package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)
// AdminOfferPackagesListPage renders packages list.
templ AdminOfferPackagesListPage(lang, dir string) {
	@layouts.AdminShell("باقات العروض", "offers_packages", lang, dir) {
		<div class="page-container py-6">
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm flex-between items-center flex-wrap gap-4">
    <div class="stack-sm">
					<h1 class="text-xl font-black text-primary m-0">باقات العروض للموردين</h1>
					<p class="text-xs text-secondary m-0 mt-0.5 font-medium">تحديد باقات الاشتراك والتثبيت الترويجي المتاحة للموردين</p>
				</div>
				<a href="/admin/offers-packages" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
					@components.IconArrowRight("icon-xs")
					<span>العودة للمركز</span>
				</a>
			</div>
			
			<div class="glass-panel p-8 text-center border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
					@components.IconBoxes("icon-md")
				</div>
				<h3 class="text-base font-extrabold text-primary mb-1.5">إدارة باقات العروض والرعايات</h3>
				<p class="text-xs text-secondary mb-4 max-w-md mx-auto">
					تتيح باقات العروض للموردين نشر عروض متعددة مع ميزات تثبيت إضافية في صدارة الكتالوج وقنوات التوريد.
				</p>
			</div>
		</div>
	}
}

// AdminOfferPackageDetailPage renders package detail.
templ AdminOfferPackageDetailPage(pkgID int64, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل الباقة #%d", pkgID), "offers_packages", lang, dir) {
		<div class="page-container py-6">
			<div class="glass-panel p-6 max-w-2xl mx-auto border border-slate-200/80 rounded-2xl shadow-sm">
				<div class="flex-between items-center mb-4 pb-3 border-b border-slate-100">
					<h2 class="text-lg font-black text-primary m-0">باقة العروض #{ fmt.Sprintf("%d", pkgID) }</h2>
					<a href="/admin/offers-packages/packages" class="btn btn-secondary btn-sm font-bold gap-1">
						@components.IconArrowRight("icon-xs")
						<span>العودة</span>
					</a>
				</div>
			</div>
		</div>
	}
}

type AdminOfferSponsorshipsPageData struct {
	Requests   []*promo.SponsorshipRequest
	Page       int
	PerPage    int
	TotalCount int
}

// AdminOfferSponsorshipsPage renders sponsorships and pending requests for admin review.
templ AdminOfferSponsorshipsPage(lang, dir string, data AdminOfferSponsorshipsPageData) {
	@layouts.AdminShell("الرعايات الرسمية للعروض", "offers_packages", lang, dir) {
		<div class="page-container py-6">
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm flex-between items-center flex-wrap gap-4">
				<div class="stack-sm">
					<h1 class="text-xl font-black text-primary m-0">مراجعة طلبات الرعاية</h1>
					<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
						اعتماد أو رفض طلبات الرعاية المُقدّمة من الموردين. عند الاعتماد يظهر العنصر في صدارة الكتالوج مع وسم معتمد.
					</p>
				</div>
				<a href="/admin/offers-packages" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
					@components.IconArrowRight("icon-xs")
					<span>العودة للمركز</span>
				</a>
			</div>

			if len(data.Requests) == 0 {
				<div class="glass-panel p-8 text-center border border-slate-200/80 rounded-2xl shadow-xs">
					<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
						@components.IconShield("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary mb-1.5">لا توجد طلبات رعاية حالياً</h3>
					<p class="text-xs text-secondary max-w-md mx-auto">
						جميع طلبات الرعاية الترويجية المقدمة من الموردين تمت مراجعتها بالكامل.
					</p>
				</div>
			} else {
				<div class="glass-panel p-0 border border-slate-200/80 rounded-2xl shadow-xs overflow-hidden">
					<div class="table-container m-0 overflow-x-auto">
						<table class="data-table m-0 text-xs w-full">
							<thead>
								<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
									<th class="py-3 text-start ps-4">المورد</th>
									<th class="py-3 text-start">نوع العنصر</th>
									<th class="py-3 text-start">معرف العنصر</th>
									<th class="py-3 text-start">الباقة</th>
									<th class="text-center py-3">المستوى</th>
									<th class="text-center py-3">الحالة</th>
									<th class="text-center py-3">تاريخ الطلب</th>
									<th class="col-actions py-3 pe-4">الإجراءات</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								for _, req := range data.Requests {
									if req != nil {
										<tr class="transition-colors">
											<td class="tabular-nums font-bold text-primary py-3 ps-4">{ fmt.Sprintf("#%d", req.OrganizationID) }</td>
											<td class="py-3">
												if req.ItemType == "product" {
													<span class="badge badge-sky text-xs font-semibold">صنف دوائي</span>
												} else {
													<span class="badge badge-emerald text-xs font-semibold">عرض ترويجي</span>
												}
											</td>
											<td class="tabular-nums font-mono py-3">{ fmt.Sprintf("#%d", req.ItemID) }</td>
											<td class="tabular-nums font-bold py-3">
												if req.Package != nil && req.Package.Name.Get(i18n.ParseLang(lang)) != "" {
													<span>{ req.Package.Name.Get(i18n.ParseLang(lang)) }</span>
												} else {
													<span>باقة #{ fmt.Sprintf("%d", req.PackageID) }</span>
												}
											</td>
											<td class="text-center py-3">
												if req.Package != nil {
													<span class="badge badge-amber font-extrabold text-xs shadow-2xs">
														مستوى { fmt.Sprintf("%d", req.Package.TierLevel) }
													</span>
												} else {
													<span class="text-muted text-xs">—</span>
												}
											</td>
											<td class="text-center py-3">
												if req.AdminStatus == "pending" {
													<span class="badge badge-sky font-extrabold text-xs">قيد المراجعة</span>
												} else if req.AdminStatus == "approved" {
													<span class="badge badge-emerald font-extrabold text-xs">معتمد</span>
												} else {
													<span class="badge badge-rose font-extrabold text-xs">مرفوض</span>
												}
											</td>
											<td class="text-center text-xs tabular-nums text-secondary py-3">{ req.CreatedAt.Format("2006-01-02 03:04 PM") }</td>
											<td class="col-actions py-3 pe-4">
												if req.AdminStatus == "pending" {
													<div class="table-actions">
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers-packages/sponsorships/%d/approve", req.ID)) } class="m-0">
															<button type="submit" class="btn btn-primary btn-xs font-bold gap-1 shadow-2xs">
																@components.IconCheck("icon-2xs")
																<span>اعتماد</span>
															</button>
														</form>
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers-packages/sponsorships/%d/reject", req.ID)) } class="m-0">
															<button type="submit" class="btn btn-secondary btn-xs font-bold text-rose-600 gap-1 shadow-2xs" onclick="return confirm('هل أنت متأكد من رفض هذا الطلب؟')">
																@components.IconClose("icon-2xs")
																<span>رفض</span>
															</button>
														</form>
													</div>
												} else {
													<span class="text-muted text-xs font-medium">مكتمل</span>
												}
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
					if data.TotalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.TotalCount,
							BaseURL:     "/admin/offers-packages/sponsorships",
						})
					}
				</div>
			}
		</div>
	}
}

// AdminOfferPromotionsPage renders promotional campaigns.
templ AdminOfferPromotionsPage(lang, dir string) {
	@layouts.AdminShell("الحملات الترويجية", "offers_packages", lang, dir) {
		<div class="page-container py-6">
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm flex-between items-center flex-wrap gap-4">
				<div class="stack-sm">
					<h1 class="text-xl font-black text-primary m-0">الحملات الترويجية المخصصة</h1>
					<p class="text-xs text-secondary m-0 mt-0.5 font-medium">إدارة الحملات الترويجية الموجهة حسب المحافظات والقطاعات الجغرافية</p>
				</div>
				<a href="/admin/offers-packages" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
					@components.IconArrowRight("icon-xs")
					<span>العودة</span>
				</a>
			</div>
			
			<div class="glass-panel p-8 text-center border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
					@components.IconMegaphone("icon-md")
				</div>
				<h3 class="text-base font-extrabold text-primary mb-1.5">الحملات الترويجية الموسمية</h3>
				<p class="text-xs text-secondary max-w-md mx-auto">
					تسمح المنظومة بإنشاء حملات خصومات موجهة حسب المحافظات والقطاعات الحيوية.
				</p>
			</div>
		</div>
	}
}

// AdminAdPlansPage renders ad plans.
templ AdminAdPlansPage(lang, dir string) {
	@layouts.AdminShell("خطط وباقات الإعلانات", "ad_plans", lang, dir) {
		<div class="page-container py-6">
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm flex-between items-center flex-wrap gap-4">
    <div class="stack-sm">
					<h1 class="text-xl font-black text-primary m-0">خطط ومواضع الإعلانات</h1>
					<p class="text-xs text-secondary m-0 mt-0.5 font-medium">تحديد تسعير ومواضع الإعلانات والبنرات ومدة ظهور كل مساحة ترويجية</p>
				</div>
				<a href="/admin/ads" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
					@components.IconArrowRight("icon-xs")
					<span>العودة للإعلانات</span>
				</a>
			</div>
			
			<div class="glass-panel p-8 text-center border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
					@components.IconSettings("icon-md")
				</div>
				<h3 class="text-base font-extrabold text-primary mb-1.5">خطط ومواضع البنرات</h3>
				<p class="text-xs text-secondary max-w-md mx-auto">
					تحديد مواضع البنرات الرئيسية (Hero)، البنرات العريضة بين الأقسام، وبنرات الكتالوج الجانبية.
				</p>
			</div>
		</div>
	}
}

// AdminOfferAnalyticsViewsPage renders views analytics.
templ AdminOfferAnalyticsViewsPage(lang, dir string) {
	@layouts.AdminShell("إحصائيات مشاهدات العروض", "analytics", lang, dir) {
		<div class="page-container py-6">
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm">
				<h1 class="text-xl font-black text-primary m-0">تقرير مشاهدات وزيارات العروض الترويجية</h1>
				<p class="text-xs text-secondary m-0 mt-0.5 font-medium">تتبع معدل المشاهدات اليومية والأسبوعية لكل عرض ترويجي وبنر معلن</p>
			</div>
			<div class="glass-panel p-8 text-center border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
					@components.IconChart("icon-md")
				</div>
				<h3 class="text-base font-extrabold text-primary mb-1.5">إحصائيات المشاهدات النشطة</h3>
				<p class="text-xs text-secondary max-w-md mx-auto">
					لوحة بيانية دقيقة لتحليل عدد مرات ظهور العروض للعملاء والمشتريات المنفذة عبرها.
				</p>
			</div>
		</div>
	}
}

// AdminOfferAnalyticsClicksPage renders clicks analytics.
templ AdminOfferAnalyticsClicksPage(lang, dir string) {
	@layouts.AdminShell("إحصائيات النقرات والتحويل", "analytics", lang, dir) {
		<div class="page-container py-6">
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm">
				<h1 class="text-xl font-black text-primary m-0">تقرير النقرات ومعدلات التحويل (CTR) للعروض</h1>
				<p class="text-xs text-secondary m-0 mt-0.5 font-medium">تحليل كفاءة العروض والبنرات ونسبة النقر للطلب المباشر</p>
			</div>
			<div class="glass-panel p-8 text-center border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
					@components.IconPercent("icon-md")
				</div>
				<h3 class="text-base font-extrabold text-primary mb-1.5">تحليل معدل التحويل (CTR)</h3>
				<p class="text-xs text-secondary max-w-md mx-auto">
					مقارنة أداء الحملات الإعلانية ومعدل وصول الصيدليات لصفحات تفاصيل العروض.
				</p>
			</div>
		</div>
	}
}

type AdminOfferLocationsData struct {
	Locations  []*promo.OfferLocationAdminRow
	Stats      promo.OfferLocationsStats
	Filter     promo.OfferLocationsFilter
	Page       int
	PerPage    int
	TotalCount int
}

func dayOfWeekArabicName(d int) string {
	switch d {
	case 1:
		return "السبت"
	case 2:
		return "الأحد"
	case 3:
		return "الإثنين"
	case 4:
		return "الثلاثاء"
	case 5:
		return "الأربعاء"
	case 6:
		return "الخميس"
	case 7:
		return "الجمعة"
	default:
		return "طوال الأسبوع"
	}
}

// AdminOfferLocationsPage renders geographic distribution and coverage for offers across the platform.
templ AdminOfferLocationsPage(lang, dir string, data AdminOfferLocationsData) {
	@layouts.AdminShell("التوزيع الجغرافي للعروض", "offer_locations", lang, dir) {
		<div class="page-container py-6">
			<!-- Header -->
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm flex-between items-center flex-wrap gap-4">
				<div class="stack-sm">
					<div class="d-flex items-center gap-2 text-2xs text-secondary font-medium mb-0.5">
						<a href="/admin/offers-packages" class="hover:underline text-secondary">مركز العروض والصفقات</a>
						<span>/</span>
						<span class="text-primary font-bold">التغطية الجغرافية</span>
					</div>
					<h1 class="text-xl font-black text-primary m-0">نطاق التغطية الجغرافية للعروض والصفقات</h1>
					<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
						استعراض ومتابعة توزيع العروض على المحافظات والمدن، ونطاقات التوريد المعتمدة لموردي الأدوية.
					</p>
				</div>
				<a href="/admin/offers-packages" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
					@components.IconArrowRight("icon-xs")
					<span>العودة للمركز</span>
				</a>
			</div>

			<!-- KPI Stat Cards -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
				<div class="glass-panel p-4 border border-slate-200/80 rounded-2xl shadow-xs d-flex items-center gap-3.5">
					<div class="w-11 h-11 rounded-xl bg-brand/10 text-brand d-flex items-center justify-center shrink-0">
						@components.IconMapPin("icon-sm")
					</div>
					<div>
						<div class="text-2xs font-bold text-secondary">إجمالي نقاط التغطية</div>
						<div class="text-xl font-black text-primary tabular-nums mt-0.5">{ fmt.Sprintf("%d", data.Stats.TotalLocations) }</div>
					</div>
				</div>

				<div class="glass-panel p-4 border border-slate-200/80 rounded-2xl shadow-xs d-flex items-center gap-3.5">
					<div class="w-11 h-11 rounded-xl bg-sky-50 text-sky-600 d-flex items-center justify-center shrink-0">
						@components.IconBuilding("icon-sm")
					</div>
					<div>
						<div class="text-2xs font-bold text-secondary">المدن المشمولة</div>
						<div class="text-xl font-black text-primary tabular-nums mt-0.5">{ fmt.Sprintf("%d", data.Stats.CoveredCities) }</div>
					</div>
				</div>

				<div class="glass-panel p-4 border border-slate-200/80 rounded-2xl shadow-xs d-flex items-center gap-3.5">
					<div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 d-flex items-center justify-center shrink-0">
						@components.IconGlobe("icon-sm")
					</div>
					<div>
						<div class="text-2xs font-bold text-secondary">المحافظات المشمولة</div>
						<div class="text-xl font-black text-primary tabular-nums mt-0.5">{ fmt.Sprintf("%d", data.Stats.CoveredGovernorates) }</div>
					</div>
				</div>

				<div class="glass-panel p-4 border border-slate-200/80 rounded-2xl shadow-xs d-flex items-center gap-3.5">
					<div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 d-flex items-center justify-center shrink-0">
						@components.IconSparkles("icon-sm")
					</div>
					<div>
						<div class="text-2xs font-bold text-secondary">العروض المغطاة نشطة</div>
						<div class="text-xl font-black text-primary tabular-nums mt-0.5">{ fmt.Sprintf("%d", data.Stats.ActiveOffers) }</div>
					</div>
				</div>
			</div>

			<!-- Filter Bar -->
			<div class="glass-panel p-4 mb-5 border border-slate-200/80 rounded-2xl shadow-xs">
				<form method="GET" action="/admin/offers/locations" class="m-0 flex flex-wrap items-end gap-3">
					<div class="flex-1 min-w-[200px]">
						<label class="form-label text-2xs font-bold text-secondary d-block mb-1">البحث</label>
						<div class="relative">
							<input
								type="text"
								name="q"
								value={ data.Filter.Search }
								placeholder="ابحث بالعرض، المورد، المدينة، أو العنوان..."
								class="form-input text-xs w-full rounded-xl ps-8"
							/>
							<div class="absolute inset-y-0 start-2.5 flex items-center pointer-events-none text-slate-400">
								@components.IconSearch("icon-2xs")
							</div>
						</div>
					</div>

					<div class="w-40">
						<label class="form-label text-2xs font-bold text-secondary d-block mb-1">الحالة</label>
						<select name="status" class="form-select text-xs w-full rounded-xl">
							<option value="">كل الحالات</option>
							<option value="active" selected?={ data.Filter.Status == "active" }>نشط</option>
							<option value="inactive" selected?={ data.Filter.Status == "inactive" }>غير نشط</option>
						</select>
					</div>

					<div class="w-44">
						<label class="form-label text-2xs font-bold text-secondary d-block mb-1">اعتماد المنصة</label>
						<select name="admin_status" class="form-select text-xs w-full rounded-xl">
							<option value="">كل الاعتمادات</option>
							<option value="approved" selected?={ data.Filter.AdminStatus == "approved" }>معتمد</option>
							<option value="pending" selected?={ data.Filter.AdminStatus == "pending" }>قيد المراجعة</option>
							<option value="rejected" selected?={ data.Filter.AdminStatus == "rejected" }>مرفوض</option>
						</select>
					</div>

					<div class="d-flex items-center gap-2">
						<button type="submit" class="btn btn-primary btn-sm font-bold gap-1 shadow-xs">
							@components.IconFilter("icon-2xs")
							<span>تصفية</span>
						</button>
						if data.Filter.Search != "" || data.Filter.Status != "" || data.Filter.AdminStatus != "" {
							<a href="/admin/offers/locations" class="btn btn-secondary btn-sm font-bold">
								إلغاء
							</a>
						}
					</div>
				</form>
			</div>

			<!-- Data Table or Empty State -->
			if len(data.Locations) == 0 {
				<div class="glass-panel p-10 text-center border border-slate-200/80 rounded-2xl shadow-xs">
					<div class="w-14 h-14 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
						@components.IconMapPin("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary mb-1">لا توجد مواقع تغطية مسجلة</h3>
					<p class="text-xs text-secondary max-w-md mx-auto m-0">
						if data.Filter.Search != "" || data.Filter.Status != "" || data.Filter.AdminStatus != "" {
							لا توجد نتائج تطابق معايير البحث والتصفية المحددة. جرب تعديل خيارات التصفية.
						} else {
							لم يقم الموردون بتحديد نطاقات جغرافية مخصصة للعروض بعد، ويتم الاعتماد على نطاق الفروع الأسبوعي الافتراضي.
						}
					</p>
				</div>
			} else {
				<div class="glass-panel p-0 border border-slate-200/80 rounded-2xl shadow-xs overflow-hidden">
					<div class="table-container m-0 overflow-x-auto">
						<table class="data-table m-0 text-xs w-full">
							<thead>
								<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
									<th class="py-3 text-start ps-4">العرض الترويجي والمورد</th>
									<th class="py-3 text-start">المحافظة والمدينة</th>
									<th class="py-3 text-start">العنوان ونطاق التغطية</th>
									<th class="py-3 text-center">أيام وساعات الخدمة</th>
									<th class="py-3 text-center">الحالة</th>
									<th class="py-3 text-center">الاعتماد</th>
									<th class="py-3 text-center">تاريخ الإضافة</th>
									<th class="py-3 text-center pe-4">الإجراءات</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								for _, loc := range data.Locations {
									<tr class="hover:bg-slate-50/50 transition-colors">
										<!-- Offer & Supplier -->
										<td class="py-3 ps-4">
											<div class="stack-2xs">
												<a href={ templ.SafeURL(fmt.Sprintf("/offers/%d", loc.OfferID)) } class="font-extrabold text-primary hover:text-brand hover:underline leading-snug">
													if loc.OfferTitle != "" {
														{ loc.OfferTitle }
													} else {
														{ fmt.Sprintf("عرض رقم #%d", loc.OfferID) }
													}
												</a>
												<div class="d-flex items-center gap-1.5 text-2xs text-secondary font-medium">
													@components.IconBuilding("icon-2xs text-slate-400")
													<span>{ loc.SupplierName }</span>
												</div>
											</div>
										</td>

										<!-- Governorate & City -->
										<td class="py-3">
											<div class="stack-2xs">
												if loc.GovernorateName != "" {
													<span class="badge badge-indigo text-2xs font-bold py-0.5 px-2 w-fit">
														{ loc.GovernorateName }
													</span>
												}
												<span class="font-bold text-slate-800 text-xs mt-0.5">
													if loc.CityName != "" {
														{ loc.CityName }
													} else {
														{ fmt.Sprintf("مدينة #%d", loc.CityID) }
													}
												</span>
											</div>
										</td>

										<!-- Address & Radius -->
										<td class="py-3">
											<div class="stack-2xs">
												if loc.AddressAr != "" {
													<span class="text-xs text-primary font-medium">{ loc.AddressAr }</span>
												} else {
													<span class="text-xs text-muted">نطاق إحداثيات GPS</span>
												}
												<div class="d-flex items-center gap-2 text-2xs text-secondary tabular-nums">
													if loc.RadiusMeters > 0 {
														<span class="font-bold text-sky-700">
															نطاق: { fmt.Sprintf("%d م (%.1f كم)", loc.RadiusMeters, float64(loc.RadiusMeters)/1000.0) }
														</span>
													}
													if loc.Latitude != 0 && loc.Longitude != 0 {
														<span class="text-muted">
															GPS: { fmt.Sprintf("%.4f, %.4f", loc.Latitude, loc.Longitude) }
														</span>
													}
												</div>
											</div>
										</td>

										<!-- Days & Hours -->
										<td class="py-3 text-center">
											<div class="stack-2xs items-center">
												<span class="badge badge-sky text-2xs font-bold py-0.5 px-2">
													{ dayOfWeekArabicName(loc.DayOfWeek) }
												</span>
												if loc.TimeFrom != "" && loc.TimeTo != "" {
													<span class="text-2xs text-secondary font-mono tabular-nums">
														{ loc.TimeFrom } - { loc.TimeTo }
													</span>
												} else {
													<span class="text-2xs text-muted">طوال اليوم</span>
												}
											</div>
										</td>

										<!-- Status -->
										<td class="py-3 text-center">
											if loc.Status == "active" {
												<span class="badge badge-emerald text-2xs font-bold py-0.5 px-2">نشط</span>
											} else {
												<span class="badge badge-slate text-2xs font-bold py-0.5 px-2">غير نشط</span>
											}
										</td>

										<!-- Moderation Status -->
										<td class="py-3 text-center">
											if loc.AdminStatus == "approved" {
												<span class="badge badge-emerald text-2xs font-bold py-0.5 px-2">معتمد</span>
											} else if loc.AdminStatus == "pending" {
												<span class="badge badge-amber text-2xs font-bold py-0.5 px-2">قيد المراجعة</span>
											} else if loc.AdminStatus == "rejected" {
												<span class="badge badge-rose text-2xs font-bold py-0.5 px-2">مرفوض</span>
											} else {
												<span class="badge badge-slate text-2xs font-bold py-0.5 px-2">{ loc.AdminStatus }</span>
											}
										</td>

										<!-- Created At -->
										<td class="py-3 text-center text-2xs text-secondary font-mono tabular-nums">
											{ loc.CreatedAt.Format("2006-01-02") }
										</td>

										<!-- Actions -->
										<td class="py-3 text-center pe-4">
											<a
												href={ templ.SafeURL(fmt.Sprintf("/offers/%d", loc.OfferID)) }
												target="_blank"
												class="btn btn-secondary btn-xs font-bold gap-1"
												title="معاينة العرض في الكتالوج"
											>
												@components.IconExternalLink("icon-2xs")
												<span>معاينة</span>
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Pagination -->
					if data.TotalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.TotalCount,
							BaseURL:     "/admin/offers/locations",
						})
					}
				</div>
			}
		</div>
	}
}

