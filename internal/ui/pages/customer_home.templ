package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HomeStats struct {
	TotalSuppliers int
	TotalProducts  int
	TotalCities    int
	TotalOrders    int
	TotalOffers    int
	HeroTitle      string
	HeroSubtitle   string
	HeroBadge      string
	Ads            []*promo.Ad
	DealsAds       []*promo.Ad
	BottomAds      []*promo.Ad
}

templ CustomerHome(featured []*catalog.Product, categories []*catalog.Category, offers []*promo.Offer, stats HomeStats, lang, dir string) {
	@layouts.PublicShell("دوا 24 — منصة التوريد والربط الدوائي المباشر في مصر", lang, dir) {
		
		<!-- 1. Hero Split Section: Marketing Headline & Direct CTAs + Live Medicine Comparison Stage -->
		<section class="landing-hero-container">
			<div class="landing-hero-split-grid">
				<!-- Right Column in RTL: Catchy Text & Action CTAs -->
				<div class="landing-hero-text-col">
					<div class="landing-hero-pill-badge">
						@components.IconSparkles("icon-xs text-brand")
						if stats.HeroBadge != "" {
							<span>{ stats.HeroBadge }</span>
						} else {
							<span>منصة التداول الدوائي الذكية الأولى في مصر</span>
						}
					</div>

					<h1 class="landing-hero-title-main text-balance">
						if stats.HeroTitle != "" {
							{ stats.HeroTitle }
						} else {
							ابحث .. قارن .. اشترِ بسهولة
							<span class="text-gradient-brand d-block mt-1">سوق الأدوية والمستلزمات الطبية الأول في مصر</span>
						}
					</h1>

					<p class="landing-hero-desc text-pretty">
						if stats.HeroSubtitle != "" {
							{ stats.HeroSubtitle }
						} else {
							المنصة المتكاملة لربط الصيدليات بالموزعين والمستودعات في مصر، مع شفافية كاملة في الأسعار والخصومات، وسرعة في التوريد بأعلى معايير سلاسل التبريد.
						}
					</p>

					<!-- Direct Action CTAs -->
					<div class="hero-cta-group justify-start">
						<a href="/auth/register" class="btn btn-primary btn-lg font-extrabold hero-cta-btn">
							@components.IconPlus("icon-sm")
							<span>ابدأ الآن مجاناً</span>
						</a>
						<a href="/auth/login" class="btn btn-secondary btn-lg font-bold hero-cta-btn">
							@components.IconUser("icon-sm")
							<span>تسجيل الدخول</span>
						</a>
						<a href="/catalog" class="btn btn-ghost btn-lg font-bold hero-cta-btn">
							@components.IconSearch("icon-sm")
							<span>تصفح الكتالوج</span>
						</a>
					</div>
				</div>

				<!-- Left Column in RTL: Live Pharmaceutical Comparison Board & Dr. Capsule Mascot -->
				<div class="landing-hero-stage-col">
					<div class="dashboard-preview-frame shadow-2xl">
						<div class="preview-window-topbar">
							<div class="preview-window-dots">
								<span class="dot dot-red"></span>
								<span class="dot dot-yellow"></span>
								<span class="dot dot-green"></span>
							</div>
							<div class="preview-window-title">
								@components.IconScale("icon-xs text-brand")
								<span>مقارنة عروض التوريد اللحظية</span>
							</div>
							<div class="preview-window-status">
								<span class="status-live-indicator"></span>
								<span class="status-live-text">محدث الآن</span>
							</div>
						</div>

						<div class="preview-workspace-bar">
							<div class="d-flex items-center gap-2 text-xs text-muted w-full">
								@components.IconSearch("icon-xs text-brand")
								<span>ابحث عن دواء، مادة فعالة، أو كود تشغيلة...</span>
							</div>
						</div>

						<div class="preview-table-container">
							<table class="preview-catalog-table">
								<thead>
									<tr>
										<th>الصنف الدوائي</th>
										<th>المورد المعتمد</th>
										<th>سعر الجمهور</th>
										<th>الخصم</th>
										<th>صافي التوريد</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>
											<div class="d-flex items-center gap-2">
												<div class="table-drug-icon">
													@components.IconPill("icon-xs text-brand")
												</div>
												<div>
													<div class="font-extrabold text-xs text-primary">Amoxicillin 500mg</div>
													<div class="text-3xs text-muted font-mono">أموكسيسيلين كبسول</div>
												</div>
											</div>
										</td>
										<td>
											<span class="badge badge-subtle text-3xs font-bold">متجر الأمل الدوائي</span>
										</td>
										<td class="text-xs text-muted line-through font-mono">45.00 ج.م</td>
										<td>
											<span class="badge badge-emerald text-2xs font-extrabold">35%</span>
										</td>
										<td class="text-xs font-black text-emerald font-mono">29.25 ج.م</td>
									</tr>
									<tr>
										<td>
											<div class="d-flex items-center gap-2">
												<div class="table-drug-icon">
													@components.IconPill("icon-xs text-emerald")
												</div>
												<div>
													<div class="font-extrabold text-xs text-primary">Panadol Extra</div>
													<div class="text-3xs text-muted font-mono">بنادول إكسترا أقراص</div>
												</div>
											</div>
										</td>
										<td>
											<span class="badge badge-subtle text-3xs font-bold">مستودع النصر الطبي</span>
										</td>
										<td class="text-xs text-muted line-through font-mono">60.00 ج.م</td>
										<td>
											<span class="badge badge-emerald text-2xs font-extrabold">28%</span>
										</td>
										<td class="text-xs font-black text-emerald font-mono">43.20 ج.م</td>
									</tr>
									<tr>
										<td>
											<div class="d-flex items-center gap-2">
												<div class="table-drug-icon">
													@components.IconPill("icon-xs text-amber")
												</div>
												<div>
													<div class="font-extrabold text-xs text-primary">Omeprazole 20mg</div>
													<div class="text-3xs text-muted font-mono">أوميبرازول كبسول</div>
												</div>
											</div>
										</td>
										<td>
											<span class="badge badge-subtle text-3xs font-bold">فارما تريد مصر</span>
										</td>
										<td class="text-xs text-muted line-through font-mono">52.00 ج.م</td>
										<td>
											<span class="badge badge-emerald text-2xs font-extrabold">25%</span>
										</td>
										<td class="text-xs font-black text-emerald font-mono">39.00 ج.م</td>
									</tr>
									<tr>
										<td>
											<div class="d-flex items-center gap-2">
												<div class="table-drug-icon">
													@components.IconPill("icon-xs text-sky-600")
												</div>
												<div>
													<div class="font-extrabold text-xs text-primary">Augmentin 1g</div>
													<div class="text-3xs text-muted font-mono">أوجمنتين 1 جم أقراص</div>
												</div>
											</div>
										</td>
										<td>
											<span class="badge badge-subtle text-3xs font-bold">مخزن الأهرام للأدوية</span>
										</td>
										<td class="text-xs text-muted line-through font-mono">110.00 ج.م</td>
										<td>
											<span class="badge badge-emerald text-2xs font-extrabold">30%</span>
										</td>
										<td class="text-xs font-black text-emerald font-mono">77.00 ج.م</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<!-- Dr. Capsule Mascot Floating Card -->
					<div class="hero-mascot-pill-card">
						<div class="hero-mascot-img-box">
							<img src="/static/img/doctor-capsule.png" alt="د. كبسولة المساعد الذكي" loading="lazy" decoding="async"/>
						</div>
						<div class="flex-1 min-w-0">
							<div class="d-flex items-center gap-2">
								<span class="text-xs font-black text-primary">د. كبسولة — المساعد الذكي</span>
								<span class="badge badge-emerald text-3xs font-bold">نشط الآن</span>
							</div>
							<p class="text-2xs text-secondary m-0 mt-0.5 line-clamp-2">
								مرحباً بك في دواء 24! بنوفرلك أفضل عروض وخصومات الأدوية من الموردين المعتمدين يومياً بأعلى نسب خصم.
							</p>
							<div class="hero-mascot-waveform">
								<span class="hero-waveform-bar"></span>
								<span class="hero-waveform-bar"></span>
								<span class="hero-waveform-bar"></span>
								<span class="hero-waveform-bar"></span>
								<span class="hero-waveform-bar"></span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- 4 Trust Value Pills Bar -->
			<div class="landing-trust-pills-bar">
				<div class="landing-trust-pill">
					@components.IconCheckCircle("icon-xs text-emerald")
					<span>بيانات دقيقة ومحدثة دائماً</span>
				</div>
				<div class="landing-trust-pill">
					@components.IconClock("icon-xs text-brand")
					<span>توفير الوقت والجهد</span>
				</div>
				<div class="landing-trust-pill">
					@components.IconScale("icon-xs text-sky-500")
					<span>مقارنة العروض والخصومات بسهولة</span>
				</div>
				<div class="landing-trust-pill">
					@components.IconBuilding("icon-xs text-amber-500")
					<span>موردين موثوقين في جميع أنحاء مصر</span>
				</div>
			</div>

			<!-- 1b. Hero Sponsored Ads Showcase (if any) -->
			if len(stats.Ads) > 0 {
				<div
					class="hero-ad-showcase-container"
					x-data={ fmt.Sprintf(`{
						currentSlide: 0,
						totalSlides: %d,
						timer: null,
						startAutoplay() {
							if (this.totalSlides <= 1) return;
							if (document.hidden) return;
							this.stopAutoplay();
							this.timer = setInterval(() => {
								this.currentSlide = (this.currentSlide + 1) %% this.totalSlides;
							}, 5500);
						},
						bindVisibility() {
							this._onVis = () => document.hidden ? this.stopAutoplay() : this.startAutoplay();
							document.addEventListener('visibilitychange', this._onVis);
							if ('IntersectionObserver' in window) {
								this._io = new IntersectionObserver((entries) => {
									entries.forEach((e) => e.isIntersecting ? this.startAutoplay() : this.stopAutoplay());
								}, { threshold: 0 });
								this._io.observe(this.$el);
							}
						},
						teardown() {
							this.stopAutoplay();
							if (this._onVis) document.removeEventListener('visibilitychange', this._onVis);
							if (this._io) this._io.disconnect();
						},
						stopAutoplay() {
							if (this.timer) {
								clearInterval(this.timer);
								this.timer = null;
							}
						},
						next() {
							this.currentSlide = (this.currentSlide + 1) %% this.totalSlides;
						},
						prev() {
							this.currentSlide = (this.currentSlide - 1 + this.totalSlides) %% this.totalSlides;
						},
						goTo(i) {
							this.currentSlide = i;
						}
					}`, len(stats.Ads)) }
					x-init="startAutoplay(); bindVisibility()"
					@mouseenter="stopAutoplay()"
					@mouseleave="startAutoplay()"
					x-on:beforeunload.window="teardown()"
				>
					<div class="hero-ad-slider-frame">
						if len(stats.Ads) > 1 {
							<button
								type="button"
								@click.prevent.stop="prev()"
								class="hero-ad-nav-btn hero-ad-nav-prev"
								aria-label="Previous ad"
							>
								@components.IconArrowRight("icon-sm")
							</button>
						}

						for i, ad := range stats.Ads {
							if ad != nil {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/ads/click/%d", ad.ID)) }
									hx-get={ fmt.Sprintf("/ads/impression/%d", ad.ID) }
									hx-trigger="intersect once"
									class="hero-ad-slide"
									x-show={ fmt.Sprintf("currentSlide === %d", i) }
									x-cloak
									x-transition:enter="transition ease-out duration-300"
									x-transition:enter-start="opacity-0 scale-98"
									x-transition:enter-end="opacity-100 scale-100"
									x-transition:leave="transition ease-in duration-200"
									x-transition:leave-start="opacity-100 scale-100"
									x-transition:leave-end="opacity-0 scale-98"
									data-ad-id={ fmt.Sprintf("%d", ad.ID) }
								>
									<!-- Fallback Gradient Layer -->
									<div class="hero-ad-fallback-bg"></div>

									<!-- Left Content & Pricing Block -->
									<div class="hero-ad-content">
										<!-- Supplier Identity Badge (Logo + Name) -->
										<div class="hero-ad-supplier-identity">
											if ad.SupplierLogo != "" {
												<img src={ ad.SupplierLogo } alt={ ad.SupplierName } loading={ heroImageLoading(i) } decoding="async" class="hero-ad-supplier-logo"/>
											} else {
												<div class="hero-ad-supplier-icon-box">
													@components.IconBuilding("icon-2xs")
												</div>
											}
											<span class="hero-ad-supplier-name">
												if ad.SupplierName != "" {
													{ ad.SupplierName }
												} else {
													مورد دوائي معتمد
												}
											</span>
										</div>

										<h2 class="hero-ad-title">{ ad.DisplayTitle(lang) }</h2>
										if ad.DisplayText(lang) != "" {
											<p class="hero-ad-description">{ ad.DisplayText(lang) }</p>
										}

										<!-- Commercial B2B Pricing Pill Bar -->
										if ad.PublicPrice != "" {
											<div class="hero-ad-pricing-bar">
												if ad.PublicPrice != "سعر رسمي معتمد" {
													<div class="hero-ad-price-item">
														<span class="hero-ad-price-label">سعر الجمهور</span>
														<span class="hero-ad-public-price">{ ad.PublicPrice }</span>
													</div>
												}
												if ad.DiscountPercent != "" && ad.DiscountPercent != "خصم تجاري خاص" {
													<div class="hero-ad-discount-badge">
														<span>خصم { ad.DiscountPercent }</span>
													</div>
												}
												if ad.SupplyPrice != "" {
													<div class="hero-ad-price-item hero-ad-net-item">
														<span class="hero-ad-price-label">سعر التوريد</span>
														<span class="hero-ad-net-price">{ ad.SupplyPrice }</span>
													</div>
												}
											</div>
										}

										<div class="hero-ad-cta-pill">
											<span>اطلب الآن بالسعر المخفض</span>
											@components.IconArrowLeft("icon-2xs")
										</div>
									</div>

									<!-- Right Product Showcase Stage (Full View) -->
									<div class="hero-ad-stage">
										<div class="hero-ad-product-card">
											if (ad.MediaType == "video" || ad.IsVideo()) && ad.MediaURL != "" {
												<video
													src={ ad.MediaURL }
													poster={ ad.ThumbnailURL }
													autoplay?={ i == 0 }
													preload={ heroMediaPreload(i) }
													muted
													loop
													playsinline
													class="hero-ad-product-video"
												></video>
											} else if ad.MediaURL != "" {
												<img
													src={ ad.MediaURL }
													alt={ ad.DisplayTitle(lang) }
													loading={ heroImageLoading(i) }
													decoding="async"
													class="hero-ad-product-img"
													onerror="this.style.display='none'"
												/>
											} else {
												<div class="hero-ad-product-placeholder">
													@components.IconPill("icon-xl text-brand-400")
												</div>
											}
											if ad.DiscountPercent != "" && ad.DiscountPercent != "خصم تجاري خاص" {
												<span class="hero-ad-card-discount-tag">وفر { ad.DiscountPercent }</span>
											}
										</div>
									</div>
								</a>
							}
						}

						if len(stats.Ads) > 1 {
							<button
								type="button"
								@click.prevent.stop="next()"
								class="hero-ad-nav-btn hero-ad-nav-next"
								aria-label="Next ad"
							>
								@components.IconArrowLeft("icon-sm")
							</button>

							<div class="hero-ad-dots">
								for i := range stats.Ads {
									<button
										type="button"
										@click.prevent.stop={ fmt.Sprintf("goTo(%d)", i) }
										class="hero-ad-dot"
										:class={ fmt.Sprintf("currentSlide === %d ? 'hero-ad-dot-active' : ''", i) }
										aria-label={ fmt.Sprintf("Go to slide %d", i+1) }
									></button>
								}
							</div>
						}
					</div>
				</div>
			}
		</section>

		<!-- 2. مزايا المنصة: 6 Feature Cards -->
		<section class="landing-section-block">
			<div class="landing-section-header">
				<div class="landing-hero-pill-badge mb-3">
					@components.IconSparkles("icon-xs text-brand")
					<span>لماذا دواء 24؟</span>
				</div>
				<h2 class="landing-section-title">مزايا مصممة لتطوير تجارتك الدوائية</h2>
				<p class="landing-section-subtitle">كل ما تحتاجه لإدارة مشتريات صيدليتك أو توزيع أدويتك بكفاءة وسرعة فائقة وبدون تعقيد.</p>
			</div>

			<div class="landing-features-grid">
				<!-- Feature 1: AI Smart Matching -->
				<div class="landing-feature-card">
					<div class="landing-feature-icon-box">
						@components.IconRobot("icon-md")
					</div>
					<h3 class="landing-feature-title">الذكاء الاصطناعي</h3>
					<p class="landing-feature-desc">مطابقة ذكية بين قوائم النواقص وأفضل العروض المتاحة، مع اقتراح البدائل الدوائية المعتمدة بأعلى نسبة ربحية لصيدليتك.</p>
				</div>

				<!-- Feature 2: Massive Drug Database -->
				<div class="landing-feature-card">
					<div class="landing-feature-icon-box">
						@components.IconDatabase("icon-md")
					</div>
					<h3 class="landing-feature-title">قاعدة بيانات ضخمة</h3>
					<p class="landing-feature-desc">كتالوج دوائي موحد وشامل يضم آلاف الأصناف والمستلزمات، بأسعار الجمهور الرسمية والمواصفات المعتمدة من هيئة الدواء.</p>
				</div>

				<!-- Feature 3: Realtime Price Comparison -->
				<div class="landing-feature-card">
					<div class="landing-feature-icon-box">
						@components.IconScale("icon-md")
					</div>
					<h3 class="landing-feature-title">مقارنة العروض والخصومات</h3>
					<p class="landing-feature-desc">محرك بحث فوري يقارن عروض جميع الموزعين والمخازن في نطاقك الجغرافي لحظة بلحظة لاقتناص الخصم الأعلى فوراً.</p>
				</div>

				<!-- Feature 4: Excel Order Upload -->
				<div class="landing-feature-card">
					<div class="landing-feature-icon-box">
						@components.IconFileSpreadsheet("icon-md")
					</div>
					<h3 class="landing-feature-title">الشراء من خلال Excel</h3>
					<p class="landing-feature-desc">ارفع كشف طلبيتك أو فواتير صيدليتك بصيغة Excel لتقوم المنظومة بتوزيع الأصناف تلقائياً على الموردين الأرخص سعراً والأسرع توريداً.</p>
				</div>

				<!-- Feature 5: Trusted Reviews -->
				<div class="landing-feature-card">
					<div class="landing-feature-icon-box">
						@components.IconStar("icon-md")
					</div>
					<h3 class="landing-feature-title">تقييمات موثوقة</h3>
					<p class="landing-feature-desc">تقييمات شفافة وتجارب حقيقية لسرعة التوصيل، التزام الموردين بتواريخ الصلاحية، وحالة تشغيلات الأدوية من صيادلة معتمدين.</p>
				</div>

				<!-- Feature 6: System Integrations -->
				<div class="landing-feature-card">
					<div class="landing-feature-icon-box">
						@components.IconLink("icon-md")
					</div>
					<h3 class="landing-feature-title">تكامل مع الأنظمة</h3>
					<p class="landing-feature-desc">ربط سلس ومرن مع أنظمة إدارة الصيدليات وبرامج الحسابات (ERP) لتحديث الأرصدة والمخزون والمشتريات آلياً دون جهد يدوي.</p>
				</div>
			</div>
		</section>

		<!-- 3. كيف تعمل المنصة؟: 4 Steps Flow -->
		<section class="landing-steps-wrapper">
			<div class="landing-section-header">
				<div class="landing-hero-pill-badge mb-3">
					@components.IconClock("icon-xs text-brand")
					<span>بكل سهولة وسرعة</span>
				</div>
				<h2 class="landing-section-title">كيف تبدأ الشراء والتوريد في 4 خطوات؟</h2>
				<p class="landing-section-subtitle">تجربة رقمية متكاملة توفر عليك ساعات طويلة من المكالمات الهاتفية والمطابقة الورقية المعقدة.</p>
			</div>

			<div class="landing-steps-row">
				<!-- Step 1 -->
				<div class="landing-step-card">
					<div class="landing-step-number-badge">1</div>
					<div class="landing-step-icon-wrap">
						@components.IconUpload("icon-md")
					</div>
					<h3 class="landing-step-title">ارفع قائمة احتياجاتك</h3>
					<p class="landing-step-text">ابحث بالاسم التجاري أو العلمي، أو ارفع ملف طلبيتك كاملاً بصيغة Excel بضغطة زر واحدة.</p>
				</div>

				<!-- Step 2 -->
				<div class="landing-step-card">
					<div class="landing-step-number-badge">2</div>
					<div class="landing-step-icon-wrap">
						@components.IconScale("icon-md")
					</div>
					<h3 class="landing-step-title">قارن العروض والخصومات</h3>
					<p class="landing-step-text">شاهد كافة عروض المخازن والشركات المتاحة لنفس الأصناف مع نسب الخصم اللحظية وأوقات التسليم.</p>
				</div>

				<!-- Step 3 -->
				<div class="landing-step-card">
					<div class="landing-step-number-badge">3</div>
					<div class="landing-step-icon-wrap">
						@components.IconCheck("icon-md")
					</div>
					<h3 class="landing-step-title">اختر الأنسب لصيدليتك</h3>
					<p class="landing-step-text">فاضل بين الخصم التجاري الأعلى، سرعة الشحن، أو تقييم واعتمادية المورد لإتمام صفقة رابحة.</p>
				</div>

				<!-- Step 4 -->
				<div class="landing-step-card">
					<div class="landing-step-number-badge">4</div>
					<div class="landing-step-icon-wrap">
						@components.IconTruck("icon-md")
					</div>
					<h3 class="landing-step-title">أتمم طلب الشراء والتوصيل</h3>
					<p class="landing-step-text">تأكيد فوري للطلب وتتبع لحظي لمسار الشحن المجهز بسلاسل التبريد، مع توثيق الفواتير إلكترونياً.</p>
				</div>
			</div>
		</section>

		<!-- 4. حل متكامل لجميع الأطراف: Audience Ecosystem & Capabilities -->
		<section class="landing-section-block">
			<div class="landing-section-header">
				<div class="landing-hero-pill-badge mb-3">
					@components.IconShield("icon-xs text-brand")
					<span>منظومة موحدة تجمع الجميع</span>
				</div>
				<h2 class="landing-section-title">حلول رقمية متكاملة لجميع أطراف السوق الدوائي</h2>
				<p class="landing-section-subtitle">سواء كنت صيدلية تبحث عن أعلى نسبة خصم وتوريد سريع، أو موزعاً ومستودعاً يسعى لتوسيع شبكة عملائه ومبيعاته.</p>
			</div>

			<div class="landing-audience-grid">
				<!-- Pillar 1: Pharmacies -->
				<div class="landing-audience-card">
					<div class="landing-audience-icon">
						@components.IconBuilding("icon-md")
					</div>
					<h3 class="landing-audience-role">الصيدليات</h3>
					<p class="landing-audience-desc">أقصى ربحية على كل فاتورة، توفير الوقت المستغرق في البحث عن النواقص، وتوريد آمن وموثق مباشرة لصيدليتك.</p>
				</div>

				<!-- Pillar 2: Distributors / Stores -->
				<div class="landing-audience-card">
					<div class="landing-audience-icon">
						@components.IconUsers("icon-md")
					</div>
					<h3 class="landing-audience-role">المتاجر والموزعون</h3>
					<p class="landing-audience-desc">وصول فوري لآلاف الصيدليات في نطاقك الجغرافي، تصريف سريع للمخزون بعروض حصرية، وزيادة مضاعفة في المبيعات اليومية.</p>
				</div>

				<!-- Pillar 3: Suppliers / Warehouses -->
				<div class="landing-audience-card">
					<div class="landing-audience-icon">
						@components.IconPackage("icon-md")
					</div>
					<h3 class="landing-audience-role">الموردون والمستودعات</h3>
					<p class="landing-audience-desc">منصة احترافية لإدارة الطلبات الضخمة، تقارير تحليلية لحظية لمؤشرات الطلب الدوائي، وتسهيل إجراءات التوريد والتحصيل المالي.</p>
				</div>

				<!-- Pillar 4: Customers / Final Beneficiaries -->
				<div class="landing-audience-card">
					<div class="landing-audience-icon">
						@components.IconShield("icon-md")
					</div>
					<h3 class="landing-audience-role">العملاء والشركاء</h3>
					<p class="landing-audience-desc">منظومة رقمية متماسكة تضمن توافر الدواء للمريض النهائي بأعلى جودة وتخزين مطابق لاشتراطات هيئة الدواء المصرية.</p>
				</div>
			</div>

			<!-- Platform Capabilities Strip (Checklist) -->
			<div class="landing-capabilities-strip">
				<div class="landing-cap-item">
					@components.IconCheckCircle("icon-xs text-emerald")
					<span>لوحات تحكم متطورة ومؤشرات أداء لحظية</span>
				</div>
				<div class="landing-cap-item">
					@components.IconCheckCircle("icon-xs text-emerald")
					<span>تقارير وتحليلات ذكية لحركة الأسعار</span>
				</div>
				<div class="landing-cap-item">
					@components.IconCheckCircle("icon-xs text-emerald")
					<span>إدارة الفروع وتعدد مستويات الصلاحيات</span>
				</div>
				<div class="landing-cap-item">
					@components.IconCheckCircle("icon-xs text-emerald")
					<span>رقابة صارمة ومكافحة الاحتيال التجاري</span>
				</div>
				<div class="landing-cap-item">
					@components.IconCheckCircle("icon-xs text-emerald")
					<span>دعم فني وصيدلي متواصل على مدار الساعة</span>
				</div>
			</div>
		</section>

		<!-- 5. جاهز للانطلاق؟: High-Contrast Dark CTA Banner -->
		<section class="landing-cta-banner-card">
			<div class="landing-cta-glow-circle"></div>
			<div class="landing-hero-pill-badge mb-4" style="background: rgba(14, 165, 233, 0.2); border-color: rgba(56, 189, 248, 0.4); color: #38bdf8;">
				@components.IconRocket("icon-xs")
				<span>انطلاقة جديدة لتجارتك</span>
			</div>
			<h2 class="landing-cta-title">جاهز للانطلاق وتطوير تجارتك الدوائية؟</h2>
			<p class="landing-cta-subtitle">
				انضم اليوم إلى مئات الصيدليات والموردين الذين يثقون في منصة دواء 24 لتسيير مشترياتهم وتوريداتهم اليومية بأعلى كفاءة وأفضل أرباح.
			</p>
			<div class="d-flex items-center justify-center flex-wrap gap-4">
				<a href="/auth/register" class="landing-cta-btn-emerald">
					@components.IconRocket("icon-sm")
					<span>ابدأ الآن مجاناً</span>
				</a>
				<a href="/auth/login" class="btn btn-secondary btn-lg font-bold" style="border-radius: 9999px; padding-inline: 2.25rem;">
					<span>تسجيل الدخول</span>
				</a>
			</div>
			<div class="landing-cta-footer-decor">
				<div class="d-flex items-center gap-2">
					@components.IconRocket("icon-xs text-sky-400")
					<span>مستقبل التجارة الدوائية في مصر يبدأ من هنا</span>
				</div>
				<div>
					<span>Dawa24 — أكثر من مجرد منصة .. شريك نجاحك اليومي</span>
				</div>
			</div>
		</section>

		<!-- 6. Bottom Trust & Operational Strip (3 Pillars) -->
		<section class="landing-bottom-trust-grid">
			<div class="landing-bottom-trust-item">
				<div class="landing-bottom-trust-icon">
					@components.IconHeadphones("icon-md")
				</div>
				<div>
					<h4 class="font-extrabold text-sm text-primary m-0">دعم مستمر 24/7</h4>
					<p class="text-xs text-secondary m-0 mt-0.5">فريق دعم فني وصيدلي متخصص جاهز لمساعدتك وحل أي استفسارات لحظياً عبر الهاتف والواتساب.</p>
				</div>
			</div>

			<div class="landing-bottom-trust-item">
				<div class="landing-bottom-trust-icon">
					@components.IconShield("icon-md text-emerald")
				</div>
				<div>
					<h4 class="font-extrabold text-sm text-primary m-0">آمن وموثوق 100%</h4>
					<p class="text-xs text-secondary m-0 mt-0.5">موردون ومستودعات مرخصة وفواتير إلكترونية معتمدة لحماية كافة تعاملاتك التجارية.</p>
				</div>
			</div>

			<div class="landing-bottom-trust-item">
				<div class="landing-bottom-trust-icon">
					@components.IconFlagEG("icon-md")
				</div>
				<div>
					<h4 class="font-extrabold text-sm text-primary m-0">تغطية شاملة لمحافظات مصر</h4>
					<p class="text-xs text-secondary m-0 mt-0.5">شبكة توزيع لوجستية وسلاسل تبريد مجهزة تربط كافة محافظات الجمهورية من القاهرة وحتى الصعيد.</p>
				</div>
			</div>
		</section>


		if len(stats.DealsAds) > 0 {
			<section class="landing-deals-ad-section p-4 max-w-7xl mx-auto mb-8">
				<div class="d-grid grid-auto-fit-md gap-4">
					for _, dad := range stats.DealsAds {
						if dad != nil {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/ads/click/%d", dad.ID)) }
								hx-get={ fmt.Sprintf("/ads/impression/%d", dad.ID) }
								hx-trigger="intersect once"
								class="deals-ad-card p-5 rounded-3xl border border-brand-200/60 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 flex-between items-center gap-5 transition-all text-decoration-none shadow-md hover:border-brand-400"
							>
								<div class="d-flex items-center gap-4">
									<div class="w-32 h-24 md:w-36 md:h-28 rounded-2xl bg-black/40 p-1 d-flex items-center justify-center flex-shrink-0 shadow-md border border-slate-700/60 overflow-hidden relative">
										if (dad.MediaType == "video" || dad.IsVideo()) && dad.MediaURL != "" {
											<video src={ dad.MediaURL } autoplay muted loop playsinline class="w-full h-full object-cover rounded-xl"></video>
										} else if dad.MediaURL != "" {
											<img src={ dad.MediaURL } alt={ dad.DisplayTitle(lang) } loading="lazy" decoding="async" class="w-full h-full object-contain"/>
										} else {
											@components.IconPill("icon-md text-brand")
										}
									</div>
									<div class="stack-xs text-start">
										if dad.SupplierName != "" {
											<span class="text-2xs text-brand-300 font-extrabold d-block">{ dad.SupplierName }</span>
										}
										<h3 class="deals-ad-title text-base font-black text-white m-0">{ dad.DisplayTitle(lang) }</h3>
										if dad.DisplayText(lang) != "" {
											<p class="text-xs text-slate-300 m-0 line-clamp-1">{ dad.DisplayText(lang) }</p>
										}
										if dad.PublicPrice != "" && dad.PublicPrice != "سعر رسمي معتمد" {
											<div class="d-flex items-center gap-2.5 mt-1">
												<span class="text-2xs text-rose-400 line-through font-bold">{ dad.PublicPrice }</span>
												<span class="badge badge-emerald text-2xs font-black">{ dad.DiscountPercent }</span>
												<span class="text-xs font-black text-sky-400 tabular-nums">{ dad.SupplyPrice }</span>
											</div>
										}
									</div>
								</div>
								<div class="d-flex items-center gap-1.5 text-xs font-black text-sky-400 flex-shrink-0">
									<span>اطلب الآن</span>
									@components.IconArrowLeft("icon-2xs")
								</div>
							</a>
						}
					}
				</div>
			</section>
		}

		if len(stats.BottomAds) > 0 {
			<section class="landing-bottom-ad-section p-4 max-w-7xl mx-auto mb-8">
				<div class="d-grid grid-auto-fit-md gap-4">
					for _, bad := range stats.BottomAds {
						if bad != nil {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/ads/click/%d", bad.ID)) }
								hx-get={ fmt.Sprintf("/ads/impression/%d", bad.ID) }
								hx-trigger="intersect once"
								class="bottom-ad-card p-5 rounded-3xl border border-slate-700 bg-surface-sunken flex-between items-center gap-4 transition-all text-decoration-none shadow-sm hover:border-brand-500"
							>
								<div class="d-flex items-center gap-4">
									<div class="w-28 h-20 md:w-32 md:h-24 rounded-2xl bg-black/40 p-1 d-flex items-center justify-center flex-shrink-0 shadow-xs border border-slate-700/60 overflow-hidden relative">
										if (bad.MediaType == "video" || bad.IsVideo()) && bad.MediaURL != "" {
											<video src={ bad.MediaURL } autoplay muted loop playsinline class="w-full h-full object-cover rounded-xl"></video>
										} else if bad.MediaURL != "" {
											<img src={ bad.MediaURL } alt={ bad.DisplayTitle(lang) } loading="lazy" decoding="async" class="w-full h-full object-contain"/>
										} else {
											@components.IconPill("icon-md text-brand")
										}
									</div>
									<div class="stack-xs text-start">
										if bad.SupplierName != "" {
											<span class="text-2xs text-muted font-bold d-block">{ bad.SupplierName }</span>
										}
										<h3 class="bottom-ad-title text-sm font-black text-primary m-0">{ bad.DisplayTitle(lang) }</h3>
										if bad.DisplayText(lang) != "" {
											<p class="text-xs text-secondary m-0 line-clamp-1">{ bad.DisplayText(lang) }</p>
										}
										if bad.PublicPrice != "" && bad.PublicPrice != "سعر رسمي معتمد" {
											<div class="d-flex items-center gap-2 mt-1">
												<span class="text-2xs text-rose-500 line-through font-bold">{ bad.PublicPrice }</span>
												<span class="badge badge-emerald text-2xs font-black">{ bad.DiscountPercent }</span>
												<span class="text-xs font-black text-brand tabular-nums">{ bad.SupplyPrice }</span>
											</div>
										}
									</div>
								</div>
								<div class="d-flex items-center gap-1.5 text-xs font-black text-brand flex-shrink-0">
									<span>استعراض التفاصيل</span>
									@components.IconArrowLeft("icon-2xs")
								</div>
							</a>
						}
					}
				</div>
			</section>
		}

		@components.PublicCTA("", "", lang)
	}
}