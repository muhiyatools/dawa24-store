package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HomeStats struct {
	TotalSuppliers int
	TotalProducts  int
	TotalCities    int
	TotalOrders    int
}

templ CustomerHome(featured []*catalog.Product, categories []*catalog.Category, stats HomeStats, lang, dir string) {
	@layouts.PublicShell("دواء 24 — منصة التوريد والربط الدوائي المباشر في مصر", lang, dir) {
		<style>
			.hero-badge-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.35rem 0.95rem;
				border-radius: var(--radius-full);
				background: var(--accent-subtle);
				color: var(--accent);
				font-weight: 800;
				font-size: 0.825rem;
				border: 1px solid var(--border);
				margin-bottom: 1.25rem;
			}
			.search-suggestion-tag {
				font-size: 0.775rem;
				padding: 0.25rem 0.65rem;
				border-radius: var(--radius-full);
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				color: var(--text-secondary);
				text-decoration: none;
				transition: all 150ms ease;
				white-space: nowrap;
			}
			.search-suggestion-tag:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: var(--accent-subtle);
			}
			.product-catalog-card {
				background: var(--surface-raised);
				border: 1px solid var(--border);
				border-radius: var(--radius-xl);
				padding: var(--space-5);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
			}
			.product-catalog-card:hover {
				border-color: var(--accent);
				transform: translateY(-2px);
				box-shadow: var(--shadow-sm);
			}
			.category-tile-card {
				background: var(--surface-raised);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 1.25rem 1rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.6rem;
				text-align: center;
				text-decoration: none;
				color: var(--text);
				transition: all 150ms ease;
			}
			.category-tile-card:hover {
				border-color: var(--accent);
				background: var(--accent-subtle);
				transform: translateY(-2px);
			}
			.feature-benefit-card {
				background: var(--surface-raised);
				border: 1px solid var(--border);
				border-radius: var(--radius-xl);
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
		</style>

		<!-- 1. Hero Section -->
		<section class="card mb-0" style="background:var(--surface-raised); padding:3.5rem 1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border); margin-bottom:2rem; text-align:center;">
			<div class="hero-badge-pill">
				@components.IconShield("icon-xs")
				<span>المنظومة الرقمية المعتمدة لربط وتوريد الأدوية في مصر</span>
			</div>
			
			<h1 style="font-size:2.5rem; font-weight:900; color:var(--text); margin:0 auto 1rem auto; max-width:800px; line-height:1.25; letter-spacing:-0.02em;">
				سوق التوريد الدوائي المباشر للصيدليات والمستودعات
			</h1>
			
			<p style="font-size:1.05rem; font-weight:500; color:var(--text-secondary); margin:0 auto 2rem auto; max-width:680px; line-height:1.75;">
				اطلب طلبيتك الدوائية مباشرة من كبرى شركات التوزيع ومصانع الأدوية المرخصة، مع ضمان فواتير إلكترونية معتمدة وسلاسل شحن مبردة (Cold-Chain).
			</p>

			<!-- Live Catalog Search Box -->
			<form action="/catalog" method="GET" style="max-width:620px; margin:0 auto 1.25rem auto; display:flex; gap:0.5rem; background:var(--surface-sunken); padding:0.4rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
				<input
					type="search"
					name="q"
					placeholder="ابحث بالاسم التجاري (مثل Panadol)، المادة الفعالة، أو اسم الشركة..."
					class="form-input"
					style="flex:1; border:none; background:transparent; font-size:0.95rem; padding:0.6rem 0.85rem;"
				/>
				<button type="submit" class="btn btn-primary" style="padding-inline:1.5rem; font-weight:800; border-radius:var(--radius-md);">
					@components.IconSearch("icon-xs")
					<span>بحث في الكتالوج</span>
				</button>
			</form>

			<!-- Quick Search Suggestion Tags -->
			<div style="display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:0.45rem; margin-bottom:2rem;">
				<span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">الأكثر طلباً:</span>
				<a href="/catalog?q=Augmentin" class="search-suggestion-tag">أوجمنتين</a>
				<a href="/catalog?q=Panadol" class="search-suggestion-tag">بنادول</a>
				<a href="/catalog?q=Cataflam" class="search-suggestion-tag">كتافلام</a>
				<a href="/catalog?q=Congestal" class="search-suggestion-tag">كونجستال</a>
				<a href="/catalog?q=Insulin" class="search-suggestion-tag">أنسولين وثلاجة</a>
				<a href="/catalog?q=Antinal" class="search-suggestion-tag">أنتينال</a>
			</div>
			
			<!-- Direct Action CTAs -->
			<div style="display:flex; justify-content:center; gap:0.85rem; flex-wrap:wrap;">
				<a href="/auth/register" class="btn btn-primary" style="padding:0.7rem 1.75rem; font-weight:800; font-size:0.95rem;">
					@components.IconPlus("icon-xs")
					<span>تسجيل صيدلية جديدة</span>
				</a>
				<a href="/catalog" class="btn btn-secondary" style="padding:0.7rem 1.75rem; font-weight:700; font-size:0.95rem;">
					@components.IconPill("icon-xs")
					<span>تصفح كتالوج الأدوية</span>
				</a>
			</div>
		</section>

		<!-- 2. Trust Metrics Strip -->
		<section class="card mb-0" style="display:flex; justify-content:space-around; align-items:center; flex-wrap:wrap; gap:1.5rem; padding:1.25rem 2rem; margin-bottom:2.5rem; border:1px solid var(--border); border-radius:var(--radius-xl); background:var(--surface-raised);">
			<div style="display:flex; align-items:center; gap:0.75rem;">
				<div style="width:38px; height:38px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
					@components.IconBuilding("icon-sm")
				</div>
				<div>
					<div class="tabular-nums" style="font-weight:900; font-size:1.35rem; color:var(--text); line-height:1.1;">
						if stats.TotalSuppliers > 0 {
							{ fmt.Sprintf("%d", stats.TotalSuppliers) }
						} else {
							47
						}
					</div>
					<div style="font-weight:600; color:var(--text-secondary); font-size:0.775rem;">مورد ومصنع معتمد</div>
				</div>
			</div>
			
			<div style="border-inline-start:1px solid var(--border); height:2rem;" class="hide-mobile"></div>
			
			<div style="display:flex; align-items:center; gap:0.75rem;">
				<div style="width:38px; height:38px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
					@components.IconPill("icon-sm")
				</div>
				<div>
					<div class="tabular-nums" style="font-weight:900; font-size:1.35rem; color:var(--text); line-height:1.1;">
						if stats.TotalProducts > 0 {
							{ fmt.Sprintf("%d", stats.TotalProducts) }
						} else {
							8,340
						}
					</div>
					<div style="font-weight:600; color:var(--text-secondary); font-size:0.775rem;">صنف دوائي مسجل</div>
				</div>
			</div>
			
			<div style="border-inline-start:1px solid var(--border); height:2rem;" class="hide-mobile"></div>
			
			<div style="display:flex; align-items:center; gap:0.75rem;">
				<div style="width:38px; height:38px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
					@components.IconTruck("icon-sm")
				</div>
				<div>
					<div class="tabular-nums" style="font-weight:900; font-size:1.35rem; color:var(--text); line-height:1.1;">
						if stats.TotalCities > 0 {
							{ fmt.Sprintf("%d", stats.TotalCities) }
						} else {
							86
						}
					</div>
					<div style="font-weight:600; color:var(--text-secondary); font-size:0.775rem;">مدينة ومنطقة مغطاة</div>
				</div>
			</div>

			<div style="border-inline-start:1px solid var(--border); height:2rem;" class="hide-mobile"></div>

			<div style="display:flex; align-items:center; gap:0.75rem;">
				<div style="width:38px; height:38px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
					@components.IconCheckCircle("icon-sm")
				</div>
				<div>
					<div style="font-weight:900; font-size:1.15rem; color:var(--text); line-height:1.1;">فواتير إلكترونية</div>
					<div style="font-weight:600; color:var(--text-secondary); font-size:0.775rem;">متوافقة مع الضرائب المصرية</div>
				</div>
			</div>
		</section>

		<!-- 3. Featured Products for Direct Procurement -->
		<section style="margin-bottom:3rem;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
				<div>
					<h2 style="font-size:1.5rem; font-weight:900; color:var(--text); margin:0;">
						أصناف دوائية متوفرة للتوريد الفوري
					</h2>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
						أدوية ومستلزمات صيدلانية معتمدة متوفرة بأرصدة حية لدى كبار الموردين
					</p>
				</div>
				<a href="/catalog" class="btn btn-secondary btn-sm" style="font-weight:700;">
					<span>عرض الكتالوج الشامل</span>
					@components.IconArrowLeft("icon-xs")
				</a>
			</div>
			
			if len(featured) == 0 {
				<div class="card mb-0" style="padding:2.5rem; text-align:center; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
					@components.EmptyState(components.EmptyStateProps{
						Title:   "جاري تحديث قائمة الأصناف المميزة",
						Message: "يمكنك استخدام شريط البحث أعلاه أو تصفح الكتالوج للوصول لكافة الأدوية.",
					})
				</div>
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:1.25rem;">
					for _, prod := range featured {
						<div class="product-catalog-card">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
									if prod.DosageForm != "" {
										<span class="badge badge-sky" style="font-size:0.725rem; font-weight:700;">
											@components.IconPill("icon-xs")
											<span>{ prod.DosageForm }</span>
										</span>
									} else {
										<span class="badge badge-slate" style="font-size:0.725rem;">دوائي معتمد</span>
									}
									<span class="badge badge-emerald" style="font-size:0.725rem;">متوفر للتوريد</span>
								</div>
								
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", prod.ID)) } style="text-decoration:none; color:inherit;">
									<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0 0 0.35rem 0; line-height:1.4;">
										if prod.Name["ar"] != "" {
											{ prod.Name["ar"] }
										} else {
											{ prod.Name["en"] }
										}
									</h3>
								</a>
								
								if prod.ScientificName != "" {
									<div style="font-size:0.775rem; color:var(--text-muted); margin-bottom:0.4rem; direction:ltr; text-align:right;">
										{ prod.ScientificName }
									</div>
								}

								if prod.ManufacturingCompanies != "" {
									<div style="font-size:0.775rem; color:var(--text-secondary); margin-bottom:0.75rem;">
										<span style="color:var(--text-muted);">الشركة:</span> { prod.ManufacturingCompanies }
									</div>
								}
							</div>
							
							<div style="margin-top:1rem; padding-top:0.75rem; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", prod.ID)) } class="btn btn-primary btn-sm" style="width:100%; justify-content:center; font-weight:800;">
									@components.IconFileText("icon-xs")
									<span>عروض الموردين والطلب</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</section>

		<!-- 4. Therapeutic Categories -->
		if len(categories) > 0 {
			<section style="margin-bottom:3rem;">
				<div style="margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
					<h2 style="font-size:1.5rem; font-weight:900; color:var(--text); margin:0;">
						الأقسام والمجموعات العلاجية
					</h2>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
						تغطية لكافة التخصصات الدوائية والمستلزمات الصيدلانية
					</p>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:1rem;">
					for _, cat := range categories {
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) } class="category-tile-card">
							<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconPill("icon-sm")
							</div>
							<div style="font-size:0.875rem; font-weight:700; color:var(--text);">
								if cat.Name["ar"] != "" {
									{ cat.Name["ar"] }
								} else {
									{ cat.Name["en"] }
								}
							</div>
						</a>
					}
				</div>
			</section>
		}

		<!-- 5. Core Platform Guarantees -->
		<section style="margin-bottom:3rem;">
			<div style="text-align:center; margin-bottom:2rem;">
				<h2 style="font-size:1.6rem; font-weight:900; color:var(--text); margin:0 0 0.35rem 0;">
					لماذا تعتمد الصيدليات على منصة دواء 24
				</h2>
				<p style="color:var(--text-secondary); font-size:0.925rem; margin:0;">
					منظومة متكاملة صُممت لتسهيل التوريد الدوائي وحماية الصيدلي
				</p>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:1.25rem;">
				<div class="feature-benefit-card">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconShield("icon-md")
					</div>
					<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">موردون وشركات معتمدة</h3>
					<p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.7; margin:0;">
						تدقيق دوري للتراخيص والسجلات التجارية من هيئة الدواء ونقابة الصيادلة لضمان أصالة المصادر وجودة المنتجات.
					</p>
				</div>

				<div class="feature-benefit-card">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconTruck("icon-md")
					</div>
					<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">شحن وسلسلة تبريد مجهزة</h3>
					<p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.7; margin:0;">
						سيارات مجهزة بحاويات تبريد ومجسات حرارية (2° - 8°C) لنقل الأنسولين والأمصال والأدوية الحيوية بأمان تام.
					</p>
				</div>

				<div class="feature-benefit-card">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconFileText("icon-md")
					</div>
					<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">فواتير ضريبية إلكترونية</h3>
					<p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.7; margin:0;">
						إصدار وتوثيق مباشر مع مصلحة الضرائب المصرية لتسوية المصروفات والامتثال المالي للصيدلية بدون تعقيد.
					</p>
				</div>

				<div class="feature-benefit-card">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconPhone("icon-md")
					</div>
					<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">دعم صيدلي مباشر 24/7</h3>
					<p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.7; margin:0;">
						فريق دعم متخصص من الصيادلة لمساعدتك في تتبع الشحنات، حل أي نواقص دوائية، والإجابة عن الاستفسارات.
					</p>
				</div>
			</div>
		</section>

		<!-- 6. How Procurement Works -->
		<section class="card mb-0" style="padding:2.5rem 1.5rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border); margin-bottom:3rem; text-align:center;">
			<h2 style="font-size:1.5rem; font-weight:900; color:var(--text); margin:0 0 0.35rem 0;">
				كيف تتم عملية التوريد عبر المنصة
			</h2>
			<p style="color:var(--text-secondary); font-size:0.875rem; margin:0 auto 2rem auto; max-width:500px;">
				خطوات رقمية مبسطة تختصر الوقت وتوفر أفضل أسعار الشراء للصيدلية
			</p>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem; text-align:center;">
				<div style="padding:1rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 0.75rem auto; font-weight:900; font-size:1.1rem;">
						1
					</div>
					<h4 style="font-size:1rem; font-weight:800; color:var(--text); margin:0 0 0.35rem 0;">ابحث وقارن العروض</h4>
					<p style="font-size:0.825rem; color:var(--text-secondary); line-height:1.6; margin:0;">
						ابحث بالاسم أو الباركود وقارن عروض الأسعار ونسب الخصم والكميات المتاحة لدى الموردين.
					</p>
				</div>

				<div style="padding:1rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 0.75rem auto; font-weight:900; font-size:1.1rem;">
						2
					</div>
					<h4 style="font-size:1rem; font-weight:800; color:var(--text); margin:0 0 0.35rem 0;">اطلب بضغطة زر</h4>
					<p style="font-size:0.825rem; color:var(--text-secondary); line-height:1.6; margin:0;">
						اجمع أصنافك من موردين متعددين في طلبية واحدة موحدة يتم تجزئتها آلياً لكل مورد.
					</p>
				</div>

				<div style="padding:1rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 0.75rem auto; font-weight:900; font-size:1.1rem;">
						3
					</div>
					<h4 style="font-size:1rem; font-weight:800; color:var(--text); margin:0 0 0.35rem 0;">استلم وتتبع الشحنة</h4>
					<p style="font-size:0.825rem; color:var(--text-secondary); line-height:1.6; margin:0;">
						استلم الطلبية في صيدليتك مع الفاتورة الضريبية المعتمدة والدفع عند الاستلام أو بالائتمان.
					</p>
				</div>
			</div>
		</section>

		<!-- 7. Call To Action -->
		<section class="card mb-0" style="background:var(--accent-subtle); border:1px solid var(--border); border-radius:var(--radius-xl); padding:3rem 1.5rem; text-align:center; margin-bottom:1.5rem;">
			<h2 style="font-size:1.85rem; font-weight:900; color:var(--text); margin:0 0 0.5rem 0;">
				انضم إلى مستقبل التوريد الدوائي الآن
			</h2>
			<p style="font-size:0.95rem; color:var(--text-secondary); max-width:580px; margin:0 auto 1.75rem auto; line-height:1.7;">
				سجل حساب صيدليتك الآن للاستفادة من أفضل عروض التوريد والخصومات المباشرة من كبرى شركات ومستودعات الأدوية.
			</p>
			<div style="display:flex; justify-content:center; gap:0.75rem; flex-wrap:wrap;">
				<a href="/auth/register" class="btn btn-primary" style="padding:0.7rem 1.75rem; font-weight:800; font-size:0.95rem;">
					@components.IconCheck("icon-xs")
					<span>تسجيل صيدلية الآن</span>
				</a>
				<a href="/auth/register" class="btn btn-secondary" style="padding:0.7rem 1.75rem; font-weight:700; font-size:0.95rem;">
					@components.IconBuilding("icon-xs")
					<span>انضمام كمورد أو موزع</span>
				</a>
			</div>
		</section>
	}
}

