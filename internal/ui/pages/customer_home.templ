package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HomeStats struct {
	TotalSuppliers int
	TotalProducts  int
	TotalCities    int
	TotalOrders    int
	TotalOffers    int
	HeroTitle      string
	HeroSubtitle   string
	HeroBadge      string
	Ads            []*promo.Ad
	DealsAds       []*promo.Ad
	BottomAds      []*promo.Ad
}

templ CustomerHome(featured []*catalog.Product, categories []*catalog.Category, offers []*promo.Offer, stats HomeStats, lang, dir string) {
	@layouts.PublicShell("دواء 24 — منصة التوريد والربط الدوائي المباشر في مصر", lang, dir) {
		
		<!-- 1. High-Contrast, Attractive Hero Section -->
		<section class="landing-hero-container">
			<div class="landing-hero-header text-center">
				<div class="hero-badge-pill">
					@components.IconShield("icon-xs text-brand")
					if stats.HeroBadge != "" {
						<span>{ stats.HeroBadge }</span>
					} else {
						<span>منظومة التوريد والربط الدوائي المباشر في مصر</span>
					}
				</div>
				
				<h1 class="landing-hero-headline text-balance">
					if stats.HeroTitle != "" {
						{ stats.HeroTitle }
					} else {
						سوق التوريد والربط الدوائي المباشر للصيدليات والمستودعات
					}
				</h1>
				
				<p class="landing-hero-subhead text-pretty">
					if stats.HeroSubtitle != "" {
						{ stats.HeroSubtitle }
					} else {
						قارن أسعار التوريد، استفد من أعلى نسب الخصم اللحظية، واطلب احتياجات صيدليتك بسلاسل تبريد موثّقة بنقرة واحدة.
					}
				</p>

				<!-- Direct Action CTAs -->
				<div class="hero-cta-group">
					<a href="/auth/register" class="btn btn-primary btn-lg font-extrabold hero-cta-btn">
						@components.IconPlus("icon-sm")
						<span>تسجيل صيدلية جديدة</span>
					</a>
					<a href="/auth/login" class="btn btn-secondary btn-lg font-bold hero-cta-btn">
						@components.IconUser("icon-sm")
						<span>تسجيل الدخول للمنظومة</span>
					</a>
					<a href="/auth/register" class="btn btn-ghost btn-lg font-bold hero-cta-btn">
						@components.IconBuilding("icon-sm")
						<span>انضمام كمورد أو مصنع</span>
					</a>
				</div>
			</div>

			<!-- 1b. Hero Sponsored Ads Showcase (if any) -->
			if len(stats.Ads) > 0 {
				<div
					class="hero-ad-showcase-container"
					x-data={ fmt.Sprintf(`{
						currentSlide: 0,
						totalSlides: %d,
						timer: null,
						startAutoplay() {
							if (this.totalSlides <= 1) return;
							this.stopAutoplay();
							this.timer = setInterval(() => {
								this.currentSlide = (this.currentSlide + 1) %% this.totalSlides;
							}, 5500);
						},
						stopAutoplay() {
							if (this.timer) {
								clearInterval(this.timer);
								this.timer = null;
							}
						},
						next() {
							this.currentSlide = (this.currentSlide + 1) %% this.totalSlides;
						},
						prev() {
							this.currentSlide = (this.currentSlide - 1 + this.totalSlides) %% this.totalSlides;
						},
						goTo(i) {
							this.currentSlide = i;
						}
					}`, len(stats.Ads)) }
					x-init="startAutoplay()"
					@mouseenter="stopAutoplay()"
					@mouseleave="startAutoplay()"
				>
					<div class="hero-ad-slider-frame">
						if len(stats.Ads) > 1 {
							<button
								type="button"
								@click.prevent.stop="prev()"
								class="hero-ad-nav-btn hero-ad-nav-prev"
								aria-label="Previous ad"
							>
								@components.IconArrowRight("icon-sm")
							</button>
						}

						for i, ad := range stats.Ads {
							if ad != nil {
								<a
									href={ templ.SafeURL(ad.ResolveClickURL()) }
									class="hero-ad-slide"
									x-show={ fmt.Sprintf("currentSlide === %d", i) }
									x-cloak
									x-transition:enter="transition ease-out duration-300"
									x-transition:enter-start="opacity-0 scale-98"
									x-transition:enter-end="opacity-100 scale-100"
									x-transition:leave="transition ease-in duration-200"
									x-transition:leave-start="opacity-100 scale-100"
									x-transition:leave-end="opacity-0 scale-98"
									data-ad-id={ fmt.Sprintf("%d", ad.ID) }
								>
									<!-- Fallback Gradient Layer -->
									<div class="hero-ad-fallback-bg"></div>

									if ad.MediaType == "video" && ad.MediaURL != "" {
										<video
											src={ ad.MediaURL }
											poster={ ad.ThumbnailURL }
											autoplay
											muted
											loop
											playsinline
											class="hero-ad-video-media"
										></video>
									} else if ad.MediaURL != "" {
										<img
											src={ ad.MediaURL }
											alt={ ad.DisplayTitle(lang) }
											loading="eager"
											class="hero-ad-bg-media"
											onerror="this.style.display='none'"
										/>
									}
									<div class="hero-ad-gradient-overlay"></div>
									<div class="hero-ad-floating-badges">
										<span class="hero-ad-badge-sponsor">
											@components.IconSparkles("icon-2xs")
											<span>إعلانات الموردين والشركات</span>
										</span>
										<span class="hero-ad-badge-verified">
											@components.IconShield("icon-2xs")
											<span>مورد ومصنع معتمد</span>
										</span>
									</div>
									<div class="hero-ad-content">
										<h2 class="hero-ad-title">{ ad.DisplayTitle(lang) }</h2>
										if ad.DisplayText(lang) != "" {
											<p class="hero-ad-description">{ ad.DisplayText(lang) }</p>
										}
										<div class="hero-ad-cta-pill">
											<span>استعراض الصنف والطلب الآن</span>
											@components.IconArrowLeft("icon-2xs")
										</div>
									</div>
								</a>
							}
						}

						if len(stats.Ads) > 1 {
							<button
								type="button"
								@click.prevent.stop="next()"
								class="hero-ad-nav-btn hero-ad-nav-next"
								aria-label="Next ad"
							>
								@components.IconArrowLeft("icon-sm")
							</button>

							<div class="hero-ad-dots">
								for i := range stats.Ads {
									<button
										type="button"
										@click.prevent.stop={ fmt.Sprintf("goTo(%d)", i) }
										class="hero-ad-dot"
										:class={ fmt.Sprintf("currentSlide === %d ? 'hero-ad-dot-active' : ''", i) }
										aria-label={ fmt.Sprintf("Go to slide %d", i+1) }
									></button>
								}
							</div>
						}
					</div>
				</div>
			}

			<!-- 2. Authentic Interactive Platform Clone Preview -->
			@HeroPlatformClone()

		</section>

		<!-- 3. Key Platform Performance Metrics Strip (3 Verified Metrics) -->
		<section class="landing-metric-strip">
			<div class="metric-strip-inner">
				<div class="metric-strip-item">
					<div class="metric-strip-icon-box">
						@components.IconBuilding("icon-md")
					</div>
					<div class="stack-sm">
						<div class="metric-strip-number text-xl">
							if stats.TotalSuppliers > 0 {
								{ fmt.Sprintf("%d", stats.TotalSuppliers) }
							} else {
								47
							}
						</div>
						<div class="metric-strip-label">مورد ومستودع معتمد</div>
					</div>
				</div>

				<div class="metric-strip-divider hide-mobile"></div>

				<div class="metric-strip-item">
					<div class="metric-strip-icon-box">
						@components.IconPill("icon-md")
					</div>
					<div class="stack-sm">
						<div class="metric-strip-number text-xl">
							if stats.TotalProducts > 0 {
								{ fmt.Sprintf("%d+", stats.TotalProducts) }
							} else {
								8,340+
							}
						</div>
						<div class="metric-strip-label">صنف دوائي ومستلزمات</div>
					</div>
				</div>

				<div class="metric-strip-divider hide-mobile"></div>

				<div class="metric-strip-item">
					<div class="metric-strip-icon-box">
						@components.IconTruck("icon-md")
					</div>
					<div class="stack-sm">
						<div class="metric-strip-number text-xl">
							if stats.TotalCities > 0 {
								{ fmt.Sprintf("%d", stats.TotalCities) }
							} else {
								86
							}
						</div>
						<div class="metric-strip-label">مدينة ومنطقة مغطاة</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. Platform Guarantees (Clean, Crisp, Trust-Building) -->
		<section class="landing-section-block">
			<div class="section-title-wrap text-center">
				<h2 class="section-main-title">
					لماذا تعتمد كبرى الصيدليات على دواء 24؟
				</h2>
				<p class="section-main-subtitle">
					بنية تحتية موثوقة مصممة لتأمين سلاسل الإمداد وتوفير أعلى نسبة ربحية للصيدلي
				</p>
			</div>

			<div class="guarantees-grid">
				<div class="guarantee-card">
					<div class="guarantee-icon-box">
						@components.IconShield("icon-md")
					</div>
					<h3 class="guarantee-title">موردون ومستودعات معتمدة</h3>
					<p class="guarantee-text">
						تدقيق مستمر للتراخيص والسجلات من هيئة الدواء المصرية لضمان سلامة المصادر وأصالة التشغيلات.
					</p>
				</div>

				<div class="guarantee-card">
					<div class="guarantee-icon-box">
						@components.IconTruck("icon-md")
					</div>
					<h3 class="guarantee-title">شحن وسلسلة تبريد مجهزة (Cold-Chain)</h3>
					<p class="guarantee-text">
						حاويات تبريد رقمية بمجسات حرارية لنقل الأنسولين والأمصال والأدوية الحيوية (2°C - 8°C).
					</p>
				</div>

				<div class="guarantee-card">
					<div class="guarantee-icon-box">
						@components.IconPhone("icon-md")
					</div>
					<h3 class="guarantee-title">دعم صيدلي وتقني متواصل 24/7</h3>
					<p class="guarantee-text">
						فريق صيادلة وتقنيين متخصصين لمساعدتك في تتبع الشحنات، حل نواقص الأدوية، والرد الفوري.
					</p>
				</div>
			</div>
		</section>

		<!-- 5. Unified Call To Action Section -->
		if len(stats.DealsAds) > 0 {
			<section class="landing-deals-ad-section p-4">
				for _, dad := range stats.DealsAds {
					if dad != nil {
						<a href={ templ.SafeURL(dad.ResolveClickURL()) } class="deals-ad-card d-block p-4 rounded-xl border bg-surface-sunken">
							<span class="badge badge-amber text-xs font-bold mb-2">صفقة ترويجية مميزة</span>
							<h3 class="deals-ad-title text-base font-extrabold text-primary m-0">{ dad.DisplayTitle(lang) }</h3>
						</a>
					}
				}
			</section>
		}

		if len(stats.BottomAds) > 0 {
			<section class="landing-bottom-ad-section p-4">
				for _, bad := range stats.BottomAds {
					if bad != nil {
						<a href={ templ.SafeURL(bad.ResolveClickURL()) } class="bottom-ad-card d-block p-4 rounded-xl border bg-surface-sunken">
							<span class="badge badge-sky text-xs font-bold mb-2">إعلان ترويجي موثق</span>
							<h3 class="bottom-ad-title text-base font-extrabold text-primary m-0">{ bad.DisplayTitle(lang) }</h3>
						</a>
					}
				}
			</section>
		}

		@components.PublicCTA("", "", lang)
	}
}