package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerHome(featured []*catalog.Product, lang, dir string) {
	@layouts.CustomerShell("السوق الدوائي الموحد | Dawa24", lang, dir) {
		<section style="background:linear-gradient(135deg, #ffffff 0%, var(--primary-50) 100%); padding:3.5rem 2rem; border-radius:var(--radius-2xl); border:1px solid var(--border-card); margin-bottom:2.5rem; text-align:center; box-shadow:var(--shadow-sm);">
			<div style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.35rem 0.85rem; border-radius:var(--radius-full); background:var(--primary-100); color:var(--primary-800); font-weight:700; font-size:0.825rem; margin-bottom:1rem;">
				@components.IconShield("icon-xs")
				<span>منظومة التوريد الدوائي المعتمدة للمؤسسات الطبية والصيدليات</span>
			</div>
			<h1 style="font-size:2.5rem; font-weight:900; color:var(--neutral-900); margin-bottom:1rem; letter-spacing:-0.02em;">
				منصة الربط والتوريد الدوائي الموحدة في مصر
			</h1>
			<p style="color:var(--neutral-600); font-size:1.1rem; max-width:680px; margin:0 auto 2rem auto;">
				طلب مباشر من الموزعين وشركات الأدوية المعتمدة، أسعار موحدة، فواتير إلكترونية، ومتابعة دقيقة لتواريخ الصلاحية والتشغيلات.
			</p>
			<form action="/catalog" method="GET" style="max-width:600px; margin:0 auto; display:flex; gap:0.5rem;">
				<div style="position:relative; flex:1;">
					<input
						type="search"
						name="q"
						placeholder="ابحث بالاسم التجاري، المادة الفعالة، أو الباركود..."
						class="form-input"
						style="font-size:0.95rem; padding:0.75rem 1.25rem; width:100%; border-radius:var(--radius-lg);"
					/>
				</div>
				<button type="submit" class="btn btn-primary" style="padding-inline:1.75rem; border-radius:var(--radius-lg);">
					@components.IconSearch("icon-sm")
					<span>بحث</span>
				</button>
			</form>
		</section>

		<section style="margin-bottom:3rem;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 style="font-size:1.4rem; font-weight:800; color:var(--neutral-900);">
						أحدث الأصناف والأدوية المتوفرة
					</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">أصناف متوفرة للتوريد الفوري للصيدليات</p>
				</div>
				<a href="/catalog" class="btn btn-secondary btn-sm" style="font-weight:600;">
					<span>عرض كل الأصناف</span>
					@components.IconArrowLeft("icon-xs")
				</a>
			</div>

			if len(featured) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد أصناف مميزة حالياً",
					Message: "يمكنك تصفح الكتالوج الدوائي العام للبحث عن الأدوية والمستلزمات المطلوبة.",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:1.5rem;">
					for _, p := range featured {
						<div class="card hover-lift" style="display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0; padding:1.5rem;">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem;">
									<span class="badge badge-slate" style="font-size:0.725rem;">
										@components.IconPill("icon-xs")
										<span>{ p.DosageForm }</span>
									</span>
									<span class="badge badge-emerald" style="font-size:0.725rem;">متوفر</span>
								</div>
								<h3 style="font-size:1.05rem; font-weight:700; color:var(--neutral-900); margin-bottom:0.25rem;">
									if p.Name["ar"] != "" {
										{ p.Name["ar"] }
									} else {
										{ p.Name["en"] }
									}
								</h3>
								if p.ScientificName != "" {
									<p style="font-size:0.8rem; color:var(--neutral-500); margin-bottom:0.5rem;">
										{ p.ScientificName }
									</p>
								}
								if p.ManufacturingCompanies != "" {
									<div style="font-size:0.775rem; color:var(--neutral-600);">
										الشركة: { p.ManufacturingCompanies }
									</div>
								}
							</div>
							<div style="margin-top:1.5rem; border-top:1px solid var(--neutral-100); padding-top:1rem;">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-secondary" style="width:100%; font-size:0.85rem; justify-content:center;">
									@components.IconFileText("icon-xs")
									<span>التفاصيل والأسعار</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</section>
	}
}
