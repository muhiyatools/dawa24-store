package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HomeStats struct {
	TotalSuppliers int
	TotalProducts  int
	TotalCities    int
	TotalOrders    int
	TotalOffers    int
	HeroTitle      string
	HeroSubtitle   string
	HeroBadge      string
	Ads            []*promo.Ad
	DealsAds       []*promo.Ad
	BottomAds      []*promo.Ad
}

templ CustomerHome(featured []*catalog.Product, categories []*catalog.Category, offers []*promo.Offer, stats HomeStats, lang, dir string) {
	@layouts.PublicShell("دواء 24 — منصة التوريد والربط الدوائي المباشر في مصر", lang, dir) {
		
		<!-- 1. High-Contrast, Attractive Hero Section -->
		<section class="landing-hero-container">
			<div class="landing-hero-header text-center">
				<div class="hero-badge-pill">
					@components.IconShield("icon-xs text-brand")
					if stats.HeroBadge != "" {
						<span>{ stats.HeroBadge }</span>
					} else {
						<span>منظومة التوريد والربط الدوائي المباشر في مصر</span>
					}
				</div>
				
				<h1 class="landing-hero-headline text-balance">
					if stats.HeroTitle != "" {
						{ stats.HeroTitle }
					} else {
						سوق التوريد والربط الدوائي المباشر للصيدليات والمستودعات
					}
				</h1>
				
				<p class="landing-hero-subhead text-pretty">
					if stats.HeroSubtitle != "" {
						{ stats.HeroSubtitle }
					} else {
						قارن أسعار التوريد، استفد من أعلى نسب الخصم اللحظية، واطلب احتياجات صيدليتك بسلاسل تبريد موثّقة بنقرة واحدة.
					}
				</p>

				<!-- Direct Action CTAs -->
				<div class="hero-cta-group">
					<a href="/auth/register" class="btn btn-primary btn-lg font-extrabold hero-cta-btn">
						@components.IconPlus("icon-sm")
						<span>تسجيل صيدلية جديدة</span>
					</a>
					<a href="/auth/login" class="btn btn-secondary btn-lg font-bold hero-cta-btn">
						@components.IconUser("icon-sm")
						<span>تسجيل الدخول للمنظومة</span>
					</a>
					<a href="/auth/register" class="btn btn-ghost btn-lg font-bold hero-cta-btn">
						@components.IconBuilding("icon-sm")
						<span>انضمام كمورد أو مصنع</span>
					</a>
				</div>
			</div>

			<!-- 1b. Hero Sponsored Ads Showcase (if any) -->
			if len(stats.Ads) > 0 {
				<div
					class="hero-ad-showcase-container"
					x-data={ fmt.Sprintf(`{
						currentSlide: 0,
						totalSlides: %d,
						timer: null,
						startAutoplay() {
							if (this.totalSlides <= 1) return;
							this.stopAutoplay();
							this.timer = setInterval(() => {
								this.currentSlide = (this.currentSlide + 1) %% this.totalSlides;
							}, 5500);
						},
						stopAutoplay() {
							if (this.timer) {
								clearInterval(this.timer);
								this.timer = null;
							}
						},
						next() {
							this.currentSlide = (this.currentSlide + 1) %% this.totalSlides;
						},
						prev() {
							this.currentSlide = (this.currentSlide - 1 + this.totalSlides) %% this.totalSlides;
						},
						goTo(i) {
							this.currentSlide = i;
						}
					}`, len(stats.Ads)) }
					x-init="startAutoplay()"
					@mouseenter="stopAutoplay()"
					@mouseleave="startAutoplay()"
				>
					<div class="hero-ad-slider-frame">
						if len(stats.Ads) > 1 {
							<button
								type="button"
								@click.prevent.stop="prev()"
								class="hero-ad-nav-btn hero-ad-nav-prev"
								aria-label="Previous ad"
							>
								@components.IconArrowRight("icon-sm")
							</button>
						}

						for i, ad := range stats.Ads {
							if ad != nil {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/ads/click/%d", ad.ID)) }
									hx-get={ fmt.Sprintf("/ads/impression/%d", ad.ID) }
									hx-trigger="intersect once"
									class="hero-ad-slide"
									x-show={ fmt.Sprintf("currentSlide === %d", i) }
									x-cloak
									x-transition:enter="transition ease-out duration-300"
									x-transition:enter-start="opacity-0 scale-98"
									x-transition:enter-end="opacity-100 scale-100"
									x-transition:leave="transition ease-in duration-200"
									x-transition:leave-start="opacity-100 scale-100"
									x-transition:leave-end="opacity-0 scale-98"
									data-ad-id={ fmt.Sprintf("%d", ad.ID) }
								>
									<!-- Fallback Gradient Layer -->
									<div class="hero-ad-fallback-bg"></div>

									<!-- Left Content & Pricing Block -->
									<div class="hero-ad-content">
										<!-- Supplier Identity Badge (Logo + Name) -->
										<div class="hero-ad-supplier-identity">
											if ad.SupplierLogo != "" {
												<img src={ ad.SupplierLogo } alt={ ad.SupplierName } class="hero-ad-supplier-logo" />
											} else {
												<div class="hero-ad-supplier-icon-box">
													@components.IconBuilding("icon-2xs")
												</div>
											}
											<span class="hero-ad-supplier-name">
												if ad.SupplierName != "" {
													{ ad.SupplierName }
												} else {
													مورد دوائي معتمد
												}
											</span>
										</div>

										<h2 class="hero-ad-title">{ ad.DisplayTitle(lang) }</h2>
										if ad.DisplayText(lang) != "" {
											<p class="hero-ad-description">{ ad.DisplayText(lang) }</p>
										}

										<!-- Commercial B2B Pricing Pill Bar -->
										if ad.PublicPrice != "" {
											<div class="hero-ad-pricing-bar">
												if ad.PublicPrice != "سعر رسمي معتمد" {
													<div class="hero-ad-price-item">
														<span class="hero-ad-price-label">سعر الجمهور</span>
														<span class="hero-ad-public-price">{ ad.PublicPrice }</span>
													</div>
												}
												if ad.DiscountPercent != "" && ad.DiscountPercent != "خصم تجاري خاص" {
													<div class="hero-ad-discount-badge">
														<span>خصم { ad.DiscountPercent }</span>
													</div>
												}
												if ad.SupplyPrice != "" {
													<div class="hero-ad-price-item hero-ad-net-item">
														<span class="hero-ad-price-label">سعر التوريد</span>
														<span class="hero-ad-net-price">{ ad.SupplyPrice }</span>
													</div>
												}
											</div>
										}

										<div class="hero-ad-cta-pill">
											<span>اطلب الآن بالسعر المخفض</span>
											@components.IconArrowLeft("icon-2xs")
										</div>
									</div>

									<!-- Right Product Showcase Stage (Full View) -->
									<div class="hero-ad-stage">
										<div class="hero-ad-product-card">
											if (ad.MediaType == "video" || ad.IsVideo()) && ad.MediaURL != "" {
												<video
													src={ ad.MediaURL }
													poster={ ad.ThumbnailURL }
													autoplay
													muted
													loop
													playsinline
													class="hero-ad-product-video"
												></video>
											} else if ad.MediaURL != "" {
												<img
													src={ ad.MediaURL }
													alt={ ad.DisplayTitle(lang) }
													loading="eager"
													class="hero-ad-product-img"
													onerror="this.style.display='none'"
												/>
											} else {
												<div class="hero-ad-product-placeholder">
													@components.IconPill("icon-xl text-brand-400")
												</div>
											}
											if ad.DiscountPercent != "" && ad.DiscountPercent != "خصم تجاري خاص" {
												<span class="hero-ad-card-discount-tag">وفر { ad.DiscountPercent }</span>
											}
										</div>
									</div>
								</a>
							}
						}

						if len(stats.Ads) > 1 {
							<button
								type="button"
								@click.prevent.stop="next()"
								class="hero-ad-nav-btn hero-ad-nav-next"
								aria-label="Next ad"
							>
								@components.IconArrowLeft("icon-sm")
							</button>

							<div class="hero-ad-dots">
								for i := range stats.Ads {
									<button
										type="button"
										@click.prevent.stop={ fmt.Sprintf("goTo(%d)", i) }
										class="hero-ad-dot"
										:class={ fmt.Sprintf("currentSlide === %d ? 'hero-ad-dot-active' : ''", i) }
										aria-label={ fmt.Sprintf("Go to slide %d", i+1) }
									></button>
								}
							</div>
						}
					</div>
				</div>
			}

			<!-- 2. Authentic Interactive Platform Clone Preview -->
			@HeroPlatformClone()

		</section>

		<!-- 3. Key Platform Performance Metrics Strip (3 Verified Metrics) -->
		<section class="landing-metric-strip">
			<div class="metric-strip-inner">
				<div class="metric-strip-item">
					<div class="metric-strip-icon-box">
						@components.IconBuilding("icon-md")
					</div>
					<div class="stack-sm">
						<div class="metric-strip-number text-xl">
							if stats.TotalSuppliers > 0 {
								{ fmt.Sprintf("%d", stats.TotalSuppliers) }
							} else {
								47
							}
						</div>
						<div class="metric-strip-label">مورد ومستودع معتمد</div>
					</div>
				</div>

				<div class="metric-strip-divider hide-mobile"></div>

				<div class="metric-strip-item">
					<div class="metric-strip-icon-box">
						@components.IconPill("icon-md")
					</div>
					<div class="stack-sm">
						<div class="metric-strip-number text-xl">
							if stats.TotalProducts > 0 {
								{ fmt.Sprintf("%d+", stats.TotalProducts) }
							} else {
								8,340+
							}
						</div>
						<div class="metric-strip-label">صنف دوائي ومستلزمات</div>
					</div>
				</div>

				<div class="metric-strip-divider hide-mobile"></div>

				<div class="metric-strip-item">
					<div class="metric-strip-icon-box">
						@components.IconTruck("icon-md")
					</div>
					<div class="stack-sm">
						<div class="metric-strip-number text-xl">
							if stats.TotalCities > 0 {
								{ fmt.Sprintf("%d", stats.TotalCities) }
							} else {
								86
							}
						</div>
						<div class="metric-strip-label">مدينة ومنطقة مغطاة</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. Quality & Cold-Chain Operational Guarantees -->
		<section class="landing-guarantees-section">
			<div class="guarantees-header text-center mb-8">
				<h2 class="text-2xl font-black text-primary m-0">معايير وضمانات التوريد الطبي المعتمد</h2>
				<p class="text-xs text-secondary mt-1">تداول دوائي آمن وموثق يخضع لأعلى معايير سلاسل الإمداد العالمية</p>
			</div>

			<div class="guarantees-grid">
				<div class="guarantee-card">
					<div class="guarantee-icon-box">
						@components.IconShield("icon-md")
					</div>
					<h3 class="guarantee-title">موردون ومستودعات معتمدة</h3>
					<p class="guarantee-text">
						تدقيق مستمر للتراخيص والسجلات من هيئة الدواء المصرية لضمان سلامة المصادر وأصالة التشغيلات.
					</p>
				</div>

				<div class="guarantee-card">
					<div class="guarantee-icon-box">
						@components.IconTruck("icon-md")
					</div>
					<h3 class="guarantee-title">شحن وسلسلة تبريد مجهزة (Cold-Chain)</h3>
					<p class="guarantee-text">
						حاويات تبريد رقمية بمجسات حرارية لنقل الأنسولين والأمصال والأدوية الحيوية (2°C - 8°C).
					</p>
				</div>

				<div class="guarantee-card">
					<div class="guarantee-icon-box">
						@components.IconPhone("icon-md")
					</div>
					<h3 class="guarantee-title">دعم صيدلي وتقني متواصل 24/7</h3>
					<p class="guarantee-text">
						فريق صيادلة وتقنيين متخصصين لمساعدتك في تتبع الشحنات، حل نواقص الأدوية، والرد الفوري.
					</p>
				</div>
			</div>
		</section>

		if len(stats.DealsAds) > 0 {
			<section class="landing-deals-ad-section p-4 max-w-7xl mx-auto mb-8">
				<div class="d-grid grid-auto-fit-md gap-4">
					for _, dad := range stats.DealsAds {
						if dad != nil {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/ads/click/%d", dad.ID)) }
								hx-get={ fmt.Sprintf("/ads/impression/%d", dad.ID) }
								hx-trigger="intersect once"
								class="deals-ad-card p-5 rounded-3xl border border-brand-200/60 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 flex-between items-center gap-5 transition-all text-decoration-none shadow-md hover:border-brand-400"
							>
								<div class="d-flex items-center gap-4">
									<div class="w-20 h-20 rounded-2xl bg-white p-2 d-flex items-center justify-center flex-shrink-0 shadow-sm border border-slate-200 overflow-hidden">
										if (dad.MediaType == "video" || dad.IsVideo()) && dad.MediaURL != "" {
											<video src={ dad.MediaURL } autoplay muted loop playsinline class="w-full h-full object-cover rounded-xl"></video>
										} else if dad.MediaURL != "" {
											<img src={ dad.MediaURL } alt={ dad.DisplayTitle(lang) } class="w-full h-full object-contain" />
										} else {
											@components.IconPill("icon-md text-brand")
										}
									</div>
									<div class="stack-xs text-start">
										if dad.SupplierName != "" {
											<span class="text-2xs text-brand-300 font-extrabold d-block">{ dad.SupplierName }</span>
										}
										<h3 class="deals-ad-title text-base font-black text-white m-0">{ dad.DisplayTitle(lang) }</h3>
										if dad.DisplayText(lang) != "" {
											<p class="text-xs text-slate-300 m-0 line-clamp-1">{ dad.DisplayText(lang) }</p>
										}
										if dad.PublicPrice != "" && dad.PublicPrice != "سعر رسمي معتمد" {
											<div class="d-flex items-center gap-2.5 mt-1">
												<span class="text-2xs text-rose-400 line-through font-bold">{ dad.PublicPrice }</span>
												<span class="badge badge-emerald text-2xs font-black">{ dad.DiscountPercent }</span>
												<span class="text-xs font-black text-sky-400 tabular-nums">{ dad.SupplyPrice }</span>
											</div>
										}
									</div>
								</div>
								<div class="d-flex items-center gap-1.5 text-xs font-black text-sky-400 flex-shrink-0">
									<span>اطلب الآن</span>
									@components.IconArrowLeft("icon-2xs")
								</div>
							</a>
						}
					}
				</div>
			</section>
		}

		if len(stats.BottomAds) > 0 {
			<section class="landing-bottom-ad-section p-4 max-w-7xl mx-auto mb-8">
				<div class="d-grid grid-auto-fit-md gap-4">
					for _, bad := range stats.BottomAds {
						if bad != nil {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/ads/click/%d", bad.ID)) }
								hx-get={ fmt.Sprintf("/ads/impression/%d", bad.ID) }
								hx-trigger="intersect once"
								class="bottom-ad-card p-5 rounded-3xl border border-slate-700 bg-surface-sunken flex-between items-center gap-4 transition-all text-decoration-none shadow-sm hover:border-brand-500"
							>
								<div class="d-flex items-center gap-4">
									<div class="w-16 h-16 rounded-2xl bg-white p-1.5 d-flex items-center justify-center flex-shrink-0 shadow-xs border border-slate-200 overflow-hidden">
										if (bad.MediaType == "video" || bad.IsVideo()) && bad.MediaURL != "" {
											<video src={ bad.MediaURL } autoplay muted loop playsinline class="w-full h-full object-cover rounded-xl"></video>
										} else if bad.MediaURL != "" {
											<img src={ bad.MediaURL } alt={ bad.DisplayTitle(lang) } class="w-full h-full object-contain" />
										} else {
											@components.IconPill("icon-md text-brand")
										}
									</div>
									<div class="stack-xs text-start">
										if bad.SupplierName != "" {
											<span class="text-2xs text-muted font-bold d-block">{ bad.SupplierName }</span>
										}
										<h3 class="bottom-ad-title text-sm font-black text-primary m-0">{ bad.DisplayTitle(lang) }</h3>
										if bad.DisplayText(lang) != "" {
											<p class="text-xs text-secondary m-0 line-clamp-1">{ bad.DisplayText(lang) }</p>
										}
										if bad.PublicPrice != "" && bad.PublicPrice != "سعر رسمي معتمد" {
											<div class="d-flex items-center gap-2 mt-1">
												<span class="text-2xs text-rose-500 line-through font-bold">{ bad.PublicPrice }</span>
												<span class="badge badge-emerald text-2xs font-black">{ bad.DiscountPercent }</span>
												<span class="text-xs font-black text-brand tabular-nums">{ bad.SupplyPrice }</span>
											</div>
										}
									</div>
								</div>
								<div class="d-flex items-center gap-1.5 text-xs font-black text-brand flex-shrink-0">
									<span>استعراض التفاصيل</span>
									@components.IconArrowLeft("icon-2xs")
								</div>
							</a>
						}
					}
				</div>
			</section>
		}

		@components.PublicCTA("", "", lang)
	}
}