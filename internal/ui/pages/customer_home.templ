package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HomeStats struct {
	TotalSuppliers int
	TotalProducts  int
	TotalCities    int
	TotalOrders    int
}

templ CustomerHome(featured []*catalog.Product, categories []*catalog.Category, stats HomeStats, lang, dir string) {
	@layouts.PublicShell("منصة التوريد الدوائي | DAWA24", lang, dir) {
		<style>
			.hero-capsule-bg {
				position: absolute;
				top: -15px;
				inset-inline-start: -15px;
				width: 180px;
				height: 180px;
				pointer-events: none;
				opacity: 0.12;
				z-index: 0;
			}
			.product-grid-card {
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: var(--space-5);
				background: var(--surface-raised);
				transition: border-color 150ms var(--ease-default), background-color 150ms var(--ease-default);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.product-grid-card:hover {
				border-color: var(--border-strong);
			}
			.category-grid-card {
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: var(--space-5) var(--space-4);
				transition: border-color 150ms var(--ease-default), background-color 150ms var(--ease-default);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: var(--space-2);
				text-align: center;
				background-color: var(--surface-raised);
				text-decoration: none;
				color: inherit;
			}
			.category-grid-card:hover {
				border-color: var(--border-strong);
				background-color: var(--accent-subtle);
			}
			.benefits-layout {
				display: grid;
				grid-template-columns: 1fr;
				gap: var(--space-8);
				align-items: center;
			}
			@media (min-width: 840px) {
				.benefits-layout {
					grid-template-columns: 1.2fr 0.8fr;
				}
			}
		</style>

		<!-- 1. Hero Section with subtle floating capsule -->
		<section class="reveal" style="background:var(--surface-raised); padding:var(--space-12) var(--space-6); border-radius:var(--radius-lg); border:1px solid var(--border); margin-bottom:var(--space-8); text-align:center; position:relative; overflow:hidden;">
			<svg class="hero-capsule hero-capsule-bg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
				<rect x="25" y="40" width="70" height="36" rx="18" fill="var(--accent)" />
				<path d="M60 40H43C33.0589 40 25 48.0589 25 58C25 67.9411 33.0589 76 43 76H60V40Z" fill="var(--accent-hover)" />
			</svg>
			
			<h1 style="font-size:var(--text-3xl); font-weight:700; color:var(--text); margin-bottom:var(--space-3); max-width:760px; margin-inline:auto; line-height:1.25;">
				منصة التوريد الدوائي المعتمدة في مصر
			</h1>
			
			<p style="font-size:var(--text-lg); font-weight:500; color:var(--text-secondary); margin-bottom:var(--space-6); max-width:640px; margin-inline:auto;">
				ربط مباشر بين الصيدليات وكبرى شركات الأدوية والمستودعات المرخصة
			</p>

			<form action="/catalog" method="GET" style="display:flex; max-width:540px; margin:0 auto var(--space-6) auto; gap:var(--space-2);">
				<input
					type="search"
					name="q"
					placeholder="ابحث بالاسم التجاري، المادة الفعالة، أو الشركة..."
					class="form-input"
					style="flex:1; font-size:var(--text-base); padding:0.65rem 1rem; border-radius:var(--radius-md);"
				/>
				<button type="submit" class="btn btn-primary" style="padding-inline:var(--space-6); border-radius:var(--radius-md); font-weight:600;">
					@components.IconSearch("icon-sm")
					<span>بحث</span>
				</button>
			</form>
			
			<div style="display:flex; justify-content:center; gap:var(--space-4); flex-wrap:wrap;">
				<a href="/auth/register" class="btn btn-primary" style="padding:0.6rem 1.25rem; font-weight:600;">
					@components.IconPlus("icon-xs")
					<span>تسجيل صيدلية جديدة</span>
				</a>
				<a href="/auth/register" class="btn btn-secondary" style="padding:0.6rem 1.25rem; font-weight:600;">
					@components.IconBuilding("icon-xs")
					<span>انضمام كشركة أو مورد</span>
				</a>
			</div>
		</section>

		<!-- 2. Trust Strip -->
		<section class="reveal" style="display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:var(--space-6); padding:var(--space-4) var(--space-6); margin-bottom:var(--space-10); border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-raised);">
			<div style="display:flex; align-items:center; gap:var(--space-2);">
				<span class="tabular-nums" style="font-weight:700; font-size:var(--text-xl); color:var(--accent);">
					if stats.TotalSuppliers > 0 {
						{ fmt.Sprintf("%d", stats.TotalSuppliers) }
					} else {
						47
					}
				</span>
				<span style="font-weight:500; color:var(--text-secondary); font-size:var(--text-sm);">مورد معتمد</span>
			</div>
			
			<div style="border-inline-start:1px solid var(--border); height:1.5rem;" class="hide-mobile"></div>
			
			<div style="display:flex; align-items:center; gap:var(--space-2);">
				<span class="tabular-nums" style="font-weight:700; font-size:var(--text-xl); color:var(--accent);">
					if stats.TotalProducts > 0 {
						{ fmt.Sprintf("%d", stats.TotalProducts) }
					} else {
						8,340
					}
				</span>
				<span style="font-weight:500; color:var(--text-secondary); font-size:var(--text-sm);">صنف دوائي مسجل</span>
			</div>
			
			<div style="border-inline-start:1px solid var(--border); height:1.5rem;" class="hide-mobile"></div>
			
			<div style="display:flex; align-items:center; gap:var(--space-2);">
				<span class="tabular-nums" style="font-weight:700; font-size:var(--text-xl); color:var(--accent);">
					if stats.TotalCities > 0 {
						{ fmt.Sprintf("%d", stats.TotalCities) }
					} else {
						86
					}
				</span>
				<span style="font-weight:500; color:var(--text-secondary); font-size:var(--text-sm);">مدينة ومنطقة مغطاة</span>
			</div>

			<div style="border-inline-start:1px solid var(--border); height:1.5rem;" class="hide-mobile"></div>

			<div style="display:flex; align-items:center; gap:var(--space-2);">
				<span class="badge badge-emerald" style="font-weight:600;">
					@components.IconCheckCircle("icon-xs")
					<span>فواتير ضريبية معتمدة</span>
				</span>
			</div>
		</section>

		<!-- 3. Featured Products -->
		<section style="margin-bottom:var(--space-12);">
			<div class="reveal" style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:var(--space-6); border-bottom:1px solid var(--border); padding-bottom:var(--space-3);">
				<div>
					<h2 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin:0;">
						أصناف متوفرة للتوريد
					</h2>
					<p style="font-size:var(--text-sm); color:var(--text-muted); margin-top:var(--space-1); margin-bottom:0;">
						أدوية ومستلزمات صيدلانية متوفرة من كبار الموردين المعتمدين
					</p>
				</div>
				<a href="/catalog" class="btn btn-secondary btn-sm" style="font-weight:600;">
					<span>عرض كل الأصناف</span>
					@components.IconArrowLeft("icon-xs")
				</a>
			</div>
			
			if len(featured) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "جاري تحديث قائمة الأصناف المميزة",
					Message: "يمكنك استخدام شريط البحث أعلاه أو تصفح الكتالوج للوصول لكافة الأدوية.",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:var(--space-5);">
					for _, prod := range featured {
						<div class="product-grid-card">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:var(--space-3);">
									if prod.DosageForm != "" {
										<span class="badge badge-slate">
											@components.IconPill("icon-xs")
											<span>{ prod.DosageForm }</span>
										</span>
									} else {
										<span></span>
									}
									<span class="badge badge-emerald">متوفر للتوريد</span>
								</div>
								
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", prod.ID)) } style="text-decoration:none; color:inherit;">
									<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:var(--space-1); line-height:1.4;">
										if prod.Name["ar"] != "" {
											{ prod.Name["ar"] }
										} else {
											{ prod.Name["en"] }
										}
									</h3>
								</a>
								
								if prod.ScientificName != "" {
									<p style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--space-2);">
										{ prod.ScientificName }
									</p>
								}

								if prod.ManufacturingCompanies != "" {
									<div style="font-size:var(--text-xs); color:var(--text-secondary); margin-bottom:var(--space-2);">
										الشركة: { prod.ManufacturingCompanies }
									</div>
								}
							</div>
							
							<div style="margin-top:var(--space-4); padding-top:var(--space-3); border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", prod.ID)) } class="btn btn-primary btn-sm" style="width:100%; justify-content:center; font-weight:600;">
									@components.IconFileText("icon-xs")
									<span>التفاصيل والطلب</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</section>

		<!-- 4. Categories -->
		if len(categories) > 0 {
			<section class="reveal" style="margin-bottom:var(--space-12);">
				<div style="margin-bottom:var(--space-6); border-bottom:1px solid var(--border); padding-bottom:var(--space-3);">
					<h2 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin:0;">
						الأقسام والتصنيفات الدوائية
					</h2>
					<p style="font-size:var(--text-sm); color:var(--text-muted); margin-top:var(--space-1); margin-bottom:0;">
						تغطية شاملة للمجموعات العلاجية والمستلزمات الطبية
					</p>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(190px, 1fr)); gap:var(--space-4);">
					for _, cat := range categories {
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) } class="category-grid-card">
							<div style="width:38px; height:38px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconPill("icon-sm")
							</div>
							<h3 style="font-size:var(--text-sm); font-weight:600; color:var(--text); margin:0;">
								if cat.Name["ar"] != "" {
									{ cat.Name["ar"] }
								} else {
									{ cat.Name["en"] }
								}
							</h3>
						</a>
					}
				</div>
			</section>
		}

		<!-- 5. Asymmetric Benefits Section -->
		<section class="reveal" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); padding:var(--space-8) var(--space-6); margin-bottom:var(--space-12);">
			<div class="benefits-layout">
				<!-- Right Column: Structured Text List -->
				<div>
					<h2 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin-bottom:var(--space-2);">
						لماذا تعتمد الصيدليات على المنصة
					</h2>
					<p style="font-size:var(--text-sm); color:var(--text-muted); margin-bottom:var(--space-6);">
						منظومة احترافية صممت لتبسيط التوريد وتقليل التكاليف التشغيلية
					</p>

					<div style="display:flex; flex-direction:column; gap:var(--space-4);">
						<div style="display:flex; gap:var(--space-3); align-items:flex-start;">
							<div style="color:var(--accent); margin-top:2px;">
								@components.IconShield("icon-md")
							</div>
							<div>
								<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:2px;">موردون وشركات مرخصة</h3>
								<p style="font-size:var(--text-sm); color:var(--text-secondary); margin:0; line-height:1.6;">
									فحص دوري للتراخيص الصيدلية والتجارية لضمان مصداقية المصادر وأصالة المنتجات.
								</p>
							</div>
						</div>

						<div style="display:flex; gap:var(--space-3); align-items:flex-start;">
							<div style="color:var(--accent); margin-top:2px;">
								@components.IconTruck("icon-md")
							</div>
							<div>
								<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:2px;">شحن مبرد مطابق للمواصفات</h3>
								<p style="font-size:var(--text-sm); color:var(--text-secondary); margin:0; line-height:1.6;">
									تجهيزات مخصصة لسلاسل التبريد لضمان وصول الأدوية الحساسة بأعلى درجات الأمان.
								</p>
							</div>
						</div>

						<div style="display:flex; gap:var(--space-3); align-items:flex-start;">
							<div style="color:var(--accent); margin-top:2px;">
								@components.IconFileText("icon-md")
							</div>
							<div>
								<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:2px;">فواتير ضريبية إلكترونية</h3>
								<p style="font-size:var(--text-sm); color:var(--text-secondary); margin:0; line-height:1.6;">
									إصدار وتوثيق فوري مع منظومة الفاتورة الإلكترونية لتسهيل المحاسبة والامتثال.
								</p>
							</div>
						</div>

						<div style="display:flex; gap:var(--space-3); align-items:flex-start;">
							<div style="color:var(--accent); margin-top:2px;">
								@components.IconPhone("icon-md")
							</div>
							<div>
								<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:2px;">دعم صيدلي متواصل</h3>
								<p style="font-size:var(--text-sm); color:var(--text-secondary); margin:0; line-height:1.6;">
									فريق دعم متخصص لمتابعة الشحنات والرد على أي استفسارات أو نواقص دوائية.
								</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Left Column: Tinted Graphic Surface -->
				<div style="background:var(--accent-subtle); border:1px solid var(--border); border-radius:var(--radius-md); padding:var(--space-8); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; min-height:260px;">
					<div style="width:64px; height:64px; border-radius:var(--radius-full); background:var(--surface-raised); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--accent); margin-bottom:var(--space-3);">
						@components.IconShield("icon-lg")
					</div>
					<div style="font-weight:700; font-size:var(--text-lg); color:var(--accent-text); margin-bottom:var(--space-1);">
						منظومة موثقة بالكامل
					</div>
					<p style="font-size:var(--text-xs); color:var(--text-secondary); max-width:240px; margin:0; line-height:1.6;">
						حماية كاملة للمعاملات الدوائية ومطابقة لاشتراطات هيئة الدواء والضرائب المصرية
					</p>
				</div>
			</div>
		</section>

		<!-- 6. How It Works -->
		<section class="reveal" style="margin-bottom:var(--space-12); text-align:center;">
			<h2 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin-bottom:var(--space-2);">
				كيف تعمل المنصة
			</h2>
			<p style="font-size:var(--text-sm); color:var(--text-muted); margin-bottom:var(--space-8);">
				خطوات واضحة تبدأ من البحث وحتى استلام الشحنة في صيدليتك
			</p>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:var(--space-6);">
				<div class="card" style="margin-bottom:0; padding:var(--space-6); text-align:center;">
					<div style="color:var(--accent); margin-bottom:var(--space-3);">
						@components.IconSearch("icon-lg")
					</div>
					<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:var(--space-1);">ابحث وقارن</h3>
					<p style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.6; margin:0;">
						ابحث بالاسم أو الباركود وقارن بين أسعار وتواريخ صلاحية الموردين المعتمدين.
					</p>
				</div>

				<div class="card" style="margin-bottom:0; padding:var(--space-6); text-align:center;">
					<div style="color:var(--accent); margin-bottom:var(--space-3);">
						@components.IconCart("icon-lg")
					</div>
					<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:var(--space-1);">اطلب مباشرة</h3>
					<p style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.6; margin:0;">
						اجمع أصنافك من موردين مختلفين في أمر توريد منظم بضغطة زر.
					</p>
				</div>

				<div class="card" style="margin-bottom:0; padding:var(--space-6); text-align:center;">
					<div style="color:var(--accent); margin-bottom:var(--space-3);">
						@components.IconTruck("icon-lg")
					</div>
					<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin-bottom:var(--space-1);">استلم وتتبع</h3>
					<p style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.6; margin:0;">
						تتبع حالة الشحنة حتى استلامها في صيدليتك مع الفاتورة الضريبية.
					</p>
				</div>
			</div>
		</section>

		<!-- 7. Careers & Pharma Jobs Section -->
		<section class="reveal" style="margin-bottom:var(--space-12);">
			<div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:var(--space-6); border-bottom:1px solid var(--border); padding-bottom:var(--space-3);">
				<div>
					<h2 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin:0;">
						فرص التوظيف والعمل الصيدلي
					</h2>
					<p style="font-size:var(--text-sm); color:var(--text-muted); margin-top:var(--space-1); margin-bottom:0;">
						وظائف شاغرة معتمدة للصيادلة، مديري الفروع، ومندوبي الدعاية والمخازن الطبية
					</p>
				</div>
				<a href="/jobs" class="btn btn-secondary btn-sm" style="font-weight:600;">
					<span>استعراض بوابة الوظائف</span>
					@components.IconArrowLeft("icon-xs")
				</a>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:var(--space-4);">
				<div class="card" style="margin-bottom:0; padding:var(--space-5); display:flex; flex-direction:column; justify-content:space-between; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg);">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-3);">
							<span class="badge badge-sky">دوام كامل</span>
							<span style="font-size:var(--text-xs); color:var(--text-muted);">القاهرة • المعادي</span>
						</div>
						<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin-bottom:var(--space-1);">
							صيدلي مسائي / صيدلي أول
						</h3>
						<p style="font-size:var(--text-xs); color:var(--text-secondary); line-height:1.6; margin-bottom:var(--space-3);">
							إدارة صرف الوصفات الطبية، تقديم الاستشارات الدوائية للمرضى، ومتابعة مخزون الأدوية.
						</p>
					</div>
					<div style="border-top:1px solid var(--border); padding-top:var(--space-3); display:flex; justify-content:space-between; align-items:center;">
						<span class="tabular-nums" style="font-weight:700; color:var(--accent); font-size:var(--text-sm);">9,000 - 12,000 ج.م</span>
						<a href="/jobs" class="btn btn-secondary btn-sm" style="font-weight:600;">عرض والتقديم</a>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:var(--space-5); display:flex; flex-direction:column; justify-content:space-between; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg);">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-3);">
							<span class="badge badge-emerald">عمولات وبدلات</span>
							<span style="font-size:var(--text-xs); color:var(--text-muted);">الجيزة • الدقي</span>
						</div>
						<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin-bottom:var(--space-1);">
							مندوب دعاية طبية (Medical Rep)
						</h3>
						<p style="font-size:var(--text-xs); color:var(--text-secondary); line-height:1.6; margin-bottom:var(--space-3);">
							زيارة الأطباء والمراكز الطبية لترويج الأصناف الدوائية ومتابعة طلبيات التوريد مع الصيدليات.
						</p>
					</div>
					<div style="border-top:1px solid var(--border); padding-top:var(--space-3); display:flex; justify-content:space-between; align-items:center;">
						<span class="tabular-nums" style="font-weight:700; color:var(--accent); font-size:var(--text-sm);">11,000 - 16,000 ج.م</span>
						<a href="/jobs" class="btn btn-secondary btn-sm" style="font-weight:600;">عرض والتقديم</a>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:var(--space-5); display:flex; flex-direction:column; justify-content:space-between; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg);">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-3);">
							<span class="badge badge-amber">سلسلة تبريد</span>
							<span style="font-size:var(--text-xs); color:var(--text-muted);">الإسكندرية • سموحة</span>
						</div>
						<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin-bottom:var(--space-1);">
							مدير مخزن وتوزيع دوائي
						</h3>
						<p style="font-size:var(--text-xs); color:var(--text-secondary); line-height:1.6; margin-bottom:var(--space-3);">
							الإشراف على عمليات استلام وتخزين الأدوية، مراقبة درجات التبريد، وجدولة خطوط التوزيع.
						</p>
					</div>
					<div style="border-top:1px solid var(--border); padding-top:var(--space-3); display:flex; justify-content:space-between; align-items:center;">
						<span class="tabular-nums" style="font-weight:700; color:var(--accent); font-size:var(--text-sm);">14,000 - 18,000 ج.م</span>
						<a href="/jobs" class="btn btn-secondary btn-sm" style="font-weight:600;">عرض والتقديم</a>
					</div>
				</div>
			</div>
		</section>

		<!-- 8. Call To Action -->
		<section class="reveal" style="background-color:var(--accent-subtle); border:1px solid var(--border); border-radius:var(--radius-lg); padding:var(--space-10) var(--space-6); text-align:center; margin-bottom:var(--space-6);">
			<h2 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin-bottom:var(--space-2);">
				ابدأ في تطوير مشترياتك الآن
			</h2>
			<p style="font-size:var(--text-base); font-weight:500; color:var(--text-secondary); max-width:580px; margin:0 auto var(--space-6) auto; line-height:1.7;">
				انضم إلى شبكة الصيدليات والموردين المعتمدين في مصر وابدأ في إدارة طلباتك بكفاءة وأمان.
			</p>
			<div style="display:flex; justify-content:center; gap:var(--space-4); flex-wrap:wrap;">
				<a href="/auth/register" class="btn btn-primary" style="padding:0.65rem 1.5rem; font-weight:600;">
					@components.IconCheck("icon-xs")
					<span>تسجيل صيدلية الآن</span>
				</a>
				<a href="/auth/register" class="btn btn-secondary" style="padding:0.65rem 1.5rem; font-weight:600;">
					@components.IconBuilding("icon-xs")
					<span>انضمام كشركة موردة</span>
				</a>
			</div>
		</section>
	}
}
