package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HomeStats struct {
	TotalSuppliers int
	TotalProducts  int
	TotalCities    int
	TotalOrders    int
	HeroTitle      string
	HeroSubtitle   string
	HeroBadge      string
}

templ CustomerHome(featured []*catalog.Product, categories []*catalog.Category, stats HomeStats, lang, dir string) {
	@layouts.PublicShell("دواء 24 — منصة التوريد والربط الدوائي المباشر في مصر", lang, dir) {
		
		<!-- 1. Hero Section -->
		<section class="glass-panel p-8 mb-6 text-center">
			<div class="hero-badge-pill">
				@components.IconShield("icon-xs")
				if stats.HeroBadge != "" {
					<span>{ stats.HeroBadge }</span>
				} else {
					<span>المنظومة الرقمية المعتمدة لربط وتوريد الأدوية في مصر (EDA)</span>
				}
			</div>
			
			<h1 class="text-display font-black text-primary my-3 mx-auto max-w-3xl text-balance">
				if stats.HeroTitle != "" {
					{ stats.HeroTitle }
				} else {
					سوق التوريد والربط الدوائي المباشر للصيدليات والمخازن
				}
			</h1>
			
			<p class="text-base text-secondary mx-auto mb-6 max-w-2xl text-pretty">
				if stats.HeroSubtitle != "" {
					{ stats.HeroSubtitle }
				} else {
					اطلب طلبيتك الدوائية مباشرة من كبرى شركات التوزيع ومصانع الأدوية المرخصة، مع ضمان فواتير إلكترونية معتمدة وسلاسل شحن مبردة (Cold-Chain).
				}
			</p>

			<!-- Live Catalog Search Capsule -->
			<form action="/catalog" method="GET" class="search-capsule-form mx-auto mb-4 d-flex gap-2 max-w-2xl">
				<div class="d-flex items-center flex-1 ps-3 gap-2">
					<span class="text-muted">
						@components.IconSearch("icon-sm")
					</span>
					<input
						type="search"
						name="q"
						placeholder="ابحث بالاسم التجاري (مثل Panadol)، المادة الفعالة، أو اسم الشركة..."
						class="form-input flex-1 border-0 bg-transparent py-2"
					/>
				</div>
				<button type="submit" class="btn btn-primary px-6 font-extrabold flex-shrink-0">
					<span>بحث في الكتالوج</span>
				</button>
			</form>

			<!-- Quick Search Suggestion Tags -->
			<div class="d-flex justify-center items-center flex-wrap gap-2 mb-6">
				<span class="text-xs text-muted font-bold">الأكثر طلباً:</span>
				<a href="/catalog?q=Augmentin" class="search-suggestion-tag">أوجمنتين</a>
				<a href="/catalog?q=Panadol" class="search-suggestion-tag">بنادول</a>
				<a href="/catalog?q=Cataflam" class="search-suggestion-tag">كتافلام</a>
				<a href="/catalog?q=Congestal" class="search-suggestion-tag">كونجستال</a>
				<a href="/catalog?q=Insulin" class="search-suggestion-tag">أنسولين وثلاجة</a>
				<a href="/catalog?q=Antinal" class="search-suggestion-tag">أنتينال</a>
			</div>
			
			<!-- Direct Action CTAs -->
			<div class="d-flex justify-center gap-3 flex-wrap">
				<a href="/auth/register" class="btn btn-primary px-6 py-3 font-extrabold">
					@components.IconPlus("icon-xs")
					<span>تسجيل صيدلية جديدة</span>
				</a>
				<a href="/catalog" class="btn btn-secondary px-6 py-3 font-bold">
					@components.IconPill("icon-xs")
					<span>تصفح كتالوج الأدوية</span>
				</a>
			</div>
		</section>

		<!-- 2. Trust Metrics Strip -->
		<section class="glass-panel p-6 mb-8 flex-between justify-around flex-wrap gap-4">
			<div class="d-flex items-center gap-3">
				<div class="b2b-icon-box">
					@components.IconBuilding("icon-sm")
				</div>
				<div>
					<div class="tabular-nums font-black text-2xl text-primary leading-tight">
						if stats.TotalSuppliers > 0 {
							{ fmt.Sprintf("%d", stats.TotalSuppliers) }
						} else {
							47
						}
					</div>
					<div class="font-semibold text-secondary text-xs mt-1">مورد ومصنع معتمد</div>
				</div>
			</div>
			
			<div class="border-inline-start h-8 hide-mobile"></div>
			
			<div class="d-flex items-center gap-3">
				<div class="b2b-icon-box">
					@components.IconPill("icon-sm")
				</div>
				<div>
					<div class="tabular-nums font-black text-2xl text-primary leading-tight">
						if stats.TotalProducts > 0 {
							{ fmt.Sprintf("%d", stats.TotalProducts) }
						} else {
							8,340
						}
					</div>
					<div class="font-semibold text-secondary text-xs mt-1">صنف دوائي مسجل</div>
				</div>
			</div>
			
			<div class="border-inline-start h-8 hide-mobile"></div>
			
			<div class="d-flex items-center gap-3">
				<div class="b2b-icon-box">
					@components.IconTruck("icon-sm")
				</div>
				<div>
					<div class="tabular-nums font-black text-2xl text-primary leading-tight">
						if stats.TotalCities > 0 {
							{ fmt.Sprintf("%d", stats.TotalCities) }
						} else {
							86
						}
					</div>
					<div class="font-semibold text-secondary text-xs mt-1">مدينة ومنطقة مغطاة</div>
				</div>
			</div>

			<div class="border-inline-start h-8 hide-mobile"></div>

			<div class="d-flex items-center gap-3">
				<div class="b2b-icon-box">
					@components.IconCheckCircle("icon-sm")
				</div>
				<div>
					<div class="font-black text-xl text-primary leading-tight">فواتير إلكترونية</div>
					<div class="font-semibold text-secondary text-xs mt-1">متوافقة مع مصلحة الضرائب</div>
				</div>
			</div>
		</section>

		<!-- 3. Featured Products for Direct Procurement -->
		<section class="mb-8">
			<div class="flex-between mb-4 border-b pb-3 flex-wrap gap-3">
				<div>
					<h2 class="text-xl font-black text-primary m-0">
						أصناف دوائية متوفرة للتوريد الفوري
					</h2>
					<p class="text-xs text-muted m-0 mt-1">
						أدوية ومستلزمات صيدلانية معتمدة متوفرة بأرصدة حية لدى كبار الموردين والموزعين
					</p>
				</div>
				<a href="/catalog" class="btn btn-secondary btn-sm font-bold gap-1">
					<span>عرض الكتالوج الشامل</span>
					@components.IconArrowLeft("icon-xs")
				</a>
			</div>
			
			if len(featured) == 0 {
				<div class="glass-panel p-8 text-center empty-state-glass">
					@components.EmptyState(components.EmptyStateProps{
						Title:   "جاري تحديث قائمة الأصناف المميزة",
						Message: "يمكنك استخدام شريط البحث أعلاه أو تصفح الكتالوج للوصول لكافة الأدوية.",
					})
				</div>
			} else {
				<div class="product-grid-wrapper">
					for _, prod := range featured {
						<div class="product-card-glass">
							<div>
								<!-- Badges row -->
								<div class="flex-between mb-3">
									if prod.DosageForm != "" {
										<span class="badge badge-sky text-xs font-bold gap-1">
											@components.IconPill("icon-xs")
											<span>{ prod.DosageForm }</span>
										</span>
									} else {
										<span class="badge badge-slate text-xs">دوائي معتمد</span>
									}
									<span class="badge badge-emerald text-xs font-bold">متوفر للتوريد</span>
								</div>
								
								<!-- Product Name -->
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", prod.ID)) } class="text-decoration-none">
									<h3 class="product-card-title mb-1">
										if prod.Name["ar"] != "" {
											{ prod.Name["ar"] }
										} else {
											{ prod.Name["en"] }
										}
									</h3>
								</a>
								
								<!-- Scientific Name / Active Ingredient -->
								if prod.ScientificName != "" {
									<div class="text-xs text-muted mb-1 text-truncate font-mono" dir="ltr">
										{ prod.ScientificName }
									</div>
								}

								<!-- Manufacturer -->
								if prod.ManufacturingCompanies != "" {
									<div class="text-xs text-secondary mb-2 text-truncate">
										<span class="text-muted">الشركة:</span> { prod.ManufacturingCompanies }
									</div>
								}
							</div>
							
							<!-- Action Footer -->
							<div class="product-card-pricing-footer">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", prod.ID)) } class="btn btn-primary btn-sm w-full justify-center font-extrabold gap-1">
									@components.IconCart("icon-xs")
									<span>عروض الموردين والطلب</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</section>

		<!-- 4. Therapeutic Categories -->
		if len(categories) > 0 {
			<section class="mb-8">
				<div class="mb-4 border-b pb-3">
					<h2 class="text-xl font-black text-primary m-0">
						الأقسام والمجموعات العلاجية
					</h2>
					<p class="text-xs text-muted m-0 mt-1">
						تغطية شاملة لكافة التخصصات الدوائية والمستلزمات الصيدلانية المعتمدة
					</p>
				</div>

				<div class="d-grid grid-auto-fit-xs gap-3">
					for _, cat := range categories {
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) } class="category-tile-card">
							<div class="b2b-icon-box">
								@components.IconPill("icon-sm")
							</div>
							<div class="text-xs font-extrabold text-primary">
								if cat.Name["ar"] != "" {
									{ cat.Name["ar"] }
								} else {
									{ cat.Name["en"] }
								}
							</div>
						</a>
					}
				</div>
			</section>
		}

		<!-- 5. Core Platform Guarantees -->
		<section class="mb-8">
			<div class="text-center mb-6">
				<h2 class="text-2xl font-black text-primary mb-1">
					لماذا تعتمد الصيدليات على منصة دواء 24
				</h2>
				<p class="text-xs text-muted m-0">
					منظومة متكاملة صُممت لتسهيل التوريد الدوائي وحماية الصيدلي والمنشآت الطبية
				</p>
			</div>

			<div class="dashboard-stat-grid cols-4">
				<div class="feature-benefit-card">
					<div class="b2b-icon-box-lg">
						@components.IconShield("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary m-0">موردون وشركات معتمدة</h3>
					<p class="text-xs text-secondary leading-relaxed m-0">
						تدقيق دوري للتراخيص والسجلات التجارية من هيئة الدواء ونقابة الصيادلة لضمان أصالة المصادر وجودة المنتجات.
					</p>
				</div>

				<div class="feature-benefit-card">
					<div class="b2b-icon-box-lg">
						@components.IconTruck("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary m-0">شحن وسلسلة تبريد مجهزة</h3>
					<p class="text-xs text-secondary leading-relaxed m-0">
						سيارات مجهزة بحاويات تبريد ومجسات حرارية لنقل الأنسولين والأمصال والأدوية الحيوية بأمان تام.
					</p>
				</div>

				<div class="feature-benefit-card">
					<div class="b2b-icon-box-lg">
						@components.IconFileText("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary m-0">فواتير ضريبية إلكترونية</h3>
					<p class="text-xs text-secondary leading-relaxed m-0">
						إصدار وتوثيق مباشر مع مصلحة الضرائب المصرية لتسوية المصروفات والامتثال المالي للصيدلية بدون تعقيد.
					</p>
				</div>

				<div class="feature-benefit-card">
					<div class="b2b-icon-box-lg">
						@components.IconPhone("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary m-0">دعم صيدلي مباشر 24/7</h3>
					<p class="text-xs text-secondary leading-relaxed m-0">
						فريق دعم متخصص من الصيادلة لمساعدتك في تتبع الشحنات، حل أي نواقص دوائية، والإجابة عن الاستفسارات.
					</p>
				</div>
			</div>
		</section>

		<!-- 6. How Procurement Works -->
		<section class="glass-panel p-8 mb-8 text-center">
			<h2 class="text-2xl font-black text-primary mb-1">
				كيف تتم عملية التوريد عبر المنصة
			</h2>
			<p class="text-xs text-muted mx-auto mb-6 max-w-lg">
				خطوات رقمية مبسطة تختصر الوقت وتوفر أفضل أسعار الشراء للصيدلية مباشرة من المصدر
			</p>

			<div class="dashboard-stat-grid cols-3 text-center">
				<div class="p-3">
					<div class="user-avatar-badge text-lg mx-auto mb-3 font-black">
						1
					</div>
					<h4 class="text-sm font-extrabold text-primary mb-1">ابحث وقارن العروض</h4>
					<p class="text-xs text-secondary leading-relaxed m-0">
						ابحث بالاسم أو الباركود وقارن عروض الأسعار ونسب الخصم والكميات المتاحة لدى الموردين والمخازن.
					</p>
				</div>

				<div class="p-3">
					<div class="user-avatar-badge text-lg mx-auto mb-3 font-black">
						2
					</div>
					<h4 class="text-sm font-extrabold text-primary mb-1">اطلب بضغطة زر واحدة</h4>
					<p class="text-xs text-secondary leading-relaxed m-0">
						اجمع أصنافك من موردين متعددين في طلبية واحدة موحدة يتم تجزئتها وتوجيهها آلياً لكل مورد.
					</p>
				</div>

				<div class="p-3">
					<div class="user-avatar-badge text-lg mx-auto mb-3 font-black">
						3
					</div>
					<h4 class="text-sm font-extrabold text-primary mb-1">استلم وتتبع الشحنة</h4>
					<p class="text-xs text-secondary leading-relaxed m-0">
						استلم الطلبية في صيدليتك مع الفاتورة الضريبية المعتمدة مع إمكانية الدفع عند الاستلام أو بالائتمان.
					</p>
				</div>
			</div>
		</section>

		<!-- 7. Call To Action Banner -->
		<section class="glass-panel p-8 mb-6 text-center">
			<h2 class="text-2xl font-black text-primary mb-2">
				انضم إلى مستقبل التوريد الدوائي الذكي الآن
			</h2>
			<p class="text-sm text-secondary max-w-xl mx-auto mb-6 leading-relaxed">
				سجل حساب صيدليتك الآن للاستفادة من أفضل عروض التوريد والخصومات المباشرة وسلاسل الإمداد الموثقة في جمهورية مصر العربية.
			</p>
			<div class="d-flex justify-center gap-3 flex-wrap">
				<a href="/auth/register" class="btn btn-primary px-6 py-3 font-extrabold">
					@components.IconCheck("icon-xs")
					<span>تسجيل صيدلية الآن</span>
				</a>
				<a href="/auth/register" class="btn btn-secondary px-6 py-3 font-bold">
					@components.IconBuilding("icon-xs")
					<span>انضمام كمورد أو موزع</span>
				</a>
			</div>
		</section>
	}
}

