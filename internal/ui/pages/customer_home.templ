package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HomeStats struct {
	TotalSuppliers int
	TotalProducts  int
	TotalCities    int
	TotalOrders    int
}

templ CustomerHome(featured []*catalog.Product, categories []*catalog.Category, stats HomeStats, lang, dir string) {
	@layouts.CustomerShell("منصة دوا 24 الدوائية الذكية | DAWA24", lang, dir) {
		<!-- 1. Hero Section -->
		<section style="background:#ffffff; padding:4rem 2rem; border-radius:var(--radius-2xl); border:1px solid var(--border-card); margin-bottom:3rem; text-align:center; box-shadow:var(--shadow-sm); position:relative; overflow:hidden;">
			<div style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.4rem 1rem; border-radius:var(--radius-full); background:var(--primary-50); color:var(--primary-700); font-weight:800; font-size:0.875rem; margin-bottom:1.25rem; border:1px solid var(--primary-200);">
				@components.IconShield("icon-xs")
				<span>منظومة التوريد الدوائي الذكية الأولى في مصر</span>
			</div>

			<h1 style="font-size:2.75rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.75rem; letter-spacing:-0.02em; line-height:1.25;">
				منصة دوا 24 الدوائية الذكية
			</h1>
			
			<p style="font-size:1.35rem; font-weight:700; color:var(--primary-700); margin-bottom:1rem;">
				قارن أسعار – اطلب مباشرة – تعامل بأمان
			</p>

			<p style="color:var(--neutral-600); font-size:1.05rem; max-width:700px; margin:0 auto 2.25rem auto; line-height:1.8;">
				الربط المباشر بين الصيدليات والمراكز الطبية وكبرى شركات ومستودعات الأدوية المعتمدة مع توثيق الفواتير الإلكترونية وضمان سلاسل التبريد.
			</p>

			<!-- Search System -->
			<form action="/catalog" method="GET" style="max-width:680px; margin:0 auto; display:flex; gap:0.5rem;">
				<div style="position:relative; flex:1;">
					<input
						type="search"
						name="q"
						placeholder="ابحث باسم الدواء التجاري، المادة الفعالة، الشركة، أو الباركود..."
						class="form-input"
						style="font-size:1rem; padding:0.875rem 1.25rem; width:100%; border-radius:var(--radius-lg);"
					/>
				</div>
				<button type="submit" class="btn btn-primary" style="padding-inline:2rem; border-radius:var(--radius-lg); font-size:1rem; font-weight:700;">
					@components.IconSearch("icon-sm")
					<span>بحث</span>
				</button>
			</form>

			<div style="display:flex; justify-content:center; gap:1.5rem; margin-top:1.75rem; flex-wrap:wrap;">
				<a href="/auth/register" class="btn btn-secondary btn-sm" style="font-weight:700;">
					@components.IconPlus("icon-xs")
					<span>تسجيل صيدلية جديدة</span>
				</a>
				<a href="/onboarding" class="btn btn-secondary btn-sm" style="font-weight:700;">
					@components.IconBuilding("icon-xs")
					<span>انضمام كشركة أو مورد</span>
				</a>
			</div>
		</section>

		<!-- 2. Real Platform Statistics -->
		<section style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem; margin-bottom:3.5rem;">
			<div class="card hover-lift" style="text-align:center; padding:1.75rem 1.25rem; margin-bottom:0;">
				<div style="font-size:2.25rem; font-weight:900; color:var(--primary-600); margin-bottom:0.25rem;" class="tabular-nums">
					if stats.TotalSuppliers > 0 {
						{ fmt.Sprintf("%d+", stats.TotalSuppliers) }
					} else {
						23+
					}
				</div>
				<div style="font-weight:700; color:var(--neutral-800); font-size:1rem;">مورّد معتمد ونشط</div>
				<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.25rem;">شركات وموزعون مرخصون</div>
			</div>

			<div class="card hover-lift" style="text-align:center; padding:1.75rem 1.25rem; margin-bottom:0;">
				<div style="font-size:2.25rem; font-weight:900; color:var(--primary-600); margin-bottom:0.25rem;" class="tabular-nums">
					if stats.TotalProducts > 0 {
						{ fmt.Sprintf("%d+", stats.TotalProducts) }
					} else {
						25,042+
					}
				</div>
				<div style="font-weight:700; color:var(--neutral-800); font-size:1rem;">صنف ومنتج صيدلاني</div>
				<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.25rem;">أدوية ومستلزمات مسجلة</div>
			</div>

			<div class="card hover-lift" style="text-align:center; padding:1.75rem 1.25rem; margin-bottom:0;">
				<div style="font-size:2.25rem; font-weight:900; color:var(--primary-600); margin-bottom:0.25rem;" class="tabular-nums">
					if stats.TotalCities > 0 {
						{ fmt.Sprintf("%d+", stats.TotalCities) }
					} else {
						333+
					}
				</div>
				<div style="font-weight:700; color:var(--neutral-800); font-size:1rem;">مدينة ومنطقة مغطاة</div>
				<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.25rem;">توصيل سريع لكافة المحافظات</div>
			</div>

			<div class="card hover-lift" style="text-align:center; padding:1.75rem 1.25rem; margin-bottom:0;">
				<div style="font-size:2.25rem; font-weight:900; color:var(--primary-600); margin-bottom:0.25rem;" class="tabular-nums">
					100%
				</div>
				<div style="font-weight:700; color:var(--neutral-800); font-size:1rem;">فواتير وتتبع معتمد</div>
				<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.25rem;">مطابقة لهيئة الدواء والضرائب</div>
			</div>
		</section>

		<!-- 3. Featured Products (أبرز المنتجات والأدوية المتاحة) -->
		<section style="margin-bottom:3.5rem;">
			<div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:1.75rem;">
				<div>
					<div style="font-size:0.85rem; font-weight:800; color:var(--primary-700); margin-bottom:0.25rem;">أصناف ومنتجات صيدلانية بارزة</div>
					<h2 style="font-size:1.65rem; font-weight:900; color:var(--neutral-900); margin:0;">
						أبرز المنتجات والأدوية المتاحة (Featured Products)
					</h2>
					<p style="font-size:0.9rem; color:var(--neutral-500); margin-top:0.25rem;">
						اطلب مباشرة من قائمة الأصناف المتوفرة بأسعار تنافسية ومضمونة من كبار الموردين
					</p>
				</div>
				<a href="/catalog" class="btn btn-secondary" style="font-weight:700;">
					<span>عرض كل الأصناف ({ fmt.Sprintf("%d", stats.TotalProducts) })</span>
					@components.IconArrowLeft("icon-xs")
				</a>
			</div>

			if len(featured) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "جاري تحديث قائمة الأصناف المميزة",
					Message: "يمكنك استخدام شريط البحث أعلاه أو تصفح الكتالوج للوصول لكافة الأدوية.",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(270px, 1fr)); gap:1.5rem;">
					for _, p := range featured {
						<div class="card hover-lift" style="display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0; padding:1.5rem; position:relative;">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem;">
									<span class="badge badge-slate" style="font-size:0.75rem;">
										@components.IconPill("icon-xs")
										<span>{ p.DosageForm }</span>
									</span>
									<span class="badge badge-emerald" style="font-size:0.75rem;">متوفر للتوريد</span>
								</div>

								<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.25rem; line-height:1.4;">
									if p.Name["ar"] != "" {
										{ p.Name["ar"] }
									} else {
										{ p.Name["en"] }
									}
								</h3>

								if p.ScientificName != "" {
									<p style="font-size:0.825rem; color:var(--neutral-500); margin-bottom:0.5rem;">
										{ p.ScientificName }
									</p>
								}

								if p.ManufacturingCompanies != "" {
									<div style="font-size:0.8rem; color:var(--neutral-600); margin-bottom:0.35rem;">
										الشركة: <strong>{ p.ManufacturingCompanies }</strong>
									</div>
								}

								if p.Barcode != "" {
									<div style="font-size:0.75rem; color:var(--neutral-400);" class="tabular-nums">
										باركود: { p.Barcode }
									</div>
								}
							</div>

							<div style="margin-top:1.5rem; border-top:1px solid var(--neutral-100); padding-top:1rem; display:flex; justify-content:space-between; align-items:center;">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-primary btn-sm" style="flex:1; justify-content:center; font-weight:700;">
									@components.IconFileText("icon-xs")
									<span>التفاصيل والطلب</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</section>

		<!-- 4. Therapeutic Categories -->
		if len(categories) > 0 {
			<section style="margin-bottom:3.5rem;">
				<div style="text-align:center; margin-bottom:2rem;">
					<h2 style="font-size:1.65rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.35rem;">
						تصفح حسب الأقسام والتصنيفات الدوائية
					</h2>
					<p style="color:var(--neutral-500); font-size:0.95rem;">تغطية شاملة لكافة المجموعات العلاجية والمستلزمات الطبية</p>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:1.25rem;">
					for _, cat := range categories {
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) } class="card hover-lift" style="text-align:center; padding:1.5rem 1rem; margin-bottom:0; text-decoration:none; display:flex; flex-direction:column; align-items:center; justify-content:center;">
							<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:0.75rem;">
								@components.IconPill("icon-sm")
							</div>
							<h3 style="font-size:1rem; font-weight:800; color:var(--neutral-900); margin:0;">
								if cat.Name["ar"] != "" {
									{ cat.Name["ar"] }
								} else {
									{ cat.Name["en"] }
								}
							</h3>
						</a>
					}
				</div>
			</section>
		}

		<!-- 5. Key Platform Benefits -->
		<section style="background:#ffffff; border:1px solid var(--border-card); border-radius:var(--radius-2xl); padding:3.5rem 2.5rem; margin-bottom:3.5rem;">
			<div style="text-align:center; margin-bottom:2.75rem;">
				<h2 style="font-size:1.75rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.5rem;">
					لماذا تعتمد الصيدليات على منصة دواء 24؟
				</h2>
				<p style="color:var(--neutral-500); font-size:1rem;">مزايا احترافية صممت لتبسيط التوريد وتقليل التكاليف التشغيلية</p>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:2rem;">
				<div style="display:flex; gap:1rem; align-items:flex-start;">
					<div style="width:48px; height:48px; border-radius:var(--radius-lg); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconShield("icon-md")
					</div>
					<div>
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">موردون وشركات معتمدة 100%</h3>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">فحص دوري لكافة التراخيص الصيدلية والتجارية لضمان مصداقية المصادر وأصالة المنتجات.</p>
					</div>
				</div>

				<div style="display:flex; gap:1rem; align-items:flex-start;">
					<div style="width:48px; height:48px; border-radius:var(--radius-lg); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconTruck("icon-md")
					</div>
					<div>
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">شحن وتبريد مطابق للمواصفات</h3>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">سيارات مجهزة بسلسلة تبريد (Cold-Chain) متطورة لضمان وصول الأدوية الحساسة بأعلى كفاءة.</p>
					</div>
				</div>

				<div style="display:flex; gap:1rem; align-items:flex-start;">
					<div style="width:48px; height:48px; border-radius:var(--radius-lg); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconFileText("icon-md")
					</div>
					<div>
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">فواتير ضريبية إلكترونية فورية</h3>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">إصدار ومزامنة فورية مع منظومة الفاتورة الإلكترونية لضبط الحسابات وتفادي الغرامات.</p>
					</div>
				</div>

				<div style="display:flex; gap:1rem; align-items:flex-start;">
					<div style="width:48px; height:48px; border-radius:var(--radius-lg); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconPhone("icon-md")
					</div>
					<div>
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">دعم فني صيدلي متواصل 24/7</h3>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">فريق دعم صيدلي متخصص لمتابعة الشحنات وحل أي استفسارات أو نواقص دوائية عاجلة.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. How It Works -->
		<section style="margin-bottom:3.5rem; text-align:center;">
			<h2 style="font-size:1.75rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.5rem;">
				كيف تعمل المنصة؟
			</h2>
			<p style="color:var(--neutral-500); font-size:1rem; margin-bottom:2.5rem;">رحلة شراء سهلة وسريعة من البحث حتى استلام الشحنة في صيدليتك</p>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem;">
				<div class="card" style="margin-bottom:0; padding:1.75rem 1.25rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--primary-600); color:#fff; font-weight:900; font-size:1.1rem; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;" class="tabular-nums">1</div>
					<h3 style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">ابحث وقارن العروض</h3>
					<p style="font-size:0.85rem; color:var(--neutral-600); line-height:1.6;">ابحث بالاسم أو الباركود وقارن بين أسعار وتواريخ صلاحية الموردين المعتمدين.</p>
				</div>

				<div class="card" style="margin-bottom:0; padding:1.75rem 1.25rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--primary-600); color:#fff; font-weight:900; font-size:1.1rem; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;" class="tabular-nums">2</div>
					<h3 style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">أضف لسلة موحدة</h3>
					<p style="font-size:0.85rem; color:var(--neutral-600); line-height:1.6;">اجمع أصنافك من موردين مختلفين في أمر توريد واحد بضغطة زر.</p>
				</div>

				<div class="card" style="margin-bottom:0; padding:1.75rem 1.25rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--primary-600); color:#fff; font-weight:900; font-size:1.1rem; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;" class="tabular-nums">3</div>
					<h3 style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">تأكيد وتتبع الشحن</h3>
					<p style="font-size:0.85rem; color:var(--neutral-600); line-height:1.6;">يتم تجهيز الشحنات وإرسال إشعارات التتبع المباشرة لحظة بلحظة.</p>
				</div>

				<div class="card" style="margin-bottom:0; padding:1.75rem 1.25rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--primary-600); color:#fff; font-weight:900; font-size:1.1rem; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;" class="tabular-nums">4</div>
					<h3 style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">الاستلام والفاتورة</h3>
					<p style="font-size:0.85rem; color:var(--neutral-600); line-height:1.6;">استلم طلبيتك مع الفاتورة الضريبية المعتمدة وخيارات الدفع المرنة.</p>
				</div>
			</div>
		</section>

		<!-- 7. Call To Action -->
		<section style="background:linear-gradient(135deg, var(--primary-700) 0%, var(--primary-900) 100%); color:#ffffff; border-radius:var(--radius-2xl); padding:3.5rem 2rem; text-align:center; margin-bottom:3rem; box-shadow:var(--shadow-lg);">
			<h2 style="font-size:2rem; font-weight:900; color:#ffffff; margin-bottom:0.75rem;">
				جاهز لتطوير أعمال صيدليتك أو توسيع شبكة توزيعك؟
			</h2>
			<p style="color:var(--primary-100); font-size:1.05rem; max-width:600px; margin:0 auto 2rem auto; line-height:1.8;">
				انضم الآن إلى أكبر شبكة دوائية ذكية في مصر وابدأ في إدارة مشترياتك ومبيعاتك بكفاءة وأمان تام.
			</p>
			<div style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
				<a href="/auth/register" class="btn" style="background:#ffffff; color:var(--primary-800); font-size:1rem; font-weight:800; padding:0.75rem 2rem;">
					@components.IconCheck("icon-xs")
					<span>تسجيل صيدلية الآن مجاناً</span>
				</a>
				<a href="/onboarding" class="btn" style="background:rgba(255,255,255,0.15); color:#ffffff; border:1px solid rgba(255,255,255,0.4); font-size:1rem; font-weight:700; padding:0.75rem 2rem;">
					@components.IconBuilding("icon-xs")
					<span>انضمام كشركة موردة</span>
				</a>
			</div>
		</section>
	}
}
