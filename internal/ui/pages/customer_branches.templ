package pages

import (
	"fmt"
	"strings"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerBranchesData struct {
	Branches   []*org.Branch
	Employees  []*org.EmployeeView
	Cities     []*platformadmin.City
	ActiveTab  string // "branches" or "employees"
	NoticeType string
	NoticeMsg  string
}

func (d CustomerBranchesData) GetBranchEmployees(branchID int64) []*org.EmployeeView {
	var list []*org.EmployeeView
	for _, emp := range d.Employees {
		if emp != nil && emp.Member != nil && emp.Member.BranchID != nil && *emp.Member.BranchID == branchID {
			list = append(list, emp)
		}
	}
	return list
}

func (d CustomerBranchesData) GetBranchName(branchID *int64) string {
	if branchID == nil || *branchID <= 0 {
		return "غير محدد بفرع معين"
	}
	for _, b := range d.Branches {
		if b != nil && b.ID == *branchID {
			if b.Name["ar"] != "" {
				return b.Name["ar"]
			}
			return b.Name["en"]
		}
	}
	return fmt.Sprintf("فرع رقم #%d", *branchID)
}

func (d CustomerBranchesData) GetMainBranch() *org.Branch {
	for _, b := range d.Branches {
		if b != nil && b.IsMain {
			return b
		}
	}
	if len(d.Branches) > 0 {
		return d.Branches[0]
	}
	return nil
}

func cbRoleLabelArabic(key string) string {
	switch key {
	case "org_admin", "admin", "org_owner", "owner":
		return "مدير عام المؤسسة"
	case "org_manager", "manager":
		return "مدير فرع / صيدلية"
	case "org_pharmacist", "pharmacist":
		return "صيدلي مسؤول"
	case "org_accountant", "accountant":
		return "محاسب / مسؤول مشتريات"
	case "org_warehouse", "warehouse":
		return "أمين مخزن / استلام"
	case "org_employee", "employee":
		return "موظف صيدلية / فرع"
	default:
		if strings.HasPrefix(key, "org_") {
			return strings.TrimPrefix(key, "org_")
		}
		return key
	}
}

func cbRoleBadgeClass(key string) string {
	switch key {
	case "org_admin", "admin", "org_owner", "owner":
		return "badge-primary"
	case "org_manager", "manager":
		return "badge-emerald"
	case "org_pharmacist", "pharmacist":
		return "badge-sky"
	case "org_accountant", "accountant":
		return "badge-amber"
	case "org_warehouse", "warehouse":
		return "badge-slate"
	default:
		return "badge-secondary"
	}
}

templ CustomerBranches(data CustomerBranchesData, lang string, dir string, perms []string) {
	@layouts.CustomerShell(i18n.T(lang, "nav.pharmacy_branches"), "branches", lang, dir, perms) {
		<div x-data="customerBranchManager()" x-init="init()" class="page-container">
			
			<!-- Notice Feedback Banner -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-4 p-4 flex-between">
						<div class="d-flex items-center gap-3 font-extrabold text-sm">
							<span class="text-2xl">@components.IconAlert("icon-sm")</span>
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 flex-between">
						<div class="d-flex items-center gap-3 font-extrabold text-sm">
							<span class="text-2xl">@components.IconCheckCircle("icon-sm")</span>
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				}
			}
			
			<!-- Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4">
					<div>
						<h2 class="text-2xl font-black text-primary m-0 mb-1">
							إدارة الفروع ومستخدمي الصيدلية
						</h2>
						<p class="text-sm text-secondary m-0 max-w-2xl leading-relaxed">
							إدارة شبكة الفروع ومواقع الاستلام الجغرافية، وتعيين الموظفين والصيادلة لكل فرع وتحديد أدوارهم وصلاحياتهم.
						</p>
					</div>
					<div class="d-flex items-center gap-3 flex-wrap">
						<button type="button" class="btn btn-secondary btn-sm font-bold gap-2" onclick="openAddEmployeeModal()" data-modal-open="add-employee-modal">
							@components.IconUser("icon-xs")
							<span>+ إضافة مستخدم / موظف</span>
						</button>
						<button type="button" class="btn btn-primary btn-sm font-bold gap-2" @click="resetToAddMode(); switchCustomerBranchTab('branches'); document.getElementById('new-branch-form').scrollIntoView({behavior:'smooth'});">
							@components.IconPlus("icon-xs")
							<span>+ إضافة فرع جديد</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Metrics Strip -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label">
						إجمالي الفروع المسجلة
					</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", len(data.Branches)) } <span class="text-xs font-semibold text-secondary">فروع</span>
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">
						الفرع الرئيسي للاستلام
					</div>
					<div class="text-lg font-black text-brand truncate mt-1">
						if mb := data.GetMainBranch(); mb != nil {
							<span>{ mb.Name.Get(i18n.ParseLang(lang)) }</span>
						} else {
							<span>غير محدد</span>
						}
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">
						الموظفون والصيادلة
					</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", len(data.Employees)) } <span class="text-xs font-semibold text-secondary">مستخدمين</span>
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">
						حالة التغطية والشحن
					</div>
					<div class="d-flex items-center gap-2 mt-2">
						<span class="badge badge-emerald text-xs font-bold gap-1">
							@components.IconCheckCircle("icon-xs")
							<span>جاهز لتلقي طلبيات التوريد</span>
						</span>
					</div>
				</div>
			</div>

			<!-- Navigation Tabs -->
			<div class="cb-tabs-nav mb-6">
				<button
					type="button"
					id="cb-tab-btn-branches"
					onclick="switchCustomerBranchTab('branches')"
					class={ "cb-tab-btn", templ.KV("active", data.ActiveTab != "employees") }
				>
					@components.IconBuilding("icon-xs")
					<span>شبكة الفروع ومواقع الاستلام ({ fmt.Sprintf("%d", len(data.Branches)) })</span>
				</button>
				<button
					type="button"
					id="cb-tab-btn-employees"
					onclick="switchCustomerBranchTab('employees')"
					class={ "cb-tab-btn", templ.KV("active", data.ActiveTab == "employees") }
				>
					@components.IconUser("icon-xs")
					<span>موظفو ومستخدمو الفروع والصلاحيات ({ fmt.Sprintf("%d", len(data.Employees)) })</span>
				</button>
			</div>

			<!-- TAB 1: Branches Network Content -->
			<div id="cb-tab-panel-branches" style={ fmt.Sprintf("display: %s;", func() string { if data.ActiveTab == "employees" { return "none" }; return "block" }()) }>
				<div class="cb-split-grid">
					
					<!-- Left Column: Existing Pharmacy Branches List -->
					<div>
						<div>
							<div class="d-flex items-center gap-2">
								@components.IconBuilding("icon-xs")
								<span>فروع الصيدلية المعتمدة</span>
							</div>
							<span class="badge badge-sky text-xs fw-700">{ fmt.Sprintf("%d فروع", len(data.Branches)) }</span>
						</div>

						if len(data.Branches) == 0 {
							<div>
								<div>@components.IconBuilding("icon-sm")</div>
								<h3>لم تقم بإضافة فروع بعد</h3>
								<p>أضف فرع صيدليتك الرئيسي لتتمكن من تصفح العروض وتحديد نطاق التوريد المتاح لمنطقتك.</p>
							</div>
						} else {
							<div>
								for _, b := range data.Branches {
									<div class="cb-branch-card">
										<div>
											<div>
												<div class="inline-row-wrap">
													<strong>
														if b.Name["ar"] != "" {
															{ b.Name["ar"] }
														} else {
															{ b.Name["en"] }
														}
													</strong>
													if b.IsMain {
														<span class="badge badge-emerald text-xs fw-700">الفرع الرئيسي</span>
													}
													if b.Status == "inactive" {
														<span class="badge badge-slate text-xs">معطل</span>
													} else {
														<span class="badge badge-emerald text-xs">نشط</span>
													}
												</div>
												if b.Code != "" {
													<span class="badge badge-slate tabular-nums text-xs">كود: { b.Code }</span>
												}
											</div>

											<div class="inline-row-04">
												<!-- Edit Branch Button (Triggers Edit Mode in the same interface) -->
												<button
													type="button"
													class="btn btn-secondary btn-xs fw-700"
													data-edit-branch-btn={ fmt.Sprintf("%d", b.ID) }
												
													@click={ fmt.Sprintf("setEditMode({id: %d, name_ar: '%s', name_en: '%s', code: '%s', city_id: %d, address: '%s', phone: '%s', operating_hours: '%s', google_maps_url: '%s', has_cold_storage: %t, is_main: %t, latitude: %f, longitude: %f})",
														b.ID, b.Name.Get("ar"), b.Name.Get("en"), b.Code, func() int64 { if b.CityID != nil { return *b.CityID }; return 0 }(), b.Address, b.Phone, b.OperatingHours, b.GoogleMapsURL, b.HasColdStorage, b.IsMain, func() float64 { if b.Latitude != nil { return *b.Latitude }; return 30.0444 }(), func() float64 { if b.Longitude != nil { return *b.Longitude }; return 31.2357 }()) }
												>
													@components.IconEdit("icon-xs")
													<span>تعديل</span>
												</button>

												<!-- Add Employee to Branch Button -->
												<button
													type="button"
													class="btn btn-secondary btn-xs fw-700"
													data-branch-id={ fmt.Sprintf("%d", b.ID) }
													onclick="openAddEmployeeModalFromBtn(this)"
												
													title="إضافة موظف لهذا الفرع"
												>
													@components.IconPlus("icon-xs")
													<span>موظف</span>
												</button>

												<!-- Delete Branch Button -->
												if !b.IsMain {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/branches/%d/delete", b.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الفرع؟');">
														<button type="submit" class="btn btn-secondary btn-xs">
															<span>حذف</span>
														</button>
													</form>
												}
											</div>
										</div>

										<div>
											if b.Address != "" {
												<div><span class="text-muted">العنوان: </span><strong class="text-primary">{ b.Address }</strong></div>
											}
											if b.Phone != "" {
												<div><span class="text-muted">الهاتف: </span><strong class="tabular-nums text-primary">{ b.Phone }</strong></div>
											}
											if b.OperatingHours != "" {
												<div><span class="text-muted">ساعات العمل: </span><strong class="tabular-nums">{ b.OperatingHours }</strong></div>
											}
										</div>

										<!-- Badges Strip: Cold Storage & Staff Count -->
										<div>
											<div class="inline-row-wrap">
												<!-- Coordinates -->
												<div>
													<span>الإحداثيات:</span>
													if b.Latitude != nil && b.Longitude != nil {
														<span class="tabular-nums fw-700">{ fmt.Sprintf("%.4f, %.4f", *b.Latitude, *b.Longitude) }</span>
													} else {
														<span class="text-muted">غير محددة</span>
													}
												</div>

												if b.HasColdStorage {
													<span class="badge badge-sky text-xs">مجهز بتبريد 2-8°C</span>
												}
											</div>

											<div>
												<!-- Assigned Staff Pill -->
												{{ branchEmps := data.GetBranchEmployees(b.ID) }}
												<span class="badge badge-secondary text-xs font-bold">
													{ fmt.Sprintf("%d موظف بالفرع", len(branchEmps)) }
												</span>

												<!-- Google Maps Link -->
												if b.GoogleMapsURL != "" {
													<a href={ templ.SafeURL(b.GoogleMapsURL) } target="_blank" rel="noopener">
														عرض على الخريطة ↗
													</a>
												} else if b.Latitude != nil && b.Longitude != nil {
													<a href={ templ.SafeURL(fmt.Sprintf("https://www.google.com/maps?q=%f,%f", *b.Latitude, *b.Longitude)) } target="_blank" rel="noopener">
														عرض على الخريطة ↗
													</a>
												}
											</div>
										</div>
									</div>
								}
							</div>
						}
					</div>

					<!-- Right Column: Unified Pharmacy Branch Form (Add / Edit Modes) -->
					<div id="new-branch-form">
						<div>
							<div class="inline-row-06">
								<div>
									<span x-text="mode === 'edit' ? '' : ''"></span>
								</div>
								<div>
									<h3 class="text-base fw-800 text-primary m-0" x-text="mode === 'edit' ? 'تعديل بيانات الفرع: ' + (form.name_ar || '') : 'إضافة فرع صيدلية جديد'">
									</h3>
									<p x-text="mode === 'edit' ? 'تحديث بيانات الموقع، العنوان، وخصائص الفرع الحالية' : 'أدخل بيانات الفرع وموقعه على الخريطة لتفعيل التغطية'">
									</p>
								</div>
							</div>

							<!-- Exit Edit Mode Button -->
							<template x-if="mode === 'edit'">
								<button
									type="button"
									class="btn btn-secondary btn-xs font-bold gap-1"
									@click="resetToAddMode()"
									title="إلغاء التعديل والعودة لوضع إضافة فرع جديد"
								>
									<span>الخروج من وضع التعديل</span>
								</button>
							</template>
						</div>

						<form method="POST" :action="formAction">
							<div class="grid-halves">
								<div>
									<label class="form-label label-sm-bold">
										اسم الفرع بالعربية <span class="text-danger">*</span>
									</label>
									<input type="text" name="name_ar" x-model="form.name_ar" required placeholder="صيدلية الأمل - المعادي" class="form-input input-sm w-full"/>
								</div>
								<div>
									<label class="form-label label-sm-bold">
										اسم الفرع بالإنجليزية
									</label>
									<input type="text" name="name_en" x-model="form.name_en" placeholder="Al Amal - Maadi" class="form-input input-sm w-full"/>
								</div>
							</div>

							<div class="grid-halves">
								<div>
									<label class="form-label label-sm-bold">
										كود الفرع الداخلي
									</label>
									<input type="text" name="code" x-model="form.code" placeholder="PH-01" class="form-input input-sm tabular-nums w-full"/>
								</div>
								<div>
									<label class="form-label label-sm-bold">
										المدينة / المحافظة <span class="text-danger">*</span>
									</label>
									<select name="city_id" x-model="form.city_id" required class="form-input input-sm w-full">
										<option value="">-- اختر المدينة / المحافظة --</option>
										for _, c := range data.Cities {
											<option
												value={ fmt.Sprintf("%d", c.ID) }
												data-lat={ fmt.Sprintf("%.6f", c.Latitude) }
												data-lng={ fmt.Sprintf("%.6f", c.Longitude) }
											>
												if c.Name["ar"] != "" {
													{ c.Name["ar"] }
												} else {
													{ c.Name["en"] }
												}
											</option>
										}
									</select>
								</div>
							</div>

							<div>
								<label class="form-label label-sm-bold">
									العنوان التفصيلي <span class="text-danger">*</span>
								</label>
								<input type="text" name="address" x-model="form.address" required placeholder="شارع النصر، أمام مستشفى المعادي" class="form-input input-sm w-full"/>
							</div>

							<div class="grid-halves">
								<div>
									<label class="form-label label-sm-bold">
										رقم هاتف الفرع
									</label>
									<input type="tel" name="phone" x-model="form.phone" placeholder="01012345678" class="form-input input-sm tabular-nums w-full"/>
								</div>
								<div>
									<label class="form-label label-sm-bold">
										ساعات العمل
									</label>
									<input type="text" name="operating_hours" x-model="form.operating_hours" placeholder="9 صباحاً - 11 مساءً" class="form-input input-sm w-full"/>
								</div>
							</div>

							<!-- Leaflet Map Picker with Auto-Pan -->
							<div class="stack-xs">
								<label>
									موقع الفرع على الخريطة (سيتم التحريك تلقائياً عند اختيار المدينة)
								</label>
								<div data-map-picker data-default-lat="30.0444" data-default-lon="31.2357">
									<div class="map-container map-canvas"></div>
									<div>
										<span data-map-coords-badge class="tabular-nums fw-700 text-primary">30.0444, 31.2357</span>
										<button type="button" data-map-locate class="btn btn-secondary btn-xs fw-700">موقعي</button>
									</div>
									<input type="hidden" name="latitude" data-map-input="lat" :value="form.latitude"/>
									<input type="hidden" name="longitude" data-map-input="lon" :value="form.longitude"/>
								</div>
							</div>

							<div>
								<label class="form-label">
									رابط خرائط Google (اختياري)
								</label>
								<input type="url" name="google_maps_url" x-model="form.google_maps_url" data-map-google-url placeholder="https://maps.google.com/?q=30.0444,31.2357" class="form-input input-sm w-full text-xs"/>
							</div>

							<div>
								<label>
									<input type="checkbox" name="has_cold_storage" value="true" x-model="form.has_cold_storage"/>
									<span>تتوفر ثلاجة لحفظ وتبريد الأدوية (2-8°C)</span>
								</label>
								<label>
									<input type="checkbox" name="is_main" value="true" x-model="form.is_main"/>
									<span>تعيين كفرع رئيسي لاستلام طلبيات الصيدلية</span>
								</label>
							</div>

							<button type="submit" class="btn btn-primary btn-sm">
								@components.IconCheck("icon-xs")
								<span x-text="mode === 'edit' ? 'حفظ تعديلات الفرع' : 'حفظ وإضافة فرع الصيدلية'"></span>
							</button>
						</form>
					</div>
				</div>
			</div>

			@CustomerEmployeesTab(data, lang, dir, perms)
		<script>
			function switchCustomerBranchTab(tabName) {
				const branchesBtn = document.getElementById('cb-tab-btn-branches');
				const empsBtn = document.getElementById('cb-tab-btn-employees');
				const branchesPanel = document.getElementById('cb-tab-panel-branches');
				const empsPanel = document.getElementById('cb-tab-panel-employees');

				if (tabName === 'employees') {
					if (branchesBtn) branchesBtn.classList.remove('active');
					if (empsBtn) empsBtn.classList.add('active');
					if (branchesPanel) branchesPanel.style.display = 'none';
					if (empsPanel) empsPanel.style.display = 'block';
				} else {
					if (branchesBtn) branchesBtn.classList.add('active');
					if (empsBtn) empsBtn.classList.remove('active');
					if (branchesPanel) branchesPanel.style.display = 'block';
					if (empsPanel) empsPanel.style.display = 'none';
				}
			}

			function filterCustomerEmployees() {
				const search = (document.getElementById('cb-emp-search-input')?.value || '').toLowerCase().trim();
				const branchFilter = document.getElementById('cb-emp-branch-filter')?.value || '';
				const rows = document.querySelectorAll('#customer-employees-table tbody tr');

				rows.forEach(row => {
					const nameStr = row.getAttribute('data-emp-name') || '';
					const branchId = row.getAttribute('data-branch-id') || '';

					const matchesSearch = !search || nameStr.includes(search);
					const matchesBranch = !branchFilter || branchId === branchFilter;

					if (matchesSearch && matchesBranch) {
						row.style.display = '';
					} else {
						row.style.display = 'none';
					}
				});
			}

			function openAddEmployeeModalFromBtn(btn) {
				if (!btn) return;
				const branchId = btn.getAttribute('data-branch-id');
				openAddEmployeeModal(branchId);
			}

			function openAddEmployeeModal(branchId) {
				const modal = document.getElementById('add-employee-modal');
				if (branchId) {
					const branchSelect = document.getElementById('add-emp-branch-select');
					if (branchSelect) branchSelect.value = String(branchId);
				}
				if (modal && typeof modal.showModal === 'function') {
					modal.showModal();
				}
			}

			function closeAddEmployeeModal() {
				const modal = document.getElementById('add-employee-modal');
				if (modal && typeof modal.close === 'function') {
					modal.close();
				}
			}

			function openEditEmployeeModalFromBtn(btn) {
				if (!btn) return;
				const empId = btn.getAttribute('data-emp-id');
				openEditEmployeeModal(empId);
			}

			function openEditEmployeeModal(empId) {
				const modal = document.getElementById('edit-emp-modal-' + empId);
				if (modal && typeof modal.showModal === 'function') {
					modal.showModal();
				}
			}

			function closeEditEmployeeModal(empId) {
				const modal = document.getElementById('edit-emp-modal-' + empId);
				if (modal && typeof modal.close === 'function') {
					modal.close();
				}
			}

			function customerBranchManager() {
				return {
					mode: 'add',
					editId: 0,
					formAction: '/customer/branches/new',
					form: {
						id: 0,
						name_ar: '',
						name_en: '',
						code: '',
						city_id: '',
						address: '',
						phone: '',
						operating_hours: '',
						google_maps_url: '',
						has_cold_storage: false,
						is_main: false,
						latitude: 30.0444,
						longitude: 31.2357
					},
					init() {
						const urlParams = new URLSearchParams(window.location.search);
						const editParam = urlParams.get('edit');
						if (editParam) {
							const btn = document.querySelector(`[data-edit-branch-btn="${editParam}"]`);
							if (btn) btn.click();
						}
					},
					setEditMode(b) {
						this.mode = 'edit';
						this.editId = b.id;
						this.formAction = '/customer/branches/' + b.id + '/edit';
						this.form = {
							id: b.id,
							name_ar: b.name_ar || '',
							name_en: b.name_en || '',
							code: b.code || '',
							city_id: b.city_id ? String(b.city_id) : '',
							address: b.address || '',
							phone: b.phone || '',
							operating_hours: b.operating_hours || '',
							google_maps_url: b.google_maps_url || '',
							has_cold_storage: !!b.has_cold_storage,
							is_main: !!b.is_main,
							latitude: b.latitude || 30.0444,
							longitude: b.longitude || 31.2357
						};
						const formEl = document.getElementById('new-branch-form');
						if (formEl) {
							formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
						}
					},
					resetToAddMode() {
						this.mode = 'add';
						this.editId = 0;
						this.formAction = '/customer/branches/new';
						this.form = {
							id: 0,
							name_ar: '',
							name_en: '',
							code: '',
							city_id: '',
							address: '',
							phone: '',
							operating_hours: '',
							google_maps_url: '',
							has_cold_storage: false,
							is_main: false,
							latitude: 30.0444,
							longitude: 31.2357
						};
					}
				};
			}

			// Global modal open/close delegation
			document.addEventListener('click', function(e) {
				const openBtn = e.target.closest('[data-modal-open]');
				if (openBtn) {
					const modalId = openBtn.getAttribute('data-modal-open');
					const modal = document.getElementById(modalId);
					if (modal) {
						modal.classList.remove('hidden');
						modal.style.display = 'flex';
					}
				}
				const closeBtn = e.target.closest('[data-modal-close]');
				if (closeBtn) {
					const modalId = closeBtn.getAttribute('data-modal-close');
					const modal = document.getElementById(modalId);
					if (modal) {
						modal.classList.add('hidden');
						modal.style.display = 'none';
					}
				}
				// Backdrop click close
				const addEmpModal = document.getElementById('add-employee-modal');
				if (e.target === addEmpModal) {
					closeAddEmployeeModal();
				}
			});
		</script>
		</div>
	}
}

