package pages

import (
	"encoding/json"
	"fmt"
	"strings"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerBranchesData struct {
	Branches   []*org.Branch
	Employees  []*org.EmployeeView
	Cities     []*platformadmin.City
	ActiveTab  string // "branches" or "employees"
	NoticeType    string
	NoticeMsg     string
	EmpPage       int
	EmpPerPage    int
	EmpTotalCount int
}

func (d CustomerBranchesData) GetBranchEmployees(branchID int64) []*org.EmployeeView {
	var list []*org.EmployeeView
	for _, emp := range d.Employees {
		if emp != nil && emp.Member != nil && emp.Member.BranchID != nil && *emp.Member.BranchID == branchID {
			list = append(list, emp)
		}
	}
	return list
}

func (d CustomerBranchesData) GetBranchName(branchID *int64) string {
	if branchID == nil || *branchID <= 0 {
		return "غير محدد بفرع معين"
	}
	for _, b := range d.Branches {
		if b != nil && b.ID == *branchID {
			if b.Name["ar"] != "" {
				return b.Name["ar"]
			}
			return b.Name["en"]
		}
	}
	return fmt.Sprintf("فرع رقم #%d", *branchID)
}

func (d CustomerBranchesData) GetMainBranch() *org.Branch {
	for _, b := range d.Branches {
		if b != nil && b.IsMain {
			return b
		}
	}
	if len(d.Branches) > 0 {
		return d.Branches[0]
	}
	return nil
}

func cbRoleLabelArabic(key string) string {
	switch key {
	case "org_admin", "admin", "org_owner", "owner":
		return "مدير عام المؤسسة"
	case "org_manager", "manager":
		return "مدير فرع / صيدلية"
	case "org_pharmacist", "pharmacist":
		return "صيدلي مسؤول"
	case "org_accountant", "accountant":
		return "محاسب / مسؤول مشتريات"
	case "org_warehouse", "warehouse":
		return "أمين مخزن / استلام"
	case "org_employee", "employee":
		return "موظف صيدلية / فرع"
	default:
		if strings.HasPrefix(key, "org_") {
			return strings.TrimPrefix(key, "org_")
		}
		return key
	}
}

func cbRoleBadgeClass(key string) string {
	switch key {
	case "org_admin", "admin", "org_owner", "owner":
		return "badge-primary"
	case "org_manager", "manager":
		return "badge-emerald"
	case "org_pharmacist", "pharmacist":
		return "badge-sky"
	case "org_accountant", "accountant":
		return "badge-amber"
	default:
		return "badge-slate"
	}
}

var institutionalWorkCategories = []struct {
	Key     string
	LabelAr string
	LabelEn string
	Icon    string
}{
	{Key: "group", LabelAr: "مجموعة", LabelEn: "Group", Icon: ""},
	{Key: "sector", LabelAr: "قطاع", LabelEn: "Sector", Icon: ""},
	{Key: "startup", LabelAr: "شركة ناشئة", LabelEn: "Startup", Icon: ""},
	{Key: "sole_proprietorship", LabelAr: "مؤسسة فردية", LabelEn: "Sole Proprietorship", Icon: ""},
	{Key: "audience_category", LabelAr: "فئة جماهيرية", LabelEn: "Audience Category", Icon: ""},
	{Key: "retail", LabelAr: "تجزئة", LabelEn: "Retail", Icon: ""},
	{Key: "nonprofit", LabelAr: "منظمة غير ربحية", LabelEn: "Nonprofit Organization", Icon: ""},
	{Key: "factory", LabelAr: "مصنع", LabelEn: "Factory", Icon: ""},
	{Key: "cooperative", LabelAr: "جمعية تعاونية", LabelEn: "Cooperative", Icon: ""},
	{Key: "services", LabelAr: "خدمات", LabelEn: "Services", Icon: ""},
	{Key: "pharmacy", LabelAr: "صيدلية", LabelEn: "Pharmacy", Icon: ""},
	{Key: "joint_stock", LabelAr: "شركة مساهمة", LabelEn: "Joint Stock Company", Icon: ""},
}

func formatBranchWorksJSON(works []string) string {
	if len(works) == 0 {
		return "[]"
	}
	b, err := json.Marshal(works)
	if err != nil {
		return "[]"
	}
	return string(b)
}

templ CustomerBranches(data CustomerBranchesData, lang string, dir string, perms []string) {
	@layouts.CustomerShell(i18n.T(lang, "nav.pharmacy_branches"), "branches", lang, dir, perms) {
		<div x-data="customerBranchManager()" x-init="init()" class="page-container">
			
			<!-- Notice Feedback Banner -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-4 p-4 d-flex items-center justify-between flex-wrap gap-2">
						<div class="d-flex items-center gap-2 font-bold text-sm">
							@components.IconAlert("icon-xs")
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 d-flex items-center justify-between flex-wrap gap-2">
						<div class="d-flex items-center gap-2 font-bold text-sm">
							@components.IconCheckCircle("icon-xs")
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				}
			}
			
			<!-- Header Banner -->
			<div class="glass-panel p-5 mb-4">
				<div class="d-flex items-center justify-between flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-2 mb-1">
							<div class="user-avatar-badge">
								@components.IconBuilding("icon-sm")
							</div>
							<h1 class="page-title text-xl font-bold m-0">
								إدارة الفروع ومستخدمي الصيدلية
							</h1>
						</div>
						<p class="text-xs text-secondary m-0">
							إدارة شبكة الفروع ومواقع الاستلام الجغرافية، وتعيين الموظفين والصيادلة لكل فرع وتحديد أدوارهم وصلاحياتهم.
						</p>
					</div>
					<div class="d-flex items-center gap-2 flex-wrap">
						<button type="button" class="btn btn-secondary btn-sm font-bold gap-1" onclick="openAddEmployeeModal()" data-modal-open="add-employee-modal">
							@components.IconUser("icon-xs")
							<span>+ إضافة مستخدم / موظف</span>
						</button>
						<button type="button" class="btn btn-primary btn-sm font-bold gap-1" @click="resetToAddMode(); activeTab = 'branches'; document.getElementById('new-branch-form').scrollIntoView({behavior:'smooth'});">
							@components.IconPlus("icon-xs")
							<span>+ إضافة فرع جديد</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Metrics Strip -->
			<div class="dashboard-stat-grid cols-4 mb-4">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الفروع المسجلة</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", len(data.Branches)) } <span class="text-xs font-normal text-muted">فروع</span>
					</div>
					<div class="stat-card-sub">شبكة استلام الطلبيات</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">الفرع الرئيسي للاستلام</div>
					<div class="stat-card-value text-primary truncate text-base">
						if mb := data.GetMainBranch(); mb != nil {
							<span>{ mb.Name.Get(i18n.ParseLang(lang)) }</span>
						} else {
							<span>غير محدد</span>
						}
					</div>
					<div class="stat-card-sub">نقطة التسليم الافتراضية</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">الموظفون والصيادلة</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", len(data.Employees)) } <span class="text-xs font-normal text-muted">مستخدمين</span>
					</div>
					<div class="stat-card-sub">كادر العمل بالصيدلية</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">حالة التغطية والشحن</div>
					<div class="mt-1">
						<span class="badge badge-emerald text-2xs font-bold">
							@components.IconCheck("icon-xs")
							<span>جاهز لتلقي التوريد</span>
						</span>
					</div>
					<div class="stat-card-sub">مفعل على مستوى المحافظات</div>
				</div>
			</div>

			<!-- Navigation Tabs -->
			<div class="tabs-nav">
				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'branches' }"
					@click="activeTab = 'branches'"
				>
					@components.IconBuilding("icon-xs")
					<span>شبكة الفروع ومواقع الاستلام ({ fmt.Sprintf("%d", len(data.Branches)) })</span>
				</button>
				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'employees' }"
					@click="activeTab = 'employees'"
				>
					@components.IconUser("icon-xs")
					<span>موظفو ومستخدمو الفروع والصلاحيات ({ fmt.Sprintf("%d", len(data.Employees)) })</span>
				</button>
			</div>

			<!-- TAB 1: Branches Network Content -->
			<div x-show="activeTab === 'branches'">
				<div class="cb-split-grid">
					
					<!-- Right Column (in RTL DOM): Existing Pharmacy Branches List -->
					<div class="glass-panel p-5">
						<div class="d-flex items-center justify-between flex-wrap gap-2 pb-3 mb-3 border-b">
							<div class="d-flex items-center gap-2 font-bold text-sm text-primary">
								@components.IconBuilding("icon-xs")
								<span>فروع الصيدلية المعتمدة</span>
							</div>
							<span class="badge badge-sky text-2xs font-bold tabular-nums">{ fmt.Sprintf("%d فروع", len(data.Branches)) }</span>
						</div>

						if len(data.Branches) == 0 {
							<div class="p-6 text-center">
								<div class="mb-2 text-2xl text-muted">@components.IconBuilding("icon-md")</div>
								<h3 class="font-bold text-sm text-primary mb-1">لم تقم بإضافة فروع بعد</h3>
								<p class="text-xs text-secondary m-0">أضف فرع صيدليتك لتتمكن من تصفح العروض وتحديد نطاق التوريد المتاح لمنطقتك.</p>
							</div>
						} else {
							<div class="d-flex flex-col gap-3">
								for _, b := range data.Branches {
									<div class="cb-branch-card">
										<div class="d-flex items-start justify-between gap-3">
											<div>
												<div class="d-flex items-center gap-2 flex-wrap mb-1">
													<strong class="text-sm font-bold text-primary">
														if b.Name["ar"] != "" {
															{ b.Name["ar"] }
														} else {
															{ b.Name["en"] }
														}
													</strong>
													if b.IsMain {
														<span class="badge badge-emerald text-2xs font-bold">الفرع الرئيسي</span>
													}
													if b.Status == "inactive" {
														<span class="badge badge-slate text-2xs">معطل</span>
													} else {
														<span class="badge badge-emerald text-2xs">نشط</span>
													}
												</div>
												if b.Code != "" {
													<span class="badge badge-slate tabular-nums text-2xs">كود: { b.Code }</span>
												}
											</div>

											<div class="d-flex items-center gap-1">
												<!-- Edit Branch Button -->
												<button
													type="button"
													class="btn btn-secondary btn-xs font-bold gap-1"
													data-edit-branch-btn={ fmt.Sprintf("%d", b.ID) }
													@click={ fmt.Sprintf("setEditMode({id: %d, name_ar: '%s', name_en: '%s', code: '%s', city_id: %d, address: '%s', phone: '%s', operating_hours: '%s', google_maps_url: '%s', has_cold_storage: %t, is_main: %t, latitude: %f, longitude: %f, institutional_works: %s})",
														b.ID, b.Name.Get("ar"), b.Name.Get("en"), b.Code, func() int64 { if b.CityID != nil { return *b.CityID }; return 0 }(), b.Address, b.Phone, b.OperatingHours, b.GoogleMapsURL, b.HasColdStorage, b.IsMain, func() float64 { if b.Latitude != nil { return *b.Latitude }; return 30.0444 }(), func() float64 { if b.Longitude != nil { return *b.Longitude }; return 31.2357 }(), formatBranchWorksJSON(b.InstitutionalWorks)) }
												>
													@components.IconEdit("icon-xs")
													<span>تعديل</span>
												</button>

												<!-- Add Employee to Branch Button -->
												<button
													type="button"
													class="btn btn-secondary btn-xs font-bold gap-1"
													data-branch-id={ fmt.Sprintf("%d", b.ID) }
													onclick="openAddEmployeeModalFromBtn(this)"
													title="إضافة موظف لهذا الفرع"
												>
													@components.IconPlus("icon-xs")
													<span>موظف</span>
												</button>

												<!-- Delete Branch Button -->
												if !b.IsMain {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/branches/%d/delete", b.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الفرع؟');">
														<button type="submit" class="btn btn-secondary btn-xs text-danger" title="حذف الفرع">
															@components.IconTrash("icon-xs")
														</button>
													</form>
												}
											</div>
										</div>

										<div class="d-flex flex-col gap-1 text-xs text-secondary">
											if b.Address != "" {
												<div><span class="text-muted">العنوان: </span><strong class="text-primary">{ b.Address }</strong></div>
											}
											if b.Phone != "" {
												<div><span class="text-muted">الهاتف: </span><strong class="tabular-nums text-primary">{ b.Phone }</strong></div>
											}
											if b.OperatingHours != "" {
												<div><span class="text-muted">ساعات العمل: </span><strong class="tabular-nums">{ b.OperatingHours }</strong></div>
											}
										</div>

										<!-- Institutional Works Tags -->
										if len(b.InstitutionalWorks) > 0 {
											<div class="d-flex flex-col gap-1 pt-2 pb-2">
												<div class="text-xs font-bold text-muted uppercase mb-1">
													الأعمال المؤسسية المغطاة:
												</div>
												<div class="d-flex flex-wrap gap-1">
													for _, cat := range b.InstitutionalWorks {
														<span class="badge badge-slate text-2xs font-bold">
															{ formatBranchCategoryLabel(cat) }
														</span>
													}
												</div>
											</div>
										}

										<!-- Badges Strip: Cold Storage & Staff Count -->
										<div class="d-flex items-center justify-between flex-wrap gap-2 pt-2 border-t text-xs">
											<div class="d-flex items-center gap-1 flex-wrap">
												if b.HasColdStorage {
													<span class="badge badge-sky text-2xs font-bold">مجهز بتبريد 2-8°C</span>
												}
											</div>

											<div class="d-flex items-center gap-2">
												<!-- Assigned Staff Pill -->
												{{ branchEmps := data.GetBranchEmployees(b.ID) }}
												<span class="badge badge-secondary text-2xs font-bold">
													{ fmt.Sprintf("%d موظف بالفرع", len(branchEmps)) }
												</span>

												<!-- Google Maps Link -->
												if b.GoogleMapsURL != "" {
													<a href={ templ.SafeURL(b.GoogleMapsURL) } target="_blank" rel="noopener" class="text-primary font-bold text-xs text-decoration-none">
														الخريطة ↗
													</a>
												} else if b.Latitude != nil && b.Longitude != nil {
													<a href={ templ.SafeURL(fmt.Sprintf("https://www.google.com/maps?q=%f,%f", *b.Latitude, *b.Longitude)) } target="_blank" rel="noopener" class="text-primary font-bold text-xs text-decoration-none">
														الخريطة ↗
													</a>
												}
											</div>
										</div>
									</div>
								}
							</div>
						}
					</div>

					<!-- Left Column (in RTL DOM): Unified Pharmacy Branch Form (Add / Edit Modes) -->
					<div class="glass-panel p-5" id="new-branch-form">
						<div class="d-flex items-start justify-between gap-3 pb-3 mb-3 border-b">
							<div>
								<h3 class="text-base font-bold text-primary m-0" x-text="mode === 'edit' ? 'تعديل بيانات الفرع: ' + (form.name_ar || '') : 'إضافة فرع صيدلية جديد'"></h3>
								<p class="text-xs text-secondary m-0 mt-0.5" x-text="mode === 'edit' ? 'تحديث بيانات الموقع، العنوان، وخصائص الفرع الحالية' : 'أدخل بيانات الفرع وموقعه على الخريطة لتفعيل التغطية'"></p>
							</div>

							<!-- Exit Edit Mode Button -->
							<template x-if="mode === 'edit'">
								<button
									type="button"
									class="btn btn-secondary btn-xs font-bold"
									@click="resetToAddMode()"
									title="إلغاء التعديل والعودة لوضع إضافة فرع جديد"
								>
									<span>إلغاء</span>
								</button>
							</template>
						</div>

						<form class="d-flex flex-col gap-3 m-0" method="POST" :action="formAction">
							<div class="d-grid grid-auto-fit-sm gap-3">
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">
										اسم الفرع بالعربية <span class="text-danger">*</span>
									</label>
									<input type="text" name="name_ar" x-model="form.name_ar" required placeholder="صيدلية الأمل - المعادي" class="form-control font-semibold"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">
										اسم الفرع بالإنجليزية
									</label>
									<input type="text" name="name_en" x-model="form.name_en" placeholder="Al Amal - Maadi" class="form-control font-semibold"/>
								</div>
							</div>

							<div class="d-grid grid-auto-fit-sm gap-3">
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">
										كود الفرع الداخلي
									</label>
									<input type="text" name="code" x-model="form.code" placeholder="PH-01" class="form-control tabular-nums"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">
										المدينة / المحافظة <span class="text-danger">*</span>
									</label>
									<select name="city_id" x-model="form.city_id" required class="form-select form-select-sm font-semibold">
										<option value="">-- اختر المدينة / المحافظة --</option>
										for _, c := range data.Cities {
											<option
												value={ fmt.Sprintf("%d", c.ID) }
												data-lat={ fmt.Sprintf("%.6f", c.Latitude) }
												data-lng={ fmt.Sprintf("%.6f", c.Longitude) }
											>
												if c.Name["ar"] != "" {
													{ c.Name["ar"] }
												} else {
													{ c.Name["en"] }
												}
											</option>
										}
									</select>
								</div>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">
									العنوان التفصيلي <span class="text-danger">*</span>
								</label>
								<input type="text" name="address" x-model="form.address" required placeholder="شارع النصر، أمام مستشفى المعادي" class="form-control font-semibold"/>
							</div>

							<div class="d-grid grid-auto-fit-sm gap-3">
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">
										رقم هاتف الفرع
									</label>
									<input type="tel" name="phone" x-model="form.phone" placeholder="01012345678" class="form-control tabular-nums"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">
										ساعات العمل
									</label>
									<input type="text" name="operating_hours" x-model="form.operating_hours" placeholder="9 صباحاً - 11 مساءً" class="form-control font-semibold"/>
								</div>
							</div>

							<!-- Leaflet Map Picker with Auto-Pan -->
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">
									موقع الفرع على الخريطة (سيتم التحريك تلقائياً عند اختيار المدينة)
								</label>
								<div class="d-flex flex-col gap-2" data-map-picker data-default-lat="30.0444" data-default-lon="31.2357">
									<div class="map-container map-canvas map-canvas-sm rounded-lg border"></div>
									<div class="d-flex items-center justify-between text-xs">
										<span data-map-coords-badge class="tabular-nums font-bold text-primary">30.0444, 31.2357</span>
										<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold">موقعي الحالي</button>
									</div>
									<input type="hidden" name="latitude" data-map-input="lat" :value="form.latitude"/>
									<input type="hidden" name="longitude" data-map-input="lon" :value="form.longitude"/>
								</div>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">
									رابط خرائط Google (اختياري)
								</label>
								<input type="url" name="google_maps_url" x-model="form.google_maps_url" data-map-google-url placeholder="https://maps.google.com/?q=30.0444,31.2357" class="form-control text-xs font-semibold" dir="ltr"/>
							</div>

							<!-- Section: Institutional Works (12 Categories) -->
							<div class="bg-surface-sunken p-3 rounded-xl border d-flex flex-col gap-2">
								<label class="text-xs font-black text-primary m-0 d-block">
									الأعمال المؤسسية المغطاة (Institutional Works)
								</label>

								<div class="d-grid grid-cols-2 gap-1.5 mt-1">
									for _, cat := range institutionalWorkCategories {
										<label class="d-flex items-center gap-1.5 text-xs text-secondary cursor-pointer p-1 rounded">
											<input type="checkbox" name="institutional_works" value={ cat.Key } x-model="form.institutional_works" class="form-checkbox"/>
											<span>{ cat.LabelAr }</span>
										</label>
									}
								</div>
							</div>

							<div class="d-flex flex-col gap-2 pt-1">
								<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold">
									<input type="checkbox" name="has_cold_storage" value="true" x-model="form.has_cold_storage" class="form-checkbox"/>
									<span>تتوفر ثلاجة لحفظ وتبريد الأدوية (2-8°C)</span>
								</label>
								<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold">
									<input type="checkbox" name="is_main" value="true" x-model="form.is_main" class="form-checkbox"/>
									<span>تعيين كفرع رئيسي لاستلام طلبيات الصيدلية</span>
								</label>
							</div>

							<button type="submit" class="btn btn-primary btn-sm font-bold w-full justify-center mt-2">
								@components.IconCheck("icon-xs")
								<span x-text="mode === 'edit' ? 'حفظ تعديلات الفرع' : 'حفظ وإضافة فرع الصيدلية'"></span>
							</button>
						</form>
					</div>
				</div>
			</div>

			<!-- TAB 2: Employees Content -->
			<div x-show="activeTab === 'employees'">
				@CustomerEmployeesTab(data, lang, dir, perms)
			</div>
		<script>
			// switchCustomerBranchTab was removed: nothing called it, and all four
			// elements it looked up (cb-tab-btn-branches, cb-tab-btn-employees and
			// their panels) do not exist on this page -- the tabs are driven by
			// Alpine's activeTab above. It was toggling classes on nulls.

			function filterCustomerEmployees() {
				const search = (document.getElementById('cb-emp-search-input')?.value || '').toLowerCase().trim();
				const branchFilter = document.getElementById('cb-emp-branch-filter')?.value || '';
				const rows = document.querySelectorAll('#customer-employees-table tbody tr');

				rows.forEach(row => {
					const nameStr = row.getAttribute('data-emp-name') || '';
					const branchId = row.getAttribute('data-branch-id') || '';

					const matchesSearch = !search || nameStr.includes(search);
					const matchesBranch = !branchFilter || branchId === branchFilter;

					if (matchesSearch && matchesBranch) {
						row.classList.remove('hidden');
					} else {
						row.classList.add('hidden');
					}
				});
			}

			function openAddEmployeeModalFromBtn(btn) {
				if (!btn) return;
				const branchId = btn.getAttribute('data-branch-id');
				openAddEmployeeModal(branchId);
			}

			function openAddEmployeeModal(branchId) {
				const modal = document.getElementById('add-employee-modal');
				if (branchId) {
					const branchSelect = document.getElementById('add-emp-branch-select');
					if (branchSelect) branchSelect.value = String(branchId);
				}
				if (modal && typeof modal.showModal === 'function') {
					modal.showModal();
				}
			}

			function closeAddEmployeeModal() {
				const modal = document.getElementById('add-employee-modal');
				if (modal && typeof modal.close === 'function') {
					modal.close();
				}
			}

			function openEditEmployeeModalFromBtn(btn) {
				if (!btn) return;
				const empId = btn.getAttribute('data-emp-id');
				openEditEmployeeModal(empId);
			}

			function openEditEmployeeModal(empId) {
				const modal = document.getElementById('edit-emp-modal-' + empId);
				if (modal && typeof modal.showModal === 'function') {
					modal.showModal();
				}
			}

			function closeEditEmployeeModal(empId) {
				const modal = document.getElementById('edit-emp-modal-' + empId);
				if (modal && typeof modal.close === 'function') {
					modal.close();
				}
			}

			function customerBranchManager() {
				return {
					activeTab: 'branches',
					mode: 'add',
					editId: 0,
					formAction: '/customer/branches/new',
					form: {
						id: 0,
						name_ar: '',
						name_en: '',
						code: '',
						city_id: '',
						address: '',
						phone: '',
						operating_hours: '',
						google_maps_url: '',
						has_cold_storage: false,
						is_main: false,
						latitude: 30.0444,
						longitude: 31.2357,
						institutional_works: []
					},
					init() {
						const urlParams = new URLSearchParams(window.location.search);
						const tabParam = urlParams.get('tab');
						if (tabParam === 'employees') {
							this.activeTab = 'employees';
						}
						const editParam = urlParams.get('edit');
						if (editParam) {
							const btn = document.querySelector(`[data-edit-branch-btn="${editParam}"]`);
							if (btn) btn.click();
						}
					},
					setEditMode(b) {
						this.mode = 'edit';
						this.editId = b.id;
						this.formAction = '/customer/branches/' + b.id + '/edit';
						this.form = {
							id: b.id,
							name_ar: b.name_ar || '',
							name_en: b.name_en || '',
							code: b.code || '',
							city_id: b.city_id ? String(b.city_id) : '',
							address: b.address || '',
							phone: b.phone || '',
							operating_hours: b.operating_hours || '',
							google_maps_url: b.google_maps_url || '',
							has_cold_storage: !!b.has_cold_storage,
							is_main: !!b.is_main,
							latitude: b.latitude || 30.0444,
							longitude: b.longitude || 31.2357,
							institutional_works: Array.isArray(b.institutional_works) ? b.institutional_works : []
						};
						const formEl = document.getElementById('new-branch-form');
						if (formEl) {
							formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
						}
					},
					resetToAddMode() {
						this.mode = 'add';
						this.editId = 0;
						this.formAction = '/customer/branches/new';
						this.form = {
							id: 0,
							name_ar: '',
							name_en: '',
							code: '',
							city_id: '',
							address: '',
							phone: '',
							operating_hours: '',
							google_maps_url: '',
							has_cold_storage: false,
							is_main: false,
							latitude: 30.0444,
							longitude: 31.2357
						};
					}
				};
			}

			// Global modal open/close delegation
			document.addEventListener('click', function(e) {
				const openBtn = e.target.closest('[data-modal-open]');
				if (openBtn) {
					const modalId = openBtn.getAttribute('data-modal-open');
					const modal = document.getElementById(modalId);
					if (modal && typeof modal.showModal === 'function') {
						modal.showModal();
					}
				}
				const closeBtn = e.target.closest('[data-modal-close]');
				if (closeBtn) {
					const modalId = closeBtn.getAttribute('data-modal-close');
					const modal = document.getElementById(modalId);
					if (modal && typeof modal.close === 'function') {
						modal.close();
					}
				}
			});
		</script>
		</div>
	}
}

func formatBranchCategoryLabel(key string) string {
	categories := map[string]string{
		"group":                "مجموعة",
		"sector":               "قطاع",
		"startup":              "شركة ناشئة",
		"sole_proprietorship":  "مؤسسة فردية",
		"audience_category":    "فئة جماهيرية",
		"retail":               "تجزئة",
		"nonprofit":            "منظمة غير ربحية",
		"factory":              "مصنع",
		"cooperative":          "جمعية تعاونية",
		"services":             "خدمات",
		"pharmacy":             "صيدلية",
		"joint_stock":          "شركة مساهمة",
	}
	if label, ok := categories[key]; ok {
		return label
	}
	return key
}

