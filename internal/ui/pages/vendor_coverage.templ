package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorCoverageData struct {
	Coverages           []*workflow.CoverageView
	Branches            []*org.Branch
	Bands               []*org.DeliveryBand
	Cities              []*platformadmin.City
	CoverageUnavailable bool
	NoticeType          string
	NoticeMessage       string
}

func dayNameArabic(day int) string {
	switch day {
	case 0:
		return "الأحد"
	case 1:
		return "الاثنين"
	case 2:
		return "الثلاثاء"
	case 3:
		return "الأربعاء"
	case 4:
		return "الخميس"
	case 5:
		return "الجمعة"
	case 6:
		return "السبت"
	default:
		return fmt.Sprintf("يوم %d", day)
	}
}

func dayBadgeClass(day int) string {
	switch day {
	case 0:
		return "badge-primary"
	case 1:
		return "badge-sky"
	case 2:
		return "badge-indigo"
	case 3:
		return "badge-violet"
	case 4:
		return "badge-emerald"
	case 5:
		return "badge-amber"
	case 6:
		return "badge-rose"
	default:
		return "badge-secondary"
	}
}

func countActiveDays(coverages []*workflow.CoverageView) int {
	days := make(map[int]bool)
	for _, c := range coverages {
		if c.IsActive {
			days[c.DayOfWeek] = true
		}
	}
	return len(days)
}

func coveragesForDay(coverages []*workflow.CoverageView, day int) []*workflow.CoverageView {
	var list []*workflow.CoverageView
	for _, c := range coverages {
		if c.DayOfWeek == day {
			list = append(list, c)
		}
	}
	return list
}

func formatDistanceKM(meters int) string {
	if meters >= 1000 {
		return fmt.Sprintf("%.1f كم (%d م)", float64(meters)/1000.0, meters)
	}
	return fmt.Sprintf("%d متر", meters)
}

templ VendorCoveragePage(data VendorCoverageData, lang, dir string) {
	@layouts.VendorShell("نطاق التغطية والتوصيل الأسبوعي", "coverage", lang, dir) {
		<div x-data="{
			filterDay: 'all',
			editModalOpen: false,
			editCov: {
				id: 0,
				branch_id: '',
				day_of_week: 0,
				city_id: '',
				distance_meters: 25000,
				coverage_from: '',
				coverage_to: '',
				address: '',
				latitude: '',
				longitude: '',
				is_active: true
			},
			openEdit(c) {
				this.editCov = { ...c };
				this.editModalOpen = true;
			},
			closeEdit() {
				this.editModalOpen = false;
			},
			setAddDay(d) {
				const daySelect = document.getElementById('add_day_of_week_select');
				if (daySelect) {
					daySelect.value = d;
				}
				const panel = document.getElementById('add-coverage-panel');
				if (panel) {
					panel.scrollIntoView({ behavior: 'smooth' });
				}
			},
			setAddDistance(d) {
				const distInput = document.getElementById('add_distance_input');
				if (distInput) {
					distInput.value = d;
				}
			},
			setAddTime(from, to) {
				const fromInput = document.getElementById('add_coverage_from_input');
				const toInput = document.getElementById('add_coverage_to_input');
				if (fromInput) fromInput.value = from;
				if (toInput) toInput.value = to;
			},
			setEditDistance(d) {
				this.editCov.distance_meters = d;
			},
			setEditTime(from, to) {
				this.editCov.coverage_from = from;
				this.editCov.coverage_to = to;
			}
		}" style="display:flex; flex-direction:column; gap:1.75rem;">

			<!-- Notice / Toast Banner -->
			if data.NoticeMessage != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger" style="margin-bottom:0.5rem; display:flex; align-items:center; justify-content:space-between; border-radius:var(--radius-xl); padding:1rem 1.25rem;">
						<div style="display:flex; align-items:center; gap:0.75rem;">
							<span style="font-size:1.25rem;">⚠️</span>
							<span style="font-weight:600;">{ data.NoticeMessage }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success" style="margin-bottom:0.5rem; display:flex; align-items:center; justify-content:space-between; border-radius:var(--radius-xl); padding:1rem 1.25rem;">
						<div style="display:flex; align-items:center; gap:0.75rem;">
							<span style="font-size:1.25rem;">✅</span>
							<span style="font-weight:600;">{ data.NoticeMessage }</span>
						</div>
					</div>
				}
			}

			<!-- Header Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; padding-bottom:0.75rem; border-bottom:1px solid var(--border);">
				<div style="display:flex; align-items:center; gap:1rem;">
					<div style="width:54px; height:54px; border-radius:var(--radius-xl); background:var(--accent-subtle); border:1px solid var(--accent); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.6rem; flex-shrink:0;">
						🚚
					</div>
					<div>
						<h1 style="font-size:1.6rem; font-weight:800; color:var(--text); margin:0;">
							جدول التغطية الجغرافية والتوصيل الأسبوعي
						</h1>
						<p style="color:var(--text-muted); font-size:0.875rem; margin:0.25rem 0 0 0;">
							تحديد المركز الجغرافي ونصف قطر التوصيل (بالمتر) ومواعيد الخدمة لكل يوم من أيام الأسبوع لظهور العروض بدقة للصيدليات.
						</p>
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem;">
					<a href="#add-coverage-panel" class="btn btn-primary" style="font-weight:700; padding:0.65rem 1.25rem; display:flex; align-items:center; gap:0.5rem;">
						@components.IconPlus("icon-xs")
						<span>إضافة نطاق تغطية جديد</span>
					</a>
				</div>
			</div>

			if data.CoverageUnavailable {
				<div style="margin:2rem 0;">
					@components.ErrorState(components.ErrorStateProps{
						Title:      "تعذر تحميل جدول التغطية",
						Message:    "حدث خطأ غير متوقع أثناء استرجاع بيانات التغطية الأسبوعية. يرجى إعادة المحاولة.",
						RetryURL:   "/vendor/coverage",
						RetryLabel: "إعادة المحاولة",
					})
				</div>
			} else {
				<!-- Quick Metrics Grid -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:1rem;">
					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.4rem; border-inline-start:4px solid var(--accent);">
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">إجمالي نطاقات التغطية</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", len(data.Coverages)) }
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem;">مسار توصيل مسجل</div>
					</div>

					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.4rem; border-inline-start:4px solid var(--success);">
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">الفروع والمستودعات</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--success); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", len(data.Branches)) }
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem;">نقاط انطلاق مسجلة</div>
					</div>

					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.4rem; border-inline-start:4px solid var(--info);">
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">أيام التغطية المفعلة</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--info); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d / 7", countActiveDays(data.Coverages)) }
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem;">أيام خدمة نشطة أسبوعياً</div>
					</div>

					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.4rem; border-inline-start:4px solid var(--secondary);">
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">شرائح تسعير الشحن</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", len(data.Bands)) }
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem;">شرائح مسافة مفعلة</div>
					</div>
				</div>

				<!-- 7-Day Weekly Schedule Matrix -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.5rem;">
						<div>
							<h2 style="font-size:1.15rem; font-weight:700; color:var(--text); margin:0;">
								📅 جدول مواعيد التوصيل الأسبوعية (7 أيام)
							</h2>
							<p style="font-size:0.8rem; color:var(--text-muted); margin:0.2rem 0 0 0;">
								نظرة عامة على تغطية الفروع ومواعيد الشحن من الأحد إلى السبت.
							</p>
						</div>
						<span style="font-size:0.8rem; color:var(--accent); font-weight:600; background:var(--accent-subtle); padding:0.3rem 0.75rem; border-radius:var(--radius-pill);">
							تحديث فوري
						</span>
					</div>

					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(135px, 1fr)); gap:0.75rem;">
						for dayIdx := 0; dayIdx <= 6; dayIdx++ {
							{{ dayCovs := coveragesForDay(data.Coverages, dayIdx) }}
							<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:0.85rem; display:flex; flex-direction:column; justify-content:space-between; min-height:140px; transition:border-color 0.2s;" class="day-matrix-card">
								<div>
									<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
										<span class={ "badge", dayBadgeClass(dayIdx) } style="font-weight:700; font-size:0.8rem;">
											{ dayNameArabic(dayIdx) }
										</span>
										<span style="font-size:0.75rem; font-weight:700; color:var(--text-muted);" class="tabular-nums">
											{ fmt.Sprintf("%d", len(dayCovs)) }
										</span>
									</div>

									if len(dayCovs) == 0 {
										<div style="font-size:0.75rem; color:var(--text-muted); margin:0.5rem 0; text-align:center; padding:0.75rem 0;">
											لا توجد تغطية
										</div>
									} else {
										<div style="display:flex; flex-direction:column; gap:0.35rem; margin-top:0.25rem;">
											for _, c := range dayCovs {
												<div style="font-size:0.72rem; padding:0.3rem 0.45rem; border-radius:var(--radius-sm); background:var(--surface-raised); border:1px solid var(--border); display:flex; flex-direction:column; gap:0.15rem;">
													<div style="font-weight:700; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
														{ c.BranchName }
													</div>
													<div style="color:var(--accent); font-weight:600; font-size:0.68rem;" class="tabular-nums">
														{ fmt.Sprintf("%.0f كم", float64(c.DistanceMeters)/1000.0) }
														if c.CoverageFrom != nil && c.CoverageTo != nil {
															<span>• { *c.CoverageFrom }</span>
														}
													</div>
												</div>
											}
										</div>
									}
								</div>

								<div style="margin-top:0.75rem; text-align:center;">
									<button type="button" @click={ fmt.Sprintf("setAddDay(%d)", dayIdx) } class="btn btn-xs btn-ghost" style="width:100%; font-size:0.72rem; font-weight:600; color:var(--accent);">
										+ إضافة لهذا اليوم
									</button>
								</div>
							</div>
						}
					</div>
				</div>

				<!-- Main Split Layout: Left = Coverage List & Bands, Right = Add Form Panel -->
				<div style="display:grid; grid-template-columns:1.25fr 0.75fr; gap:1.75rem; align-items:start;" class="coverage-split-layout">

					<!-- Left Column: Coverage List & Filters -->
					<div style="display:flex; flex-direction:column; gap:1.5rem;">
						<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem;">
							
							<!-- List Header & Filter Bar -->
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
								<div>
									<h2 style="font-size:1.15rem; font-weight:700; color:var(--text); margin:0;">
										مسارات ونطاقات التغطية المسجلة ({ fmt.Sprintf("%d", len(data.Coverages)) })
									</h2>
									<span style="font-size:0.8rem; color:var(--text-muted);">إدارة وتعديل وتفعيل المسارات</span>
								</div>

								<!-- Day Filter Buttons -->
								<div style="display:flex; align-items:center; gap:0.35rem; flex-wrap:wrap;">
									<button type="button" @click="filterDay = 'all'" :class="filterDay === 'all' ? 'btn btn-primary btn-xs' : 'btn btn-secondary btn-xs'" style="font-weight:600;">
										الكل
									</button>
									for dayIdx := 0; dayIdx <= 6; dayIdx++ {
										<button type="button" @click={ fmt.Sprintf("filterDay = '%d'", dayIdx) } :class={ fmt.Sprintf("filterDay === '%d' ? 'btn btn-primary btn-xs' : 'btn btn-secondary btn-xs'", dayIdx) } style="font-weight:600;">
											{ dayNameArabic(dayIdx) }
										</button>
									}
								</div>
							</div>

							if len(data.Coverages) == 0 {
								@components.EmptyState(components.EmptyStateProps{
									Title:       "لا توجد نطاقات تغطية محددة حالياً",
									Message:     "قم بإضافة نطاق تغطية جغرافي لفروعك ومستودعاتك لتتمكن الصيدليات الواقعة ضمن هذا النطاق من رؤية عروضك ومنتجاتك والطلب منها.",
									ActionLabel: "إضافة نطاق تغطية جديد",
									ActionURL:   "#add-coverage-panel",
								})
							} else {
								<div style="display:flex; flex-direction:column; gap:0.85rem;">
									for _, cov := range data.Coverages {
										<div x-show={ fmt.Sprintf("filterDay === 'all' || filterDay === '%d'", cov.DayOfWeek) } style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem; display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap; transition:box-shadow 0.2s;" class="coverage-row-card">
											<div style="display:flex; flex-direction:column; gap:0.45rem; flex:1; min-width:260px;">
												
												<!-- Badges & Title -->
												<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
													<span class={ "badge", dayBadgeClass(cov.DayOfWeek) } style="font-weight:700; font-size:0.85rem;">
														{ dayNameArabic(cov.DayOfWeek) }
													</span>
													<span style="font-weight:800; color:var(--text); font-size:1.05rem;">
														{ cov.BranchName }
													</span>
													if cov.CityName != "" {
														<span class="badge badge-secondary" style="font-size:0.78rem;">
															📍 { cov.CityName }
														</span>
													}
													if cov.IsActive {
														<span class="badge badge-emerald" style="font-size:0.75rem; font-weight:700;">مفعل</span>
													} else {
														<span class="badge badge-muted" style="font-size:0.75rem; font-weight:700;">معطل</span>
													}
												</div>

												<!-- Details: Distance, Hours, Coordinates -->
												<div style="font-size:0.85rem; color:var(--text-secondary); display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap; margin-top:0.2rem;">
													<span style="display:flex; align-items:center; gap:0.35rem;">
														<span>📏</span>
														<span>نصف القطر: <strong style="color:var(--text); font-weight:700;">{ formatDistanceKM(cov.DistanceMeters) }</strong></span>
													</span>
													if cov.CoverageFrom != nil && cov.CoverageTo != nil {
														<span style="display:flex; align-items:center; gap:0.35rem;">
															<span>⏰</span>
															<span>ساعات التوصيل: <strong style="color:var(--text); font-weight:700;">{ *cov.CoverageFrom } - { *cov.CoverageTo }</strong></span>
														</span>
													} else {
														<span style="display:flex; align-items:center; gap:0.35rem; color:var(--text-muted);">
															<span>⏰</span>
															<span>توصيل طوال اليوم</span>
														</span>
													}
													if cov.Latitude != nil && cov.Longitude != nil {
														<span style="display:flex; align-items:center; gap:0.35rem; font-size:0.8rem; color:var(--text-muted);" class="tabular-nums">
															<span>🌐</span>
															<span>{ fmt.Sprintf("%.4f, %.4f", *cov.Latitude, *cov.Longitude) }</span>
														</span>
													}
												</div>

												if cov.Address != "" {
													<div style="font-size:0.82rem; color:var(--text-muted); margin-top:0.15rem; display:flex; align-items:center; gap:0.35rem;">
														<span>📝</span>
														<span>{ cov.Address }</span>
													</div>
												}
											</div>

											<!-- Row Actions -->
											<div style="display:flex; align-items:center; gap:0.4rem; flex-shrink:0;">
												<!-- Edit Button (Opens Modal) -->
												<button type="button" @click={ fmt.Sprintf("openEdit({ id: %d, branch_id: '%d', day_of_week: %d, city_id: '%d', distance_meters: %d, coverage_from: '%s', coverage_to: '%s', address: '%s', latitude: '%s', longitude: '%s', is_active: %t })",
													cov.ID,
													cov.BranchID,
													cov.DayOfWeek,
													func() int64 { if cov.CityID != nil { return *cov.CityID }; return 0 }(),
													cov.DistanceMeters,
													func() string { if cov.CoverageFrom != nil { return *cov.CoverageFrom }; return "" }(),
													func() string { if cov.CoverageTo != nil { return *cov.CoverageTo }; return "" }(),
													cov.Address,
													func() string { if cov.Latitude != nil { return fmt.Sprintf("%.6f", *cov.Latitude) }; return "" }(),
													func() string { if cov.Longitude != nil { return fmt.Sprintf("%.6f", *cov.Longitude) }; return "" }(),
													cov.IsActive,
												) } class="btn btn-sm btn-secondary" title="تعديل بيانات التغطية" style="font-weight:600; display:flex; align-items:center; gap:0.35rem;">
													<span>✏️</span>
													<span>تعديل</span>
												</button>

												<!-- Toggle Active/Inactive Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/coverage/%d/toggle", cov.ID)) } class="m-0">
													<button type="submit" class="btn btn-sm btn-ghost" title="تغيير حالة التفعيل">
														if cov.IsActive {
															<span style="color:var(--warning); font-weight:600;">إيقاف</span>
														} else {
															<span style="color:var(--success); font-weight:600;">تفعيل</span>
														}
													</button>
												</form>

												<!-- Delete Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/coverage/%d/delete", cov.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف نطاق التغطية هذا؟');">
													<button type="submit" class="btn btn-sm btn-ghost" style="color:var(--danger);" title="حذف نطاق التغطية">
														@components.IconTrash("icon-xs")
													</button>
												</form>
											</div>
										</div>
									}
								</div>
							}
						</div>

						<!-- Delivery Bands Section -->
						<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem;">
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
								<div>
									<h2 style="font-size:1.15rem; font-weight:700; color:var(--text); margin:0;">
										💰 شرائح رسوم الشحن والتوصيل حسب المسافة
									</h2>
									<p style="font-size:0.8rem; color:var(--text-muted); margin:0.2rem 0 0 0;">
										تسعير ديناميكي يتم تطبيقه تلقائياً عند حساب تكلفة الشحن بناءً على المسافة الجغرافية للصيدلية.
									</p>
								</div>
								<span style="font-size:0.78rem; color:var(--text-muted); background:var(--surface-sunken); padding:0.3rem 0.75rem; border-radius:var(--radius-pill); border:1px solid var(--border);">
									حساب تلقائي بالـ GPS
								</span>
							</div>

							if len(data.Bands) == 0 {
								<div style="padding:1.5rem; text-align:center; color:var(--text-muted); font-size:0.9rem; background:var(--surface-sunken); border-radius:var(--radius-xl); border:1px dashed var(--border);">
									لا توجد شرائح شحن مخصصة حالياً. يتم تطبيق رسوم الشحن الافتراضية للمنشأة.
								</div>
							} else {
								<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:0.85rem;">
									for _, band := range data.Bands {
										<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.1rem; display:flex; justify-content:space-between; align-items:center;">
											<div>
												<div style="font-weight:700; font-size:0.95rem; color:var(--text);">
													{ fmt.Sprintf("من %d إلى %d كم", band.FromMeters/1000, band.ToMeters/1000) }
												</div>
												<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;">شريحة توصيل جغرافي</div>
											</div>
											<div style="font-weight:800; color:var(--accent); font-size:1.1rem;" class="tabular-nums">
												{ band.Fee.String() }
											</div>
										</div>
									}
								</div>
							}
						</div>
					</div>

					<!-- Right Column: Add Coverage Form Panel -->
					<div id="add-coverage-panel" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; position:sticky; top:1.5rem;">
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem; padding-bottom:0.75rem; border-bottom:1px solid var(--border);">
							<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.25rem; font-weight:700; flex-shrink:0;">
								+
							</div>
							<div>
								<h3 style="margin:0; font-size:1.15rem; font-weight:700; color:var(--text);">
									إضافة نطاق تغطية جديد
								</h3>
								<p style="margin:0.15rem 0 0 0; font-size:0.78rem; color:var(--text-muted);">
									حدد الفرع، يوم التوصيل، والمسافة
								</p>
							</div>
						</div>

						<form method="POST" action="/vendor/coverage" x-data="{ busy: false, applyAllDays: false }" @submit="busy = true" class="stack" style="gap:1.1rem;">
							
							<!-- Branch Selector -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
									الفرع أو المستودع المنطلق <span class="text-danger">*</span>
								</label>
								<select name="branch_id" class="form-select" required style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;">
									<option value="">-- اختر الفرع التابع --</option>
									for _, b := range data.Branches {
										<option value={ fmt.Sprintf("%d", b.ID) }>
											{ b.Name.Get(i18n.ParseLang(lang)) }
											if b.IsMain {
												<span> (الفرع الرئيسي)</span>
											}
										</option>
									}
								</select>
							</div>

							<!-- Day Scope Selector (Single vs All Week) -->
							<div>
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
									<label style="font-size:0.85rem; font-weight:700; color:var(--text);">
										أيام التغطية والتوصيل <span class="text-danger">*</span>
									</label>
									<label style="font-size:0.78rem; color:var(--accent); font-weight:600; cursor:pointer; display:flex; align-items:center; gap:0.35rem;">
										<input type="checkbox" name="apply_to_all_days" value="true" x-model="applyAllDays" style="width:15px; height:15px; accent-color:var(--accent);"/>
										<span>تطبيق على كامل الأسبوع (7 أيام)</span>
									</label>
								</div>

								<div x-show="!applyAllDays">
									<select id="add_day_of_week_select" name="day_of_week" class="form-select" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;">
										<option value="0">الأحد (Sunday)</option>
										<option value="1">الاثنين (Monday)</option>
										<option value="2">الثلاثاء (Tuesday)</option>
										<option value="3">الأربعاء (Wednesday)</option>
										<option value="4">الخميس (Thursday)</option>
										<option value="5">الجمعة (Friday)</option>
										<option value="6">السبت (Saturday)</option>
									</select>
								</div>
								<div x-show="applyAllDays" style="display:none; padding:0.65rem 0.85rem; background:var(--accent-subtle); border-radius:var(--radius-md); border:1px solid var(--accent); color:var(--text); font-size:0.82rem; font-weight:600;">
									✨ سيتم إنشاء مسارات تغطية لجميع أيام الأسبوع (الأحد إلى السبت) دفعة واحدة.
								</div>
							</div>

							<!-- Target City -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
									المدينة / المحافظة المستهدفة
								</label>
								<select name="city_id" class="form-select" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;">
									<option value="">-- اختياري (يتم أخذها تلقائياً من الفرع) --</option>
									for _, c := range data.Cities {
										<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name.Get(i18n.ParseLang(lang)) }</option>
									}
								</select>
							</div>

							<!-- Distance with Quick Buttons -->
							<div>
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
									<label style="font-size:0.85rem; font-weight:700; color:var(--text);">
										نصف قطر التغطية (بالمتر) <span class="text-danger">*</span>
									</label>
								</div>
								<input id="add_distance_input" type="number" name="distance_meters" value="25000" min="500" max="500000" step="500" class="form-input" required style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;"/>
								
								<!-- Quick distance presets -->
								<div style="display:flex; gap:0.4rem; margin-top:0.4rem; flex-wrap:wrap;">
									<button type="button" @click="setAddDistance(10000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">10 كم</button>
									<button type="button" @click="setAddDistance(25000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">25 كم</button>
									<button type="button" @click="setAddDistance(50000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">50 كم</button>
									<button type="button" @click="setAddDistance(100000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">100 كم</button>
								</div>
							</div>

							<!-- Time Window with Quick Presets -->
							<div>
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
									<label style="font-size:0.85rem; font-weight:700; color:var(--text);">
										ساعات العمل والتوصيل
									</label>
								</div>
								<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
									<div>
										<label style="display:block; font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">من الساعة</label>
										<input id="add_coverage_from_input" type="time" name="coverage_from" value="09:00" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
									</div>
									<div>
										<label style="display:block; font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">إلى الساعة</label>
										<input id="add_coverage_to_input" type="time" name="coverage_to" value="17:00" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
									</div>
								</div>
								<div style="display:flex; gap:0.4rem; margin-top:0.4rem; flex-wrap:wrap;">
									<button type="button" @click="setAddTime('09:00', '17:00')" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">صباحي (9 - 5)</button>
									<button type="button" @click="setAddTime('16:00', '23:00')" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">مسائي (4 - 11)</button>
									<button type="button" @click="setAddTime('', '')" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">طوال اليوم</button>
								</div>
							</div>

							<!-- Coordinates (Optional manual override) -->
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div>
									<label style="display:block; font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.3rem;">
										خط العرض (Latitude)
									</label>
									<input type="number" step="any" name="latitude" placeholder="تلقائي من الفرع" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
								</div>
								<div>
									<label style="display:block; font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.3rem;">
										خط الطول (Longitude)
									</label>
									<input type="number" step="any" name="longitude" placeholder="تلقائي من الفرع" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
								</div>
							</div>

							<!-- Address / Notes -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem;">
									ملاحظات ووصف خط السير
								</label>
								<input type="text" name="address" placeholder="مثال: توصيل صيدليات شرق القاهرة والتجمع" class="form-input" style="width:100%; padding:0.6rem 0.8rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
							</div>

							<!-- Active Toggle -->
							<div style="display:flex; align-items:center; gap:0.5rem;">
								<input type="checkbox" id="add_is_active_input" name="is_active" value="true" checked style="width:18px; height:18px; accent-color:var(--accent);"/>
								<label for="add_is_active_input" style="font-size:0.85rem; font-weight:600; color:var(--text); cursor:pointer;">
									تفعيل نطاق التغطية فور الحفظ
								</label>
							</div>

							<!-- Submit Button -->
							<div style="margin-top:0.25rem;">
								<button type="submit" class="btn btn-primary" :disabled="busy" style="width:100%; padding:0.75rem; font-weight:700; display:flex; align-items:center; justify-content:center; gap:0.5rem; font-size:0.95rem;">
									<span x-show="!busy">💾 حفظ نطاق التغطية</span>
									<span x-show="busy" style="display:none;">جاري الحفظ...</span>
								</button>
							</div>
						</form>
					</div>
				</div>

				<!-- Edit Coverage Modal -->
				<div x-show="editModalOpen" style="display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,0.65); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;" @keydown.escape.window="closeEdit()">
					<div @click.away="closeEdit()" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); width:100%; max-width:580px; max-height:90vh; overflow-y:auto; padding:1.75rem; box-shadow:var(--shadow-2xl);">
						
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; padding-bottom:0.75rem; border-bottom:1px solid var(--border);">
							<div style="display:flex; align-items:center; gap:0.5rem;">
								<span style="font-size:1.25rem;">✏️</span>
								<h3 style="margin:0; font-size:1.2rem; font-weight:800; color:var(--text);">
									تعديل نطاق التغطية الأسبوعية
								</h3>
							</div>
							<button type="button" @click="closeEdit()" class="btn btn-icon btn-ghost" style="font-size:1.25rem; line-height:1;" title="إغلاق">
								✕
							</button>
						</div>

						<form method="POST" :action="'/vendor/coverage/' + editCov.id" class="stack" style="gap:1rem;">
							
							<!-- Branch Selector -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem;">
									الفرع التابع <span class="text-danger">*</span>
								</label>
								<select name="branch_id" x-model="editCov.branch_id" class="form-select" required style="width:100%; padding:0.6rem 0.8rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;">
									for _, b := range data.Branches {
										<option value={ fmt.Sprintf("%d", b.ID) }>{ b.Name.Get(i18n.ParseLang(lang)) }</option>
									}
								</select>
							</div>

							<!-- Day of Week -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem;">
									يوم التوصيل الأسبوعي <span class="text-danger">*</span>
								</label>
								<select name="day_of_week" x-model="editCov.day_of_week" class="form-select" required style="width:100%; padding:0.6rem 0.8rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;">
									<option value="0">الأحد (Sunday)</option>
									<option value="1">الاثنين (Monday)</option>
									<option value="2">الثلاثاء (Tuesday)</option>
									<option value="3">الأربعاء (Wednesday)</option>
									<option value="4">الخميس (Thursday)</option>
									<option value="5">الجمعة (Friday)</option>
									<option value="6">السبت (Saturday)</option>
								</select>
							</div>

							<!-- City -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem;">
									المدينة / المحافظة المستهدفة
								</label>
								<select name="city_id" x-model="editCov.city_id" class="form-select" style="width:100%; padding:0.6rem 0.8rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;">
									<option value="">-- تلقائي من الفرع --</option>
									for _, c := range data.Cities {
										<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name.Get(i18n.ParseLang(lang)) }</option>
									}
								</select>
							</div>

							<!-- Distance -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem;">
									نصف قطر التغطية (بالمتر) <span class="text-danger">*</span>
								</label>
								<input type="number" name="distance_meters" x-model="editCov.distance_meters" min="500" max="500000" step="500" class="form-input" required style="width:100%; padding:0.6rem 0.8rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.9rem;"/>
								
								<div style="display:flex; gap:0.4rem; margin-top:0.35rem; flex-wrap:wrap;">
									<button type="button" @click="setEditDistance(10000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">10 كم</button>
									<button type="button" @click="setEditDistance(25000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">25 كم</button>
									<button type="button" @click="setEditDistance(50000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">50 كم</button>
									<button type="button" @click="setEditDistance(100000)" class="btn btn-xs btn-secondary" style="font-size:0.72rem;">100 كم</button>
								</div>
							</div>

							<!-- Times -->
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div>
									<label style="display:block; font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.3rem;">من الساعة</label>
									<input type="time" name="coverage_from" x-model="editCov.coverage_from" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
								</div>
								<div>
									<label style="display:block; font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.3rem;">إلى الساعة</label>
									<input type="time" name="coverage_to" x-model="editCov.coverage_to" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
								</div>
							</div>

							<!-- Coordinates -->
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div>
									<label style="display:block; font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.3rem;">خط العرض</label>
									<input type="number" step="any" name="latitude" x-model="editCov.latitude" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
								</div>
								<div>
									<label style="display:block; font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.3rem;">خط الطول</label>
									<input type="number" step="any" name="longitude" x-model="editCov.longitude" class="form-input" style="width:100%; padding:0.55rem 0.75rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
								</div>
							</div>

							<!-- Address -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem;">الوصف والملاحظات</label>
								<input type="text" name="address" x-model="editCov.address" class="form-input" style="width:100%; padding:0.6rem 0.8rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-size:0.85rem;"/>
							</div>

							<!-- Active Checkbox -->
							<div style="display:flex; align-items:center; gap:0.5rem;">
								<input type="checkbox" id="edit_is_active_input" name="is_active" value="true" x-model="editCov.is_active" style="width:18px; height:18px; accent-color:var(--accent);"/>
								<label for="edit_is_active_input" style="font-size:0.85rem; font-weight:600; color:var(--text); cursor:pointer;">
									نطاق التغطية مفعل
								</label>
							</div>

							<!-- Action Buttons -->
							<div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.75rem; gap:0.75rem;">
								<button type="button" @click="closeEdit()" class="btn btn-secondary" style="flex:1;">
									إلغاء
								</button>
								<button type="submit" class="btn btn-primary" style="flex:1; font-weight:700;">
									💾 حفظ التعديلات
								</button>
							</div>
						</form>
					</div>
				</div>
			}
		</div>
	}
}
