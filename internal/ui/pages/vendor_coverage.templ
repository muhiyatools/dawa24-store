package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorCoverageData struct {
	Coverages           []*workflow.CoverageView
	Branches            []*org.Branch
	Bands               []*org.DeliveryBand
	Cities              []*platformadmin.City
	CoverageUnavailable bool
	NoticeType          string
	NoticeMessage       string
}

func dayNameArabic(day int) string {
	switch day {
	case 0:
		return "الأحد"
	case 1:
		return "الاثنين"
	case 2:
		return "الثلاثاء"
	case 3:
		return "الأربعاء"
	case 4:
		return "الخميس"
	case 5:
		return "الجمعة"
	case 6:
		return "السبت"
	default:
		return fmt.Sprintf("يوم %d", day)
	}
}

templ VendorCoveragePage(data VendorCoverageData, lang, dir string) {
	@layouts.VendorShell("نطاق التغطية والتوصيل الأسبوعي", "coverage", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.75rem;">

			<!-- Notice / Toast Banner -->
			if data.NoticeMessage != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger" style="margin-bottom:0.5rem; display:flex; align-items:center; justify-content:space-between;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							<span>⚠️</span>
							<span>{ data.NoticeMessage }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success" style="margin-bottom:0.5rem; display:flex; align-items:center; justify-content:space-between;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							<span>✅</span>
							<span>{ data.NoticeMessage }</span>
						</div>
					</div>
				}
			}

			<!-- Header Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; padding-bottom:0.5rem; border-bottom:1px solid var(--border);">
				<div style="display:flex; align-items:center; gap:1rem;">
					<div style="width:52px; height:52px; border-radius:var(--radius-xl); background:var(--accent-subtle); border:1px solid var(--accent); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
						🚚
					</div>
					<div>
						<h1 style="font-size:1.6rem; font-weight:800; color:var(--text); margin:0;">
							جدول التغطية الجغرافية والتوصيل الأسبوعي
						</h1>
						<p style="color:var(--text-muted); font-size:0.875rem; margin:0.2rem 0 0 0;">
							تحديد المركز الجغرافي ونصف قطر التوصيل (بالمتر) لكل يوم من أيام الأسبوع لحساب طلبات عروض الأسعار بدقة.
						</p>
					</div>
				</div>

				<div class="row-center">
					<a href="#add-coverage-panel" class="btn btn-primary" style="font-weight:700;">
						@components.IconPlus("icon-xs")
						<span>إضافة نطاق تغطية جديد</span>
					</a>
				</div>
			</div>

			if data.CoverageUnavailable {
				<div style="margin:2rem 0;">
					@components.ErrorState(components.ErrorStateProps{
						Title:      "تعذر تحميل جدول التغطية",
						Message:    "حدث خطأ غير متوقع أثناء استرجاع بيانات التغطية الأسبوعية. يرجى إعادة المحاولة.",
						RetryURL:   "/vendor/coverage",
						RetryLabel: "إعادة المحاولة",
					})
				</div>
			} else {
				<!-- Quick Metrics -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem;">
					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.2rem 1.4rem; border-inline-start:4px solid var(--accent);">
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">إجمالي نطاقات التغطية</div>
						<div style="font-size:1.75rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", len(data.Coverages)) }
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem;">مسارات توصيل مسجلة</div>
					</div>

					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.2rem 1.4rem; border-inline-start:4px solid var(--success);">
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">الفروع المغطاة</div>
						<div style="font-size:1.75rem; font-weight:800; color:var(--success); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", len(data.Branches)) }
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem;">نقاط توزيع ومستودعات</div>
					</div>

					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.2rem 1.4rem; border-inline-start:4px solid var(--secondary);">
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">شرائح رسوم الشحن</div>
						<div style="font-size:1.75rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", len(data.Bands)) }
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem;">شرائح مسافة مفعلة</div>
					</div>
				</div>

				<!-- Main Split Layout: Left = Coverage List & 7-Day Grid, Right = Add Coverage Form -->
				<div style="display:grid; grid-template-columns:1.2fr 0.8fr; gap:1.75rem; align-items:start;" class="coverage-split-layout">

					<!-- Left Column: Coverage List & 7-Day Grid -->
					<div style="display:flex; flex-direction:column; gap:1.5rem;">
						<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem;">
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
								<h2 style="font-size:1.15rem; font-weight:700; color:var(--text); margin:0;">
									جدول مسارات التوصيل الأسبوعية
								</h2>
								<span style="font-size:0.8rem; color:var(--text-muted);">الأحد - السبت</span>
							</div>

							if len(data.Coverages) == 0 {
								@components.EmptyState(components.EmptyStateProps{
									Title:       "لا توجد نطاقات تغطية محددة",
									Message:     "قم بإضافة نطاق تغطية جغرافي لفروعك لتتمكن الصيدليات الواقعة ضمن النطاق من رؤية عروضك والطلب منها.",
									ActionLabel: "إضافة نطاق تغطية جديد",
									ActionURL:   "#add-coverage-panel",
								})
							} else {
								<div class="stack">
									for _, cov := range data.Coverages {
										<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem; display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap;">
											<div style="display:flex; flex-direction:column; gap:0.4rem;">
												<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
													<span class="badge badge-sky" style="font-weight:700;">
														{ dayNameArabic(cov.DayOfWeek) }
													</span>
													<span style="font-weight:700; color:var(--text); font-size:1rem;">
														{ cov.BranchName }
													</span>
													if cov.CityName != "" {
														<span class="badge badge-secondary" style="font-size:0.75rem;">
															📍 { cov.CityName }
														</span>
													}
													if cov.IsActive {
														<span class="badge badge-emerald" style="font-size:0.75rem;">مفعل</span>
													} else {
														<span class="badge badge-muted" style="font-size:0.75rem;">معطل</span>
													}
												</div>

												<div style="font-size:0.85rem; color:var(--text-secondary); display:flex; align-items:center; gap:1rem; flex-wrap:wrap; margin-top:0.25rem;">
													<span>
														📏 نطاق التغطية: <strong style="color:var(--text);">{ fmt.Sprintf("%.1f كم (%d م)", float64(cov.DistanceMeters)/1000.0, cov.DistanceMeters) }</strong>
													</span>
													if cov.CoverageFrom != nil && cov.CoverageTo != nil {
														<span>
															⏰ مواعيد العمل: <strong style="color:var(--text);">{ *cov.CoverageFrom } - { *cov.CoverageTo }</strong>
														</span>
													}
												</div>

												if cov.Address != "" {
													<div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.1rem;">
														📝 { cov.Address }
													</div>
												}
											</div>

											<!-- Row Actions -->
											<div style="display:flex; align-items:center; gap:0.5rem;">
												<!-- Toggle Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/coverage/%d/toggle", cov.ID)) } class="m-0">
													<button type="submit" class="btn btn-sm btn-ghost" title="تغيير حالة التفعيل">
														if cov.IsActive {
															<span style="color:var(--warning);">إيقاف</span>
														} else {
															<span style="color:var(--success);">تفعيل</span>
														}
													</button>
												</form>

												<!-- Delete Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/coverage/%d/delete", cov.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف نطاق التغطية هذا؟');">
													<button type="submit" class="btn btn-sm btn-ghost" style="color:var(--danger);" title="حذف نطاق التغطية">
														@components.IconTrash("icon-xs")
													</button>
												</form>
											</div>
										</div>
									}
								</div>
							}
						</div>

						<!-- Delivery Bands Section -->
						<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem;">
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
								<h2 style="font-size:1.15rem; font-weight:700; color:var(--text); margin:0;">
									شرائح رسوم الشحن والتوصيل حسب المسافة
								</h2>
								<span style="font-size:0.8rem; color:var(--text-muted);">تسعير ديناميكي</span>
							</div>

							if len(data.Bands) == 0 {
								<div style="padding:1.5rem; text-align:center; color:var(--text-muted); font-size:0.9rem; background:var(--surface-sunken); border-radius:var(--radius-lg);">
									لا توجد شرائح شحن مخصصة حالياً. يتم تطبيق رسوم الشحن الافتراضية.
								</div>
							} else {
								<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:0.75rem;">
									for _, band := range data.Bands {
										<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1rem; display:flex; justify-content:space-between; align-items:center;">
											<div>
												<div style="font-weight:700; font-size:0.9rem; color:var(--text);">
													{ fmt.Sprintf("من %d إلى %d كم", band.FromMeters/1000, band.ToMeters/1000) }
												</div>
												<div style="font-size:0.75rem; color:var(--text-muted);">توصيل جغرافي</div>
											</div>
											<div style="font-weight:800; color:var(--accent); font-size:1rem;" class="tabular-nums">
												{ band.Fee.String() }
											</div>
										</div>
									}
								</div>
							}
						</div>
					</div>

					<!-- Right Column: Add Coverage Form Panel -->
					<div id="add-coverage-panel" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; position:sticky; top:1.5rem;">
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem; padding-bottom:0.75rem; border-bottom:1px solid var(--border);">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-weight:700;">
								+
							</div>
							<div>
								<h3 style="margin:0; font-size:1.1rem; font-weight:700; color:var(--text);">
									إضافة نطاق تغطية لفرع
								</h3>
								<p style="margin:0; font-size:0.75rem; color:var(--text-muted);">
									حدد الفرع ويوم التوصيل ونطاق المسافة بالمتر
								</p>
							</div>
						</div>

						<form method="POST" action="/vendor/coverage" x-data="{ busy: false }" @submit="busy = true" class="stack">
							
							<!-- Branch Selector -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
									الفرع / المستودع التابع <span class="text-danger">*</span>
								</label>
								<select name="branch_id" class="form-select" required style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);">
									<option value="">-- اختر الفرع --</option>
									for _, b := range data.Branches {
										<option value={ fmt.Sprintf("%d", b.ID) }>{ b.Name.Get(i18n.ParseLang(lang)) }</option>
									}
								</select>
							</div>

							<!-- Day of Week Selector -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
									يوم التغطية الأسبوعي <span class="text-danger">*</span>
								</label>
								<select name="day_of_week" class="form-select" required style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);">
									<option value="0">الأحد (Sunday)</option>
									<option value="1">الاثنين (Monday)</option>
									<option value="2">الثلاثاء (Tuesday)</option>
									<option value="3">الأربعاء (Wednesday)</option>
									<option value="4">الخميس (Thursday)</option>
									<option value="5">الجمعة (Friday)</option>
									<option value="6">السبت (Saturday)</option>
								</select>
							</div>

							<!-- City Selector -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
									المدينة / المحافظة المستهدفة
								</label>
								<select name="city_id" class="form-select" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);">
									<option value="">-- اختياري (تلقائي من الفرع) --</option>
									for _, c := range data.Cities {
										<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name.Get(i18n.ParseLang(lang)) }</option>
									}
								</select>
							</div>

							<!-- Distance in Meters -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
									نصف قطر التغطية (بالمتر) <span class="text-danger">*</span>
								</label>
								<input type="number" name="distance_meters" value="25000" min="500" max="500000" step="500" class="form-input" required style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);"/>
								<span style="font-size:0.75rem; color:var(--text-muted); margin-top:0.2rem; display:block;">
									مثال: 25,000 متر = 25 كيلومتر
								</span>
							</div>

							<!-- Time Window -->
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div>
									<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
										من الساعة
									</label>
									<input type="time" name="coverage_from" value="09:00" class="form-input" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);"/>
								</div>
								<div>
									<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
										إلى الساعة
									</label>
									<input type="time" name="coverage_to" value="17:00" class="form-input" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);"/>
								</div>
							</div>

							<!-- Coordinates (Manual Fallback + Map Picker) -->
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div>
									<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
										خط العرض (Latitude)
									</label>
									<input type="number" step="any" name="latitude" placeholder="30.0444" class="form-input" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);"/>
								</div>
								<div>
									<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
										خط الطول (Longitude)
									</label>
									<input type="number" step="any" name="longitude" placeholder="31.2357" class="form-input" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);"/>
								</div>
							</div>

							<!-- Address / Notes -->
							<div>
								<label style="display:block; font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
									وصف نطاق التغطية والملاحظات
								</label>
								<input type="text" name="address" placeholder="مثال: قطاع القاهرة الكبرى وشرق الدلتا" class="form-input" style="width:100%; padding:0.65rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text);"/>
							</div>

							<!-- Active Toggle -->
							<div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.25rem;">
								<input type="checkbox" id="is_active_input" name="is_active" value="true" checked style="width:18px; height:18px; accent-color:var(--accent);"/>
								<label for="is_active_input" style="font-size:0.85rem; font-weight:600; color:var(--text); cursor:pointer;">
									تفعيل نطاق التغطية فور الحفظ
								</label>
							</div>

							<!-- Submit Button -->
							<div style="margin-top:0.5rem;">
								<button type="submit" class="btn btn-primary" :disabled="busy" style="width:100%; padding:0.75rem; font-weight:700; display:flex; align-items:center; justify-content:center; gap:0.5rem;">
									<span x-show="!busy">💾 حفظ نطاق التغطية</span>
									<span x-show="busy" style="display:none;">جاري الحفظ...</span>
								</button>
							</div>
						</form>
					</div>
				</div>
			}
		</div>
	}
}
