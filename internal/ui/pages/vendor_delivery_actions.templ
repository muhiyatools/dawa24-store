package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// What the representative does next.
//
// The two halves are deliberately different in kind. Moving a parcel forward —
// picked up, on the way — is a claim the courier makes about themselves, so it
// is one button. Closing it is a claim about the pharmacy, so it needs the
// pharmacy's own six-digit code; the courier cannot mark a parcel delivered by
// asserting it.

templ VendorDeliveryActions(data VendorDeliveryDetailData, lang string) {
	if data.Shipment.IsClosed() {
		@VendorDeliveryClosedCard(data.Shipment)
	} else if !data.CanUpdate {
		<div class="courier-card text-center p-6">
			<div class="mb-2">@components.IconInfo("icon-sm")</div>
			<h3 class="text-sm font-black text-primary m-0 mb-1">هذا الطرد غير مسند إليك</h3>
			<p class="text-xs text-secondary m-0 font-medium">
				if data.CanAssign {
					يمكنك إسناده إلى أحد مندوبي التوصيل من الأعلى؛ إجراءات التوصيل نفسها يقوم بها المندوب المسؤول.
				} else {
					إجراءات التسليم متاحة للمندوب المسند إليه الطرد فقط.
				}
			</p>
		</div>
	} else {
		@VendorDeliveryPipelineCard(data.Shipment)
	}
}

func deliveryPipelineStepIndex(status commerce.OrderStatus) int {
	switch status {
	case commerce.StatusPending, commerce.StatusProcessing, commerce.StatusConfirmed:
		return 1
	case commerce.StatusShipped:
		return 2
	case commerce.StatusInTransit:
		return 3
	case commerce.StatusOutForDelivery:
		return 4
	default:
		return 5
	}
}

// VendorDeliveryPipelineCard renders the step progress timeline and ONLY the single
// active forward action for the current state, plus the delivery failure modal.
templ VendorDeliveryPipelineCard(sh *commerce.OrderShipment) {
	{{ currentStep := deliveryPipelineStepIndex(sh.Status) }}
	<div x-data="{ showFailModal: false }" class="stack-md">
		<!-- Step Timeline Indicator -->
		<div class="courier-card p-4">
			<div class="d-flex items-center gap-2 mb-3 pb-2 border-b text-primary">
				@components.IconTruck("icon-xs")
				<h3 class="text-xs font-black m-0">مراحل توصيل الطرد</h3>
			</div>

			<div class="grid grid-cols-4 gap-1.5 text-center text-2xs font-bold">
				<!-- Step 1 -->
				<div class={ "p-2 rounded-xl border flex flex-col items-center gap-1", templ.KV("bg-emerald-50 border-emerald-300 text-emerald-700", currentStep > 1), templ.KV("bg-brand/10 border-brand text-brand font-black", currentStep == 1), templ.KV("bg-surface-sunken text-muted border-slate-200", currentStep < 1) }>
					<span class={ "w-5 h-5 rounded-full flex items-center justify-center text-2xs font-bold border", templ.KV("bg-emerald-600 text-white border-emerald-600", currentStep > 1), templ.KV("bg-brand text-white border-brand", currentStep == 1), templ.KV("bg-slate-200 text-slate-500 border-slate-300", currentStep < 1) }>
						if currentStep > 1 {
							✓
						} else {
							1
						}
					</span>
					<span>استلام المخزن</span>
				</div>

				<!-- Step 2 -->
				<div class={ "p-2 rounded-xl border flex flex-col items-center gap-1", templ.KV("bg-emerald-50 border-emerald-300 text-emerald-700", currentStep > 2), templ.KV("bg-brand/10 border-brand text-brand font-black", currentStep == 2), templ.KV("bg-surface-sunken text-muted border-slate-200", currentStep < 2) }>
					<span class={ "w-5 h-5 rounded-full flex items-center justify-center text-2xs font-bold border", templ.KV("bg-emerald-600 text-white border-emerald-600", currentStep > 2), templ.KV("bg-brand text-white border-brand", currentStep == 2), templ.KV("bg-slate-200 text-slate-500 border-slate-300", currentStep < 2) }>
						if currentStep > 2 {
							✓
						} else {
							2
						}
					</span>
					<span>في الطريق</span>
				</div>

				<!-- Step 3 -->
				<div class={ "p-2 rounded-xl border flex flex-col items-center gap-1", templ.KV("bg-emerald-50 border-emerald-300 text-emerald-700", currentStep > 3), templ.KV("bg-brand/10 border-brand text-brand font-black", currentStep == 3), templ.KV("bg-surface-sunken text-muted border-slate-200", currentStep < 3) }>
					<span class={ "w-5 h-5 rounded-full flex items-center justify-center text-2xs font-bold border", templ.KV("bg-emerald-600 text-white border-emerald-600", currentStep > 3), templ.KV("bg-brand text-white border-brand", currentStep == 3), templ.KV("bg-slate-200 text-slate-500 border-slate-300", currentStep < 3) }>
						if currentStep > 3 {
							✓
						} else {
							3
						}
					</span>
					<span>وصلت للصيدلية</span>
				</div>

				<!-- Step 4 -->
				<div class={ "p-2 rounded-xl border flex flex-col items-center gap-1", templ.KV("bg-emerald-50 border-emerald-300 text-emerald-700", currentStep > 4), templ.KV("bg-brand/10 border-brand text-brand font-black", currentStep == 4), templ.KV("bg-surface-sunken text-muted border-slate-200", currentStep < 4) }>
					<span class={ "w-5 h-5 rounded-full flex items-center justify-center text-2xs font-bold border", templ.KV("bg-emerald-600 text-white border-emerald-600", currentStep > 4), templ.KV("bg-brand text-white border-brand", currentStep == 4), templ.KV("bg-slate-200 text-slate-500 border-slate-300", currentStep < 4) }>
						if currentStep > 4 {
							✓
						} else {
							4
						}
					</span>
					<span>تأكيد الكود</span>
				</div>
			</div>
		</div>

		<!-- Step Action Execution Card -->
		if currentStep == 1 {
			<div class="courier-card p-5 border-brand">
				<div class="d-flex items-center gap-3 mb-3">
					<div class="courier-hero-icon bg-blue-50 text-brand border-brand/20">
						@components.IconPackage("icon-md")
					</div>
					<div>
						<h3 class="text-sm font-black text-primary m-0">الخطوة الأولى: استلام الطرد من المستودع</h3>
						<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
							قم بفحص الطرد ومطابقة رقم الشحنة مع المستودع ثم اضغط لبدء رحلة التوصيل.
						</p>
					</div>
				</div>

				<form action={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d/status", sh.ID)) } method="POST" class="m-0 mt-4">
					<input type="hidden" name="status" value={ string(commerce.StatusShipped) }/>
					<input type="hidden" name="notes" value="استلم المندوب الطرد من المخزن وبدأ رحلة التوصيل"/>
					<button type="submit" class="btn btn-primary w-full py-3 font-black text-sm rounded-xl gap-2 d-flex items-center justify-center shadow-sm">
						@components.IconCheckCircle("icon-sm")
						<span>استلمت الطرد من المخزن (بدء التوصيل)</span>
					</button>
				</form>

				<div class="mt-3 pt-3 border-t text-center">
					<button type="button" @click="showFailModal = true" class="btn btn-ghost text-danger btn-xs font-bold gap-1">
						@components.IconAlert("icon-2xs")
						<span>تعذر استلام أو تسليم الطرد؟</span>
					</button>
				</div>
			</div>
		} else if currentStep == 2 {
			<div class="courier-card p-5 border-sky-400">
				<div class="d-flex items-center gap-3 mb-3">
					<div class="courier-hero-icon bg-sky-50 text-sky-600 border-sky-500/20">
						@components.IconTruck("icon-md")
					</div>
					<div>
						<h3 class="text-sm font-black text-primary m-0">الخطوة الثانية: التحرك إلى الصيدلية</h3>
						<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
							تم استلام الطرد بنجاح. عند تحركك نحو عنوان الصيدلية اضغط لتحديث موقعك وإشعار الصيدلي.
						</p>
					</div>
				</div>

				<form action={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d/status", sh.ID)) } method="POST" class="m-0 mt-4">
					<input type="hidden" name="status" value={ string(commerce.StatusInTransit) }/>
					<input type="hidden" name="notes" value="الطرد في الطريق إلى الصيدلية"/>
					<button type="submit" class="btn btn-primary w-full py-3 font-black text-sm rounded-xl gap-2 d-flex items-center justify-center shadow-sm">
						@components.IconTruck("icon-sm")
						<span>في الطريق إلى الصيدلية (تحرك الآن)</span>
					</button>
				</form>

				<div class="mt-3 pt-3 border-t text-center">
					<button type="button" @click="showFailModal = true" class="btn btn-ghost text-danger btn-xs font-bold gap-1">
						@components.IconAlert("icon-2xs")
						<span>تعذر التوصيل؟</span>
					</button>
				</div>
			</div>
		} else if currentStep == 3 {
			<div class="courier-card p-5 border-amber-400">
				<div class="d-flex items-center gap-3 mb-3">
					<div class="courier-hero-icon bg-amber-50 text-amber-600 border-amber-500/20">
						@components.IconMapPin("icon-md")
					</div>
					<div>
						<h3 class="text-sm font-black text-primary m-0">الخطوة الثالثة: الوصول إلى مقر الصيدلية</h3>
						<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
							عند وصولك أمام فرع الصيدلية، اضغط لتنبيه الصيدلي بالاستعداد وإحضار كود الاستلام.
						</p>
					</div>
				</div>

				<form action={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d/status", sh.ID)) } method="POST" class="m-0 mt-4">
					<input type="hidden" name="status" value={ string(commerce.StatusOutForDelivery) }/>
					<input type="hidden" name="notes" value="وصل المندوب إلى مقر الصيدلية وبانتظار كود الاستلام"/>
					<button type="submit" class="btn btn-primary w-full py-3 font-black text-sm rounded-xl gap-2 d-flex items-center justify-center shadow-sm">
						@components.IconMapPin("icon-sm")
						<span>وصلت إلى الصيدلية (أمام الفرع)</span>
					</button>
				</form>

				<div class="mt-3 pt-3 border-t text-center">
					<button type="button" data-modal-open="delivery-fail-modal" @click="showFailModal = true" class="btn btn-ghost text-danger btn-xs font-bold gap-1">
						@components.IconAlert("icon-2xs")
						<span>تعذر التسليم للصيدلية؟</span>
					</button>
				</div>
			</div>
		} else if currentStep == 4 {
			<!-- Handover PIN Verification -->
			@VendorDeliveryHandoverCard(sh)

			<div class="courier-card p-3 text-center">
				<button type="button" data-modal-open="delivery-fail-modal" @click="showFailModal = true" class="btn btn-ghost text-danger btn-xs font-bold gap-1">
					@components.IconAlert("icon-2xs")
					<span>تعذر تسليم الطرد للصيدلية (إلغاء أو رفض)؟</span>
				</button>
			</div>
		}

		<!-- Failure Reason Modal -->
		@components.Modal(components.ModalProps{
			ID:          "delivery-fail-modal",
			Title:       "تسجيل تعذر تسليم الطرد",
			Subtitle:    "إجراء نهائي يتم توثيقه في سجل الطلب والشحنة",
			Icon:        "alert",
			Size:        "sm",
			AlpineClose: "showFailModal = false",
		}) {
			<form action={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d/status", sh.ID)) } method="POST" class="m-0 stack-sm">
				<input type="hidden" name="status" value={ string(commerce.StatusFailed) }/>

				<div>
					<label class="form-label text-xs font-black text-primary d-block mb-1.5">
						سبب تعذر التسليم <span class="text-danger">*</span>:
					</label>
					<select name="failure_reason" required class="form-select text-xs w-full rounded-xl">
						<option value="" disabled selected>-- اختر سبب التعذر --</option>
						<option value="الصيدلية مغلقة">الصيدلية مغلقة</option>
						<option value="رفض الاستلام من قبل الصيدلي أو المسؤول">رفض الاستلام من قبل الصيدلي أو المسؤول</option>
						<option value="العنوان خاطئ أو تعذر الوصول للموقع">العنوان خاطئ أو تعذر الوصول للموقع</option>
						<option value="عدم الرد على الهاتف بعد عدة محاولات">عدم الرد على الهاتف بعد عدة محاولات</option>
						<option value="مبلغ التحصيل غير متوفر بالفرع">مبلغ التحصيل غير متوفر بالفرع</option>
						<option value="تلف أو مشكلة في محتويات الطرد">تلف أو مشكلة في محتويات الطرد</option>
						<option value="طلب إلغاء من قبل الصيدلية">طلب إلغاء من قبل الصيدلية</option>
						<option value="سبب آخر">سبب آخر (يُرجى التوضيح بالملاحظات)</option>
					</select>
				</div>

				<div>
					<label class="form-label text-xs font-black text-primary d-block mb-1.5">
						تفاصيل الواقعة وملاحظات المندوب <span class="text-danger">*</span>:
					</label>
					<textarea
						name="notes"
						required
						minlength="5"
						rows="3"
						placeholder="اكتب بالتفصيل ما حدث أثناء محاولة التسليم ولماذا تعذر إتمامه..."
						class="form-input text-xs w-full rounded-xl"
					></textarea>
				</div>

				<p class="text-2xs text-muted m-0 leading-relaxed bg-surface-sunken p-2.5 rounded-xl border">
					تنبيه: سيتم إخطار إدارة المورد بالواقعة فوراً لتحديد إعادة التوجيه أو إرجاع الطرد لمخزن المورد.
				</p>

				<div class="d-flex items-center gap-2 justify-end pt-2">
					<button type="button" class="btn btn-secondary btn-sm font-bold" data-modal-close>
						إلغاء
					</button>
					<button type="submit" class="btn btn-danger btn-sm font-black gap-1">
						@components.IconAlert("icon-xs")
						<span>تأكيد تعذر التسليم</span>
					</button>
				</div>
			</form>
		}
	</div>
}

// VendorDeliveryHandoverCard is the PIN form. The confirmation checkbox is
// rendered only when there is cash to take, because a checkbox that always
// appears is one people always tick.
templ VendorDeliveryHandoverCard(sh *commerce.OrderShipment) {
	<div id="handover-pin-section" class="courier-card border-brand">
		<div class="text-center mb-4">
			<div class="courier-hero-icon">
				@components.IconShield("icon-sm")
			</div>
			<h3 class="text-sm font-black text-primary m-0">تأكيد تسليم الطرد بالكود</h3>
			<p class="text-xs text-secondary m-0 mt-1 font-medium leading-relaxed">
				اطلب من الصيدلي المسؤول «كود تأكيد الاستلام» الظاهر في حسابه وفاتورته لإتمام التسليم
			</p>
		</div>

		<form
			method="POST"
			action={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d/verify", sh.ID)) }
			class="m-0 d-flex flex-col gap-4"
		>
			<div class="stack-xs text-center">
				<label class="form-label text-xs font-black text-primary d-block text-center mb-2">
					أدخل كود تأكيد الاستلام المكون من 6 أرقام:
				</label>
				<input
					type="text"
					name="delivery_code"
					required
					maxlength="6"
					pattern="[0-9]{6}"
					inputmode="numeric"
					autocomplete="one-time-code"
					class="courier-pin-input"
				/>
			</div>

			if sh.CourierCollection().Kind != commerce.CollectNothing {
				<div class="p-3 rounded-xl bg-surface-sunken border text-start">
					<label class="d-flex items-center gap-2.5 cursor-pointer select-none">
						<input type="checkbox" name="confirm_collected" value="true" required class="w-4 h-4 cursor-pointer"/>
						<span class="text-xs font-bold text-primary">
							أؤكد تحصيل { sh.CourierCollection().Amount.String() } ج.م نقداً من الصيدلي قبل تسليم الأصناف
						</span>
					</label>
				</div>
			}

			<div class="stack-2xs text-start">
				<label class="form-label text-2xs font-bold text-secondary d-block mb-1">
					ملاحظات التسليم (اختياري):
				</label>
				<input
					type="text"
					name="notes"
					placeholder="مثال: تم التسليم للدكتور المسؤول بالفرع"
					class="form-input text-xs w-full rounded-xl"
				/>
			</div>

			<button type="submit" class="btn btn-primary w-full py-3 font-black text-sm rounded-xl gap-2 d-flex items-center justify-center">
				@components.IconCheckCircle("icon-sm")
				<span>تأكيد الاستلام وإغلاق الطرد</span>
			</button>
		</form>
	</div>
}

// VendorDeliveryClosedCard is what a finished parcel looks like: a receipt, not
// a form.
templ VendorDeliveryClosedCard(sh *commerce.OrderShipment) {
	<div class="courier-card text-center p-6">
		if sh.Status == commerce.StatusDelivered || sh.Status == commerce.StatusCompleted {
			<div class="courier-hero-icon">
				@components.IconCheckCircle("icon-md")
			</div>
			<h3 class="text-base font-black text-primary m-0 mb-1">تم تسليم الطرد وتوثيقه بنجاح</h3>
			<p class="text-xs text-secondary m-0 font-medium">
				تم التحقق من كود الاستلام وإشعار المورد والصيدلية باكتمال التسليم.
			</p>
			if sh.DeliveredAt != nil {
				<div class="text-2xs text-secondary mt-2 font-mono tabular-nums">
					وقت التسليم: { sh.DeliveredAt.Format("2006-01-02 03:04 PM") }
				</div>
			}
			if sh.CollectedAmountMinor > 0 {
				<div class="text-2xs text-secondary mt-1 font-mono tabular-nums">
					المبلغ المُحصَّل: { fmt.Sprintf("%.2f", float64(sh.CollectedAmountMinor)/100) } ج.م
				</div>
			}
			if sh.DeliveryNotes != "" {
				<div class="text-2xs text-secondary mt-2">ملاحظات: { sh.DeliveryNotes }</div>
			}
		} else if sh.Status == commerce.StatusFailed {
			<div class="courier-hero-icon bg-rose-50 text-danger border-danger/20">
				@components.IconAlert("icon-md")
			</div>
			<h3 class="text-base font-black text-danger m-0 mb-1">تعذّر تسليم الطرد للصيدلية</h3>
			<p class="text-xs text-secondary m-0 font-medium leading-relaxed max-w-md mx-auto">
				تم تسجيل تعذر التسليم وإشعار المورد بالواقعة. يُرجى إعادة الطرد إلى مخزن المورد لاستلامه وإعادة توجيهه.
			</p>
			if sh.DeliveryNotes != "" {
				<div class="p-3 bg-surface-sunken rounded-xl border mt-3 text-xs text-secondary text-start max-w-md mx-auto">
					<strong class="text-primary d-block mb-1">ملاحظات وسبب التعذر المسجل:</strong>
					{ sh.DeliveryNotes }
				</div>
			}
		} else if sh.Status == commerce.StatusReturned {
			<div class="courier-hero-icon bg-rose-50 text-danger border-danger/20">
				@components.IconAlert("icon-md")
			</div>
			<h3 class="text-base font-black text-danger m-0 mb-1">تم إرجاع الطرد إلى المخزن</h3>
			<p class="text-xs text-secondary m-0 font-medium leading-relaxed max-w-md mx-auto">
				هذا الطرد مرتجع لمستودع المورد وتم إغلاق دورة تسليمه.
			</p>
		} else {
			<div class="mb-2">@components.IconAlert("icon-md")</div>
			<h3 class="text-base font-black text-primary m-0 mb-1">هذا الطرد مغلق</h3>
			<p class="text-xs text-secondary m-0 font-medium">
				لم يعد بالإمكان اتخاذ إجراءات توصيل عليه. راجع المورد إذا كان ذلك غير متوقع.
			</p>
		}

		<div class="pt-4 mt-4 border-t">
			<a href="/vendor/delivery" class="btn btn-secondary text-xs font-bold py-2.5 px-5 d-inline-flex items-center gap-2">
				@components.IconTruck("icon-2xs")
				<span>العودة إلى طرودي</span>
			</a>
		</div>
	</div>
}
