package pages

import (
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CourierDeliveryData struct {
	TrackingQuery  string
	Shipment       *commerce.OrderShipment
	ErrorMessage   string
	SuccessMessage string
	IsLocked       bool
	RemainingLock  int
	IsCompleted    bool
}

templ CourierDeliveryPage(data CourierDeliveryData, lang, dir string) {
	@layouts.Base("بوابة تسليم الشحنات | دوا 24", lang, dir) {
		<div class="courier-portal-wrapper">
			<!-- Top Standalone Header with Properly Sized Logo -->
			<header class="courier-top-header">
				<div class="courier-top-header-inner">
					<a href="/delivery" class="d-flex items-center gap-2.5 text-decoration-none">
						<img
							src="/static/img/logo.png"
							alt="دوا 24"
							class="courier-logo"
							onerror="this.classList.add('hidden')"
						/>
						<div class="stack-2xs text-start">
							<span class="text-sm font-black text-primary leading-tight">دوا 24</span>
							<span class="text-2xs text-secondary font-bold">بوابة تسليم الشحنات</span>
						</div>
					</a>

					<div class="courier-badge-secure">
						@components.IconShield("icon-2xs")
						<span>تحقق مشفر 256-bit</span>
					</div>
				</div>
			</header>

			<!-- Main Container -->
			<main class="courier-main-container">
				<!-- Error & Success Feedback Banners -->
				if data.ErrorMessage != "" {
					<div class="alert alert-danger p-4 rounded-2xl border border-rose-200 bg-rose-50 text-rose-900 shadow-xs">
						<div class="d-flex items-center gap-3">
							@components.IconAlert("icon-sm text-rose-600 shrink-0")
							<div class="stack-xs text-start">
								<strong class="font-black text-xs">{ data.ErrorMessage }</strong>
								if data.IsLocked {
									<span class="text-2xs text-rose-700 font-medium">يرجى الانتظار والمحاولة لاحقاً بعد انتهاء فترة القفل الأمني.</span>
								}
							</div>
						</div>
					</div>
				}

				if data.SuccessMessage != "" {
					<div class="alert alert-success p-4 rounded-2xl border border-emerald-200 bg-emerald-50 text-emerald-900 shadow-xs">
						<div class="d-flex items-center gap-3">
							@components.IconCheckCircle("icon-sm text-emerald-600 shrink-0")
							<strong class="font-black text-xs">{ data.SuccessMessage }</strong>
						</div>
					</div>
				}

				<!-- State 1: Search / Lookup Form -->
				if data.Shipment == nil {
					<!-- Operational Flow Guide -->
					<div class="courier-card">
						<div class="d-flex items-center gap-2 mb-2.5 text-brand font-black text-xs">
							@components.IconInfo("icon-xs")
							<span>خطوات تسليم الشحنة الدوائية:</span>
						</div>
						<div class="courier-steps-grid">
							<div class="courier-step-item">
								<span class="d-block text-brand font-bold text-xs mb-0.5">1. المطابقة</span>
								<span class="text-secondary font-medium text-2xs">الفرع والعنوان</span>
							</div>
							<div class="courier-step-item">
								<span class="d-block text-brand font-bold text-xs mb-0.5">2. الفحص</span>
								<span class="text-secondary font-medium text-2xs">الطرود والتحصيل</span>
							</div>
							<div class="courier-step-item">
								<span class="d-block text-brand font-bold text-xs mb-0.5">3. كود PIN</span>
								<span class="text-secondary font-medium text-2xs">توثيق الاستلام</span>
							</div>
						</div>
					</div>

					<div class="courier-card text-center p-6">
						<div class="courier-hero-icon">
							@components.IconTruck("icon-md")
						</div>

						<h2 class="text-lg font-black text-primary m-0 mb-1">
							استعلام وتسليم شحنة دوائية
						</h2>
						<p class="text-xs text-secondary leading-relaxed max-w-sm mx-auto mb-5 font-medium">
							أدخل رقم الشحنة أو بوليصة التتبع المسلمة لك من المورد لمعاينة بيانات الصيدلية والأصناف المطلوب تسليمها.
						</p>

						<form method="GET" action="/delivery" class="m-0 d-flex flex-col gap-3">
							<div>
								<input
									type="text"
									name="tracking"
									value={ data.TrackingQuery }
									required
									autofocus
									placeholder="مثال: TRK-6023-15588"
									class="form-input text-base text-center font-mono font-black w-full p-3 rounded-xl border border-slate-300"
								/>
							</div>
							<button
								type="submit"
								class="btn btn-primary font-black text-xs py-3 px-6 rounded-xl shadow-xs gap-2 w-full d-flex items-center justify-center"
							>
								@components.IconSearch("icon-xs")
								<span>عرض بيانات الشحنة</span>
							</button>
						</form>
					</div>
				} else {
					<!-- State 2: Shipment Loaded Details -->
					@CourierShipmentDetails(data, lang, dir)
				}
			</main>
		</div>
	}
}