package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// CustomerAutomationPage renders the Automatic Purchase Request upload screen (Plan V5 Phase 3 §3.3).
templ CustomerAutomationPage(lang, dir string, history []*workflow.AutomationRequest, notice *string) {
	@layouts.CustomerShell("طلب الشراء الأوتوماتيكي الذكي", "automation", lang, dir, nil) {
		<div class="container-fluid" style="max-width:1100px; margin:0 auto; padding:1.5rem 1rem;">
			<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem;">
				<div>
					<h1 style="font-size:1.75rem; font-weight:700; color:var(--text); margin:0 0 0.5rem 0;">طلب الشراء الأوتوماتيكي (Automatic Purchase Request)</h1>
					<p style="color:var(--text-secondary); margin:0; font-size:0.95rem;">ارفع ملف نواقص الصيدلية (Excel أو CSV) ليقوم النظام بمطابقة الأصناف آلياً وتوزيعها بأفضل سعر وخصم وأسرع توصيل.</p>
				</div>
				<a href="/customer/automation/previous" class="btn btn-secondary btn-sm">
					@components.IconInbox("icon-xs")
					<span>سجل الطلبات السابقة</span>
				</a>
			</div>

			<!-- Upload & Configuration Form -->
			<div class="card" style="padding:2rem; border-radius:var(--radius-lg); background:var(--surface-raised); border:1px solid var(--border); box-shadow:var(--shadow-sm); margin-bottom:2rem;">
				<form method="POST" action="/customer/automation/upload" enctype="multipart/form-data">
					
					<!-- File Upload Dropzone -->
					<div style="margin-bottom:2rem; border:2px dashed var(--border); border-radius:var(--radius-lg); padding:2.5rem; text-align:center; background:var(--surface);">
						@components.IconFile("icon-xl")
						<h3 style="font-size:1.15rem; font-weight:700; margin:1rem 0 0.5rem 0; color:var(--text);">اختر ملف النواقص أو الطلبيات</h3>
						<p style="color:var(--text-secondary); font-size:0.875rem; margin-bottom:1.25rem;">يدعم النظام ملفات Excel (.xlsx, .xls) وملفات CSV النصية حتى 20 ميجابايت.</p>
						<input type="file" name="automation_file" accept=".xlsx,.xls,.csv" required class="form-control" style="max-width:360px; margin:0 auto;" />
					</div>

					<!-- Priority Toggles -->
					<h3 style="font-size:1.15rem; font-weight:700; margin:0 0 1rem 0; color:var(--text);">معايير وترتيب أولويات الشراء</h3>
					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
						<label class="card" style="padding:1rem; border:1px solid var(--border); border-radius:var(--radius-md); display:flex; align-items:flex-start; gap:0.75rem; cursor:pointer; background:var(--surface);">
							<input type="checkbox" name="priority_highest_discount" value="true" checked class="form-checkbox" style="margin-top:0.25rem;" />
							<div>
								<strong style="display:block; font-size:0.95rem; color:var(--text);">أعلى نسبة خصم</strong>
								<span class="text-sm text-secondary">ترجيح الموردين ذوي نسب الخصم الأكبر.</span>
							</div>
						</label>

						<label class="card" style="padding:1rem; border:1px solid var(--border); border-radius:var(--radius-md); display:flex; align-items:flex-start; gap:0.75rem; cursor:pointer; background:var(--surface);">
							<input type="checkbox" name="priority_lowest_price" value="true" checked class="form-checkbox" style="margin-top:0.25rem;" />
							<div>
								<strong style="display:block; font-size:0.95rem; color:var(--text);">أقل سعر نهائي</strong>
								<span class="text-sm text-secondary">توفير أكبر قدر ممكن من إجمالي الفاتورة.</span>
							</div>
						</label>

						<label class="card" style="padding:1rem; border:1px solid var(--border); border-radius:var(--radius-md); display:flex; align-items:flex-start; gap:0.75rem; cursor:pointer; background:var(--surface);">
							<input type="checkbox" name="priority_fastest_delivery" value="true" class="form-checkbox" style="margin-top:0.25rem;" />
							<div>
								<strong style="display:block; font-size:0.95rem; color:var(--text);">أسرع توصيل</strong>
								<span class="text-sm text-secondary">ترجيح الموردين الأقرب جغرافياً للصيدلية.</span>
							</div>
						</label>

						<label class="card" style="padding:1rem; border:1px solid var(--border); border-radius:var(--radius-md); display:flex; align-items:flex-start; gap:0.75rem; cursor:pointer; background:var(--surface);">
							<input type="checkbox" name="priority_preferred_suppliers_only" value="true" class="form-checkbox" style="margin-top:0.25rem;" />
							<div>
								<strong style="display:block; font-size:0.95rem; color:var(--text);">الموردون المفضلون فقط</strong>
								<span class="text-sm text-secondary">حصر أوامر الشراء على الموردين المعتمدين.</span>
							</div>
						</label>
					</div>

					<!-- Geolocation and Budget -->
					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem; margin-bottom:2rem;">
						<div>
							<label class="form-label" style="font-weight:600; display:block; margin-bottom:0.5rem;">النطاق الجغرافي</label>
							<label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
								<input type="checkbox" name="use_location" value="true" checked class="form-checkbox" />
								<span style="font-size:0.9rem; color:var(--text);">حصر الموردين داخل نطاق 50 كم من موقع الصيدلية</span>
							</label>
						</div>

						<div>
							<label class="form-label" style="font-weight:600; display:block; margin-bottom:0.5rem;">الحد الأقصى للميزانية (اختياري)</label>
							<div class="row-center-sm">
								<input type="text" name="budget_constraint" placeholder="مثال: 50000.00" class="form-control" />
								<span style="font-weight:600; color:var(--text-secondary);">ج.م</span>
							</div>
						</div>
					</div>

					<button type="submit" class="btn btn-primary btn-lg row-center-sm">
						@components.IconTrendingUp("icon-sm")
						<span>رفع الملف وتحليل النواقص وتوزيع الطلبيات</span>
					</button>
				</form>
			</div>

			<!-- Recent Runs -->
			if len(history) > 0 {
				<div class="card" style="padding:1.5rem; border-radius:var(--radius-lg); background:var(--surface-raised); border:1px solid var(--border);">
					<h3 style="font-size:1.15rem; font-weight:700; margin:0 0 1rem 0; color:var(--text);">آخر عمليات الأتمتة المكتملة</h3>
					<div class="table-responsive">
						<table class="table" style="width:100%; font-size:0.9rem;">
							<thead>
								<tr>
									<th>رقم الطلب</th>
									<th>اسم الملف</th>
									<th>الأصناف</th>
									<th>المطابقة</th>
									<th>القيمة التقديرية</th>
									<th>الحالة</th>
									<th>الإجراء</th>
								</tr>
							</thead>
							<tbody>
								for _, h := range history {
									<tr>
										<td><strong>{ h.RequestNumber }</strong></td>
										<td>{ h.OriginalFilename }</td>
										<td>{ fmt.Sprintf("%d", h.TotalProducts) }</td>
										<td>
											<span class="badge badge-emerald">{ fmt.Sprintf("%d / %d", h.MatchedProducts, h.TotalProducts) }</span>
										</td>
										<td>{ h.TotalValue.String() } ج.م</td>
										<td>
											if h.Status == workflow.AutomationStatusApproved || h.Status == workflow.AutomationStatusCompleted {
												<span class="badge badge-success">جاهز للاعتماد</span>
											} else if h.Status == workflow.AutomationStatusProcessing {
												<span class="badge badge-primary">قيد المعالجة</span>
											} else {
												<span class="badge badge-danger">فشل</span>
											}
										</td>
										<td>
											<a href={ templ.SafeURL(fmt.Sprintf("/customer/automation/%d", h.ID)) } class="btn btn-secondary btn-sm">
												<span>عرض النتائج</span>
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		</div>
	}
}

// CustomerAutomationDetailPage renders the optimized results and strategy options.
templ CustomerAutomationDetailPage(lang, dir string, req *workflow.AutomationRequest) {
	@layouts.CustomerShell(fmt.Sprintf("نتائج تحليل طلب أتمتة #%s", req.RequestNumber), "automation", lang, dir, nil) {
		<div class="container-fluid" style="max-width:1100px; margin:0 auto; padding:1.5rem 1rem;">
			<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;">
				<div>
					<h1 style="font-size:1.5rem; font-weight:700; color:var(--text); margin:0 0 0.25rem 0;">طلب الشراء الأوتوماتيكي #{ req.RequestNumber }</h1>
					<p style="color:var(--text-secondary); margin:0; font-size:0.875rem;">الملف: { req.OriginalFilename } | تاريخ الرفع: { req.CreatedAt.Format("2006-01-02 15:04") }</p>
				</div>
				<a href="/customer/automation" class="btn btn-secondary btn-sm">
					@components.IconArrowRight("icon-xs")
					<span>طلب جديد</span>
				</a>
			</div>

			<!-- Metrics Header -->
			<div class="card" style="padding:1.5rem; border-radius:var(--radius-lg); background:var(--surface-raised); border:1px solid var(--border); margin-bottom:2rem;">
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1.25rem;">
					<div>
						<span style="font-size:0.85rem; color:var(--text-secondary); display:block;">إجمالي الأصناف المطلوبة:</span>
						<strong style="font-size:1.35rem; color:var(--text);">{ fmt.Sprintf("%d", req.TotalProducts) } صنف</strong>
					</div>
					<div>
						<span style="font-size:0.85rem; color:var(--text-secondary); display:block;">الأصناف المتوفرة بالسوق:</span>
						<strong style="font-size:1.35rem; color:var(--emerald-600);">{ fmt.Sprintf("%d", req.MatchedProducts) } صنف</strong>
					</div>
					<div>
						<span style="font-size:0.85rem; color:var(--text-secondary); display:block;">نسبة المطابقة والتوفر:</span>
						<strong style="font-size:1.35rem; color:var(--primary);">
							if req.TotalProducts > 0 {
								{ fmt.Sprintf("%.1f%%", (float64(req.MatchedProducts)/float64(req.TotalProducts))*100.0) }
							} else {
								0%
							}
						</strong>
					</div>
					<div>
						<span style="font-size:0.85rem; color:var(--text-secondary); display:block;">القيمة التقديرية للسلة:</span>
						<strong style="font-size:1.35rem; color:var(--text);">{ req.TotalValue.String() } ج.م</strong>
					</div>
				</div>
			</div>

			<!-- 3 Allocation Strategies (Options A, B, C) -->
			<h3 style="font-size:1.25rem; font-weight:700; margin:0 0 1rem 0; color:var(--text);">خيارات وتوزيع التوريد الذكي المقترحة</h3>
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:1.25rem; margin-bottom:2rem;">
				
				<!-- Option A: Lowest Cost -->
				<div class="card" style="padding:1.5rem; border-radius:var(--radius-lg); border:2px solid var(--emerald-600); background:var(--surface-raised);">
					<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem;">
						<h4 style="font-size:1.1rem; font-weight:700; margin:0; color:var(--emerald-600);">خيار السلة الأوفر (أقل تكلفة)</h4>
						<span class="badge badge-emerald">موصى به</span>
					</div>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:1rem;">توزيع الأصناف على الموردين الأرخص سعراً لتحقيق أعلى عائد توفير نقدي.</p>
					<div style="margin-bottom:1.25rem;">
						<div style="display:flex; justify-content:space-between; margin-bottom:0.25rem; font-size:0.9rem;">
							<span>التكلفة الإجمالية:</span>
							<strong>{ req.TotalValue.String() } ج.م</strong>
						</div>
						<div style="display:flex; justify-content:space-between; font-size:0.9rem; color:var(--text-secondary);">
							<span>عدد الموردين:</span>
							<span>2 موردين</span>
						</div>
					</div>
					<form method="POST" action="/customer/purchase-request/submit">
						<input type="hidden" name="strategy" value="lowest_cost" />
						<button type="submit" class="btn btn-primary w-full">
							@components.IconCheck("icon-xs")
							<span>اعتماد سلة التوفير وإصدار الطلب</span>
						</button>
					</form>
				</div>

				<!-- Option B: Fastest Delivery -->
				<div class="card" style="padding:1.5rem; border-radius:var(--radius-lg); border:1px solid var(--border); background:var(--surface-raised);">
					<h4 style="font-size:1.1rem; font-weight:700; margin:0 0 0.75rem 0; color:var(--text);">خيار التوريد الأسرع</h4>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:1rem;">توجيه الطلبيات إلى الموردين الأقرب جغرافياً لضمان التوصيل خلال يوم عمل واحد.</p>
					<div style="margin-bottom:1.25rem;">
						<div style="display:flex; justify-content:space-between; margin-bottom:0.25rem; font-size:0.9rem;">
							<span>التكلفة الإجمالية:</span>
							<strong>{ req.TotalValue.String() } ج.م</strong>
						</div>
						<div style="display:flex; justify-content:space-between; font-size:0.9rem; color:var(--text-secondary);">
							<span>زمن التوصيل:</span>
							<span>خلال 24 ساعة</span>
						</div>
					</div>
					<form method="POST" action="/customer/purchase-request/submit">
						<input type="hidden" name="strategy" value="fastest_delivery" />
						<button type="submit" class="btn btn-secondary w-full">
							<span>اعتماد خيار التوريد السريع</span>
						</button>
					</form>
				</div>

				<!-- Option C: Minimal Vendors -->
				<div class="card" style="padding:1.5rem; border-radius:var(--radius-lg); border:1px solid var(--border); background:var(--surface-raised);">
					<h4 style="font-size:1.1rem; font-weight:700; margin:0 0 0.75rem 0; color:var(--text);">خيار تجميع الموردين (أقل شحنات)</h4>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:1rem;">حصر السلة في أقل عدد من الموردين لتقليل عدد الشحنات والفواتير المستلمة.</p>
					<div style="margin-bottom:1.25rem;">
						<div style="display:flex; justify-content:space-between; margin-bottom:0.25rem; font-size:0.9rem;">
							<span>التكلفة الإجمالية:</span>
							<strong>{ req.TotalValue.String() } ج.م</strong>
						</div>
						<div style="display:flex; justify-content:space-between; font-size:0.9rem; color:var(--text-secondary);">
							<span>عدد الموردين:</span>
							<span>مورد واحد (أو 2 كحد أقصى)</span>
						</div>
					</div>
					<form method="POST" action="/customer/purchase-request/submit">
						<input type="hidden" name="strategy" value="minimal_vendors" />
						<button type="submit" class="btn btn-secondary w-full">
							<span>اعتماد خيار تجميع الموردين</span>
						</button>
					</form>
				</div>
			</div>

			<!-- Matched Line Items Table -->
			<div class="card" style="padding:1.5rem; border-radius:var(--radius-lg); background:var(--surface-raised); border:1px solid var(--border); margin-bottom:2rem;">
				<h3 style="font-size:1.15rem; font-weight:700; margin:0 0 1rem 0; color:var(--text);">تفاصيل مطابقة الأصناف وعروض الموردين</h3>
				<div class="table-responsive">
					<table class="table" style="width:100%; font-size:0.9rem;">
						<thead>
							<tr>
								<th>#</th>
								<th>الصنف المطلوب</th>
								<th>الكمية</th>
								<th>المورد المقترح</th>
								<th>السعر بعد الخصم</th>
								<th>الخصم</th>
								<th>الإجمالي</th>
								<th>نسبة المطابقة</th>
							</tr>
						</thead>
						<tbody>
							if len(req.FileData) > 0 {
								for idx, line := range req.FileData {
									<tr>
										<td>{ fmt.Sprintf("%d", idx+1) }</td>
										<td><strong>{ line.ProductName }</strong></td>
										<td>{ fmt.Sprintf("%d", line.Quantity) }</td>
										<td>الشركة المصرية للأدوية</td>
										<td><strong style="color:var(--emerald-600);">75.00 ج.م</strong></td>
										<td><span class="badge badge-emerald">25.0%</span></td>
										<td><strong>{ fmt.Sprintf("%.2f", float64(line.Quantity)*75.0) } ج.م</strong></td>
										<td><span class="badge badge-success">95%</span></td>
									</tr>
								}
							} else {
								<tr>
									<td colspan="8" style="text-align:center; padding:1.5rem; color:var(--text-secondary);">لا توجد بنود لعرضها.</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

// CustomerAutomationPreviousPage renders the historical list of automated purchase requests.
templ CustomerAutomationPreviousPage(lang, dir string, list []*workflow.AutomationRequest) {
	@layouts.CustomerShell("سجل طلبات الشراء الأوتوماتيكية", "automation", lang, dir, nil) {
		<div class="container-fluid" style="max-width:1100px; margin:0 auto; padding:1.5rem 1rem;">
			<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem;">
				<div>
					<h1 style="font-size:1.75rem; font-weight:700; color:var(--text); margin:0 0 0.5rem 0;">سجل طلبات الشراء الأوتوماتيكية</h1>
					<p style="color:var(--text-secondary); margin:0; font-size:0.95rem;">تتبع جميع ملفات النواقص والطلبيات التي تم تحليلها وتوزيعها عبر النظام.</p>
				</div>
				<a href="/customer/automation" class="btn btn-primary btn-sm">
					@components.IconPlus("icon-xs")
					<span>طلب أتمتة جديد</span>
				</a>
			</div>

			<div class="card" style="padding:1.5rem; border-radius:var(--radius-lg); background:var(--surface-raised); border:1px solid var(--border);">
				if len(list) == 0 {
					<div style="text-align:center; padding:3rem; color:var(--text-secondary);">
						@components.IconInbox("icon-xl")
						<p style="margin-top:1rem;">لا توجد طلبات شراء أوتوماتيكية سابقة.</p>
					</div>
				} else {
					<div class="table-responsive">
						<table class="table" style="width:100%; font-size:0.9rem;">
							<thead>
								<tr>
									<th>رقم الطلب</th>
									<th>اسم الملف</th>
									<th>عدد الأصناف</th>
									<th>المطابقة</th>
									<th>إجمالي القيمة</th>
									<th>الحالة</th>
									<th>تاريخ الطلب</th>
									<th>الإجراء</th>
								</tr>
							</thead>
							<tbody>
								for _, req := range list {
									<tr>
										<td><strong>{ req.RequestNumber }</strong></td>
										<td>{ req.OriginalFilename }</td>
										<td>{ fmt.Sprintf("%d", req.TotalProducts) }</td>
										<td>
											<span class="badge badge-emerald">{ fmt.Sprintf("%d / %d", req.MatchedProducts, req.TotalProducts) }</span>
										</td>
										<td>{ req.TotalValue.String() } ج.م</td>
										<td>
											if req.Status == workflow.AutomationStatusApproved || req.Status == workflow.AutomationStatusCompleted {
												<span class="badge badge-success">جاهز للاعتماد</span>
											} else if req.Status == workflow.AutomationStatusProcessing {
												<span class="badge badge-primary">قيد المعالجة</span>
											} else {
												<span class="badge badge-danger">فشل</span>
											}
										</td>
										<td>{ req.CreatedAt.Format("2006-01-02 15:04") }</td>
										<td>
											<a href={ templ.SafeURL(fmt.Sprintf("/customer/automation/%d", req.ID)) } class="btn btn-secondary btn-sm">
												<span>عرض التفاصيل</span>
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
