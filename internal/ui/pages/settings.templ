package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// settingsTabs is the shared tab bar across the /settings surface. Every tab is
// a real, shareable route.
templ settingsTabs(active string) {
	@components.Tabs(components.TabsProps{
		Tabs: []components.Tab{
			{ ID: "profile", Label: "الملف الشخصي", URL: "/settings/profile" },
			{ ID: "wallet", Label: "المحفظة والرصيد", URL: "/wallet" },
			{ ID: "payments", Label: "طرق الدفع", URL: "/settings/payment-methods" },
			{ ID: "addresses", Label: "العناوين", URL: "/settings/addresses" },
			{ ID: "organization", Label: "المنشأة والتراخيص", URL: "/settings/organization" },
			{ ID: "security", Label: "الأمان والجلسات", URL: "/settings/security" },
			{ ID: "preferences", Label: "التفضيلات", URL: "/settings/preferences" },
		},
		ActiveID: active,
	}) {
	}
}

templ SettingsProfile(lang, dir string, user *identity.User) {
	@layouts.CustomerShell("الإعدادات", "settings", lang, dir, nil) {
		<div style="max-width:640px;">
			@settingsTabs("profile")
			<div class="card" style="margin-top:1rem;">
				<h2 class="card-title" style="margin:0 0 1rem;">الملف الشخصي</h2>
				<form method="POST" action="/settings/profile" style="display:flex; flex-direction:column; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">البريد الإلكتروني</label>
						<input type="email" value={ user.Email } disabled class="form-input" style="opacity:0.6;" />
						<p style="font-size:0.75rem; color:var(--neutral-400); margin:0.25rem 0 0;">تغيير البريد يتطلب كلمة المرور الحالية.</p>
					</div>
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="s-name-ar">الاسم (عربي)</label>
							<input type="text" id="s-name-ar" name="name_ar" class="form-input" value={ user.Name["ar"] } />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="s-name-en">الاسم (إنجليزي)</label>
							<input type="text" id="s-name-en" name="name_en" class="form-input" dir="ltr" value={ user.Name["en"] } />
						</div>
					</div>
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="s-phone">رقم الهاتف</label>
							<input type="tel" id="s-phone" name="phone" class="form-input tabular-nums" value={ user.Phone } />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="s-tz">المنطقة الزمنية</label>
							<input type="text" id="s-tz" name="timezone" class="form-input" value={ user.Timezone } />
						</div>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="s-lang">لغة الواجهة</label>
						<select id="s-lang" name="lang" class="form-input">
							<option value="ar" selected={ user.Language == i18n.AR }>العربية</option>
							<option value="en" selected={ user.Language == i18n.EN }>English</option>
						</select>
					</div>
					<button type="submit" class="btn btn-primary" style="justify-content:center;">
						@components.IconCheck("icon-sm")
						<span>حفظ التغييرات</span>
					</button>
				</form>
			</div>
		</div>
	}
}

templ SettingsAddresses(lang, dir string, addresses []*identity.UserAddress, cities []*platformadmin.City, history []*identity.UserAddressHistory) {
	@layouts.CustomerShell("الإعدادات", "settings", lang, dir, nil) {
		<div style="max-width:720px;">
			@settingsTabs("addresses")
			<div class="card" style="margin-top:1rem;">
				<h2 class="card-title" style="margin:0 0 1rem;">عنوان جديد</h2>
				<form method="POST" action="/settings/addresses" style="display:flex; flex-direction:column; gap:1rem;">
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="a-title">العنوان (تسمية)</label>
							<input type="text" id="a-title" name="title" class="form-input" placeholder="الفرع الرئيسي" />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="a-recipient">اسم المستلم</label>
							<input type="text" id="a-recipient" name="recipient" required class="form-input" />
						</div>
					</div>
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="a-phone">هاتف المستلم</label>
							<input type="tel" id="a-phone" name="phone" class="form-input tabular-nums" />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="a-city">المحافظة</label>
							<select id="a-city" name="city_id" required class="form-input">
								<option value="" disabled selected>اختر المحافظة</option>
								for _, c := range cities {
									<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name.Get(i18n.Lang(lang)) }</option>
								}
							</select>
						</div>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="a-address">العنوان</label>
						<input type="text" id="a-address" name="address" required class="form-input" placeholder="الشارع والمنطقة" />
					</div>
					<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="a-building">المبنى</label>
							<input type="text" id="a-building" name="building" class="form-input" />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="a-floor">الطابق</label>
							<input type="text" id="a-floor" name="floor" class="form-input" />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="a-apt">الشقة</label>
							<input type="text" id="a-apt" name="apartment" class="form-input" />
						</div>
					</div>
					<label style="display:flex; align-items:center; gap:0.5rem; font-size:0.9rem; color:var(--neutral-700);">
						<input type="checkbox" name="is_default" value="1" />
						<span>تعيين كعنوان افتراضي</span>
					</label>
					<button type="submit" class="btn btn-primary" style="justify-content:center;">حفظ العنوان</button>
				</form>
			</div>

			<div class="card" style="margin-top:1.25rem;">
				<h2 class="card-title" style="margin:0 0 0.75rem;">عناوينك المحفوظة</h2>
				if len(addresses) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد عناوين محفوظة بعد.</p>
				} else {
					for _, a := range addresses {
						<div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 0; border-bottom:1px solid var(--neutral-100);">
							<div>
								<div style="font-weight:700; color:var(--neutral-900);">
									{ a.Title }
									if a.IsDefault {
										<span class="badge badge-emerald" style="margin-inline-start:0.5rem;">افتراضي</span>
									}
								</div>
								<div style="font-size:0.85rem; color:var(--neutral-600);">{ a.Recipient } · { a.Phone }</div>
								<div style="font-size:0.8rem; color:var(--neutral-500);">{ a.Address }</div>
							</div>
							<form method="POST" action={ fmt.Sprintf("/settings/addresses/%d/delete", a.ID) } style="margin:0;">
								<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">حذف</button>
							</form>
						</div>
					}
				}
			</div>
			<div class="card" style="margin-top:1.25rem;">
				<h2 class="card-title" style="margin:0 0 0.75rem;">سجل تغييرات العناوين</h2>
				if len(history) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد تغييرات مسجلة بعد.</p>
				} else {
					@components.Timeline() {
						for _, h := range history {
							@components.TimelineItem(h.Event, h.ChangedAt.Format("2006-01-02 15:04"), "")
						}
					}
				}
			</div>
		</div>
	}
}


templ SettingsSecurity(lang, dir string, sessions []*identity.Session, plans []*identity.SessionPlan) {
	@layouts.CustomerShell("الإعدادات", "settings", lang, dir, nil) {
		<div style="max-width:720px;">
			@settingsTabs("security")
			<div class="card" style="margin-top:1rem;">
				<h2 class="card-title" style="margin:0 0 0.75rem;">الجلسات النشطة</h2>
				<p style="color:var(--neutral-500); font-size:0.85rem; margin:0 0 1rem;">هذه الأجهزة مسجلة الدخول حالياً بحسابك. يمكنك إلغاء أي جلسة منها.</p>
				if len(sessions) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد جلسات نشطة.</p>
				} else {
					<div class="table-container">
						<table class="data-table">
							<thead><tr><th>الجهاز</th><th>IP</th><th>آخر دخول</th><th></th></tr></thead>
							<tbody>
								for _, s := range sessions {
									<tr>
										<td>{ s.UserAgent }</td>
										<td class="tabular-nums" dir="ltr">{ s.IP }</td>
										<td>{ s.CreatedAt.Format("2006-01-02 15:04") }</td>
										<td>
											<form method="POST" action="/settings/security/revoke" style="margin:0;">
												<input type="hidden" name="token" value={ s.Token } />
												<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">إلغاء</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
			<div class="card" style="margin-top:1.25rem;">
				<h2 class="card-title" style="margin:0 0 0.75rem;">خطط الجلسات المتزامنة</h2>
				<p style="color:var(--neutral-500); font-size:0.85rem; margin:0 0 1rem;">اختر حداً أعلى لعدد الجلسات المتزامنة لحسابك.</p>
				if len(plans) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد خطط متاحة.</p>
				} else {
					for _, p := range plans {
						<div style="display:flex; justify-content:space-between; align-items:center; padding:0.65rem 0; border-bottom:1px solid var(--neutral-100);">
							<div>
								<div style="font-weight:700; color:var(--neutral-900);">{ p.Name.Get(i18n.Lang(lang)) }</div>
								<div style="font-size:0.8rem; color:var(--neutral-500);">{ fmt.Sprintf("%d", p.MaxLoginSessions) } جلسة متزامنة</div>
							</div>
							<form method="POST" action={ fmt.Sprintf("/settings/security/plan/%d", p.ID) } style="margin:0;">
								<button type="submit" class="btn btn-primary btn-sm">
									if p.IsFree {
										تفعيل مجاناً
									} else {
										<span>اشترك · </span>
										@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: p.Price })
									}
								</button>
							</form>
						</div>
					}
				}
			</div>
		</div>
	}
}


templ SettingsOrganization(lang, dir string, o *org.Organization, branches []*org.Branch, members []*org.Member) {
	@layouts.CustomerShell("الإعدادات", "settings", lang, dir, nil) {
		<div style="max-width:720px;">
			@settingsTabs("organization")
			<div class="card" style="margin-top:1rem;">
				<h2 class="card-title" style="margin:0 0 1rem;">بيانات المؤسسة</h2>
				<form method="POST" action="/settings/organization" style="display:flex; flex-direction:column; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="o-legal">الاسم القانوني</label>
						<input type="text" id="o-legal" name="legal_name" required class="form-input" value={ o.LegalName } />
					</div>
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="o-trade-ar">الاسم التجاري (عربي)</label>
							<input type="text" id="o-trade-ar" name="trade_name_ar" class="form-input" value={ o.TradeName.Get(i18n.AR) } />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="o-trade-en">الاسم التجاري (إنجليزي)</label>
							<input type="text" id="o-trade-en" name="trade_name_en" class="form-input" dir="ltr" value={ o.TradeName.Get(i18n.EN) } />
						</div>
					</div>
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="o-tax">الرقم الضريبي</label>
							<input type="text" id="o-tax" name="tax_number" class="form-input tabular-nums" value={ o.TaxNumber } />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="o-cr">السجل التجاري</label>
							<input type="text" id="o-cr" name="commercial_register" class="form-input tabular-nums" value={ o.CommercialRegister } />
						</div>
					</div>
					<button type="submit" class="btn btn-primary" style="justify-content:center;">حفظ بيانات المؤسسة</button>
				</form>
			</div>

			<div class="card" style="margin-top:1.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
					<h2 class="card-title" style="margin:0;">الفروع</h2>
				</div>
				if len(branches) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد فروع.</p>
				} else {
					for _, b := range branches {
						<div style="display:flex; justify-content:space-between; align-items:center; padding:0.65rem 0; border-bottom:1px solid var(--neutral-100);">
							<div>
								<div style="font-weight:700; color:var(--neutral-900);">{ b.Name.Get(i18n.Lang(lang)) }</div>
								<div style="font-size:0.8rem; color:var(--neutral-500);">{ b.Code } · { b.Address }</div>
							</div>
							if b.IsMain {
								<span class="badge badge-emerald">الفرع الرئيسي</span>
							} else {
								<form method="POST" action={ fmt.Sprintf("/settings/organization/branch/%d/delete", b.ID) } style="margin:0;">
									<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">حذف</button>
								</form>
							}
						</div>
					}
				}

				<h3 class="card-title" style="margin:1rem 0 0.75rem;">إضافة فرع</h3>
				<form method="POST" action="/settings/organization/branch" style="display:flex; flex-direction:column; gap:0.9rem;">
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="b-name-ar">اسم الفرع (عربي)</label>
							<input type="text" id="b-name-ar" name="name_ar" required class="form-input" />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="b-code">الكود</label>
							<input type="text" id="b-code" name="code" class="form-input" dir="ltr" />
						</div>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="b-address">العنوان</label>
						<input type="text" id="b-address" name="address" class="form-input" />
					</div>
					<button type="submit" class="btn btn-secondary" style="justify-content:center;">إضافة الفرع</button>
				</form>
			</div>
			<div class="card" style="margin-top:1.25rem;">
				<h2 class="card-title" style="margin:0 0 0.75rem;">الأعضاء</h2>
				<form method="POST" action="/settings/organization/member" style="display:flex; gap:0.5rem; margin-bottom:1rem;">
					<input type="email" name="email" required class="form-input" placeholder="البريد الإلكتروني للعضو" style="flex:1;" />
					<select name="role" class="form-input" style="width:auto;">
						<option value="org_manager">مدير</option>
						<option value="org_employee" selected>موظف</option>
						<option value="org_accountant">محاسب</option>
						<option value="org_warehouse">أمين مخزن</option>
					</select>
					<button type="submit" class="btn btn-primary btn-sm">إضافة عضو</button>
				</form>
				if len(members) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا يوجد أعضاء آخرون.</p>
				} else {
					for _, m := range members {
						<div style="display:flex; justify-content:space-between; align-items:center; padding:0.65rem 0; border-bottom:1px solid var(--neutral-100);">
							<div style="font-size:0.9rem; color:var(--neutral-700);">عضو #{ fmt.Sprintf("%d", m.UserID) }</div>
							<form method="POST" action={ fmt.Sprintf("/settings/organization/member/%d/role", m.UserID) } style="display:flex; gap:0.5rem; margin:0;">
								<select name="role" class="form-input" style="width:auto;">
									<option value="org_owner" selected={ m.RoleKey == "org_owner" }>مالك</option>
									<option value="org_manager" selected={ m.RoleKey == "org_manager" }>مدير</option>
									<option value="org_employee" selected={ m.RoleKey == "org_employee" }>موظف</option>
									<option value="org_accountant" selected={ m.RoleKey == "org_accountant" }>محاسب</option>
									<option value="org_warehouse" selected={ m.RoleKey == "org_warehouse" }>أمين مخزن</option>
								</select>
								<button type="submit" class="btn btn-secondary btn-sm">تحديث</button>
							</form>
						</div>
					}
				}
			</div>
		</div>
	}
}


templ SettingsPreferences(lang, dir string, p *identity.UserPreferences) {
	@layouts.CustomerShell("الإعدادات", "settings", lang, dir, nil) {
		<div style="max-width:560px;">
			@settingsTabs("preferences")
			<div class="card" style="margin-top:1rem;">
				<h2 class="card-title" style="margin:0 0 1rem;">التفضيلات</h2>
				<form method="POST" action="/settings/preferences" style="display:flex; flex-direction:column; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="p-theme">المظهر</label>
						<select id="p-theme" name="theme" class="form-input">
							<option value="light" selected={ p.Theme == "light" }>فاتح</option>
							<option value="dark" selected={ p.Theme == "dark" }>داكن</option>
							<option value="auto" selected={ p.Theme == "auto" }>تلقائي</option>
						</select>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">قنوات الإشعارات</label>
						<label style="display:flex; gap:0.5rem; align-items:center; margin-top:0.4rem;">
							<input type="checkbox" name="ch_email" checked={ p.NotificationChannels["email"] } />
							<span>البريد الإلكتروني</span>
						</label>
						<label style="display:flex; gap:0.5rem; align-items:center;">
							<input type="checkbox" name="ch_sms" checked={ p.NotificationChannels["sms"] } />
							<span>الرسائل النصية</span>
						</label>
						<label style="display:flex; gap:0.5rem; align-items:center;">
							<input type="checkbox" name="ch_push" checked={ p.NotificationChannels["push"] } />
							<span>إشعارات التطبيق</span>
						</label>
					</div>
					<label style="display:flex; gap:0.5rem; align-items:center; font-size:0.9rem;">
						<input type="checkbox" name="marketing_consent" checked={ p.MarketingConsent } />
						<span>أوافق على تلقي عروض تسويقية</span>
					</label>
					<button type="submit" class="btn btn-primary" style="justify-content:center;">حفظ التفضيلات</button>
				</form>
			</div>
		</div>
	}
}

templ SettingsPaymentMethods(lang, dir string) {
	@layouts.CustomerShell("طرق الدفع | Payment Methods", "settings", lang, dir, nil) {
		<div style="max-width:760px;" x-data="{ payType: 'bank_account' }">
			@settingsTabs("payments")
			<div class="card" style="margin-top:1rem; padding:2rem;">
				<h2 class="card-title" style="margin:0 0 0.5rem;">طرق الدفع المحفوظة (Payment Methods)</h2>
				<p style="color:var(--neutral-500); font-size:0.875rem; margin:0 0 1.75rem;">
					إدارة حساباتك البنكية ومحافظ الدفع الإلكتروني المستخدمة في شحن المحفظة وسحب الرصيد.
				</p>

				<!-- Saved Payment Methods -->
				<div style="display:flex; flex-direction:column; gap:1rem; margin-bottom:2.5rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1px solid var(--border-card); border-radius:var(--radius-lg); background:#fff;">
						<div style="display:flex; align-items:center; gap:1rem;">
							<div style="width:42px; height:42px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconBuilding("icon-sm")
							</div>
							<div>
								<div style="font-weight:800; color:var(--neutral-900); font-size:0.95rem;">
									البنك الأهلي المصري (حساب صيدلية جاري)
								</div>
								<div style="font-size:0.8rem; color:var(--neutral-500); display:flex; gap:0.75rem; margin-top:0.25rem;">
									<span>الحساب: <strong class="tabular-nums" style="color:var(--neutral-800);">•••• 4920</strong></span>
									<span class="badge badge-emerald">معتمد للسحب والإيداع</span>
									<span class="badge badge-sky">افتراضي</span>
								</div>
							</div>
						</div>
					</div>

					<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1px solid var(--border-card); border-radius:var(--radius-lg); background:#fff;">
						<div style="display:flex; align-items:center; gap:1rem;">
							<div style="width:42px; height:42px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconPhone("icon-sm")
							</div>
							<div>
								<div style="font-weight:800; color:var(--neutral-900); font-size:0.95rem;">
									محفظة إنستاباي (InstaPay / فودافون كاش)
								</div>
								<div style="font-size:0.8rem; color:var(--neutral-500); display:flex; gap:0.75rem; margin-top:0.25rem;">
									<span>المعرف / الهاتف: <strong class="tabular-nums" style="color:var(--neutral-800);">01065397000</strong></span>
									<span class="badge badge-emerald">معتمد للتحويل الفوري</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Dynamic Add Payment Method Form -->
				<div style="border-top:2px solid var(--neutral-100); padding-top:1.75rem;">
					<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.25rem;">
						إضافة وسيلة دفع جديدة
					</h3>

					<form action="/settings/payment-methods" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="pm-select-type">نوع وسيلة الدفع *</label>
							<select id="pm-select-type" name="type" class="form-select" x-model="payType">
								<option value="bank_account">حساب بنكي (Bank Account)</option>
								<option value="instapay_wallet">إنستاباي ومحافظ إلكترونية (InstaPay / E-Wallet)</option>
								<option value="credit_card">بطاقة بنكية (Credit / Debit Card)</option>
								<option value="cheque">شيك بنكي معتمد (Company Cheque)</option>
							</select>
						</div>

						<!-- Bank Account Fields -->
						<div x-show="payType === 'bank_account'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-bn">اسم البنك *</label>
								<input type="text" id="pm-bn" name="bank_name" placeholder="مثال: البنك الأهلي المصري، CIB، بنك مصر" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-ah">اسم صاحب الحساب (مطابق للرخصة) *</label>
								<input type="text" id="pm-ah" name="account_holder" placeholder="اسم الصيدلية أو الشركة" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-an">رقم الحساب البنكي *</label>
								<input type="text" id="pm-an" name="account_number" placeholder="مثال: 100094820194" class="form-input tabular-nums" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-ib">رقم الآيبان الدولي (IBAN) *</label>
								<input type="text" id="pm-ib" name="iban" placeholder="EG3800..." class="form-input tabular-nums" />
							</div>
						</div>

						<!-- InstaPay / Wallet Fields -->
						<div x-show="payType === 'instapay_wallet'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-wp">مزود الخدمة *</label>
								<select id="pm-wp" name="wallet_provider" class="form-select">
									<option value="instapay">InstaPay (عنوان الدفع اللحظي IPA)</option>
									<option value="vodafone">فودافون كاش (Vodafone Cash)</option>
									<option value="orange">أورنج كاش (Orange Cash)</option>
									<option value="etisalat">اتصالات كاش (Etisalat Cash)</option>
									<option value="we">وي باي (WE Pay)</option>
								</select>
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-wh">معرف الدفع (IPA) أو رقم الهاتف المسجل *</label>
								<input type="text" id="pm-wh" name="wallet_handle" placeholder="01012345678 أو pharmacy@instapay" class="form-input tabular-nums" />
							</div>
						</div>

						<!-- Credit / Debit Card Fields -->
						<div x-show="payType === 'credit_card'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-cn">الاسم المدون على البطاقة *</label>
								<input type="text" id="pm-cn" name="card_name" placeholder="DR AHMED MAHMOUD" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-num">رقم البطاقة (16 رقم) *</label>
								<input type="text" id="pm-num" name="card_number" placeholder="4234 •••• •••• 9812" class="form-input tabular-nums" />
							</div>
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label" for="pm-exp">تاريخ الانتهاء (MM/YY) *</label>
									<input type="text" id="pm-exp" name="card_expiry" placeholder="12/28" class="form-input tabular-nums" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label" for="pm-cvv">رمز الأمان (CVV) *</label>
									<input type="password" id="pm-cvv" name="card_cvv" placeholder="•••" maxlength="4" class="form-input tabular-nums" />
								</div>
							</div>
						</div>

						<!-- Cheque Fields -->
						<div x-show="payType === 'cheque'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-cbr">فرع البنك المصدر للشيكات *</label>
								<input type="text" id="pm-cbr" name="cheque_branch" placeholder="مثال: البنك الأهلي - فرع المهندسين" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-ccr">رقم السجل التجاري للشيكات *</label>
								<input type="text" id="pm-ccr" name="cheque_cr" placeholder="رقم السجل التجاري" class="form-input tabular-nums" />
							</div>
						</div>

						<div style="margin-top:0.75rem;">
							<button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem;">
								@components.IconPlus("icon-xs")
								<span>حفظ وسيلة الدفع</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}
