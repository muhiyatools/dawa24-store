package pages

// AdminDevelopersSEOEditModal renders the modal for editing SEO metadata with live Google & Social card previews.
templ AdminDevelopersSEOEditModal() {
	<div
		x-show="modalOpen"
		class="fixed inset-0 z-50 d-flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
		style="display:none;"
		x-data="{ previewLang: 'ar' }"
	>
		<div
			class="glass-panel max-w-5xl w-full rounded-3xl border border-default bg-surface-raised shadow-2xl d-flex flex-col max-h-[90vh] overflow-hidden"
			@click.outside="modalOpen = false"
		>
			<!-- Modal Header (Fixed) -->
			<div class="d-flex items-center justify-between px-6 py-4 border-b border-default bg-surface">
				<div class="d-flex items-center gap-3">
					<div class="w-9 h-9 rounded-xl bg-accent/10 d-flex items-center justify-center text-accent text-lg font-bold">
						🔍
					</div>
					<div>
						<h3 class="text-base font-black text-surface-fg m-0">تعديل بيانات الـ SEO والظهور بمحركات البحث</h3>
						<div class="d-flex items-center gap-2 mt-0.5">
							<span class="text-xs text-secondary">المسار:</span>
							<span class="badge badge-sky text-xs font-mono font-bold" x-text="editForm.route_pattern || '/'"></span>
						</div>
					</div>
				</div>
				<button type="button" class="btn btn-ghost btn-sm rounded-xl text-secondary hover:text-surface-fg" @click="modalOpen = false">
					✕
				</button>
			</div>

			<form method="POST" action="/admin/developers/seo/save" class="d-flex flex-col flex-1 overflow-hidden">
				<input type="hidden" name="id" :value="editForm.id"/>
				<input type="hidden" name="route_pattern" :value="editForm.route_pattern"/>

				<!-- Modal Body (Scrollable) -->
				<div class="p-6 overflow-y-auto max-h-[calc(90vh-140px)]">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
						
						<!-- Left Column: Form Fields (7 cols) -->
						<div class="lg:col-span-7 d-flex flex-col gap-4">
							<!-- Arabic SEO Group -->
							<div class="p-4 rounded-2xl border border-default bg-surface/50 d-flex flex-col gap-3">
								<div class="text-xs font-black text-accent d-flex items-center gap-1.5">
									<span>🇪🇬</span>
									<span>بيانات محركات البحث بالعربية (Arabic SEO)</span>
								</div>

								<div>
									<div class="d-flex justify-between items-center mb-1">
										<label class="text-xs font-bold text-surface-fg">عنوان الصفحة (Title AR)</label>
										<span class="text-2xs tabular-nums" :class="editForm.title_ar.length > 60 ? 'text-danger font-bold' : 'text-secondary'" x-text="editForm.title_ar.length + ' / 60'"></span>
									</div>
									<input type="text" name="title_ar" x-model="editForm.title_ar" placeholder="مثال: مستودع الأدوية المعتمد | دوا 24" class="form-control text-xs rounded-xl border-default w-full"/>
								</div>

								<div>
									<div class="d-flex justify-between items-center mb-1">
										<label class="text-xs font-bold text-surface-fg">الوصف التعريفي (Meta Description AR)</label>
										<span class="text-2xs tabular-nums" :class="editForm.meta_desc_ar.length > 160 ? 'text-danger font-bold' : 'text-secondary'" x-text="editForm.meta_desc_ar.length + ' / 160'"></span>
									</div>
									<textarea name="meta_desc_ar" x-model="editForm.meta_desc_ar" rows="2" placeholder="وصف جذاب ومختصر يظهر في نتائج البحث..." class="form-control text-xs rounded-xl border-default w-full"></textarea>
								</div>
							</div>

							<!-- English SEO Group -->
							<div class="p-4 rounded-2xl border border-default bg-surface/50 d-flex flex-col gap-3">
								<div class="text-xs font-black text-brand d-flex items-center gap-1.5">
									<span>🌐</span>
									<span>English Search Metadata (SEO الإنجليزية)</span>
								</div>

								<div>
									<div class="d-flex justify-between items-center mb-1">
										<label class="text-xs font-bold text-surface-fg">Page Title (EN)</label>
										<span class="text-2xs tabular-nums" :class="editForm.title_en.length > 60 ? 'text-danger font-bold' : 'text-secondary'" x-text="editForm.title_en.length + ' / 60'"></span>
									</div>
									<input type="text" name="title_en" x-model="editForm.title_en" dir="ltr" placeholder="e.g. Official Pharmaceutical Catalog | Dawa24" class="form-control text-xs rounded-xl border-default w-full font-sans"/>
								</div>

								<div>
									<div class="d-flex justify-between items-center mb-1">
										<label class="text-xs font-bold text-surface-fg">Meta Description (EN)</label>
										<span class="text-2xs tabular-nums" :class="editForm.meta_desc_en.length > 160 ? 'text-danger font-bold' : 'text-secondary'" x-text="editForm.meta_desc_en.length + ' / 160'"></span>
									</div>
									<textarea name="meta_desc_en" x-model="editForm.meta_desc_en" rows="2" dir="ltr" placeholder="Concise page summary for international and English search engines..." class="form-control text-xs rounded-xl border-default w-full font-sans"></textarea>
								</div>
							</div>

							<!-- Technical Crawling Settings -->
							<div class="p-4 rounded-2xl border border-default bg-surface/50 d-flex flex-col gap-3">
								<div class="text-xs font-black text-secondary">إعدادات الزحف والروابط التقنية</div>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<div>
										<label class="block text-xs font-bold text-surface-fg mb-1">الرابط المرجعي (Canonical URL)</label>
										<input type="text" name="canonical_url" x-model="editForm.canonical_url" placeholder="https://dawa24.com/..." class="form-control text-xs rounded-xl border-default w-full font-mono" dir="ltr"/>
									</div>

									<div>
										<label class="block text-xs font-bold text-surface-fg mb-1">توجيهات الروبوتات (Robots)</label>
										<select name="robots_directives" x-model="editForm.robots_directives" class="form-select text-xs rounded-xl border-default w-full">
											<option value="index, follow">index, follow (مفهرس ومتاح)</option>
											<option value="noindex, follow">noindex, follow (تتبع دون فهرسة)</option>
											<option value="noindex, nofollow">noindex, nofollow (محظور تماماً)</option>
										</select>
									</div>
								</div>

								<div>
									<label class="block text-xs font-bold text-surface-fg mb-1">صورة المشاركة الاجتماعية (OG Image URL)</label>
									<input type="text" name="og_image" x-model="editForm.og_image" class="form-control text-xs rounded-xl border-default w-full font-mono" dir="ltr"/>
								</div>

								<div>
									<label class="block text-xs font-bold text-surface-fg mb-1">الكلمات المفتاحية (Keywords مفصولة بفواصل)</label>
									<input type="text" name="keywords" x-model="editForm.keywords" placeholder="أدوية, صيدليات, توريد, مصر, مستودع" class="form-control text-xs rounded-xl border-default w-full"/>
								</div>

								<div class="pt-1">
									<label class="d-flex items-center gap-2 cursor-pointer">
										<input type="checkbox" name="is_public" value="true" x-model="editForm.is_public" class="rounded text-accent"/>
										<span class="text-xs font-bold text-surface-fg">صفحة عامة ومتاحة لمحركات البحث والخرائط (Public Sitemap)</span>
									</label>
								</div>
							</div>
						</div>

						<!-- Right Column: Live Previews (5 cols) -->
						<div class="lg:col-span-5 d-flex flex-col gap-4">
							
							<!-- Language Switcher for Preview -->
							<div class="d-flex items-center justify-between bg-surface p-1 rounded-xl border border-default">
								<span class="text-2xs font-bold text-secondary px-2">معاينة النتائج بلغة:</span>
								<div class="d-flex gap-1">
									<button
										type="button"
										class="btn btn-xs rounded-lg font-bold px-3"
										:class="previewLang === 'ar' ? 'btn-accent' : 'btn-ghost'"
										@click="previewLang = 'ar'"
									>
										العربية
									</button>
									<button
										type="button"
										class="btn btn-xs rounded-lg font-bold px-3"
										:class="previewLang === 'en' ? 'btn-accent' : 'btn-ghost'"
										@click="previewLang = 'en'"
									>
										English
									</button>
								</div>
							</div>

							<!-- Google Search Snippet Preview -->
							<div class="p-4 rounded-2xl border border-default bg-surface shadow-xs">
								<div class="text-xs font-bold text-secondary mb-2 d-flex items-center justify-between">
									<span>معاينة نتيجة بحث Google</span>
									<span class="text-2xs font-mono text-muted">SERP Preview</span>
								</div>
								
								<!-- Arabic Preview -->
								<div x-show="previewLang === 'ar'" class="font-sans text-start" dir="rtl">
									<div class="text-2xs text-emerald-700 dark:text-emerald-400 font-mono truncate" x-text="'https://dawa24.com' + (editForm.route_pattern || '/')"></div>
									<div class="text-sm text-blue-600 dark:text-blue-400 hover:underline font-bold mt-0.5 leading-snug cursor-pointer line-clamp-1" x-text="editForm.title_ar || 'عنوان الصفحة باللغة العربية'"></div>
									<div class="text-xs text-secondary mt-1 leading-relaxed line-clamp-2" x-text="editForm.meta_desc_ar || 'وصف الصفحة التعريفي كما يظهر للمستخدم في محرك البحث...'"></div>
								</div>

								<!-- English Preview -->
								<div x-show="previewLang === 'en'" style="display:none;" class="font-sans text-start" dir="ltr">
									<div class="text-2xs text-emerald-700 dark:text-emerald-400 font-mono truncate" x-text="'https://dawa24.com' + (editForm.route_pattern || '/')"></div>
									<div class="text-sm text-blue-600 dark:text-blue-400 hover:underline font-bold mt-0.5 leading-snug cursor-pointer line-clamp-1" x-text="editForm.title_en || editForm.title_ar || 'Page Title in English'"></div>
									<div class="text-xs text-secondary mt-1 leading-relaxed line-clamp-2" x-text="editForm.meta_desc_en || editForm.meta_desc_ar || 'Page description summary as displayed on English search engine results...'"></div>
								</div>
							</div>

							<!-- Social Share Card Preview -->
							<div class="p-4 rounded-2xl border border-default bg-surface shadow-xs">
								<div class="text-xs font-bold text-secondary mb-2 d-flex items-center justify-between">
									<span>معاينة بطاقة المشاركة (Facebook / X)</span>
									<span class="text-2xs font-mono text-muted">OpenGraph</span>
								</div>
								<div class="border border-default rounded-xl overflow-hidden bg-surface-raised text-start" :dir="previewLang === 'ar' ? 'rtl' : 'ltr'">
									<div class="h-32 bg-surface-muted d-flex items-center justify-center overflow-hidden">
										<img :src="editForm.og_image" class="w-full h-full object-cover" onerror="this.src='/static/img/og-default.jpg'"/>
									</div>
									<div class="p-3">
										<div class="text-[10px] uppercase font-bold text-secondary tracking-wider">DAWA24.COM</div>
										<div class="text-xs font-bold text-surface-fg mt-0.5 line-clamp-1" x-text="editForm.og_title || (previewLang === 'en' ? (editForm.title_en || editForm.title_ar) : editForm.title_ar) || 'عنوان المشاركة الاجتماعية'"></div>
										<div class="text-[11px] text-secondary mt-0.5 line-clamp-2" x-text="editForm.og_desc || (previewLang === 'en' ? (editForm.meta_desc_en || editForm.meta_desc_ar) : editForm.meta_desc_ar) || 'وصف الصفحة عند مشاركتها على وسائل التواصل الاجتماعي...'"></div>
									</div>
								</div>
							</div>

							<!-- SEO Health / Validation Feedback -->
							<div class="d-flex flex-col gap-2">
								<div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-700 dark:text-amber-300" x-show="!editForm.canonical_url">
									⚠️ تنبيه: يفضل تحديد رابط مرجعي (Canonical URL) لتجنب انخفاض التصنيف وازدواجية المحتوى.
								</div>
								<div class="p-3 rounded-xl bg-sky-500/10 border border-sky-500/20 text-xs text-sky-700 dark:text-sky-300" x-show="editForm.title_ar.length > 0 && editForm.title_en.length > 0">
									✓ ممتاز: تم إدخال العناوين باللغتين العربية والإنجليزية لتعزيز الفهرسة الشاملة.
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Modal Footer (Fixed) -->
				<div class="d-flex items-center justify-between px-6 py-4 border-t border-default bg-surface">
					<button type="button" class="btn btn-ghost btn-sm rounded-xl font-bold" @click="modalOpen = false">
						إلغاء
					</button>
					<button type="submit" class="btn btn-accent btn-sm rounded-xl font-bold px-6 shadow-sm">
						حفظ الإعدادات الفورية
					</button>
				</div>
			</form>
		</div>
	</div>
}
