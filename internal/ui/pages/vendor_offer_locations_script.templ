package pages

import (
	"encoding/json"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/promo"
)

templ OfferLocationsScript(offerID int64) {
	<script>
		function offerLocationsManager(offerId) {
			const activeOfferId = offerId || 0;
			return {
				mode: 'add',
				editId: 0,
				offerId: activeOfferId,
				formAction: '/vendor/offers/' + activeOfferId + '/locations',
				_settingEditMode: false,
				selectedDays: [1, 2, 3, 4, 5, 6, 7],
				selectedGovId: '',
				selectedCities: [],
				allCitiesInGov: false,
				citySearch: '',
				allCitiesList: [],
				citiesMap: {},
				form: {
					id: 0,
					governorate_id: '',
					city_id: '',
					address_ar: '',
					radius: 1000,
					day_of_week: 1,
					time_from: '09:00',
					time_to: '18:00',
					lat: 30.0444,
					lng: 31.2357
				},
				init() {
					// 1. Load full cities dataset from #cities-dataset (same as weekly coverage)
					const citiesEl = document.getElementById('cities-dataset');
					if (citiesEl) {
						try {
							const raw = citiesEl.getAttribute('data-cities') || '[]';
							this.allCitiesList = JSON.parse(raw);
						} catch (e) {
							console.error('Failed to parse cities JSON dataset:', e);
							this.allCitiesList = [];
						}
					}
					// 2. Build city reference map from coords element
					const coordsEl = document.getElementById('offer-loc-cities-coords');
					if (coordsEl) {
						try {
							const raw = coordsEl.getAttribute('data-coords') || coordsEl.textContent || '{}';
							this.citiesMap = JSON.parse(raw);
						} catch (e) {
							console.error('Failed to parse city coordinates:', e);
						}
					}
					const urlParams = new URLSearchParams(window.location.search);
					const editParam = urlParams.get('edit');
					if (editParam) {
						this.$nextTick(() => {
							const btn = document.querySelector(`[data-edit-loc-btn="${editParam}"]`);
							if (btn) {
								this.setEditModeFromElement(btn);
							}
						});
					}
				},
				selectAllDays() {
					this.selectedDays = [1, 2, 3, 4, 5, 6, 7];
				},
				clearDays() {
					this.selectedDays = [];
				},
				toggleDay(d) {
					const num = parseInt(d, 10);
					const idx = this.selectedDays.indexOf(num);
					if (idx > -1) {
						this.selectedDays.splice(idx, 1);
					} else {
						this.selectedDays.push(num);
					}
				},
				onGovChange() {
					this.form.governorate_id = this.selectedGovId;
					this.selectedCities = [];
					this.allCitiesInGov = false;
					this.citySearch = '';
					if (this.selectedGovId) {
						const gId = parseInt(this.selectedGovId, 10);
						const existing = this.allCitiesList.filter(c => c.gov_id === gId || String(c.gov_id) === String(this.selectedGovId));
						const fetchURL = '/vendor/coverage/governorates/' + gId + '/cities';
						fetch(fetchURL)
							.then(r => {
								if (!r.ok) return fetch('/api/geo/governorates/' + gId + '/cities').then(res => res.json());
								return r.json();
							})
							.then(items => {
								if (Array.isArray(items)) {
									items.forEach(item => {
										if (!this.allCitiesList.some(x => x.id === item.id)) {
											this.allCitiesList.push(item);
										}
									});
								}
							})
							.catch(e => console.error('Failed to load cities via API:', e));
					}
				},
				get filteredCities() {
					if (!this.selectedGovId) return [];
					const gId = parseInt(this.selectedGovId, 10);
					const q = (this.citySearch || '').trim().toLowerCase();
					// If allCitiesList is populated, use it (same as vendor_coverage.templ)
					if (this.allCitiesList && this.allCitiesList.length > 0) {
						return this.allCitiesList.filter(c => {
							const matchGov = (c.gov_id === gId) || (String(c.gov_id) === String(this.selectedGovId));
							if (!matchGov) return false;
							if (!q) return true;
							return (c.name_ar && c.name_ar.toLowerCase().includes(q)) || (c.name_en && c.name_en.toLowerCase().includes(q));
						});
					}
					// Fallback to citiesMap if cities-dataset was unavailable
					const list = [];
					for (const [id, data] of Object.entries(this.citiesMap)) {
						const govIdVal = String(data[2]);
						if (govIdVal === String(this.selectedGovId)) {
							const nameAr = data[4] || ('مدينة ' + id);
							const nameEn = data[5] || '';
							if (!q || nameAr.toLowerCase().includes(q) || nameEn.toLowerCase().includes(q)) {
								list.push({
									id: id,
									gov_id: gId,
									name_ar: nameAr,
									name_en: nameEn,
									radius_m: data[3] || 5000,
									is_capital: Boolean(data[6])
								});
							}
						}
					}
					return list;
				},
				toggleSelectAllCities() {
					const available = this.filteredCities;
					if (this.allCitiesInGov || this.selectedCities.length === available.length) {
						this.selectedCities = [];
						this.allCitiesInGov = false;
					} else {
						this.selectedCities = available.map(c => String(c.id));
						this.allCitiesInGov = true;
					}
				},
				toggleCity(cId) {
					const sId = String(cId);
					const idx = this.selectedCities.indexOf(sId);
					if (idx > -1) {
						this.selectedCities.splice(idx, 1);
						this.allCitiesInGov = false;
					} else {
						this.selectedCities.push(sId);
					}
				},
				setTimePreset(from, to) {
					this.form.time_from = from;
					this.form.time_to = to;
				},
				setEditModeFromElement(btnEl) {
					if (!btnEl) return;
					try {
						const raw = btnEl.getAttribute('data-loc-data');
						if (!raw) return;
						const loc = JSON.parse(raw);
						this.setEditMode(loc);
					} catch (e) {
						console.error('Failed to parse location data for editing:', e);
					}
				},
				setEditMode(loc) {
					if (!loc || !loc.id) return;
					this._settingEditMode = true;
					this.mode = 'edit';
					this.editId = loc.id;
					this.formAction = '/vendor/offers/' + this.offerId + '/locations/' + loc.id + '/edit';
					const latVal = (loc.latitude !== undefined && loc.latitude !== null && loc.latitude !== 0) ? Number(loc.latitude) : 30.0444;
					const lonVal = (loc.longitude !== undefined && loc.longitude !== null && loc.longitude !== 0) ? Number(loc.longitude) : 31.2357;
					const targetCityId = (loc.city_id && loc.city_id !== 0) ? String(loc.city_id) : '';
					let targetGovId = (loc.governorate_id && loc.governorate_id !== 0) ? String(loc.governorate_id) : '';
					if (!targetGovId && targetCityId && this.citiesMap[targetCityId]) {
						targetGovId = String(this.citiesMap[targetCityId][2] || '');
					}
					const radiusVal = loc.radius ? Number(loc.radius) : 1000;
					const dayVal = loc.day_of_week ? Number(loc.day_of_week) : 1;

					this.selectedGovId = targetGovId;
					this.selectedDays = [dayVal];
					this.selectedCities = targetCityId ? [targetCityId] : [];

					Object.assign(this.form, {
						id: loc.id,
						governorate_id: targetGovId,
						city_id: targetCityId,
						address_ar: loc.address_ar || '',
						radius: radiusVal,
						day_of_week: dayVal,
						time_from: loc.time_from || '09:00',
						time_to: loc.time_to || '18:00',
						lat: latVal,
						lng: lonVal
					});

					const formEl = document.getElementById('offer-location-form-card');
					if (formEl) {
						formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
					this._settingEditMode = false;
				},
				resetToAddMode() {
					this.mode = 'add';
					this.editId = 0;
					this.formAction = '/vendor/offers/' + this.offerId + '/locations';
					this.selectedDays = [1, 2, 3, 4, 5, 6, 7];
					this.selectedGovId = '';
					this.selectedCities = [];
					this.allCitiesInGov = false;
					this.citySearch = '';
					this.form = {
						id: 0,
						governorate_id: '',
						city_id: '',
						address_ar: '',
						radius: 1000,
						day_of_week: 1,
						time_from: '09:00',
						time_to: '18:00',
						lat: 30.0444,
						lng: 31.2357
					};
				}
			};
		}
	</script>
}

func offerLocationJSON(loc *promo.SpecialOfferLocation) string {
	if loc == nil {
		return "{}"
	}
	b, err := json.Marshal(loc)
	if err != nil {
		return "{}"
	}
	return string(b)
}

func formatDayName(day int) string {
	for _, d := range daysOfWeek {
		if d.ID == day {
			return d.Name
		}
	}
	return "كافة الأيام"
}

func formatOfferRadius(radius int) string {
	if radius >= 1000 {
		return fmt.Sprintf("%.1f كم (%d م)", float64(radius)/1000.0, radius)
	}
	return fmt.Sprintf("%d متر", radius)
}
