package pages

import (
	"encoding/json"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

func formatAdminOrgJSON(o *org.Organization) string {
	if o == nil {
		return "{}"
	}
	m := map[string]any{
		"id":                  o.ID,
		"legal_name":          o.LegalName,
		"trade_name_ar":       o.TradeName.Get("ar"),
		"trade_name_en":       o.TradeName.Get("en"),
		"type":                string(o.Type),
		"status":              string(o.Status),
		"commercial_register": o.CommercialRegister,
		"tax_number":          o.TaxNumber,
		"pharmacist_license":  o.PharmacistLicense,
		"phone":               o.Phone,
		"email":               o.Email,
		"address":             o.Address,
		"credit_limit":        o.CreditLimit.String(),
		"payment_terms_days":  o.PaymentTermsDays,
		"min_order_price":     o.MinOrderPrice.String(),
		"max_order_price":     o.MaxOrderPrice.String(),
		"verification_notes":  o.VerificationNotes,
	}
	bytes, err := json.Marshal(m)
	if err != nil {
		return "{}"
	}
	return string(bytes)
}

templ AdminOrgEditModal() {
	<!-- Alpine-controlled Full Admin Organization Edit Modal -->
	<div
		x-show="isEditOpen"
		x-cloak
		class="modal-backdrop"
		@click.self="closeEdit()"
		@keydown.escape.window="closeEdit()"
		role="dialog"
		aria-modal="true"
	>
		<div
			class="glass-panel p-0 w-full max-w-2xl max-h-[85vh] flex flex-col shadow-2xl rounded-2xl border border-border/80 overflow-hidden text-start"
			@click.stop
		>
			<!-- Sticky Modal Header -->
			<div class="modal-header flex-between items-center p-3.5 sm:p-4 border-b bg-surface-raised/90 backdrop-blur-xs shrink-0">
				<div class="d-flex items-center gap-2.5">
					<div class="w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/25 flex-center text-purple-600 dark:text-purple-400">
						@components.IconBuilding("icon-xs")
					</div>
					<div>
						<div class="d-flex items-center gap-2">
							<h3 class="text-sm font-black text-primary m-0 truncate max-w-sm" x-text="'تعديل المنشأة: ' + (form.legal_name || ('#' + form.id))">
								تعديل بيانات المنشأة
							</h3>
							<span class="badge badge-purple text-2xs font-mono font-bold" x-text="'#ORG-' + form.id"></span>
						</div>
						<div class="text-2xs text-secondary mt-0.5">تحديث بيانات السجلات والتراخيص والحدود التجارية</div>
					</div>
				</div>
				<button type="button" @click="closeEdit()" class="btn btn-ghost btn-xs btn-icon text-muted" title="إغلاق">
					@components.IconClose("icon-xs")
				</button>
			</div>

			<!-- Edit Form with Scrollable Body and Sticky Footer -->
			<form :action="'/admin/organizations/' + form.id + '/edit'" method="POST" class="d-flex flex-col flex-1 min-h-0 m-0 overflow-hidden">
				<input type="hidden" name="_csrf" value="" x-init="if (typeof getCsrfToken === 'function') $el.value = getCsrfToken()"/>
				<input type="hidden" name="redirect_to" x-model="form.redirect_to"/>

				<!-- Scrollable Body -->
				<div class="modal-body flex-1 overflow-y-auto p-4 space-y-3.5">
					
					<!-- Section 1: الهوية الأساسية والنشاط -->
					<div class="p-3.5 rounded-xl bg-surface-sunken/60 border border-border/60">
						<div class="text-xs font-black text-primary mb-2.5 d-flex items-center gap-1.5">
							@components.IconBuilding("icon-xs")
							<span>الهوية الأساسية ونوع المنشأة</span>
						</div>
						<div class="d-grid grid-cols-1 sm:grid-cols-2 gap-2.5">
							<div class="form-group mb-0 sm:col-span-2">
								<label class="form-label text-2xs font-bold mb-1">
									الاسم القانوني المسجل <span class="text-danger">*</span>
								</label>
								<input
									type="text"
									name="legal_name"
									x-model="form.legal_name"
									required
									placeholder="مثال: شركة النور للمستلزمات الطبية ذ.م.م"
									class="form-input text-xs w-full font-bold"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									الاسم التجاري (بالعربية)
								</label>
								<input
									type="text"
									name="trade_name_ar"
									x-model="form.trade_name_ar"
									placeholder="مثال: صيدليات النور"
									class="form-input text-xs w-full"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									الاسم التجاري (بالإنجليزية)
								</label>
								<input
									type="text"
									name="trade_name_en"
									x-model="form.trade_name_en"
									placeholder="e.g. Al-Nour Pharmacies"
									class="form-input text-xs w-full"
									dir="ltr"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									نوع النشاط <span class="text-danger">*</span>
								</label>
								<select name="type" x-model="form.type" required class="form-select text-xs w-full font-bold">
									<option value="customer">صيدلية ومراكز طبية (Customer / Pharmacy)</option>
									<option value="vendor">مورد ومستودع أدوية (Vendor / Supplier)</option>
								</select>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									حالة الاعتماد في المنظومة <span class="text-danger">*</span>
								</label>
								<select name="status" x-model="form.status" required class="form-select text-xs w-full font-bold">
									<option value="approved">معتمد ومفعل (Approved)</option>
									<option value="pending">قيد المراجعة والتدقيق (Pending)</option>
									<option value="suspended">معلق مؤقتاً (Suspended)</option>
									<option value="rejected">مرفوض (Rejected)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Section 2: التراخيص والسجل التجاري -->
					<div class="p-3.5 rounded-xl bg-surface-sunken/60 border border-border/60">
						<div class="text-xs font-black text-primary mb-2.5 d-flex items-center gap-1.5">
							@components.IconShield("icon-xs")
							<span>التراخيص القانونية والسجلات الرسمية</span>
						</div>
						<div class="d-grid grid-cols-1 sm:grid-cols-3 gap-2.5">
							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									رقم السجل التجاري (CR)
								</label>
								<input
									type="text"
									name="commercial_register"
									x-model="form.commercial_register"
									placeholder="مثال: 10293847"
									class="form-input text-xs w-full font-mono"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									الرقم الضريبي (Tax ID)
								</label>
								<input
									type="text"
									name="tax_number"
									x-model="form.tax_number"
									placeholder="مثال: 987-654-321"
									class="form-input text-xs w-full font-mono"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									رقم ترخيص المنشأة / الصيدلي
								</label>
								<input
									type="text"
									name="pharmacist_license"
									x-model="form.pharmacist_license"
									placeholder="مثال: PH-55421"
									class="form-input text-xs w-full font-mono"
								/>
							</div>
						</div>
					</div>

					<!-- Section 3: بيانات التواصل والمقر -->
					<div class="p-3.5 rounded-xl bg-surface-sunken/60 border border-border/60">
						<div class="text-xs font-black text-primary mb-2.5 d-flex items-center gap-1.5">
							@components.IconUsers("icon-xs")
							<span>بيانات الاتصال والعنوان</span>
						</div>
						<div class="d-grid grid-cols-1 sm:grid-cols-2 gap-2.5">
							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									رقم الهاتف الرسمي
								</label>
								<input
									type="text"
									name="phone"
									x-model="form.phone"
									placeholder="مثال: 01012345678"
									class="form-input text-xs w-full font-mono"
									dir="ltr"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									البريد الإلكتروني الرسمي
								</label>
								<input
									type="email"
									name="email"
									x-model="form.email"
									placeholder="info@company.com"
									class="form-input text-xs w-full font-mono"
									dir="ltr"
								/>
							</div>

							<div class="form-group mb-0 sm:col-span-2">
								<label class="form-label text-2xs font-bold mb-1">
									العنوان والمقر الرئيسي
								</label>
								<input
									type="text"
									name="address"
									x-model="form.address"
									placeholder="شارع التسعين الشمالي، التجمع الخامس، القاهرة"
									class="form-input text-xs w-full"
								/>
							</div>
						</div>
					</div>

					<!-- Section 4: الضوابط المالية والتجارية -->
					<div class="p-3.5 rounded-xl bg-surface-sunken/60 border border-border/60">
						<div class="text-xs font-black text-primary mb-2.5 d-flex items-center gap-1.5">
							@components.IconBriefcase("icon-xs")
							<span>الحدود المالية وشروط الدفع والطلب</span>
						</div>
						<div class="d-grid grid-cols-2 sm:grid-cols-4 gap-2.5">
							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									الحد الائتماني (ج.م)
								</label>
								<input
									type="number"
									step="0.01"
									min="0"
									name="credit_limit"
									x-model="form.credit_limit"
									placeholder="0.00"
									class="form-input text-xs w-full font-mono font-bold"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									فترة السداد (أيام)
								</label>
								<input
									type="number"
									min="0"
									step="1"
									name="payment_terms_days"
									x-model="form.payment_terms_days"
									placeholder="0"
									class="form-input text-xs w-full font-mono font-bold"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									الحد الأدنى للطلب (ج.م)
								</label>
								<input
									type="number"
									step="0.01"
									min="0"
									name="min_order_price"
									x-model="form.min_order_price"
									placeholder="10.00"
									class="form-input text-xs w-full font-mono font-bold"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-2xs font-bold mb-1">
									الحد الأقصى للطلب (ج.م)
								</label>
								<input
									type="number"
									step="0.01"
									min="0"
									name="max_order_price"
									x-model="form.max_order_price"
									placeholder="50.00"
									class="form-input text-xs w-full font-mono font-bold"
								/>
							</div>
						</div>
					</div>

					<!-- Section 5: ملاحظات التدقيق الداخلي -->
					<div class="form-group mb-0">
						<label class="form-label text-2xs font-bold mb-1">
							ملاحظات التدقيق والإدارة (داخلي)
						</label>
						<textarea
							name="verification_notes"
							x-model="form.verification_notes"
							rows="2"
							placeholder="أي ملاحظات تدقيق خاصة بحالة المنشأة أو التراخيص أو الاعتماد..."
							class="form-input text-xs w-full"
						></textarea>
					</div>

				</div>

				<!-- Sticky Modal Footer -->
				<div class="modal-footer p-3.5 sm:p-4 border-t bg-surface-raised/90 backdrop-blur-xs flex-between items-center shrink-0">
					<button type="button" @click="closeEdit()" class="btn btn-secondary btn-sm font-bold">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary btn-sm font-black gap-1.5 px-5">
						@components.IconCheck("icon-xs")
						<span>حفظ التعديلات في قاعدة البيانات</span>
					</button>
				</div>
			</form>
		</div>
	</div>
}

templ AdminOrgScript() {
	<script>
		function adminOrgManager() {
			return {
				isEditOpen: false,
				form: {
					id: 0,
					legal_name: '',
					trade_name_ar: '',
					trade_name_en: '',
					type: 'customer',
					status: 'approved',
					commercial_register: '',
					tax_number: '',
					pharmacist_license: '',
					phone: '',
					email: '',
					address: '',
					credit_limit: '0.00',
					payment_terms_days: 0,
					min_order_price: '10.00',
					max_order_price: '50.00',
					verification_notes: '',
					redirect_to: ''
				},
				openEdit(data, redirectTo) {
					if (!data) return;
					this.form = Object.assign({}, this.form, data);
					this.form.redirect_to = redirectTo || '';
					this.isEditOpen = true;
				},
				closeEdit() {
					this.isEditOpen = false;
				}
			};
		}
	</script>
}
