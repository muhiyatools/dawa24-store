package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCart(cart *commerce.Cart, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCartContent(cart)
	} else {
		@layouts.CustomerShell("سلة المشتريات | Shopping Cart", lang, dir) {
			<div class="cart-page-container" style="max-width:900px; margin:2rem auto;">
				<h1 style="font-size:1.75rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					سلة المشتريات
				</h1>
				<div id="cart-content">
					@CustomerCartContent(cart)
				</div>
			</div>
		}
	}
}

templ CustomerCartContent(cart *commerce.Cart) {
	if cart == nil || len(cart.Items) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "سلة المشتريات فارغة",
			Message:     "لم تقم بإضافة أي أدوية أو مستلزمات إلى سلة المشتريات بعد.",
			ActionLabel: "تصفح الكتالوج",
		})
	} else {
		<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-xl); padding:1.5rem; display:flex; flex-direction:column; gap:1.5rem;">
			<div style="display:flex; flex-direction:column; gap:1rem;">
				for _, item := range cart.Items {
					<div style="display:flex; align-items:center; justify-content:space-between; padding-bottom:1rem; border-bottom:1px solid var(--neutral-100);">
						<div>
							<h4 style="font-weight:700; font-size:1rem; color:var(--neutral-900);">
								المنتج #{ fmt.Sprintf("%d", item.ProductID) }
							</h4>
							<div style="font-size:0.85rem; color:var(--neutral-500);">
								سعر الوحدة: <span class="tabular-nums">{ item.UnitPrice.String() } EGP</span>
							</div>
						</div>

						<div style="display:flex; align-items:center; gap:1rem;">
							<div style="font-weight:700;" class="tabular-nums">
								الكمية: { fmt.Sprintf("%d", item.Quantity) }
							</div>
							<button
								hx-delete={ fmt.Sprintf("/api/v1/commerce/cart/items/%d", item.ProductVariantID) }
								hx-target="#cart-content"
								class="btn btn-secondary"
								style="color:var(--danger-600); border-color:var(--danger-200); font-size:0.8rem; padding:0.4rem 0.75rem;"
							>
								حذف
							</button>
						</div>
					</div>
				}
			</div>

			<div style="border-top:2px solid var(--neutral-100); padding-top:1.5rem; display:flex; align-items:center; justify-content:space-between;">
				<div>
					<span style="font-size:0.9rem; color:var(--neutral-600);">إجمالي السلة:</span>
				</div>
				<div style="display:flex; align-items:center; gap:1.5rem;">
					<a href="/checkout" class="btn btn-primary" style="padding:0.75rem 2rem; font-size:1rem; font-weight:700;">
						متابعة إتمام الشراء
					</a>
				</div>
			</div>
		</div>
	}
}
