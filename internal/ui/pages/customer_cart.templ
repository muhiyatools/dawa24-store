package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCart(cart *commerce.Cart, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCartContent(cart, lang)
	} else {
		@layouts.CustomerShell("سلة المشتريات | Shopping Cart", lang, dir) {
			<div class="cart-page-container" style="max-width:980px; margin:1rem auto 3rem auto;">
				<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.5rem;">
					@components.IconCart("icon-md")
					<h1 style="font-size:1.75rem; font-weight:900; color:var(--neutral-900); margin:0;">
						سلة المشتريات وأوامر التوريد
					</h1>
				</div>
				<div id="cart-content">
					@CustomerCartContent(cart, lang)
				</div>
			</div>
		}
	}
}

templ CustomerCartContent(cart *commerce.Cart, lang string) {
	if cart == nil || len(cart.Items) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "سلة المشتريات فارغة",
			Message:     "لم تقم بإضافة أي أدوية أو مستلزمات إلى سلة المشتريات بعد.",
			ActionLabel: "تصفح الكتالوج الدوائي",
		})
	} else {
		<div class="card" style="margin-bottom:0; display:flex; flex-direction:column; gap:1.75rem; padding:2rem;">
			<div style="display:flex; flex-direction:column; gap:2rem;">
				for _, group := range GroupCartBySupplier(cart) {
					<div style="border:1px solid var(--border-card); border-radius:var(--radius-lg); padding:1.25rem; background:var(--neutral-50);">
						<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
							<div style="display:flex; align-items:center; gap:0.5rem;">
								@components.IconBuilding("icon-xs")
								<h3 style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin:0;">
									{ group.SupplierName.Get(i18n.Lang(lang)) }
								</h3>
							</div>
							<div style="font-size:0.875rem; color:var(--neutral-600);">
								<span>الإجمالي الفرعي للمورد: </span>
								<strong class="tabular-nums" style="color:var(--primary-700);">
									@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: group.Subtotal })
								</strong>
							</div>
						</div>

						<div style="display:flex; flex-direction:column; gap:0.75rem; background:#ffffff; border-radius:var(--radius-md); padding:0.75rem;">
							for _, item := range group.Items {
								<div style="display:flex; align-items:center; justify-content:space-between; padding:0.75rem; border-bottom:1px solid var(--neutral-100); flex-wrap:wrap; gap:1rem;">
									<div style="display:flex; align-items:center; gap:0.875rem; flex:1; min-width:240px;">
										<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
											@components.IconPill("icon-xs")
										</div>
										<div>
											<h4 style="font-weight:800; font-size:1rem; color:var(--neutral-900); margin-bottom:0.15rem;">
												{ item.ProductName.Get(i18n.Lang(lang)) }
											</h4>
											<div style="font-size:0.8rem; color:var(--neutral-500);">
												سعر الوحدة: <span class="tabular-nums" style="font-weight:700; color:var(--neutral-800);">{ item.UnitPrice.String() } ج.م</span>
											</div>
										</div>
									</div>

									<div style="display:flex; align-items:center; gap:1.25rem;">
										<!-- Real Quantity Stepper Controls -->
										<div class="quantity-control">
											<form action="/cart/update-quantity" method="POST" style="margin:0; display:inline;">
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
												<input type="hidden" name="quantity" value={ fmt.Sprintf("%d", item.Quantity - 1) } />
												<button type="submit" class="quantity-btn" title="تقليل الكمية">
													@components.IconMinus("icon-xs")
												</button>
											</form>

											<span class="quantity-input tabular-nums" style="display:flex; align-items:center; justify-content:center;">
												{ fmt.Sprintf("%d", item.Quantity) }
											</span>

											<form action="/cart/update-quantity" method="POST" style="margin:0; display:inline;">
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
												<input type="hidden" name="quantity" value={ fmt.Sprintf("%d", item.Quantity + 1) } />
												<button type="submit" class="quantity-btn" title="زيادة الكمية">
													@components.IconPlus("icon-xs")
												</button>
											</form>
										</div>

										<form action="/cart/remove" method="POST" style="margin:0; display:inline;">
											<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
											<button
												type="submit"
												class="btn btn-secondary btn-icon"
												style="color:var(--danger); border-color:var(--danger-border); width:32px; height:32px;"
												title="حذف من السلة"
											>
												@components.IconTrash("icon-xs")
											</button>
										</form>
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<div style="border-top:2px solid var(--neutral-100); padding-top:1.75rem; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1.5rem;">
				<div>
					<span style="font-size:0.875rem; color:var(--neutral-500);">إجمالي قيمة الطلبيات:</span>
					<div style="font-size:1.5rem; font-weight:900; color:var(--neutral-900);" class="tabular-nums">
						@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: CartTotal(cart), Large: true })
					</div>
					<span style="font-size:0.8rem; color:var(--neutral-500);">شامل الفاتورة الضريبية والشحن المبرد</span>
				</div>
				<div style="display:flex; align-items:center; gap:1rem;">
					<a href="/catalog" class="btn btn-secondary">
						<span>متابعة التسوق</span>
					</a>
					<a href="/checkout" class="btn btn-primary" style="padding:0.75rem 2.25rem; font-size:1rem; font-weight:800;">
						<span>إتمام أمر الشراء</span>
						@components.IconArrowLeft("icon-xs")
					</a>
				</div>
			</div>
		</div>
	}
}
