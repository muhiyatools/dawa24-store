package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCart(cart *commerce.Cart, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCartContent(cart, lang)
	} else {
		@layouts.CustomerShell("سلة المشتريات | Shopping Cart", "cart", lang, dir, nil) {
			<div class="page-container max-w-6xl">
				@components.PageHeader(components.PageHeaderProps{
					Title:    "سلة المشتريات وأوامر التوريد",
					Subtitle: "مراجعة أصناف الأدوية، الكميات المطلوبة، وتقسيم الشحنات حسب الموردين المعتمدين",
				}) {
					<a href="/catalog" class="btn btn-secondary font-semibold gap-2">
						@components.IconArrowRight("icon-xs")
						<span>متابعة إضافة أدوية</span>
					</a>
				}

				<div class="stack-sm" id="cart-content">
					@CustomerCartContent(cart, lang)
				</div>
			</div>
		}
	}
}

templ CustomerCartContent(cart *commerce.Cart, lang string) {
	if cart == nil || len(cart.Items) == 0 {
		<div class="empty-state-glass p-8 text-center">
			<div class="empty-state-icon-wrapper mx-auto mb-4">
				@components.IconCart("icon-lg")
			</div>
			<h2 class="text-2xl font-black text-primary mb-2">
				سلة المشتريات فارغة حالياً
			</h2>
			<p class="text-sm text-muted max-w-md mx-auto mb-6 leading-relaxed">
				لم تقم بإضافة أي أصناف دوائية أو مستلزمات طبية بعد. تصفح الكتالوج الدوائي لاكتشاف أفضل العروض والخصومات المباشرة.
			</p>
			<a href="/catalog" class="btn btn-primary btn-lg font-extrabold px-8">
				@components.IconSearch("icon-xs")
				<span>تصفح الكتالوج الدوائي الموحد</span>
			</a>
		</div>
	} else {
		if buying, has := authctx.BuyingBranchFrom(ctx); has && len(buying.Branches) > 0 {
			<div class="glass-panel p-4 mb-4 flex-between flex-wrap gap-4">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge">
						@components.IconMapPin("icon-sm")
					</div>
     <div class="stack-sm">
						<div class="text-xs text-muted font-semibold">فرع استلام الشحنات وتغطية التوريد:</div>
						<div class="text-base font-extrabold text-primary d-flex items-center gap-2">
							<span>
								for _, b := range buying.Branches {
									if buying.Active != nil && *buying.Active == b.ID {
										{ b.Name }
									}
								}
							</span>
							<span class="badge badge-emerald text-xs">الفرع النشط</span>
						</div>
					</div>
				</div>
    <div class="stack-sm">
					<form method="POST" action="/customer/set-branch" class="m-0 d-inline-flex items-center gap-2">
						<input type="hidden" name="redirect_to" value="/cart" />
						<span class="text-xs text-secondary font-semibold">تغيير الفرع:</span>
						<select
							name="branch_id"
							class="form-select form-input-sm"
							onchange="this.form.submit()"
						>
							for _, b := range buying.Branches {
								<option
									value={ fmt.Sprintf("%d", b.ID) }
									selected?={ buying.Active != nil && *buying.Active == b.ID }
								>
									{ b.Name }
								</option>
							}
						</select>
					</form>
				</div>
			</div>
		}
		<div class="cart-grid-layout">
			<!-- Left: Items Grouped by Supplier -->
			<div class="d-flex flex-col gap-4">
				for _, group := range GroupCartBySupplier(cart) {
					<div class="cart-supplier-card">
						<!-- Supplier Group Header -->
						<div class="cart-supplier-header">
							<div class="d-flex items-center gap-3">
								<div class="user-avatar-badge">
									@components.IconBuilding("icon-xs")
								</div>
        <div class="stack-sm">
									<div class="font-extrabold text-lg text-primary">
										{ group.SupplierName.Get(i18n.Lang(lang)) }
									</div>
									<div class="d-flex items-center gap-2 text-xs text-muted mt-1">
										<span class="badge badge-sky text-xs">مورد معتمد</span>
										<span>•</span>
										<span>شحن مبرد 2° - 8°C</span>
									</div>
								</div>
							</div>

							<div class="text-end">
								<span class="text-sm text-muted">المجموع الفرعي للمورد:</span>
								<div class="tabular-nums font-black text-xl text-brand">
									@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: group.Subtotal })
								</div>
							</div>
						</div>

						if group.BelowMin {
							<div class="alert alert-danger mb-4 p-3 d-flex items-center gap-2 text-xs">
								@components.IconAlertCircle("icon-xs")
								<span>
									الحد الأدنى للتوريد من هذا العرض هو <strong class="tabular-nums">{ group.MinOrderPrice.String() } ج.م</strong> (يتبقى <strong class="tabular-nums">{ money.FromMinor(group.MinOrderPrice.Minor() - group.Subtotal.Minor()).String() } ج.م</strong> لإتمام الشراء)
								</span>
							</div>
						}

						<!-- Items List -->
						<div class="d-flex flex-col gap-3">
							for _, item := range group.Items {
								<div class="cart-item-row">
									<div class="d-flex items-center gap-3 flex-1 min-w-0">
										<div class="user-avatar-badge">
											@components.IconPill("icon-sm")
										</div>
          <div class="stack-sm">
											<h4 class="font-extrabold text-base text-primary m-0">
												{ item.ProductName.Get(i18n.Lang(lang)) }
											</h4>
											<div class="d-flex items-center gap-3 text-xs text-secondary mt-1 flex-wrap">
												<span>سعر الوحدة: <strong class="tabular-nums text-primary">{ item.UnitPrice.String() } ج.م</strong></span>
												if item.AvailableStock > 0 && item.Quantity >= item.AvailableStock {
													<span class="badge badge-amber text-xs font-bold">أقصى كمية متاحة بالمخزون</span>
												}
												if !item.IsCovered && item.CoverageReason != "" {
													<span class="badge badge-rose text-xs font-bold">
														{ item.CoverageReason }
													</span>
												}
											</div>
										</div>
									</div>

									<div class="d-flex items-center gap-4">
										<!-- Horizontal Stepper -->
										<div class="cart-stepper-control">
											<form action="/cart/update-quantity" method="POST" hx-post="/cart/update-quantity" hx-target="#cart-content" hx-swap="innerHTML" class="m-0 d-inline">
												<input type="hidden" name="item_id" value={ fmt.Sprintf("%d", item.ID) } />
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
												<input type="hidden" name="quantity" value={ fmt.Sprintf("%d", item.Quantity - 1) } />
												<button
													type="submit"
													class="cart-stepper-btn"
													title="تقليل الكمية"
												>
													@components.IconMinus("icon-xs")
												</button>
											</form>

											<span class="tabular-nums font-extrabold text-sm text-primary px-2">
												{ fmt.Sprintf("%d", item.Quantity) }
											</span>

											<form action="/cart/update-quantity" method="POST" hx-post="/cart/update-quantity" hx-target="#cart-content" hx-swap="innerHTML" class="m-0 d-inline">
												<input type="hidden" name="item_id" value={ fmt.Sprintf("%d", item.ID) } />
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
												<input type="hidden" name="quantity" value={ fmt.Sprintf("%d", item.Quantity + 1) } />
												<button
													type="submit"
													class="cart-stepper-btn"
													disabled?={ item.AvailableStock > 0 && item.Quantity >= item.AvailableStock }
													title={ fmt.Sprintf("زيادة الكمية (المتاح: %d)", item.AvailableStock) }
												>
													@components.IconPlus("icon-xs")
												</button>
											</form>
										</div>

										<!-- Total Line Item Price -->
										<div class="tabular-nums text-end font-extrabold text-base text-primary min-w-0">
											{ money.FromMinor(item.UnitPrice.Minor() * int64(item.Quantity)).String() } ج.م
										</div>

										<!-- Remove Button -->
										<form action="/cart/remove" method="POST" hx-post="/cart/remove" hx-target="#cart-content" hx-swap="innerHTML" class="m-0 d-inline">
											<input type="hidden" name="item_id" value={ fmt.Sprintf("%d", item.ID) } />
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
											<button
												type="submit"
												class="btn btn-secondary btn-icon text-danger"
												title="حذف من السلة"
											>
												@components.IconTrash("icon-xs")
											</button>
										</form>
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<!-- Right: Order Summary Sidebar -->
			<div class="cart-summary-card">
				<h3 class="text-lg font-black text-primary mb-4">
					ملخص أمر الشراء
				</h3>

				<div class="d-flex flex-col gap-3 mb-6 text-sm">
					<div class="flex-between text-secondary">
						<span>المجموع الفرعي:</span>
						<span class="tabular-nums font-bold text-primary">
							@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: CartTotal(cart) })
						</span>
					</div>

					<div class="flex-between text-secondary">
						<span>ضريبة القيمة المضافة (14% VAT):</span>
						<span class="tabular-nums font-bold text-secondary">مشمولة بالفاتورة</span>
					</div>

					<div class="flex-between text-secondary">
						<span>رسوم الشحن الدوائي المبرد:</span>
						<span class="badge badge-emerald text-xs">مجاني للطلبيات المعتمدة</span>
					</div>

					<div class="border-t pt-4 flex-between items-center">
						<span class="font-black text-base text-primary">الإجمالي النهائي:</span>
						<div class="font-black text-2xl text-brand tabular-nums">
							@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: CartTotal(cart), Large: true })
						</div>
					</div>
				</div>

				<div class="d-flex flex-col gap-3">
					if HasUncoveredItems(cart) {
						<div class="alert alert-danger p-3 text-xs leading-relaxed">
							<strong>تنبيه التغطية:</strong> يحتوي طلبك على أصناف خارج نطاق تغطية الفرع المحدد. يرجى حذفها أو اختيار فرع صيدلية آخر متاح في نطاق التوريد.
						</div>
						<button type="button" disabled class="btn btn-secondary w-full p-3 font-bold opacity-60 cursor-not-allowed">
							<span>غير متاح للإتمام (أصناف خارج التغطية)</span>
						</button>
					} else {
						<a href="/checkout" class="btn btn-primary w-full p-3 font-extrabold flex-center gap-2">
							@components.IconCheck("icon-xs")
							<span>متابعة إتمام أمر الشراء</span>
						</a>
					}

					<a href="/catalog" class="btn btn-secondary w-full p-2 flex-center font-bold">
						<span>إضافة المزيد من الأدوية</span>
					</a>
				</div>

				<div class="mt-4 pt-4 border-t d-flex flex-col gap-2 text-xs text-muted">
					<div class="d-flex items-center gap-2">
						<span class="text-success">@components.IconCheckCircle("icon-xs")</span>
						<span>شحن دوائي آمن تحت درجات حرارة محكومة</span>
					</div>
					<div class="d-flex items-center gap-2">
						<span class="text-brand">@components.IconFileText("icon-xs")</span>
						<span>فواتير ضريبية إلكترونية معتمدة (ETA e-Invoice)</span>
					</div>
				</div>
			</div>
		</div>
	}
}
