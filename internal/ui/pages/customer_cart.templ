package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCart(cart *commerce.Cart, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCartContent(cart, lang)
	} else {
		@layouts.CustomerShell("سلة المشتريات | Shopping Cart", lang, dir) {
			<div class="cart-page-container" style="max-width:1160px; margin:1.5rem auto 8rem auto; min-height:75vh;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconCart("icon-sm")
							</div>
							<h1 style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin:0;">
								سلة المشتريات وأوامر التوريد
							</h1>
						</div>
						<p style="color:var(--neutral-500); font-size:0.925rem; margin:0;">
							مراجعة أصناف الأدوية، الكميات المطلوبة، وتقسيم الشحنات حسب الموردين المعتمدين
						</p>
					</div>

					<a href="/catalog" class="btn btn-secondary" style="font-weight:700;">
						@components.IconArrowRight("icon-xs")
						<span>متابعة إضافة أدوية</span>
					</a>
				</div>

				<div id="cart-content">
					@CustomerCartContent(cart, lang)
				</div>
			</div>
		}
	}
}

templ CustomerCartContent(cart *commerce.Cart, lang string) {
	if cart == nil || len(cart.Items) == 0 {
		<div class="card" style="padding:4rem 2rem; text-align:center;">
			<div style="width:64px; height:64px; border-radius:var(--radius-full); background:var(--primary-50); color:var(--primary-600); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem auto;">
				@components.IconCart("icon-lg")
			</div>
			<h2 style="font-size:1.5rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.5rem;">
				سلة المشتريات فارغة حالياً
			</h2>
			<p style="color:var(--neutral-500); font-size:0.95rem; max-width:480px; margin:0 auto 2rem auto; line-height:1.6;">
				لم تقم بإضافة أي أصناف دوائية أو مستلزمات طبية بعد. تصفح الكتالوج الدوائي لاكتشاف أفضل العروض والخصومات المباشرة.
			</p>
			<a href="/catalog" class="btn btn-primary" style="padding:0.75rem 2rem; font-size:1rem; font-weight:800; display:inline-flex;">
				@components.IconSearch("icon-xs")
				<span>تصفح الكتالوج الدوائي الموحد</span>
			</a>
		</div>
	} else {
		<div style="display:grid; grid-template-columns:1fr 340px; gap:2rem; align-items:start;">
			<!-- Left: Items Grouped by Supplier -->
			<div style="display:flex; flex-direction:column; gap:1.75rem;">
				for _, group := range GroupCartBySupplier(cart) {
					<div class="card" style="margin-bottom:0; padding:1.5rem; border:1px solid var(--border-card); border-radius:var(--radius-xl);">
						<!-- Supplier Group Header -->
						<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:1rem; border-bottom:1.5px solid var(--neutral-100); margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
							<div style="display:flex; align-items:center; gap:0.75rem;">
								<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
									@components.IconBuilding("icon-xs")
								</div>
								<div>
									<div style="font-weight:800; font-size:1.05rem; color:var(--neutral-900);">
										{ group.SupplierName.Get(i18n.Lang(lang)) }
									</div>
									<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.75rem; color:var(--neutral-500); margin-top:0.15rem;">
										<span class="badge badge-sky" style="font-size:0.7rem; padding:0.1rem 0.4rem;">مورد معتمد</span>
										<span>•</span>
										<span>شحن مبرد 2° - 8°C</span>
									</div>
								</div>
							</div>

							<div style="text-align:end;">
								<span style="font-size:0.8rem; color:var(--neutral-500);">المجموع الفرعي للمورد:</span>
								<div class="tabular-nums" style="font-weight:900; font-size:1.15rem; color:var(--primary-700);">
									@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: group.Subtotal })
								</div>
							</div>
						</div>

						<!-- Items Table / List -->
						<div style="display:flex; flex-direction:column; gap:1rem;">
							for _, item := range group.Items {
								<div style="display:flex; align-items:center; justify-content:space-between; padding:0.85rem; background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-lg); flex-wrap:wrap; gap:1rem;">
									<div style="display:flex; align-items:center; gap:0.85rem; flex:1; min-width:240px;">
										<div style="width:40px; height:40px; border-radius:var(--radius-md); background:#ffffff; color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0; border:1px solid var(--neutral-200);">
											@components.IconPill("icon-sm")
										</div>
										<div>
											<h4 style="font-weight:800; font-size:0.95rem; color:var(--neutral-900); margin:0;">
												{ item.ProductName.Get(i18n.Lang(lang)) }
											</h4>
											<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.2rem;">
												سعر الوحدة: <span class="tabular-nums" style="font-weight:700; color:var(--neutral-800);">{ item.UnitPrice.String() } ج.م</span>
											</div>
										</div>
									</div>

									<div style="display:flex; align-items:center; gap:1.25rem;">
										<!-- Quantity Stepper -->
										<div class="quantity-control" style="background:#ffffff;">
											<form action="/cart/update-quantity" method="POST" hx-post="/cart/update-quantity" hx-target="#cart-content" hx-swap="innerHTML" style="margin:0; display:inline;">
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
												<input type="hidden" name="quantity" value={ fmt.Sprintf("%d", item.Quantity - 1) } />
												<button type="submit" class="quantity-btn" title="تقليل الكمية">
													@components.IconMinus("icon-xs")
												</button>
											</form>

											<span class="quantity-input tabular-nums" style="display:flex; align-items:center; justify-content:center; font-weight:800;">
												{ fmt.Sprintf("%d", item.Quantity) }
											</span>

											<form action="/cart/update-quantity" method="POST" hx-post="/cart/update-quantity" hx-target="#cart-content" hx-swap="innerHTML" style="margin:0; display:inline;">
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
												<input type="hidden" name="quantity" value={ fmt.Sprintf("%d", item.Quantity + 1) } />
												<button type="submit" class="quantity-btn" title="زيادة الكمية">
													@components.IconPlus("icon-xs")
												</button>
											</form>
										</div>

										<!-- Total Line Item Price -->
										<div style="min-width:90px; text-align:end;" class="tabular-nums">
											<div style="font-weight:800; font-size:1rem; color:var(--neutral-900);">
												{ money.FromMinor(item.UnitPrice.Minor() * int64(item.Quantity)).String() } ج.م
											</div>
										</div>

										<!-- Remove Button -->
										<form action="/cart/remove" method="POST" style="margin:0; display:inline;">
											<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", item.ProductVariantID) } />
											<button
												type="submit"
												class="btn btn-secondary btn-icon"
												style="color:var(--danger); border-color:var(--danger-border); width:34px; height:34px;"
												title="حذف من السلة"
											>
												@components.IconTrash("icon-xs")
											</button>
										</form>
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<!-- Right: Order Summary Sidebar -->
			<div class="card" style="margin-bottom:0; padding:1.75rem; position:sticky; top:6rem; border:1px solid var(--border-card); border-radius:var(--radius-xl); box-shadow:var(--shadow-md);">
				<h3 style="font-size:1.15rem; font-weight:900; color:var(--neutral-900); margin-bottom:1.25rem;">
					ملخص أمر الشراء
				</h3>

				<div style="display:flex; flex-direction:column; gap:0.875rem; margin-bottom:1.5rem; font-size:0.9rem;">
					<div style="display:flex; justify-content:space-between; color:var(--neutral-600);">
						<span>المجموع الفرعي:</span>
						<span class="tabular-nums" style="font-weight:700; color:var(--neutral-900);">
							@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: CartTotal(cart) })
						</span>
					</div>

					<div style="display:flex; justify-content:space-between; color:var(--neutral-600);">
						<span>ضريبة القيمة المضافة (14% VAT):</span>
						<span class="tabular-nums" style="font-weight:700; color:var(--neutral-700);">مشمولة بالفاتورة</span>
					</div>

					<div style="display:flex; justify-content:space-between; color:var(--neutral-600);">
						<span>رسوم الشحن الدوائي المبرد:</span>
						<span class="badge badge-emerald" style="font-size:0.75rem;">مجاني للطلبيات المعتمدة</span>
					</div>

					<div style="border-top:1.5px dashed var(--neutral-200); padding-top:1rem; display:flex; justify-content:space-between; align-items:center;">
						<span style="font-weight:900; font-size:1.05rem; color:var(--neutral-900);">الإجمالي النهائي:</span>
						<div style="font-weight:900; font-size:1.45rem; color:var(--primary-700);" class="tabular-nums">
							@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: CartTotal(cart), Large: true })
						</div>
					</div>
				</div>

				<div style="display:flex; flex-direction:column; gap:0.75rem;">
					<a href="/checkout" class="btn btn-primary" style="width:100%; padding:0.85rem; font-size:1.05rem; font-weight:800; justify-content:center;">
						@components.IconCheck("icon-xs")
						<span>متابعة إتمام أمر الشراء</span>
					</a>

					<a href="/catalog" class="btn btn-secondary" style="width:100%; padding:0.65rem; justify-content:center; font-weight:700;">
						<span>إضافة المزيد من الأدوية</span>
					</a>
				</div>

				<div style="margin-top:1.25rem; padding-top:1.25rem; border-top:1px solid var(--neutral-100); display:flex; flex-direction:column; gap:0.5rem; font-size:0.775rem; color:var(--neutral-500);">
					<div style="display:flex; align-items:center; gap:0.4rem;">
						<span style="color:var(--success);">@components.IconCheckCircle("icon-xs")</span>
						<span>شحن دوائي آمن تحت درجات حرارة محكومة</span>
					</div>
					<div style="display:flex; align-items:center; gap:0.4rem;">
						<span style="color:var(--primary-600);">@components.IconFileText("icon-xs")</span>
						<span>فواتير ضريبية إلكترونية معتمدة (ETA e-Invoice)</span>
					</div>
				</div>
			</div>
		</div>
	}
}
