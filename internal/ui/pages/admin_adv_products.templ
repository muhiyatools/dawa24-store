package pages

import (
	"fmt"
	"time"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminAdvProductItem struct {
	Request      *promo.SponsorshipRequest
	Product      *catalog.Product
	Organization *org.Organization
	Package      *promo.OfferPackage
	IsActive     bool
	IsPending    bool
	IsExpired    bool
	IsRejected   bool
}

type AdminAdvProductsData struct {
	Items             []AdminAdvProductItem
	TotalCount        int
	ActiveCount       int
	PendingCount      int
	ExpiredCount      int
	RejectedCount     int
	Packages          []*promo.OfferPackage
	Vendors           []*org.Organization
	CatalogProducts   []*catalog.Product
	ActiveTab         string
	SearchQuery       string
	SelectedPackageID int64
	NoticeType        string
	NoticeMsg         string
	Page              int
	PerPage           int
	FilteredTotal     int
}

func advTierBadgeClass(tier int) string {
	switch tier {
	case 5:
		return "badge-primary"
	case 4:
		return "badge-purple"
	case 3:
		return "badge-amber"
	case 2:
		return "badge-slate"
	default:
		return "badge-sky"
	}
}

func advTierName(tier int) string {
	switch tier {
	case 5:
		return "ماسي (Diamond)"
	case 4:
		return "بلاتيني (Platinum)"
	case 3:
		return "ذهبي (Gold)"
	case 2:
		return "فضي (Silver)"
	default:
		return "عادي (Standard)"
	}
}

func advDaysRemaining(expiresAt time.Time) string {
	if expiresAt.IsZero() {
		return "-"
	}
	remaining := time.Until(expiresAt)
	if remaining <= 0 {
		return "منتهية"
	}
	days := int(remaining.Hours() / 24)
	if days == 0 {
		return "اليوم"
	}
	return fmt.Sprintf("متبقي %d يوم", days)
}

func orgDisplayName(o *org.Organization, lang string) string {
	if o == nil {
		return ""
	}
	if name := o.TradeName.Get(i18n.ParseLang(lang)); name != "" {
		return name
	}
	if o.LegalName != "" {
		return o.LegalName
	}
	return fmt.Sprintf("منشأة #%d", o.ID)
}

func productImage(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	if p.Image != "" {
		return p.Image
	}
	return p.ImageLink
}

templ AdminAdvProductsPage(lang, dir string, data AdminAdvProductsData) {
	@layouts.AdminShell("رعاية المنتجات | Product Sponsorships", "adv_products", lang, dir) {
		<div class="page-container" x-data="{ rejectModalOpen: false, rejectId: 0, rejectAction: '', addModalOpen: false }">
			
			<!-- Notice Toast Banner -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-4 p-4 d-flex items-center gap-2">
						@components.IconAlert("icon-xs")
						<span class="font-bold text-sm">{ data.NoticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 d-flex items-center gap-2">
						@components.IconCheckCircle("icon-xs")
						<span class="font-bold text-sm">{ data.NoticeMsg }</span>
					</div>
				}
			}

			<!-- Top Header Banner -->
			<div class="glass-panel p-6 mb-6 flex-between items-center flex-wrap gap-4">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge text-xl">
						@components.IconSparkles("icon-sm")
					</div>
					<div class="stack-sm">
						<h1 class="text-2xl font-black text-primary m-0">
							رعاية وتثبيت المنتجات (Product Sponsorships)
						</h1>
						<p class="text-xs text-secondary m-0 mt-0.5">
							إدارة ومتابعة المنتجات المروجة في الصدارة، استهلاك باقات الرعاية للموردين، واعتماد طلبات التثبيت
						</p>
					</div>
				</div>

				<div class="d-flex items-center gap-2.5 flex-wrap">
					<a href="/admin/offers-packages" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-2xs">
						@components.IconPackage("icon-xs")
						<span>باقات الرعايات والعروض ↗</span>
					</a>
					<button
						type="button"
						class="btn btn-primary btn-sm font-bold gap-1.5 shadow-2xs"
						@click="addModalOpen = true"
					>
						@components.IconPlus("icon-xs")
						<span>+ إضافة وتثبيت رعاية لمنتج</span>
					</button>
				</div>
			</div>

			<!-- 4 Modern Executive Metric Cards -->
			<div class="d-grid grid-auto-fit-sm gap-4 mb-6">
				<div class="glass-panel p-4 border-s-4 border-s-accent mb-0">
					<div class="flex-between items-center mb-1">
						<span class="text-xs font-bold text-muted">إجمالي المنتجات المروجة</span>
						<span class="text-accent">@components.IconSparkles("icon-xs")</span>
					</div>
					<div class="text-2xl font-black text-primary tabular-nums">
						{ fmt.Sprintf("%d", data.TotalCount) }
					</div>
					<div class="text-2xs text-muted mt-1">كافة سجلات الرعايات المسجلة</div>
				</div>

				<div class="glass-panel p-4 border-s-4 border-s-success mb-0">
					<div class="flex-between items-center mb-1">
						<span class="text-xs font-bold text-muted">الرعايات النشطة حالياً</span>
						<span class="text-success">@components.IconCheckCircle("icon-xs")</span>
					</div>
					<div class="text-2xl font-black text-emerald tabular-nums">
						{ fmt.Sprintf("%d", data.ActiveCount) }
					</div>
					<div class="text-2xs text-muted mt-1">مثبتة في صدارة البحث والكتالوج</div>
				</div>

				<div class="glass-panel p-4 border-s-4 border-s-warning mb-0">
					<div class="flex-between items-center mb-1">
						<span class="text-xs font-bold text-muted">طلبات بانتظار الموافقة</span>
						<span class="text-warning">@components.IconClock("icon-xs")</span>
					</div>
					<div class="text-2xl font-black text-warning tabular-nums">
						{ fmt.Sprintf("%d", data.PendingCount) }
					</div>
					<div class="text-2xs text-muted mt-1">تتطلب تدقيق وموافقة الإدارة</div>
				</div>

				<div class="glass-panel p-4 border-s-4 border-s-slate mb-0">
					<div class="flex-between items-center mb-1">
						<span class="text-xs font-bold text-muted">الطلبات المنتهية</span>
						<span class="text-muted">@components.IconPackage("icon-xs")</span>
					</div>
					<div class="text-2xl font-black text-muted tabular-nums">
						{ fmt.Sprintf("%d", data.ExpiredCount + data.RejectedCount) }
					</div>
					<div class="text-2xs text-muted mt-1">
						{ fmt.Sprintf("%d منتهية • %d مرفوضة", data.ExpiredCount, data.RejectedCount) }
					</div>
				</div>
			</div>

			<!-- Navigation Tabs matching platform design -->
			<div class="glass-panel p-3 mb-6">
				<div class="tabs-nav">
					<a
						href="/admin/adv-products?tab=all"
						class={ "tab-btn", templ.KV("active", data.ActiveTab == "all" || data.ActiveTab == "") }
					>
						<span>كافة الرعايات</span>
						<span class="badge badge-slate text-2xs tabular-nums">{ fmt.Sprintf("%d", data.TotalCount) }</span>
					</a>
					<a
						href="/admin/adv-products?tab=active"
						class={ "tab-btn", templ.KV("active", data.ActiveTab == "active") }
					>
						<span>النشطة والمعتمدة</span>
						<span class="badge badge-emerald text-2xs tabular-nums">{ fmt.Sprintf("%d", data.ActiveCount) }</span>
					</a>
					<a
						href="/admin/adv-products?tab=pending"
						class={ "tab-btn", templ.KV("active", data.ActiveTab == "pending") }
					>
						<span>بانتظار الموافقة</span>
						if data.PendingCount > 0 {
							<span class="badge badge-amber text-2xs tabular-nums animate-pulse">{ fmt.Sprintf("%d", data.PendingCount) }</span>
						} else {
							<span class="badge badge-slate text-2xs tabular-nums">0</span>
						}
					</a>
					<a
						href="/admin/adv-products?tab=expired"
						class={ "tab-btn", templ.KV("active", data.ActiveTab == "expired") }
					>
						<span>المنتهية</span>
						<span class="badge badge-slate text-2xs tabular-nums">{ fmt.Sprintf("%d", data.ExpiredCount) }</span>
					</a>
					<a
						href="/admin/adv-products?tab=rejected"
						class={ "tab-btn", templ.KV("active", data.ActiveTab == "rejected") }
					>
						<span>المرفوضة</span>
						<span class="badge badge-rose text-2xs tabular-nums">{ fmt.Sprintf("%d", data.RejectedCount) }</span>
					</a>
				</div>
			</div>

			<!-- Filter & Live Search Toolbar -->
			<div class="glass-panel p-4 mb-6">
				<form method="GET" action="/admin/adv-products" class="d-flex items-center gap-3 flex-wrap m-0">
					<input type="hidden" name="tab" value={ data.ActiveTab } />

					<!-- Search input -->
					<div class="flex-1 min-w-60">
						<input
							type="text"
							name="q"
							value={ data.SearchQuery }
							placeholder="ابحث باسم المنتج، الكود، المورد، أو اسم الباقة..."
							class="form-input text-xs w-full"
						/>
					</div>

					<!-- Package filter -->
					<div class="min-w-48">
						<select name="package_id" class="form-select text-xs w-full" onchange="this.form.submit()">
							<option value="0">-- كافة باقات الرعاية --</option>
							for _, p := range data.Packages {
								if p != nil {
									<option value={ fmt.Sprintf("%d", p.ID) } selected?={ data.SelectedPackageID == p.ID }>
										{ p.Name.Get(i18n.ParseLang(lang)) } ({ advTierName(p.TierLevel) })
									</option>
								}
							}
						</select>
					</div>

					<!-- Submit & Reset Buttons -->
					<button type="submit" class="btn btn-primary btn-sm font-bold">
						@components.IconSearch("icon-xs")
						<span>تصفية</span>
					</button>

					if data.SearchQuery != "" || data.SelectedPackageID > 0 {
						<a href={ templ.SafeURL(fmt.Sprintf("/admin/adv-products?tab=%s", data.ActiveTab)) } class="btn btn-secondary btn-sm font-bold">
							إلغاء التصفية
						</a>
					}
				</form>
			</div>

			<!-- Main Sponsored Products Table Card -->
			<div class="glass-panel p-0 overflow-hidden mb-6">
				<div class="p-4 border-b d-flex items-center justify-between">
					<h3 class="font-bold text-sm text-primary m-0 d-flex items-center gap-2">
						@components.IconPackage("icon-xs text-primary")
						<span>سجل رعاية وتثبيت المنتجات</span>
					</h3>
					<span class="badge badge-sky text-2xs font-bold tabular-nums">
						{ fmt.Sprintf("%d منتج معروض", len(data.Items)) }
					</span>
				</div>

				if len(data.Items) == 0 {
					<div class="p-12 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconSparkles("icon-sm")</div>
						<h3 class="text-base font-bold text-primary mb-1">لا توجد منتجات مروجة في هذا القسم</h3>
						<p class="text-xs text-secondary m-0 max-w-md mx-auto mb-4">
							يمكن للموردين ترويج منتجاتهم عبر باقات الرعاية أو يمكنك إضافة وتثبيت رعاية لمنتج يدوياً الآن
						</p>
						<button
							type="button"
							class="btn btn-primary btn-sm font-bold gap-1.5"
							@click="addModalOpen = true"
						>
							@components.IconPlus("icon-xs")
							<span>+ إضافة وتثبيت رعاية لمنتج الآن</span>
						</button>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0 text-xs w-full">
							<thead>
								<tr>
									<th>المنتج المروّج</th>
									<th>المورد / المنشأة</th>
									<th>باقة الرعاية والمستوى</th>
									<th>فترة الرعاية</th>
									<th>الرصيد والتكلفة</th>
									<th class="text-center">الحالة</th>
									<th class="col-actions">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Items {
									<tr>
										<!-- Product Column -->
										<td>
											<div class="d-flex items-center gap-3">
												<div class="w-10 h-10 rounded-lg bg-surface-sunken border d-flex items-center justify-center shrink-0 overflow-hidden">
													if img := productImage(item.Product); img != "" {
														<img src={ img } alt="Product" class="w-full h-full object-cover" />
													} else {
														@components.IconPackage("icon-xs text-muted")
													}
												</div>
												<div class="stack-xs text-start">
													<div class="font-bold text-sm text-primary">
														if item.Product != nil {
															{ item.Product.Name.Get(i18n.ParseLang(lang)) }
														} else {
															<span>منتج رقم #{ fmt.Sprintf("%d", item.Request.ItemID) }</span>
														}
													</div>
													<div class="d-flex items-center gap-1.5 text-2xs text-muted tabular-nums">
														if item.Product != nil && item.Product.PublicID != "" {
															<span class="font-mono font-semibold">{ item.Product.PublicID }</span>
															<span>•</span>
														}
														if item.Product != nil && item.Product.Barcode != "" {
															<span class="font-mono">{ item.Product.Barcode }</span>
														} else {
															<span>ID: #{ fmt.Sprintf("%d", item.Request.ItemID) }</span>
														}
													</div>
												</div>
											</div>
										</td>

										<!-- Vendor Column -->
										<td>
											if item.Organization != nil {
												<div class="font-bold text-xs text-primary">
													{ orgDisplayName(item.Organization, lang) }
												</div>
												<div class="text-2xs text-muted font-mono mt-0.5" dir="ltr">
													if item.Organization.OrganizationNumber != "" {
														<span>كود: { item.Organization.OrganizationNumber }</span>
													} else {
														<span>ID: #{ fmt.Sprintf("%d", item.Organization.ID) }</span>
													}
												</div>
											} else {
												<span class="text-xs text-muted">منشأة #{ fmt.Sprintf("%d", item.Request.OrganizationID) }</span>
											}
										</td>

										<!-- Package & Tier Column -->
										<td>
											if item.Package != nil {
												<div class="d-flex items-center gap-1.5 flex-wrap">
													<strong class="text-xs text-primary">{ item.Package.Name.Get(i18n.ParseLang(lang)) }</strong>
													<span class={ "badge text-2xs font-bold", advTierBadgeClass(item.Package.TierLevel) }>
														{ advTierName(item.Package.TierLevel) }
													</span>
												</div>
												<div class="text-2xs text-muted mt-0.5">
													<span>المستوى: { fmt.Sprintf("%d", item.Package.TierLevel) }</span>
													<span> • </span>
													<span>{ fmt.Sprintf("%d يوم", item.Package.DurationDays) }</span>
												</div>
											} else {
												<span class="badge badge-sky text-2xs font-bold">باقة رعاية عامة</span>
											}
										</td>

										<!-- Dates Column -->
										<td>
											<div class="text-xs font-semibold text-primary tabular-nums">
												{ format.Date(item.Request.StartsAt, lang) }
												<span> - </span>
												{ format.Date(item.Request.ExpiresAt, lang) }
											</div>
											<div class="text-2xs mt-0.5 font-bold">
												if item.IsActive {
													<span class="text-emerald tabular-nums">● { advDaysRemaining(item.Request.ExpiresAt) }</span>
												} else if item.IsPending {
													<span class="text-amber">⏳ قيد المراجعة</span>
												} else if item.IsExpired {
													<span class="text-muted">منتهية الصلاحية</span>
												} else if item.IsRejected {
													<span class="text-danger">مرفوضة</span>
												}
											</div>
										</td>

										<!-- Credits / Price Column -->
										<td>
											<div class="font-bold text-xs text-primary tabular-nums">
												{ fmt.Sprintf("%d رصيد", item.Request.CreditsUsed) }
											</div>
											if item.Package != nil && item.Package.Price.IsPositive() {
												<div class="text-2xs text-muted tabular-nums">
													{ item.Package.Price.String() } ج.م
												</div>
											}
										</td>

										<!-- Status Column -->
										<td class="text-center">
											if item.IsActive {
												<span class="badge badge-emerald text-xs font-bold">نشطة ومعتمدة</span>
											} else if item.IsPending {
												<span class="badge badge-amber text-xs font-bold animate-pulse">بانتظار الموافقة</span>
											} else if item.IsExpired {
												<span class="badge badge-slate text-xs font-bold">منتهية الصلاحية</span>
											} else if item.IsRejected {
												<span class="badge badge-rose text-xs font-bold">مرفوضة</span>
											} else {
												<span class="badge badge-slate text-xs font-bold">{ string(item.Request.Status) }</span>
											}
										</td>

										<!-- Actions Column -->
										<td class="col-actions">
											<div class="d-flex items-center gap-1.5 justify-end">
												<!-- If Pending: Show Approve & Reject -->
												if item.IsPending {
													<!-- Approve Form -->
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/adv-products/%d/approve", item.Request.ID)) } class="m-0">
														<button
															type="submit"
															class="btn btn-primary btn-xs font-bold gap-1"
															title="موافقة وتفعيل الرعاية في الصدارة فوراً"
														>
															@components.IconCheck("icon-2xs")
															<span>اعتماد</span>
														</button>
													</form>

													<!-- Reject Button (opens modal) -->
													<button
														type="button"
														class="btn btn-secondary btn-xs font-bold text-rose-600 gap-1"
														title="رفض الطلب وإعادة الرصيد للمورد"
														@click={ fmt.Sprintf("rejectId = %d; rejectAction = '/admin/adv-products/%d/reject'; rejectModalOpen = true", item.Request.ID, item.Request.ID) }
													>
														@components.IconClose("icon-2xs")
														<span>رفض</span>
													</button>
												}

												<!-- If Active: Option to reject/revoke if needed -->
												if item.IsActive {
													<button
														type="button"
														class="btn btn-secondary btn-xs font-bold text-rose-600 gap-1"
														title="إلغاء وتجميد الرعاية"
														@click={ fmt.Sprintf("rejectId = %d; rejectAction = '/admin/adv-products/%d/reject'; rejectModalOpen = true", item.Request.ID, item.Request.ID) }
													>
														@components.IconClose("icon-2xs")
														<span>إلغاء</span>
													</button>
												}

												<!-- View Product in Catalog -->
												if item.Product != nil {
													<a
														href={ templ.SafeURL(fmt.Sprintf("/admin/products/%d", item.Product.ID)) }
														class="btn btn-secondary btn-xs font-bold text-accent gap-1"
														title="معاينة تفاصيل المنتج في الكتالوج"
														target="_blank"
													>
														@components.IconEye("icon-2xs")
														<span>عرض</span>
													</a>
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if data.FilteredTotal > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.FilteredTotal,
							BaseURL:     "/admin/adv-products",
							QueryValues: map[string][]string{
								"tab":        {data.ActiveTab},
								"q":          {data.SearchQuery},
								"package_id": {fmt.Sprintf("%d", data.SelectedPackageID)},
							},
						})
					}
				}
			</div>

			<!-- ================= ADD PRODUCT SPONSORSHIP MODAL ================= -->
			<div x-show="addModalOpen" x-cloak class="modal-backdrop" @click.self="addModalOpen = false">
				<div class="modal-content max-w-lg w-full mx-4 glass-panel border rounded-3xl shadow-2xl overflow-hidden text-start" @click.stop>
					<div class="modal-header p-5 border-b flex-between items-center">
						<div class="d-flex items-center gap-2.5">
							<div class="w-9 h-9 rounded-xl bg-accent-subtle text-accent d-flex items-center justify-center">
								@components.IconSparkles("icon-xs")
							</div>
							<div class="stack-xs text-start">
								<h3 class="text-base font-black text-primary m-0">إضافة وتفعيل رعاية منتج يدوياً</h3>
								<span class="text-2xs text-muted">تثبيت وترويج منتج في صدارة الكتالوج لصالح مورد محدد</span>
							</div>
						</div>
						<button type="button" @click="addModalOpen = false" class="btn btn-ghost btn-sm text-slate-400 hover:text-slate-600">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/admin/adv-products/new" class="p-6 d-flex flex-col gap-4 m-0">
						<!-- Vendor Selection -->
						<div class="stack-xs">
							<label class="form-label text-xs font-bold text-primary">
								المنشأة / المورد المستفيد <span class="text-danger">*</span>
							</label>
							<select name="org_id" required class="form-select text-xs w-full">
								<option value="">-- اختر المنشأة أو المورد --</option>
								for _, v := range data.Vendors {
									if v != nil {
										<option value={ fmt.Sprintf("%d", v.ID) }>
											{ orgDisplayName(v, lang) }
											if v.OrganizationNumber != "" {
												({ v.OrganizationNumber })
											}
										</option>
									}
								}
							</select>
						</div>

						<!-- Product Selection -->
						<div class="stack-xs">
							<label class="form-label text-xs font-bold text-primary">
								المنتج المراد تثبيته ورعايته <span class="text-danger">*</span>
							</label>
							<select name="product_id" required class="form-select text-xs w-full">
								<option value="">-- اختر المنتج من الكتالوج --</option>
								for _, prod := range data.CatalogProducts {
									if prod != nil {
										<option value={ fmt.Sprintf("%d", prod.ID) }>
											{ prod.Name.Get(i18n.ParseLang(lang)) }
											if prod.PublicID != "" {
												({ prod.PublicID })
											}
										</option>
									}
								}
							</select>
						</div>

						<!-- Package & Duration Selection -->
						<div class="d-grid grid-cols-2 gap-3">
							<div class="stack-xs">
								<label class="form-label text-xs font-bold text-primary">
									باقة الرعاية <span class="text-danger">*</span>
								</label>
								<select name="package_id" required class="form-select text-xs w-full">
									<option value="">-- اختر الباقة --</option>
									for _, p := range data.Packages {
										if p != nil {
											<option value={ fmt.Sprintf("%d", p.ID) }>
												{ p.Name.Get(i18n.ParseLang(lang)) } - { advTierName(p.TierLevel) }
											</option>
										}
									}
								</select>
							</div>

							<div class="stack-xs">
								<label class="form-label text-xs font-bold text-primary">
									مدة التثبيت (بالأيام) <span class="text-danger">*</span>
								</label>
								<input
									type="number"
									name="duration_days"
									value="30"
									min="1"
									max="365"
									required
									class="form-input text-xs font-bold tabular-nums w-full"
								/>
							</div>
						</div>

						<!-- Form Actions -->
						<div class="d-flex justify-between items-center pt-4 border-t mt-2">
							<button
								type="button"
								class="btn btn-secondary font-bold"
								@click="addModalOpen = false"
							>
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary font-bold px-6">
								@components.IconCheck("icon-xs")
								<span>+ تأكيد وتفعيل رعاية المنتج فوراً</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- ================= REJECT / REVOKE MODAL ================= -->
			<div x-show="rejectModalOpen" x-cloak class="modal-backdrop" @click.self="rejectModalOpen = false">
				<div class="modal-content max-w-md w-full mx-4 glass-panel border border-rose-200 rounded-3xl shadow-2xl overflow-hidden text-start" @click.stop>
					<div class="modal-header p-5 border-b border-rose-100 flex-between items-center bg-rose-50/70">
						<div class="d-flex items-center gap-2.5">
							<div class="w-9 h-9 rounded-xl bg-rose-500 text-white d-flex items-center justify-center">
								@components.IconAlert("icon-xs")
							</div>
							<div class="stack-xs text-start">
								<h3 class="text-base font-black text-rose-700 m-0">رفض أو إلغاء رعاية المنتج</h3>
								<span class="text-2xs text-muted">إيقاف التثبيت في الصدارة وإعادة الرصيد للمورد</span>
							</div>
						</div>
						<button type="button" @click="rejectModalOpen = false" class="btn btn-ghost btn-sm text-slate-400 hover:text-slate-600">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form :action="rejectAction" method="POST" class="p-6 d-flex flex-col gap-4 m-0">
						<p class="text-xs text-secondary m-0">
							سيتم رفض طلب الرعاية وإيقاف ظهوره في الصدارة وإعادة رصيد الرعاية للمورد مع إرسال إشعار بالملاحظات المدونة أدناه.
						</p>

						<div class="stack-xs">
							<label class="form-label text-xs font-bold text-primary">
								سبب الرفض أو الملاحظات للمورد
							</label>
							<textarea
								name="notes"
								rows="3"
								placeholder="اكتب سبب الرفض أو التوجيهات للمورد..."
								class="form-input text-xs w-full"
							></textarea>
						</div>

						<div class="d-flex justify-between items-center pt-4 border-t mt-2">
							<button
								type="button"
								class="btn btn-secondary font-bold"
								@click="rejectModalOpen = false"
							>
								تراجع
							</button>
							<button type="submit" class="btn btn-danger font-bold px-6">
								تأكيد الرفض والإلغاء
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}
