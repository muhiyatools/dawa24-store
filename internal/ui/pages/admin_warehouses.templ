package pages

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminWarehouseRowView wraps a warehouse with owner organization metadata.
type AdminWarehouseRowView struct {
	Warehouse *inventory.Warehouse
	OrgName   string
}

// AdminWarehouseDetailView carries all metadata, metrics, items, filters and pagination for a warehouse.
type AdminWarehouseDetailView struct {
	Warehouse        *inventory.Warehouse
	OrgName          string
	Items            []*inventory.DetailedWarehouseStockView
	TotalItems       int
	TotalUnits       int
	AvailableCount   int
	LowStockCount    int
	OutOfStockCount  int
	SearchQuery      string
	StatusFilter     string
	NegotiableFilter string
	CurrentPage      int
	PageSize         int
	TotalCount       int
	QueryValues      url.Values
}

// AdminWarehousesPage renders permanent warehouses list.
templ AdminWarehousesPage(warehouses []*AdminWarehouseRowView, lang, dir string) {
	@layouts.AdminShell("إدارة المخازن ومراكز التوزيع", "warehouses", lang, dir) {
		<div class="d-flex flex-col gap-6 w-full">
			<!-- Header Banner -->
			<div class="glass-panel mb-0 bg-surface-raised border rounded-2xl p-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-4">
						<div class="w-12 h-12 rounded-2xl bg-accent-subtle text-accent flex-center text-2xl shrink-0">
							@components.IconBuilding("icon-sm")
						</div>
						<div class="stack-sm">
							<h1 class="text-xl font-black text-primary m-0">إدارة المخازن ومراكز التوزيع</h1>
							<p class="text-sm text-secondary m-0 mt-1">متابعة أرصدة المخزون الحي وحدود الأمان بالمستودعات</p>
						</div>
					</div>

					<div class="badge badge-sky font-bold text-sm px-3.5 py-1.5">
						{ fmt.Sprintf("إجمالي %d مخزن معتمد", len(warehouses)) }
					</div>
				</div>
			</div>

			<!-- Warehouses Table Card -->
			<div class="glass-panel mb-0 border rounded-2xl p-0 overflow-hidden bg-surface-raised">
				if len(warehouses) == 0 {
					<div class="p-16 text-center">
						<div class="w-14 h-14 rounded-full bg-surface-sunken text-muted flex-center mx-auto mb-4 text-2xl">
							@components.IconBuilding("icon-sm")
						</div>
						<h3 class="text-lg font-black text-primary m-0 mb-1">لا توجد مخازن مسجلة</h3>
						<p class="text-sm text-secondary max-w-sm mx-auto">لم تتم إضافة أي مخازن معتمدة بعد.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>المخزن</th>
									<th>المنشأة المالكة</th>
									<th>العنوان</th>
									<th>الهاتف</th>
									<th class="text-center">الحالة</th>
									<th class="col-actions">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range warehouses {
									<tr>
										<td>
											<div class="d-flex items-center gap-2.5">
												<span class="text-lg">@components.IconBuilding("icon-sm")</span>
												<div class="stack-sm">
													<strong class="text-primary text-sm font-black">{ row.Warehouse.Name }</strong>
													if row.Warehouse.Code != "" {
														<div class="text-xs text-muted font-mono">الكود: { row.Warehouse.Code }</div>
													}
												</div>
											</div>
										</td>
										<td>
											if row.OrgName != "" {
												<span class="badge badge-slate font-bold text-xs">
													{ row.OrgName }
												</span>
											} else {
												<span class="text-muted text-sm">منشأة #{ fmt.Sprintf("%d", row.Warehouse.OrganizationID) }</span>
											}
										</td>
										<td>
											if row.Warehouse.Address != "" {
												<span class="text-sm text-primary font-semibold">{ row.Warehouse.Address }</span>
											} else {
												<span class="text-muted text-sm">غير محدد</span>
											}
										</td>
										<td class="tabular-nums">
											if row.Warehouse.Phone != "" {
												<span dir="ltr" class="text-sm font-bold">{ row.Warehouse.Phone }</span>
											} else {
												<span class="text-muted text-sm">-</span>
											}
										</td>
										<td class="text-center">
											if row.Warehouse.IsActive {
												<span class="badge badge-emerald font-black">نشط</span>
											} else {
												<span class="badge badge-rose font-black">غير نشط</span>
											}
										</td>
										<td class="col-actions">
											<a
												href={ templ.SafeURL(fmt.Sprintf("/admin/warehouses/%d", row.Warehouse.ID)) }
												class="btn btn-secondary btn-sm font-bold text-xs px-3.5 py-1.5 rounded-lg gap-1.5 inline-flex items-center"
											>
												@components.IconPackage("icon-xs")
												<span>عرض المخزون</span>
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}

// AdminWarehouseDetailPage renders full warehouse detail and searchable/paginated stocks page.
templ AdminWarehouseDetailPage(data AdminWarehouseDetailView, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("مخزون مخزن: %s", data.Warehouse.Name), "warehouses", lang, dir) {
		<div class="d-flex flex-col gap-6 w-full">

			<!-- Breadcrumb & Top Bar -->
			<div class="flex-between items-center flex-wrap gap-4">
				<div class="d-flex items-center gap-2.5 text-sm">
					<a href="/admin/warehouses" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5 font-bold rounded-lg">
						@components.IconArrowRight("icon-xs")
						<span>العودة لقائمة المخازن</span>
					</a>
					<span class="text-muted">|</span>
					<span class="text-muted text-xs">المخزن الحالي:</span>
					<strong class="text-primary text-sm font-bold">{ data.Warehouse.Name }</strong>
				</div>

				<div class="d-flex items-center gap-2">
					if data.Warehouse.IsActive {
						<span class="badge badge-emerald font-black px-3.5 py-1.5 text-xs">هذا المخزن نشط</span>
					} else {
						<span class="badge badge-rose font-black px-3.5 py-1.5 text-xs">هذا المخزن غير نشط</span>
					}
				</div>
			</div>

			<!-- Warehouse Profile Banner -->
			<div class="glass-panel mb-0 border rounded-2xl p-6 bg-surface-raised">
				<div class="flex-between items-center flex-wrap gap-5">
					<div class="d-flex items-center gap-4">
						<div class="w-14 h-14 rounded-2xl bg-sky-500/15 text-accent flex-center text-2xl shrink-0 border border-sky-500/25">
							@components.IconBuilding("icon-sm")
						</div>
						<div class="stack-sm">
							<div class="d-flex items-center gap-2.5 flex-wrap">
								<h1 class="text-xl font-black text-primary m-0">
									مخزون مخزن: { data.Warehouse.Name }
								</h1>
								if data.OrgName != "" {
									<span class="badge badge-sky font-bold text-xs px-2.5 py-1">
										{ data.OrgName }
									</span>
								} else {
									<span class="badge badge-slate font-bold text-xs">
										منشأة #{ fmt.Sprintf("%d", data.Warehouse.OrganizationID) }
									</span>
								}
							</div>
							<div class="d-flex items-center gap-5 flex-wrap text-xs text-secondary mt-1.5">
								if data.Warehouse.Code != "" {
									<div class="d-flex items-center gap-1.5">
										<span class="text-muted">كود المخزن:</span>
										<code class="bg-surface-raised px-1.5 py-0.5 rounded border font-mono font-bold text-xs">{ data.Warehouse.Code }</code>
									</div>
								}
								<div class="d-flex items-center gap-1.5">
									<span class="text-muted">العنوان:</span>
									<span class="text-primary font-semibold">
										if data.Warehouse.Address != "" {
											{ data.Warehouse.Address }
										} else {
											غير محدد
										}
									</span>
								</div>
								if data.Warehouse.Phone != "" {
									<div class="d-flex items-center gap-1.5">
										<span class="text-muted">الهاتف:</span>
										<span dir="ltr" class="tabular-nums text-primary font-bold">{ data.Warehouse.Phone }</span>
									</div>
								}
							</div>
						</div>
					</div>

					<div class="d-flex gap-2 items-center">
						<a href={ templ.SafeURL(fmt.Sprintf("/admin/warehouses/%d", data.Warehouse.ID)) } class="btn btn-secondary btn-sm d-flex items-center gap-1.5 font-bold rounded-lg px-3.5 py-1.5">
							@components.IconRefresh("icon-xs")
							<span>تحديث البيانات</span>
						</a>
					</div>
				</div>
			</div>

			<!-- KPI Stat Summary Cards (Responsive 4-Column Grid) -->
			<div class="warehouse-kpi-grid">
				<!-- Total SKUs -->
				<div class="glass-panel mb-0 warehouse-kpi-card border-t-4 border-t-primary bg-surface-raised">
					<div class="flex-between items-start mb-1.5">
						<span class="text-xs font-bold text-secondary">إجمالي الأصناف</span>
						<span class="text-base">@components.IconPackage("icon-sm")</span>
					</div>
					<div class="tabular-nums text-3xl font-black text-primary leading-tight">
						{ fmt.Sprintf("%d", data.TotalItems) }
					</div>
					<div class="text-xs text-muted mt-1">
						بإجمالي <strong class="text-primary">{ fmt.Sprintf("%d", data.TotalUnits) }</strong> وحدة مخزنية
					</div>
				</div>

				<!-- Available (Ready for order) -->
				<div class="glass-panel mb-0 warehouse-kpi-card border-t-4 border-t-emerald bg-surface-raised">
					<div class="flex-between items-start mb-1.5">
						<span class="text-xs font-bold text-secondary">متاح للطلب</span>
						<span class="text-base">@components.IconCheckCircle("icon-sm")</span>
					</div>
					<div class="tabular-nums text-3xl font-black text-emerald leading-tight">
						{ fmt.Sprintf("%d", data.AvailableCount) }
					</div>
					<div class="text-xs text-muted mt-1">
						أصناف فوق حد الأمان
					</div>
				</div>

				<!-- Low Stock -->
				<div class="glass-panel mb-0 warehouse-kpi-card border-t-4 border-t-amber bg-surface-raised">
					<div class="flex-between items-start mb-1.5">
						<span class="text-xs font-bold text-secondary">رصيد منخفض</span>
						<span class="text-base">@components.IconAlert("icon-sm")</span>
					</div>
					<div class="tabular-nums text-3xl font-black text-warning leading-tight">
						{ fmt.Sprintf("%d", data.LowStockCount) }
					</div>
					<div class="text-xs text-muted mt-1">
						أصناف تحت حد الأمان
					</div>
				</div>

				<!-- Out of Stock -->
				<div class="glass-panel mb-0 warehouse-kpi-card border-t-4 border-t-rose bg-surface-raised">
					<div class="flex-between items-start mb-1.5">
						<span class="text-xs font-bold text-secondary">نفد المخزون</span>
						<span class="text-base">@components.IconClose("icon-sm")</span>
					</div>
					<div class="tabular-nums text-3xl font-black text-danger leading-tight">
						{ fmt.Sprintf("%d", data.OutOfStockCount) }
					</div>
					<div class="text-xs text-muted mt-1">
						رصيد صفري (غير متاح)
					</div>
				</div>
			</div>

			<!-- Filter & Search Toolbar Card -->
			<div class="filter-bar">
				<form method="GET" action={ templ.SafeURL(fmt.Sprintf("/admin/warehouses/%d", data.Warehouse.ID)) } class="stack-md">
					<div class="warehouse-filter-grid">

						<!-- Search Query -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-secondary mb-1">
								بحث في الأصناف
							</label>
							<div class="relative">
								<input
									type="text"
									name="q"
									value={ data.SearchQuery }
									placeholder="ابحث باسم الصنف، كود SKU، الباركود أو رقم التشغيلة..."
									class="form-input ps-9 text-sm h-10 w-full rounded-lg"
								/>
								<div class="absolute start-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none">
									@components.IconSearch("icon-xs")
								</div>
							</div>
						</div>

						<!-- Stock Status Filter -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-secondary mb-1">حالة المخزون</label>
							<select name="status" class="form-input text-sm h-10 rounded-lg">
								<option value="all" selected?={ data.StatusFilter == "all" || data.StatusFilter == "" }>جميع الحالات</option>
								<option value="available" selected?={ data.StatusFilter == "available" }>متوفر (فوق حد الأمان)</option>
								<option value="low" selected?={ data.StatusFilter == "low" }>رصيد منخفض</option>
								<option value="out" selected?={ data.StatusFilter == "out" }>نفد المخزون (صفر)</option>
							</select>
						</div>

						<!-- Negotiation Filter -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-secondary mb-1">قابلية التفاوض</label>
							<select name="negotiable" class="form-input text-sm h-10 rounded-lg">
								<option value="all" selected?={ data.NegotiableFilter == "all" || data.NegotiableFilter == "" }>الكل</option>
								<option value="yes" selected?={ data.NegotiableFilter == "yes" }>قابل للتفاوض</option>
								<option value="no" selected?={ data.NegotiableFilter == "no" }>سعر ثابت فقط</option>
							</select>
						</div>

						<!-- Page Size Selector -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-secondary mb-1">عدد النتائج بالصفحة</label>
							<select name="limit" class="form-input text-sm h-10 rounded-lg">
								<option value="25" selected?={ data.PageSize == 25 }>25 صنف</option>
								<option value="50" selected?={ data.PageSize == 50 }>50 صنف</option>
								<option value="100" selected?={ data.PageSize == 100 }>100 صنف</option>
								<option value="250" selected?={ data.PageSize == 250 }>250 صنف</option>
							</select>
						</div>
					</div>

					<!-- Filter Actions -->
					<div class="flex-between items-center border-t pt-3 flex-wrap gap-3">
						<div class="text-xs text-secondary font-semibold">
							إجمالي النتائج: <span class="tabular-nums text-primary font-black">{ fmt.Sprintf("%d", data.TotalCount) }</span> صنف
						</div>

						<div class="d-flex items-center gap-3">
							if data.SearchQuery != "" || (data.StatusFilter != "all" && data.StatusFilter != "") || (data.NegotiableFilter != "all" && data.NegotiableFilter != "") {
								<a href={ templ.SafeURL(fmt.Sprintf("/admin/warehouses/%d", data.Warehouse.ID)) } class="btn btn-ghost btn-sm text-muted">
									مسح الفلاتر
								</a>
							}
							<button type="submit" class="btn btn-primary btn-sm d-flex items-center gap-1.5 px-5 font-bold rounded-lg">
								@components.IconSearch("icon-xs")
								<span>بحث وتصفية</span>
							</button>
						</div>
					</div>
				</form>
			</div>

			<!-- Inventory Data Table Card -->
			<div class="glass-panel mb-0 border rounded-2xl p-0 overflow-hidden bg-surface-raised shadow-xs">
				<div class="p-5 border-b flex-between items-center flex-wrap gap-3 bg-surface">
					<div class="d-flex items-center gap-2.5">
						<span class="text-base">@components.IconPackage("icon-sm")</span>
						<h3 class="font-black text-base text-primary m-0">
							أصناف المخزون
						</h3>
						<span class="badge badge-slate text-xs tabular-nums font-bold">
							{ fmt.Sprintf("%d صنف معروض", len(data.Items)) }
						</span>
					</div>
				</div>

				if len(data.Items) == 0 {
					<div class="p-16 text-center">
						<div class="w-14 h-14 rounded-full bg-surface-sunken text-muted flex-center mx-auto mb-4 text-2xl">
							@components.IconPackage("icon-sm")
						</div>
						<h4 class="text-base font-black text-primary m-0 mb-2">لا توجد أصناف مطابقة</h4>
						<p class="text-sm text-secondary max-w-md mx-auto mb-6">
							لم يتم العثور على أي أصناف تطابق معايير البحث الحالية. جرّب تعديل الفلاتر أو مسحها.
						</p>
						<a href={ templ.SafeURL(fmt.Sprintf("/admin/warehouses/%d", data.Warehouse.ID)) } class="btn btn-secondary btn-sm font-bold">
							مسح الفلاتر وإعادة العرض
						</a>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th class="w-12">#</th>
									<th>الصنف</th>
									<th>كود SKU والباركود</th>
									<th>التشغيلة والصلاحية</th>
									<th>السعر</th>
									<th>الخصم</th>
									<th>التفاوض</th>
									<th>الكمية</th>
									<th>حد الأمان</th>
									<th>الحالة</th>
								</tr>
							</thead>
							<tbody>
								for idx, st := range data.Items {
									<tr>
										<td class="tabular-nums text-muted text-sm">
											{ fmt.Sprintf("%d", (data.CurrentPage-1)*data.PageSize + idx + 1) }
										</td>
										<td>
											<div class="stack-sm">
												<div class="font-bold text-primary text-sm">
													if st.ProductName != "" {
														{ st.ProductName }
													} else {
														صنف غير معروف
													}
												</div>
												if st.VariantName != "" {
													<div class="text-xs text-secondary mt-0.5">
														{ st.VariantName }
													</div>
												}
												if st.ProductID > 0 {
													<div class="text-xs text-muted mt-0.5">
														ID: #{ fmt.Sprintf("%d", st.ProductID) }
													</div>
												}
											</div>
										</td>
										<td class="tabular-nums font-mono text-xs">
											if st.SKU != "" {
												<div class="font-semibold text-primary">{ st.SKU }</div>
											}
											if st.Barcode != "" {
												<div class="text-muted text-xs">{ st.Barcode }</div>
											}
											if st.SKU == "" && st.Barcode == "" {
												<span class="text-muted">-</span>
											}
										</td>
										<td class="tabular-nums">
											if st.BatchNumber != "" {
												<div class="text-sm font-bold text-primary">
													{ st.BatchNumber }
												</div>
											} else {
												<div class="text-muted text-sm">-</div>
											}
											if st.ExpiryDate != nil {
												<div class="text-xs text-muted" title="تاريخ الصلاحية">
													{ st.ExpiryDate.Format("2006-01-02") }
												</div>
											}
										</td>
										<td class="tabular-nums font-bold text-primary text-sm">
											if st.PriceStr != "" && st.PriceStr != "0.00" {
												{ st.PriceStr } <span class="text-xs font-semibold text-secondary">ج.م</span>
											} else {
												<span class="text-muted">-</span>
											}
										</td>
										<td class="tabular-nums font-bold text-emerald text-sm">
											if st.DiscountStr != "" && st.DiscountStr != "0.00" && st.DiscountStr != "0" {
												if strings.HasSuffix(st.DiscountStr, "%") {
													{ st.DiscountStr }
												} else {
													{ st.DiscountStr }%
												}
											} else {
												<span class="text-muted text-xs">0%</span>
											}
										</td>
										<td>
											if st.IsNegotiable {
												<span class="badge badge-amber font-black text-xs px-2 py-0.5">قابل للتفاوض</span>
											} else {
												<span class="badge badge-slate text-xs px-2 py-0.5">سعر ثابت</span>
											}
										</td>
										<td class="tabular-nums">
											if st.Quantity > st.MinThreshold {
												<strong class="text-base text-primary font-black">{ fmt.Sprintf("%d", st.Quantity) }</strong>
											} else if st.Quantity > 0 {
												<strong class="text-base text-warning font-black">{ fmt.Sprintf("%d", st.Quantity) }</strong>
											} else {
												<strong class="text-base text-danger font-black">{ fmt.Sprintf("%d", st.Quantity) }</strong>
											}
										</td>
										<td class="tabular-nums text-muted text-sm">
											{ fmt.Sprintf("%d", st.MinThreshold) }
										</td>
										<td>
											if st.Quantity > st.MinThreshold {
												<span class="badge badge-emerald font-black">متوفر</span>
											} else if st.Quantity > 0 {
												<span class="badge badge-amber font-black">رصيد منخفض</span>
											} else {
												<span class="badge badge-rose font-black">نفد</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Pagination Footer -->
					<div class="p-4 border-t bg-surface">
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.CurrentPage,
							PageSize:    data.PageSize,
							TotalCount:  data.TotalCount,
							BaseURL:     fmt.Sprintf("/admin/warehouses/%d", data.Warehouse.ID),
							QueryValues: data.QueryValues,
						})
					</div>
				}
			</div>

		</div>
	}
}
