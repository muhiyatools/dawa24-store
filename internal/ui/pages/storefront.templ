package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func sectionTypeLabel(t string) string {
	switch t {
	case "vision":
		return "رؤيتنا (Our Vision)"
	case "goals":
		return "أهدافنا (Our Goals)"
	case "about":
		return "حولنا (About Us)"
	case "why_us":
		return "لماذا نحن (Why Choose Us)"
	case "features":
		return "الميزات (Features)"
	case "services":
		return "الخدمات (Services)"
	case "achievements":
		return "الإنجازات (Achievements)"
	case "certifications":
		return "الشهادات والاعتمادات (Certifications)"
	case "stats":
		return "إحصائيات (Stats)"
	case "special_info":
		return "معلومات خاصة (Special Info)"
	default:
		return "قسم تعريفي عام"
	}
}

func sectionTypeIcon(t string) string {
	switch t {
	case "vision", "goals":
		return "🎯"
	case "about":
		return "🏢"
	case "why_us":
		return "⭐"
	case "features":
		return "✨"
	case "services":
		return "🛠️"
	case "achievements":
		return "🏆"
	case "certifications":
		return "📜"
	case "stats":
		return "📊"
	case "special_info":
		return "💡"
	default:
		return "📌"
	}
}

templ VendorStorefront(lang, dir string, sections []*promo.HighlightSection) {
	@layouts.VendorShell("الأقسام المميزة وواجهة المتجر", "storefront", lang, dir) {
		<div
			class="page-container"
			style="max-width: 1100px; margin: 0 auto;"
			x-data="{
				isModalOpen: false,
				modalMode: 'add',
				currentSection: {
					id: 0,
					title_ar: '',
					title_en: '',
					description_ar: '',
					description_en: '',
					display_order: 0,
					color: '#0284c7',
					is_active: true,
					show_in_header: true
				},
				openAddModal() {
					this.modalMode = 'add';
					this.currentSection = {
						id: 0,
						title_ar: '',
						title_en: '',
						description_ar: '',
						description_en: '',
						display_order: 0,
						color: '#0284c7',
						is_active: true,
						show_in_header: true
					};
					this.isModalOpen = true;
				}
			}"
		>
			
			<!-- Header Card -->
			<div class="glass-panel p-6 mb-0">
				<div class="flex-between items-center flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								🌟
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								الأقسام المميزة ونبذة المنشأة
							</h1>
						</div>
						<p class="text-xs text-secondary m-0">
							تخصيص الأقسام التعريفية (رؤيتنا، أهدافنا، حولنا، الشهادات، والمميزات) التي تظهر على بروفايلك العام للمنشأة أمام الصيدليات.
						</p>
					</div>

					<button type="button" @click="openAddModal()" class="btn btn-primary font-bold text-xs px-4 py-2 gap-2">
						@components.IconPlus("icon-xs")
						<span>إضافة قسم تعريفي جديد</span>
					</button>
				</div>
			</div>

			<!-- List of Current Sections -->
			<div class="glass-panel p-6 mb-0">
				<div class="flex-between items-center pb-3 mb-4 border-b">
					<div class="d-flex items-center gap-2">
						<span class="text-lg">📑</span>
						<h2 class="text-base font-black text-primary m-0">
							الأقسام المميزة الحالية بالمنشأة
						</h2>
					</div>
					<span class="badge badge-sky text-xs font-bold tabular-nums">{ fmt.Sprintf("%d أقسام مسجلة", len(sections)) }</span>
				</div>

				if len(sections) == 0 {
					<div class="p-12 text-center empty-state-glass">
						<div class="text-4xl mb-3">📋</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد أقسام مميزة بعد</h3>
						<p class="text-xs text-secondary max-w-md mx-auto mb-4">
							قم بإضافة أقسام تعريفية كـ "رؤيتنا"، "شهادات الاعتماد"، أو "خدماتنا" لتظهر بأزرار تفاعلية أنيقة على بروفايلك العام أمام الصيدليات.
						</p>
						<button type="button" @click="openAddModal()" class="btn btn-primary btn-sm font-bold text-xs">
							@components.IconPlus("icon-xs")
							<span>إضافة أول قسم الآن</span>
						</button>
					</div>
				} else {
					<div class="d-flex flex-col gap-3">
						for _, s := range sections {
							<div class="p-4 bg-surface-sunken border rounded-xl d-flex flex-col gap-3">
								<div class="flex-between items-center flex-wrap gap-3">
									<div class="d-flex items-center gap-3">
										<span class="text-2xl">{ sectionTypeIcon(s.SectionType) }</span>
										<div>
											<div class="d-flex items-center gap-2 flex-wrap">
												<strong class="text-primary text-sm font-extrabold">
													{ s.Title.Get(i18n.Lang(lang)) }
												</strong>
												if s.IsActive {
													<span class="badge badge-emerald text-xs font-bold">نشط ومعروض</span>
												} else {
													<span class="badge badge-rose text-xs font-bold">معطل</span>
												}
											</div>
											<div class="text-xs text-muted tabular-nums mt-0.5">
												الترتيب: { fmt.Sprintf("%d", s.DisplayOrder) }
												if s.ShowInHeader {
													<span> • معروض في ترويسة البروفايل</span>
												}
											</div>
										</div>
									</div>

									<!-- Action Buttons -->
									<div class="d-flex items-center gap-2">
										<!-- Edit Modal Trigger Button -->
										<button
											type="button"
											class="btn btn-secondary btn-sm font-bold text-xs gap-1"
											@click={ fmt.Sprintf("modalMode = 'edit'; currentSection = { id: %d, title_ar: %q, title_en: %q, description_ar: %q, description_en: %q, display_order: %d, color: %q, is_active: %t, show_in_header: %t }; isModalOpen = true;", s.ID, s.Title.Get(i18n.AR), s.Title.Get(i18n.EN), s.Description.Get(i18n.AR), s.Description.Get(i18n.EN), s.DisplayOrder, s.Color, s.IsActive, s.ShowInHeader) }
										>
											@components.IconEdit("icon-xs")
											<span>تعديل</span>
										</button>

										<!-- Toggle Status Form -->
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/storefront/section/%d/toggle", s.ID)) } class="m-0">
											<button type="submit" class="btn btn-secondary btn-sm font-bold text-xs">
												if s.IsActive {
													<span>تعطيل</span>
												} else {
													<span>تفعيل</span>
												}
											</button>
										</form>

										<!-- Delete Form -->
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/storefront/section/%d/delete", s.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا القسم المميز؟');">
											<button type="submit" class="btn btn-secondary btn-sm btn-icon text-danger" title="حذف القسم">
												@components.IconTrash("icon-xs")
											</button>
										</form>
									</div>
								</div>

								<!-- Content Snippet Preview -->
								if s.Description.Get(i18n.Lang(lang)) != "" {
									<div class="text-xs text-secondary p-3 bg-surface-raised border rounded-lg line-clamp-3">
										{ s.Description.Get(i18n.Lang(lang)) }
									</div>
								}
							</div>
						}
					</div>
				}
			</div>

			<!-- Unified Add / Edit Section Modal (Fixed Centered Overlay) -->
			<div
				x-show="isModalOpen"
				x-cloak
				x-transition.opacity
				style="position: fixed; inset: 0; z-index: 99999; display: flex; align-items: center; justify-content: center; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); padding: 1.5rem;"
				@keydown.escape.window="isModalOpen = false"
			>
				<div
					@click.outside="isModalOpen = false"
					class="glass-panel p-6 w-full"
					style="max-width: 620px; max-height: 90vh; overflow-y: auto;"
				>
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<span class="text-xl">🌟</span>
							<h3 class="text-lg font-black text-primary m-0" x-text="modalMode === 'add' ? 'إضافة قسم مميز جديد للبروفايل' : 'تعديل بيانات القسم المميز'"></h3>
						</div>
						<button type="button" @click="isModalOpen = false" class="btn btn-secondary btn-icon btn-sm">✕</button>
					</div>

					<form :action="modalMode === 'add' ? '/vendor/storefront/section' : '/vendor/storefront/section/' + currentSection.id" method="POST" class="d-flex flex-col gap-4 m-0">
						<input type="hidden" name="section_type" value="about" />

						<!-- Titles -->
						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">العنوان (بالعربية) <span class="text-danger">*</span></label>
								<input type="text" name="title_ar" x-model="currentSection.title_ar" required placeholder="مثال: رؤيتنا للتميز الدوائي" class="form-input text-xs w-full" />
							</div>
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">العنوان (بالإنجليزية)</label>
								<input type="text" name="title_en" x-model="currentSection.title_en" placeholder="e.g. Our Vision" class="form-input text-xs w-full" dir="ltr" />
							</div>
						</div>

						<!-- Order & Color -->
						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">ترتيب العرض</label>
								<input type="number" name="display_order" x-model.number="currentSection.display_order" min="0" class="form-input text-xs tabular-nums w-full" />
							</div>

							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">اللون المميز</label>
								<select name="color" x-model="currentSection.color" class="form-input text-xs w-full">
									<option value="#0284c7">أزرق سماوي (Sky Blue)</option>
									<option value="#10b981">أخضر زمردي (Emerald Green)</option>
									<option value="#6366f1">نيلي موحد (Indigo)</option>
									<option value="#8b5cf6">بنفسجي ملكي (Purple)</option>
									<option value="#f59e0b">كهرماني (Amber)</option>
									<option value="#ec4899">وردي عصري (Pink)</option>
								</select>
							</div>
						</div>

						<!-- Descriptions -->
						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">المحتوى والوصف (بالعربية) <span class="text-danger">*</span></label>
								<textarea name="description_ar" x-model="currentSection.description_ar" rows="4" required placeholder="اكتب نبذة مفصلة عن رؤية الشركة، معايير التخزين، شهادات الجودة..." class="form-input text-xs w-full" style="resize:vertical;"></textarea>
							</div>
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">المحتوى والوصف (بالإنجليزية)</label>
								<textarea name="description_en" x-model="currentSection.description_en" rows="4" placeholder="Detailed content and description in English..." class="form-input text-xs w-full" dir="ltr" style="resize:vertical;"></textarea>
							</div>
						</div>

						<!-- Toggles -->
						<div class="d-flex items-center gap-4 py-1 flex-wrap">
							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_active" value="true" x-model="currentSection.is_active" class="form-checkbox" />
								<span>القسم نشط ومفعل</span>
							</label>

							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="show_in_header" value="true" x-model="currentSection.show_in_header" class="form-checkbox" />
								<span>إظهار في رأس بروفايل المورد العام</span>
							</label>
						</div>

						<div class="flex-between items-center gap-3 pt-3 border-t mt-2">
							<button type="button" class="btn btn-secondary text-xs font-bold" @click="isModalOpen = false">إلغاء</button>
							<button type="submit" class="btn btn-primary text-xs font-black px-6" x-text="modalMode === 'add' ? 'حفظ ونشر القسم المميز' : 'تحديث وحفظ التعديلات'"></button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}
