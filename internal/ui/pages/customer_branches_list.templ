package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerBranchesList(data CustomerBranchesData, lang string) {
	<!-- Existing Pharmacy Branches List -->
	<div class="glass-panel p-5">
		<div class="d-flex items-center justify-between flex-wrap gap-2 pb-3 mb-3 border-b">
			<div class="d-flex items-center gap-2 font-bold text-sm text-primary">
				@components.IconBuilding("icon-xs")
				<span>{ i18n.T(lang, "branches.title") }</span>
			</div>
			<span class="badge badge-sky text-2xs font-bold tabular-nums">{ fmt.Sprintf("%d", len(data.Branches)) }</span>
		</div>

		if len(data.Branches) == 0 {
			<div class="p-6 text-center">
				<div class="mb-2 text-2xl text-muted">@components.IconBuilding("icon-md")</div>
				<h3 class="font-bold text-sm text-primary mb-1">{ i18n.T(lang, "branches.empty_title") }</h3>
				<p class="text-xs text-secondary m-0">{ i18n.T(lang, "branches.empty_desc") }</p>
			</div>
		} else {
			<div class="d-flex flex-col gap-3">
				for _, b := range data.Branches {
					<div class="cb-branch-card">
						<div class="d-flex items-start justify-between gap-3">
							<div>
								<div class="d-flex items-center gap-2 flex-wrap mb-1">
									<strong class="text-sm font-bold text-primary">
										if lang == "en" && b.Name["en"] != "" {
											{ b.Name["en"] }
										} else if b.Name["ar"] != "" {
											{ b.Name["ar"] }
										} else {
											{ b.Name["en"] }
										}
									</strong>
									if b.IsMain {
										<span class="badge badge-emerald text-2xs font-bold">{ i18n.T(lang, "branches.active_badge") }</span>
									}
									if b.Status == "inactive" {
										<span class="badge badge-slate text-2xs">{ i18n.T(lang, "common.inactive") }</span>
									} else {
										<span class="badge badge-emerald text-2xs">{ i18n.T(lang, "common.active") }</span>
									}
								</div>
								if b.Code != "" {
									<span class="badge badge-slate tabular-nums text-2xs">كود: { b.Code }</span>
								}
							</div>

							<div class="d-flex items-center gap-1">
								<!-- Edit Branch Button -->
								<button
									type="button"
									class="btn btn-secondary btn-xs font-bold gap-1"
									data-edit-branch-btn={ fmt.Sprintf("%d", b.ID) }
									data-branch-data={ formatCustomerBranchJSON(b, data.Cities) }
									@click="setEditModeFromElement($el)"
								>
									@components.IconEdit("icon-xs")
									<span>{ i18n.T(lang, "common.edit") }</span>
								</button>

								<!-- Assign staff to this branch -->
								<a
									href={ templ.SafeURL(fmt.Sprintf("/customer/team?branch=%d", b.ID)) }
									class="btn btn-secondary btn-xs font-bold gap-1"
									title={ i18n.T(lang, "team.title") }
								>
									@components.IconUsers("icon-xs")
									<span>{ i18n.T(lang, "nav.team") }</span>
								</a>

								<!-- Delete Branch Button -->
								if !b.IsMain {
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/branches/%d/delete", b.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الفرع؟');">
										<button type="submit" class="btn btn-secondary btn-xs text-danger" title={ i18n.T(lang, "common.delete") }>
											@components.IconTrash("icon-xs")
										</button>
									</form>
								}
							</div>
						</div>

						<div class="d-flex flex-col gap-1 text-xs text-secondary">
							if b.Address != "" {
								<div><span class="text-muted">{ i18n.T(lang, "branches.address") }: </span><strong class="text-primary">{ b.Address }</strong></div>
							}
							if b.Phone != "" {
								<div><span class="text-muted">{ i18n.T(lang, "branches.phone") }: </span><strong class="tabular-nums text-primary">{ b.Phone }</strong></div>
							}
							if b.OperatingHours != "" {
								<div><span class="text-muted">{ i18n.T(lang, "branches.operating_hours") }: </span><strong class="tabular-nums">{ b.OperatingHours }</strong></div>
							}
						</div>

						<!-- Institutional Works Tags -->
						if len(b.InstitutionalWorks) > 0 {
							<div class="d-flex flex-col gap-1 pt-2 pb-2">
								<div class="text-xs font-bold text-muted uppercase mb-1">
									{ i18n.T(lang, "branches.institutional_works") }:
								</div>
								<div class="d-flex flex-wrap gap-1">
									for _, cat := range b.InstitutionalWorks {
										<span class="badge badge-slate text-2xs font-bold">
											{ data.WorkLabel(cat) }
										</span>
									}
								</div>
							</div>
						}

						<!-- Badges Strip: Cold Storage & Staff Count -->
						<div class="d-flex items-center justify-between flex-wrap gap-2 pt-2 border-t text-xs">
							<div class="d-flex items-center gap-1 flex-wrap">
								if b.HasColdStorage {
									<span class="badge badge-sky text-2xs font-bold">{ i18n.T(lang, "branches.cold_storage") }</span>
								}
							</div>

							<div class="d-flex items-center gap-2">
								<!-- Assigned Staff Pill -->
								<span class="badge badge-secondary text-2xs font-bold">
									{ fmt.Sprintf(i18n.T(lang, "branches.staff_count"), data.BranchStaffCount(b.ID)) }
								</span>

								<!-- Google Maps Link -->
								if b.GoogleMapsURL != "" {
									<a href={ templ.SafeURL(b.GoogleMapsURL) } target="_blank" rel="noopener" class="text-primary font-bold text-xs text-decoration-none">
										{ i18n.T(lang, "branches.map_link") } ↗
									</a>
								} else if b.Latitude != nil && b.Longitude != nil {
									<a href={ templ.SafeURL(fmt.Sprintf("https://www.google.com/maps?q=%f,%f", *b.Latitude, *b.Longitude)) } target="_blank" rel="noopener" class="text-primary font-bold text-xs text-decoration-none">
										{ i18n.T(lang, "branches.map_link") } ↗
									</a>
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>
}