package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// CategoryViewItem holds a category and its linked product count.
type CategoryViewItem struct {
	Category     *catalog.Category
	ProductCount int
}

func getParentCategoryName(parentID *int64, allCategories []*catalog.Category) string {
	if parentID != nil && *parentID > 0 {
		for _, c := range allCategories {
			if c != nil && c.ID == *parentID {
				name := c.Name.Get("ar")
				if name == "" {
					name = c.Name.Get("en")
				}
				if name != "" {
					return name
				}
			}
		}
	}
	return ""
}

func buildAdminCategoriesPageURL(page, limit int, q, status string) string {
	u := fmt.Sprintf("/admin/categories?page=%d&limit=%d", page, limit)
	if q != "" {
		u += "&q=" + url.QueryEscape(q)
	}
	if status != "" && status != "all" {
		u += "&status=" + url.QueryEscape(status)
	}
	return u
}

templ AdminCategoriesPage(categories []CategoryViewItem, allCategories []*catalog.Category, totalCount, currentPage, pageSize int, searchQuery, statusFilter, lang, dir string) {
	@layouts.AdminShell("فئات المنتجات", "categories", lang, dir) {
		<div class="page-container">
			
			<!-- Page Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconFolder("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">فئات المنتجات والتصنيفات المركزية</h1>
							<p class="text-sm text-secondary m-0 mt-1">إدارة الشجرة التصنيفية للأصناف الدوائية والطبية، وتحديد الفئات الرئيسية والفرعية المعتمدة ({ fmt.Sprintf("%d فئة", totalCount) })</p>
						</div>
					</div>

					<div class="d-flex items-center gap-2">
						<button
							type="button"
							class="btn btn-primary font-bold text-xs px-3 py-2"
							data-modal-open="create-category-modal"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة فئة جديدة +</span>
						</button>
					</div>
				</div>
			</div>

			<div class="glass-panel p-6 mb-6">
				<!-- Search and Filter Bar -->
				<form
					method="GET"
					action="/admin/categories"
					class="d-flex gap-3 items-center flex-wrap mb-6"
				>
					<div class="flex-1">
						<input
							type="text"
							name="q"
							value={ searchQuery }
							placeholder="ابحث باسم الفئة بالعربية أو الإنجليزية..."
							class="form-input text-xs w-full"
						/>
					</div>

					<div>
						<select name="status" class="form-select text-xs w-full" onchange="this.form.submit()">
							<option value="all" selected?={ statusFilter == "" || statusFilter == "all" }>جميع الحالات</option>
							<option value="active" selected?={ statusFilter == "active" }>نشط ومفعل (Active)</option>
							<option value="inactive" selected?={ statusFilter == "inactive" }>معطل (Inactive)</option>
						</select>
					</div>

					<div>
						<select name="limit" class="form-select text-xs w-full" onchange="this.form.submit()">
							<option value="25" selected?={ pageSize == 25 }>25 فئة لكل صفحة</option>
							<option value="50" selected?={ pageSize == 50 }>50 فئة لكل صفحة</option>
							<option value="100" selected?={ pageSize == 100 }>100 فئة لكل صفحة</option>
							<option value="200" selected?={ pageSize == 200 }>200 فئة لكل صفحة</option>
						</select>
					</div>

					<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-3">
						تصفية
					</button>
					if searchQuery != "" || (statusFilter != "" && statusFilter != "all") {
						<a href="/admin/categories" class="btn btn-secondary btn-sm text-xs">
							إعادة تعيين
						</a>
					}
				</form>

				<!-- Categories Table Card -->
				if len(categories) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconFolder("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد فئات مطابقة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يتم العثور على أي نتائج وفق معايير البحث الحالية. اضغط على إضافة فئة جديدة للبدء.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>#</th>
									<th>اسم الفئة</th>
									<th>الفئة الأب (Parent)</th>
									<th>الوصف</th>
									<th>الأصناف المرتبطة</th>
									<th>ترتيب</th>
									<th>الحالة</th>
									<th>الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range categories {
									{{ c := item.Category }}
									{{ parentName := getParentCategoryName(c.ParentID, allCategories) }}
									<tr id={ fmt.Sprintf("category-row-%d", c.ID) }>
										<td class="tabular-nums">
											#{ fmt.Sprintf("%d", c.ID) }
										</td>
										<td>
											<div class="fw-800 text-primary text-base">
												{ c.Name.Get("ar") }
											</div>
											if c.Name.Get("en") != "" {
												<div>
													{ c.Name.Get("en") }
												</div>
											}
										</td>
										<td>
											if parentName != "" {
												<span class="badge badge-slate fw-700">
													{ parentName }
												</span>
											} else {
												<span>-- رئيسية (مستوى أول) --</span>
											}
										</td>
										<td>
											if c.Description.Get("ar") != "" {
												<div>
													{ c.Description.Get("ar") }
												</div>
											} else if c.Description.Get("en") != "" {
												<div>
													{ c.Description.Get("en") }
												</div>
											} else {
												<span class="text-sm text-muted">لا يوجد وصف</span>
											}
										</td>
										<td class="text-center">
											<a
												href={ templ.SafeURL(fmt.Sprintf("/admin/products?category_id=%d", c.ID)) }
												class="badge badge-indigo fw-700"
											
												title="عرض كافة أصناف هذه الفئة"
											>
												@components.IconLayers("icon-xs")
												<span class="tabular-nums">{ fmt.Sprintf("%d صنف", item.ProductCount) }</span>
											</a>
										</td>
										<td class="tabular-nums fw-600 text-center">
											{ fmt.Sprintf("%d", c.SortOrder) }
										</td>
										<td class="text-center">
											if c.Status == "active" || c.Status == "" {
												<span class="badge badge-emerald fw-700">نشط</span>
											} else {
												<span class="badge badge-slate fw-700">معطل</span>
											}
										</td>
										<td class="text-end">
											<div>
												<button
													type="button"
													class="btn btn-secondary btn-icon size-8"
													data-modal-open={ fmt.Sprintf("edit-category-modal-%d", c.ID) }
												
													title="تعديل بيانات الفئة"
												>
													@components.IconEdit("icon-xs")
												</button>

												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/categories/%d/toggle", c.ID)) } class="m-0">
													if c.Status == "active" || c.Status == "" {
														<button type="submit" class="btn btn-secondary btn-icon" title="تعطيل الفئة">
															@components.IconMinus("icon-xs")
														</button>
													} else {
														<button type="submit" class="btn btn-secondary btn-icon" title="تفعيل الفئة">
															@components.IconCheck("icon-xs")
														</button>
													}
												</form>

												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/categories/%d/delete", c.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف فئة المنتجات هذه؟');">
													<button type="submit" class="btn btn-secondary btn-icon" title="حذف الفئة">
														@components.IconTrash("icon-xs")
													</button>
												</form>

												<!-- Edit Category Modal -->
												@components.Modal(components.ModalProps{
													ID:    fmt.Sprintf("edit-category-modal-%d", c.ID),
													Title: fmt.Sprintf("تعديل فئة: %s", c.Name.Get("ar")),
													Size:  "md",
												}) {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/categories/%d/edit", c.ID)) }>
														<div class="form-grid-2">
															<div class="form-group m-0">
																<label class="form-label">اسم الفئة (عربي) *</label>
																<input type="text" name="name_ar" value={ c.Name.Get("ar") } required class="form-input" />
															</div>
															<div class="form-group m-0">
																<label class="form-label">اسم الفئة (إنجليزي)</label>
																<input type="text" name="name_en" value={ c.Name.Get("en") } class="form-input" dir="ltr" />
															</div>
														</div>

														<div class="form-grid-2">
															<div class="form-group m-0">
																<label class="form-label">الفئة الأب (Parent Category)</label>
																<select name="parent_id" class="form-select">
																	<option value="" selected?={ c.ParentID == nil || *c.ParentID <= 0 }>-- فئة رئيسية (مستوى أول / بدون فئة أب) --</option>
																	for _, other := range allCategories {
																		if other != nil && other.ID != c.ID {
																			<option value={ fmt.Sprintf("%d", other.ID) } selected?={ c.ParentID != nil && *c.ParentID == other.ID }>
																				{ other.Name.Get("ar") }
																				if other.Name.Get("en") != "" {
																					({ other.Name.Get("en") })
																				}
																			</option>
																		}
																	}
																</select>
															</div>
															<div class="form-group m-0">
																<label class="form-label">الحالة *</label>
																<select name="status" class="form-select">
																	<option value="active" selected?={ c.Status == "active" || c.Status == "" }>نشط (Active)</option>
																	<option value="inactive" selected?={ c.Status == "inactive" }>معطل (Inactive)</option>
																</select>
															</div>
														</div>

														<div class="form-grid-2">
															<div class="form-group m-0">
																<label class="form-label">الوصف (عربي)</label>
																<textarea name="description_ar" rows="2" class="form-input" placeholder="وصف الفئة ونطاق الأصناف التابعة لها...">{ c.Description.Get("ar") }</textarea>
															</div>
															<div class="form-group m-0">
																<label class="form-label">الوصف (إنجليزي)</label>
																<textarea name="description_en" rows="2" class="form-input" dir="ltr" placeholder="Category description...">{ c.Description.Get("en") }</textarea>
															</div>
														</div>

														<div class="form-group m-0">
															<label class="form-label">ترتيب العرض</label>
															<input type="number" name="sort_order" value={ fmt.Sprintf("%d", c.SortOrder) } class="form-input" min="0" />
														</div>

														<div class="modal-footer-standard">
															<button
																type="button"
																class="btn btn-secondary"
																data-modal-close={ fmt.Sprintf("edit-category-modal-%d", c.ID) }
															>
																إلغاء
															</button>
															<button type="submit" class="btn btn-primary fw-800">
																@components.IconCheck("icon-xs")
																<span>حفظ التعديلات</span>
															</button>
														</div>
													</form>
												}

											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Pagination Controls -->
					if totalCount > 0 {
						<div>
							<div>
								{ fmt.Sprintf("عرض %d - %d من إجمالي %d فئة منتجات", minInt((currentPage-1)*pageSize+1, totalCount), minInt(currentPage*pageSize, totalCount), totalCount) }
							</div>

							<!-- Page navigation numbers -->
							<div>
								if currentPage > 1 {
									<a
										href={ templ.SafeURL(buildAdminCategoriesPageURL(1, pageSize, searchQuery, statusFilter)) }
										class="btn btn-secondary btn-sm"
									
										title="الصفحة الأولى"
									>
										«
									</a>
									<a
										href={ templ.SafeURL(buildAdminCategoriesPageURL(currentPage-1, pageSize, searchQuery, statusFilter)) }
										class="btn btn-secondary btn-sm"
									
									>
										السابق
									</a>
								}

								for _, pNum := range calculateAdminPageNumbers(currentPage, totalPages(totalCount, pageSize)) {
									if pNum == currentPage {
										<span
											class="btn btn-primary btn-sm"
										
										>
											{ fmt.Sprintf("%d", pNum) }
										</span>
									} else {
										<a
											href={ templ.SafeURL(buildAdminCategoriesPageURL(pNum, pageSize, searchQuery, statusFilter)) }
											class="btn btn-secondary btn-sm"
										
										>
											{ fmt.Sprintf("%d", pNum) }
										</a>
									}
								}

								if currentPage < totalPages(totalCount, pageSize) {
									<a
										href={ templ.SafeURL(buildAdminCategoriesPageURL(currentPage+1, pageSize, searchQuery, statusFilter)) }
										class="btn btn-secondary btn-sm"
									
									>
										التالي
									</a>
									<a
										href={ templ.SafeURL(buildAdminCategoriesPageURL(totalPages(totalCount, pageSize), pageSize, searchQuery, statusFilter)) }
										class="btn btn-secondary btn-sm"
									
										title="الصفحة الأخيرة"
									>
										»
									</a>
								}
							</div>
						</div>
					}
				}
			</div>

		</div>

		<!-- Create Category Modal -->
		@components.Modal(components.ModalProps{
			ID:    "create-category-modal",
			Title: "إضافة فئة منتجات جديدة",
			Size:  "md",
		}) {
			<form method="POST" action="/admin/categories/new">
				<div class="form-grid-2">
					<div class="form-group m-0">
						<label class="form-label">اسم الفئة (عربي) *</label>
						<input type="text" name="name_ar" required class="form-input" placeholder="مثال: أدوية القلب والأوعية الدموية" />
					</div>
					<div class="form-group m-0">
						<label class="form-label">اسم الفئة (إنجليزي)</label>
						<input type="text" name="name_en" class="form-input" dir="ltr" placeholder="Cardiovascular Drugs" />
					</div>
				</div>

				<div class="form-grid-2">
					<div class="form-group m-0">
						<label class="form-label">الفئة الأب (Parent Category)</label>
						<select name="parent_id" class="form-select">
							<option value="" selected>-- فئة رئيسية (مستوى أول / بدون فئة أب) --</option>
							for _, cat := range allCategories {
								if cat != nil && (cat.Status == "active" || cat.Status == "") {
									<option value={ fmt.Sprintf("%d", cat.ID) }>
										{ cat.Name.Get("ar") }
										if cat.Name.Get("en") != "" {
											({ cat.Name.Get("en") })
										}
									</option>
								}
							}
						</select>
					</div>
					<div class="form-group m-0">
						<label class="form-label">الحالة *</label>
						<select name="status" class="form-select">
							<option value="active" selected>نشط (Active)</option>
							<option value="inactive">معطل (Inactive)</option>
						</select>
					</div>
				</div>

				<div class="form-grid-2">
					<div class="form-group m-0">
						<label class="form-label">الوصف (عربي)</label>
						<textarea name="description_ar" rows="2" class="form-input" placeholder="وصف وتفاصيل فئة الأصناف..."></textarea>
					</div>
					<div class="form-group m-0">
						<label class="form-label">الوصف (إنجليزي)</label>
						<textarea name="description_en" rows="2" class="form-input" dir="ltr" placeholder="Description in English..."></textarea>
					</div>
				</div>

				<div class="form-group m-0">
					<label class="form-label">ترتيب العرض</label>
					<input type="number" name="sort_order" value="0" class="form-input" min="0" />
				</div>

				<div class="modal-footer-standard">
					<button
						type="button"
						class="btn btn-secondary"
						data-modal-close="create-category-modal"
					>
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary fw-800">
						@components.IconCheck("icon-xs")
						<span>إنشاء فئة المنتج</span>
					</button>
				</div>
			</form>
		}

	}
}
