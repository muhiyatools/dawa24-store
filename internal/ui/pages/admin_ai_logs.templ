package pages

import (
	"fmt"
	"net/url"
	"time"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminAILogItem represents one enriched row in the admin AI audit ledger.
type AdminAILogItem struct {
	ID             int64
	OrganizationID int64
	OrgName        string
	OrgType        string
	UserID         int64
	Capability     string
	Feature        string
	FeatureName    string
	Model          string
	RequestID      string
	InputTokens    int
	OutputTokens   int
	TotalTokens    int
	CostUSD        float64
	CostKnown      bool
	DurationMS     int
	Status         string
	StatusLabel    string
	FinishReason   string
	ErrorMessage   string
	FromCache      bool
	Fallback       bool
	CreatedAt      time.Time
}

// AdminAILogsData contains data for rendering the system-wide AI usage page.
type AdminAILogsData struct {
	Logs          []AdminAILogItem
	Organizations []*org.Organization
	TotalRequests int
	TotalTokens   int64
	TotalCostUSD  float64
	SuccessCount  int
	FailedCount   int
	CachedCount   int
	FallbackCount int
	SuccessRate   float64
	FilterOrgID   int64
	FilterFeature string
	FilterModel   string
	FilterStatus  string
	FilterSearch  string
	DateFrom      string
	DateTo        string
	Page          int
	PerPage       int
	TotalCount    int
}

templ AdminAILogsPage(data AdminAILogsData, lang, dir string) {
	@layouts.AdminShell("سجلات استهلاك الذكاء الاصطناعي", "ai_logs", lang, dir) {
		<div class="page-container">
			<!-- Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl bg-accent-soft text-accent">
							@components.IconSparkles("icon-sm")
						</div>
						<div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">سجلات استهلاك الذكاء الاصطناعي (AI Audit Ledger)</h1>
							<p class="text-sm text-secondary m-0 mt-1">
								مراقبة استهلاك النماذج الذكية والتوكنز عبر كافة الصيدليات والموردين والتحقق من التكلفة ومعدلات النجاح بدقة.
							</p>
						</div>
					</div>
					<div class="d-flex items-center gap-2">
						<a href="/admin/ai-logs" class="btn btn-secondary btn-sm font-bold">
							@components.IconActivity("icon-xs")
							<span>تحديث السجلات</span>
						</a>
						<a href="/admin/developers?tab=ai" class="btn btn-ghost btn-sm font-bold text-accent">
							@components.IconSettings("icon-xs")
							<span>إعدادات البوابة والـ AI</span>
						</a>
					</div>
				</div>
			</div>

			<!-- KPI Summary Strip -->
			<div class="d-grid grid-auto-fit-sm gap-4 mb-6">
				<!-- Total Requests -->
				<div class="glass-panel p-4 mb-0">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">إجمالي استدعاءات AI</span>
						<span class="text-accent">@components.IconZap("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-primary mt-2">
						{ fmt.Sprintf("%d", data.TotalRequests) }
					</div>
					<span class="text-2xs text-secondary mt-1 d-block">عبر كافة العمليات والمنشآت</span>
				</div>

				<!-- Total Tokens -->
				<div class="glass-panel p-4 mb-0">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">إجمالي التوكنز</span>
						<span class="text-sky">@components.IconLayers("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-sky mt-2">
						{ fmt.Sprintf("%d", data.TotalTokens) }
					</div>
					<span class="text-2xs text-secondary mt-1 d-block">مدخلات ومخرجات النماذج</span>
				</div>

				<!-- Total Cost USD -->
				<div class="glass-panel p-4 mb-0">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">التكلفة التقديرية</span>
						<span class="text-emerald">@components.IconCreditCard("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-emerald mt-2">
						{ fmt.Sprintf("$%.4f", data.TotalCostUSD) }
					</div>
					<span class="text-2xs text-secondary mt-1 d-block">محسوبة بالدولار الأمريكي</span>
				</div>

				<!-- Success Rate -->
				<div class="glass-panel p-4 mb-0">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">معدل النجاح</span>
						<span class="text-emerald">@components.IconCheckCircle("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-emerald mt-2">
						if data.TotalRequests > 0 {
							{ fmt.Sprintf("%.1f%%", data.SuccessRate) }
						} else {
							<span>100%</span>
						}
					</div>
					<span class="text-2xs text-secondary mt-1 d-block">
						{ fmt.Sprintf("%d ناجح • %d فاشل", data.SuccessCount, data.FailedCount) }
					</span>
				</div>

				<!-- Cache & Fallback -->
				<div class="glass-panel p-4 mb-0">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">التوفير والبدائل</span>
						<span class="text-purple">@components.IconSparkles("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-purple mt-2">
						{ fmt.Sprintf("%d", data.CachedCount + data.FallbackCount) }
					</div>
					<span class="text-2xs text-secondary mt-1 d-block">
						{ fmt.Sprintf("%d كاش محلي • %d مسار احتياطي", data.CachedCount, data.FallbackCount) }
					</span>
				</div>
			</div>

			<!-- Filter Bar -->
			<div class="glass-panel p-5 mb-6">
				<form method="GET" action="/admin/ai-logs" class="m-0">
					<div class="d-flex flex-wrap items-end gap-3">
						<!-- Search Keyword -->
						<div class="form-group mb-0 flex-1 min-w-[200px]">
							<label class="form-label text-xs font-bold text-primary mb-1">بحث في السجلات</label>
							<input
								type="text"
								name="q"
								value={ data.FilterSearch }
								class="form-input text-xs w-full"
								placeholder="معرف الطلب، النموذج، الخطأ، أو الخاصية..."
							/>
						</div>

						<!-- Organization Filter -->
						<div class="form-group mb-0 min-w-[220px]">
							<label class="form-label text-xs font-bold text-primary mb-1">المنشأة (صيدلية / مورد)</label>
							<select name="org_id" class="form-select text-xs w-full">
								<option value="">كافة المنشآت والشركات</option>
								for _, o := range data.Organizations {
									<option
										value={ fmt.Sprintf("%d", o.ID) }
										selected?={ data.FilterOrgID == o.ID }
									>
										if o.Type == "vendor" {
											[مورد]
										} else {
											[صيدلية]
										}
										{" "}
										if o.LegalName != "" {
											{ o.LegalName }
										} else if !o.TradeName.IsEmpty() {
											{ o.TradeName.Get(i18n.Lang(lang)) }
										} else {
											منشأة #{ fmt.Sprintf("%d", o.ID) }
										}
									</option>
								}
							</select>
						</div>

						<!-- Feature Filter -->
						<div class="form-group mb-0 min-w-[150px]">
							<label class="form-label text-xs font-bold text-primary mb-1">الخاصية</label>
							<select name="feature" class="form-select text-xs w-full">
								<option value="">كافة الخصائص</option>
								<option value="smart_order" selected?={ data.FilterFeature == "smart_order" }>الطلب الذكي</option>
								<option value="variant_match" selected?={ data.FilterFeature == "variant_match" }>مطابقة الأصناف</option>
								<option value="savings" selected?={ data.FilterFeature == "savings" }>بدائل التوفير</option>
								<option value="assistant" selected?={ data.FilterFeature == "assistant" }>المساعد الآلي</option>
								<option value="voice_ocr" selected?={ data.FilterFeature == "voice_ocr" }>الصوت والـ OCR</option>
								<option value="column_detect" selected?={ data.FilterFeature == "column_detect" }>كشف الأعمدة</option>
							</select>
						</div>

						<!-- Status Filter -->
						<div class="form-group mb-0 min-w-[130px]">
							<label class="form-label text-xs font-bold text-primary mb-1">الحالة</label>
							<select name="status" class="form-select text-xs w-full">
								<option value="">كافة الحالات</option>
								<option value="success" selected?={ data.FilterStatus == "success" }>ناجح (Success)</option>
								<option value="timeout" selected?={ data.FilterStatus == "timeout" }>مهلة (Timeout)</option>
								<option value="quota_exceeded" selected?={ data.FilterStatus == "quota_exceeded" }>تجاوز الحصة</option>
								<option value="rate_limited" selected?={ data.FilterStatus == "rate_limited" }>تجاوز المعدل</option>
								<option value="unavailable" selected?={ data.FilterStatus == "unavailable" }>غير متاح</option>
							</select>
						</div>

						<!-- Date Range -->
						<div class="form-group mb-0 min-w-[130px]">
							<label class="form-label text-xs font-bold text-primary mb-1">من تاريخ</label>
							<input type="date" name="date_from" value={ data.DateFrom } class="form-input text-xs w-full" />
						</div>

						<div class="form-group mb-0 min-w-[130px]">
							<label class="form-label text-xs font-bold text-primary mb-1">إلى تاريخ</label>
							<input type="date" name="date_to" value={ data.DateTo } class="form-input text-xs w-full" />
						</div>

						<!-- Actions -->
						<div class="d-flex items-center gap-2">
							<button type="submit" class="btn btn-primary btn-sm font-bold">
								@components.IconFilter("icon-xs")
								<span>تصفية</span>
							</button>
							<a href="/admin/ai-logs" class="btn btn-ghost btn-sm text-secondary">
								إلغاء
							</a>
						</div>
					</div>
				</form>
			</div>

			<!-- Main Table Card -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(data.Logs) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد سجلات استهلاك مطابقة",
						Message: "لم يتم تسجيل أي عمليات استهلاك للذكاء الاصطناعي تطابق المعايير المحددة في البحث والفلاتر.",
					})
				} else {
					<div class="table-container m-0 overflow-x-auto">
						<table class="data-table data-table-compact m-0 w-full text-xs">
							<thead>
								<tr>
									<th class="w-[8%] text-center">المعرف</th>
									<th class="w-[14%]">التاريخ والوقت</th>
									<th class="w-[18%]">المنشأة</th>
									<th class="w-[14%]">الخاصية</th>
									<th class="w-[12%]">النموذج</th>
									<th class="w-[10%] text-center">التوكنز</th>
									<th class="w-[8%] text-center">المدة</th>
									<th class="w-[8%] text-center">التكلفة</th>
									<th class="w-[10%] text-center">الحالة</th>
									<th class="w-[6%] text-center col-actions">التفاصيل</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Logs {
									<tr>
										<!-- ID -->
										<td class="tabular-nums font-mono text-center text-muted">
											#{ fmt.Sprintf("%d", item.ID) }
										</td>

										<!-- Date & Time -->
										<td class="tabular-nums text-secondary">
											<div class="font-bold text-primary">{ item.CreatedAt.Format("2006-01-02") }</div>
											<div class="text-2xs text-muted">{ item.CreatedAt.Format("03:04:05 PM") }</div>
										</td>

										<!-- Organization -->
										<td>
											<div class="d-flex items-center gap-1.5">
												if item.OrgType == "vendor" {
													<span class="badge badge-purple text-2xs font-bold">مورد</span>
												} else {
													<span class="badge badge-sky text-2xs font-bold">صيدلية</span>
												}
												<span class="font-bold text-primary truncate max-w-[140px]" title={ item.OrgName }>
													{ item.OrgName }
												</span>
											</div>
											if item.UserID > 0 {
												<span class="text-2xs text-muted">مستخدم #{ fmt.Sprintf("%d", item.UserID) }</span>
											}
										</td>

										<!-- Feature -->
										<td>
											<div class="font-bold text-primary">{ item.FeatureName }</div>
											<span class="badge badge-slate text-2xs font-mono">{ item.Feature }</span>
										</td>

										<!-- Model -->
										<td>
											<span class="font-mono text-2xs text-secondary truncate max-w-[110px] d-block" title={ item.Model }>
												if item.Model != "" {
													{ item.Model }
												} else {
													<span class="text-muted">-</span>
												}
											</span>
										</td>

										<!-- Tokens -->
										<td class="text-center tabular-nums font-bold">
											<div class="text-primary">{ fmt.Sprintf("%d", item.TotalTokens) }</div>
											<div class="text-2xs text-muted">
												{ fmt.Sprintf("in: %d • out: %d", item.InputTokens, item.OutputTokens) }
											</div>
										</td>

										<!-- Duration -->
										<td class="text-center tabular-nums text-secondary">
											if item.DurationMS > 0 {
												{ fmt.Sprintf("%d ms", item.DurationMS) }
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Cost -->
										<td class="text-center tabular-nums font-bold">
											if item.CostKnown {
												<span class="text-emerald">{ fmt.Sprintf("$%.5f", item.CostUSD) }</span>
											} else {
												<span class="text-muted text-2xs">غير محدد</span>
											}
										</td>

										<!-- Status Badge -->
										<td class="text-center">
											if item.Fallback {
												<span class="badge badge-amber text-2xs font-bold">احتياطي</span>
											} else if item.FromCache {
												<span class="badge badge-cyan text-2xs font-bold">كاش محلي</span>
											} else if item.Status == "success" {
												<span class="badge badge-emerald text-2xs font-bold">ناجح</span>
											} else {
												<span class="badge badge-rose text-2xs font-bold" title={ item.ErrorMessage }>
													{ item.StatusLabel }
												</span>
											}
										</td>

										<!-- Details Modal Trigger -->
										<td class="col-actions text-center">
											<button
												type="button"
												class="btn btn-ghost btn-xs text-accent font-bold"
												@click={ fmt.Sprintf("$dispatch('open-modal', 'ai-log-detail-%d')", item.ID) }
												title="عرض تفاصيل الطلب التقنية"
											>
												@components.IconEye("icon-2xs")
											</button>

											<!-- Details Modal -->
											@AdminAILogDetailModal(item, dir)
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					if data.TotalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.TotalCount,
							BaseURL:     "/admin/ai-logs",
							QueryValues: url.Values{
								"org_id":    {fmt.Sprintf("%d", data.FilterOrgID)},
								"feature":   {data.FilterFeature},
								"model":     {data.FilterModel},
								"status":    {data.FilterStatus},
								"q":         {data.FilterSearch},
								"date_from": {data.DateFrom},
								"date_to":   {data.DateTo},
							},
						})
					}
				}
			</div>
		</div>
	}
}

templ AdminAILogDetailModal(item AdminAILogItem, dir string) {
	@components.Modal(components.ModalProps{
		ID:    fmt.Sprintf("ai-log-detail-%d", item.ID),
		Title: fmt.Sprintf("تفاصيل استدعاء الذكاء الاصطناعي #%d", item.ID),
		Size:  "md",
	}) {
		<div class="d-flex flex-col gap-4 text-start" dir={ dir }>
			<!-- Status Banner -->
			<div class="glass-panel p-3 mb-0 bg-surface-sunken rounded-xl flex-between items-center">
				<div class="stack-2xs">
					<span class="text-2xs text-muted">المنشأة المستفيدة</span>
					<strong class="text-xs text-primary">{ item.OrgName }</strong>
				</div>
				<div>
					if item.Status == "success" {
						<span class="badge badge-emerald font-bold text-xs">عملية ناجحة</span>
					} else {
						<span class="badge badge-rose font-bold text-xs">{ item.Status }</span>
					}
				</div>
			</div>

			<!-- Grid specs -->
			<div class="d-grid grid-cols-2 gap-3">
				<div class="p-2.5 rounded-lg bg-surface-raised border">
					<span class="text-2xs text-muted d-block">معرف الطلب (Request ID)</span>
					<span class="font-mono text-2xs text-primary select-all break-all">
						if item.RequestID != "" {
							{ item.RequestID }
						} else {
							-
						}
					</span>
				</div>
				<div class="p-2.5 rounded-lg bg-surface-raised border">
					<span class="text-2xs text-muted d-block">النموذج المستخدم</span>
					<span class="font-mono text-2xs text-primary">{ item.Model }</span>
				</div>
				<div class="p-2.5 rounded-lg bg-surface-raised border">
					<span class="text-2xs text-muted d-block">استهلاك التوكنز</span>
					<span class="text-xs font-bold text-primary tabular-nums">
						{ fmt.Sprintf("إجمالي: %d (مدخلات: %d, مخرجات: %d)", item.TotalTokens, item.InputTokens, item.OutputTokens) }
					</span>
				</div>
				<div class="p-2.5 rounded-lg bg-surface-raised border">
					<span class="text-2xs text-muted d-block">التكلفة والمدة</span>
					<span class="text-xs font-bold text-emerald tabular-nums">
						{ fmt.Sprintf("$%.5f • %d ms", item.CostUSD, item.DurationMS) }
					</span>
				</div>
			</div>

			<!-- Error message if any -->
			if item.ErrorMessage != "" {
				<div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900">
					<span class="text-2xs font-bold text-rose-700 dark:text-rose-400 d-block mb-1">تفاصيل رسالة الخطأ:</span>
					<p class="font-mono text-2xs text-rose-800 dark:text-rose-300 m-0 leading-relaxed whitespace-pre-wrap break-all">
						{ item.ErrorMessage }
					</p>
				</div>
			}

			if item.FinishReason != "" {
				<div class="text-2xs text-secondary">
					<span class="font-bold">سبب الانتهاء (Finish Reason):</span> { item.FinishReason }
				</div>
			}

			<div class="flex-end mt-2">
				<button
					type="button"
					@click={ fmt.Sprintf("$dispatch('close-modal', 'ai-log-detail-%d')", item.ID) }
					class="btn btn-secondary btn-sm font-bold"
				>
					إغلاق
				</button>
			</div>
		</div>
	}
}
