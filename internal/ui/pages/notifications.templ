package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/notifications"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ Notifications(logs []*notifications.NotificationLog, unreadCount int, lang, dir string, isPartial bool) {
	if isPartial {
		@NotificationsList(logs)
	} else {
		@layouts.ShellFor("الإشعارات والتنبيهات | Notifications", "notifications", lang, dir, authctx.FromContext(ctx)) {
			@NotificationsContent(logs, unreadCount, lang)
		}
	}
}


templ NotificationsContent(logs []*notifications.NotificationLog, unreadCount int, lang string) {
	<div class="notifications-page-container" style="max-width:880px; margin:1.5rem auto;">
				<div class="header-row">
					<div class="row-center-sm">
						@components.IconBell("icon-md")
						<h1 style="font-size:1.75rem; font-weight:900; color:var(--neutral-900); margin:0;">
							الإشعارات والتنبيهات
						</h1>
					</div>
					if unreadCount > 0 {
						<span class="badge badge-emerald" style="font-size:0.85rem; padding:0.35rem 0.85rem;">
							{ fmt.Sprintf("%d غير مقروء", unreadCount) }
						</span>
					}
				</div>

				<div id="notifications-list">
					@NotificationsList(logs)
				</div>
			</div>
}

templ NotificationsList(logs []*notifications.NotificationLog) {
	if len(logs) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا توجد إشعارات جديدة",
			Message: "أنت على اطلاع دائم بجميع الطلبات وتحديثات الأسعار والمخزون.",
		})
	} else {
		<div style="display:flex; flex-direction:column; gap:0.875rem;">
			for _, l := range logs {
				<div class="card hover-lift" style={ fmt.Sprintf("padding:1.25rem; margin-bottom:0; display:flex; justify-content:space-between; align-items:flex-start; background:%s;", ifReadBg(l.IsRead)) }>
					<div>
						<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
							if !l.IsRead {
								<span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--primary-600);"></span>
							}
							<h4 style="font-weight:700; font-size:1rem; color:var(--neutral-900); margin:0;">
								{ l.Title }
							</h4>
						</div>
						<p style="font-size:0.9rem; color:var(--neutral-600); margin:0 0 0.5rem 0;">
							{ l.Body }
						</p>
						<span class="tabular-nums" style="font-size:0.775rem; color:var(--neutral-400);">
							{ l.CreatedAt.Format("2006-01-02 15:04") }
						</span>
					</div>

					if !l.IsRead {
						<form action={ templ.SafeURL(fmt.Sprintf("/notifications/%d/read", l.ID)) } method="POST" class="m-0">
							<button
								type="submit"
								class="btn btn-secondary btn-sm"
								style="font-size:0.8rem; padding:0.35rem 0.75rem;"
							>
								@components.IconCheck("icon-xs")
								<span>تحديد كمقروء</span>
							</button>
						</form>
					}
				</div>
			}
		</div>
	}
}

func ifReadBg(isRead bool) string {
	if isRead {
		return "#ffffff"
	}
	return "var(--primary-50)"
}
