package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/notifications"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ Notifications(logs []*notifications.NotificationLog, unreadCount int, lang, dir string, isPartial bool) {
	if isPartial {
		@NotificationsList(logs)
	} else {
		@layouts.CustomerShell("الإشعارات والتنبيهات | Notifications", lang, dir) {
			<div class="notifications-page-container" style="max-width:800px; margin:2rem auto;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
					<h1 style="font-size:1.75rem; font-weight:800; color:var(--neutral-900);">
						الإشعارات والتنبيهات
					</h1>
					if unreadCount > 0 {
						<span style="background:var(--primary-600); color:#fff; font-size:0.8rem; font-weight:700; padding:0.25rem 0.75rem; border-radius:20px;">
							{ fmt.Sprintf("%d غير مقروء", unreadCount) }
						</span>
					}
				</div>

				<div id="notifications-list">
					@NotificationsList(logs)
				</div>
			</div>
		}
	}
}

templ NotificationsList(logs []*notifications.NotificationLog) {
	if len(logs) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا توجد إشعارات جديدة",
			Message: "أنت على اطلاع دائم بجميع الطلبات وتحديثات الأسعار والمخزون.",
		})
	} else {
		<div style="display:flex; flex-direction:column; gap:0.75rem;">
			for _, l := range logs {
				<div style={ fmt.Sprintf("background:%s; border:1px solid var(--neutral-200); border-radius:var(--radius-lg); padding:1rem; display:flex; justify-content:space-between; align-items:flex-start;", ifReadBg(l.IsRead)) }>
					<div>
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
							if !l.IsRead {
								<span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--primary-600);"></span>
							}
							<h4 style="font-weight:700; font-size:0.95rem; color:var(--neutral-900); margin:0;">
								{ l.Title }
							</h4>
						</div>
						<p style="font-size:0.875rem; color:var(--neutral-600); margin:0 0 0.5rem 0;">
							{ l.Body }
						</p>
						<span class="tabular-nums" style="font-size:0.75rem; color:var(--neutral-400);">
							{ l.CreatedAt.Format("2006-01-02 15:04") }
						</span>
					</div>

					if !l.IsRead {
						<form action={ templ.SafeURL(fmt.Sprintf("/notifications/%d/read", l.ID)) } method="POST" style="margin:0;">
							<button
								type="submit"
								class="btn btn-secondary"
								style="font-size:0.75rem; padding:0.25rem 0.6rem;"
							>
								تحديد كمقروء ✓
							</button>
						</form>
					}
				</div>
			}
		</div>
	}
}

func ifReadBg(isRead bool) string {
	if isRead {
		return "#ffffff"
	}
	return "var(--primary-50)"
}
