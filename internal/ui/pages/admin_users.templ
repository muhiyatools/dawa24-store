package pages

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminUsersPageData struct {
	Users            []*identity.User
	Organizations    []*org.Organization
	OrgNames         map[int64]string
	AllBranches      []*org.Branch
	UserNationalIDs  map[int64]string
	UserMemberships  map[int64]*identity.UserOrgMembership
	DeletionRequests []*identity.AccountDeletionRequest
	TotalUsers       int
	CustomerUsers    int
	VendorUsers      int
	StaffUsers       int
	ActiveUsers      int
	SuspendedUsers   int
	Page             int
	PerPage          int
	TotalCount       int
	SearchQuery      string
	RoleFilter       string
	TypeFilter       string
	StatusFilter     string
	OrgFilter        int64
	MFAFilter        string
	LoginFromFilter  string
	LoginToFilter    string
	StaffRoles       []AdminUserRoleOption
	Notice           string
	NoticeKind       string
	// MainModerators are the top-level moderators a new sub-moderator may be
	// assigned under. Only top-level ones: the hierarchy is one level deep
	// (migration 168), so a moderator who already reports to somebody cannot
	// himself be a parent.
	MainModerators []AdminModeratorOption
}

// AdminModeratorOption is one selectable main moderator.
type AdminModeratorOption struct {
	UserID int64
	Name   string
	// Team is how many moderators already report to them, so a super admin
	// distributing work can see the load before adding to it.
	Team int
}

type AdminUsersData struct {
	Users            []*identity.User
	DeletionRequests []*identity.AccountDeletionRequest
	ActiveTab        string
}

templ AdminUsersPage(data AdminUsersPageData, lang, dir string) {
	@layouts.AdminShell("إدارة المستخدمين والحسابات", "users", lang, dir) {
		<div
			class="admin-page-container"
			x-data="{
				showAddStaff: false,
				showEditModal: false,
				showPasswordModal: false,
				editUser: { id: 0, name_ar: '', name_en: '', email: '', phone: '', avatar_url: '', national_id: '', status: 'active', org_id: '0', branch_id: '0', job_title: '' },
				passwordUser: { id: 0, name: '', email: '' },
				openEdit(u) {
					this.editUser = u;
					this.showEditModal = true;
				},
				openPassword(u) {
					this.passwordUser = u;
					this.showPasswordModal = true;
				}
			}"
		>
			@roleNotice(data.NoticeKind, data.Notice)
			@adminStaffCreateForm(data)
			
			<!-- Header Banner -->
			<div class="glass-panel p-5 mb-5 border rounded-2xl shadow-xs">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="w-11 h-11 rounded-xl bg-surface-sunken text-primary d-flex items-center justify-center border">
							@components.IconUsers("icon-sm")
						</div>
      <div class="stack-sm">
							<h1 class="text-xl font-black text-primary m-0 d-flex items-center gap-2">
								<span>إدارة المستخدمين والحسابات المركزية</span>
								<span class="badge badge-indigo text-xs font-black tabular-nums">{ fmt.Sprintf("%d حساب", data.TotalUsers) }</span>
							</h1>
							<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
								التحكم في حسابات الصيادلة، مدراء وموظفي الموردين، ومشرفي وإدارة المنصة
							</p>
						</div>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap">
						if len(data.StaffRoles) > 0 {
							<button
								type="button"
								class="btn btn-primary btn-sm font-bold gap-1"
								@click="showAddStaff = !showAddStaff"
							>
								@components.IconPlus("icon-xs")
								<span>إضافة مشرف / دور إداري</span>
							</button>
						}
						<a href="/admin/users" class="btn btn-secondary btn-sm font-bold gap-1">
							@components.IconRefresh("icon-xs")
							<span>تحديث</span>
						</a>
					</div>
				</div>

				<!-- KPI Metric Strip -->
				<div class="d-grid gap-3 mt-4 pt-3 border-t grid-auto-fit-xs">
					<div class="bg-surface-sunken p-3 rounded-xl border">
						<div class="text-xs text-muted font-bold">إجمالي الحسابات</div>
						<div class="tabular-nums text-lg font-black text-primary mt-0.5">{ fmt.Sprintf("%d", data.TotalUsers) }</div>
					</div>
					<div class="bg-surface-sunken p-3 rounded-xl border">
						<div class="text-xs text-muted font-bold">حسابات الصيدليات</div>
						<div class="tabular-nums text-lg font-black text-success mt-0.5">{ fmt.Sprintf("%d", data.CustomerUsers) }</div>
					</div>
					<div class="bg-surface-sunken p-3 rounded-xl border">
						<div class="text-xs text-muted font-bold">حسابات الموردين</div>
						<div class="tabular-nums text-lg font-black text-purple mt-0.5">{ fmt.Sprintf("%d", data.VendorUsers) }</div>
					</div>
					<div class="bg-surface-sunken p-3 rounded-xl border">
						<div class="text-xs text-muted font-bold">إدارة المنصة (Staff)</div>
						<div class="tabular-nums text-lg font-black text-brand mt-0.5">{ fmt.Sprintf("%d", data.StaffUsers) }</div>
					</div>
				</div>
			</div>

			<!-- Filter Bar -->
			<!-- Filter Bar -->
			<div class="filter-bar">
				<form method="GET" action="/admin/users" class="d-flex flex-column gap-3 m-0">
					<div class="d-flex gap-2 items-center flex-wrap">
						<input
							type="text"
							name="q"
							value={ data.SearchQuery }
							placeholder="ابحث بالاسم، البريد الإلكتروني، أو رقم الهاتف..."
							class="form-input text-xs min-w-64 flex-1"
						/>
						<select name="role" class="form-select text-xs font-bold w-auto">
							<option value="">كل الأدوار الوظيفية</option>
							<option value="customer" selected?={ data.RoleFilter == "customer" }>صيدلي / عميل</option>
							<option value="vendor" selected?={ data.RoleFilter == "vendor" }>مورد / موظف مورد</option>
							<option value="staff" selected?={ data.RoleFilter == "staff" }>إدارة ومشرفو المنصة</option>
						</select>
						<select name="type" class="form-select text-xs font-bold w-auto">
							<option value="">كل تصنيفات الحساب</option>
							<option value="customer" selected?={ data.TypeFilter == "customer" }>حساب صيدلية (Customer)</option>
							<option value="vendor" selected?={ data.TypeFilter == "vendor" }>حساب مورد (Vendor)</option>
							<option value="staff" selected?={ data.TypeFilter == "staff" }>إدارة ومنصة (Staff)</option>
						</select>
						<select name="status" class="form-select text-xs font-bold w-auto">
							<option value="">كل الحالات</option>
							<option value="active" selected?={ data.StatusFilter == "active" }>نشط ومفعل</option>
							<option value="suspended" selected?={ data.StatusFilter == "suspended" }>موقوف / معلق</option>
						</select>
						<select name="mfa" class="form-select text-xs font-bold w-auto">
							<option value="">حالة التحقق MFA</option>
							<option value="1" selected?={ data.MFAFilter == "1" }>مفعل MFA</option>
							<option value="0" selected?={ data.MFAFilter == "0" }>غير مفعل MFA</option>
						</select>
						<select name="org_id" class="form-select text-xs font-bold w-auto">
							<option value="">كافة المنشآت</option>
							for _, o := range data.Organizations {
								if o != nil {
									<option value={ fmt.Sprintf("%d", o.ID) } selected?={ o.ID == data.OrgFilter }>{ o.LegalName }</option>
								}
							}
						</select>
					</div>
					<div class="d-flex gap-2 items-center flex-wrap text-xs">
						<span class="text-secondary font-bold">آخر تسجيل دخول:</span>
						<input
							type="date"
							name="login_from"
							value={ data.LoginFromFilter }
							class="form-input text-xs w-auto py-1"
							title="من تاريخ"
						/>
						<span class="text-muted">إلى</span>
						<input
							type="date"
							name="login_to"
							value={ data.LoginToFilter }
							class="form-input text-xs w-auto py-1"
							title="إلى تاريخ"
						/>
						<button type="submit" class="btn btn-secondary btn-sm font-black shadow-2xs">
							تصفية
						</button>
						if data.SearchQuery != "" || data.RoleFilter != "" || data.TypeFilter != "" || data.StatusFilter != "" || data.MFAFilter != "" || data.LoginFromFilter != "" || data.LoginToFilter != "" || data.OrgFilter > 0 {
							<a href="/admin/users" class="btn btn-secondary btn-sm text-muted font-bold shadow-2xs">إلغاء الفلاتر</a>
						}
						if data.OrgFilter > 0 {
							<div class="badge badge-sky text-xs font-bold gap-1 ms-2">
								<span>منشأة: { data.OrgNames[data.OrgFilter] }</span>
								<a href="/admin/users" class="text-danger no-underline ms-1" title="إلغاء تصفية المنشأة">✕</a>
							</div>
						}
					</div>
				</form>
			</div>

			<!-- Users Table -->
			if len(data.Users) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا يوجد مستخدمون",
					Message: "لم يتم العثور على أي مستخدمين يطابقون معايير الفلترة المحددة.",
				})
			} else {
				<div class="glass-panel p-0 border rounded-2xl shadow-xs overflow-hidden">
					<div class="table-container m-0 overflow-x-auto">
						<table class="data-table m-0 text-xs w-full">
							<thead>
								<tr class="bg-surface-raised border-b font-bold">
									<th class="py-3 text-start ps-4">المستخدم</th>
									<th class="py-3 text-start">البريد الإلكتروني ورقم الهاتف</th>
									<th class="py-3 text-start">الدور الوظيفي والمنشأة</th>
									<th class="py-3 text-center">تاريخ الانضمام</th>
									<th class="py-3 text-center">الحالة</th>
									<th class="col-actions py-3 pe-4">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, u := range data.Users {
									{{
										userNID := data.UserNationalIDs[u.ID]
										userOrgID := int64(0)
										userBranchID := int64(0)
										userJobTitle := ""
										userOrgName := ""
										if mem := data.UserMemberships[u.ID]; mem != nil {
											userOrgID = mem.OrganizationID
											userOrgName = mem.OrgName.Get("ar")
											if userOrgName == "" && data.OrgNames[mem.OrganizationID] != "" {
												userOrgName = data.OrgNames[mem.OrganizationID]
											}
										}
									}}
									<tr>
										<td class="py-3 ps-4">
											<div class="d-flex items-center gap-2.5">
												<div class="w-8 h-8 rounded-lg bg-surface-sunken text-primary border d-flex items-center justify-center font-black text-xs overflow-hidden flex-shrink-0">
													if u.AvatarURL != "" {
														<img src={ u.AvatarURL } alt={ userDisplayName(u) } class="w-full h-full object-cover" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='block';" />
														<span style="display: none;">
															{ userInitials(u) }
														</span>
													} else {
														{ userInitials(u) }
													}
												</div>
												<div class="stack-sm">
													<div class="font-extrabold text-primary text-xs">{ userDisplayName(u) }</div>
													<div class="d-flex items-center gap-2 text-2xs text-muted tabular-nums font-mono">
														<span>#{ fmt.Sprintf("USR-%d", u.ID) }</span>
														if userNID != "" {
															<span class="badge badge-slate text-2xs">هوية: { userNID }</span>
														}
													</div>
												</div>
											</div>
										</td>
										<td class="py-3">
											<div class="tabular-nums text-xs font-mono text-secondary" dir="ltr">{ u.Email }</div>
											if u.Phone != "" {
												<div class="text-2xs text-muted mt-0.5 tabular-nums">{ u.Phone }</div>
											}
										</td>
										<td class="py-3">
											<div class="d-flex flex-col gap-1 items-start">
												<span class={ "badge text-xs font-bold", roleBadgeClass(u.Role) }>
													{ roleDisplayAr(u.Role) }
												</span>
												if userOrgName != "" {
													<span class="text-2xs text-secondary font-medium">
														{ userOrgName }
													</span>
												}
											</div>
										</td>
										<td class="tabular-nums text-xs text-muted text-center py-3">
											{ u.CreatedAt.Format("2006-01-02") }
										</td>
										<td class="text-center py-3">
											if u.Status == identity.StatusActive {
												<span class="badge badge-emerald text-xs font-black">نشط ومفعل</span>
											} else if u.Status == identity.StatusSuspended {
												<span class="badge badge-rose text-xs font-black">موقوف / معلق</span>
											} else {
												<span class="badge badge-amber text-xs font-black">قيد المراجعة</span>
											}
										</td>
										<td class="col-actions py-3 pe-4">
											<div class="table-actions">
												<a href={ templ.SafeURL(fmt.Sprintf("/admin/users/%d", u.ID)) } class="btn btn-secondary btn-xs font-bold">
													عرض
												</a>
												<button
													type="button"
													class="btn btn-secondary btn-xs font-bold"
													@click={ fmt.Sprintf("openEdit({ id: %d, name_ar: %q, name_en: %q, email: %q, phone: %q, avatar_url: %q, national_id: %q, status: %q, org_id: '%d', branch_id: '%d', job_title: %q })",
														u.ID, u.Name.Get("ar"), u.Name.Get("en"), u.Email, u.Phone, u.AvatarURL, userNID, string(u.Status), userOrgID, userBranchID, userJobTitle) }
												>
													تعديل
												</button>
												<button
													type="button"
													class="btn btn-secondary btn-xs font-bold"
													@click={ fmt.Sprintf("openPassword({ id: %d, name: %q, email: %q })", u.ID, userDisplayName(u), u.Email) }
												>
													كلمة المرور
												</button>
												if u.Status == identity.StatusActive {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/suspend", u.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من رغبتك في تعليق هذا الحساب؟');">
														<input type="hidden" name="redirect" value="/admin/users" />
														<button type="submit" class="btn btn-secondary btn-xs font-bold text-danger">
															تعليق
														</button>
													</form>
												} else {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reactivate", u.ID)) } class="m-0">
														<input type="hidden" name="redirect" value="/admin/users" />
														<button type="submit" class="btn btn-primary btn-xs font-bold">
															تفعيل
														</button>
													</form>
												}
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reset-mfa", u.ID)) } class="m-0" onsubmit="return confirm('إعادة ضبط التحقق الثنائي MFA لهذا الحساب؟');">
													<input type="hidden" name="redirect" value="/admin/users" />
													<button type="submit" class="btn btn-secondary btn-icon btn-xs" title="إعادة ضبط MFA">
														@components.IconRefresh("icon-2xs")
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					if data.TotalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.TotalCount,
							BaseURL:     "/admin/users",
							QueryValues: adminUsersQueryValues(data),
						})
					}
				</div>
			}

			<!-- Edit User Modal -->
			<div
				x-show="showEditModal"
				x-cloak
				class="modal-backdrop fixed inset-0 z-50 d-flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
				@keydown.escape.window="showEditModal = false"
			>
				<div
					class="glass-panel p-6 max-w-xl w-full max-h-[90vh] overflow-y-auto rounded-2xl shadow-xl border"
					@click.away="showEditModal = false"
				>
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 d-flex items-center justify-center border">
								@components.IconEdit("icon-xs")
							</div>
							<h3 class="text-base font-black text-primary m-0">تعديل بيانات المستخدم والحساب</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon btn-sm" @click="showEditModal = false">✕</button>
					</div>

					<form method="POST" :action="'/admin/users/' + editUser.id + '/edit'" class="d-grid gap-3">
						<input type="hidden" name="redirect" value="/admin/users" />

						<div class="d-grid grid-2-col gap-3">
							<div class="stack-sm">
								<label class="form-label" for="list-edit-name-ar">الاسم بالعربية <span class="text-danger">*</span></label>
								<input id="list-edit-name-ar" class="form-input" type="text" name="name_ar" x-model="editUser.name_ar" required maxlength="120"/>
							</div>
							<div class="stack-sm">
								<label class="form-label" for="list-edit-name-en">الاسم بالإنجليزية</label>
								<input id="list-edit-name-en" class="form-input" type="text" name="name_en" x-model="editUser.name_en" maxlength="120"/>
							</div>
						</div>

						<div class="d-grid grid-2-col gap-3">
							<div class="stack-sm">
								<label class="form-label" for="list-edit-email">البريد الإلكتروني <span class="text-danger">*</span></label>
								<input id="list-edit-email" class="form-input" type="email" name="email" x-model="editUser.email" required autocomplete="off"/>
							</div>
							<div class="stack-sm">
								<label class="form-label" for="list-edit-phone">رقم الهاتف</label>
								<input id="list-edit-phone" class="form-input" type="tel" name="phone" x-model="editUser.phone" maxlength="20"/>
							</div>
						</div>

						<div class="d-grid grid-2-col gap-3">
							<div class="stack-sm">
								<label class="form-label" for="list-edit-national-id">رقم الهوية الوطنية / الإقامة</label>
								<input id="list-edit-national-id" class="form-input" type="text" name="national_id" x-model="editUser.national_id" maxlength="30" placeholder="10 أرقام"/>
							</div>
							<div class="stack-sm">
								<label class="form-label" for="list-edit-status">حالة الحساب</label>
								<select id="list-edit-status" class="form-select font-bold" name="status" x-model="editUser.status">
									<option value="active">نشط ومفعل</option>
									<option value="suspended">موقوف / معلق</option>
								</select>
							</div>
						</div>

						<div class="stack-sm">
							<label class="form-label" for="list-edit-avatar">رابط الصورة الرمزية (Avatar URL)</label>
							<input id="list-edit-avatar" class="form-input" type="url" name="avatar_url" x-model="editUser.avatar_url" placeholder="https://..."/>
						</div>

						<div class="p-3 bg-surface-sunken rounded-xl border mt-2">
							<div class="text-xs font-black text-primary mb-2">ربط المنشأة والفرع (Organization & Branch)</div>
							<div class="d-grid gap-3">
								<div class="stack-sm">
									<label class="form-label" for="list-edit-org">المنشأة التابع لها</label>
									<select id="list-edit-org" class="form-select text-xs font-bold" name="org_id" x-model="editUser.org_id">
										<option value="0">— بدون منشأة (حساب مستقل) —</option>
										for _, o := range data.Organizations {
											if o != nil {
												<option value={ fmt.Sprintf("%d", o.ID) }>
													{ o.LegalName }
												</option>
											}
										}
									</select>
								</div>
								<div class="d-grid grid-2-col gap-3">
									<div class="stack-sm">
										<label class="form-label" for="list-edit-branch">الفرع المخصص</label>
										<select id="list-edit-branch" class="form-select text-xs font-bold" name="branch_id" x-model="editUser.branch_id">
											<option value="0">— المركز الرئيسي / كافة الفروع —</option>
											for _, b := range data.AllBranches {
												if b != nil {
													<option value={ fmt.Sprintf("%d", b.ID) }>
														{ b.Name.Get("ar") }
													</option>
												}
											}
										</select>
									</div>
									<div class="stack-sm">
										<label class="form-label" for="list-edit-job-title">المسمى الوظيفي</label>
										<input
											id="list-edit-job-title"
											class="form-input text-xs"
											type="text"
											name="job_title"
											x-model="editUser.job_title"
											placeholder="مثال: مسؤول مبيعات، صيدلي..."
										/>
									</div>
								</div>
							</div>
						</div>

						<div class="d-flex items-center gap-3 mt-4 pt-3 border-t">
							<button type="submit" class="btn btn-primary font-black">حفظ التعديلات</button>
							<button type="button" class="btn btn-secondary" @click="showEditModal = false">إلغاء</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Set Password Modal -->
			<div
				x-show="showPasswordModal"
				x-cloak
				class="modal-backdrop fixed inset-0 z-50 d-flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
				@keydown.escape.window="showPasswordModal = false"
			>
				<div
					class="glass-panel p-6 max-w-md w-full rounded-2xl shadow-xl border"
					@click.away="showPasswordModal = false"
				>
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 d-flex items-center justify-center border">
								@components.IconLock("icon-xs")
							</div>
							<h3 class="text-base font-black text-primary m-0">تعيين كلمة مرور جديدة</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon btn-sm" @click="showPasswordModal = false">✕</button>
					</div>

					<div class="mb-3 text-xs text-secondary">
						المستخدم: <strong class="text-primary" x-text="passwordUser.name"></strong> (<span class="font-mono" x-text="passwordUser.email"></span>)
					</div>

					<div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-xs text-amber-800 dark:text-amber-300 mb-4">
						<strong>تنبيه أمني:</strong>
						سيتم تغيير كلمة المرور فوراً، إنهاء كافة الجلسات النشطة للمستخدم، وإلغاء أي حظر مؤقت ليتمكن من تسجيل الدخول فوراً.
					</div>

					<form method="POST" :action="'/admin/users/' + passwordUser.id + '/password'" class="d-grid gap-3">
						<input type="hidden" name="redirect" value="/admin/users" />

						<div class="stack-sm">
							<label class="form-label" for="list-new-pass">كلمة المرور الجديدة <span class="text-danger">*</span></label>
							<input
								id="list-new-pass"
								class="form-input font-mono"
								type="password"
								name="password"
								required
								minlength="8"
								autocomplete="new-password"
								placeholder="••••••••"
							/>
							<span class="text-2xs text-muted">يجب ألا تقل عن 8 خانات، وتحتوي حرفاً كبيراً وحرفاً صغيراً ورقماً ورمزاً.</span>
						</div>

						<div class="stack-sm">
							<label class="form-label" for="list-confirm-pass">تأكيد كلمة المرور <span class="text-danger">*</span></label>
							<input
								id="list-confirm-pass"
								class="form-input font-mono"
								type="password"
								name="confirm_password"
								required
								minlength="8"
								autocomplete="new-password"
								placeholder="••••••••"
							/>
						</div>

						<div class="d-flex items-center gap-3 mt-4 pt-3 border-t">
							<button type="submit" class="btn btn-primary font-black">تعيين كلمة المرور</button>
							<button type="button" class="btn btn-secondary" @click="showPasswordModal = false">إلغاء</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}

templ adminStaffCreateForm(data AdminUsersPageData) {
	if len(data.StaffRoles) > 0 {
		<div
			x-show="showAddStaff"
			x-cloak
			class="admin-banner mb-4"
		>
			<h2 class="text-base font-black text-primary mb-1 m-0">إنشاء حساب مشرف جديد</h2>
			<p class="text-xs text-secondary mb-4 m-0">
				يحدد الدور المختار الصفحات والإجراءات المتاحة للمشرف داخل لوحة الإدارة. يمكنك تعديل صلاحيات أي دور من صفحة الأدوار.
			</p>
			<form method="POST" action="/admin/users/staff" class="d-grid gap-3 grid-auto-fit-sm">
    <div class="stack-sm">
					<label class="form-label" for="staff-name-ar">الاسم بالعربية</label>
					<input id="staff-name-ar" class="form-input" type="text" name="name_ar" required maxlength="120"/>
				</div>
    <div class="stack-sm">
					<label class="form-label" for="staff-name-en">الاسم بالإنجليزية</label>
					<input id="staff-name-en" class="form-input" type="text" name="name_en" maxlength="120"/>
				</div>
    <div class="stack-sm">
					<label class="form-label" for="staff-email">البريد الإلكتروني</label>
					<input id="staff-email" class="form-input" type="email" name="email" required autocomplete="off"/>
				</div>
    <div class="stack-sm">
					<label class="form-label" for="staff-phone">رقم الهاتف</label>
					<input id="staff-phone" class="form-input" type="tel" name="phone" maxlength="20"/>
				</div>
    <div class="stack-sm">
					<label class="form-label" for="staff-password">كلمة مرور مبدئية</label>
					<input id="staff-password" class="form-input" type="password" name="password" required minlength="8" autocomplete="new-password"/>
				</div>
    <div class="stack-sm" x-data="{ role: '', level: 'main' }">
					<label class="form-label" for="staff-role">الدور الإداري</label>
					<select id="staff-role" class="form-input font-bold" name="role" required x-model="role">
						for _, role := range data.StaffRoles {
							<option value={ role.Key }>{ role.Name }</option>
						}
					</select>

					<!-- The hierarchy question, asked only for a موظف whose role is
					     مشرف: every other staff role reports to the super admin and
					     has no team of its own. -->
					<div x-show="role === 'moderator'" x-cloak class="stack-sm mt-3">
						<label class="form-label">موقع المشرف في التسلسل</label>
						<label class="form-label d-flex items-center gap-2">
							<input type="radio" name="moderator_level" value="main" x-model="level" checked/>
							<span class="text-body">مشرف رئيسي مستقل — يتبع مدير النظام مباشرة، ويمكن تعيين مشرفين تحته</span>
						</label>
						<label class="form-label d-flex items-center gap-2">
							<input type="radio" name="moderator_level" value="sub" x-model="level"/>
							<span class="text-body">يعمل تحت إدارة مشرف رئيسي</span>
						</label>
						<div x-show="level === 'sub'" x-cloak>
							if len(data.MainModerators) > 0 {
								<select class="form-input" name="moderator_parent_id">
									<option value="">— اختر المشرف الرئيسي —</option>
									for _, m := range data.MainModerators {
										<option value={ fmt.Sprintf("%d", m.UserID) }>
											{ m.Name } ({ fmt.Sprintf("%d مشرف تحته", m.Team) })
										</option>
									}
								</select>
							} else {
								<p class="text-xs text-warning m-0">
									لا يوجد مشرف رئيسي مستقل بعد. أنشئ مشرفاً رئيسياً أولاً ثم عيّن المشرفين تحته.
								</p>
							}
						</div>
					</div>
				</div>
				<div class="col-span-full d-flex items-center gap-3">
					<button type="submit" class="btn btn-primary font-black">إنشاء الحساب</button>
					<button type="button" class="btn btn-secondary" @click="showAddStaff = false">إلغاء</button>
					<span class="text-xs text-muted">
						يُنشأ الحساب مُفعّلاً؛ يُغيّر المشرف كلمة المرور المبدئية عند أول دخول.
					</span>
				</div>
			</form>
		</div>
	}
}

templ AdminUsers(data AdminUsersData, lang, dir string) {
	@layouts.AdminShell("إدارة المستخدمين والصلاحيات | Users", "users", lang, dir) {
		<div
			class="page-container"
			x-data="{
				activeTab: 'all',
				searchQuery: '',
				statusFilter: 'all',
				roleFilter: 'all',
				init() {
					const urlParams = new URLSearchParams(window.location.search);
					let tab = urlParams.get('tab') || localStorage.getItem('dawa24-users-tab') || 'all';
					if (['all', 'pharmacies', 'suppliers', 'staff', 'deletion_requests'].includes(tab)) {
						this.activeTab = tab;
					}
				},
				setTab(tab) {
					this.activeTab = tab;
					localStorage.setItem('dawa24-users-tab', tab);
					const u = new URL(window.location);
					u.searchParams.set('tab', tab);
					window.history.replaceState({}, '', u);
				},
				matchesFilter(name, email, role, status) {
					const q = (this.searchQuery || '').toLowerCase().trim();
					if (q && !name.toLowerCase().includes(q) && !email.toLowerCase().includes(q) && !role.toLowerCase().includes(q)) {
						return false;
					}
					if (this.statusFilter !== 'all' && status !== this.statusFilter) {
						return false;
					}
					if (this.roleFilter !== 'all' && role !== this.roleFilter) {
						return false;
					}
					return true;
				}
			}"
		>
			<!-- Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconUsers("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								إدارة المستخدمين والحسابات ({ fmt.Sprintf("%d", len(data.Users)) })
							</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							التحكم في صلاحيات الحسابات، تعليق وتفعيل المستخدمين، وإدارة طلبات حذف الحسابات
						</p>
					</div>
				</div>

				<!-- Tabs Navigation Bar -->
				<div class="tabs-nav mt-4">
					<button
						type="button"
						class="tab-btn"
						:class="activeTab === 'all' ? 'active' : ''"
						@click="setTab('all')"
					>
						@components.IconUser("icon-xs")
						<span>جميع المستخدمين ({ fmt.Sprintf("%d", len(data.Users)) })</span>
					</button>

					<button
						type="button"
						class="tab-btn"
						:class="activeTab === 'pharmacies' ? 'active' : ''"
						@click="setTab('pharmacies')"
					>
						@components.IconBuilding("icon-xs")
						<span>الصيدليات والعملاء ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "pharmacy")) })</span>
					</button>

					<button
						type="button"
						class="tab-btn"
						:class="activeTab === 'suppliers' ? 'active' : ''"
						@click="setTab('suppliers')"
					>
						@components.IconTruck("icon-xs")
						<span>الموردين والمخازن ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "supplier")) })</span>
					</button>

					<button
						type="button"
						class="tab-btn"
						:class="activeTab === 'staff' ? 'active' : ''"
						@click="setTab('staff')"
					>
						@components.IconShield("icon-xs")
						<span>فريق الإدارة والمنصة ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "staff")) })</span>
					</button>

					<button
						type="button"
						class="tab-btn d-flex items-center gap-2"
						:class="activeTab === 'deletion_requests' ? 'active' : ''"
						@click="setTab('deletion_requests')"
					>
						@components.IconTrash("icon-xs")
						<span>طلبات حذف الحسابات</span>
						if countPendingDeletions(data.DeletionRequests) > 0 {
							<span class="badge badge-rose text-xs font-black">
								{ fmt.Sprintf("%d", countPendingDeletions(data.DeletionRequests)) }
							</span>
						} else {
							<span class="badge badge-slate text-xs">
								{ fmt.Sprintf("%d", len(data.DeletionRequests)) }
							</span>
						}
					</button>
				</div>
			</div>

			<!-- TABS 1-4: Users Tables with Live Filter -->
			<div x-show="activeTab !== 'deletion_requests'" class="d-flex flex-col gap-6">
				<!-- Search and Filter Toolstrip -->
				<div class="glass-panel p-4 mb-0">
					<div class="d-grid grid-3-col gap-3 items-center">
      <div class="stack-sm">
							<input
								type="text"
								x-model="searchQuery"
								placeholder="البحث بالاسم، البريد الإلكتروني، أو الدور..."
								class="form-input text-xs w-full"
							/>
						</div>

      <div class="stack-sm">
							<select x-model="statusFilter" class="form-select text-xs w-full font-bold">
								<option value="all">جميع الحالات (All Status)</option>
								<option value="active">نشط (Active)</option>
								<option value="suspended">موقوف / معلق (Suspended)</option>
								<option value="pending">قيد التفعيل (Pending)</option>
							</select>
						</div>

      <div class="stack-sm">
							<select x-model="roleFilter" class="form-select text-xs w-full font-bold">
								<option value="all">جميع الصلاحيات (All Roles)</option>
								<option value="super_admin">مدير نظام عام (Super Admin)</option>
								<option value="admin">مدير (Admin)</option>
								<option value="pharmacy">صيدلية (Pharmacy)</option>
								<option value="supplier">مورد (Supplier)</option>
								<option value="vendor">بائع / متجر (Vendor)</option>
								<option value="customer">عميل / فرد (Customer)</option>
							</select>
						</div>
					</div>
				</div>

				<!-- Users Data Card -->
				<div class="glass-panel p-0 mb-6 overflow-hidden">
					if len(data.Users) == 0 {
						<div class="p-8 text-center empty-state-glass">
							<div class="text-4xl mb-3">@components.IconUsers("icon-sm")</div>
							<h3 class="text-lg font-black text-primary mb-2">لا يوجد مستخدمين مسجلين</h3>
							<p class="text-sm text-secondary m-0">لم يتم العثور على أي حسابات مستخدمين مطابقة.</p>
						</div>
					} else {
						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th>الاسم وبيانات المستخدم</th>
										<th>البريد الإلكتروني</th>
										<th>الدور / الصلاحية</th>
										<th class="text-center">الحالة</th>
										<th class="col-actions">الإجراءات</th>
									</tr>
								</thead>
								<tbody>
									for _, u := range data.Users {
										<tr
											x-show={ fmt.Sprintf("((activeTab === 'all') || (activeTab === 'pharmacies' && %t) || (activeTab === 'suppliers' && %t) || (activeTab === 'staff' && %t)) && matchesFilter(%q, %q, %q, %q)",
												isPharmacyGroup(u.Role),
												isSupplierGroup(u.Role),
												isStaffGroup(u.Role),
												userDisplayName(u),
												u.Email,
												u.Role,
												string(u.Status),
											) }
										>
											<td>
												<div class="font-extrabold text-primary text-sm">
													{ userDisplayName(u) }
												</div>
												if u.Phone != "" {
													<div class="text-xs text-muted tabular-nums">
														{ u.Phone }
													</div>
												}
											</td>
											<td>
												<span class="text-secondary text-xs tabular-nums">
													{ u.Email }
												</span>
											</td>
											<td>
												<span class={ "badge text-xs font-bold", roleBadgeClass(u.Role) }>
													{ roleDisplayAr(u.Role) }
												</span>
											</td>
											<td class="text-center">
												if u.Status == identity.StatusActive {
													<span class="badge badge-emerald text-xs font-bold">نشط ومفعل</span>
												} else if u.Status == identity.StatusSuspended {
													<span class="badge badge-rose text-xs font-bold">موقوف</span>
												} else {
													<span class="badge badge-amber text-xs font-bold">قيد المراجعة</span>
												}
											</td>
											<td class="col-actions">
												<div class="table-actions">
													if u.Status == identity.StatusActive {
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/suspend", u.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من تعليق هذا الحساب وإنهاء جلساته؟');">
															<button type="submit" class="btn btn-secondary btn-sm font-bold text-danger text-xs px-3">
																@components.IconMinus("icon-xs")
																<span>تعليق الحساب</span>
															</button>
														</form>
													} else {
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reactivate", u.ID)) } class="m-0">
															<button type="submit" class="btn btn-primary btn-sm text-xs font-bold px-3">
																@components.IconCheck("icon-xs")
																<span>إعادة التفعيل</span>
															</button>
														</form>
													}

													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reset-mfa", u.ID)) } class="m-0" onsubmit="return confirm('إعادة ضبط التحقق الثنائي MFA لهذا الحساب؟');">
														<button type="submit" class="btn btn-secondary btn-icon btn-sm" title="إعادة ضبط MFA">
															@components.IconRefresh("icon-xs")
														</button>
													</form>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>

			<!-- TAB 5: Account Deletion Requests -->
			<div x-show="activeTab === 'deletion_requests'" class="d-flex flex-col gap-6">
				<div class="glass-panel p-0 mb-6 overflow-hidden">
					<div class="p-4 px-6 border-b flex-between items-center flex-wrap gap-2">
      <div class="stack-sm">
							<h3 class="text-base font-extrabold text-primary m-0">
								طلبات حذف الحسابات المقدمة من الصيدليات والموردين ({ fmt.Sprintf("%d", len(data.DeletionRequests)) })
							</h3>
							<p class="text-xs text-secondary m-0 mt-1">
								مراجعة طلبات الحذف، والتحقق من عدم وجود أوامر شراء أو مطالبات مالية معلقة قبل اتخاذ القرار
							</p>
						</div>
					</div>

					if len(data.DeletionRequests) == 0 {
						<div class="p-8 text-center empty-state-glass">
							<div class="text-4xl mb-3">@components.IconTrash("icon-sm")</div>
							<h3 class="text-lg font-black text-primary mb-2">لا توجد طلبات حذف معلقة</h3>
							<p class="text-sm text-secondary m-0">لم يتم تقديم أي طلبات حذف حسابات جديدة من الصيدليات أو الموردين.</p>
						</div>
					} else {
						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th>المستخدم</th>
										<th>نوع الحساب / المنشأة</th>
										<th>سبب طلب الحذف</th>
										<th>تاريخ الطلب</th>
										<th class="text-center">الحالة</th>
										<th class="text-end">الإجراء</th>
									</tr>
								</thead>
								<tbody>
									for _, req := range data.DeletionRequests {
										<tr>
											<td>
												<div class="font-extrabold text-primary text-sm">{ req.UserName }</div>
												<div class="text-xs text-muted tabular-nums">{ req.UserEmail }</div>
											</td>
											<td>
												<span class={ "badge text-xs font-bold", roleBadgeClass(req.UserRole) }>
													{ roleDisplayAr(req.UserRole) }
												</span>
												if req.OrganizationName != "" {
													<div class="text-xs text-secondary mt-1">{ req.OrganizationName }</div>
												}
											</td>
											<td>
												if req.Reason != "" {
													<div class="text-xs text-primary leading-normal">{ req.Reason }</div>
												} else {
													<span class="text-xs text-muted italic">لم يذكر سبب محدد</span>
												}
											</td>
											<td class="tabular-nums">
												<span class="text-secondary text-xs">{ req.CreatedAt.Format("2006-01-02 03:04 PM") }</span>
											</td>
											<td class="text-center">
												if req.Status == "pending" {
													<span class="badge badge-amber text-xs font-black">قيد المراجعة</span>
												} else if req.Status == "approved" {
													<span class="badge badge-emerald text-xs font-black">تم الحذف</span>
												} else {
													<span class="badge badge-rose text-xs font-black">مرفوض</span>
												}
											</td>
											<td class="col-actions">
												if req.Status == "pending" {
													<div class="table-actions">
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/approve", req.ID)) } class="m-0" onsubmit="return confirm('تأكيد الموافقة على حذف الحساب وتعليقه فورياً؟');">
															<button type="submit" class="btn btn-danger btn-sm text-xs font-black px-3 py-1 gap-1">
																@components.IconTrash("icon-xs")
																<span>قبول وحذف</span>
															</button>
														</form>

														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/reject", req.ID)) } class="m-0">
															<button type="submit" class="btn btn-secondary btn-sm text-xs font-bold px-3 py-1">
																<span>رفض</span>
															</button>
														</form>
													</div>
												} else {
													<span class="text-xs text-muted">تمت المعالجة</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>

		</div>
	}
}

func userDisplayName(u *identity.User) string {
	if u.Name.Get("ar") != "" {
		return u.Name.Get("ar")
	}
	if u.Name.Get("en") != "" {
		return u.Name.Get("en")
	}
	return u.Email
}

func isPharmacyGroup(role string) bool {
	r := strings.ToLower(role)
	return r == "pharmacy" || r == "customer" || r == "individual" || r == "pharmacist" || r == "buyer" || r == "pharmacist_assistant"
}

func isSupplierGroup(role string) bool {
	r := strings.ToLower(role)
	return r == "supplier" || r == "vendor" || r == "warehouse_keeper" || r == "driver" || r == "sales_rep"
}

func isStaffGroup(role string) bool {
	r := strings.ToLower(role)
	return r == "super_admin" || r == "admin" || r == "support" || r == "developer" || r == "employer" || r == "staff" || r == "finance" || r == "auditor"
}

func countUsersByGroup(users []*identity.User, group string) int {
	cnt := 0
	for _, u := range users {
		switch group {
		case "pharmacy":
			if isPharmacyGroup(u.Role) {
				cnt++
			}
		case "supplier":
			if isSupplierGroup(u.Role) {
				cnt++
			}
		case "staff":
			if isStaffGroup(u.Role) {
				cnt++
			}
		}
	}
	return cnt
}

func countPendingDeletions(requests []*identity.AccountDeletionRequest) int {
	cnt := 0
	for _, r := range requests {
		if r.Status == "pending" {
			cnt++
		}
	}
	return cnt
}

func roleDisplayAr(role string) string {
	switch strings.ToLower(role) {
	case "super_admin":
		return "مدير نظام عام"
	case "admin":
		return "مدير منصة"
	case "pharmacy":
		return "صيدلية"
	case "supplier":
		return "مورد معتمد"
	case "vendor":
		return "بائع / مخزن"
	case "customer", "individual":
		return "عميل / مشتري"
	case "employer":
		return "مسؤول توظيف"
	default:
		return role
	}
}

func roleBadgeClass(role string) string {
	switch strings.ToLower(role) {
	case "super_admin", "admin":
		return "badge-danger"
	case "pharmacy":
		return "badge-sky"
	case "supplier", "vendor":
		return "badge-emerald"
	default:
		return "badge-slate"
	}
}

func userInitials(u *identity.User) string {
	if u == nil {
		return "U"
	}
	name := strings.TrimSpace(u.Name.Get("ar"))
	if name == "" {
		name = strings.TrimSpace(u.Name.Get("en"))
	}
	if name == "" {
		name = strings.TrimSpace(u.Email)
	}
	words := strings.Fields(name)
	if len(words) >= 2 {
		r1 := []rune(words[0])
		r2 := []rune(words[1])
		if len(r1) > 0 && len(r2) > 0 {
			return string(r1[0]) + string(r2[0])
		}
	}
	runes := []rune(name)
	if len(runes) > 0 {
		return string(runes[0])
	}
	return "U"
}

func adminUsersQueryValues(data AdminUsersPageData) url.Values {
	vals := url.Values{}
	if data.SearchQuery != "" {
		vals.Set("q", data.SearchQuery)
	}
	if data.RoleFilter != "" {
		vals.Set("role", data.RoleFilter)
	}
	if data.TypeFilter != "" {
		vals.Set("type", data.TypeFilter)
	}
	if data.StatusFilter != "" {
		vals.Set("status", data.StatusFilter)
	}
	if data.OrgFilter > 0 {
		vals.Set("org_id", fmt.Sprintf("%d", data.OrgFilter))
	}
	if data.MFAFilter != "" {
		vals.Set("mfa", data.MFAFilter)
	}
	if data.LoginFromFilter != "" {
		vals.Set("login_from", data.LoginFromFilter)
	}
	if data.LoginToFilter != "" {
		vals.Set("login_to", data.LoginToFilter)
	}
	return vals
}