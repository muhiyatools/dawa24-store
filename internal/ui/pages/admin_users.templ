package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminUsersData struct {
	Users            []*identity.User
	DeletionRequests []*identity.AccountDeletionRequest
	ActiveTab        string
}

templ AdminUsers(data AdminUsersData, lang, dir string) {
	@layouts.AdminShell("إدارة المستخدمين والصلاحيات | Users", "users", lang, dir) {
		<div
			style="max-width:1200px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem;"
			x-data="{
				activeTab: 'all',
				searchQuery: '',
				statusFilter: 'all',
				roleFilter: 'all',
				init() {
					const urlParams = new URLSearchParams(window.location.search);
					let tab = urlParams.get('tab') || localStorage.getItem('dawa24-users-tab') || 'all';
					if (['all', 'pharmacies', 'suppliers', 'staff', 'deletion_requests'].includes(tab)) {
						this.activeTab = tab;
					}
				},
				setTab(tab) {
					this.activeTab = tab;
					localStorage.setItem('dawa24-users-tab', tab);
					const u = new URL(window.location);
					u.searchParams.set('tab', tab);
					window.history.replaceState({}, '', u);
				},
				matchesFilter(name, email, role, status) {
					const q = (this.searchQuery || '').toLowerCase().trim();
					if (q && !name.toLowerCase().includes(q) && !email.toLowerCase().includes(q) && !role.toLowerCase().includes(q)) {
						return false;
					}
					if (this.statusFilter !== 'all' && status !== this.statusFilter) {
						return false;
					}
					if (this.roleFilter !== 'all' && role !== this.roleFilter) {
						return false;
					}
					return true;
				}
			}"
		>
			
			<!-- Header -->
			<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
				<div style="display:flex; align-items:center; gap:0.75rem;">
					<div style="width:46px; height:46px; border-radius:var(--radius-xl); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconUser("icon-md")
					</div>
					<div>
						<h2 class="card-title" style="margin:0; font-size:1.55rem; font-weight:800;">
							إدارة المستخدمين والحسابات ({ fmt.Sprintf("%d", len(data.Users)) })
						</h2>
						<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
							التحكم في صلاحيات الحسابات، تعليق وتفعيل المستخدمين، وإدارة طلبات حذف الحسابات
						</p>
					</div>
				</div>
			</div>

			<!-- Tabs Navigation Bar -->
			<div style="display:flex; gap:0.5rem; border-bottom:2px solid var(--border); flex-wrap:wrap;">
				<button
					type="button"
					class="btn"
					:class="activeTab === 'all' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('all')"
				>
					@components.IconUser("icon-xs")
					<span>جميع المستخدمين ({ fmt.Sprintf("%d", len(data.Users)) })</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'pharmacies' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('pharmacies')"
				>
					@components.IconBuilding("icon-xs")
					<span>الصيدليات والعملاء ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "pharmacy")) })</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'suppliers' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('suppliers')"
				>
					@components.IconTruck("icon-xs")
					<span>الموردين والمستودعات ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "supplier")) })</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'staff' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('staff')"
				>
					@components.IconShield("icon-xs")
					<span>فريق الإدارة والمنصة ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "staff")) })</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'deletion_requests' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem; position:relative;"
					@click="setTab('deletion_requests')"
				>
					@components.IconTrash("icon-xs")
					<span>طلبات حذف الحسابات</span>
					if countPendingDeletions(data.DeletionRequests) > 0 {
						<span class="badge badge-danger" style="font-size:0.7rem; font-weight:800; padding:0.15rem 0.45rem;">
							{ fmt.Sprintf("%d", countPendingDeletions(data.DeletionRequests)) }
						</span>
					} else {
						<span class="badge badge-slate" style="font-size:0.7rem;">
							{ fmt.Sprintf("%d", len(data.DeletionRequests)) }
						</span>
					}
				</button>
			</div>

			<!-- ========================================== -->
			<!-- TABS 1-4: Users Tables with Live Filter   -->
			<!-- ========================================== -->
			<div x-show="activeTab !== 'deletion_requests'" style="display:flex; flex-direction:column; gap:1.25rem;">
				
				<!-- Search and Filter Toolstrip -->
				<div class="card" style="padding:1rem 1.25rem; margin-bottom:0; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:0.75rem; align-items:center;">
						<div class="form-group" style="margin:0;">
							<input
								type="text"
								x-model="searchQuery"
								placeholder="البحث بالاسم، البريد الإلكتروني، أو الدور..."
								class="form-input"
								style="font-size:0.875rem;"
							/>
						</div>

						<div class="form-group" style="margin:0;">
							<select x-model="statusFilter" class="form-select" style="font-size:0.875rem;">
								<option value="all">جميع الحالات (All Status)</option>
								<option value="active">نشط (Active)</option>
								<option value="suspended">موقوف / معلق (Suspended)</option>
								<option value="pending">قيد التفعيل (Pending)</option>
							</select>
						</div>

						<div class="form-group" style="margin:0;">
							<select x-model="roleFilter" class="form-select" style="font-size:0.875rem;">
								<option value="all">جميع الصلاحيات (All Roles)</option>
								<option value="super_admin">مدير نظام عام (Super Admin)</option>
								<option value="admin">مدير (Admin)</option>
								<option value="pharmacy">صيدلية (Pharmacy)</option>
								<option value="supplier">مورد (Supplier)</option>
								<option value="vendor">بائع / متجر (Vendor)</option>
								<option value="customer">عميل / فرد (Customer)</option>
							</select>
						</div>
					</div>
				</div>

				<!-- Users Data Card -->
				<div class="card" style="padding:0; overflow:visible; margin-bottom:0;">
					if len(data.Users) == 0 {
						<div style="padding:2rem;">
							@components.EmptyState(components.EmptyStateProps{
								Title:   "لا يوجد مستخدمين مسجلين",
								Message: "لم يتم العثور على أي حسابات مستخدمين مطابقة.",
							})
						</div>
					} else {
						<div class="table-container" style="overflow-x:auto;">
							<table class="data-table" style="width:100%; border-collapse:collapse; font-size:0.875rem;">
								<thead>
									<tr>
										<th style="width:25%; text-align:start;">الاسم وبيانات المستخدم</th>
										<th style="width:25%; text-align:start;">البريد الإلكتروني</th>
										<th style="width:15%; text-align:start;">الدور / الصلاحية</th>
										<th style="width:15%; text-align:center;">الحالة</th>
										<th style="width:20%; text-align:end;">الإجراءات</th>
									</tr>
								</thead>
								<tbody>
									for _, u := range data.Users {
										<tr
											x-show={ fmt.Sprintf("((activeTab === 'all') || (activeTab === 'pharmacies' && %t) || (activeTab === 'suppliers' && %t) || (activeTab === 'staff' && %t)) && matchesFilter(%q, %q, %q, %q)",
												isPharmacyGroup(u.Role),
												isSupplierGroup(u.Role),
												isStaffGroup(u.Role),
												userDisplayName(u),
												u.Email,
												u.Role,
												string(u.Status),
											) }
										>
											<td style="text-align:start;">
												<div style="font-weight:700; color:var(--text);">
													{ userDisplayName(u) }
												</div>
												if u.Phone != "" {
													<div style="font-size:0.75rem; color:var(--text-muted); direction:ltr; text-align:start;" class="tabular-nums">
														{ u.Phone }
													</div>
												}
											</td>
											<td style="text-align:start;">
												<span style="color:var(--text-secondary); direction:ltr; display:inline-block;" class="tabular-nums">
													{ u.Email }
												</span>
											</td>
											<td style="text-align:start;">
												<span class={ "badge", roleBadgeClass(u.Role) } style="font-weight:700; font-size:0.75rem;">
													{ roleDisplayAr(u.Role) }
												</span>
											</td>
											<td style="text-align:center;">
												if u.Status == identity.StatusActive {
													<span class="badge badge-emerald">نشط ومفعل</span>
												} else if u.Status == identity.StatusSuspended {
													<span class="badge badge-danger">موقوف</span>
												} else {
													<span class="badge badge-amber">قيد المراجعة</span>
												}
											</td>
											<td style="text-align:end;">
												<div class="table-actions" style="justify-content:flex-end; gap:0.4rem;">
													if u.Status == identity.StatusActive {
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/suspend", u.ID)) } style="margin:0;" onsubmit="return confirm('هل أنت متأكد من تعليق هذا الحساب وإنهاء جلساته؟');">
															<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); font-size:0.75rem; font-weight:700;">
																@components.IconMinus("icon-xs")
																<span>تعليق الحساب</span>
															</button>
														</form>
													} else {
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reactivate", u.ID)) } style="margin:0;">
															<button type="submit" class="btn btn-primary btn-sm" style="font-size:0.75rem; font-weight:700;">
																@components.IconCheck("icon-xs")
																<span>إعادة التفعيل</span>
															</button>
														</form>
													}

													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reset-mfa", u.ID)) } style="margin:0;" onsubmit="return confirm('إعادة ضبط التحقق الثنائي MFA لهذا الحساب؟');">
														<button type="submit" class="btn btn-secondary btn-icon" style="width:30px; height:30px;" title="إعادة ضبط MFA">
															@components.IconRefresh("icon-xs")
														</button>
													</form>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

			</div>

			<!-- ========================================== -->
			<!-- TAB 5: Account Deletion Requests           -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'deletion_requests'" style="display:flex; flex-direction:column; gap:1.25rem;">
				
				<div class="card" style="padding:0; overflow:visible; margin-bottom:0;">
					<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
						<div>
							<h3 class="card-title" style="margin:0; font-size:1.15rem; font-weight:800;">
								طلبات حذف الحسابات المقدمة من الصيدليات والموردين ({ fmt.Sprintf("%d", len(data.DeletionRequests)) })
							</h3>
							<p style="font-size:0.8rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								مراجعة طلبات الحذف، والتحقق من عدم وجود أوامر شراء أو مطالبات مالية معلقة قبل اتخاذ القرار
							</p>
						</div>
					</div>

					if len(data.DeletionRequests) == 0 {
						<div style="padding:2.5rem;">
							@components.EmptyState(components.EmptyStateProps{
								Title:   "لا توجد طلبات حذف معلقة",
								Message: "لم يتم تقديم أي طلبات حذف حسابات جديدة من الصيدليات أو الموردين.",
							})
						</div>
					} else {
						<div class="table-container" style="overflow-x:auto;">
							<table class="data-table" style="width:100%; border-collapse:collapse; font-size:0.875rem;">
								<thead>
									<tr>
										<th style="width:20%; text-align:start;">المستخدم</th>
										<th style="width:15%; text-align:start;">نوع الحساب / المنشأة</th>
										<th style="width:25%; text-align:start;">سبب طلب الحذف</th>
										<th style="width:15%; text-align:start;">تاريخ الطلب</th>
										<th style="width:10%; text-align:center;">الحالة</th>
										<th style="width:15%; text-align:end;">الإجراء</th>
									</tr>
								</thead>
								<tbody>
									for _, req := range data.DeletionRequests {
										<tr>
											<td style="text-align:start;">
												<div style="font-weight:700; color:var(--text);">{ req.UserName }</div>
												<div style="font-size:0.75rem; color:var(--text-muted); direction:ltr; text-align:start;" class="tabular-nums">{ req.UserEmail }</div>
											</td>
											<td style="text-align:start;">
												<span class={ "badge", roleBadgeClass(req.UserRole) } style="font-size:0.725rem; font-weight:700;">
													{ roleDisplayAr(req.UserRole) }
												</span>
												if req.OrganizationName != "" {
													<div style="font-size:0.75rem; color:var(--text-secondary); margin-top:2px;">{ req.OrganizationName }</div>
												}
											</td>
											<td style="text-align:start;">
												if req.Reason != "" {
													<div style="font-size:0.825rem; color:var(--text); line-height:1.4;">{ req.Reason }</div>
												} else {
													<span style="font-size:0.8rem; color:var(--text-muted); font-style:italic;">لم يذكر سبب محدد</span>
												}
											</td>
											<td style="text-align:start;" class="tabular-nums">
												<span style="color:var(--text-secondary); font-size:0.8rem;">{ req.CreatedAt.Format("2006-01-02 15:04") }</span>
											</td>
											<td style="text-align:center;">
												if req.Status == "pending" {
													<span class="badge badge-amber" style="font-weight:800;">قيد المراجعة</span>
												} else if req.Status == "approved" {
													<span class="badge badge-emerald" style="font-weight:800;">تم الحذف</span>
												} else {
													<span class="badge badge-danger" style="font-weight:800;">مرفوض</span>
												}
											</td>
											<td style="text-align:end;">
												if req.Status == "pending" {
													<div class="table-actions" style="justify-content:flex-end; gap:0.4rem;">
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/approve", req.ID)) } style="margin:0;" onsubmit="return confirm('تأكيد الموافقة على حذف الحساب وتعليقه فورياً؟');">
															<button type="submit" class="btn btn-danger btn-sm" style="font-size:0.725rem; font-weight:800; padding:0.35rem 0.65rem;">
																@components.IconTrash("icon-xs")
																<span>قبول وحذف</span>
															</button>
														</form>

														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/reject", req.ID)) } style="margin:0;">
															<button type="submit" class="btn btn-secondary btn-sm" style="font-size:0.725rem; font-weight:700; padding:0.35rem 0.65rem;">
																<span>رفض</span>
															</button>
														</form>
													</div>
												} else {
													<span style="font-size:0.75rem; color:var(--text-muted);">تمت المعالجة</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

			</div>

		</div>
	}
}

templ AdminUsersTable(users []*identity.User) {
	<!-- Deprecated legacy partial container - rendered inside AdminUsers -->
}

func userDisplayName(u *identity.User) string {
	if u.Name.Get("ar") != "" {
		return u.Name.Get("ar")
	}
	if u.Name.Get("en") != "" {
		return u.Name.Get("en")
	}
	return u.Email
}

func isPharmacyGroup(role string) bool {
	r := strings.ToLower(role)
	return r == "pharmacy" || r == "customer" || r == "individual"
}

func isSupplierGroup(role string) bool {
	r := strings.ToLower(role)
	return r == "supplier" || r == "vendor"
}

func isStaffGroup(role string) bool {
	r := strings.ToLower(role)
	return r == "super_admin" || r == "admin" || r == "support" || r == "developer" || r == "employer"
}

func countUsersByGroup(users []*identity.User, group string) int {
	cnt := 0
	for _, u := range users {
		switch group {
		case "pharmacy":
			if isPharmacyGroup(u.Role) {
				cnt++
			}
		case "supplier":
			if isSupplierGroup(u.Role) {
				cnt++
			}
		case "staff":
			if isStaffGroup(u.Role) {
				cnt++
			}
		}
	}
	return cnt
}

func countPendingDeletions(requests []*identity.AccountDeletionRequest) int {
	cnt := 0
	for _, r := range requests {
		if r.Status == "pending" {
			cnt++
		}
	}
	return cnt
}

func roleDisplayAr(role string) string {
	switch strings.ToLower(role) {
	case "super_admin":
		return "مدير نظام عام"
	case "admin":
		return "مدير منصة"
	case "pharmacy":
		return "صيدلية"
	case "supplier":
		return "مورد معتمد"
	case "vendor":
		return "بائع / مستودع"
	case "customer", "individual":
		return "عميل / مشتري"
	case "employer":
		return "مسؤول توظيف"
	default:
		return role
	}
}

func roleBadgeClass(role string) string {
	switch strings.ToLower(role) {
	case "super_admin", "admin":
		return "badge-danger"
	case "pharmacy":
		return "badge-sky"
	case "supplier", "vendor":
		return "badge-emerald"
	default:
		return "badge-slate"
	}
}

