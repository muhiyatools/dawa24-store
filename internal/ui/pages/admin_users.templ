package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminUsers(users []*identity.User, lang, dir string, isPartial bool) {
	if isPartial {
		@AdminUsersTable(users)
	} else {
		@layouts.AdminShell("إدارة المستخدمين والصلاحيات | Users", "users", lang, dir) {
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">دليل المستخدمين وحسابات النظام</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">إدارة صلاحيات الدخول، تعليق الحسابات، وإعادة ضبط التحقق الثنائي</p>
				</div>
			</div>

			<div id="admin-users-content">
				@AdminUsersTable(users)
			</div>
		}
	}
}

templ AdminUsersTable(users []*identity.User) {
	if len(users) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا يوجد مستخدمين مسجلين",
			Message: "لم يتم العثور على أي حسابات مستخدمين مطابقة.",
		})
	} else {
		<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-lg); overflow:hidden;">
			<table style="width:100%; border-collapse:collapse; text-align:start; font-size:0.9rem;">
				<thead>
					<tr style="background:var(--neutral-50); border-bottom:1px solid var(--neutral-200);">
						<th style="padding:0.75rem 1rem;">الاسم</th>
						<th style="padding:0.75rem 1rem;">البريد الإلكتروني</th>
						<th style="padding:0.75rem 1rem;">الدور / الصلاحية</th>
						<th style="padding:0.75rem 1rem;">الحالة</th>
						<th style="padding:0.75rem 1rem; text-align:end;">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr style="border-bottom:1px solid var(--neutral-100);">
							<td style="padding:0.75rem 1rem; font-weight:700; color:var(--neutral-900);">
								if u.Name["ar"] != "" {
									{ u.Name["ar"] }
								} else {
									{ u.Name["en"] }
								}
							</td>
							<td style="padding:0.75rem 1rem; color:var(--neutral-600);">{ u.Email }</td>
							<td style="padding:0.75rem 1rem;">
								<span style="font-size:0.75rem; padding:0.2rem 0.5rem; border-radius:4px; background:var(--primary-50); color:var(--primary-700); font-weight:600;">
									{ u.Role }
								</span>
							</td>
							<td style="padding:0.75rem 1rem;">
								<span style="font-size:0.75rem; padding:0.2rem 0.5rem; border-radius:4px; background:var(--success-50); color:var(--success-700); font-weight:600;">
									{ string(u.Status) }
								</span>
							</td>
							<td style="padding:0.75rem 1rem; text-align:end;">
								<div style="display:inline-flex; gap:0.5rem;">
									if u.Status == identity.StatusActive {
										<button
											hx-post={ fmt.Sprintf("/api/v1/identity/admin/users/%d/suspend", u.ID) }
											hx-swap="none"
											class="btn btn-secondary"
											style="font-size:0.75rem; padding:0.25rem 0.5rem; color:var(--danger-700);"
										>
											تعليق ⛔
										</button>
									} else {
										<button
											hx-post={ fmt.Sprintf("/api/v1/identity/admin/users/%d/reactivate", u.ID) }
											hx-swap="none"
											class="btn btn-secondary"
											style="font-size:0.75rem; padding:0.25rem 0.5rem; color:var(--success-700);"
										>
											تفعيل ✅
										</button>
									}
									<button
										hx-post={ fmt.Sprintf("/api/v1/identity/admin/users/%d/reset-mfa", u.ID) }
										hx-swap="none"
										class="btn btn-secondary"
										style="font-size:0.75rem; padding:0.25rem 0.5rem;"
									>
										إعادة ضبط MFA 🔑
									</button>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
