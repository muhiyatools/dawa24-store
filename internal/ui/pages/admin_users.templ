package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminUsers(users []*identity.User, lang, dir string, isPartial bool) {
	if isPartial {
		@AdminUsersTable(users)
	} else {
		@layouts.AdminShell("إدارة المستخدمين والصلاحيات | Users", "users", lang, dir) {
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">دليل المستخدمين وحسابات النظام</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">إدارة صلاحيات الدخول، تعليق الحسابات، وإعادة ضبط التحقق الثنائي</p>
				</div>
			</div>

			<div id="admin-users-content">
				@AdminUsersTable(users)
			</div>
		}
	}
}

templ AdminUsersTable(users []*identity.User) {
	if len(users) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا يوجد مستخدمين مسجلين",
			Message: "لم يتم العثور على أي حسابات مستخدمين مطابقة.",
		})
	} else {
		<div class="card" style="padding:0; overflow:hidden; margin-bottom:0;">
			<table class="data-table">
				<thead>
					<tr>
						<th>الاسم</th>
						<th>البريد الإلكتروني</th>
						<th>الدور / الصلاحية</th>
						<th>الحالة</th>
						<th style="text-align:end;">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr>
							<td style="font-weight:700; color:var(--neutral-900);">
								if u.Name["ar"] != "" {
									{ u.Name["ar"] }
								} else {
									{ u.Name["en"] }
								}
							</td>
							<td style="color:var(--neutral-600);">{ u.Email }</td>
							<td>
								<span class="badge badge-sky">
									{ u.Role }
								</span>
							</td>
							<td>
								if u.Status == identity.StatusActive {
									<span class="badge badge-emerald">
										@components.IconCheck("icon-xs")
										<span>نشط</span>
									</span>
								} else {
									<span class="badge badge-rose">
										<span>معلق</span>
									</span>
								}
							</td>
							<td style="text-align:end;">
								<div style="display:inline-flex; gap:0.5rem;">
									if u.Status == identity.StatusActive {
										<button
											hx-post={ fmt.Sprintf("/api/v1/identity/admin/users/%d/suspend", u.ID) }
											hx-swap="none"
											class="btn btn-secondary btn-sm"
											style="color:var(--danger); border-color:var(--danger-border);"
										>
											<span>تعليق الحساب</span>
										</button>
									} else {
										<button
											hx-post={ fmt.Sprintf("/api/v1/identity/admin/users/%d/reactivate", u.ID) }
											hx-swap="none"
											class="btn btn-primary btn-sm"
										>
											@components.IconCheck("icon-xs")
											<span>إعادة التفعيل</span>
										</button>
									}
									<button
										hx-post={ fmt.Sprintf("/api/v1/identity/admin/users/%d/reset-mfa", u.ID) }
										hx-swap="none"
										class="btn btn-secondary btn-sm"
									>
										@components.IconRefresh("icon-xs")
										<span>إعادة ضبط MFA</span>
									</button>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
