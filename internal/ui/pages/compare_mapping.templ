package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CompareFileMappingPage(lang, dir string, file *compare.CompareFile, headers []string, preview [][]string, detection *compare.ColumnDetection) {
	@layouts.VendorShell("تعيين أعمدة الملف - "+file.SupplierName, "compare", lang, dir) {
		<div style="max-width:900px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem;">

			<!-- Header -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem 1.75rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.25rem;">
							<div style="width:40px; height:40px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.25rem;">
								📋
							</div>
							<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
								تعيين أعمدة ملف المورد
							</h1>
						</div>
						<p style="color:var(--text-muted); font-size:0.875rem; margin:0;">
							ملف: <strong>{ file.SupplierName }</strong> • { file.OriginalFilename } • حدد الأعمدة المقابلة لكل حقل مطلوب
						</p>
					</div>
					<a href="/compare/tool" class="btn btn-secondary" style="font-weight:700;">
						@components.IconArrowLeft("icon-xs")
						<span>العودة</span>
					</a>
				</div>
			</div>

			<!-- Mapping Form -->
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/compare/files/%d/mapping", file.ID)) } style="display:flex; flex-direction:column; gap:1.5rem;">

				<!-- Required Fields Notice -->
				<div class="card" style="background:var(--surface-sunken); border:1px solid var(--warning-border); border-radius:var(--radius-xl); padding:1rem;">
					<div style="display:flex; align-items:start; gap:0.5rem;">
						<span style="font-size:1.25rem; color:var(--warning-text); margin-top:0.15rem;">⚠️</span>
						<div>
							<strong style="color:var(--warning-text);">الحقول المطلوبة:</strong>
							<ul style="margin:0.5rem 0 0 1rem; color:var(--text-muted); font-size:0.875rem;">
								<li><strong>اسم الصنف</strong> - مطلوب</li>
								<li><strong>السعر</strong> أو <strong>الخصم</strong> - مطلوب على الأقل أحدهما</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Column Mapping Fields -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
					<h3 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">تعيين الأعمدة</h3>

					<div style="display:grid; gap:1rem;">
						<!-- Product Name (Required) -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
							<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
								<label style="display:block; font-weight:800; color:var(--text); font-size:0.9rem; margin:0;">
									اسم الصنف <span style="color:var(--danger-text);">*</span>
								</label>
								if detection != nil && detection.NameCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldProductName]; ok {
										<span style="display:inline-flex; align-items:center; gap:0.35rem; background:var(--fill-success); color:var(--on-success); padding:0.3rem 0.6rem; border-radius:var(--radius-lg); font-size:0.75rem; font-weight:700;">
											<i class="ti ti-check" style="font-size:12px;"></i>
											{ fmt.Sprintf("%.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="name_col" required class="form-input" style="width:100%; padding:0.5rem; border-radius:var(--radius-lg); border:1px solid var(--border); background:var(--surface);">
								<option value="">-- اختر عمود اسم الصنف --</option>
								for idx, h := range headers {
									if detection != nil && detection.NameCol != nil && *detection.NameCol == idx {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									}
								}
							</select>
						</div>

						<!-- Price -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
							<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
								<label style="display:block; font-weight:800; color:var(--text); font-size:0.9rem; margin:0;">
									السعر
								</label>
								if detection != nil && detection.PriceCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldPrice]; ok {
										<span style="display:inline-flex; align-items:center; gap:0.35rem; background:var(--fill-success); color:var(--on-success); padding:0.3rem 0.6rem; border-radius:var(--radius-lg); font-size:0.75rem; font-weight:700;">
											<i class="ti ti-check" style="font-size:12px;"></i>
											{ fmt.Sprintf("%.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="price_col" class="form-input" style="width:100%; padding:0.5rem; border-radius:var(--radius-lg); border:1px solid var(--border); background:var(--surface);">
								<option value="">-- اختر عمود السعر (اختياري) --</option>
								for idx, h := range headers {
									if detection != nil && detection.PriceCol != nil && *detection.PriceCol == idx {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									}
								}
							</select>
						</div>

						<!-- Discount -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
							<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
								<label style="display:block; font-weight:800; color:var(--text); font-size:0.9rem; margin:0;">
									الخصم (%)
								</label>
								if detection != nil && detection.DiscountCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldDiscount]; ok {
										<span style="display:inline-flex; align-items:center; gap:0.35rem; background:var(--fill-success); color:var(--on-success); padding:0.3rem 0.6rem; border-radius:var(--radius-lg); font-size:0.75rem; font-weight:700;">
											<i class="ti ti-check" style="font-size:12px;"></i>
											{ fmt.Sprintf("%.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="discount_col" class="form-input" style="width:100%; padding:0.5rem; border-radius:var(--radius-lg); border:1px solid var(--border); background:var(--surface);">
								<option value="">-- اختر عمود الخصم (اختياري) --</option>
								for idx, h := range headers {
									if detection != nil && detection.DiscountCol != nil && *detection.DiscountCol == idx {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									}
								}
							</select>
						</div>

						<!-- Code/SKU -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
							<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
								<label style="display:block; font-weight:800; color:var(--text); font-size:0.9rem; margin:0;">
									الكود / SKU
								</label>
								if detection != nil && detection.CodeCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldSKU]; ok {
										<span style="display:inline-flex; align-items:center; gap:0.35rem; background:var(--fill-success); color:var(--on-success); padding:0.3rem 0.6rem; border-radius:var(--radius-lg); font-size:0.75rem; font-weight:700;">
											<i class="ti ti-check" style="font-size:12px;"></i>
											{ fmt.Sprintf("%.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="code_col" class="form-input" style="width:100%; padding:0.5rem; border-radius:var(--radius-lg); border:1px solid var(--border); background:var(--surface);">
								<option value="">-- اختر عمود الكود (اختياري) --</option>
								for idx, h := range headers {
									if detection != nil && detection.CodeCol != nil && *detection.CodeCol == idx {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("%d: %s", idx, h) }</option>
									}
								}
							</select>
						</div>
					</div>
				</div>

				<!-- Preview Table -->
				if len(headers) > 0 {
					<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem;">
						<h3 style="font-size:1rem; font-weight:800; color:var(--text); margin:0 0 1rem;">معاينة البيانات (أول 5 صفوف)</h3>
						<div style="overflow-x:auto;">
							<table class="table" style="width:100%; border-collapse:collapse; font-size:0.85rem;">
								<thead>
									<tr style="border-bottom:2px solid var(--border); text-align:start; color:var(--text-muted);">
										for _, h := range headers {
											<th style="padding:0.5rem 0.75rem; font-weight:800;">{ h }</th>
										}
									</tr>
								</thead>
								<tbody>
									for _, row := range preview {
										<tr style="border-bottom:1px solid var(--border);">
											for _, cell := range row {
												<td style="padding:0.5rem 0.75rem; color:var(--text);">{ cell }</td>
											}
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				}

				<!-- Submit Button -->
				<div style="display:flex; justify-content:flex-end; gap:0.75rem; padding-top:1rem; border-top:1px solid var(--border);">
					<a href="/compare/tool" class="btn btn-secondary" style="font-weight:700;">إلغاء</a>
					<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.75rem 2rem;">
						@components.IconCheck("icon-xs")
						<span>حفظ وتعيين الأعمدة</span>
					</button>
				</div>
			</form>
		</div>
	}
}