package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CompareFileMappingModal(file *compare.CompareFile, headers []string, preview [][]string, detection *compare.ColumnDetection, isSetup bool, step int, total int, remainingQueue string, nextFileID int64) {
	<dialog
		id="compare-mapping-modal-backdrop"
		class="modal"
		open
		aria-labelledby="compare-mapping-title"
	>
		<div class="modal-box modal-xl">
			<!-- Modal Header & Stepper -->
			<div class="modal-header">
				<div class="d-flex items-center gap-3">
					<div class="b2b-icon-box-sm">
						if isSetup || total > 1 {
							@components.IconSettings("icon-sm")
						} else {
							@components.IconFileText("icon-sm")
						}
					</div>
					<div>
						if isSetup || total > 1 {
							<div class="d-flex items-center gap-2 mb-1 flex-wrap">
								<span class="badge badge-emerald text-xs font-extrabold">
									معالج ضبط الأعمدة (Setup Mode)
								</span>
								<span class="badge badge-sky text-xs font-bold">
									{ fmt.Sprintf("ملف %d من %d", step, total) }
								</span>
							</div>
						}
						<h2 id="compare-mapping-title" class="modal-title">
							ضبط وتأكيد أعمدة كشف المورد
						</h2>
						<p class="text-xs text-muted mt-1 m-0">
							الملف المرفوع: <strong class="text-primary">{ file.OriginalFilename }</strong>
							if file.RowCount > 0 {
								<span> • { fmt.Sprintf("(%d صنف مسجل)", file.RowCount) }</span>
							}
						</p>
					</div>
				</div>

				<form method="dialog">
					<button
						type="submit"
						onclick="closeMappingModal()"
						class="modal-close"
						aria-label="إغلاق"
					>
						@components.IconClose("icon-xs")
					</button>
				</form>
			</div>

			<!-- Visual Progress Bar if in Multi-File Setup Mode -->
			if (isSetup || total > 1) && total > 0 {
				<div style="display:flex; flex-direction:column; gap:0.35rem; margin-top:-0.35rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; font-size:0.75rem; color:var(--text-muted); font-weight:700;">
						<span>نسبة إنجاز ملفات الموردين</span>
						<span class="tabular-nums">{ fmt.Sprintf("%d%%", (step*100)/total) }</span>
					</div>
					<div style="width:100%; height:6px; background:var(--surface-sunken); border-radius:var(--radius-full); overflow:hidden; border:1px solid var(--border);">
						<div
							style={ fmt.Sprintf("width:%d%%;", (step*100)/total) }
							class="progress-bar-fill"
						></div>
					</div>
				</div>
			}

			<!-- Form Content -->
			<form
				id="compare-mapping-form"
				method="POST"
				action={ templ.SafeURL(fmt.Sprintf("/compare/files/%d/mapping", file.ID)) }
				onsubmit="return submitMappingFormAsync(event)"
				style="display:flex; flex-direction:column; gap:1.25rem; margin:0;"
			>
				<input type="hidden" name="setup_queue" value={ remainingQueue } />
				<input type="hidden" name="step" value={ fmt.Sprintf("%d", step) } />
				<input type="hidden" name="total" value={ fmt.Sprintf("%d", total) } />
				<input type="hidden" name="next_file_id" value={ fmt.Sprintf("%d", nextFileID) } />

				<!-- Supplier Name Editable Field -->
				<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1rem 1.25rem; display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
					<div style="font-size:1.4rem;">@components.IconBuilding("icon-sm")</div>
					<div style="flex:1; min-width:260px;">
						<label class="form-label" style="font-weight:800; font-size:0.85rem; color:var(--text); margin-bottom:0.25rem; display:block;">
							اسم المورد أو شركة التوزيع <span class="text-danger">*</span>
						</label>
						<input
							type="text"
							name="supplier_name"
							value={ file.SupplierName }
							class="form-input"
							style="width:100%; height:40px; border-radius:var(--radius-lg); font-weight:700; font-size:0.9rem;"
							placeholder="مثال: شركة المتحدة للصيادلة / ابن سينا فارما"
							required
						/>
					</div>
					<div style="font-size:0.775rem; color:var(--text-muted); max-width:240px; line-height:1.4;">
						سيظهر هذا الاسم في جداول المقارنة وأفضل العروض. يمكنك تعديله الآن.
					</div>
				</div>

				<!-- Column Mapping Selectors Grid (2x2) -->
				<div>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
						<div class="row-center-sm">
							<span style="font-size:1rem;">@components.IconActivity("icon-sm")</span>
							<strong style="font-size:0.9rem; color:var(--text);">تحديد أعمدة البيانات بالكشف:</strong>
						</div>
						<span class="badge badge-sky" style="font-weight:700; font-size:0.75rem;">
							{ fmt.Sprintf("%d عمود تم رصده في الملف", len(headers)) }
						</span>
					</div>

					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(360px, 1fr)); gap:1rem;">
						
						<!-- 1. Product Name (Required) -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; flex-direction:column; gap:0.5rem;">
							<div class="flex-between">
								<label style="font-weight:800; color:var(--text); font-size:0.875rem;">
									اسم الصنف الدوائي <span class="text-danger">* (مطلوب للمطابقة)</span>
								</label>
								if detection != nil && detection.NameCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldProductName]; ok {
										<span class="badge badge-emerald text-xs font-bold">
											{ fmt.Sprintf("تطابق %.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="name_col" required class="form-select" style="width:100%; border-radius:var(--radius-lg); font-weight:700; height:42px; font-size:0.875rem;">
								<option value="">-- اختر عمود اسم الصنف --</option>
								for idx, h := range headers {
									if (file.MappingConfig.NameCol != nil && *file.MappingConfig.NameCol == idx) || (file.MappingConfig.NameCol == nil && detection != nil && detection.NameCol != nil && *detection.NameCol == idx) {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									}
								}
							</select>
						</div>

						<!-- 2. Price -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; flex-direction:column; gap:0.5rem;">
							<div class="flex-between">
								<label style="font-weight:800; color:var(--text); font-size:0.875rem;">
									سعر الجمهور الرسمي (Public Price)
								</label>
								if detection != nil && detection.PriceCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldPrice]; ok {
										<span class="badge badge-emerald text-xs font-bold">
											{ fmt.Sprintf("تطابق %.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="price_col" class="form-select" style="width:100%; border-radius:var(--radius-lg); font-weight:700; height:42px; font-size:0.875rem;">
								<option value="">-- اختر عمود السعر (اختياري) --</option>
								for idx, h := range headers {
									if (file.MappingConfig.PriceCol != nil && *file.MappingConfig.PriceCol == idx) || (file.MappingConfig.PriceCol == nil && detection != nil && detection.PriceCol != nil && *detection.PriceCol == idx) {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									}
								}
							</select>
						</div>

						<!-- 3. Discount -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; flex-direction:column; gap:0.5rem;">
							<div class="flex-between">
								<label style="font-weight:800; color:var(--text); font-size:0.875rem;">
									نسبة الخصم % (Discount)
								</label>
								if detection != nil && detection.DiscountCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldDiscount]; ok {
										<span class="badge badge-emerald text-xs font-bold">
											{ fmt.Sprintf("تطابق %.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="discount_col" class="form-select" style="width:100%; border-radius:var(--radius-lg); font-weight:700; height:42px; font-size:0.875rem;">
								<option value="">-- اختر عمود الخصم (اختياري) --</option>
								for idx, h := range headers {
									if (file.MappingConfig.DiscountCol != nil && *file.MappingConfig.DiscountCol == idx) || (file.MappingConfig.DiscountCol == nil && detection != nil && detection.DiscountCol != nil && *detection.DiscountCol == idx) {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									}
								}
							</select>
						</div>

						<!-- 4. Code / SKU -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; flex-direction:column; gap:0.5rem;">
							<div class="flex-between">
								<label style="font-weight:800; color:var(--text); font-size:0.875rem;">
									كود الصنف / SKU (اختياري)
								</label>
								if detection != nil && detection.CodeCol != nil && detection.FieldScores != nil {
									if score, ok := detection.FieldScores[compare.FieldSKU]; ok {
										<span class="badge badge-emerald text-xs font-bold">
											{ fmt.Sprintf("تطابق %.0f%%", score*100) }
										</span>
									}
								}
							</div>
							<select name="code_col" class="form-select" style="width:100%; border-radius:var(--radius-lg); font-weight:700; height:42px; font-size:0.875rem;">
								<option value="">-- اختر عمود الكود (اختياري) --</option>
								for idx, h := range headers {
									if (file.MappingConfig.CodeCol != nil && *file.MappingConfig.CodeCol == idx) || (file.MappingConfig.CodeCol == nil && detection != nil && detection.CodeCol != nil && *detection.CodeCol == idx) {
										<option value={ fmt.Sprintf("%d", idx) } selected>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									} else {
										<option value={ fmt.Sprintf("%d", idx) }>{ fmt.Sprintf("العمود %d: %s", idx+1, h) }</option>
									}
								}
							</select>
						</div>

					</div>
				</div>

				<!-- Live Preview Table -->
				if len(headers) > 0 && len(preview) > 0 {
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1rem; display:flex; flex-direction:column; gap:0.6rem;">
						<div style="display:flex; justify-content:space-between; align-items:center;">
							<div style="font-weight:800; font-size:0.85rem; color:var(--text);">
								عينة من بيانات الملف (الصفوف الأولى):
							</div>
							<span class="meta-muted">
								{ fmt.Sprintf("%d صفوف للمعاينة", len(preview)) }
							</span>
						</div>
						<div style="overflow-x:auto; max-height:160px; border-radius:var(--radius-lg); border:1px solid var(--border);">
							<table class="data-table" style="font-size:0.785rem">
								<thead>
									<tr style="background:var(--surface-raised); border-bottom:2px solid var(--border); color:var(--text-muted);">
										for idx, h := range headers {
											<th style="padding:0.45rem 0.65rem; font-weight:800; white-space:nowrap; border-inline-end:1px solid var(--border);">
												<div class="tabular-nums" style="font-size:0.7rem; color:var(--accent); font-weight:800;">#{ fmt.Sprintf("%d", idx+1) }</div>
												{ h }
											</th>
										}
									</tr>
								</thead>
								<tbody>
									for _, row := range preview {
										<tr style="border-bottom:1px solid var(--border); background:var(--surface-sunken);">
											for _, cell := range row {
												<td style="padding:0.45rem 0.65rem; color:var(--text); white-space:nowrap; border-inline-end:1px solid var(--border);" class="tabular-nums">
													{ cell }
												</td>
											}
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				}

				<!-- Actions Bar -->
				<div style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; border-top:1px solid var(--border); padding-top:1.15rem; flex-wrap:wrap;">
					
					<div class="d-flex items-center gap-2">
						if isSetup || total > 1 {
							<button
								type="button"
								data-file-id={ fmt.Sprintf("%d", file.ID) }
								data-queue={ remainingQueue }
								data-step={ fmt.Sprintf("%d", step) }
								data-total={ fmt.Sprintf("%d", total) }
								onclick="handleSetupSkip(parseInt(this.dataset.fileId,10), this.dataset.queue, parseInt(this.dataset.step,10), parseInt(this.dataset.total,10))"
								class="btn btn-secondary text-danger"
								style="font-weight:700; padding:0.6rem 1.15rem; font-size:0.85rem;"
								title="حذف وتخطي هذا الملف والانتقال للملف التالي"
							>
								<span>⏩ تخطي هذا الملف</span>
							</button>
						}
						
						<button
							type="button"
							onclick="closeMappingModal()"
							class="btn btn-secondary"
							style="font-weight:700; padding:0.6rem 1.15rem; font-size:0.85rem;"
						>
							إلغاء
						</button>
					</div>

					<div class="d-flex items-center gap-3">
						<button
							type="submit"
							id="mapping-submit-btn"
							class="btn btn-primary"
							style="font-weight:800; padding:0.65rem 1.85rem; gap:0.5rem; font-size:0.9rem; box-shadow:0 4px 14px rgba(16,185,129,0.35);"
						>
							@components.IconCheck("icon-xs")
							if nextFileID > 0 {
								<span>حفظ والملف التالي </span>
							} else {
								<span>حفظ وإنهاء وبدء المقارنة </span>
							}
						</button>
					</div>
				</div>

			</form>
		</div>

		<script>
			if (typeof window.closeMappingModal !== 'function') {
				window.closeMappingModal = function() {
					const modal = document.getElementById('compare-mapping-modal-backdrop');
					if (modal) {
						modal.remove();
					} else {
						const root = document.getElementById('mapping-modal-root');
						if (root) root.innerHTML = '';
						else window.location.href = '/compare/tool';
					}
				};
			}

			if (typeof window.handleSetupSkip !== 'function') {
				window.handleSetupSkip = function(fileId, remainingQueue, step, total) {
					if (!confirm('هل أنت متأكد من تخطي هذا الملف؟ سيتم حذفه من المقارنة والانتقال للملف التالي.')) {
						return;
					}

					const modal = document.getElementById('compare-mapping-modal-backdrop');
					if (modal) {
						modal.innerHTML = `
							<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:2rem; color:var(--text); font-weight:800; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.75rem;">
								<div style="font-size:2rem;">⏩</div>
								<div>جاري تخطي الملف والانتقال للملف التالي...</div>
							</div>
						`;
					}

					const formData = new FormData();
					formData.append('setup_queue', remainingQueue);
					formData.append('step', step);
					formData.append('total', total);

					fetch('/compare/files/' + fileId + '/skip', {
						method: 'POST',
						body: formData,
						headers: {
							'Accept': 'application/json'
						}
					})
					.then(res => {
						if (!res.ok) throw new Error('فشل تخطي الملف.');
						return res.json();
					})
					.then(data => {
						if (data.next_file_id && data.next_file_id > 0) {
							if (typeof window.openSetupModal === 'function') {
								window.openSetupModal(data.next_file_id, data.remaining_queue, data.step, data.total);
							} else {
								window.location.href = '/compare/tool?setup_file=' + data.next_file_id + '&setup_queue=' + encodeURIComponent(data.remaining_queue || '') + '&setup_step=' + data.step + '&setup_total=' + data.total;
							}
						} else {
							window.location.href = '/compare/tool?notice=success&msg=' + encodeURIComponent('تم تخطي الملف والانتهاء من معالج الإعداد.');
						}
					})
					.catch(err => {
						alert(err.message || 'تعذر تخطي الملف.');
						if (typeof window.closeMappingModal === 'function') {
							window.closeMappingModal();
						}
					});
				};
			}
		</script>
	</dialog>
}

templ CompareFileMappingPage(lang, dir string, file *compare.CompareFile, headers []string, preview [][]string, detection *compare.ColumnDetection, isSetup bool, step int, total int, remainingQueue string, nextFileID int64) {
	@layouts.VendorShell("تعيين أعمدة الملف - "+file.SupplierName, "compare", lang, dir) {
		<div style="max-width:920px; margin:0 auto; padding:1.5rem 0;">
			@CompareFileMappingModal(file, headers, preview, detection, isSetup, step, total, remainingQueue, nextFileID)
		</div>
	}
}