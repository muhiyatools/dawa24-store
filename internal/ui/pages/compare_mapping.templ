package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// CompareFileMappingModal is the column setup step: which column of this
// supplier's spreadsheet holds the name, the price, the discount and the code.
//
// In bulk mode it is a wizard. `remainingQueue` carries the file ids still to
// be set up, so uploading twelve files walks the user through twelve of these
// in order — "الملف 3 من 12" — rather than leaving twelve un-mapped files on
// the page for them to find and open one at a time.
templ CompareFileMappingModal(file *compare.CompareFile, headers []string, preview [][]string, detection *compare.ColumnDetection, isSetup bool, step int, total int, remainingQueue string, nextFileID int64) {
	@components.Modal(components.ModalProps{
		ID:    "compare-mapping-modal-backdrop",
		Title: "إعداد أعمدة ملف المورد",
		Size:  "xl",
		Open:  true,
	}) {
		<form
			class="cmap"
			id="compare-mapping-form"
			method="POST"
			action={ templ.SafeURL(fmt.Sprintf("/compare/files/%d/mapping", file.ID)) }
			onsubmit="return submitMappingFormAsync(event)"
		>
			<input type="hidden" name="setup_queue" value={ remainingQueue }/>
			<input type="hidden" name="step" value={ fmt.Sprintf("%d", step) }/>
			<input type="hidden" name="total" value={ fmt.Sprintf("%d", total) }/>
			<input type="hidden" name="next_file_id" value={ fmt.Sprintf("%d", nextFileID) }/>

			<!-- Where the user is in the batch. Only shown when there is a batch. -->
			if total > 1 {
				<div class="cmap-progress">
					<div class="cmap-progress-head">
						<span class="cmap-progress-label">
							{ fmt.Sprintf("الملف %d من %d", step, total) }
						</span>
						<span class="cmap-progress-file">{ file.OriginalFilename }</span>
					</div>
					<div class="cmap-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100">
						<div class={ "cmap-progress-fill", progressWidthClass(step, total) }></div>
					</div>
				</div>
			}

			<!-- Supplier name: the label every comparison table will show. -->
			<div class="cmap-field">
				<label class="cmap-label" for="cmap-supplier">
					اسم المورد أو شركة التوزيع <span class="cmap-req">*</span>
				</label>
				<input
					type="text"
					id="cmap-supplier"
					name="supplier_name"
					value={ file.SupplierName }
					class="form-input"
					placeholder="مثال: شركة المتحدة للصيادلة"
					required
				/>
				<p class="cmap-hint">يظهر هذا الاسم في جداول المقارنة وأفضل العروض.</p>
			</div>

			<!-- The four columns, each with what the detector thought and how sure
			     it was. A confident guess is pre-selected; the user overrides. -->
			<div class="cmap-section">
				<div class="cmap-section-head">
					<strong class="cmap-section-title">ربط أعمدة الملف</strong>
					<span class="cmap-section-meta tabular-nums">
						{ fmt.Sprintf("%d عمود في الملف", len(headers)) }
					</span>
				</div>

				<div class="cmap-grid">
					@cmapColumnField("name_col", "اسم الصنف الدوائي", true, headers, file.MappingConfig.NameCol, detectionCol(detection, "name"), detectionScore(detection, compare.FieldProductName))
					@cmapColumnField("price_col", "سعر الجمهور", false, headers, file.MappingConfig.PriceCol, detectionCol(detection, "price"), detectionScore(detection, compare.FieldPrice))
					@cmapColumnField("discount_col", "نسبة الخصم %", false, headers, file.MappingConfig.DiscountCol, detectionCol(detection, "discount"), detectionScore(detection, compare.FieldDiscount))
					@cmapColumnField("code_col", "كود الصنف / SKU", false, headers, file.MappingConfig.CodeCol, detectionCol(detection, "code"), detectionScore(detection, compare.FieldSKU))
				</div>
			</div>

			<!-- The file as it was read, so a wrong header row is visible here
			     rather than discovered after a few thousand rows are committed. -->
			if len(headers) > 0 && len(preview) > 0 {
				<div class="cmap-section">
					<div class="cmap-section-head">
						<strong class="cmap-section-title">معاينة الملف</strong>
						<span class="cmap-section-meta tabular-nums">
							{ fmt.Sprintf("أول %d صفوف", len(preview)) }
						</span>
					</div>
					<div class="cmap-preview">
						<table class="data-table data-table-compact m-0">
							<thead>
								<tr>
									for idx, h := range headers {
										<th class="whitespace-nowrap">
											<span class="cmap-colnum tabular-nums">{ fmt.Sprintf("%d", idx+1) }</span>
											if h != "" {
												{ h }
											} else {
												<span class="text-muted">(بدون عنوان)</span>
											}
										</th>
									}
								</tr>
							</thead>
							<tbody>
								for _, row := range preview {
									<tr>
										for _, cell := range padPreviewCells(row, len(headers)) {
											<td class="whitespace-nowrap">
												if cell != "" {
													{ cell }
												} else {
													<span class="text-muted">—</span>
												}
											</td>
										}
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<div class="cmap-actions">
				<div class="cmap-actions-start">
					if total > 1 {
						<button
							type="button"
							data-file-id={ fmt.Sprintf("%d", file.ID) }
							data-queue={ remainingQueue }
							data-step={ fmt.Sprintf("%d", step) }
							data-total={ fmt.Sprintf("%d", total) }
							onclick="handleSetupSkip(parseInt(this.dataset.fileId,10), this.dataset.queue, parseInt(this.dataset.step,10), parseInt(this.dataset.total,10))"
							class="btn btn-secondary btn-sm text-danger"
							title="تخطي هذا الملف والانتقال للتالي"
						>
							تخطي هذا الملف
						</button>
					}
					<button type="button" onclick="closeMappingModal()" class="btn btn-ghost btn-sm">إغلاق</button>
				</div>

				<button type="submit" id="mapping-submit-btn" class="btn btn-primary btn-sm font-bold">
					@components.IconCheck("icon-xs")
					if nextFileID > 0 {
						<span>حفظ والانتقال للملف التالي</span>
					} else {
						<span>حفظ وبدء المطابقة</span>
					}
				</button>
			</div>
		</form>
	}
}

// cmapColumnField is one column chooser: the field it fills, what the detector
// guessed, and how sure it was.
//
// The confidence badge is the point of the screen. Without it a pre-selected
// wrong column looks exactly like a pre-selected right one, and the user
// confirms it.
templ cmapColumnField(name, label string, required bool, headers []string, saved *int, detected *int, score float64) {
	<div class="cmap-field">
		<div class="cmap-label-row">
			<label class="cmap-label" for={ "cmap-" + name }>
				{ label }
				if required {
					<span class="cmap-req">*</span>
				}
			</label>
			if score > 0 {
				<span class={ "cmap-score", cmapScoreTone(score) }>
					{ fmt.Sprintf("ثقة %.0f%%", score*100) }
				</span>
			}
		</div>
		<select id={ "cmap-" + name } name={ name } class="form-select" required?={ required }>
			if !required {
				<option value="">— لا يوجد —</option>
			} else {
				<option value="">— اختر العمود —</option>
			}
			for idx, h := range headers {
				<option value={ fmt.Sprintf("%d", idx) } selected?={ cmapSelected(saved, detected, idx) }>
					{ fmt.Sprintf("%d. %s", idx+1, cmapHeaderLabel(h)) }
				</option>
			}
		</select>
	</div>
}

templ CompareFileMappingPage(lang, dir string, file *compare.CompareFile, headers []string, preview [][]string, detection *compare.ColumnDetection, isSetup bool, step int, total int, remainingQueue string, nextFileID int64) {
	@layouts.VendorShell("تعيين أعمدة الملف - "+file.SupplierName, "compare", lang, dir) {
		<div class="stack-xs text-sm">
			@CompareFileMappingModal(file, headers, preview, detection, isSetup, step, total, remainingQueue, nextFileID)
		</div>
	}
}