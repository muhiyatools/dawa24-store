package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerDecisionMemoryData struct {
	Decisions          []*catalog.MatchDecisionView
	Total              int
	Page               int
	PerPage            int
	Search             string
	IsEnabled          bool
	IsVendor           bool
	UsePlatformMemory  bool
	QueryValues        url.Values
}

templ CustomerDecisionMemoryPage(lang, dir string, data CustomerDecisionMemoryData) {
	if data.IsVendor {
		@layouts.VendorShell("ذاكرة قرارات المطابقة للمورد | Dawa24", "decision_memory", lang, dir) {
			@decisionMemoryContent(lang, dir, data)
		}
	} else {
		@layouts.CustomerShell("ذاكرة قرارات المطابقة للصيدلية | Dawa24", "decision_memory", lang, dir, nil) {
			@decisionMemoryContent(lang, dir, data)
		}
	}
}

templ decisionMemoryContent(lang, dir string, data CustomerDecisionMemoryData) {
	{{
		basePath := "/customer/decision-memory"
		if data.IsVendor {
			basePath = "/vendor/decision-memory"
		}
		titleText := "ذاكرة قرارات المطابقة للصيدلية"
		subTitleText := "القرارات المعتمدة لمنشأتك بالإضافة إلى ذاكرة المنصة العامة. قرارات منشأتك تحظى دائماً بالأولوية القصوى."
		if data.IsVendor {
			titleText = "ذاكرة قرارات المطابقة للمورد"
			subTitleText = "القرارات المعتمدة لمنشأتك بالإضافة إلى ذاكرة المنصة العامة لتسريع مطابقة الكتالوج واستيراد الأصناف."
		}
	}}

	<div class="page-container stack-md">
		<!-- Header Banner -->
		<div class="glass-panel p-6 mb-0">
			<div class="flex-between items-center flex-wrap gap-4">
				<div class="stack-sm">
					<div class="d-flex items-center gap-3 mb-1 flex-wrap">
						<div class="user-avatar-badge text-xl">
							@components.IconSparkles("icon-sm")
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							{ titleText }
						</h1>
						if data.IsEnabled {
							<span class="badge badge-emerald text-xs font-bold">نظام الذاكرة نشط</span>
						} else {
							<span class="badge badge-rose text-xs font-bold">معطل مؤقتاً من إدارة المنصة</span>
						}
					</div>
					<p class="text-sm text-secondary m-0">
						{ subTitleText }
					</p>
				</div>
				<div class="d-flex items-center gap-2 flex-wrap">
					if data.Total > 0 {
						<button type="button" class="btn btn-secondary btn-sm font-bold text-danger gap-1" onclick="confirmClearMyDecisions()" title="مسح قرارات منشأتك الخاصة فقط">
							<span>مسح قرارات منشأتي</span>
						</button>
					}
				</div>
			</div>
		</div>

		<!-- Platform Memory Opt-Out Toggle Banner -->
		<div class="p-4 rounded-xl border bg-surface-raised flex-between items-center flex-wrap gap-4">
			<div class="stack-2xs">
				<div class="d-flex items-center gap-2">
					<span class="font-extrabold text-sm text-primary">استخدام ذاكرة المنصة العامة (Public Platform Memory)</span>
					if data.UsePlatformMemory {
						<span class="badge badge-emerald text-xs">مفعّلة 🌐</span>
					} else {
						<span class="badge badge-slate text-xs">معطّلة 🔒</span>
					}
				</div>
				<p class="text-xs text-secondary m-0">
					عند التفعيل، تستفيد منشأتك تلقائياً من آلاف القرارات المعتمدة على مستوى المنصة لتسريع استيراد الطلبيات. قرارات منشأتك الخاصة تتفوق دائماً في حال وجود أي تعارض.
				</p>
			</div>
			<form method="POST" action={ templ.SafeURL(basePath + "/toggle-platform") } class="m-0">
				if data.UsePlatformMemory {
					<input type="hidden" name="use_platform_memory" value="false" />
					<button type="submit" class="btn btn-outline-secondary btn-sm font-bold text-xs" title="إيقاف الاستفادة من ذاكرة المنصة العامة">
						إيقاف ذاكرة المنصة العامة
					</button>
				} else {
					<input type="hidden" name="use_platform_memory" value="true" />
					<button type="submit" class="btn btn-primary btn-sm font-bold text-xs" title="تشغيل والاستفادة من ذاكرة المنصة العامة">
						تفعيل ذاكرة المنصة العامة
					</button>
				}
			</form>
		</div>

		<!-- Stats Grid -->
		<div class="dashboard-stat-grid cols-3 mb-0">
			<div class="stat-card-3d">
				<div class="stat-card-label">إجمالي القرارات المتاحة</div>
				<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", data.Total) }</div>
			</div>
			<div class="stat-card-3d">
				<div class="stat-card-label">مرات إعادة الاستخدام بالصفحة</div>
				<div class="stat-card-value text-brand tabular-nums">
					{{
						hitTotal := int64(0)
						for _, d := range data.Decisions {
							hitTotal += d.HitCount
						}
					}}
					{ fmt.Sprintf("%d", hitTotal) }
				</div>
			</div>
			<div class="stat-card-3d">
				<div class="stat-card-label">حالة ذاكرة المنصة العامة</div>
				<div class="text-base font-black mt-1">
					if data.UsePlatformMemory {
						<span class="text-success">مشاركة مفعّلة (توفير فوري)</span>
					} else {
						<span class="text-muted">مقتصر على قرارات منشأتك</span>
					}
				</div>
			</div>
		</div>

		<!-- Search Bar -->
		<div class="filter-bar">
			<form method="GET" action={ templ.SafeURL(basePath) } class="d-flex items-center gap-3 flex-wrap m-0">
				<div class="flex-1 min-w-260">
					<input type="text" name="q" value={ data.Search } placeholder="بحث باسم الصنف الوارد أو اسم الصنف المعتمد..." class="form-input text-xs w-full" />
				</div>
				<input type="hidden" name="limit" value={ fmt.Sprintf("%d", data.PerPage) } />
				<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-4">
					<span>بحث</span>
				</button>
				if data.Search != "" {
					<a href={ templ.SafeURL(basePath) } class="btn btn-secondary btn-sm text-xs">
						<span>إلغاء</span>
					</a>
				}
			</form>
		</div>

		<!-- Decisions Table -->
		<div class="glass-panel p-0 mb-0 overflow-hidden">
			<div class="table-container m-0">
				<table class="data-table m-0">
					<thead>
						<tr>
							<th class="text-center">#</th>
							<th>النطاق</th>
							<th>اسم الصنف الوارد</th>
							<th>الصنف المعتمد بالكتالوج</th>
							<th class="text-center">نسبة التطابق</th>
							<th class="text-center">الاستخدامات</th>
							<th>السبب / الملاحظات</th>
							<th class="text-center">آخر استخدام</th>
							<th class="col-actions">إجراءات</th>
						</tr>
					</thead>
					<tbody>
						if len(data.Decisions) == 0 {
							<tr>
								<td colspan="9" class="text-center py-12 text-muted">
									<div class="text-4xl mb-3">@components.IconSparkles("icon-sm")</div>
									<div class="font-extrabold text-base text-primary">لا توجد قرارات مطابقة مخزنة حالياً</div>
									<div class="text-xs text-secondary mt-1 max-w-md mx-auto">
										يقوم النظام بحفظ قرارات المطابقة المعتمدة تلقائياً عند استيراد ومعالجة الطلبيات لتسريع عمليات المطابقة القادمة.
									</div>
								</td>
							</tr>
						}
						for _, d := range data.Decisions {
							<tr>
								<td class="text-center font-bold text-muted text-xs tabular-nums font-mono">
									{ fmt.Sprintf("%d", d.ID) }
								</td>
								<!-- Scope Badge -->
								<td>
									if d.IsPlatformInherited {
										<span class="badge badge-emerald text-xs font-bold" title="قرار موروث من المنصة العامة">
											🌐 عام للمنصة
										</span>
									} else {
										<span class="badge badge-sky text-xs font-bold" title="قرار خاص بمنشأتك">
											🏢 خاص بمنشأتك
										</span>
									}
								</td>
								<!-- Raw Norm Name -->
								<td>
									<div class="font-extrabold text-xs text-primary">{ d.NormName }</div>
								</td>
								<!-- Chosen Product -->
								<td>
									if d.ChosenProductID != nil && *d.ChosenProductID > 0 {
										<div class="font-extrabold text-xs text-brand">
											if d.ChosenProductName != "" {
												{ d.ChosenProductName }
											} else {
												صنف كتالوج #{ fmt.Sprintf("%d", *d.ChosenProductID) }
											}
										</div>
										<div class="d-flex items-center gap-2 mt-1">
											<span class="text-xs text-muted font-mono font-bold">#{ fmt.Sprintf("%d", *d.ChosenProductID) }</span>
											if d.ChosenProductSKU != "" {
												<span class="badge badge-slate text-xs font-mono">كود: { d.ChosenProductSKU }</span>
											}
										</div>
									} else {
										<span class="badge badge-rose text-xs font-bold">لا يوجد تطابق موثوق</span>
									}
								</td>
								<!-- Confidence -->
								<td class="text-center tabular-nums">
									if d.Confidence > 0 {
										<span class="badge badge-emerald text-xs font-bold">{ fmt.Sprintf("%.0f%%", d.Confidence*100) }</span>
									} else {
										<span class="text-xs text-muted">0%</span>
									}
								</td>
								<!-- Hit Count -->
								<td class="text-center tabular-nums font-bold text-xs text-primary">
									<span class="badge badge-slate text-xs font-bold">{ fmt.Sprintf("%d", d.HitCount) }</span>
								</td>
								<!-- Reason -->
								<td class="text-xs text-secondary">
									if d.Reason != "" {
										{ d.Reason }
									} else {
										<span class="text-muted">—</span>
									}
								</td>
								<!-- Last Used At -->
								<td class="text-center text-xs text-muted tabular-nums">
									{ d.LastUsedAt.Format("2006-01-02 15:04") }
								</td>
								<!-- Actions -->
								<td class="col-actions">
									if d.IsPlatformInherited {
										<span class="text-muted text-2xs italic">للقراءة فقط</span>
									} else {
										<div class="d-flex items-center gap-1">
											<button
												type="button"
												class="btn btn-outline-brand btn-xs font-bold"
												data-id={ fmt.Sprintf("%d", d.ID) }
												data-norm={ d.NormName }
												data-base-path={ basePath }
												onclick="orgOpenRelinkModalFromBtn(this)"
												title="تصحيح مطابقة هذا الصنف"
											>
												ربط
											</button>
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/%d/delete", basePath, d.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف هذا القرار من ذاكرتك؟');" class="m-0">
												<input type="hidden" name="q" value={ data.Search } />
												<input type="hidden" name="page" value={ fmt.Sprint(data.Page) } />
												<input type="hidden" name="limit" value={ fmt.Sprint(data.PerPage) } />
												<button type="submit" class="btn btn-secondary btn-icon btn-sm text-danger" title="حذف هذا القرار من الذاكرة">
													@components.IconX("icon-sm")
												</button>
											</form>
										</div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			@components.B2BPagination(components.PaginationProps{
				CurrentPage: data.Page,
				PageSize:    data.PerPage,
				TotalCount:  data.Total,
				BaseURL:     basePath,
				QueryValues: data.QueryValues,
			})
		</div>

		@CustomerDecisionRelinkModal(basePath)
	</div>

	<!-- Clear All Script -->
	<script data-decision-memory-base={ basePath }>
		function confirmClearMyDecisions() {
			if (confirm("هل أنت متأكد من مسح جميع قرارات المطابقة المحفوظة في ذاكرتك الخاصة فقط؟\n\nلن يؤثر ذلك على أي صيدلية أو مورد آخر.")) {
				var holder = document.querySelector('script[data-decision-memory-base]');
				var root = holder ? holder.getAttribute('data-decision-memory-base') : '';
				if (!root) return;
				var form = document.createElement('form');
				form.method = 'POST';
				form.action = root + '/clear';
				document.body.appendChild(form);
				form.submit();
			}
		}
	</script>
}
