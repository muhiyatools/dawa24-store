package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerDecisionMemoryData struct {
	Decisions []*catalog.MatchDecisionView
	Total     int
	Page      int
	PerPage   int
	Search    string
	IsEnabled bool
	IsVendor  bool
}

func buildCustomerDecisionMemoryURL(isVendor bool, search string, page, limit int) string {
	vals := url.Values{}
	if search != "" {
		vals.Set("q", search)
	}
	if page > 1 {
		vals.Set("page", fmt.Sprintf("%d", page))
	}
	if limit != 50 && limit != 0 {
		vals.Set("limit", fmt.Sprintf("%d", limit))
	}
	base := "/customer/decision-memory"
	if isVendor {
		base = "/vendor/decision-memory"
	}
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

templ CustomerDecisionMemoryPage(lang, dir string, data CustomerDecisionMemoryData) {
	if data.IsVendor {
		@layouts.VendorShell("ذاكرة قرارات المطابقة للمورد | Dawa24", "decision_memory", lang, dir) {
			@decisionMemoryContent(lang, dir, data)
		}
	} else {
		@layouts.CustomerShell("ذاكرة قرارات المطابقة للصيدلية | Dawa24", "decision_memory", lang, dir, nil) {
			@decisionMemoryContent(lang, dir, data)
		}
	}
}

templ decisionMemoryContent(lang, dir string, data CustomerDecisionMemoryData) {
	{{
		basePath := "/customer/decision-memory"
		if data.IsVendor {
			basePath = "/vendor/decision-memory"
		}
		titleText := "ذاكرة قرارات المطابقة للصيدلية"
		subTitleText := "القرارات التي اعتمدتها صيدليتك ومحرك الذكاء الاصطناعي وتم حفظها في ذاكرتك الخاصة. يتم تطبيق هذه القرارات تلقائياً لتسريع استيراد الطلبيات القادمة."
		if data.IsVendor {
			titleText = "ذاكرة قرارات المطابقة للمورد"
			subTitleText = "القرارات التي اعتمدتها منشأتك ومحرك الذكاء الاصطناعي وتم حفظها في ذاكرتك الخاصة. يتم تطبيق هذه القرارات تلقائياً لتسريع مطابقة الكتالوج واستيراد الأصناف."
		}
	}}

	<div class="page-container">
		
		<!-- Header Banner -->
		<div class="glass-panel p-6 mb-0">
			<div class="flex-between items-center flex-wrap gap-4">
				<div>
					<div class="d-flex items-center gap-3 mb-1 flex-wrap">
						<div class="user-avatar-badge text-xl">
							🧠
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							{ titleText }
						</h1>
						if data.IsEnabled {
							<span class="badge badge-emerald text-xs font-bold">
								🟢 الذاكرة نشطة ومعزولة لمنشأتك
							</span>
						} else {
							<span class="badge badge-rose text-xs font-bold">
								🔴 الذاكرة معطلة حالياً من إدارة المنصة
							</span>
						}
					</div>
					<p class="text-sm text-secondary m-0">
						{ subTitleText }
					</p>
				</div>
				<div class="d-flex items-center gap-2 flex-wrap">
					if data.Total > 0 {
						<button
							type="button"
							class="btn btn-secondary btn-sm font-bold text-danger gap-1"
							onclick="confirmClearMyDecisions()"
							title="مسح كافة قرارات المطابقة المحفوظة في ذاكرتك فقط">
							<span>🗑️ مسح كافة قراراتي الذكية</span>
						</button>
					}
				</div>
			</div>
		</div>

		<!-- Warning Alert if Disabled by Admin -->
		if !data.IsEnabled {
			<div class="alert alert-warning mb-0 p-4 d-flex items-center gap-3">
				<span class="text-2xl">⚠️</span>
				<div>
					<div class="font-extrabold text-sm text-warning">نظام ذاكرة القرارات معطل مؤقتاً على مستوى المنصة</div>
					<div class="text-xs text-muted mt-1">
						تم إيقاف استخدام ذاكرة القرارات مؤقتاً بواسطة إدارة المنصة. لن يتم تطبيق القرارات المخزنة خلال الاستيراد حتى يتم إعادة التفعيل من قبل الإدارة.
					</div>
				</div>
			</div>
		}

		<!-- Stats Grid -->
		<div class="dashboard-stat-grid cols-3 mb-0">
			<div class="stat-card-3d">
				<div class="stat-card-label">إجمالي القرارات في ذاكرتك</div>
				<div class="stat-card-value text-primary tabular-nums">
					{ fmt.Sprintf("%d", data.Total) }
				</div>
			</div>
			<div class="stat-card-3d">
				<div class="stat-card-label">مرات إعادة الاستخدام بالصفحة</div>
				<div class="stat-card-value text-brand tabular-nums">
					{{
						hitTotal := int64(0)
						for _, d := range data.Decisions {
							hitTotal += d.HitCount
						}
					}}
					{ fmt.Sprintf("%d", hitTotal) }
				</div>
			</div>
			<div class="stat-card-3d">
				<div class="stat-card-label">نطاق الحماية والخصوصية</div>
				<div class="text-lg font-black text-success mt-1">
					🔒 عزل تام ومؤمّن
				</div>
			</div>
		</div>

		<!-- Search & Rows-Per-Page Form -->
		<div class="glass-panel p-4 mb-0">
			<form method="GET" action={ templ.SafeURL(basePath) } class="d-flex items-center gap-3 flex-wrap m-0">
				<div class="flex-1 min-w-260">
					<input
						type="text"
						name="q"
						value={ data.Search }
						placeholder="بحث باسم الصنف كما ورد بملف الطلب/الكتالوج، أو اسم الصنف المعتمد..."
						class="form-input text-xs w-full"
					/>
				</div>

				<div style="min-width:130px;">
					<select name="limit" onchange="this.form.submit()" class="form-input text-xs w-full">
						<option value="25" selected?={ data.PerPage == 25 }>25 عنصر</option>
						<option value="50" selected?={ data.PerPage == 50 || data.PerPage == 0 }>50 عنصر</option>
						<option value="100" selected?={ data.PerPage == 100 }>100 عنصر</option>
						<option value="200" selected?={ data.PerPage == 200 }>200 عنصر</option>
					</select>
				</div>

				<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-4">
					<span>🔍 بحث</span>
				</button>

				if data.Search != "" {
					<a href={ templ.SafeURL(basePath) } class="btn btn-secondary btn-sm text-xs">
						<span>إلغاء</span>
					</a>
				}
			</form>
		</div>

		<!-- Main Table Card -->
		<div class="glass-panel p-0 mb-0 overflow-hidden">
			<div class="table-container m-0">
				<table class="data-table m-0">
					<thead>
						<tr>
							<th style="width:65px;" class="text-center">#</th>
							<th style="min-width:240px;">اسم الصنف الوارد</th>
							<th style="min-width:280px;">الصنف المعتمد بالكتالوج المركزي</th>
							<th style="width:110px;" class="text-center">نسبة التطابق</th>
							<th style="width:95px;" class="text-center">الاستخدامات</th>
							<th style="min-width:220px;">السبب / الملاحظات</th>
							<th style="width:130px;" class="text-center">تاريخ الاستخدام</th>
							<th style="width:90px;" class="text-center">إجراءات</th>
						</tr>
					</thead>
					<tbody>
						if len(data.Decisions) == 0 {
							<tr>
								<td colspan="8" class="text-center py-12 text-muted">
									<div class="text-4xl mb-3">🧠</div>
									<div class="font-extrabold text-base text-primary">لا توجد قرارات مطابقة مخزنة حالياً في ذاكرتك</div>
									<div class="text-xs text-secondary mt-1 max-w-md mx-auto">
										يقوم النظام ومحرك الذكاء الاصطناعي بحفظ قرارات المطابقة المعتمدة تلقائياً عند استيراد ومعالجة ملفات الطلبيات والكتالوج لتسريع عمليات المطابقة القادمة فورياً.
									</div>
								</td>
							</tr>
						}
						for _, d := range data.Decisions {
							<tr>
								<!-- ID -->
								<td class="text-center font-bold text-muted text-xs tabular-nums">
									{ fmt.Sprintf("%d", d.ID) }
								</td>

								<!-- Norm Name -->
								<td>
									<div class="font-extrabold text-xs text-primary">
										{ d.NormName }
									</div>
								</td>

								<!-- Chosen Product -->
								<td>
									if d.ChosenProductID != nil && *d.ChosenProductID > 0 {
										<div class="font-extrabold text-xs text-brand">
											if d.ChosenProductName != "" {
												{ d.ChosenProductName }
											} else {
												صنف كتالوج #{ fmt.Sprintf("%d", *d.ChosenProductID) }
											}
										</div>
										<div class="d-flex items-center gap-2 mt-1">
											<span class="text-xs text-muted font-mono font-bold">
												#{ fmt.Sprintf("%d", *d.ChosenProductID) }
											</span>
											if d.ChosenProductSKU != "" {
												<span class="badge badge-slate text-xs font-mono">
													كود: { d.ChosenProductSKU }
												</span>
											}
										</div>
									} else {
										<span class="badge badge-rose text-xs font-bold">
											لا يوجد تطابق موثوق (Non-match)
										</span>
									}
								</td>

								<!-- Confidence Score -->
								<td class="text-center tabular-nums">
									if d.Confidence > 0 {
										<span class="badge badge-emerald text-xs font-bold">
											{ fmt.Sprintf("%.0f%%", d.Confidence*100) }
										</span>
									} else {
										<span class="text-xs text-muted">0%</span>
									}
								</td>

								<!-- Hit Count -->
								<td class="text-center tabular-nums font-bold text-xs text-primary">
									<span class="badge badge-slate text-xs font-bold">
										{ fmt.Sprintf("%d", d.HitCount) }
									</span>
								</td>

								<!-- Reason -->
								<td class="text-xs text-secondary">
									if d.Reason != "" {
										{ d.Reason }
									} else {
										<span class="text-muted">—</span>
									}
								</td>

								<!-- Last Used At -->
								<td class="text-center text-xs text-muted tabular-nums">
									{ d.LastUsedAt.Format("2006-01-02 15:04") }
								</td>

								<!-- Actions -->
								<td class="text-center">
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/%d/delete", basePath, d.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف هذا القرار من ذاكرتك؟');" class="m-0">
										<input type="hidden" name="q" value={ data.Search } />
										<input type="hidden" name="page" value={ fmt.Sprint(data.Page) } />
										<input type="hidden" name="limit" value={ fmt.Sprint(data.PerPage) } />
										<button type="submit" class="btn btn-secondary btn-icon btn-sm text-danger" title="حذف هذا القرار من الذاكرة">
											✕
										</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<!-- Pagination Bar -->
			if data.Total > data.PerPage {
				<div class="flex-between items-center p-3 px-6 border-t bg-surface-sunken text-xs">
					<div class="text-secondary">
						إجمالي النتائج: <strong class="text-primary">{ fmt.Sprintf("%d", data.Total) }</strong>
					</div>
					<div class="d-flex items-center gap-2">
						if data.Page > 1 {
							<a href={ templ.SafeURL(buildCustomerDecisionMemoryURL(data.IsVendor, data.Search, data.Page-1, data.PerPage)) } class="btn btn-secondary btn-sm text-xs">
								السابق
							</a>
						}
						<span class="font-bold text-primary px-2">
							صفحة { fmt.Sprintf("%d", data.Page) }
						</span>
						if data.Page * data.PerPage < data.Total {
							<a href={ templ.SafeURL(buildCustomerDecisionMemoryURL(data.IsVendor, data.Search, data.Page+1, data.PerPage)) } class="btn btn-secondary btn-sm text-xs">
								التالي
							</a>
						}
					</div>
				</div>
			}
		</div>
	</div>

	<!-- Clear All Script -->
	<script>
		function confirmClearMyDecisions() {
			if (confirm("⚠️ هل أنت متأكد من مسح جميع قرارات المطابقة المحفوظة في ذاكرتك الخاصة فقط؟\n\nلن يؤثر ذلك على أي صيدلية أو مورد آخر.")) {
				var form = document.createElement('form');
				form.method = 'POST';
				form.action = basePath + '/clear';
				document.body.appendChild(form);
				form.submit();
			}
		}
	</script>
}
