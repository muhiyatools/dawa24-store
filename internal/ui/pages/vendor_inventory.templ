package pages

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorInventoryData struct {
	Stocks      []*inventory.Stock
	AllStocks   []*inventory.Stock
	Warehouses  []*inventory.Warehouse
	Variants    []*catalog.ProductVariant
	Total       int
	Page        int
	PerPage     int
	TotalPages  int
	Query       string
	WarehouseID int64
	NoticeType  string
	NoticeMsg   string
}

func buildInventoryURL(query string, whID int64, page, limit int) string {
	u, _ := url.Parse("/vendor/inventory")
	q := u.Query()
	if query != "" {
		q.Set("q", query)
	}
	if whID > 0 {
		q.Set("warehouse_id", strconv.FormatInt(whID, 10))
	}
	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}
	if limit > 0 && limit != 25 {
		q.Set("limit", strconv.Itoa(limit))
	}
	u.RawQuery = q.Encode()
	return u.String()
}

templ VendorInventory(data VendorInventoryData, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorInventoryTable(data)
	} else {
		@layouts.VendorShell("المخزون والأرصدة | Inventory & Stock", "inventory", lang, dir) {
			<div class="page-container" x-data="{ adjustModal: false, selectedStock: { id: 0, variantName: '', currentQty: 0 } }">
				
				<!-- Notices -->
				if data.NoticeMsg != "" {
					if data.NoticeType == "error" {
						<div class="alert alert-danger mb-4 d-flex items-center gap-3 p-4">
							<span class="text-xl">@components.IconAlert("icon-sm")</span>
							<span class="font-bold text-sm">{ data.NoticeMsg }</span>
						</div>
					} else {
						<div class="alert alert-success mb-4 d-flex items-center gap-3 p-4">
							<span class="text-xl">@components.IconCheckCircle("icon-sm")</span>
							<span class="font-bold text-sm">{ data.NoticeMsg }</span>
						</div>
					}
				}

				<!-- Header -->
				<div class="glass-panel p-6 mb-0">
					<div class="flex-between items-center flex-wrap gap-4">
      <div class="stack-sm">
							<div class="d-flex items-center gap-3 mb-1">
								<div class="user-avatar-badge text-xl">
									@components.IconBarChart("icon-sm")
								</div>
								<h1 class="text-2xl font-black text-primary m-0">أرصدة المخازن والتشغيلات</h1>
							</div>
							<p class="text-sm text-secondary m-0">
								مراقبة الكميات المتاحة في المخازن، إدارة التشغيلات، وتسوية الأرصدة في الوقت الفعلي.
							</p>
						</div>
						<div class="d-flex items-center gap-3 flex-wrap">
							<a href="/vendor/warehouses" class="btn btn-secondary font-bold gap-2">
								@components.IconBuilding("icon-xs")
								<span>مخازن المنشأة</span>
							</a>
							<a href="/vendor/transfers" class="btn btn-secondary font-bold gap-2">
								@components.IconRefresh("icon-xs")
								<span>تحويل بين المخازن</span>
							</a>
							<a href="/vendor/saving-products" class="btn btn-primary font-bold gap-2">
								@components.IconPlus("icon-xs")
								<span>إدارة أصناف المورد</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Inventory Metrics -->
				<div class="dashboard-stat-grid cols-4 mb-0">
					<div class="stat-card-3d">
						<div class="stat-card-label">إجمالي الأصناف بالمخزن</div>
						<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", data.Total) }</div>
					</div>

					<div class="stat-card-3d">
						<div class="stat-card-label text-success">إجمالي العبوات المتوفرة</div>
						<div class="stat-card-value text-success tabular-nums">
							{ fmt.Sprintf("%d", func() int {
								total := 0
								for _, s := range data.AllStocks {
									total += s.Quantity
								}
								return total
							}()) }
						</div>
					</div>

					<div class="stat-card-3d">
						<div class="stat-card-label text-warning">تنبيهات انخفاض المخزون</div>
						<div class="stat-card-value text-warning tabular-nums">
							{ fmt.Sprintf("%d", func() int {
								low := 0
								for _, s := range data.AllStocks {
									if s.Quantity <= s.MinThreshold {
										low++
									}
								}
								return low
							}()) }
						</div>
					</div>

					<div class="stat-card-3d">
						<div class="stat-card-label text-brand">المخازن المغذية</div>
						<div class="stat-card-value text-brand tabular-nums">{ fmt.Sprintf("%d", len(data.Warehouses)) }</div>
					</div>
				</div>

				<!-- Filter & Rows-Per-Page Form -->
				<div class="filter-bar">
					<form method="GET" action="/vendor/inventory" class="d-flex items-center gap-3 flex-wrap m-0">
						<div class="flex-1">
							<input
								type="text"
								name="q"
								value={ data.Query }
								placeholder="بحث باسم الصنف، كود التشغيلة، أو رقم الباركود..."
								class="form-input text-xs w-full"
							/>
						</div>

      <div class="stack-sm">
							<select name="warehouse_id" onchange="this.form.submit()" class="form-input text-xs w-full">
								<option value="">كافة المخازن ({ fmt.Sprintf("%d", len(data.Warehouses)) })</option>
								for _, wh := range data.Warehouses {
									<option value={ fmt.Sprintf("%d", wh.ID) } selected?={ data.WarehouseID == wh.ID }>
										{ wh.Name }
									</option>
								}
							</select>
						</div>

      <div class="stack-sm">
							<select name="limit" onchange="this.form.submit()" class="form-input text-xs w-full">
								<option value="10" selected?={ data.PerPage == 10 }>10 عناصر</option>
								<option value="25" selected?={ data.PerPage == 25 || data.PerPage == 0 }>25 عنصر</option>
								<option value="50" selected?={ data.PerPage == 50 }>50 عنصر</option>
								<option value="100" selected?={ data.PerPage == 100 }>100 عنصر</option>
							</select>
						</div>

						<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-4">
							<span>بحث</span>
						</button>

						if data.Query != "" || data.WarehouseID > 0 {
							<a href="/vendor/inventory" class="btn btn-secondary btn-sm text-xs">
								<span>إلغاء</span>
							</a>
						}
					</form>
				</div>

				<!-- Inventory Table Card -->
				<div class="glass-panel p-0 mb-0 overflow-hidden">
					<div class="stack-sm" id="vendor-inventory-content">
						@VendorInventoryTable(data)
					</div>
				</div>

				<!-- Stock Adjustment Modal (True Fixed Centered Overlay) -->
				<div class="stack-sm"
					x-show="adjustModal"
					x-cloak
					x-transition.opacity
					@keydown.escape.window="adjustModal = false"
				>
					<div
						@click.outside="adjustModal = false"
						class="glass-panel p-6 w-full"
					>
						<div class="flex-between items-center mb-4 pb-3 border-b">
							<div class="d-flex items-center gap-2">
								<span class="text-xl">@components.IconRefresh("icon-sm")</span>
								<h3 class="text-lg font-black text-primary m-0">تسوية وتعديل رصيد المخزن</h3>
							</div>
							<button type="button" @click="adjustModal = false" class="btn btn-secondary btn-icon btn-sm">@components.IconX("icon-sm")</button>
						</div>

						<div class="bg-surface-sunken border rounded-xl p-3 mb-4 text-xs">
							<div class="font-extrabold text-primary text-sm" x-text="selectedStock.variantName"></div>
							<div class="text-secondary mt-1">
								الرصيد الحالي بالمخزن: <strong class="tabular-nums text-brand font-black" x-text="selectedStock.currentQty + ' عبوة'"></strong>
							</div>
						</div>

						<form :action="'/vendor/inventory/' + selectedStock.id + '/adjust'" method="POST" class="d-flex flex-col gap-4 m-0">
       <div class="stack-sm">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">الكمية المراد إضافتها أو خصمها (+/-) <span class="text-danger">*</span></label>
								<input type="number" name="delta" required class="form-input tabular-nums w-full" placeholder="+50 (إضافة) أو -10 (خصم)" />
								<span class="text-xs text-muted mt-1 d-block">اكتب رقم موجب للإيداع أو رقم سالب للخصم والتسوية.</span>
							</div>

       <div class="stack-sm">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">سبب التعديل</label>
								<select name="reason" class="form-input text-xs w-full">
									<option value="تسوية جرد دوري">تسوية جرد دوري</option>
									<option value="استلام شحنة جديدة من المصنع">استلام شحنة جديدة من المصنع</option>
									<option value="تالف / كسر / انتهاء صلاحية">تالف / كسر / انتهاء صلاحية</option>
									<option value="تسوية مبيعات يدوية">تسوية مبيعات يدوية</option>
									<option value="أخرى">أسباب أخرى</option>
								</select>
							</div>

							<div class="flex-between items-center gap-3 pt-3 border-t mt-2">
								<button type="button" class="btn btn-secondary font-bold text-xs" @click="adjustModal = false">إلغاء</button>
								<button type="submit" class="btn btn-primary font-black text-xs px-6">تأكيد تعديل الرصيد</button>
							</div>
						</form>
					</div>
				</div>

			</div>
		}
	}
}

templ VendorInventoryTable(data VendorInventoryData) {
	if len(data.Stocks) == 0 {
		<div class="p-12 text-center empty-state-glass">
			<div class="text-4xl mb-3">@components.IconPackage("icon-sm")</div>
			<h3 class="text-lg font-black text-primary mb-2">لا توجد أصناف تطابق البحث</h3>
			<p class="text-sm text-secondary m-0">لم يتم العثور على أي تشغيلات أو كميات مخزون مطابقة لمعايير البحث المحددة.</p>
		</div>
	} else {
		<div class="table-container m-0">
			<table class="data-table m-0">
				<thead>
					<tr>
						<th>الصنف والتشغيلة</th>
						<th>المخزن / الفرع</th>
						<th>الرصيد المتاح</th>
						<th>حد إعادة الطلب</th>
						<th>الحالة</th>
						<th class="text-end">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range data.Stocks {
						<tr>
							<td>
								<div class="d-flex items-center gap-3">
									<div class="user-avatar-badge">
										@components.IconPackage("icon-xs")
									</div>
         <div class="stack-sm">
										<strong class="text-primary text-sm font-extrabold d-block">
											{ resolveVariantName(s.ProductVariantID, data.Variants) }
										</strong>
										<div class="text-xs text-muted tabular-nums">
											<span>Variant #{ fmt.Sprintf("%d", s.ProductVariantID) }</span>
											{ resolveVariantMeta(s.ProductVariantID, data.Variants) }
										</div>
									</div>
								</div>
							</td>
							<td>
								<div class="font-bold text-primary text-xs">
									{ resolveWarehouseName(s.WarehouseID, data.Warehouses) }
								</div>
								<div class="text-xs text-muted tabular-nums">WH #{ fmt.Sprintf("%d", s.WarehouseID) }</div>
							</td>
							<td>
								if s.Quantity > s.MinThreshold {
									<span class="badge badge-emerald tabular-nums text-xs font-black">
										{ fmt.Sprintf("%d", s.Quantity) } عبوة
									</span>
								} else if s.Quantity > 0 {
									<span class="badge badge-amber tabular-nums text-xs font-black">
										{ fmt.Sprintf("%d", s.Quantity) } عبوة (منخفض)
									</span>
								} else {
									<span class="badge badge-rose tabular-nums text-xs font-black">
										نفد الرصيد
									</span>
								}
							</td>
							<td class="tabular-nums">
								<span class="text-xs text-secondary font-bold">
									{ fmt.Sprintf("%d", s.MinThreshold) } عبوة
								</span>
							</td>
							<td>
								if s.Quantity > 0 {
									<span class="badge badge-emerald text-xs font-bold">جاهز للبيع</span>
								} else {
									<span class="badge badge-rose text-xs font-bold">غير متوفر</span>
								}
							</td>
							<td class="text-end">
								<button
									type="button"
									class="btn btn-secondary btn-sm font-bold gap-1 text-xs"
									@click={ fmt.Sprintf("selectedStock = { id: %d, variantName: %q, currentQty: %d }; adjustModal = true;", s.ID, resolveVariantName(s.ProductVariantID, data.Variants), s.Quantity) }
								>
									@components.IconRefresh("icon-xs")
									<span>تعديل الرصيد</span>
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<!-- Pagination Footer -->
		if data.TotalPages > 1 {
			<div class="flex-between items-center p-4 border-t flex-wrap gap-3 bg-surface-sunken">
				<div class="text-xs text-secondary">
					عرض الصفحة <strong class="text-primary tabular-nums">{ fmt.Sprintf("%d", data.Page) }</strong> من إجمالي <strong class="text-primary tabular-nums">{ fmt.Sprintf("%d", data.TotalPages) }</strong> صفحات ({ fmt.Sprintf("%d", data.Total) } صنف مسجل)
				</div>
				<div class="d-flex items-center gap-1">
					if data.Page > 1 {
						<a href={ templ.SafeURL(buildInventoryURL(data.Query, data.WarehouseID, data.Page-1, data.PerPage)) } class="btn btn-secondary btn-sm text-xs font-bold">
							السابق
						</a>
					}
					for p := 1; p <= data.TotalPages; p++ {
						if p == 1 || p == data.TotalPages || (p >= data.Page-2 && p <= data.Page+2) {
							<a
								href={ templ.SafeURL(buildInventoryURL(data.Query, data.WarehouseID, p, data.PerPage)) }
								class={ "btn btn-sm text-xs font-bold", templ.KV("btn-primary", p == data.Page), templ.KV("btn-secondary", p != data.Page) }
							>
								{ fmt.Sprintf("%d", p) }
							</a>
						}
					}
					if data.Page < data.TotalPages {
						<a href={ templ.SafeURL(buildInventoryURL(data.Query, data.WarehouseID, data.Page+1, data.PerPage)) } class="btn btn-secondary btn-sm text-xs font-bold">
							التالي
						</a>
					}
				</div>
			</div>
		}
	}
}

func resolveWarehouseName(whID int64, warehouses []*inventory.Warehouse) string {
	for _, w := range warehouses {
		if w.ID == whID {
			return w.Name
		}
	}
	return fmt.Sprintf("مخزن #%d", whID)
}

func resolveVariantName(variantID int64, variants []*catalog.ProductVariant) string {
	for _, v := range variants {
		if v.ID == variantID {
			if v.Name["ar"] != "" {
				return v.Name["ar"]
			}
			if v.Name["en"] != "" {
				return v.Name["en"]
			}
			if v.SKU != "" {
				return "تشغيلة " + v.SKU
			}
		}
	}
	return fmt.Sprintf("تشغيلة رقم #%d", variantID)
}

func resolveVariantMeta(variantID int64, variants []*catalog.ProductVariant) string {
	for _, v := range variants {
		if v.ID == variantID {
			meta := ""
			if v.BatchNumber != "" {
				meta += " • تشغيلة: " + v.BatchNumber
			}
			if v.ExpiryDate != nil {
				meta += " • صلاحية: " + v.ExpiryDate.Format("2006-01")
			}
			return meta
		}
	}
	return ""
}
