package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorInventoryData holds context for the vendor inventory page.
type VendorInventoryData struct {
	Stocks      []*inventory.Stock
	AllStocks   []*inventory.Stock
	Warehouses  []*inventory.Warehouse
	Variants    []*catalog.ProductVariant
	Total       int
	Page        int
	PerPage     int
	TotalPages  int
	Query       string
	WarehouseID int64
	NoticeType  string
	NoticeMsg   string
}

// VendorInventory renders the main vendor inventory page.
templ VendorInventory(data VendorInventoryData, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorInventoryTable(data)
	} else {
		@layouts.VendorShell("المخزون والأرصدة | Inventory & Stock", "inventory", lang, dir) {
			<div class="page-container" x-data="{ adjustModal: false, selectedStock: { id: 0, variantName: '', currentQty: 0 }, transferModal: false, transferStock: { id: 0, variant_id: 0, product_id: 0, name: '', from_wh_id: 0, from_wh_name: '', qty: 0 } }">
				
				<!-- Notices -->
				if data.NoticeMsg != "" {
					if data.NoticeType == "error" {
						<div class="alert alert-danger mb-4 d-flex items-center gap-3 p-4">
							<span class="text-xl">@components.IconAlert("icon-sm")</span>
							<span class="font-bold text-sm">{ data.NoticeMsg }</span>
						</div>
					} else {
						<div class="alert alert-success mb-4 d-flex items-center gap-3 p-4">
							<span class="text-xl">@components.IconCheckCircle("icon-sm")</span>
							<span class="font-bold text-sm">{ data.NoticeMsg }</span>
						</div>
					}
				}

				<!-- Header -->
				<div class="glass-panel p-6 mb-0">
					<div class="flex-between items-center flex-wrap gap-4">
						<div class="stack-sm">
							<div class="d-flex items-center gap-3 mb-1">
								<div class="user-avatar-badge text-xl">
									@components.IconBarChart("icon-sm")
								</div>
								<h1 class="text-2xl font-black text-primary m-0">أرصدة المخازن والتشغيلات</h1>
							</div>
							<p class="text-sm text-secondary m-0">
								مراقبة الكميات المتاحة في المخازن، إدارة التشغيلات، وتسوية الأرصدة في الوقت الفعلي.
							</p>
						</div>
						<div class="d-flex items-center gap-3 flex-wrap">
							<a href="/vendor/warehouses" class="btn btn-secondary font-bold gap-2">
								@components.IconBuilding("icon-xs")
								<span>مخازن المنشأة</span>
							</a>
							<a href="/vendor/transfers" class="btn btn-secondary font-bold gap-2">
								@components.IconRefresh("icon-xs")
								<span>سجلات حركة المخازن</span>
							</a>
							<a href="/vendor/saving-products" class="btn btn-primary font-bold gap-2">
								@components.IconPlus("icon-xs")
								<span>إدارة أصناف المورد</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Inventory Metrics -->
				<div class="dashboard-stat-grid cols-4 mb-0">
					<div class="stat-card-3d">
						<div class="stat-card-label">إجمالي الأصناف بالمخزن</div>
						<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", data.Total) }</div>
					</div>

					<div class="stat-card-3d">
						<div class="stat-card-label text-success">إجمالي العبوات المتوفرة</div>
						<div class="stat-card-value text-success tabular-nums">
							{ fmt.Sprintf("%d", func() int {
								total := 0
								for _, s := range data.AllStocks {
									total += s.Quantity
								}
								return total
							}()) }
						</div>
					</div>

					<div class="stat-card-3d">
						<div class="stat-card-label text-warning">تنبيهات انخفاض المخزون</div>
						<div class="stat-card-value text-warning tabular-nums">
							{ fmt.Sprintf("%d", func() int {
								low := 0
								for _, s := range data.AllStocks {
									if s.Quantity <= s.MinThreshold {
										low++
									}
								}
								return low
							}()) }
						</div>
					</div>

					<div class="stat-card-3d">
						<div class="stat-card-label text-brand">المخازن المغذية</div>
						<div class="stat-card-value text-brand tabular-nums">{ fmt.Sprintf("%d", len(data.Warehouses)) }</div>
					</div>
				</div>

				<!-- Filter & Rows-Per-Page Form -->
				<div class="filter-bar">
					<form method="GET" action="/vendor/inventory" class="d-flex items-center gap-3 flex-wrap m-0">
						<div class="flex-1">
							<input
								type="text"
								name="q"
								value={ data.Query }
								placeholder="بحث باسم الصنف، كود التشغيلة، أو رقم الباركود..."
								class="form-input text-xs w-full"
							/>
						</div>

						<div class="stack-sm">
							<select name="warehouse_id" onchange="this.form.submit()" class="form-input text-xs w-full">
								<option value="">كافة المخازن ({ fmt.Sprintf("%d", len(data.Warehouses)) })</option>
								for _, wh := range data.Warehouses {
									<option value={ fmt.Sprintf("%d", wh.ID) } selected?={ data.WarehouseID == wh.ID }>
										{ wh.Name }
									</option>
								}
							</select>
						</div>

						<input type="hidden" name="limit" value={ fmt.Sprintf("%d", data.PerPage) }/>

						<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-4">
							<span>بحث</span>
						</button>

						if data.Query != "" || data.WarehouseID > 0 {
							<a href="/vendor/inventory" class="btn btn-secondary btn-sm text-xs">
								<span>إلغاء</span>
							</a>
						}
					</form>
				</div>

				<!-- Inventory Table Card -->
				<div class="glass-panel p-0 mb-0 overflow-hidden">
					<div class="stack-sm" id="vendor-inventory-content">
						@VendorInventoryTable(data)
					</div>
				</div>

				<!-- Modals Component (Adjust Stock Modal & Transfer Stock Modal) -->
				@VendorInventoryModals(data)

			</div>
		}
	}
}
