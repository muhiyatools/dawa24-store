package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorInventory(stocks []*inventory.Stock, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorInventoryTable(stocks)
	} else {
		@layouts.VendorShell("المخزون والأرصدة | Inventory & Stock", "inventory", lang, dir) {
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">أرصدة المخازن والفروع</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">مراقبة الكميات المتاحة والمحجوزة للطلبيات في الوقت الفعلي</p>
				</div>
				<div style="display:flex; gap:0.75rem;">
					<a href="/vendor/transfers" class="btn btn-secondary">
						@components.IconRefresh("icon-xs")
						<span>تحويل بين المخازن</span>
					</a>
					<a href="/vendor/ingest" class="btn btn-primary">
						@components.IconUpload("icon-xs")
						<span>استيراد ملف أرصدة</span>
					</a>
				</div>
			</div>

			<div id="vendor-inventory-content">
				@VendorInventoryTable(stocks)
			</div>
		}
	}
}

templ VendorInventoryTable(stocks []*inventory.Stock) {
	if len(stocks) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد أرصدة مسجلة بالمخزن",
			Message:     "لم يتم تسجيل أي تشغيلات أو كميات مخزون بعد.",
			ActionLabel: "رفع ملف مخزون",
		})
	} else {
		<div class="card" style="padding:0; overflow:hidden; margin-bottom:0;">
			<table class="data-table">
				<thead>
					<tr>
						<th>المنتج / العبوة</th>
						<th>المخزن / الفرع</th>
						<th>الرصيد المتاح</th>
						<th>حد إعادة الطلب</th>
						<th>إجراءات</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range stocks {
						<tr>
							<td style="font-weight:700; color:var(--neutral-900);">
								Variant #{ fmt.Sprintf("%d", s.ProductVariantID) }
							</td>
							<td style="color:var(--neutral-600);">
								Warehouse #{ fmt.Sprintf("%d", s.WarehouseID) }
							</td>
							<td>
								<span class="badge badge-emerald tabular-nums" style="font-size:0.85rem; font-weight:700;">
									{ fmt.Sprintf("%d", s.Quantity) } عبوة
								</span>
							</td>
							<td>
								<span class="badge badge-amber tabular-nums" style="font-size:0.85rem;">
									{ fmt.Sprintf("%d", s.MinThreshold) }
								</span>
							</td>
							<td>
								@components.ModalTrigger(fmt.Sprintf("adjust-%d", s.ID), "btn btn-secondary btn-sm") {
									تعديل
								}
								@components.Modal(components.ModalProps{ ID: fmt.Sprintf("adjust-%d", s.ID), Title: "تعديل الرصيد", Size: "sm" }) {
									<form method="POST" action={ fmt.Sprintf("/vendor/inventory/%d/adjust", s.ID) } style="display:flex; flex-direction:column; gap:0.9rem;">
										<div class="form-group" style="margin-bottom:0;">
											<label class="form-label">التعديل (+/-)</label>
											<input type="number" name="delta" required class="form-input tabular-nums" placeholder="+10 أو -5" />
										</div>
										<div class="form-group" style="margin-bottom:0;">
											<label class="form-label">السبب</label>
											<input type="text" name="reason" class="form-input" placeholder="جرد / تلف / تسوية" />
										</div>
										<button type="submit" class="btn btn-primary" style="justify-content:center;">حفظ التعديل</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
