package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/ingest"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorIngestPage renders the server-driven vendor catalog ingestion wizard (Plan V5 Phase 4 §4.2).
templ VendorIngestPage(sessions []*ingest.ImportSession, currentSession *ingest.ImportSession, rows []*ingest.ImportRow, lang, dir string) {
	@layouts.VendorShell("استيراد وتحديث كتالوج الأدوية والأرصدة", "ingest", lang, dir) {
		<div style="max-width:1160px; margin:0 auto 4rem auto; display:flex; flex-direction:column; gap:2rem;">
			
			<!-- Header & Actions Bar -->
			<div class="card" style="margin-bottom:0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-sm);">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
						<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
							@components.IconUpload("icon-sm")
						</div>
						<h1 style="font-size:1.85rem; font-weight:800; color:var(--text); margin:0;">
							استيراد وتحديث كتالوج الأدوية والأرصدة
						</h1>
					</div>
					<p style="color:var(--text-secondary); font-size:0.925rem; margin:0;">
						معالج الاستيراد الذكي لمطابقة آلاف الأصناف بالباركود وتحديث الأسعار والأرصدة بالـ Chunk بدون استهلاك ذاكرة.
					</p>
				</div>

				<div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
					<a href="/vendor/ingest" class="btn btn-secondary" style="font-weight:700; font-size:0.875rem;">
						@components.IconPlus("icon-xs")
						<span>استيراد ملف جديد</span>
					</a>
				</div>
			</div>

			<!-- Stepper Indicator -->
			<div class="card" style="margin-bottom:0; padding:2.5rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-sm);">
				<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem; margin-bottom:2.5rem; border-bottom:1px solid var(--border); padding-bottom:1.5rem;">
					<div style={ templ.KV("border-inline-start:3px solid var(--accent); padding-inline-start:0.75rem;", currentSession == nil), templ.KV("opacity:0.6; padding-inline-start:0.75rem;", currentSession != nil) }>
						<div style="font-size:0.8rem; color:var(--accent); font-weight:800;">الخطوة 1</div>
						<div style="font-weight:700; font-size:1rem; color:var(--text);">اختيار ورفع ملف الأرصدة</div>
					</div>

					<div style={ templ.KV("border-inline-start:3px solid var(--accent); padding-inline-start:0.75rem;", currentSession != nil && currentSession.Status == ingest.StatusPending), templ.KV("opacity:0.6; padding-inline-start:0.75rem;", currentSession == nil || currentSession.Status != ingest.StatusPending) }>
						<div style="font-size:0.8rem; color:var(--accent); font-weight:800;">الخطوة 2</div>
						<div style="font-weight:700; font-size:1rem; color:var(--text);">مطابقة الأعمدة والبيانات</div>
					</div>

					<div style={ templ.KV("border-inline-start:3px solid var(--accent); padding-inline-start:0.75rem;", currentSession != nil && currentSession.Status == ingest.StatusCompleted), templ.KV("opacity:0.6; padding-inline-start:0.75rem;", currentSession == nil || currentSession.Status != ingest.StatusCompleted) }>
						<div style="font-size:0.8rem; color:var(--accent); font-weight:800;">الخطوة 3</div>
						<div style="font-weight:700; font-size:1rem; color:var(--text);">تأكيد وتفعيل الأسعار للمتجر</div>
					</div>
				</div>

				<!-- Step 1: Upload Dropzone (when no active session) -->
				if currentSession == nil {
					<div>
						<form method="POST" action="/vendor/ingest/upload" enctype="multipart/form-data">
							<div style="border:2px dashed var(--accent); border-radius:var(--radius-xl); padding:3.5rem 2rem; text-align:center; background:var(--surface-sunken); margin-bottom:1.5rem;">
								@components.IconUpload("icon-lg")
								<h3 style="font-weight:800; color:var(--text); font-size:1.2rem; margin:1rem 0 0.5rem 0;">اختر ملف Excel أو CSV أو اسحبه هنا</h3>
								<p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:1.5rem;">الصيغ المدعومة: .xlsx, .xls, .csv (حتى 50,000 صنف معالجة متدفقة بدون استهلاك ذاكرة).</p>
								<input type="file" name="file" accept=".xlsx,.xls,.csv" required class="form-control" style="max-width:380px; margin:0 auto;" />
							</div>

							<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
								<div style="font-size:0.85rem; color:var(--text-secondary);">
									الأعمدة المقترحة: <strong>اسم الصنف (Name)</strong>، <strong>الباركود (Barcode)</strong>، <strong>السعر (Price)</strong>، <strong>الرصيد (Quantity)</strong>.
								</div>
								<button type="submit" class="btn btn-primary" style="padding:0.75rem 2.25rem; font-weight:800;">
									<span>رفع الملف وبدء الاستيراد التدريجي</span>
									@components.IconArrowLeft("icon-xs")
								</button>
							</div>
						</form>
					</div>
				}

				<!-- Step 2: Mapping / Review (when session is pending/processing) -->
				if currentSession != nil && currentSession.Status != ingest.StatusCompleted {
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
							<div>
								<h3 style="font-size:1.2rem; font-weight:800; color:var(--text); margin:0;">
									جلسة استيراد #{ fmt.Sprintf("%d", currentSession.ID) } — مراجعة وتأكيد الأصناف
								</h3>
								<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.25rem;">
									تمت قراءة البيانات بنجاح وتجهيز { fmt.Sprintf("%d", len(rows)) } صنف للمطابقة.
								</p>
							</div>
							<div style="display:flex; gap:0.5rem;">
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%d/cancel", currentSession.ID)) }>
									<button type="submit" class="btn btn-secondary btn-sm">إلغاء الجلسة</button>
								</form>
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%d/commit", currentSession.ID)) }>
									<button type="submit" class="btn btn-primary btn-sm" style="font-weight:700;">
										@components.IconCheck("icon-xs")
										<span>تأكيد وتفعيل الأصناف في المتجر</span>
									</button>
								</form>
							</div>
						</div>

						<!-- Staged Rows Table -->
						<div class="table-container" style="margin-bottom:1.75rem;">
							<table class="data-table">
								<thead>
									<tr>
										<th>#</th>
										<th>اسم الصنف في الملف</th>
										<th>الاسم المعياري المقترح</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									if len(rows) > 0 {
										for _, r := range rows {
											<tr>
												<td>{ fmt.Sprintf("%d", r.RowNumber) }</td>
												<td><strong>{ fmt.Sprintf("%v", r.RawData["product_name"]) }</strong></td>
												<td style="color:var(--accent); font-weight:600;">{ r.NormalizedName }</td>
												<td><span class="badge badge-success">{ r.Status }</span></td>
											</tr>
										}
									} else {
										<tr>
											<td colspan="4" style="text-align:center; padding:1.5rem; color:var(--text-secondary);">جاري تجهيز وبث السجلات...</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				}

				<!-- Step 3: Success Confirmation (when session is completed) -->
				if currentSession != nil && currentSession.Status == ingest.StatusCompleted {
					<div style="text-align:center; padding:2rem 1rem;">
						<div style="width:64px; height:64px; border-radius:var(--radius-full); background:var(--surface-sunken); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 1.25rem auto; border:1px solid var(--border);">
							@components.IconCheckCircle("icon-lg")
						</div>
						<h3 style="font-size:1.6rem; font-weight:800; color:var(--text); margin:0 0 0.5rem 0;">
							تم استيراد وتفعيل الأرصدة بنجاح!
						</h3>
						<p style="font-size:0.95rem; color:var(--text-secondary); max-width:560px; margin:0 auto 2rem auto; line-height:1.6;">
							تمت مطابقة وحفظ كافة الأصناف وعروض الأسعار والكميات في متجر شركتك، وأصبحت متاحة للطلب الفوري.
						</p>

						<div style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
							<a href="/vendor/ingest" class="btn btn-secondary" style="font-weight:700;">
								استيراد ملف جديد
							</a>
							<a href="/vendor/products" class="btn btn-primary" style="font-weight:800;">
								<span>الانتقال لكتالوج منتجات المورد</span>
								@components.IconArrowLeft("icon-xs")
							</a>
						</div>
					</div>
				}
			</div>

			<!-- Previous Import Sessions Log -->
			<div class="card" style="margin-bottom:0; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-sm);">
				<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.5rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--surface-sunken); color:var(--text); display:flex; align-items:center; justify-content:center; border:1px solid var(--border);">
						@components.IconFolder("icon-sm")
					</div>
					<h2 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
						سجل عمليات الاستيراد والمزامنة السابقة
					</h2>
				</div>

				if len(sessions) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد عمليات استيراد سابقة",
						Message: "يمكنك رفع ملف الأرصدة والأسعار الخاص بشركتك للبدء في البيع فوراً.",
					})
				} else {
					<div class="table-container">
						<table class="data-table">
							<thead>
								<tr>
									<th>رقم الجلسة</th>
									<th>الحالة</th>
									<th>تاريخ البدء</th>
									<th>الإجراء</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range sessions {
									<tr>
										<td><strong>#{ fmt.Sprintf("%d", s.ID) }</strong></td>
										<td>
											if s.Status == ingest.StatusCompleted {
												<span class="badge badge-success">مكتمل ومفعل</span>
											} else if s.Status == ingest.StatusProcessing {
												<span class="badge badge-primary">قيد المعالجة</span>
											} else {
												<span class="badge badge-secondary">{ string(s.Status) }</span>
											}
										</td>
										<td>{ s.CreatedAt.Format("2006-01-02 15:04") }</td>
										<td>
											<a href={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%d", s.ID)) } class="btn btn-secondary btn-sm">
												<span>فتح الجلسة</span>
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
