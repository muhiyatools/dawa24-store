package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/ingest"

	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// The vendor catalogue import.
//
// One page that renders whichever stage the import has reached, because the
// stage lives on the session rather than in the URL: a vendor who reloads, or
// comes back to yesterday's link, lands where they left off.

templ VendorIngestPage(view VendorImportView, lang, dir string) {
	@layouts.VendorShell("استيراد الكتالوج الذكي | Dawa24", "ingest", lang, dir) {
		<div class="vendor-ingest-container">
			@components.PageHeader(components.PageHeaderProps{
				Title:    "استيراد الكتالوج الذكي",
				Subtitle: "ارفع ملف الأسعار، راجع ربط الأعمدة، واعتمد الإعدادات قبل أن يُكتب أي صنف",
			}) {
				<div class="row-center">
					<a href="/vendor/products" class="btn btn-secondary btn-sm font-bold">
						@components.IconPackage("icon-xs")
						<span>أصناف المورد</span>
					</a>
				</div>
			}
			<div class="wizard">
				@WizardRail(VendorRail(view.WizardStep()))
				if view.NoticeMessage != "" {
					@importNotice(view.NoticeType, view.NoticeMessage)
				}
				if view.Fatal != "" {
					@importFatal(view.Fatal, view.Session)
				} else if !view.Started() {
					@importUploadStage(view)
				} else {
					switch view.Phase() {
						case ingest.PhaseMapping:
							@importMappingStage(view)
						case ingest.PhaseSettings:
							@importSettingsStage(view)
						case ingest.PhaseReview:
							@importReviewStage(view)
						case ingest.PhaseConfirm:
							@importConfirmStage(view)
						case ingest.PhaseProcessing:
							@importProcessingStage(view)
						default:
							@importResultsStage(view)
					}
				}
			</div>
		</div>
	}
}

templ importNotice(kind, message string) {
	<div
		class={ "alert",
			templ.KV("alert-danger", kind == "error"),
			templ.KV("alert-success", kind == "success"),
			templ.KV("alert-info", kind != "error" && kind != "success") }
		role="alert"
	>
		{ message }
	</div>
}

templ importFatal(message string, session *ingest.Session) {
	<div class="glass-panel p-6">
		<h2 class="wiz-head">تعذر قراءة الملف</h2>
		<p class="wiz-sub">{ message }</p>
		<div class="row-center">
			<a href="/vendor/ingest" class="btn btn-primary">رفع ملف آخر</a>
			if session != nil {
				<form class="stack-md" method="POST" action={ templ.SafeURL("/vendor/ingest/" + session.PublicID + "/cancel") }>
					<button type="submit" class="btn btn-ghost">إلغاء هذه الجلسة</button>
				</form>
			}
		</div>
	</div>
}

// --- stage 1: upload -------------------------------------------------------

templ importUploadStage(view VendorImportView) {
	<form class="stack-md" method="POST" action="/vendor/ingest/upload" enctype="multipart/form-data" hx-boost="false" id="import-upload-form">
		<div class="glass-panel p-6">
			<h2 class="wiz-head">1. اختر ملف الكتالوج</h2>
			<p class="wiz-sub">
				الصيغ المدعومة: Excel الحديث (.xlsx) وExcel القديم (.xls) وCSV وجداول HTML.
				لا يشترط ترتيب معين للأعمدة ولا أسماء محددة لها — سيتعرف النظام عليها من العناوين
				ومن محتوى الصفوف معاً، وستراجع النتيجة بنفسك قبل أن يُكتب أي شيء.
			</p>
			<label class="wiz-drop" id="import-drop">
				<input type="file" name="file" accept=".xlsx,.xls,.csv,.txt" required id="import-file-input"/>
				<span class="wiz-drop-icon" aria-hidden="true">@components.IconUpload("icon-sm")</span>
				<span class="wiz-drop-title" id="import-drop-title">اسحب الملف إلى هنا أو اضغط للاختيار</span>
				<span class="wiz-drop-text" id="import-drop-text">الحد الأقصى 25 ميجابايت</span>
			</label>
			<div class="wiz-actions">
				<span class="wiz-actions-note">
					لن يتم حفظ أي صنف الآن — الخطوة التالية هي مراجعة ربط الأعمدة.
				</span>
				<div class="row-center">
					<a href="/vendor/ingest/sample.csv" class="btn btn-ghost">تنزيل ملف نموذجي</a>
					<button type="submit" class="btn btn-primary" id="import-submit-btn">
						<span id="import-submit-text">تحليل الملف</span>
					</button>
				</div>
			</div>
		</div>
	</form>
	if len(view.Recent) > 0 {
		@importHistory(view.Recent)
	}
	<script>
		(function () {
			const input = document.getElementById('import-file-input');
			const drop = document.getElementById('import-drop');
			const title = document.getElementById('import-drop-title');
			const text = document.getElementById('import-drop-text');
			if (!input || !drop) return;
			input.addEventListener('change', function () {
				if (!this.files || !this.files[0]) return;
				const f = this.files[0];
				title.textContent = '' + f.name;
				text.textContent = 'الحجم: ' + (f.size / 1048576).toFixed(2) + ' ميجابايت — جاهز للتحليل';
				drop.classList.add('is-over');
			});
			['dragenter', 'dragover'].forEach(function (name) {
				drop.addEventListener(name, function (e) { e.preventDefault(); drop.classList.add('is-dragover'); });
			});
			['dragleave', 'drop'].forEach(function (name) {
				drop.addEventListener(name, function (e) { e.preventDefault(); drop.classList.remove('is-dragover'); });
			});
			const form = document.getElementById('import-upload-form');
			form.addEventListener('submit', function () {
				const btn = document.getElementById('import-submit-btn');
				const label = document.getElementById('import-submit-text');
				if (btn) { btn.disabled = true; }
				if (label) { label.textContent = '⏳ جارٍ تحليل الملف...'; }
			});
		})();
	</script>
}

templ importHistory(recent []*ingest.Session) {
	<div class="glass-panel p-6">
		<h2 class="wiz-head">عمليات الاستيراد السابقة</h2>
		<div class="table-container">
			<table class="data-table">
				<thead>
					<tr>
						<th>الملف</th>
						<th>الحالة</th>
						<th>أضيف</th>
						<th>حُدّث</th>
						<th>تخطي</th>
						<th>أخطاء</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, s := range recent {
						<tr>
							<td class="font-bold">{ s.Filename }</td>
							<td><span class="badge badge-slate text-xs">{ s.Phase.Label() }</span></td>
							<td>{ fmt.Sprint(s.InsertedRows) }</td>
							<td>{ fmt.Sprint(s.UpdatedRows) }</td>
							<td>{ fmt.Sprint(s.SkippedRows) }</td>
							<td>{ fmt.Sprint(s.ErrorRows) }</td>
							<td class="col-actions">
								<a class="btn btn-ghost btn-sm" href={ templ.SafeURL("/vendor/ingest/" + s.PublicID) }>فتح</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
