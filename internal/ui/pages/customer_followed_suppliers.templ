package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerFollowedSuppliers(suppliers []*org.Organization, query, sort, lang, dir string) {
	@layouts.ShellFor(i18n.T(lang, "followed.page_title"), "followed", lang, dir, authctx.FromContext(ctx)) {
		<div class="page-container">
			
			<!-- Page Header -->
			<div class="glass-panel p-6 mb-6 rounded-2xl border shadow-xs">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="stack-xs">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconBuilding("icon-sm")
							</div>
							<h1 class="page-title text-2xl font-black text-primary m-0">
								{ i18n.T(lang, "followed.page_title") }
							</h1>
						</div>
						<p class="text-sm text-secondary m-0 max-w-2xl leading-relaxed">
							{ i18n.T(lang, "followed.banner_desc") }
						</p>
					</div>

					<div class="d-flex items-center gap-2.5 flex-wrap">
						<span class="badge badge-primary text-xs font-bold tabular-nums px-3 py-1.5">
							{ fmt.Sprintf(i18n.T(lang, "followed.count_badge"), len(suppliers)) }
						</span>
						<a href="/suppliers" class="btn btn-secondary btn-sm font-bold gap-2 shadow-xs">
							@components.IconSearch("icon-xs")
							<span>{ i18n.T(lang, "followed.directory_btn") }</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Search & Sort Filter Toolbar -->
			<div class="glass-panel p-4 mb-6 flex-between items-center flex-wrap gap-4 rounded-2xl border shadow-xs">
				<form method="GET" action="/suppliers/followed" class="d-flex items-center gap-3 flex-wrap flex-1 m-0" id="followed-filter-form">
					<div class="position-relative flex-1 min-w-0">
						<input
							type="text"
							name="q"
							value={ query }
							placeholder={ i18n.T(lang, "followed.search_placeholder") }
							class="form-input text-xs w-full"
						/>
					</div>

					<div class="d-flex items-center gap-2 flex-shrink-0">
						<label class="text-xs text-muted font-bold whitespace-nowrap">{ i18n.T(lang, "followed.sort_label") }</label>
						<select
							name="sort"
							class="form-select text-xs"
							onchange="document.getElementById('followed-filter-form').submit()"
						>
							<option value="newest" selected?={ sort == "" || sort == "newest" }>{ i18n.T(lang, "followed.sort_newest") }</option>
							<option value="oldest" selected?={ sort == "oldest" }>{ i18n.T(lang, "followed.sort_oldest") }</option>
							<option value="name_asc" selected?={ sort == "name_asc" }>{ i18n.T(lang, "followed.sort_name_asc") }</option>
							<option value="name_desc" selected?={ sort == "name_desc" }>{ i18n.T(lang, "followed.sort_name_desc") }</option>
						</select>
					</div>

					<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-3">
						<span>{ i18n.T(lang, "followed.apply_btn") }</span>
					</button>

					if query != "" || (sort != "" && sort != "newest") {
						<a href="/suppliers/followed" class="btn btn-secondary btn-sm text-xs">
							<span>{ i18n.T(lang, "followed.clear_filter") }</span>
						</a>
					}
				</form>
			</div>

			if len(suppliers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       i18n.T(lang, "followed.empty_title"),
					Message:     i18n.T(lang, "followed.empty_desc"),
					ActionLabel: i18n.T(lang, "followed.browse_btn"),
					ActionURL:   "/suppliers",
				})
			} else {
				<div class="supplier-cards-grid mb-6">
					for _, s := range suppliers {
						if s != nil {
							<div class="glass-panel p-5 rounded-2xl border shadow-xs d-flex flex-col justify-between hover-shadow-md transition-all">
								<div>
									<!-- Header with Emblem and Verified Badge -->
									<div class="flex-between items-start gap-3 mb-3">
										<div class="d-flex items-center gap-2.5 min-w-0">
											<div class="w-11 h-11 rounded-xl bg-primary-subtle text-primary flex-center flex-shrink-0">
												@components.IconBuilding("icon-sm")
											</div>
											<div class="stack-2xs min-w-0">
												<h3 class="font-extrabold text-sm text-primary m-0 line-clamp-1">
													<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.ID)) } class="text-primary text-decoration-none hover-text-brand">
														if s.TradeName.Get(i18n.Lang(lang)) != "" {
															{ s.TradeName.Get(i18n.Lang(lang)) }
														} else {
															{ s.LegalName }
														}
													</a>
												</h3>
												<div>
													<span class="badge badge-emerald text-2xs font-bold py-0 px-1.5">{ i18n.T(lang, "suppliers.verified_badge") }</span>
												</div>
											</div>
										</div>

										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/follow", s.ID)) } class="m-0">
											<button type="submit" class="btn btn-secondary btn-icon btn-sm text-rose" title={ i18n.T(lang, "supplier_profile.unfollow") }>
												@components.IconHeart("icon-xs")
											</button>
										</form>
									</div>

									<!-- Legal Info -->
									<div class="p-3 bg-surface-sunken rounded-xl border stack-2xs text-xs mb-3">
										if s.LegalName != "" && s.LegalName != s.TradeName.Get(i18n.Lang(lang)) {
											<div class="text-2xs line-clamp-1">
												<span class="text-muted font-bold">{ i18n.T(lang, "supplier_profile.legal_name_label") }</span>
												<strong class="text-primary">{ s.LegalName }</strong>
											</div>
										}
										if s.CommercialRegister != "" {
											<div class="text-2xs">
												<span class="text-muted font-bold">{ i18n.T(lang, "common.commercial_register") }: </span>
												<strong class="tabular-nums font-mono text-primary">{ s.CommercialRegister }</strong>
											</div>
										}
									</div>
								</div>

								<!-- Bottom Actions -->
								<div class="flex-between items-center gap-2 pt-3 border-t">
									<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.ID)) } class="btn btn-primary btn-sm font-bold flex-1 justify-center gap-1 shadow-2xs text-xs">
										@components.IconPackage("icon-xs")
										<span>{ i18n.T(lang, "suppliers.view_catalog_btn") }</span>
									</a>
									<a href="https://wa.me/201012345678" target="_blank" rel="noopener" class="btn btn-secondary btn-sm btn-icon text-emerald" title={ i18n.T(lang, "suppliers.whatsapp_tooltip") }>
										@components.IconWhatsApp("icon-xs")
									</a>
								</div>
							</div>
						}
					}
				</div>
			}
		</div>
	}
}