package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerFollowedSuppliers(suppliers []*org.Organization, lang, dir string) {
	@layouts.CustomerShell("الموردون المتابعون", "followed", lang, dir, nil) {
		<div class="followed-suppliers-container">
			
			<!-- Page Header -->
			<div>
				<div>
					<div>
						<div>
							@components.IconBuilding("icon-xs")
						</div>
						<h2>
							الموردون المتابعون
						</h2>
					</div>
					<p>
						الوصول السريع لكتالوجات شركات التوزيع المفضلة ومتابعة عروض التوريد الخاصة بصيدليتك.
					</p>
				</div>

				<a href="/suppliers" class="btn btn-secondary fw-700">
					@components.IconSearch("icon-xs")
					<span>دليل الموردين المعتمدين</span>
				</a>
			</div>

			if len(suppliers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لم تقم بمتابعة أي مورد بعد",
					Message:     "عند متابعة شركات الأدوية والموزعين المعتمدين، ستتمكن من الوصول السريع لكتالوجاتهم وأسعارهم الحصرية والتوريد المباشر.",
					ActionLabel: "تصفح دليل الموردين المعتمدين",
				})
			} else {
				<div>
					for _, s := range suppliers {
						<div class="card">
							<div>
								<!-- Header with Emblem and Verified Badge -->
								<div>
									<div class="row-center">
										<div>
											@components.IconBuilding("icon-md")
										</div>
										<div>
											<h3>
												{ s.TradeName.Get(i18n.Lang(lang)) }
											</h3>
											<div>
												<span class="badge badge-emerald">مورد معتمد</span>
											</div>
										</div>
									</div>

									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/follow", s.ID)) } class="m-0">
										<button type="submit" class="btn btn-secondary btn-icon" title="إلغاء المتابعة">
											@components.IconHeart("icon-xs")
										</button>
									</form>
								</div>

								<!-- Legal Info -->
								<div>
									if s.LegalName != "" && s.LegalName != s.TradeName.Get(i18n.Lang(lang)) {
										<div>
											<span class="text-muted">الاسم القانوني:</span>
											<strong class="text-primary">{ s.LegalName }</strong>
										</div>
									}
									if s.CommercialRegister != "" {
										<div>
											<span class="text-muted">السجل التجاري:</span>
											<strong class="tabular-nums text-primary">{ s.CommercialRegister }</strong>
										</div>
									}
								</div>
							</div>

							<!-- Bottom Actions -->
							<div>
								<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.ID)) } class="btn btn-primary btn-sm">
									@components.IconPackage("icon-xs")
									<span>عرض الكتالوج والطلب</span>
								</a>
								<a href="https://wa.me/201012345678" target="_blank" rel="noopener" class="btn btn-secondary btn-sm btn-icon text-success" title="تواصل عبر واتساب">
									@components.IconWhatsApp("icon-xs")
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}
