package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/smartorder"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// SmartOrderReviewLine is one line as the review screen shows it.
type SmartOrderReviewLine struct {
	Line           *smartorder.Line
	VendorName     string
	AvailableStock int
	UnitPrice      money.Amount
	DiscountPct    float64
	LineNet        money.Amount
	DecidedBy      smartorder.DecidedBy
	SkippedName    string
	SkippedExcess  float64
	Alternatives   int
}

// SmartOrderReviewGroup is the lines going to one supplier.
type SmartOrderReviewGroup struct {
	VendorName string
	Lines      []SmartOrderReviewLine
	Subtotal   money.Amount
}

// SmartOrderReviewData is the review screen's payload.
type SmartOrderReviewData struct {
	Run        *smartorder.Run
	Groups     []SmartOrderReviewGroup
	Excluded   []*smartorder.Line
	BranchName string
	Stale      []smartorder.StaleLine
	Error      string
}

func decidedLabel(d smartorder.DecidedBy) string {
	switch d {
	case smartorder.DecidedLowestPrice:
		return "أقل سعر"
	case smartorder.DecidedHighestDiscount:
		return "أعلى خصم"
	case smartorder.DecidedFollowedSuppliers:
		return "مورد مفضل"
	case smartorder.DecidedOnlyCandidate:
		return "المورد الوحيد"
	case smartorder.DecidedUser:
		return "اختيار يدوي"
	case smartorder.DecidedDefault:
		return "تلقائي"
	}
	return "—"
}

func totalOrderableItems(groups []SmartOrderReviewGroup) int {
	total := 0
	for _, g := range groups {
		total += len(g.Lines)
	}
	return total
}

// SmartOrderReviewPage is step 5: review and place.
templ SmartOrderReviewPage(lang, dir string, data SmartOrderReviewData) {
	@layouts.CustomerShell("مراجعة وتأكيد الطلب الذكي", "purchase-request", lang, dir, nil) {
		<div class="container-fluid">
			
			<!-- Page Header Strip -->
			<div>
				<div>
					<nav>
						<a href="/">الرئيسية</a>
						<span>/</span>
						<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", data.Run.PublicID)) }>نتائج المطابقة</a>
						<span>/</span>
						<span>مراجعة الطلب</span>
					</nav>
					<h1>
						مراجعة وتأكيد طلب الشراء — { data.Run.RunNumber }
					</h1>
					<p>
						تدقيق الأصناف والموردين والكميات المطلوبة والأسعار قبل الاعتماد النهائي وإرسال أوامر الشراء.
					</p>
				</div>
				<div>
					<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", data.Run.PublicID)) } class="btn btn-secondary btn-sm fw-700">
						<span>← العودة لنتائج المطابقة</span>
					</a>
				</div>
			</div>

			@WizardRail(OrderRail(StepOrder))

			if data.Error != "" {
				<div>
					{ data.Error }
				</div>
			}

			if len(data.Stale) > 0 {
				<div>
					<strong>تنبيه: تغيّرت بعض عروض التوريد منذ إنشاء الطلب</strong>
					<p>
						لم يُستبدل أي مورد تلقائياً ولم يُحذف أي صنف. يرجى مراجعة الأصناف التالية:
					</p>
					<ul>
						for _, s := range data.Stale {
							<li>
								<strong>{ s.RawName }</strong> — { s.Detail }
							</li>
						}
					</ul>
				</div>
			}

			<!-- Summary Metrics Grid -->
			<div>
				@statCard("إجمالي قيمة الطلب", data.Run.EstimatedTotal.String() + " ج.م")
				@statCard("عدد الموردين", fmt.Sprintf("%d موردين", len(data.Groups)))
				@statCard("الأصناف الجاهزة للتوريد", fmt.Sprintf("%d صنف", totalOrderableItems(data.Groups)))
				@statCard("أصناف مستبعدة", fmt.Sprintf("%d صنف", len(data.Excluded)))
				@statCard("فرع التسليم", data.BranchName)
			</div>

			if data.Run.BudgetExceeded != nil && *data.Run.BudgetExceeded {
				<div>
					<strong>تجاوز الطلب الميزانية المحددة</strong>
					if data.Run.BudgetOverage != nil {
						<span> — بزيادة { data.Run.BudgetOverage.String() }</span>
					}
					<span>(يمكنك المتابعة أو تعديل الكميات أدناه).</span>
				</div>
			}

			<!-- Main Supplier Groups Review Tables -->
			if len(data.Groups) > 0 {
				<div class="so-review-lead">
					<strong class="so-review-lead-title">
						{ fmt.Sprintf("%d صنف جاهز للتوريد من %d مورد", totalOrderableItems(data.Groups), len(data.Groups)) }
					</strong>
					<span class="so-review-lead-hint">
						هذه هي الأصناف التي ستُطلب فعلياً. راجع الكميات والموردين، ثم اعتمد الطلب من الأسفل.
					</span>
				</div>
			} else {
				<div class="so-review-lead">
					<strong class="so-review-lead-title">لا يوجد أي صنف جاهز للتوريد في هذا الطلب</strong>
					<span class="so-review-lead-hint">
						راجع الأصناف المستبعدة أدناه واربط غير المطابق منها بالكتالوج، أو عد إلى شاشة نتائج المطابقة.
					</span>
				</div>
			}
			for _, g := range data.Groups {
				<div class="card">
					
					<!-- Group Header Strip -->
					<div>
						<div class="inline-row-06">
							<span>@components.IconBuilding("icon-sm")</span>
							<div>
								<div>
									{ g.VendorName }
								</div>
								<div>
									{ fmt.Sprintf("%d أصناف مطلوبة من هذا المورد", len(g.Lines)) }
								</div>
							</div>
						</div>
						<div class="d-flex items-center gap-3">
							<span>إجمالي المورد:</span>
							<span class="tabular-nums">
								{ g.Subtotal.String() } ج.م
							</span>
						</div>
					</div>

					<!-- 10-Column Master Responsive Table in Exact Specified Order -->
					<div class="table-responsive">
						<table class="data-table">
							<thead>
								<tr>
									<th>1. اسم الصنف</th>
									<th>2. كود الصنف (SKU)</th>
									<th>3. الكمية المطلوبة</th>
									<th>4. الصنف المطابق</th>
									<th>5. المورد</th>
									<th>6. الكمية المتاحة</th>
									<th class="td-numeric">7. سعر الجمهور</th>
									<th>8. نسبة الخصم</th>
									<th class="td-numeric">9. السعر بعد الخصم</th>
									<th>10. الحالة</th>
								</tr>
							</thead>
							<tbody>
								for _, l := range g.Lines {
									<tr>
										
										<!-- 1. Product Name -->
										<td class="pad-md">
											<div>
												{ l.Line.RawName }
											</div>
											if l.Line.RawBarcode != "" {
												<div>
													باركود: { l.Line.RawBarcode }
												</div>
											}
										</td>

										<!-- 2. SKU -->
										<td>
											if l.Line.RawSKU != "" {
												<span class="badge badge-slate">
													{ l.Line.RawSKU }
												</span>
											} else {
												<span>—</span>
											}
										</td>

										<!-- 3. Requested Quantity (with in-place stepper form) -->
										<td>
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/lines/%d/quantity", data.Run.PublicID, l.Line.ID)) }>
												<div>
													<button type="button" class="btn btn-ghost btn-xs" onclick="stepReviewQty(this, -1)">−</button>
													<input
														type="number"
														name="quantity"
														value={ fmt.Sprintf("%g", l.Line.EffectiveQty) }
														min="1"
														class="tabular-nums"
													
													/>
													<button type="button" class="btn btn-ghost btn-xs" onclick="stepReviewQty(this, 1)">+</button>
												</div>
												<button type="submit" class="btn btn-secondary btn-xs fw-700" title="حفظ الكمية">
													تعديل
												</button>
											</form>
										</td>

										<!-- 4. Matched Product -->
										<td class="pad-md">
											if l.Line.MatchedProductName != "" {
												<div>
													{ l.Line.MatchedProductName }
												</div>
												if l.Line.MatchedProductID != nil {
													<div>
														#{ fmt.Sprintf("%d", *l.Line.MatchedProductID) }
													</div>
												}
											} else {
												<span class="badge badge-rose">غير محدد</span>
											}
										</td>

										<!-- 5. Supplier & Selection Decision -->
										<td>
											<div>
												{ l.VendorName }
											</div>
											<div>
												<span class="badge badge-slate">
													{ decidedLabel(l.DecidedBy) }
												</span>
												if l.Alternatives > 0 {
													<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/lines/%d/candidates", data.Run.PublicID, l.Line.ID)) } class="btn btn-ghost btn-xs">
														{ fmt.Sprintf("بدلاء (%d)", l.Alternatives) }
													</a>
												}
											</div>
										</td>

										<!-- 6. Available Quantity -->
										<td>
											if l.AvailableStock > 0 {
												<span class="badge badge-emerald tabular-nums">
													{ fmt.Sprintf("%d", l.AvailableStock) } عبوة
												</span>
											} else {
												<span class="badge badge-rose">
													غير محدد
												</span>
											}
										</td>

										<!-- 7. Public Price -->
										<td class="td-numeric">
											<div class="tabular-nums font-mono">
												{ l.UnitPrice.String() } ج.م
											</div>
										</td>

										<!-- 8. Discount Percentage -->
										<td>
											if l.DiscountPct > 0 {
												<span class="badge badge-emerald tabular-nums">
													{ fmt.Sprintf("%.1f%%", l.DiscountPct) }
												</span>
											} else {
												<span class="text-secondary text-xs">0%</span>
											}
										</td>

										<!-- 9. Price After Discount (Subtotal) -->
										<td class="td-numeric">
											<div class="tabular-nums font-mono">
												{ l.LineNet.String() } ج.م
											</div>
										</td>

										<!-- 9. Status & Line Actions -->
										<td>
											<div>
												<span class="badge badge-emerald">
													جاهز للطلب 
												</span>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/lines/%d/remove", data.Run.PublicID, l.Line.ID)) }>
													<button type="submit" class="btn btn-ghost btn-xs text-danger" title="حذف الصنف من الطلب">
														@components.IconX("icon-sm")
													</button>
												</form>
											</div>
										</td>

									</tr>
								}
							</tbody>
						</table>
					</div>

				</div>
			}

			<!-- Everything that will not be ordered, folded away.

			     It is shown rather than omitted (FR-045) and closed rather than
			     shown open: the buyer is on this screen to place an order, and
			     a list of what failed sitting between them and the button reads
			     as a wall of problems on a tool they chose for its speed. The
			     count is on the closed summary, so nothing is a surprise. -->
			if len(data.Excluded) > 0 {
				<details class="so-blocked-panel">
					<summary class="so-blocked-summary">
						<span class="so-blocked-title">
							{ fmt.Sprintf("%d صنف مستبعد ولن يُطلب", len(data.Excluded)) }
						</span>
						<span class="so-blocked-hint">
							لم تكتمل شروط توريدها. اضغط لمراجعتها ومعالجتها قبل الاعتماد.
						</span>
					</summary>
					<div>
					<div>
						<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results?match=blocked", data.Run.PublicID)) } class="btn btn-secondary btn-xs fw-700">
							معالجة الأصناف ←
						</a>
					</div>

					<div class="table-responsive">
						<table class="data-table">
							<thead>
								<tr>
									<th>اسم الصنف المطلوب</th>
									<th>كود SKU</th>
									<th>الكمية</th>
									<th>سبب الاستبعاد / الحالة</th>
									<th>الإجراء</th>
								</tr>
							</thead>
							<tbody>
								for _, l := range data.Excluded {
									<tr class="rule-bottom">
										<td>
											{ l.RawName }
										</td>
										<td>
											if l.RawSKU != "" {
												<span class="badge badge-slate">{ l.RawSKU }</span>
											} else {
												<span>-</span>
											}
										</td>
										<td class="tabular-nums">
											{ fmt.Sprintf("%g", l.EffectiveQty) }
										</td>
										<td>
											<span style={ outcomeChip(l.Outcome) }>
												{ SmartOrderOutcomeLabel(l.Outcome) }
											</span>
										</td>
										<td>
											<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results?q=%s", data.Run.PublicID, l.RawName)) } class="btn btn-secondary btn-xs fw-700">
												ربط الصنف
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					</div>
				</details>
			}

			<!-- Bottom Sticky Placement Action Bar -->
			<div class="card">
				<div>
					<div>إجمالي الطلب الشامل:</div>
					<div class="tabular-nums">
						{ data.Run.EstimatedTotal.String() } <span>ج.م</span>
					</div>
					<div>
						{ fmt.Sprintf("سيتم إنشاء %d أوامر شراء منفصلة ومباشرة للموردين المحددين", len(data.Groups)) }
					</div>
				</div>

				<div>
					<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", data.Run.PublicID)) } class="btn btn-secondary fw-700">
						تعديل المطابقة
					</a>
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/finalize", data.Run.PublicID)) }>
						<button
							type="submit"
							class="btn btn-primary"
						
							disabled?={ len(data.Groups) == 0 }
						>
							<span>اعتماد الطلب وإرسال أوامر الشراء </span>
						</button>
					</form>
				</div>
			</div>

		</div>

		<script>
			function stepReviewQty(btn, delta) {
				const form = btn.closest('form');
				if (!form) return;
				const input = form.querySelector('input[name="quantity"]');
				if (input) {
					let val = parseInt(input.value, 10) || 1;
					val += delta;
					if (val < 1) val = 1;
					input.value = val;
				}
			}
		</script>
	}
}

