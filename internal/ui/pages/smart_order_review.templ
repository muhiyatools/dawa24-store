package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/smartorder"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// SmartOrderReviewLine is one line as the review screen shows it.
type SmartOrderReviewLine struct {
	Line           *smartorder.Line
	VendorName     string
	AvailableStock int
	UnitPrice      money.Amount
	DiscountPct    float64
	LineNet        money.Amount
	DecidedBy      smartorder.DecidedBy
	SkippedName    string
	SkippedExcess  float64
	Alternatives   int
}

// SmartOrderReviewGroup is the lines going to one supplier.
type SmartOrderReviewGroup struct {
	VendorName string
	Lines      []SmartOrderReviewLine
	Subtotal   money.Amount
}

// SmartOrderReviewData is the review screen's payload.
type SmartOrderReviewData struct {
	Run        *smartorder.Run
	Groups     []SmartOrderReviewGroup
	Excluded   []*smartorder.Line
	BranchName string
	Stale      []smartorder.StaleLine
	Error      string
}

func decidedLabel(d smartorder.DecidedBy) string {
	switch d {
	case smartorder.DecidedLowestPrice:
		return "أقل سعر"
	case smartorder.DecidedHighestDiscount:
		return "أعلى خصم"
	case smartorder.DecidedFollowedSuppliers:
		return "مورد مفضل"
	case smartorder.DecidedOnlyCandidate:
		return "المورد الوحيد"
	case smartorder.DecidedUser:
		return "اختيار يدوي"
	case smartorder.DecidedDefault:
		return "تلقائي"
	}
	return "—"
}

func totalOrderableItems(groups []SmartOrderReviewGroup) int {
	total := 0
	for _, g := range groups {
		total += len(g.Lines)
	}
	return total
}

// SmartOrderReviewPage is step 5: review and place.
templ SmartOrderReviewPage(lang, dir string, data SmartOrderReviewData) {
	@layouts.CustomerShell("مراجعة وتأكيد الطلب الذكي", "purchase-request", lang, dir, nil) {
		<div class="container-fluid so-review-page">
			
			<!-- Page Header Strip -->
			<div class="so-page-header">
				<div>
					<nav class="so-breadcrumbs">
						<a href="/">الرئيسية</a>
						<span>/</span>
						<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", data.Run.PublicID)) }>نتائج المطابقة</a>
						<span>/</span>
						<span class="so-breadcrumb-current">مراجعة الطلب</span>
					</nav>
					<h1 class="so-page-title">
						مراجعة وتأكيد طلب الشراء — { data.Run.RunNumber }
					</h1>
					<p class="so-page-subtitle">
						تدقيق الأصناف والموردين والكميات المطلوبة والأسعار قبل الاعتماد النهائي وإرسال أوامر الشراء.
					</p>
				</div>
				<div class="so-page-actions">
					<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", data.Run.PublicID)) } class="btn btn-secondary btn-sm fw-700">
						<span>← العودة لنتائج المطابقة</span>
					</a>
				</div>
			</div>

			@stepBar(5)

			if data.Error != "" {
				<div class="so-alert so-alert-error">
					{ data.Error }
				</div>
			}

			if len(data.Stale) > 0 {
				<div class="so-alert so-alert-warning so-stale-alert">
					<strong class="so-alert-title">تنبيه: تغيّرت بعض عروض التوريد منذ إنشاء الطلب</strong>
					<p class="so-alert-copy">
						لم يُستبدل أي مورد تلقائياً ولم يُحذف أي صنف. يرجى مراجعة الأصناف التالية:
					</p>
					<ul class="so-alert-list">
						for _, s := range data.Stale {
							<li>
								<strong>{ s.RawName }</strong> — { s.Detail }
							</li>
						}
					</ul>
				</div>
			}

			<!-- Summary Metrics Grid -->
			<div class="so-stat-grid">
				@statCard("إجمالي قيمة الطلب", data.Run.EstimatedTotal.String() + " ج.م")
				@statCard("عدد الموردين", fmt.Sprintf("%d موردين", len(data.Groups)))
				@statCard("الأصناف الجاهزة للتوريد", fmt.Sprintf("%d صنف", totalOrderableItems(data.Groups)))
				@statCard("أصناف مستبعدة", fmt.Sprintf("%d صنف", len(data.Excluded)))
				@statCard("فرع التسليم", data.BranchName)
			</div>

			if data.Run.BudgetExceeded != nil && *data.Run.BudgetExceeded {
				<div class="so-alert so-alert-warning">
					<strong>تجاوز الطلب الميزانية المحددة</strong>
					if data.Run.BudgetOverage != nil {
						<span> — بزيادة { data.Run.BudgetOverage.String() }</span>
					}
					<span class="so-alert-inline-note">(يمكنك المتابعة أو تعديل الكميات أدناه).</span>
				</div>
			}

			<!-- Main Supplier Groups Review Tables -->
			for _, g := range data.Groups {
				<div class="card so-review-group">
					
					<!-- Group Header Strip -->
					<div class="so-group-header">
						<div class="so-group-heading">
							<span class="so-group-icon" aria-hidden="true"></span>
							<div class="so-group-details">
								<div class="so-group-name">
									{ g.VendorName }
								</div>
								<div class="so-group-count">
									{ fmt.Sprintf("%d أصناف مطلوبة من هذا المورد", len(g.Lines)) }
								</div>
							</div>
						</div>
						<div class="so-group-total">
							<span class="so-group-total-label">إجمالي المورد:</span>
							<span class="tabular-nums so-group-total-value">
								{ g.Subtotal.String() } ج.م
							</span>
						</div>
					</div>

					<!-- 9-Column Master Responsive Table in Exact Specified Order -->
					<div class="table-responsive so-review-table-wrap">
						<table class="table so-review-table">
							<thead>
								<tr class="so-review-table-head">
									<th class="so-review-col-item">1. اسم الصنف</th>
									<th class="so-review-col-sku">2. كود الصنف (SKU)</th>
									<th class="so-review-col-qty">3. الكمية المطلوبة</th>
									<th class="so-review-col-match">4. الصنف المطابق</th>
									<th class="so-review-col-vendor">5. المورد</th>
									<th class="so-review-col-stock">6. الكمية المتاحة</th>
									<th class="so-review-col-price td-numeric">7. سعر الوحدة</th>
									<th class="so-review-col-total td-numeric">8. الإجمالي</th>
									<th class="so-review-col-status">9. الحالة</th>
								</tr>
							</thead>
							<tbody>
								for _, l := range g.Lines {
									<tr class="so-review-row">
										
										<!-- 1. Product Name -->
										<td class="so-review-cell so-review-item">
											<div class="so-review-item-name">
												{ l.Line.RawName }
											</div>
											if l.Line.RawBarcode != "" {
												<div class="so-review-item-barcode">
													باركود: { l.Line.RawBarcode }
												</div>
											}
										</td>

										<!-- 2. SKU -->
										<td class="so-review-cell so-review-sku">
											if l.Line.RawSKU != "" {
												<span class="badge badge-slate so-review-sku-badge">
													{ l.Line.RawSKU }
												</span>
											} else {
												<span class="so-review-muted">—</span>
											}
										</td>

										<!-- 3. Requested Quantity (with in-place stepper form) -->
										<td class="so-review-cell so-review-qty">
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/lines/%d/quantity", data.Run.PublicID, l.Line.ID)) } class="so-quantity-form">
												<div class="so-quantity-stepper">
													<button type="button" class="btn btn-ghost btn-xs so-quantity-button" onclick="stepReviewQty(this, -1)">−</button>
													<input
														type="number"
														name="quantity"
														value={ fmt.Sprintf("%g", l.Line.EffectiveQty) }
														min="1"
														class="tabular-nums"
														class="tabular-nums so-quantity-input"
													/>
													<button type="button" class="btn btn-ghost btn-xs so-quantity-button" onclick="stepReviewQty(this, 1)">+</button>
												</div>
												<button type="submit" class="btn btn-secondary btn-xs fw-700 so-quantity-save" title="حفظ الكمية">
													تعديل
												</button>
											</form>
										</td>

										<!-- 4. Matched Product -->
										<td class="so-review-cell so-review-match">
											if l.Line.MatchedProductName != "" {
												<div class="so-review-match-name">
													{ l.Line.MatchedProductName }
												</div>
												if l.Line.MatchedProductID != nil {
													<div class="so-review-product-id">
														#{ fmt.Sprintf("%d", *l.Line.MatchedProductID) }
													</div>
												}
											} else {
												<span class="badge badge-rose so-review-small-badge">غير محدد</span>
											}
										</td>

										<!-- 5. Supplier & Selection Decision -->
										<td class="so-review-cell so-review-vendor">
											<div class="so-review-vendor-name">
												{ l.VendorName }
											</div>
											<div class="so-review-vendor-meta">
												<span class="badge badge-slate so-review-decision-badge">
													{ decidedLabel(l.DecidedBy) }
												</span>
												if l.Alternatives > 0 {
													<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/lines/%d/candidates", data.Run.PublicID, l.Line.ID)) } class="btn btn-ghost btn-xs so-alternative-link">
														{ fmt.Sprintf("بدلاء (%d)", l.Alternatives) }
													</a>
												}
											</div>
										</td>

										<!-- 6. Available Quantity -->
										<td class="so-review-cell so-review-stock">
											if l.AvailableStock > 0 {
												<span class="badge badge-emerald tabular-nums so-stock-badge">
													{ fmt.Sprintf("%d", l.AvailableStock) } عبوة
												</span>
											} else {
												<span class="badge badge-rose so-review-small-badge">
													غير محدد
												</span>
											}
										</td>

										<!-- 7. Unit Price -->
										<td class="so-review-cell so-review-price td-numeric">
											<div class="tabular-nums font-mono so-review-price-value">
												{ l.UnitPrice.String() } ج.م
											</div>
											if l.DiscountPct > 0 {
												<span class="badge badge-emerald so-discount-badge">
													خصم { fmt.Sprintf("%.0f%%", l.DiscountPct) }
												</span>
											}
										</td>

										<!-- 8. Subtotal -->
										<td class="so-review-cell so-review-total td-numeric">
											<div class="tabular-nums font-mono so-review-line-total">
												{ l.LineNet.String() } ج.م
											</div>
										</td>

										<!-- 9. Status & Line Actions -->
										<td class="so-review-cell so-review-status">
											<div class="so-status-actions">
												<span class="badge badge-emerald so-ready-badge">
													جاهز للطلب
												</span>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/lines/%d/remove", data.Run.PublicID, l.Line.ID)) } class="so-remove-form">
													<button type="submit" class="btn btn-ghost btn-xs text-danger so-remove-button" title="حذف الصنف من الطلب">
														حذف
													</button>
												</form>
											</div>
										</td>

									</tr>
								}
							</tbody>
						</table>
					</div>

				</div>
			}

			<!-- Excluded Items Section (if any) -->
			if len(data.Excluded) > 0 {
				<div class="card so-excluded-card">
					<div class="so-excluded-header">
						<div class="so-excluded-heading">
							<span class="so-warning-icon" aria-hidden="true"></span>
							<div class="so-excluded-details">
								<h3 class="so-excluded-title">
									أصناف مستبعدة ولن تُطلب تلقائياً ({ fmt.Sprintf("%d", len(data.Excluded)) } صنف)
								</h3>
								<div class="so-excluded-description">
									هذه الأصناف لم تكتمل شروط توريدها (بسبب عدم التطابق أو عدم توفر مورد أو نفاد المخزون).
								</div>
							</div>
						</div>
						<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results?match=unmatched", data.Run.PublicID)) } class="btn btn-secondary btn-xs fw-700">
							معالجة الأصناف ←
						</a>
					</div>

					<div class="table-responsive so-excluded-table-wrap">
						<table class="table so-excluded-table">
							<thead>
								<tr class="so-excluded-table-head">
									<th>اسم الصنف المطلوب</th>
									<th class="so-excluded-col-sku">كود SKU</th>
									<th class="so-excluded-col-qty">الكمية</th>
									<th class="so-excluded-col-reason">سبب الاستبعاد / الحالة</th>
									<th class="so-excluded-col-action">الإجراء</th>
								</tr>
							</thead>
							<tbody>
								for _, l := range data.Excluded {
									<tr>
										<td class="so-excluded-name">
											{ l.RawName }
										</td>
										<td class="so-excluded-cell">
											if l.RawSKU != "" {
												<span class="badge badge-slate so-review-small-badge">{ l.RawSKU }</span>
											} else {
												<span class="so-review-muted">-</span>
											}
										</td>
										<td class="so-excluded-cell so-excluded-qty tabular-nums">
											{ fmt.Sprintf("%g", l.EffectiveQty) }
										</td>
										<td class="so-excluded-cell so-excluded-reason">
											<span class={ outcomeChip(l.Outcome) }>
												{ SmartOrderOutcomeLabel(l.Outcome) }
											</span>
										</td>
										<td class="so-excluded-cell so-excluded-action">
											<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results?q=%s", data.Run.PublicID, l.RawName)) } class="btn btn-secondary btn-xs fw-700 so-link-button">
												ربط الصنف
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- Bottom Sticky Placement Action Bar -->
			<div class="card so-finalize-bar">
				<div>
					<div class="so-finalize-label">إجمالي الطلب الشامل:</div>
					<div class="tabular-nums so-finalize-total">
						{ data.Run.EstimatedTotal.String() } <span class="so-finalize-currency">ج.م</span>
					</div>
					<div class="so-finalize-note">
						{ fmt.Sprintf("سيتم إنشاء %d أوامر شراء منفصلة ومباشرة للموردين المحددين", len(data.Groups)) }
					</div>
				</div>

				<div class="so-finalize-actions">
					<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", data.Run.PublicID)) } class="btn btn-secondary fw-700 so-finalize-secondary">
						تعديل المطابقة
					</a>
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/finalize", data.Run.PublicID)) } class="so-finalize-form">
						<button
							type="submit"
							class="btn btn-primary so-finalize-primary"
							disabled?={ len(data.Groups) == 0 }
						>
							<span>اعتماد الطلب وإرسال أوامر الشراء</span>
						</button>
					</form>
				</div>
			</div>

		</div>

		<script>
			function stepReviewQty(btn, delta) {
				const form = btn.closest('form');
				if (!form) return;
				const input = form.querySelector('input[name="quantity"]');
				if (input) {
					let val = parseInt(input.value, 10) || 1;
					val += delta;
					if (val < 1) val = 1;
					input.value = val;
				}
			}
		</script>
	}
}
