package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CompareToolPage(lang, dir string, files []*compare.CompareFile, maxAllowedFiles int, noticeType, noticeMsg string) {
	@layouts.VendorShell("محرك مقارنة الخصومات والأسعار", "compare", lang, dir) {
		<!-- Notice / Toast Banner -->
		if noticeMsg != "" {
				if noticeType == "error" {
					<div class="alert alert-danger mb-4 p-3.5 flex-between rounded-xl shadow-xs">
						<div class="d-flex items-center gap-2.5 font-extrabold text-xs">
							@components.IconAlert("icon-xs")
							<span>{ noticeMsg }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-3.5 flex-between rounded-xl shadow-xs">
						<div class="d-flex items-center gap-2.5 font-extrabold text-xs">
							@components.IconCheckCircle("icon-xs")
							<span>{ noticeMsg }</span>
						</div>
					</div>
				}
			}
			
			<!-- Header Banner -->
			<div class="glass-panel p-5 mb-5 flex-between flex-wrap gap-4 border rounded-2xl shadow-xs">
				<div class="stack-2xs">
					<div class="d-flex items-center gap-2 mb-0.5">
						<div class="w-8 h-8 rounded-lg bg-brand-subtle text-brand d-flex items-center justify-center border border-brand/20">
							@components.IconBarChart("icon-xs")
						</div>
						<h1 class="text-xl font-black text-primary m-0 tracking-tight">
							محرك مقارنة الخصومات والأسعار
						</h1>
						<span class="badge badge-emerald font-bold text-2xs">متاح بالكامل</span>
					</div>
					<p class="text-xs text-secondary m-0 font-medium">
						ارفع وقارن كشوف أسعار وخصومات الموردين والشركات بدقة واحترافية.
					</p>
				</div>

				<div class="d-flex items-center gap-2.5 flex-wrap">
					<a
						href="/compare/sample"
						class="btn btn-secondary btn-sm font-bold text-xs gap-1.5 shadow-2xs"
						download="dawa24_supplier_template.xlsx"
					>
						@components.IconDownload("icon-xs")
						<span>نموذج تجريبي (Excel)</span>
					</a>
					<span class="badge badge-slate text-xs font-bold px-3 py-1.5">
						if maxAllowedFiles == 0 {
							{ fmt.Sprintf("%d ملفات موردين", len(files)) }
						} else {
							{ fmt.Sprintf("الملفات: %d / %d", len(files), maxAllowedFiles) }
						}
					</span>
				</div>
			</div>

			<!-- Navigation Subtabs for all 4 Analysis Modes -->
			<div class="d-flex gap-2 mb-5 flex-wrap">
				<a href="/compare/results" class="btn btn-secondary btn-sm font-bold text-xs">
					المقارنة المجمعة
				</a>
				<a href="/compare/head-to-head" class="btn btn-secondary btn-sm font-bold text-xs">
					مقارنة مورد بمورد
				</a>
				<a href="/compare/market-benchmark" class="btn btn-secondary btn-sm font-bold text-xs">
					مقارنة مع السوق
				</a>
				<a href="/compare/market-intelligence" class="btn btn-secondary btn-sm font-bold text-xs">
					تقرير ذكاء السوق
				</a>
			</div>

			<!-- 3-Column Horizontal Workspace -->
			<div class="compare-workspace-grid">
				
				<!-- Column 1: Supplier File Center -->
				<div class="compare-col-card">
					<div class="flex-between border-b pb-3">
						<div class="d-flex items-center gap-2">
							@components.IconFolder("icon-xs text-brand")
							<h2 class="text-sm font-black text-primary m-0">مركز ملفات الموردين</h2>
						</div>
						<span class="badge badge-sky text-2xs font-bold">
							if maxAllowedFiles > 0 {
								{ fmt.Sprintf("%d / %d ملف", len(files), maxAllowedFiles) }
							} else {
								{ fmt.Sprintf("%d ملف", len(files)) }
							}
						</span>
					</div>


					<!-- Comparison Form -->
					<form method="POST" action="/compare/run" id="compare-run-form" class="d-flex flex-col gap-3 m-0" onsubmit="return validateCompareSelection(event)">
						<!-- Action Controls: Select All + Start Analysis -->
						<div class="flex-between bg-surface-sunken p-2.5 rounded-xl border">
							<label class="d-flex items-center gap-2 cursor-pointer font-bold text-xs text-primary select-none">
								<input type="checkbox" id="select-all-files" onchange="toggleSelectAll(this)" checked class="form-checkbox" />
								<span>تحديد الكل</span>
							</label>

							<button
								type="submit"
								class="btn btn-primary btn-sm font-black text-xs px-3.5 shadow-xs"
							>
								<span>بدء التحليل والمقارنة</span>
							</button>
						</div>

						<!-- Files List -->
						if len(files) == 0 {
							<div class="empty-state-glass p-8 text-center rounded-xl border">
								<div class="text-2xl mb-1.5">📂</div>
								<strong class="text-primary text-xs d-block mb-1 font-bold">لا توجد ملفات مرفوعة بعد</strong>
								<p class="text-2xs text-muted m-0">استخدم نموذج الرفع المجاور أو حمل النموذج التجريبي لاختبار المقارنة فوراً.</p>
							</div>
						} else {
							<div class="d-flex flex-col gap-2 max-h-[460px] overflow-y-auto pe-1">
								for _, f := range files {
									<div class="bg-surface-sunken border rounded-xl p-3 flex-between gap-3 shadow-2xs">
										<div class="d-flex items-start gap-2.5 min-w-0">
											<input
												type="checkbox"
												name="supplier_ids"
												value={ fmt.Sprintf("%d", f.ID) }
												class="file-checkbox form-checkbox mt-1 flex-shrink-0"
												checked
											/>
											<div class="min-w-0">
												<div class="d-flex items-center gap-1.5 flex-wrap">
													<strong class="text-xs text-primary font-black text-truncate">{ f.SupplierName }</strong>
													if f.RowCount > 0 {
														<span class="badge badge-emerald text-2xs font-bold">{ fmt.Sprintf("%d صنف", f.RowCount) }</span>
													} else {
														<span class="badge badge-secondary text-2xs font-bold">جاهز</span>
													}
												</div>
												<div class="text-2xs text-muted mt-0.5 tabular-nums">
													{ f.OriginalFilename } • { f.CreatedAt.Format("02/01/2006") }
												</div>
											</div>
										</div>

										<!-- Actions (Map / Rename / Delete) -->
										<div class="d-flex items-center gap-1 flex-shrink-0">
											<button
												type="button"
												class="btn btn-secondary btn-icon btn-xs text-brand"
												title="تعديل تعيين الأعمدة"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("openMappingModal(%d)", f.ID)} }
											>
												@components.IconSettings("icon-2xs")
											</button>

											<button
												type="button"
												class="btn btn-secondary btn-icon btn-xs"
												title="تعديل اسم المورد"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("openRenameModal(%d, '%s')", f.ID, f.SupplierName)} }
											>
												@components.IconEdit("icon-2xs")
											</button>

											<button
												type="button"
												class="btn btn-secondary btn-icon btn-xs text-danger"
												title="حذف الملف"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("deleteFileConfirm(%d)", f.ID)} }
											>
												@components.IconTrash("icon-2xs")
											</button>
										</div>
									</div>
								}
							</div>
						}
					</form>
				</div>

				<!-- Column 2: Upload Zone -->
				<div class="compare-col-card">
					<div class="flex-between border-b pb-3">
						<div class="d-flex items-center gap-2">
							@components.IconUpload("icon-xs text-brand")
							<h2 class="text-sm font-black text-primary m-0">رفع كشوف الموردين</h2>
						</div>
						<span class="badge badge-slate text-2xs font-bold">استيراد مجمّع</span>
					</div>

					<!-- Quota Notice if limit reached -->
					if maxAllowedFiles > 0 && len(files) >= maxAllowedFiles {
						<div class="alert alert-warning p-2.5 d-flex items-start gap-2 rounded-xl text-2xs">
							@components.IconAlert("icon-2xs text-amber-700")
							<span class="font-bold">بلغت الحد الأقصى ({ fmt.Sprintf("%d / %d", len(files), maxAllowedFiles) }). يرجى حذف ملفات لإتاحة مساحة.</span>
						</div>
					}

					<form
						method="POST"
						action="/compare/upload"
						id="compare-upload-form"
						enctype="multipart/form-data"
						class="d-flex flex-col gap-3 m-0"
						onsubmit="return handleUploadSubmit(event)"
					>
						<!-- Drag and drop box with Multi-File support -->
						<div
							id="drop-zone-box"
							class="empty-state-glass p-6 text-center cursor-pointer rounded-xl border hover:border-brand transition-colors"
							onclick="triggerFileInput()"
							data-current-count={ fmt.Sprintf("%d", len(files)) }
							data-max-limit={ fmt.Sprintf("%d", maxAllowedFiles) }
						>
							<div class="w-10 h-10 rounded-full bg-primary-subtle text-brand d-flex items-center justify-center mx-auto mb-2 border">
								@components.IconUpload("icon-xs")
							</div>
							<strong class="text-primary text-xs d-block mb-1 font-bold">
								اسحب الكشوف هنا أو اضغط للاختيار
							</strong>
							<p class="text-2xs text-muted m-0 leading-relaxed">
								يدعم كشوف Excel (.xlsx, .xls) و CSV دفعة واحدة
							</p>
							<div id="file-name-preview" class="mt-2 text-2xs font-bold text-brand"></div>

							<input
								type="file"
								id="file-upload-input"
								name="compare_files"
								multiple
								accept=".xlsx,.xls,.csv"
								class="d-none"
								onchange="handleFileSelect(this)"
							/>
						</div>

						<!-- Template Download helper card -->
						<div class="bg-surface-sunken border rounded-xl p-2.5 flex-between gap-2">
							<span class="text-2xs text-muted font-medium">تحميل كشف أسعار تجريبي</span>
							<a
								href="/compare/sample"
								class="btn btn-secondary btn-xs text-brand font-black px-2.5"
								download="dawa24_supplier_template.xlsx"
							>
								نموذج Excel
							</a>
						</div>

						<button
							type="submit"
							id="upload-submit-btn"
							class="btn btn-primary w-full justify-center font-bold text-xs py-2.5 shadow-xs"
						>
							@components.IconCheck("icon-xs")
							<span id="upload-btn-text">رفع ومعالجة الملفات فورياً</span>
						</button>
					</form>

					<!-- Live upload and processing progress. Before this the
					     button simply greyed out and the page sat still for as
					     long as the batch took, which is indistinguishable from
					     a dead connection — so people reloaded and lost the
					     upload they were waiting for. -->
					@components.UploadProgressModal(components.UploadProgressProps{
						ID:       "compare-upload-progress",
						Title:    "رفع كشوف الموردين",
						Subtitle: "يتم رفع الملفات ثم قراءتها ومطابقة أصنافها بالكتالوج المركزي",
					})
				</div>

				<!-- Column 3: Instant Search Box -->
				<div class="compare-col-card">
					<div class="flex-between border-b pb-3">
						<div class="d-flex items-center gap-2">
							@components.IconSearch("icon-xs text-brand")
							<h2 class="text-sm font-black text-primary m-0">البحث المباشر في الكشوف</h2>
						</div>
						<span class="badge badge-emerald text-2xs font-bold">فوري</span>
					</div>

					<div class="position-relative">
						<input
							type="text"
							name="q"
							id="instant-search-input"
							placeholder="ابحث عن دواء أو مادة فعالة..."
							class="form-input text-xs ps-8"
							oninput="filterSearchLocal(this.value)"
						/>
						<div class="position-absolute start-2.5 top-half translate-middle-y text-muted pointer-events-none">
							@components.IconSearch("icon-2xs")
						</div>
					</div>

					<!-- Search Results Area -->
					<div id="instant-search-results" class="d-flex flex-col gap-2 max-h-[460px] overflow-y-auto">
						<div class="bg-surface-sunken rounded-xl p-6 text-center text-muted text-2xs leading-relaxed font-medium">
							اكتب اسم الصنف للبحث المباشر عبر جميع كشوف الموردين المرفوعة ومقارنة الأسعار فورياً.
						</div>
					</div>
				</div>

			</div>

		<!-- Scripts for compare tool interactions -->
		<script src="/static/js/compare_tool.js"></script>

		<!-- Root container for dynamically injected mapping modal -->
		<div id="mapping-modal-root"></div>

		<!-- Centered File Rename Modal -->
		<div id="rename-file-modal" class="d-none fixed inset-0 z-50 items-center justify-center p-4 bg-black/60 backdrop-blur-xs" onclick="closeRenameModal()">
			<div class="glass-panel w-full max-w-md p-6 rounded-2xl shadow-xl border border-border" onclick="event.stopPropagation()">
				<div class="flex-between items-center mb-4 pb-3 border-b border-border">
					<div class="d-flex items-center gap-2">
						<div class="w-8 h-8 rounded-lg bg-brand-subtle text-brand flex-center font-bold">
							@components.IconEdit("icon-xs")
						</div>
						<h3 class="text-base font-black text-primary m-0">تعديل اسم المورد / الملف</h3>
					</div>
					<button type="button" onclick="closeRenameModal()" class="btn btn-secondary btn-icon btn-xs text-muted" title="إغلاق">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<form id="rename-file-form" method="POST" action="">
					<div class="mb-4">
						<label for="rename-supplier-input" class="form-label text-xs font-bold mb-1.5 d-block">اسم المورد أو المستودع الجديد:</label>
						<input
							type="text"
							id="rename-supplier-input"
							name="supplier_name"
							class="form-input w-full text-sm font-bold"
							placeholder="مثال: المتحدة للصيادلة، فارما أوفرسيز..."
							required
							maxlength="120"
						/>
					</div>

					<div class="flex-end gap-2 pt-2 border-t border-border">
						<button type="button" onclick="closeRenameModal()" class="btn btn-secondary btn-sm font-bold">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary btn-sm font-black">
							حفظ التعديل
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}

