package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CompareToolPage(lang, dir string, files []*compare.CompareFile) {
	@layouts.VendorShell("محرك مقارنة الخصومات والأسعار", "compare", lang, dir) {
		<div style="max-width:1380px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem;">
			
			<!-- Header Banner -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem 1.75rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.25rem;">
							<div style="width:40px; height:40px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.25rem;">
								📊
							</div>
							<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
								محرك مقارنة الخصومات والأسعار
							</h1>
							<span class="badge badge-emerald" style="font-weight:700; font-size:0.75rem;">مجاني ومتاح بالكامل</span>
						</div>
						<p style="color:var(--text-muted); font-size:0.875rem; margin:0;">
							ارفع كشوف أسعار وخصومات الموردين وقارن أسعار الأصناف والخصومات مباشرة بدقة واحترافية.
						</p>
					</div>

					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<a
							href="/compare/sample"
							class="btn btn-secondary"
							style="font-weight:800; font-size:0.875rem; gap:0.5rem;"
							download="dawa24_supplier_template.xlsx"
						>
							@components.IconDownload("icon-xs")
							<span>تحميل نموذج تجريبي (Excel) 📥</span>
						</a>
						<span class="badge badge-secondary" style="font-size:0.85rem; padding:0.5rem 0.85rem;">
							{ fmt.Sprintf("%d ملفات موردين مسجلة", len(files)) }
						</span>
					</div>
				</div>
			</div>

			<!-- 3-Column Workspace (Matching Image 5) -->
			<div style="display:grid; grid-template-columns:1.25fr 1fr 1fr; gap:1.25rem; align-items:start;" class="compare-workspace-grid">
				
				<!-- Column 1: Supplier File Center -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:0.85rem;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							<span style="font-size:1.2rem;">📁</span>
							<h2 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">
								مركز ملفات الموردين
							</h2>
						</div>
						<span class="badge badge-sky" style="font-size:0.75rem;">{ fmt.Sprintf("%d ملف", len(files)) }</span>
					</div>

					<form method="POST" action="/compare/run" id="compare-run-form" style="display:flex; flex-direction:column; gap:1rem; margin:0;" onsubmit="return validateCompareSelection(event)">
						<!-- Action Controls: Select All + Start Analysis -->
						<div style="display:flex; justify-content:space-between; align-items:center; background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
							<label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; font-weight:700; font-size:0.875rem; color:var(--text);">
								<input type="checkbox" id="select-all-files" onchange="toggleSelectAll(this)" checked style="width:18px; height:18px; accent-color:var(--accent);" />
								<span>تحديد الكل</span>
							</label>

							<button
								type="submit"
								class="btn btn-primary"
								style="font-weight:800; font-size:0.875rem; padding:0.5rem 1.25rem; border-radius:var(--radius-lg);"
							>
								<span>بدء التحليل والمقارنة 🚀</span>
							</button>
						</div>

						<!-- Files List -->
						if len(files) == 0 {
							<div style="padding:2.5rem 1rem; text-align:center; background:var(--surface-sunken); border:1px dashed var(--border); border-radius:var(--radius-xl);">
								<div style="font-size:2rem; margin-bottom:0.5rem;">📂</div>
								<strong style="color:var(--text); font-size:0.95rem; display:block; margin-bottom:0.25rem;">لا توجد ملفات مرفوعة بعد</strong>
								<p style="color:var(--text-muted); font-size:0.8rem; margin:0 0 1rem 0;">استخدم نموذج الرفع المجاور أو حمل النموذج التجريبي لاختبار المقارنة فوراً.</p>
								<a href="/compare/sample" class="btn btn-secondary btn-sm" style="font-weight:700;">
									📥 تحميل النموذج التجريبي
								</a>
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:0.75rem; max-height:480px; overflow-y:auto; padding-inline-end:0.25rem;">
								for _, f := range files {
									<div style="padding:0.85rem 1rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; align-items:center; justify-content:space-between; gap:0.75rem; transition:border-color 0.2s;">
										<div style="display:flex; align-items:center; gap:0.75rem; min-width:0;">
											<input
												type="checkbox"
												name="supplier_ids"
												value={ fmt.Sprintf("%d", f.ID) }
												class="file-checkbox"
												checked
												style="width:18px; height:18px; accent-color:var(--accent); flex-shrink:0;"
											/>
											<div style="min-width:0;">
												<div style="display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap;">
													<strong style="font-size:0.95rem; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
														{ f.SupplierName }
													</strong>
													if f.RowCount > 0 {
														<span class="badge badge-emerald" style="font-size:0.7rem; padding:0.15rem 0.45rem;">
															{ fmt.Sprintf("%d صنف جاهز", f.RowCount) }
														</span>
													} else {
														<span class="badge badge-secondary" style="font-size:0.7rem; padding:0.15rem 0.45rem;">
															جاهز للتحليل
														</span>
													}
												</div>
												<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;" class="tabular-nums">
													{ f.OriginalFilename } • { f.CreatedAt.Format("2006-01-02") }
												</div>
											</div>
										</div>

										<!-- Actions (Map / Rename / Delete) -->
										<div style="display:flex; align-items:center; gap:0.35rem; flex-shrink:0;">
											<a
												href={ templ.SafeURL(fmt.Sprintf("/compare/files/%d/mapping", f.ID)) }
												class="btn btn-secondary btn-sm btn-icon"
												title="تعديل تعيين الأعمدة"
												style="color:var(--accent);"
											>
												@components.IconSettings("icon-xs")
											</a>

											<button
												type="button"
												class="btn btn-secondary btn-sm btn-icon"
												title="تعديل اسم المورد"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("promptRenameFile(%d, '%s')", f.ID, f.SupplierName)} }
											>
												@components.IconEdit("icon-xs")
											</button>

											<button
												type="button"
												class="btn btn-secondary btn-sm btn-icon"
												style="color:var(--danger-text);"
												title="حذف الملف"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("deleteFileConfirm(%d)", f.ID)} }
											>
												@components.IconTrash("icon-xs")
											</button>
										</div>
									</div>
								}
							</div>
						}
					</form>
				</div>

				<!-- Column 2: Upload Zone -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
					<div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:0.85rem;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							<span style="font-size:1.2rem;">📤</span>
							<h2 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">
								رفع ملف مورد جديد
							</h2>
						</div>
					</div>

					<form method="POST" action="/compare/upload" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" style="font-weight:700; color:var(--text); font-size:0.875rem;">
								اسم المورد / الشركة <span style="color:var(--danger-text);">*</span>
							</label>
							<input
								type="text"
								name="supplier_name"
								required
								placeholder="مثال: شركة ويزر فارما للتوزيع"
								class="form-input"
								style="width:100%; border-radius:var(--radius-lg);"
							/>
						</div>

						<!-- Drag and drop box -->
						<div
							style="border:2px dashed var(--accent); background:var(--surface-sunken); border-radius:var(--radius-xl); padding:1.75rem 1rem; text-align:center; cursor:pointer; position:relative;"
							onclick="document.getElementById('file-upload-input').click()"
						>
							<div style="font-size:2.5rem; margin-bottom:0.5rem;">📄</div>
							<strong style="color:var(--text); font-size:0.95rem; display:block; margin-bottom:0.25rem;">
								انقر هنا لاختيار الملف أو اسحبه
							</strong>
							<p style="color:var(--text-muted); font-size:0.775rem; margin:0;">
								يدعم ملفات Excel (.xlsx, .xls) وكشوف CSV (.csv) بحد أقصى 20 ميجابايت
							</p>
							<div id="file-name-preview" style="margin-top:0.75rem; font-weight:700; color:var(--accent); font-size:0.85rem;"></div>

							<input
								type="file"
								id="file-upload-input"
								name="compare_file"
								required
								accept=".xlsx,.xls,.csv"
								style="display:none;"
								onchange="handleFileSelect(this)"
							/>
						</div>

						<!-- Template Download helper card -->
						<div style="padding:0.85rem 1rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
							<div style="font-size:0.8rem; color:var(--text-muted);">
								هل تحتاج كشف أسعار للتجربة؟
							</div>
							<a
								href="/compare/sample"
								class="btn btn-secondary btn-sm"
								style="font-weight:800; font-size:0.775rem; padding:0.35rem 0.75rem; color:var(--accent);"
								download="dawa24_supplier_template.xlsx"
							>
								📥 تحميل نموذج Excel
							</a>
						</div>

						<button
							type="submit"
							class="btn btn-primary"
							style="width:100%; justify-content:center; font-weight:800; font-size:0.95rem; padding:0.75rem;"
						>
							@components.IconCheck("icon-xs")
							<span>رفع ومعالجة الملف فورياً 🚀</span>
						</button>
					</form>
				</div>

				<!-- Column 3: Instant Search Box -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
					<div style="display:flex; align-items:center; gap:0.5rem; border-bottom:1px solid var(--border); padding-bottom:0.85rem;">
						<span style="font-size:1.2rem;">🔍</span>
						<h2 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">
							البحث السريع والفوري
						</h2>
					</div>

					<div style="position:relative;">
						<input
							type="text"
							name="q"
							id="instant-search-input"
							placeholder="ابحث عن دواء، مادة فعالة، كود..."
							class="form-input"
							style="width:100%; border-radius:var(--radius-lg); padding-inline-start:2.5rem;"
							oninput="filterSearchLocal(this.value)"
						/>
						<div style="position:absolute; right:0.85rem; top:50%; transform:translateY(-50%); color:var(--text-muted);">
							@components.IconSearch("icon-xs")
						</div>
					</div>

					<!-- Search Results Area -->
					<div id="instant-search-results" style="display:flex; flex-direction:column; gap:0.6rem; max-height:420px; overflow-y:auto;">
						<div style="padding:2rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:var(--radius-xl); color:var(--text-muted); font-size:0.85rem;">
							اكتب اسم الصنف للبحث المباشر عبر جميع كشوف الموردين المرفوعة ومقارنة الخصومات فورياً.
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- Scripts for compare tool interactions -->
		<script>
			function toggleSelectAll(masterCheckbox) {
				const checkboxes = document.querySelectorAll('.file-checkbox');
				checkboxes.forEach(cb => cb.checked = masterCheckbox.checked);
			}

			function validateCompareSelection(event) {
				const checked = document.querySelectorAll('.file-checkbox:checked');
				if (checked.length === 0) {
					const all = document.querySelectorAll('.file-checkbox');
					if (all.length > 0) {
						all.forEach(cb => cb.checked = true);
						return true;
					}
					alert("يرجى رفع ملف كشف أسعار واحد على الأقل للمقارنة.");
					event.preventDefault();
					return false;
				}
				return true;
			}

			function handleFileSelect(input) {
				if (input.files && input.files[0]) {
					const name = input.files[0].name;
					const size = (input.files[0].size / 1024 / 1024).toFixed(2);
					document.getElementById('file-name-preview').textContent = `تم اختيار: ${name} (${size} MB)`;
				}
			}

			function promptRenameFile(id, currentName) {
				const newName = prompt("أدخل الاسم الجديد للمورد / الملف:", currentName);
				if (newName && newName.trim() !== "" && newName !== currentName) {
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = `/compare/files/${id}/rename`;
					const input = document.createElement('input');
					input.type = 'hidden';
					input.name = 'supplier_name';
					input.value = newName.trim();
					form.appendChild(input);
					document.body.appendChild(form);
					form.submit();
				}
			}

			function deleteFileConfirm(id) {
				if (confirm("هل أنت متأكد من حذف هذا الملف نهائياً من مركز الملفات؟")) {
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = `/compare/files/${id}/delete`;
					document.body.appendChild(form);
					form.submit();
				}
			}

			let searchTimeout = null;
			function filterSearchLocal(query) {
				clearTimeout(searchTimeout);
				const resultsContainer = document.getElementById('instant-search-results');
				if (!query || query.trim().length < 2) {
					resultsContainer.innerHTML = `
						<div style="padding:2rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:var(--radius-xl); color:var(--text-muted); font-size:0.85rem;">
							اكتب اسم الصنف للبحث المباشر عبر جميع كشوف الموردين المرفوعة ومقارنة الخصومات فورياً.
						</div>
					`;
					return;
				}

				searchTimeout = setTimeout(() => {
					fetch(`/catalog/search?q=${encodeURIComponent(query.trim())}`, {
						headers: { 'Accept': 'application/json' }
					})
					.then(r => r.json())
					.then(data => {
						if (!data || data.length === 0) {
							resultsContainer.innerHTML = `
								<div style="padding:1.5rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:var(--radius-xl); color:var(--text-muted); font-size:0.85rem;">
									لم يتم العثور على أصناف مطابقة لـ "${query}".
								</div>
							`;
							return;
						}
						let html = '';
						data.slice(0, 10).forEach(item => {
							html += `
								<div style="padding:0.75rem 1rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); display:flex; justify-content:space-between; align-items:center;">
									<div>
										<strong style="color:var(--text); font-size:0.875rem; display:block;">${item.name || item.name_ar || 'صنف دوائي'}</strong>
										<span style="color:var(--text-muted); font-size:0.75rem;">${item.dosage_form || 'مستحضر صيدلي'}</span>
									</div>
									<div style="font-weight:800; color:var(--accent); font-size:0.9rem;" class="tabular-nums">
										${item.price || '--'} ج.م
									</div>
								</div>
							`;
						});
						resultsContainer.innerHTML = html;
					})
					.catch(() => {
						resultsContainer.innerHTML = `
							<div style="padding:1rem; text-align:center; color:var(--text-muted); font-size:0.8rem;">
								البحث متاح عبر كتالوج الأدوية
							</div>
						`;
					});
				}, 300);
			}
		</script>
	}
}
