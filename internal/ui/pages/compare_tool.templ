package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// CompareMatchOptions says what the catalogue matching stage can do on this
// deployment, so the screen offers a control only where it would work.
//
// A button that ticks and then does nothing is worse than a missing button: the
// AI switch on this tool used to be exactly that — an entitlement flag named
// AIMatchingEnabled, with no matching stage behind it at all.
type CompareMatchOptions struct {
	Available   bool
	AIAvailable bool
}

templ CompareToolPage(lang, dir string, files []*compare.CompareFile, maxAllowedFiles int, matching CompareMatchOptions, noticeType, noticeMsg string) {
	@layouts.VendorShell("محرك مقارنة الخصومات والأسعار", "compare", lang, dir) {
		<div class="page-container max-w-5xl">

			<!-- Notice / Toast Banner -->
			if noticeMsg != "" {
				if noticeType == "error" {
					<div class="alert alert-danger mb-4 p-4 flex-between">
						<div class="d-flex items-center gap-3 font-extrabold text-sm">
							<span class="text-2xl">@components.IconAlert("icon-sm")</span>
							<span>{ noticeMsg }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 flex-between">
						<div class="d-flex items-center gap-3 font-extrabold text-sm">
							<span class="text-2xl">@components.IconCheckCircle("icon-sm")</span>
							<span>{ noticeMsg }</span>
						</div>
					</div>
				}
			}
			
			<!-- Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-2 mb-1">
							<div class="user-avatar-badge">
								@components.IconBarChart("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								محرك مقارنة الخصومات والأسعار
							</h1>
							<span class="badge badge-emerald font-bold text-xs">مجاني ومتاح بالكامل</span>
						</div>
						<p class="text-sm text-muted m-0">
							ارفع كشوف أسعار وخصومات الموردين وقارن أسعار الأصناف والخصومات مباشرة بدقة واحترافية.
						</p>
					</div>

					<div class="d-flex items-center gap-3 flex-wrap">
						<a
							href="/compare/sample"
							class="btn btn-secondary font-bold text-xs gap-2"
							download="dawa24_supplier_template.xlsx"
						>
							@components.IconDownload("icon-xs")
							<span>تحميل نموذج تجريبي (Excel)</span>
						</a>
						<span class="badge badge-secondary text-xs px-3 py-2">
							if maxAllowedFiles == 0 {
								{ fmt.Sprintf("%d ملفات موردين مسجلة (غير محدود)", len(files)) }
							} else {
								{ fmt.Sprintf("ملفات الموردين: %d / %d", len(files), maxAllowedFiles) }
							}
						</span>
					</div>
				</div>

				<!-- Navigation Subtabs for all 4 Analysis Modes -->
				<div class="d-flex gap-2 mt-4 pt-4 border-t flex-wrap">
					<a href="/compare/results" class="btn btn-secondary btn-sm font-bold">
						المقارنة المجمعة بين الموردين
					</a>
					<a href="/compare/head-to-head" class="btn btn-secondary btn-sm font-bold">
						مقارنة مورد بمورد
					</a>
					<a href="/compare/market-benchmark" class="btn btn-secondary btn-sm font-bold">
						مقارنة مع موردين السوق
					</a>
					<a href="/compare/market-intelligence" class="btn btn-secondary btn-sm font-bold">
						تقرير ذكاء السوق
					</a>
				</div>
			</div>

			<!-- 3-Column Workspace -->
			<div class="compare-workspace-grid">
				
				<!-- Column 1: Supplier File Center -->
				<div class="compare-col-card">
					<div class="flex-between border-b pb-3">
						<div class="d-flex items-center gap-2">
							<span class="text-lg">@components.IconFolder("icon-sm")</span>
							<h2 class="text-base font-extrabold text-primary m-0">
								مركز ملفات الموردين
							</h2>
						</div>
						<div class="d-flex items-center gap-1.5">
							if maxAllowedFiles > 0 {
								if len(files) >= maxAllowedFiles {
									<span class="badge badge-amber text-xs font-bold">{ fmt.Sprintf("الاستهلاك: %d / %d (الحد الأقصى)", len(files), maxAllowedFiles) }</span>
								} else {
									<span class="badge badge-sky text-xs font-bold">{ fmt.Sprintf("الاستهلاك: %d / %d ملف", len(files), maxAllowedFiles) }</span>
								}
							} else {
								<span class="badge badge-sky text-xs font-bold">{ fmt.Sprintf("%d ملف (غير محدود)", len(files)) }</span>
							}
						</div>
					</div>

					if matching.Available {
						@compareMatchPanel(matching)
					}

					<form method="POST" action="/compare/run" id="compare-run-form" class="d-flex flex-col gap-3 m-0" onsubmit="return validateCompareSelection(event)">
						<!-- Action Controls: Select All + Start Analysis -->
						<div class="flex-between bg-surface-sunken p-3 rounded-xl border">
							<label class="d-flex items-center gap-2 cursor-pointer font-bold text-xs text-primary">
								<input type="checkbox" id="select-all-files" onchange="toggleSelectAll(this)" checked class="form-checkbox" />
								<span>تحديد الكل</span>
							</label>

							<button
								type="submit"
								class="btn btn-primary font-bold text-xs px-4"
							>
								<span>بدء التحليل والمقارنة</span>
							</button>
						</div>

						<!-- Files List -->
						if len(files) == 0 {
							<div class="empty-state-glass p-6 text-center">
								<div class="text-2xl mb-2">@components.IconFolderOpen("icon-sm")</div>
								<strong class="text-primary text-sm d-block mb-1">لا توجد ملفات مرفوعة بعد</strong>
								<p class="text-xs text-muted m-0 mb-3">استخدم نموذج الرفع المجاور أو حمل النموذج التجريبي لاختبار المقارنة فوراً.</p>
								<a href="/compare/sample" class="btn btn-secondary btn-sm font-bold">
									تحميل النموذج التجريبي
								</a>
							</div>
						} else {
							<div class="d-flex flex-col gap-2 max-h-96 overflow-y-auto pe-1">
								for _, f := range files {
									<div class="bg-surface-sunken border rounded-xl p-3 flex-between gap-3">
										<div class="d-flex items-center gap-3 min-w-0">
											<input
												type="checkbox"
												name="supplier_ids"
												value={ fmt.Sprintf("%d", f.ID) }
												class="file-checkbox form-checkbox flex-shrink-0"
												checked
											/>
											<div class="min-w-0">
												<div class="d-flex items-center gap-2 flex-wrap">
													<strong class="text-sm text-primary text-truncate">
														{ f.SupplierName }
													</strong>
													if f.RowCount > 0 {
														<span class="badge badge-emerald text-xs">
															{ fmt.Sprintf("%d صنف جاهز", f.RowCount) }
														</span>
													} else {
														<span class="badge badge-secondary text-xs">
															جاهز للتحليل
														</span>
													}
												</div>
												<div class="text-xs text-muted mt-1 tabular-nums">
													{ f.OriginalFilename } • { f.CreatedAt.Format("2006-01-02") }
												</div>
											</div>
										</div>

										<!-- Actions (Match / Map / Rename / Delete) -->
										<div class="d-flex items-center gap-1 flex-shrink-0">
											if matching.Available {
												<!-- The button belongs to the matching form above through the
												     form attribute, because this file card sits inside the
												     comparison form and a form cannot contain another. -->
												<button
													type="submit"
													form="compare-match-form"
													formaction={ templ.SafeURL(fmt.Sprintf("/compare/files/%d/match", f.ID)) }
													class="btn btn-secondary btn-sm btn-icon text-brand"
													title="مطابقة أصناف هذا الملف بالكتالوج المركزي"
												>
													@components.IconExternalLink("icon-sm")
												</button>
											}
											<button
												type="button"
												class="btn btn-secondary btn-sm btn-icon text-brand"
												title="تعديل تعيين الأعمدة"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("openMappingModal(%d)", f.ID)} }
											>
												@components.IconSettings("icon-xs")
											</button>

											<button
												type="button"
												class="btn btn-secondary btn-sm btn-icon"
												title="تعديل اسم المورد"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("promptRenameFile(%d, '%s')", f.ID, f.SupplierName)} }
											>
												@components.IconEdit("icon-xs")
											</button>

											<button
												type="button"
												class="btn btn-secondary btn-sm btn-icon text-danger"
												title="حذف الملف"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("deleteFileConfirm(%d)", f.ID)} }
											>
												@components.IconTrash("icon-xs")
											</button>
										</div>
									</div>
								}
							</div>
						}
					</form>
				</div>

				<!-- Column 2: Upload Zone -->
				<div class="compare-col-card">
					<div class="flex-between border-b pb-3">
						<div class="d-flex items-center gap-2">
							<span class="text-lg">@components.IconUpload("icon-sm")</span>
							<h2 class="text-base font-extrabold text-primary m-0">
								رفع ملفات الموردين (استيراد مجمّع)
							</h2>
						</div>
					</div>

					<!-- Quota Notice if limit reached -->
					if maxAllowedFiles > 0 && len(files) >= maxAllowedFiles {
						<div class="alert alert-warning p-3 mb-3 d-flex items-start gap-2.5 rounded-xl border border-amber-300/80 bg-amber-50/80 text-xs">
							<span class="text-base">@components.IconAlert("icon-sm")</span>
							<div>
								<strong class="d-block font-extrabold text-amber-900 mb-0.5">
									بلغت الحد الأقصى لكشوف الموردين في باقتك ({ fmt.Sprintf("%d / %d", len(files), maxAllowedFiles) })
								</strong>
								<span class="text-secondary leading-relaxed">
									يرجى حذف أو أرشفة ملفات قديمة من القائمة لإتاحة مساحة، أو ترقية باقة الاشتراك لإضافة المزيد من الموردين.
								</span>
							</div>
						</div>
					}

					<form
						method="POST"
						action="/compare/upload"
						id="compare-upload-form"
						enctype="multipart/form-data"
						class="d-flex flex-col gap-3"
						onsubmit="return handleUploadSubmit(event)"
					>
						<!-- Drag and drop box with Multi-File support -->
						<div
							id="drop-zone-box"
							class="empty-state-glass p-6 text-center cursor-pointer position-relative"
							onclick="triggerFileInput()"
							data-current-count={ fmt.Sprintf("%d", len(files)) }
							data-max-limit={ fmt.Sprintf("%d", maxAllowedFiles) }
						>
							<div class="text-3xl mb-2">@components.IconFolder("icon-sm")</div>
							<strong class="text-primary text-sm d-block mb-1">
								انقر هنا لاختيار ملفات الموردين أو اسحبها هنا دفعة واحدة
							</strong>
							<p class="text-xs text-muted m-0 leading-relaxed">
								يدعم رفع عدة ملفات Excel (.xlsx, .xls) و CSV معاً.<br/>
								<span class="text-brand font-bold">يتم تسمية كل مورد تلقائياً من اسم الملف الخاص به</span>
							</p>
							<div id="file-name-preview" class="mt-2 text-xs"></div>

							<input
								type="file"
								id="file-upload-input"
								name="compare_files"
								multiple
								accept=".xlsx,.xls,.csv"
								class="position-absolute opacity-0 pointer-events-none"
								onchange="handleFileSelect(this)"
							/>
						</div>

						<!-- Template Download helper card -->
						<div class="bg-surface-sunken border rounded-xl p-3 flex-between gap-2">
							<div class="text-xs text-muted">
								هل تحتاج كشف أسعار للتجربة؟
							</div>
							<a
								href="/compare/sample"
								class="btn btn-secondary btn-sm text-brand font-extrabold text-xs px-3"
								download="dawa24_supplier_template.xlsx"
							>
								تحميل نموذج Excel
							</a>
						</div>

						<button
							type="submit"
							id="upload-submit-btn"
							class="btn btn-primary w-full justify-center font-extrabold text-sm p-3"
						>
							@components.IconCheck("icon-xs")
							<span id="upload-btn-text">رفع ومعالجة الملفات المختارة فورياً</span>
						</button>
					</form>
				</div>

				<!-- Column 3: Instant Search Box -->
				<div class="compare-col-card">
					<div class="d-flex items-center gap-2 border-b pb-3">
						<span class="text-lg">@components.IconSearch("icon-sm")</span>
						<h2 class="text-base font-extrabold text-primary m-0">
							البحث السريع والفوري
						</h2>
					</div>

					<div class="position-relative">
						<input
							type="text"
							name="q"
							id="instant-search-input"
							placeholder="ابحث عن دواء، مادة فعالة، كود..."
							class="form-input ps-8"
							oninput="filterSearchLocal(this.value)"
						/>
						<div class="position-absolute start-3 top-half translate-middle-y text-muted pointer-events-none">
							@components.IconSearch("icon-xs")
						</div>
					</div>

					<!-- Search Results Area -->
					<div id="instant-search-results" class="d-flex flex-col gap-2 max-h-96 overflow-y-auto">
						<div class="bg-surface-sunken rounded-xl p-6 text-center text-muted text-xs leading-relaxed">
							اكتب اسم الصنف للبحث المباشر عبر جميع كشوف الموردين المرفوعة ومقارنة الخصومات فورياً.
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- Scripts for compare tool interactions -->
		<script>
			function toggleSelectAll(masterCheckbox) {
				const checkboxes = document.querySelectorAll('.file-checkbox');
				checkboxes.forEach(cb => cb.checked = masterCheckbox.checked);
			}

			function validateCompareSelection(event) {
				const checked = document.querySelectorAll('.file-checkbox:checked');
				if (checked.length === 0) {
					const all = document.querySelectorAll('.file-checkbox');
					if (all.length > 0) {
						all.forEach(cb => cb.checked = true);
						return true;
					}
					alert("يرجى رفع ملف كشف أسعار واحد على الأقل للمقارنة.");
					event.preventDefault();
					return false;
				}
				return true;
			}

			function triggerFileInput() {
				const input = document.getElementById('file-upload-input');
				if (input) {
					input.click();
				}
			}

			function handleFileSelect(input) {
				const previewEl = document.getElementById('file-name-preview');
				if (!previewEl) return;

				if (input.files && input.files.length > 0) {
					if (input.files.length === 1) {
						const file = input.files[0];
						const size = (file.size / 1024 / 1024).toFixed(2);
						previewEl.innerHTML = `<span style="color:var(--accent); font-weight:800;">تم اختيار ملف:</span> <strong class="text-primary">${file.name}</strong> (${size} MB)`;
					} else {
						let fileNames = [];
						let totalSize = 0;
						for (let i = 0; i < input.files.length; i++) {
							fileNames.push(input.files[i].name);
							totalSize += input.files[i].size;
						}
						const totalMb = (totalSize / 1024 / 1024).toFixed(2);
						previewEl.innerHTML = `
							<div style="background:var(--surface-raised); padding:0.6rem 0.85rem; border-radius:var(--radius-lg); border:1px solid var(--border); text-align:start;">
								<div style="color:var(--accent); font-weight:800; margin-bottom:0.25rem;">تم اختيار (${input.files.length}) ملفات موردين (الإجمالي: ${totalMb} MB):</div>
								<div style="font-size:0.775rem; color:var(--text-secondary); max-height:80px; overflow-y:auto;">
									${fileNames.map(n => `• ${n}`).join('<br/>')}
								</div>
							</div>
						`;
					}
				} else {
					previewEl.innerHTML = '';
				}
			}

			// Setup drag and drop on drop zone box
			(function setupDropZone() {
				window.addEventListener('DOMContentLoaded', () => {
					const dropZone = document.getElementById('drop-zone-box');
					const fileInput = document.getElementById('file-upload-input');
					if (!dropZone || !fileInput) return;

					['dragenter', 'dragover'].forEach(eventName => {
						dropZone.addEventListener(eventName, (e) => {
							e.preventDefault();
							e.stopPropagation();
							dropZone.style.borderColor = 'var(--accent)';
							dropZone.style.background = 'var(--surface-raised)';
						}, false);
					});

					['dragleave', 'drop'].forEach(eventName => {
						dropZone.addEventListener(eventName, (e) => {
							e.preventDefault();
							e.stopPropagation();
							dropZone.style.borderColor = '';
							dropZone.style.background = '';
						}, false);
					});

					dropZone.addEventListener('drop', (e) => {
						const dt = e.dataTransfer;
						const files = dt.files;
						if (files && files.length > 0) {
							fileInput.files = files;
							handleFileSelect(fileInput);
						}
					}, false);
				});
			})();

			function handleUploadSubmit(event) {
				const fileInput = document.getElementById('file-upload-input');
				const dropZone = document.getElementById('drop-zone-box');

				if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
					alert("يرجى اختيار ملف Excel أو CSV واحد على الأقل للرفع والمعالجة.");
					event.preventDefault();
					triggerFileInput();
					return false;
				}

				const count = fileInput.files.length;

				if (dropZone) {
					const currentCount = parseInt(dropZone.dataset.currentCount || '0', 10);
					const maxLimit = parseInt(dropZone.dataset.maxLimit || '0', 10);
					if (maxLimit > 0 && (currentCount + count > maxLimit)) {
						alert(`عذراً، باقة اشتراكك الحالية تسمح بحد أقصى ${maxLimit} ملفات موردين.\nلديك حالياً ${currentCount} ملفات، ومحاولة رفع ${count} ملفات إضافية ستتجاوز الحد المسموح (${currentCount + count} / ${maxLimit}).\nيرجى تقليل عدد الملفات المرفوعة، أو حذف/أرشفة ملفات قديمة، أو ترقية باقتك.`);
						event.preventDefault();
						return false;
					}
				}

				const btn = document.getElementById('upload-submit-btn');
				const btnText = document.getElementById('upload-btn-text');
				if (btn && btnText) {
					btn.disabled = true;
					btn.style.opacity = '0.75';
					btnText.textContent = `⏳ جاري رفع ومعالجة (${count}) كشوف موردين...`;
				}

				// Allow normal form POST to proceed
				return true;
			}

			function promptRenameFile(id, currentName) {
				const newName = prompt("أدخل الاسم الجديد للمورد / الملف:", currentName);
				if (newName && newName.trim() !== "" && newName !== currentName) {
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = `/compare/files/${id}/rename`;
					const input = document.createElement('input');
					input.type = 'hidden';
					input.name = 'supplier_name';
					input.value = newName.trim();
					form.appendChild(input);
					document.body.appendChild(form);
					form.submit();
				}
			}

			function deleteFileConfirm(id) {
				if (confirm("هل أنت متأكد من حذف هذا الملف نهائياً من مركز الملفات؟")) {
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = `/compare/files/${id}/delete`;
					document.body.appendChild(form);
					form.submit();
				}
			}

			let searchTimeout = null;
			function filterSearchLocal(query) {
				clearTimeout(searchTimeout);
				const resultsContainer = document.getElementById('instant-search-results');
				if (!query || query.trim().length < 2) {
					resultsContainer.innerHTML = `
						<div style="padding:2rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:var(--radius-xl); color:var(--text-muted); font-size:0.85rem;">
							اكتب اسم الصنف للبحث المباشر عبر جميع كشوف الموردين المرفوعة ومقارنة الخصومات فورياً.
						</div>
					`;
					return;
				}

				resultsContainer.innerHTML = `
					<div style="padding:1.5rem 1rem; text-align:center; color:var(--text-muted); font-size:0.85rem;">
						⏳ جاري البحث عبر الكتالوج وكشوف الموردين...
					</div>
				`;

				searchTimeout = setTimeout(() => {
					fetch(`/compare/search?q=${encodeURIComponent(query.trim())}`, {
						headers: { 'Accept': 'application/json' }
					})
					.then(r => {
						if (!r.ok) throw new Error('Search failed');
						return r.json();
					})
					.then(data => {
						const items = data.items || [];
						if (items.length === 0) {
							resultsContainer.innerHTML = `
								<div style="padding:1.5rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:var(--radius-xl); color:var(--text-muted); font-size:0.85rem;">
									لم يتم العثور على أصناف مطابقة لـ "${query}".
								</div>
							`;
							return;
						}

						let html = `
							<div style="display:flex; justify-content:space-between; align-items:center; padding:0.25rem 0.5rem; font-size:0.775rem; color:var(--text-muted); border-bottom:1px solid var(--border); margin-bottom:0.35rem;">
								<span>تم العثور على <strong>${items.length}</strong> صنف</span>
								<span>بالكتالوج: ${data.in_catalog_count || 0} | أصناف موردين: ${data.custom_items_count || 0}</span>
							</div>
						`;

						items.slice(0, 15).forEach(item => {
							// 3-way status badge
							let statusBadge = '';
							if (item.catalog_status === 'catalog_and_suppliers') {
								statusBadge = '<span class="badge badge-emerald" style="font-size:0.68rem; font-weight:700;">معتمد بالكتالوج ومتوفر</span>';
							} else if (item.catalog_status === 'catalog_only') {
								statusBadge = '<span class="badge badge-sky" style="font-size:0.68rem; font-weight:700;">مسجل بالكتالوج (غير متوفر بالكشوف)</span>';
							} else {
								statusBadge = '<span class="badge badge-amber" style="font-size:0.68rem; font-weight:700;">صنف خاص بكشف المورد</span>';
							}

							// Best price and supplier pill
							let bestPriceHtml = '';
							if (item.best_net_price && parseFloat(item.best_net_price) > 0) {
								bestPriceHtml = `
									<div class="text-end">
										<div style="font-weight:900; color:var(--accent); font-size:0.95rem;" class="tabular-nums">
											${item.best_net_price} ج.م
										</div>
										<div style="font-size:0.725rem; color:var(--success-text); font-weight:700;">
											${item.best_supplier || 'أفضل سعر'} (${item.best_discount || 0}%)
										</div>
									</div>
								`;
							} else {
								bestPriceHtml = `
									<div style="text-align:end; font-size:0.75rem; color:var(--text-muted);">
										لا توجد عروض أسعار مرفوعة
									</div>
								`;
							}

							// Offers pill list
							let offersHtml = '';
							if (item.offers && Object.keys(item.offers).length > 0) {
								offersHtml = '<div style="display:flex; flex-wrap:wrap; gap:0.25rem; margin-top:0.4rem;">';
								for (const [sup, off] of Object.entries(item.offers)) {
									const isBest = (sup === item.best_supplier);
									const badgeClass = isBest ? 'badge-emerald' : 'badge-secondary';
									offersHtml += `
										<span class="badge ${badgeClass}" style="font-size:0.7rem; font-weight:600;">
											${sup}: ${off.discount || 0}% (${off.price_after_discount || '--'} ج.م)
										</span>
									`;
								}
								offersHtml += '</div>';
							}

							let missingHtml = '';
							if (item.missing_from_suppliers && item.missing_from_suppliers.length > 0 && Object.keys(item.offers || {}).length > 0) {
								missingHtml = '<div style="font-size:0.7rem; color:var(--danger-text); margin-top:0.3rem;">' +
									'غير مدرج لدى: <strong>' + item.missing_from_suppliers.join('، ') + '</strong>' +
								'</div>';
							}

							const skuHtml = item.sku ? ('<span style="font-size:0.725rem; color:var(--text-muted);" class="tabular-nums">كود: ' + item.sku + '</span>') : '';
							html += '<div style="padding:0.75rem 0.85rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); display:flex; flex-direction:column; gap:0.25rem; transition:border-color 0.2s ease;">' +
								'<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem;">' +
									'<div>' +
										'<div style="display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap; margin-bottom:0.2rem;">' +
											'<strong style="color:var(--text); font-size:0.875rem;">' + (item.product_name || 'صنف دوائي') + '</strong>' +
											statusBadge +
										'</div>' +
										skuHtml +
									'</div>' +
									bestPriceHtml +
								'</div>' +
								offersHtml +
								missingHtml +
							'</div>';
						});

						resultsContainer.innerHTML = html;
					})
					.catch(err => {
						resultsContainer.innerHTML = '<div style="padding:1.5rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:var(--radius-xl); color:var(--danger-text); font-size:0.85rem;">حدث خطأ أثناء البحث. يرجى المحاولة بكلمة بحث أخرى.</div>';
					});
				}, 250);
			}

			let isModalLoading = false;

			function openSetupModal(fileId, queue, step, total) {
				if (isModalLoading) return;
				const root = document.getElementById('mapping-modal-root');
				if (!root) return;

				isModalLoading = true;
				step = step || 1;
				total = total || 1;
				queue = queue || '';

				root.innerHTML = `
					<div style="position:fixed; inset:0; z-index:10000; display:flex; align-items:center; justify-content:center; background:rgba(15,23,42,0.75); backdrop-filter:blur(8px);">
						<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:2rem; color:var(--text); font-weight:800; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
							<div style="font-size:2.2rem;">@components.IconSettings("icon-sm")</div>
							<div style="font-size:1.05rem;">معالج ضبط الأعمدة (ملف ${step} من ${total})...</div>
							<div style="font-size:0.8rem; color:var(--text-muted); font-weight:600;">جاري قراءة البيانات وإعداد المعاينة الذكية</div>
						</div>
					</div>
				`;

				fetch(`/compare/files/${fileId}/mapping-modal?setup=1&queue=${encodeURIComponent(queue)}&step=${step}&total=${total}`)
					.then(res => {
						if (!res.ok) throw new Error('فشل فتح معالج ضبط الأعمدة');
						return res.text();
					})
					.then(html => {
						isModalLoading = false;
						root.innerHTML = html;
					})
					.catch(err => {
						isModalLoading = false;
						alert('تعذر فتح معالج ضبط الأعمدة: ' + err.message);
						root.innerHTML = '';
					});
			}

			function openMappingModal(fileId) {
				if (isModalLoading) return;
				const root = document.getElementById('mapping-modal-root');
				if (!root) return;

				isModalLoading = true;
				root.innerHTML = `
					<div style="position:fixed; inset:0; z-index:10000; display:flex; align-items:center; justify-content:center; background:rgba(15,23,42,0.75); backdrop-filter:blur(8px);">
						<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:2rem; color:var(--text); font-weight:800; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
							<div style="font-size:2rem;">⏳</div>
							<div>جاري قراءة أعمدة الملف ومعاينتها...</div>
						</div>
					</div>
				`;

				fetch(`/compare/files/${fileId}/mapping-modal`)
					.then(res => {
						if (!res.ok) throw new Error('فشل جلب نافذة تعيين الأعمدة');
						return res.text();
					})
					.then(html => {
						isModalLoading = false;
						root.innerHTML = html;
					})
					.catch(err => {
						isModalLoading = false;
						alert('تعذر فتح نافذة تعيين الأعمدة: ' + err.message);
						root.innerHTML = '';
					});
			}

			function submitMappingFormAsync(event) {
				event.preventDefault();
				const form = event.target;
				const submitBtn = document.getElementById('mapping-submit-btn');
				if (submitBtn) {
					submitBtn.disabled = true;
					submitBtn.style.opacity = '0.7';
					submitBtn.innerHTML = '⏳ جاري الحفظ والمعالجة...';
				}

				const formData = new FormData(form);

				fetch(form.action, {
					method: 'POST',
					body: formData,
					headers: {
						'Accept': 'application/json'
					}
				})
				.then(res => {
					if (!res.ok) throw new Error('حدث خطأ أثناء حفظ تعيين الأعمدة.');
					return res.json();
				})
				.then(data => {
					if (data.next_file_id && data.next_file_id > 0) {
						openSetupModal(data.next_file_id, data.remaining_queue, data.step, data.total);
					} else {
						closeMappingModal();
						window.location.href = '/compare/tool?notice=success&msg=' + encodeURIComponent('تم حفظ وتطبيق ضبط أعمدة كافة ملفات الموردين بنجاح.');
					}
				})
				.catch(err => {
					alert(err.message || 'تعذر حفظ تعيين الأعمدة.');
					if (submitBtn) {
						submitBtn.disabled = false;
						submitBtn.style.opacity = '1';
						submitBtn.innerHTML = 'حفظ وإعادة المحاولة';
					}
				});

				return false;
			}

			function handleSetupSkip(fileId, remainingQueue, step, total) {
				if (!confirm('هل أنت متأكد من تخطي هذا الملف؟ سيتم حذفه من المقارنة والانتقال للملف التالي.')) {
					return;
				}

				const root = document.getElementById('mapping-modal-root');
				if (root) {
					root.innerHTML = `
						<div style="position:fixed; inset:0; z-index:10000; display:flex; align-items:center; justify-content:center; background:rgba(15,23,42,0.75); backdrop-filter:blur(8px);">
							<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:2rem; color:var(--text); font-weight:800; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.75rem;">
								<div style="font-size:2rem;">⏩</div>
								<div>جاري تخطي الملف والانتقال للملف التالي...</div>
							</div>
						</div>
					`;
				}

				const formData = new FormData();
				formData.append('setup_queue', remainingQueue);
				formData.append('step', step);
				formData.append('total', total);

				fetch(`/compare/files/${fileId}/skip`, {
					method: 'POST',
					body: formData,
					headers: {
						'Accept': 'application/json'
					}
				})
				.then(res => {
					if (!res.ok) throw new Error('فشل تخطي الملف.');
					return res.json();
				})
				.then(data => {
					if (data.next_file_id && data.next_file_id > 0) {
						openSetupModal(data.next_file_id, data.remaining_queue, data.step, data.total);
					} else {
						closeMappingModal();
						window.location.href = '/compare/tool?notice=success&msg=' + encodeURIComponent('تم تخطي الملف والانتهاء من معالج الإعداد.');
					}
				})
				.catch(err => {
					alert(err.message || 'تعذر تخطي الملف.');
					closeMappingModal();
				});
			}

			function closeMappingModal() {
				const root = document.getElementById('mapping-modal-root');
				if (root) {
					root.innerHTML = '';
				}
			}

			// Auto open Setup Modal or Mapping Modal on page load if query param is set
			window.addEventListener('DOMContentLoaded', () => {
				const params = new URLSearchParams(window.location.search);
				const setupFile = params.get('setup_file');
				const setupQueue = params.get('setup_queue');
				const setupStep = parseInt(params.get('setup_step') || '1', 10);
				const setupTotal = parseInt(params.get('setup_total') || '1', 10);

				if (setupFile) {
					openSetupModal(setupFile, setupQueue, setupStep, setupTotal);
				} else {
					const openFileId = params.get('open_mapping') || params.get('mapping_file');
					if (openFileId) {
						openMappingModal(openFileId);
					}
				}
			});
		</script>

		<!-- Root container for dynamically injected mapping modal -->
		<div id="mapping-modal-root"></div>
	}
}

// compareMatchPanel is the catalogue matching control and its AI switch.
//
// It is a form of its own, sitting outside the comparison form, and every
// per-file match button joins it through the HTML form attribute. That is what
// lets one switch govern every file's run without repeating the checkbox on
// each card.
templ compareMatchPanel(matching CompareMatchOptions) {
	<form method="POST" action="/compare/tool" id="compare-match-form"
		class="compare-match-panel">
		<div class="d-flex items-center gap-2 mb-1">
			<span class="text-base">@components.IconExternalLink("icon-sm")</span>
			<strong class="text-xs font-extrabold text-primary">مطابقة الأصناف بالكتالوج المركزي</strong>
		</div>
		<p class="text-xs text-muted m-0 mb-2 leading-relaxed">
			اضغط بجوار أي ملف لربط أصنافه بالكتالوج المركزي. المقارنة بين الموردين تصبح على مستوى
			الصنف نفسه بدل الاعتماد على تشابه الأسماء، وتُحفظ الروابط لاستخدامها في المرات القادمة.
		</p>
		if matching.AIAvailable {
			<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold">
				<input type="checkbox" name="use_ai" value="1" class="form-checkbox" checked/>
				<span>استخدام الذكاء الاصطناعي للأصناف التي تعذّرت مطابقتها حتمياً</span>
			</label>
			<div class="text-xs text-muted mt-1">
				يعمل فقط على الأصناف التي لم تُحسم حسابياً، ويستخدم ذاكرة القرارات المشتركة أولاً بلا تكلفة.
				أوقفه لتشغيل المطابقة الحتمية وحدها بلا أي استهلاك.
			</div>
		} else {
			<div class="text-xs text-muted">
				خدمة الذكاء الاصطناعي غير مهيّأة على هذا الخادم؛ تعمل المطابقة الحتمية وحدها.
			</div>
		}
	</form>
}
