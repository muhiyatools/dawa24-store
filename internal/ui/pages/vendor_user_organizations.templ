package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorUserOrgData struct {
	UserOrgs      []*org.UserOrganization
	AllCustomers  []*identity.User
	ActiveTab     string
	TotalCount    int
	PendingCount  int
	ApprovedCount int
	RejectedCount int
	NoticeType    string
	NoticeMsg     string
	Page          int
	PerPage       int
	FilteredTotal int
}

templ VendorUserOrganizationsPage(lang, dir string, data *VendorUserOrgData) {
	@layouts.VendorShell("مستخدمو المنظمات | إدارة المنشأة", "user_organization", lang, dir) {
		<div class="page-container">

			<!-- Notice Banner -->
			if data != nil && data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-4 p-4 d-flex items-center gap-2">
						<span>@components.IconAlert("icon-sm")</span>
						<strong>{ data.NoticeMsg }</strong>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 d-flex items-center gap-2">
						<span>@components.IconCheckCircle("icon-sm")</span>
						<strong>{ data.NoticeMsg }</strong>
					</div>
				}
			}

			<!-- Top Nav Tabs matching System -->
			<div class="tabs-nav">
				<a href="/vendor/organization" class="tab-btn">
					المؤسسة
				</a>
				<a href="/vendor/team" class="tab-btn">
					الموظفون
				</a>
				<a href="/vendor/user-organization" class="tab-btn active">
					المستخدم-المنظمة
				</a>
				<a href="/vendor/branches" class="tab-btn">
					الفروع
				</a>
				<a href="/vendor/roles" class="tab-btn">
					الأدوار
				</a>
			</div>

			<!-- Header Banner matching system -->
			<div class="glass-panel p-5 mb-4 d-flex items-center justify-between flex-wrap gap-4">
				<div>
					<div class="d-flex items-center gap-2 mb-1">
						<div class="user-avatar-badge">
							@components.IconUsers("icon-sm")
						</div>
						<h1 class="page-title font-bold text-xl m-0">
							مستخدمو المنظمات (MANAGE ORGANIZATION MEMBERS)
						</h1>
					</div>
					<p class="text-xs text-secondary m-0">
						إدارة وتدقيق طلبات ربط الصيدليات وتعيين أكواد المنظمات (Organization Numbers) وتفعيل أو رفض الحسابات.
					</p>
				</div>

				<div>
					<button
						type="button"
						class="btn btn-primary btn-sm fw-800"
						data-modal-open="add-vendor-user-org-modal"
					>
						@components.IconPlus("icon-xs")
						<span>ADD USER + (إضافة مستخدم)</span>
					</button>
				</div>
			</div>

			<!-- Add User Organization Modal -->
			@components.Modal(components.ModalProps{
				ID:    "add-vendor-user-org-modal",
				Title: "ربط مستخدم / صيدلية وتعيين رقم المنظمة",
				Size:  "md",
			}) {
				<form method="POST" class="d-flex flex-col gap-3 m-0" action="/vendor/user-organization/new">
					<!-- Live AJAX User Search with Debouncing -->
					<div class="form-group m-0 relative">
						<label class="form-label text-xs font-bold" for="vendor-uo-user-search">
							المستخدم / الصيدلية المستهدفة *
						</label>
						
						<!-- Hidden Input holding the selected User ID -->
						<input type="hidden" id="vendor-selected-user-id" name="user_id" required value="" />

						<!-- Selected User Chip Card (shown once a user is chosen) -->
						<div class="uo-user-chip" id="vendor-selected-user-chip" style="display: none;">
							<div class="d-flex items-center gap-2">
								<span class="text-primary">@components.IconUser("icon-sm")</span>
								<div>
									<strong id="vendor-selected-user-name" class="d-block text-xs font-bold"></strong>
									<div id="vendor-selected-user-details" class="text-2xs text-muted" dir="ltr"></div>
								</div>
							</div>
							<button type="button" class="btn btn-ghost btn-xs text-danger font-bold" onclick="clearVendorSelectedUser()">
								تغيير
							</button>
						</div>

						<!-- Search Input Field -->
						<div id="vendor-search-input-wrapper" class="relative">
							<input
								type="text"
								id="vendor-uo-user-search"
								placeholder="ابحث بالاسم أو البريد الإلكتروني أو الهاتف..."
								autocomplete="off"
								class="form-control font-bold"
								oninput="handleVendorUserSearch(this.value)"
								onfocus="handleVendorUserSearch(this.value)"
							/>
							<div class="position-absolute inset-inline-end-3 top-50 translate-middle-y" id="vendor-search-spinner" style="display: none;">
								⏳
							</div>
						</div>

						<!-- Autocomplete Results Dropdown -->
						<div class="uo-search-dropdown" id="vendor-user-search-dropdown" style="display: none;"></div>
					</div>

					<div class="form-group m-0">
						<label class="form-label text-xs font-bold" for="vendor-uo-number">
							رقم المنظمة لدى شركتك (Organization Number) *
						</label>
						<input
							type="text"
							id="vendor-uo-number"
							name="organization_number"
							required
							placeholder="مثال: NUM10001 أو 010645645..."
							class="form-control font-bold"
							dir="ltr"
						/>
					</div>

					<div class="form-group m-0">
						<label class="form-label text-xs font-bold" for="vendor-uo-notes">
							ملاحظات
						</label>
						<textarea
							id="vendor-uo-notes"
							name="notes"
							rows="2"
							placeholder="أي تفاصيل أو ملاحظات..."
							class="form-control"
						></textarea>
					</div>

					<div class="d-flex justify-end gap-2 mt-2">
						<button
							type="button"
							class="btn btn-secondary btn-sm"
							data-modal-close="add-vendor-user-org-modal"
						>
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary btn-sm fw-800">
							ربط واعتماد المستخدم
						</button>
					</div>
				</form>
			}

			<!-- Filter Status Pills matching old reference UI (الكل، قيد الانتظار، Approval، مرفوض) -->
			if data != nil {
				<div class="d-flex items-center gap-2 mb-4 flex-wrap">
					<a
						href="/vendor/user-organization?status=all"
						class={ "btn btn-xs fw-800", templ.KV("btn-primary", data.ActiveTab == "" || data.ActiveTab == "all"), templ.KV("btn-secondary", data.ActiveTab != "" && data.ActiveTab != "all") }
					>
						<span>الكل</span>
						<span class="badge text-2xs tabular-nums">{ fmt.Sprintf("%d", data.TotalCount) }</span>
					</a>

					<a
						href="/vendor/user-organization?status=pending"
						class={ "btn btn-xs fw-800", templ.KV("btn-primary", data.ActiveTab == "pending"), templ.KV("btn-secondary", data.ActiveTab != "pending") }
					>
						<span>قيد الانتظار</span>
						<span class="badge badge-amber text-2xs tabular-nums">{ fmt.Sprintf("%d", data.PendingCount) }</span>
					</a>

					<a
						href="/vendor/user-organization?status=approved"
						class={ "btn btn-xs fw-800", templ.KV("btn-primary", data.ActiveTab == "approved"), templ.KV("btn-secondary", data.ActiveTab != "approved") }
					>
						<span>Approval</span>
						<span class="badge badge-emerald text-2xs tabular-nums">{ fmt.Sprintf("%d", data.ApprovedCount) }</span>
					</a>

					<a
						href="/vendor/user-organization?status=rejected"
						class={ "btn btn-xs fw-800", templ.KV("btn-primary", data.ActiveTab == "rejected"), templ.KV("btn-secondary", data.ActiveTab != "rejected") }
					>
						<span>مرفوض</span>
						<span class="badge badge-rose text-2xs tabular-nums">{ fmt.Sprintf("%d", data.RejectedCount) }</span>
					</a>
				</div>
			}

			<!-- List of Users / Connected Organizations (Matching Old Reference UI) -->
			if data == nil || len(data.UserOrgs) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد طلبات أو مستخدمين",
					Message: "لم يتم تقديم أي طلبات ربط تحت هذا التصنيف حالياً.",
				})
			} else {
				<div class="d-flex flex-col gap-3">
					for _, uo := range data.UserOrgs {
						if uo != nil {
							<div class="glass-panel p-4 d-flex items-center justify-between flex-wrap gap-3">
								<!-- User Details -->
								<div class="d-flex items-center gap-3">
									<div class="w-10 h-10 rounded-lg bg-primary-subtle text-primary border border-primary-subtle d-flex items-center justify-center font-bold text-base flex-shrink-0">
										if len(uo.UserName) > 0 {
											{ string([]rune(uo.UserName)[0:1]) }
										} else {
											<span>@components.IconUser("icon-sm")</span>
										}
									</div>

									<div>
										<div class="d-flex items-center gap-2 flex-wrap">
											<strong class="text-sm font-bold text-primary">{ uo.UserName }</strong>
											if uo.CustomerOrgName != "" {
												<span class="badge badge-slate text-2xs">{ uo.CustomerOrgName }</span>
											}
											<!-- Org Code Badge -->
											<span class="badge badge-sky text-2xs fw-800 tabular-nums" dir="ltr">
												{ uo.OrganizationNumber }
											</span>
										</div>

										<div class="text-xs text-muted tabular-nums" dir="ltr">
											{ uo.UserEmail }
										</div>

										<div class="text-2xs text-secondary mt-0.5">
											تاريخ الطلب: <span class="tabular-nums font-bold">{ format.Date(uo.CreatedAt, "ar") }</span>
										</div>

										if uo.Notes != "" {
											<div class="text-2xs text-muted mt-0.5">
												<strong>ملاحظات:</strong> { uo.Notes }
											</div>
										}
									</div>
								</div>

								<!-- Action Buttons on Left matching Old Reference UI -->
								<div class="d-flex items-center gap-2 flex-wrap">
									
									<!-- If pending: show Approve & Reject buttons -->
									if uo.Status == org.UserOrgStatusPending {
										<span class="badge badge-amber text-2xs fw-800">قيد الانتظار</span>

										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/user-organization/%d/approve", uo.ID)) } class="m-0 d-inline">
											<button type="submit" class="btn btn-primary btn-xs fw-800">
												@components.IconCheck("icon-xs")
												<span>APPROVAL</span>
											</button>
										</form>

										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/user-organization/%d/reject", uo.ID)) } class="m-0 d-inline">
											<button type="submit" class="btn btn-secondary btn-xs fw-800 text-danger">
												@components.IconClose("icon-xs")
												<span>رفض</span>
											</button>
										</form>
									} else if uo.Status == org.UserOrgStatusApproved {
										<span class="badge badge-emerald text-2xs fw-800">APPROVAL</span>
									} else if uo.Status == org.UserOrgStatusRejected {
										<span class="badge badge-rose text-2xs fw-800">مرفوض</span>
									}

									<!-- Edit Button -->
									<button
										type="button"
										class="btn btn-secondary btn-xs"
										title="تعديل رقم المنظمة"
										data-modal-open={ fmt.Sprintf("vendor-edit-uo-modal-%d", uo.ID) }
									>
										@components.IconEdit("icon-xs")
									</button>

									<!-- Delete Button -->
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/user-organization/%d/delete", uo.ID)) } class="m-0 d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المستخدم؟');">
										<button type="submit" class="btn btn-secondary btn-xs text-danger" title="حذف الربط">
											@components.IconTrash("icon-xs")
										</button>
									</form>
								</div>

								<!-- Edit Modal for Vendor -->
								@components.Modal(components.ModalProps{
									ID:    fmt.Sprintf("vendor-edit-uo-modal-%d", uo.ID),
									Title: fmt.Sprintf("تعديل رقم المنظمة للمستخدم %s", uo.UserName),
									Size:  "md",
								}) {
									<form method="POST" class="d-flex flex-col gap-3 m-0" action={ templ.SafeURL(fmt.Sprintf("/vendor/user-organization/%d/edit", uo.ID)) }>
										<div class="form-group m-0">
											<label class="form-label text-xs font-bold" for={ fmt.Sprintf("vendor-edit-num-%d", uo.ID) }>
												رقم المنظمة (Organization Number) *
											</label>
											<input
												type="text"
												id={ fmt.Sprintf("vendor-edit-num-%d", uo.ID) }
												name="organization_number"
												value={ uo.OrganizationNumber }
												required
												class="form-control font-bold"
												dir="ltr"
											/>
										</div>

										<div class="form-group m-0">
											<label class="form-label text-xs font-bold" for={ fmt.Sprintf("vendor-edit-notes-%d", uo.ID) }>
												ملاحظات
											</label>
											<textarea
												id={ fmt.Sprintf("vendor-edit-notes-%d", uo.ID) }
												name="notes"
												rows="2"
												class="form-control"
											>{ uo.Notes }</textarea>
										</div>

										<div class="d-flex justify-end gap-2 mt-2">
											<button
												type="button"
												class="btn btn-secondary btn-sm"
												data-modal-close={ fmt.Sprintf("vendor-edit-uo-modal-%d", uo.ID) }
											>
												إلغاء
											</button>
											<button type="submit" class="btn btn-primary btn-sm fw-800">
												حفظ التعديلات
											</button>
										</div>
									</form>
								}

							</div>
						}
					}
				</div>
				if data != nil && data.FilteredTotal > 0 {
					@components.B2BPagination(components.PaginationProps{
						CurrentPage: data.Page,
						PageSize:    data.PerPage,
						TotalCount:  data.FilteredTotal,
						BaseURL:     "/vendor/user-organization",
						QueryValues: map[string][]string{
							"status": {data.ActiveTab},
						},
					})
				}
			}

		</div>

		<script>
			let searchDebounceTimer = null;

			function handleVendorUserSearch(val) {
				clearTimeout(searchDebounceTimer);
				const dropdown = document.getElementById('vendor-user-search-dropdown');
				const spinner = document.getElementById('vendor-search-spinner');
				if (!dropdown) return;

				const query = (val || '').trim();
				if (!query) {
					dropdown.style.display = 'none';
					dropdown.innerHTML = '';
					if (spinner) spinner.style.display = 'none';
					return;
				}

				if (spinner) spinner.style.display = 'block';

				searchDebounceTimer = setTimeout(() => {
					fetch('/vendor/api/users/search?q=' + encodeURIComponent(query))
						.then(res => res.json())
						.then(users => {
							if (spinner) spinner.style.display = 'none';
							if (!users || users.length === 0) {
								dropdown.innerHTML = '<div class="p-3 text-xs text-muted text-center">لا توجد حسابات صيدليات أو مستخدمين مطابقة</div>';
								dropdown.style.display = 'block';
								return;
							}

							let html = '';
							users.forEach(u => {
								const safeName = (u.name || 'بدون اسم').replace(/'/g, "\\'");
								const safeEmail = (u.email || '').replace(/'/g, "\\'");
								const safePhone = (u.phone || '').replace(/'/g, "\\'");
								html += `
									<div class="uo-search-item"
										onclick="selectVendorUser(${u.id}, '${safeName}', '${safeEmail}', '${safePhone}')"
									>
										<div>
											<strong class="d-block text-xs font-bold text-primary">${u.name}</strong>
											<div class="text-2xs text-muted" dir="ltr">${u.email} ${u.phone ? '• ' + u.phone : ''}</div>
										</div>
										<span class="badge badge-sky text-2xs tabular-nums">#${u.id}</span>
									</div>
								`;
							});
							dropdown.innerHTML = html;
							dropdown.style.display = 'block';
						})
						.catch(err => {
							if (spinner) spinner.style.display = 'none';
							dropdown.innerHTML = '<div class="p-3 text-xs text-danger text-center">حدث خطأ أثناء البحث</div>';
							dropdown.style.display = 'block';
						});
				}, 250);
			}

			function selectVendorUser(id, name, email, phone) {
				const hiddenInput = document.getElementById('vendor-selected-user-id');
				const chip = document.getElementById('vendor-selected-user-chip');
				const chipName = document.getElementById('vendor-selected-user-name');
				const chipDetails = document.getElementById('vendor-selected-user-details');
				const searchWrapper = document.getElementById('vendor-search-input-wrapper');
				const dropdown = document.getElementById('vendor-user-search-dropdown');
				const searchInput = document.getElementById('vendor-uo-user-search');

				if (hiddenInput) hiddenInput.value = id;
				if (chipName) chipName.textContent = name;
				if (chipDetails) chipDetails.textContent = email + (phone ? ' • ' + phone : '') + ' (ID: #' + id + ')';
				if (chip) chip.style.display = 'flex';
				if (searchWrapper) searchWrapper.style.display = 'none';
				if (dropdown) {
					dropdown.style.display = 'none';
					dropdown.innerHTML = '';
				}
				if (searchInput) searchInput.value = '';
			}

			function clearVendorSelectedUser() {
				const hiddenInput = document.getElementById('vendor-selected-user-id');
				const chip = document.getElementById('vendor-selected-user-chip');
				const searchWrapper = document.getElementById('vendor-search-input-wrapper');
				const searchInput = document.getElementById('vendor-uo-user-search');

				if (hiddenInput) hiddenInput.value = '';
				if (chip) chip.style.display = 'none';
				if (searchWrapper) searchWrapper.style.display = 'block';
				if (searchInput) {
					searchInput.value = '';
					searchInput.focus();
				}
			}

			document.addEventListener('click', (e) => {
				const dropdown = document.getElementById('vendor-user-search-dropdown');
				const searchInput = document.getElementById('vendor-uo-user-search');
				if (dropdown && !dropdown.contains(e.target) && e.target !== searchInput) {
					dropdown.style.display = 'none';
				}
			});
		</script>
	}
}
