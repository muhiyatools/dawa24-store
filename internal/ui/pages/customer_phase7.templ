package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)


// CustomerSavingProductsPage renders customer saving products list.
templ CustomerSavingProductsPage(search string, lang, dir string) {
	@layouts.CustomerShell("منتجات التوفير وتتبع فروق الأسعار", "saving_products", lang, dir, nil) {
		<div class="card" style="margin-bottom:0;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 class="card-title" style="margin:0;">تتبع فروق الأسعار والخصومات الحية</h2>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.2rem;">مقارنة مستمرة بين أسعار مشترياتك السابقة وعروض الموردين الحالية في السوق.</p>
				</div>
				<a href="/customer/saving-products/import" class="btn btn-secondary btn-sm">استيراد قائمة أدوية</a>
			</div>

			<form method="GET" action="/customer/saving-products" style="margin-bottom:1.5rem;">
				<div style="display:flex; gap:0.5rem; max-width:500px;">
					<input type="text" name="q" value={ search } placeholder="ابحث في قائمة أدوية التوفير..." class="form-input" style="flex:1;" />
					<button type="submit" class="btn btn-secondary">بحث</button>
				</div>
			</form>

			@components.EmptyState(components.EmptyStateProps{Title: "قائمة التوفير فارغة", Message: "قم برفع ملف بأدويتك الأكثر استهلاكاً لتنبيهك عند توفر عروض بخصومات أعلى لدى الموردين."})
		</div>
	}
}

// CustomerSavingProductsImportPage renders bulk spreadsheet upload.
templ CustomerSavingProductsImportPage(lang, dir string) {
	@layouts.CustomerShell("استيراد أدوية التوفير", "saving_products", lang, dir, nil) {
		<div class="card" style="max-width:800px; margin:0 auto;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 class="card-title" style="margin:0;">استيراد قائمة الأدوية للتوفير</h2>
				</div>
				<a href="/customer/saving-products" class="btn btn-secondary btn-sm">العودة</a>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "معالج الرفع الذكي", Message: "ارفع شيت الأدوية وسيتم مطابقتها تلقائياً وتتبع أسعارها."})
		</div>
	}
}

// CustomerSavingProductDetailPage renders single product delta details.
templ CustomerSavingProductDetailPage(id int64, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("صنف توفير #%d", id), "saving_products", lang, dir, nil) {
		<div class="card" style="max-width:800px; margin:0 auto;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 class="card-title" style="margin:0;">تفاصيل الصنف #{ fmt.Sprintf("%d", id) }</h2>
				</div>
				<a href="/customer/saving-products" class="btn btn-secondary btn-sm">العودة</a>
			</div>
		</div>
	}
}

// CustomerOfferOrdersPage renders offer-based orders.
templ CustomerOfferOrdersPage(orders []*commerce.Order, lang, dir string) {
	@layouts.CustomerShell("طلبات العروض والصفقات", "orders_offers", lang, dir, nil) {
		<div class="card" style="margin-bottom:0;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 class="card-title" style="margin:0;">طلبات العروض والصفقات الخاصة ({ fmt.Sprintf("%d", len(orders)) })</h2>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.2rem;">أوامر الشراء المشتملة على عروض ترويجية وباقات خصومات خاصة.</p>
				</div>
			</div>

			if len(orders) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات عروض مسجلة", Message: "تصفح قسم العروض واطلب الكميات المطلوبة للاستفادة من أعلى خصم متاح."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>رقم الطلب</th>
								<th>الإجمالي</th>
								<th>الخصم</th>
								<th>الحالة</th>
								<th style="text-align:end;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range orders {
								<tr>
									<td class="tabular-nums"><strong>{ o.OrderNumber }</strong></td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", o.TotalAmount.String()) }</td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", o.TotalDiscount.String()) }</td>
									<td><span class="badge badge-sky">{ string(o.Status) }</span></td>
									<td style="text-align:end;">
										<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-secondary btn-sm">عرض الطلب</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// CustomerOfferCheckoutPage renders checkout for an offer.
templ CustomerOfferCheckoutPage(offer *promo.Offer, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("إتمام طلب العرض: %s", offer.Title.Get("ar")), "offers", lang, dir, nil) {
		<div class="card" style="max-width:800px; margin:0 auto;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 class="card-title" style="margin:0;">إتمام شراء العرض: { offer.Title.Get("ar") }</h2>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.2rem;">قيمة الخصم: { offer.DiscountValue.String() }</p>
				</div>
				<a href="/offers" class="btn btn-secondary btn-sm">إلغاء والعودة</a>
			</div>

			<form method="POST" action="/checkout">
				<input type="hidden" name="offer_id" value={ fmt.Sprintf("%d", offer.ID) } />
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md); margin-bottom:1.5rem;">
					<h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.75rem;">بيانات التسليم والفرع</h3>
					<div style="display:flex; flex-direction:column; gap:1rem;">
						<div>
							<label class="form-label">فرع الاستلام</label>
							<select name="branch_id" class="form-input" required>
								<option value="1">الفرع الرئيسي للصيدلية</option>
							</select>
						</div>
						<div>
							<label class="form-label">ملاحظات التوصيل</label>
							<textarea name="notes" class="form-input" rows="2" placeholder="مواعيد التسليم أو تعليمات الشحن..."></textarea>
						</div>
					</div>
				</div>

				<div style="display:flex; justify-content:flex-end;">
					<button type="submit" class="btn btn-primary">تأكيد وإرسال أمر الشراء</button>
				</div>
			</form>
		</div>
	}
}

// CustomerAddOrderPage renders manual order form.
templ CustomerAddOrderPage(lang, dir string) {
	@layouts.CustomerShell("طلب شراء سريع", "orders", lang, dir, nil) {
		<div class="card" style="max-width:800px; margin:0 auto;">
			<h2 class="card-title" style="margin-bottom:1.5rem;">إضافة أمر شراء يدوي سريع</h2>
			@components.EmptyState(components.EmptyStateProps{Title: "الطلب اليدوي", Message: "يمكنك إضافة الأصناف والكميات مباشرة لإرسالها لأقرب مورد معتمد."})
		</div>
	}
}

// GuestOrderTrackingPage renders public tracking screen.
templ GuestOrderTrackingPage(orderNumber string, order *commerce.Order, lang, dir string) {
	@layouts.PublicShell("تتبع حالة الطلب والشحنة", lang, dir) {
		<div class="container" style="max-width:700px; padding:3rem 1rem; margin:0 auto;">
			<div class="card">
				<h2 class="card-title" style="text-align:center; margin-bottom:0.5rem;">تتبع شحنات وطلبات دواء 24</h2>
				<p style="text-align:center; color:var(--text-secondary); font-size:0.9rem; margin-bottom:1.5rem;">أدخل رقم الطلب لمعرفة حالة التجهيز والشحن دون الحاجة لتسجيل الدخول.</p>

				<form method="GET" action="/tracking" style="display:flex; gap:0.5rem; margin-bottom:2rem;">
					<input type="text" name="order_number" value={ orderNumber } placeholder="مثال: ORD-20260819-XXXXXX" class="form-input" style="flex:1;" required />
					<button type="submit" class="btn btn-primary">تتبع الآن</button>
				</form>

				if orderNumber != "" {
					if order != nil {
						<div style="background:var(--surface-sunken); padding:1.5rem; border-radius:var(--radius-md);">
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
								<div>
									<div style="font-size:0.85rem; color:var(--text-secondary);">رقم الطلب</div>
									<div style="font-size:1.15rem; font-weight:700; color:var(--text);"><code>{ order.OrderNumber }</code></div>
								</div>
								<span class="badge badge-sky" style="font-size:0.9rem; padding:0.4rem 0.8rem;">{ string(order.Status) }</span>
							</div>
							<div style="font-size:0.85rem; color:var(--text-secondary);">
								تاريخ الإنشاء: <span class="tabular-nums">{ order.CreatedAt.Format("2006-01-02 15:04") }</span>
							</div>
						</div>
					} else {
						@components.EmptyState(components.EmptyStateProps{Title: "لم يتم العثور على الطلب", Message: "تأكد من إدخال رقم الطلب بصورة صحيحة."})
					}
				}
			</div>
		</div>
	}
}
