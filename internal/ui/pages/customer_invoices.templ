package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ InvoicesPage(lang, dir string, data InvoicesData) {
	@layouts.ShellFor("الفواتير الضريبية والإلكترونية", "invoices", lang, dir, authctx.FromContext(ctx)) {

		<div style="max-width:100%; margin:0 0 4rem 0;">
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
						<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
							@components.IconFileText("icon-sm")
						</div>
						<h2 style="font-size:1.6rem; font-weight:900; color:var(--neutral-900); margin:0;">
							الفواتير الضريبية والإلكترونية
						</h2>
					</div>
					<p style="color:var(--neutral-500); font-size:0.925rem; margin:0;">
						الفواتير الرسمية المعتمدة من منظومة الضرائب المصرية (ETA e-Invoicing)
					</p>
				</div>
			</div>

			<div class="card p-modal">
				if len(data.Invoices) == 0 {
					<div style="padding:3rem 1rem; text-align:center; color:var(--neutral-500);">
						<div style="width:48px; height:48px; border-radius:var(--radius-full); background:var(--neutral-100); color:var(--neutral-400); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;">
							@components.IconFileText("icon-md")
						</div>
						<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-800); margin-bottom:0.35rem;">لا توجد فواتير صادرة حالياً</h3>
						<p class="text-sm">تظهر الفواتير الضريبية فور اكتمال تسليم أوامر الشراء واعتمادها من المورد.</p>
					</div>
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th>رقم الفاتورة</th>
									<th>رقم الطلبية</th>
									<th>المبلغ الإجمالي</th>
									<th>ضريبة القيمة المضافة (VAT)</th>
									<th>تاريخ الإصدار</th>
									<th>الحالة الضريبية</th>
								</tr>
							</thead>
							<tbody>
								for _, inv := range data.Invoices {
									<tr>
										<td class="tabular-nums" style="font-weight:700; color:var(--primary-700);">{ inv.InvoiceNumber }</td>
										<td class="tabular-nums">
											if inv.OrderID != nil {
												#{ fmt.Sprintf("%d", *inv.OrderID) }
											} else {
												—
											}
										</td>
										<td class="tabular-nums fw-800">{ inv.TotalAmount.String() } ج.م</td>
										<td class="tabular-nums" style="color:var(--neutral-600);">{ inv.TaxAmount.String() } ج.م</td>
										<td class="tabular-nums" style="color:var(--neutral-500); font-size:0.85rem;">{ inv.IssueDate.Format("2006-01-02") }</td>
										<td>
											<span class="badge badge-emerald">
												@components.IconCheckCircle("icon-xs")
												<span>معتمدة ضريبياً</span>
											</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
