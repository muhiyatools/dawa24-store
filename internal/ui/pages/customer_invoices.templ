package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ InvoicesPage(lang, dir string, data InvoicesData) {
	@layouts.ShellFor("فواتير وسندات التوريد", "invoices", lang, dir, authctx.FromContext(ctx)) {
		<div class="page-container">
			
			<!-- Header Banner -->
			<div class="glass-panel p-5 mb-4">
				<div class="d-flex items-center justify-between flex-wrap gap-3">
					<div>
						<div class="d-flex items-center gap-2 mb-1">
							<div class="user-avatar-badge">
								@components.IconFileText("icon-sm")
							</div>
							<h1 class="page-title text-xl font-bold m-0">
								فواتير وسندات التوريد
							</h1>
						</div>
						<p class="text-xs text-secondary m-0">
							سجل الفواتير وسندات التوريد الصادرة لطلبيات الأدوية مع تفاصيل المبالغ والبنود وقابلة للطباعة الفورية.
						</p>
					</div>

					<div>
						<span class="badge badge-secondary text-xs font-bold">
							@components.IconFileText("icon-xs")
							<span>سجل الفواتير الضريبية</span>
						</span>
					</div>
				</div>
			</div>

			<!-- Search & Filter Bar -->
			<div class="invoices-filter-card mb-4">
				<form method="GET" class="invoices-filter-form" action="/invoices">
					<div>
						<input
							type="text"
							name="q"
							value={ data.Search }
							placeholder="بحث برقم الفاتورة، رقم الطلبية، اسم الصيدلية..."
							class="form-control w-full font-semibold"
						/>
					</div>

					<div>
						<select name="status" class="form-select form-select-sm w-full font-semibold">
							<option value="">-- جميع الحالات --</option>
							<option value="paid" selected?={ data.StatusFilter == "paid" }>مدفوعة (Paid)</option>
							<option value="issued" selected?={ data.StatusFilter == "issued" }>صادرة (Issued)</option>
							<option value="overdue" selected?={ data.StatusFilter == "overdue" }>متأخرة (Overdue)</option>
							<option value="cancelled" selected?={ data.StatusFilter == "cancelled" }>ملغاة (Cancelled)</option>
						</select>
					</div>

					<button type="submit" class="btn btn-primary btn-sm fw-800">
						تطبيق الفلتر
					</button>
				</form>
			</div>

			<!-- Invoices Table -->
			<div class="glass-panel p-0">
				if len(data.Invoices) == 0 {
					<div class="p-6 text-center">
						<div class="mb-2 text-2xl text-muted">
							@components.IconFile("icon-md")
						</div>
						<h3 class="font-bold text-sm m-0">
							لا توجد فواتير مطابقة
						</h3>
						<p class="text-xs text-secondary m-0 mt-1">
							يتم إنشاء وتوثيق فواتير وسندات التوريد تلقائياً فور تسجيل واعتماد أوامر الشراء.
						</p>
					</div>
				} else {
					<div class="table-responsive">
						<table class="data-table mb-0">
							<thead>
								<tr>
									<th>رقم الفاتورة</th>
									<th>رقم الطلبية</th>
									<th>الطرف المستلم</th>
									<th>تاريخ الإصدار</th>
									<th>المبلغ الإجمالي</th>
									<th>الحالة</th>
									<th>الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, inv := range data.Invoices {
									<tr>
										<!-- رقم الفاتورة -->
										<td>
											<a
												href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print", inv.ID)) }
												target="_blank"
												class="tabular-nums fw-800 text-primary"
											>
												{ inv.InvoiceNumber }
											</a>
										</td>

										<!-- رقم الطلبية -->
										<td class="tabular-nums">
											if inv.OrderID != nil {
												<span class="badge badge-secondary text-2xs font-bold">
													#{ fmt.Sprintf("%d", *inv.OrderID) }
												</span>
											} else if inv.OrderNumber != "" {
												<span class="badge badge-secondary text-2xs font-bold">
													#{ inv.OrderNumber }
												</span>
											} else {
												<span class="text-muted text-xs">—</span>
											}
										</td>

										<!-- الصيدلية المستلمة -->
										<td>
											<div class="font-bold text-xs">
												if inv.CustomerName != "" {
													{ inv.CustomerName }
												} else {
													صيدلية معتمدة
												}
											</div>
											if inv.CustomerOrgID != nil {
												<div class="text-2xs text-muted">
													كود العميل: #{ fmt.Sprintf("%d", *inv.CustomerOrgID) }
												</div>
											}
										</td>

										<!-- تاريخ الإصدار -->
										<td class="tabular-nums text-xs text-secondary">
											{ inv.IssueDate.Format("2006-01-02") }
										</td>

										<!-- المبلغ الإجمالي -->
										<td class="tabular-nums font-bold text-xs text-primary">
											{ inv.TotalAmount.String() } <span class="text-2xs text-muted font-normal">ج.م</span>
										</td>

										<!-- الحالة -->
										<td>
											if inv.Status == "paid" {
												<span class="badge badge-emerald text-2xs font-bold">مدفوعة</span>
											} else if inv.Status == "issued" {
												<span class="badge badge-sky text-2xs font-bold">صادرة</span>
											} else if inv.Status == "overdue" {
												<span class="badge badge-amber text-2xs font-bold">متأخرة</span>
											} else if inv.Status == "cancelled" {
												<span class="badge badge-rose text-2xs font-bold">ملغاة</span>
											} else {
												<span class="badge badge-secondary text-2xs font-bold">{ string(inv.Status) }</span>
											}
										</td>

										<!-- الإجراءات: عرض + طباعة -->
										<td>
											<div class="d-flex items-center gap-1">
												<!-- زر الطباعة -->
												<a
													href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print", inv.ID)) }
													target="_blank"
													class="btn btn-primary btn-xs font-bold"
													title="طباعة الفاتورة أو إيصال الكاشير"
												>
													<span>طباعة</span>
												</a>

												<!-- زر العرض -->
												<a
													href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print?autoprint=0", inv.ID)) }
													target="_blank"
													class="btn btn-secondary btn-xs font-bold"
													title="معاينة تفاصيل الفاتورة"
												>
													<span>عرض</span>
												</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}
