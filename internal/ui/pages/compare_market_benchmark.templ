package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type MarketBenchmarkPageData struct {
	Result      *compare.MarketBenchmarkResult
	Files       []*compare.CompareFile
	FileID      int64
	Query       string
	MinPrice    string
	MaxPrice    string
	MinDiscount string
	MaxDiscount string
	ActiveTab   string // "all", "higher", "equal", "lower", "exclusives"
	IsCustomer  bool
}

func buildMarketBenchmarkURL(fileID int64, q, minP, maxP, minD, maxD, tab string) string {
	vals := url.Values{}
	if fileID > 0 {
		vals.Set("file", fmt.Sprintf("%d", fileID))
	}
	if q != "" {
		vals.Set("q", q)
	}
	if minP != "" {
		vals.Set("min_price", minP)
	}
	if maxP != "" {
		vals.Set("max_price", maxP)
	}
	if minD != "" {
		vals.Set("min_discount", minD)
	}
	if maxD != "" {
		vals.Set("max_discount", maxD)
	}
	if tab != "" && tab != "all" {
		vals.Set("tab", tab)
	}
	base := "/compare/market-benchmark"
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

templ CompareMarketBenchmarkContent(data MarketBenchmarkPageData) {
	<div class="page-container">
		
		<!-- Header Banner -->
		<div class="glass-panel p-6 mb-6">
			<div class="flex-between flex-wrap gap-4">
				<div>
					<div class="d-flex items-center gap-3 mb-1">
						<div class="user-avatar-badge text-xl">
							@components.IconSparkles("icon-sm")
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							مقارنة مع موردين السوق (Market Benchmark)
						</h1>
					</div>
					<p class="text-sm text-secondary m-0">
						معايرة وقياس أسعار وخصومات كشف المورد مقابل متوسط وأفضل عروض كافة موردي المنصة والسوق.
					</p>
				</div>

				<div class="d-flex items-center gap-3 flex-wrap">
					<a href="/compare/tool" class="btn btn-secondary font-bold gap-2">
						@components.IconArrowLeft("icon-xs")
						<span>مركز الملفات</span>
					</a>
					if data.Result != nil && len(data.Result.Rows) > 0 {
						<button
							type="button"
							class="btn btn-primary font-bold gap-2"
							onclick="exportBenchmarkToCSV()"
						>
							@components.IconDownload("icon-xs")
							<span>تصدير التقرير</span>
						</button>
					}
				</div>
			</div>

			<!-- Navigation Subtabs for all 4 Analysis Modes -->
			<div class="cb-tabs-nav mt-4 pt-3 border-t">
				<a href="/compare/results" class="cb-tab-btn">
					المقارنة المجمعة بين الموردين
				</a>
				<a href="/compare/head-to-head" class="cb-tab-btn">
					مقارنة مورد بمورد
				</a>
				<a href="/compare/market-benchmark" class="cb-tab-btn active">
					مقارنة مع موردين السوق
				</a>
				<a href="/compare/market-intelligence" class="cb-tab-btn">
					تقرير ذكاء السوق
				</a>
			</div>
		</div>

		<!-- Supplier Selector Form -->
		<div class="glass-panel p-6 mb-6">
			<form method="GET" action="/compare/market-benchmark" class="d-grid gap-4 items-end m-0" style="grid-template-columns: 1fr auto;">
				<div>
					<label class="form-label font-bold text-xs text-primary mb-1 d-block">
						اختر ملف المورد المراد مقارنته مع السوق
					</label>
					<select name="file" class="form-select text-xs w-full" required>
						<option value="">-- اختر ملف المورد --</option>
						for _, f := range data.Files {
							<option value={ fmt.Sprintf("%d", f.ID) } selected?={ f.ID == data.FileID }>
								{ f.SupplierName } ({ fmt.Sprintf("%d صنف", f.RowCount) })
							</option>
						}
					</select>
				</div>

				<button type="submit" class="btn btn-primary font-bold px-6">
					تحليل ومقارنة السوق
				</button>
			</form>
		</div>

		if data.Result != nil {
			<!-- KPI Summary Metric Cards -->
			<div class="dashboard-stat-grid mb-6">
				<!-- Average Supplier Discount -->
				<div class="stat-card-3d">
					<div class="stat-card-label">متوسط خصم المورد</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Result.AvgSupplierDisc) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">عبر { fmt.Sprintf("%d", data.Result.TotalItems) } صنف</span>
				</div>

				<!-- Higher than Market (أعلى من السوق) -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-success">أعلى من السوق</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%d", data.Result.HigherThanMarket) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">خصمك أفضل من متوسط السوق</span>
				</div>

				<!-- Equal to Market (مساوي للسوق) -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">مساوي للسوق</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%d", data.Result.EqualToMarket) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">خصم مطابق لمتوسط السوق</span>
				</div>

				<!-- Lower than Market (أقل من السوق) -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-danger">أقل من السوق</div>
					<div class="stat-card-value text-danger tabular-nums">
						{ fmt.Sprintf("%d", data.Result.LowerThanMarket) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">تحتاج لمراجعة لزيادة التنافسية</span>
				</div>

				<!-- Exclusives / Gaps -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-warning">حصريات المورد</div>
					<div class="stat-card-value text-warning tabular-nums">
						{ fmt.Sprintf("%d", data.Result.ExclusivesCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">أصناف لا يقدمها غيرك بالسوق</span>
				</div>
			</div>

			<!-- Filter Bar: Price and Discount Range Inputs -->
			<div class="glass-panel p-6 mb-6 d-flex flex-col gap-4">
				<form method="GET" action="/compare/market-benchmark" class="m-0">
					<input type="hidden" name="file" value={ fmt.Sprintf("%d", data.FileID) } />
					<input type="hidden" name="tab" value={ data.ActiveTab } />

					<div class="d-grid gap-3 items-end" style="grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)) 1.5fr auto;">
						<div>
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأدنى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="min_price"
								value={ data.MinPrice }
								placeholder="0.00"
								class="form-input text-xs"
							/>
						</div>

						<div>
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأقصى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="max_price"
								value={ data.MaxPrice }
								placeholder="1000.00"
								class="form-input text-xs"
							/>
						</div>

						<div>
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأدنى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="min_discount"
								value={ data.MinDiscount }
								placeholder="0%"
								class="form-input text-xs"
							/>
						</div>

						<div>
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأقصى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="max_discount"
								value={ data.MaxDiscount }
								placeholder="50%"
								class="form-input text-xs"
							/>
						</div>

						<div>
							<label class="text-xs font-bold text-muted mb-1 d-block">
								بحث بالاسم أو الكود
							</label>
							<input
								type="text"
								name="q"
								value={ data.Query }
								placeholder="اسم الصنف..."
								class="form-input text-xs"
							/>
						</div>

						<button type="submit" class="btn btn-primary font-bold px-4">
							تطبيق الفلتر
						</button>
					</div>
				</form>

				<!-- Quick Filter Tabs -->
				<div class="d-flex items-center gap-2 pt-3 border-t flex-wrap">
					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "all")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "all" || data.ActiveTab == ""), templ.KV("btn-secondary", data.ActiveTab != "all" && data.ActiveTab != "") }
					>
						الكل ({ fmt.Sprintf("%d", data.Result.TotalItems) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "higher")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "higher"), templ.KV("btn-secondary", data.ActiveTab != "higher") }
					>
						أعلى من السوق ({ fmt.Sprintf("%d", data.Result.HigherThanMarket) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "equal")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "equal"), templ.KV("btn-secondary", data.ActiveTab != "equal") }
					>
						مساوي للسوق ({ fmt.Sprintf("%d", data.Result.EqualToMarket) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "lower")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "lower"), templ.KV("btn-secondary", data.ActiveTab != "lower") }
					>
						أقل من السوق ({ fmt.Sprintf("%d", data.Result.LowerThanMarket) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "exclusives")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "exclusives"), templ.KV("btn-secondary", data.ActiveTab != "exclusives") }
					>
						الحصريات ({ fmt.Sprintf("%d", data.Result.ExclusivesCount) })
					</a>
				</div>
			</div>

			<!-- Main Table -->
			<div class="glass-panel p-0 mb-0 overflow-hidden">
				<div class="table-container m-0">
					<table class="data-table m-0" id="market-benchmark-table">
						<thead>
							<tr>
								<th>المنتج</th>
								<th class="text-center tabular-nums">سعر الجمهور</th>
								<th class="text-center tabular-nums">نسبة خصمك</th>
								<th class="text-center tabular-nums">متوسط خصم السوق</th>
								<th class="text-center tabular-nums">أعلى خصم بالسوق</th>
								<th class="text-center">الفارق التنافسي</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Result.Rows) == 0 {
								<tr>
									<td colspan="6" class="text-center p-8 text-muted">
										<div class="text-3xl mb-2">@components.IconSearch("icon-sm")</div>
										<div class="font-extrabold text-base text-primary">لا توجد نتائج تطابق خيارات الفلترة</div>
									</td>
								</tr>
							}
							for _, r := range data.Result.Rows {
								<tr>
									<!-- المنتج -->
									<td>
										<div class="font-extrabold text-primary text-sm">
											{ r.ProductName }
										</div>
										if r.SKU != "" {
											<span class="text-xs text-muted tabular-nums">
												كود: { r.SKU }
											</span>
										}
									</td>

									<!-- سعرك -->
									<td class="text-center font-bold text-secondary tabular-nums">
										{ r.YourPrice.String() } ج.م
									</td>

									<!-- خصمك -->
									<td class="text-center font-extrabold tabular-nums">
										<span class="badge badge-slate text-xs">
											{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
										</span>
									</td>

									<!-- متوسط خصم السوق -->
									<td class="text-center tabular-nums">
										if r.MarketAvgDiscount > 0 {
											<div class="font-bold text-primary text-sm">
												{ fmt.Sprintf("%.1f%%", r.MarketAvgDiscount) }
											</div>
											<span class="text-xs text-muted">
												({ fmt.Sprintf("%d موردين", r.SupplierCount) })
											</span>
										} else {
											<span class="badge badge-secondary text-xs">غير متوفر</span>
										}
									</td>

									<!-- أعلى خصم بالسوق -->
									<td class="text-center tabular-nums">
										if r.MarketBestDiscount > 0 {
											<div class="font-black text-brand text-sm">
												{ fmt.Sprintf("%.1f%%", r.MarketBestDiscount) }
											</div>
											<span class="text-xs text-muted">
												({ r.MarketBestSupplier })
											</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>

									<!-- الفارق التنافسي -->
									<td class="text-center tabular-nums">
										if r.Classification == "higher" {
											<span class="badge badge-emerald text-xs font-bold">
												+{ fmt.Sprintf("%.1f%%", r.DiffVsMarketAvg) }
											</span>
										} else if r.Classification == "lower" {
											<span class="badge badge-rose text-xs font-bold">
												{ fmt.Sprintf("%.1f%%", r.DiffVsMarketAvg) }
											</span>
										} else if r.Classification == "equal" {
											<span class="badge badge-sky text-xs font-bold">
												مطابق
											</span>
										} else {
											<span class="badge badge-amber text-xs font-bold">
												حصري
											</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>

	<!-- Export Table to CSV Script -->
	<script>
		function exportBenchmarkToCSV() {
			var table = document.getElementById("market-benchmark-table");
			if (!table) return;
			var rows = table.querySelectorAll("tr");
			var csv = [];
			for (var i = 0; i < rows.length; i++) {
				var row = [], cols = rows[i].querySelectorAll("td, th");
				for (var j = 0; j < cols.length; j++) {
					var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
					data = data.replace(/"/g, '""');
					row.push('"' + data + '"');
				}
				csv.push(row.join(","));
			}
			var csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
			var downloadLink = document.createElement("a");
			downloadLink.download = "market_benchmark_report.csv";
			downloadLink.href = window.URL.createObjectURL(csvFile);
			downloadLink.style.display = "none";
			document.body.appendChild(downloadLink);
			downloadLink.click();
			document.body.removeChild(downloadLink);
		}
	</script>
}

templ CompareMarketBenchmarkPage(lang, dir string, data MarketBenchmarkPageData) {
	if data.IsCustomer {
		@layouts.CustomerShell("مقارنة مع موردين السوق | Dawa24", "compare", lang, dir, nil) {
			@CompareMarketBenchmarkContent(data)
		}
	} else {
		@layouts.VendorShell("مقارنة مع موردين السوق | Dawa24", "compare", lang, dir) {
			@CompareMarketBenchmarkContent(data)
		}
	}
}
