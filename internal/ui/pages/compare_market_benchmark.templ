package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type MarketBenchmarkPageData struct {
	Result      *compare.MarketBenchmarkResult
	Files       []*compare.CompareFile
	FileID      int64
	Query       string
	MinPrice    string
	MaxPrice    string
	MinDiscount string
	MaxDiscount string
	ActiveTab   string // "all", "higher", "equal", "lower", "exclusives"
	IsCustomer  bool
}

func buildMarketBenchmarkURL(fileID int64, q, minP, maxP, minD, maxD, tab string) string {
	vals := url.Values{}
	if fileID > 0 {
		vals.Set("file", fmt.Sprintf("%d", fileID))
	}
	if q != "" {
		vals.Set("q", q)
	}
	if minP != "" {
		vals.Set("min_price", minP)
	}
	if maxP != "" {
		vals.Set("max_price", maxP)
	}
	if minD != "" {
		vals.Set("min_discount", minD)
	}
	if maxD != "" {
		vals.Set("max_discount", maxD)
	}
	if tab != "" && tab != "all" {
		vals.Set("tab", tab)
	}
	base := "/compare/market-benchmark"
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

templ CompareMarketBenchmarkContent(data MarketBenchmarkPageData) {
	<div class="max-w-4xl mx-auto stack-lg">
		
		<!-- Header Banner -->
		<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem 1.75rem;">
			<div class="flex-between flex-wrap gap-md">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.25rem;">
						<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
							🧠
						</div>
						<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
							مقارنة مع موردين السوق (Market Benchmark)
						</h1>
					</div>
					<p style="color:var(--text-muted); font-size:0.875rem; margin:0;">
						معايرة وقياس أسعار وخصومات كشف المورد مقابل متوسط وأفضل عروض كافة موردي المنصة والسوق.
					</p>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
					<a href="/compare/tool" class="btn btn-secondary fw-700">
						@components.IconArrowLeft("icon-xs")
						<span>مركز الملفات</span>
					</a>
					if data.Result != nil && len(data.Result.Rows) > 0 {
						<button
							type="button"
							class="btn btn-primary fw-800"
							onclick="exportBenchmarkToCSV()"
						>
							@components.IconDownload("icon-xs")
							<span>تصدير التقرير</span>
						</button>
					}
				</div>
			</div>

			<!-- Navigation Subtabs for all 4 Analysis Modes -->
			<div style="display:flex; gap:0.5rem; margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--border); flex-wrap:wrap;">
				<a href="/compare/results" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					📊 المقارنة المجمعة بين الموردين
				</a>
				<a href="/compare/head-to-head" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					🏢 مقارنة مورد بمورد
				</a>
				<a href="/compare/market-benchmark" class="btn btn-primary btn-sm" style="font-weight:800; border-radius:var(--radius-lg);">
					🧠 مقارنة مع موردين السوق
				</a>
				<a href="/compare/market-intelligence" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					🧠 تقرير ذكاء السوق
				</a>
			</div>
		</div>

		<!-- Supplier Selector Form -->
		<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.25rem 1.5rem;">
			<form method="GET" action="/compare/market-benchmark" style="display:grid; grid-template-columns:1fr auto; gap:1rem; align-items:end; margin:0;">
				<div>
					<label class="form-label" style="font-weight:700; font-size:0.85rem; color:var(--text); margin-bottom:0.35rem; display:block;">
						اختر ملف المورد المراد مقارنته مع السوق
					</label>
					<select name="file" class="form-select" style="width:100%; height:40px; font-size:0.875rem;" required>
						<option value="">-- اختر ملف المورد --</option>
						for _, f := range data.Files {
							<option value={ fmt.Sprintf("%d", f.ID) } selected?={ f.ID == data.FileID }>
								{ f.SupplierName } ({ fmt.Sprintf("%d صنف", f.RowCount) })
							</option>
						}
					</select>
				</div>

				<button type="submit" class="btn btn-primary fw-800" style="height:40px; padding:0 1.5rem;">
					⚡ تحليل ومقارنة السوق
				</button>
			</form>
		</div>

		if data.Result != nil {
			<!-- KPI Summary Metric Cards -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.85rem;">
				
				<!-- Average Supplier Discount -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.25rem;">
						متوسط خصم المورد
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:var(--text);" class="tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Result.AvgSupplierDisc) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">عبر { fmt.Sprintf("%d", data.Result.TotalItems) } صنف</span>
				</div>

				<!-- Higher than Market (أعلى من السوق) -->
				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(16,185,129,0.3); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:#10b981; margin-bottom:0.25rem;">
						🟢 أعلى من السوق
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:#10b981;" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.HigherThanMarket) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">خصمك أفضل من متوسط السوق</span>
				</div>

				<!-- Equal to Market (مساوي للسوق) -->
				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(59,130,246,0.3); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:#3b82f6; margin-bottom:0.25rem;">
						🔵 مساوي للسوق
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:#3b82f6;" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.EqualToMarket) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">خصم مطابق لمتوسط السوق</span>
				</div>

				<!-- Lower than Market (أقل من السوق) -->
				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(239,68,68,0.3); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:#ef4444; margin-bottom:0.25rem;">
						🔴 أقل من السوق
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:#ef4444;" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.LowerThanMarket) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">تحتاج لمراجعة لزيادة التنافسية</span>
				</div>

				<!-- Exclusives / Gaps -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--accent-subtle); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:var(--accent); margin-bottom:0.25rem;">
						⭐ حصريات المورد
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:var(--accent);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.ExclusivesCount) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">أصناف لا يقدمها غيرك بالسوق</span>
				</div>

			</div>

			<!-- Filter Bar: Price and Discount Range Inputs -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.25rem 1.5rem; display:flex; flex-direction:column; gap:1rem;">
				
				<form method="GET" action="/compare/market-benchmark" style="margin:0;">
					<input type="hidden" name="file" value={ fmt.Sprintf("%d", data.FileID) } />
					<input type="hidden" name="tab" value={ data.ActiveTab } />

					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)) 1.5fr auto; gap:0.75rem; align-items:end;">
						
						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأدنى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="min_price"
								value={ data.MinPrice }
								placeholder="0.00"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأقصى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="max_price"
								value={ data.MaxPrice }
								placeholder="1000.00"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأدنى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="min_discount"
								value={ data.MinDiscount }
								placeholder="0%"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأقصى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="max_discount"
								value={ data.MaxDiscount }
								placeholder="50%"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								بحث بالاسم أو الكود
							</label>
							<input
								type="text"
								name="q"
								value={ data.Query }
								placeholder="اسم الصنف..."
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<button type="submit" class="btn btn-primary fw-800" style="height:38px; padding:0 1.25rem;">
							تطبيق الفلتر
						</button>

					</div>
				</form>

				<!-- Quick Filter Tabs -->
				<div style="display:flex; align-items:center; gap:0.5rem; border-top:1px solid var(--border); padding-top:0.85rem; flex-wrap:wrap;">
					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "all")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "all" || data.ActiveTab == ""), templ.KV("btn-secondary", data.ActiveTab != "all" && data.ActiveTab != "") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						الكل ({ fmt.Sprintf("%d", data.Result.TotalItems) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "higher")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "higher"), templ.KV("btn-secondary", data.ActiveTab != "higher") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						🟢 أعلى من السوق ({ fmt.Sprintf("%d", data.Result.HigherThanMarket) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "equal")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "equal"), templ.KV("btn-secondary", data.ActiveTab != "equal") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						🔵 مساوي للسوق ({ fmt.Sprintf("%d", data.Result.EqualToMarket) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "lower")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "lower"), templ.KV("btn-secondary", data.ActiveTab != "lower") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						🔴 أقل من السوق ({ fmt.Sprintf("%d", data.Result.LowerThanMarket) })
					</a>

					<a
						href={ templ.SafeURL(buildMarketBenchmarkURL(data.FileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "exclusives")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "exclusives"), templ.KV("btn-secondary", data.ActiveTab != "exclusives") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						⭐ الحصريات ({ fmt.Sprintf("%d", data.Result.ExclusivesCount) })
					</a>
				</div>

			</div>

			<!-- Main Table -->
			<div class="card" style="padding:0; overflow:hidden; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); box-shadow:var(--shadow-sm);">
				<div class="table-responsive">
					<table class="table" id="market-benchmark-table" style="margin:0; width:100%; border-collapse:collapse; font-size:0.875rem;">
						<thead>
							<tr style="background:var(--surface-sunken); border-bottom:2px solid var(--border); font-size:0.825rem; text-align:start;">
								<th style="padding:0.9rem 1rem; min-width:240px;">المنتج</th>
								<th style="padding:0.9rem 0.75rem; width:110px; text-align:center;">سعر الجمهور</th>
								<th style="padding:0.9rem 0.75rem; width:90px; text-align:center;">نسبة خصمك</th>
								<th style="padding:0.9rem 0.85rem; width:120px; text-align:center;">متوسط خصم السوق</th>
								<th style="padding:0.9rem 1rem; min-width:160px; text-align:center;">أعلى خصم بالسوق</th>
								<th style="padding:0.9rem 0.85rem; width:110px; text-align:center;">الفارق التنافسي</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Result.Rows) == 0 {
								<tr>
									<td colspan="6" style="text-align:center; padding:3rem 1rem; color:var(--text-muted);">
										<div style="font-size:2rem; margin-bottom:0.5rem;">🔍</div>
										<div style="font-weight:700; font-size:1rem; color:var(--text);">لا توجد نتائج تطابق خيارات الفلترة</div>
									</td>
								</tr>
							}
							for _, r := range data.Result.Rows {
								<tr style="border-bottom:1px solid var(--border);">
									<!-- المنتج -->
									<td style="padding:0.85rem 1rem;">
										<div style="font-weight:700; color:var(--text); line-height:1.4;">
											{ r.ProductName }
										</div>
										if r.SKU != "" {
											<span style="font-size:0.725rem; color:var(--text-muted); font-family:monospace;">
												كود: { r.SKU }
											</span>
										}
									</td>

									<!-- سعرك -->
									<td style="padding:0.85rem 0.75rem; text-align:center; font-weight:700; color:var(--text);" class="tabular-nums">
										{ r.YourPrice.String() } ج.م
									</td>

									<!-- خصمك -->
									<td style="padding:0.85rem 0.75rem; text-align:center; font-weight:800;" class="tabular-nums">
										<span class="badge badge-slate" style="font-size:0.8rem; padding:0.25rem 0.5rem;">
											{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
										</span>
									</td>

									<!-- متوسط خصم السوق -->
									<td style="padding:0.85rem 0.85rem; text-align:center;" class="tabular-nums">
										if r.MarketAvgDiscount > 0 {
											<div style="font-weight:700; color:var(--text);">
												{ fmt.Sprintf("%.1f%%", r.MarketAvgDiscount) }
											</div>
											<span style="font-size:0.7rem; color:var(--text-muted);">
												({ fmt.Sprintf("%d موردين", r.SupplierCount) })
											</span>
										} else {
											<span class="badge badge-secondary" style="font-size:0.7rem;">غير متوفر</span>
										}
									</td>

									<!-- أعلى خصم بالسوق -->
									<td style="padding:0.85rem 1rem; text-align:center;" class="tabular-nums">
										if r.MarketBestDiscount > 0 {
											<div style="font-weight:900; color:var(--accent);">
												{ fmt.Sprintf("%.1f%%", r.MarketBestDiscount) }
											</div>
											<span style="font-size:0.7rem; color:var(--text-muted);">
												({ r.MarketBestSupplier })
											</span>
										} else {
											<span style="color:var(--text-muted);">—</span>
										}
									</td>

									<!-- الفارق التنافسي -->
									<td style="padding:0.85rem 0.85rem; text-align:center;" class="tabular-nums">
										if r.Classification == "higher" {
											<span class="badge badge-emerald" style="font-size:0.75rem; padding:0.25rem 0.5rem;">
												+{ fmt.Sprintf("%.1f%%", r.DiffVsMarketAvg) }
											</span>
										} else if r.Classification == "lower" {
											<span class="badge badge-rose" style="font-size:0.75rem; padding:0.25rem 0.5rem;">
												{ fmt.Sprintf("%.1f%%", r.DiffVsMarketAvg) }
											</span>
										} else if r.Classification == "equal" {
											<span class="badge badge-sky" style="font-size:0.75rem; padding:0.25rem 0.5rem;">
												مطابق
											</span>
										} else {
											<span class="badge badge-amber" style="font-size:0.75rem; padding:0.25rem 0.5rem;">
												حصري
											</span>
										}
									</td>

								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}

	</div>

	<!-- Export Table to CSV Script -->
	<script>
		function exportBenchmarkToCSV() {
			var table = document.getElementById("market-benchmark-table");
			if (!table) return;
			var rows = table.querySelectorAll("tr");
			var csv = [];
			for (var i = 0; i < rows.length; i++) {
				var row = [], cols = rows[i].querySelectorAll("td, th");
				for (var j = 0; j < cols.length; j++) {
					var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
					data = data.replace(/"/g, '""');
					row.push('"' + data + '"');
				}
				csv.push(row.join(","));
			}
			var csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
			var downloadLink = document.createElement("a");
			downloadLink.download = "market_benchmark_report.csv";
			downloadLink.href = window.URL.createObjectURL(csvFile);
			downloadLink.style.display = "none";
			document.body.appendChild(downloadLink);
			downloadLink.click();
			document.body.removeChild(downloadLink);
		}
	</script>
}

templ CompareMarketBenchmarkPage(lang, dir string, data MarketBenchmarkPageData) {
	if data.IsCustomer {
		@layouts.CustomerShell("مقارنة مع موردين السوق | Dawa24", "compare", lang, dir, nil) {
			@CompareMarketBenchmarkContent(data)
		}
	} else {
		@layouts.VendorShell("مقارنة مع موردين السوق | Dawa24", "compare", lang, dir) {
			@CompareMarketBenchmarkContent(data)
		}
	}
}
