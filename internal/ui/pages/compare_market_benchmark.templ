package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// مقارنة قائمتي مع عروض السوق العامة.
//
// The screen is a table of the caller's own rows, each carrying how many market
// offers beat it, match it and lose to it. The counts are the point: an average
// market discount tells a supplier nothing about whether one outlier or forty
// houses are undercutting them, and the previous version of this page showed
// only an average — over a market of a hundred rows.

type MarketBenchmarkPageData struct {
	Result *compare.BenchmarkResult
	// Failed separates a broken query from an empty market. Both used to render
	// as "لا توجد أصناف مطابقة", which is the single most misleading thing this
	// screen could say.
	Failed      bool
	Files       []*compare.CompareFile
	FileID      int64
	Query       string
	MinPrice    string
	MaxPrice    string
	MinDiscount string
	MaxDiscount string
	// ActiveTab is one of "all", "higher", "equal", "better", "exclusive".
	ActiveTab string
	// Sort is "", "discount" or "price".
	Sort       string
	IsCustomer bool
}

func benchmarkURL(d MarketBenchmarkPageData, tab, sort string) string {
	vals := url.Values{}
	if d.FileID > 0 {
		vals.Set("file", fmt.Sprintf("%d", d.FileID))
	}
	if d.Query != "" {
		vals.Set("q", d.Query)
	}
	if d.MinPrice != "" {
		vals.Set("min_price", d.MinPrice)
	}
	if d.MaxPrice != "" {
		vals.Set("max_price", d.MaxPrice)
	}
	if d.MinDiscount != "" {
		vals.Set("min_discount", d.MinDiscount)
	}
	if d.MaxDiscount != "" {
		vals.Set("max_discount", d.MaxDiscount)
	}
	if tab != "" && tab != "all" {
		vals.Set("tab", tab)
	}
	if sort != "" {
		vals.Set("sort", sort)
	}
	if len(vals) == 0 {
		return "/compare/market-benchmark"
	}
	return "/compare/market-benchmark?" + vals.Encode()
}

func benchmarkTabClass(active, tab string) string {
	if active == tab || (active == "" && tab == "all") {
		return "tab-btn active"
	}
	return "tab-btn"
}

func benchmarkRowTone(class string) string {
	switch class {
	case compare.BenchHigher:
		return "badge-rose"
	case compare.BenchBetter:
		return "badge-emerald"
	case compare.BenchEqual:
		return "badge-slate"
	}
	return "badge-amber"
}

func benchmarkRowLabel(class string) string {
	switch class {
	case compare.BenchHigher:
		return "سعرك أعلى"
	case compare.BenchBetter:
		return "أنت الأفضل"
	case compare.BenchEqual:
		return "مماثل للسوق"
	}
	return "حصري"
}

templ CompareMarketBenchmarkContent(data MarketBenchmarkPageData) {
	<div class="page-container">
		@benchmarkHeader()
		@benchmarkControls(data)
		if data.Failed {
			<div class="alert alert-danger mb-6">
				<span class="fw-800">تعذّر تشغيل المقارنة</span>
				<span class="text-sm">حدث خطأ أثناء قراءة عروض السوق. أعد المحاولة، وإذا تكرر الخطأ راجع سجلات النظام.</span>
			</div>
		} else if len(data.Files) == 0 {
			<div class="glass-panel p-6 mb-6 text-sm text-muted">
				لا توجد لديك قوائم مرفوعة بعد. ارفع قائمة من <a href="/compare/tool" class="text-accent fw-800">مركز الملفات</a> ثم عد إلى هنا.
			</div>
		} else if data.Result == nil {
			<div class="glass-panel p-6 mb-6 text-sm text-muted">
				اختر إحدى قوائمك من القائمة أعلاه لبدء المقارنة مع السوق.
			</div>
		} else {
			@benchmarkSummary(data.Result)
			@benchmarkTabs(data)
			@benchmarkTable(data)
			@benchmarkCoverage(data.Result)
		}
		<!-- Where the offers modal is swapped in. Empty until a count is clicked. -->
		<div id="benchmark-offers-modal"></div>
	</div>
}

templ benchmarkHeader() {
	<div class="glass-panel p-6 mb-6">
		<div class="flex-between flex-wrap gap-4">
			<div class="stack-sm">
				<div class="d-flex items-center gap-3 mb-1">
					<div class="user-avatar-badge text-xl">
						@components.IconChart("icon-sm")
					</div>
					<h1 class="text-2xl font-black text-primary m-0">مقارنة قائمتي مع عروض السوق العامة</h1>
				</div>
				<p class="text-sm text-secondary m-0">
					كل صنف في قائمتك مقابل عروض بقية الموردين على المنصة: كم عرضاً أفضل منك، وكم مماثل، وكم أقل.
				</p>
			</div>
			<a href="/compare/tool" class="btn btn-secondary font-bold gap-2">
				@components.IconArrowLeft("icon-xs")
				<span>مركز الملفات</span>
			</a>
		</div>
		<div class="tabs-nav mt-4">
			<a href="/compare/results" class="tab-btn">المقارنة المجمعة بين الموردين</a>
			<a href="/compare/head-to-head" class="tab-btn">مقارنة مورد بمورد</a>
			<a href="/compare/market-benchmark" class="tab-btn active">مقارنة مع موردي السوق</a>
			<a href="/compare/market-intelligence" class="tab-btn">تقرير ذكاء السوق</a>
		</div>
	</div>
}

// benchmarkControls is one row: which list, what to find in it, and how to
// order it. The five range inputs that used to sit beside those — a six-cell
// grid of labelled boxes taking half the screen before a single result — are
// behind a disclosure now, because a range is something you reach for
// occasionally and a search is something you reach for every time.
templ benchmarkControls(data MarketBenchmarkPageData) {
	<div
		class="filter-bar bench-controls"
		x-data={ fmt.Sprintf("{ ranges: %t }", data.MinPrice != "" || data.MaxPrice != "" || data.MinDiscount != "" || data.MaxDiscount != "") }
	>
		<form method="GET" action="/compare/market-benchmark" class="bench-controls-form">
			<input type="hidden" name="tab" value={ data.ActiveTab }/>

			<div class="bench-controls-row">
				<label class="bench-field">
					<span class="bench-field-label">قائمتي</span>
					<select name="file" class="form-select" onchange="this.form.submit()">
						for _, f := range data.Files {
							<option value={ fmt.Sprintf("%d", f.ID) } selected?={ f.ID == data.FileID }>
								{ f.SupplierName } ({ fmt.Sprintf("%d صنف", f.RowCount) })
							</option>
						}
					</select>
				</label>

				<label class="bench-field is-grow">
					<span class="bench-field-label">بحث</span>
					<input type="search" name="q" value={ data.Query } placeholder="اسم الصنف أو الكود…" class="form-input"/>
				</label>

				<label class="bench-field">
					<span class="bench-field-label">الترتيب</span>
					<select name="sort" class="form-select" onchange="this.form.submit()">
						<option value="" selected?={ data.Sort == "" }>الأكبر فارقاً</option>
						<option value="price" selected?={ data.Sort == "price" }>السعر النهائي</option>
						<option value="discount" selected?={ data.Sort == "discount" }>الخصم</option>
					</select>
				</label>

				<button type="submit" class="btn btn-primary btn-sm font-bold">تطبيق</button>
				<button type="button" @click="ranges = !ranges" class="btn btn-secondary btn-sm font-bold" :class="{ 'active': ranges }">
					نطاق متقدم
				</button>
				if data.Query != "" || data.MinPrice != "" || data.MaxPrice != "" || data.MinDiscount != "" || data.MaxDiscount != "" {
					<a href={ templ.SafeURL(fmt.Sprintf("/compare/market-benchmark?file=%d", data.FileID)) } class="btn btn-ghost btn-sm">مسح</a>
				}
			</div>

			<div x-show="ranges" x-cloak x-transition.opacity class="bench-ranges">
				<div class="bench-range">
					<span class="bench-field-label">السعر النهائي (ج.م)</span>
					<div class="bench-range-pair">
						<input type="number" step="0.01" min="0" name="min_price" value={ data.MinPrice } placeholder="من" class="form-input"/>
						<span class="bench-range-dash">—</span>
						<input type="number" step="0.01" min="0" name="max_price" value={ data.MaxPrice } placeholder="إلى" class="form-input"/>
					</div>
				</div>
				<div class="bench-range">
					<span class="bench-field-label">الخصم (%)</span>
					<div class="bench-range-pair">
						<input type="number" step="0.1" min="0" name="min_discount" value={ data.MinDiscount } placeholder="من" class="form-input"/>
						<span class="bench-range-dash">—</span>
						<input type="number" step="0.1" min="0" name="max_discount" value={ data.MaxDiscount } placeholder="إلى" class="form-input"/>
					</div>
				</div>
				<button type="submit" class="btn btn-primary btn-sm font-bold">تطبيق النطاق</button>
			</div>
		</form>
	</div>
}

templ benchmarkSummary(res *compare.BenchmarkResult) {
	<div class="dashboard-stat-grid mb-6">
		<div class="stat-card-3d">
			<div class="stat-card-label">أصناف قائمتك</div>
			<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", res.Total) }</div>
			<span class="text-xs text-secondary mt-1 d-block">{ res.SupplierName }</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label text-danger">أسعارك أعلى من السوق</div>
			<div class="stat-card-value text-danger tabular-nums">{ fmt.Sprintf("%d", res.HigherCount) }</div>
			<span class="text-xs text-secondary mt-1 d-block">فرص توفير لعملائك</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label text-success">أنت الأفضل بالسوق</div>
			<div class="stat-card-value text-success tabular-nums">{ fmt.Sprintf("%d", res.BetterCount) }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				{ fmt.Sprintf("و%d صنفاً مماثل للسوق", res.EqualCount) }
			</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label text-brand">فارقك التنافسي</div>
			<div class="stat-card-value text-brand tabular-nums">{ res.PotentialBuyerSaving.String() }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				{ fmt.Sprintf("متوسط خصمك %.1f%% مقابل %.1f%% للسوق", res.AvgYourDiscount, res.AvgMarketDiscount) }
			</span>
		</div>
	</div>
}

templ benchmarkTabs(data MarketBenchmarkPageData) {
	<div class="tabs-nav mb-4">
		<a href={ templ.SafeURL(benchmarkURL(data, "all", data.Sort)) } class={ benchmarkTabClass(data.ActiveTab, "all") }>
			الكل ({ fmt.Sprintf("%d", data.Result.Total) })
		</a>
		<a href={ templ.SafeURL(benchmarkURL(data, compare.BenchHigher, data.Sort)) } class={ benchmarkTabClass(data.ActiveTab, compare.BenchHigher) }>
			أسعارك أعلى من السوق ({ fmt.Sprintf("%d", data.Result.HigherCount) })
		</a>
		<a href={ templ.SafeURL(benchmarkURL(data, compare.BenchEqual, data.Sort)) } class={ benchmarkTabClass(data.ActiveTab, compare.BenchEqual) }>
			مماثل للسوق ({ fmt.Sprintf("%d", data.Result.EqualCount) })
		</a>
		<a href={ templ.SafeURL(benchmarkURL(data, compare.BenchBetter, data.Sort)) } class={ benchmarkTabClass(data.ActiveTab, compare.BenchBetter) }>
			خصمك أفضل من السوق ({ fmt.Sprintf("%d", data.Result.BetterCount) })
		</a>
		<a href={ templ.SafeURL(benchmarkURL(data, compare.BenchExclusive, data.Sort)) } class={ benchmarkTabClass(data.ActiveTab, compare.BenchExclusive) }>
			حصري ({ fmt.Sprintf("%d", data.Result.ExclusiveCount) })
		</a>
	</div>
}

templ benchmarkTable(data MarketBenchmarkPageData) {
	<div class="glass-panel p-0 mb-6 overflow-hidden">
		if len(data.Result.Rows) == 0 {
			@benchmarkEmpty(data)
		} else {
			<div class="table-container bench-scroll m-0">
				<table class="data-table bench-table">
					<thead>
						<tr>
							<th>اسم الصنف</th>
							<th>الكود</th>
							<th class="text-end">سعري / الخصم</th>
							<th class="text-center">عروض أفضل بالسوق</th>
							<th class="text-center">عروض مماثلة بالسوق</th>
							<th class="text-center">عروض أقل بالسوق</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range data.Result.Rows {
							<tr>
								<!-- Identity, with the standing this row has in one word -->
								<td>
									<div class="bench-name">{ row.ProductName }</div>
									<div class="bench-name-meta">
										<span class={ "bench-verdict", benchmarkVerdictTone(row.Classification) }>
											{ benchmarkRowLabel(row.Classification) }
										</span>
										if !row.InCatalog {
											<span class="bench-soft" title="لم يُربط هذا الصنف بالكتالوج بعد؛ المقارنة تمت بمطابقة الاسم">
												مطابقة بالاسم
											</span>
										}
									</div>
								</td>

								<td class="bench-code tabular-nums">
									if row.SKU != "" {
										{ row.SKU }
									} else {
										<span class="text-muted">—</span>
									}
								</td>

								<!-- Your price. The net figure leads; the list price and
								     discount that produced it sit under it. -->
								<td class="text-end">
									<div class="bench-net tabular-nums">{ row.YourNet.String() } <small>ج.م</small></div>
									<div class="bench-sub tabular-nums">
										{ fmt.Sprintf("%s ج.م − %s%%", row.YourPrice.String(), formatBenchPercent(row.YourDiscount)) }
									</div>
								</td>

								<!-- The three counts, each a button onto the suppliers
								     behind it. A number alone leaves the reader with the
								     next question unanswered — which three, at what price
								     — and the answer is too much data to carry inline for
								     a few thousand rows, so it is fetched on click. -->
								<td class="text-center">
									@benchmarkCountCell(data.FileID, row.RowID, "better", row.BetterOffers, "is-worse", "عروض أفضل بالسوق")
								</td>
								<td class="text-center">
									@benchmarkCountCell(data.FileID, row.RowID, "equal", row.EqualOffers, "is-equal", "عروض مماثلة بالسوق")
								</td>
								<td class="text-center">
									@benchmarkCountCell(data.FileID, row.RowID, "worse", row.WorseOffers, "is-better", "عروض أقل بالسوق")
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="bench-footnote">
				{ fmt.Sprintf("عرض %d من %d صنف", data.Result.Shown, data.Result.Total) }
			</div>
		}
	</div>
}

// benchmarkCountCell renders one of the three counts. A count of zero is a dash
// and not a control: there is nothing to open, and a button that opens an empty
// list is worse than no button.
templ benchmarkCountCell(fileID, rowID int64, bucket string, count int, tone, label string) {
	if count > 0 {
		<button
			type="button"
			class={ "bench-count", "is-link", tone, "tabular-nums" }
			hx-get={ fmt.Sprintf("/compare/market-benchmark/offers?file=%d&row=%d&bucket=%s", fileID, rowID, bucket) }
			hx-target="#benchmark-offers-modal"
			hx-swap="innerHTML"
			title={ fmt.Sprintf("عرض %s (%d)", label, count) }
			aria-haspopup="dialog"
		>
			{ fmt.Sprintf("%d", count) }
		</button>
	} else {
		<span class="bench-count is-none" aria-hidden="true">—</span>
	}
}

// formatBenchPercent drops the decimal when there is nothing behind it, so a
// column of discounts reads as 20% and 12.5%, not 20.0% and 12.5%.
func formatBenchPercent(pct float64) string {
	if pct == float64(int64(pct)) {
		return fmt.Sprintf("%d", int64(pct))
	}
	return fmt.Sprintf("%.1f", pct)
}

// benchmarkVerdictTone colours the one-word standing on the product name.
func benchmarkVerdictTone(class string) string {
	switch class {
	case compare.BenchHigher:
		return "is-worse"
	case compare.BenchBetter:
		return "is-better"
	case compare.BenchEqual:
		return "is-equal"
	}
	return "is-exclusive"
}

// benchmarkEmpty says which of the several different empty states this is.
//
// "لا توجد أصناف مطابقة" used to cover all of them, including the two that are
// not about matching at all: a filter that excludes everything, and a market
// with nothing in it to compare against.
templ benchmarkEmpty(data MarketBenchmarkPageData) {
	<div class="p-6 stack-sm">
		if data.Result.Total == 0 {
			<div class="fw-800">هذه القائمة لا تحتوي على أصناف بأسعار</div>
			<div class="text-sm text-muted">
				راجع ربط الأعمدة للملف من مركز الملفات: صف بلا سعر لا يدخل المقارنة.
			</div>
		} else if data.Result.ComparedAgainst == 0 {
			<div class="fw-800">لا توجد عروض أخرى في السوق للمقارنة</div>
			<div class="text-sm text-muted">
				لا يوجد حالياً أي ملف مورد آخر منشور أو مستودع مؤقت نشط. تظهر المقارنة فور توفر قائمة مورد أخرى.
			</div>
		} else if data.ActiveTab != "" && data.ActiveTab != "all" {
			<div class="fw-800">لا توجد أصناف ضمن هذا التصنيف</div>
			<div class="text-sm text-muted">
				جرّب تبويب «الكل»، أو وسّع نطاق السعر والخصم.
			</div>
			<a href={ templ.SafeURL(benchmarkURL(data, "all", data.Sort)) } class="btn btn-sm btn-secondary">عرض الكل</a>
		} else {
			<div class="fw-800">لا توجد أصناف تطابق البحث أو النطاقات المحددة</div>
			<a href={ templ.SafeURL(fmt.Sprintf("/compare/market-benchmark?file=%d", data.FileID)) } class="btn btn-sm btn-secondary">مسح عوامل التصفية</a>
		}
	</div>
}

templ benchmarkCoverage(res *compare.BenchmarkResult) {
	<div class="glass-panel p-4 mb-6">
		<p class="text-xs text-muted m-0">
			{ fmt.Sprintf("قورنت بـ %d عرضاً من %d مورد آخر، %d منها (%.0f%%) مرتبط بالكتالوج المركزي.",
				res.ComparedAgainst, res.Coverage.Suppliers, res.Coverage.MatchedOffers, res.Coverage.MatchedPercent()) }
			if !res.Coverage.AIEnabled {
				<span class="text-warning"> · مطابقة الذكاء الاصطناعي غير مفعّلة.</span>
			}
		</p>
	</div>
}

templ CompareMarketBenchmarkPage(lang, dir string, data MarketBenchmarkPageData) {
	if data.IsCustomer {
		@layouts.ShellFor("مقارنة مع موردي السوق | Dawa24", "compare", lang, dir, authctx.FromContext(ctx)) {
			@CompareMarketBenchmarkContent(data)
		}
	} else {
		@layouts.VendorShell("مقارنة مع موردي السوق | Dawa24", "compare", lang, dir) {
			@CompareMarketBenchmarkContent(data)
		}
	}
}
