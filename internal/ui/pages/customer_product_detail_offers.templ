package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerProductDetailOffersTable(product *catalog.Product, offers []SupplierOffer, langOpt ...string) {
	{{
		lang := "ar"
		if len(langOpt) > 0 && langOpt[0] != "" {
			lang = langOpt[0]
		}
	}}
	if len(offers) > 1 {
		<div class="glass-panel p-0 mb-6 overflow-hidden border rounded-2xl shadow-xs">
			<div class="p-4 px-6 border-b flex-between items-center">
				<h3 class="text-base font-extrabold text-primary m-0 d-flex items-center gap-2">
					<span>{ i18n.T(lang, "product.competing_offers_title") }</span>
					<span class="badge badge-slate text-xs font-bold">{ fmt.Sprintf(i18n.T(lang, "product.suppliers_count"), len(offers)) }</span>
				</h3>
			</div>

			<div class="table-container m-0 overflow-x-auto">
				<table class="data-table m-0 text-xs w-full">
					<thead>
						<tr>
							<th>{ i18n.T(lang, "product.col_supplier_branch") }</th>
							<th class="text-end">{ i18n.T(lang, "product.col_public_price") }</th>
							<th class="text-center">{ i18n.T(lang, "product.col_discount") }</th>
							<th class="text-end">{ i18n.T(lang, "product.col_net_price") }</th>
							<th>{ i18n.T(lang, "product.col_available_stock") }</th>
							<th class="text-center">{ i18n.T(lang, "product.col_coverage") }</th>
							<th class="text-center">{ i18n.T(lang, "product.col_purchase") }</th>
						</tr>
					</thead>
					<tbody>
						for _, off := range offers {
							<tr>
								<!-- Supplier -->
								<td>
									<div class="font-bold text-primary text-xs d-flex items-center gap-1.5">
										<span>{ off.SupplierName }</span>
										if off.IsVerified {
											<span class="badge badge-emerald text-2xs font-bold">{ i18n.T(lang, "product.badge_certified") }</span>
										}
									</div>
									<div class="d-flex items-center gap-2 text-2xs text-muted mt-0.5">
										if off.BranchName != "" {
											<span>{ off.BranchName }</span>
											<span>•</span>
										}
										<span class="text-amber-500 font-bold d-flex items-center gap-0.5">
											<span>★</span>
											<span class="tabular-nums">4.9</span>
										</span>
									</div>
								</td>

								<!-- Public Price -->
								<td class="text-end tabular-nums font-bold text-xs text-primary">
									if off.OldPrice.IsPositive() {
										{ fmt.Sprintf("%s %s", off.OldPrice.String(), i18n.T(lang, "common.currency_egp")) }
									} else {
										{ fmt.Sprintf("%s %s", off.Price.String(), i18n.T(lang, "common.currency_egp")) }
									}
								</td>

								<!-- Discount Percentage -->
								<td class="text-center">
									if off.DiscountBPS > 0 {
										<span class="badge badge-emerald text-xs font-black tabular-nums">
											{ fmt.Sprintf("%d%%", int(float64(off.DiscountBPS)/100.0 + 0.5)) }
										</span>
									} else {
										<span class="text-xs text-muted font-medium">0%</span>
									}
								</td>

								<!-- Net Price -->
								<td class="text-end tabular-nums text-xs">
									<div class="font-black text-brand">{ fmt.Sprintf("%s %s", off.Price.String(), i18n.T(lang, "common.currency_egp")) }</div>
									if off.IsNegotiable {
										<span class="badge badge-amber text-2xs font-bold mt-0.5">{ i18n.T(lang, "product.negotiable") }</span>
									}
								</td>

								<!-- Stock -->
								<td class="text-xs">
									if off.AvailableStock > 0 {
										<span class="text-brand font-bold">{ fmt.Sprintf(i18n.T(lang, "product.units_count"), off.AvailableStock) }</span>
									} else {
										<span class="text-danger font-bold">{ i18n.T(lang, "product.stock_depleted") }</span>
									}
								</td>

								<!-- Coverage -->
								<td class="text-center">
									if off.IsCovered {
										<span class="badge badge-emerald text-xs font-bold">{ i18n.T(lang, "product.badge_covered") }</span>
									} else {
										<span class="badge badge-rose text-xs font-bold">{ i18n.T(lang, "product.badge_not_covered") }</span>
									}
								</td>

								<!-- Action -->
								<td class="col-actions">
									if off.CanAddToCart {
										<div class="d-flex items-center justify-center gap-1">
											<form method="POST" action="/cart/add" hx-post="/cart/add" hx-swap="none" class="d-flex items-center justify-center gap-1 m-0">
												<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", off.VariantID) } />
												<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
												<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", off.SupplierID) } />
												<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", off.SupplierID) } />
												<input type="hidden" name="offer_price" value={ off.Price.String() } />
												<input type="hidden" name="qty" value={ fmt.Sprintf("%d", max(1, off.MinOrderQty)) } />
												<button type="submit" class="btn btn-primary btn-xs font-bold px-3">
													<span>{ i18n.T(lang, "product.btn_add_to_cart") }</span>
												</button>
											</form>
											if off.IsNegotiable {
												<button
													type="button"
													class="btn btn-secondary btn-xs font-bold text-amber-700 shadow-2xs gap-1 border-amber-300"
													data-variant-id={ fmt.Sprintf("%d", off.VariantID) }
													data-product-id={ fmt.Sprintf("%d", product.ID) }
													data-vendor-id={ fmt.Sprintf("%d", off.SupplierID) }
													data-product-name={ productTitle(product) }
													data-current-price={ off.Price.String() }
													data-min-qty={ fmt.Sprintf("%d", max(1, off.MinOrderQty)) }
													onclick="openNegotiationModal(this)"
													title={ i18n.T(lang, "product.title_negotiate") }
												>
													@components.IconTag("icon-2xs")
													<span>{ i18n.T(lang, "product.btn_negotiate") }</span>
												</button>
											}
										</div>
									} else {
										<div class="d-flex items-center justify-center gap-1">
											if off.IsNegotiable {
												<button
													type="button"
													class="btn btn-secondary btn-xs font-bold text-amber-700 shadow-2xs gap-1 border-amber-300"
													data-variant-id={ fmt.Sprintf("%d", off.VariantID) }
													data-product-id={ fmt.Sprintf("%d", product.ID) }
													data-vendor-id={ fmt.Sprintf("%d", off.SupplierID) }
													data-product-name={ productTitle(product) }
													data-current-price={ off.Price.String() }
													data-min-qty={ fmt.Sprintf("%d", max(1, off.MinOrderQty)) }
													onclick="openNegotiationModal(this)"
													title={ i18n.T(lang, "product.title_negotiate") }
												>
													@components.IconTag("icon-2xs")
													<span>{ i18n.T(lang, "product.btn_negotiate") }</span>
												</button>
											}
											<button type="button" disabled class="btn btn-secondary btn-xs font-bold opacity-60" title={ off.CoverageReason }>
												if off.CoverageReason != "" {
													{ off.CoverageReason }
												} else {
													{ i18n.T(lang, "product.not_available") }
												}
											</button>
										</div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
