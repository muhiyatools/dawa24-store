package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorSpecialOffersData struct {
	Offers        []*promo.SpecialOffer
	Counts        map[string]int
	FilterStatus  string
}

templ VendorSpecialOffersPage(data VendorSpecialOffersData, lang, dir string) {
	@layouts.VendorShell("إدارة العروض الخاصة وتغطية الفروع | Special Offers", "offers", lang, dir) {
		<div class="page-container">
			
			<!-- Header Action Bar -->
			<div class="glass-panel p-6 mb-0">
				<div class="flex-between items-center flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconPackage("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								العروض الخاصة والتغطية الجغرافية
							</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							إدارة وتخصيص العروض الخاصة بالمنشأة، المنتجات المشمولة، ونطاقات التغطية وأيام التوصيل
						</p>
					</div>

     <div class="stack-sm">
						<a href="/vendor/offers/new" class="btn btn-primary font-bold text-xs px-4 py-2 gap-1">
							@components.IconPlus("icon-xs")
							<span>إضافة عرض خاص جديد</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Statistics Summary Cards (Clickable Filter Tabs) -->
			<div class="dashboard-stat-grid cols-4 mb-0">
				<!-- Total Offers -->
				<a href="/vendor/offers" class="text-decoration-none">
					<div class="stat-card-3d">
						<div class="stat-card-label">إجمالي العروض</div>
						<div class="stat-card-value text-primary tabular-nums">
							{ fmt.Sprintf("%d", len(data.Offers)) }
						</div>
					</div>
				</a>

				<!-- Active Offers -->
				<a href="/vendor/offers?status=active" class="text-decoration-none">
					<div class="stat-card-3d">
						<div class="stat-card-label text-success d-flex items-center gap-2">
							<span class="status-dot success"></span>
							<span>العروض النشطة</span>
						</div>
						<div class="stat-card-value text-success tabular-nums">
							{ fmt.Sprintf("%d", countOffersByStatus(data.Offers, "active")) }
						</div>
					</div>
				</a>

				<!-- Pending Review -->
				<a href="/vendor/offers?status=pending" class="text-decoration-none">
					<div class="stat-card-3d">
						<div class="stat-card-label text-warning d-flex items-center gap-2">
							<span class="status-dot warning"></span>
							<span>قيد المراجعة</span>
						</div>
						<div class="stat-card-value text-warning tabular-nums">
							{ fmt.Sprintf("%d", countOffersByAdminStatus(data.Offers, "pending")) }
						</div>
					</div>
				</a>

				<!-- Drafts & Expired -->
				<a href="/vendor/offers?status=draft" class="text-decoration-none">
					<div class="stat-card-3d">
						<div class="stat-card-label text-muted d-flex items-center gap-2">
							<span class="status-dot"></span>
							<span>المسودات والمنتهية</span>
						</div>
						<div class="stat-card-value text-muted tabular-nums">
							{ fmt.Sprintf("%d", countOffersByStatus(data.Offers, "draft") + countOffersByStatus(data.Offers, "expired")) }
						</div>
					</div>
				</a>
			</div>

			<!-- Offers Grid List -->
			if len(data.Offers) == 0 {
				<div class="glass-panel p-12 text-center empty-state-glass">
					<div class="text-4xl mb-3">@components.IconPackage("icon-sm")</div>
					<h3 class="text-lg font-black text-primary mb-2">
						لا توجد عروض خاصة مضافة حتى الآن
					</h3>
					<p class="text-sm text-secondary max-w-md mx-auto mb-6">
						أنشئ عروضك الخاصة وخصص المنتجات المشمولة ونطاقات التغطية الجغرافية وأيام التوصيل للصيدليات.
					</p>
					<a href="/vendor/offers/new" class="btn btn-primary font-bold text-xs gap-1">
						@components.IconPlus("icon-xs")
						<span>+ إنشاء أول عرض خاص الآن</span>
					</a>
				</div>
			} else {
				<div class="dashboard-grid-3col mb-0">
					for _, o := range data.Offers {
						<div class="glass-panel p-6 mb-0 d-flex flex-col justify-between">
       <div class="stack-sm">
								<!-- Header Strip -->
								<div class="flex-between items-start gap-2 mb-3">
         <div class="stack-sm">
										<h3 class="text-base font-extrabold text-primary m-0">
											{ o.Title.Get(i18n.Lang(lang)) }
										</h3>
										if o.BranchName != "" {
											<div class="text-xs text-brand font-bold mt-1">
												الفرع: { o.BranchName }
											</div>
										}
									</div>

         <div class="stack-sm">
										if o.Status == "active" {
											<span class="badge badge-emerald text-xs font-bold">نشط</span>
										} else if o.Status == "draft" {
											<span class="badge badge-slate text-xs font-bold">مسودة</span>
										} else {
											<span class="badge badge-rose text-xs font-bold">{ o.Status }</span>
										}
									</div>
								</div>

								if o.Description.Get(i18n.Lang(lang)) != "" {
									<p class="text-xs text-secondary leading-relaxed mb-4">
										{ o.Description.Get(i18n.Lang(lang)) }
									</p>
								}

								<!-- Pricing & Products Summary Pill -->
								<div class="p-3 rounded-lg bg-surface-sunken border mb-4">
									<div class="flex-between items-baseline">
          <div class="stack-sm">
											<span class="text-xs text-muted font-bold d-block">نسبة الخصم:</span>
											<span class="text-lg font-black text-brand tabular-nums">
												{ fmt.Sprintf("%.0f%%", o.DiscountPercentage) }
											</span>
										</div>

										<div class="text-end">
											<span class="text-xs text-muted font-bold d-block">السعر الكلي:</span>
											<span class="text-base font-extrabold text-primary tabular-nums">
												if o.TotalPrice.Minor() > 0 {
													{ o.TotalPrice.String() } <span class="text-xs text-muted">ج.م</span>
												} else {
													<span>حسب الصنف</span>
												}
											</span>
										</div>
									</div>
								</div>

								<!-- Validity Dates & Location Cover Badge -->
								<div class="flex-between items-center text-xs text-muted">
									if o.StartDate != nil && o.EndDate != nil {
										<span>{ o.StartDate.Format("02/01/2006") } - { o.EndDate.Format("02/01/2006") }</span>
									} else {
										<span>ساري المفعول</span>
									}

									<span class="text-brand font-bold">
										{ fmt.Sprintf("%d صنف مشمول", len(o.Products)) }
									</span>
								</div>
							</div>

							<!-- Action Buttons -->
							<div class="flex-between items-center border-t pt-4 mt-4">
								<a href={ templ.SafeURL(fmt.Sprintf("/vendor/offers/%d/locations", o.ID)) } class="btn btn-secondary btn-sm font-bold text-xs gap-1">
									<span>نطاقات التغطية</span>
								</a>

								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/offers/%d/delete", o.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا العرض الخاص؟');">
									<button type="submit" class="btn btn-secondary btn-icon btn-sm text-danger" title="حذف هذا العرض">
										@components.IconX("icon-sm")
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}

func countOffersByStatus(offers []*promo.SpecialOffer, status string) int {
	c := 0
	for _, o := range offers {
		if o.Status == status {
			c++
		}
	}
	return c
}

func countOffersByAdminStatus(offers []*promo.SpecialOffer, status string) int {
	c := 0
	for _, o := range offers {
		if o.AdminStatus == status {
			c++
		}
	}
	return c
}
