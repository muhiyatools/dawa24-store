package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorSpecialOffersData struct {
	Offers        []*promo.SpecialOffer
	Counts        map[string]int
	FilterStatus  string
}

templ VendorSpecialOffersPage(data VendorSpecialOffersData, lang, dir string) {
	@layouts.VendorShell("إدارة العروض الخاصة وتغطية الفروع | Special Offers", "offers", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.75rem;">
			
			<!-- Header Action Bar -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
				<div style="display:flex; align-items:center; gap:1.25rem;">
					<div style="width:56px; height:56px; border-radius:var(--radius-xl); background:var(--accent-subtle); border:1px solid var(--accent); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.6rem;">
						🎁
					</div>
					<div>
						<div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.15em; font-weight:700; margin-bottom:0.25rem;">
							إدارة عروض المؤسسة
						</div>
						<h1 style="font-size:1.65rem; font-weight:800; color:var(--text); margin:0;">
							العروض الخاصة والتغطية الجغرافية
						</h1>
					</div>
				</div>

				<div class="row-center">
					<a href="/vendor/offers/new" class="btn btn-primary" style="font-weight:800; padding:0.75rem 1.5rem;">
						@components.IconPlus("icon-xs")
						<span>إضافة عرض خاص جديد</span>
					</a>
				</div>
			</div>

			<!-- Statistics Summary Cards (Clickable Filter Tabs) -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem;">
				<!-- Total Offers -->
				<a href="/vendor/offers" style="text-decoration:none; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.2rem 1.4rem; display:flex; align-items:center; justify-content:space-between;">
					<div>
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700; text-transform:uppercase;">إجمالي العروض</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", len(data.Offers)) }
						</div>
					</div>
					<div style="font-size:1.5rem; opacity:0.8;">📊</div>
				</a>

				<!-- Active Offers -->
				<a href="/vendor/offers?status=active" style="text-decoration:none; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.2rem 1.4rem; display:flex; align-items:center; justify-content:space-between; border-inline-start:4px solid var(--success);">
					<div>
						<div style="font-size:0.75rem; color:var(--success); font-weight:700; text-transform:uppercase;">العروض النشطة</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--success); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", countOffersByStatus(data.Offers, "active")) }
						</div>
					</div>
					<div style="font-size:1.5rem; opacity:0.8;">🟢</div>
				</a>

				<!-- Pending Review -->
				<a href="/vendor/offers?status=pending" style="text-decoration:none; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.2rem 1.4rem; display:flex; align-items:center; justify-content:space-between; border-inline-start:4px solid var(--warning);">
					<div>
						<div style="font-size:0.75rem; color:var(--warning); font-weight:700; text-transform:uppercase;">قيد المراجعة</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--warning); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", countOffersByAdminStatus(data.Offers, "pending")) }
						</div>
					</div>
					<div style="font-size:1.5rem; opacity:0.8;">⏳</div>
				</a>

				<!-- Drafts & Expired -->
				<a href="/vendor/offers?status=draft" style="text-decoration:none; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.2rem 1.4rem; display:flex; align-items:center; justify-content:space-between; border-inline-start:4px solid var(--secondary);">
					<div>
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700; text-transform:uppercase;">المسودات والمنتهية</div>
						<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d", countOffersByStatus(data.Offers, "draft") + countOffersByStatus(data.Offers, "expired")) }
						</div>
					</div>
					<div style="font-size:1.5rem; opacity:0.8;">📝</div>
				</a>
			</div>

			<!-- Offers Grid List -->
			if len(data.Offers) == 0 {
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:4rem 2rem; text-align:center;">
					<div style="width:64px; height:64px; border-radius:50%; background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto; font-size:1.75rem;">
						🎁
					</div>
					<h3 style="font-size:1.35rem; font-weight:800; color:var(--text); margin-bottom:0.4rem;">
						لا توجد عروض خاصة مضافة حتى الآن
					</h3>
					<p style="color:var(--text-muted); font-size:0.9rem; max-width:440px; margin:0 auto 1.5rem auto;">
						أنشئ عروضك الخاصة وخصص المنتجات المشمولة ونطاقات التغطية الجغرافية وأيام التوصيل للصيدليات.
					</p>
					<a href="/vendor/offers/new" class="btn btn-primary" style="font-weight:700;">
						@components.IconPlus("icon-xs")
						<span>+ إنشاء أول عرض خاص الآن</span>
					</a>
				</div>
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(340px, 1fr)); gap:1.25rem;">
					for _, o := range data.Offers {
						<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; display:flex; flex-direction:column; justify-content:space-between; gap:1.25rem; transition:border-color 150ms;">
							<div>
								<!-- Header Strip -->
								<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem; margin-bottom:0.75rem;">
									<div>
										<h3 style="font-size:1.15rem; font-weight:800; color:var(--text); margin:0;">
											{ o.Title.Get(i18n.Lang(lang)) }
										</h3>
										if o.BranchName != "" {
											<div style="font-size:0.75rem; color:var(--accent); margin-top:0.2rem;">
												📍 الفرع: { o.BranchName }
											</div>
										}
									</div>

									<div>
										if o.Status == "active" {
											<span class="badge badge-emerald" style="font-size:0.7rem; font-weight:800;">نشط</span>
										} else if o.Status == "draft" {
											<span class="badge badge-gray" style="font-size:0.7rem; font-weight:800;">مسودة</span>
										} else {
											<span class="badge badge-rose" style="font-size:0.7rem; font-weight:800;">{ o.Status }</span>
										}
									</div>
								</div>

								if o.Description.Get(i18n.Lang(lang)) != "" {
									<p style="font-size:0.825rem; color:var(--text-secondary); line-height:1.4; margin:0 0 1rem 0;">
										{ o.Description.Get(i18n.Lang(lang)) }
									</p>
								}

								<!-- Pricing & Products Summary Pill -->
								<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; background:var(--surface-sunken); padding:0.9rem; border-radius:var(--radius-xl); border:1px solid var(--border); margin-bottom:0.75rem;">
									<div>
										<div style="font-size:0.725rem; color:var(--text-muted); font-weight:700;">نسبة الخصم:</div>
										<div style="font-size:1.1rem; font-weight:800; color:var(--accent);" class="tabular-nums">
											{ fmt.Sprintf("%.1f%%", o.DiscountPercentage) }
										</div>
									</div>

									<div>
										<div style="font-size:0.725rem; color:var(--text-muted); font-weight:700;">السعر الكلي:</div>
										<div style="font-size:1.1rem; font-weight:800; color:var(--text);" class="tabular-nums">
											if o.TotalPrice.Minor() > 0 {
												{ o.TotalPrice.String() } <span style="font-size:0.75rem;">ج.م</span>
											} else {
												<span>حسب الصنف</span>
											}
										</div>
									</div>
								</div>

								<!-- Validity Dates & Location Cover Badge -->
								<div style="font-size:0.775rem; color:var(--text-muted); display:flex; justify-content:space-between; align-items:center; margin-top:0.25rem;">
									if o.StartDate != nil && o.EndDate != nil {
										<span>📅 { o.StartDate.Format("02/01/2006") } - { o.EndDate.Format("02/01/2006") }</span>
									} else {
										<span>📅 ساري المفعول</span>
									}

									<span style="color:var(--accent); font-weight:700;">
										{ fmt.Sprintf("%d صنف مشمول", len(o.Products)) }
									</span>
								</div>
							</div>

							<!-- Action Buttons -->
							<div style="border-top:1px solid var(--border); padding-top:0.9rem; display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
								<a href={ templ.SafeURL(fmt.Sprintf("/vendor/offers/%d/locations", o.ID)) } class="btn btn-secondary btn-xs" style="font-weight:700;">
									<span>🗺️ نطاقات التغطية</span>
								</a>

								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/offers/%d/delete", o.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا العرض الخاص؟');">
									<button type="submit" class="btn btn-secondary btn-xs" style="color:var(--danger); border-color:rgba(255, 71, 87, 0.2);">
										<span>حذف</span>
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}

func countOffersByStatus(offers []*promo.SpecialOffer, status string) int {
	c := 0
	for _, o := range offers {
		if o.Status == status {
			c++
		}
	}
	return c
}

func countOffersByAdminStatus(offers []*promo.SpecialOffer, status string) int {
	c := 0
	for _, o := range offers {
		if o.AdminStatus == status {
			c++
		}
	}
	return c
}
