package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerSavingImportModal(lang string) {
		@components.Modal(components.ModalProps{
		ID:       "pharmacy-saving-import-modal",
		Title:    "استيراد ملفات التوفير الذكي للصيدلية",
		Subtitle: "الخطوة 1 من 3: اختيار الملف وتحديد الأعمدة",
		Size:     "xl",
	}) {
		<div id="pharmacy-import-step-config" class="stack-lg">
						<div class="stack-sm"
							id="pharmacy-import-dropzone"
						
							onclick="document.getElementById('pharmacy-import-file-input').click()"
						>
							<div class="stack-xs text-sm">@components.IconBarChart("icon-sm")</div>
							<strong>
								انقر هنا لاختيار الملف أو اسحبه هنا
							</strong>
							<p class="text-sm text-muted m-0">
								يدعم ملفات Excel (.xlsx, .xls) وكشوف CSV (.csv) بحد أقصى 32 ميجابايت
							</p>
							<div class="stack-sm" id="pharmacy-import-filename-preview"></div>

							<input
								type="file"
								id="pharmacy-import-file-input"
								name="file"
								accept=".xlsx,.xls,.csv"
								required
							
								onchange="handlePharmacyImportFileSelect(this)"
							/>
						</div>

						<div class="stack-sm" id="pharmacy-import-columns-panel">
       <div class="stack-sm">
								<div class="row-center-sm">
									<span>@components.IconSettings("icon-sm")</span>
									<span>تحديد وتعيين أعمدة الملف:</span>
								</div>
								<span class="badge badge-emerald font-size-10">تم التحديد الذكي تلقائياً </span>
							</div>

							<div class="stack-sm" id="pharmacy-import-columns-loading">
								⏳ جاري قراءة أعمدة الملف وتحليل البيانات...
							</div>

							<div id="pharmacy-import-columns-grid" class="grid-halves">
        <div class="stack-sm">
									<label class="form-label">
										عمود اسم الصنف / الدواء <span class="text-danger">*</span>
									</label>
									<select name="col_name" id="pharmacy-col-name" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

        <div class="stack-sm">
									<label class="form-label">
										عمود كود الصنف / SKU / الباركود
									</label>
									<select name="col_sku" id="pharmacy-col-sku" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

        <div class="stack-sm">
									<label class="form-label">
										عمود الكمية المطلوبة
									</label>
									<select name="col_qty" id="pharmacy-col-qty" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

        <div class="stack-sm">
									<label class="form-label">
										عمود سعر الشراء المسجل (ج.م)
									</label>
									<select name="col_price" id="pharmacy-col-price" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>
							</div>

							<!-- Live Sample Preview Container -->
							<div class="stack-sm" id="pharmacy-import-preview-table-container"></div>
						</div>

      <!-- Unified matching settings -->
      <div class="stack-sm">
      	<label class="form-label">مطابقة الذكاء الاصطناعي</label>
      	<label class="form-label">
      		<input type="checkbox" name="use_ai" value="1" checked/>
      		<span class="text-body">تفعيل مطابقة الذكاء الاصطناعي للأصناف الصعبة</span>
      	</label>
      </div>

      <div class="stack-sm">
      	<label class="form-label">أقل نسبة مطابقة تُعتمد تلقائياً (%)</label>
      	<input type="number" name="min_match_score" min="25" max="100" value="50" class="form-input"/>
      </div>

      <div class="stack-sm">
      	<label class="form-label">المطابقة بالمعرّفات (اختياري)</label>
      	<label class="form-label">
      		<input type="checkbox" name="match_by_barcode" value="1"/>
      		<span class="text-body">عمود الكود يحمل باركود GTIN</span>
      	</label>
      	<label class="form-label">
      		<input type="checkbox" name="match_by_code" value="1"/>
      		<span class="text-body">المطابقة بعمود كود الصنف</span>
      	</label>
      	<label class="form-label">
      		<input type="checkbox" name="code_is_catalog_code" value="1"/>
      		<span class="text-body">عمود الكود يحمل أكواد دواء 24 نفسها</span>
      	</label>
      </div>

      <div class="stack-sm">
							ℹ️ <strong>معالجة آمنة في الخلفية:</strong> لن يتم حفظ أو تعديل أي صنف في قاعدة البيانات مباشرة؛ ستظهر لك نتائج المطابقة كاملة في الخطوة التالية لمراجعتها والموافقة عليها.
						</div>
					</div>

					<!-- STEP 2: Real-time Background Progress -->
					<div class="stack-sm" id="pharmacy-import-step-progress">
						<div class="stack-xs text-sm">@components.IconZap("icon-sm")</div>
						<h4 class="font-bold" id="pharmacy-progress-phase">
							جاري قراءة وفك تشفير ملف الإكسيل...
						</h4>
						<p class="text-sm text-secondary m-0" id="pharmacy-progress-sub">
							تتم المعالجة والمطابقة الصيدلانية في الخلفية دون تجميد المتصفح
						</p>

      <div class="wiz-progress">
							<div class="wiz-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100">
								<div class="wiz-progress-fill" id="pharmacy-progress-bar"></div>
							</div>
							<div class="wiz-progress-meta">
								<span id="pharmacy-progress-counter" class="tabular-nums"></span>
								<span id="pharmacy-progress-percent" class="wiz-progress-percent">0%</span>
							</div>
						</div>
					</div>

					<!-- STEP 3: Staged Review & Confirmation -->
					<div id="pharmacy-import-step-review" class="stack-md">
						<!-- Stats Summary Grid -->
      <div class="stack-sm">
       <div class="stack-sm">
								<div class="stack-xs text-sm">إجمالي الأصناف بالملف</div>
								<div class="stack-sm" id="pharmacy-review-total-count">0</div>
							</div>
       <div class="stack-sm">
								<div class="stack-xs text-sm">تم ربطها بالكتالوج</div>
								<div class="stack-sm" id="pharmacy-review-matched-count">0</div>
							</div>
       <div class="stack-sm">
								<div class="stack-xs text-sm">أصناف غير مرتبطة / جديدة</div>
								<div class="stack-sm" id="pharmacy-review-unlinked-count">0</div>
							</div>
       <div class="stack-sm">
								<div class="stack-xs text-sm">إجمالي الكمية المطلوبة</div>
								<div class="stack-sm" id="pharmacy-review-total-qty">0</div>
							</div>
						</div>

						<!-- Filter Tabs & Quick Search -->
      <div class="stack-sm">
							<div class="row-center-sm">
								<button type="button" class="btn btn-sm btn-ghost" id="pharmacy-tab-all" onclick="filterPharmacyReviewTable('all')">الكل (<span id="pharmacy-badge-all">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="pharmacy-tab-matched" onclick="filterPharmacyReviewTable('matched')">المتطابق فقط (<span id="pharmacy-badge-matched">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="pharmacy-tab-unlinked" onclick="filterPharmacyReviewTable('unlinked')">غير المرتبط (<span id="pharmacy-badge-unlinked">0</span>)</button>
							</div>
							<input type="text" id="pharmacy-review-search" class="form-input" placeholder="بحث سريع في المسودة..." oninput="searchPharmacyReviewTable(this.value)" />
						</div>

						<!-- Staged Items Table Container -->
						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th>
											<input type="checkbox" id="pharmacy-select-all" checked onchange="toggleAllPharmacyStagedRows(this.checked)" />
										</th>
										<th>اسم الصنف في الملف</th>
										<th>كود SKU</th>
										<th>الصنف المطابق بالكتالوج العام</th>
										<th class="text-center">حالة المطابقة</th>
										<th class="text-center">الكمية</th>
										<th class="text-end">سعر الشراء</th>
									</tr>
								</thead>
								<tbody id="pharmacy-review-table-body"></tbody>
							</table>
						</div>

      <div class="stack-sm">
							<span>لم يتم حفظ أي صنف في قاعدة البيانات بعد. اضغط "تأكيد الاستيراد والحفظ" لاعتماد البيانات.</span>
							<span>الأصناف المحددة: <strong id="pharmacy-selected-count">0</strong></span>
						</div>
					</div>

				<!-- Fixed Sticky Footer -->
				<div class="stack-sm" id="pharmacy-import-footer">
					<div class="stack-sm" id="pharmacy-footer-left">
						<button type="button" id="pharmacy-cancel-btn" class="btn btn-secondary" onclick="handlePharmacyImportCancelClick()">
							إلغاء
						</button>
					</div>
					<div id="pharmacy-footer-right" class="row-center-sm">
						<button type="button" id="pharmacy-back-btn" class="btn btn-secondary" onclick="backToPharmacyImportConfig()">
							← الرجوع لضبط الأعمدة
						</button>
						<button type="button" id="pharmacy-start-btn" class="btn btn-primary" onclick="startPharmacyAsyncImport()">
							بدء المعالجة ومطابقة الذكاء الاصطناعي 
						</button>
						<button type="button" id="pharmacy-commit-btn" class="btn btn-primary" onclick="commitPharmacyStagedImport()">
							تأكيد الاستيراد والحفظ النهائي في قائمة التوفير
						</button>
					</div>
				</div>
			
	}

}
