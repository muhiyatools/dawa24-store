package pages

import (
	"encoding/json"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorSponsorshipForm(data SponsorshipRequestsData, lang string) {
	<div
		class="glass-panel p-6 mb-6 border border-slate-200/80 rounded-2xl shadow-xs"
		x-data={ fmt.Sprintf(`{
			availableProducts: %s,
			availableOffers: %s,
			itemType: 'product',
			selectedItems: [],
			selectedPackageID: '%s',
			searchQuery: '',
			showDropdown: false,
			packagesCredits: %s,
			hasPackages: %t,
			lang: %q,

			get currentAvailableList() {
				if (this.itemType === 'product') {
					if (!this.searchQuery.trim()) return this.availableProducts.slice(0, 15);
					const q = this.searchQuery.toLowerCase();
					return this.availableProducts.filter(p => 
						(p.name_ar && p.name_ar.toLowerCase().includes(q)) ||
						(p.name_en && p.name_en.toLowerCase().includes(q)) ||
						(p.sku && p.sku.toLowerCase().includes(q))
					).slice(0, 15);
				} else {
					if (!this.searchQuery.trim()) return this.availableOffers.slice(0, 15);
					const q = this.searchQuery.toLowerCase();
					return this.availableOffers.filter(o => 
						o.title && o.title.toLowerCase().includes(q)
					).slice(0, 15);
				}
			},

			get selectedPkgCredits() {
				return this.packagesCredits[this.selectedPackageID] || 0;
			},

			addItem(item) {
				const id = item.variant_id || item.id;
				if (this.selectedItems.some(i => i.id === id)) return;
				if (this.selectedItems.length >= this.selectedPkgCredits) return;
				const title = this.lang === 'en' ? (item.name_en || item.title || item.name_ar || ('#' + id)) : (item.name_ar || item.title || item.name_en || ('#' + id));
				this.selectedItems.push({
					id: id,
					title: title,
					sku: item.sku || '',
					stock: item.available_stock || 0
				});
				this.searchQuery = '';
				this.showDropdown = false;
			},

			removeItem(id) {
				this.selectedItems = this.selectedItems.filter(i => i.id !== id);
			},

			onTypeChange() {
				this.selectedItems = [];
				this.searchQuery = '';
			},

			get canSubmit() {
				return this.hasPackages
					&& this.selectedItems.length > 0
					&& this.selectedItems.length <= this.selectedPkgCredits;
			},

			get blockedReason() {
				if (!this.hasPackages) return %q;
				if (this.selectedItems.length === 0) return %q;
				if (this.selectedItems.length > this.selectedPkgCredits) return %q;
				return '';
			}
		}`, InStockItemsToJSON(data.ItemOptions), ActiveOffersToJSON(data.ActiveOffers), func() string { if len(data.ActivePurchases) > 0 { return fmt.Sprintf("%d", data.ActivePurchases[0].PackageID) }; return "" }(), func() string {
			m := make(map[string]int)
			for _, p := range data.ActivePurchases {
				if p != nil {
					m[fmt.Sprintf("%d", p.PackageID)] = p.CreditsRemaining
				}
			}
			b, _ := json.Marshal(m)
			return string(b)
		}(), len(data.ActivePurchases) > 0, lang, i18n.T(lang, "vendor_sponsorship.block_no_package"), i18n.T(lang, "vendor_sponsorship.block_no_items"), i18n.T(lang, "vendor_sponsorship.block_exceed_credits")) }
	>
		<div class="d-flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
			@components.IconPlus("icon-xs text-brand")
			<h3 class="text-sm font-black text-primary m-0">{ i18n.T(lang, "vendor_sponsorship.form_title") }</h3>
		</div>

		<form method="POST" action="/vendor/sponsorship-requests/new" class="d-flex flex-col gap-4 m-0">
			<div class="d-grid grid-auto-fit-sm gap-4">
				<div class="stack-sm">
					<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">{ i18n.T(lang, "vendor_sponsorship.lbl_item_type") }</label>
					<select name="item_type" x-model="itemType" @change="onTypeChange()" class="form-input text-xs font-semibold">
						<option value="product">{ i18n.T(lang, "vendor_sponsorship.type_product") }</option>
						<option value="offer">{ i18n.T(lang, "vendor_sponsorship.type_offer") }</option>
					</select>
				</div>

				<div class="stack-sm">
					<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">{ i18n.T(lang, "vendor_sponsorship.lbl_pkg_select") }</label>
					<select name="package_id" x-model="selectedPackageID" class="form-input text-xs font-semibold" required>
						if len(data.ActivePurchases) > 0 {
							for _, p := range data.ActivePurchases {
								if p != nil {
									<option value={ fmt.Sprintf("%d", p.PackageID) }>
										{ fmt.Sprintf(i18n.T(lang, "vendor_sponsorship.pkg_opt_format"), p.PackageID, p.CreditsRemaining, p.CreditsTotal) }
									</option>
								}
							}
						} else {
							<option value="" disabled selected>{ i18n.T(lang, "vendor_sponsorship.pkg_no_credits") }</option>
						}
					</select>
				</div>
			</div>

			<!-- Dynamic Multi-Select Search Dropdown -->
			<div class="position-relative">
				<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">
					<span x-text={ fmt.Sprintf("itemType === 'product' ? %q : %q", i18n.T(lang, "vendor_sponsorship.lbl_search_products"), i18n.T(lang, "vendor_sponsorship.lbl_search_offers")) }></span>
				</label>

				<div class="position-relative">
					<input
						type="text"
						x-model="searchQuery"
						@focus="showDropdown = true"
						@input="showDropdown = true"
						:placeholder={ fmt.Sprintf("itemType === 'product' ? %q : %q", i18n.T(lang, "vendor_sponsorship.placeholder_search_prod"), i18n.T(lang, "vendor_sponsorship.placeholder_search_offer")) }
						class="form-input text-xs font-semibold w-full ps-9"
						autocomplete="off"
					/>
					<span class="position-absolute start-3 top-half translate-middle-y text-muted pointer-events-none">
						@components.IconSearch("icon-xs")
					</span>
				</div>

				<!-- Autocomplete Results Dropdown -->
				<div
					x-show="showDropdown"
					@click.outside="showDropdown = false"
					class="position-absolute z-50 w-full bg-white border border-slate-200 rounded-2xl shadow-2xl p-2 mt-1.5 max-h-60 overflow-y-auto"
					x-cloak
				>
					<template x-for="item in currentAvailableList" :key="item.variant_id || item.id">
						<div
							@click="addItem(item)"
							class="p-2.5 rounded-xl cursor-pointer d-flex items-center justify-between gap-3 border-b border-slate-100 last:border-b-0 transition-colors"
						>
							<div class="d-flex items-center gap-2.5">
								<div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 d-flex items-center justify-center">
									<template x-if="itemType === 'product'">
										@components.IconPill("icon-xs")
									</template>
									<template x-if="itemType === 'offer'">
										@components.IconPercent("icon-xs")
									</template>
								</div>
								<div class="stack-sm">
									<strong class="text-xs font-bold text-primary d-block" x-text="lang === 'en' ? (item.name_en || item.title || item.name_ar) : (item.name_ar || item.title || item.name_en)"></strong>
									<div class="text-2xs text-muted font-mono" x-show="item.sku" x-text="'SKU: ' + item.sku"></div>
								</div>
							</div>
							<div class="text-end">
								<template x-if="itemType === 'product'">
									<span class="badge badge-emerald text-2xs font-extrabold tabular-nums" x-text="item.available_stock + ' ' + (lang === 'en' ? 'in stock' : 'عبوة متوفرة')"></span>
								</template>
								<button type="button" class="btn btn-secondary btn-2xs font-bold gap-1 mt-1">
									@components.IconPlus("icon-2xs")
									<span>{ i18n.T(lang, "vendor_sponsorship.btn_add_item") }</span>
								</button>
							</div>
						</div>
					</template>
					<div x-show="currentAvailableList.length === 0" class="p-4 text-center text-xs text-muted">
						{ i18n.T(lang, "vendor_sponsorship.no_matching_items") }
					</div>
				</div>
			</div>

			<!-- Selected Items Chips Display -->
			<div class="p-4 bg-slate-50/80 border border-slate-200/80 rounded-2xl">
				<div class="flex-between items-center mb-2.5 pb-2 border-b border-slate-200/60">
					<div class="d-flex items-center gap-2">
						@components.IconCheckCircle("icon-xs text-brand")
						<span class="text-xs font-black text-primary">{ i18n.T(lang, "vendor_sponsorship.selected_items_title") }</span>
					</div>
					<div class="text-xs text-secondary font-bold">
						<span>{ i18n.T(lang, "vendor_sponsorship.cost_prefix") }</span>
						<strong class="text-brand tabular-nums font-black" x-text="selectedItems.length + ' ' + (lang === 'en' ? 'Credits (1 per item)' : 'رصيد (1 لكل عنصر)')"></strong>
					</div>
				</div>

				<div class="d-flex items-center gap-2 flex-wrap min-h-8">
					<template x-if="selectedItems.length === 0">
						<span class="text-xs text-muted font-medium">{ i18n.T(lang, "vendor_sponsorship.empty_selected_items") }</span>
					</template>
					<template x-for="it in selectedItems" :key="it.id">
						<div class="badge badge-sky font-bold text-xs gap-1.5 p-1.5 ps-2.5 rounded-xl border border-sky-300/60 d-flex items-center shadow-2xs">
							<span x-text="it.title"></span>
							<button
								type="button"
								@click="removeItem(it.id)"
								class="w-4 h-4 rounded-full bg-sky-200 text-sky-800 d-flex items-center justify-center text-2xs cursor-pointer border-0"
								title={ i18n.T(lang, "vendor_team.btn_delete") }
							>
								&times;
							</button>
						</div>
					</template>
				</div>

				<!-- Hidden Inputs for Submission -->
				<template x-for="it in selectedItems" :key="it.id">
					<input type="hidden" name="item_ids" :value="it.id" />
				</template>
			</div>

			<!-- Credits Calculation & Warning -->
			<div class="p-4 bg-surface-sunken rounded-2xl border border-slate-200 d-flex items-center justify-between gap-4 flex-wrap text-xs">
				<div class="d-flex items-center gap-2 text-secondary">
					@components.IconZap("icon-xs text-amber-500")
					<span>{ i18n.T(lang, "vendor_sponsorship.credit_rule_notice") }</span>
				</div>
				<div class="d-flex items-center gap-3 tabular-nums font-bold">
					<span>{ i18n.T(lang, "vendor_sponsorship.lbl_avail_credits") }<strong class="text-primary" x-text="selectedPkgCredits"></strong></span>
					<span>{ i18n.T(lang, "vendor_sponsorship.lbl_req_credits") }<strong class="text-amber-600" x-text="selectedItems.length"></strong></span>
					<span>{ i18n.T(lang, "vendor_sponsorship.lbl_rem_credits") }<strong :class="selectedPkgCredits - selectedItems.length >= 0 ? 'text-emerald-600' : 'text-rose-600'" x-text="selectedPkgCredits - selectedItems.length"></strong></span>
				</div>
			</div>

			<div class="pt-2">
				<button
					type="submit"
					class="btn btn-primary btn-sm font-black px-8 shadow-sm gap-2"
					:disabled="!canSubmit"
				>
					@components.IconCheck("icon-xs")
					<span x-text={ fmt.Sprintf("canSubmit ? (lang === 'en' ? ('Submit ' + selectedItems.length + ' Requests (Deduct ' + selectedItems.length + ' credits)') : ('إرسال ' + selectedItems.length + ' طلب رعاية للمراجعة (خصم ' + selectedItems.length + ' رصيد)')) : %q", i18n.T(lang, "vendor_sponsorship.btn_submit_req")) }></span>
				</button>
				<p class="text-2xs text-danger font-bold mt-2 m-0" x-show="blockedReason" x-cloak x-text="blockedReason"></p>
			</div>
		</form>
	</div>
}
