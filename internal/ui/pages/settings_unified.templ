package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type UnifiedSettingsData struct {
	User           *identity.User
	PaymentMethods []*billing.UserPaymentMethod
	Sessions       []*identity.Session
	ActiveTab      string
}

templ UnifiedSettingsPage(data UnifiedSettingsData, lang, dir string) {
	@layouts.ShellFor("إعدادات الحساب والمنشأة", "settings", lang, dir, authctx.FromContext(ctx)) {

		<div
			style="max-width:100%; margin:0 0 4rem 0;"
			x-data="{
				isAddPaymentModalOpen: false,
				paymentType: 'bank',
				isDeleteAccountModalOpen: false
			}"
		>
			<!-- Page Header -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
						<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
							@components.IconSettings("icon-sm")
						</div>
						<h2 style="font-size:1.6rem; font-weight:900; color:var(--text); margin:0;">
							إعدادات الحساب والمنشأة
						</h2>
					</div>
					<p style="color:var(--text-muted); font-size:0.925rem; margin:0;">
						إدارة البيانات الشخصية، المحفظة، طرق الدفع والحسابات البنكية، التراخيص، والأمان
					</p>
				</div>

				<a href="/wallet" class="btn btn-primary" style="padding:0.6rem 1.25rem; font-weight:800;">
					@components.IconWallet("icon-xs")
					<span>فتح المحفظة المالية</span>
				</a>
			</div>

			<!-- Unified Tabs Navigation Bar -->
			<div class="tab-list">
				<button type="button" class="tab-btn active" data-tab-target="profile">
					@components.IconUser("icon-xs")
					<span>الملف الشخصي</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="wallet">
					@components.IconWallet("icon-xs")
					<span>المحفظة والرصيد</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="payments">
					@components.IconShield("icon-xs")
					<span>طرق الدفع ({ fmt.Sprintf("%d", len(data.PaymentMethods)) })</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="organization">
					@components.IconBuilding("icon-xs")
					<span>المنشأة والتراخيص</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="security">
					@components.IconSettings("icon-xs")
					<span>الأمان والجلسات</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="preferences">
					@components.IconBell("icon-xs")
					<span>الإشعارات والتفضيلات</span>
				</button>
			</div>

			<!-- Tab 1: Profile -->
			<div id="tab-profile" class="tab-pane active card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin-bottom:1.5rem;">
					البيانات الشخصية والصورة الرمزية
				</h3>

				<form action="/settings/profile" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.5rem; text-align:start;">
					
					<!-- Avatar Picker Section -->
					<div style="display:flex; align-items:center; gap:1.5rem; padding:1.25rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl);">
						<div style="width:72px; height:72px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0; border:2px solid var(--accent); overflow:hidden;">
							if data.User != nil && data.User.AvatarURL != "" {
								<img src={ data.User.AvatarURL } alt="Avatar" style="width:100%; height:100%; object-fit:cover;" />
							} else {
								@components.IconUser("icon-lg")
							}
						</div>
						<div style="flex:1;">
							<label class="form-label" for="user-avatar" style="margin-bottom:0.25rem;">رابط الصورة الشخصية / الصورة الرمزية</label>
							<input type="text" id="user-avatar" name="avatar_url" class="form-input" value={ ternaryStr(data.User != nil, data.User.AvatarURL, "") } placeholder="https://example.com/avatar.jpg" />
							<span style="font-size:0.75rem; color:var(--text-muted); display:block; margin-top:0.25rem;">يمكنك إدخال رابط مباشر لصورتك أو شعار الصيدلية</span>
						</div>
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-name">الاسم بالكامل</label>
						<input type="text" id="user-name" name="name" class="form-input" value={ userNameVal(data.User) } placeholder="د. أحمد محمود" required />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-email">البريد الإلكتروني</label>
						<input type="email" id="user-email" name="email" class="form-input tabular-nums" value={ userEmailVal(data.User) } placeholder="pharmacy@dawa24.eg" required />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-phone">رقم الهاتف / الواتساب</label>
						<input type="tel" id="user-phone" name="phone" class="form-input tabular-nums" value={ userPhoneVal(data.User) } placeholder="01012345678" />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-role">نوع الحساب والصلاحية</label>
						<input type="text" id="user-role" class="form-input" value={ userRoleVal(data.User) } disabled style="background:var(--surface-sunken); color:var(--text-muted);" />
					</div>

					<div style="margin-top:0.75rem;">
						<button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem; font-weight:800;">
							@components.IconCheck("icon-xs")
							<span>حفظ التعديلات وتحديث الملف</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Tab 2: Wallet Snapshot -->
			<div id="tab-wallet" class="tab-pane card" style="padding:2.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
							المحفظة الإلكترونية والرصيد
						</h3>
						<p style="color:var(--text-muted); font-size:0.875rem; margin-top:0.25rem;">الرصيد المتاح للطلبيات وسجل المعاملات المعتمد</p>
					</div>

					<div style="display:flex; gap:0.75rem;">
						<a href="/wallet" class="btn btn-primary btn-sm" style="font-weight:800;">
							@components.IconPlus("icon-xs")
							<span>إيداع رصيد جديد</span>
						</a>
						<a href="/wallet" class="btn btn-secondary btn-sm" style="font-weight:800;">
							@components.IconArrowLeft("icon-xs")
							<span>طلب سحب</span>
						</a>
					</div>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem; margin-bottom:2rem;">
					<div style="padding:1.5rem; background:var(--accent-subtle); border:1px solid var(--accent); border-radius:var(--radius-xl);">
						<div style="font-size:0.85rem; color:var(--accent); font-weight:700;">الرصيد المتاح</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--text); margin-top:0.5rem;" class="tabular-nums">5,420.00 <span style="font-size:1rem; font-weight:700;">ج.م</span></div>
					</div>

					<div style="padding:1.5rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl);">
						<div style="font-size:0.85rem; color:var(--text-secondary); font-weight:700;">الرصيد المعلق (أوامر جارية)</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--text); margin-top:0.5rem;" class="tabular-nums">1,250.00 <span style="font-size:1rem; font-weight:700;">ج.م</span></div>
					</div>

					<div style="padding:1.5rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl);">
						<div style="font-size:0.85rem; color:var(--text-secondary); font-weight:700;">إجمالي الإيداعات</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--text); margin-top:0.5rem;" class="tabular-nums">48,900.00 <span style="font-size:1rem; font-weight:700;">ج.م</span></div>
					</div>
				</div>

				<div style="text-align:start;">
					<a href="/wallet" class="btn btn-secondary" style="font-weight:700;">
						<span>عرض كشف الحساب الكامل والمعاملات</span>
						@components.IconArrowLeft("icon-xs")
					</a>
				</div>
			</div>

			<!-- Tab 3: Payment Methods -->
			<div id="tab-payments" class="tab-pane card" style="padding:2.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
							طرق الدفع والحسابات البنكية المحفوظة
						</h3>
						<p style="color:var(--text-muted); font-size:0.85rem; margin-top:0.25rem;">
							الحسابات المعتمدة لعمليات الدفع، التسوية، والتحويلات البنكية
						</p>
					</div>

					<button
						type="button"
						class="btn btn-primary btn-sm"
						@click="isAddPaymentModalOpen = true"
						style="font-weight:800;"
					>
						@components.IconPlus("icon-xs")
						<span>إضافة وسيلة دفع جديدة</span>
					</button>
				</div>

				if len(data.PaymentMethods) == 0 {
					<div style="padding:3.5rem 1.5rem; border:2px dashed var(--border); border-radius:var(--radius-2xl); text-align:center; background:var(--surface-sunken);">
						<div style="width:54px; height:54px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;">
							@components.IconShield("icon-md")
						</div>
						<h4 style="font-size:1.15rem; font-weight:800; color:var(--text); margin:0 0 0.4rem 0;">
							لا توجد وسائل دفع محفوظة حالياً
						</h4>
						<p style="color:var(--text-muted); font-size:0.875rem; max-width:440px; margin:0 auto 1.5rem auto; line-height:1.5;">
							أضف حسابك البنكي الرسمي أو معرف إنستاباي لربطه بالمعاملات المالية وأوامر التوريد المباشرة.
						</p>
						<button
							type="button"
							class="btn btn-primary"
							@click="isAddPaymentModalOpen = true"
							style="font-weight:800;"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة أول وسيلة دفع</span>
						</button>
					</div>
				} else {
					<div style="display:grid; grid-template-columns:1fr; gap:1rem;">
						for _, pm := range data.PaymentMethods {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); flex-wrap:wrap; gap:1rem;">
								<div style="display:flex; align-items:center; gap:1rem;">
									<div style="width:46px; height:46px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
										if pm.Provider == "bank" {
											@components.IconBuilding("icon-sm")
										} else if pm.Provider == "instapay" {
											@components.IconWallet("icon-sm")
										} else {
											@components.IconShield("icon-sm")
										}
									</div>
									<div>
										<div style="font-weight:800; color:var(--text); display:flex; align-items:center; gap:0.5rem;">
											<span>{ paymentProviderTitle(pm.Provider) }</span>
											if pm.IsDefault {
												<span class="badge badge-emerald" style="font-size:0.75rem;">الافتراضي</span>
											}
										</div>
										<div style="font-size:0.875rem; color:var(--text-secondary); margin-top:0.25rem;" class="tabular-nums" dir="ltr">
											{ pm.AccountIdentifier }
										</div>
									</div>
								</div>

								<div style="display:flex; align-items:center; gap:0.75rem;">
									<span class="badge badge-sky" style="font-weight:700;">معتمد</span>

									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/settings/payment-methods/%d/delete", pm.ID)) } style="margin:0;" onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف وسيلة الدفع هذه؟');">
										<button
											type="submit"
											class="btn btn-secondary btn-icon"
											style="color:var(--danger); border-color:var(--danger-border); width:36px; height:36px;"
											title="حذف وسيلة الدفع"
										>
											@components.IconTrash("icon-xs")
										</button>
									</form>
								</div>
							</div>
						}
					</div>
				}
			</div>

			<!-- Tab 4: Organization & Licenses -->
			<div id="tab-organization" class="tab-pane card" style="padding:2.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
							بيانات المنشأة والتراخيص الرسمية
						</h3>
						<p style="color:var(--text-muted); font-size:0.875rem; margin-top:0.25rem;">
							السجلات التجارية وتراخيص هيئة الدواء المصرية (EDA)
						</p>
					</div>

					<a href="/customer/branches" class="btn btn-secondary btn-sm" style="font-weight:700;">
						@components.IconBuilding("icon-xs")
						<span>إدارة فروع ومواقع استلام الصيدلية</span>
					</a>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem; margin-bottom:2rem;">
					<div style="padding:1.25rem; background:var(--surface-sunken); border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">الاسم القانوني للمنشأة</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--text); margin-top:0.25rem;">صيدلية معتمدة - شبكة دواء 24</div>
					</div>

					<div style="padding:1.25rem; background:var(--surface-sunken); border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">رقم السجل التجاري</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">CR-9481920</div>
					</div>

					<div style="padding:1.25rem; background:var(--surface-sunken); border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">رقم البطاقة الضريبية (ETA)</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--text); margin-top:0.25rem;" class="tabular-nums">984-210-941</div>
					</div>

					<div style="padding:1.25rem; background:var(--surface-sunken); border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">رقم ترخيص المؤسسة الصيدلية</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--accent); margin-top:0.25rem;" class="tabular-nums">EDA-LIC-2024-8842</div>
					</div>
				</div>

				<div style="padding:1rem 1.25rem; background:var(--success-surface); border:1px solid var(--success-border); border-radius:var(--radius-lg); display:flex; align-items:center; gap:0.75rem;">
					<div style="color:var(--success-text);">@components.IconCheckCircle("icon-sm")</div>
					<div style="color:var(--success-text); font-weight:700; font-size:0.9rem;">
						حساب المؤسسة موثق ومعتمد رسمياً للتوريد والشراء المباشر عبر منظومة دواء 24.
					</div>
				</div>
			</div>

			<!-- Tab 5: Security & Sessions -->
			<div id="tab-security" class="tab-pane card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin-bottom:1.5rem;">
					الأمان وكلمة المرور والجلسات النشطة
				</h3>

				<div style="max-width:680px; margin-bottom:2.5rem; text-align:start;">
					<h4 style="font-size:1.05rem; font-weight:800; color:var(--text); margin-bottom:1rem;">تحديث كلمة المرور</h4>
					<form action="/settings/password" method="POST" style="display:flex; flex-direction:column; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label">كلمة المرور الحالية</label>
							<input type="password" name="current_password" required class="form-input" placeholder="••••••••" />
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">كلمة المرور الجديدة</label>
								<input type="password" name="new_password" required minlength="8" class="form-input" placeholder="••••••••" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">تأكيد كلمة المرور الجديدة</label>
								<input type="password" name="confirm_password" required minlength="8" class="form-input" placeholder="••••••••" />
							</div>
						</div>

						<div style="margin-top:0.5rem;">
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>تحديث كلمة المرور</span>
							</button>
						</div>
					</form>
				</div>

				<div style="border-top:1px solid var(--border); padding-top:1.5rem;">
					<h4 style="font-size:1.05rem; font-weight:800; color:var(--text); margin-bottom:1rem;">
						الأجهزة والجلسات المتصلة حالياً
					</h4>
					<div style="display:flex; flex-direction:column; gap:0.75rem;">
						for _, sess := range data.Sessions {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 1.25rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-sunken);">
								<div style="display:flex; align-items:center; gap:0.75rem;">
									<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
										@components.IconSettings("icon-xs")
									</div>
									<div>
										<div style="font-weight:700; font-size:0.9rem; color:var(--text);">{ sess.UserAgent }</div>
										<div style="font-size:0.8rem; color:var(--text-muted);" class="tabular-nums">
											IP: { sess.IP } • متصل منذ { sess.CreatedAt.Format("2006-01-02 15:04") }
										</div>
									</div>
								</div>
								<form action="/settings/sessions/revoke" method="POST" style="margin:0;">
									<input type="hidden" name="token" value={ sess.Token } />
									<button type="submit" class="btn btn-danger btn-sm">إنهاء الجلسة</button>
								</form>
							</div>
						}
					</div>
				</div>

				<!-- Danger Zone: Account Deletion Request -->
				<div style="border-top:1px solid var(--danger-border); margin-top:2.5rem; padding-top:1.75rem;">
					<div style="background:var(--danger-surface); border:1px solid var(--danger-border); border-radius:var(--radius-xl); padding:1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
						<div>
							<div style="display:flex; align-items:center; gap:0.5rem; color:var(--danger-text); font-weight:800; font-size:1.05rem;">
								@components.IconTrash("icon-xs")
								<span>طلب حذف الحساب وإنهاء النشاط</span>
							</div>
							<p style="font-size:0.85rem; color:var(--text-secondary); margin:0.35rem 0 0 0; line-height:1.5; max-width:620px;">
								يمكنك تقديم طلب رسمي لإلغاء الحساب وحذف البيانات. ستتم مراجعة الطلب من إدارة المنصة والتحقق من تسوية المستحقات المالية وأوامر التوريد قبل إتمام الحذف.
							</p>
						</div>
						<button
							type="button"
							class="btn btn-danger"
							style="font-weight:800; padding:0.65rem 1.5rem;"
							@click="isDeleteAccountModalOpen = true"
						>
							@components.IconTrash("icon-xs")
							<span>تقديم طلب حذف الحساب</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Tab 6: Preferences -->
			<div id="tab-preferences" class="tab-pane card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin-bottom:1.5rem;">
					تفضيلات الإشعارات والتنبيهات
				</h3>

				<form action="/settings/preferences" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.25rem; text-align:start;">
					<div style="display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-sunken);">
						<div>
							<div style="font-weight:800; color:var(--text);">إشعارات الواتساب (WhatsApp Alerts)</div>
							<div style="font-size:0.85rem; color:var(--text-muted);">استلام تحديثات تسليم الشحنات وتغير حالة أوامر الشراء فورياً</div>
						</div>
						<input type="checkbox" name="notif_whatsapp" checked style="width:20px; height:20px; accent-color:var(--accent);" />
					</div>

					<div style="display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-sunken);">
						<div>
							<div style="font-weight:800; color:var(--text);">رسائل البريد الإلكتروني للفواتير الضريبية</div>
							<div style="font-size:0.85rem; color:var(--text-muted);">إرسال نسخة PDF معتمدة من الفاتورة الضريبية فور اكتمال الطلب</div>
						</div>
						<input type="checkbox" name="notif_invoices" checked style="width:20px; height:20px; accent-color:var(--accent);" />
					</div>

					<div style="display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-sunken);">
						<div>
							<div style="font-weight:800; color:var(--text);">تنبيهات انخفاض المخزون والخصومات الحصرية</div>
							<div style="font-size:0.85rem; color:var(--text-muted);">إشعارات عند توفر أصناف دوائية ناقصة أو وجود عروض بونص خاصة</div>
						</div>
						<input type="checkbox" name="notif_promos" checked style="width:20px; height:20px; accent-color:var(--accent);" />
					</div>

					<div style="margin-top:0.75rem;">
						<button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem; font-weight:800;">
							@components.IconCheck("icon-xs")
							<span>حفظ التفضيلات</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Dynamic Modal: Add Payment Method Modal (Centered Popup) -->
			<div
				x-show="isAddPaymentModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isAddPaymentModalOpen = false"
			>
				<div
					@click.outside="isAddPaymentModalOpen = false"
					class="card"
					style="max-width:560px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconShield("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								إضافة وسيلة دفع جديدة
							</h3>
						</div>
						<button type="button" @click="isAddPaymentModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form action="/settings/payment-methods" method="POST" style="display:flex; flex-direction:column; gap:1.25rem; text-align:start;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label">نوع وسيلة الدفع *</label>
							<select name="type" x-model="paymentType" class="form-select">
								<option value="bank">حساب بنكي رسمي (Bank Account / IBAN)</option>
								<option value="instapay">إنستاباي / محفظة هاتف (InstaPay / E-Wallet)</option>
								<option value="card">بطاقة دفع إلكتروني (Debit / Credit Card)</option>
							</select>
						</div>

						<!-- Bank Account Fields -->
						<div x-show="paymentType === 'bank'" style="display:flex; flex-direction:column; gap:1rem;">
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">اسم البنك *</label>
									<input type="text" name="bank_name" class="form-input" placeholder="البنك الأهلي المصري NBE / CIB" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">اسم صاحب الحساب *</label>
									<input type="text" name="account_holder" class="form-input" placeholder="مطابق للسجل التجاري أو المنشأة" />
								</div>
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">رقم الآيبان الدولي (IBAN) *</label>
								<input type="text" name="iban" class="form-input tabular-nums" dir="ltr" placeholder="EG380003000012345678901234567" />
							</div>
						</div>

						<!-- InstaPay Fields -->
						<div x-show="paymentType === 'instapay'" x-cloak style="display:flex; flex-direction:column; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">عنوان الدفع اللحظي IPA أو رقم الهاتف *</label>
								<input type="text" name="instapay_handle" class="form-input tabular-nums" dir="ltr" placeholder="pharmacy.name@instapay" />
							</div>
						</div>

						<!-- Card Fields -->
						<div x-show="paymentType === 'card'" x-cloak style="display:flex; flex-direction:column; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">اسم حامل البطاقة *</label>
								<input type="text" name="card_name" class="form-input" placeholder="الاسم كما هو مدون على البطاقة" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">رقم البطاقة (16 رقم) *</label>
								<input type="text" name="card_number" class="form-input tabular-nums" dir="ltr" placeholder="•••• •••• •••• ••••" />
							</div>
						</div>

						<div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.25rem;">
							<input type="checkbox" id="is_default_pm" name="is_default" value="1" style="width:18px; height:18px; accent-color:var(--accent);" />
							<label for="is_default_pm" style="font-size:0.875rem; font-weight:700; color:var(--text); cursor:pointer;">
								تعيين كوسيلة دفع وحساب افتراضي
							</label>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isAddPaymentModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="padding-inline:1.75rem; font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ وسيلة الدفع</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Dynamic Modal: Request Account Deletion Modal (Centered Popup) -->
			<div
				x-show="isDeleteAccountModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isDeleteAccountModalOpen = false"
			>
				<div
					@click.outside="isDeleteAccountModalOpen = false"
					class="card"
					style="max-width:540px; width:100%; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.5rem; color:var(--danger-text);">
							@components.IconTrash("icon-sm")
							<h3 style="font-size:1.25rem; font-weight:800; margin:0;">
								طلب حذف الحساب
							</h3>
						</div>
						<button type="button" @click="isDeleteAccountModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form action="/settings/delete-request" method="POST" style="display:flex; flex-direction:column; gap:1.25rem; text-align:start;">
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1rem; font-size:0.875rem; color:var(--text-secondary); line-height:1.6;">
							تنبيه: سيتم إرسال طلبك إلى إدارة المنصة للتحقق من عدم وجود معاملات معلقة. يمكنك كتابة سبب الحذف اختيارياً:
						</div>

						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label">سبب طلب حذف الحساب (اختياري)</label>
							<textarea name="reason" rows="3" class="form-input" placeholder="مثال: تغيير النشاط، إغلاق الفرع، أو أي ملاحظات أخرى..."></textarea>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isDeleteAccountModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-danger" style="padding-inline:1.75rem; font-weight:800;">
								@components.IconTrash("icon-xs")
								<span>تأكيد إرسال طلب الحذف</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}

func paymentProviderTitle(provider string) string {
	switch provider {
	case "bank":
		return "حساب بنكي معتمد"
	case "instapay":
		return "معرف إنستاباي (InstaPay / E-Wallet)"
	case "card":
		return "بطاقة دفع إلكتروني"
	default:
		return "وسيلة دفع معتمدة"
	}
}

func userNameVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Name.Get("ar")
}

func userEmailVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Email
}

func userPhoneVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Phone
}

func userRoleVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Role
}

func ternaryStr(cond bool, a, b string) string {
	if cond {
		return a
	}
	return b
}
