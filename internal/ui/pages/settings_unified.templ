package pages

import (
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type UnifiedSettingsData struct {
	User        *identity.User
	Addresses   []*identity.UserAddress
	Sessions    []*identity.Session
	ActiveTab   string
}

templ UnifiedSettingsPage(data UnifiedSettingsData, lang, dir string) {
	@layouts.ShellFor("إعدادات الحساب والمنشأة", "settings", lang, dir, authctx.FromContext(ctx)) {

		<div style="max-width:100%; margin:0 0 4rem 0;">
			<!-- Page Header -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
						<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
							@components.IconSettings("icon-sm")
						</div>
						<h2 style="font-size:1.6rem; font-weight:900; color:var(--neutral-900); margin:0;">
							إعدادات الحساب والمنشأة
						</h2>
					</div>
					<p style="color:var(--neutral-500); font-size:0.925rem; margin:0;">
						إدارة البيانات الشخصية، المحفظة، طرق الدفع، التراخيص، والأمان
					</p>
				</div>

				<a href="/wallet" class="btn btn-primary" style="padding:0.6rem 1.25rem; font-weight:800;">
					@components.IconWallet("icon-xs")
					<span>فتح المحفظة المالية</span>
				</a>
			</div>

			<!-- Unified Tabs Navigation Bar (No Scrollbar) -->
			<div class="tab-list">
				<button type="button" class="tab-btn active" data-tab-target="profile">
					@components.IconUser("icon-xs")
					<span>الملف الشخصي</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="wallet">
					@components.IconWallet("icon-xs")
					<span>المحفظة والرصيد</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="payments">
					@components.IconShield("icon-xs")
					<span>طرق الدفع</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="addresses">
					@components.IconTruck("icon-xs")
					<span>العناوين والفروع</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="organization">
					@components.IconBuilding("icon-xs")
					<span>المنشأة والتراخيص</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="security">
					@components.IconSettings("icon-xs")
					<span>الأمان والجلسات</span>
				</button>

				<button type="button" class="tab-btn" data-tab-target="preferences">
					@components.IconBell("icon-xs")
					<span>الإشعارات والتفضيلات</span>
				</button>
			</div>

			<!-- Tab 1: Profile -->
			<div id="tab-profile" class="tab-pane active card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					البيانات الشخصية والصورة الرمزية
				</h3>

				<form action="/settings/profile" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.5rem;">
					
					<!-- Avatar Picker Section -->
					<div style="display:flex; align-items:center; gap:1.5rem; padding:1.25rem; background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-xl);">
						<div style="width:72px; height:72px; border-radius:var(--radius-full); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0; border:2px solid var(--primary-300); overflow:hidden;">
							if data.User.AvatarURL != "" {
								<img src={ data.User.AvatarURL } alt="Avatar" style="width:100%; height:100%; object-fit:cover;" />
							} else {
								@components.IconUser("icon-lg")
							}
						</div>
						<div style="flex:1;">
							<label class="form-label" for="user-avatar" style="margin-bottom:0.25rem;">رابط الصورة الشخصية / الصورة الرمزية</label>
							<input type="text" id="user-avatar" name="avatar_url" class="form-input" value={ data.User.AvatarURL } placeholder="https://example.com/avatar.jpg" />
							<span style="font-size:0.75rem; color:var(--neutral-500); display:block; margin-top:0.25rem;">يمكنك إدخال رابط مباشر لصورتك أو شعار الصيدلية</span>
						</div>
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-name">الاسم بالكامل</label>
						<input type="text" id="user-name" name="name" class="form-input" value={ data.User.Name.Get("ar") } placeholder="د. أحمد محمود" required />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-email">البريد الإلكتروني</label>
						<input type="email" id="user-email" name="email" class="form-input tabular-nums" value={ data.User.Email } placeholder="pharmacy@dawa24.eg" required />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-phone">رقم الهاتف / الواتساب</label>
						<input type="tel" id="user-phone" name="phone" class="form-input tabular-nums" value={ data.User.Phone } placeholder="01012345678" />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-role">نوع الحساب والصلاحية</label>
						<input type="text" id="user-role" class="form-input" value={ data.User.Role } disabled style="background:var(--neutral-50); color:var(--neutral-600);" />
					</div>

					<div style="margin-top:0.75rem;">
						<button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem; font-weight:800;">
							@components.IconCheck("icon-xs")
							<span>حفظ التعديلات وتحديث الملف</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Tab 2: Wallet Snapshot -->
			<div id="tab-wallet" class="tab-pane card" style="padding:2.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
							المحفظة الإلكترونية والرصيد
						</h3>
						<p style="color:var(--neutral-500); font-size:0.875rem; margin-top:0.25rem;">الرصيد المتاح للطلبيات وسجل المعاملات</p>
					</div>

					<div style="display:flex; gap:0.75rem;">
						<a href="/wallet" class="btn btn-primary btn-sm" style="font-weight:800;">
							@components.IconPlus("icon-xs")
							<span>إيداع رصيد جديد</span>
						</a>
						<a href="/wallet" class="btn btn-secondary btn-sm" style="font-weight:800;">
							@components.IconArrowLeft("icon-xs")
							<span>طلب سحب</span>
						</a>
					</div>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem; margin-bottom:2rem;">
					<div style="padding:1.5rem; background:var(--primary-50); border:1px solid var(--primary-200); border-radius:var(--radius-xl);">
						<div style="font-size:0.85rem; color:var(--primary-800); font-weight:700;">الرصيد المتاح</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--primary-900); margin-top:0.5rem;" class="tabular-nums">5,420.00 <span style="font-size:1rem; font-weight:700;">ج.م</span></div>
					</div>

					<div style="padding:1.5rem; background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-xl);">
						<div style="font-size:0.85rem; color:var(--neutral-600); font-weight:700;">الرصيد المعلق (أوامر جارية)</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--neutral-800); margin-top:0.5rem;" class="tabular-nums">1,250.00 <span style="font-size:1rem; font-weight:700;">ج.م</span></div>
					</div>

					<div style="padding:1.5rem; background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-xl);">
						<div style="font-size:0.85rem; color:var(--neutral-600); font-weight:700;">إجمالي الإيداعات</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--neutral-800); margin-top:0.5rem;" class="tabular-nums">48,900.00 <span style="font-size:1rem; font-weight:700;">ج.م</span></div>
					</div>
				</div>

				<div style="text-align:start;">
					<a href="/wallet" class="btn btn-secondary" style="font-weight:700;">
						<span>عرض كشف الحساب الكامل والمعاملات</span>
						@components.IconArrowLeft("icon-xs")
					</a>
				</div>
			</div>

			<!-- Tab 3: Payment Methods -->
			<div id="tab-payments" class="tab-pane card" style="padding:2.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
							طرق الدفع والحسابات البنكية المحفوظة
						</h3>
						<p style="color:var(--neutral-500); font-size:0.85rem; margin-top:0.25rem;">الحسابات المعتمدة لعمليات الدفع والتسوية والسحب</p>
					</div>

					<button type="button" class="btn btn-primary btn-sm" data-modal-open="add-payment-method-modal" style="font-weight:800;">
						@components.IconPlus("icon-xs")
						<span>إضافة وسيلة دفع جديدة</span>
					</button>
				</div>

				<div style="display:grid; grid-template-columns:1fr; gap:1rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1.5px solid var(--primary-200); background:var(--primary-50); border-radius:var(--radius-xl);">
						<div style="display:flex; align-items:center; gap:1rem;">
							<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:#ffffff; color:var(--primary-700); display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow-xs);">
								@components.IconBuilding("icon-sm")
							</div>
							<div>
								<div style="font-weight:800; color:var(--neutral-900); display:flex; align-items:center; gap:0.5rem;">
									<span>البنك الأهلي المصري (NBE)</span>
									<span class="badge badge-emerald" style="font-size:0.75rem;">الحساب الافتراضي</span>
								</div>
								<div style="font-size:0.85rem; color:var(--neutral-600); margin-top:0.25rem;" class="tabular-nums">
									IBAN: EG380003000012345678901234567 • باسم: صيدلية الأمل الحديثة
								</div>
							</div>
						</div>
						<div>
							<span class="badge badge-sky">معتمد</span>
						</div>
					</div>

					<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1px solid var(--neutral-200); background:#ffffff; border-radius:var(--radius-xl);">
						<div style="display:flex; align-items:center; gap:1rem;">
							<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--neutral-100); color:var(--neutral-700); display:flex; align-items:center; justify-content:center;">
								@components.IconWallet("icon-sm")
							</div>
							<div>
								<div style="font-weight:800; color:var(--neutral-900);">
									<span>InstaPay (إنستاباي)</span>
								</div>
								<div style="font-size:0.85rem; color:var(--neutral-600); margin-top:0.25rem;" class="tabular-nums">
									معرف الدفع IPA: elamal.pharmacy@instapay
								</div>
							</div>
						</div>
						<div>
							<span class="badge badge-sky">معتمد</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Tab 4: Addresses -->
			<div id="tab-addresses" class="tab-pane card" style="padding:2.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
							عناوين الفروع ومواقع الاستلام
						</h3>
						<p style="color:var(--neutral-500); font-size:0.85rem; margin-top:0.25rem;">العناوين المسجلة لتسليم شحنات الأدوية والمستلزمات</p>
					</div>

					<button type="button" class="btn btn-primary btn-sm" data-modal-open="add-address-modal" style="font-weight:800;">
						@components.IconPlus("icon-xs")
						<span>إضافة فرع / عنوان جديد</span>
					</button>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem;">
					for _, addr := range data.Addresses {
						<div style="padding:1.5rem; border:1px solid var(--neutral-200); border-radius:var(--radius-xl); background:#ffffff; box-shadow:var(--shadow-xs);">
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
								<div style="font-weight:800; color:var(--neutral-900); font-size:1.05rem;">{ addr.Title }</div>
								if addr.IsDefault {
									<span class="badge badge-emerald" style="font-size:0.75rem;">الفرع الرئيسي</span>
								}
							</div>
							<div style="color:var(--neutral-600); font-size:0.875rem; line-height:1.6; margin-bottom:0.75rem;">
								{ addr.Address }
							</div>
							<div style="font-size:0.85rem; color:var(--neutral-500); display:flex; align-items:center; gap:0.5rem;" class="tabular-nums">
								@components.IconPhone("icon-xs")
								<span>{ addr.Phone } ({ addr.Recipient })</span>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- Tab 5: Organization & Licenses -->
			<div id="tab-organization" class="tab-pane card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					بيانات المنشأة والتراخيص الرسمية
				</h3>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem; margin-bottom:2rem;">
					<div style="padding:1.25rem; background:var(--neutral-50); border-radius:var(--radius-lg); border:1px solid var(--neutral-200);">
						<div style="font-size:0.8rem; color:var(--neutral-500); font-weight:700;">الاسم القانوني للمنشأة</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin-top:0.25rem;">شركة ومجموعة صيدليات الأمل ش.م.م</div>
					</div>

					<div style="padding:1.25rem; background:var(--neutral-50); border-radius:var(--radius-lg); border:1px solid var(--neutral-200);">
						<div style="font-size:0.8rem; color:var(--neutral-500); font-weight:700;">رقم السجل التجاري</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin-top:0.25rem;" class="tabular-nums">CR-9481920</div>
					</div>

					<div style="padding:1.25rem; background:var(--neutral-50); border-radius:var(--radius-lg); border:1px solid var(--neutral-200);">
						<div style="font-size:0.8rem; color:var(--neutral-500); font-weight:700;">رقم البطاقة الضريبية (ETA)</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--neutral-900); margin-top:0.25rem;" class="tabular-nums">984-210-941</div>
					</div>

					<div style="padding:1.25rem; background:var(--neutral-50); border-radius:var(--radius-lg); border:1px solid var(--neutral-200);">
						<div style="font-size:0.8rem; color:var(--neutral-500); font-weight:700;">رقم ترخيص المؤسسة الصيدلية</div>
						<div style="font-size:1.05rem; font-weight:800; color:var(--primary-700); margin-top:0.25rem;" class="tabular-nums">EDA-LIC-2024-8842</div>
					</div>
				</div>

				<div style="padding:1rem 1.25rem; background:var(--success-bg); border:1px solid var(--success-border); border-radius:var(--radius-lg); display:flex; align-items:center; gap:0.75rem;">
					<div style="color:var(--success);">@components.IconCheckCircle("icon-sm")</div>
					<div style="color:var(--success); font-weight:700; font-size:0.9rem;">
						حساب المؤسسة موثق ومعتمد رسمياً للتوريد والشراء المباشر عبر منظومة دواء 24.
					</div>
				</div>
			</div>

			<!-- Tab 6: Security & Sessions -->
			<div id="tab-security" class="tab-pane card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					الأمان وكلمة المرور والجلسات النشطة
				</h3>

				<div style="max-width:680px; margin-bottom:2.5rem;">
					<h4 style="font-size:1.05rem; font-weight:800; color:var(--neutral-800); margin-bottom:1rem;">تحديث كلمة المرور</h4>
					<form action="/settings/password" method="POST" style="display:flex; flex-direction:column; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label">كلمة المرور الحالية</label>
							<input type="password" name="current_password" required class="form-input" placeholder="••••••••" />
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">كلمة المرور الجديدة</label>
								<input type="password" name="new_password" required minlength="8" class="form-input" placeholder="••••••••" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">تأكيد كلمة المرور الجديدة</label>
								<input type="password" name="confirm_password" required minlength="8" class="form-input" placeholder="••••••••" />
							</div>
						</div>

						<div style="margin-top:0.5rem;">
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>تحديث كلمة المرور</span>
							</button>
						</div>
					</form>
				</div>

				<div style="border-top:1px solid var(--neutral-100); padding-top:1.5rem;">
					<h4 style="font-size:1.05rem; font-weight:800; color:var(--neutral-800); margin-bottom:1rem;">
						الأجهزة والجلسات المتصلة حالياً
					</h4>
					<div style="display:flex; flex-direction:column; gap:0.75rem;">
						for _, sess := range data.Sessions {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 1.25rem; border:1px solid var(--neutral-200); border-radius:var(--radius-lg);">
								<div style="display:flex; align-items:center; gap:0.75rem;">
									<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--neutral-100); color:var(--neutral-600); display:flex; align-items:center; justify-content:center;">
										@components.IconSettings("icon-xs")
									</div>
									<div>
										<div style="font-weight:700; font-size:0.9rem; color:var(--neutral-900);">{ sess.UserAgent }</div>
										<div style="font-size:0.8rem; color:var(--neutral-500);" class="tabular-nums">
											IP: { sess.IP } • متصل منذ { sess.CreatedAt.Format("2006-01-02 15:04") }
										</div>
									</div>
								</div>
								<form action="/settings/sessions/revoke" method="POST" style="margin:0;">
									<input type="hidden" name="token" value={ sess.Token } />
									<button type="submit" class="btn btn-danger btn-sm">إنهاء الجلسة</button>
								</form>
							</div>
						}
					</div>
				</div>
			</div>

			<!-- Tab 7: Preferences -->
			<div id="tab-preferences" class="tab-pane card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					تفضيلات الإشعارات والتنبيهات
				</h3>

				<form action="/settings/preferences" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.25rem;">
					<div style="display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--neutral-200); border-radius:var(--radius-lg);">
						<div>
							<div style="font-weight:800; color:var(--neutral-900);">إشعارات الواتساب (WhatsApp Alerts)</div>
							<div style="font-size:0.85rem; color:var(--neutral-500);">استلام تحديثات تسليم الشحنات وتغير حالة أوامر الشراء فورياً</div>
						</div>
						<input type="checkbox" name="notif_whatsapp" checked style="width:20px; height:20px; accent-color:var(--primary-600);" />
					</div>

					<div style="display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--neutral-200); border-radius:var(--radius-lg);">
						<div>
							<div style="font-weight:800; color:var(--neutral-900);">رسائل البريد الإلكتروني للفواتير الضريبية</div>
							<div style="font-size:0.85rem; color:var(--neutral-500);">إرسال نسخة PDF معتمدة من الفاتورة الضريبية فور اكتمال الطلب</div>
						</div>
						<input type="checkbox" name="notif_invoices" checked style="width:20px; height:20px; accent-color:var(--primary-600);" />
					</div>

					<div style="display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--neutral-200); border-radius:var(--radius-lg);">
						<div>
							<div style="font-weight:800; color:var(--neutral-900);">تنبيهات انخفاض المخزون والخصومات الحصرية</div>
							<div style="font-size:0.85rem; color:var(--neutral-500);">إشعارات عند توفر أصناف دوائية ناقصة أو وجود عروض بونص خاصة</div>
						</div>
						<input type="checkbox" name="notif_promos" checked style="width:20px; height:20px; accent-color:var(--primary-600);" />
					</div>

					<div style="margin-top:0.75rem;">
						<button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem; font-weight:800;">
							@components.IconCheck("icon-xs")
							<span>حفظ التفضيلات</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Modal 1: Add Payment Method Modal -->
			<div id="add-payment-method-modal" class="modal-overlay hidden">
				<div class="modal-card" style="max-width:540px; width:100%; padding:2rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--neutral-100); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							@components.IconShield("icon-sm")
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
								إضافة وسيلة دفع جديدة
							</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon" style="width:32px; height:32px;" data-modal-close>
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form action="/settings/payment-methods" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label">نوع وسيلة الدفع</label>
							<select name="type" class="form-select" onchange="document.querySelectorAll('.pay-extra').forEach(el => el.style.display = 'none'); document.getElementById('pay-fields-' + this.value).style.display = 'block';">
								<option value="bank">حساب بنكي (Bank Account)</option>
								<option value="instapay">إنستاباي / محفظة هاتف (InstaPay / E-Wallet)</option>
								<option value="card">بطاقة دفع إلكتروني (Debit / Credit Card)</option>
							</select>
						</div>

						<div id="pay-fields-bank" class="pay-extra" style="display:block;">
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">اسم البنك</label>
									<input type="text" name="bank_name" class="form-input" placeholder="البنك التجاري الدولي CIB" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">اسم صاحب الحساب</label>
									<input type="text" name="account_holder" class="form-input" placeholder="مطابق للسجل التجاري" />
								</div>
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">رقم الآيبان (IBAN)</label>
								<input type="text" name="iban" class="form-input tabular-nums" placeholder="EG000000000000000000000000000" />
							</div>
						</div>

						<div id="pay-fields-instapay" class="pay-extra" style="display:none;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">عنوان الدفع اللحظي IPA أو رقم الهاتف</label>
								<input type="text" name="instapay_handle" class="form-input tabular-nums" placeholder="username@instapay" />
							</div>
						</div>

						<div id="pay-fields-card" class="pay-extra" style="display:none;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">رقم البطاقة</label>
								<input type="text" name="card_number" class="form-input tabular-nums" placeholder="•••• •••• •••• ••••" />
							</div>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" data-modal-close>إلغاء</button>
							<button type="submit" class="btn btn-primary" style="padding-inline:1.75rem; font-weight:800;">
								@components.IconPlus("icon-xs")
								<span>حفظ وسيلة الدفع</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Modal 2: Add Address Modal -->
			<div id="add-address-modal" class="modal-overlay hidden">
				<div class="modal-card" style="max-width:560px; width:100%; padding:2rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--neutral-100); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							@components.IconTruck("icon-sm")
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
								إضافة فرع أو عنوان تسليم جديد
							</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon" style="width:32px; height:32px;" data-modal-close>
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form action="/settings/addresses" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">اسم الفرع / العنوان *</label>
								<input type="text" name="title" class="form-input" placeholder="فرع مدينة نصر" required />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">اسم المستلم المسؤول *</label>
								<input type="text" name="recipient" class="form-input" placeholder="د. أحمد محمود" required />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">رقم هاتف الفرع *</label>
								<input type="tel" name="phone" class="form-input tabular-nums" placeholder="01012345678" required />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">العنوان بالتفصيل *</label>
								<input type="text" name="address" class="form-input" placeholder="شارع عباس العقاد، عمارة 15" required />
							</div>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" data-modal-close>إلغاء</button>
							<button type="submit" class="btn btn-primary" style="padding-inline:1.75rem; font-weight:800;">
								@components.IconPlus("icon-xs")
								<span>إضافة العنوان</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}
