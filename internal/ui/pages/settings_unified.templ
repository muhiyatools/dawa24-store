package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type UnifiedSettingsData struct {
	User        *identity.User
	Addresses   []*identity.UserAddress
	Sessions    []*identity.Session
	ActiveTab   string
}

templ UnifiedSettingsPage(data UnifiedSettingsData, lang, dir string) {
	@layouts.CustomerShell("إعدادات الحساب | Account Settings", lang, dir) {
		<div
			style="max-width:1160px; margin:1rem auto 4rem auto;"
			x-data="{
				tab: window.location.hash ? window.location.hash.substring(1) : 'profile',
				payType: 'bank_account',
				setTab(t) {
					this.tab = t;
					window.location.hash = t;
				}
			}"
		>
			<!-- Page Header -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
						<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
							@components.IconSettings("icon-sm")
						</div>
						<h1 style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin:0;">
							إعدادات الحساب والمنشأة
						</h1>
					</div>
					<p style="color:var(--neutral-500); font-size:0.925rem; margin:0;">
						إدارة البيانات الشخصية، المحفظة، طرق الدفع، التراخيص، والأمان
					</p>
				</div>

				<a href="/wallet" class="btn btn-primary" style="padding:0.6rem 1.25rem;">
					@components.IconWallet("icon-xs")
					<span>فتح المحفظة المالية</span>
				</a>
			</div>

			<!-- Unified Tabs Navigation Bar -->
			<div class="tab-list">
				<button type="button" class="tab-btn" :class="{ 'active': tab === 'profile' }" @click="setTab('profile')">
					@components.IconUser("icon-xs")
					<span>الملف الشخصي</span>
				</button>

				<button type="button" class="tab-btn" :class="{ 'active': tab === 'wallet' }" @click="setTab('wallet')">
					@components.IconWallet("icon-xs")
					<span>المحفظة والرصيد</span>
				</button>

				<button type="button" class="tab-btn" :class="{ 'active': tab === 'payments' }" @click="setTab('payments')">
					@components.IconShield("icon-xs")
					<span>طرق الدفع</span>
				</button>

				<button type="button" class="tab-btn" :class="{ 'active': tab === 'addresses' }" @click="setTab('addresses')">
					@components.IconTruck("icon-xs")
					<span>العناوين والفروع</span>
				</button>

				<button type="button" class="tab-btn" :class="{ 'active': tab === 'organization' }" @click="setTab('organization')">
					@components.IconBuilding("icon-xs")
					<span>المنشأة والتراخيص</span>
				</button>

				<button type="button" class="tab-btn" :class="{ 'active': tab === 'security' }" @click="setTab('security')">
					@components.IconSettings("icon-xs")
					<span>الأمان والجلسات</span>
				</button>

				<button type="button" class="tab-btn" :class="{ 'active': tab === 'preferences' }" @click="setTab('preferences')">
					@components.IconBell("icon-xs")
					<span>الإشعارات والتفضيلات</span>
				</button>
			</div>

			<!-- Tab 1: Profile -->
			<div x-show="tab === 'profile'" x-cloak class="card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					البيانات الشخصية والحساب
				</h3>

				<form action="/settings/profile" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.25rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-name">الاسم بالكامل</label>
						<input type="text" id="user-name" name="name" class="form-input" value={ data.User.Name.Get("ar") } placeholder="د. أحمد محمود" required />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-email">البريد الإلكتروني</label>
						<input type="email" id="user-email" name="email" class="form-input tabular-nums" value={ data.User.Email } placeholder="pharmacy@dawa24.eg" required />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-phone">رقم الهاتف / الواتساب</label>
						<input type="tel" id="user-phone" name="phone" class="form-input tabular-nums" value={ data.User.Phone } placeholder="01012345678" />
					</div>

					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="user-role">نوع الحساب والصلاحية</label>
						<input type="text" id="user-role" class="form-input" value={ data.User.Role } disabled style="background:var(--neutral-50); color:var(--neutral-600);" />
					</div>

					<div style="margin-top:0.75rem;">
						<button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem;">
							@components.IconCheck("icon-xs")
							<span>حفظ التعديلات</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Tab 2: Wallet Snapshot -->
			<div x-show="tab === 'wallet'" x-cloak class="card" style="padding:2.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
							رصيد المحفظة والمعاملات
						</h3>
						<p style="font-size:0.875rem; color:var(--neutral-500); margin-top:0.2rem;">
							نظرة سريعة على رصيد حسابك المالي
						</p>
					</div>
					<a href="/wallet" class="btn btn-primary">
						<span>فتح صفحة المحفظة الكاملة</span>
						@components.IconArrowLeft("icon-xs")
					</a>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem; margin-bottom:2rem;">
					<div style="background:var(--primary-50); border:1px solid var(--primary-200); border-radius:var(--radius-lg); padding:1.5rem;">
						<div style="font-size:0.85rem; font-weight:700; color:var(--primary-800);">الرصيد المتاح</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--primary-700); margin-top:0.25rem;" class="tabular-nums">5,420.00 ج.م</div>
					</div>

					<div style="background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-lg); padding:1.5rem;">
						<div style="font-size:0.85rem; font-weight:700; color:var(--neutral-600);">الرصيد المعلق</div>
						<div style="font-size:1.85rem; font-weight:900; color:var(--neutral-800); margin-top:0.25rem;" class="tabular-nums">0.00 ج.م</div>
					</div>
				</div>

				<div style="display:flex; gap:1rem;">
					<a href="/wallet" class="btn btn-secondary">
						@components.IconPlus("icon-xs")
						<span>شحن الرصيد (Deposit)</span>
					</a>
					<a href="/wallet" class="btn btn-secondary">
						@components.IconArrowLeft("icon-xs")
						<span>طلب سحب رصيد (Withdraw)</span>
					</a>
				</div>
			</div>

			<!-- Tab 3: Payment Methods -->
			<div x-show="tab === 'payments'" x-cloak class="card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.5rem;">
					طرق الدفع المحفوظة (Payment Methods)
				</h3>
				<p style="font-size:0.875rem; color:var(--neutral-500); margin-bottom:2rem;">
					إدارة حساباتك البنكية، محافظ إنستاباي، والبطاقات المستخدمة في السحب والإيداع
				</p>

				<!-- Saved Methods List -->
				<div style="display:flex; flex-direction:column; gap:1rem; margin-bottom:2.5rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1px solid var(--border-card); border-radius:var(--radius-lg); background:#fff; box-shadow:var(--shadow-xs);">
						<div style="display:flex; align-items:center; gap:1rem;">
							<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconBuilding("icon-sm")
							</div>
							<div>
								<div style="font-weight:800; color:var(--neutral-900); font-size:1rem;">
									البنك الأهلي المصري (حساب جاري)
								</div>
								<div style="font-size:0.825rem; color:var(--neutral-500); display:flex; gap:1rem; margin-top:0.2rem;">
									<span>رقم الحساب: <strong class="tabular-nums" style="color:var(--neutral-800);">•••• 4920</strong></span>
									<span class="badge badge-emerald">معتمد للسحب والإيداع</span>
									<span class="badge badge-sky">افتراضي</span>
								</div>
							</div>
						</div>
						<button type="button" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">
							@components.IconTrash("icon-xs")
							<span>حذف</span>
						</button>
					</div>

					<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1px solid var(--border-card); border-radius:var(--radius-lg); background:#fff; box-shadow:var(--shadow-xs);">
						<div style="display:flex; align-items:center; gap:1rem;">
							<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconPhone("icon-sm")
							</div>
							<div>
								<div style="font-weight:800; color:var(--neutral-900); font-size:1rem;">
									محفظة إنستاباي (InstaPay / فودافون كاش)
								</div>
								<div style="font-size:0.825rem; color:var(--neutral-500); display:flex; gap:1rem; margin-top:0.2rem;">
									<span>المعرف / الهاتف: <strong class="tabular-nums" style="color:var(--neutral-800);">01065397000</strong></span>
									<span class="badge badge-emerald">معتمد للتحويل الفوري</span>
								</div>
							</div>
						</div>
						<button type="button" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">
							@components.IconTrash("icon-xs")
							<span>حذف</span>
						</button>
					</div>
				</div>

				<!-- Dynamic Add Payment Method Form -->
				<div style="border-top:2px solid var(--neutral-100); padding-top:2rem;">
					<h4 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.25rem;">
						إضافة طريقة دفع جديدة
					</h4>

					<form action="/settings/payment-methods" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.25rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="pm-type">نوع وسيلة الدفع *</label>
							<select id="pm-type" name="type" class="form-select" x-model="payType">
								<option value="bank_account">حساب بنكي (Bank Account)</option>
								<option value="instapay_wallet">إنستاباي ومحافظ إلكترونية (InstaPay / E-Wallet)</option>
								<option value="credit_card">بطاقة بنكية (Credit / Debit Card)</option>
								<option value="cheque">شيك بنكي معتمد (Company Cheque)</option>
							</select>
						</div>

						<!-- Bank Account Fields -->
						<div x-show="payType === 'bank_account'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-bank-name">اسم البنك *</label>
								<input type="text" id="pm-bank-name" name="bank_name" placeholder="مثال: البنك الأهلي المصري، CIB، بنك مصر" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-acc-holder">اسم صاحب الحساب (مطابق للسجل التجاري) *</label>
								<input type="text" id="pm-acc-holder" name="account_holder" placeholder="اسم الصيدلية أو الشركة" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-acc-num">رقم الحساب البنكي *</label>
								<input type="text" id="pm-acc-num" name="account_number" placeholder="مثال: 100094820194" class="form-input tabular-nums" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-iban">رقم الآيبان الدولي (IBAN) *</label>
								<input type="text" id="pm-iban" name="iban" placeholder="EG3800..." class="form-input tabular-nums" />
							</div>
						</div>

						<!-- InstaPay / Wallet Fields -->
						<div x-show="payType === 'instapay_wallet'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-wallet-provider">مزود الخدمة *</label>
								<select id="pm-wallet-provider" name="wallet_provider" class="form-select">
									<option value="instapay">InstaPay (عنوان الدفع اللحظي IPA)</option>
									<option value="vodafone">فودافون كاش (Vodafone Cash)</option>
									<option value="orange">أورنج كاش (Orange Cash)</option>
									<option value="etisalat">اتصالات كاش (Etisalat Cash)</option>
									<option value="we">وي باي (WE Pay)</option>
								</select>
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-wallet-handle">معرف الدفع (IPA) أو رقم الهاتف المسجل *</label>
								<input type="text" id="pm-wallet-handle" name="wallet_handle" placeholder="01012345678 أو pharmacy@instapay" class="form-input tabular-nums" />
							</div>
						</div>

						<!-- Credit / Debit Card Fields -->
						<div x-show="payType === 'credit_card'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-card-name">الاسم المدون على البطاقة *</label>
								<input type="text" id="pm-card-name" name="card_name" placeholder="MOHAMED AHMED" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-card-num">رقم البطاقة (16 رقم) *</label>
								<input type="text" id="pm-card-num" name="card_number" placeholder="4234 •••• •••• 9812" class="form-input tabular-nums" />
							</div>
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label" for="pm-card-exp">تاريخ الانتهاء (MM/YY) *</label>
									<input type="text" id="pm-card-exp" name="card_expiry" placeholder="12/28" class="form-input tabular-nums" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label" for="pm-card-cvv">رمز الأمان (CVV) *</label>
									<input type="password" id="pm-card-cvv" name="card_cvv" placeholder="•••" maxlength="4" class="form-input tabular-nums" />
								</div>
							</div>
						</div>

						<!-- Cheque Fields -->
						<div x-show="payType === 'cheque'" style="display:flex; flex-direction:column; gap:1.15rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-cheque-branch">فرع البنك المصدر للشيكات *</label>
								<input type="text" id="pm-cheque-branch" name="cheque_branch" placeholder="مثال: البنك الأهلي - فرع المهندسين" class="form-input" />
							</div>
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" for="pm-cheque-cr">رقم السجل التجاري للشيكات *</label>
								<input type="text" id="pm-cheque-cr" name="cheque_cr" placeholder="رقم السجل التجاري" class="form-input tabular-nums" />
							</div>
						</div>

						<div style="margin-top:0.75rem;">
							<button type="submit" class="btn btn-primary" style="padding:0.75rem 2rem;">
								@components.IconPlus("icon-xs")
								<span>حفظ وسيلة الدفع</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Tab 4: Addresses -->
			<div x-show="tab === 'addresses'" x-cloak class="card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					عناوين التوصيل وفروع الصيدلية
				</h3>

				<div style="display:flex; flex-direction:column; gap:1.25rem; margin-bottom:2rem;">
					for _, addr := range data.Addresses {
						<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; border:1px solid var(--border-card); border-radius:var(--radius-lg); background:#fff;">
							<div>
								<div style="font-weight:800; color:var(--neutral-900); font-size:1rem; margin-bottom:0.25rem;">
									{ addr.Title }
									if addr.IsDefault {
										<span class="badge badge-emerald" style="margin-inline-start:0.5rem;">افتراضي</span>
									}
								</div>
								<div style="font-size:0.875rem; color:var(--neutral-600);">
									{ addr.Recipient } · { addr.Phone }
								</div>
								<div style="font-size:0.8rem; color:var(--neutral-500);">
									{ addr.Address }
								</div>
							</div>
							<form action={ templ.SafeURL(fmt.Sprintf("/settings/addresses/%d/delete", addr.ID)) } method="POST" style="margin:0;">
								<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">
									@components.IconTrash("icon-xs")
									<span>حذف</span>
								</button>
							</form>
						</div>
					}
				</div>

				<div style="border-top:2px solid var(--neutral-100); padding-top:1.75rem;">
					<h4 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:1rem;">إضافة عنوان جديد</h4>
					<form action="/settings/addresses" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="addr-label">اسم الفرع / العنوان</label>
							<input type="text" id="addr-label" name="label" placeholder="مثال: الفرع الرئيسي - الدقي" class="form-input" required />
						</div>
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="addr-street">العنوان بالتفصيل</label>
							<input type="text" id="addr-street" name="street" placeholder="شارع مصدق، مبنى 14" class="form-input" required />
						</div>
						<button type="submit" class="btn btn-primary" style="align-self:flex-start;">
							@components.IconPlus("icon-xs")
							<span>إضافة العنوان</span>
						</button>
					</form>
				</div>
			</div>

			<!-- Tab 5: Organization & Licenses -->
			<div x-show="tab === 'organization'" x-cloak class="card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.5rem;">
					بيانات المنشأة والتراخيص الرسمية
				</h3>
				<p style="font-size:0.875rem; color:var(--neutral-500); margin-bottom:1.75rem;">
					توثيق التراخيص معتمد ومطابق لاشتراطات هيئة الدواء المصرية
				</p>

				<form action="/settings/organization" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.25rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="org-name">اسم الصيدلية / المؤسسة الطبية</label>
						<input type="text" id="org-name" name="name" class="form-input" value="صيدلية النصر التخصصية" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="org-cr">رقم السجل التجاري</label>
						<input type="text" id="org-cr" name="cr_number" class="form-input tabular-nums" value="CR-9481029" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="org-tax">رقم التسجيل الضريبي (الفاتورة الإلكترونية)</label>
						<input type="text" id="org-tax" name="tax_id" class="form-input tabular-nums" value="984-210-941" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="org-lic">رقم ترخيص المؤسسة الصيدلية</label>
						<input type="text" id="org-lic" name="license_number" class="form-input tabular-nums" value="EDA-LIC-2024-884" />
					</div>

					<div style="background:var(--success-bg); border:1px solid var(--success-border); border-radius:var(--radius-md); padding:1rem; display:flex; align-items:center; gap:0.75rem; color:#065f46; font-size:0.875rem;">
						@components.IconCheckCircle("icon-sm")
						<span>الحساب موثق بالكامل ومعتمد من إدارة الرقابة الصيدلية.</span>
					</div>

					<button type="submit" class="btn btn-primary" style="align-self:flex-start; margin-top:0.5rem;">
						@components.IconCheck("icon-xs")
						<span>تحديث بيانات المنشأة</span>
					</button>
				</form>
			</div>

			<!-- Tab 6: Security & Sessions -->
			<div x-show="tab === 'security'" x-cloak class="card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					الأمان وكلمة المرور وجلسات الدخول
				</h3>

				<form action="/settings/profile" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.25rem; margin-bottom:2.5rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="cur-pass">كلمة المرور الحالية</label>
						<input type="password" id="cur-pass" name="current_password" class="form-input" placeholder="••••••••" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="new-pass">كلمة المرور الجديدة</label>
						<input type="password" id="new-pass" name="new_password" class="form-input" placeholder="••••••••" />
					</div>
					<button type="submit" class="btn btn-primary" style="align-self:flex-start;">
						@components.IconShield("icon-xs")
						<span>تغيير كلمة المرور</span>
					</button>
				</form>

				<div style="border-top:2px solid var(--neutral-100); padding-top:2rem;">
					<h4 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:1rem;">الجلسات النشطة</h4>
					<div style="display:flex; flex-direction:column; gap:0.75rem;">
						for _, sess := range data.Sessions {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:1rem; border:1px solid var(--border-card); border-radius:var(--radius-md); background:#fff;">
								<div>
									<div style="font-weight:700; color:var(--neutral-900); font-size:0.9rem;">
										{ sess.UserAgent }
									</div>
									<div style="font-size:0.775rem; color:var(--neutral-500);" class="tabular-nums">
										IP: { sess.IP } | تاريخ الدخول: { sess.CreatedAt.Format("2006-01-02 15:04") }
									</div>
								</div>
								<form action="/settings/security/revoke" method="POST" style="margin:0;">
									<input type="hidden" name="token" value={ sess.Token } />
									<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">
										إنهاء الجلسة
									</button>
								</form>
							</div>
						}
					</div>
				</div>
			</div>

			<!-- Tab 7: Preferences -->
			<div x-show="tab === 'preferences'" x-cloak class="card" style="padding:2.25rem;">
				<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					تفضيلات الإشعارات والتنبيهات
				</h3>

				<form action="/settings/preferences" method="POST" style="max-width:680px; display:flex; flex-direction:column; gap:1.25rem;">
					<label style="display:flex; align-items:center; gap:0.75rem; cursor:pointer;">
						<input type="checkbox" name="notify_sms" checked style="width:18px; height:18px; accent-color:var(--primary-600);" />
						<span style="font-size:0.95rem; font-weight:700; color:var(--neutral-800);">إشعارات الرسائل النصية القصيرة (SMS) عند شحن الطلبيات</span>
					</label>

					<label style="display:flex; align-items:center; gap:0.75rem; cursor:pointer;">
						<input type="checkbox" name="notify_whatsapp" checked style="width:18px; height:18px; accent-color:var(--primary-600);" />
						<span style="font-size:0.95rem; font-weight:700; color:var(--neutral-800);">إشعارات الواتساب الفورية للفواتير وأرقام التتبع</span>
					</label>

					<label style="display:flex; align-items:center; gap:0.75rem; cursor:pointer;">
						<input type="checkbox" name="notify_email" checked style="width:18px; height:18px; accent-color:var(--primary-600);" />
						<span style="font-size:0.95rem; font-weight:700; color:var(--neutral-800);">التقارير المالية الأسبوعية وكشوف الحسابات عبر البريد</span>
					</label>

					<button type="submit" class="btn btn-primary" style="align-self:flex-start; margin-top:1rem;">
						@components.IconCheck("icon-xs")
						<span>حفظ التفضيلات</span>
					</button>
				</form>
			</div>
		</div>
	}
}
