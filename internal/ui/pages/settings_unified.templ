package pages

import (
	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type UnifiedSettingsData struct {
	User                   *identity.User
	Wallet                 *billing.Wallet
	Transactions           []*billing.WalletTransaction
	DepositRequests        []*billing.WalletDeposit
	PaymentMethods         []*billing.UserPaymentMethod
	PlatformPaymentMethods []*billing.PlatformPaymentMethod
	Sessions               []*identity.Session
	SessionPlans           []*identity.SessionPlan
	ActiveTab              string
}

templ UnifiedSettingsPage(data UnifiedSettingsData, lang, dir string) {
	@layouts.ShellFor("إعدادات الحساب والمنشأة", "settings", lang, dir, authctx.FromContext(ctx)) {

		<div
			class="w-full mb-16"
			x-data="{
				activeTab: (new URLSearchParams(window.location.search).get('tab') || window.location.hash.replace('#', '') || 'profile')
			}"
		>
			<!-- Page Header -->
			<div class="flex-between items-center flex-wrap gap-4 mb-8">
				<div>
					<div class="row-center-sm mb-2">
						<div class="b2b-icon-box-sm">
							@components.IconSettings("icon-sm")
						</div>
						<h2 class="text-2xl font-black text-primary m-0">
							إعدادات الحساب والمنشأة
						</h2>
					</div>
					<p class="text-sm text-muted m-0">
						إدارة البيانات الشخصية للصيدلي، التراخيص الرسمية للمنشأة، والتفضيلات
					</p>
				</div>

				<div class="row-center">
					<a
						href="/customer/wallet"
						class="btn btn-outline-brand font-bold gap-2"
					>
						@components.IconWallet("icon-xs")
						<span>المحفظة والرصيد</span>
					</a>
				</div>
			</div>

			<!-- Unified Tabs Navigation Bar -->
			<div class="tab-list">
				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'profile' }"
					@click="activeTab = 'profile'; history.replaceState(null, null, '#profile')"
					data-tab-target="profile"
				>
					@components.IconUser("icon-xs")
					<span>الملف الشخصي</span>
				</button>

				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'organization' }"
					@click="activeTab = 'organization'; history.replaceState(null, null, '#organization')"
					data-tab-target="organization"
				>
					@components.IconBuilding("icon-xs")
					<span>المنشأة والتراخيص</span>
				</button>

				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'preferences' }"
					@click="activeTab = 'preferences'; history.replaceState(null, null, '#preferences')"
					data-tab-target="preferences"
				>
					@components.IconBell("icon-xs")
					<span>الإشعارات والتفضيلات</span>
				</button>
			</div>

			<!-- Tab 1: Profile -->
			<div
				id="tab-profile"
				class="tab-pane card p-8"
				:class="{ 'active': activeTab === 'profile' }"
				x-show="activeTab === 'profile'"
			>
				<h3 class="text-lg font-extrabold text-primary mb-6">
					البيانات الشخصية والصورة الرمزية
				</h3>

				<form 
					action="/settings/profile" 
					method="POST" 
					enctype="multipart/form-data" 
					class="max-w-2xl d-flex flex-col gap-6 text-start" 
					x-data="{ avatarPreview: '', removeAvatar: false }"
				>
					<!-- Avatar Upload Section -->
					<div class="d-flex items-center gap-6 p-5 bg-surface-sunken border rounded-xl flex-wrap sm:flex-nowrap">
						<!-- Circular Avatar Preview -->
						<div class="avatar-box w-20 h-20 rounded-full bg-accent-subtle text-accent d-flex items-center justify-center flex-shrink-0 border-2 border-accent overflow-hidden shadow-sm">
							<template x-if="avatarPreview">
								<img :src="avatarPreview" alt="Avatar Preview" class="w-full h-full object-cover" />
							</template>
							<template x-if="!avatarPreview && !removeAvatar">
								if data.User != nil && data.User.AvatarURL != "" {
									<img src={ data.User.AvatarURL } alt="Avatar" class="w-full h-full object-cover" />
								} else {
									@components.IconUser("icon-lg")
								}
							</template>
							<template x-if="!avatarPreview && removeAvatar">
								@components.IconUser("icon-lg")
							</template>
						</div>

						<!-- Upload Controls -->
						<div class="flex-1">
							<label class="form-label font-extrabold text-sm mb-1.5">الصورة الشخصية / شعار الصيدلية</label>
							<div class="d-flex items-center gap-2 flex-wrap">
								<label class="btn btn-secondary btn-sm font-bold cursor-pointer m-0 gap-1.5">
									@components.IconUpload("icon-xs")
									<span>اختيار وتغيير الصورة</span>
									<input 
										type="file" 
										id="user-avatar-file" 
										name="avatar_file" 
										accept="image/png,image/jpeg,image/jpg,image/webp" 
										class="hidden" 
										@change="
											const file = $event.target.files[0];
											if (file) {
												removeAvatar = false;
												const reader = new FileReader();
												reader.onload = (e) => { avatarPreview = e.target.result };
												reader.readAsDataURL(file);
											}
										"
									/>
								</label>
								
								if data.User != nil && data.User.AvatarURL != "" {
									<button 
										type="button" 
										class="btn btn-ghost btn-sm font-bold text-danger m-0 gap-1" 
										x-show="!removeAvatar"
										@click="removeAvatar = true; avatarPreview = ''; const el = document.getElementById('user-avatar-file'); if(el) el.value = '';"
									>
										@components.IconTrash("icon-xs")
										<span>حذف الصورة</span>
									</button>
								}
							</div>
							<input type="hidden" name="remove_avatar" :value="removeAvatar ? '1' : '0'" />
							<span class="text-xs text-muted d-block mt-1.5">
								يدعم الصور بتنسيق JPG, PNG, WEBP حتى 50 ميجابايت كحد أقصى.
							</span>
						</div>
					</div>

					<div class="form-group mb-0">
						<label class="form-label" for="user-name">الاسم بالكامل</label>
						<input type="text" id="user-name" name="name" class="form-input" value={ userNameVal(data.User) } placeholder="د. أحمد محمود" required />
					</div>

					<div class="form-group mb-0">
						<label class="form-label" for="user-email">البريد الإلكتروني</label>
						<input type="email" id="user-email" name="email" class="form-input tabular-nums" value={ userEmailVal(data.User) } placeholder="pharmacy@dawa24.eg" required />
					</div>

					<div class="form-group mb-0">
						<label class="form-label" for="user-phone">رقم الهاتف / الواتساب</label>
						<input type="tel" id="user-phone" name="phone" class="form-input tabular-nums" value={ userPhoneVal(data.User) } placeholder="01012345678" />
					</div>

					<div class="form-group mb-0">
						<label class="form-label" for="user-role">نوع الحساب والصلاحية</label>
						<input type="text" id="user-role" class="form-input bg-surface-sunken text-muted" value={ userRoleVal(data.User) } disabled />
					</div>

					<div class="mt-3">
						<button type="submit" class="btn btn-primary font-black px-8 py-3">
							@components.IconCheck("icon-xs")
							<span>حفظ التعديلات وتحديث الملف</span>
						</button>
					</div>
				</form>

				<!-- Danger Zone: Account Deletion Request -->
				<div class="border-t border-danger/30 mt-10 pt-7">
					<div class="bg-danger/5 border border-danger/20 rounded-xl p-6 flex-between items-center flex-wrap gap-5">
						<div>
							<div class="d-flex items-center gap-2 text-danger font-extrabold text-base">
								@components.IconTrash("icon-xs")
								<span>طلب حذف الحساب وإنهاء النشاط</span>
							</div>
							<p class="text-xs text-secondary mt-1.5 leading-relaxed max-w-xl">
								يمكنك تقديم طلب رسمي لإلغاء الحساب وحذف البيانات. ستتم مراجعة الطلب من إدارة المنصة والتحقق من تسوية المستحقات المالية وأوامر التوريد قبل إتمام الحذف.
							</p>
						</div>
						<button
							type="button"
							class="btn btn-danger font-bold px-6 py-2.5"
							data-modal-open="delete-account-modal"
						>
							@components.IconTrash("icon-xs")
							<span>تقديم طلب حذف الحساب</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Tab 2: Organization & Licenses -->
			<div
				id="tab-organization"
				class="tab-pane card p-8"
				:class="{ 'active': activeTab === 'organization' }"
				x-show="activeTab === 'organization'"
			>
				<div class="flex-between items-center mb-6 flex-wrap gap-4">
					<div>
						<h3 class="text-xl font-black text-primary m-0">
							بيانات المنشأة والتراخيص الرسمية
						</h3>
						<p class="text-sm text-muted mt-1">
							السجلات التجارية وتراخيص هيئة الدواء المصرية (EDA)
						</p>
					</div>

					<a href="/customer/branches" class="btn btn-secondary btn-sm font-bold">
						@components.IconBuilding("icon-xs")
						<span>إدارة فروع ومواقع استلام الصيدلية</span>
					</a>
				</div>

				<div class="d-grid grid-auto-fit-lg gap-5 mb-8">
					<div class="p-5 bg-surface-sunken rounded-lg border">
						<div class="text-xs text-muted font-bold">الاسم القانوني للمنشأة</div>
						<div class="text-base font-black text-primary mt-1">صيدلية معتمدة - شبكة دواء 24</div>
					</div>

					<div class="p-5 bg-surface-sunken rounded-lg border">
						<div class="text-xs text-muted font-bold">رقم السجل التجاري</div>
						<div class="text-base font-black text-primary mt-1 tabular-nums">CR-9481920</div>
					</div>

					<div class="p-5 bg-surface-sunken rounded-lg border">
						<div class="text-xs text-muted font-bold">رقم البطاقة الضريبية (ETA)</div>
						<div class="text-base font-black text-primary mt-1 tabular-nums">984-210-941</div>
					</div>

					<div class="p-5 bg-surface-sunken rounded-lg border">
						<div class="text-xs text-muted font-bold">رقم ترخيص المؤسسة الصيدلية</div>
						<div class="text-base font-black text-accent mt-1 tabular-nums">EDA-LIC-2024-8842</div>
					</div>
				</div>

				<div class="p-4 bg-success/10 border border-success/30 rounded-lg d-flex items-center gap-3">
					<div class="text-success">@components.IconCheckCircle("icon-sm")</div>
					<div class="text-success font-bold text-sm">
						حساب المؤسسة موثق ومعتمد رسمياً للتوريد والشراء المباشر عبر منظومة دواء 24.
					</div>
				</div>
			</div>

			<!-- Tab 3: Preferences -->
			<div
				id="tab-preferences"
				class="tab-pane card p-8"
				:class="{ 'active': activeTab === 'preferences' }"
				x-show="activeTab === 'preferences'"
			>
				<h3 class="text-lg font-extrabold text-primary mb-6">
					تفضيلات الإشعارات والتنبيهات
				</h3>

				<form action="/settings/preferences" method="POST" class="max-w-2xl d-flex flex-col gap-5 text-start">
					<div class="flex-between items-center p-4 border rounded-lg bg-surface-sunken">
						<div>
							<div class="font-extrabold text-primary">إشعارات الواتساب (WhatsApp Alerts)</div>
							<div class="text-sm text-muted">استلام تحديثات تسليم الشحنات وتغير حالة أوامر الشراء فورياً</div>
						</div>
						<input type="checkbox" name="notif_whatsapp" checked class="form-checkbox" />
					</div>

					<div class="flex-between items-center p-4 border rounded-lg bg-surface-sunken">
						<div>
							<div class="font-extrabold text-primary">رسائل البريد الإلكتروني للفواتير الضريبية</div>
							<div class="text-sm text-muted">إرسال نسخة PDF معتمدة من الفاتورة الضريبية فور اكتمال الطلب</div>
						</div>
						<input type="checkbox" name="notif_invoices" checked class="form-checkbox" />
					</div>

					<div class="flex-between items-center p-4 border rounded-lg bg-surface-sunken">
						<div>
							<div class="font-extrabold text-primary">تنبيهات انخفاض المخزون والخصومات الحصرية</div>
							<div class="text-sm text-muted">إشعارات عند توفر أصناف دوائية ناقصة أو وجود عروض بونص خاصة</div>
						</div>
						<input type="checkbox" name="notif_promos" checked class="form-checkbox" />
					</div>

					<div class="mt-3">
						<button type="submit" class="btn btn-primary font-black px-8 py-3">
							@components.IconCheck("icon-xs")
							<span>حفظ التفضيلات</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Dynamic Modal: Request Account Deletion Modal (Typed Confirmation) -->
			@components.ConfirmModal(components.ConfirmModalProps{
				ID:           "delete-account-modal",
				Title:        "طلب حذف الحساب وإنهاء النشاط",
				Message:      "تنبيه: سيتم إرسال طلبك إلى إدارة المنصة للتحقق من عدم وجود معاملات أو مستحقات معلقة قبل إتمام الحذف.",
				ConfirmURL:   "/settings/delete-request",
				ConfirmVerb:  "post",
				ConfirmText:  "تأكيد إرسال طلب الحذف",
				CancelText:   "إلغاء",
				RequireMatch: "حذف",
				Danger:       true,
			})

		</div>
	}
}

func userNameVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Name.Get("ar")
}

func userEmailVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Email
}

func userPhoneVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Phone
}

func userRoleVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Role
}

func ternaryStr(cond bool, a, b string) string {
	if cond {
		return a
	}
	return b
}
