package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerUserOrgData struct {
	UserOrgs   []*org.UserOrganization
	Vendors    []*org.Organization
	NoticeType string
	NoticeMsg  string
}

templ CustomerUserOrganizationsPage(lang, dir string, data *CustomerUserOrgData, perms []string) {
	@layouts.CustomerShell("المنظمات المربوطة | My Organizations", "user_organization", lang, dir, perms) {
		<div class="page-container">

			<!-- Notice Banner -->
			if data != nil && data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-4 p-4 d-flex items-center gap-2">
						@components.IconAlert("icon-xs")
						<strong class="text-sm">{ data.NoticeMsg }</strong>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 d-flex items-center gap-2">
						@components.IconCheckCircle("icon-xs")
						<strong class="text-sm">{ data.NoticeMsg }</strong>
					</div>
				}
			}

			<!-- Top Header Banner -->
			<div class="glass-panel p-5 mb-6 d-flex items-center justify-between flex-wrap gap-4 border rounded-2xl shadow-xs">
				<div>
					<div class="d-flex items-center gap-2 mb-1">
						<div class="user-avatar-badge">
							@components.IconBuilding("icon-sm")
						</div>
						<h1 class="page-title font-bold text-xl m-0">
							المنظمات المربوطة (My Organizations)
						</h1>
					</div>
					<p class="text-xs text-secondary m-0">
						ربط الصيدلية بالموردين والشركات داخل المنصة باستخدام رقم المنظمة (Organization Number) للحصول على الأسعار المعتمدة والتسهيلات المباشرة.
					</p>
				</div>

				<div class="d-flex items-center gap-2 flex-wrap">
					<a href="/customer/dashboard" class="btn btn-secondary btn-sm font-bold">
						<span>العودة للرئيسية ←</span>
					</a>
					<button
						type="button"
						class="btn btn-primary btn-sm font-bold gap-1 px-3 shadow-xs"
						data-modal-open="add-customer-user-org-modal"
					>
						@components.IconPlus("icon-xs")
						<span>+ إضافة وربط منظمة جديدة</span>
					</button>
				</div>
			</div>

			<!-- Linked Organizations Cards Grid -->
			if data == nil || len(data.UserOrgs) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لا توجد منظمات مربوطة حالياً",
					Message:     "قم بربط حساب صيدليتك بأرقام المنظمات المعتمدة لدى الموردين لتفعيل عروض الأسعار والتسهيلات المخصصة لك.",
					ActionLabel: "+ إضافة وربط منظمة الآن",
					ActionURL:   "#",
				})
			} else {
				<div class="user-org-cards-grid mb-6">
					for _, uo := range data.UserOrgs {
						if uo != nil {
							<div class="product-card-glass p-5 rounded-2xl border d-flex flex-col justify-between shadow-xs">
								<!-- Card Top -->
								<div>
									<!-- Vendor Info & Status Pill -->
									<div class="d-flex items-start justify-between gap-3 mb-4">
										<div class="d-flex items-center gap-3">
											<div class="user-avatar-badge text-primary">
												@components.IconBuilding("icon-sm")
											</div>
											<div>
												<h3 class="text-base font-extrabold text-primary m-0">
													{ uo.VendorOrgName }
												</h3>
												<span class="text-xs text-muted font-bold">
													شركة / مورد معتمد
												</span>
											</div>
										</div>

										<!-- Status Pill -->
										<div>
											switch uo.Status {
												case org.UserOrgStatusApproved:
													<span class="badge badge-emerald text-xs font-bold gap-1">
														@components.IconCheck("icon-2xs")
														<span>معتمد ومطابق</span>
													</span>
												case org.UserOrgStatusRejected:
													<span class="badge badge-rose text-xs font-bold gap-1">
														@components.IconAlert("icon-2xs")
														<span>مرفوض</span>
													</span>
												default:
													<span class="badge badge-amber text-xs font-bold gap-1">
														@components.IconClock("icon-2xs")
														<span>قيد الانتظار</span>
													</span>
											}
										</div>
									</div>

									<!-- Card Body: Organization Number Display -->
									<div class="p-3.5 bg-surface-sunken rounded-xl border mb-3">
										<div class="text-2xs text-muted font-bold mb-1">
											رقم المنظمة لدى المورد (Organization Number)
										</div>
										<div class="d-flex items-center justify-between">
											<div class="tabular-nums font-mono text-lg font-black text-brand tracking-wide" dir="ltr">
												{ uo.OrganizationNumber }
											</div>
											<span class="badge badge-slate text-2xs font-mono">مفعل</span>
										</div>
										if uo.Notes != "" {
											<div class="text-xs text-secondary mt-2 pt-2 border-t">
												{ uo.Notes }
											</div>
										}
									</div>

									<!-- Date Added -->
									<div class="d-flex items-center gap-1 text-2xs text-muted mb-4 font-bold">
										@components.IconClock("icon-2xs")
										<span>تاريخ الربط:</span>
										<span class="tabular-nums text-primary">{ format.Date(uo.CreatedAt, "ar") }</span>
									</div>
								</div>

								<!-- Card Footer: Actions -->
								<div class="d-flex items-center gap-2 pt-3 border-t">
									<!-- Edit Button -->
									<button
										type="button"
										class="btn btn-secondary btn-sm font-bold gap-1.5 flex-1"
										data-modal-open={ fmt.Sprintf("edit-uo-modal-%d", uo.ID) }
									>
										@components.IconEdit("icon-xs")
										<span>تعديل</span>
									</button>

									<!-- Delete Form -->
									<form method="POST" class="m-0 flex-1" action={ templ.SafeURL(fmt.Sprintf("/customer/user-organization/%d/delete", uo.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف ربط هذه المنظمة؟');">
										<button type="submit" class="btn btn-secondary btn-sm text-danger font-bold gap-1.5 w-full">
											@components.IconTrash("icon-xs")
											<span>حذف الربط</span>
										</button>
									</form>
								</div>

							</div>
						}
					}
				</div>
			}

			<!-- Modals & Scripts -->
			@CustomerUserOrgAddModal()

			if data != nil {
				for _, uo := range data.UserOrgs {
					if uo != nil {
						@CustomerUserOrgEditModal(uo)
					}
				}
			}

			@CustomerUserOrgScript()

		</div>
	}
}