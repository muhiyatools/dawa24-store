package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerUserOrgData struct {
	UserOrgs   []*org.UserOrganization
	Vendors    []*org.Organization
	NoticeType string
	NoticeMsg  string
}

templ CustomerUserOrganizationsPage(lang, dir string, data *CustomerUserOrgData, perms []string) {
	@layouts.CustomerShell("المستخدم-المنظمة | My organizations", "user_organization", lang, dir, perms) {
		<div class="page-container">

			<!-- Notice Banner -->
			if data != nil && data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-6 p-4 d-flex items-center gap-3">
						<span class="text-xl">@components.IconAlert("icon-sm")</span>
						<strong class="text-sm">{ data.NoticeMsg }</strong>
					</div>
				} else {
					<div class="alert alert-success mb-6 p-4 d-flex items-center gap-3">
						<span class="text-xl">@components.IconCheckCircle("icon-sm")</span>
						<strong class="text-sm">{ data.NoticeMsg }</strong>
					</div>
				}
			}

			<!-- Top Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="stack-xs">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconBuilding("icon-sm")
							</div>
							<h1 class="page-title text-2xl font-black text-primary m-0">
								المنظمات المربوطة (My Organizations)
							</h1>
						</div>
						<p class="text-sm text-secondary m-0 max-w-2xl leading-relaxed">
							ربط الصيدلية بالموردين والشركات داخل المنصة باستخدام رقم المنظمة (Organization Number) للحصول على الأسعار المعتمدة والتسهيلات المباشرة.
						</p>
					</div>

					<div class="d-flex items-center gap-3 flex-wrap">
						<a href="/customer/dashboard" class="btn btn-secondary btn-sm font-bold">
							<span>العودة للرئيسية ←</span>
						</a>
						<button
							type="button"
							class="btn btn-primary btn-sm font-bold gap-2 px-4"
							data-modal-open="add-customer-user-org-modal"
						>
							@components.IconPlus("icon-xs")
							<span>+ إضافة وربط منظمة جديدة</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Add Organization Modal -->
			@components.Modal(components.ModalProps{
				ID:    "add-customer-user-org-modal",
				Title: "إضافة وربط منظمة / مورد جديد",
				Size:  "md",
			}) {
				<form method="POST" class="stack-md" action="/customer/user-organization/new">
					<!-- Live AJAX Vendor Search with Debouncing -->
					<div class="form-group m-0 relative">
						<label class="form-label text-xs font-bold" for="customer-uo-vendor-search">
							المورد أو المنشأة المستهدفة <span class="text-danger">*</span>
						</label>
						
						<!-- Hidden Input holding the selected Vendor Organization ID -->
						<input type="hidden" id="customer-selected-vendor-id" name="vendor_org_id" required value="" />

						<!-- Selected Vendor Chip Card (shown once a vendor is chosen) -->
						<div id="customer-selected-vendor-chip" class="selected-vendor-chip d-flex items-center justify-between p-3 bg-surface-sunken rounded-xl border hidden">
							<div class="d-flex items-center gap-3">
								<div class="w-10 h-10 rounded-lg bg-primary-subtle text-primary flex-center">
									@components.IconBuilding("icon-sm")
								</div>
								<div class="stack-2xs">
									<strong id="customer-selected-vendor-name" class="text-sm text-primary"></strong>
									<div id="customer-selected-vendor-details" class="text-xs text-muted font-mono" dir="ltr"></div>
								</div>
							</div>
							<button type="button" class="btn btn-ghost btn-xs text-danger font-bold" onclick="clearCustomerSelectedVendor()">
								تغيير
							</button>
						</div>

						<!-- Search Input Field -->
						<div id="customer-vendor-search-input-wrapper" class="relative">
							<input
								type="text"
								id="customer-uo-vendor-search"
								placeholder="ابحث باسم المورد، الشركة، أو رقم السجل..."
								autocomplete="off"
								class="form-input w-full"
								oninput="handleCustomerVendorSearch(this.value)"
								onfocus="handleCustomerVendorSearch(this.value)"
							/>
							<div id="customer-vendor-search-spinner" class="spinner-container text-muted hidden">
								⏳
							</div>
						</div>

						<!-- Autocomplete Results Dropdown -->
						<div
							id="customer-vendor-search-dropdown"
							class="dropdown-menu shadow-md hidden"
						></div>
					</div>

					<div class="form-group m-0">
						<label class="form-label text-xs font-bold" for="add-uo-number">
							رقم المنظمة لدى المورد (Organization Number) <span class="text-danger">*</span>
						</label>
						<input
							type="text"
							id="add-uo-number"
							name="organization_number"
							required
							placeholder="مثال: NUM10001 أو 010645645..."
							class="form-input font-mono font-bold"
							dir="ltr"
						/>
						<span class="text-xs text-muted mt-1 d-block">
							كود حساب الصيدلية أو رقم التعريف المسجل به لدى هذا المورد.
						</span>
					</div>

					<div class="form-group m-0">
						<label class="form-label text-xs font-bold" for="add-uo-notes">
							ملاحظات إضافية (اختياري)
						</label>
						<textarea
							id="add-uo-notes"
							name="notes"
							rows="2"
							placeholder="أي تفاصيل أو ملاحظات للمورد..."
							class="form-input"
						></textarea>
					</div>

					<div class="modal-footer pt-3 border-t flex-between items-center">
						<button
							type="button"
							class="btn btn-secondary font-bold"
							data-modal-close="add-customer-user-org-modal"
						>
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary font-bold px-6">
							حفظ وإرسال الطلب للمورد
						</button>
					</div>
				</form>
			}

			<!-- Grid of Organization Cards -->
			if data == nil || len(data.UserOrgs) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد منظمات مربوطة حالياً",
					Message: "يمكنك إضافة وربط حسابك بالموردين والشركات بالضغط على '+ إضافة وربط منظمة جديدة'.",
				})
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					for _, uo := range data.UserOrgs {
						if uo != nil {
							<div class="card p-5 flex flex-col justify-between hover:shadow-md transition-shadow">
								<!-- Card Header -->
								<div>
									<div class="flex-between items-start gap-3 mb-4">
										<div class="d-flex items-center gap-3">
											<div class="w-10 h-10 rounded-xl bg-primary-subtle text-primary flex-center flex-shrink-0">
												@components.IconBuilding("icon-sm")
											</div>
											<div class="stack-2xs">
												<h3 class="card-title text-sm font-bold text-primary m-0">
													{ uo.VendorOrgName }
												</h3>
												<span class="text-xs text-muted">
													شركة / مورد معتمد
												</span>
											</div>
										</div>

										<!-- Status Pill -->
										<div>
											switch uo.Status {
												case org.UserOrgStatusApproved:
													<span class="badge badge-emerald text-xs font-bold">معتمد ومطابق</span>
												case org.UserOrgStatusRejected:
													<span class="badge badge-rose text-xs font-bold">مرفوض</span>
												default:
													<span class="badge badge-amber text-xs font-bold">قيد الانتظار</span>
											}
										</div>
									</div>

									<!-- Card Body: Organization Number Display -->
									<div class="p-3.5 bg-surface-sunken rounded-xl border mb-4">
										<div class="text-xs text-muted font-bold mb-1">
											رقم المنظمة (Organization Number)
										</div>
										<div class="tabular-nums font-mono text-lg font-black text-primary tracking-wider" dir="ltr">
											{ uo.OrganizationNumber }
										</div>
										if uo.Notes != "" {
											<div class="text-xs text-secondary mt-2 pt-2 border-t">
												{ uo.Notes }
											</div>
										}
									</div>
								</div>

								<!-- Card Footer: Actions & Date -->
								<div class="flex-between items-center pt-3 border-t">
									<div class="d-flex items-center gap-2">
										<!-- Delete Form -->
										<form method="POST" class="m-0" action={ templ.SafeURL(fmt.Sprintf("/customer/user-organization/%d/delete", uo.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف ربط هذه المنظمة؟');">
											<button type="submit" class="btn btn-secondary btn-icon btn-sm" title="حذف الربط">
												@components.IconTrash("icon-xs")
											</button>
										</form>

										<!-- Edit Button -->
										<button
											type="button"
											class="btn btn-secondary btn-icon btn-sm"
											title="تعديل رقم المنظمة"
											data-modal-open={ fmt.Sprintf("edit-uo-modal-%d", uo.ID) }
										>
											@components.IconEdit("icon-xs")
										</button>
									</div>

									<div class="tabular-nums text-xs text-muted">
										{ format.Date(uo.CreatedAt, "ar") }
									</div>
								</div>

								<!-- Edit Modal -->
								@components.Modal(components.ModalProps{
									ID:    fmt.Sprintf("edit-uo-modal-%d", uo.ID),
									Title: fmt.Sprintf("تعديل بيانات الربط مع %s", uo.VendorOrgName),
									Size:  "md",
								}) {
									<form method="POST" class="stack-md" action={ templ.SafeURL(fmt.Sprintf("/customer/user-organization/%d/edit", uo.ID)) }>
										<div class="form-group m-0">
											<label class="form-label text-xs font-bold" for={ fmt.Sprintf("edit-uo-num-%d", uo.ID) }>
												رقم المنظمة (Organization Number) <span class="text-danger">*</span>
											</label>
											<input
												type="text"
												id={ fmt.Sprintf("edit-uo-num-%d", uo.ID) }
												name="organization_number"
												value={ uo.OrganizationNumber }
												required
												class="form-input font-mono font-bold"
												dir="ltr"
											/>
										</div>

										<div class="form-group m-0">
											<label class="form-label text-xs font-bold" for={ fmt.Sprintf("edit-uo-notes-%d", uo.ID) }>
												ملاحظات إضافية
											</label>
											<textarea
												id={ fmt.Sprintf("edit-uo-notes-%d", uo.ID) }
												name="notes"
												rows="2"
												class="form-input"
											>{ uo.Notes }</textarea>
										</div>

										<div class="modal-footer pt-3 border-t flex-between items-center">
											<button
												type="button"
												class="btn btn-secondary font-bold"
												data-modal-close={ fmt.Sprintf("edit-uo-modal-%d", uo.ID) }
											>
												إلغاء
											</button>
											<button type="submit" class="btn btn-primary font-bold px-6">
												حفظ التعديلات
											</button>
										</div>
									</form>
								}

							</div>
						}
					}
				</div>
			}

		</div>

		<script>
			let customerVendorSearchTimer = null;

			function handleCustomerVendorSearch(val) {
				clearTimeout(customerVendorSearchTimer);
				const dropdown = document.getElementById('customer-vendor-search-dropdown');
				const spinner = document.getElementById('customer-vendor-search-spinner');
				if (!dropdown) return;

				const query = (val || '').trim();
				if (!query) {
					dropdown.classList.add('hidden');
					dropdown.innerHTML = '';
					if (spinner) spinner.classList.add('hidden');
					return;
				}

				if (spinner) spinner.classList.remove('hidden');

				customerVendorSearchTimer = setTimeout(() => {
					fetch('/customer/api/vendors/search?q=' + encodeURIComponent(query))
						.then(res => res.json())
						.then(vendors => {
							if (spinner) spinner.classList.add('hidden');
							if (!vendors || vendors.length === 0) {
								dropdown.innerHTML = '<div class="p-3 text-sm text-muted text-center">لا توجد شركات أو موردين مطابقين</div>';
								dropdown.classList.remove('hidden');
								return;
							}

							let html = '';
							vendors.forEach(v => {
								const safeName = (v.name || 'مورد').replace(/'/g, "\\'");
								const safeLegal = (v.legal_name || '').replace(/'/g, "\\'");
								const safeOrgNum = (v.organization_number || '').replace(/'/g, "\\'");
								const safeTax = (v.tax_number || '').replace(/'/g, "\\'");
								html += `
									<div
										class="dropdown-item d-flex items-center justify-between p-2.5 cursor-pointer hover:bg-surface-sunken rounded-lg transition-colors"
										onclick="selectCustomerVendor(${v.id}, '${safeName}', '${safeLegal}', '${safeOrgNum}', '${safeTax}')"
									>
										<div class="stack-2xs">
											<strong class="text-sm text-primary">${v.name}</strong>
											<div class="text-xs text-muted font-mono" dir="ltr">${v.organization_number ? 'كود: ' + v.organization_number + ' • ' : ''}${v.tax_number ? 'ب.ض: ' + v.tax_number : ''}</div>
										</div>
										<span class="badge badge-sky text-xs">#${v.id}</span>
									</div>
								`;
							});
							dropdown.innerHTML = html;
							dropdown.classList.remove('hidden');
						})
						.catch(err => {
							if (spinner) spinner.classList.add('hidden');
							dropdown.innerHTML = '<div class="p-3 text-sm text-danger text-center">حدث خطأ أثناء البحث</div>';
							dropdown.classList.remove('hidden');
						});
				}, 250);
			}

			function selectCustomerVendor(id, name, legal, orgNum, taxNum) {
				const hiddenInput = document.getElementById('customer-selected-vendor-id');
				const chip = document.getElementById('customer-selected-vendor-chip');
				const chipName = document.getElementById('customer-selected-vendor-name');
				const chipDetails = document.getElementById('customer-selected-vendor-details');
				const searchWrapper = document.getElementById('customer-vendor-search-input-wrapper');
				const dropdown = document.getElementById('customer-vendor-search-dropdown');
				const searchInput = document.getElementById('customer-uo-vendor-search');

				if (hiddenInput) hiddenInput.value = id;
				if (chipName) chipName.textContent = name;
				if (chipDetails) chipDetails.textContent = (orgNum ? 'كود: ' + orgNum + ' • ' : '') + 'ID: #' + id;
				if (chip) chip.classList.remove('hidden');
				if (searchWrapper) searchWrapper.classList.add('hidden');
				if (dropdown) {
					dropdown.classList.add('hidden');
					dropdown.innerHTML = '';
				}
				if (searchInput) searchInput.value = '';
			}

			function clearCustomerSelectedVendor() {
				const hiddenInput = document.getElementById('customer-selected-vendor-id');
				const chip = document.getElementById('customer-selected-vendor-chip');
				const searchWrapper = document.getElementById('customer-vendor-search-input-wrapper');
				const searchInput = document.getElementById('customer-uo-vendor-search');

				if (hiddenInput) hiddenInput.value = '';
				if (chip) chip.classList.add('hidden');
				if (searchWrapper) searchWrapper.classList.remove('hidden');
				if (searchInput) {
					searchInput.value = '';
					searchInput.focus();
				}
			}

			document.addEventListener('click', (e) => {
				const dropdown = document.getElementById('customer-vendor-search-dropdown');
				const searchInput = document.getElementById('customer-uo-vendor-search');
				if (dropdown && !dropdown.contains(e.target) && e.target !== searchInput) {
					dropdown.classList.add('hidden');
				}
			});
		</script>
	}
}
