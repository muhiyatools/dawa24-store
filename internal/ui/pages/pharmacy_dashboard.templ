package pages

import (
	"fmt"
	"time"

	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ PharmacyDashboard(lang, dir string, data PharmacyDashboardData, perms []string) {
	@layouts.CustomerShell(i18n.T(lang, "pharmacy.dashboard.title"), "dashboard", lang, dir, perms) {
		<div class="page-container">
			
			<!-- Header / Pharmacy Overview Banner -->
			<div class="glass-panel p-4 mb-6 flex-between flex-wrap gap-4">
    <div class="stack-sm">
					<div class="d-flex items-center gap-2 flex-wrap">
						<h1 class="text-xl font-black text-primary m-0">
							if data.CustomerOrgName != "" {
								{ data.CustomerOrgName }
							} else {
								<span>{ i18n.T(lang, "pharmacy.dashboard.title") }</span>
							}
						</h1>
						<span class="badge badge-emerald text-xs font-bold">
							{ i18n.T(lang, "pharmacy.dashboard.verified") }
						</span>
					</div>
					<div class="text-xs text-muted mt-1 d-flex items-center gap-2 flex-wrap">
						<span>{ i18n.T(lang, "pharmacy.dashboard.overview") }</span>
						<span>•</span>
						<span>{ i18n.T(lang, "pharmacy.dashboard.today") } <strong class="tabular-nums text-primary">{ format.Date(time.Now(), lang) }</strong></span>
					</div>
				</div>

			</div>

			<!-- Urgent Document Alert (if pending) -->
			if len(data.PendingDocRequests) > 0 {
				<div class="alert alert-warning mb-6 p-4 flex-between flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="text-warning flex-shrink-0">
							@components.IconAlert("icon-lg")
						</div>
      <div class="stack-sm">
							<div class="font-extrabold text-sm text-warning">
								تنبيه إداري عاجل: مطلوب استكمال مستند رسمي ({ data.PendingDocRequests[0].Title })
							</div>
							<div class="text-xs text-muted mt-1">
								المهلة الممنوحة: متبقي <strong class="tabular-nums text-primary">{ fmt.Sprintf("%d", data.PendingDocRequests[0].DaysRemaining()) }</strong> يوم (حتى { format.Date(data.PendingDocRequests[0].DeadlineAt, lang) }). يرجى الرفع لتجنب إيقاف العمليات.
							</div>
						</div>
					</div>
					<a href="/customer/documents" class="btn btn-primary btn-sm font-bold gap-1">
						@components.IconFile("icon-xs")
						<span>رفع المستند الآن ↗</span>
					</a>
				</div>
			}

			@PharmacyDashboardMetrics(lang, data)
			<!-- Quick Actions Hub -->
			<div class="glass-panel p-4 mb-6">
				<div class="flex-between mb-3">
					<span class="text-sm font-extrabold text-primary">{ i18n.T(lang, "pharmacy.dashboard.quick_actions") }</span>
					<span class="text-xs text-muted">{ i18n.T(lang, "pharmacy.dashboard.most_used") }</span>
				</div>
				<div class="quick-actions-grid">
					
					<!-- Action 1: Purchase Request Hub (طلب الشراء) -->
					<a href="/customer/purchase-request" class="quick-action-btn">
						<span class="text-brand">@components.IconShoppingBag("icon-xs")</span>
						<span>{ i18n.T(lang, "pharmacy.dashboard.purchase_request") }</span>
					</a>

					<!-- Action 2: New Smart Order (الطلب الذكي) -->
					<a href="/customer/smart-order/new" class="quick-action-btn">
						<span class="text-brand">@components.IconZap("icon-xs")</span>
						<span>{ i18n.T(lang, "pharmacy.dashboard.smart_order") }</span>
					</a>

					<!-- Action 3: Top up Wallet -->
					<a href="/wallet" class="quick-action-btn">
						<span class="text-success">@components.IconCreditCard("icon-xs")</span>
						<span>{ i18n.T(lang, "pharmacy.dashboard.top_up_action") }</span>
					</a>

					<!-- Action 4: Manage Branches -->
					<a href="/customer/branches" class="quick-action-btn">
						<span class="text-info">@components.IconBuilding("icon-xs")</span>
						<span>{ fmt.Sprintf(i18n.T(lang, "pharmacy.dashboard.manage_branches_action"), data.TotalBranches) }</span>
					</a>

					<!-- Action 5: Documents -->
					<a href="/customer/documents" class="quick-action-btn">
						<span class="text-warning">@components.IconFileText("icon-xs")</span>
						<span>{ i18n.T(lang, "pharmacy.dashboard.documents_action") }</span>
					</a>

					<!-- Action 6: View Orders -->
					<a href="/orders" class="quick-action-btn">
						<span class="text-secondary">@components.IconPackage("icon-xs")</span>
						<span>{ i18n.T(lang, "pharmacy.dashboard.orders_log_action") }</span>
					</a>

				</div>
			</div>

			<!-- Main 2-Column Responsive Workspace Grid -->
			<div class="dashboard-workspace-grid">
				
				<!-- Column 1: Main Area (Recent Orders Table + Smart Orders Section) -->
				<div class="d-flex flex-col gap-6">
					
					<!-- Recent Orders Table Section -->
					<div class="glass-panel p-4">
						<div class="flex-between pb-3 border-b mb-4">
       <div class="stack-sm">
								<h2 class="text-base font-extrabold text-primary m-0">{ i18n.T(lang, "pharmacy.dashboard.recent_orders") }</h2>
								<span class="text-xs text-muted">{ i18n.T(lang, "pharmacy.dashboard.recent_orders_desc") }</span>
							</div>
							<a href="/orders" class="btn btn-secondary btn-sm font-bold">
								{ fmt.Sprintf(i18n.T(lang, "pharmacy.dashboard.all_orders_count"), data.TotalOrders) }
							</a>
						</div>

						if len(data.Orders) == 0 {
							@components.EmptyState(components.EmptyStateProps{
								Title:   i18n.T(lang, "pharmacy.dashboard.empty_orders_title"),
								Message: i18n.T(lang, "pharmacy.dashboard.empty_orders_msg"),
							})
						} else {
							<div class="table-container">
								<table class="data-table">
									<thead>
										<tr>
											<th>{ i18n.T(lang, "pharmacy.dashboard.col_order_num") }</th>
											<th>{ i18n.T(lang, "pharmacy.dashboard.col_date") }</th>
											<th>{ i18n.T(lang, "pharmacy.dashboard.col_branch") }</th>
											<th class="text-center">{ i18n.T(lang, "pharmacy.dashboard.col_items") }</th>
											<th class="tabular-nums text-end">{ i18n.T(lang, "pharmacy.dashboard.col_total") }</th>
											<th>{ i18n.T(lang, "pharmacy.dashboard.col_status") }</th>
											<th class="text-end">{ i18n.T(lang, "pharmacy.dashboard.col_actions") }</th>
										</tr>
									</thead>
									<tbody>
										for _, o := range data.Orders {
											<tr>
												<td>
													<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="font-extrabold text-brand tabular-nums">
														#{ o.OrderNumber }
													</a>
												</td>
												<td class="text-xs text-secondary whitespace-nowrap">
													{ format.Date(o.CreatedAt, lang) }
												</td>
												<td class="text-xs text-primary font-semibold">
													if !o.CustomerBranchName.IsEmpty() {
														{ o.CustomerBranchName.Get(i18n.Lang(lang)) }
													} else if data.ActiveBranchName != "" {
														{ data.ActiveBranchName }
													} else {
														<span>{ i18n.T(lang, "pharmacy.dashboard.main_branch") }</span>
													}
												</td>
												<td class="text-center text-xs font-bold">
													if len(o.Lines) > 0 {
														<span class="badge badge-slate">{ fmt.Sprintf("%d صنف", len(o.Lines)) }</span>
													} else {
														<span class="text-muted">—</span>
													}
												</td>
												<td class="tabular-nums text-end font-extrabold">
													@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: o.TotalAmount })
												</td>
												<td>
													@components.StatusBadge(string(o.Status))
												</td>
												<td class="text-end">
													<div class="d-flex items-center gap-1 justify-end">
														<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-secondary btn-xs font-bold">
															{ i18n.T(lang, "common.details") }
														</a>
														<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", o.ID)) } target="_blank" class="btn btn-secondary btn-xs text-muted" title="طباعة الفاتورة">
															@components.IconPrinter("icon-xs")
														</a>
													</div>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>

					<!-- Section: الطلب الذكي (الطلب الذكي ومطابقة النواقص) -->
					<div class="glass-panel p-4">
						<div class="flex-between pb-3 border-b mb-4">
       <div class="stack-sm">
								<div class="d-flex items-center gap-2">
									<h2 class="text-base font-extrabold text-primary m-0">{ i18n.T(lang, "pharmacy.dashboard.smart_matching_title") }</h2>
									<span class="badge badge-sky text-xs font-bold">{ i18n.T(lang, "pharmacy.dashboard.ai_badge") }</span>
								</div>
								<span class="text-xs text-muted">{ i18n.T(lang, "pharmacy.dashboard.smart_matching_desc") }</span>
							</div>
							<a href="/customer/smart-order/new" class="btn btn-primary btn-sm font-bold gap-1">
								@components.IconPlus("icon-xs")
								<span>{ i18n.T(lang, "pharmacy.dashboard.start_smart_order") }</span>
							</a>
						</div>

						<!-- Smart Orders Stats 4-Pills Grid -->
						<div class="d-grid grid-auto-fit-sm gap-3 mb-5">
							
							<div class="bg-surface-sunken p-3 rounded-lg border text-center">
								<div class="text-xs text-secondary font-bold">{ i18n.T(lang, "pharmacy.dashboard.total_files") }</div>
								<div class="tabular-nums text-xl font-black text-primary mt-1">
									{ fmt.Sprintf("%d", data.SmartOrdersTotal) }
								</div>
							</div>

							<div class="bg-warning/10 p-3 rounded-lg border border-warning/30 text-center">
								<div class="text-xs text-warning font-bold">{ i18n.T(lang, "smartorder.status_processing") }</div>
								<div class="tabular-nums text-xl font-black text-warning mt-1">
									{ fmt.Sprintf("%d", data.SmartOrdersProcessing) }
								</div>
							</div>

							<div class="bg-success/10 p-3 rounded-lg border border-success/30 text-center">
								<div class="text-xs text-success font-bold">{ i18n.T(lang, "smartorder.status_placed") }</div>
								<div class="tabular-nums text-xl font-black text-success mt-1">
									{ fmt.Sprintf("%d", data.SmartOrdersCompleted) }
								</div>
							</div>

							<div class="bg-info/10 p-3 rounded-lg border border-info/30 text-center">
								<div class="text-xs text-info font-bold">{ i18n.T(lang, "pharmacy.dashboard.awaiting_review") }</div>
								<div class="tabular-nums text-xl font-black text-info mt-1">
									{ fmt.Sprintf("%d", data.SmartOrdersNeedsReview) }
								</div>
							</div>

						</div>

						<!-- Recent Smart Order Runs -->
						if len(data.RecentSmartOrders) == 0 {
							<div class="text-center p-7 bg-surface-sunken rounded-lg border border-dashed">
								<div class="text-sm font-bold text-primary">{ i18n.T(lang, "pharmacy.dashboard.no_smart_orders_title") }</div>
								<p class="text-xs text-secondary my-2">{ i18n.T(lang, "pharmacy.dashboard.no_smart_orders_msg") }</p>
								<a href="/customer/smart-order/new" class="btn btn-primary btn-sm font-bold">
									{ i18n.T(lang, "pharmacy.dashboard.upload_first_file") }
								</a>
							</div>
						} else {
							<div class="d-flex flex-col gap-2.5">
								for _, r := range data.RecentSmartOrders {
									<div class="flex-between items-center p-3 px-4 border rounded-lg bg-surface-sunken flex-wrap gap-2">
          <div class="stack-sm">
											<div class="font-extrabold text-primary text-sm d-flex items-center gap-1.5">
												<span>{ r.OriginalFile }</span>
												<span class="text-xs font-semibold text-muted tabular-nums">#{ r.RunNumber }</span>
											</div>
											<div class="text-xs text-secondary mt-1 d-flex items-center gap-2">
												<span>{ format.Date(r.CreatedAt, lang) }</span>
												<span>•</span>
												<span class="tabular-nums">مطابق { fmt.Sprintf("%d", r.Stats.MatchedRows) } من { fmt.Sprintf("%d", r.Stats.TotalRows) } صنف</span>
											</div>
										</div>
										<div class="inline-row-06">
											@components.Badge(components.BadgeProps{
												Label: FormatSmartOrderStatusLabel(r.Status),
												Tone:  FormatSmartOrderStatusTone(r.Status),
											})
											<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", r.PublicID)) } class="btn btn-secondary btn-xs font-bold px-2.5 py-1">
												{ i18n.T(lang, "pharmacy.dashboard.view_results") }
											</a>
										</div>
									</div>
								}
							</div>
						}

					</div>

				</div>

				<!-- Column 2: Side Widgets (Wallet, Branches, AI Quota, Offers) -->
				@PharmacyDashboardSidebar(lang, data)
			</div>

		</div>
	}
}