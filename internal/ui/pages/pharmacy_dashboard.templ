package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ PharmacyDashboard(lang, dir string, data PharmacyDashboardData, perms []string) {
	@layouts.CustomerShell("لوحة التحكم", "dashboard", lang, dir, perms) {
		if len(data.PendingDocRequests) > 0 {
			<div style="background:#fffbeb; border:2px solid #f59e0b; border-radius:var(--radius-xl); padding:1.25rem; margin-bottom:1.5rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; box-shadow:var(--shadow-sm);">
				<div class="row-center">
					@components.IconAlert("icon-lg")
					<div>
						<div style="font-weight:800; color:#92400e; font-size:0.95rem;">
							تنبيه إداري عاجل: مطلوب رفع مستند رسمي ({ data.PendingDocRequests[0].Title })
						</div>
						<div style="font-size:0.8rem; color:#b45309; margin-top:0.2rem;">
							المهلة الممنوحة: متبقي <strong class="tabular-nums">{ fmt.Sprintf("%d", data.PendingDocRequests[0].DaysRemaining()) }</strong> يوم (حتى { format.Date(data.PendingDocRequests[0].DeadlineAt, "ar") }). يرجى الرفع لتجنب إيقاف وتجميد الحساب.
						</div>
					</div>
				</div>
				<a href="/customer/documents" class="btn btn-primary btn-sm" style="font-weight:800; background:#d97706; border-color:#d97706; color:#ffffff; gap:0.35rem;">
					@components.IconFile("icon-xs")
					<span>رفع المستند المطلوب الآن ↗</span>
				</a>
			</div>
		}

		if data.Subscription != nil && data.Subscription.HasSubscription {
			<div class="card" style="margin-bottom:1.5rem; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
					<div style="display:flex; align-items:center; gap:0.6rem;">
						<span class="text-xl">🏢</span>
						<div>
							<h3 style="margin:0; font-size:1.05rem; font-weight:800; color:var(--text);">
								باقة الاشتراك وخدمات الذكاء الاصطناعي للمنشأة
							</h3>
							<p style="margin:0.15rem 0 0; font-size:0.775rem; color:var(--text-secondary);">
								الخطة المعتمدة وحدود الجلسات المطبقة على المنشأة بالكامل وحصة الـ AI Gateway
							</p>
						</div>
					</div>
					<div class="row-center-sm">
						<span class="badge badge-emerald fw-700">{ data.Subscription.Status }</span>
						if data.Subscription.IsDefaultPlan {
							<span class="badge badge-primary text-xs">باقة افتراضية</span>
						}
					</div>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:1rem;">
					<!-- Plan Name & Expiry -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<span style="font-size:0.75rem; color:var(--text-secondary); font-weight:600; display:block;">خطة الاشتراك المعتمدة</span>
						<strong style="font-size:1rem; color:var(--text); display:block; margin-top:0.25rem;">{ data.Subscription.PlanName }</strong>
						<span style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem; display:block;">الصلاحية: { data.Subscription.ExpiresAt }</span>
					</div>

					<!-- Sessions Quota -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<span style="font-size:0.75rem; color:var(--text-secondary); font-weight:600; display:block;">الجلسات المتزامنة (إجمالي المنشأة)</span>
						<strong style="font-size:1.15rem; color:var(--primary); display:block; margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d جلسات", data.Subscription.MaxLoginSessions) }
						</strong>
						<span style="font-size:0.725rem; color:var(--text-muted); margin-top:0.25rem; display:block;">مشتركة لكافة موظفي الصيدلية</span>
					</div>

					<!-- Devices Quota -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<span style="font-size:0.75rem; color:var(--text-secondary); font-weight:600; display:block;">الأجهزة المصرح بها</span>
						<strong style="font-size:1.15rem; color:var(--text); display:block; margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d أجهزة", data.Subscription.MaxDevices) }
						</strong>
						<span style="font-size:0.725rem; color:var(--text-muted); margin-top:0.25rem; display:block;">حد الأجهزة المفتوحة</span>
					</div>

					<!-- AI Gateway & Live Consumption -->
					<div style="background:rgba(56, 189, 248, 0.05); border:1px solid rgba(56, 189, 248, 0.2); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<div class="flex-between">
							<span style="font-size:0.75rem; color:var(--primary); font-weight:700;">بوابة الذكاء الاصطناعي</span>
							<span class="badge badge-info" dir="ltr" style="font-size:0.7rem; font-weight:700;">{ data.Subscription.AIPlanID }</span>
						</div>
						if data.Subscription.HasAIUsage && data.Subscription.AIBudgetLimitUSD > 0 {
							<div style="margin-top:0.35rem; font-size:0.8rem; color:var(--text);">
								<span>الميزانية: </span><strong class="tabular-nums" dir="ltr" style="color:var(--primary); font-weight:800;">${ fmt.Sprintf("%.2f / $%.2f", data.Subscription.AIBudgetSpentUSD, data.Subscription.AIBudgetLimitUSD) }</strong>
							</div>
							<div style="margin-top:0.25rem; font-size:0.725rem; color:var(--text-muted);">
								if data.Subscription.AIBudgetResetTime != "" {
									<span>تجديد: <strong class="tabular-nums">{ data.Subscription.AIBudgetResetTime }</strong></span>
								} else {
									<span>تجديد دوري مستمر</span>
								}
							</div>
						} else {
							<div style="margin-top:0.35rem; font-size:0.8rem; color:var(--text);">
								<span>المعرّف: </span><code dir="ltr" class="text-xs">{ data.Subscription.AIUserID }</code>
							</div>
							<div style="margin-top:0.25rem; font-size:0.725rem; color:var(--emerald); font-weight:600;">
								✓ المفتاح الافتراضي مفعل وجاهز
							</div>
						}
					</div>
				</div>

				<div style="margin-top:1rem; padding-top:0.75rem; border-top:1px solid var(--border); display:flex; justify-content:flex-end;">
					<a href="/customer/subscription" style="font-size:0.8rem; font-weight:700; color:var(--primary); text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem;">
						<span>عرض تفاصيل الاشتراك والترقية ↗</span>
					</a>
				</div>
			</div>
		}

		<div class="b2b-metric-grid" style="grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));">
			@components.StatCard(components.StatCardProps{
				Label: "طلبات مفتوحة",
				Value: fmt.Sprintf("%d طلب", data.OpenOrders),
				Tone:  "warning",
			})
			@components.StatCard(components.StatCardProps{
				Label: "إنفاق الشهر",
				Money: &data.MonthSpend,
				Tone:  "neutral",
			})
			if data.HasWallet {
				@components.StatCard(components.StatCardProps{
					Label: "رصيد المحفظة",
					Money: &data.WalletBalance,
					Tone:  "info",
				})
			}
			@components.StatCard(components.StatCardProps{
				Label: "المفضلة",
				Value: fmt.Sprintf("%d صنف", data.Favorites),
				Tone:  "primary",
			})
			@components.StatCard(components.StatCardProps{
				Label: "عروض متاحة",
				Value: fmt.Sprintf("%d عرض", data.ActiveOffers),
				Tone:  "primary",
			})
		</div>

		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(360px, 1fr)); gap:1.25rem;">
			<div class="b2b-table-card p-card-sm">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
					<h2 class="card-title" style="margin:0; font-size:1.1rem; font-weight:700;">متابعة الطلبات</h2>
					<a href="/orders" class="btn btn-secondary btn-sm fw-600">كل الطلبات</a>
				</div>
				if len(data.Orders) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد طلبات بعد",
						Message: "ابدأ التصفح وأضف منتجات لسلتك لإنشاء طلبيتك الأولى.",
					})
				} else {
					<div class="b2b-table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th>الطلب</th>
									<th>الحالة</th>
									<th class="td-numeric">الإجمالي</th>
								</tr>
							</thead>
							<tbody>
								for _, o := range data.Orders {
									<tr>
										<td><a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } style="font-weight:700; color:var(--accent); text-decoration:none;">{ o.OrderNumber }</a></td>
										<td>@components.StatusBadge(string(o.Status))</td>
										<td class="td-numeric">@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: o.TotalAmount })</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<div class="b2b-table-card p-card-sm">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
					<h2 class="card-title" style="margin:0; font-size:1.1rem; font-weight:700;">عروض توريد مقترحة لك</h2>
					<a href="/offers" class="btn btn-secondary btn-sm fw-600">كل العروض</a>
				</div>
				if len(data.Offers) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد عروض حالياً",
						Message: "لا توجد عروض توريد نشطة في منطقتك حالياً.",
					})
				} else {
					<div class="stack-sm">
						for _, o := range data.Offers {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-sunken);">
								<div>
									<div style="font-weight:700; color:var(--text); font-size:0.9375rem;">{ o.Title.Get(i18n.Lang(lang)) }</div>
									<div style="font-size:0.8125rem; color:var(--text-secondary); margin-top:0.15rem;">قيمة الخصم: <strong class="tabular-nums">{ o.DiscountValue.String() }</strong> ج.م</div>
								</div>
								<a href="/offers" class="btn btn-secondary btn-sm fw-600">عرض التفاصيل</a>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}
