package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrders(orders []*commerce.Order, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerOrdersList(orders)
	} else {
		@layouts.CustomerShell("طلبياتي وأوامر التوريد", "orders", lang, dir, nil) {
			{{
				ordersCount := len(orders)
			}}
			<div class="orders-page-container" style="max-width:100%;">
				@components.PageHeader(components.PageHeaderProps{
					Title:      "سجل طلبيات وأوامر التوريد",
					Subtitle:   "متابعة كافة طلبيات الشراء وفواتير التوريد وحالات الشحن المباشرة للصيدلية",
					Count:      &ordersCount,
					CountLabel: "طلبية",
				}) {
					<a href="/catalog" class="btn btn-primary" style="font-weight:700; gap:0.4rem;">
						@components.IconPlus("icon-xs")
						<span>طلب توريد جديد</span>
					</a>
				}
				<div id="orders-list">
					@CustomerOrdersList(orders)
				</div>
			</div>
		}
	}
}

templ CustomerOrdersList(orders []*commerce.Order) {
	if len(orders) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد طلبيات سابقة",
			Message:     "لم تقم بإجراء أي طلبات شراء حتى الآن عبر منصة دواء 24.",
			ActionLabel: "تصفح الكتالوج الدوائي",
			ActionURL:   "/catalog",
		})
	} else {
		<div style="display:flex; flex-direction:column; gap:0.875rem;">
			for _, o := range orders {
				<div class="b2b-table-card" style="display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; margin-bottom:0; flex-wrap:wrap; gap:1rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.4rem;">
							<span style="font-weight:800; font-size:1.1rem; color:var(--text);" class="tabular-nums">
								#{ o.OrderNumber }
							</span>
							@components.StatusBadge(string(o.Status))
						</div>
						<div style="font-size:0.85rem; color:var(--text-secondary); display:flex; gap:1.25rem; flex-wrap:wrap;">
							<span>التاريخ: <strong class="tabular-nums">{ o.CreatedAt.Format("2006-01-02 15:04") }</strong></span>
							<span>طريقة الدفع: { string(o.PaymentMethod) }</span>
						</div>
					</div>
					<div style="display:flex; align-items:center; gap:1.5rem;">
						<div class="text-end">
							<div style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">إجمالي الطلبية</div>
							<div style="font-weight:800; font-size:1.2rem; color:var(--text);" class="tabular-nums">
								{ o.TotalAmount.String() } <span style="font-size:0.8rem; font-weight:600; color:var(--text-secondary);">ج.م</span>
							</div>
						</div>
						<div style="display:flex; align-items:center; gap:0.5rem;">
							<a
								href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", o.ID)) }
								target="_blank"
								class="btn btn-secondary btn-sm"
								style="font-weight:700; gap:0.35rem; padding:0.35rem 0.65rem;"
								title="طباعة الفاتورة الضريبية الرسمية"
							>
								@components.IconPrinter("icon-xs")
								<span>طباعة</span>
							</a>
							<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-primary btn-sm" style="font-weight:700; gap:0.35rem;">
								<span>تفاصيل الطلب</span>
								@components.IconArrowLeft("icon-xs")
							</a>
						</div>
					</div>
				</div>
			}
		</div>
	}
}

