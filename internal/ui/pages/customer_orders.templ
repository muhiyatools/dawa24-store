package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrders(orders []*commerce.Order, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerOrdersList(orders, lang)
	} else {
		@layouts.CustomerShell("طلبياتي وأوامر التوريد", "orders", lang, dir, nil) {
			{{
				ordersCount := len(orders)
				activeCount := 0
				completedCount := 0
				cancelledCount := 0
				for _, o := range orders {
					if o.Status == commerce.StatusDelivered || o.Status == commerce.StatusCompleted {
						completedCount++
					} else if o.Status == commerce.StatusCancelled || o.Status == commerce.StatusRefunded || o.Status == commerce.StatusFailed {
						cancelledCount++
					} else {
						activeCount++
					}
				}
			}}
			<div class="page-container">
				<!-- Header Section -->
				<div class="page-header-block mb-6">
					<div>
						<div class="d-flex items-center gap-2 mb-1">
							<h1 class="text-2xl font-black text-primary m-0">
								سجل طلبيات وأوامر التوريد
							</h1>
							<span class="badge badge-primary text-xs tabular-nums font-bold">
								{ fmt.Sprintf("%d طلبية", ordersCount) }
							</span>
						</div>
						<p class="text-sm text-muted m-0">
							متابعة كافة طلبيات الشراء وفواتير التوريد وحالات الشحن المباشرة للصيدلية
						</p>
					</div>

					<div class="page-actions-group">
						<a href="/catalog" class="btn btn-primary font-bold gap-2 px-4">
							@components.IconPlus("icon-xs")
							<span>طلب توريد جديد</span>
						</a>
					</div>
				</div>

				<!-- Filter Tabs -->
				<div class="flex-between flex-wrap gap-4 mb-6 border-b pb-3">
					<div class="d-flex items-center gap-2 flex-wrap">
						<button
							type="button"
							class="btn btn-secondary btn-sm filter-tab active font-bold"
							onclick="filterOrders('all', this)"
						>
							<span>كل الطلبيات</span>
							<span class="badge badge-slate text-xs tabular-nums ms-1">{ fmt.Sprintf("%d", ordersCount) }</span>
						</button>
						<button
							type="button"
							class="btn btn-secondary btn-sm filter-tab font-bold"
							onclick="filterOrders('active', this)"
						>
							<span>قيد التنفيذ</span>
							<span class="badge badge-amber text-xs tabular-nums ms-1">{ fmt.Sprintf("%d", activeCount) }</span>
						</button>
						<button
							type="button"
							class="btn btn-secondary btn-sm filter-tab font-bold"
							onclick="filterOrders('completed', this)"
						>
							<span>المكتملة</span>
							<span class="badge badge-emerald text-xs tabular-nums ms-1">{ fmt.Sprintf("%d", completedCount) }</span>
						</button>
						if cancelledCount > 0 {
							<button
								type="button"
								class="btn btn-secondary btn-sm filter-tab font-bold"
								onclick="filterOrders('cancelled', this)"
							>
								<span>الملغية</span>
								<span class="badge badge-rose text-xs tabular-nums ms-1">{ fmt.Sprintf("%d", cancelledCount) }</span>
							</button>
						}
					</div>

					<!-- Search input -->
					<div class="position-relative min-w-0">
						<input
							type="text"
							id="order-search-input"
							placeholder="بحث برقم الطلب..."
							onkeyup="searchOrders(this.value)"
							class="form-input form-input-sm ps-6"
						/>
					</div>
				</div>

				<!-- Orders List Container -->
				<div id="orders-list">
					@CustomerOrdersList(orders, lang)
				</div>
			</div>

			<script>
				function filterOrders(status, btn) {
					document.querySelectorAll('.filter-tab').forEach(b => {
						b.classList.remove('btn-primary');
						b.classList.add('btn-secondary');
					});
					btn.classList.remove('btn-secondary');
					btn.classList.add('btn-primary');

					const items = document.querySelectorAll('.order-card-item');
					items.forEach(item => {
						const s = item.getAttribute('data-status-category');
						if (status === 'all' || s === status) {
							item.style.display = 'flex';
						} else {
							item.style.display = 'none';
						}
					});
				}

				function searchOrders(q) {
					const query = (q || '').trim().toLowerCase();
					const items = document.querySelectorAll('.order-card-item');
					items.forEach(item => {
						const num = (item.getAttribute('data-order-num') || '').toLowerCase();
						if (!query || num.includes(query)) {
							item.style.display = 'flex';
						} else {
							item.style.display = 'none';
						}
					});
				}
			</script>
		}
	}
}

templ CustomerOrdersList(orders []*commerce.Order, lang string) {
	if len(orders) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد طلبيات سابقة",
			Message:     "لم تقم بإجراء أي طلبات شراء حتى الآن عبر منصة دواء 24.",
			ActionLabel: "تصفح الكتالوج الدوائي",
			ActionURL:   "/catalog",
		})
	} else {
		<div class="d-flex flex-col gap-3">
			for _, o := range orders {
				{{
					statusCategory := "active"
					if o.Status == commerce.StatusDelivered || o.Status == commerce.StatusCompleted {
						statusCategory = "completed"
					} else if o.Status == commerce.StatusCancelled || o.Status == commerce.StatusRefunded || o.Status == commerce.StatusFailed {
						statusCategory = "cancelled"
					}

					itemsCount := len(o.Lines)
					shipmentsCount := len(o.Shipments)
					if shipmentsCount == 0 {
						shipmentsCount = 1
					}
				}}
				<div
					class="order-card-glass order-card-item"
					data-status-category={ statusCategory }
					data-order-num={ o.OrderNumber }
				>
					<!-- Left info -->
					<div class="d-flex flex-col gap-2 flex-1 min-w-0">
						<div class="d-flex items-center gap-3 flex-wrap">
							<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="order-card-num">
								#{ o.OrderNumber }
							</a>
							@components.StatusBadge(string(o.Status))
							if o.PaymentStatus == commerce.PaymentPaid {
								<span class="badge badge-emerald text-xs font-bold">مدفوع</span>
							} else {
								<span class="badge badge-amber text-xs font-bold">دفع عند الاستلام</span>
							}
						</div>

						<div class="order-card-meta">
							<span class="d-flex items-center gap-1">
								<span>📅</span>
								<span class="tabular-nums">{ o.CreatedAt.Format("2006-01-02 15:04") }</span>
							</span>
							if o.CustomerBranchName.Get(i18n.Lang(lang)) != "" {
								<span class="d-flex items-center gap-1">
									@components.IconLocation("icon-xs")
									<span>{ o.CustomerBranchName.Get(i18n.Lang(lang)) }</span>
								</span>
							}
							<span class="d-flex items-center gap-1">
								@components.IconPackage("icon-xs")
								<span>{ fmt.Sprintf("%d أصناف", itemsCount) } ({ fmt.Sprintf("%d شحنات/موزعين", shipmentsCount) })</span>
							</span>
						</div>
					</div>

					<!-- Right finance & actions -->
					<div class="d-flex items-center gap-6 flex-wrap">
						<div class="text-end">
							<div class="order-card-total-title">المبلغ الإجمالي</div>
							<div class="order-card-total-val">
								{ o.TotalAmount.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
							</div>
						</div>

						<div class="d-flex items-center gap-2">
							if o.Status != commerce.StatusPending {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", o.ID)) }
									target="_blank"
									class="btn btn-secondary btn-sm font-bold gap-1"
									title="طباعة الفاتورة"
								>
									@components.IconPrinter("icon-xs")
									<span>طباعة الفاتورة</span>
								</a>
							}
							<a
								href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) }
								class="btn btn-primary btn-sm font-bold gap-1"
							>
								<span>تفاصيل الطلب</span>
								@components.IconArrowLeft("icon-xs")
							</a>
						</div>
					</div>
				</div>
			}
		</div>
	}
}


