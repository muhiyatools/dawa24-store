package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrders(orders []*commerce.Order, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerOrdersList(orders)
	} else {
		@layouts.CustomerShell("سجل الطلبات | My Orders", lang, dir) {
			<div class="orders-page-container" style="max-width:1040px; margin:1.5rem auto;">
				<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.5rem;">
					@components.IconPackage("icon-md")
					<h1 style="font-size:1.75rem; font-weight:900; color:var(--neutral-900); margin:0;">
						سجل طلبات التوريد
					</h1>
				</div>
				<div id="orders-list">
					@CustomerOrdersList(orders)
				</div>
			</div>
		}
	}
}

templ CustomerOrdersList(orders []*commerce.Order) {
	if len(orders) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد طلبات سابقة",
			Message:     "لم تقم بإجراء أي طلبات شراء حتى الآن عبر منصة دواء 24.",
			ActionLabel: "تصفح الكتالوج الدوائي",
		})
	} else {
		<div style="display:flex; flex-direction:column; gap:1rem;">
			for _, o := range orders {
				<div class="card hover-lift" style="display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; margin-bottom:0;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.4rem;">
							<span style="font-weight:800; font-size:1.1rem; color:var(--primary-800);" class="tabular-nums">
								#{ o.OrderNumber }
							</span>
							<span class="badge badge-emerald" style="font-size:0.775rem;">
								{ string(o.Status) }
							</span>
						</div>
						<div style="font-size:0.85rem; color:var(--neutral-500); display:flex; gap:1.25rem;">
							<span>التاريخ: <strong class="tabular-nums">{ o.CreatedAt.Format("2006-01-02 15:04") }</strong></span>
							<span>طريقة الدفع: <strong>{ o.PaymentMethod }</strong></span>
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:1.5rem;">
						<div style="text-align:end;">
							<div style="font-size:0.8rem; color:var(--neutral-500);">إجمالي الفاتورة</div>
							<div style="font-weight:800; font-size:1.15rem; color:var(--neutral-900);" class="tabular-nums">
								{ o.TotalAmount.String() } EGP
							</div>
						</div>
						<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-secondary btn-sm" style="font-weight:600;">
							@components.IconFileText("icon-xs")
							<span>تفاصيل الطلب</span>
						</a>
					</div>
				</div>
			}
		</div>
	}
}
