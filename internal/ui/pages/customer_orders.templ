package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrders(orders []*commerce.Order, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerOrdersList(orders)
	} else {
		@layouts.CustomerShell("طلبياتي وأوامر التوريد", "orders", lang, dir, nil) {
			<div class="orders-page-container" style="max-width:100%;">
				<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;">
					<div class="row-center-sm">
						@components.IconPackage("icon-md")
						<h2 style="font-size:1.5rem; font-weight:900; color:var(--neutral-900); margin:0;">
							سجل طلبيات وأوامر التوريد
						</h2>
					</div>
					<a href="/catalog" class="btn btn-primary btn-sm" style="font-weight:800;">
						@components.IconPlus("icon-xs")
						<span>طلب توريد جديد</span>
					</a>
				</div>
				<div id="orders-list">
					@CustomerOrdersList(orders)
				</div>
			</div>
		}
	}
}

templ CustomerOrdersList(orders []*commerce.Order) {
	if len(orders) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد طلبيات سابقة",
			Message:     "لم تقم بإجراء أي طلبات شراء حتى الآن عبر منصة دواء 24.",
			ActionLabel: "تصفح الكتالوج الدوائي",
		})
	} else {
		<div class="stack">
			for _, o := range orders {
				<div class="card hover-lift" style="display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; margin-bottom:0;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.4rem;">
							<span style="font-weight:800; font-size:1.1rem; color:var(--primary-800);" class="tabular-nums">
								#{ o.OrderNumber }
							</span>
							<span class="badge badge-emerald" style="font-size:0.775rem;">
								{ string(o.Status) }
							</span>
						</div>
						<div style="font-size:0.85rem; color:var(--neutral-500); display:flex; gap:1.25rem;">
							<span>التاريخ: { o.CreatedAt.Format("2006-01-02 15:04") }</span>
							<span>طريقة الدفع: { string(o.PaymentMethod) }</span>
						</div>
					</div>
					<div style="text-align:inline-end; display:flex; align-items:center; gap:1.5rem;">
						<div>
							<div style="font-size:0.75rem; color:var(--neutral-400); font-weight:700;">إجمالي الطلب</div>
							<div style="font-weight:900; font-size:1.2rem; color:var(--neutral-900);" class="tabular-nums">
								{ o.TotalAmount.String() } ج.م
							</div>
						</div>
						<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-secondary btn-sm" style="font-weight:800;">
							<span>تفاصيل الطلب</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>
				</div>
			}
		</div>
	}
}
