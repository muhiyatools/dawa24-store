package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrders(orders []*commerce.Order, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerOrdersList(orders)
	} else {
		@layouts.CustomerShell("طلباتي | Order History", lang, dir) {
			<div class="orders-page-container" style="max-width:960px; margin:2rem auto;">
				<h1 style="font-size:1.75rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.5rem;">
					سجل الطلبات
				</h1>
				<div id="orders-list">
					@CustomerOrdersList(orders)
				</div>
			</div>
		}
	}
}

templ CustomerOrdersList(orders []*commerce.Order) {
	if len(orders) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد طلبات سابقة",
			Message:     "لم تقم بإجراء أي طلبات شراء حتى الآن عبر منصة دواء 24.",
			ActionLabel: "تصفح الكتالوج",
		})
	} else {
		<div style="display:flex; flex-direction:column; gap:1rem;">
			for _, o := range orders {
				<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-lg); padding:1.25rem; display:flex; align-items:center; justify-content:space-between;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.4rem;">
							<span style="font-weight:800; font-size:1.05rem; color:var(--primary-800);" class="tabular-nums">
								#{ o.OrderNumber }
							</span>
							<span style="font-size:0.75rem; font-weight:700; padding:0.2rem 0.6rem; border-radius:4px; background:var(--primary-50); color:var(--primary-700);">
								{ string(o.Status) }
							</span>
						</div>
						<div style="font-size:0.85rem; color:var(--neutral-500);">
							التاريخ: <span class="tabular-nums">{ o.CreatedAt.Format("2006-01-02 15:04") }</span> | طريقة الدفع: { o.PaymentMethod }
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:1.5rem;">
						<div style="text-align:end;">
							<div style="font-size:0.8rem; color:var(--neutral-500);">الإجمالي</div>
							<div style="font-weight:800; font-size:1.1rem; color:var(--neutral-900);" class="tabular-nums">
								{ o.TotalAmount.String() } EGP
							</div>
						</div>
						<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-secondary" style="font-size:0.875rem;">
							تفاصيل الطلب 🔍
						</a>
					</div>
				</div>
			}
		</div>
	}
}
