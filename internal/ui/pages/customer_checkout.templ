package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCheckout(cart *commerce.Cart, branches []*org.Branch, lang, dir string) {
	@layouts.CustomerShell("إتمام أمر الشراء والتوريد | B2B Checkout", "checkout", lang, dir, nil) {
		<div class="page-container max-w-6xl">
			
			<!-- Header -->
			<div class="page-header-block mb-6 border-b pb-4">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge">
						📦
					</div>
					<div>
						<h1 class="text-2xl font-black text-primary m-0">
							إتمام أمر الشراء والتوريد
						</h1>
						<p class="text-sm text-muted m-0 mt-1">
							تأكيد عنوان فرع الصيدلية المستلم، شروط الدفع، وإصدار الفواتير الإلكترونية المعتمدة
						</p>
					</div>
				</div>
			</div>

			<!-- Stepper Progress Bar -->
			<div class="mb-6">
				@components.Stepper(components.StepperProps{
					Steps: []components.StepperStep{
						{ ID: "address", Label: "فرع الصيدلية" },
						{ ID: "shipping", Label: "الشحن المبرد" },
						{ ID: "payment", Label: "شروط الدفع" },
						{ ID: "review", Label: "تأكيد الطلب" },
					},
					Current: 2,
				})
			</div>

			if cart == nil || len(cart.Items) == 0 {
				<div class="empty-state-glass p-8 text-center">
					<div class="empty-state-icon-wrapper mx-auto mb-4">
						🛒
					</div>
					<h3 class="text-xl font-black text-primary mb-2">
						سلة المشتريات فارغة
					</h3>
					<p class="text-sm text-muted max-w-md mx-auto mb-6">
						لم تقم بإضافة أي أصناف دوائية للسلة حتى الآن.
					</p>
					<a href="/catalog" class="btn btn-primary font-bold">
						@components.IconSearch("icon-xs")
						<span>استعراض الكتالوج الدوائي</span>
					</a>
				</div>
			} else {
				<form action="/checkout" method="POST">
					<div class="checkout-grid">
						
						<!-- Left Column: Address, Payment, Notes -->
						<div class="d-flex flex-col gap-6">
							
							<!-- 1. Pharmacy Delivery Branches Card -->
							<div class="checkout-step-card">
								<div class="flex-between mb-4 flex-wrap gap-3">
									<div class="d-flex items-center gap-3">
										<div class="user-avatar-badge">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<h2 class="text-lg font-extrabold text-primary m-0">
												1. اختيار فرع الصيدلية المستلم للطلبية
											</h2>
											<span class="text-xs text-muted">تسليم مباشر إلى مقر الفرع المرخص</span>
										</div>
									</div>

									<a href="/customer/branches" class="btn btn-secondary btn-sm font-bold gap-1">
										@components.IconPlus("icon-xs")
										<span>إدارة فروع الصيدلية</span>
									</a>
								</div>

								<div class="d-flex flex-col gap-3">
									if len(branches) == 0 {
										<div class="empty-state-glass p-6 text-center border-dashed">
											<div class="text-sm text-muted mb-4">
												لا توجد فروع مسجلة للصيدلية حتى الآن. يرجى إضافة الفرع وعنوان الاستلام لتأكيد الشحنة.
											</div>
											<a href="/customer/branches" class="btn btn-primary btn-sm font-extrabold gap-1">
												@components.IconPlus("icon-xs")
												<span>إضافة عنوان فرع الصيدلية الآن</span>
											</a>
										</div>
									}
									for idx, b := range branches {
										<label class="checkout-branch-item">
											<input
												type="radio"
												name="branch_id"
												value={ fmt.Sprintf("%d", b.ID) }
												checked?={ func() bool {
													if buying, has := authctx.BuyingBranchFrom(ctx); has && buying.Active != nil {
														return b.ID == *buying.Active
													}
													return b.IsMain || idx == 0
												}() }
												class="form-radio mt-1"
											/>
											<div class="flex-1">
												<div class="flex-between mb-1 flex-wrap gap-2">
													<strong class="text-base font-extrabold text-primary">
														{ b.Name.Get(i18n.Lang(lang)) }
													</strong>
													<div class="d-flex items-center gap-2">
														if b.IsMain {
															<span class="badge badge-emerald text-xs font-bold">الفرع الرئيسي</span>
														}
														if b.Status == "active" || b.Status == "" {
															<span class="badge badge-sky text-xs font-bold">نشط ومعتمد</span>
														}
													</div>
												</div>
												<div class="text-xs text-secondary mb-2 leading-relaxed">
													{ b.Address }
												</div>
												<div class="text-xs text-muted d-flex items-center gap-3 flex-wrap tabular-nums">
													if b.Phone != "" {
														<span class="d-flex items-center gap-1">
															@components.IconPhone("icon-xs")
															<span>{ b.Phone }</span>
														</span>
													}
													if b.ManagerName != "" {
														<span>• الصيدلي المسؤول / المدير: { b.ManagerName }</span>
													}
												</div>
											</div>
										</label>
									}
								</div>
							</div>

							<!-- 2. Payment Terms & Methods Card -->
							<div class="checkout-step-card">
								<div class="d-flex items-center gap-3 mb-4">
									<div class="user-avatar-badge">
										@components.IconShield("icon-xs")
									</div>
									<h2 class="text-lg font-extrabold text-primary m-0">
										2. طريقة وشروط الدفع والتسوية
									</h2>
								</div>

								<div class="d-flex flex-col gap-3">
									<!-- Only Cash on Delivery -->
									<label class="checkout-branch-item border-brand bg-surface-sunken">
										<input type="radio" name="payment_method" value="cod" checked class="form-radio mt-1" />
										<div class="flex-1">
											<div class="flex-between mb-1 flex-wrap gap-2">
												<div class="font-extrabold text-base text-primary">
													الدفع عند الاستلام والتسليم (نقداً / شيك مقبول الدفع)
												</div>
												<span class="badge badge-sky text-xs font-bold">تسوية مباشرة مع مندوب التوزيع</span>
											</div>
											<div class="text-xs text-secondary leading-relaxed">
												التحصيل بمعرفة مندوب شركة التوزيع المعتمد عند تسليم الشحنة المبردة بالصيدلية ومراجعة الفاتورة الضريبية الإلكترونية (ETA e-Invoice).
											</div>
										</div>
									</label>
								</div>
							</div>

							<!-- 3. Cold-Chain & Delivery Notes -->
							<div class="checkout-step-card">
								<div class="d-flex items-center gap-3 mb-3">
									<div class="user-avatar-badge">
										@components.IconTruck("icon-xs")
									</div>
									<h2 class="text-lg font-extrabold text-primary m-0">
										3. تعليمات خاصة للشحن وسلسلة التبريد
									</h2>
								</div>
								<textarea
									name="notes"
									rows="3"
									placeholder="أوقات استلام الشحنات بالصيدلية، رقم إضافي للطوارئ، أو أي تعليمات خاصة لمندوب التوريد المبرد..."
									class="form-textarea w-full"
								></textarea>
							</div>
						</div>

						<!-- Right Column: Order Summary & Confirm Button -->
						<div class="d-flex flex-col gap-4">
							<div class="checkout-summary-card">
								<h3 class="text-lg font-extrabold text-primary m-0 mb-3 border-b pb-3">
									ملخص أمر التوريد
								</h3>

								<!-- Line items summary -->
								<div class="d-flex flex-col gap-2 mb-4 max-h-56 overflow-y-auto pe-1">
									for _, it := range cart.Items {
										<div class="flex-between text-xs">
											<span class="text-secondary text-truncate max-w-180">
												{ it.ProductName.Get(i18n.Lang(lang)) }
												<span class="text-muted tabular-nums"> (×{ fmt.Sprintf("%d", it.Quantity) })</span>
											</span>
											<strong class="tabular-nums text-primary font-bold">{ CartItemTotal(it).String() } ج.م</strong>
										</div>
									}
								</div>

								<div class="border-t pt-3 d-flex flex-col gap-2 text-xs">
									<div class="flex-between text-secondary">
										<span>إجمالي الأصناف:</span>
										<span class="tabular-nums font-bold text-primary">{ fmt.Sprintf("%d", len(cart.Items)) } أصناف</span>
									</div>

									<div class="flex-between text-secondary">
										<span>الشحن المبرد (Cold-Chain):</span>
										<span class="badge badge-emerald text-xs">مجاناً للطلبيات المعتمدة</span>
									</div>

									<div class="flex-between text-secondary">
										<span>ضريبة القيمة المضافة (14% ETA):</span>
										<span class="text-primary font-bold">مشمولة بالفاتورة</span>
									</div>
								</div>

								<div class="border-t pt-3 mt-3 flex-between items-baseline">
									<span class="font-extrabold text-sm text-primary">الإجمالي النهائي:</span>
									<div class="text-2xl font-black text-brand tabular-nums">
										{ CartTotal(cart).String() } <span class="text-xs font-bold text-muted">ج.م</span>
									</div>
								</div>

								<div class="mt-4">
									<button
										type="submit"
										class="btn btn-primary btn-lg w-full font-extrabold flex-center gap-2"
									>
										@components.IconCheck("icon-sm")
										<span>تأكيد الطلب وإرساله للموردين</span>
									</button>
								</div>
							</div>

							<!-- Security Badge -->
							<div class="glass-panel p-3 d-flex items-center gap-3 text-xs text-muted">
								<div class="text-brand text-lg">🛡️</div>
								<div>معاملة مضمونة بنظام الضمان المالي الدوائي (Escrow) والفواتير الإلكترونية المعتمدة.</div>
							</div>
						</div>
					</div>
				</form>
			}
		</div>
	}
}
