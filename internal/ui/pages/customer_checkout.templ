package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCheckout(cart *commerce.Cart, addresses []*identity.UserAddress, lang, dir string) {
	@layouts.CustomerShell("إتمام أمر الشراء والتوريد | B2B Checkout", lang, dir) {
		<div class="checkout-page-container" style="max-width:1160px; margin:1.5rem auto 5rem auto;">
			
			<!-- Header -->
			<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem;">
				<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
					@components.IconCheckCircle("icon-md")
				</div>
				<div>
					<h1 style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin:0;">
						إتمام أمر الشراء والتوريد
					</h1>
					<p style="color:var(--neutral-500); font-size:0.875rem; margin:0.15rem 0 0 0;">
						تأكيد عناوين تسليم الفروع، شروط الدفع، وإصدار الفواتير الإلكترونية المعتمدة
					</p>
				</div>
			</div>

			<!-- Stepper Progress Bar -->
			@components.Stepper(components.StepperProps{
				Steps: []components.StepperStep{
					{ ID: "address", Label: "مقر التوصيل" },
					{ ID: "shipping", Label: "الشحن المبرد" },
					{ ID: "payment", Label: "شروط الدفع" },
					{ ID: "review", Label: "تأكيد الطلب" },
				},
				Current: 2,
			})

			if cart == nil || len(cart.Items) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "سلة المشتريات فارغة",
					Message:     "لا توجد منتجات في السلة لإتمام الطلب.",
					ActionLabel: "العودة للكتالوج الدوائي",
				})
			} else {
				<form action="/checkout" method="POST">
					<div style="display:grid; grid-template-columns:1.3fr 0.7fr; gap:2rem; align-items:start;">
						
						<!-- Left Column: Address, Payment, Notes -->
						<div style="display:flex; flex-direction:column; gap:1.75rem;">
							
							<!-- 1. Delivery Addresses Card -->
							<div class="card" style="margin-bottom:0; padding:2rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card); box-shadow:var(--shadow-sm);">
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:0.75rem;">
									<div style="display:flex; align-items:center; gap:0.6rem;">
										<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
											@components.IconBuilding("icon-xs")
										</div>
										<h2 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
											1. اختيار عنوان ومقر استلام الصيدلية
										</h2>
									</div>

									<a href="/settings#addresses" class="btn btn-secondary btn-sm" style="font-weight:700;">
										@components.IconPlus("icon-xs")
										<span>إدارة / إضافة عنوان جديد</span>
									</a>
								</div>

								<div style="display:flex; flex-direction:column; gap:0.875rem;">
									for idx, addr := range addresses {
										<label
											style="display:flex; align-items:flex-start; gap:1rem; padding:1.25rem; border:1.5px solid var(--neutral-200); border-radius:var(--radius-xl); cursor:pointer; background:#ffffff; transition:all 0.15s ease;"
											class="hover-lift"
										>
											<input
												type="radio"
												name="address_id"
												value={ fmt.Sprintf("%d", addr.ID) }
												checked?={ addr.IsDefault || idx == 0 }
												style="margin-top:0.35rem; width:18px; height:18px; accent-color:var(--primary-600);"
											/>
											<div style="flex:1;">
												<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem;">
													<strong style="font-size:1.05rem; color:var(--neutral-900);">{ addr.Title }</strong>
													if addr.IsDefault {
														<span class="badge badge-emerald" style="font-size:0.75rem;">الفرع الرئيسي</span>
													}
												</div>
												<div style="color:var(--neutral-600); font-size:0.875rem; line-height:1.5; margin-bottom:0.4rem;">
													{ addr.Address }
												</div>
												<div style="font-size:0.825rem; color:var(--neutral-500); display:flex; align-items:center; gap:0.5rem;" class="tabular-nums">
													@components.IconPhone("icon-xs")
													<span>{ addr.Phone } • المسؤول: { addr.Recipient }</span>
												</div>
											</div>
										</label>
									}
								</div>
							</div>

							<!-- 2. Payment Terms & Methods Card -->
							<div class="card" style="margin-bottom:0; padding:2rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card); box-shadow:var(--shadow-sm);">
								<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.5rem;">
									<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
										@components.IconShield("icon-xs")
									</div>
									<h2 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
										2. طريقة وشروط الدفع والتسوية
									</h2>
								</div>

								<div style="display:flex; flex-direction:column; gap:0.875rem;">
									<!-- Option 1: Wallet -->
									<label style="display:flex; align-items:flex-start; gap:1rem; padding:1.25rem; border:1.5px solid var(--primary-200); background:var(--primary-50); border-radius:var(--radius-xl); cursor:pointer;">
										<input type="radio" name="payment_method" value="wallet" checked style="margin-top:0.35rem; width:18px; height:18px; accent-color:var(--primary-600);" />
										<div style="flex:1;">
											<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem;">
												<div style="font-weight:900; font-size:1rem; color:var(--primary-900);">
													خصم مباشر من رصيد المحفظة الإلكترونية
												</div>
												<span class="badge badge-sky" style="font-weight:800;">الرصيد المتاح: 5,420.00 ج.م</span>
											</div>
											<div style="font-size:0.825rem; color:var(--primary-800);">
												تنفيذ فوري للطلبية مع تأكيد حجز التشغيلات لدى الموردين بدون انتظار التحصيل
											</div>
										</div>
									</label>

									<!-- Option 2: Cash / Cheque on Delivery -->
									<label style="display:flex; align-items:flex-start; gap:1rem; padding:1.25rem; border:1px solid var(--neutral-200); background:#ffffff; border-radius:var(--radius-xl); cursor:pointer;">
										<input type="radio" name="payment_method" value="cod" style="margin-top:0.35rem; width:18px; height:18px; accent-color:var(--primary-600);" />
										<div style="flex:1;">
											<div style="font-weight:800; font-size:1rem; color:var(--neutral-900); margin-bottom:0.25rem;">
												الدفع عند الاستلام (نقداً / شيك مقبول الدفع)
											</div>
											<div style="font-size:0.825rem; color:var(--neutral-500);">
												التحصيل بمعرفة مندوب شركة التوزيع المعتمد عند تسليم الشحنة وفحص الفاتورة
											</div>
										</div>
									</label>

									<!-- Option 3: InstaPay / Bank Transfer -->
									<label style="display:flex; align-items:flex-start; gap:1rem; padding:1.25rem; border:1px solid var(--neutral-200); background:#ffffff; border-radius:var(--radius-xl); cursor:pointer;">
										<input type="radio" name="payment_method" value="instapay" style="margin-top:0.35rem; width:18px; height:18px; accent-color:var(--primary-600);" />
										<div style="flex:1;">
											<div style="font-weight:800; font-size:1rem; color:var(--neutral-900); margin-bottom:0.25rem;">
												إنستاباي / تحويل بنكي لحظي (InstaPay / Bank Transfer)
											</div>
											<div style="font-size:0.825rem; color:var(--neutral-500);">
												تسوية سريعة عبر الحسابات البنكية المعتمدة للمنظومة
											</div>
										</div>
									</label>

									<!-- Option 4: Credit Facility (30 Days) -->
									<label style="display:flex; align-items:flex-start; gap:1rem; padding:1.25rem; border:1px solid var(--neutral-200); background:#ffffff; border-radius:var(--radius-xl); cursor:pointer;">
										<input type="radio" name="payment_method" value="credit_30" style="margin-top:0.35rem; width:18px; height:18px; accent-color:var(--primary-600);" />
										<div style="flex:1;">
											<div style="font-weight:800; font-size:1rem; color:var(--neutral-900); margin-bottom:0.25rem;">
												تسهيلات ائتمانية آجلة (30 يوماً)
											</div>
											<div style="font-size:0.825rem; color:var(--neutral-500);">
												سداد مؤجل وفقاً للحد الائتماني المعتمد لمؤسستكم الصيدلية
											</div>
										</div>
									</label>
								</div>
							</div>

							<!-- 3. Cold-Chain & Delivery Notes -->
							<div class="card" style="margin-bottom:0; padding:2rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card); box-shadow:var(--shadow-sm);">
								<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1rem;">
									<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
										@components.IconTruck("icon-xs")
									</div>
									<h2 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
										3. تعليمات خاصة للشحن وسلسلة التبريد
									</h2>
								</div>
								<textarea
									name="notes"
									rows="3"
									placeholder="أوقات استلام الشحنات بالصيدلية، رقم إضافي للطوارئ، أو أي تعليمات خاصة لمندوب التوريد المبرد..."
									class="form-textarea"
									style="width:100%; border-radius:var(--radius-lg); font-size:0.9rem;"
								></textarea>
							</div>
						</div>

						<!-- Right Column: Order Summary & Confirm Button -->
						<div style="position:sticky; top:6rem; display:flex; flex-direction:column; gap:1.25rem;">
							<div class="card" style="margin-bottom:0; padding:2rem; background:#ffffff; border-radius:var(--radius-2xl); border:1.5px solid var(--primary-200); box-shadow:var(--shadow-sm);">
								<h3 style="font-size:1.25rem; font-weight:900; color:var(--neutral-900); margin-bottom:1.25rem; border-bottom:1px solid var(--neutral-100); padding-bottom:0.75rem;">
									ملخص أمر التوريد
								</h3>

								<!-- Line items summary -->
								<div style="display:flex; flex-direction:column; gap:0.6rem; margin-bottom:1.25rem; max-height:220px; overflow-y:auto; padding-inline-end:0.35rem;">
									for _, it := range cart.Items {
										<div style="display:flex; justify-content:space-between; align-items:center; font-size:0.85rem;">
											<span style="color:var(--neutral-700); max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
												{ it.ProductName.Get(i18n.Lang(lang)) }
												<span style="color:var(--neutral-400);" class="tabular-nums"> (×{ fmt.Sprintf("%d", it.Quantity) })</span>
											</span>
											<strong class="tabular-nums" style="color:var(--neutral-900);">{ CartItemTotal(it).String() } ج.م</strong>
										</div>
									}
								</div>

								<div style="border-top:1px solid var(--neutral-100); padding-top:1rem; display:flex; flex-direction:column; gap:0.6rem; font-size:0.9rem;">
									<div style="display:flex; justify-content:space-between; color:var(--neutral-600);">
										<span>إجمالي الأصناف:</span>
										<span class="tabular-nums" style="font-weight:700; color:var(--neutral-900);">{ fmt.Sprintf("%d", len(cart.Items)) } أصناف</span>
									</div>

									<div style="display:flex; justify-content:space-between; color:var(--neutral-600);">
										<span>الشحن المبرد (Cold-Chain):</span>
										<span class="badge badge-emerald" style="font-size:0.75rem;">مجاناً للطلبيات المعتمدة</span>
									</div>

									<div style="display:flex; justify-content:space-between; color:var(--neutral-600);">
										<span>ضريبة القيمة المضافة (14% ETA):</span>
										<span style="color:var(--neutral-700); font-weight:700;">مشمولة بالفاتورة</span>
									</div>
								</div>

								<div style="border-top:2px solid var(--neutral-200); padding-top:1rem; margin-top:1rem; display:flex; justify-content:space-between; align-items:baseline;">
									<span style="font-weight:900; font-size:1.1rem; color:var(--neutral-900);">الإجمالي النهائي:</span>
									<div style="font-size:1.75rem; font-weight:900; color:var(--primary-700);" class="tabular-nums">
										{ CartTotal(cart).String() } <span style="font-size:0.95rem; font-weight:700;">ج.م</span>
									</div>
								</div>

								<div style="margin-top:1.5rem;">
									<button
										type="submit"
										class="btn btn-primary"
										style="width:100%; padding:0.9rem; font-size:1.05rem; font-weight:900; justify-content:center;"
									>
										@components.IconCheck("icon-sm")
										<span>تأكيد الطلب وإرساله للموردين</span>
									</button>
								</div>
							</div>

							<!-- Security Badge -->
							<div style="padding:1rem; background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-lg); display:flex; align-items:center; gap:0.75rem; font-size:0.8rem; color:var(--neutral-600);">
								<div style="color:var(--primary-600);">@components.IconShield("icon-sm")</div>
								<div>معاملة مضمونة بنظام الضمان المالي الدوائي (Escrow) والفواتير الإلكترونية المعتمدة.</div>
							</div>
						</div>
					</div>
				</form>
			}
		</div>
	}
}
