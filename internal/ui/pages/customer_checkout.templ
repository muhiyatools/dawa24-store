package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCheckout(cart *commerce.Cart, branches []*org.Branch, lang, dir string) {
	@layouts.CustomerShell("إتمام أمر الشراء والتوريد | B2B Checkout", "checkout", lang, dir, nil) {
		<div class="checkout-page-container" style="max-width:1160px; margin:1.5rem auto 5rem auto; padding:0 1rem;">
			
			<!-- Header -->
			<div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
				<div style="width:46px; height:46px; border-radius:var(--radius-xl); background:var(--accent-subtle); border:1px solid var(--accent); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.35rem;">
					📦
				</div>
				<div>
					<h1 style="font-size:1.75rem; font-weight:800; color:var(--text); margin:0;">
						إتمام أمر الشراء والتوريد
					</h1>
					<p style="color:var(--text-muted); font-size:0.875rem; margin:0.2rem 0 0 0;">
						تأكيد عنوان فرع الصيدلية المستلم، شروط الدفع، وإصدار الفواتير الإلكترونية المعتمدة
					</p>
				</div>
			</div>

			<!-- Stepper Progress Bar -->
			<div style="margin-bottom:2rem;">
				@components.Stepper(components.StepperProps{
					Steps: []components.StepperStep{
						{ ID: "address", Label: "فرع الصيدلية" },
						{ ID: "shipping", Label: "الشحن المبرد" },
						{ ID: "payment", Label: "شروط الدفع" },
						{ ID: "review", Label: "تأكيد الطلب" },
					},
					Current: 2,
				})
			</div>

			if cart == nil || len(cart.Items) == 0 {
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:4rem 2rem; text-align:center;">
					<div style="width:64px; height:64px; border-radius:50%; background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto; font-size:1.75rem;">
						🛒
					</div>
					<h3 style="font-size:1.35rem; font-weight:800; color:var(--text); margin-bottom:0.4rem;">
						سلة المشتريات فارغة
					</h3>
					<p style="color:var(--text-muted); font-size:0.9rem; max-width:420px; margin:0 auto 1.5rem auto;">
						لم تقم بإضافة أي أصناف دوائية للسلة حتى الآن.
					</p>
					<a href="/catalog" class="btn btn-primary fw-700">
						@components.IconSearch("icon-xs")
						<span>استعراض الكتالوج الدوائي</span>
					</a>
				</div>
			} else {
				<form action="/checkout" method="POST">
					<div style="display:grid; grid-template-columns:1.3fr 0.7fr; gap:2rem; align-items:start;" class="checkout-grid">
						
						<!-- Left Column: Address, Payment, Notes -->
						<div class="stack-lg">
							
							<!-- 1. Pharmacy Delivery Branches Card -->
							<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem;">
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
									<div class="row-center-sm">
										<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<h2 style="font-size:1.2rem; font-weight:800; color:var(--text); margin:0;">
												1. اختيار فرع الصيدلية المستلم للطلبية
											</h2>
											<span class="text-sm text-muted">تسليم مباشر إلى مقر الفرع المرخص</span>
										</div>
									</div>

									<a href="/customer/branches" class="btn btn-secondary btn-sm fw-700">
										@components.IconPlus("icon-xs")
										<span>إدارة فروع الصيدلية</span>
									</a>
								</div>

								<div style="display:flex; flex-direction:column; gap:0.875rem;">
									if len(branches) == 0 {
										<div style="padding:2rem 1.5rem; border:2px dashed var(--border); border-radius:var(--radius-xl); text-align:center; background:var(--surface-sunken);">
											<div style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1rem;">
												لا توجد فروع مسجلة للصيدلية حتى الآن. يرجى إضافة الفرع وعنوان الاستلام لتأكيد الشحنة.
											</div>
											<a href="/customer/branches" class="btn btn-primary btn-sm fw-800">
												@components.IconPlus("icon-xs")
												<span>إضافة عنوان فرع الصيدلية الآن</span>
											</a>
										</div>
									}
									for idx, b := range branches {
										<label style="display:flex; align-items:flex-start; gap:1rem; padding:1.2rem; border:1px solid var(--border); border-radius:var(--radius-xl); cursor:pointer; background:var(--surface-sunken); transition:border-color 150ms;">
											<input
												type="radio"
												name="branch_id"
												value={ fmt.Sprintf("%d", b.ID) }
												checked?={ func() bool {
													if buying, has := authctx.BuyingBranchFrom(ctx); has && buying.Active != nil {
														return b.ID == *buying.Active
													}
													return b.IsMain || idx == 0
												}() }
												style="margin-top:0.35rem; width:18px; height:18px; accent-color:var(--accent);"
											/>
											<div class="flex-1">
												<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem; flex-wrap:wrap; gap:0.5rem;">
													<strong style="font-size:1.05rem; color:var(--text);">
														{ b.Name.Get(i18n.Lang(lang)) }
													</strong>
													<div class="row-center-sm">
														if b.IsMain {
															<span class="badge badge-emerald" style="font-size:0.725rem;">الفرع الرئيسي</span>
														}
														if b.Status == "active" || b.Status == "" {
															<span class="badge badge-sky" style="font-size:0.725rem;">نشط ومعتمد</span>
														}
													</div>
												</div>
												<div style="color:var(--text-secondary); font-size:0.875rem; line-height:1.5; margin-bottom:0.35rem;">
													{ b.Address }
												</div>
												<div style="font-size:0.8rem; color:var(--text-muted); display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;" class="tabular-nums">
													if b.Phone != "" {
														<span class="row-center-xs">
															@components.IconPhone("icon-xs")
															<span>{ b.Phone }</span>
														</span>
													}
													if b.ManagerName != "" {
														<span>• الصيدلي المسؤول / المدير: { b.ManagerName }</span>
													}
												</div>
											</div>
										</label>
									}
								</div>
							</div>

							<!-- 2. Payment Terms & Methods Card -->
							<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem;">
								<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.25rem;">
									<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
										@components.IconShield("icon-xs")
									</div>
									<h2 style="font-size:1.2rem; font-weight:800; color:var(--text); margin:0;">
										2. طريقة وشروط الدفع والتسوية
									</h2>
								</div>

								<div style="display:flex; flex-direction:column; gap:0.875rem;">
									<!-- Only Cash on Delivery -->
									<label style="display:flex; align-items:flex-start; gap:1rem; padding:1.25rem; border:1.5px solid var(--accent); background:var(--accent-subtle); border-radius:var(--radius-xl); cursor:pointer;">
										<input type="radio" name="payment_method" value="cod" checked style="margin-top:0.35rem; width:18px; height:18px; accent-color:var(--accent);" />
										<div class="flex-1">
											<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem; flex-wrap:wrap; gap:0.5rem;">
												<div style="font-weight:800; font-size:1rem; color:var(--text);">
													الدفع عند الاستلام والتسليم (نقداً / شيك مقبول الدفع)
												</div>
												<span class="badge badge-sky fw-700">تسوية مباشرة مع مندوب التوزيع</span>
											</div>
											<div style="font-size:0.85rem; color:var(--text-secondary); line-height:1.5;">
												التحصيل بمعرفة مندوب شركة التوزيع المعتمد عند تسليم الشحنة المبردة بالصيدلية ومراجعة الفاتورة الضريبية الإلكترونية (ETA e-Invoice).
											</div>
										</div>
									</label>
								</div>
							</div>

							<!-- 3. Cold-Chain & Delivery Notes -->
							<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem;">
								<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1rem;">
									<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
										@components.IconTruck("icon-xs")
									</div>
									<h2 style="font-size:1.2rem; font-weight:800; color:var(--text); margin:0;">
										3. تعليمات خاصة للشحن وسلسلة التبريد
									</h2>
								</div>
								<textarea
									name="notes"
									rows="3"
									placeholder="أوقات استلام الشحنات بالصيدلية، رقم إضافي للطوارئ، أو أي تعليمات خاصة لمندوب التوريد المبرد..."
									class="form-input"
									style="width:100%; border-radius:var(--radius-lg); font-size:0.875rem; resize:vertical;"
								></textarea>
							</div>
						</div>

						<!-- Right Column: Order Summary & Confirm Button -->
						<div style="position:sticky; top:24px; display:flex; flex-direction:column; gap:1.25rem;">
							<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 8px 32px rgba(0,0,0,0.2);">
								<h3 style="font-size:1.2rem; font-weight:800; color:var(--text); margin:0 0 1rem 0; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
									ملخص أمر التوريد
								</h3>

								<!-- Line items summary -->
								<div style="display:flex; flex-direction:column; gap:0.6rem; margin-bottom:1.25rem; max-height:220px; overflow-y:auto; padding-inline-end:0.35rem;">
									for _, it := range cart.Items {
										<div style="display:flex; justify-content:space-between; align-items:center; font-size:0.85rem;">
											<span style="color:var(--text-secondary); max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
												{ it.ProductName.Get(i18n.Lang(lang)) }
												<span class="text-muted tabular-nums"> (×{ fmt.Sprintf("%d", it.Quantity) })</span>
											</span>
											<strong class="tabular-nums text-primary">{ CartItemTotal(it).String() } ج.م</strong>
										</div>
									}
								</div>

								<div style="border-top:1px solid var(--border); padding-top:1rem; display:flex; flex-direction:column; gap:0.6rem; font-size:0.85rem;">
									<div style="display:flex; justify-content:space-between; color:var(--text-secondary);">
										<span>إجمالي الأصناف:</span>
										<span class="tabular-nums fw-700 text-primary">{ fmt.Sprintf("%d", len(cart.Items)) } أصناف</span>
									</div>

									<div style="display:flex; justify-content:space-between; color:var(--text-secondary);">
										<span>الشحن المبرد (Cold-Chain):</span>
										<span class="badge badge-emerald" style="font-size:0.725rem;">مجاناً للطلبيات المعتمدة</span>
									</div>

									<div style="display:flex; justify-content:space-between; color:var(--text-secondary);">
										<span>ضريبة القيمة المضافة (14% ETA):</span>
										<span style="color:var(--text); font-weight:700;">مشمولة بالفاتورة</span>
									</div>
								</div>

								<div style="border-top:1px solid var(--border); padding-top:1rem; margin-top:1rem; display:flex; justify-content:space-between; align-items:baseline;">
									<span style="font-weight:800; font-size:1rem; color:var(--text);">الإجمالي النهائي:</span>
									<div style="font-size:1.75rem; font-weight:800; color:var(--accent);" class="tabular-nums">
										{ CartTotal(cart).String() } <span style="font-size:0.9rem; font-weight:700; color:var(--text-muted);">ج.م</span>
									</div>
								</div>

								<div style="margin-top:1.25rem;">
									<button
										type="submit"
										class="btn btn-primary btn-lg"
										style="width:100%; font-weight:800; justify-content:center;"
									>
										@components.IconCheck("icon-sm")
										<span>تأكيد الطلب وإرساله للموردين</span>
									</button>
								</div>
							</div>

							<!-- Security Badge -->
							<div style="padding:0.9rem 1.1rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; align-items:center; gap:0.75rem; font-size:0.8rem; color:var(--text-muted);">
								<div style="color:var(--accent); font-size:1.1rem;">🛡️</div>
								<div>معاملة مضمونة بنظام الضمان المالي الدوائي (Escrow) والفواتير الإلكترونية المعتمدة.</div>
							</div>
						</div>
					</div>
				</form>
			}
		</div>
	}
}
