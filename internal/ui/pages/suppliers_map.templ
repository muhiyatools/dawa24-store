package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
)

templ SuppliersMap(lang, dir string, data SupplierDirectoryData) {
	<!-- View 2: Interactive Map View -->
	<div id="suppliers-map-view" class={ templ.KV("d-none", data.ActiveTab != "map") }>
		<div class="suppliers-map-layout mb-6">
			<!-- Map Side Panel: Quick List & Focus -->
			<div class="glass-panel p-4 map-side-panel">
				<div class="pb-3 mb-3 border-b">
					<h3 class="font-bold text-sm m-0 text-primary">
						مواقع مخازن التوزيع الدوائي
					</h3>
					<p class="text-xs text-secondary m-0 mt-0.5">
						انقر على أي مورد للتركيز عليه على الخريطة
					</p>
				</div>

				<div class="d-flex flex-col gap-2">
					for idx, s := range data.Suppliers {
						<div
							class="map-supplier-item p-3 rounded-xl bg-surface-sunken border cursor-pointer hover-bg-raised transition-all"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("focusSupplierOnMap(%f, %f, %d)", s.Latitude, s.Longitude, idx)} }
						>
							<div class="flex-between items-center gap-2 mb-1">
								<strong class="text-xs text-primary font-extrabold line-clamp-1">
									if s.Org.TradeName.Get(i18n.Lang(lang)) != "" {
										{ s.Org.TradeName.Get(i18n.Lang(lang)) }
									} else {
										{ s.Org.LegalName }
									}
								</strong>
								if s.IsOpenNow {
									<span class="badge badge-emerald text-2xs font-bold py-0 px-1.5">مفتوح</span>
								} else {
									<span class="badge badge-slate text-2xs font-bold py-0 px-1.5">مغلق</span>
								}
							</div>
							<div class="d-flex items-center gap-1.5 text-2xs text-secondary">
								<span>⏱</span>
								<span>{ s.WorkingHours }</span>
							</div>
							if s.Address != "" {
								<div class="text-2xs text-muted mt-1 line-clamp-1">
									📍 { s.Address }
								</div>
							}
						</div>
					}
				</div>
			</div>

			<!-- Map Container -->
			<div class="glass-panel p-0 overflow-hidden map-container-frame">
				<div id="suppliers-leaflet-map"></div>
			</div>
		</div>
	</div>

	<!-- JSON Data for Map Integration -->
	<script id="suppliers-data-json" type="application/json">
		{ templ.Raw(SuppliersJSON(data.Suppliers, lang)) }
	</script>

	<!-- Interactive Map & View Switcher Script -->
	<script>
		let mapInstance = null;
		const markers = [];
		let activeMarkerIdx = -1;

		function getSuppliersData() {
			try {
				const el = document.getElementById('suppliers-data-json');
				return el ? JSON.parse(el.textContent || '[]') : [];
			} catch (e) {
				return [];
			}
		}

		function getNormalPinIcon(isOpen) {
			const statusClass = isOpen ? 'is-open' : 'is-closed';
			return L.divIcon({
				className: 'custom-map-pin',
				html: '<div class="map-pin-badge ' + statusClass + '">🏢</div>',
				iconSize: [38, 38],
				iconAnchor: [19, 38],
				popupAnchor: [0, -38]
			});
		}

		function getActiveLargePinIcon() {
			return L.divIcon({
				className: 'custom-map-pin',
				html: '<div class="supplier-active-pin">🏢</div>',
				iconSize: [52, 52],
				iconAnchor: [26, 52],
				popupAnchor: [0, -52]
			});
		}

		function initSuppliersMap() {
			if (mapInstance) return;
			const mapEl = document.getElementById('suppliers-leaflet-map');
			if (!mapEl) return;

			if (typeof L === 'undefined') {
				if (typeof ensureLeaflet === 'function') {
					ensureLeaflet().then(initSuppliersMap).catch(function (err) {
						mapEl.setAttribute('data-map-failed', 'true');
						console.error('suppliers map:', err);
					});
				}
				return;
			}

			// Center on Egypt / Cairo by default (30.0444, 31.2357)
			mapInstance = L.map('suppliers-leaflet-map').setView([30.0444, 31.2357], 7);

			L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
				maxZoom: 19,
				attribution: '© OpenStreetMap contributors'
			}).addTo(mapInstance);

			const data = getSuppliersData();
			const bounds = [];

			data.forEach((s, idx) => {
				let lat = parseFloat(s.lat);
				let lng = parseFloat(s.lng);

				// If no coords or 0, fallback with staggered coordinates around Cairo
				if (!lat || !lng || (lat === 0 && lng === 0)) {
					lat = 30.0444 + ((idx * 0.035) % 0.35) - 0.15;
					lng = 31.2357 + (((idx * 7) % 10) * 0.04) - 0.20;
				}

				bounds.push([lat, lng]);

				const statusText = s.isOpen ? 'مفتوح الآن 🟢' : 'مغلق حالياً ⚪';
				const customIcon = getNormalPinIcon(s.isOpen);
				const marker = L.marker([lat, lng], { icon: customIcon }).addTo(mapInstance);

				const linkHtml = '<a href="/suppliers/' + s.id + '" class="btn btn-primary btn-xs font-bold text-decoration-none d-inline-block mt-2">عرض الكتالوج والطلب ↗</a>';
				const popupContent = '<div class="p-2 text-start font-sans" dir="rtl">' +
					'<div class="font-extrabold text-sm text-primary mb-1">' + s.name + '</div>' +
					'<div class="text-xs font-bold text-secondary mb-1">' + statusText + '</div>' +
					(s.hours ? '<div class="text-2xs text-muted mb-0.5">⏱ مواعيد العمل: <strong>' + s.hours + '</strong></div>' : '') +
					(s.coverageDays ? '<div class="text-2xs text-muted mb-0.5">أيام التغطية: ' + s.coverageDays + '</div>' : '') +
					(s.address ? '<div class="text-2xs text-muted mt-1">📍 ' + s.address + '</div>' : '') +
					linkHtml +
				'</div>';

				marker.bindPopup(popupContent);
				marker.on('click', function() {
					focusSupplierOnMap(lat, lng, idx);
				});

				markers.push(marker);
			});

			if (bounds.length > 0) {
				mapInstance.fitBounds(bounds, { padding: [40, 40], maxZoom: 12 });
			}
		}

		function focusSupplierOnMap(lat, lng, idx) {
			switchSupplierView('map');
			if (mapInstance) {
				if (activeMarkerIdx >= 0 && markers[activeMarkerIdx]) {
					const prevData = getSuppliersData()[activeMarkerIdx];
					if (prevData) {
						markers[activeMarkerIdx].setIcon(getNormalPinIcon(prevData.isOpen));
					}
				}

				if (markers[idx]) {
					markers[idx].setIcon(getActiveLargePinIcon());
					activeMarkerIdx = idx;
					mapInstance.flyTo([lat, lng], 14, { animate: true, duration: 1.0 });
					setTimeout(() => {
						markers[idx].openPopup();
					}, 400);
				} else {
					mapInstance.flyTo([lat, lng], 14, { animate: true, duration: 1.0 });
				}
			}
		}

		function switchSupplierView(view) {
			const listView = document.getElementById('suppliers-list-view');
			const mapView = document.getElementById('suppliers-map-view');
			const listBtn = document.getElementById('view-toggle-list');
			const mapBtn = document.getElementById('view-toggle-map');

			if (view === 'map') {
				if (listView) listView.classList.add('d-none');
				if (mapView) mapView.classList.remove('d-none');
				if (listBtn) listBtn.classList.remove('active');
				if (mapBtn) mapBtn.classList.add('active');
				setTimeout(() => {
					initSuppliersMap();
					if (mapInstance) mapInstance.invalidateSize();
				}, 100);
			} else {
				if (listView) listView.classList.remove('d-none');
				if (mapView) mapView.classList.add('d-none');
				if (listBtn) listBtn.classList.add('active');
				if (mapBtn) mapBtn.classList.remove('active');
			}
		}

		document.addEventListener('DOMContentLoaded', () => {
			const urlParams = new URLSearchParams(window.location.search);
			if (urlParams.get('view') === 'map') {
				switchSupplierView('map');
			}
		});
	</script>
}