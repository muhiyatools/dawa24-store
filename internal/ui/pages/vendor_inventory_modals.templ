package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// VendorInventoryModals renders both the stock adjustment and stock transfer modals as centered backdrops.
templ VendorInventoryModals(data VendorInventoryData) {
	<!-- Stock Adjustment Modal (True Fixed Centered Overlay) -->
	<div
		class="modal-backdrop"
		x-show="adjustModal"
		x-cloak
		x-transition.opacity
		@keydown.escape.window="adjustModal = false"
	>
		<div
			@click.outside="adjustModal = false"
			class="glass-panel p-6 max-w-lg w-full"
		>
			<div class="flex-between items-center mb-4 pb-3 border-b">
				<div class="d-flex items-center gap-2">
					<div class="user-avatar-badge text-brand">
						@components.IconRefresh("icon-xs")
					</div>
					<h3 class="text-lg font-black text-primary m-0">تسوية وتعديل رصيد المخزن</h3>
				</div>
				<button type="button" @click="adjustModal = false" class="btn btn-secondary btn-icon btn-sm">
					@components.IconClose("icon-xs")
				</button>
			</div>

			<div class="bg-surface-sunken border rounded-xl p-3.5 mb-4 text-xs stack-xs">
				<div class="font-extrabold text-primary text-sm" x-text="selectedStock.variantName"></div>
				<div class="text-secondary mt-1">
					الرصيد الحالي بالمخزن: <strong class="tabular-nums text-brand font-black" x-text="selectedStock.currentQty + ' عبوة'"></strong>
				</div>
			</div>

			<form :action="'/vendor/inventory/' + selectedStock.id + '/adjust'" method="POST" class="d-flex flex-col gap-4 m-0">
				<div class="stack-sm">
					<label class="form-label text-xs font-bold text-primary mb-1 d-block">الكمية المراد إضافتها أو خصمها (+/-) <span class="text-danger">*</span></label>
					<input type="number" name="delta" required class="form-input text-center font-bold tabular-nums w-full" placeholder="+50 (إضافة) أو -10 (خصم)" />
					<span class="text-xs text-muted mt-1 d-block">اكتب رقم موجب للإيداع أو رقم سالب للخصم والتسوية.</span>
				</div>

				<div class="stack-sm">
					<label class="form-label text-xs font-bold text-primary mb-1 d-block">سبب التعديل</label>
					<select name="reason" class="form-input text-xs w-full font-bold">
						<option value="تسوية جرد دوري">تسوية جرد دوري</option>
						<option value="استلام شحنة جديدة من المصنع">استلام شحنة جديدة من المصنع</option>
						<option value="تالف / كسر / انتهاء صلاحية">تالف / كسر / انتهاء صلاحية</option>
						<option value="تسوية مبيعات يدوية">تسوية مبيعات يدوية</option>
						<option value="أخرى">أسباب أخرى</option>
					</select>
				</div>

				<div class="flex-between items-center gap-3 pt-3 border-t mt-2">
					<button type="button" class="btn btn-secondary font-bold text-xs" @click="adjustModal = false">إلغاء</button>
					<button type="submit" class="btn btn-primary font-black text-xs px-6 shadow-sm">تأكيد تعديل الرصيد</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Transfer Stock to Another Warehouse Modal -->
	<div
		class="modal-backdrop"
		x-show="transferModal"
		x-cloak
		x-transition.opacity
		@keydown.escape.window="transferModal = false"
	>
		<div
			@click.outside="transferModal = false"
			class="glass-panel p-6 max-w-lg w-full"
		>
			<div class="flex-between items-center mb-4 pb-3 border-b">
				<div class="d-flex items-center gap-2">
					<div class="user-avatar-badge text-brand">
						@components.IconRefresh("icon-xs")
					</div>
					<div>
						<h3 class="text-base font-black text-primary m-0">نقل مخزون الصنف إلى مخزن آخر</h3>
						<p class="text-2xs text-secondary m-0 mt-0.5">تحويل رصيد الدواء بين مراكز التخزين التابعة للمنشأة</p>
					</div>
				</div>
				<button type="button" @click="transferModal = false" class="btn btn-secondary btn-icon btn-sm">
					@components.IconClose("icon-xs")
				</button>
			</div>

			<form action="/vendor/inventory/transfer" method="POST" class="d-flex flex-col gap-4 m-0">
				<input type="hidden" name="stock_id" :value="transferStock.id" />
				<input type="hidden" name="variant_id" :value="transferStock.variant_id" />
				<input type="hidden" name="product_id" :value="transferStock.product_id" />
				<input type="hidden" name="from_warehouse_id" :value="transferStock.from_wh_id" />
				<input type="hidden" name="redirect_url" value="/vendor/inventory" />

				<!-- Item & Source Warehouse Info Card -->
				<div class="bg-surface-sunken border rounded-xl p-3.5 text-xs stack-xs">
					<div class="text-2xs text-muted font-bold">الصنف المختار:</div>
					<div class="font-black text-primary text-sm" x-text="transferStock.name"></div>
					<div class="flex-between items-center text-xs mt-2 pt-2 border-t text-secondary">
						<span>المخزن المصدر: <strong class="text-primary font-bold" x-text="transferStock.from_wh_name"></strong></span>
						<span>الرصيد المتاح: <strong class="tabular-nums text-brand font-black" x-text="transferStock.qty + ' عبوة'"></strong></span>
					</div>
				</div>

				<!-- Target Warehouse -->
				<div class="stack-xs">
					<label class="form-label text-xs font-bold text-primary mb-1 d-block">المخزن الوجهة (المراد التحويل إليه) <span class="text-danger">*</span></label>
					if len(data.Warehouses) > 1 {
						<select name="to_warehouse_id" class="form-select text-xs w-full font-bold" required>
							<option value="">-- اختر المخزن المراد التحويل إليه --</option>
							for _, wh := range data.Warehouses {
								<option value={ fmt.Sprintf("%d", wh.ID) } x-show={ fmt.Sprintf("transferStock.from_wh_id != %d", wh.ID) }>
									{ wh.Name } { fmt.Sprintf("(كود: %s)", wh.Code) }
								</option>
							}
						</select>
					} else {
						<div class="p-3 rounded-lg bg-amber-subtle text-amber text-xs font-bold d-flex items-center gap-2">
							@components.IconAlert("icon-xs")
							<span>لا يوجد سوى مخزن واحد مسجل. يجب إضافة مخزن آخر لإتمام عملية النقل المخزني.</span>
						</div>
					}
				</div>

				<!-- Quantity to Transfer -->
				<div class="stack-xs">
					<label class="form-label text-xs font-bold text-brand mb-1 d-block">الكمية المراد نقلها (عبوة) <span class="text-danger">*</span></label>
					<input
						type="number"
						name="quantity"
						min="1"
						:max="transferStock.qty"
						required
						class="form-input text-center font-black tabular-nums text-base w-full"
						placeholder="0"
					/>
					<div class="text-2xs text-muted mt-0.5">
						الحد الأقصى للتحويل: <strong class="tabular-nums" x-text="transferStock.qty"></strong> عبوة
					</div>
				</div>

				<!-- Notes / Reason -->
				<div class="stack-xs">
					<label class="form-label text-xs font-bold text-secondary mb-1 d-block">سبب / ملاحظات التحويل</label>
					<textarea
						name="notes"
						rows="2"
						class="form-input text-xs w-full"
						placeholder="أدخل سبب النقل أو ملاحظات الشحنة (اختياري)..."
					></textarea>
				</div>

				<!-- Immediate Receive Option -->
				<div class="p-2.5 bg-surface-raised rounded-lg border d-flex items-center gap-2.5">
					<input type="checkbox" name="immediate" id="inv_transfer_imm" value="true" checked class="form-checkbox" />
					<label for="inv_transfer_imm" class="text-xs font-bold text-secondary cursor-pointer m-0 select-none">
						تأكيد الاستلام الفوري وإضافة الرصيد مباشرة إلى المخزن الوجهة
					</label>
				</div>

				<!-- Actions -->
				<div class="flex-between items-center gap-3 pt-3 border-t mt-2">
					<button type="button" class="btn btn-secondary font-bold text-xs" @click="transferModal = false">إلغاء</button>
					if len(data.Warehouses) > 1 {
						<button type="submit" class="btn btn-primary font-black text-xs px-6 shadow-sm gap-1.5" :disabled="transferStock.qty <= 0">
							@components.IconRefresh("icon-xs")
							<span>تأكيد نقل المخزون</span>
						</button>
					} else {
						<button type="button" disabled class="btn btn-secondary font-bold text-xs opacity-50 cursor-not-allowed">
							غير متاح (مخزن واحد فقط)
						</button>
					}
				</div>
			</form>
		</div>
	</div>
}
