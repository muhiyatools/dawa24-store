package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminMatchDecisionsData struct {
	Decisions []*catalog.MatchDecisionView
	Total     int
	Page      int
	PerPage   int
	Search    string
	IsEnabled bool
}


templ AdminMatchDecisionsPage(lang, dir string, data AdminMatchDecisionsData) {
	@layouts.AdminShell("ذاكرة قرارات المطابقة (AI & Matching Decisions)", "match_decisions", lang, dir) {
		<div class="match-decisions-page stack-lg">
			
			<!-- Header Banner -->
			<div class="page-header d-flex justify-between items-center flex-wrap gap-4 mb-6">
				<div class="stack-sm">
					<div class="d-flex items-center gap-3">
						<h1 class="page-title text-xl font-bold m-0">
							ذاكرة قرارات مطابقة الذكاء الاصطناعي (Decision Memories)
						</h1>
						if data.IsEnabled {
							<span class="badge badge-emerald">
								النظام مفعّل ونشط
							</span>
						} else {
							<span class="badge badge-rose">
								النظام معطّل بالكامل
							</span>
						}
					</div>
					<p class="text-sm text-secondary m-0">
						إدارة وتحكم مركزي في ذاكرة القرارات. عند تفعيل النظام، يتم عزل وتطبيق قرارات كل صيدلية ومورد على حدة لتسريع وتوحيد عمليات الاستيراد والطلب الذكي.
					</p>
				</div>
				<div class="d-flex items-center gap-3">
					<!-- Global Toggle Button -->
					<form method="POST" action="/admin/match-decisions/toggle-state" class="m-0">
						if data.IsEnabled {
							<input type="hidden" name="enabled" value="false" />
							<button
								type="submit"
								class="btn btn-outline-warning btn-sm font-bold"
								onclick="return confirm('هل أنت متأكد من رغبتك في إيقاف نظام ذاكرة القرارات بالكامل؟ لن تستخدم عمليات الاستيراد والطلب الذكي أي ذاكرة مخزنة حتى إعادة التفعيل.');"
								title="إيقاف النظام مؤقتاً">
								⏸️ إيقاف ذاكرة القرارات
							</button>
						} else {
							<input type="hidden" name="enabled" value="true" />
							<button
								type="submit"
								class="btn btn-primary btn-sm font-bold"
								title="تشغيل نظام ذاكرة القرارات">
								▶️ تفعيل ذاكرة القرارات
							</button>
						}
					</form>

					if data.Total > 0 {
						<button
							type="button"
							class="btn btn-outline-danger btn-sm font-bold"
							onclick="confirmClearAllDecisions()"
							title="مسح كافة القرارات المخزنة">
							مسح الذاكرة بالكامل
						</button>
					}
				</div>
			</div>

			<!-- Status Alert Banner if Disabled -->
			if !data.IsEnabled {
				<div class="alert alert-warning d-flex items-center justify-between gap-4 p-4 mb-6">
					<div class="d-flex items-center gap-3">
						<span class="alert-icon">@components.IconAlert("icon-sm")</span>
						<div class="stack-xs">
							<div class="font-bold">نظام ذاكرة القرارات معطّل حالياً</div>
							<div class="text-sm text-secondary">
								جميع وحدات المنصة (الطلب الذكي، استيراد الكتالوج، أداة المقارنة، والتعرف التلقائي) لن تستخدم أي قرارات مخزنة مسبقاً ولن تقوم بحفظ قرارات جديدة حتى يتم إعادة التفعيل من هذا القسم.
							</div>
						</div>
					</div>
					<form method="POST" action="/admin/match-decisions/toggle-state" class="m-0">
						<input type="hidden" name="enabled" value="true" />
						<button type="submit" class="btn btn-primary btn-sm font-bold">
							تشغيل الآن
						</button>
					</form>
				</div>
			}

			<!-- Stats Grid -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-value tabular-nums">
						{ fmt.Sprintf("%d", data.Total) }
					</div>
					<div class="stat-card-label">
						إجمالي القرارات المخزنة
					</div>
				</div>
				<div class="stat-card-3d">
					<div class="stat-card-value tabular-nums">
						{{
							hitTotal := int64(0)
							for _, d := range data.Decisions {
								hitTotal += d.HitCount
							}
						}}
						{ fmt.Sprintf("%d", hitTotal) }
					</div>
					<div class="stat-card-label">
						مرات إعادة الاستخدام في الصفحة
					</div>
				</div>
				<div class="stat-card-3d">
					<div class="stat-card-value tabular-nums">
						if data.IsEnabled {
							<span class="text-success">مفعّل (ON)</span>
						} else {
							<span class="text-danger">معطّل (OFF)</span>
						}
					</div>
					<div class="stat-card-label">
						حالة المفتاح العام للنظام
					</div>
				</div>
			</div>

			<!-- Search & Filter Card -->
			<div class="filter-bar">
				<form method="GET" action="/admin/match-decisions" class="filter-bar d-flex items-center gap-3 flex-wrap p-4">
					<div class="flex-1 min-w-48">
						<input
							type="text"
							name="q"
							value={ data.Search }
							placeholder="بحث بنص الصنف، اسم الدواء بالكتالوج، أو الكود..."
							class="form-control form-input"
						/>
					</div>

					<input type="hidden" name="limit" value={ fmt.Sprintf("%d", data.PerPage) }/>

					<button type="submit" class="btn btn-primary btn-sm font-bold">
						بحث
					</button>

					if data.Search != "" {
						<a href="/admin/match-decisions" class="btn btn-secondary btn-sm">
							إلغاء البحث
						</a>
					}
				</form>
			</div>

			<!-- Main Table Card -->
			<div class="glass-panel">
				<div class="table-responsive">
					<table class="data-table">
						<thead>
							<tr>
								<th>#</th>
								<th>المنشأة المربوطة</th>
								<th>النص الوارد (Norm Name)</th>
								<th>الصنف المعتمد بالكتالوج</th>
								<th>نسبة التطابق</th>
								<th>الاستخدامات</th>
								<th>السبب / التفسير</th>
								<th>تاريخ الاستخدام</th>
								<th class="col-actions">إجراءات</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Decisions) == 0 {
								<tr>
									<td colspan="9" class="p-8 text-center">
										<div class="empty-state d-flex flex-column items-center justify-center p-6">
											<div class="empty-state-icon text-muted mb-2">@components.IconSparkles("icon-md")</div>
											<div class="empty-state-title font-bold text-base mb-1">لا توجد قرارات مطابقة مخزنة حالياً</div>
											<div class="empty-state-desc text-sm text-secondary">عند قيام المستخدمين باتخاذ قرارات مطابقة أو تصحيح يدوي سيتم حفظها هنا فورياً.</div>
										</div>
									</td>
								</tr>
							}
							for _, d := range data.Decisions {
								<tr class="rule-bottom">
									<!-- ID -->
									<td class="tabular-nums">
										{ fmt.Sprintf("%d", d.ID) }
									</td>

									<!-- Organization Scope -->
									<td>
										if d.OrganizationID != nil && *d.OrganizationID > 0 {
											<span class="badge badge-sky">
												منشأة #{ fmt.Sprintf("%d", *d.OrganizationID) }
											</span>
										} else {
											<span class="badge badge-slate text-xs">
												عام للمنصة
											</span>
										}
									</td>

									<!-- Norm Name -->
									<td>
										<div class="font-medium text-sm">
											{ d.NormName }
										</div>
										<div class="text-xs text-muted font-mono" title={ d.DecisionKey }>
											{ d.PromptVersion }
										</div>
									</td>

									<!-- Chosen Catalog Product -->
									<td>
										if d.ChosenProductID != nil && *d.ChosenProductID > 0 {
											<div class="font-medium text-sm">
												if d.ChosenProductName != "" {
													{ d.ChosenProductName }
												} else {
													صنف كتالوج #{ fmt.Sprintf("%d", *d.ChosenProductID) }
												}
											</div>
											<div class="d-flex items-center gap-2 text-xs text-secondary">
												<span class="tabular-nums">
													#{ fmt.Sprintf("%d", *d.ChosenProductID) }
												</span>
												if d.ChosenProductSKU != "" {
													<span class="badge badge-slate">
														كود: { d.ChosenProductSKU }
													</span>
												}
											</div>
										} else {
											<span class="badge badge-rose">
												لا يوجد تطابق موثوق (Non-match)
											</span>
										}
									</td>

									<!-- Confidence Score (نسبة التطابق) -->
									<td class="tabular-nums font-bold">
										if d.Confidence > 0 {
											<span>
												{ fmt.Sprintf("%.0f%%", d.Confidence*100) }
											</span>
										} else {
											<span>0%</span>
										}
									</td>

									<!-- Hit Count -->
									<td class="tabular-nums">
										<span class="badge badge-slate">
											{ fmt.Sprintf("%d", d.HitCount) }
										</span>
									</td>

									<!-- Reason -->
									<td>
										if d.Reason != "" {
											{ d.Reason }
										} else {
											<span class="text-muted">—</span>
										}
									</td>

									<!-- Last Used At -->
									<td class="tabular-nums">
										{ d.LastUsedAt.Format("2006-01-02 03:04 PM") }
									</td>

									<!-- Actions -->
									<td class="col-actions">
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/match-decisions/%d/delete", d.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف هذا القرار من الذاكرة؟');" class="m-0">
											<input type="hidden" name="q" value={ data.Search } />
											<input type="hidden" name="page" value={ fmt.Sprint(data.Page) } />
											<input type="hidden" name="limit" value={ fmt.Sprint(data.PerPage) } />
											<button type="submit" class="btn btn-outline-danger btn-xs" title="حذف هذا القرار">
												@components.IconTrash("icon-sm")
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				@components.B2BPagination(components.PaginationProps{
					CurrentPage: data.Page,
					PageSize:    data.PerPage,
					TotalCount:  data.Total,
					BaseURL:     "/admin/match-decisions",
					QueryValues: url.Values{"q": {data.Search}},
				})
			</div>
		</div>

		<!-- Clear All Modal / Confirmation Script -->
		<script>
			function confirmClearAllDecisions() {
				if (confirm("تحذير: هل أنت متأكد من رغبتك في مسح كافة قرارات المطابقة المخزنة بالكامل؟ هذا الإجراء سيجعل النظام يعيد تقييم الأصناف الجديدة من البداية.")) {
					var form = document.createElement('form');
					form.method = 'POST';
					form.action = '/admin/match-decisions/clear';
					document.body.appendChild(form);
					form.submit();
				}
			}
		</script>
	}
}
