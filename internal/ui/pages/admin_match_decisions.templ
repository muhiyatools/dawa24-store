package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminMatchDecisionsData struct {
	Decisions []*catalog.MatchDecisionView
	Total     int
	Page      int
	PerPage   int
	Search    string
}

func buildAdminMatchDecisionsURL(search string, page, limit int) string {
	vals := url.Values{}
	if search != "" {
		vals.Set("q", search)
	}
	if page > 1 {
		vals.Set("page", fmt.Sprintf("%d", page))
	}
	if limit != 50 && limit != 0 {
		vals.Set("limit", fmt.Sprintf("%d", limit))
	}
	base := "/admin/match-decisions"
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

templ AdminMatchDecisionsPage(lang, dir string, data AdminMatchDecisionsData) {
	@layouts.AdminShell("ذاكرة قرارات المطابقة (AI & Matching Decisions)", "match_decisions", lang, dir) {
		<div class="container-fluid" style="max-width:1380px; margin:0 auto; padding:1.5rem 1rem; display:flex; flex-direction:column; gap:1.5rem;">
			
			<!-- Header Banner -->
			<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; border-bottom:1px solid var(--border); padding-bottom:1.25rem;">
				<div>
					<h1 style="font-size:1.5rem; font-weight:800; color:var(--text); margin:0 0 0.4rem 0;">
						⚡ ذاكرة قرارات المطابقة الذكية (Decision Memories)
					</h1>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0; line-height:1.5;">
						القرارات التي اتخذها محرك المطابقة والذكاء الاصطناعي وتم تخزينها في الكتالوج المركزي لإعادة استخدامها وتسريع عمليات الاستيراد والطلب الذكي.
					</p>
				</div>
				<div style="display:flex; align-items:center; gap:0.75rem;">
					<button
						type="button"
						class="btn btn-outline-danger btn-sm fw-700"
						onclick="confirmClearAllDecisions()"
						title="مسح كافة القرارات المخزنة">
						🗑️ مسح الذاكرة بالكامل
					</button>
				</div>
			</div>

			<!-- Stats Grid -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem;">
				<div class="card" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div style="font-size:1.75rem; font-weight:800; color:var(--primary-700);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Total) }
					</div>
					<div style="font-size:0.825rem; font-weight:600; color:var(--text-secondary); margin-top:0.25rem;">
						إجمالي القرارات المخزنة
					</div>
				</div>
				<div class="card" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div style="font-size:1.75rem; font-weight:800; color:var(--accent);" class="tabular-nums">
						{{
							hitTotal := int64(0)
							for _, d := range data.Decisions {
								hitTotal += d.HitCount
							}
						}}
						{ fmt.Sprintf("%d", hitTotal) }
					</div>
					<div style="font-size:0.825rem; font-weight:600; color:var(--text-secondary); margin-top:0.25rem;">
						مرات إعادة الاستخدام في الصفحة
					</div>
				</div>
			</div>

			<!-- Search & Filter Card -->
			<div class="card" style="padding:1rem 1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
				<form method="GET" action="/admin/match-decisions" style="display:flex; flex-wrap:wrap; align-items:center; gap:0.75rem; margin:0;">
					<div style="flex:1; min-width:260px;">
						<input
							type="text"
							name="q"
							value={ data.Search }
							placeholder="بحث بنص الصنف، اسم الدواء بالكتالوج، أو الكود..."
							class="form-control"
							style="width:100%; height:38px; font-size:0.875rem;"
						/>
					</div>

					<div style="min-width:130px;">
						<select name="limit" onchange="this.form.submit()" class="form-select" style="height:38px; font-size:0.85rem; width:100%;">
							<option value="25" selected?={ data.PerPage == 25 }>25 عنصر</option>
							<option value="50" selected?={ data.PerPage == 50 || data.PerPage == 0 }>50 عنصر</option>
							<option value="100" selected?={ data.PerPage == 100 }>100 عنصر</option>
							<option value="200" selected?={ data.PerPage == 200 }>200 عنصر</option>
						</select>
					</div>

					<button type="submit" class="btn btn-primary btn-sm fw-700" style="height:38px; padding:0 1.25rem;">
						🔍 بحث
					</button>

					if data.Search != "" {
						<a href="/admin/match-decisions" class="btn btn-secondary btn-sm" style="height:38px;">
							إلغاء البحث
						</a>
					}
				</form>
			</div>

			<!-- Main Table Card -->
			<div class="card" style="padding:0; overflow:hidden; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); box-shadow:var(--shadow-xs);">
				<div class="table-responsive">
					<table class="table" style="margin:0; width:100%; border-collapse:collapse;">
						<thead>
							<tr style="background:var(--surface-sunken); border-bottom:1px solid var(--border); font-size:0.825rem; text-align:start;">
								<th style="padding:0.85rem 0.75rem; width:65px; text-align:center;">#</th>
								<th style="padding:0.85rem 1rem; min-width:240px;">النص الوارد (Norm Name)</th>
								<th style="padding:0.85rem 1rem; min-width:280px;">الصنف المعتمد بالكتالوج</th>
								<th style="padding:0.85rem 0.75rem; width:110px; text-align:center;">نسبة التطابق</th>
								<th style="padding:0.85rem 0.75rem; width:95px; text-align:center;">الاستخدامات</th>
								<th style="padding:0.85rem 1rem; min-width:220px;">السبب / التفسير</th>
								<th style="padding:0.85rem 0.75rem; width:130px; text-align:center;">تاريخ الاستخدام</th>
								<th style="padding:0.85rem 0.75rem; width:90px; text-align:center;">إجراءات</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Decisions) == 0 {
								<tr>
									<td colspan="8" style="text-align:center; padding:3rem 1rem; color:var(--text-muted);">
										<div style="font-size:2rem; margin-bottom:0.5rem;">🧠</div>
										<div style="font-weight:700; font-size:1rem; color:var(--text);">لا توجد قرارات مطابقة مخزنة حالياً</div>
										<div style="font-size:0.85rem; margin-top:0.25rem;">عند استيراد ملفات جديدة أو تشغيل المطابقة الذكية سيتم حفظ القرارات الموثوقة هنا تلقائياً.</div>
									</td>
								</tr>
							}
							for _, d := range data.Decisions {
								<tr style="border-bottom:1px solid var(--border);">
									<!-- ID -->
									<td style="padding:0.85rem 0.75rem; text-align:center; font-weight:700; color:var(--text-muted); font-size:0.8rem;" class="tabular-nums">
										{ fmt.Sprintf("%d", d.ID) }
									</td>

									<!-- Norm Name -->
									<td style="padding:0.85rem 1rem;">
										<div style="font-weight:700; font-size:0.9rem; color:var(--text); line-height:1.4;">
											{ d.NormName }
										</div>
										<div style="font-size:0.7rem; color:var(--text-muted); font-family:monospace; margin-top:0.2rem;" title={ d.DecisionKey }>
											{ d.PromptVersion }
										</div>
									</td>

									<!-- Chosen Catalog Product -->
									<td style="padding:0.85rem 1rem;">
										if d.ChosenProductID != nil && *d.ChosenProductID > 0 {
											<div style="font-weight:700; font-size:0.875rem; color:var(--primary-700);">
												if d.ChosenProductName != "" {
													{ d.ChosenProductName }
												} else {
													صنف كتالوج #{ fmt.Sprintf("%d", *d.ChosenProductID) }
												}
											</div>
											<div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.2rem;">
												<span style="font-size:0.725rem; color:var(--accent); font-family:monospace; font-weight:700;">
													#{ fmt.Sprintf("%d", *d.ChosenProductID) }
												</span>
												if d.ChosenProductSKU != "" {
													<span class="badge badge-slate" style="font-size:0.675rem;">
														كود: { d.ChosenProductSKU }
													</span>
												}
											</div>
										} else {
											<span class="badge badge-rose" style="font-size:0.75rem; font-weight:700;">
												لا يوجد تطابق موثوق (Non-match)
											</span>
										}
									</td>

									<!-- Confidence Score (نسبة التطابق) -->
									<td style="padding:0.85rem 0.75rem; text-align:center; font-weight:700; font-size:0.85rem;" class="tabular-nums">
										if d.Confidence > 0 {
											<span style="display:inline-block; padding:0.2rem 0.5rem; border-radius:var(--radius-full); background:rgba(16,185,129,0.12); color:var(--primary-700); font-size:0.8rem; font-weight:800;">
												{ fmt.Sprintf("%.0f%%", d.Confidence*100) }
											</span>
										} else {
											<span style="color:var(--text-muted); font-size:0.8rem;">0%</span>
										}
									</td>

									<!-- Hit Count -->
									<td style="padding:0.85rem 0.75rem; text-align:center; font-weight:800; font-size:0.875rem;" class="tabular-nums">
										<span class="badge badge-slate" style="font-size:0.75rem; padding:0.25rem 0.6rem;">
											{ fmt.Sprintf("%d", d.HitCount) }
										</span>
									</td>

									<!-- Reason -->
									<td style="padding:0.85rem 1rem; font-size:0.825rem; color:var(--text-secondary); line-height:1.4;">
										if d.Reason != "" {
											{ d.Reason }
										} else {
											<span style="color:var(--text-muted);">—</span>
										}
									</td>

									<!-- Last Used At -->
									<td style="padding:0.85rem 0.75rem; text-align:center; font-size:0.775rem; color:var(--text-muted);" class="tabular-nums">
										{ d.LastUsedAt.Format("2006-01-02 15:04") }
									</td>

									<!-- Actions -->
									<td style="padding:0.85rem 0.75rem; text-align:center;">
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/match-decisions/%d/delete", d.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف هذا القرار من الذاكرة؟');" style="margin:0;">
											<input type="hidden" name="q" value={ data.Search } />
											<input type="hidden" name="page" value={ fmt.Sprint(data.Page) } />
											<input type="hidden" name="limit" value={ fmt.Sprint(data.PerPage) } />
											<button type="submit" class="btn btn-outline-danger btn-xs" title="حذف هذا القرار">
												🗑️
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<!-- Pagination Bar -->
				if data.Total > data.PerPage {
					<div style="display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1.25rem; border-top:1px solid var(--border); background:var(--surface-sunken); font-size:0.85rem;">
						<div style="color:var(--text-secondary);">
							إجمالي النتائج: <strong>{ fmt.Sprintf("%d", data.Total) }</strong>
						</div>
						<div style="display:flex; align-items:center; gap:0.5rem;">
							if data.Page > 1 {
								<a href={ templ.SafeURL(buildAdminMatchDecisionsURL(data.Search, data.Page-1, data.PerPage)) } class="btn btn-secondary btn-xs">
									السابق
								</a>
							}
							<span style="font-weight:700; color:var(--text); padding:0 0.4rem;">
								صفحة { fmt.Sprintf("%d", data.Page) }
							</span>
							if data.Page * data.PerPage < data.Total {
								<a href={ templ.SafeURL(buildAdminMatchDecisionsURL(data.Search, data.Page+1, data.PerPage)) } class="btn btn-secondary btn-xs">
									التالي
								</a>
							}
						</div>
					</div>
				}
			</div>
		</div>

		<!-- Clear All Modal / Confirmation Script -->
		<script>
			function confirmClearAllDecisions() {
				if (confirm("⚠️ تحذير: هل أنت متأكد من رغبتك في مسح كافة قرارات المطابقة المخزنة بالكامل؟ هذا الإجراء سيجعل النظام يعيد تقييم الأصناف الجديدة من البداية.")) {
					var form = document.createElement('form');
					form.method = 'POST';
					form.action = '/admin/match-decisions/clear';
					document.body.appendChild(form);
					form.submit();
				}
			}
		</script>
	}
}
