package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminMatchDecisionsData struct {
	Decisions []*catalog.MatchDecisionView
	Total     int
	Page      int
	PerPage   int
	Search    string
	IsEnabled bool
}

func buildAdminMatchDecisionsURL(search string, page, limit int) string {
	vals := url.Values{}
	if search != "" {
		vals.Set("q", search)
	}
	if page > 1 {
		vals.Set("page", fmt.Sprintf("%d", page))
	}
	if limit != 50 && limit != 0 {
		vals.Set("limit", fmt.Sprintf("%d", limit))
	}
	base := "/admin/match-decisions"
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

templ AdminMatchDecisionsPage(lang, dir string, data AdminMatchDecisionsData) {
	@layouts.AdminShell("ذاكرة قرارات المطابقة (AI & Matching Decisions)", "match_decisions", lang, dir) {
		<div class="container-fluid">
			
			<!-- Header Banner -->
			<div>
				<div>
					<div>
						<h1>
							ذاكرة قرارات المطابقة الذكية (Decision Memories)
						</h1>
						if data.IsEnabled {
							<span class="badge badge-emerald">
								النظام مفعّل ونشط
							</span>
						} else {
							<span class="badge badge-rose">
								النظام معطّل بالكامل
							</span>
						}
					</div>
					<p>
						إدارة وتحكم مركزي في ذاكرة القرارات. عند تفعيل النظام، يتم عزل وتطبيق قرارات كل صيدلية ومورد على حدة لتسريع وتوحيد عمليات الاستيراد والطلب الذكي.
					</p>
				</div>
				<div class="d-flex items-center gap-3">
					<!-- Global Toggle Button -->
					<form method="POST" action="/admin/match-decisions/toggle-state" class="m-0">
						if data.IsEnabled {
							<input type="hidden" name="enabled" value="false" />
							<button
								type="submit"
								class="btn btn-outline-warning btn-sm fw-700"
								onclick="return confirm('هل أنت متأكد من رغبتك في إيقاف نظام ذاكرة القرارات بالكامل؟ لن تستخدم عمليات الاستيراد والطلب الذكي أي ذاكرة مخزنة حتى إعادة التفعيل.');"
								title="إيقاف النظام مؤقتاً">
								⏸️ إيقاف ذاكرة القرارات
							</button>
						} else {
							<input type="hidden" name="enabled" value="true" />
							<button
								type="submit"
								class="btn btn-primary btn-sm fw-700"
								title="تشغيل نظام ذاكرة القرارات">
								▶️ تفعيل ذاكرة القرارات
							</button>
						}
					</form>

					if data.Total > 0 {
						<button
							type="button"
							class="btn btn-outline-danger btn-sm fw-700"
							onclick="confirmClearAllDecisions()"
							title="مسح كافة القرارات المخزنة">
							مسح الذاكرة بالكامل
						</button>
					}
				</div>
			</div>

			<!-- Status Alert Banner if Disabled -->
			if !data.IsEnabled {
				<div class="card">
					<div>@components.IconAlert("icon-sm")</div>
					<div>
						<div>نظام ذاكرة القرارات معطّل حالياً</div>
						<div>
							جميع وحدات المنصة (الطلب الذكي، استيراد الكتالوج، أداة المقارنة، والتعرف التلقائي) لن تستخدم أي قرارات مخزنة مسبقاً ولن تقوم بحفظ قرارات جديدة حتى يتم إعادة التفعيل من هذا القسم.
						</div>
					</div>
					<form method="POST" action="/admin/match-decisions/toggle-state" class="m-0">
						<input type="hidden" name="enabled" value="true" />
						<button type="submit" class="btn btn-primary btn-sm fw-700">
							تشغيل الآن
						</button>
					</form>
				</div>
			}

			<!-- Stats Grid -->
			<div>
				<div class="card">
					<div class="tabular-nums">
						{ fmt.Sprintf("%d", data.Total) }
					</div>
					<div>
						إجمالي القرارات المخزنة
					</div>
				</div>
				<div class="card">
					<div class="tabular-nums">
						{{
							hitTotal := int64(0)
							for _, d := range data.Decisions {
								hitTotal += d.HitCount
							}
						}}
						{ fmt.Sprintf("%d", hitTotal) }
					</div>
					<div>
						مرات إعادة الاستخدام في الصفحة
					</div>
				</div>
				<div class="card">
					<div class="tabular-nums">
						if data.IsEnabled {
							<span>مفعّل (ON)</span>
						} else {
							<span>معطّل (OFF)</span>
						}
					</div>
					<div>
						حالة المفتاح العام للنظام
					</div>
				</div>
			</div>

			<!-- Search & Filter Card -->
			<div class="card">
				<form method="GET" action="/admin/match-decisions">
					<div>
						<input
							type="text"
							name="q"
							value={ data.Search }
							placeholder="بحث بنص الصنف، اسم الدواء بالكتالوج، أو الكود..."
							class="form-control"
						
						/>
					</div>

					<div>
						<select name="limit" onchange="this.form.submit()" class="form-select">
							<option value="25" selected?={ data.PerPage == 25 }>25 عنصر</option>
							<option value="50" selected?={ data.PerPage == 50 || data.PerPage == 0 }>50 عنصر</option>
							<option value="100" selected?={ data.PerPage == 100 }>100 عنصر</option>
							<option value="200" selected?={ data.PerPage == 200 }>200 عنصر</option>
						</select>
					</div>

					<button type="submit" class="btn btn-primary btn-sm fw-700">
						بحث
					</button>

					if data.Search != "" {
						<a href="/admin/match-decisions" class="btn btn-secondary btn-sm">
							إلغاء البحث
						</a>
					}
				</form>
			</div>

			<!-- Main Table Card -->
			<div class="card">
				<div class="table-responsive">
					<table class="data-table">
						<thead>
							<tr>
								<th>#</th>
								<th>المنشأة المربوطة</th>
								<th>النص الوارد (Norm Name)</th>
								<th>الصنف المعتمد بالكتالوج</th>
								<th>نسبة التطابق</th>
								<th>الاستخدامات</th>
								<th>السبب / التفسير</th>
								<th>تاريخ الاستخدام</th>
								<th>إجراءات</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Decisions) == 0 {
								<tr>
									<td colspan="9">
										<div>@components.IconSparkles("icon-sm")</div>
										<div>لا توجد قرارات مطابقة مخزنة حالياً</div>
										<div>عند قيام المستخدمين باتخاذ قرارات مطابقة أو تصحيح يدوي سيتم حفظها هنا فورياً.</div>
									</td>
								</tr>
							}
							for _, d := range data.Decisions {
								<tr class="rule-bottom">
									<!-- ID -->
									<td class="tabular-nums">
										{ fmt.Sprintf("%d", d.ID) }
									</td>

									<!-- Organization Scope -->
									<td>
										if d.OrganizationID != nil && *d.OrganizationID > 0 {
											<span class="badge badge-sky">
												منشأة #{ fmt.Sprintf("%d", *d.OrganizationID) }
											</span>
										} else {
											<span class="badge badge-slate text-xs">
												عام للمنصة
											</span>
										}
									</td>

									<!-- Norm Name -->
									<td>
										<div>
											{ d.NormName }
										</div>
										<div title={ d.DecisionKey }>
											{ d.PromptVersion }
										</div>
									</td>

									<!-- Chosen Catalog Product -->
									<td>
										if d.ChosenProductID != nil && *d.ChosenProductID > 0 {
											<div>
												if d.ChosenProductName != "" {
													{ d.ChosenProductName }
												} else {
													صنف كتالوج #{ fmt.Sprintf("%d", *d.ChosenProductID) }
												}
											</div>
											<div>
												<span>
													#{ fmt.Sprintf("%d", *d.ChosenProductID) }
												</span>
												if d.ChosenProductSKU != "" {
													<span class="badge badge-slate">
														كود: { d.ChosenProductSKU }
													</span>
												}
											</div>
										} else {
											<span class="badge badge-rose">
												لا يوجد تطابق موثوق (Non-match)
											</span>
										}
									</td>

									<!-- Confidence Score (نسبة التطابق) -->
									<td class="tabular-nums">
										if d.Confidence > 0 {
											<span>
												{ fmt.Sprintf("%.0f%%", d.Confidence*100) }
											</span>
										} else {
											<span>0%</span>
										}
									</td>

									<!-- Hit Count -->
									<td class="tabular-nums">
										<span class="badge badge-slate">
											{ fmt.Sprintf("%d", d.HitCount) }
										</span>
									</td>

									<!-- Reason -->
									<td>
										if d.Reason != "" {
											{ d.Reason }
										} else {
											<span class="text-muted">—</span>
										}
									</td>

									<!-- Last Used At -->
									<td class="tabular-nums">
										{ d.LastUsedAt.Format("2006-01-02 15:04") }
									</td>

									<!-- Actions -->
									<td>
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/match-decisions/%d/delete", d.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف هذا القرار من الذاكرة؟');">
											<input type="hidden" name="q" value={ data.Search } />
											<input type="hidden" name="page" value={ fmt.Sprint(data.Page) } />
											<input type="hidden" name="limit" value={ fmt.Sprint(data.PerPage) } />
											<button type="submit" class="btn btn-outline-danger btn-xs" title="حذف هذا القرار">
												@components.IconTrash("icon-sm")
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<!-- Pagination Bar -->
				if data.Total > data.PerPage {
					<div>
						<div>
							إجمالي النتائج: <strong>{ fmt.Sprintf("%d", data.Total) }</strong>
						</div>
						<div class="d-flex items-center gap-2">
							if data.Page > 1 {
								<a href={ templ.SafeURL(buildAdminMatchDecisionsURL(data.Search, data.Page-1, data.PerPage)) } class="btn btn-secondary btn-xs">
									السابق
								</a>
							}
							<span>
								صفحة { fmt.Sprintf("%d", data.Page) }
							</span>
							if data.Page * data.PerPage < data.Total {
								<a href={ templ.SafeURL(buildAdminMatchDecisionsURL(data.Search, data.Page+1, data.PerPage)) } class="btn btn-secondary btn-xs">
									التالي
								</a>
							}
						</div>
					</div>
				}
			</div>
		</div>

		<!-- Clear All Modal / Confirmation Script -->
		<script>
			function confirmClearAllDecisions() {
				if (confirm("تحذير: هل أنت متأكد من رغبتك في مسح كافة قرارات المطابقة المخزنة بالكامل؟ هذا الإجراء سيجعل النظام يعيد تقييم الأصناف الجديدة من البداية.")) {
					var form = document.createElement('form');
					form.method = 'POST';
					form.action = '/admin/match-decisions/clear';
					document.body.appendChild(form);
					form.submit();
				}
			}
		</script>
	}
}
