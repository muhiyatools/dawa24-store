package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/ingest"
	"github.com/muhiya/dawa24-store/internal/shared/productmatch"
)

// Stages two to five of the vendor catalogue import.

// --- stage 2: mapping and validation ---------------------------------------

templ importMappingStage(view VendorImportView) {
	@importFileSummary(view)
	if view.Analysis != nil {
		@importFindings(view.Analysis)
		<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/mapping") } hx-boost="false">
			
			<!-- Core Required Fields Status Overview -->
			<div class="card">
				<h2 class="wiz-head">1. حالة الحقول الأساسية والمخزون</h2>
				<p class="wiz-sub">
					تحقق من ربط الحقول الإلزامية وحقل الكمية (المخزون). إذا لم يُكتشف أحد الحقول تلقائياً، يمكنك تحديده مباشرة من جدول الأعمدة أدناه.
				</p>
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>الحقل المطلوب</th>
								<th>أهمية الحقل</th>
								<th>حالة الربط بالملف</th>
								<th>ملاحظة المخزون والتخزين</th>
							</tr>
						</thead>
						<tbody>
							for _, st := range view.CoreFieldsStatus() {
								<tr>
									<td>
										<div class="fw-800">{ st.Label }</div>
										<div class="text-xs text-muted">{ st.Description }</div>
									</td>
									<td>
										if st.Required {
											<span class="badge badge-rose text-xs">إلزامي / أساسي</span>
										} else {
											<span class="badge badge-slate text-xs">اختياري</span>
										}
									</td>
									<td>
										if st.ColumnIndex >= 0 {
											<span class="badge badge-emerald text-xs">
												✓ مربوط بـ: { st.ColumnName }
											</span>
										} else if st.Field == productmatch.FieldQuantity {
											<span class="badge badge-sky text-xs">
												📦 غير موجود بالملف — حدد كمية افتراضية في (3) أدناه
											</span>
										} else {
											<span class="badge badge-amber text-xs">
												⚠️ لم يُربط تلقائياً — حدده من الجدول أدناه
											</span>
										}
									</td>
									<td class="text-xs text-muted">
										if st.Field == productmatch.FieldQuantity {
											if st.ColumnIndex >= 0 {
												<strong class="text-primary">يتم قيد هذه الكمية في المستودع المحدد في الخطوة التالية</strong>
											} else {
												<strong class="text-primary">يمكنك تعيين كمية موحدة في (3) أدناه أو إدخال الكميات يدوياً في المراجعة</strong>
											}
										} else {
											<span>—</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- All Columns Mapping Table -->
			<div class="card">
				<h2 class="wiz-head">2. راجع ربط الأعمدة في الملف</h2>
				<p class="wiz-sub">
					تم فحص جميع أعمدة ملفك. غيّر ما تريد لربط الحقول بدقة (مثل اختيار عمود الكمية، السعر، والاسم).
				</p>
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>العمود في ملفك</th>
								<th>عينة من القيم</th>
								<th>الحقل المربوط</th>
								<th>الثقة والسبب</th>
							</tr>
						</thead>
						<tbody>
							for _, col := range view.Analysis.Mapping.Columns {
								@importColumnRow(col)
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Section 3: Manual / Default Stock Quantity Setting -->
			<div class="card">
				<div class="row-center-sm gap-sm mb-2">
					<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.2rem;">
						📦
					</div>
					<div>
						<h2 class="wiz-head mb-0">3. تعيين كمية افتراضية للمخزون (في حال عدم وجود عمود للكمية في ملفك)</h2>
						<p class="wiz-sub mb-0">
							إذا كان ملفك يحتوي فقط على أسماء الأصناف والأسعار دون عمود للكمية، يمكنك كتابة كمية افتراضية هنا ليتم تطبيقها على كافة الأصناف تلقائياً، مع إمكانية تعديل كمية أي صنف يدوياً لاحقاً في مرحلة المراجعة.
						</p>
					</div>
				</div>

				<div class="row-center-sm gap-md flex-wrap mt-3" style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
					<label class="form-label mb-0 fw-800 text-sm">
						الكمية الافتراضية لكل صنف:
					</label>
					<input type="number" name="default_quantity" min="0" placeholder="مثال: 50 أو 100"
						value={ defaultQuantityDisplay(view.Session) }
						class="form-input tabular-nums fw-700 text-center"
						style="width:140px; height:42px; font-size:1rem; border-radius:var(--radius-lg);"/>
					<span class="text-xs text-muted">
						(عبوة / وحدة لكل صنف مستورد) — ستُسجَّل تلقائياً في رصيد المستودع المختار.
					</span>
				</div>
			</div>

			<div class="card mb-0">
				<div class="wiz-actions">
					<span class="wiz-actions-note">لن يُكتب أي صنف بعد — الخطوة التالية هي تحديد المستودع والإعدادات.</span>
					<div class="row-center">
						<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/cancel") }>
							<button type="submit" class="btn btn-ghost">إلغاء</button>
						</form>
						<button type="submit" class="btn btn-primary">اعتماد الربط والمتابعة ←</button>
					</div>
				</div>
			</div>
		</form>
	}
}

templ importColumnRow(col *productmatch.Column) {
	<tr>
		<td>
			<div class="fw-800">
				if col.Header != "" {
					{ col.Header }
				} else {
					{ fmt.Sprintf("العمود %d", col.Index+1) }
				}
			</div>
			<div class="text-xs text-muted">{ fmt.Sprintf("العمود رقم %d", col.Index+1) }</div>
		</td>
		<td class="text-xs text-muted">{ strings.Join(col.Preview, " · ") }</td>
		<td>
			<select name={ fmt.Sprintf("column_%d", col.Index) } class="form-input">
				<option value="" selected?={ col.Field == "" && !col.Ignored }>— حدد تلقائياً —</option>
				<option value="__none" selected?={ false }>لا تستورد هذا العمود</option>
				<option value="__ignore" selected?={ col.Ignored }>تجاهل نهائياً</option>
				for _, spec := range FieldChoices() {
					<option value={ string(spec.Field) } selected?={ col.Field == spec.Field }>
						{ spec.Label }
					</option>
				}
			</select>
		</td>
		<td>
			if col.Field != "" {
				<span class={ "badge", ConfidenceTone(col.Confidence), "text-xs" }>
					{ col.Confidence.Label() } · { PercentText(col.Score) }
				</span>
				for _, why := range col.Why {
					<div class="text-xs text-muted mt-1">· { why }</div>
				}
			} else {
				<span class="badge badge-slate text-xs">بدون ربط</span>
			}
		</td>
	</tr>
}

templ importFindings(a *productmatch.Analysis) {
	if len(a.Mapping.Conflicts) > 0 || len(a.Mapping.Notes) > 0 {
		<div class="card">
			<h2 class="wiz-head">التحقق</h2>
			<p class="wiz-sub">ما يجب أن تنظر إليه قبل المتابعة. لا شيء هنا يمنع الاستيراد إلا ما هو موسوم بـ«خطأ».</p>
			for _, c := range a.Mapping.Conflicts {
				<div class="row-center-sm mb-2">
					<span class={ "badge", SeverityTone(c.Severity), "text-xs" }>
						if c.Severity == productmatch.SeverityError {
							خطأ
						} else if c.Severity == productmatch.SeverityWarning {
							تنبيه
						} else {
							معلومة
						}
					</span>
					<span class="text-sm">{ c.Message }</span>
				</div>
			}
			for _, n := range a.Mapping.Notes {
				<div class="row-center-sm mb-2">
					<span class="badge badge-slate text-xs">معلومة</span>
					<span class="text-sm">{ n.Message }</span>
				</div>
			}
		</div>
	}
}

templ importFileSummary(view VendorImportView) {
	<div class="card">
		<div class="wiz-stats">
			@importStat("الملف", view.Session.Filename)
			@importStat("الصيغة", view.Session.Source.Format.Label())
			if view.Session.Source.Sheet != "" {
				@importStat("ورقة العمل", view.Session.Source.Sheet)
			}
			@importStat("عدد الصفوف", fmt.Sprint(view.Session.Source.TotalRows))
			@importStat("الحجم", FileSizeText(view.Session.FileSizeBytes))
		</div>
	</div>
}

templ importStat(label, value string) {
	<div class="wiz-stat">
		<div class="wiz-stat-value text-sm">{ value }</div>
		<div class="wiz-stat-label">{ label }</div>
	</div>
}

// --- stage 3: settings -----------------------------------------------------

templ importSettingsStage(view VendorImportView) {
	<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/settings") } hx-boost="false">
		<div class="card">
			<h2 class="wiz-head">3. إعدادات الاستيراد</h2>
			<p class="wiz-sub">اختر المخزن وطريقة التعامل مع الأصناف والأرصدة. القيم الافتراضية هي الأكثر تحفظاً.</p>
			<div class="stack-lg">
				<div>
					<label class="form-label">المستودع الذي ستُسجَّل فيه الأرصدة والكميات المستوردة <span class="text-danger">*</span></label>
					<select name="warehouse_id" class="form-input" required>
						<option value="">— اختر المستودع —</option>
						for _, wh := range view.Warehouses {
							<option value={ fmt.Sprint(wh.ID) } selected?={ view.Session.Settings.WarehouseID == wh.ID }>
								{ wh.Name }
							</option>
						}
					</select>
					<div class="text-xs text-muted mt-1">سيتم إيداع كميات جميع الأصناف المستوردة والمطابقة مباشرة في رصيد هذا المستودع.</div>
				</div>
			</div>
		</div>
		<div class="card">
			<h3 class="wiz-head">ماذا نفعل بأصناف كتالوجك؟</h3>
			<div class="wiz-choices">
				for _, opt := range ImportModeOptions() {
					<label class="wiz-choice">
						<input type="radio" name="mode" value={ string(opt.Mode) } checked?={ view.Session.Settings.Mode == opt.Mode }/>
						<span class="wiz-choice-body">
							<span class="wiz-choice-icon">{ opt.Icon }</span>
							<span>
								<span class="wiz-choice-title">{ opt.Title }</span>
								<span class="wiz-choice-text">{ opt.Description }</span>
								if opt.Destructive {
									<span class="wiz-choice-warn">سيوقف عرض الأصناف غير الموجودة في الملف</span>
								}
							</span>
						</span>
					</label>
				}
			</div>
		</div>
		<div class="card">
			<h3 class="wiz-head">ماذا تعني الكمية في ملفك؟</h3>
			<div class="wiz-choices">
				for _, mode := range StockModeOptions() {
					<label class="wiz-choice">
						<input type="radio" name="stock_mode" value={ string(mode) } checked?={ view.Session.Settings.StockMode == mode }/>
						<span class="wiz-choice-body">
							<span class="wiz-choice-icon">📦</span>
							<span><span class="wiz-choice-title">{ mode.Label() }</span></span>
						</span>
					</label>
				}
			</div>
		</div>
		<div class="card">
			<h3 class="wiz-head">مراجعة الأصناف قبل الإضافة</h3>
			<p class="wiz-sub">
				لن يُضاف أي صنف تلقائياً إلى قاعدة البيانات. بعد معالجة الملف، ستنتقل إلى شاشة مراجعة تفاعلية منظمة
				تتيح لك معاينة كل صنف ودرجة تطابقه، وتعديل اسم الصنف أو سعره أو كميته، أو ربطه يدوياً بالكتالوج المركزي، وتحديد ما تريد استيراده أو استبعاده.
			</p>
		</div>
		<div class="card">
			<h3 class="wiz-head">المطابقة الذكية</h3>
			<p class="wiz-sub">
				نفس محرك المطابقة الذي يعمل في الطلب الذكي للصيدليات. تعمل المطابقة الحتمية أولاً دائماً،
				ولا يصل إلى الذكاء الاصطناعي إلا ما تعذّر حسمه — وهو عادةً عشرات الأسطر من آلاف.
			</p>
			<div class="wiz-switches">
				if view.AIAvailable {
					@vendorImportSwitch("use_ai", "🤖", "تفعيل المطابقة الذكية للأصناف الصعبة",
						"لا يمسّ أي مطابقة حتمية مؤكدة، ولا يختار إلا من أصناف الكتالوج المعروضة عليه.",
						view.Session.Settings.UseAI)
				} else {
					@vendorImportSwitchDisabled("🤖", "المطابقة الذكية غير متاحة حالياً",
						view.AIUnavailableReason)
				}
			</div>
			<ul class="wiz-notes text-xs text-muted" style="margin: 0.75rem 0 0; padding-inline-start: 1.1rem;">
				<li>تُراجَع ذاكرة القرارات المشتركة أولاً؛ ما سبق حسمه — في ملفك أو في ملف غيرك — لا يُرسل ولا يُحتسب.</li>
				<li>الأسطر المكررة والمرشحون المشتركون يُدمجون في طلب واحد، فالملف كاملاً بضعة طلبات مهما طال.</li>
				<li>يُعاد فحص كل اقتراح أمام الكتالوج، ويُرفض ما اختلف تركيزه أو شكله الصيدلي أو إضافته التجارية.</li>
			</ul>
		</div>
		<div class="card">
			<h3 class="wiz-head">خيارات دقيقة</h3>
			<div class="wiz-switches">
				@vendorImportSwitch("publish_immediately", "🟢", "نشر الأصناف فور استيرادها",
					"إن أُوقف، ستُضاف الأصناف موقوفة بانتظار التفعيل اليدوي لاحقاً.",
					view.Session.Settings.PublishImmediately)
				@vendorImportSwitch("reject_expired", "⛔", "رفض الأصناف منتهية الصلاحية",
					"لن يُستورد أي سطر تاريخ صلاحيته قد مضى.", view.Session.Settings.RejectExpired)
				@vendorImportSwitch("blank_quantity_is_zero", "0️⃣", "اعتبار الخلية الفارغة رصيداً صفرياً",
					"فعّله فقط إذا كان الملف يمثل جرد المخزن كاملاً.", view.Session.Settings.BlankQuantityIsZero)
				@vendorImportSwitch("infer_dosage_form", "💊", "استنتاج الشكل الصيدلي من اسم الصنف",
					"يُستخدم فقط إذا لم يوجد عمود للشكل الصيدلي.", view.Session.Settings.InferDosageForm)
				@vendorImportSwitch("infer_concentration", "🧪", "استخراج التركيز من اسم الصنف",
					"يُقتبس التركيز حرفياً من الاسم ولا يُخمَّن.", view.Session.Settings.InferConcentration)
				@vendorImportSwitch("trust_supplier_code", "🔢", "مطابقة الكتالوج المركزي بكودك الداخلي",
					"لا تفعّله إلا إذا كنت تستخدم أكواد دواء 24 نفسها.", view.Session.Settings.TrustSupplierCode)
				@vendorImportSwitch("mark_negotiable", "🤝", "تعليم الأصناف كقابلة للتفاوض", "",
					view.Session.Settings.MarkNegotiable)
				@vendorImportSwitch("record_rows", "🧾", "حفظ سجل تفصيلي لكل صف",
					"يتيح لك تصفية النتائج وتنزيل الأصناف التي تحتاج معالجة.", view.Session.Settings.RecordRows)
			</div>
			<div class="wiz-map">
				<div class="wiz-map-item">
					<span class="wiz-map-label">الكمية الافتراضية لكل صنف (إذا لم تكن محددة بالملف)</span>
					<input class="wiz-map-input" type="number" name="default_quantity" min="0" placeholder="مثال: 50 أو 100"
						value={ defaultQuantityDisplay(view.Session) }/>
					<span class="wiz-map-hint">تُطبَّق تلقائياً على كافة الأصناف التي لم يُحدد لها رصيد في الملف.</span>
				</div>
				<div class="wiz-map-item">
					<span class="wiz-map-label">أقل كمية للطلب (افتراضياً)</span>
					<input class="wiz-map-input" type="number" name="default_min_order_qty" min="1"
						value={ fmt.Sprint(view.Session.Settings.DefaultMinOrderQty) }/>
				</div>
				<div class="wiz-map-item">
					<span class="wiz-map-label">حد التنبيه للمخزون (افتراضياً)</span>
					<input class="wiz-map-input" type="number" name="default_min_threshold" min="0"
						value={ fmt.Sprint(view.Session.Settings.DefaultMinThreshold) }/>
				</div>
				<div class="wiz-map-item">
					<span class="wiz-map-label">أقل نسبة مطابقة مقبولة (%)</span>
					<input class="wiz-map-input" type="number" name="min_match_score" min="5" max="100"
						value={ fmt.Sprint(int(view.Session.Settings.MinMatchScore*100)) }/>
					<span class="wiz-map-hint">الافتراضي 30% — يمكنك تحديد أي نسبة تفضلها (حتى أقل من 50%). ما دونها يُعرض للمراجعة اليدوية.</span>
				</div>
			</div>
			<input type="hidden" name="duplicates" value={ string(view.Session.Settings.Duplicates) }/>
		</div>
		<div class="card mb-0">
			<div class="wiz-actions">
				<span class="wiz-actions-note">ستنتقل إلى جدول المراجعة التفاعلي لفحص كل صنف وتعديله قبل الحفظ النهائي.</span>
				<div class="row-center">
					<button type="submit" class="btn btn-primary">متابعة إلى مراجعة الأصناف ←</button>
				</div>
			</div>
		</div>
	</form>
	<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/back") }>
		<button type="submit" class="btn btn-ghost btn-sm">← العودة لربط الأعمدة</button>
	</form>
}

// vendorImportSwitchDisabled renders the AI switch as unavailable, with the
// reason.
//
// Showing it rather than hiding it is deliberate: a vendor who has been told
// the platform matches intelligently needs to know why it is not doing so
// today, and every reason here is one an operator can act on.
templ vendorImportSwitchDisabled(icon, title, reason string) {
	<label class="wiz-switch is-disabled">
		<input type="checkbox" disabled/>
		<span class="wiz-switch-icon">{ icon }</span>
		<span class="wiz-switch-main">
			<span class="wiz-switch-title">{ title }</span>
			if reason != "" {
				<span class="wiz-switch-text">{ reason }</span>
			}
		</span>
		<span class="wiz-track" aria-hidden="true"></span>
	</label>
}

templ vendorImportSwitch(name, icon, title, text string, on bool) {
	<label class="wiz-switch">
		<input type="checkbox" name={ name } value="1" checked?={ on }/>
		<span class="wiz-switch-icon">{ icon }</span>
		<span class="wiz-switch-main">
			<span class="wiz-switch-title">{ title }</span>
			if text != "" {
				<span class="wiz-switch-text">{ text }</span>
			}
		</span>
		<span class="wiz-track" aria-hidden="true"></span>
	</label>
}

func defaultQuantityDisplay(s *ingest.Session) string {
	if s != nil && s.Settings.DefaultQuantity > 0 {
		return fmt.Sprint(s.Settings.DefaultQuantity)
	}
	return ""
}
