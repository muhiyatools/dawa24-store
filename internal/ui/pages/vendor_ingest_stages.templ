package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/shared/productmatch"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// Stages two to five of the vendor catalogue import.

// --- stage 2: mapping and validation ---------------------------------------

templ importMappingStage(view VendorImportView, lang string) {
	@importFileSummary(view, lang)
	if view.Analysis != nil {
		@importFindings(view.Analysis, lang)
		{{ previewHeaders, previewRows := view.RawFilePreview() }}
		@components.ImportFilePreview(view.Session.Filename, previewHeaders, previewRows)
		<form class="stack-md" method="POST" action={ templ.SafeURL(view.SessionPath(view.Session.PublicID, "mapping")) } hx-boost="false">
			
			<!-- System fields, each mapped to a column of the uploaded file -->
			<div class="glass-panel p-6" x-data={ "{cols: " + view.FileColumnsJSON() + ", sample(i){const c=this.cols.find(c=>String(c.index)===String(i)); return c && c.preview ? c.preview.join(' · ') : '';}}" }>
				<h2 class="wiz-head">{ i18n.T(lang, "vendor_ingest.mapping.title") }</h2>
				<p class="wiz-sub">
					{ i18n.T(lang, "vendor_ingest.mapping.desc") }
				</p>
				if len(view.UnmappedRequired()) > 0 {
					<div class="alert alert-warning mb-4">
						<span class="fw-800">{ i18n.T(lang, "vendor_ingest.mapping.unmapped_required") }</span>
						for i, r := range view.UnmappedRequired() {
							if i > 0 {
								<span>،</span>
							}
							<span>{ r.Spec.Label }</span>
						}
					</div>
				}
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>{ i18n.T(lang, "vendor_ingest.mapping.th_system_field") }</th>
								<th>{ i18n.T(lang, "vendor_ingest.mapping.th_importance") }</th>
								<th>{ i18n.T(lang, "vendor_ingest.mapping.th_file_column") }</th>
								<th>{ i18n.T(lang, "vendor_ingest.mapping.th_sample_values") }</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range view.FieldMappingRows() {
								@importFieldRow(row, view.FileColumns(), lang)
							}
						</tbody>
					</table>
				</div>
				if len(view.UnusedColumns()) > 0 {
					<p class="text-xs text-muted mt-3">
						{ i18n.T(lang, "vendor_ingest.mapping.unused_columns") }
						for i, c := range view.UnusedColumns() {
							if i > 0 {
								<span>،</span>
							}
							<span>{ c.Title() }</span>
						}
					</p>
				}
			</div>

			<div class="glass-panel p-6 mb-0">
				<div class="wiz-actions">
					<span class="wiz-actions-note">{ i18n.T(lang, "vendor_ingest.mapping.note") }</span>
					<div class="row-center">
						<form class="stack-md" method="POST" action={ templ.SafeURL(view.SessionPath(view.Session.PublicID, "cancel")) }>
							<button type="submit" class="btn btn-ghost">{ i18n.T(lang, "vendor_ingest.mapping.btn_cancel") }</button>
						</form>
						<button type="submit" class="btn btn-primary">{ i18n.T(lang, "vendor_ingest.mapping.btn_submit") }</button>
					</div>
				</div>
			</div>
		</form>
	}
}

templ importFieldRow(row FieldMappingRow, cols []FileColumn, lang string) {
	<tr x-data={ "{ sel: '" + row.SelectedValue() + "' }" }>
		<td>
			<div class="fw-800">{ row.Spec.Label }</div>
			<div class="text-xs text-muted">{ row.Spec.Hint }</div>
			if row.Spec.Example != "" {
				<div class="text-xs text-muted">{ fmt.Sprintf(i18n.T(lang, "vendor_ingest.mapping.example_prefix"), row.Spec.Example) }</div>
			}
		</td>
		<td>
			<span class={ "badge", row.NeedTone(), "text-xs" }>{ row.NeedLabel() }</span>
		</td>
		<td>
			<select name={ row.FormName() } class="form-input" x-model="sel">
				<option value="">{ i18n.T(lang, "vendor_ingest.mapping.no_column") }</option>
				for _, c := range cols {
					<option value={ fmt.Sprint(c.Index) }>{ c.Title() }</option>
				}
			</select>
			if row.Bound() && len(row.Why) > 0 {
				<span class={ "badge", ConfidenceTone(row.Confidence), "text-xs" }>
					{ row.Confidence.Label() } · { PercentText(row.Score) }
				</span>
				for _, why := range row.Why {
					<div class="text-xs text-muted mt-1">· { why }</div>
				}
			}
		</td>
		<td class="text-xs text-muted" x-text="sample(sel)">{ fieldSampleText(row, cols) }</td>
	</tr>
}

templ importFindings(a *productmatch.Analysis, lang string) {
	if len(a.Mapping.Conflicts) > 0 || len(a.Mapping.Notes) > 0 {
		<div class="glass-panel p-6">
			<h2 class="wiz-head">{ i18n.T(lang, "vendor_ingest.mapping.findings_title") }</h2>
			<p class="wiz-sub">{ i18n.T(lang, "vendor_ingest.mapping.findings_desc") }</p>
			for _, c := range a.Mapping.Conflicts {
				<div class="row-center-sm mb-2">
					<span class={ "badge", SeverityTone(c.Severity), "text-xs" }>
						if c.Severity == productmatch.SeverityError {
							{ i18n.T(lang, "vendor_ingest.mapping.severity_error") }
						} else if c.Severity == productmatch.SeverityWarning {
							{ i18n.T(lang, "vendor_ingest.mapping.severity_warning") }
						} else {
							{ i18n.T(lang, "vendor_ingest.mapping.severity_info") }
						}
					</span>
					<span class="text-sm">{ c.Message }</span>
				</div>
			}
			for _, n := range a.Mapping.Notes {
				<div class="row-center-sm mb-2">
					<span class="badge badge-slate text-xs">{ i18n.T(lang, "vendor_ingest.mapping.severity_info") }</span>
					<span class="text-sm">{ n.Message }</span>
				</div>
			}
		</div>
	}
}

templ importFileSummary(view VendorImportView, lang string) {
	<div class="glass-panel p-6">
		<div class="wiz-stats">
			@importStat(i18n.T(lang, "vendor_ingest.summary.file"), view.Session.Filename)
			@importStat(i18n.T(lang, "vendor_ingest.summary.format"), view.Session.Source.Format.Label())
			if view.Session.Source.Sheet != "" {
				@importStat(i18n.T(lang, "vendor_ingest.summary.sheet"), view.Session.Source.Sheet)
			}
			@importStat(i18n.T(lang, "vendor_ingest.summary.rows"), fmt.Sprint(view.Session.Source.TotalRows))
			@importStat(i18n.T(lang, "vendor_ingest.summary.size"), FileSizeText(view.Session.FileSizeBytes, lang))
		</div>
	</div>
}

templ importStat(label, value string) {
	<div class="wiz-stat">
		<div class="wiz-stat-value text-sm">{ value }</div>
		<div class="wiz-stat-label">{ label }</div>
	</div>
}

// --- stage 3: settings -----------------------------------------------------

templ importSettingsStage(view VendorImportView, lang string) {
	<form class="stack-md" method="POST" action={ templ.SafeURL(view.SessionPath(view.Session.PublicID, "settings")) } hx-boost="false">
		<div class="glass-panel p-6">
			<h2 class="wiz-head">{ i18n.T(lang, "vendor_ingest.settings.title") }</h2>
			<p class="wiz-sub">{ i18n.T(lang, "vendor_ingest.settings.desc") }</p>
			<div class="stack-lg">
				<div class="stack-sm">
					<label class="form-label">{ i18n.T(lang, "vendor_ingest.settings.warehouse_lbl") } <span class="text-danger">*</span></label>
					<select name="warehouse_id" class="form-input" required>
						<option value="">{ i18n.T(lang, "vendor_ingest.settings.warehouse_select") }</option>
						for _, wh := range view.Warehouses {
							<option value={ fmt.Sprint(wh.ID) } selected?={ view.Session.Settings.WarehouseID == wh.ID }>
								{ wh.Name }
							</option>
						}
					</select>
					<div class="text-xs text-muted mt-1">{ i18n.T(lang, "vendor_ingest.settings.warehouse_hint") }</div>
				</div>
			</div>
		</div>
		<div class="glass-panel p-6">
			<h3 class="wiz-head">{ i18n.T(lang, "vendor_ingest.settings.mode_head") }</h3>
			<div class="wiz-choices">
				for _, opt := range ImportModeOptions(lang) {
					<label class="wiz-choice">
						<input type="radio" name="mode" value={ string(opt.Mode) } checked?={ view.Session.Settings.Mode == opt.Mode }/>
						<span class="wiz-choice-body">
							<span class="wiz-choice-icon">{ opt.Icon }</span>
							<span>
								<span class="wiz-choice-title">{ opt.Title }</span>
								<span class="wiz-choice-text">{ opt.Description }</span>
								if opt.Destructive {
									<span class="wiz-choice-warn">{ i18n.T(lang, "vendor_ingest.settings.mode_destructive_warn") }</span>
								}
							</span>
						</span>
					</label>
				}
			</div>
		</div>
		<div class="glass-panel p-6">
			<h3 class="wiz-head">{ i18n.T(lang, "vendor_ingest.settings.stock_head") }</h3>
			<div class="wiz-choices">
				for _, mode := range StockModeOptions() {
					<label class="wiz-choice">
						<input type="radio" name="stock_mode" value={ string(mode) } checked?={ view.Session.Settings.StockMode == mode }/>
						<span class="wiz-choice-body">
							<span class="wiz-choice-icon">@components.IconPackage("icon-sm")</span>
							<span><span class="wiz-choice-title">{ ImportStockModeLabel(mode, lang) }</span></span>
						</span>
					</label>
				}
			</div>
		</div>
		<div class="glass-panel p-6">
			<h3 class="wiz-head">{ i18n.T(lang, "vendor_ingest.settings.ai_head") }</h3>
			<div class="wiz-switches">
				if view.AIAvailable {
					@vendorImportSwitch("use_ai", "", i18n.T(lang, "vendor_ingest.settings.ai_enable"), "",
						view.Session.Settings.UseAI)
				} else {
					@vendorImportSwitchDisabled("", i18n.T(lang, "vendor_ingest.settings.ai_unavailable"),
						view.AIUnavailableReason)
				}
			</div>
		</div>
		<div class="glass-panel p-6">
			<h3 class="wiz-head">{ i18n.T(lang, "vendor_ingest.settings.ids_head") }</h3>
			<p class="wiz-sub">
				{ i18n.T(lang, "vendor_ingest.settings.ids_desc") }
			</p>
			<div class="wiz-switches">
				if view.MappedIdentifiers().Code {
					@vendorImportSwitch("trust_supplier_code", "", i18n.T(lang, "vendor_ingest.settings.trust_code"), "",
						view.Session.Settings.TrustSupplierCode)
					@vendorImportSwitch("code_is_catalog_code", "", i18n.T(lang, "vendor_ingest.settings.code_is_catalog"), "",
						view.Session.Settings.CodeIsCatalogCode)
				}
				if view.MappedIdentifiers().Barcode {
					@vendorImportSwitch("trust_barcode", "", i18n.T(lang, "vendor_ingest.settings.trust_barcode"), "",
						view.Session.Settings.TrustBarcode)
				}
				if !view.MappedIdentifiers().Code && !view.MappedIdentifiers().Barcode {
					<p class="text-xs text-muted m-0">{ i18n.T(lang, "vendor_ingest.settings.no_ids_mapped") }</p>
				}
			</div>
			<div class="wiz-map">
				<div class="wiz-map-item">
					<span class="wiz-map-label">{ i18n.T(lang, "vendor_ingest.settings.min_score_lbl") }</span>
					<input class="wiz-map-input" type="number" name="min_match_score"
						min={ fmt.Sprint(int(productmatch.DefaultMinReview*100)) } max="100"
						value={ fmt.Sprint(int(view.Session.Settings.MinMatchScore*100)) }/>
					<span class="wiz-map-hint">
						{ fmt.Sprintf(i18n.T(lang, "vendor_ingest.settings.min_score_hint"), int(productmatch.DefaultMinStrong*100)) }
					</span>
				</div>
			</div>
		</div>
		<div class="glass-panel p-6">
			<h3 class="wiz-head">{ i18n.T(lang, "vendor_ingest.settings.fine_options_head") }</h3>
			<div class="wiz-switches">
				@vendorImportSwitch("publish_immediately", "", i18n.T(lang, "vendor_ingest.settings.publish_immediately_title"),
					i18n.T(lang, "vendor_ingest.settings.publish_immediately_text"),
					view.Session.Settings.PublishImmediately)
				@vendorImportSwitch("reject_expired", "", i18n.T(lang, "vendor_ingest.settings.reject_expired_title"),
					i18n.T(lang, "vendor_ingest.settings.reject_expired_text"), view.Session.Settings.RejectExpired)
				@vendorImportSwitch("blank_quantity_is_zero", "", i18n.T(lang, "vendor_ingest.settings.blank_qty_is_zero_title"),
					i18n.T(lang, "vendor_ingest.settings.blank_qty_is_zero_text"), view.Session.Settings.BlankQuantityIsZero)
				@vendorImportSwitch("mark_negotiable", "", i18n.T(lang, "vendor_ingest.settings.mark_negotiable"), "",
					view.Session.Settings.MarkNegotiable)
				@vendorImportSwitch("record_rows", "", i18n.T(lang, "vendor_ingest.settings.record_rows_title"),
					i18n.T(lang, "vendor_ingest.settings.record_rows_text"), view.Session.Settings.RecordRows)
			</div>
			<div class="wiz-map">
				<div class="wiz-map-item">
					<span class="wiz-map-label">{ i18n.T(lang, "vendor_ingest.settings.default_min_order_qty") }</span>
					<input class="wiz-map-input" type="number" name="default_min_order_qty" min="1"
						value={ fmt.Sprint(view.Session.Settings.DefaultMinOrderQty) }/>
				</div>
				<div class="wiz-map-item">
					<span class="wiz-map-label">{ i18n.T(lang, "vendor_ingest.settings.default_min_threshold") }</span>
					<input class="wiz-map-input" type="number" name="default_min_threshold" min="0"
						value={ fmt.Sprint(view.Session.Settings.DefaultMinThreshold) }/>
				</div>
			</div>
			<input type="hidden" name="duplicates" value={ string(view.Session.Settings.Duplicates) }/>
		</div>
		<div class="glass-panel p-6 mb-0">
			<div class="wiz-actions">
				<span class="wiz-actions-note">{ i18n.T(lang, "vendor_ingest.settings.actions_note") }</span>
				<div class="row-center">
					<button type="submit" class="btn btn-primary">{ i18n.T(lang, "vendor_ingest.settings.btn_continue_review") }</button>
				</div>
			</div>
		</div>
	</form>
	<form class="stack-md" method="POST" action={ templ.SafeURL(view.SessionPath(view.Session.PublicID, "back")) }>
		<button type="submit" class="btn btn-ghost btn-sm">{ i18n.T(lang, "vendor_ingest.settings.btn_back_mapping") }</button>
	</form>
}

// vendorImportSwitchDisabled renders the AI switch as unavailable, with the
// reason.
//
// Showing it rather than hiding it is deliberate: a vendor who has been told
// the platform matches intelligently needs to know why it is not doing so
// today, and every reason here is one an operator can act on.
templ vendorImportSwitchDisabled(icon, title, reason string) {
	<label class="wiz-switch is-disabled">
		<input type="checkbox" disabled/>
		<span class="wiz-switch-icon">{ icon }</span>
		<span class="wiz-switch-main">
			<span class="wiz-switch-title">{ title }</span>
			if reason != "" {
				<span class="wiz-switch-text">{ reason }</span>
			}
		</span>
		<span class="wiz-track" aria-hidden="true"></span>
	</label>
}

templ vendorImportSwitch(name, icon, title, text string, on bool) {
	<label class="wiz-switch">
		<input type="checkbox" name={ name } value="1" checked?={ on }/>
		<span class="wiz-switch-icon">{ icon }</span>
		<span class="wiz-switch-main">
			<span class="wiz-switch-title">{ title }</span>
			if text != "" {
				<span class="wiz-switch-text">{ text }</span>
			}
		</span>
		<span class="wiz-track" aria-hidden="true"></span>
	</label>
}
