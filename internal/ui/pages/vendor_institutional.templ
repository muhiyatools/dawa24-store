package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorInstitutionalWorkPage renders vendor institutional memberships.
templ VendorInstitutionalWorkPage(works []*org.InstitutionalWork, lang, dir string) {
	@layouts.VendorShell("الأعمال المؤسسية للشركات والجهات", "institutional_work", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconBank("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">الأعمال والاتفاقيات المؤسسية للمنشأة ({ fmt.Sprintf("%d", len(works)) })</h1>
						</div>
						<p class="text-sm text-secondary m-0">إدارة عضويات الجهات الطبية، المجموعات الصيدلانية، وسلاسل التوريد الخاصة</p>
					</div>
				</div>
			</div>

			if len(works) == 0 {
				<div class="glass-panel p-8 text-center empty-state-glass">
					<div class="text-4xl mb-3">@components.IconBank("icon-sm")</div>
					<h3 class="text-lg font-black text-primary mb-2">لا توجد أعمال مؤسسية معتمدة</h3>
					<p class="text-sm text-secondary m-0">تتيح الأعمال المؤسسية تقديم عروض حصرية لفئات محددة من الصيدليات والجهات الطبية.</p>
				</div>
			} else {
				<div class="glass-panel p-0 mb-6 overflow-hidden">
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>اسم الهيكل المؤسسي</th>
									<th>الوصف</th>
									<th class="text-center">نوع التسعير</th>
									<th class="text-center">الحالة</th>
								</tr>
							</thead>
							<tbody>
								for _, w := range works {
									<tr>
										<td class="font-extrabold text-primary text-sm">{ w.Title.Get(i18n.Lang(lang)) }</td>
										<td class="text-xs text-secondary">{ w.Description.Get(i18n.Lang(lang)) }</td>
										<td class="text-center"><span class="badge badge-sky text-xs font-bold">{ string(w.PricingType) }</span></td>
										<td class="text-center">
											if w.IsActive {
												<span class="badge badge-emerald text-xs font-bold">نشط</span>
											} else {
												<span class="badge badge-slate text-xs font-bold">غير نشط</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		</div>
	}
}

// VendorPharmacyCoveragePage renders pharmacies covered by vendor schedules.
templ VendorPharmacyCoveragePage(data VendorPharmacyCoverageData, lang, dir string) {
	@layouts.VendorShell("تغطية الصيدليات وشبكة التوزيع", "pharmacy_coverage", lang, dir) {
		<div class="page-container">
			<!-- Header & Action Bar -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconGlobe("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">الصيدليات المشمولة في نطاق التغطية الأسبوعية</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							استعراض شبكة الصيدليات الواقعة داخل نطاق تغطية فروعك ومخازنك حسب المحافظة والمدينة والمسافة الجغرافية
						</p>
					</div>
					<div class="d-flex gap-2 flex-wrap">
						<a href="/vendor/coverage" class="btn btn-primary btn-sm font-bold gap-1">
							@components.IconClock("icon-xs")
							<span>إدارة جدول التغطية الأسبوعية</span>
						</a>
					</div>
				</div>
			</div>

			<!-- KPI Stat Cards -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الصيدليات المغطاة</div>
					<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", data.TotalPharmacies) }</div>
					<span class="text-xs text-secondary mt-1 d-block">صيدلية في نطاق الفروع</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-success">متاحة للتوصيل اليوم</div>
					<div class="stat-card-value text-success tabular-nums">{ fmt.Sprintf("%d", data.CoveredTodayCount) }</div>
					<span class="text-xs text-secondary mt-1 d-block">ضمن جدول خطوط سير اليوم</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">المدن والمحافظات المغطاة</div>
					<div class="stat-card-value text-brand tabular-nums">{ fmt.Sprintf("%d", len(data.CoveredCities)) }</div>
					<span class="text-xs text-secondary mt-1 d-block">نطاق جغرافي مشمول</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-secondary">فروع التوزيع المغذية</div>
					<div class="stat-card-value text-secondary tabular-nums">{ fmt.Sprintf("%d", len(data.CoveredBranches)) }</div>
					<span class="text-xs text-secondary mt-1 d-block">مراكز التوزيع النشطة</span>
				</div>
			</div>

			<!-- Filter Bar -->
			<div class="glass-panel p-4 mb-6">
				<form method="GET" action="/vendor/pharmacy-coverage" class="d-grid gap-3 items-end" style="grid-template-columns:2fr 1.2fr 1.2fr 1.2fr auto;">
					<div>
						<label class="form-label text-xs font-bold text-secondary mb-1">البحث بالاسم أو العنوان أو الهاتف</label>
						<input type="text" name="q" value={ data.SearchQuery } class="form-input text-xs w-full" placeholder="اسم الصيدلية / الفرع / العنوان..." />
					</div>

					<div>
						<label class="form-label text-xs font-bold text-secondary mb-1">يوم التوصيل</label>
						<select name="day" class="form-select text-xs w-full">
							<option value="">كافة الأيام</option>
							<option value="today" selected?={ data.FilterDay == "today" }>اليوم الحالي فقط</option>
							<option value="0" selected?={ data.FilterDay == "0" }>الأحد</option>
							<option value="1" selected?={ data.FilterDay == "1" }>الاثنين</option>
							<option value="2" selected?={ data.FilterDay == "2" }>الثلاثاء</option>
							<option value="3" selected?={ data.FilterDay == "3" }>الأربعاء</option>
							<option value="4" selected?={ data.FilterDay == "4" }>الخميس</option>
							<option value="5" selected?={ data.FilterDay == "5" }>الجمعة</option>
							<option value="6" selected?={ data.FilterDay == "6" }>السبت</option>
						</select>
					</div>

					<div>
						<label class="form-label text-xs font-bold text-secondary mb-1">فرع التوزيع</label>
						<select name="branch" class="form-select text-xs w-full">
							<option value="">كافة الفروع</option>
							for _, b := range data.CoveredBranches {
								<option value={ b } selected?={ data.FilterBranch == b }>{ b }</option>
							}
						</select>
					</div>

					<div>
						<label class="form-label text-xs font-bold text-secondary mb-1">المدينة / المنطقة</label>
						<select name="city" class="form-select text-xs w-full">
							<option value="">كافة المدن</option>
							for _, c := range data.CoveredCities {
								<option value={ c } selected?={ data.FilterCity == c }>{ c }</option>
							}
						</select>
					</div>

					<div class="d-flex items-center gap-2">
						<button type="submit" class="btn btn-primary text-xs font-bold px-4">تصفية</button>
						if data.SearchQuery != "" || data.FilterDay != "" || data.FilterBranch != "" || data.FilterCity != "" {
							<a href="/vendor/pharmacy-coverage" class="btn btn-secondary text-xs px-3" title="إعادة تعيين"></a>
						}
					</div>
				</form>
			</div>

			<!-- Pharmacies Table / Directory -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(data.Pharmacies) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconSearch("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد صيدليات مطابقة لمعايير البحث</h3>
						<p class="text-sm text-secondary max-w-md mx-auto mb-4">لم يتم العثور على صيدليات تقع ضمن نطاق التغطية المحدد. يمكنك تعديل فلاتر البحث أو توسيع نطاق جدول التغطية الأسبوعية لفروعك.</p>
						<a href="/vendor/coverage" class="btn btn-secondary btn-sm font-bold">تعديل جدول التغطية</a>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>الصيدلية والفرع</th>
									<th>المدينة والعنوان</th>
									<th>فرع التوزيع والمسافة</th>
									<th>أيام ومواعيد التوصيل</th>
									<th class="text-center">حالة التغطية اليوم</th>
									<th class="text-end">التواصل</th>
								</tr>
							</thead>
							<tbody>
								for _, p := range data.Pharmacies {
									<tr>
										<td>
											<div class="d-flex items-center gap-2">
												<div class="user-avatar-badge text-xs font-black">
													@components.IconBuilding("icon-sm")
												</div>
												<div>
													<div class="font-extrabold text-primary text-sm">
														if p.PharmacyTradeName != "" {
															{ p.PharmacyTradeName }
														} else {
															{ p.PharmacyName }
														}
													</div>
													<div class="text-xs text-muted">
														<span>{ p.BranchName }</span>
														if p.Phone != "" {
															<span class="tabular-nums" style="margin-inline-start:0.35rem;">• { p.Phone }</span>
														}
													</div>
												</div>
											</div>
										</td>
										<td>
											<div class="text-xs text-primary font-bold">
												if p.CityName != "" {
													<span class="badge badge-sky text-xs font-bold mb-1">
														{ p.CityName }
													</span>
												}
												if p.Address != "" {
													<div class="text-xs text-secondary mt-1">{ p.Address }</div>
												}
											</div>
										</td>
										<td>
											<div>
												<div class="font-bold text-primary text-xs">{ p.CoveringBranchName }</div>
												<div class="text-xs text-brand font-bold mt-1">
													if p.DistanceKM > 0 {
														if p.DistanceMeters < 1000 {
															<span>تبعد { fmt.Sprintf("%d", p.DistanceMeters) } متر</span>
														} else {
															<span>تبعد { fmt.Sprintf("%.2f", p.DistanceKM) } كم</span>
														}
													} else {
														<span>{ p.MatchReason }</span>
													}
												</div>
											</div>
										</td>
										<td>
											<div class="d-flex flex-col gap-1">
												<div class="d-flex gap-1 flex-wrap">
													for _, dLabel := range p.CoveredDaysLabels {
														<span class="badge badge-slate text-xs font-bold">
															{ dLabel }
														</span>
													}
												</div>
												if p.TimeWindow != "" {
													<div class="text-xs text-muted tabular-nums">
														⏰ { p.TimeWindow }
													</div>
												}
											</div>
										</td>
										<td class="text-center">
											if p.IsCoveredToday {
												<span class="badge badge-emerald text-xs font-bold">
													متاح اليوم
												</span>
											} else {
												<span class="badge badge-slate text-xs">
													أيام أخرى
												</span>
											}
										</td>
										<td class="text-end">
											<div class="d-flex items-center justify-end gap-2">
												if p.Phone != "" {
													<a href={ templ.SafeURL("tel:" + p.Phone) } class="btn btn-secondary btn-sm btn-icon" title="اتصال">
														@components.IconPhone("icon-xs")
													</a>
													<a href={ templ.SafeURL("https://wa.me/" + p.Phone) } target="_blank" rel="noopener" class="btn btn-secondary btn-sm btn-icon text-success" title="مراسلة واتساب">
														@components.IconWhatsApp("icon-xs")
													</a>
												}
												<a href="/vendor/coverage" class="btn btn-secondary btn-sm font-bold text-xs" title="عرض جدول التغطية">
													التغطية
												</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

