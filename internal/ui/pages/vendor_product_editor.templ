package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorVariantEditorData struct {
	MasterProducts []*catalog.Product
	Branches       []*org.Branch
	SelectedProdID int64
}

templ VendorProductEditor(data VendorVariantEditorData, lang, dir string) {
	@layouts.VendorShell("إضافة عرض توريد لصنف دوائي معتمد", "new_variant", lang, dir) {
		<div class="card">
			<div>
				<div>
					@components.IconPlus("icon-sm")
				</div>
				<div>
					<h2>
						إضافة عرض توريد لصنف دوائي
					</h2>
					<p>
						اختر الصنف من الكتالوج المعتمد وحدد سعر التوريد، الكمية، والخصم الممنوح للصيدليات
					</p>
				</div>
			</div>

			<form action="/vendor/variants/new" method="POST" class="stack-lg">
				<!-- 1. Master Product Selection -->
				<div>
					<label class="form-label" for="var-master-prod">
						الصنف الدوائي المعتمد من هيئة الدواء (Master Product) *
					</label>
					<select id="var-master-prod" name="product_id" class="form-select" required>
						<option value="" disabled selected>اختر الدواء / الصنف الأساسي من القائمة</option>
						for _, p := range data.MasterProducts {
							<option value={ fmt.Sprintf("%d", p.ID) } selected?={ p.ID == data.SelectedProdID }>
								{ p.Name.Get(i18n.Lang(lang)) } — { p.DosageForm }
								if p.ScientificName != "" {
									({ p.ScientificName })
								}
							</option>
						}
					</select>
					<p>
						تنبيه: يتم إنشاء المنتجات الأساسية وتدقيق مواصفاتها وصورها حصرياً بواسطة إدارة المنصة.
					</p>
				</div>

				<!-- 2. Variant Title -->
				<div>
					<div>
						<label class="form-label" for="var-name-ar">اسم العبوة والمواصفات (عربي) *</label>
						<input type="text" id="var-name-ar" name="name_ar" class="form-input" placeholder="مثال: علبة 30 قرص (3 شرائط)" required />
					</div>
					<div>
						<label class="form-label" for="var-name-en">اسم العبوة والمواصفات (إنجليزي)</label>
						<input type="text" id="var-name-en" name="name_en" class="form-input" dir="ltr" placeholder="e.g. Box of 30 Tablets (3 Strips)" />
					</div>
				</div>

				<!-- 3. Batch and Expiry -->
				<div>
					<div>
						<label class="form-label" for="var-batch">رقم التشغيلة (Batch / Lot Number) *</label>
						<input type="text" id="var-batch" name="batch_number" class="form-input tabular-nums" placeholder="مثال: BTH-2026-948" required />
					</div>
					<div>
						<label class="form-label" for="var-expiry">تاريخ انتهاء الصلاحية *</label>
						<input type="date" id="var-expiry" name="expiry_date" class="form-input tabular-nums" required />
					</div>
				</div>

				<!-- 4. Pricing & Cost Discounts (Unified Standard) -->
				<div class="stack-md">
					<div class="d-flex items-center gap-2">
						<span class="text-brand">@components.IconWallet("icon-xs")</span>
						<span class="font-extrabold text-sm text-primary">التسعير، الخصومات، وهوامش الربح</span>
					</div>
					
					<div>
						<div>
							<label class="form-label" for="var-price">سعر الجمهور الرسمي (ج.م) <span class="text-danger">*</span></label>
							<input type="number" step="0.01" min="0.5" id="var-price" name="price" class="form-input tabular-nums" placeholder="مثال: 100.00" required oninput="recalcProfitPreview()" />
							<span class="text-xs text-muted mt-1 d-block">السعر الرسمي المعتمد للمستهلك</span>
						</div>
						<div>
							<label class="form-label" for="var-discount">نسبة الخصم الممنوح للصيدليات (%)</label>
							<input type="number" step="0.1" min="0" max="100" id="var-discount" name="discount" class="form-input tabular-nums" placeholder="مثال: 15.0%" oninput="recalcProfitPreview()" />
							<span class="text-xs text-muted mt-1 d-block">الخصم المطبق على سعر الجمهور</span>
						</div>
					</div>

					<div>
						<div>
							<label class="form-label" for="var-cost">سعر التكلفة (ج.م) <span class="badge badge-slate text-xs">اختياري</span></label>
							<input type="number" step="0.01" min="0" id="var-cost" name="cost_price" class="form-input tabular-nums" placeholder="0.00 (إن وجد)" oninput="recalcProfitPreview()" />
							<span class="text-xs text-muted mt-1 d-block">تكلفة شراء الصنف على المورد</span>
						</div>
						<div>
							<label class="form-label" for="var-cost-discount">خصم التكلفة (%) <span class="badge badge-slate text-xs">اختياري</span></label>
							<input type="number" step="0.1" min="0" max="100" id="var-cost-discount" name="cost_discount_percentage" class="form-input tabular-nums" placeholder="0.0%" oninput="recalcProfitPreview()" />
							<span class="text-xs text-muted mt-1 d-block">نسبة الخصم الممنوحة على سعر التكلفة</span>
						</div>
					</div>

					<!-- Real-time Profit Preview Strip -->
					<div id="profit-calc-preview">
						<div>
							<div class="text-xs text-muted font-bold">سعر البيع بعد الخصم</div>
							<div id="preview-selling-price" class="font-extrabold text-primary tabular-nums mt-1">0.00 ج.م</div>
						</div>
						<div>
							<div class="text-xs text-muted font-bold">التكلفة الفعلية المخفضة</div>
							<div id="preview-cost-price" class="font-extrabold text-secondary tabular-nums mt-1">0.00 ج.م</div>
						</div>
						<div>
							<div class="text-xs text-muted font-bold">صافي ربح الوحدة</div>
							<div id="preview-net-profit" class="font-black text-success tabular-nums mt-1">0.00 ج.م</div>
						</div>
						<div>
							<div class="text-xs text-muted font-bold">هامش الربح المتوقع</div>
							<div id="preview-profit-margin" class="font-black text-brand tabular-nums mt-1">0.0%</div>
						</div>
					</div>
				</div>

				<script>
					function recalcProfitPreview() {
						const price = parseFloat(document.getElementById('var-price')?.value) || 0;
						const discount = parseFloat(document.getElementById('var-discount')?.value) || 0;
						const cost = parseFloat(document.getElementById('var-cost')?.value) || 0;
						const costDiscount = parseFloat(document.getElementById('var-cost-discount')?.value) || 0;

						const sellingPrice = price > 0 ? (price * (1 - (discount / 100))) : 0;
						const discountedCost = cost > 0 ? (cost * (1 - (costDiscount / 100))) : 0;
						
						let netProfit = sellingPrice;
						if (cost > 0) {
							netProfit = sellingPrice - discountedCost;
						}
						const margin = sellingPrice > 0 ? ((netProfit / sellingPrice) * 100) : 0;

						const elSell = document.getElementById('preview-selling-price');
						const elCost = document.getElementById('preview-cost-price');
						const elProfit = document.getElementById('preview-net-profit');
						const elMargin = document.getElementById('preview-profit-margin');

						if (elSell) elSell.textContent = sellingPrice.toFixed(2) + ' ج.م';
						if (elCost) elCost.textContent = cost > 0 ? (discountedCost.toFixed(2) + ' ج.م') : 'لا توجد تكلفة';
						if (elProfit) elProfit.textContent = netProfit.toFixed(2) + ' ج.م';
						if (elMargin) elMargin.textContent = margin.toFixed(1) + '%';
					}
					document.addEventListener('DOMContentLoaded', recalcProfitPreview);
				</script>

				<!-- 5. Quantities & Stock -->
				<div>
					<div>
						<label class="form-label" for="var-stock">الكمية المتوفرة بالمخزن (الرصيد) *</label>
						<input type="number" min="1" id="var-stock" name="stock_qty" class="form-input tabular-nums" placeholder="مثال: 500" required />
					</div>
					<div>
						<label class="form-label" for="var-min-qty">الحد الأدنى لطلب الصيدلية (عبوة)</label>
						<input type="number" min="1" id="var-min-qty" name="min_order_qty" value="1" class="form-input tabular-nums" required />
					</div>
				</div>

				<!-- 6. Branch / Warehouse Location -->
				<div>
					<div>
						<label class="form-label" for="var-branch">مخزن أو فرع الشحن المعتمد *</label>
						<select id="var-branch" name="branch_id" class="form-select">
							for _, b := range data.Branches {
								<option value={ fmt.Sprintf("%d", b.ID) } selected?={ b.IsMain }>
									{ b.Name.Get(i18n.Lang(lang)) }
									if b.IsMain {
										<span> (الفرع الرئيسي)</span>
									}
									if b.Code != "" {
										({ b.Code })
									}
								</option>
							}
						</select>
					</div>
					<div>
						<label class="form-label" for="var-sku">كود الصنف الخاص بالشركة (SKU / Barcode)</label>
						<input type="text" id="var-sku" name="sku" class="form-input tabular-nums" placeholder="مثال: SKU-88492" />
					</div>
				</div>

				<div>
					<a href="/vendor/products" class="btn btn-secondary">إلغاء</a>
					<button type="submit" class="btn btn-primary">
						@components.IconCheck("icon-xs")
						<span>حفظ ونشر عرض التوريد</span>
					</button>
				</div>
			</form>
		</div>
	}
}
