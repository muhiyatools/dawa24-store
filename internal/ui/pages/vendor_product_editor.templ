package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorProductEditor(product *catalog.Product, categories []*catalog.Category, brands []*catalog.Brand, isNew bool, lang, dir string) {
	@layouts.VendorShell(editorTitle(isNew), "products", lang, dir) {
		<div class="card" style="max-width:880px; margin:0 auto;">
			<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.5rem;">
				@components.IconPill("icon-md")
				<h2 class="card-title" style="margin:0;">
					if isNew {
						إضافة صنف دوائي جديد
					} else {
						تعديل بيانات الصنف الدوائي
					}
				</h2>
			</div>

			<form action="/vendor/products" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
				if !isNew && product != nil {
					<input type="hidden" name="id" value={ fmt.Sprintf("%d", product.ID) } />
				}
				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">
							الاسم التجاري (عربي) *
						</label>
						<input
							type="text"
							name="name_ar"
							value={ getProdNameAr(product) }
							required
							class="form-input"
						/>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">
							الاسم التجاري (إنجليزي) *
						</label>
						<input
							type="text"
							name="name_en"
							value={ getProdNameEn(product) }
							required
							class="form-input"
						/>
					</div>
				</div>

				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">
							الشكل الصيدلي (Dosage Form) *
						</label>
						<input
							type="text"
							name="dosage_form"
							value={ getProdDosage(product) }
							placeholder="أقراص / كبسولات / شراب / أمبولات..."
							required
							class="form-input"
						/>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">
							الشركة المصنعة (Manufacturing Company)
						</label>
						<input
							type="text"
							name="manufacturing_companies"
							value={ getProdManufacturer(product) }
							class="form-input"
						/>
					</div>
				</div>

				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">
							الاسم العلمي / المادة الفعالة
						</label>
						<input
							type="text"
							name="scientific_name"
							value={ getProdActiveIng(product) }
							class="form-input"
						/>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">
							الباركود الدولي (Barcode)
						</label>
						<input
							type="text"
							name="barcode"
							value={ getProdBarcode(product) }
							class="form-input tabular-nums"
						/>
					</div>
				</div>

				<div style="display:flex; justify-content:flex-end; gap:1rem; margin-top:1rem; border-top:1px solid var(--neutral-100); padding-top:1.25rem;">
					<a href="/vendor/products" class="btn btn-secondary">
						إلغاء
					</a>
					<button type="submit" class="btn btn-primary" style="padding:0.65rem 1.75rem;">
						@components.IconCheck("icon-xs")
						<span>حفظ بيانات الصنف</span>
					</button>
				</div>
			</form>
		</div>
	}
}

func editorTitle(isNew bool) string {
	if isNew {
		return "إضافة منتج جديد"
	}
	return "تعديل المنتج"
}

func getProdNameAr(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	return p.Name["ar"]
}

func getProdNameEn(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	return p.Name["en"]
}

func getProdDosage(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	return p.DosageForm
}

func getProdManufacturer(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	return p.ManufacturingCompanies
}

func getProdActiveIng(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	return p.ScientificName
}

func getProdBarcode(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	return p.Barcode
}
