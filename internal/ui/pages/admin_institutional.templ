package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminInstitutional(lang, dir string, items []*org.InstitutionalWork) {
	@layouts.AdminShell("الهيكل المؤسسي وأنواعه | Institutional Structure", "institutional", lang, dir) {
		<div
			class="card"
			style="margin-bottom:0;"
			x-data="{
				isCreateModalOpen: false,
				isEditModalOpen: false,
				editData: {
					id: 0,
					title_ar: '',
					title_en: '',
					description_ar: '',
					icon: 'building',
					pricing_type: 'free',
					view_type: 1,
					parent_id: 0
				},
				openCreateModal() {
					this.isCreateModalOpen = true;
				},
				openEdit(id, titleAr, titleEn, descAr, icon, pricingType, viewType, parentId) {
					this.editData = {
						id: id,
						title_ar: titleAr || '',
						title_en: titleEn || '',
						description_ar: descAr || '',
						icon: icon || 'building',
						pricing_type: pricingType || 'free',
						view_type: viewType || 1,
						parent_id: parentId || 0
					};
					this.isEditModalOpen = true;
				}
			}"
		>
			
			<!-- Header Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap;">
				<div style="display:flex; align-items:center; gap:0.6rem;">
					<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconBuilding("icon-sm")
					</div>
					<div>
						<h2 class="card-title" style="margin:0; font-size:1.5rem; font-weight:800;">
							الهيكل المؤسسي وأنواعه ({ fmt.Sprintf("%d", len(items)) })
						</h2>
						<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
							إدارة التصنيفات الهيكلية للمنشآت والمستودعات والصيدليات ونمط التغطية (تغطية عامة / تغطية صيدلية)
						</p>
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
					<button type="button" @click="openCreateModal()" class="btn btn-primary" style="font-weight:800;">
						@components.IconPlus("icon-xs")
						<span>إضافة تصنيف هيكلي جديد</span>
					</button>
				</div>
			</div>

			if len(items) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد تصنيفات هيكلية مضافة",
					Message: "يمكنك إضافة تصنيفات الهيكل المؤسسي لربط فروع الموردين والصيدليات بها وتحديد نمط التغطية ونوع التسعير.",
				})
			} else {
				<div style="display:flex; flex-direction:column; gap:1.25rem;">
					for _, root := range items {
						<div class="card" style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem; margin-bottom:0;">
							
							<!-- Main Parent Header -->
							<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:1rem; flex-wrap:wrap; gap:1rem;">
								<div style="display:flex; align-items:center; gap:0.85rem;">
									<div style="width:44px; height:44px; border-radius:var(--radius-xl); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-weight:900;">
										@components.IconLayers("icon-sm")
									</div>
									<div>
										<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
											<h3 style="font-size:1.15rem; font-weight:800; color:var(--text); margin:0;">
												{ root.Title.Get("ar") }
											</h3>
											
											<!-- View Type Badge -->
											if root.ViewType == 2 {
												<span class="badge badge-sky" style="font-weight:700;">
													تغطية صيدلية (Pharmacy) - 2
												</span>
											} else {
												<span class="badge badge-slate" style="font-weight:700;">
													تغطية عامة (Normal) - 1
												</span>
											}

											<span class={ "badge", pricingBadgeClass(string(root.PricingType)) } style="font-weight:700;">
												{ pricingTypeAr(string(root.PricingType)) }
											</span>

											if root.IsActive {
												<span class="badge badge-emerald" style="font-weight:700;">نشط</span>
											} else {
												<span class="badge badge-danger" style="font-weight:700;">موقوف</span>
											}
										</div>
										if root.Title.Get("en") != "" {
											<div style="font-size:0.8rem; color:var(--text-muted); margin-top:2px;">{ root.Title.Get("en") }</div>
										}
										if root.Description.Get("ar") != "" {
											<p style="font-size:0.825rem; color:var(--text-secondary); margin:0.35rem 0 0 0; line-height:1.4;">
												{ root.Description.Get("ar") }
											</p>
										}
									</div>
								</div>

								<!-- Parent Actions -->
								<div style="display:flex; align-items:center; gap:0.4rem;">
									<button
										type="button"
										class="btn btn-secondary btn-icon"
										style="width:34px; height:34px; color:var(--accent);"
										title="تعديل التصنيف"
										@click={ fmt.Sprintf("openEdit(%d, %q, %q, %q, %q, %q, %d, %d)", root.ID, root.Title.Get("ar"), root.Title.Get("en"), root.Description.Get("ar"), root.Icon, string(root.PricingType), root.ViewType, root.ParentIDVal()) }
									>
										@components.IconEdit("icon-xs")
									</button>

									<!-- Status Toggle -->
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/institutional/%d/status", root.ID)) } style="margin:0;">
										<button
											type="submit"
											class="btn btn-secondary btn-icon"
											style="width:34px; height:34px;"
											title={ ternary(root.IsActive, "إيقاف التصنيف", "تفعيل التصنيف") }
										>
											if root.IsActive {
												@components.IconMinus("icon-xs")
											} else {
												@components.IconCheck("icon-xs")
											}
										</button>
									</form>

									<!-- Delete -->
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/institutional/%d/delete", root.ID)) } style="margin:0;" onsubmit="return confirm('هل أنت متأكد من حذف هذا التصنيف المؤسسي؟');">
										<button type="submit" class="btn btn-secondary btn-icon" style="width:34px; height:34px; color:var(--danger);" title="حذف">
											@components.IconTrash("icon-xs")
										</button>
									</form>
								</div>
							</div>

							<!-- Children Sub-categories if any -->
							if len(root.Children) > 0 {
								<div style="margin-top:0.75rem; padding-inline-start:1.5rem; border-inline-start:3px solid var(--accent); display:flex; flex-direction:column; gap:0.6rem;">
									<div style="font-size:0.775rem; font-weight:700; color:var(--text-muted);">
										التفريعات والفئات المرتبطة:
									</div>
									<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:0.6rem;">
										for _, child := range root.Children {
											<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.75rem 1rem; display:flex; justify-content:space-between; align-items:center;">
												<div>
													<div style="font-weight:700; font-size:0.9rem; color:var(--text);">{ child.Title.Get("ar") }</div>
													<div style="display:flex; align-items:center; gap:0.4rem; margin-top:3px;">
														if child.ViewType == 2 {
															<span class="badge badge-sky" style="font-size:0.675rem;">تغطية صيدلية - 2</span>
														} else {
															<span class="badge badge-slate" style="font-size:0.675rem;">تغطية عامة - 1</span>
														}
														<span class={ "badge", pricingBadgeClass(string(child.PricingType)) } style="font-size:0.675rem;">
															{ pricingTypeAr(string(child.PricingType)) }
														</span>
													</div>
												</div>
												<div style="display:flex; align-items:center; gap:0.25rem;">
													<button
														type="button"
														class="btn btn-secondary btn-icon"
														style="width:28px; height:28px; color:var(--accent);"
														title="تعديل"
														@click={ fmt.Sprintf("openEdit(%d, %q, %q, %q, %q, %q, %d, %d)", child.ID, child.Title.Get("ar"), child.Title.Get("en"), child.Description.Get("ar"), child.Icon, string(child.PricingType), child.ViewType, child.ParentIDVal()) }
													>
														@components.IconEdit("icon-xs")
													</button>
												</div>
											</div>
										}
									</div>
								</div>
							}

						</div>
					}
				</div>
			}

			<!-- Create Institutional Work Modal -->
			<div
				x-show="isCreateModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isCreateModalOpen = false"
			>
				<div
					@click.outside="isCreateModalOpen = false"
					class="card"
					style="max-width:720px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconPlus("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								إضافة تصنيف هيكل مؤسسي جديد
							</h3>
						</div>
						<button type="button" @click="isCreateModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/admin/institutional/new" style="display:flex; flex-direction:column; gap:1.15rem; text-align:start;">
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم التصنيف المؤسسي (عربي) *</label>
								<input type="text" name="title_ar" required class="form-input" placeholder="مستودع مركزي رئيسي" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">الاسم بالإنجليزية (English)</label>
								<input type="text" name="title_en" class="form-input" dir="ltr" placeholder="Central Main Warehouse" />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">التصنيف الأب الرئيسي (Parent Group)</label>
								<select name="parent_id" class="form-select">
									<option value="0">تصنيف رئيسي مستقل (Root Category)</option>
									for _, p := range items {
										<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Title.Get("ar") }</option>
									}
								</select>
							</div>

							<div class="form-group" style="margin:0;">
								<label class="form-label">طريقة ونمط العرض (View Type) *</label>
								<select name="view_type" required class="form-select">
									<option value="1">1 - تغطية عامة / عادية (Normal Coverage)</option>
									<option value="2">2 - تغطية صيدلية (Pharmacy Coverage)</option>
								</select>
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">نوع التسعير والاشتراك *</label>
								<select name="pricing_type" required class="form-select">
									<option value="free">مجاني (Free)</option>
									<option value="subscription">اشتراك دوري (Subscription)</option>
									<option value="paid">مدفوع ثابت (Paid)</option>
									<option value="monthly">شهري (Monthly)</option>
									<option value="per_project">لكل مشروع / توريد (Per Project)</option>
								</select>
							</div>

							<div class="form-group" style="margin:0;">
								<label class="form-label">الأيقونة الرمزية</label>
								<select name="icon" class="form-select">
									<option value="building">مبنى / منشأة (Building)</option>
									<option value="truck">شاحنة / نقل وتوزيع (Truck)</option>
									<option value="pill">دواء / صيدلية (Pill)</option>
									<option value="shield">أمان / مستشفى (Shield)</option>
									<option value="layers">طبقات / فروع (Layers)</option>
									<option value="package">صندوق / مصنع (Package)</option>
								</select>
							</div>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الوصف والبيان التفصيلي</label>
							<textarea name="description_ar" rows="2" class="form-input" placeholder="شرح لطبيعة المنشأة والتصنيف ونطاق التوريد..."></textarea>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isCreateModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ وإضافة التصنيف</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Edit Modal -->
			<div
				x-show="isEditModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isEditModalOpen = false"
			>
				<div
					@click.outside="isEditModalOpen = false"
					class="card"
					style="max-width:720px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconEdit("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								تعديل التصنيف المؤسسي
							</h3>
						</div>
						<button type="button" @click="isEditModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form :action="'/admin/institutional/' + editData.id + '/edit'" method="POST" style="display:flex; flex-direction:column; gap:1.15rem; text-align:start;">
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم التصنيف (عربي) *</label>
								<input type="text" name="title_ar" x-model="editData.title_ar" required class="form-input" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">الاسم بالإنجليزية (English)</label>
								<input type="text" name="title_en" x-model="editData.title_en" class="form-input" dir="ltr" />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">التصنيف الأب الرئيسي</label>
								<select name="parent_id" x-model="editData.parent_id" class="form-select">
									<option value="0">تصنيف رئيسي مستقل (Root Category)</option>
									for _, p := range items {
										<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Title.Get("ar") }</option>
									}
								</select>
							</div>

							<div class="form-group" style="margin:0;">
								<label class="form-label">طريقة ونمط العرض (View Type) *</label>
								<select name="view_type" x-model="editData.view_type" required class="form-select">
									<option value="1">1 - تغطية عامة / عادية (Normal Coverage)</option>
									<option value="2">2 - تغطية صيدلية (Pharmacy Coverage)</option>
								</select>
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">نوع التسعير والاشتراك *</label>
								<select name="pricing_type" x-model="editData.pricing_type" required class="form-select">
									<option value="free">مجاني (Free)</option>
									<option value="subscription">اشتراك دوري (Subscription)</option>
									<option value="paid">مدفوع ثابت (Paid)</option>
									<option value="monthly">شهري (Monthly)</option>
									<option value="per_project">لكل مشروع / توريد (Per Project)</option>
								</select>
							</div>

							<div class="form-group" style="margin:0;">
								<label class="form-label">الأيقونة الرمزية</label>
								<select name="icon" x-model="editData.icon" class="form-select">
									<option value="building">مبنى / منشأة (Building)</option>
									<option value="truck">شاحنة / نقل وتوزيع (Truck)</option>
									<option value="pill">دواء / صيدلية (Pill)</option>
									<option value="shield">أمان / مستشفى (Shield)</option>
									<option value="layers">طبقات / فروع (Layers)</option>
									<option value="package">صندوق / مصنع (Package)</option>
								</select>
							</div>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الوصف والبيان التفصيلي</label>
							<textarea name="description_ar" x-model="editData.description_ar" rows="2" class="form-input"></textarea>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isEditModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ التعديلات</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}

func pricingTypeAr(pt string) string {
	switch pt {
	case "free":
		return "مجاني"
	case "subscription":
		return "اشتراك دوري"
	case "paid":
		return "مدفوع ثابت"
	case "monthly":
		return "شهري"
	case "per_project":
		return "لكل مشروع"
	default:
		return "عام"
	}
}

func pricingBadgeClass(pt string) string {
	switch pt {
	case "free":
		return "badge-emerald"
	case "subscription":
		return "badge-sky"
	case "paid", "monthly":
		return "badge-amber"
	default:
		return "badge-slate"
	}
}

func ternary(cond bool, a, b string) string {
	if cond {
		return a
	}
	return b
}
