package pages

import (
	"fmt"
	"time"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// InvoicePaymentPageData holds the view-model for the dedicated invoice payment recording page.
type InvoicePaymentPageData struct {
	Invoice   *billing.AdminInvoiceView
	Payments  []*billing.AdminPaymentView
	IsAdmin   bool
	BackURL   string
	ActionURL string
}

func invoicePaymentMethodName(m string) string {
	switch m {
	case "bank_transfer":
		return "تحويل بنكي"
	case "cash":
		return "نقدي (كاش)"
	case "cheque":
		return "شيك بنكي"
	case "card":
		return "بطاقة بنكية / POS"
	case "wallet":
		return "رصيد المحفظة"
	default:
		if m != "" {
			return m
		}
		return "تحويل بنكي"
	}
}

templ InvoicePaymentPage(data InvoicePaymentPageData, lang, dir string) {
	if data.IsAdmin {
		@layouts.AdminShell("تسجيل دفعة للفاتورة", "invoices", lang, dir) {
			@invoicePaymentContent(data, lang, dir)
		}
	} else {
		@layouts.ShellFor("تسجيل دفعة للفاتورة", "invoices", lang, dir, authctx.FromContext(ctx)) {
			@invoicePaymentContent(data, lang, dir)
		}
	}
}

templ invoicePaymentContent(data InvoicePaymentPageData, lang, dir string) {
	<div class="page-container">
		<!-- Header & Breadcrumbs -->
		<div class="glass-panel p-5 mb-5">
			<div class="flex-between items-center flex-wrap gap-4">
				<div class="d-flex items-center gap-3">
					<a href={ templ.SafeURL(data.BackURL) } class="btn btn-secondary btn-sm p-2 rounded-lg" title="رجوع لقائمة الفواتير">
						@components.IconArrowRight("icon-xs")
					</a>
					<div class="user-avatar-badge text-lg">
						@components.IconCreditCard("icon-sm")
					</div>
					<div>
						<div class="d-flex items-center gap-2">
							<h1 class="text-xl font-black text-primary m-0">تسجيل دفعة مالية</h1>
							<span class="badge badge-secondary font-mono font-bold text-xs">{ data.Invoice.InvoiceNumber }</span>
							<span class={ "badge font-bold text-xs " + InvoiceBadgeClass(data.Invoice.Status) }>
								{ InvoiceLabel(data.Invoice.Status) }
							</span>
						</div>
						<p class="text-xs text-secondary m-0 mt-1">
							قيد سداد نقدي أو بنكي وتحديث الرصيد المستحق ومزامنة حالة الفاتورة والطلبية
						</p>
					</div>
				</div>

				<div class="d-flex items-center gap-2">
					<a href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print", data.Invoice.ID)) } target="_blank" class="btn btn-secondary btn-sm font-bold gap-1">
						@components.IconPrinter("icon-xs")
						<span>معاينة الفاتورة</span>
					</a>
					<a href={ templ.SafeURL(data.BackURL) } class="btn btn-ghost btn-sm font-bold">
						إلغاء وعودة
					</a>
				</div>
			</div>
		</div>

		<!-- Overview Cards: Total, Paid, Remaining -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
			<!-- Total Amount -->
			<div class="stat-card-3d">
				<div class="flex-between items-center">
					<span class="text-xs font-bold text-muted">إجمالي الفاتورة</span>
					<span class="text-indigo">
						@components.IconFileText("icon-xs")
					</span>
				</div>
				<div class="text-2xl font-black text-primary mt-2 font-mono tabular-nums">
					{ data.Invoice.TotalAmount.String() } <span class="text-xs font-normal text-muted">ج.م</span>
				</div>
				<div class="text-3xs text-secondary mt-1">
					تاريخ الإصدار: { data.Invoice.IssueDate.Format("2006-01-02") }
				</div>
			</div>

			<!-- Paid Amount -->
			<div class="stat-card-3d">
				<div class="flex-between items-center">
					<span class="text-xs font-bold text-muted">المبلغ المسدد</span>
					<span class="text-emerald">
						@components.IconCheckCircle("icon-xs")
					</span>
				</div>
				<div class="text-2xl font-black text-emerald mt-2 font-mono tabular-nums">
					{ data.Invoice.PaidAmount.String() } <span class="text-xs font-normal text-muted">ج.م</span>
				</div>
				<div class="text-3xs text-secondary mt-1">
					نسبة السداد: { fmt.Sprintf("%d%%", invoicePaymentPercent(data.Invoice.PaidAmount, data.Invoice.TotalAmount)) }
				</div>
			</div>

			<!-- Remaining Amount -->
			<div class="stat-card-3d">
				<div class="flex-between items-center">
					<span class="text-xs font-bold text-muted">المبلغ المتبقي</span>
					<span class="text-amber">
						@components.IconClock("icon-xs")
					</span>
				</div>
				<div class="text-2xl font-black text-amber mt-2 font-mono tabular-nums">
					{ data.Invoice.RemainingAmount.String() } <span class="text-xs font-normal text-muted">ج.م</span>
				</div>
				<div class="text-3xs text-secondary mt-1">
					تاريخ الاستحقاق: { data.Invoice.DueDate.Format("2006-01-02") }
				</div>
			</div>
		</div>

		<!-- Progress Bar -->
		<div class="glass-panel p-4 mb-6">
			<div class="flex-between items-center text-xs mb-2">
				<span class="font-bold text-primary">نسبة إنجاز سداد الفاتورة:</span>
				<span class="font-mono font-bold text-brand">
					{ fmt.Sprintf("%d%%", invoicePaymentPercent(data.Invoice.PaidAmount, data.Invoice.TotalAmount)) }
				</span>
			</div>
			<div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
				<div
					class="bg-emerald h-2.5 rounded-full transition-all duration-500"
					style={ fmt.Sprintf("width: %d%%", invoicePaymentPercent(data.Invoice.PaidAmount, data.Invoice.TotalAmount)) }
				></div>
			</div>
		</div>

		<!-- Two Column Section: Payment Form & Payments History -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
			<!-- Payment Form (Left on LTR, Right on RTL: 7 cols) -->
			<div class="lg:col-span-7">
				<div class="glass-panel p-6">
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<div class="user-avatar-badge text-brand">
								@components.IconPlus("icon-xs")
							</div>
							<h2 class="text-base font-bold text-primary m-0">بيانات الدفعة الجديدة</h2>
						</div>
						<span class="text-3xs text-muted">جميع الحقول المعلمة بـ (*) إلزامية</span>
					</div>

					if data.Invoice.Status == billing.InvoicePaid || data.Invoice.RemainingAmount.Minor() <= 0 {
						<div class="alert alert-success d-flex items-center gap-3 p-4 rounded-xl">
							@components.IconCheckCircle("icon-sm text-emerald")
							<div>
								<h3 class="font-bold text-sm m-0 text-emerald">تم سداد الفاتورة بالكامل</h3>
								<p class="text-xs m-0 mt-1 text-secondary">
									لا يوجد أي مبالغ مستحقة على هذه الفاتورة. يمكنك مراجعة سجل العمليات أدناه أو طباعة السند.
								</p>
							</div>
						</div>
					} else {
						<form action={ templ.SafeURL(data.ActionURL) } method="POST" class="d-flex flex-col gap-4 m-0">
							<input type="hidden" name="invoice_id" value={ fmt.Sprintf("%d", data.Invoice.ID) }/>

							<!-- Quick Preset Chips for Amount -->
							<div class="form-group m-0">
								<div class="flex-between items-center mb-1.5">
									<label class="form-label font-bold text-xs m-0" for="payment-amount-input">
										مبلغ الدفعة (بالجنيه المصري) <span class="text-danger">*</span>
									</label>
									<div class="d-flex items-center gap-1.5">
										<button
											type="button"
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('payment-amount-input').value = '%s'", data.Invoice.RemainingAmount.String())} }
											class="btn btn-secondary btn-2xs font-bold text-3xs"
										>
											سداد كامل المتبقي (100%)
										</button>
										if data.Invoice.RemainingAmount.Minor() > 100 {
											<button
												type="button"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('payment-amount-input').value = '%.2f'", float64(data.Invoice.RemainingAmount.Minor())/200.0)} }
												class="btn btn-secondary btn-2xs font-bold text-3xs"
											>
												سداد النصف (50%)
											</button>
										}
									</div>
								</div>
								<input
									type="number"
									step="0.01"
									min="0.01"
									max={ data.Invoice.RemainingAmount.String() }
									id="payment-amount-input"
									name="amount"
									value={ data.Invoice.RemainingAmount.String() }
									required
									placeholder="0.00"
									class="form-control text-lg font-mono font-black text-brand tabular-nums"
								/>
								<span class="text-3xs text-secondary mt-1">الحد الأقصى للدفعة هو المبلغ المتبقي ({ data.Invoice.RemainingAmount.String() } ج.م).</span>
							</div>

							<div class="form-grid-2">
								<!-- Payment Method -->
								<div class="form-group m-0">
									<label class="form-label font-bold text-xs">طريقة السداد <span class="text-danger">*</span></label>
									<select name="method" class="form-select text-xs font-semibold" required>
										<option value="bank_transfer" selected>تحويل بنكي / إيداع</option>
										<option value="cash">نقدي (كاش للمندوب)</option>
										<option value="cheque">شيك بنكي معتمد</option>
										<option value="card">بطاقة دفع إلكترونية / POS</option>
										<option value="wallet">خصم من رصيد المحفظة</option>
									</select>
								</div>

								<!-- Reference Number -->
								<div class="form-group m-0">
									<label class="form-label font-bold text-xs">الرقم المرجعي / رقم الحوالة</label>
									<input
										type="text"
										name="reference_number"
										placeholder="رقم الإيصال أو الشيك أو الحوالة..."
										class="form-control text-xs font-mono"
									/>
								</div>
							</div>

							<!-- Paid Date -->
							<div class="form-group m-0">
								<label class="form-label font-bold text-xs">تاريخ السداد الفعلي <span class="text-danger">*</span></label>
								<input
									type="date"
									name="paid_at"
									value={ time.Now().Format("2006-01-02") }
									required
									class="form-control text-xs"
								/>
							</div>

							<!-- Notes -->
							<div class="form-group m-0">
								<label class="form-label font-bold text-xs">ملاحظات المحاسب / تفاصيل إضافية</label>
								<textarea
									name="notes"
									rows="2"
									placeholder="اسم البنك، اسم المودع، أو أي تفاصيل تخص الدفعة..."
									class="form-control text-xs"
								></textarea>
							</div>

							<!-- Submit Button -->
							<div class="d-flex items-center justify-end gap-2 pt-2 border-t mt-2">
								<a href={ templ.SafeURL(data.BackURL) } class="btn btn-ghost btn-sm">إلغاء</a>
								<button type="submit" class="btn btn-primary btn-sm font-bold px-6 gap-2 shadow-sm">
									@components.IconCheckCircle("icon-xs")
									<span>تأكيد وقيد الدفعة</span>
								</button>
							</div>
						</form>
					}
				</div>
			</div>

			<!-- Payments History (Right on LTR, Left on RTL: 5 cols) -->
			<div class="lg:col-span-5">
				<div class="glass-panel p-5">
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<div class="d-flex items-center gap-2">
							@components.IconClock("icon-xs text-muted")
							<h2 class="text-sm font-bold text-primary m-0">سجل الدفعات المقيدة</h2>
						</div>
						<span class="badge badge-secondary text-2xs font-bold">
							{ fmt.Sprintf("%d عملية", len(data.Payments)) }
						</span>
					</div>

					if len(data.Payments) == 0 {
						<div class="p-6 text-center">
							<div class="mb-2 text-2xl text-muted">
								@components.IconCreditCard("icon-md")
							</div>
							<h3 class="font-bold text-xs m-0">لا توجد دفعات مقيدة بعد</h3>
							<p class="text-3xs text-secondary m-0 mt-1">
								عند تسجيل أي دفعة نقدية أو بنكية ستظهر تفاصيلها وتاريخها هنا.
							</p>
						</div>
					} else {
						<div class="d-flex flex-col gap-3">
							for _, p := range data.Payments {
								<div class="p-3 bg-slate-50 border border-slate-200/80 rounded-xl">
									<div class="flex-between items-start">
										<div>
											<div class="font-bold text-xs text-primary font-mono tabular-nums">
												{ p.Amount.String() } ج.م
											</div>
											<div class="text-3xs text-secondary mt-0.5">
												{ invoicePaymentMethodName(p.Method) }
												if p.ReferenceNumber != "" {
													<span> • مرجع: { p.ReferenceNumber }</span>
												}
											</div>
										</div>
										<span class="badge badge-emerald text-3xs font-bold">مسدد</span>
									</div>
									if p.PaidAt != nil {
										<div class="text-3xs text-muted mt-2 d-flex items-center gap-1 border-t pt-1.5">
											@components.IconClock("icon-3xs")
											<span>{ p.PaidAt.Format("2006-01-02 15:04") }</span>
											if p.UserName != "" {
												<span class="mx-1">•</span>
												<span>بواسطة: { p.UserName }</span>
											}
										</div>
									}
									if p.Notes != "" {
										<div class="text-3xs text-secondary bg-white p-1.5 rounded mt-1.5 border">
											{ p.Notes }
										</div>
									}
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}
