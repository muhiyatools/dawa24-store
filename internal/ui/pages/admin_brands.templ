package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// BrandViewItem represents a brand item decorated with its product count.
type BrandViewItem struct {
	Brand        *catalog.Brand
	ProductCount int
}

// AdminBrandsPage renders the pharmaceutical brands / manufacturers management console.
templ AdminBrandsPage(brands []BrandViewItem, lang, dir string) {
	@layouts.AdminShell("دليل الشركات المصنعة والماركات", "brands", lang, dir) {
		<div
			class="card mb-0"
			style="overflow:visible;"
			x-data="{
				searchQuery: '',
				statusFilter: 'all',
				isCreateModalOpen: false,
				isEditModalOpen: false,
				editData: {
					id: 0,
					name_ar: '',
					name_en: '',
					description_ar: '',
					description_en: '',
					image: '',
					status: 'active'
				},
				openEdit(id, nameAr, nameEn, descAr, descEn, img, status) {
					this.editData = {
						id: id,
						name_ar: nameAr || '',
						name_en: nameEn || '',
						description_ar: descAr || '',
						description_en: descEn || '',
						image: img || '',
						status: status || 'active'
					};
					this.isEditModalOpen = true;
				}
			}"
		>
			<!-- Header Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; gap:1rem; flex-wrap:wrap;">
				<div class="row-center-sm">
					<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconTag("icon-sm")
					</div>
					<div>
						<h2 class="card-title" style="margin:0; font-size:1.5rem; font-weight:800;">
							دليل الشركات المصنعة والماركات ({ fmt.Sprintf("%d", len(brands)) })
						</h2>
						<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
							إدارة الشركات الدوائية المنتجة والمصنعة المعتمدة وربطها المباشر بالأصناف والمنتجات الأساسية.
						</p>
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
					<button type="button" @click="isCreateModalOpen = true" class="btn btn-primary" style="font-weight:800;">
						@components.IconPlus("icon-xs")
						<span>إضافة شركة مصنعة جديدة</span>
					</button>
				</div>
			</div>

			<!-- Search and Filter Bar -->
			if len(brands) > 0 {
				<div style="margin-bottom:1.25rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; background:var(--surface-sunken); padding:0.85rem 1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
					<div style="flex:1; min-width:280px; max-width:480px; position:relative;">
						<input
							type="text"
							x-model="searchQuery"
							placeholder="ابحث باسم الشركة بالعربية أو الإنجليزية..."
							class="form-input"
							style="padding-inline-start:2.25rem; font-size:0.875rem;"
						/>
						<div style="position:absolute; inset-inline-start:0.75rem; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
							@components.IconSearch("icon-xs")
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
						<select x-model="statusFilter" class="form-select" style="font-size:0.825rem; padding:0.4rem 0.8rem;">
							<option value="all">جميع الحالات</option>
							<option value="active">نشط ومفعل</option>
							<option value="inactive">معطل</option>
						</select>
					</div>
				</div>
			}

			<!-- Brands Data Table -->
			if len(brands) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد شركات مصنعة مسجلة",
					Message: "يمكنك إضافة الشركات الدوائية المنتجة والمصنعة المعتمدة لتظهر في قوائم ربط الأصناف والمستحضرات.",
				})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th style="width:50px;">الشعار</th>
								<th style="width:28%;">اسم الشركة المصنعة</th>
								<th style="width:32%;">الوصف ونبذة التعريف</th>
								<th style="width:14%;">الأصناف المرتبطة</th>
								<th style="width:12%;">الحالة</th>
								<th style="width:14%; text-align:end;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, item := range brands {
								<tr
									x-show={ fmt.Sprintf("(!searchQuery || '%s %s %s'.toLowerCase().includes(searchQuery.toLowerCase())) && (statusFilter === 'all' || '%s' === statusFilter)",
										escapeJS(item.Brand.Name.Get("ar")),
										escapeJS(item.Brand.Name.Get("en")),
										escapeJS(item.Brand.Description.Get("ar")),
										item.Brand.Status) }
								>
									<td style="width:50px;">
										if item.Brand.Image != "" {
											<img src={ item.Brand.Image } alt={ item.Brand.Name.Get(i18n.Lang(lang)) } style="width:40px; height:40px; object-fit:contain; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-raised); padding:2px;" />
										} else {
											<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--surface-sunken); display:flex; align-items:center; justify-content:center; color:var(--text-muted); border:1px solid var(--border);">
												@components.IconBuilding("icon-xs")
											</div>
										}
									</td>
									<td>
										<div style="font-weight:800; color:var(--text); font-size:0.95rem;">{ item.Brand.Name.Get(i18n.Lang(lang)) }</div>
										if item.Brand.Name.Get("en") != "" && lang == "ar" {
											<div style="font-size:0.75rem; color:var(--text-muted);">{ item.Brand.Name.Get("en") }</div>
										}
									</td>
									<td>
										if item.Brand.Description.Get(i18n.Lang(lang)) != "" {
											<div style="font-size:0.85rem; color:var(--text-secondary); line-height:1.4;">{ item.Brand.Description.Get(i18n.Lang(lang)) }</div>
										} else {
											<span style="color:var(--text-muted); font-size:0.8rem; font-style:italic;">لا يوجد وصف مضاف</span>
										}
									</td>
									<td>
										if item.ProductCount > 0 {
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/products?brand_id=%d", item.Brand.ID)) } class="badge badge-emerald" style="font-weight:800; text-decoration:none;">
												{ fmt.Sprintf("%d صنف دوائي", item.ProductCount) }
											</a>
										} else {
											<span class="badge badge-slate" style="font-size:0.75rem;">0 صنف</span>
										}
									</td>
									<td>
										if item.Brand.Status == "active" || item.Brand.Status == "" {
											<span class="badge badge-emerald" style="font-weight:800;">نشط ومفعل</span>
										} else {
											<span class="badge badge-danger" style="font-weight:800;">معطل</span>
										}
									</td>
									<td class="text-end">
										<div class="table-actions" style="justify-content:flex-end; gap:0.35rem;">
											
											<!-- Edit Button -->
											<button
												type="button"
												class="btn btn-secondary btn-icon"
												style="width:32px; height:32px; color:var(--accent);"
												title="تعديل بيانات الشركة"
												@click={ fmt.Sprintf("openEdit(%d, %q, %q, %q, %q, %q, %q)",
													item.Brand.ID,
													item.Brand.Name.Get("ar"),
													item.Brand.Name.Get("en"),
													item.Brand.Description.Get("ar"),
													item.Brand.Description.Get("en"),
													item.Brand.Image,
													item.Brand.Status) }
											>
												@components.IconEdit("icon-xs")
											</button>

											<!-- Status Toggle -->
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/brands/%d/status", item.Brand.ID)) } class="m-0">
												if item.Brand.Status == "active" || item.Brand.Status == "" {
													<input type="hidden" name="status" value="inactive" />
													<button type="submit" class="btn btn-secondary btn-icon" style="width:32px; height:32px; color:var(--warning-text);" title="تعطيل الشركة">
														@components.IconMinus("icon-xs")
													</button>
												} else {
													<input type="hidden" name="status" value="active" />
													<button type="submit" class="btn btn-secondary btn-icon" style="width:32px; height:32px; color:var(--success-text);" title="تفعيل الشركة">
														@components.IconCheck("icon-xs")
													</button>
												}
											</form>

											<!-- Delete Button -->
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/brands/%d/delete", item.Brand.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذه الشركة المصنعة؟');">
												<button type="submit" class="btn btn-secondary btn-icon" style="width:32px; height:32px; color:var(--danger);" title="حذف الشركة">
													@components.IconTrash("icon-xs")
												</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

			<!-- Create Brand Modal -->
			<div
				x-show="isCreateModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isCreateModalOpen = false"
			>
				<div
					@click.outside="isCreateModalOpen = false"
					class="card"
					style="max-width:620px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div class="row-center-sm">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconPlus("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								إضافة شركة مصنعة / ماركة جديدة
							</h3>
						</div>
						<button type="button" @click="isCreateModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/admin/brands/new" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:1.15rem; text-align:start;">
						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الشركة المصنعة (عربي) *</label>
								<input type="text" name="name_ar" required class="form-input" placeholder="إيفا فارما" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الشركة (إنجليزي) *</label>
								<input type="text" name="name_en" required class="form-input" dir="ltr" placeholder="Eva Pharma" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">شعار أو صورة الشركة (ملف)</label>
								<input type="file" name="brand_image" accept=".png,.jpg,.jpeg,.webp" class="form-input" style="padding:0.45rem;" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">أو رابط الصورة (URL)</label>
								<input type="text" name="image_url" class="form-input" dir="ltr" placeholder="https://..." />
							</div>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الوصف والنبذة التعريفية (عربي)</label>
							<textarea name="description_ar" rows="2" class="form-input" placeholder="نبذة عن الشركة، التراخيص والمقر الرئيسي..."></textarea>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الوصف (إنجليزي)</label>
							<textarea name="description_en" rows="2" class="form-input" dir="ltr" placeholder="About the company, headquarters and certifications..."></textarea>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الحالة الأولية</label>
							<select name="status" class="form-select">
								<option value="active">نشط ومفعل (Active)</option>
								<option value="inactive">معطل (Inactive)</option>
							</select>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isCreateModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ وإضافة الشركة المصنعة</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Edit Brand Modal -->
			<div
				x-show="isEditModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isEditModalOpen = false"
			>
				<div
					@click.outside="isEditModalOpen = false"
					class="card"
					style="max-width:620px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div class="row-center-sm">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconEdit("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								تعديل بيانات الشركة المصنعة
							</h3>
						</div>
						<button type="button" @click="isEditModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form :action="'/admin/brands/' + editData.id + '/edit'" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:1.15rem; text-align:start;">
						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الشركة المصنعة (عربي) *</label>
								<input type="text" name="name_ar" x-model="editData.name_ar" required class="form-input" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الشركة (إنجليزي) *</label>
								<input type="text" name="name_en" x-model="editData.name_en" required class="form-input" dir="ltr" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">تغيير الشعار أو الصورة</label>
								<input type="file" name="brand_image" accept=".png,.jpg,.jpeg,.webp" class="form-input" style="padding:0.45rem;" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">أو رابط الصورة (URL)</label>
								<input type="text" name="image_url" x-model="editData.image" class="form-input" dir="ltr" />
							</div>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الوصف والنبذة التعريفية (عربي)</label>
							<textarea name="description_ar" x-model="editData.description_ar" rows="2" class="form-input"></textarea>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الوصف (إنجليزي)</label>
							<textarea name="description_en" x-model="editData.description_en" rows="2" class="form-input" dir="ltr"></textarea>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">الحالة</label>
							<select name="status" x-model="editData.status" class="form-select">
								<option value="active">نشط ومفعل (Active)</option>
								<option value="inactive">معطل (Inactive)</option>
							</select>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isEditModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ التعديلات</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}
