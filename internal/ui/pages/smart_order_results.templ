package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/smartorder"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type SmartOrderResultsData struct {
	Run    *smartorder.Run
	Counts smartorder.FilterCounts
	// Blocked is what will not be ordered, split by reason. It fills the
	// collapsed section rather than being mixed into the main table.
	Blocked   smartorder.BlockedCounts
	Lines     []*smartorder.Line
	Total     int
	Page      int
	PerPage   int
	Match     string
	SortBy    string
	SortOrder string
	Search    string
}

func buildSmartOrderResultsURL(publicID, match, sort, order string, page, limit int, search string) string {
	vals := url.Values{}
	if match != "" {
		vals.Set("match", match)
	}
	if sort != "" {
		vals.Set("sort", sort)
	}
	if order != "" {
		vals.Set("order", order)
	}
	if page > 1 {
		vals.Set("page", fmt.Sprintf("%d", page))
	}
	if limit != 25 && limit != 0 {
		vals.Set("limit", fmt.Sprintf("%d", limit))
	}
	if search != "" {
		vals.Set("q", search)
	}
	base := fmt.Sprintf("/customer/smart-order/%s/results", publicID)
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

func SmartOrderOutcomeLabel(o smartorder.Outcome) string {
	switch o {
	case smartorder.OutcomeOrdered:
		return "جاهز للطلب"
	case smartorder.OutcomeNoSupplier:
		return "لا يوجد مورد"
	case smartorder.OutcomeCoverageBlocked:
		return "خارج التغطية"
	case smartorder.OutcomeInstitutionalBlocked:
		return "غير متاح مؤسسياً"
	case smartorder.OutcomeOutOfStock:
		return "غير متوفر بالمخزون"
	case smartorder.OutcomeBelowMinQty:
		return "أقل من الحد الأدنى"
	case smartorder.OutcomeUnmatched:
		return "غير مطابق"
	case smartorder.OutcomeZeroQty:
		return "الكمية صفر"
	case smartorder.OutcomeRemoved:
		return "تم حذفه"
	}
	return string(o)
}

func MatchMethodLabel(m smartorder.MatchMethod) string {
	switch m {
	case smartorder.MethodSavingProduct:
		return "منتجات التوفير"
	case smartorder.MethodLearnedMapping:
		return "ربط سابق"
	case smartorder.MethodBarcode:
		return "باركود"
	case smartorder.MethodSKU:
		return "كود الصنف"
	case smartorder.MethodExactName:
		return "اسم مطابق"
	case smartorder.MethodIdentityKey:
		return "تركيب وتركيز"
	case smartorder.MethodFuzzy:
		return "تشابه"
	case smartorder.MethodAlias:
		return "اسم بديل"
	case smartorder.MethodAI:
		return "ذكاء اصطناعي"
	case smartorder.MethodManual:
		return "تصحيح يدوي"
	}
	return "—"
}

func outcomeChip(o smartorder.Outcome) string {
	switch o {
	case smartorder.OutcomeOrdered:
		return "outcome-chip outcome-chip-success"
	case smartorder.OutcomeUnmatched:
		return "outcome-chip outcome-chip-danger"
	case smartorder.OutcomeNoSupplier:
		return "outcome-chip outcome-chip-warning"
	default:
		return "outcome-chip outcome-chip-warning"
	}
}

func aiSummary(ai smartorder.AIUsage) string {
	reviewed := ai.LinesReviewed + ai.CacheHits
	if ai.LinesImproved == 0 {
		return fmt.Sprintf(
			"تمت مراجعة %d صنف لم تتمكن المطابقة الحتمية من حسمها، ولم يُضِف الذكاء الاصطناعي مطابقة جديدة موثوقة.",
			reviewed)
	}
	out := fmt.Sprintf(
		"تمت مراجعة %d صنف لم تتمكن المطابقة الحتمية من حسمها، وتم تحسين مطابقة %d منها.",
		reviewed, ai.LinesImproved)
	if ai.CacheHits > 0 {
		out += fmt.Sprintf(" (%d منها أُجيبت من ذاكرة القرارات دون تكلفة إضافية)", ai.CacheHits)
	}
	return out
}

templ statCard(label string, value string) {
	<div class="so-stat-card">
		<div class="so-stat-value tabular-nums">{ value }</div>
		<div class="so-stat-label">{ label }</div>
	</div>
}

templ soSortHeader(data SmartOrderResultsData, colKey, label string) {
	{{
		isCurrent := data.SortBy == colKey || (data.SortBy == "" && colKey == "row")
		nextOrder := "asc"
		icon := "⇅"
		if isCurrent {
			if data.SortOrder == "desc" {
				nextOrder = "asc"
				icon = "▼"
			} else {
				nextOrder = "desc"
				icon = "▲"
			}
		} else if colKey == "confidence" || colKey == "qty" {
			nextOrder = "desc"
		}
		href := buildSmartOrderResultsURL(data.Run.PublicID, data.Match, colKey, nextOrder, 1, data.PerPage, data.Search)
	}}
	<a href={ templ.SafeURL(href) }
		class="so-sort-link"
		title={ fmt.Sprintf("ترتيب حسب %s", label) }>
		<span>{ label }</span>
		<span class="so-sort-icon">{ icon }</span>
	</a>
}

templ soFilterTab(data SmartOrderResultsData, matchKey, label string, count int) {
	{{
		active := (matchKey == "all" && data.Match == "") || data.Match == matchKey
		href := buildSmartOrderResultsURL(data.Run.PublicID, matchKey, data.SortBy, data.SortOrder, 1, data.PerPage, data.Search)
	}}
	<a href={ templ.SafeURL(href) }
		class={ "wiz-chip", templ.KV("is-on", active) }>
		<span>{ label }</span>
		<span class="badge tabular-nums">{ fmt.Sprintf("%d", count) }</span>
	</a>
}

templ SmartOrderResultsPage(lang, dir string, data SmartOrderResultsData) {
	@layouts.CustomerShell("نتائج الطلب الذكي والمطابقة", "purchase-request", lang, dir, nil) {
		<div class="container-fluid so-results-page">
			
			<!-- Header Banner -->
			<div class="so-page-header">
				<div>
					<h1 class="so-page-title">
						نتائج مطابقة الأصناف — { data.Run.RunNumber }
					</h1>
					<p class="so-page-subtitle">
						فحص ومراجعة نتائج مطابقة الأصناف وتوفر الموردين والتغطية بدقة مع إمكانية التعديل اليدوي قبل اعتماد الطلب.
					</p>
				</div>
				<div class="so-page-actions">
					<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/export", data.Run.PublicID)) } class="btn btn-secondary btn-sm fw-700">
						<span>تصدير النتائج (CSV)</span>
					</a>
					<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/review", data.Run.PublicID)) } class="btn btn-primary btn-sm fw-800 so-primary-action">
						<span>المتابعة إلى مراجعة الطلب ←</span>
					</a>
				</div>
			</div>

			@WizardRail(OrderRail(StepResults))

			<!-- Summary Stats Grid -->
			<div class="so-stat-grid">
				@statCard("إجمالي الأصناف", fmt.Sprintf("%d", data.Counts.Total))
				@statCard("غير مطابق", fmt.Sprintf("%d", data.Counts.Unmatched))
				@statCard("مطابق للصنف", fmt.Sprintf("%d", data.Counts.MatchedProduct))
				@statCard("لديه مورد", fmt.Sprintf("%d", data.Counts.MatchedSupplier))
				@statCard("متوفر بالمخزون", fmt.Sprintf("%d", data.Counts.AvailableStock))
				@statCard("مشمول بالتغطية", fmt.Sprintf("%d", data.Counts.CoveredBranch))
				@statCard("جاهز للطلب", fmt.Sprintf("%d", data.Counts.ReadyToOrder))
				@statCard("التكلفة التقديرية", data.Run.EstimatedTotal.String())
			</div>

			if data.Run.BudgetExceeded != nil && *data.Run.BudgetExceeded {
				<div class="so-alert so-alert-warning">
					<strong>تنبيه: تجاوز الميزانية المحددة</strong>
					if data.Run.BudgetOverage != nil {
						<span> — بزيادة { data.Run.BudgetOverage.String() }</span>
					}
					<div class="so-alert-detail">
						هذا تنبيه للمتابعة فقط: لم يُحذف أي صنف ويمكنك استكمال الطلب أو تعديل الكميات.
					</div>
				</div>
			}

			if data.Run.AI.Enabled && data.Run.AI.LinesReviewed+data.Run.AI.CacheHits > 0 {
				<div class="so-ai-summary">
					<strong class="so-ai-summary-title">تحسين المطابقة بالذكاء الاصطناعي</strong>
					<div class="so-alert-detail">
						{ aiSummary(data.Run.AI) }
					</div>
				</div>
			}

			@soBlockedPanel(data)

			<!-- Filter Tabs Bar & Search Toolbar -->
			<div class="card so-filter-card">
				
				<!-- Tabs: 6 Independent Statuses + Unmatched + All -->
				<div class="so-filter-tabs">
					@soFilterTab(data, "ready_to_order", "جاهز للطلب", data.Counts.ReadyToOrder)
					@soFilterTab(data, "blocked", "غير جاهز", data.Blocked.Total())
					@soFilterTab(data, "all", "الكل", data.Counts.Total)
					@soFilterTab(data, "unmatched", "غير مطابق", data.Counts.Unmatched)
					@soFilterTab(data, "matched_product", "مطابق للصنف", data.Counts.MatchedProduct)
					@soFilterTab(data, "matched_supplier", "لديه مورد", data.Counts.MatchedSupplier)
					@soFilterTab(data, "available_stock", "متوفر بالمخزون", data.Counts.AvailableStock)
					@soFilterTab(data, "covered_branch", "مشمول بالتغطية", data.Counts.CoveredBranch)
					@soFilterTab(data, "price_available", "السعر متوفر", data.Counts.PriceAvailable)
				</div>

				<!-- Search & Rows-Per-Page Form -->
				<form method="GET" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results", data.Run.PublicID)) } class="so-filter-form">
					if data.Match != "" {
						<input type="hidden" name="match" value={ data.Match } />
					}
					if data.SortBy != "" {
						<input type="hidden" name="sort" value={ data.SortBy } />
					}
					if data.SortOrder != "" {
						<input type="hidden" name="order" value={ data.SortOrder } />
					}

					<div class="so-filter-search">
						<input
							type="text"
							name="q"
							value={ data.Search }
							placeholder="بحث باسم الصنف، الكود، أو الباركود..."
							class="form-control"
							class="form-control"
						/>
					</div>

					<div class="so-filter-limit">
						<select name="limit" onchange="this.form.submit()" class="form-select">
							<option value="10" selected?={ data.PerPage == 10 }>10 صفوف</option>
							<option value="25" selected?={ data.PerPage == 25 || data.PerPage == 0 }>25 صنف</option>
							<option value="50" selected?={ data.PerPage == 50 }>50 صنف</option>
							<option value="100" selected?={ data.PerPage == 100 }>100 صنف</option>
							<option value="-1" selected?={ data.PerPage == -1 }>عرض الكل</option>
						</select>
					</div>

					<button type="submit" class="btn btn-primary btn-sm fw-700 so-filter-submit">
						بحث
					</button>

					if data.Search != "" {
						<a href={ templ.SafeURL(buildSmartOrderResultsURL(data.Run.PublicID, data.Match, data.SortBy, data.SortOrder, 1, data.PerPage, "")) } class="btn btn-secondary btn-sm so-filter-clear">
							إلغاء البحث
						</a>
					}
				</form>
			</div>

			<!-- Main Table Card -->
			<div class="card so-results-table-card">
				<div class="table-responsive">
					<table class="table so-results-table">
						<thead>
							<tr class="so-results-table-head">
								<th class="so-col-index">
									@soSortHeader(data, "row", "#")
								</th>
								<th class="so-col-item">
									@soSortHeader(data, "name", "الصنف كما ورد بالملف")
								</th>
								<th class="so-col-match">
									@soSortHeader(data, "matched_name", "الصنف المطابق بالكتالوج المركزي")
								</th>
								<th class="so-col-status">
									@soSortHeader(data, "method", "طريقة المطابقة")
								</th>
								<th class="so-col-qty">
									@soSortHeader(data, "confidence", "نسبة التطابق")
								</th>
								<th class="so-col-confidence">
									@soSortHeader(data, "qty", "الكمية")
								</th>
								<th class="so-col-actions">
									@soSortHeader(data, "outcome", "حالة الصنف")
								</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Lines) == 0 {
								<tr>
									<td colspan="7" class="so-empty-state">
										<div class="so-empty-title">لا توجد أصناف تطابق التصفية الحالية</div>
										<div class="so-empty-detail">جرب تغيير التبويب المختار أو مسح كلمات البحث.</div>
									</td>
								</tr>
							}
							for _, l := range data.Lines {
								@smartOrderResultRow(data, l)
							}
						</tbody>
					</table>
				</div>

				<!-- Pagination Bar -->
				if data.Total > 0 && data.PerPage != -1 {
					{{
						pageSize := data.PerPage
						if pageSize <= 0 {
							pageSize = 25
						}
						totalP := (data.Total + pageSize - 1) / pageSize
						startItem := (data.Page-1)*pageSize + 1
						endItem := data.Page * pageSize
						if endItem > data.Total {
							endItem = data.Total
						}
					}}
					<div class="so-pagination">
						<div class="so-pagination-summary">
							عرض <strong>{ fmt.Sprintf("%d - %d", startItem, endItem) }</strong> من إجمالي <strong>{ fmt.Sprintf("%d", data.Total) }</strong> صنف
						</div>

						<div class="so-pagination-controls">
							if data.Page > 1 {
								<a href={ templ.SafeURL(buildSmartOrderResultsURL(data.Run.PublicID, data.Match, data.SortBy, data.SortOrder, 1, data.PerPage, data.Search)) } class="btn btn-secondary btn-xs" title="الصفحة الأولى">&laquo;</a>
								<a href={ templ.SafeURL(buildSmartOrderResultsURL(data.Run.PublicID, data.Match, data.SortBy, data.SortOrder, data.Page-1, data.PerPage, data.Search)) } class="btn btn-secondary btn-xs" title="السابق">&lsaquo;</a>
							} else {
								<span class="btn btn-secondary btn-xs disabled">&laquo;</span>
								<span class="btn btn-secondary btn-xs disabled">&lsaquo;</span>
							}

							<span class="btn btn-primary btn-xs fw-700 pagination-current">
								{ fmt.Sprintf("صفحة %d من %d", data.Page, totalP) }
							</span>

							if data.Page < totalP {
								<a href={ templ.SafeURL(buildSmartOrderResultsURL(data.Run.PublicID, data.Match, data.SortBy, data.SortOrder, data.Page+1, data.PerPage, data.Search)) } class="btn btn-secondary btn-xs" title="التالي">&rsaquo;</a>
								<a href={ templ.SafeURL(buildSmartOrderResultsURL(data.Run.PublicID, data.Match, data.SortBy, data.SortOrder, totalP, data.PerPage, data.Search)) } class="btn btn-secondary btn-xs" title="الصفحة الأخيرة">&raquo;</a>
							} else {
								<span class="btn btn-secondary btn-xs disabled">&rsaquo;</span>
								<span class="btn btn-secondary btn-xs disabled">&raquo;</span>
							}
						</div>
					</div>
				}
			</div>

			<!-- Footer Action Buttons -->
			<div class="so-footer-actions">
				<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/export", data.Run.PublicID)) } class="btn btn-secondary fw-700">
					تصدير النتائج (CSV)
				</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/review", data.Run.PublicID)) } class="btn btn-primary fw-700 so-primary-action">
					المتابعة إلى مراجعة الطلب واعتماده ←
				</a>
			</div>
		</div>

		@smartOrderScript()
	}
}

// soBlockedPanel is everything the run will not order, folded away.
//
// The screen leads with the lines that are ready because that is what the
// pharmacist came for. What failed is not hidden — the counts are visible on
// the closed summary, and each reason opens the table filtered to it — but it
// does not sit between the buyer and their order, and it is not interleaved
// with the rows that are fine.
//
// Closed by default, and grouped by reason rather than listed flat, because
// "no supplier", "out of stock" and "nothing matched" are three different jobs
// for three different moments.
templ soBlockedPanel(data SmartOrderResultsData) {
	{{ blocked := data.Blocked }}
	if blocked.Total() > 0 {
		<details class="so-blocked-panel">
			<summary class="so-blocked-summary">
				<span class="so-blocked-title">
					⚠️ { fmt.Sprintf("%d صنف غير جاهز للطلب", blocked.Total()) }
				</span>
				<span class="so-blocked-hint">
					لن تُطلب هذه الأصناف. اضغط لعرض أسبابها ومعالجتها.
				</span>
			</summary>
			<div class="so-blocked-body">
				@soBlockedRow(data, "unmatched", "لم يُطابَق بالكتالوج", blocked.Unmatched,
					"اربط الصنف يدوياً بالكتالوج المركزي ليصبح قابلاً للطلب.")
				@soBlockedRow(data, "no_supplier", "لا يوجد مورد", blocked.NoSupplier,
					"الصنف مطابق لكن لا يعرضه أي مورد حالياً.")
				@soBlockedRow(data, "out_of_stock", "غير متوفر بالمخزون", blocked.OutOfStock,
					"العرض موجود لكن رصيده صفر لدى المورد.")
				@soBlockedRow(data, "coverage_blocked", "خارج نطاق التغطية", blocked.CoverageBlocked,
					"المورد لا يغطي فرع التسليم المختار.")
				@soBlockedRow(data, "institutional_blocked", "غير متاح مؤسسياً", blocked.InstitutionalBlocked,
					"العرض مقيّد باتفاقية لا تشمل منشأتك.")
				@soBlockedRow(data, "below_min_qty", "أقل من الحد الأدنى للطلب", blocked.BelowMinQty,
					"ارفع الكمية إلى الحد الأدنى الذي يشترطه المورد.")
				@soBlockedRow(data, "zero_qty", "الكمية صفر", blocked.ZeroQty,
					"لم يُقرأ للصنف كمية من الملف؛ أدخلها يدوياً.")
			</div>
		</details>
	}
}

// soBlockedRow is one reason, with a link that opens the table filtered to it.
templ soBlockedRow(data SmartOrderResultsData, outcome, label string, count int, hint string) {
	if count > 0 {
		<a class="so-blocked-row"
			href={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/results?match=%s", data.Run.PublicID, outcome)) }>
			<span class="so-blocked-count tabular-nums">{ fmt.Sprintf("%d", count) }</span>
			<span class="so-blocked-label">{ label }</span>
			<span class="so-blocked-detail">{ hint }</span>
			<span class="so-blocked-go">معالجة ←</span>
		</a>
	}
}
