package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/platform/gateway"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminPlansData holds plan definitions, active subscriptions, and AI Gateway plans.
type AdminPlansData struct {
	ActiveTab     string // "plans", "subscriptions"
	Plans         []*billing.Plan
	Subscriptions []*billing.Subscription
	GatewayPlans  []gateway.GatewayPlan
	GatewayURL    string
	GatewayOnline bool
}

func countActivePlans(plans []*billing.Plan) int {
	c := 0
	for _, p := range plans {
		if p.IsActive {
			c++
		}
	}
	return c
}

func getDefaultPlanName(plans []*billing.Plan, lang string) string {
	for _, p := range plans {
		if p.IsDefault {
			name := p.Name.Get(i18n.Lang(lang))
			if name == "" {
				name = p.Slug
			}
			return name
		}
	}
	return "غير محدد"
}

templ AdminPlans(lang, dir string, plans []*billing.Plan) {
	@AdminPlansHub(AdminPlansData{ActiveTab: "plans", Plans: plans}, lang, dir)
}

templ AdminPlansHub(data AdminPlansData, lang, dir string) {
	@layouts.AdminShell("باقات وخطط الاشتراك الموحدة", "plans", lang, dir) {
		<div x-data="adminPlansManager()" class="page-container py-6">
			
			<!-- Top Header & Actions -->
			<div class="glass-panel p-6 mb-6 border border-slate-200/80 rounded-2xl shadow-sm">
				<div class="flex-between items-center flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3">
							<div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
								@components.IconTag("icon-sm")
							</div>
       <div class="stack-sm">
								<h1 class="text-2xl font-black text-primary m-0">
									باقات واشتراكات المنظومة الموحدة
								</h1>
								<p class="text-xs text-secondary m-0 mt-1 font-medium">
									إدارة مركزية لخطط الاشتراكات، حدود الجلسات المتزامنة، وحصص بوابة الذكاء الاصطناعي (AI Gateway)
								</p>
							</div>
						</div>
					</div>

					<div class="d-flex items-center gap-3 flex-wrap">
						<!-- AI Gateway Connection Status Indicator -->
						<div class="d-inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-slate-200/80 text-xs bg-surface-sunken">
							@components.IconZap("icon-xs text-amber-500")
							<span class="text-secondary font-bold">بوابة الذكاء الاصطناعي:</span>
							if data.GatewayOnline {
								<span class="badge badge-emerald text-xs font-bold">متصلة ومزامنة</span>
							} else {
								<span class="badge badge-amber text-xs font-bold" title="جاري الاتصال بـ Endpoint">جاهزة للربط</span>
							}
							if data.GatewayURL != "" {
								<code dir="ltr" class="text-xs text-muted font-mono">{ data.GatewayURL }</code>
							}
						</div>

						<!-- Add New Plan Action -->
						<button
							type="button"
							class="btn btn-primary btn-sm font-black text-xs gap-1.5 shadow-sm"
							@click="openCreateModal()"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة باقة جديدة</span>
						</button>
					</div>
				</div>
			</div>

			<!-- KPI Summary Metrics (4-grid) -->
			<div class="grid-4 mb-6">
				<!-- KPI 1: Total Plans -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">إجمالي الباقات</span>
						<span class="text-brand">@components.IconTag("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-primary mt-2">
						{ fmt.Sprintf("%d", len(data.Plans)) } <span class="text-xs text-muted font-normal">باقة</span>
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t flex-between">
						<span>النشطة: <strong class="text-emerald">{ fmt.Sprintf("%d", countActivePlans(data.Plans)) }</strong></span>
						<span>المعطلة: <strong class="text-secondary">{ fmt.Sprintf("%d", len(data.Plans) - countActivePlans(data.Plans)) }</strong></span>
					</div>
				</div>

				<!-- KPI 2: Default System Plan -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">الباقة الافتراضية</span>
						<span class="text-amber-500">@components.IconShield("icon-xs")</span>
					</div>
					<div class="text-lg font-black text-primary mt-2 text-truncate" title={ getDefaultPlanName(data.Plans, lang) }>
						{ getDefaultPlanName(data.Plans, lang) }
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t">
						تُمنح تلقائياً لأي منشأة جديدة مسجلة
					</div>
				</div>

				<!-- KPI 3: Total Active Subscriptions -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">المشتركون النشطون</span>
						<span class="text-emerald">@components.IconUsers("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-emerald mt-2">
						{ fmt.Sprintf("%d", len(data.Subscriptions)) } <span class="text-xs text-muted font-normal">منشأة</span>
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t">
						اشتراكات سارية ومفعلة بالكامل
					</div>
				</div>

				<!-- KPI 4: AI Gateway Tiers Available -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">باقات الـ AI Gateway</span>
						<span class="text-purple-500">@components.IconZap("icon-xs")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-purple mt-2">
						{ fmt.Sprintf("%d", len(data.GatewayPlans)) } <span class="text-xs text-muted font-normal">باقة</span>
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t">
						حصص الكوتا وتوليد الـ Virtual Keys
					</div>
				</div>
			</div>

			<!-- Main Content Panel with Tabs -->
			<div class="glass-panel p-6 mb-6">
				<!-- Tab Navigation -->
				<div class="cb-tabs-nav m-0 mb-6 pb-4 border-b">
					<a
						href="/admin/plans?tab=plans"
						class={ "cb-tab-btn", templ.KV("active", data.ActiveTab == "plans" || data.ActiveTab == "") }
					>
						@components.IconTag("icon-xs")
						<span>دليل باقات الاشتراك الموحدة ({ fmt.Sprintf("%d", len(data.Plans)) })</span>
					</a>
					<a
						href="/admin/plans?tab=subscriptions"
						class={ "cb-tab-btn", templ.KV("active", data.ActiveTab == "subscriptions") }
					>
						@components.IconWallet("icon-xs")
						<span>سجلات المشتركين والمنشآت ({ fmt.Sprintf("%d", len(data.Subscriptions)) })</span>
					</a>
				</div>

    <div class="stack-sm">
					if data.ActiveTab == "subscriptions" {
						<!-- TAB 2: Subscriptions Table -->
						if len(data.Subscriptions) == 0 {
							<div class="p-8 text-center empty-state-glass">
								<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
									@components.IconTag("icon-md")
								</div>
								<h3 class="text-base font-black text-primary mb-1.5">لا توجد اشتراكات مسجلة حالياً</h3>
								<p class="text-xs text-secondary max-w-md mx-auto">ستظهر هنا سجلات اشتراكات المنشآت فور اعتمادها وتفعيل حساباتها.</p>
							</div>
						} else {
							<div class="table-container m-0 overflow-x-auto">
								<table class="data-table m-0 text-xs w-full">
									<thead>
										<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
											<th class="py-3 text-start ps-4">رقم الاشتراك</th>
											<th class="py-3 text-start">المنشأة / المستفيد</th>
											<th class="py-3 text-start">باقة الاشتراك</th>
											<th class="text-center py-3">الحالة</th>
											<th class="text-center py-3">دورة الفوترة</th>
											<th class="text-center py-3">تاريخ البدء</th>
											<th class="text-center py-3 pe-4">تاريخ الانتهاء</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-slate-100">
										for _, s := range data.Subscriptions {
											<tr class="transition-colors">
												<td class="tabular-nums font-bold text-primary py-3 ps-4">{ fmt.Sprintf("SUB-%d", s.ID) }</td>
												<td class="py-3">
													if s.OrganizationID != nil && *s.OrganizationID > 0 {
														<span class="badge badge-primary font-bold text-xs">منشأة #{ fmt.Sprintf("%d", *s.OrganizationID) }</span>
													} else {
														<span class="badge badge-secondary text-xs">مستخدم #{ fmt.Sprintf("%d", s.UserID) }</span>
													}
												</td>
												<td class="py-3">
													for _, p := range data.Plans {
														if p.ID == s.PlanID {
															<div class="font-extrabold text-primary">{ p.Name.Get(i18n.Lang(lang)) }</div>
															<span class="text-xs text-muted" dir="ltr"><code>{ p.Slug }</code></span>
														}
													}
												</td>
												<td class="text-center py-3">
													if s.Status == "active" {
														<span class="badge badge-emerald font-extrabold text-xs">ساري وفعال</span>
													} else {
														<span class="badge badge-slate text-xs">{ string(s.Status) }</span>
													}
												</td>
												<td class="text-center py-3">
													if s.BillingCycle == "annual" {
														<span class="badge badge-sky font-bold text-xs">سنوي</span>
													} else {
														<span class="badge badge-slate text-xs">شهري</span>
													}
												</td>
												<td class="text-center tabular-nums text-secondary font-medium py-3">{ s.StartsAt.Format("2006-01-02") }</td>
												<td class="text-center tabular-nums text-secondary font-medium py-3 pe-4">{ s.ExpiresAt.Format("2006-01-02") }</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					} else {
						<!-- TAB 1: Unified Plans Cards Grid -->
						if len(data.Plans) == 0 {
							<div class="p-8 text-center empty-state-glass">
								<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
									@components.IconBoxes("icon-md")
								</div>
								<h3 class="text-base font-black text-primary mb-1.5">لا توجد باقات اشتراك معرفة بالمنظومة</h3>
								<p class="text-xs text-secondary max-w-md mx-auto mb-4">قم بإنشاء باقة اشتراك جديدة لتحديد الأسعار وحدود الجلسات وصلاحيات الذكاء الاصطناعي.</p>
								<button type="button" class="btn btn-primary btn-sm font-bold shadow-xs" @click="openCreateModal()">
									@components.IconPlus("icon-xs")
									<span>إنشاء الباقة الأولى</span>
								</button>
							</div>
						} else {
							<div class="d-grid grid-auto-fit-sm gap-6">
								for _, p := range data.Plans {
									<div class={ "glass-panel p-6 border border-slate-200/80 rounded-2xl shadow-xs transition-all d-flex flex-col justify-between", templ.KV("ring-2 ring-brand-500 shadow-md", p.IsDefault) }>
										<!-- Card Top: Badges & Title -->
          <div class="stack-sm">
											<!-- Header Badges -->
											<div class="flex-between items-start gap-2 mb-3">
            <div class="stack-sm">
													<div class="d-flex items-center gap-2 flex-wrap">
														<h3 class="m-0 text-base font-black text-primary">
															{ p.Name.Get(i18n.Lang(lang)) }
														</h3>
														if p.IsDefault {
															<span class="badge badge-primary font-black text-2xs shadow-2xs">
																الباقة الافتراضية
															</span>
														}
													</div>
													<div dir="ltr" class="text-xs text-muted font-mono mt-0.5">
														<code>{ p.Slug }</code>
													</div>
												</div>

												<div class="d-flex items-center gap-1">
													if p.IsActive {
														<span class="badge badge-emerald font-extrabold text-2xs">نشطة</span>
													} else {
														<span class="badge badge-slate text-2xs">معطلة</span>
													}
												</div>
											</div>

											<!-- Description -->
											if p.Description.Get(i18n.Lang(lang)) != "" {
												<p class="text-xs text-secondary mb-4 leading-relaxed font-medium">
													{ p.Description.Get(i18n.Lang(lang)) }
												</p>
											} else {
												<p class="text-xs text-muted mb-4 italic">
													لا يوجد وصف محدد للباقة
												</p>
											}

											<!-- Pricing Display Strip -->
											<div class="bg-surface-sunken border border-slate-200/80 rounded-xl p-3.5 mb-4 flex-between items-center">
            <div class="stack-sm">
													<div class="text-2xs text-secondary font-bold">الاشتراك الشهري</div>
													<div class="text-lg font-black text-brand tabular-nums">
														if p.PriceMonth.IsPositive() {
															{ p.PriceMonth.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
														} else {
															<span class="text-emerald-600 font-bold">مجاني</span>
														}
													</div>
												</div>
												<div class="text-end border-s border-slate-200/80 ps-3">
													<div class="text-2xs text-secondary font-bold">الاشتراك السنوي</div>
													<div class="text-sm font-black text-primary tabular-nums">
														if p.PriceYear.IsPositive() {
															{ p.PriceYear.String() } <span class="text-2xs font-bold text-secondary">ج.م</span>
														} else {
															<span class="text-emerald-600 font-bold">مجاني</span>
														}
													</div>
												</div>
												<div class="text-end border-s border-slate-200/80 ps-3">
													<div class="text-2xs text-secondary font-bold">الصلاحية</div>
													<div class="text-xs font-extrabold text-secondary tabular-nums">
														{ fmt.Sprintf("%d يوم", p.DurationDays) }
													</div>
												</div>
											</div>

											<!-- Quotas & Limits Box -->
											<div class="bg-brand-50/40 border border-brand-200/50 rounded-xl p-3.5 mb-4">
												<div class="text-xs font-extrabold text-brand-700 mb-2.5 d-flex items-center gap-1.5">
													@components.IconShield("icon-2xs")
													<span>حدود الجلسات والأمان للمنشأة</span>
												</div>

												<div class="d-flex flex-col gap-2 text-xs">
													<!-- Concurrent Sessions Limit -->
													<div class="flex-between">
														<span class="text-secondary d-flex items-center gap-1.5 font-medium">
															@components.IconUsers("icon-2xs text-muted")
															<span>الجلسات المتزامنة:</span>
														</span>
														<strong class="text-primary tabular-nums font-bold">
															{ fmt.Sprintf("%d جلسات", p.MaxLoginSessions) }
														</strong>
													</div>

													<!-- Max Devices Limit -->
													<div class="flex-between">
														<span class="text-secondary d-flex items-center gap-1.5 font-medium">
															@components.IconSettings("icon-2xs text-muted")
															<span>الأجهزة المسموح بها:</span>
														</span>
														<strong class="text-primary tabular-nums font-bold">
															{ fmt.Sprintf("%d أجهزة", p.MaxDevices) }
														</strong>
													</div>

													<!-- Max Compare Files Limit -->
													<div class="flex-between">
														<span class="text-secondary d-flex items-center gap-1.5 font-medium">
															@components.IconBoxes("icon-2xs text-muted")
															<span>كشوف الموردين للمقارنة:</span>
														</span>
														<strong class="text-primary tabular-nums font-bold">
															if p.GetMaxCompareFiles() == 0 {
																<span>غير محدود</span>
															} else {
																{ fmt.Sprintf("%d كشوف", p.GetMaxCompareFiles()) }
															}
														</strong>
													</div>

													<!-- Compare Files Retention Days -->
													<div class="flex-between">
														<span class="text-secondary d-flex items-center gap-1.5 font-medium">
															@components.IconClock("icon-2xs text-muted")
															<span>صلاحية احتفاظ الملفات:</span>
														</span>
														<strong class="text-primary tabular-nums font-bold">
															if p.GetCompareRetentionDays() == 0 {
																<span>دائمة (بدون مسح)</span>
															} else {
																{ fmt.Sprintf("%d يوم", p.GetCompareRetentionDays()) }
															}
														</strong>
													</div>

													<!-- AI Gateway Plan -->
													<div class="flex-between border-t border-dashed border-slate-200 pt-2 mt-1">
														<span class="text-secondary d-flex items-center gap-1.5 font-medium">
															@components.IconZap("icon-2xs text-amber-500")
															<span>باقة الـ AI Gateway:</span>
														</span>
														<span class="badge badge-sky font-mono font-bold text-2xs" dir="ltr">
															{ p.AIPlanID }
														</span>
													</div>
												</div>
											</div>

											<!-- Features Badges -->
											<div class="bg-surface-sunken border border-slate-200/80 rounded-xl p-3 mb-4">
												<div class="text-2xs font-bold text-secondary mb-2">
													صلاحيات وميزات المنظومة:
												</div>
												<div class="d-flex flex-col gap-1.5 text-xs font-medium">
													if p.HasFeature("feature_market_discounts") {
														<div class="d-flex items-center gap-1.5 text-emerald-600 font-bold">
															@components.IconCheck("icon-2xs")
															<span>خصومات السوق العامة ومؤشرات الأسعار</span>
														</div>
													}

													if p.HasFeature("feature_compare_tool") || p.HasFeature("compare") {
														<div class="d-flex items-center gap-1.5 text-brand-600 font-bold">
															@components.IconCheck("icon-2xs")
															<span>أداة مقارنة الخصومات وتحليل العروض</span>
														</div>
													}

													if p.HasFeature("bulk_import") {
														<div class="d-flex items-center gap-1.5 text-sky-600 font-bold">
															@components.IconCheck("icon-2xs")
															<span>استيراد وتحديث الكتالوجات بالجملة</span>
														</div>
													}

													if p.HasFeature("analytics") {
														<div class="d-flex items-center gap-1.5 text-purple-600 font-bold">
															@components.IconCheck("icon-2xs")
															<span>لوحة التحليلات المتقدمة والتقارير</span>
														</div>
													}
												</div>
											</div>
										</div>

										<!-- Card Bottom Action Toolbar -->
										<div class="border-t border-slate-100 pt-3 mt-auto d-flex flex-col gap-2">
											<button
												type="button"
												class="btn btn-secondary btn-sm w-full justify-center font-extrabold gap-1.5 shadow-2xs edit-plan-trigger-btn"
												data-id={ fmt.Sprintf("%d", p.ID) }
												data-slug={ p.Slug }
												data-name-ar={ p.Name.Get("ar") }
												data-name-en={ p.Name.Get("en") }
												data-desc-ar={ p.Description.Get("ar") }
												data-desc-en={ p.Description.Get("en") }
												data-price-month={ p.PriceMonth.String() }
												data-price-year={ p.PriceYear.String() }
												data-duration={ fmt.Sprintf("%d", p.DurationDays) }
												data-sessions={ fmt.Sprintf("%d", p.MaxLoginSessions) }
												data-devices={ fmt.Sprintf("%d", p.MaxDevices) }
												data-max-compare-files={ fmt.Sprintf("%d", p.GetMaxCompareFiles()) }
												data-compare-retention={ fmt.Sprintf("%d", p.GetCompareRetentionDays()) }
												data-ai-plan={ p.AIPlanID }
												data-is-default={ fmt.Sprintf("%t", p.IsDefault) }
												data-is-active={ fmt.Sprintf("%t", p.IsActive) }
												data-feat-market={ fmt.Sprintf("%t", p.HasFeature("feature_market_discounts")) }
												data-feat-compare={ fmt.Sprintf("%t", p.HasFeature("feature_compare_tool") || p.HasFeature("compare")) }
												data-feat-import={ fmt.Sprintf("%t", p.HasFeature("bulk_import")) }
												data-feat-analytics={ fmt.Sprintf("%t", p.HasFeature("analytics")) }
												@click="openEditFromDataset($el)"
											>
												@components.IconEdit("icon-xs")
												<span>تعديل إعدادات وصلاحيات الباقة</span>
											</button>

											<!-- Secondary Action Strip: Quick Toggle, Set Default, Delete -->
											<div class="d-flex items-center gap-2 pt-1">
												<!-- Quick Toggle Active Status -->
												<form class="stack-md" method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/plans/%d/toggle", p.ID)) }>
													if p.IsActive {
														<button type="submit" class="btn btn-outline-secondary btn-xs w-full" title="تعطيل الباقة مؤقتاً">
															<span>إيقاف الباقة</span>
														</button>
													} else {
														<button type="submit" class="btn btn-outline-success btn-xs w-full font-bold" title="تفعيل الباقة">
															<span>تفعيل الباقة</span>
														</button>
													}
												</form>

												<!-- Set Default Plan -->
												if !p.IsDefault {
													<form class="stack-md" method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/plans/%d/set-default", p.ID)) }>
														<button type="submit" class="btn btn-outline-amber btn-xs w-full d-flex items-center justify-center gap-1" title="جعلها الباقة الافتراضية">
															@components.IconShield("icon-2xs")
															<span>تعيين كافتراضية</span>
														</button>
													</form>
												}

												<!-- Delete Plan (if not default) -->
												if !p.IsDefault {
													<form class="stack-md" method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/plans/%d/delete", p.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف هذه الباقة نهائياً؟');">
														<button type="submit" class="btn btn-outline-danger btn-xs btn-icon" title="حذف الباقة">
															@components.IconTrash("icon-2xs text-rose-600")
														</button>
													</form>
												}
											</div>

										</div>
									</div>
								}
							</div>
						}
					}
				</div>
			</div>

			<!-- ========================================== -->
			<!-- Create / Edit Plan Modal                   -->
			<!-- ========================================== -->
			<!-- ========================================== -->
			<!-- Create / Edit Plan Modal                   -->
			<!-- ========================================== -->
			@components.Modal(components.ModalProps{
				ID:       "admin-plan-modal",
				Title:    "إنشاء خطة اشتراك جديدة",
				Subtitle: "تحديد مميزات وخيارات الباقة للمشتركين والمنشآت على المنصة",
				Size:     "lg",
			}) {
				<form :action="formAction" method="POST" class="d-flex flex-col gap-4 m-0">
						<div class="modal-body d-flex flex-col gap-4">
							<!-- Section 1: Identity & Names -->
							<div class="d-grid grid-auto-fit-sm gap-4">
        <div class="stack-sm">
									<label class="form-label font-bold text-xs d-block mb-1">المعرّف الفريد (Slug) <span class="text-danger">*</span></label>
									<input type="text" name="slug" x-model="form.slug" required class="form-input text-xs font-mono" placeholder="e.g. basic, pro, enterprise" dir="ltr" />
								</div>
        <div class="stack-sm">
									<label class="form-label font-bold text-xs d-block mb-1">اسم الباقة (عربي) <span class="text-danger">*</span></label>
									<input type="text" name="name_ar" x-model="form.name_ar" required class="form-input text-xs font-bold" placeholder="مثال: الباقة الاحترافية" />
								</div>
							</div>

							<div class="d-grid grid-auto-fit-sm gap-4">
        <div class="stack-sm">
									<label class="form-label font-bold text-xs d-block mb-1">اسم الباقة (إنجليزي)</label>
									<input type="text" name="name_en" x-model="form.name_en" class="form-input text-xs" placeholder="e.g. Professional Plan" dir="ltr" />
								</div>
        <div class="stack-sm">
									<label class="form-label font-bold text-xs d-block mb-1">فترة الصلاحية (أيام) <span class="text-danger">*</span></label>
									<input type="number" name="duration_days" x-model="form.duration" class="form-input tabular-nums text-xs" min="1" required />
								</div>
							</div>

       <div class="stack-sm">
								<label class="form-label font-bold text-xs d-block mb-1">وصف الباقة ومزاياها للمشتركين</label>
								<textarea name="description_ar" x-model="form.desc_ar" rows="2" class="form-input text-xs" placeholder="اكتب نبذة توضيحية عن ميزات الباقة..."></textarea>
							</div>

							<!-- Section 2: Pricing (Monthly & Yearly) -->
							<div class="bg-surface-sunken border border-slate-200/80 rounded-xl p-4">
								<div class="text-xs font-extrabold text-primary mb-3 d-flex items-center gap-1.5">
									@components.IconCreditCard("icon-xs text-brand")
									<span>تسعير الباقة (شهري وسنوي)</span>
								</div>

								<div class="d-grid grid-auto-fit-sm gap-3">
         <div class="stack-sm">
										<label class="form-label font-bold text-xs d-block mb-1">السعر الشهري (ج.م) <span class="text-danger">*</span></label>
										<input type="number" step="0.01" min="0" name="price_month" x-model="form.price_month" class="form-input tabular-nums text-xs font-bold" placeholder="0.00" required />
										<span class="text-2xs text-muted mt-1 d-block font-medium">ضع 0 للباقات المجانية</span>
									</div>
         <div class="stack-sm">
										<label class="form-label font-bold text-xs d-block mb-1">السعر السنوي (ج.م) <span class="text-danger">*</span></label>
										<input type="number" step="0.01" min="0" name="price_year" x-model="form.price_year" class="form-input tabular-nums text-xs font-bold" placeholder="0.00" required />
										<span class="text-2xs text-muted mt-1 d-block font-medium">سعر الدفع السنوي المجمع</span>
									</div>
								</div>
							</div>

							<!-- Section 3: Limits & AI Gateway Plan -->
							<div class="bg-surface-sunken border border-slate-200/80 rounded-xl p-4 d-flex flex-col gap-3">
								<div class="text-xs font-extrabold text-primary d-flex items-center gap-1.5">
									@components.IconShield("icon-xs text-brand")
									<span>حدود الأمان والجلسات المطبقة على إجمالي المنشأة</span>
								</div>

								<div class="d-grid grid-auto-fit-sm gap-3">
         <div class="stack-sm">
										<label class="form-label font-bold text-xs d-block mb-1">الجلسات المتزامنة <span class="text-danger">*</span></label>
										<input type="number" name="max_login_sessions" x-model="form.sessions" class="form-input tabular-nums text-xs" min="1" max="500" required />
										<span class="text-2xs text-secondary mt-1 d-block font-medium">مطبقة على إجمالي المنشأة</span>
									</div>
         <div class="stack-sm">
										<label class="form-label font-bold text-xs d-block mb-1">الأجهزة المسموح بها <span class="text-danger">*</span></label>
										<input type="number" name="max_devices" x-model="form.devices" class="form-input tabular-nums text-xs" min="1" max="500" required />
										<span class="text-2xs text-secondary mt-1 d-block font-medium">أقصى أجهزة مسجلة</span>
									</div>
         <div class="stack-sm">
										<label class="form-label font-bold text-xs d-block mb-1">كشوف المقارنة المسموحة <span class="text-danger">*</span></label>
										<input type="number" name="max_compare_files" x-model="form.max_compare_files" class="form-input tabular-nums text-xs font-bold" min="0" max="500" required />
										<span class="text-2xs text-secondary mt-1 d-block font-medium">أقصى كشوف موردين (0 لغير محدود)</span>
									</div>
         <div class="stack-sm">
										<label class="form-label font-bold text-xs d-block mb-1">صلاحية ملفات المقارنة (بالأيام) <span class="text-danger">*</span></label>
										<input type="number" name="compare_file_retention_days" x-model="form.compare_file_retention_days" class="form-input tabular-nums text-xs font-bold" min="0" max="3650" required />
										<span class="text-2xs text-secondary mt-1 d-block font-medium">مسح آلي بعد X يوم (0 للدائمة)</span>
									</div>
								</div>

								<div class="pt-2 border-t border-slate-200/80">
									<div class="flex-between items-center mb-1">
										<label class="form-label m-0 font-bold text-xs">باقة بوابة الذكاء الاصطناعي (AI Gateway Plan) <span class="text-danger">*</span></label>
										if data.GatewayURL != "" {
											<span class="text-2xs text-primary font-semibold">(مزامنة من { data.GatewayURL })</span>
										}
									</div>
									<select name="ai_plan_id" x-model="form.ai_plan" class="form-input text-xs font-semibold">
										for _, gp := range data.GatewayPlans {
											<option value={ gp.ID }>
												{ gp.Name } ({ gp.ID }) — { fmt.Sprintf("%d RPM / %d TPM", gp.RPMLimit, gp.TPMLimit) }
											</option>
										}
									</select>
								</div>
							</div>

							<!-- Section 4: Entitlements & Features Checklist -->
							<div class="d-flex flex-col gap-2.5 pt-2 border-t border-slate-100">
								<div class="text-xs font-extrabold text-primary d-flex items-center gap-1.5">
									@components.IconTag("icon-xs text-brand")
									<span>صلاحيات وميزات المنظومة المتضمنة:</span>
								</div>

								<label class="d-flex gap-2.5 items-center cursor-pointer p-2.5 rounded-xl border border-emerald-200/60 bg-emerald-50/40">
									<input type="checkbox" name="feature_market_discounts" value="1" x-model="form.feat_market" />
         <div class="stack-sm">
										<strong class="text-primary d-block text-xs font-extrabold">(خاص بالموردين) إتاحة الوصول إلى: خصومات السوق العامة ومؤشرات الأسعار</strong>
										<span class="text-2xs text-secondary font-medium">تمكين المورد من استعراض خصومات السوق الحية والتحليلات المقارنة</span>
									</div>
								</label>

								<label class="d-flex gap-2.5 items-center cursor-pointer p-2.5 rounded-xl border border-indigo-200/60 bg-indigo-50/40">
									<input type="checkbox" name="feature_compare_tool" value="1" x-model="form.feat_compare" />
         <div class="stack-sm">
										<strong class="text-primary d-block text-xs font-extrabold">(خاص بالموردين) إتاحة الوصول إلى: أداة مقارنة الخصومات وتحليل العروض</strong>
										<span class="text-2xs text-secondary font-medium">تمكين المورد من تشغيل أداة المقارنة المتقدمة للملفات وخصومات الموردين</span>
									</div>
								</label>

								<label class="d-flex gap-2.5 items-center cursor-pointer p-2.5 rounded-xl border border-sky-200/60 bg-sky-50/40">
									<input type="checkbox" name="feature_bulk_import" value="1" x-model="form.feat_import" />
         <div class="stack-sm">
										<strong class="text-primary d-block text-xs font-extrabold">إتاحة استيراد وتحديث الكتالوجات بالجملة (Bulk Ingest)</strong>
										<span class="text-2xs text-secondary font-medium">معالجة وتحديث كميات وأسعار الأصناف من ملفات Excel و CSV</span>
									</div>
								</label>

								<label class="d-flex gap-2.5 items-center cursor-pointer p-2.5 rounded-xl border border-purple-200/60 bg-purple-50/40">
									<input type="checkbox" name="feature_analytics" value="1" x-model="form.feat_analytics" />
         <div class="stack-sm">
										<strong class="text-primary d-block text-xs font-extrabold">إتاحة لوحة التحليلات المتقدمة والتقارير المالية</strong>
										<span class="text-2xs text-secondary font-medium">إحصائيات تفصيلية ومؤشرات الأداء للأعمال والمبيعات</span>
									</div>
								</label>
							</div>

							<!-- Section 5: Default & Status Switches -->
							<div class="d-flex flex-col gap-2.5 pt-2 border-t border-slate-100">
								<label class="d-flex gap-2.5 items-center cursor-pointer p-2.5 rounded-xl border border-amber-200/60 bg-amber-50/40">
									<input type="checkbox" name="is_default" value="1" x-model="form.is_default" />
         <div class="stack-sm">
										<strong class="text-primary d-block text-xs font-extrabold">تعيين كباقة افتراضية للمنظومة (Default Plan)</strong>
										<span class="text-2xs text-secondary font-medium">تُمنح تلقائياً ومجاناً لأي منشأة جديدة فور تسجيلها واعتمادها من الإدارة</span>
									</div>
								</label>

								<label class="d-flex gap-2.5 items-center cursor-pointer p-2.5 rounded-xl border border-slate-200/80 bg-surface-sunken">
									<input type="checkbox" name="is_active" value="1" x-model="form.is_active" />
         <div class="stack-sm">
										<strong class="text-primary d-block text-xs font-extrabold">الباقة نشطة ومتاحة للاشتراك والتجديد</strong>
										<span class="text-2xs text-secondary font-medium">عند التعطيل لن يتمكن المشتركون الجدد من اختيار هذه الباقة</span>
									</div>
								</label>
							</div>
						</div>

						<!-- Modal Actions -->
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary btn-sm font-bold" onclick="document.getElementById('admin-plan-modal').close()">إلغاء</button>
							<button type="submit" class="btn btn-primary btn-sm font-black px-6 shadow-sm gap-1.5">
								@components.IconCheck("icon-xs")
								<span x-text="isEdit ? 'حفظ التحديثات' : 'إضافة وتفعيل الباقة'"></span>
							</button>
						</div>
					</form>
			}

		</div>

		<!-- Clean Client-Side State Manager without inline string interpolation bugs -->
		<script>
			function adminPlansManager() {
				return {
					isEdit: false,
					formAction: '/admin/plans',
					form: {
						id: 0,
						slug: '',
						name_ar: '',
						name_en: '',
						desc_ar: '',
						desc_en: '',
						price_month: '0.00',
						price_year: '0.00',
						duration: 30,
						sessions: 3,
						devices: 3,
						max_compare_files: 10,
						compare_file_retention_days: 30,
						ai_plan: 'plan-dev',
						is_default: false,
						is_active: true,
						feat_market: false,
						feat_compare: false,
						feat_import: false,
						feat_analytics: false
					},
					openCreateModal() {
						this.isEdit = false;
						this.formAction = '/admin/plans';
						this.form = {
							id: 0,
							slug: '',
							name_ar: '',
							name_en: '',
							desc_ar: '',
							desc_en: '',
							price_month: '0.00',
							price_year: '0.00',
							duration: 30,
							sessions: 3,
							devices: 3,
							max_compare_files: 10,
							compare_file_retention_days: 30,
							ai_plan: 'plan-dev',
							is_default: false,
							is_active: true,
							feat_market: false,
							feat_compare: false,
							feat_import: false,
							feat_analytics: false
						};
						const modal = document.getElementById('admin-plan-modal');
						if (modal && typeof modal.showModal === 'function') modal.showModal();
					},
					openEditFromDataset(btnEl) {
						if (!btnEl || !btnEl.dataset) return;
						const ds = btnEl.dataset;
						this.isEdit = true;
						this.formAction = '/admin/plans/' + ds.id + '/update';
						this.form = {
							id: parseInt(ds.id, 10) || 0,
							slug: ds.slug || '',
							name_ar: ds.nameAr || '',
							name_en: ds.nameEn || '',
							desc_ar: ds.descAr || '',
							desc_en: ds.descEn || '',
							price_month: ds.priceMonth || '0.00',
							price_year: ds.priceYear || '0.00',
							duration: parseInt(ds.duration, 10) || 30,
							sessions: parseInt(ds.sessions, 10) || 3,
							devices: parseInt(ds.devices, 10) || 3,
							max_compare_files: typeof ds.maxCompareFiles !== 'undefined' ? parseInt(ds.maxCompareFiles, 10) : 10,
							compare_file_retention_days: typeof ds.compareRetention !== 'undefined' ? parseInt(ds.compareRetention, 10) : 30,
							ai_plan: ds.aiPlan || 'plan-dev',
							is_default: ds.isDefault === 'true',
							is_active: ds.isActive === 'true',
							feat_market: ds.featMarket === 'true',
							feat_compare: ds.featCompare === 'true',
							feat_import: ds.featImport === 'true',
							feat_analytics: ds.featAnalytics === 'true'
						};
						const modal = document.getElementById('admin-plan-modal');
						if (modal && typeof modal.showModal === 'function') modal.showModal();
					}
				}
			}
		</script>
	}
}

