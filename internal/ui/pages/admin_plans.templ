package pages

import (
	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminPlans(lang, dir string, plans []*billing.Plan) {
	@layouts.AdminShell("خطط الاشتراك | Plans", "plans", lang, dir) {

		<!-- Sub-views of the plans screen. They are reached from here rather
		     than from the sidebar: one concept, one top-level entry. -->
		<div class="row-center" style="margin-bottom:1rem; flex-wrap:wrap;">
			<a href="/admin/plans-info" class="btn btn-secondary btn-sm">تفاصيل الباقات</a>
			<a href="/admin/plan-types" class="btn btn-secondary btn-sm">أنواع الباقات</a>
			<a href="/admin/plan-features" class="btn btn-secondary btn-sm">مزايا الباقات</a>
			<a href="/admin/plans/subscriptions" class="btn btn-secondary btn-sm">الاشتراكات النشطة</a>
		</div>
		<div class="card" style="margin-bottom:1.25rem;">
			<h2 class="card-title" style="margin:0 0 1rem;">خطة جديدة</h2>
			<form method="POST" action="/admin/plans" style="display:flex; flex-direction:column; gap:0.9rem;">
				<div class="form-grid-2">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="p-slug">المعرّف</label>
						<input type="text" id="p-slug" name="slug" required class="form-input" dir="ltr" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="p-name-ar">الاسم (عربي)</label>
						<input type="text" id="p-name-ar" name="name_ar" required class="form-input" />
					</div>
				</div>
				<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="p-month">السعر الشهري</label>
						<input type="text" id="p-month" name="price_month" class="form-input tabular-nums" value="0.00" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="p-year">السعر السنوي</label>
						<input type="text" id="p-year" name="price_year" class="form-input tabular-nums" value="0.00" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="p-days">المدة (أيام)</label>
						<input type="number" id="p-days" name="duration_days" class="form-input tabular-nums" value="30" />
					</div>
				</div>
				<label style="display:flex; gap:0.5rem; align-items:center; font-size:0.9rem;">
					<input type="checkbox" name="is_compare" value="1" />
					<span>خطة مقارنة الخصومات (تمنح صلاحية compare)</span>
				</label>
				<button type="submit" class="btn btn-primary" style="justify-content:center;">
					@components.IconPlus("icon-sm")
					<span>إضافة الخطة</span>
				</button>
			</form>
		</div>

		<div class="card">
			<h2 class="card-title" style="margin:0 0 0.75rem;">الخطط الحالية</h2>
			if len(plans) == 0 {
				<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد خطط بعد.</p>
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead><tr><th>المعرّف</th><th>الاسم</th><th>شهري</th><th>سنوي</th></tr></thead>
						<tbody>
							for _, p := range plans {
								<tr>
									<td dir="ltr">{ p.Slug }</td>
									<td>{ p.Name.Get(i18n.Lang(lang)) }</td>
									<td>@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: p.PriceMonth })</td>
									<td>@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: p.PriceYear })</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
