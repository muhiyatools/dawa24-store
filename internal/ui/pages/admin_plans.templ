package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/platform/gateway"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminPlansData holds plan definitions, active subscriptions, and AI Gateway plans.
type AdminPlansData struct {
	ActiveTab     string // "plans", "subscriptions"
	Plans         []*billing.Plan
	Subscriptions []*billing.Subscription
	GatewayPlans  []gateway.GatewayPlan
	GatewayURL    string
	GatewayOnline bool
}

func countActivePlans(plans []*billing.Plan) int {
	c := 0
	for _, p := range plans {
		if p.IsActive {
			c++
		}
	}
	return c
}

func getDefaultPlanName(plans []*billing.Plan, lang string) string {
	for _, p := range plans {
		if p.IsDefault {
			name := p.Name.Get(i18n.Lang(lang))
			if name == "" {
				name = p.Slug
			}
			return name
		}
	}
	return "غير محدد"
}

templ AdminPlans(lang, dir string, plans []*billing.Plan) {
	@AdminPlansHub(AdminPlansData{ActiveTab: "plans", Plans: plans}, lang, dir)
}

templ AdminPlansHub(data AdminPlansData, lang, dir string) {
	@layouts.AdminShell("باقات وخطط الاشتراك الموحدة", "plans", lang, dir) {
		<div x-data="adminPlansManager()" class="page-container">
			
			<!-- Top Header & Actions -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-3">
							<div class="user-avatar-badge text-xl">
								🏷️
							</div>
							<div>
								<h1 class="text-2xl font-black text-primary m-0">
									باقات واشتراكات المنظومة الموحدة
								</h1>
								<p class="text-sm text-secondary m-0 mt-1">
									إدارة مركزية لخطط الاشتراكات، حدود الجلسات المتزامنة، وحصص بوابة الذكاء الاصطناعي (AI Gateway)
								</p>
							</div>
						</div>
					</div>

					<div class="d-flex items-center gap-3 flex-wrap">
						<!-- AI Gateway Connection Status Indicator -->
						<div class="d-inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs" style="background:var(--surface-sunken);">
							<span>🤖</span>
							<span class="text-secondary font-bold">بوابة الذكاء الاصطناعي:</span>
							if data.GatewayOnline {
								<span class="badge badge-emerald text-xs font-bold">متصلة ومزامنة</span>
							} else {
								<span class="badge badge-amber text-xs font-bold" title="جاري الاتصال بـ Endpoint">جاهزة للربط</span>
							}
							if data.GatewayURL != "" {
								<code dir="ltr" class="text-xs text-muted font-mono">{ data.GatewayURL }</code>
							}
						</div>

						<!-- Add New Plan Action -->
						<button
							type="button"
							class="btn btn-primary btn-sm font-bold text-xs gap-1"
							@click="openCreateModal()"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة باقة جديدة</span>
						</button>
					</div>
				</div>
			</div>

			<!-- KPI Summary Metrics (4-grid) -->
			<div class="grid-4 mb-6">
				<!-- KPI 1: Total Plans -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">إجمالي الباقات</span>
						<span class="text-brand">🏷️</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-primary mt-2">
						{ fmt.Sprintf("%d", len(data.Plans)) } <span class="text-xs text-muted font-normal">باقة</span>
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t flex-between">
						<span>النشطة: <strong class="text-emerald">{ fmt.Sprintf("%d", countActivePlans(data.Plans)) }</strong></span>
						<span>المعطلة: <strong class="text-secondary">{ fmt.Sprintf("%d", len(data.Plans) - countActivePlans(data.Plans)) }</strong></span>
					</div>
				</div>

				<!-- KPI 2: Default System Plan -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">الباقة الافتراضية</span>
						<span class="text-amber">★</span>
					</div>
					<div class="text-lg font-black text-primary mt-2 text-truncate" title={ getDefaultPlanName(data.Plans, lang) }>
						{ getDefaultPlanName(data.Plans, lang) }
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t">
						تُمنح تلقائياً لأي منشأة جديدة مسجلة
					</div>
				</div>

				<!-- KPI 3: Total Active Subscriptions -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">المشتركون النشطون</span>
						<span class="text-emerald">👥</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-emerald mt-2">
						{ fmt.Sprintf("%d", len(data.Subscriptions)) } <span class="text-xs text-muted font-normal">منشأة</span>
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t">
						اشتراكات سارية ومفعلة بالكامل
					</div>
				</div>

				<!-- KPI 4: AI Gateway Tiers Available -->
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">باقات الـ AI Gateway</span>
						<span class="text-purple">🔮</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-purple mt-2">
						{ fmt.Sprintf("%d", len(data.GatewayPlans)) } <span class="text-xs text-muted font-normal">باقة</span>
					</div>
					<div class="text-xs text-muted mt-2 pt-2 border-t">
						حصص الكوتا وتوليد الـ Virtual Keys
					</div>
				</div>
			</div>

			<!-- Main Content Panel with Tabs -->
			<div class="glass-panel p-6 mb-6">
				<!-- Tab Navigation -->
				<div class="cb-tabs-nav m-0 mb-6 pb-4 border-b">
					<a
						href="/admin/plans?tab=plans"
						class={ "cb-tab-btn", templ.KV("active", data.ActiveTab == "plans" || data.ActiveTab == "") }
					>
						@components.IconTag("icon-xs")
						<span>دليل باقات الاشتراك الموحدة ({ fmt.Sprintf("%d", len(data.Plans)) })</span>
					</a>
					<a
						href="/admin/plans?tab=subscriptions"
						class={ "cb-tab-btn", templ.KV("active", data.ActiveTab == "subscriptions") }
					>
						@components.IconWallet("icon-xs")
						<span>سجلات المشتركين والمنشآت ({ fmt.Sprintf("%d", len(data.Subscriptions)) })</span>
					</a>
				</div>

				<div>
					if data.ActiveTab == "subscriptions" {
						<!-- TAB 2: Subscriptions Table -->
						if len(data.Subscriptions) == 0 {
							<div class="p-8 text-center empty-state-glass">
								<div class="text-4xl mb-3">🏷️</div>
								<h3 class="text-lg font-black text-primary mb-2">لا توجد اشتراكات مسجلة حالياً</h3>
								<p class="text-sm text-secondary max-w-md mx-auto">ستظهر هنا سجلات اشتراكات المنشآت فور اعتمادها وتفعيل حساباتها.</p>
							</div>
						} else {
							<div class="table-container m-0">
								<table class="data-table m-0">
									<thead>
										<tr>
											<th>رقم الاشتراك</th>
											<th>المنشأة / المستفيد</th>
											<th>باقة الاشتراك</th>
											<th>الحالة</th>
											<th>دورة الفوترة</th>
											<th>تاريخ البدء</th>
											<th>تاريخ الانتهاء</th>
										</tr>
									</thead>
									<tbody>
										for _, s := range data.Subscriptions {
											<tr>
												<td class="tabular-nums"><strong>{ fmt.Sprintf("SUB-%d", s.ID) }</strong></td>
												<td>
													if s.OrganizationID != nil && *s.OrganizationID > 0 {
														<span class="badge badge-primary fw-700">منشأة #{ fmt.Sprintf("%d", *s.OrganizationID) }</span>
													} else {
														<span class="badge badge-secondary">مستخدم #{ fmt.Sprintf("%d", s.UserID) }</span>
													}
												</td>
												<td>
													for _, p := range data.Plans {
														if p.ID == s.PlanID {
															<div class="fw-800 text-primary">{ p.Name.Get(i18n.Lang(lang)) }</div>
															<span class="text-xs text-muted" dir="ltr"><code>{ p.Slug }</code></span>
														}
													}
													if s.PlanID > 0 {
														<span style="font-size:0.75rem; color:var(--text-muted); display:none;">(خطة #{ fmt.Sprintf("%d", s.PlanID) })</span>
													}
												</td>
												<td>
													if s.Status == "active" {
														<span class="badge badge-emerald">ساري وفعال</span>
													} else {
														<span class="badge badge-secondary">{ string(s.Status) }</span>
													}
												</td>
												<td>
													if s.BillingCycle == "annual" {
														<span class="badge badge-sky font-bold text-xs">سنوي</span>
													} else {
														<span class="badge badge-slate text-xs">شهري</span>
													}
												</td>
												<td class="tabular-nums">{ s.StartsAt.Format("2006-01-02") }</td>
												<td class="tabular-nums">{ s.ExpiresAt.Format("2006-01-02") }</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					} else {
						<!-- TAB 1: Unified Plans Cards Grid -->
						if len(data.Plans) == 0 {
							<div class="p-8 text-center empty-state-glass">
								<div class="text-4xl mb-3">📦</div>
								<h3 class="text-lg font-black text-primary mb-2">لا توجد باقات اشتراك معرفة بالمنظومة</h3>
								<p class="text-sm text-secondary max-w-md mx-auto mb-4">قم بإنشاء باقة اشتراك جديدة لتحديد الأسعار وحدود الجلسات وصلاحيات الذكاء الاصطناعي.</p>
								<button type="button" class="btn btn-primary btn-sm font-bold" @click="openCreateModal()">
									@components.IconPlus("icon-xs")
									<span>إنشاء الباقة الأولى</span>
								</button>
							</div>
						} else {
							<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(360px, 1fr)); gap:1.5rem; align-items:stretch;">
								for _, p := range data.Plans {
									<div
										class={ "card mb-0 plan-card-container", templ.KV("border-brand shadow-sm", p.IsDefault) }
										style="display:flex; flex-direction:column; justify-content:space-between; border:1px solid var(--border); background:var(--surface); border-radius:var(--radius-xl); padding:1.5rem; position:relative;"
									>
										<!-- Card Top: Badges & Title -->
										<div>
											<!-- Header Badges -->
											<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem; margin-bottom:0.75rem;">
												<div style="display:flex; flex-direction:column; gap:0.25rem;">
													<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
														<h3 style="margin:0; font-size:1.2rem; font-weight:900; color:var(--text);">
															{ p.Name.Get(i18n.Lang(lang)) }
														</h3>
														if p.IsDefault {
															<span class="badge badge-primary font-bold text-xs" style="padding:0.2rem 0.6rem;">
																★ الباقة الافتراضية
															</span>
														}
													</div>
													<div dir="ltr" class="text-xs text-muted">
														<code>{ p.Slug }</code>
													</div>
												</div>

												<div class="d-flex items-center gap-1">
													if p.IsActive {
														<span class="badge badge-emerald font-bold text-xs">● نشطة</span>
													} else {
														<span class="badge badge-secondary text-xs">○ معطلة</span>
													}
												</div>
											</div>

											<!-- Description -->
											if p.Description.Get(i18n.Lang(lang)) != "" {
												<p style="font-size:0.85rem; color:var(--text-secondary); margin:0 0 1.25rem 0; line-height:1.6;">
													{ p.Description.Get(i18n.Lang(lang)) }
												</p>
											} else {
												<p style="font-size:0.85rem; color:var(--text-muted); margin:0 0 1.25rem 0; font-style:italic;">
													لا يوجد وصف محدد للباقة
												</p>
											}

											<!-- Pricing Display Strip -->
											<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.9rem 1.1rem; margin-bottom:1.25rem; display:flex; justify-content:space-between; align-items:center;">
												<div>
													<div style="font-size:0.75rem; color:var(--text-secondary); font-weight:700;">الاشتراك الشهري</div>
													<div style="font-size:1.35rem; font-weight:900; color:var(--primary);" class="tabular-nums">
														if p.PriceMonth.IsPositive() {
															{ p.PriceMonth.String() } <span style="font-size:0.8rem; font-weight:600;">ج.م</span>
														} else {
															<span class="text-emerald">مجاني (0.00)</span>
														}
													</div>
												</div>
												<div style="text-align:end; border-inline-start:1px solid var(--border); padding-inline-start:1rem;">
													<div style="font-size:0.75rem; color:var(--text-secondary); font-weight:700;">الاشتراك السنوي</div>
													<div style="font-size:1.1rem; font-weight:800; color:var(--text);" class="tabular-nums">
														if p.PriceYear.IsPositive() {
															{ p.PriceYear.String() } <span style="font-size:0.75rem; font-weight:600;">ج.م</span>
														} else {
															<span class="text-emerald">مجاني (0.00)</span>
														}
													</div>
												</div>
												<div style="text-align:end; border-inline-start:1px solid var(--border); padding-inline-start:1rem;">
													<div style="font-size:0.75rem; color:var(--text-secondary); font-weight:700;">الصلاحية</div>
													<div style="font-size:0.9rem; font-weight:800; color:var(--text-secondary);" class="tabular-nums">
														{ fmt.Sprintf("%d يوم", p.DurationDays) }
													</div>
												</div>
											</div>

											<!-- Quotas & Limits Box -->
											<div style="background:rgba(56, 189, 248, 0.04); border:1px solid rgba(56, 189, 248, 0.2); border-radius:var(--radius-lg); padding:1rem; margin-bottom:1.25rem;">
												<div style="font-size:0.8rem; font-weight:800; color:var(--primary); margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
													<span>⚙️</span>
													<span>حدود الأمان والجلسات المطبقة على إجمالي المنشأة</span>
												</div>

												<div style="display:flex; flex-direction:column; gap:0.6rem; font-size:0.85rem;">
													<!-- Concurrent Sessions Limit -->
													<div class="flex-between">
														<span style="color:var(--text-secondary); display:flex; align-items:center; gap:0.35rem;">
															<span>👥</span>
															<span>الجلسات المتزامنة:</span>
														</span>
														<strong class="text-primary tabular-nums">
															{ fmt.Sprintf("%d جلسات (إجمالي المنشأة)", p.MaxLoginSessions) }
														</strong>
													</div>

													<!-- Max Devices Limit -->
													<div class="flex-between">
														<span style="color:var(--text-secondary); display:flex; align-items:center; gap:0.35rem;">
															<span>💻</span>
															<span>الأجهزة المسموح بها:</span>
														</span>
														<strong class="text-primary tabular-nums">
															{ fmt.Sprintf("%d أجهزة", p.MaxDevices) }
														</strong>
													</div>

													<!-- AI Gateway Plan -->
													<div style="display:flex; justify-content:space-between; align-items:center; border-top:1px dashed var(--border); padding-top:0.5rem; margin-top:0.25rem;">
														<span style="color:var(--text-secondary); display:flex; align-items:center; gap:0.35rem;">
															<span>🤖</span>
															<span>باقة الـ AI Gateway:</span>
														</span>
														<span class="badge badge-info" dir="ltr" style="font-weight:700; font-size:0.75rem;">
															{ p.AIPlanID }
														</span>
													</div>
												</div>
											</div>

											<!-- Vendor Features Badges -->
											<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.75rem 1rem; margin-bottom:1.25rem;">
												<div style="font-size:0.75rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.5rem;">
													صلاحيات وميزات المنظومة المتضمنة:
												</div>
												<div style="display:flex; flex-direction:column; gap:0.4rem; font-size:0.8rem;">
													if p.HasFeature("feature_market_discounts") {
														<div class="d-flex items-center gap-2 text-emerald font-bold">
															<span>✓</span>
															<span>🛒 (للموردين) خصومات السوق العامة ومؤشرات الأسعار</span>
														</div>
													} else {
														<div class="d-flex items-center gap-2 text-muted" style="opacity:0.6;">
															<span>✕</span>
															<span>خصومات السوق العامة (معطلة)</span>
														</div>
													}

													if p.HasFeature("feature_compare_tool") || p.HasFeature("compare") {
														<div class="d-flex items-center gap-2 text-indigo font-bold">
															<span>✓</span>
															<span>📊 (للموردين) أداة مقارنة الخصومات وتحليل العروض</span>
														</div>
													} else {
														<div class="d-flex items-center gap-2 text-muted" style="opacity:0.6;">
															<span>✕</span>
															<span>أداة مقارنة الخصومات (معطلة)</span>
														</div>
													}

													if p.HasFeature("bulk_import") {
														<div class="d-flex items-center gap-2 text-sky font-bold">
															<span>✓</span>
															<span>📦 استيراد وتحديث الكتالوجات بالجملة</span>
														</div>
													}

													if p.HasFeature("analytics") {
														<div class="d-flex items-center gap-2 text-purple font-bold">
															<span>✓</span>
															<span>📈 لوحة التحليلات المتقدمة والتقارير</span>
														</div>
													}
												</div>
											</div>
										</div>

										<!-- Card Bottom Action Toolbar -->
										<div style="border-top:1px solid var(--border); padding-top:1rem; margin-top:0.5rem; display:flex; flex-direction:column; gap:0.5rem;">
											
											<!-- Edit Action -->
											<button
												type="button"
												class="btn btn-secondary btn-sm edit-plan-trigger-btn"
												style="font-weight:800; width:100%; justify-content:center; gap:0.4rem;"
												data-id={ fmt.Sprintf("%d", p.ID) }
												data-slug={ p.Slug }
												data-name-ar={ p.Name.Get("ar") }
												data-name-en={ p.Name.Get("en") }
												data-desc-ar={ p.Description.Get("ar") }
												data-desc-en={ p.Description.Get("en") }
												data-price-month={ p.PriceMonth.String() }
												data-price-year={ p.PriceYear.String() }
												data-duration={ fmt.Sprintf("%d", p.DurationDays) }
												data-sessions={ fmt.Sprintf("%d", p.MaxLoginSessions) }
												data-devices={ fmt.Sprintf("%d", p.MaxDevices) }
												data-ai-plan={ p.AIPlanID }
												data-is-default={ fmt.Sprintf("%t", p.IsDefault) }
												data-is-active={ fmt.Sprintf("%t", p.IsActive) }
												data-feat-market={ fmt.Sprintf("%t", p.HasFeature("feature_market_discounts")) }
												data-feat-compare={ fmt.Sprintf("%t", p.HasFeature("feature_compare_tool") || p.HasFeature("compare")) }
												data-feat-import={ fmt.Sprintf("%t", p.HasFeature("bulk_import")) }
												data-feat-analytics={ fmt.Sprintf("%t", p.HasFeature("analytics")) }
												@click="openEditFromDataset($el)"
											>
												@components.IconEdit("icon-xs")
												<span>تعديل إعدادات وصلاحيات الباقة</span>
											</button>

											<!-- Secondary Action Strip: Quick Toggle, Set Default, Delete -->
											<div class="d-flex items-center gap-2 pt-1">
												<!-- Quick Toggle Active Status -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/plans/%d/toggle", p.ID)) } style="flex:1; margin:0;">
													if p.IsActive {
														<button type="submit" class="btn btn-outline-secondary btn-xs w-full" title="تعطيل الباقة مؤقتاً">
															<span>إيقاف الباقة</span>
														</button>
													} else {
														<button type="submit" class="btn btn-outline-success btn-xs w-full font-bold" title="تفعيل الباقة">
															<span>تفعيل الباقة</span>
														</button>
													}
												</form>

												<!-- Set Default Plan -->
												if !p.IsDefault {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/plans/%d/set-default", p.ID)) } style="flex:1; margin:0;">
														<button type="submit" class="btn btn-outline-amber btn-xs w-full" title="جعلها الباقة الافتراضية">
															<span>★ تعيين كافتراضية</span>
														</button>
													</form>
												}

												<!-- Delete Plan (if not default) -->
												if !p.IsDefault {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/plans/%d/delete", p.ID)) } style="margin:0;" onsubmit="return confirm('هل أنت متأكد من حذف هذه الباقة نهائياً؟');">
														<button type="submit" class="btn btn-outline-danger btn-xs btn-icon" title="حذف الباقة">
															<span>🗑️</span>
														</button>
													</form>
												}
											</div>

										</div>
									</div>
								}
							</div>
						}
					}
				</div>
			</div>

			<!-- ========================================== -->
			<!-- Create / Edit Plan Modal                   -->
			<!-- ========================================== -->
			<div
				x-show="showModal"
				x-cloak
				class="modal-overlay"
			>
				<div
					@click.away="showModal = false"
					class="card"
					style="width:100%; max-width:680px; max-height:92vh; overflow-y:auto; margin:0; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); box-shadow:0 24px 48px rgba(0,0,0,0.6); padding:1.75rem;"
				>
					<!-- Modal Header -->
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div>
							<h3 style="margin:0; font-size:1.25rem; font-weight:900; color:var(--text);" x-text="isEdit ? 'تعديل باقة الاشتراك الموحدة' : 'إضافة باقة اشتراك جديدة'"></h3>
							<p style="margin:0.25rem 0 0; font-size:0.8rem; color:var(--text-secondary);">
								تحديد الأسعار، حدود الجلسات المتزامنة، وصلاحيات الوصول لحصص الذكاء الاصطناعي وخصومات السوق.
							</p>
						</div>
						<button type="button" @click="showModal = false" class="btn btn-secondary btn-xs" style="border-radius:var(--radius-full); width:32px; height:32px; padding:0; justify-content:center;">✕</button>
					</div>

					<form :action="formAction" method="POST" style="display:flex; flex-direction:column; gap:1.2rem;">
						
						<!-- Section 1: Identity & Names -->
						<div class="form-grid-2">
							<div class="form-group m-0">
								<label class="form-label font-bold text-xs">المعرّف الفريد (Slug) <span class="text-danger">*</span></label>
								<input type="text" name="slug" x-model="form.slug" required class="form-input text-xs" placeholder="e.g. basic, pro, enterprise" dir="ltr" />
							</div>
							<div class="form-group m-0">
								<label class="form-label font-bold text-xs">اسم الباقة (عربي) <span class="text-danger">*</span></label>
								<input type="text" name="name_ar" x-model="form.name_ar" required class="form-input text-xs" placeholder="مثال: الباقة الاحترافية" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group m-0">
								<label class="form-label font-bold text-xs">اسم الباقة (إنجليزي)</label>
								<input type="text" name="name_en" x-model="form.name_en" class="form-input text-xs" placeholder="e.g. Professional Plan" dir="ltr" />
							</div>
							<div class="form-group m-0">
								<label class="form-label font-bold text-xs">فترة الصلاحية (أيام) <span class="text-danger">*</span></label>
								<input type="number" name="duration_days" x-model="form.duration" class="form-input tabular-nums text-xs" min="1" required />
							</div>
						</div>

						<div class="form-group m-0">
							<label class="form-label font-bold text-xs">وصف الباقة ومزاياها للمشتركين</label>
							<textarea name="description_ar" x-model="form.desc_ar" rows="2" class="form-input text-xs" placeholder="اكتب نبذة توضيحية عن ميزات الباقة..."></textarea>
						</div>

						<!-- Section 2: Pricing (Monthly & Yearly) -->
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1rem;">
							<div style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
								<span>💰</span>
								<span>تسعير الباقة (شهري وسنوي)</span>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div class="form-group m-0">
									<label class="form-label font-bold text-xs">السعر الشهري (ج.م) <span class="text-danger">*</span></label>
									<input type="number" step="0.01" min="0" name="price_month" x-model="form.price_month" class="form-input tabular-nums text-xs" placeholder="0.00" required />
									<span class="text-xs text-muted mt-1 d-block">ضع 0 للباقات المجانية</span>
								</div>
								<div class="form-group m-0">
									<label class="form-label font-bold text-xs">السعر السنوي (ج.م) <span class="text-danger">*</span></label>
									<input type="number" step="0.01" min="0" name="price_year" x-model="form.price_year" class="form-input tabular-nums text-xs" placeholder="0.00" required />
									<span class="text-xs text-muted mt-1 d-block">سعر الدفع السنوي المجمع</span>
								</div>
							</div>
						</div>

						<!-- Section 3: Limits & AI Gateway Plan -->
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1rem; display:flex; flex-direction:column; gap:0.85rem;">
							<div style="font-size:0.825rem; font-weight:800; color:var(--text); display:flex; align-items:center; gap:0.4rem;">
								<span>🛡️</span>
								<span>حدود الأمان والجلسات المطبقة على إجمالي المنشأة</span>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div class="form-group m-0">
									<label class="form-label font-bold text-xs">الجلسات المتزامنة (إجمالي المنشأة) <span class="text-danger">*</span></label>
									<input type="number" name="max_login_sessions" x-model="form.sessions" class="form-input tabular-nums text-xs" min="1" max="500" required />
									<span style="font-size:0.75rem; color:var(--text-secondary); margin-top:0.2rem; display:block;">مطبقة على إجمالي مستخدمي المنشأة</span>
								</div>
								<div class="form-group m-0">
									<label class="form-label font-bold text-xs">حد الأجهزة المسموح بها <span class="text-danger">*</span></label>
									<input type="number" name="max_devices" x-model="form.devices" class="form-input tabular-nums text-xs" min="1" max="500" required />
									<span style="font-size:0.75rem; color:var(--text-secondary); margin-top:0.2rem; display:block;">أقصى أجهزة مسجلة</span>
								</div>
							</div>

							<div class="form-group m-0 pt-2 border-t">
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
									<label class="form-label m-0 font-bold text-xs">باقة بوابة الذكاء الاصطناعي (AI Gateway Plan) <span class="text-danger">*</span></label>
									if data.GatewayURL != "" {
										<span style="font-size:0.75rem; color:var(--primary); font-weight:600;">(مزامنة من { data.GatewayURL })</span>
									}
								</div>
								<select name="ai_plan_id" x-model="form.ai_plan" class="form-input text-xs" style="background:var(--surface);">
									for _, gp := range data.GatewayPlans {
										<option value={ gp.ID }>
											{ gp.Name } ({ gp.ID }) — { fmt.Sprintf("%d RPM / %d TPM", gp.RPMLimit, gp.TPMLimit) }
										</option>
									}
								</select>
								<span style="font-size:0.75rem; color:var(--text-secondary); margin-top:0.25rem; display:block;">
									الربط التلقائي وتحديد حصة الكوتا في الـ AI Gateway وتوليد المفتاح الافتراضي (Virtual Key) تلقائياً للمنشأة.
								</span>
							</div>
						</div>

						<!-- Section 4: Entitlements & Features Checklist -->
						<div style="display:flex; flex-direction:column; gap:0.75rem; font-size:0.875rem; border-top:1px solid var(--border); padding-top:0.9rem;">
							<div style="font-size:0.8rem; font-weight:800; color:var(--primary); display:flex; align-items:center; gap:0.4rem;">
								<span>🏢</span>
								<span>صلاحيات وميزات المنظومة المتضمنة (Feature Entitlements):</span>
							</div>

							<label style="display:flex; gap:0.6rem; align-items:center; cursor:pointer; background:rgba(16, 185, 129, 0.05); padding:0.6rem 0.85rem; border-radius:var(--radius-md); border:1px solid rgba(16, 185, 129, 0.2);">
								<input type="checkbox" name="feature_market_discounts" value="1" x-model="form.feat_market" />
								<div>
									<strong style="color:var(--text); display:block; font-size:0.825rem;">🛒 (خاص بالموردين) إتاحة الوصول إلى: خصومات السوق العامة ومؤشرات الأسعار</strong>
									<span class="text-xs text-secondary">تمكين المورد من استعراض خصومات السوق الحية والتحليلات المقارنة</span>
								</div>
							</label>

							<label style="display:flex; gap:0.6rem; align-items:center; cursor:pointer; background:rgba(99, 102, 241, 0.05); padding:0.6rem 0.85rem; border-radius:var(--radius-md); border:1px solid rgba(99, 102, 241, 0.2);">
								<input type="checkbox" name="feature_compare_tool" value="1" x-model="form.feat_compare" />
								<div>
									<strong style="color:var(--text); display:block; font-size:0.825rem;">📊 (خاص بالموردين) إتاحة الوصول إلى: أداة مقارنة الخصومات وتحليل العروض</strong>
									<span class="text-xs text-secondary">تمكين المورد من تشغيل أداة المقارنة المتقدمة للملفات وخصومات الموردين</span>
								</div>
							</label>

							<label style="display:flex; gap:0.6rem; align-items:center; cursor:pointer; background:rgba(14, 165, 233, 0.05); padding:0.6rem 0.85rem; border-radius:var(--radius-md); border:1px solid rgba(14, 165, 233, 0.2);">
								<input type="checkbox" name="feature_bulk_import" value="1" x-model="form.feat_import" />
								<div>
									<strong style="color:var(--text); display:block; font-size:0.825rem;">📦 إتاحة استيراد وتحديث الكتالوجات بالجملة (Bulk Ingest)</strong>
									<span class="text-xs text-secondary">معالجة وتحديث كميات وأسعار الأصناف من ملفات Excel و CSV</span>
								</div>
							</label>

							<label style="display:flex; gap:0.6rem; align-items:center; cursor:pointer; background:rgba(168, 85, 247, 0.05); padding:0.6rem 0.85rem; border-radius:var(--radius-md); border:1px solid rgba(168, 85, 247, 0.2);">
								<input type="checkbox" name="feature_analytics" value="1" x-model="form.feat_analytics" />
								<div>
									<strong style="color:var(--text); display:block; font-size:0.825rem;">📈 إتاحة لوحة التحليلات المتقدمة والتقارير المالية</strong>
									<span class="text-xs text-secondary">إحصائيات تفصيلية ومؤشرات الأداء للأعمال والمبيعات</span>
								</div>
							</label>
						</div>

						<!-- Section 5: Default & Status Switches -->
						<div style="display:flex; flex-direction:column; gap:0.6rem; font-size:0.875rem; border-top:1px solid var(--border); padding-top:0.9rem;">
							<label style="display:flex; gap:0.6rem; align-items:center; cursor:pointer; background:rgba(245, 158, 11, 0.06); padding:0.6rem 0.85rem; border-radius:var(--radius-md); border:1px solid rgba(245, 158, 11, 0.25);">
								<input type="checkbox" name="is_default" value="1" x-model="form.is_default" />
								<div>
									<strong style="color:var(--text); display:block; font-size:0.825rem;">تعيين كباقة افتراضية للمنظومة (Default Plan)</strong>
									<span class="text-xs text-secondary">تُمنح تلقائياً ومجاناً لأي منشأة جديدة فور تسجيلها واعتمادها من الإدارة</span>
								</div>
							</label>

							<label style="display:flex; gap:0.6rem; align-items:center; cursor:pointer; background:var(--surface-sunken); padding:0.6rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border);">
								<input type="checkbox" name="is_active" value="1" x-model="form.is_active" />
								<div>
									<strong style="color:var(--text); display:block; font-size:0.825rem;">الباقة نشطة ومتاحة للاشتراك والتجديد</strong>
									<span class="text-xs text-secondary">عند التعطيل لن يتمكن المشتركون الجدد من اختيار هذه الباقة</span>
								</div>
							</label>
						</div>

						<!-- Modal Actions -->
						<div style="display:flex; justify-content:flex-end; gap:0.75rem; border-top:1px solid var(--border); padding-top:1.25rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" @click="showModal = false">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.6rem 2rem;">
								@components.IconCheck("icon-xs")
								<span x-text="isEdit ? 'حفظ التحديثات' : 'إضافة وتفعيل الباقة'"></span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>

		<!-- Clean Client-Side State Manager without inline string interpolation bugs -->
		<script>
			function adminPlansManager() {
				return {
					showModal: false,
					isEdit: false,
					formAction: '/admin/plans',
					form: {
						id: 0,
						slug: '',
						name_ar: '',
						name_en: '',
						desc_ar: '',
						desc_en: '',
						price_month: '0.00',
						price_year: '0.00',
						duration: 30,
						sessions: 3,
						devices: 3,
						ai_plan: 'plan-dev',
						is_default: false,
						is_active: true,
						feat_market: false,
						feat_compare: false,
						feat_import: false,
						feat_analytics: false
					},
					openCreateModal() {
						this.isEdit = false;
						this.formAction = '/admin/plans';
						this.form = {
							id: 0,
							slug: '',
							name_ar: '',
							name_en: '',
							desc_ar: '',
							desc_en: '',
							price_month: '0.00',
							price_year: '0.00',
							duration: 30,
							sessions: 3,
							devices: 3,
							ai_plan: 'plan-dev',
							is_default: false,
							is_active: true,
							feat_market: false,
							feat_compare: false,
							feat_import: false,
							feat_analytics: false
						};
						this.showModal = true;
					},
					openEditFromDataset(btnEl) {
						if (!btnEl || !btnEl.dataset) return;
						const ds = btnEl.dataset;
						this.isEdit = true;
						this.formAction = '/admin/plans/' + ds.id + '/update';
						this.form = {
							id: parseInt(ds.id, 10) || 0,
							slug: ds.slug || '',
							name_ar: ds.nameAr || '',
							name_en: ds.nameEn || '',
							desc_ar: ds.descAr || '',
							desc_en: ds.descEn || '',
							price_month: ds.priceMonth || '0.00',
							price_year: ds.priceYear || '0.00',
							duration: parseInt(ds.duration, 10) || 30,
							sessions: parseInt(ds.sessions, 10) || 3,
							devices: parseInt(ds.devices, 10) || 3,
							ai_plan: ds.aiPlan || 'plan-dev',
							is_default: ds.isDefault === 'true',
							is_active: ds.isActive === 'true',
							feat_market: ds.featMarket === 'true',
							feat_compare: ds.featCompare === 'true',
							feat_import: ds.featImport === 'true',
							feat_analytics: ds.featAnalytics === 'true'
						};
						this.showModal = true;
					}
				}
			}
		</script>
	}
}

