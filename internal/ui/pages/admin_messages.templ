package pages

import (
	"fmt"
	"strings"

	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminMessages(lang, dir string, messages []*platformadmin.ContactMessage) {
	@layouts.AdminShell("رسائل واستفسارات التواصل", "messages", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.25rem;">
			
			<!-- Header Banner -->
			<div class="card" style="margin-bottom:0;">
				<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
					<div class="row-center-sm">
						@components.IconMail("icon-lg")
						<div>
							<h2 class="card-title" style="margin:0; font-size:1.35rem;">
								رسائل واستفسارات التواصل ({ fmt.Sprintf("%d", len(messages)) })
							</h2>
							<p style="font-size:0.875rem; color:var(--neutral-500); margin-top:0.25rem; margin-bottom:0;">
								صندوق الرسائل والطلبات الواردة عبر نموذج "تواصل معنا" من الصيدليات والشركات والعملاء.
							</p>
						</div>
					</div>

					<div style="display:flex; gap:0.75rem; align-items:center;">
						<a href="/admin/messages" class="btn btn-secondary btn-sm" style="display:flex; align-items:center; gap:0.4rem;">
							@components.IconRefresh("icon-xs")
							<span>تحديث الرسائل</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Messages Table Card -->
			<div class="card" style="margin-bottom:0; overflow:visible;">
				if len(messages) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد رسائل تواصل واردة",
						Message: "لم يقم أي مستخدم بإرسال رسائل أو استفسارات عبر صفحة تواصل معنا حتى الآن.",
					})
				} else {
					<div class="table-container" style="overflow:visible;">
						<table class="data-table">
							<thead>
								<tr>
									<th>#</th>
									<th>المرسل وبيانات الاتصال</th>
									<th>الموضوع / نوع الطلب</th>
									<th>نص الرسالة</th>
									<th>الحالة</th>
									<th>التاريخ والتوقيت</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range messages {
									<tr id={ fmt.Sprintf("message-row-%d", m.ID) }>
										<td class="tabular-nums" style="font-weight:700; color:var(--neutral-500);">
											#{ fmt.Sprintf("%d", m.ID) }
										</td>
										<td>
											<div style="font-weight:800; color:var(--text); font-size:0.95rem;">
												{ m.Name }
											</div>
											if m.Email != "" {
												<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:2px;" dir="ltr">
													<a href={ templ.SafeURL(fmt.Sprintf("mailto:%s", m.Email)) } style="color:var(--accent); text-decoration:none;">
														{ m.Email }
													</a>
												</div>
											}
											if m.Phone != "" {
												<div style="font-size:0.8rem; color:var(--neutral-600); margin-top:2px; display:flex; align-items:center; gap:0.35rem;" dir="ltr" class="tabular-nums">
													<span>📞 { m.Phone }</span>
													{{ cleanPhone := strings.TrimPrefix(strings.TrimPrefix(m.Phone, "+"), "0") }}
													if cleanPhone != "" {
														<a href={ templ.SafeURL(fmt.Sprintf("https://wa.me/20%s", cleanPhone)) } target="_blank" rel="noopener" style="color:var(--success-text); font-size:0.75rem; font-weight:700; text-decoration:none;" title="محادثة واتساب">
															(واتساب 💬)
														</a>
													}
												</div>
											}
										</td>
										<td>
											<span class="badge badge-sky" style="font-weight:700;">
												{ m.Subject }
											</span>
										</td>
										<td>
											<div style="max-width:320px; font-size:0.875rem; color:var(--text); line-height:1.6; white-space:pre-wrap; word-break:break-word;">
												{ m.Message }
											</div>
										</td>
										<td>
											if m.Status == "unread" || m.Status == "" {
												<span class="badge badge-rose" style="font-weight:800;">غير مقروءة ✉</span>
											} else if m.Status == "in_progress" {
												<span class="badge badge-warning" style="font-weight:800;">قيد المتابعة ⏳</span>
											} else {
												<span class="badge badge-emerald" style="font-weight:800;">تم الرد / مكتملة ✓</span>
											}
										</td>
										<td class="tabular-nums" style="font-size:0.8rem; color:var(--neutral-500);">
											<div>{ m.CreatedAt.Format("2006-01-02") }</div>
											<div style="font-size:0.75rem; color:var(--neutral-400);">{ m.CreatedAt.Format("15:04:05") }</div>
										</td>
										<td class="text-end">
											<div class="table-actions" style="justify-content:flex-end; gap:0.4rem;">
												if m.Email != "" {
													<a
														href={ templ.SafeURL(fmt.Sprintf("mailto:%s?subject=%s", m.Email, "رد بخصوص: "+m.Subject)) }
														class="btn btn-secondary btn-sm"
														title="إرسال بريد إلكتروني"
													>
														@components.IconMail("icon-xs")
													</a>
												}

												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/messages/%d/toggle", m.ID)) } style="margin:0; display:inline;">
													if m.Status == "unread" || m.Status == "" {
														<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--success-text);" title="تحديد كمقروءة / تم التعامل">
															تمت المتابعة
														</button>
													} else {
														<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--warning-text);" title="تحديد كغير مقروءة">
															غير مقروءة
														</button>
													}
												</form>

												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/messages/%d/delete", m.ID)) } style="margin:0; display:inline;">
													<button
														type="submit"
														class="btn btn-secondary btn-sm"
														style="color:var(--danger-text);"
														onclick="return confirm('هل أنت متأكد من حذف هذه الرسالة؟')"
														title="حذف الرسالة"
													>
														@components.IconTrash("icon-xs")
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}
