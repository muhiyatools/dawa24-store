package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminApprovals(pending []*org.Organization, lang, dir string) {
	@layouts.AdminShell("طلبات اعتماد الشركاء | Partner Approvals", "approvals", lang, dir) {
		<div class="card" style="margin-bottom:0;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div style="display:flex; align-items:center; gap:0.6rem;">
					@components.IconBuilding("icon-md")
					<h2 class="card-title" style="margin:0;">
						طلبات المؤسسات والصيدليات المعلقة ({ fmt.Sprintf("%d", len(pending)) })
					</h2>
				</div>
			</div>

			if len(pending) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد طلبات اعتماد معلقة",
					Message: "تمت مراجعة واعتماد جميع طلبات انضمام الشركات والصيدليات بنجاح.",
				})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>الاسم القانوني</th>
								<th>الاسم التجاري</th>
								<th>البطاقة الضريبية</th>
								<th>السجل التجاري</th>
								<th>نوع المؤسسة</th>
								<th style="text-align:end;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range pending {
								<tr id={ fmt.Sprintf("org-row-%d", o.ID) }>
									<td style="font-weight:700; color:var(--neutral-900);">{ o.LegalName }</td>
									<td>
										if o.TradeName["ar"] != "" {
											{ o.TradeName["ar"] }
										} else {
											{ o.TradeName["en"] }
										}
									</td>
									<td class="tabular-nums">{ o.TaxNumber }</td>
									<td class="tabular-nums">{ o.CommercialRegister }</td>
									<td>
										<span class="badge badge-slate">{ string(o.Type) }</span>
									</td>
									<td style="text-align:end;">
										<div style="display:flex; justify-content:flex-end; gap:0.5rem;">
											<button
												class="btn btn-primary btn-sm"
												hx-post={ fmt.Sprintf("/api/v1/admin/org/%d/approve", o.ID) }
												hx-target={ fmt.Sprintf("#org-row-%d", o.ID) }
												hx-swap="outerHTML"
											>
												@components.IconCheck("icon-xs")
												<span>اعتماد</span>
											</button>
											<button
												class="btn btn-danger btn-sm"
												hx-post={ fmt.Sprintf("/api/v1/admin/org/%d/reject", o.ID) }
												hx-target={ fmt.Sprintf("#org-row-%d", o.ID) }
												hx-swap="outerHTML"
											>
												<span>رفض</span>
											</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
