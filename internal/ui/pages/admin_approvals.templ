package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/attachments"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminApprovals(organizations []*org.Organization, orgDocs map[int64][]*attachments.Document, currentFilter, lang, dir string) {
	@layouts.AdminShell("اعتماد ومراجعة تراخيص المنشآت", "approvals", lang, dir) {
		<div class="card" style="margin-bottom:0; overflow:visible;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; gap:1rem; flex-wrap:wrap;">
				<div class="row-center-sm">
					@components.IconShield("icon-md")
					<div>
						<h2 class="card-title" style="margin:0;">
							اعتماد وتدقيق طلبات المنشآت الطبية والتوريد
						</h2>
						<p style="font-size:0.85rem; color:var(--neutral-500); margin-top:0.2rem;">
							فحص مستندات التراخيص، السجل التجاري، وتصنيف وتوثيق المستندات الرسمية لكافة المنشآت.
						</p>
					</div>
				</div>

				<div style="display:flex; gap:0.5rem; align-items:center;">
					<a href="/admin/approvals" class={ "btn btn-sm", templ.KV("btn-primary", currentFilter == "" || currentFilter == "pending"), templ.KV("btn-secondary", currentFilter != "" && currentFilter != "pending") }>
						<span>طلبات قيد الفحص (Pending)</span>
					</a>
					<a href="/admin/approvals?status=approved" class={ "btn btn-sm", templ.KV("btn-primary", currentFilter == "approved"), templ.KV("btn-secondary", currentFilter != "approved") }>
						<span>المعتمدة (Approved)</span>
					</a>
					<a href="/admin/approvals?status=rejected" class={ "btn btn-sm", templ.KV("btn-primary", currentFilter == "rejected"), templ.KV("btn-secondary", currentFilter != "rejected") }>
						<span>المرفوضة (Rejected)</span>
					</a>
				</div>
			</div>

			<div id="admin-approvals-content">
				@AdminApprovalsTable(organizations, orgDocs)
			</div>
		</div>
	}
}

templ AdminApprovalsTable(orgs []*org.Organization, orgDocs map[int64][]*attachments.Document) {
	if len(orgs) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا توجد منشآت مطابقة للفلتر المحدد",
			Message: "تمت مراجعة جميع المستندات والتراخيص بالكامل، ولا توجد طلبات معلقة حالياً.",
		})
	} else {
		<div class="table-container" style="overflow:visible;">
			<table class="data-table">
				<thead>
					<tr>
						<th>المنشأة والاسم التجاري</th>
						<th>النوع</th>
						<th>السجل والبطاقة الضريبية</th>
						<th>ترخيص هيئة الدواء</th>
						<th>المستندات المرفقة</th>
						<th>الحالة الحالية</th>
						<th class="text-end">الإجراء والتدقيق</th>
					</tr>
				</thead>
				<tbody>
					for _, o := range orgs {
						<tr id={ fmt.Sprintf("org-row-%d", o.ID) }>
							<td>
								<div style="font-weight:800; color:var(--neutral-900); font-size:0.95rem;">{ o.LegalName }</div>
								<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.15rem;">
									if o.TradeName["ar"] != "" {
										{ o.TradeName["ar"] }
									} else {
										{ o.TradeName["en"] }
									}
								</div>
							</td>
							<td>
								if string(o.Type) == "vendor" {
									<span class="badge badge-sky">مورد / شركة أدوية</span>
								} else {
									<span class="badge badge-emerald">صيدلية مرخصة</span>
								}
							</td>
							<td>
								<div style="font-size:0.85rem;"><span style="color:var(--neutral-500);">سجل:</span> <strong class="tabular-nums">{ o.CommercialRegister }</strong></div>
								if o.TaxNumber != "" {
									<div style="font-size:0.8rem; color:var(--neutral-600);"><span style="color:var(--neutral-500);">ضريبة:</span> <span class="tabular-nums">{ o.TaxNumber }</span></div>
								}
							</td>
							<td>
								if o.PharmacistLicense != "" {
									<span class="tabular-nums" style="font-weight:700; color:var(--primary-700); font-size:0.875rem;">{ o.PharmacistLicense }</span>
								} else {
									<span style="color:var(--neutral-400); font-size:0.8rem;">غير محدد</span>
								}
							</td>
							<td>
								if orgDocs != nil && len(orgDocs[o.ID]) > 0 {
									<div style="display:flex; flex-direction:column; gap:0.25rem;">
										for _, doc := range orgDocs[o.ID] {
											<a href={ templ.SafeURL(fmt.Sprintf("/api/v1/attachments/%d", doc.ID)) } target="_blank" class="btn btn-secondary btn-sm" style="font-size:0.75rem; font-weight:700; color:var(--primary-700); gap:0.35rem; padding:0.25rem 0.55rem;">
												@components.IconFile("icon-xs")
												<span>{ docTypeLabelAr(string(doc.DocumentType)) }</span>
											</a>
										}
									</div>
								} else {
									<span style="font-size:0.775rem; color:var(--neutral-400);">لا يوجد ملف</span>
								}
							</td>
							<td>
								if string(o.Status) == "approved" {
									<span class="badge badge-emerald">معتمد ونشط</span>
								} else if string(o.Status) == "rejected" {
									<span class="badge badge-danger">مرفوض</span>
								} else if string(o.Status) == "suspended" {
									<span class="badge badge-warning">معلق مؤقتاً</span>
								} else {
									<span class="badge badge-sky">قيد التدقيق</span>
								}
							</td>
							<td class="text-end">
								<div class="table-actions" style="justify-content:flex-end; gap:0.4rem;">
									<button
										type="button"
										class="btn btn-secondary btn-sm"
										data-modal-open={ fmt.Sprintf("details-modal-%d", o.ID) }
									>
										@components.IconEye("icon-xs")
										<span>بيانات التسجيل</span>
									</button>

									if string(o.Status) != "approved" {
										<button
											type="button"
											class="btn btn-primary btn-sm"
											data-modal-open={ fmt.Sprintf("review-modal-%d", o.ID) }
										>
											@components.IconCheck("icon-xs")
											<span>تدقيق واعتماد</span>
										</button>
									}

									<!-- Persistent Registration Details Modal -->
									@components.Modal(components.ModalProps{
										ID:    fmt.Sprintf("details-modal-%d", o.ID),
										Title: fmt.Sprintf("ملف بيانات التسجيل: %s", o.LegalName),
										Size:  "lg",
									}) {
										<div style="display:flex; flex-direction:column; gap:1.25rem; text-align:start;">
											<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border); font-size:0.875rem;">
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">الاسم القانوني للمنشأة</span>
													<strong style="color:var(--text); font-size:1rem;">{ o.LegalName }</strong>
												</div>
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">نوع الحساب</span>
													<span class="badge badge-sky">{ orgTypeAr(string(o.Type)) }</span>
												</div>
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">الاسم التجاري (عربي)</span>
													<strong style="color:var(--text);">{ o.TradeName["ar"] }</strong>
												</div>
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">الاسم التجاري (إنجليزي)</span>
													<span style="color:var(--text);" dir="ltr">{ o.TradeName["en"] }</span>
												</div>
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">رقم السجل التجاري</span>
													<strong class="tabular-nums" style="color:var(--text);">{ o.CommercialRegister }</strong>
												</div>
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">الرقم الضريبي</span>
													<span class="tabular-nums" style="color:var(--text);">{ o.TaxNumber }</span>
												</div>
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">رقم ترخيص المؤسسة الصيدلية</span>
													<strong class="tabular-nums" style="color:var(--accent);">{ o.PharmacistLicense }</strong>
												</div>
												<div>
													<span style="color:var(--text-muted); display:block; font-size:0.75rem;">الحالة الحالية</span>
													if string(o.Status) == "approved" {
														<span class="badge badge-emerald">معتمد ونشط</span>
													} else if string(o.Status) == "rejected" {
														<span class="badge badge-danger">مرفوض</span>
													} else {
														<span class="badge badge-sky">قيد التدقيق</span>
													}
												</div>
											</div>

											<div style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; border-top:1px solid var(--border); padding-top:1rem;">
												<a href="/admin/documents" class="btn btn-secondary btn-sm" style="font-weight:700; color:var(--accent);">
													@components.IconFile("icon-xs")
													<span>عرض المستندات والملفات المرفقة في مركز الوثائق</span>
												</a>
												<button
													type="button"
													class="btn btn-secondary"
													data-modal-close={ fmt.Sprintf("details-modal-%d", o.ID) }
												>
													إغلاق
												</button>
											</div>
										</div>
									}

									<!-- Full Review Modal with Document Classification -->
									@components.Modal(components.ModalProps{
										ID:    fmt.Sprintf("review-modal-%d", o.ID),
										Title: fmt.Sprintf("تدقيق واعتماد ترخيص: %s", o.LegalName),
										Size:  "md",
									}) {
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/approvals/%d/review", o.ID)) } style="display:flex; flex-direction:column; gap:1.1rem; text-align:start;">
											<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-lg); border:1px solid var(--border); font-size:0.875rem;">
												<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.5rem;">
													<div><strong>الاسم التجاري:</strong> { o.TradeName["ar"] }</div>
													<div><strong>نوع المنشأة:</strong> { orgTypeAr(string(o.Type)) }</div>
													<div><strong>السجل التجاري:</strong> <span class="tabular-nums">{ o.CommercialRegister }</span></div>
													<div><strong>ترخيص المهنة:</strong> <span class="tabular-nums">{ o.PharmacistLicense }</span></div>
												</div>
												
												<!-- Document Preview Strip -->
												<div style="margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid var(--border);">
													if orgDocs != nil && len(orgDocs[o.ID]) > 0 {
														<div style="font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">المستند المرفوع عند التسجيل:</div>
														for _, doc := range orgDocs[o.ID] {
															<a href={ templ.SafeURL(fmt.Sprintf("/api/v1/attachments/%d", doc.ID)) } target="_blank" class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; font-weight:700; color:var(--accent); margin-bottom:0.25rem;">
																@components.IconFile("icon-xs")
																<span>معاينة المستند المرفوع ({ docTypeLabelAr(string(doc.DocumentType)) }) في نافذة جديدة ↗</span>
															</a>
														}
													} else {
														<span style="font-size:0.8rem; color:var(--text-muted);">لم يتم رفع ملف مستند إلكتروني أثناء التسجيل</span>
													}
												</div>
											</div>

											<!-- Document Category Assignment -->
											<div class="form-group" style="margin:0;">
												<label class="form-label" for={ fmt.Sprintf("doc-type-select-%d", o.ID) }>
													تصنيف فئة المستند المرفوع (لتوثيقه واعتماده تلقائياً في ملف المنشأة) *
												</label>
												<select id={ fmt.Sprintf("doc-type-select-%d", o.ID) } name="document_type" required class="form-select" style="font-weight:700; background:var(--surface-sunken); border-color:var(--accent);">
													if string(o.Type) == "vendor" {
														<option value="commercial_register" selected>السجل التجاري (Commercial Register)</option>
														<option value="tax_card">البطاقة الضريبية (Tax Card)</option>
														<option value="pharmacy_license">ترخيص المستودع / المنشأة (Warehouse License)</option>
														<option value="pharmacist_license">ترخيص المدير الفني / الصيدلي (Technical Director License)</option>
														<option value="authorization_letter">خطاب تفويض رسمي (Authorization Letter)</option>
														<option value="national_id">بطاقة الرقم القومي للمفوض (National ID)</option>
														<option value="other">مستند رسمي آخر (Other)</option>
													} else {
														<option value="pharmacy_license" selected>ترخيص الصيدلية / المنشأة الطبية (Pharmacy License)</option>
														<option value="pharmacist_license">ترخيص مزاولة المهنة للصيدلي (Pharmacist License)</option>
														<option value="commercial_register">السجل التجاري (Commercial Register)</option>
														<option value="tax_card">البطاقة الضريبية (Tax Card)</option>
														<option value="syndicate_card">كارنيه نقابة الصيادلة (Syndicate Card)</option>
														<option value="national_id">بطاقة الرقم القومي (National ID)</option>
														<option value="authorization_letter">خطاب تفويض رسمي (Authorization Letter)</option>
														<option value="other">مستند رسمي آخر (Other)</option>
													}
												</select>
												<span style="font-size:0.75rem; color:var(--text-muted); margin-top:3px; display:block;">
													عند الاعتماد، سيتم حفظ المستند كـ "معتمد وموثق" تحت هذه الفئة وسيظهر فوراً في لوحة تحكم المنشأة.
												</span>
											</div>

											<div class="form-group" style="margin:0;">
												<label class="form-label" for={ fmt.Sprintf("status-select-%d", o.ID) }>قرار المراجعة والاعتماد *</label>
												<select id={ fmt.Sprintf("status-select-%d", o.ID) } name="status" required class="form-select">
													<option value="approved" selected?={ string(o.Status) == "approved" || string(o.Status) == "pending" }>اعتماد وترخيص المنشأة (Approve)</option>
													<option value="rejected" selected?={ string(o.Status) == "rejected" }>رفض الطلب (Reject)</option>
													<option value="suspended" selected?={ string(o.Status) == "suspended" }>تعليق مؤقت للحساب (Suspend)</option>
													<option value="pending">إبقاء قيد التدقيق (Pending)</option>
												</select>
											</div>

											<div class="form-group" style="margin:0;">
												<label class="form-label" for={ fmt.Sprintf("notes-%d", o.ID) }>ملاحظات الإدارة الداخلية</label>
												<input type="text" id={ fmt.Sprintf("notes-%d", o.ID) } name="verification_notes" class="form-input" value={ o.VerificationNotes } placeholder="مثال: تم التأكد من صحة الترخيص وتصنيفه عبر هيئة الدواء" />
											</div>

											<div class="form-group" style="margin:0;">
												<label class="form-label" for={ fmt.Sprintf("rejection-%d", o.ID) }>سبب الرفض (يظهر للمنشأة في حال الرفض)</label>
												<textarea id={ fmt.Sprintf("rejection-%d", o.ID) } name="rejection_reason" rows="2" class="form-input" placeholder="يرجى توضيح سبب الرفض أو النواقص المطلوبة...">{ o.RejectionReason }</textarea>
											</div>

											<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
												<button
													type="button"
													class="btn btn-secondary"
													data-modal-close={ fmt.Sprintf("review-modal-%d", o.ID) }
												>
													إلغاء
												</button>
												<button type="submit" class="btn btn-primary" style="font-weight:800;">
													@components.IconCheck("icon-xs")
													<span>حفظ وتوثيق القرار</span>
												</button>
											</div>
										</form>
									}

								</div>
							</td>
						</tr>
					}

				</tbody>
			</table>
		</div>
	}
}

func orgTypeAr(t string) string {
	switch t {
	case "vendor":
		return "مورّد / شركة أدوية"
	case "customer":
		return "صيدلية / منشأة طبية"
	default:
		return t
	}
}

func docTypeLabelAr(t string) string {
	switch t {
	case "commercial_register":
		return "السجل التجاري"
	case "tax_card":
		return "البطاقة الضريبية"
	case "pharmacist_license":
		return "ترخيص مزاولة المهنة"
	case "pharmacy_license":
		return "ترخيص الصيدلية / المنشأة"
	case "national_id":
		return "بطاقة الرقم القومي"
	case "syndicate_card":
		return "كارنيه النقابة"
	case "authorization_letter":
		return "خطاب التفويض الرسمي"
	case "cv":
		return "السيرة الذاتية"
	default:
		if t != "" {
			return t
		}
		return "مستند رسمي"
	}
}
