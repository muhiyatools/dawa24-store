package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorDashboard(lang, dir string, data VendorDashboardData) {
	@layouts.VendorShell("لوحة التحكم", "dashboard", lang, dir) {
		<div class="page-container" class="admin-page-container">
			
			<!-- Emergency Legal Document Request Banner -->
			if len(data.PendingDocRequests) > 0 {
				<div class="alert alert-warning mb-0 p-4 flex-between flex-wrap gap-4" class="rounded-xl">
					<div class="d-flex items-center gap-3">
						<div class="text-warning flex-shrink-0">
							@components.IconAlert("icon-lg")
						</div>
      <div class="stack-sm">
							<div class="font-extrabold text-sm text-warning">
								تنبيه إداري عاجل: مطلوب رفع مستند رسمي ({ data.PendingDocRequests[0].Title })
							</div>
							<div class="text-xs text-muted mt-1">
								المهلة الممنوحة: متبقي <strong class="tabular-nums text-primary">{ fmt.Sprintf("%d", data.PendingDocRequests[0].DaysRemaining()) }</strong> يوم (حتى { format.Date(data.PendingDocRequests[0].DeadlineAt, "ar") }). يرجى الرفع لتجنب إيقاف وتجميد حساب المورد.
							</div>
						</div>
					</div>
					<a href="/vendor/documents" class="btn btn-primary btn-sm font-bold gap-1 rounded-md">
						@components.IconFile("icon-xs")
						<span>رفع المستند المطلوب الآن â†—</span>
					</a>
				</div>
			}

			<!-- Subscription & AI Quotas Strip -->
			if data.Subscription != nil && data.Subscription.HasSubscription {
				<div class="glass-panel p-5 mb-0" class="rounded-2xl">
					<div class="flex-between items-center flex-wrap gap-3 mb-4 pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<span class="text-xl">@components.IconBuilding("icon-sm")</span>
       <div class="stack-sm">
								<h2 class="text-base font-extrabold text-primary m-0">
									باقة الاشتراك وخدمات الذكاء الاصطناعي للمورد
								</h2>
								<p class="text-xs text-secondary m-0 mt-1">
									الخطة المعتمدة وحدود الجلسات المطبقة على المنشأة بالكامل وحصة الـ AI Gateway
								</p>
							</div>
						</div>
						<div class="d-flex items-center gap-2">
							<span class="badge badge-emerald text-xs font-bold">{ data.Subscription.Status }</span>
							if data.Subscription.IsDefaultPlan {
								<span class="badge badge-primary text-xs font-bold">باقة افتراضية</span>
							}
						</div>
					</div>

					<div class="dashboard-stat-grid cols-4 mb-0">
						<!-- Plan Name & Expiry -->
						<div class="stat-card-3d">
							<div class="stat-card-label">خطة الاشتراك المعتمدة</div>
							<div class="text-base font-black text-primary mt-1">{ data.Subscription.PlanName }</div>
							<div class="text-xs text-muted mt-1">الصلاحية: { data.Subscription.ExpiresAt }</div>
						</div>

						<!-- Sessions Quota -->
						<div class="stat-card-3d">
							<div class="stat-card-label">الجلسات المتزامنة</div>
							<div class="stat-card-value text-brand tabular-nums">
								{ fmt.Sprintf("%d", data.Subscription.MaxLoginSessions) }
							</div>
							<div class="text-xs text-muted mt-1">مشتركة لكافة موظفي المورد</div>
						</div>

						<!-- Devices Quota -->
						<div class="stat-card-3d">
							<div class="stat-card-label">حد الأجهزة المفتوحة</div>
							<div class="stat-card-value text-primary tabular-nums">
								{ fmt.Sprintf("%d", data.Subscription.MaxDevices) }
							</div>
							<div class="text-xs text-muted mt-1">الحد الأقصى للأجهزة المصرح بها</div>
						</div>

						<!-- AI Gateway & Live Consumption -->
						<div class="stat-card-3d d-flex flex-col justify-between">
       <div class="stack-sm">
								<div class="flex-between items-center mb-1">
									<span class="stat-card-label text-brand font-black">بوابة الـ AI</span>
									<span class="badge badge-sky text-xs font-bold font-mono" dir="ltr">{ data.Subscription.AIPlanID }</span>
								</div>

								<div class="mt-2">
									<div class="flex-between items-baseline mb-1">
										<span class="text-xs text-secondary font-bold">استهلاك الحصة:</span>
										<div class="tabular-nums text-base font-black text-brand">
											if data.Subscription.HasAIBudget {
												{ fmt.Sprintf("%d%%", data.Subscription.AIPercentage()) }
											} else {
												{ data.Subscription.AIUsageText() }
											}
										</div>
									</div>

									if data.Subscription.HasAIBudget {
										<div class="progress-bar-container">
											<div class="progress-bar-fill" style={ fmt.Sprintf("width:%d%%;", data.Subscription.AIPercentage()) }></div>
										</div>
									}

									<div class="flex-between text-xs text-muted mt-1">
										if data.Subscription.HasAIBudget {
											<span>متبقي: <strong class="text-success">{ fmt.Sprintf("%d%%", 100-data.Subscription.AIPercentage()) }</strong></span>
										}
										<span>التجديد: <strong class="text-primary">{ data.Subscription.AIResetText() }</strong></span>
									</div>
								</div>
							</div>

							<div class="mt-3 pt-2 border-t flex-between items-center">
								<a href="/vendor/ai-logs" class="text-xs font-bold text-brand text-decoration-none">
									<span>سجل الاستهلاك (AI Logs) â†—</span>
								</a>
								<a href="/vendor/subscription" class="text-xs font-bold text-muted text-decoration-none">
									<span>الاشتراك â†—</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			}

			<!-- Master KPI 6-Stat Grid with Relevant Metrics -->
			<div class="dashboard-stat-grid mb-0" >
				
				<!-- 1. Monthly Revenue -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-brand font-bold d-flex items-center justify-between">
						<span>صافي مبيعات الشهر</span>
						<a href="/vendor/earnings/order" class="badge badge-emerald text-xs text-decoration-none">تفاصيل â†—</a>
					</div>
					<div class="stat-card-value text-brand tabular-nums mt-1">
						@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.MonthSales })
					</div>
					<div class="text-xs text-muted mt-1">إجمالي المبيعات المعتمدة لهذا الشهر</div>
				</div>

				<!-- 2. Realized Net Profit -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-success font-bold d-flex items-center justify-between">
						<span>صافي أرباح الشهر المحققة</span>
						if data.MonthProfitMargin > 0 {
							<span class="badge badge-emerald text-xs font-extrabold tabular-nums">{ fmt.Sprintf("%.1f%%", data.MonthProfitMargin) }</span>
						}
					</div>
					<div class="stat-card-value text-success tabular-nums mt-1">
						@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.MonthNetProfit })
					</div>
					<div class="text-xs text-muted mt-1">بعد خصم تكاليف البضاعة المباعة COGS</div>
				</div>

				<!-- 3. Available Wallet Balance -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-sky font-bold d-flex items-center justify-between">
						<span>رصيد المحفظة المتاح</span>
						<span class="badge badge-sky text-xs">سيولة</span>
					</div>
					<div class="stat-card-value text-sky tabular-nums mt-1">
						@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.WalletBalance })
					</div>
					<div class="text-xs text-muted mt-1">الرصيد القابل للتحويل والتسوية</div>
				</div>

				<!-- 4. Pending Orders -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-warning font-bold d-flex items-center justify-between">
						<span>طلبات قيد التنفيذ</span>
						<span class="badge badge-amber text-xs font-bold">بانتظار</span>
					</div>
					<div class="stat-card-value text-warning tabular-nums mt-1">
						{ fmt.Sprintf("%d", data.PendingShipments) } <span class="text-xs text-muted font-semibold">أوامر توريد</span>
					</div>
					<div class="text-xs text-secondary font-bold mt-1 tabular-nums">
						بقيمة: { data.PendingOrdersTotal.String() } ج.م
					</div>
				</div>

				<!-- 5. Active Catalog Products -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-primary font-bold d-flex items-center justify-between">
						<span>المنتجات النشطة بالكتالوج</span>
						<a href="/vendor/products" class="badge badge-slate text-xs text-decoration-none">الكتالوج â†—</a>
					</div>
					<div class="stat-card-value text-primary tabular-nums mt-1">
						{ fmt.Sprintf("%d", data.ActiveProducts) } <span class="text-xs text-muted font-semibold">صنف دواء</span>
					</div>
					<div class="text-xs text-muted mt-1">جاهزة للطلب المباشر من الصيدليات</div>
				</div>

				<!-- 6. Delivered Shipments -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-success font-bold d-flex items-center justify-between">
						<span>الشحنات المسلمة بنجاح</span>
						<span class="badge badge-emerald text-xs">تسليم</span>
					</div>
					<div class="stat-card-value text-success tabular-nums mt-1">
						{ fmt.Sprintf("%d", data.DeliveredShipments) } <span class="text-xs text-muted font-semibold">شحنة</span>
					</div>
					<div class="text-xs text-muted mt-1 tabular-nums">
						من إجمالي { fmt.Sprintf("%d", data.TotalShipmentsCount) } شحنة مسجلة
					</div>
				</div>

			</div>

			<!-- Workspace 2-Column Grid -->
			<div class="dashboard-grid-2col mb-0">
				
				<!-- 1. Pending Shipments Section (With Preview Flow) -->
				<div class="glass-panel p-6 mb-0 d-flex flex-col justify-between" class="rounded-2xl">
     <div class="stack-sm">
						<div class="flex-between items-center mb-4 pb-3 border-b">
							<div class="d-flex items-center gap-2">
								<span class="text-lg">@components.IconPackage("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">
									شحنات بانتظار قيد التنفيذ
								</h2>
								if len(data.Shipments) > 0 {
									<span class="badge badge-amber text-xs font-bold tabular-nums">{ fmt.Sprintf("%d", len(data.Shipments)) }</span>
								}
							</div>
							<a href="/vendor/orders" class="btn btn-secondary btn-sm font-bold text-xs rounded-md">
								<span>عرض كافة الطلبيات â†—</span>
							</a>
						</div>

						if len(data.Shipments) == 0 {
							<div class="text-xs text-muted text-center py-10">
								<div class="text-2xl mb-2">ðŸŽ‰</div>
								<strong class="text-primary d-block mb-1">لا توجد شحنات معلّقة حالياً</strong>
								<span>تمت معالجة وتنفيذ كافة أوامر التوريد الواردة من الصيدليات.</span>
							</div>
						} else {
							<div class="table-container m-0" class="rounded-xl overflow-hidden">
								<table class="data-table m-0">
									<thead>
										<tr>
											<th>الشحنة والطلب</th>
											<th>الصيدلية والفرع المستلم</th>
											<th class="text-center">الأصناف</th>
											<th class="text-end">الإجمالي</th>
											<th>الحالة</th>
											<th class="w-24" class="text-center">الإجراء</th>
										</tr>
									</thead>
									<tbody>
										for _, s := range data.Shipments {
											<tr class="align-middle">
												<td>
													<div class="tabular-nums font-bold text-xs text-primary">#{ s.ShipmentNumber }</div>
													if s.OrderNumber != "" {
														<div class="text-xs text-muted tabular-nums mt-1">أمر #{ s.OrderNumber }</div>
													}
												</td>
												<td>
													<div class="font-bold text-xs text-primary">
														if s.CustomerBranchName.Get(i18n.Lang(lang)) != "" {
															{ s.CustomerBranchName.Get(i18n.Lang(lang)) }
														} else {
															<span>صيدلية معتمدة</span>
														}
													</div>
													if s.CustomerBranchAddress != "" {
														<div class="text-xs text-muted mt-1 text-truncate" class="max-w-xs">
															{ s.CustomerBranchAddress }
														</div>
													}
												</td>
												<td class="text-center tabular-nums">
													<span class="badge badge-secondary text-xs font-bold">
														{ fmt.Sprintf("%d صنف", len(s.Lines)) }
													</span>
												</td>
												<td class="tabular-nums font-black text-brand text-xs text-end">
													@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: s.TotalAmount })
												</td>
												<td>
													if s.Status == commerce.StatusPending {
														<span class="badge badge-amber text-xs font-bold">بانتظار التأكيد</span>
													} else if s.Status == commerce.StatusConfirmed {
														<span class="badge badge-sky text-xs font-bold">قيد التجهيز</span>
													} else {
														<span class="badge badge-slate text-xs font-bold">{ string(s.Status) }</span>
													}
												</td>
												<td class="text-center">
													@components.ModalTrigger(fmt.Sprintf("preview-shipment-%d", s.ID), "btn btn-secondary btn-sm font-bold text-xs px-3 gap-1") {
														<span>@components.IconEye("icon-sm")</span>
														<span>معاينة</span>
													}
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>
				</div>

				<!-- 2. Low Stock Alerts -->
				<div class="glass-panel p-6 mb-0 d-flex flex-col justify-between" class="rounded-2xl">
     <div class="stack-sm">
						<div class="flex-between items-center mb-4 pb-3 border-b">
							<div class="d-flex items-center gap-2">
								<span class="text-lg">@components.IconAlert("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">أصناف تحت الحد الأدنى</h2>
								if len(data.LowStock) > 0 {
									<span class="badge badge-danger text-xs font-bold tabular-nums">{ fmt.Sprintf("%d", len(data.LowStock)) }</span>
								}
							</div>
							<a href="/vendor/inventory" class="btn btn-secondary btn-sm font-bold text-xs rounded-md">الأرصدة والمخازن</a>
						</div>
						if len(data.LowStock) == 0 {
							<div class="text-xs text-muted text-center py-10">
								<div class="text-2xl mb-2">@components.IconCheckCircle("icon-sm")</div>
								<strong class="text-primary d-block mb-1">المخزون في وضع آمن</strong>
								<span>جميع الأرصدة المخزنية فوق حد إعادة الطلب الآمن.</span>
							</div>
						} else {
							<div class="table-container m-0" class="rounded-xl overflow-hidden">
								<table class="data-table m-0">
									<thead>
										<tr>
											<th>الصنف</th>
											<th class="text-center">الكمية المتبقية</th>
											<th class="text-center">حد الأمان</th>
										</tr>
									</thead>
									<tbody>
										for _, s := range data.LowStock {
											<tr>
												<td class="font-bold text-xs text-primary">صنف #{ fmt.Sprintf("%d", s.ProductID) }</td>
												<td class="text-center tabular-nums text-danger font-black text-xs">{ fmt.Sprintf("%d", s.Quantity) }</td>
												<td class="text-center tabular-nums text-muted text-xs">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>
				</div>

				<!-- 3. Active Offers Strip -->
				<div class="glass-panel p-6 mb-0 d-flex flex-col justify-between" class="rounded-2xl">
     <div class="stack-sm">
						<div class="flex-between items-center mb-4 pb-3 border-b">
							<div class="d-flex items-center gap-2">
								<span class="text-lg">@components.IconPackage("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">العروض الخاصة النشطة</h2>
							</div>
							<a href="/vendor/offers" class="btn btn-secondary btn-sm font-bold text-xs rounded-md">إدارة العروض</a>
						</div>
						if len(data.Offers) == 0 {
							<div class="text-xs text-muted text-center py-8">
								لا توجد عروض ترويجية نشطة حالياً.
							</div>
						} else {
							<div class="d-flex flex-col gap-2">
								for _, o := range data.Offers {
									<div class="flex-between items-center p-3 rounded-lg bg-surface-sunken border">
          <div class="stack-sm">
											<div class="font-bold text-primary text-xs">{ o.Title.Get(i18n.Lang(lang)) }</div>
											<div class="text-xs text-muted mt-1 tabular-nums">مشاهدة { fmt.Sprintf("%d", o.ViewsCount) } Â· نقر { fmt.Sprintf("%d", o.ClicksCount) }</div>
										</div>
										<span class="badge badge-emerald text-xs font-bold">نشط</span>
									</div>
								}
							</div>
						}
					</div>
				</div>

				<!-- 4. Price Quotes Strip -->
				<div class="glass-panel p-6 mb-0 d-flex flex-col justify-between" class="rounded-2xl">
     <div class="stack-sm">
						<div class="flex-between items-center mb-4 pb-3 border-b">
							<div class="d-flex items-center gap-2">
								<span class="text-lg">@components.IconUsers("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">طلبات التسعير المباشرة</h2>
							</div>
							<a href="/vendor/orders" class="btn btn-secondary btn-sm font-bold text-xs rounded-md">المراجعة</a>
						</div>
						if data.UnreadQuotes == 0 {
							<div class="text-xs text-muted text-center py-8">
								لا توجد طلبات تسعير غير مقروءة بانتظار الرد.
							</div>
						} else {
							<div class="p-4 rounded-lg bg-surface-sunken border text-center">
								<div class="text-2xl font-black text-brand tabular-nums mb-1">{ fmt.Sprintf("%d", data.UnreadQuotes) }</div>
								<div class="text-xs text-secondary font-bold">طلب تسعير جديد بانتظار موافقتك</div>
								<div class="mt-4">
									<a href="/vendor/orders" class="btn btn-primary btn-sm font-bold text-xs px-4 rounded-md">
										<span>مراجعة طلبات التسعير والرد â†—</span>
									</a>
								</div>
							</div>
						}
					</div>
				</div>

			</div>
		</div>
	}

	<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
	<!-- Detailed Shipment Preview & Execution Modals (With Official Workflow) -->
	<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
	for _, s := range data.Shipments {
		@components.Modal(components.ModalProps{ 
			ID: fmt.Sprintf("preview-shipment-%d", s.ID), 
			Title: fmt.Sprintf("معاينة أمر التوريد والبدء في التنفيذ: شحنة #%s", s.ShipmentNumber), 
			Size: "lg", 
		}) {
			<div class="stack-md p-1">
				
				<!-- Shipment & Pharmacy Quick Header Strip -->
				<div class="d-grid gap-3 bg-surface-sunken p-4 rounded-xl border mb-3 text-xs" class="grid-auto-fit-sm">
     <div class="stack-sm">
						<div class="text-muted font-bold mb-1">الصيدلية والفرع المستلم:</div>
						<strong class="text-primary text-sm font-bold d-block">
							if s.CustomerBranchName.Get(i18n.Lang(lang)) != "" {
								{ s.CustomerBranchName.Get(i18n.Lang(lang)) }
							} else {
								<span>صيدلية معتمدة</span>
							}
						</strong>
						if s.CustomerOrgName.Get(i18n.Lang(lang)) != "" {
							<span class="text-secondary text-xs">{ s.CustomerOrgName.Get(i18n.Lang(lang)) }</span>
						}
					</div>

     <div class="stack-sm">
						<div class="text-muted font-bold mb-1">عنوان التسليم:</div>
						<div class="text-primary">
							if s.CustomerBranchAddress != "" {
								{ s.CustomerBranchAddress }
							} else {
								<span class="text-muted">العنوان المسجل للفرع</span>
							}
						</div>
					</div>

     <div class="stack-sm">
						<div class="text-muted font-bold mb-1">مسؤول الاستلام:</div>
						<div class="text-primary">
							if s.CustomerManagerName != "" {
								<strong>{ s.CustomerManagerName }</strong>
							}
							if s.CustomerBranchPhone != "" {
								<div class="tabular-nums text-secondary mt-1">{ s.CustomerBranchPhone }</div>
							} else if s.CustomerManagerName == "" {
								<span class="text-muted">الصيدلي المسؤول</span>
							}
						</div>
					</div>

     <div class="stack-sm">
						<div class="text-muted font-bold mb-1">القيمة الإجمالية:</div>
						<strong class="text-brand font-black text-sm tabular-nums">
							{ s.TotalAmount.String() } ج.م
						</strong>
						<div class="text-muted mt-1">
							if s.PaymentMethod != "" {
								<span>طريقة الدفع: { s.PaymentMethod }</span>
							}
						</div>
					</div>

					if s.Notes != "" {
						<div class="border-t pt-2 mt-1" class="col-span-full">
							<div class="text-muted font-bold mb-1">ملاحظات الصيدلية:</div>
							<div class="text-primary">{ s.Notes }</div>
						</div>
					}
				</div>

				<!-- Line Items Table -->
				<div class="mb-4">
					<div class="flex-between items-center mb-2">
						<h4 class="text-xs font-black text-primary m-0 d-flex items-center gap-1">
							@components.IconPackage("icon-xs")
							<span>الأصناف المطلوبة للتوريد ({ fmt.Sprintf("%d", len(s.Lines)) } صنف)</span>
						</h4>
						<span class="badge badge-sky text-xs font-bold">Cold-Chain مبرد</span>
					</div>

					if len(s.Lines) == 0 {
						<div class="text-xs text-muted text-center py-4 bg-surface-sunken rounded-lg border">
							أمر التوريد يحتوي على أصناف معتمدة بقيمة إجمالية { s.TotalAmount.String() } ج.م.
						</div>
					} else {
						<div class="table-container m-0" class="rounded-lg overflow-y-auto max-h-56">
							<table class="data-table m-0" class="text-xs">
								<thead>
									<tr class="bg-surface-raised">
										<th>اسم الصنف / الدواء</th>
										<th class="text-center">الكمية</th>
										<th class="text-center">السعر</th>
										<th class="text-end">الإجمالي</th>
									</tr>
								</thead>
								<tbody>
									for _, l := range s.Lines {
										<tr>
											<td>
												<strong class="text-primary">{ l.ProductName.Get(i18n.Lang(lang)) }</strong>
												if l.VariantName.Get(i18n.Lang(lang)) != "" {
													<div class="text-xs text-muted">{ l.VariantName.Get(i18n.Lang(lang)) }</div>
												}
											</td>
											<td class="text-center font-bold tabular-nums">
												<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", l.Quantity) } عبوة</span>
											</td>
											<td class="text-center tabular-nums text-secondary text-xs">{ l.UnitPrice.String() } ج.م</td>
											<td class="text-end tabular-nums font-bold text-brand">{ l.TotalPrice.String() } ج.م</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Execution Controls Workflow Section -->
				<div class="p-3 bg-surface-sunken rounded-xl border">
					<div class="text-xs font-extrabold text-primary mb-3">
						خيارات بدء وتنفيذ الشحنة وفق دورة العمل الرسمية:
					</div>

					if s.Status == commerce.StatusPending {
						<!-- Status: Pending -> Choice to Confirm, Ship, Deliver, or Reject -->
						<div class="d-flex flex-col gap-3">
							<div class="d-grid gap-2 grid-auto-fit-xs">
								
								<!-- Option A: Confirm & Start Warehouse Prep -->
								<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", s.ID)) } method="POST" class="m-0">
									<input type="hidden" name="status" value="confirmed" />
									<input type="hidden" name="notes" value="تمت الموافقة على أمر التوريد وبدء التجهيز بالمستودع" />
									<button type="submit" class="btn btn-secondary w-full justify-center font-bold text-xs py-2 gap-1 rounded-md">
										@components.IconCheck("icon-xs")
										<span>قبول وبدء التجهيز</span>
									</button>
								</form>

								<!-- Option B: Direct Deliver -->
								<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", s.ID)) } method="POST" class="m-0">
									<input type="hidden" name="status" value="delivered" />
									<input type="hidden" name="notes" value="تم تسليم الشحنة المبردة بالصيدلية وتوثيق الاستلام" />
									<button type="submit" class="btn btn-primary w-full justify-center font-bold text-xs py-2 gap-1 rounded-md">
										@components.IconCheckCircle("icon-xs")
										<span>إتمام وتسليم الطلب للصيدلية</span>
									</button>
								</form>

								<!-- Option C: Reject Order -->
								<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", s.ID)) } method="POST" class="m-0" onsubmit="return confirm('تأكيد رفض أمر التوريد هذا وإلغائه؟');">
									<input type="hidden" name="status" value="cancelled" />
									<input type="hidden" name="notes" value="تم رفض الطلب من قبل إدارة مبيعات المورد" />
									<button type="submit" class="btn btn-danger w-full justify-center font-bold text-xs py-2 rounded-md">
										<span>رفض الطلب</span>
									</button>
								</form>
							</div>

							<!-- Option D: Dispatch / Ship with Carrier Details -->
							<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", s.ID)) } method="POST" class="border-t pt-3 mt-1 d-flex items-center gap-2 flex-wrap">
								<input type="hidden" name="status" value="shipped" />
								<input type="hidden" name="notes" value="تم تسليم الشحنة للمندوب/شركة الشحن" />
								<input
									type="text"
									name="carrier"
									placeholder="شركة الشحن / اسم المندوب..."
									class="form-input text-xs"
									class="flex-1 min-w-36 rounded-md"
								/>
								<input
									type="text"
									name="tracking"
									placeholder="رقم البوليصة / هاتف المندوب..."
									class="form-input text-xs tabular-nums"
									class="flex-1 min-w-36 rounded-md"
									dir="ltr"
								/>
								<button type="submit" class="btn btn-secondary font-bold text-xs py-2 px-3 gap-1" class="rounded-md">
									@components.IconTruck("icon-xs")
									<span>إرسال للشحن </span>
								</button>
							</form>
						</div>
					} else if s.Status == commerce.StatusConfirmed {
						<!-- Status: Confirmed -> Ship with Carrier, or Mark Delivered -->
						<div class="d-flex flex-col gap-3">
							<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", s.ID)) } method="POST" class="d-flex items-center gap-2 flex-wrap">
								<input type="hidden" name="status" value="shipped" />
								<input type="hidden" name="notes" value="تم الانتهاء من التجهيز وتسليم الشحنة للشحن والتوصيل" />
								<input
									type="text"
									name="carrier"
									placeholder="شركة الشحن / المندوب..."
									class="form-input text-xs"
									class="flex-1 min-w-36 rounded-md"
								/>
								<input
									type="text"
									name="tracking"
									placeholder="رقم التتبع / البوليصة..."
									class="form-input text-xs tabular-nums"
									class="flex-1 min-w-36 rounded-md"
									dir="ltr"
								/>
								<button type="submit" class="btn btn-secondary font-bold text-xs py-2 px-3 gap-1" class="rounded-md">
									@components.IconTruck("icon-xs")
									<span>بدء الشحن والتوصيل</span>
								</button>
							</form>

							<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", s.ID)) } method="POST" class="m-0">
								<input type="hidden" name="status" value="delivered" />
								<input type="hidden" name="notes" value="تم تسليم الشحنة بالصيدلية وتوثيق الاستلام بنجاح" />
								<button type="submit" class="btn btn-primary w-full justify-center font-bold text-xs py-2 gap-1 rounded-md">
									@components.IconCheckCircle("icon-xs")
									<span>تأكيد وإتمام التسليم للصيدلية مباشرة </span>
								</button>
							</form>
						</div>
					} else {
						<div class="flex-between items-center">
							<span class="badge badge-emerald text-xs font-bold p-2 px-3">
								الشحنة بحالة: { string(s.Status) }
							</span>
							<a href="/vendor/orders" class="btn btn-secondary btn-sm text-xs font-bold">
								الانتقال لصفحة الطلبيات â†—
							</a>
						</div>
					}
				</div>

				<!-- Navigation Footer Link -->
				<div class="mt-3 pt-2 border-t flex-between items-center">
					<a href="/vendor/orders" class="text-xs font-bold text-secondary text-decoration-none">
						الانتقال لصفحة كافة الطلبيات والشحنات المعتمدة â†—
					</a>
					<form method="dialog" class="m-0">
						<button type="button" class="btn btn-secondary btn-sm font-bold text-xs">إغلاق</button>
					</form>
				</div>

			</div>
		}
	}
}

