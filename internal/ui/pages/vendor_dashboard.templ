package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorDashboard(lang, dir string, data VendorDashboardData) {
	@layouts.VendorShell("لوحة التحكم", "dashboard", lang, dir) {
		if len(data.PendingDocRequests) > 0 {
			<div style="background:#fffbeb; border:2px solid #f59e0b; border-radius:var(--radius-xl); padding:1.25rem; margin-bottom:1.5rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; box-shadow:var(--shadow-sm);">
				<div class="row-center">
					@components.IconAlert("icon-lg")
					<div>
						<div style="font-weight:800; color:#92400e; font-size:0.95rem;">
							تنبيه إداري عاجل: مطلوب رفع مستند رسمي ({ data.PendingDocRequests[0].Title })
						</div>
						<div style="font-size:0.8rem; color:#b45309; margin-top:0.2rem;">
							المهلة الممنوحة: متبقي <strong class="tabular-nums">{ fmt.Sprintf("%d", data.PendingDocRequests[0].DaysRemaining()) }</strong> يوم (حتى { format.Date(data.PendingDocRequests[0].DeadlineAt, "ar") }). يرجى الرفع لتجنب إيقاف وتجميد حساب المورد.
						</div>
					</div>
				</div>
				<a href="/vendor/documents" class="btn btn-primary btn-sm" style="font-weight:800; background:#d97706; border-color:#d97706; color:#ffffff; gap:0.35rem;">
					@components.IconFile("icon-xs")
					<span>رفع المستند المطلوب الآن ↗</span>
				</a>
			</div>
		}

		if data.Subscription != nil && data.Subscription.HasSubscription {
			<div class="card" style="margin-bottom:1.5rem; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
					<div style="display:flex; align-items:center; gap:0.6rem;">
						<span class="text-xl">🏢</span>
						<div>
							<h3 style="margin:0; font-size:1.05rem; font-weight:800; color:var(--text);">
								باقة الاشتراك وخدمات الذكاء الاصطناعي للمورد
							</h3>
							<p style="margin:0.15rem 0 0; font-size:0.775rem; color:var(--text-secondary);">
								الخطة المعتمدة وحدود الجلسات المطبقة على المنشأة بالكامل وحصة الـ AI Gateway
							</p>
						</div>
					</div>
					<div class="row-center-sm">
						<span class="badge badge-emerald fw-700">{ data.Subscription.Status }</span>
						if data.Subscription.IsDefaultPlan {
							<span class="badge badge-primary text-xs">باقة افتراضية</span>
						}
					</div>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:1rem;">
					<!-- Plan Name & Expiry -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<span style="font-size:0.75rem; color:var(--text-secondary); font-weight:600; display:block;">خطة الاشتراك المعتمدة</span>
						<strong style="font-size:1rem; color:var(--text); display:block; margin-top:0.25rem;">{ data.Subscription.PlanName }</strong>
						<span style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem; display:block;">الصلاحية: { data.Subscription.ExpiresAt }</span>
					</div>

					<!-- Sessions Quota -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<span style="font-size:0.75rem; color:var(--text-secondary); font-weight:600; display:block;">الجلسات المتزامنة (إجمالي المنشأة)</span>
						<strong style="font-size:1.15rem; color:var(--primary); display:block; margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d جلسات", data.Subscription.MaxLoginSessions) }
						</strong>
						<span style="font-size:0.725rem; color:var(--text-muted); margin-top:0.25rem; display:block;">مشتركة لكافة موظفي المورد</span>
					</div>

					<!-- Devices Quota -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<span style="font-size:0.75rem; color:var(--text-secondary); font-weight:600; display:block;">الأجهزة المصرح بها</span>
						<strong style="font-size:1.15rem; color:var(--text); display:block; margin-top:0.25rem;" class="tabular-nums">
							{ fmt.Sprintf("%d أجهزة", data.Subscription.MaxDevices) }
						</strong>
						<span style="font-size:0.725rem; color:var(--text-muted); margin-top:0.25rem; display:block;">حد الأجهزة المفتوحة</span>
					</div>

					<!-- AI Gateway & Live Consumption -->
					<div style="background:rgba(56, 189, 248, 0.05); border:1px solid rgba(56, 189, 248, 0.2); border-radius:var(--radius-lg); padding:0.85rem 1rem;">
						<div class="flex-between">
							<span style="font-size:0.75rem; color:var(--primary); font-weight:700;">بوابة الذكاء الاصطناعي</span>
							<span class="badge badge-info" dir="ltr" style="font-size:0.7rem; font-weight:700;">{ data.Subscription.AIPlanID }</span>
						</div>
						if data.Subscription.HasAIUsage && data.Subscription.AIBudgetLimitUSD > 0 {
							<div style="margin-top:0.35rem; font-size:0.8rem; color:var(--text);">
								<span>الميزانية: </span><strong class="tabular-nums" dir="ltr" style="color:var(--primary); font-weight:800;">${ fmt.Sprintf("%.2f / $%.2f", data.Subscription.AIBudgetSpentUSD, data.Subscription.AIBudgetLimitUSD) }</strong>
							</div>
							<div style="margin-top:0.25rem; font-size:0.725rem; color:var(--text-muted);">
								if data.Subscription.AIBudgetResetTime != "" {
									<span>تجديد: <strong class="tabular-nums">{ data.Subscription.AIBudgetResetTime }</strong></span>
								} else {
									<span>تجديد دوري مستمر</span>
								}
							</div>
						} else {
							<div style="margin-top:0.35rem; font-size:0.8rem; color:var(--text);">
								<span>المعرّف: </span><code dir="ltr" class="text-xs">{ data.Subscription.AIUserID }</code>
							</div>
							<div style="margin-top:0.25rem; font-size:0.725rem; color:var(--emerald); font-weight:600;">
								✓ المفتاح الافتراضي مفعل وجاهز
							</div>
						}
					</div>
				</div>

				<div style="margin-top:1rem; padding-top:0.75rem; border-top:1px solid var(--border); display:flex; justify-content:flex-end;">
					<a href="/vendor/subscription" style="font-size:0.8rem; font-weight:700; color:var(--primary); text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem;">
						<span>عرض تفاصيل الاشتراك والترقية ↗</span>
					</a>
				</div>
			</div>
		}

		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
			@components.StatCard(components.StatCardProps{ Label: "المنتجات النشطة", Value: fmt.Sprintf("%d", data.ActiveProducts), Tone: "primary" })
			@components.StatCard(components.StatCardProps{ Label: "طلبات قيد التنفيذ", Value: fmt.Sprintf("%d", data.PendingShipments), Tone: "warning" })
			@components.StatCard(components.StatCardProps{ Label: "مبيعات الشهر", Money: &data.MonthSales, Tone: "neutral" })
			if data.HasWallet {
				@components.StatCard(components.StatCardProps{ Label: "رصيد المحفظة", Money: &data.WalletBalance, Tone: "info" })
			}
			@components.StatCard(components.StatCardProps{ Label: "أصناف تحت الحد الأدنى", Value: fmt.Sprintf("%d", data.LowStockCount), Tone: "danger" })
		</div>

		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(360px, 1fr)); gap:1.25rem;">
			<div class="card">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
					<h2 class="card-title m-0">شحنات بانتظار التنفيذ</h2>
					<a href="/vendor/orders" class="btn btn-secondary btn-sm">عرض الكل</a>
				</div>
				if len(data.Shipments) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد شحنات معلّقة حالياً.</p>
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead><tr><th>الشحنة</th><th>الإجمالي</th><th></th></tr></thead>
							<tbody>
								for _, s := range data.Shipments {
									<tr>
										<td>{ s.ShipmentNumber }</td>
										<td>@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: s.TotalAmount })</td>
										<td>
											@components.ModalTrigger(fmt.Sprintf("dispatch-%d", s.ID), "btn btn-primary btn-sm") {
												تنفيذ
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<div class="card">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
					<h2 class="card-title m-0">أصناف تحت الحد الأدنى</h2>
					<a href="/vendor/inventory" class="btn btn-secondary btn-sm">الأرصدة</a>
				</div>
				if len(data.LowStock) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">جميع الأرصدة فوق حد إعادة الطلب.</p>
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead><tr><th>الصنف</th><th>الكمية</th><th>الحد</th></tr></thead>
							<tbody>
								for _, s := range data.LowStock {
									<tr>
										<td>صنف #{ fmt.Sprintf("%d", s.ProductID) }</td>
										<td class="tabular-nums">{ fmt.Sprintf("%d", s.Quantity) }</td>
										<td class="tabular-nums">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<div class="card">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
					<h2 class="card-title m-0">العروض النشطة</h2>
					<a href="/vendor/offers" class="btn btn-secondary btn-sm">إدارة العروض</a>
				</div>
				if len(data.Offers) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد عروض نشطة.</p>
				} else {
					for _, o := range data.Offers {
						<div style="display:flex; justify-content:space-between; align-items:center; padding:0.65rem 0; border-bottom:1px solid var(--neutral-100);">
							<div>
								<div style="font-weight:700; color:var(--neutral-900);">{ o.Title.Get(i18n.Lang(lang)) }</div>
								<div style="font-size:0.8rem; color:var(--neutral-500);">مشاهدة { fmt.Sprintf("%d", o.ViewsCount) } · نقر { fmt.Sprintf("%d", o.ClicksCount) }</div>
							</div>
						</div>
					}
				}
			</div>

			<div class="card">
				<h2 class="card-title" style="margin:0 0 0.75rem;">طلبات التسعير</h2>
				if data.UnreadQuotes == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد طلبات تسعير غير مقروءة.</p>
				} else {
					<p style="font-weight:800; color:var(--primary-700); font-size:1.1rem;">{ fmt.Sprintf("%d", data.UnreadQuotes) } طلب تسعير بانتظار الرد</p>
					<a href="/vendor/orders" class="btn btn-secondary btn-sm">مراجعة الطلبات</a>
				}
			</div>
		</div>
	}

		for _, s := range data.Shipments {
			@components.Modal(components.ModalProps{ ID: fmt.Sprintf("dispatch-%d", s.ID), Title: "تنفيذ الشحنة", Size: "sm" }) {
				<form method="POST" action={ fmt.Sprintf("/vendor/orders/%d/status", s.ID) } class="stack">
					<input type="hidden" name="status" value="shipped" />
					<div class="form-group mb-0">
						<label class="form-label" for={ fmt.Sprintf("c-%d", s.ID) }>شركة الشحن</label>
						<input type="text" id={ fmt.Sprintf("c-%d", s.ID) } name="carrier" class="form-input" placeholder="ARAMEX" />
					</div>
					<div class="form-group mb-0">
						<label class="form-label" for={ fmt.Sprintf("t-%d", s.ID) }>رقم التتبع</label>
						<input type="text" id={ fmt.Sprintf("t-%d", s.ID) } name="tracking" class="form-input tabular-nums" dir="ltr" />
					</div>
					<button type="submit" class="btn btn-primary" style="justify-content:center;">تأكيد الشحن</button>
				</form>
			}
		}
}
