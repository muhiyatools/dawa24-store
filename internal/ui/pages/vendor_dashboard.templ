package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorDashboard(lang, dir string, data VendorDashboardData) {
	@layouts.VendorShell("لوحة التحكم", "dashboard", lang, dir) {
		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
			<div class="card hover-lift" style="margin-bottom:0;">
				<span style="font-size:0.8rem; color:var(--neutral-500); font-weight:600;">المنتجات النشطة</span>
				<div style="font-size:1.9rem; font-weight:900; color:var(--primary-700); margin-top:0.6rem;" class="tabular-nums">{ fmt.Sprintf("%d", data.ActiveProducts) }</div>
			</div>
			<div class="card hover-lift" style="margin-bottom:0;">
				<span style="font-size:0.8rem; color:var(--neutral-500); font-weight:600;">طلبات قيد التنفيذ</span>
				<div style="font-size:1.9rem; font-weight:900; color:var(--warning); margin-top:0.6rem;" class="tabular-nums">{ fmt.Sprintf("%d", data.PendingShipments) }</div>
			</div>
			<div class="card hover-lift" style="margin-bottom:0;">
				<span style="font-size:0.8rem; color:var(--neutral-500); font-weight:600;">مبيعات الشهر</span>
				<div style="font-size:1.4rem; font-weight:900; color:var(--neutral-900); margin-top:0.6rem;" class="tabular-nums">@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.MonthSales })</div>
			</div>
			if data.HasWallet {
				<div class="card hover-lift" style="margin-bottom:0;">
					<span style="font-size:0.8rem; color:var(--neutral-500); font-weight:600;">رصيد المحفظة</span>
					<div style="font-size:1.4rem; font-weight:900; color:var(--info); margin-top:0.6rem;" class="tabular-nums">@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.WalletBalance })</div>
				</div>
			}
			<div class="card hover-lift" style="margin-bottom:0;">
				<span style="font-size:0.8rem; color:var(--neutral-500); font-weight:600;">أصناف تحت الحد الأدنى</span>
				<div style="font-size:1.9rem; font-weight:900; color:var(--danger); margin-top:0.6rem;" class="tabular-nums">{ fmt.Sprintf("%d", data.LowStockCount) }</div>
			</div>
		</div>

		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(360px, 1fr)); gap:1.25rem;">
			<div class="card">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
					<h2 class="card-title" style="margin:0;">شحنات بانتظار التنفيذ</h2>
					<a href="/vendor/orders" class="btn btn-secondary btn-sm">عرض الكل</a>
				</div>
				if len(data.Shipments) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد شحنات معلّقة حالياً.</p>
				} else {
					<div class="table-container">
						<table class="data-table">
							<thead><tr><th>الشحنة</th><th>الإجمالي</th><th></th></tr></thead>
							<tbody>
								for _, s := range data.Shipments {
									<tr>
										<td>{ s.ShipmentNumber }</td>
										<td>@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: s.TotalAmount })</td>
										<td>
											<form method="POST" action={ fmt.Sprintf("/vendor/orders/%d/status", s.ID) } style="margin:0;">
												<input type="hidden" name="status" value="processing" />
												<button type="submit" class="btn btn-primary btn-sm">تنفيذ</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<div class="card">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
					<h2 class="card-title" style="margin:0;">أصناف تحت الحد الأدنى</h2>
					<a href="/vendor/inventory" class="btn btn-secondary btn-sm">الأرصدة</a>
				</div>
				if len(data.LowStock) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">جميع الأرصدة فوق حد إعادة الطلب.</p>
				} else {
					<div class="table-container">
						<table class="data-table">
							<thead><tr><th>الصنف</th><th>الكمية</th><th>الحد</th></tr></thead>
							<tbody>
								for _, s := range data.LowStock {
									<tr>
										<td>صنف #{ fmt.Sprintf("%d", s.ProductID) }</td>
										<td class="tabular-nums">{ fmt.Sprintf("%d", s.Quantity) }</td>
										<td class="tabular-nums">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<div class="card">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
					<h2 class="card-title" style="margin:0;">العروض النشطة</h2>
					<a href="/vendor/offers" class="btn btn-secondary btn-sm">إدارة العروض</a>
				</div>
				if len(data.Offers) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد عروض نشطة.</p>
				} else {
					for _, o := range data.Offers {
						<div style="display:flex; justify-content:space-between; align-items:center; padding:0.65rem 0; border-bottom:1px solid var(--neutral-100);">
							<div>
								<div style="font-weight:700; color:var(--neutral-900);">{ o.Title.Get(i18n.Lang(lang)) }</div>
								<div style="font-size:0.8rem; color:var(--neutral-500);">مشاهدة { fmt.Sprintf("%d", o.ViewsCount) } · نقر { fmt.Sprintf("%d", o.ClicksCount) }</div>
							</div>
						</div>
					}
				}
			</div>

			<div class="card">
				<h2 class="card-title" style="margin:0 0 0.75rem;">طلبات التسعير</h2>
				if data.UnreadQuotes == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد طلبات تسعير غير مقروءة.</p>
				} else {
					<p style="font-weight:800; color:var(--primary-700); font-size:1.1rem;">{ fmt.Sprintf("%d", data.UnreadQuotes) } طلب تسعير بانتظار الرد</p>
					<a href="/vendor/orders" class="btn btn-secondary btn-sm">مراجعة الطلبات</a>
				}
			</div>
		</div>
	}
}
