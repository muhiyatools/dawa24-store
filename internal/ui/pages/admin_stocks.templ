package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminStocksPage renders inventory stocks across warehouses.
templ AdminStocksPage(stocks []*inventory.Stock, lang, dir string) {
	@layouts.AdminShell("إدارة الأرصدة والمخزون الحي", "stocks", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconBarChart("icon-sm")
						</div>
      <div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">أرصدة المخزون بالمنشآت والمخازن ({ fmt.Sprintf("%d", len(stocks)) })</h1>
							<p class="text-sm text-secondary m-0 mt-1">متابعة أرصدة المخزون الحي وحدود الأمان بالمستودعات</p>
						</div>
					</div>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(stocks) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconBarChart("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد أصناف موردين مسجلة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يقم الموردون بتسجيل أصناف أو عروض توريد مطابقة لبحثك بعد.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>#</th>
									<th>المورد</th>
									<th>المورد</th>
									<th>المورد</th>
									<th>المورد</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range stocks {
									<tr>
										<td class="tabular-nums font-bold text-brand">#{ fmt.Sprintf("%d", s.ID) }</td>
										<td>منشأة #{ fmt.Sprintf("%d", s.OrganizationID) }</td>
										<td>مخزن #{ fmt.Sprintf("%d", s.WarehouseID) }</td>
										<td class="tabular-nums font-bold text-primary">{ fmt.Sprintf("%d", s.Quantity) }</td>
										<td class="tabular-nums text-muted">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
