package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerSavingPageData struct {
	Items        []*catalog.SavingProductEnriched
	Stats        *catalog.SavingProductStats
	SearchQuery  string
	FilterStatus string
	NoticeType   string
	NoticeMsg    string
}

// CustomerSavingProductsPage renders customer saving products workspace and best supplier price delta tracker.
templ CustomerSavingProductsPage(data CustomerSavingPageData, lang, dir string) {
	@layouts.CustomerShell("منتجات التوفير وتتبع فروق الأسعار للصيدلية", "saving_products", lang, dir, nil) {
		<div style="max-width:1440px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem;">

			<!-- Notice / Toast Banner -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger" style="display:flex; align-items:center; justify-content:space-between; padding:1.15rem 1.5rem; border-radius:var(--radius-xl); background:rgba(239, 68, 68, 0.12); border:1px solid rgba(239, 68, 68, 0.35); color:#ef4444; box-shadow:0 10px 25px rgba(0,0,0,0.15);">
						<div style="display:flex; align-items:center; gap:0.75rem; font-weight:800; font-size:0.95rem;">
							<span class="text-2xl">⚠️</span>
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success" style="display:flex; align-items:center; justify-content:space-between; padding:1.15rem 1.5rem; border-radius:var(--radius-xl); background:rgba(16, 185, 129, 0.12); border:1px solid rgba(16, 185, 129, 0.35); color:#10b981; box-shadow:0 10px 25px rgba(0,0,0,0.15);">
						<div style="display:flex; align-items:center; gap:0.75rem; font-weight:800; font-size:0.95rem;">
							<span class="text-2xl">✅</span>
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				}
			}

			<!-- Top Header Banner -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; margin-bottom:0;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div style="display:flex; align-items:center; gap:1rem;">
						<div style="width:54px; height:54px; border-radius:var(--radius-xl); background:linear-gradient(135deg, #10b981 0%, #06b6d4 100%); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.75rem; box-shadow:0 8px 20px rgba(16,185,129,0.25);">
							💊
						</div>
						<div>
							<h1 style="font-size:1.65rem; font-weight:900; color:var(--text); margin:0;">
								منتجات وأدوية التوفير للصيدلية
							</h1>
							<p style="color:var(--text-muted); font-size:0.875rem; margin:0.25rem 0 0 0;">
								تتبع أدوية الصيدلية ومقارنة عروض وخصومات الموردين المتاحة بالكتالوج بالأسعار الحية
							</p>
						</div>
					</div>

					<!-- Top Action Buttons -->
					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<button
							type="button"
							class="btn btn-primary"
							data-modal-open="pharmacy-saving-product-modal"
							style="background:#10b981; border-color:#10b981; color:#fff; font-weight:800; font-size:0.9rem; padding:0.65rem 1.25rem; border-radius:var(--radius-lg);"
							onclick="openPharmacyCreateModal()"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة صنف توفير جديد</span>
						</button>

						<button
							type="button"
							class="btn btn-secondary"
							data-modal-open="pharmacy-saving-import-modal"
							style="font-weight:800; font-size:0.9rem; padding:0.65rem 1.25rem; border-radius:var(--radius-lg);"
							onclick="openPharmacyImportModal()"
						>
							@components.IconUpload("icon-xs")
							<span>استيراد قائمة الأدوية (Excel / CSV)</span>
						</button>

						<a
							href="/customer/saving-products/export"
							class="btn btn-secondary"
							style="background:#0f766e; border-color:#0f766e; color:#fff; font-weight:800; font-size:0.9rem; padding:0.65rem 1.25rem; border-radius:var(--radius-lg); text-decoration:none;"
							download
						>
							@components.IconDownload("icon-xs")
							<span>تصدير Excel 📊</span>
						</a>
					</div>
				</div>
			</div>

			<!-- 3 Status Metric Cards -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.25rem;">
				<a
					href="/customer/saving-products?filter=all"
					class="card"
					style={ fmt.Sprintf("padding:1.5rem; margin:0; text-decoration:none; background:var(--surface-raised); border:2px solid %s; border-radius:var(--radius-2xl); display:flex; justify-content:space-between; align-items:center; transition:transform 0.2s;", savingFilterBorder(data.FilterStatus, "all")) }
				>
					<div>
						<div style="font-size:0.875rem; font-weight:700; color:var(--text-muted); margin-bottom:0.35rem;">
							جميع الأصناف المسجلة
						</div>
						<div style="font-size:2.2rem; font-weight:900; color:var(--text);" class="tabular-nums">
							if data.Stats != nil {
								{ fmt.Sprintf("%d", data.Stats.CountAll) }
							} else {
								0
							}
						</div>
					</div>
					<div style="width:48px; height:48px; border-radius:var(--radius-xl); background:rgba(16, 185, 129, 0.12); color:#10b981; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
						📋
					</div>
				</a>

				<a
					href="/customer/saving-products?filter=linked"
					class="card"
					style={ fmt.Sprintf("padding:1.5rem; margin:0; text-decoration:none; background:var(--surface-raised); border:2px solid %s; border-radius:var(--radius-2xl); display:flex; justify-content:space-between; align-items:center; transition:transform 0.2s;", savingFilterBorder(data.FilterStatus, "linked")) }
				>
					<div>
						<div style="font-size:0.875rem; font-weight:700; color:var(--text-muted); margin-bottom:0.35rem;">
							أصناف مرتبطة بالكتالوج
						</div>
						<div style="font-size:2.2rem; font-weight:900; color:#38bdf8;" class="tabular-nums">
							if data.Stats != nil {
								{ fmt.Sprintf("%d", data.Stats.CountLinked) }
							} else {
								0
							}
						</div>
					</div>
					<div style="width:48px; height:48px; border-radius:var(--radius-xl); background:rgba(56, 189, 248, 0.12); color:#38bdf8; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
						🔗
					</div>
				</a>

				<a
					href="/customer/saving-products?filter=unlinked"
					class="card"
					style={ fmt.Sprintf("padding:1.5rem; margin:0; text-decoration:none; background:var(--surface-raised); border:2px solid %s; border-radius:var(--radius-2xl); display:flex; justify-content:space-between; align-items:center; transition:transform 0.2s;", savingFilterBorder(data.FilterStatus, "unlinked")) }
				>
					<div>
						<div style="font-size:0.875rem; font-weight:700; color:var(--text-muted); margin-bottom:0.35rem;">
							أصناف بحاجة إلى ربط
						</div>
						<div style="font-size:2.2rem; font-weight:900; color:#f59e0b;" class="tabular-nums">
							if data.Stats != nil {
								{ fmt.Sprintf("%d", data.Stats.CountUnlinked) }
							} else {
								0
							}
						</div>
					</div>
					<div style="width:48px; height:48px; border-radius:var(--radius-xl); background:rgba(245, 158, 11, 0.12); color:#f59e0b; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
						⚠️
					</div>
				</a>
			</div>

			<!-- Search Filter Bar -->
			<div class="card" style="padding:1rem 1.5rem; margin-bottom:0; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div style="flex:1; min-width:280px; max-width:500px; position:relative;">
					<input
						type="text"
						id="pharmacy-saving-search-input"
						value={ data.SearchQuery }
						placeholder="ابحث باسم الدواء، الكود SKU، أو اسم الصنف بالكتالوج..."
						class="form-input"
						style="padding-inline-start:2.5rem; width:100%; border-radius:var(--radius-lg);"
						oninput="filterPharmacySavingTable(this.value)"
					/>
					<div style="position:absolute; inset-inline-start:0.85rem; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
						@components.IconSearch("icon-xs")
					</div>
				</div>

				<div class="row-center-sm">
					<span style="font-size:0.85rem; font-weight:700; color:var(--text-muted);">
						عرض: { fmt.Sprintf("%d", len(data.Items)) } صنف
					</span>
				</div>
			</div>

			<!-- Saving Products Table Card -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:0; overflow:hidden;">
				if len(data.Items) == 0 {
					<div style="padding:4rem 2rem; text-align:center;">
						<div style="font-size:3.5rem; margin-bottom:1rem;">📦</div>
						<h3 style="font-size:1.35rem; font-weight:800; color:var(--text); margin:0 0 0.5rem 0;">
							لا توجد أصناف مسجلة في قائمة التوفير حالياً
						</h3>
						<p style="color:var(--text-muted); max-width:520px; margin:0 auto 1.5rem auto; font-size:0.9rem; line-height:1.6;">
							أضف أدويتك الأكثر استهلاكاً أو ارفع ملف Excel لمتابعة خصومات الموردين واقتناص أفضل الأسعار.
						</p>
						<div style="display:flex; justify-content:center; gap:0.75rem; flex-wrap:wrap;">
							<button type="button" class="btn btn-primary fw-800" onclick="openPharmacyCreateModal()">
								@components.IconPlus("icon-xs")
								<span>إضافة صنف جديد</span>
							</button>
							<button type="button" class="btn btn-secondary fw-800" onclick="openPharmacyImportModal()">
								@components.IconUpload("icon-xs")
								<span>استيراد ملف Excel</span>
							</button>
						</div>
					</div>
				} else {
					<div class="table-container" style="margin:0; overflow-x:auto;">
						<table class="b2b-table" style="width:100%; border-collapse:collapse;">
							<thead>
								<tr style="background:var(--surface-sunken); border-bottom:2px solid var(--border); text-align:start; font-size:0.8rem; color:var(--text-muted);">
									<th class="p-card-sm">اسم الصنف للصيدلية</th>
									<th class="p-md">الربط بالكتالوج العام</th>
									<th class="p-md text-center">الكمية</th>
									<th class="p-md text-center">سعر الشراء</th>
									<th class="p-md text-center">عروض الموردين</th>
									<th style="padding:1rem 1.25rem; text-align:center;">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, it := range data.Items {
									<tr
										class="pharmacy-saving-row"
										data-id={ fmt.Sprintf("%d", it.ID) }
										data-name={ it.NameProduct }
										data-sku={ it.SKU }
										data-qty={ fmt.Sprintf("%v", it.Quantity) }
										data-price={ it.Price.String() }
										data-product-id={ savingProductIDStr(it.ProductID) }
										data-product-name={ it.LinkedProductName.Get(i18n.AR) }
										style="border-bottom:1px solid var(--border); transition:background 0.15s;"
									>
										<!-- Name & SKU -->
										<td class="p-card-sm">
											<div class="fw-800 text-primary text-base">
												{ it.NameProduct }
											</div>
											if it.SKU != "" {
												<div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">
													<code>{ it.SKU }</code>
												</div>
											}
										</td>

										<!-- Linked Product -->
										<td class="p-md">
											if it.ProductID != nil && *it.ProductID > 0 {
												<div class="row-center-sm">
													<span class="badge badge-emerald text-xs fw-800">
														🔗 { it.LinkedProductName.Get(i18n.AR) }
													</span>
													<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", *it.ProductID)) } target="_blank" class="btn btn-secondary btn-icon" style="width:26px; height:26px;" title="عرض بالكتالوج">
														@components.IconEye("icon-xs")
													</a>
												</div>
											} else {
												<span class="badge badge-amber text-xs fw-700">
													غير مرتبط
												</span>
											}
										</td>

										<!-- Quantity -->
										<td class="p-md text-center tabular-nums">
											<strong>{ fmt.Sprintf("%v", it.Quantity) }</strong>
										</td>

										<!-- Price -->
										<td class="p-md text-center tabular-nums">
											<strong class="text-primary">{ it.Price.String() } ج.م</strong>
										</td>

										<!-- Providers & Market Offers -->
										<td class="p-md text-center">
											if it.ProductID != nil && *it.ProductID > 0 {
												<button
													type="button"
													class="btn btn-secondary btn-sm"
													style="font-size:0.78rem; font-weight:800; gap:0.35rem; color:var(--accent); cursor:pointer;"
													data-open-providers-id={ fmt.Sprintf("%d", *it.ProductID) }
													data-open-providers-name={ it.NameProduct }
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openPharmacyProvidersModal(%d, %q)", *it.ProductID, it.NameProduct)} }
												>
													<span>{ fmt.Sprintf("%d موردين", it.ProvidingOrgsCount) }</span>
												</button>
											} else {
												<span class="text-xs text-muted">-</span>
											}
										</td>

										<!-- Actions -->
										<td style="padding:1rem 1.25rem; text-align:center;">
											<div style="display:flex; align-items:center; justify-content:center; gap:0.4rem;">
												<button
													type="button"
													class="btn btn-secondary btn-icon size-8"
													title="تعديل الصنف والربط"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openPharmacyEditModalFromRow(%d)", it.ID)} }
												>
													@components.IconEdit("icon-xs")
												</button>
												<button
													type="button"
													class="btn btn-secondary btn-icon"
													style="width:32px; height:32px; color:var(--danger-text);"
													title="حذف من قائمة التوفير"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("confirmPharmacyDeleteSavingProduct(%d)", it.ID)} }
												>
													@components.IconTrash("icon-xs")
												</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>

		<!-- MODAL 1: Create / Edit Saving Product Modal -->
		<div id="pharmacy-saving-product-modal" class="modal-overlay hidden">
			<div class="card" style="max-width:620px; width:100%; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
				<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.25rem;">
					<h3 id="pharmacy-modal-title" class="text-xl fw-900 text-primary m-0">
						إضافة صنف توفير جديد
					</h3>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closePharmacyCreateModal()">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<form method="POST" id="pharmacy-saving-product-form" action="/customer/saving-products">
					<input type="hidden" id="pharmacy-form-saving-id" name="id" value="" />
					
					<div class="stack-md">
						<div>
							<label class="form-label text-sm fw-700 text-primary">
								اسم الصنف الدوائي بالصيدلية <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								id="pharmacy-form-name-product"
								name="name_product"
								required
								placeholder="مثال: أوجمنتين 1 جم 14 قرص"
								class="form-input"
								style="width:100%; border-radius:var(--radius-lg);"
							/>
						</div>

						<div class="grid-2">
							<div>
								<label class="form-label text-sm fw-700 text-primary">
									رمز SKU (اختياري)
								</label>
								<input
									type="text"
									id="pharmacy-form-sku"
									name="sku"
									placeholder="كود الصنف..."
									class="form-input"
									style="width:100%; border-radius:var(--radius-lg);"
								/>
							</div>

							<div>
								<label class="form-label text-sm fw-700 text-primary">
									الكمية المطلوبة
								</label>
								<input
									type="number"
									step="any"
									id="pharmacy-form-qty"
									name="qty"
									placeholder="0"
									class="form-input"
									style="width:100%; border-radius:var(--radius-lg);"
								/>
							</div>
						</div>

						<div>
							<label class="form-label text-sm fw-700 text-primary">
								سعر الشراء الحالي / المستهدف (ج.م)
							</label>
							<input
								type="number"
								step="0.01"
								id="pharmacy-form-price"
								name="price"
								placeholder="0.00"
								class="form-input"
								style="width:100%; border-radius:var(--radius-lg);"
							/>
						</div>

						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; flex-direction:column; gap:0.5rem;">
							<label style="font-weight:800; color:var(--text); font-size:0.875rem;">
								🔗 ربط الصنف بالكتالوج المركزي العام
							</label>
							
							<input type="hidden" id="pharmacy-form-product-id" name="product_id" value="" />
							
							<div id="pharmacy-selected-product-box" style="display:none; justify-content:space-between; align-items:center; background:var(--surface-raised); padding:0.6rem 0.85rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
								<span id="pharmacy-selected-product-label" style="font-weight:800; color:var(--accent); font-size:0.9rem;"></span>
								<button type="button" class="btn btn-secondary btn-sm" onclick="clearPharmacySelectedProduct()" style="font-size:0.75rem; color:var(--danger-text);">
									إلغاء الربط ✕
								</button>
							</div>

							<div id="pharmacy-search-product-container" style="position:relative;">
								<input
									type="text"
									id="pharmacy-product-search-input"
									placeholder="ابحث بالاسم أو SKU لربط الصنف بالكتالوج..."
									class="form-input"
									style="width:100%; border-radius:var(--radius-lg); font-size:0.85rem;"
									oninput="searchPharmacyCatalogProductsLive(this.value)"
								/>
								<div id="pharmacy-product-search-dropdown" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:100; max-height:200px; overflow-y:auto; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); box-shadow:0 10px 25px rgba(0,0,0,0.3); margin-top:0.25rem;"></div>
							</div>
						</div>
					</div>

					<div class="modal-footer-standard">
						<button type="button" class="btn btn-secondary" onclick="closePharmacyCreateModal()">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.6rem 1.5rem;">
							حفظ وتثبيت البيانات
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- MODAL 2: Bulk Import Modal -->
		<div id="pharmacy-saving-import-modal" class="modal-overlay hidden">
			<div class="card" style="max-width:600px; width:100%; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
				<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.25rem;">
					<div class="row-center-sm">
						<span class="text-2xl">📥</span>
						<h3 class="text-xl fw-900 text-primary m-0">
							استيراد ملف أدوية التوفير (Excel / CSV)
						</h3>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closePharmacyImportModal()">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<form method="POST" action="/customer/saving-products/import" enctype="multipart/form-data" onsubmit="return handlePharmacyImportSubmit(event)">
					<div class="stack-lg">
						<div
							id="pharmacy-import-dropzone"
							style="border:2px dashed var(--accent); background:var(--surface-sunken); border-radius:var(--radius-xl); padding:2rem 1rem; text-align:center; cursor:pointer;"
							onclick="document.getElementById('pharmacy-import-file-input').click()"
						>
							<div style="font-size:2.8rem; margin-bottom:0.5rem;">📊</div>
							<strong style="color:var(--text); font-size:1rem; display:block; margin-bottom:0.25rem;">
								انقر هنا لاختيار الملف أو اسحبه هنا
							</strong>
							<p class="text-sm text-muted m-0">
								يدعم ملفات Excel (.xlsx, .xls) وكشوف CSV (.csv) بحد أقصى 10 ميجابايت
							</p>
							<div id="pharmacy-import-filename-preview" style="margin-top:0.75rem; font-weight:800; color:var(--accent); font-size:0.85rem;"></div>

							<input
								type="file"
								id="pharmacy-import-file-input"
								name="file"
								accept=".xlsx,.xls,.csv"
								required
								style="display:none;"
								onchange="handlePharmacyImportFileSelect(this)"
							/>
						</div>

						<div style="font-size:0.8rem; color:var(--text-muted); line-height:1.5; background:rgba(56, 189, 248, 0.08); border:1px solid rgba(56, 189, 248, 0.2); padding:0.75rem 1rem; border-radius:var(--radius-lg);">
							ℹ️ <strong>المطابقة الذكية:</strong> سيتم مطابقة الأدوية تلقائياً مع الكتالوج المركزي لتوفير مقارنة أسعار فورية مع عروض الموردين.
						</div>
					</div>

					<div class="modal-footer-standard">
						<button type="button" class="btn btn-secondary" onclick="closePharmacyImportModal()">
							إلغاء
						</button>
						<button type="submit" id="pharmacy-import-btn" class="btn btn-primary" style="font-weight:800; padding:0.6rem 1.5rem;">
							بدء الاستيراد الذكي 🚀
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- MODAL 3: Providing Organizations & Offers Modal -->
		<div id="pharmacy-providers-modal" class="modal-overlay hidden">
			<div class="card" style="max-width:860px; width:100%; max-height:85vh; overflow-y:auto; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.25rem;">
					<div>
						<h3 id="pharmacy-providers-modal-title" class="text-xl fw-900 text-primary m-0">
							عروض الموردين المتاحة بالكتالوج
						</h3>
						<p id="pharmacy-providers-modal-subtitle" style="color:var(--text-muted); font-size:0.85rem; margin:0.25rem 0 0 0;"></p>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closePharmacyProvidersModal()">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<div id="pharmacy-providers-modal-content">
					<div style="padding:2rem; text-align:center; color:var(--text-muted);">
						⏳ جاري استرجاع عروض الموردين والأسعار المتاحة...
					</div>
				</div>
			</div>
		</div>

		<script>
			function openPharmacyCreateModal() {
				document.getElementById('pharmacy-modal-title').textContent = 'إضافة صنف توفير جديد';
				document.getElementById('pharmacy-saving-product-form').action = '/customer/saving-products';
				document.getElementById('pharmacy-form-saving-id').value = '';
				document.getElementById('pharmacy-form-name-product').value = '';
				document.getElementById('pharmacy-form-sku').value = '';
				document.getElementById('pharmacy-form-qty').value = '';
				document.getElementById('pharmacy-form-price').value = '';
				clearPharmacySelectedProduct();
				if (window.openModal) {
					window.openModal('pharmacy-saving-product-modal');
				} else {
					const el = document.getElementById('pharmacy-saving-product-modal');
					if (el) {
						el.classList.remove('hidden');
						el.style.display = 'flex';
					}
				}
			}

			function openPharmacyEditModalFromRow(id) {
				const row = document.querySelector(`.pharmacy-saving-row[data-id="${id}"]`);
				if (!row) return;

				document.getElementById('pharmacy-modal-title').textContent = 'تعديل صنف التوفير وتعيين الربط';
				document.getElementById('pharmacy-saving-product-form').action = `/customer/saving-products/${id}/update`;
				document.getElementById('pharmacy-form-saving-id').value = id;
				document.getElementById('pharmacy-form-name-product').value = row.dataset.name || '';
				document.getElementById('pharmacy-form-sku').value = row.dataset.sku || '';
				document.getElementById('pharmacy-form-qty').value = row.dataset.qty || '';
				document.getElementById('pharmacy-form-price').value = row.dataset.price || '';

				const prodId = row.dataset.productId;
				const prodName = row.dataset.productName;
				if (prodId && prodId !== '') {
					selectPharmacyCatalogProduct(prodId, prodName);
				} else {
					clearPharmacySelectedProduct();
				}

				if (window.openModal) {
					window.openModal('pharmacy-saving-product-modal');
				} else {
					const el = document.getElementById('pharmacy-saving-product-modal');
					if (el) {
						el.classList.remove('hidden');
						el.style.display = 'flex';
					}
				}
			}

			function closePharmacyCreateModal() {
				if (window.closeModal) {
					window.closeModal('pharmacy-saving-product-modal');
				} else {
					const el = document.getElementById('pharmacy-saving-product-modal');
					if (el) {
						el.classList.add('hidden');
						el.style.display = 'none';
					}
				}
			}

			function selectPharmacyCatalogProduct(id, name) {
				document.getElementById('pharmacy-form-product-id').value = id;
				document.getElementById('pharmacy-selected-product-label').textContent = `🔗 ${name}`;
				document.getElementById('pharmacy-selected-product-box').style.display = 'flex';
				document.getElementById('pharmacy-search-product-container').style.display = 'none';
				document.getElementById('pharmacy-product-search-dropdown').style.display = 'none';
				document.getElementById('pharmacy-product-search-input').value = '';
			}

			function clearPharmacySelectedProduct() {
				document.getElementById('pharmacy-form-product-id').value = '';
				document.getElementById('pharmacy-selected-product-label').textContent = '';
				document.getElementById('pharmacy-selected-product-box').style.display = 'none';
				document.getElementById('pharmacy-search-product-container').style.display = 'block';
			}

			let pharmacySearchDebounce = null;
			function searchPharmacyCatalogProductsLive(query) {
				clearTimeout(pharmacySearchDebounce);
				const dropdown = document.getElementById('pharmacy-product-search-dropdown');
				if (!query || query.trim().length < 2) {
					dropdown.style.display = 'none';
					return;
				}

				pharmacySearchDebounce = setTimeout(() => {
					fetch('/customer/saving-products/search-products?q=' + encodeURIComponent(query.trim()))
						.then(r => r.json())
						.then(items => {
							if (!items || items.length === 0) {
								dropdown.innerHTML = '<div style="padding:0.75rem 1rem; color:var(--text-muted); font-size:0.8rem; text-align:center;">لم يتم العثور على نتائج بالكتالوج</div>';
								dropdown.style.display = 'block';
								return;
							}

							let html = '';
							items.forEach(it => {
								const skuText = it.sku ? ('<span style="font-size:0.75rem; color:var(--text-muted); margin-inline-start:0.5rem;">(' + it.sku + ')</span>') : '';
								const safeName = (it.name || '').replace(/'/g, "\\'");
								html += '<div style="padding:0.6rem 0.85rem; border-bottom:1px solid var(--border); cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition:background 0.15s;" ' +
									'onmouseover="this.style.background=\'var(--surface-sunken)\'" onmouseout="this.style.background=\'\'" ' +
									'onclick="selectPharmacyCatalogProduct(\'' + it.id + '\', \'' + safeName + '\')">' +
									'<div><strong style="color:var(--text); font-size:0.85rem;">' + it.name + '</strong>' + skuText + '</div>' +
									'<span class="badge badge-emerald text-xs">اختيار</span></div>';
							});
							dropdown.innerHTML = html;
							dropdown.style.display = 'block';
						})
						.catch(() => {
							dropdown.style.display = 'none';
						});
				}, 200);
			}

			function confirmPharmacyDeleteSavingProduct(id) {
				if (confirm("هل أنت متأكد من حذف هذا الصنف من قائمة أدوية التوفير؟")) {
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = '/customer/saving-products/' + id + '/delete';
					document.body.appendChild(form);
					form.submit();
				}
			}

			function openPharmacyImportModal() {
				document.getElementById('pharmacy-import-filename-preview').innerHTML = '';
				document.getElementById('pharmacy-import-file-input').value = '';
				if (window.openModal) {
					window.openModal('pharmacy-saving-import-modal');
				} else {
					const el = document.getElementById('pharmacy-saving-import-modal');
					if (el) {
						el.classList.remove('hidden');
						el.style.display = 'flex';
					}
				}
			}

			function closePharmacyImportModal() {
				if (window.closeModal) {
					window.closeModal('pharmacy-saving-import-modal');
				} else {
					const el = document.getElementById('pharmacy-saving-import-modal');
					if (el) {
						el.classList.add('hidden');
						el.style.display = 'none';
					}
				}
			}

			function handlePharmacyImportFileSelect(input) {
				if (input.files && input.files[0]) {
					const f = input.files[0];
					const size = (f.size / 1024 / 1024).toFixed(2);
					document.getElementById('pharmacy-import-filename-preview').innerHTML = '✓ تم اختيار: ' + f.name + ' (' + size + ' MB)';
				}
			}

			function handlePharmacyImportSubmit(e) {
				const input = document.getElementById('pharmacy-import-file-input');
				if (!input.files || input.files.length === 0) {
					alert("يرجى اختيار ملف Excel أو CSV أولاً.");
					e.preventDefault();
					return false;
				}
				const btn = document.getElementById('pharmacy-import-btn');
				btn.disabled = true;
				btn.textContent = '⏳ جاري قراءة الملف والمطابقة الذكية...';
				return true;
			}

			function openPharmacyProvidersModal(productId, productName) {
				const subtitleEl = document.getElementById('pharmacy-providers-modal-subtitle');
				if (subtitleEl) subtitleEl.textContent = 'الصنف: ' + productName;
				const contentEl = document.getElementById('pharmacy-providers-modal-content');
				if (contentEl) contentEl.innerHTML = '<div style="padding:2rem; text-align:center; color:var(--text-muted);">⏳ جاري استرجاع عروض الموردين والأسعار...</div>';
				
				const modalEl = document.getElementById('pharmacy-providers-modal');
				if (modalEl) {
					modalEl.classList.remove('hidden');
					modalEl.style.display = 'flex';
				}
				if (window.openModal) {
					window.openModal('pharmacy-providers-modal');
				}

				fetch('/customer/saving-products/providers/' + productId)
					.then(r => r.json())
					.then(providers => {
						if (!providers || providers.length === 0) {
							if (contentEl) contentEl.innerHTML = '<div style="padding:2.5rem; text-align:center; color:var(--text-muted); font-size:0.9rem;">لا توجد عروض موردين مسجلة لهذا الصنف حالياً في الكتالوج.<br><a href="/catalog" class="btn btn-secondary btn-sm" style="margin-top:1rem;">تصفح كتالوج الأدوية العام</a></div>';
							return;
						}

						let html = '<div style="overflow-x:auto;"><table class="table" style="width:100%; border-collapse:collapse; font-size:0.875rem;"><thead><tr style="background:var(--surface-sunken); border-bottom:2px solid var(--border); text-align:start; font-size:0.775rem; color:var(--text-muted);"><th class="p-sm">المورد / المستودع</th><th class="p-sm">العبوة / المواصفات</th><th class="p-sm text-center">المخزون</th><th class="p-sm text-center">السعر الأساسي</th><th class="p-sm text-center">الخصم</th><th style="padding:0.75rem; text-align:end;">السعر الصافي</th><th class="p-sm text-center">طلب توريد</th></tr></thead><tbody>';

						providers.forEach(p => {
							const branchText = p.branch_name ? ('<div style="font-size:0.725rem; color:var(--text-muted); margin-top:2px;">' + p.branch_name + '</div>') : '';
							const skuText = p.sku ? ('<code class="text-xs">' + p.sku + '</code>') : '';
							const stockBadge = p.stock_quantity > 0 ? 'badge-emerald' : 'badge-secondary';
							const orgDisplayName = (typeof p.org_name === 'object' && p.org_name) ? (p.org_name.ar || p.org_name.en || 'مورد معتمد') : (p.org_name || 'مورد معتمد');
							const varDisplayName = (typeof p.variant_name === 'object' && p.variant_name) ? (p.variant_name.ar || p.variant_name.en || 'العبوة القياسية') : (p.variant_name || 'العبوة القياسية');
							
							const addCartAction = (p.stock_quantity > 0 && p.variant_id) ?
								('<form method="POST" action="/cart/add" style="margin:0; display:inline-flex; gap:0.25rem;">' +
									'<input type="hidden" name="variant_id" value="' + p.variant_id + '" />' +
									'<input type="hidden" name="product_id" value="' + productId + '" />' +
									'<input type="hidden" name="organization_id" value="' + (p.organization_id || '') + '" />' +
									'<input type="hidden" name="vendor_org_id" value="' + (p.organization_id || '') + '" />' +
									'<input type="hidden" name="offer_price" value="' + (p.price_after_discount || p.price) + '" />' +
									'<input type="hidden" name="qty" value="1" />' +
									'<button type="submit" class="btn btn-primary btn-sm" style="font-size:0.75rem; font-weight:800; padding:0.25rem 0.65rem;">+ أضف للسلة</button>' +
								'</form>') :
								'<span class="text-xs text-muted">غير متوفر</span>';

							html += '<tr style="border-bottom:1px solid var(--border);">' +
								'<td class="p-sm"><strong style="color:var(--text); font-size:0.875rem;">' + orgDisplayName + '</strong>' + branchText + '</td>' +
								'<td class="p-sm"><div>' + varDisplayName + '</div>' + skuText + '</td>' +
								'<td class="p-sm text-center tabular-nums"><span class="badge ' + stockBadge + '">' + p.stock_quantity + ' عبوة</span></td>' +
								'<td class="p-sm text-center tabular-nums">' + p.price + ' ج.م</td>' +
								'<td class="p-sm text-center tabular-nums"><span class="badge badge-sky">' + p.discount + ' ج.م</span></td>' +
								'<td style="padding:0.75rem; text-align:end;" class="tabular-nums"><strong style="color:var(--accent); font-size:0.95rem;">' + p.price_after_discount + ' ج.م</strong></td>' +
								'<td class="p-sm text-center">' + addCartAction + '</td>' +
								'</tr>';
						});

						html += '</tbody></table></div>';
						if (contentEl) contentEl.innerHTML = html;
					})
					.catch(() => {
						if (contentEl) contentEl.innerHTML = '<div style="padding:2rem; text-align:center; color:var(--danger-text);">حدث خطأ أثناء تحميل عروض الموردين.</div>';
					});
			}

			function closePharmacyProvidersModal() {
				const el = document.getElementById('pharmacy-providers-modal');
				if (el) {
					el.classList.add('hidden');
					el.style.display = 'none';
				}
				if (window.closeModal) {
					window.closeModal('pharmacy-providers-modal');
				}
			}

			// Delegated click handler for providers modal trigger
			document.addEventListener('click', function(e) {
				const btn = e.target.closest('[data-open-providers-id]');
				if (btn) {
					e.preventDefault();
					const pId = btn.getAttribute('data-open-providers-id');
					const pName = btn.getAttribute('data-open-providers-name') || '';
					openPharmacyProvidersModal(pId, pName);
				}
			});

			function filterPharmacySavingTable(query) {
				const term = (query || '').trim().toLowerCase();
				const rows = document.querySelectorAll('.pharmacy-saving-row');
				rows.forEach(row => {
					const name = (row.dataset.name || '').toLowerCase();
					const sku = (row.dataset.sku || '').toLowerCase();
					const pName = (row.dataset.productName || '').toLowerCase();
					if (term === '' || name.includes(term) || sku.includes(term) || pName.includes(term)) {
						row.style.display = '';
					} else {
						row.style.display = 'none';
					}
				});
			}
		</script>
	}
}

// CustomerOfferOrdersPage renders offer-based orders.
templ CustomerOfferOrdersPage(orders []*commerce.Order, lang, dir string) {
	@layouts.CustomerShell("طلبات العروض والصفقات", "orders_offers", lang, dir, nil) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">طلبات العروض والصفقات الخاصة ({ fmt.Sprintf("%d", len(orders)) })</h2>
					<p class="subtitle">أوامر الشراء المشتملة على عروض ترويجية وباقات خصومات خاصة.</p>
				</div>
			</div>

			if len(orders) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات عروض مسجلة", Message: "تصفح قسم العروض واطلب الكميات المطلوبة للاستفادة من أعلى خصم متاح."})
			} else {
				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>رقم الطلب</th>
								<th>الإجمالي</th>
								<th>الخصم</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range orders {
								<tr>
									<td class="tabular-nums"><strong>{ o.OrderNumber }</strong></td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", o.TotalAmount.String()) }</td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", o.TotalDiscount.String()) }</td>
									<td><span class="badge badge-sky">{ string(o.Status) }</span></td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-secondary btn-sm">عرض الطلب</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// CustomerOfferCheckoutPage renders checkout for an offer.
templ CustomerOfferCheckoutPage(offer *promo.Offer, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("إتمام طلب العرض: %s", offer.Title.Get("ar")), "offers", lang, dir, nil) {
		<div class="card max-w-2xl mx-auto">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">إتمام شراء العرض: { offer.Title.Get("ar") }</h2>
					<p class="subtitle">قيمة الخصم: { offer.DiscountValue.String() }</p>
				</div>
				<a href="/offers" class="btn btn-secondary btn-sm">إلغاء والعودة</a>
			</div>

			<form method="POST" action="/checkout">
				<input type="hidden" name="offer_id" value={ fmt.Sprintf("%d", offer.ID) } />
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md); margin-bottom:1.5rem;">
					<h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.75rem;">بيانات التسليم والفرع</h3>
					<div class="stack">
						<div>
							<label class="form-label">فرع الاستلام</label>
							<select name="branch_id" class="form-input" required>
								<option value="1">الفرع الرئيسي للصيدلية</option>
							</select>
						</div>
						<div>
							<label class="form-label">ملاحظات التوصيل</label>
							<textarea name="notes" class="form-input" rows="2" placeholder="مواعيد التسليم أو تعليمات الشحن..."></textarea>
						</div>
					</div>
				</div>

				<div class="flex justify-end">
					<button type="submit" class="btn btn-primary">تأكيد وإرسال أمر الشراء</button>
				</div>
			</form>
		</div>
	}
}

// CustomerAddOrderPage renders manual order form.
templ CustomerAddOrderPage(lang, dir string) {
	@layouts.CustomerShell("طلب شراء سريع", "orders", lang, dir, nil) {
		<div class="card max-w-2xl mx-auto">
			<h2 class="card-title mb-lg">إضافة أمر شراء يدوي سريع</h2>
			@components.EmptyState(components.EmptyStateProps{Title: "الطلب اليدوي", Message: "يمكنك إضافة الأصناف والكميات مباشرة لإرسالها لأقرب مورد معتمد."})
		</div>
	}
}

// GuestOrderTrackingPage renders public tracking screen.
templ GuestOrderTrackingPage(orderNumber string, order *commerce.Order, lang, dir string) {
	@layouts.PublicShell("تتبع حالة الطلب والشحنة", lang, dir) {
		<div class="container" style="max-width:700px; padding:3rem 1rem; margin:0 auto;">
			<div class="card">
				<h2 class="card-title" style="text-align:center; margin-bottom:0.5rem;">تتبع شحنات وطلبات دواء 24</h2>
				<p style="text-align:center; color:var(--text-secondary); font-size:0.9rem; margin-bottom:1.5rem;">أدخل رقم الطلب لمعرفة حالة التجهيز والشحن دون الحاجة لتسجيل الدخول.</p>

				<form method="GET" action="/tracking" style="display:flex; gap:0.5rem; margin-bottom:2rem;">
					<input type="text" name="order_number" value={ orderNumber } placeholder="مثال: ORD-20260819-XXXXXX" class="form-input flex-1" required />
					<button type="submit" class="btn btn-primary">تتبع الآن</button>
				</form>

				if orderNumber != "" {
					if order != nil {
						<div style="background:var(--surface-sunken); padding:1.5rem; border-radius:var(--radius-md);">
							<div class="flex-between mb-md">
								<div>
									<div class="text-sm text-secondary">رقم الطلب</div>
									<div style="font-size:1.15rem; font-weight:700; color:var(--text);"><code>{ order.OrderNumber }</code></div>
								</div>
								<span class="badge badge-sky" style="font-size:0.9rem; padding:0.4rem 0.8rem;">{ string(order.Status) }</span>
							</div>
							<div class="text-sm text-secondary">
								تاريخ الإنشاء: <span class="tabular-nums">{ order.CreatedAt.Format("2006-01-02 15:04") }</span>
							</div>
						</div>
					} else {
						@components.EmptyState(components.EmptyStateProps{Title: "لم يتم العثور على الطلب", Message: "تأكد من إدخال رقم الطلب بصورة صحيحة."})
					}
				}
			</div>
		</div>
	}
}
