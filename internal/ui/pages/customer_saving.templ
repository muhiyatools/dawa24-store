package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerSavingPageData struct {
	Items        []*catalog.SavingProductEnriched
	Stats        *catalog.SavingProductStats
	SearchQuery  string
	FilterStatus string
	NoticeType   string
	NoticeMsg    string
	Pagination   components.PaginationProps
}

// CustomerSavingProductsPage renders customer saving products workspace and best supplier price delta tracker.
templ CustomerSavingProductsPage(data CustomerSavingPageData, lang, dir string) {
	@layouts.CustomerShell("منتجات التوفير وتتبع فروق الأسعار للصيدلية", "saving_products", lang, dir, nil) {
		<div class="page-container">

			<!-- Notice / Toast Banner -->
			if data.NoticeMsg != "" {
				<div
					class={ "alert mb-4",
						templ.KV("alert-success", data.NoticeType != "error"),
						templ.KV("alert-danger", data.NoticeType == "error") }
					role="alert"
				>
					{ data.NoticeMsg }
				</div>
			}

			<!-- Top Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconPill("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">
								منتجات وأدوية التوفير للصيدلية
							</h1>
							<p class="text-sm text-secondary m-0 mt-1">
								تتبع أدوية الصيدلية ومقارنة عروض وخصومات الموردين المتاحة بالكتالوج بالأسعار الحية
							</p>
						</div>
					</div>

					<!-- Top Action Buttons -->
					<div class="d-flex items-center gap-2 flex-wrap">
						<button
							type="button"
							class="btn btn-primary font-bold text-xs px-3 py-2"
							data-modal-open="pharmacy-saving-product-modal"
							onclick="openPharmacyCreateModal()"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة صنف توفير جديد</span>
						</button>

						<a
							href="/customer/saving-products/import"
							class="btn btn-secondary font-bold text-xs px-3 py-2 text-decoration-none"
						>
							@components.IconUpload("icon-xs")
							<span>استيراد قائمة الأدوية (Excel / CSV)</span>
						</a>

						<a
							href="/customer/saving-products/export"
							class="btn btn-secondary font-bold text-xs px-3 py-2 text-decoration-none"
							download
						>
							@components.IconDownload("icon-xs")
							<span>تصدير Excel </span>
						</a>

						if data.Stats != nil && data.Stats.CountAll > 0 {
							<form
								method="POST"
								action="/customer/saving-products/delete-all"
								onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف جميع منتجات التوفير الخاصة بصيدليتك نهائياً؟ لا يمكن التراجع عن هذه العملية.');"
							
							>
								<button
									type="submit"
									class="btn btn-secondary font-bold text-xs px-3 py-2 text-danger"
									title="حذف كافة منتجات التوفير المسجلة للصيدلية فقط"
								>
									@components.IconTrash("icon-xs")
									<span>حذف كافة منتجات التوفير</span>
								</button>
							</form>
						}
					</div>
				</div>
			</div>

			<!-- 3 Status Metric Cards -->
			<div class="dashboard-stat-grid mb-6">
				<a
					href="/customer/saving-products?filter=all"
					class="stat-card-3d text-decoration-none"
				>
					<div class="stat-card-label">جميع الأصناف المسجلة</div>
					<div class="stat-card-value text-primary tabular-nums">
						if data.Stats != nil {
							{ fmt.Sprintf("%d", data.Stats.CountAll) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">إجمالي قائمة الأدوية</span>
				</a>

				<a
					href="/customer/saving-products?filter=linked"
					class="stat-card-3d text-decoration-none"
				>
					<div class="stat-card-label text-sky">أصناف مرتبطة بالكتالوج</div>
					<div class="stat-card-value text-sky tabular-nums">
						if data.Stats != nil {
							{ fmt.Sprintf("%d", data.Stats.CountLinked) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">مفعلة وتتتبع الأسعار حياً</span>
				</a>

				<a
					href="/customer/saving-products?filter=unlinked"
					class="stat-card-3d text-decoration-none"
				>
					<div class="stat-card-label text-warning">أصناف بحاجة إلى ربط</div>
					<div class="stat-card-value text-warning tabular-nums">
						if data.Stats != nil {
							{ fmt.Sprintf("%d", data.Stats.CountUnlinked) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">غير مربوطة بصنف معتمد</span>
				</a>
			</div>

			<!-- Search Filter Bar -->
			<div class="glass-panel p-4 mb-6 flex-between items-center flex-wrap gap-4">
				<div class="position-relative">
					<input
						type="text"
						id="pharmacy-saving-search-input"
						value={ data.SearchQuery }
						placeholder="ابحث باسم الدواء، الكود SKU، أو اسم الصنف بالكتالوج..."
						class="form-input text-xs w-full"
						oninput="filterPharmacySavingTable(this.value)"
					/>
				</div>

				<div class="badge badge-slate text-xs font-bold tabular-nums">
					عرض: { fmt.Sprintf("%d", len(data.Items)) } صنف
				</div>
			</div>

			<!-- Saving Products Table Card -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(data.Items) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconPackage("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">
							لا توجد أصناف مسجلة في قائمة التوفير حالياً
						</h3>
						<p class="text-sm text-secondary max-w-md mx-auto mb-4">
							أضف أدويتك الأكثر استهلاكاً أو ارفع ملف Excel لمتابعة خصومات الموردين واقتناص أفضل الأسعار.
						</p>
						<div class="d-flex justify-center gap-2 flex-wrap">
							<button type="button" class="btn btn-primary font-bold text-xs px-4" onclick="openPharmacyCreateModal()">
								@components.IconPlus("icon-xs")
								<span>إضافة صنف جديد</span>
							</button>
							<button type="button" class="btn btn-secondary font-bold text-xs px-4" onclick="openPharmacyImportModal()">
								@components.IconUpload("icon-xs")
								<span>استيراد ملف Excel</span>
							</button>
						</div>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>اسم الصنف للصيدلية</th>
									<th>الربط بالكتالوج العام</th>
									<th class="p-md text-center">الكمية</th>
									<th class="p-md text-center">سعر الشراء</th>
									<th class="p-md text-center">عروض الموردين</th>
									<th>الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, it := range data.Items {
									<tr
										class="pharmacy-saving-row"
										data-id={ fmt.Sprintf("%d", it.ID) }
										data-name={ it.NameProduct }
										data-sku={ it.SKU }
										data-qty={ fmt.Sprintf("%v", it.Quantity) }
										data-price={ it.Price.String() }
										data-product-id={ savingProductIDStr(it.ProductID) }
										data-product-name={ it.LinkedProductName.Get(i18n.AR) }
									
									>
										<!-- Name & SKU -->
										<td class="p-card-sm">
											<div class="fw-800 text-primary text-base">
												{ it.NameProduct }
											</div>
											if it.SKU != "" {
												<div>
													<code>{ it.SKU }</code>
												</div>
											}
										</td>

										<!-- Linked Product -->
										<td class="p-md">
											if it.ProductID != nil && *it.ProductID > 0 {
												<div class="row-center-sm">
													<span class="badge badge-emerald text-xs fw-800">
														{ it.LinkedProductName.Get(i18n.AR) }
													</span>
													<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", *it.ProductID)) } target="_blank" class="btn btn-secondary btn-icon" title="عرض بالكتالوج">
														@components.IconEye("icon-xs")
													</a>
												</div>
											} else {
												<span class="badge badge-amber text-xs fw-700">
													غير مرتبط
												</span>
											}
										</td>

										<!-- Quantity -->
										<td class="p-md text-center tabular-nums">
											<strong>{ fmt.Sprintf("%v", it.Quantity) }</strong>
										</td>

										<!-- Price -->
										<td class="p-md text-center tabular-nums">
											<strong class="text-primary">{ it.Price.String() } ج.م</strong>
										</td>

										<!-- Providers & Market Offers -->
										<td class="p-md text-center">
											if it.ProductID != nil && *it.ProductID > 0 {
												<button
													type="button"
													class="btn btn-secondary btn-sm"
												
													data-open-providers-id={ fmt.Sprintf("%d", *it.ProductID) }
													data-open-providers-name={ it.NameProduct }
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openPharmacyProvidersModal(%d, %q)", *it.ProductID, it.NameProduct)} }
												>
													<span>{ fmt.Sprintf("%d موردين", it.ProvidingOrgsCount) }</span>
												</button>
											} else {
												<span class="text-xs text-muted">-</span>
											}
										</td>

										<!-- Actions -->
										<td>
											<div>
												<button
													type="button"
													class="btn btn-secondary btn-icon size-8"
													title="تعديل الصنف والربط"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openPharmacyEditModalFromRow(%d)", it.ID)} }
												>
													@components.IconEdit("icon-xs")
												</button>
												<button
													type="button"
													class="btn btn-secondary btn-icon"
												
													title="حذف من قائمة التوفير"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("confirmPharmacyDeleteSavingProduct(%d)", it.ID)} }
												>
													@components.IconTrash("icon-xs")
												</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if data.Pagination.TotalCount > 0 {
						@components.B2BPagination(data.Pagination)
					}
				}
			</div>

		</div>

		<!-- MODAL 1: Create / Edit Saving Product Modal -->
		@components.Modal(components.ModalProps{
		ID:    "pharmacy-saving-product-modal",
		Title: "????? ??? ????? ????",
		Size:  "md",
	}) {
		<form method="POST" id="pharmacy-saving-product-form" action="/customer/saving-products" class="d-flex flex-col gap-4 m-0">
					<input type="hidden" id="pharmacy-form-saving-id" name="id" value="" />
					
					<div class="modal-body d-flex flex-col gap-3">
						<div>
							<label class="form-label text-sm fw-700 text-primary">
								اسم الصنف الدوائي بالصيدلية <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								id="pharmacy-form-name-product"
								name="name_product"
								required
								placeholder="مثال: أوجمنتين 1 جم 14 قرص"
								class="form-input w-full-rounded"
							/>
						</div>

						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-sm fw-700 text-primary">
									رمز SKU (اختياري)
								</label>
								<input
									type="text"
									id="pharmacy-form-sku"
									name="sku"
									placeholder="كود الصنف..."
									class="form-input w-full-rounded"
								/>
							</div>

							<div>
								<label class="form-label text-sm fw-700 text-primary">
									الكمية المطلوبة
								</label>
								<input
									type="number"
									step="any"
									id="pharmacy-form-qty"
									name="qty"
									placeholder="0"
									class="form-input w-full-rounded"
								/>
							</div>
						</div>

						<div>
							<label class="form-label text-sm fw-700 text-primary">
								سعر الشراء الحالي / المستهدف (ج.م)
							</label>
							<input
								type="number"
								step="0.01"
								id="pharmacy-form-price"
								name="price"
								placeholder="0.00"
								class="form-input w-full-rounded"
							/>
						</div>

						<div class="d-flex flex-col gap-2 p-3 rounded-xl border bg-surface-sunken">
							<label class="font-extrabold text-sm text-primary">
								ربط الصنف بالكتالوج المركزي العام
							</label>
							
							<input type="hidden" id="pharmacy-form-product-id" name="product_id" value="" />
							
							<div id="pharmacy-selected-product-box">
								<span id="pharmacy-selected-product-label"></span>
								<button type="button" class="btn btn-secondary btn-sm" onclick="clearPharmacySelectedProduct()">
									إلغاء الربط 
								</button>
							</div>

							<div id="pharmacy-search-product-container" class="relative">
								<input
									type="text"
									id="pharmacy-product-search-input"
									placeholder="ابحث بالاسم أو SKU لربط الصنف بالكتالوج..."
									class="form-input w-full"
									oninput="searchPharmacyCatalogProductsLive(this.value)"
								/>
								<div id="pharmacy-product-search-dropdown"></div>
							</div>
						</div>
					</div>

					<div class="modal-footer">
						<button type="button" class="btn btn-secondary font-bold" onclick="closePharmacyCreateModal()">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary font-bold px-6">
							حفظ وتثبيت البيانات
						</button>
					</div>
				</form>
	}

		<!-- MODAL 2: Bulk Import Modal -->
		<!-- MODAL 2: Bulk Import & Staged Review Wizard Modal -->
		@components.Modal(components.ModalProps{
		ID:       "pharmacy-saving-import-modal",
		Title:    "????? ??????? ??????? ????? ???????",
		Subtitle: "?????? 1 ?? 3: ?????? ????? ?????? ???????",
		Size:     "xl",
	}) {
		<div id="pharmacy-import-step-config" class="stack-lg">
						<div
							id="pharmacy-import-dropzone"
						
							onclick="document.getElementById('pharmacy-import-file-input').click()"
						>
							<div>@components.IconBarChart("icon-sm")</div>
							<strong>
								انقر هنا لاختيار الملف أو اسحبه هنا
							</strong>
							<p class="text-sm text-muted m-0">
								يدعم ملفات Excel (.xlsx, .xls) وكشوف CSV (.csv) بحد أقصى 32 ميجابايت
							</p>
							<div id="pharmacy-import-filename-preview"></div>

							<input
								type="file"
								id="pharmacy-import-file-input"
								name="file"
								accept=".xlsx,.xls,.csv"
								required
							
								onchange="handlePharmacyImportFileSelect(this)"
							/>
						</div>

						<div id="pharmacy-import-columns-panel">
							<div>
								<div class="row-center-sm">
									<span>@components.IconSettings("icon-sm")</span>
									<span>تحديد وتعيين أعمدة الملف:</span>
								</div>
								<span class="badge badge-emerald font-size-10">تم التحديد الذكي تلقائياً </span>
							</div>

							<div id="pharmacy-import-columns-loading">
								⏳ جاري قراءة أعمدة الملف وتحليل البيانات...
							</div>

							<div id="pharmacy-import-columns-grid" class="grid-halves">
								<div>
									<label class="form-label">
										عمود اسم الصنف / الدواء <span class="text-danger">*</span>
									</label>
									<select name="col_name" id="pharmacy-col-name" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label">
										عمود كود الصنف / SKU / الباركود
									</label>
									<select name="col_sku" id="pharmacy-col-sku" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label">
										عمود الكمية المطلوبة
									</label>
									<select name="col_qty" id="pharmacy-col-qty" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label">
										عمود سعر الشراء المسجل (ج.م)
									</label>
									<select name="col_price" id="pharmacy-col-price" class="form-input">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>
							</div>

							<!-- Live Sample Preview Container -->
							<div id="pharmacy-import-preview-table-container"></div>
						</div>

						<!-- Match Strategy Selection -->
						<div>
							<label>
								طريقة مطابقة وربط الأصناف مع كتالوج الأدوية المعتمد:
							</label>
							<div>
								<label>
									<input type="radio" name="pharmacy_match_strategy" value="smart_auto" checked />
									<div>
										<strong class="text-body">مطابقة ذكية شاملة (موصى بها)</strong>
										<span>الربط بكود SKU / الباركود أولاً، ثم الاسم بالتنظيف اللغوي وتصحيح الهمزات والتطابق الصيدلاني.</span>
									</div>
								</label>
								<label>
									<input type="radio" name="pharmacy_match_strategy" value="sku_only" />
									<div>
										<strong class="text-body">مطابقة عبر كود SKU / الباركود فقط</strong>
										<span>المطابقة الحصرية عبر كود الباركود / SKU؛ الأصناف غير المتطابقة برمجياً لن ترتبط.</span>
									</div>
								</label>
								<label>
									<input type="radio" name="pharmacy_match_strategy" value="name_only" />
									<div>
										<strong class="text-body">مطابقة عبر اسم الصنف فقط (تجاهل كود الصيدلية الداخلي)</strong>
										<span>مثالي إذا كانت الصيدلية تستخدم أكواد كاشير داخلية خاصة تختلف عن أكواد الكتالوج العام.</span>
									</div>
								</label>
							</div>
						</div>

						<div>
							ℹ️ <strong>معالجة آمنة في الخلفية:</strong> لن يتم حفظ أو تعديل أي صنف في قاعدة البيانات مباشرة؛ ستظهر لك نتائج المطابقة كاملة في الخطوة التالية لمراجعتها والموافقة عليها.
						</div>
					</div>

					<!-- STEP 2: Real-time Background Progress -->
					<div id="pharmacy-import-step-progress">
						<div>@components.IconZap("icon-sm")</div>
						<h4 id="pharmacy-progress-phase">
							جاري قراءة وفك تشفير ملف الإكسيل...
						</h4>
						<p id="pharmacy-progress-sub">
							تتم المعالجة والمطابقة الصيدلانية في الخلفية دون تجميد المتصفح
						</p>

						<div>
							<div id="pharmacy-progress-bar"></div>
						</div>
						<div>
							<span id="pharmacy-progress-percent">10%</span>
							<span id="pharmacy-progress-counter">0 / 0 صنف</span>
						</div>
					</div>

					<!-- STEP 3: Staged Review & Confirmation -->
					<div id="pharmacy-import-step-review" class="stack-md">
						<!-- Stats Summary Grid -->
						<div>
							<div>
								<div>إجمالي الأصناف بالملف</div>
								<div id="pharmacy-review-total-count">0</div>
							</div>
							<div>
								<div>تم ربطها بالكتالوج</div>
								<div id="pharmacy-review-matched-count">0</div>
							</div>
							<div>
								<div>أصناف غير مرتبطة / جديدة</div>
								<div id="pharmacy-review-unlinked-count">0</div>
							</div>
							<div>
								<div>إجمالي الكمية المطلوبة</div>
								<div id="pharmacy-review-total-qty">0</div>
							</div>
						</div>

						<!-- Filter Tabs & Quick Search -->
						<div>
							<div class="row-center-sm">
								<button type="button" class="btn btn-sm btn-ghost" id="pharmacy-tab-all" onclick="filterPharmacyReviewTable('all')">الكل (<span id="pharmacy-badge-all">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="pharmacy-tab-matched" onclick="filterPharmacyReviewTable('matched')">المتطابق فقط (<span id="pharmacy-badge-matched">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="pharmacy-tab-unlinked" onclick="filterPharmacyReviewTable('unlinked')">غير المرتبط (<span id="pharmacy-badge-unlinked">0</span>)</button>
							</div>
							<input type="text" id="pharmacy-review-search" class="form-input" placeholder="بحث سريع في المسودة..." oninput="searchPharmacyReviewTable(this.value)" />
						</div>

						<!-- Staged Items Table Container -->
						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th>
											<input type="checkbox" id="pharmacy-select-all" checked onchange="toggleAllPharmacyStagedRows(this.checked)" />
										</th>
										<th>اسم الصنف في الملف</th>
										<th>كود SKU</th>
										<th>الصنف المطابق بالكتالوج العام</th>
										<th class="text-center">حالة المطابقة</th>
										<th class="text-center">الكمية</th>
										<th class="text-end">سعر الشراء</th>
									</tr>
								</thead>
								<tbody id="pharmacy-review-table-body"></tbody>
							</table>
						</div>

						<div>
							<span>لم يتم حفظ أي صنف في قاعدة البيانات بعد. اضغط "تأكيد الاستيراد والحفظ" لاعتماد البيانات.</span>
							<span>الأصناف المحددة: <strong id="pharmacy-selected-count">0</strong></span>
						</div>
					</div>

				<!-- Fixed Sticky Footer -->
				<div id="pharmacy-import-footer">
					<div id="pharmacy-footer-left">
						<button type="button" id="pharmacy-cancel-btn" class="btn btn-secondary" onclick="handlePharmacyImportCancelClick()">
							إلغاء
						</button>
					</div>
					<div id="pharmacy-footer-right" class="row-center-sm">
						<button type="button" id="pharmacy-back-btn" class="btn btn-secondary" onclick="backToPharmacyImportConfig()">
							← الرجوع لضبط الأعمدة
						</button>
						<button type="button" id="pharmacy-start-btn" class="btn btn-primary" onclick="startPharmacyAsyncImport()">
							بدء المعالجة والمطابقة الذكية 
						</button>
						<button type="button" id="pharmacy-commit-btn" class="btn btn-primary" onclick="commitPharmacyStagedImport()">
							تأكيد الاستيراد والحفظ النهائي في قائمة التوفير
						</button>
					</div>
				</div>
			
	}

		<!-- MODAL 3: Providing Organizations & Offers Modal -->
		@components.Modal(components.ModalProps{
		ID:    "pharmacy-providers-modal",
		Title: "???? ???????? ??????? ?????????",
		Size:  "lg",
	}) {
		<div id="pharmacy-providers-modal-content" class="modal-body p-4">
					<div class="text-center text-muted p-8">
						⏳ جاري استرجاع عروض الموردين والأسعار المتاحة...
					</div>
				</div>
	}

		<script>
			function openPharmacyCreateModal() {
				document.getElementById('pharmacy-modal-title').textContent = 'إضافة صنف توفير جديد';
				document.getElementById('pharmacy-saving-product-form').action = '/customer/saving-products';
				document.getElementById('pharmacy-form-saving-id').value = '';
				document.getElementById('pharmacy-form-name-product').value = '';
				document.getElementById('pharmacy-form-sku').value = '';
				document.getElementById('pharmacy-form-qty').value = '';
				document.getElementById('pharmacy-form-price').value = '';
				clearPharmacySelectedProduct();
				const el = document.getElementById('pharmacy-saving-product-modal');
				if (el && typeof el.showModal === 'function') {
					el.showModal();
				}
			}

			function openPharmacyEditModalFromRow(id) {
				const row = document.querySelector(`.pharmacy-saving-row[data-id="${id}"]`);
				if (!row) return;

				document.getElementById('pharmacy-modal-title').textContent = 'تعديل صنف التوفير وتعيين الربط';
				document.getElementById('pharmacy-saving-product-form').action = `/customer/saving-products/${id}/update`;
				document.getElementById('pharmacy-form-saving-id').value = id;
				document.getElementById('pharmacy-form-name-product').value = row.dataset.name || '';
				document.getElementById('pharmacy-form-sku').value = row.dataset.sku || '';
				document.getElementById('pharmacy-form-qty').value = row.dataset.qty || '';
				document.getElementById('pharmacy-form-price').value = row.dataset.price || '';

				const prodId = row.dataset.productId;
				const prodName = row.dataset.productName;
				if (prodId && prodId !== '') {
					selectPharmacyCatalogProduct(prodId, prodName);
				} else {
					clearPharmacySelectedProduct();
				}

				const el = document.getElementById('pharmacy-saving-product-modal');
				if (el && typeof el.showModal === 'function') {
					el.showModal();
				}
			}

			function closePharmacyCreateModal() {
				const el = document.getElementById('pharmacy-saving-product-modal');
				if (el && typeof el.close === 'function') {
					el.close();
				}
			}

			function selectPharmacyCatalogProduct(id, name) {
				document.getElementById('pharmacy-form-product-id').value = id;
				document.getElementById('pharmacy-selected-product-label').textContent = `${name}`;
				document.getElementById('pharmacy-selected-product-box').style.display = 'flex';
				document.getElementById('pharmacy-search-product-container').style.display = 'none';
				document.getElementById('pharmacy-product-search-dropdown').style.display = 'none';
				document.getElementById('pharmacy-product-search-input').value = '';
			}

			function clearPharmacySelectedProduct() {
				document.getElementById('pharmacy-form-product-id').value = '';
				document.getElementById('pharmacy-selected-product-label').textContent = '';
				document.getElementById('pharmacy-selected-product-box').style.display = 'none';
				document.getElementById('pharmacy-search-product-container').style.display = 'block';
			}

			let pharmacySearchDebounce = null;
			function searchPharmacyCatalogProductsLive(query) {
				clearTimeout(pharmacySearchDebounce);
				const dropdown = document.getElementById('pharmacy-product-search-dropdown');
				if (!query || query.trim().length < 2) {
					dropdown.style.display = 'none';
					return;
				}

				pharmacySearchDebounce = setTimeout(() => {
					fetch('/customer/saving-products/search-products?q=' + encodeURIComponent(query.trim()))
						.then(r => r.json())
						.then(items => {
							if (!items || items.length === 0) {
								dropdown.innerHTML = '<div>لم يتم العثور على نتائج بالكتالوج</div>';
								dropdown.style.display = 'block';
								return;
							}

							let html = '';
							items.forEach(it => {
								const skuText = it.sku ? ('<span>(' + it.sku + ')</span>') : '';
								const safeName = (it.name || '').replace(/'/g, "\\'");
								html += '<div ' +
									'onmouseover="this.style.background=\'var(--surface-sunken)\'" onmouseout="this.style.background=\'\'" ' +
									'onclick="selectPharmacyCatalogProduct(\'' + it.id + '\', \'' + safeName + '\')">' +
									'<div><strong>' + it.name + '</strong>' + skuText + '</div>' +
									'<span class="badge badge-emerald text-xs">اختيار</span></div>';
							});
							dropdown.innerHTML = html;
							dropdown.style.display = 'block';
						})
						.catch(() => {
							dropdown.style.display = 'none';
						});
				}, 200);
			}

			function confirmPharmacyDeleteSavingProduct(id) {
				if (confirm("هل أنت متأكد من حذف هذا الصنف من قائمة أدوية التوفير؟")) {
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = '/customer/saving-products/' + id + '/delete';
					document.body.appendChild(form);
					form.submit();
				}
			}

			function openPharmacyImportModal() {
				document.getElementById('pharmacy-import-filename-preview').innerHTML = '';
				document.getElementById('pharmacy-import-file-input').value = '';
				const el = document.getElementById('pharmacy-saving-import-modal');
				if (el && typeof el.showModal === 'function') {
					el.showModal();
				}
			}

			function closePharmacyImportModal() {
				const el = document.getElementById('pharmacy-saving-import-modal');
				if (el && typeof el.close === 'function') {
					el.close();
				}
			}

			function handlePharmacyImportFileSelect(input) {
				if (!input.files || !input.files[0]) return;
				const f = input.files[0];
				const size = (f.size / 1024 / 1024).toFixed(2);
				document.getElementById('pharmacy-import-filename-preview').innerHTML = 'تم اختيار: ' + f.name + ' (' + size + ' MB)';

				const panel = document.getElementById('pharmacy-import-columns-panel');
				const loadingEl = document.getElementById('pharmacy-import-columns-loading');
				const formGrid = document.getElementById('pharmacy-import-columns-grid');
				const previewTableEl = document.getElementById('pharmacy-import-preview-table-container');

				if (panel) panel.style.display = 'block';
				if (loadingEl) loadingEl.style.display = 'block';
				if (formGrid) formGrid.style.display = 'none';
				if (previewTableEl) previewTableEl.innerHTML = '';

				const formData = new FormData();
				formData.append('file', f);

				fetch('/customer/saving-products/preview-columns', {
					method: 'POST',
					body: formData,
				})
				.then(r => r.json())
				.then(data => {
					if (loadingEl) loadingEl.style.display = 'none';
					if (!data || !data.success || !data.headers || data.headers.length === 0) {
						if (formGrid) formGrid.style.display = 'none';
						alert(data.error || 'تعذر قراءة أعمدة الملف المرفوع. تأكد من سلامة ملف Excel.');
						return;
					}

					if (formGrid) formGrid.style.display = 'grid';
					renderImportColumnDropdowns('pharmacy', data.headers, data.detected);
					renderImportSamplePreview('pharmacy', data.headers, data.sample_rows, data.detected);
				})
				.catch(err => {
					if (loadingEl) loadingEl.style.display = 'none';
					console.error('preview error', err);
				});
			}

			function renderImportColumnDropdowns(prefix, headers, detected) {
				const selects = [
					{ id: prefix + '-col-name', selected: detected.name_col },
					{ id: prefix + '-col-sku', selected: detected.sku_col },
					{ id: prefix + '-col-qty', selected: detected.qty_col },
					{ id: prefix + '-col-price', selected: detected.price_col }
				];

				selects.forEach(s => {
					const el = document.getElementById(s.id);
					if (!el) return;
					el.innerHTML = '<option value="-1">-- غير محدد (تجاهل) --</option>';
					headers.forEach((h, idx) => {
						const colLetter = String.fromCharCode(65 + idx);
						const opt = document.createElement('option');
						opt.value = idx;
						opt.textContent = `العمود ${colLetter}: [${h}]`;
						if (idx === s.selected) {
							opt.selected = true;
						}
						el.appendChild(opt);
					});

					el.onchange = function() {
						const curDetected = {
							name_col: parseInt(document.getElementById(prefix + '-col-name')?.value || -1),
							sku_col: parseInt(document.getElementById(prefix + '-col-sku')?.value || -1),
							qty_col: parseInt(document.getElementById(prefix + '-col-qty')?.value || -1),
							price_col: parseInt(document.getElementById(prefix + '-col-price')?.value || -1)
						};
						if (window[prefix + '_last_sample_rows']) {
							renderImportSamplePreview(prefix, headers, window[prefix + '_last_sample_rows'], curDetected);
						}
					};
				});
			}

			function renderImportSamplePreview(prefix, headers, sampleRows, detected) {
				window[prefix + '_last_sample_rows'] = sampleRows;
				const container = document.getElementById(prefix + '-import-preview-table-container');
				if (!container || !sampleRows || sampleRows.length === 0) return;

				let html = '<div>';
				html += '<div>';
				html += '<span>معاينة أعمدة الملف والبيانات الحقيقية:</span>';
				html += '<span class="meta-muted">أول ' + sampleRows.length + ' صفوف</span>';
				html += '</div>';
				html += '<div class="table-container m-0"><table class="data-table m-0"><thead><tr>';

				headers.forEach((h, idx) => {
					let tag = '';
					if (idx === detected.name_col) tag = ' <span class="badge badge-emerald">اسم الصنف </span>';
					else if (idx === detected.sku_col) tag = ' <span class="badge badge-sky">كود SKU </span>';
					else if (idx === detected.qty_col) tag = ' <span class="badge badge-amber">الكمية </span>';
					else if (idx === detected.price_col) tag = ' <span class="badge badge-purple">السعر </span>';
					const colLetter = String.fromCharCode(65 + idx);
					html += `<th>${colLetter}: ${h}${tag}</th>`;
				});
				html += '</tr></thead><tbody>';

				sampleRows.forEach(row => {
					html += '<tr>';
					headers.forEach((_, idx) => {
						const cellVal = (idx < row.length) ? row[idx] : '';
						let cellStyle = 'padding:0.4rem 0.6rem; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;';
						if (idx === detected.name_col) cellStyle += ' font-weight:700; color:var(--text);';
						html += `<td style="${cellStyle}">${cellVal}</td>`;
					});
					html += '</tr>';
				});

				html += '</tbody></table></div></div>';
				container.innerHTML = html;
			}

			let pharmacyActiveSessionId = null;
			let pharmacyStagedData = null;
			let pharmacyCurrentTab = 'all';
			let pharmacyPollInterval = null;

			function startPharmacyAsyncImport() {
				const input = document.getElementById('pharmacy-import-file-input');
				if (!input.files || input.files.length === 0) {
					alert("يرجى اختيار ملف Excel أو CSV أولاً.");
					return;
				}

				const file = input.files[0];
				const formData = new FormData();
				formData.append('file', file);

				const colName = document.getElementById('pharmacy-col-name')?.value || '';
				const colSKU = document.getElementById('pharmacy-col-sku')?.value || '';
				const colQty = document.getElementById('pharmacy-col-qty')?.value || '';
				const colPrice = document.getElementById('pharmacy-col-price')?.value || '';
				const strat = document.querySelector('input[name="pharmacy_match_strategy"]:checked')?.value || 'smart_auto';

				formData.append('col_name', colName);
				formData.append('col_sku', colSKU);
				formData.append('col_qty', colQty);
				formData.append('col_price', colPrice);
				formData.append('match_strategy', strat);

				// Switch UI to Step 2: Progress
				showPharmacyImportStep('progress');
				document.getElementById('pharmacy-progress-bar').style.width = '10%';
				document.getElementById('pharmacy-progress-percent').textContent = '10%';
				document.getElementById('pharmacy-progress-counter').textContent = '0 / ...';
				document.getElementById('pharmacy-progress-phase').textContent = 'جاري رفع الملف وبدء المعالجة الذكية على السيرفر...';

				fetch('/customer/saving-products/import/start', {
					method: 'POST',
					body: formData,
				})
				.then(r => r.json())
				.then(res => {
					if (!res.success) {
						alert(res.error || 'حدث خطأ أثناء بدء المعالجة.');
						showPharmacyImportStep('config');
						return;
					}
					pharmacyActiveSessionId = res.session_id;
					pollPharmacyImportProgress(res.session_id);
				})
				.catch(err => {
					console.error('start import error', err);
					alert('حدث خطأ في الاتصال بالسيرفر أثناء بدء الاستيراد.');
					showPharmacyImportStep('config');
				});
			}

			function pollPharmacyImportProgress(sessionId) {
				if (pharmacyPollInterval) clearInterval(pharmacyPollInterval);

				pharmacyPollInterval = setInterval(() => {
					fetch('/customer/saving-products/import/session/' + sessionId + '/progress')
					.then(r => r.json())
					.then(sess => {
						if (!sess || !sess.success) {
							clearInterval(pharmacyPollInterval);
							alert(sess.error || 'فشلت معالجة الجلسة.');
							showPharmacyImportStep('config');
							return;
						}

						if (sess.status === 'failed') {
							clearInterval(pharmacyPollInterval);
							alert('فشلت المعالجة: ' + (sess.error_message || 'خطأ غير معروف'));
							showPharmacyImportStep('config');
							return;
						}

						// Update progress UI
						const pct = Math.max(10, Math.min(100, sess.progress || 10));
						document.getElementById('pharmacy-progress-bar').style.width = pct + '%';
						document.getElementById('pharmacy-progress-percent').textContent = pct + '%';
						document.getElementById('pharmacy-progress-counter').textContent = (sess.processed_rows || 0) + ' / ' + (sess.total_rows || 0) + ' صنف';
						if (sess.progress_phase) {
							document.getElementById('pharmacy-progress-phase').textContent = sess.progress_phase;
						}

						if (sess.status === 'ready') {
							clearInterval(pharmacyPollInterval);
							pharmacyStagedData = sess;
							renderPharmacyStagedReview(sess);
						}
					})
					.catch(err => {
						console.error('poll progress error', err);
					});
				}, 450);
			}

			function showPharmacyImportStep(step) {
				const configStep = document.getElementById('pharmacy-import-step-config');
				const progressStep = document.getElementById('pharmacy-import-step-progress');
				const reviewStep = document.getElementById('pharmacy-import-step-review');

				const subtitle = document.getElementById('pharmacy-import-modal-subtitle');
				const icon = document.getElementById('pharmacy-import-modal-icon');

				const startBtn = document.getElementById('pharmacy-start-btn');
				const commitBtn = document.getElementById('pharmacy-commit-btn');
				const backBtn = document.getElementById('pharmacy-back-btn');
				const cancelBtn = document.getElementById('pharmacy-cancel-btn');

				configStep.style.display = (step === 'config') ? 'block' : 'none';
				progressStep.style.display = (step === 'progress') ? 'block' : 'none';
				reviewStep.style.display = (step === 'review') ? 'block' : 'none';

				if (step === 'config') {
					subtitle.textContent = 'الخطوة 1 من 3: اختيار الملف وتعيين الأعمدة';
					icon.textContent = '';
					startBtn.style.display = 'inline-flex';
					commitBtn.style.display = 'none';
					backBtn.style.display = 'none';
					cancelBtn.textContent = 'إلغاء';
				} else if (step === 'progress') {
					subtitle.textContent = 'الخطوة 2 من 3: المعالجة والمطابقة في الخلفية';
					icon.textContent = '';
					startBtn.style.display = 'none';
					commitBtn.style.display = 'none';
					backBtn.style.display = 'none';
					cancelBtn.textContent = 'إلغاء المعالجة';
				} else if (step === 'review') {
					subtitle.textContent = 'الخطوة 3 من 3: مراجعة المسودة وتأكيد الحفظ النهائي';
					icon.textContent = '';
					startBtn.style.display = 'none';
					commitBtn.style.display = 'inline-flex';
					backBtn.style.display = 'inline-flex';
					cancelBtn.textContent = 'تفريغ وإلغاء المسودة';
				}
			}

			function renderPharmacyStagedReview(sess) {
				showPharmacyImportStep('review');

				document.getElementById('pharmacy-review-total-count').textContent = sess.total_rows || (sess.items ? sess.items.length : 0);
				document.getElementById('pharmacy-review-matched-count').textContent = sess.matched_rows || 0;
				document.getElementById('pharmacy-review-unlinked-count').textContent = sess.unlinked_rows || 0;
				document.getElementById('pharmacy-review-total-qty').textContent = Number(sess.total_quantity || 0).toLocaleString();

				document.getElementById('pharmacy-badge-all').textContent = sess.items ? sess.items.length : 0;
				document.getElementById('pharmacy-badge-matched').textContent = sess.matched_rows || 0;
				document.getElementById('pharmacy-badge-unlinked').textContent = sess.unlinked_rows || 0;

				renderPharmacyReviewRows(sess.items || []);
			}

			function renderPharmacyReviewRows(items) {
				const tbody = document.getElementById('pharmacy-review-table-body');
				if (!tbody) return;

				const searchVal = (document.getElementById('pharmacy-review-search')?.value || '').trim().toLowerCase();

				let html = '';
				let selectedCount = 0;

				items.forEach((item, idx) => {
					const isMatched = !!item.product_id;
					if (pharmacyCurrentTab === 'matched' && !isMatched) return;
					if (pharmacyCurrentTab === 'unlinked' && isMatched) return;

					if (searchVal) {
						const n = (item.name_product || '').toLowerCase();
						const s = (item.sku || '').toLowerCase();
						const m = (item.master_product_name || '').toLowerCase();
						if (!n.includes(searchVal) && !s.includes(searchVal) && !m.includes(searchVal)) {
							return;
						}
					}

					if (item.included !== false) selectedCount++;

					let matchBadge = '<span class="badge badge-amber font-size-10">غير مرتبط (جديد)</span>';
					if (isMatched) {
						if (item.match_type === 'exact_sku' || item.match_type === 'clean_sku') {
							matchBadge = '<span class="badge badge-emerald font-size-10">كود SKU </span>';
						} else if (item.match_type === 'exact_name' || item.match_type === 'norm_name') {
							matchBadge = '<span class="badge badge-emerald font-size-10">اسم متطابق </span>';
						} else if (item.match_type === 'core_name') {
							matchBadge = '<span class="badge badge-sky font-size-10">اسم مجرد </span>';
						} else {
							const conf = Math.round((item.confidence || 0) * 100);
							matchBadge = '<span class="badge badge-purple font-size-10">تشابه ' + conf + '% </span>';
						}
					}

					const masterDisplay = item.master_product_name ? 
						('<strong>' + item.master_product_name + '</strong>' + (item.master_product_sku ? ' <code class="text-xs text-muted">(' + item.master_product_sku + ')</code>' : '')) : 
						'<span>— صنف حر غير مقيد —</span>';

					const checkedAttr = (item.included !== false) ? 'checked' : '';

					html += '<tr class="rule-bottom">' +
						'<td class="text-center">' +
							'<input type="checkbox" class="pharmacy-staged-row-cb" data-idx="' + idx + '" ' + checkedAttr + ' onchange="updatePharmacyRowInclusion(' + idx + ', this.checked)" />' +
						'</td>' +
						'<td><strong class="text-body">' + (item.name_product || '') + '</strong></td>' +
						'<td><code class="text-xs">' + (item.sku || '—') + '</code></td>' +
						'<td>' + masterDisplay + '</td>' +
						'<td class="text-center">' + matchBadge + '</td>' +
						'<td class="text-center tabular-nums font-bold">' + (item.quantity || 0) + '</td>' +
						'<td class="text-end tabular-nums font-bold">' + (item.price || '0.00') + ' ج.م</td>' +
						'</tr>';
				});

				if (!html) {
					html = '<tr><td colspan="7">لا توجد أصناف تطابق الفلتر الحالي.</td></tr>';
				}

				tbody.innerHTML = html;
				document.getElementById('pharmacy-selected-count').textContent = selectedCount;
			}

			function updatePharmacyRowInclusion(idx, included) {
				if (pharmacyStagedData && pharmacyStagedData.items && pharmacyStagedData.items[idx]) {
					pharmacyStagedData.items[idx].included = included;
				}
				let count = 0;
				if (pharmacyStagedData && pharmacyStagedData.items) {
					pharmacyStagedData.items.forEach(it => { if (it.included !== false) count++; });
				}
				document.getElementById('pharmacy-selected-count').textContent = count;
			}

			function toggleAllPharmacyStagedRows(checked) {
				if (pharmacyStagedData && pharmacyStagedData.items) {
					pharmacyStagedData.items.forEach(it => { it.included = checked; });
				}
				const cbs = document.querySelectorAll('.pharmacy-staged-row-cb');
				cbs.forEach(cb => cb.checked = checked);
				document.getElementById('pharmacy-selected-count').textContent = checked && pharmacyStagedData && pharmacyStagedData.items ? pharmacyStagedData.items.length : 0;
			}

			function filterPharmacyReviewTable(tab) {
				pharmacyCurrentTab = tab;
				['all', 'matched', 'unlinked'].forEach(t => {
					const btn = document.getElementById('pharmacy-tab-' + t);
					if (btn) {
						if (t === tab) {
							btn.style.background = 'var(--surface-raised)';
							btn.style.color = 'var(--accent)';
						} else {
							btn.style.background = 'transparent';
							btn.style.color = 'var(--text-muted)';
						}
					}
				});
				if (pharmacyStagedData && pharmacyStagedData.items) {
					renderPharmacyReviewRows(pharmacyStagedData.items);
				}
			}

			function searchPharmacyReviewTable(val) {
				if (pharmacyStagedData && pharmacyStagedData.items) {
					renderPharmacyReviewRows(pharmacyStagedData.items);
				}
			}

			function commitPharmacyStagedImport() {
				if (!pharmacyActiveSessionId) return;

				const btn = document.getElementById('pharmacy-commit-btn');
				btn.disabled = true;
				btn.textContent = '⏳ جاري الحفظ النهائي في قاعدة البيانات...';

				fetch('/customer/saving-products/import/session/' + pharmacyActiveSessionId + '/commit', {
					method: 'POST',
				})
				.then(r => r.json())
				.then(res => {
					if (!res.success) {
						alert(res.error || 'فشل حفظ الأصناف.');
						btn.disabled = false;
						btn.textContent = 'تأكيد الاستيراد والحفظ النهائي في قائمة التوفير';
						return;
					}
					alert(res.message || 'تم استيراد وحفظ الأصناف بنجاح!');
					window.location.reload();
				})
				.catch(err => {
					console.error('commit error', err);
					alert('حدث خطأ في الاتصال أثناء تأكيد الحفظ.');
					btn.disabled = false;
					btn.textContent = 'تأكيد الاستيراد والحفظ النهائي في قائمة التوفير';
				});
			}

			function handlePharmacyImportCancelClick() {
				if (pharmacyPollInterval) clearInterval(pharmacyPollInterval);

				if (pharmacyActiveSessionId) {
					fetch('/customer/saving-products/import/session/' + pharmacyActiveSessionId + '/cancel', { method: 'POST' }).catch(() => {});
					pharmacyActiveSessionId = null;
					pharmacyStagedData = null;
				}
				closePharmacyImportModal();
			}

			function backToPharmacyImportConfig() {
				if (pharmacyPollInterval) clearInterval(pharmacyPollInterval);
				showPharmacyImportStep('config');
			}

			function openPharmacyProvidersModal(productId, productName) {
				const subtitleEl = document.getElementById('pharmacy-providers-modal-subtitle');
				if (subtitleEl) subtitleEl.textContent = 'الصنف: ' + productName;
				const contentEl = document.getElementById('pharmacy-providers-modal-content');
				if (contentEl) contentEl.innerHTML = '<div>⏳ جاري استرجاع عروض الموردين والأسعار...</div>';
				
				const modalEl = document.getElementById('pharmacy-providers-modal');
				if (modalEl && typeof modalEl.showModal === 'function') {
					modalEl.showModal();
				}

				fetch('/customer/saving-products/providers/' + productId)
					.then(r => r.json())
					.then(providers => {
						if (!providers || providers.length === 0) {
							if (contentEl) contentEl.innerHTML = '<div>لا توجد عروض موردين مسجلة لهذا الصنف حالياً في الكتالوج.<br><a href="/catalog" class="btn btn-secondary btn-sm">تصفح كتالوج الأدوية العام</a></div>';
							return;
						}

						let html = '<div><table class="data-table"><thead><tr><th class="p-sm">المورد / المخزن</th><th class="p-sm">العبوة / المواصفات</th><th class="p-sm text-center">المخزون</th><th class="p-sm text-center">سعر الجمهور</th><th class="p-sm text-center">نسبة الخصم</th><th class="p-sm text-center">السعر بعد الخصم</th><th class="p-sm text-center">طلب توريد</th></tr></thead><tbody>';

						providers.forEach(p => {
							const branchText = p.branch_name ? ('<div>' + p.branch_name + '</div>') : '';
							const skuText = p.sku ? ('<code class="text-xs">' + p.sku + '</code>') : '';
							const stockBadge = p.stock_quantity > 0 ? 'badge-emerald' : 'badge-secondary';
							const orgDisplayName = (typeof p.org_name === 'object' && p.org_name) ? (p.org_name.ar || p.org_name.en || 'مورد معتمد') : (p.org_name || 'مورد معتمد');
							const varDisplayName = (typeof p.variant_name === 'object' && p.variant_name) ? (p.variant_name.ar || p.variant_name.en || 'العبوة القياسية') : (p.variant_name || 'العبوة القياسية');
							
							const publicPrice = p.public_price || p.cost_price || p.price;
							const discountPct = p.discount_percentage ? (p.discount_percentage + '%') : (p.discount ? (p.discount + '%') : '0%');
							const netPrice = p.price_after_discount || p.price;

							const addCartAction = (p.stock_quantity > 0 && p.variant_id) ?
								('<form method="POST" action="/cart/add">' +
									'<input type="hidden" name="variant_id" value="' + p.variant_id + '" />' +
									'<input type="hidden" name="product_id" value="' + productId + '" />' +
									'<input type="hidden" name="organization_id" value="' + (p.organization_id || '') + '" />' +
									'<input type="hidden" name="vendor_org_id" value="' + (p.organization_id || '') + '" />' +
									'<input type="hidden" name="offer_price" value="' + netPrice + '" />' +
									'<input type="hidden" name="qty" value="1" />' +
									'<button type="submit" class="btn btn-primary btn-sm">+ أضف للسلة</button>' +
								'</form>') :
								'<span class="text-xs text-muted">غير متوفر</span>';

							html += '<tr class="rule-bottom">' +
								'<td class="p-sm"><strong>' + orgDisplayName + '</strong>' + branchText + '</td>' +
								'<td class="p-sm"><div>' + varDisplayName + '</div>' + skuText + '</td>' +
								'<td class="p-sm text-center tabular-nums"><span class="badge ' + stockBadge + '">' + p.stock_quantity + ' عبوة</span></td>' +
								'<td class="p-sm text-center tabular-nums">' + publicPrice + ' ج.م</td>' +
								'<td class="p-sm text-center tabular-nums"><span class="badge badge-emerald">' + discountPct + '</span></td>' +
								'<td class="p-sm text-center tabular-nums"><strong class="text-primary tabular-nums">' + netPrice + ' ج.م</strong></td>' +
								'<td class="p-sm text-center">' + addCartAction + '</td>' +
								'</tr>';
						});

						html += '</tbody></table></div>';
						if (contentEl) contentEl.innerHTML = html;
					})
					.catch(() => {
						if (contentEl) contentEl.innerHTML = '<div>حدث خطأ أثناء تحميل عروض الموردين.</div>';
					});
			}

			function closePharmacyProvidersModal() {
				const el = document.getElementById('pharmacy-providers-modal');
				if (el && typeof el.close === 'function') {
					el.close();
				}
			}

			// Delegated click handler for providers modal trigger
			document.addEventListener('click', function(e) {
				const btn = e.target.closest('[data-open-providers-id]');
				if (btn) {
					e.preventDefault();
					const pId = btn.getAttribute('data-open-providers-id');
					const pName = btn.getAttribute('data-open-providers-name') || '';
					openPharmacyProvidersModal(pId, pName);
				}
			});

			function filterPharmacySavingTable(query) {
				const term = (query || '').trim().toLowerCase();
				const rows = document.querySelectorAll('.pharmacy-saving-row');
				rows.forEach(row => {
					const name = (row.dataset.name || '').toLowerCase();
					const sku = (row.dataset.sku || '').toLowerCase();
					const pName = (row.dataset.productName || '').toLowerCase();
					if (term === '' || name.includes(term) || sku.includes(term) || pName.includes(term)) {
						row.style.display = '';
					} else {
						row.style.display = 'none';
					}
				});
			}
		</script>
	}
}

// CustomerOfferOrdersPage renders offer-based orders.
templ CustomerOfferOrdersPage(orders []*commerce.Order, lang, dir string) {
	@layouts.CustomerShell("طلبات العروض والصفقات", "orders_offers", lang, dir, nil) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">طلبات العروض والصفقات الخاصة ({ fmt.Sprintf("%d", len(orders)) })</h2>
					<p class="subtitle">أوامر الشراء المشتملة على عروض ترويجية وباقات خصومات خاصة.</p>
				</div>
			</div>

			if len(orders) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات عروض مسجلة", Message: "تصفح قسم العروض واطلب الكميات المطلوبة للاستفادة من أعلى خصم متاح."})
			} else {
				<div class="table-container m-0">
					<table class="data-table m-0">
						<thead>
							<tr>
								<th>رقم الطلب</th>
								<th>الإجمالي</th>
								<th>الخصم</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range orders {
								<tr>
									<td class="tabular-nums"><strong>{ o.OrderNumber }</strong></td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", o.TotalAmount.String()) }</td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", o.TotalDiscount.String()) }</td>
									<td><span class="badge badge-sky">{ string(o.Status) }</span></td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/orders/%d", o.ID)) } class="btn btn-secondary btn-sm">عرض الطلب</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// CustomerOfferCheckoutPage renders checkout for an offer.
templ CustomerOfferCheckoutPage(offer *promo.Offer, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("إتمام طلب العرض: %s", offer.Title.Get("ar")), "offers", lang, dir, nil) {
		<div class="card max-w-2xl mx-auto">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">إتمام شراء العرض: { offer.Title.Get("ar") }</h2>
					<p class="subtitle">قيمة الخصم: { offer.DiscountValue.String() }</p>
				</div>
				<a href="/offers" class="btn btn-secondary btn-sm">إلغاء والعودة</a>
			</div>

			<form method="POST" action="/checkout">
				<input type="hidden" name="offer_id" value={ fmt.Sprintf("%d", offer.ID) } />
				<div>
					<h3>بيانات التسليم والفرع</h3>
					<div class="stack">
						<div>
							<label class="form-label">فرع الاستلام</label>
							<select name="branch_id" class="form-input" required>
								<option value="1">الفرع الرئيسي للصيدلية</option>
							</select>
						</div>
						<div>
							<label class="form-label">ملاحظات التوصيل</label>
							<textarea name="notes" class="form-input" rows="2" placeholder="مواعيد التسليم أو تعليمات الشحن..."></textarea>
						</div>
					</div>
				</div>

				<div class="flex justify-end">
					<button type="submit" class="btn btn-primary">تأكيد وإرسال أمر الشراء</button>
				</div>
			</form>
		</div>
	}
}

// CustomerAddOrderPage renders manual order form.
templ CustomerAddOrderPage(lang, dir string) {
	@layouts.CustomerShell("طلب شراء سريع", "orders", lang, dir, nil) {
		<div class="card max-w-2xl mx-auto">
			<h2 class="card-title mb-lg">إضافة أمر شراء يدوي سريع</h2>
			@components.EmptyState(components.EmptyStateProps{Title: "الطلب اليدوي", Message: "يمكنك إضافة الأصناف والكميات مباشرة لإرسالها لأقرب مورد معتمد."})
		</div>
	}
}

// GuestOrderTrackingPage renders public tracking screen.
templ GuestOrderTrackingPage(orderNumber string, order *commerce.Order, lang, dir string) {
	@layouts.PublicShell("تتبع حالة الطلب والشحنة", lang, dir) {
		<div class="container">
			<div class="card">
				<h2 class="card-title">تتبع شحنات وطلبات دواء 24</h2>
				<p>أدخل رقم الطلب لمعرفة حالة التجهيز والشحن دون الحاجة لتسجيل الدخول.</p>

				<form method="GET" action="/tracking">
					<input type="text" name="order_number" value={ orderNumber } placeholder="مثال: ORD-20260819-XXXXXX" class="form-input flex-1" required />
					<button type="submit" class="btn btn-primary">تتبع الآن</button>
				</form>

				if orderNumber != "" {
					if order != nil {
						<div>
							<div class="flex-between mb-md">
								<div>
									<div class="text-sm text-secondary">رقم الطلب</div>
									<div><code>{ order.OrderNumber }</code></div>
								</div>
								<span class="badge badge-sky">{ string(order.Status) }</span>
							</div>
							<div class="text-sm text-secondary">
								تاريخ الإنشاء: <span class="tabular-nums">{ order.CreatedAt.Format("2006-01-02 15:04") }</span>
							</div>
						</div>
					} else {
						@components.EmptyState(components.EmptyStateProps{Title: "لم يتم العثور على الطلب", Message: "تأكد من إدخال رقم الطلب بصورة صحيحة."})
					}
				}
			</div>
		</div>
	}
}
