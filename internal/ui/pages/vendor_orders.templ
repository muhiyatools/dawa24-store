package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorOrders(shipments []*commerce.OrderShipment, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorOrdersTable(shipments)
	} else {
		@layouts.VendorShell("طلبيات الموردين والشحنات | Orders & Shipments", "orders", lang, dir) {
			<div class="header-row">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">طلبيات الصيدليات والشحنات</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">متابعة وتأكيد أوامر التوريد وإصدار إشعارات الشحن والتوصيل</p>
				</div>
			</div>

			<div id="vendor-orders-content">
				@VendorOrdersTable(shipments)
			</div>
		}
	}
}

templ VendorOrdersTable(shipments []*commerce.OrderShipment) {
	if len(shipments) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا توجد طلبيات واردة حالياً",
			Message: "ستظهر هنا أي طلبيات جديدة يتم إجراؤها من الصيدليات والعملاء.",
		})
	} else {
		<div class="card" style="padding:0; overflow:hidden; margin-bottom:0;">
			<table class="data-table">
				<thead>
					<tr>
						<th>رقم الشحنة</th>
						<th>الطلب الرئيسي</th>
						<th>قيمة الشحنة</th>
						<th>الحالة الحالية</th>
						<th>التاريخ</th>
						<th class="text-end">تحديث الحالة</th>
					</tr>
				</thead>
				<tbody>
					for _, sh := range shipments {
						<tr>
							<td style="font-weight:700; color:var(--primary-700);" class="tabular-nums">
								#{ sh.ShipmentNumber }
							</td>
							<td style="color:var(--neutral-600);">
								Order #{ fmt.Sprintf("%d", sh.OrderID) }
							</td>
							<td style="font-weight:700; color:var(--neutral-900);" class="tabular-nums">
								{ sh.TotalAmount.String() } EGP
							</td>
							<td>
								<span class="badge badge-sky">
									{ string(sh.Status) }
								</span>
							</td>
							<td style="color:var(--neutral-500);" class="tabular-nums">
								{ sh.CreatedAt.Format("2006-01-02 15:04") }
							</td>
							<td class="text-end">
								if sh.Status == commerce.StatusPending {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" style="margin:0; display:inline;">
										<input type="hidden" name="status" value="confirmed" />
										<button
											type="submit"
											class="btn btn-primary btn-sm"
										>
											@components.IconCheck("icon-xs")
											<span>تأكيد الطلب</span>
										</button>
									</form>
								} else if sh.Status == commerce.StatusConfirmed {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" style="margin:0; display:inline;">
										<input type="hidden" name="status" value="shipped" />
										<button
											type="submit"
											class="btn btn-primary btn-sm"
										>
											@components.IconTruck("icon-xs")
											<span>بدء الشحن</span>
										</button>
									</form>
								} else if sh.Status == commerce.StatusShipped {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" style="margin:0; display:inline;">
										<input type="hidden" name="status" value="delivered" />
										<button
											type="submit"
											class="btn btn-primary btn-sm"
										>
											@components.IconCheckCircle("icon-xs")
											<span>تم التسليم</span>
										</button>
									</form>
								} else {
									<span class="badge badge-emerald">
										@components.IconCheck("icon-xs")
										<span>مكتمل</span>
									</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
