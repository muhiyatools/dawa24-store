package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorOrdersData struct {
	Shipments      []*commerce.OrderShipment
	FilterStatus   string
	Page           int
	PerPage        int
	TotalCount     int
	PendingCount   int
	ConfirmedCount int
	ShippedCount   int
	DeliveredCount int
}

func filterCardBorder(current, target string) string {
	if current == target {
		return "var(--accent)"
	}
	return "var(--border)"
}

templ VendorOrders(data VendorOrdersData, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorOrdersContent(data, lang, dir)
	} else {
		@layouts.VendorShell("طلبيات الصيدليات والشحنات | Orders & Shipments", "orders", lang, dir) {
			<div class="page-container">
				<!-- Header Section -->
				<div class="glass-panel p-6 mb-6">
					<div class="flex-between flex-wrap gap-4">
      <div class="stack-sm">
							<div class="d-flex items-center gap-3 mb-1">
								<div class="user-avatar-badge text-xl">
									@components.IconPackage("icon-sm")
								</div>
								<h1 class="text-2xl font-black text-primary m-0">
									طلبيات الصيدليات والشحنات
								</h1>
							</div>
							<p class="text-sm text-secondary m-0">
								مراجعة تفاصيل أصناف أوامر التوريد الواردة من الصيدليات وتأكيد التجهيز وبدء الشحن
							</p>
						</div>
					</div>

					<!-- Navigation Filter Tabs -->
					<div class="tabs-nav mt-4">
						<a
							href="/vendor/orders"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "") }
						>
							الكل ({ fmt.Sprintf("%d", data.TotalCount) })
						</a>
						<a
							href="/vendor/orders?status=pending"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "pending") }
						>
							بانتظار التأكيد ({ fmt.Sprintf("%d", data.PendingCount) })
						</a>
						<a
							href="/vendor/orders?status=confirmed"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "confirmed") }
						>
							قيد التجهيز ({ fmt.Sprintf("%d", data.ConfirmedCount) })
						</a>
						<a
							href="/vendor/orders?status=shipped"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "shipped") }
						>
							قيد التوصيل ({ fmt.Sprintf("%d", data.ShippedCount) })
						</a>
						<a
							href="/vendor/orders?status=delivered"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "delivered") }
						>
							تم التسليم ({ fmt.Sprintf("%d", data.DeliveredCount) })
						</a>
					</div>
				</div>

				<!-- Quick Status Metrics Cards -->
				<div class="dashboard-stat-grid mb-6">
					<a href="/vendor/orders" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label">إجمالي الشحنات</div>
							<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", data.TotalCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=pending" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-warning d-flex items-center gap-2">
								<span class="status-dot warning"></span>
								<span>بانتظار التأكيد</span>
							</div>
							<div class="stat-card-value text-warning tabular-nums">{ fmt.Sprintf("%d", data.PendingCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=confirmed" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-brand d-flex items-center gap-2">
								<span class="status-dot"></span>
								<span>قيد التجهيز بالمخزن</span>
							</div>
							<div class="stat-card-value text-brand tabular-nums">{ fmt.Sprintf("%d", data.ConfirmedCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=shipped" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-accent d-flex items-center gap-2">
								<span class="status-dot"></span>
								<span>قيد الشحن والتوصيل</span>
							</div>
							<div class="stat-card-value text-accent tabular-nums">{ fmt.Sprintf("%d", data.ShippedCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=delivered" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-success d-flex items-center gap-2">
								<span class="status-dot success"></span>
								<span>تم التسليم بنجاح</span>
							</div>
							<div class="stat-card-value text-success tabular-nums">{ fmt.Sprintf("%d", data.DeliveredCount) }</div>
						</div>
					</a>
				</div>

				<div class="stack-sm" id="vendor-orders-content">
					@VendorOrdersContent(data, lang, dir)
				</div>
			</div>
		}
	}
}

templ VendorOrdersContent(data VendorOrdersData, lang, dir string) {
	if len(data.Shipments) == 0 {
		<div class="glass-panel p-12 text-center empty-state-glass">
			<div class="text-4xl mb-3">@components.IconPackage("icon-sm")</div>
			<h3 class="text-lg font-black text-primary mb-2">لا توجد طلبيات مطابقة في هذا القسم</h3>
			<p class="text-sm text-secondary m-0">ستظهر هنا أي طلبيات جديدة يتم إجراؤها من الصيدليات والعملاء التابعين لتغطيتك الجغرافية.</p>
		</div>
	} else {
		<div class="d-flex flex-col gap-4">
			for _, sh := range data.Shipments {
				<div
					x-data="{ expanded: false }"
					class="glass-panel p-5 transition-all"
				>
					<!-- Compact Summary Header (Always Visible, Clickable to Expand) -->
					<div
						class="flex-between items-center flex-wrap gap-4 cursor-pointer"
						@click="expanded = !expanded"
					>
						<div class="d-flex items-center gap-3 flex-wrap">
							<!-- Expand / Collapse Indicator -->
							<button
								type="button"
								class="btn btn-secondary btn-icon btn-sm"
								:title="expanded ? 'طي التفاصيل' : 'عرض التفاصيل'"
							>
								<span x-text="expanded ? '▲' : '▼'"></span>
							</button>

							<span class="text-base font-black text-primary tabular-nums">
								شحنة #{ sh.ShipmentNumber }
							</span>

							if sh.OrderNumber != "" {
								<span class="badge badge-secondary text-xs font-bold">
									أمر الشراء #{ sh.OrderNumber }
								</span>
							}

							if sh.Status == commerce.StatusPending {
								<span class="badge badge-amber text-xs font-black">بانتظار التأكيد</span>
							} else if sh.Status == commerce.StatusConfirmed {
								<span class="badge badge-sky text-xs font-black">قيد التجهيز بالمخزن</span>
							} else if sh.Status == commerce.StatusShipped {
								<span class="badge badge-indigo text-xs font-black">قيد الشحن والتوصيل</span>
							} else if sh.Status == commerce.StatusDelivered {
								<span class="badge badge-emerald text-xs font-black">تم التسليم بنجاح</span>
							} else {
								<span class="badge badge-slate text-xs font-black">{ string(sh.Status) }</span>
							}

							<!-- Destination Chip -->
							<span class="badge badge-slate text-xs font-bold gap-1 d-none d-md-inline-flex">
								@components.IconBuilding("icon-xs")
								<span>{ sh.CustomerBranchName.Get(i18n.Lang(lang)) }</span>
							</span>

							<!-- Items count chip -->
							<span class="badge badge-secondary text-xs font-bold tabular-nums">
								{ fmt.Sprintf("%d أصناف", len(sh.Lines)) }
							</span>
						</div>

						<div class="d-flex items-center gap-4">
							<div class="text-end">
								<span class="text-xs text-muted d-block font-bold">القيمة الإجمالية</span>
								<strong class="text-lg font-black text-brand tabular-nums">
									{ sh.TotalAmount.String() } <span class="text-xs font-bold text-muted">ج.م</span>
								</strong>
							</div>

							<button
								type="button"
								class="btn btn-secondary btn-sm font-bold text-xs gap-1"
								@click.stop="expanded = !expanded"
							>
								<span x-text="expanded ? 'طي التفاصيل ▲' : 'استعراض الأصناف ▼'"></span>
							</button>
						</div>
					</div>

					<!-- Expandable Details Section (Shown when expanded == true) -->
					<div x-show="expanded" x-cloak class="mt-4 pt-4 border-t">
						
						<!-- Destination & Contact Grid -->
						<div class="d-grid gap-4 bg-surface-sunken p-4 rounded-xl border mb-5 text-sm" class="grid-auto-fit-md">
       <div class="stack-sm">
								<div class="text-muted text-xs font-bold mb-1 d-flex items-center gap-2">
									@components.IconBuilding("icon-xs")
									<span>الصيدلية والفرع المستلم:</span>
								</div>
								<strong class="text-base font-extrabold text-primary d-block">
									{ sh.CustomerBranchName.Get(i18n.Lang(lang)) }
								</strong>
								if sh.CustomerOrgName.Get(i18n.Lang(lang)) != "" {
									<span class="text-secondary text-xs">
										{ sh.CustomerOrgName.Get(i18n.Lang(lang)) }
									</span>
								}
							</div>

       <div class="stack-sm">
								<div class="text-muted text-xs font-bold mb-1 d-flex items-center gap-2">
									@components.IconTruck("icon-xs")
									<span>عنوان التسليم الجغرافي:</span>
								</div>
								<div class="text-primary leading-normal text-xs">
									if sh.CustomerBranchAddress != "" {
										{ sh.CustomerBranchAddress }
									} else {
										<span class="text-muted">العنوان المسجل لفرع الصيدلية</span>
									}
								</div>
							</div>

       <div class="stack-sm">
								<div class="text-muted text-xs font-bold mb-1 d-flex items-center gap-2">
									@components.IconPhone("icon-xs")
									<span>مسؤول الاستلام والتواصل:</span>
								</div>
								<div class="text-primary text-xs">
									if sh.CustomerManagerName != "" {
										<div class="font-bold">{ sh.CustomerManagerName }</div>
									}
									if sh.CustomerBranchPhone != "" {
										<div class="tabular-nums text-secondary">{ sh.CustomerBranchPhone }</div>
									} else if sh.CustomerManagerName == "" {
										<span class="text-muted">الصيدلي المسؤول بالفرع</span>
									}
								</div>
							</div>

							if sh.Notes != "" {
								<div class="border-t pt-2 mt-1">
									<div class="text-muted text-xs font-bold mb-1">ملاحظات خاصة من الصيدلية:</div>
									<div class="text-primary text-xs">{ sh.Notes }</div>
								</div>
							}
						</div>

						<!-- Detailed Line Items Table -->
						<div class="mb-5">
							<div class="flex-between items-center mb-3">
								<h4 class="text-xs font-black text-primary m-0 d-flex items-center gap-2">
									@components.IconPackage("icon-xs")
									<span>الأصناف والكميات المطلوبة ({ fmt.Sprintf("%d", len(sh.Lines)) } صنف)</span>
								</h4>
								<span class="badge badge-sky text-xs font-bold">شحن مبرد معتمد Cold-Chain</span>
							</div>

							<div class="table-container m-0">
								<table class="data-table m-0">
									<thead>
										<tr>
											<th>اسم الدواء / الصنف</th>
											<th class="text-center tabular-nums">الكمية المطلوبة</th>
											<th class="text-center tabular-nums">سعر الجمهور</th>
											<th class="text-center tabular-nums">نسبة الخصم</th>
											<th class="text-end tabular-nums">السعر بعد الخصم (الإجمالي)</th>
										</tr>
									</thead>
									<tbody>
										for _, line := range sh.Lines {
											<tr>
												<td>
													<div class="d-flex items-center gap-2 flex-wrap">
														<strong class="text-primary text-sm font-bold">{ line.ProductName.Get(i18n.Lang(lang)) }</strong>
														if line.IsNegotiated {
															<span class="badge badge-amber text-xs font-bold">سعر تفاوضي</span>
														}
													</div>
													if line.VariantName.Get(i18n.Lang(lang)) != "" {
														<div class="text-xs text-muted">
															{ line.VariantName.Get(i18n.Lang(lang)) }
														</div>
													}
												</td>
												<td class="text-center">
													<span class="badge badge-secondary text-xs font-black">
														{ fmt.Sprintf("%d", line.Quantity) } عبوة
													</span>
												</td>
												<td class="text-center font-bold text-secondary tabular-nums text-xs">
													{ line.UnitPrice.String() } ج.م
												</td>
												<td class="text-center tabular-nums text-xs">
													{{
														discPct := 0.0
														if line.UnitPrice.IsPositive() && line.DiscountAmount.IsPositive() {
															discPct = (float64(line.DiscountAmount.Minor()) / float64(line.UnitPrice.Minor())) * 100.0
														}
													}}
													if discPct > 0 {
														<span class="badge badge-emerald tabular-nums text-xs font-bold">{ fmt.Sprintf("%.1f%%", discPct) }</span>
													} else {
														<span class="text-xs text-muted">0%</span>
													}
												</td>
												<td class="text-end tabular-nums">
													<strong class="text-brand font-black text-sm">{ line.TotalPrice.String() } ج.م</strong>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>

						<!-- Action Controls Toolbar -->
						<div class="flex-between items-center flex-wrap gap-4 pt-4 border-t">
							<div class="d-flex items-center gap-2 flex-wrap">
								if sh.TrackingNumber != "" {
									<div class="text-xs text-secondary bg-surface-sunken p-2 px-3 rounded-lg border d-flex items-center gap-2">
										<span>رقم بوليصة الشحن:</span>
										<strong class="tabular-nums text-primary font-black font-mono">{ sh.TrackingNumber }</strong>
									</div>
									<a
										href={ templ.SafeURL(fmt.Sprintf("/delivery?tracking=%s", sh.TrackingNumber)) }
										target="_blank"
										class="btn btn-secondary font-black text-xs py-1.5 px-3 gap-1.5 text-sky-700 bg-sky-50 border-sky-200"
										title="فتح شاشة تسليم المندوب لمشاركتها معه"
									>
										@components.IconExternalLink("icon-2xs")
										<span>بوابة المندوب ↗</span>
									</a>
								}
							</div>

							<div class="d-flex items-center gap-3 flex-wrap">
								if sh.Status == commerce.StatusPending {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" class="m-0 d-inline">
										<input type="hidden" name="status" value="confirmed" />
										<input type="hidden" name="notes" value="تمت الموافقة على أمر التوريد والتجهيز بالمخزن" />
										<button
											type="submit"
											class="btn btn-secondary font-bold px-4 py-2 gap-2 text-xs"
										>
											@components.IconCheck("icon-xs")
											<span>قبول وتأكيد الطلب</span>
										</button>
									</form>
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" class="m-0 d-inline" onsubmit="return confirm('هل أنت متأكد من رفض هذا الطلب؟');">
										<input type="hidden" name="status" value="cancelled" />
										<input type="hidden" name="notes" value="تم رفض الطلب أو السعر المقترح من قبل المورد" />
										<button
											type="submit"
											class="btn btn-danger font-bold px-4 py-2 text-xs"
										>
											<span>رفض الطلب</span>
										</button>
									</form>
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" class="m-0 d-inline">
										<input type="hidden" name="status" value="delivered" />
										<input type="hidden" name="notes" value="تم تسليم الشحنة المبردة بالصيدلية وتوثيق الاستلام" />
										<button
											type="submit"
											class="btn btn-primary font-black px-4 py-2 gap-2 text-xs"
										>
											@components.IconCheckCircle("icon-xs")
											<span>تأكيد وإتمام التسليم للصيدلية</span>
										</button>
									</form>
								} else if sh.Status == commerce.StatusConfirmed {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" class="m-0 d-flex items-center gap-2 flex-wrap">
										<input type="hidden" name="status" value="shipped" />
										<input
											type="text"
											name="tracking"
											placeholder="رقم البوليصة (أو يُولد تلقائياً)..."
											class="form-input text-xs"
										/>
										<button
											type="submit"
											class="btn btn-primary font-black px-4 py-2 gap-2 text-xs shadow-xs"
										>
											@components.IconTruck("icon-xs")
											<span>إرسال للشحن وبدء التوصيل</span>
										</button>
									</form>
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" class="m-0 d-inline">
										<input type="hidden" name="status" value="delivered" />
										<input type="hidden" name="notes" value="تم تسليم الشحنة المبردة بالصيدلية وتوثيق الاستلام" />
										<button
											type="submit"
											class="btn btn-secondary font-bold px-4 py-2 gap-2 text-xs"
										>
											@components.IconCheckCircle("icon-xs")
											<span>تسليم مباشر</span>
										</button>
									</form>
								} else if sh.Status == commerce.StatusShipped {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" class="m-0 d-inline">
										<input type="hidden" name="status" value="delivered" />
										<input type="hidden" name="notes" value="تم تسليم الشحنة المبردة بالصيدلية وتوثيق الاستلام" />
										<button
											type="submit"
											class="btn btn-primary font-black px-4 py-2 gap-2 text-xs"
										>
											@components.IconCheckCircle("icon-xs")
											<span>تأكيد وإتمام التسليم للصيدلية</span>
										</button>
									</form>
								} else {
									<span class="badge badge-emerald text-xs font-black p-2 px-3 gap-2">
										@components.IconCheckCircle("icon-xs")
										<span>تم تسليم الشحنة وتوثيق الاستلام</span>
									</span>
								}
								if sh.Status != commerce.StatusPending {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", sh.OrderID)) }
										target="_blank"
										class="btn btn-secondary font-bold px-4 py-2 text-xs"
										title="طباعة الفاتورة"
									>
										<span>طباعة الفاتورة</span>
									</a>
								}
							</div>
						</div>
					</div>
				</div>
			}

			if data.TotalCount > 0 {
				@components.B2BPagination(components.PaginationProps{
					CurrentPage: data.Page,
					PageSize:    data.PerPage,
					TotalCount:  data.TotalCount,
					BaseURL:     "/vendor/orders",
					QueryValues: url.Values{
						"status": {data.FilterStatus},
					},
				})
			}
		</div>
	}
}
