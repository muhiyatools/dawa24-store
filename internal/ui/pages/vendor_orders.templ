package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorOrders(shipments []*commerce.OrderShipment, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorOrdersTable(shipments)
	} else {
		@layouts.VendorShell("طلبيات الموردين والشحنات | Orders & Shipments", "shipments", lang, dir) {
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">طلبيات الصيدليات والشحنات</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">متابعة وتأكيد أوامر التوريد وإصدار إشعارات الشحن والتوصيل</p>
				</div>
			</div>

			<div id="vendor-orders-content">
				@VendorOrdersTable(shipments)
			</div>
		}
	}
}

templ VendorOrdersTable(shipments []*commerce.OrderShipment) {
	if len(shipments) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا توجد طلبيات واردة حالياً",
			Message: "ستظهر هنا أي طلبيات جديدة يتم إجراؤها من الصيدليات والعملاء.",
		})
	} else {
		<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-lg); overflow:hidden;">
			<table style="width:100%; border-collapse:collapse; text-align:start; font-size:0.9rem;">
				<thead>
					<tr style="background:var(--neutral-50); border-bottom:1px solid var(--neutral-200);">
						<th style="padding:0.75rem 1rem;">رقم الشحنة</th>
						<th style="padding:0.75rem 1rem;">الطلب الرئيسي</th>
						<th style="padding:0.75rem 1rem;">قيمة الشحنة</th>
						<th style="padding:0.75rem 1rem;">الحالة الحالية</th>
						<th style="padding:0.75rem 1rem;">التاريخ</th>
						<th style="padding:0.75rem 1rem; text-align:end;">تحديث الحالة</th>
					</tr>
				</thead>
				<tbody>
					for _, sh := range shipments {
						<tr style="border-bottom:1px solid var(--neutral-100);">
							<td style="padding:0.75rem 1rem; font-weight:700; color:var(--primary-700);" class="tabular-nums">
								#{ sh.ShipmentNumber }
							</td>
							<td style="padding:0.75rem 1rem; color:var(--neutral-600);">
								Order #{ fmt.Sprintf("%d", sh.OrderID) }
							</td>
							<td style="padding:0.75rem 1rem; font-weight:700; color:var(--neutral-900);" class="tabular-nums">
								{ sh.TotalAmount.String() } EGP
							</td>
							<td style="padding:0.75rem 1rem;">
								<span style="font-size:0.75rem; padding:0.2rem 0.5rem; border-radius:4px; background:var(--primary-50); color:var(--primary-700); font-weight:600;">
									{ string(sh.Status) }
								</span>
							</td>
							<td style="padding:0.75rem 1rem; color:var(--neutral-500);" class="tabular-nums">
								{ sh.CreatedAt.Format("2006-01-02 15:04") }
							</td>
							<td style="padding:0.75rem 1rem; text-align:end;">
								if sh.Status == commerce.StatusPending {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" style="margin:0; display:inline;">
										<input type="hidden" name="status" value="confirmed" />
										<button
											type="submit"
											class="btn btn-primary"
											style="font-size:0.75rem; padding:0.25rem 0.6rem;"
										>
											تأكيد الطلب ✓
										</button>
									</form>
								} else if sh.Status == commerce.StatusConfirmed {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" style="margin:0; display:inline;">
										<input type="hidden" name="status" value="shipped" />
										<button
											type="submit"
											class="btn btn-primary"
											style="font-size:0.75rem; padding:0.25rem 0.6rem;"
										>
											بدء الشحن 🚚
										</button>
									</form>
								} else if sh.Status == commerce.StatusShipped {
									<form action={ templ.SafeURL(fmt.Sprintf("/vendor/orders/%d/status", sh.ID)) } method="POST" style="margin:0; display:inline;">
										<input type="hidden" name="status" value="delivered" />
										<button
											type="submit"
											class="btn btn-primary"
											style="font-size:0.75rem; padding:0.25rem 0.6rem;"
										>
											تم التسليم ✅
										</button>
									</form>
								} else {
									<span style="font-size:0.8rem; color:var(--neutral-500);">مكتمل</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
