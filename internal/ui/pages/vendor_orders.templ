package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorOrdersData struct {
	Shipments      []*commerce.OrderShipment
	FilterStatus   string
	Page           int
	PerPage        int
	TotalCount     int
	PendingCount   int
	ConfirmedCount int
	ShippedCount   int
	DeliveredCount int
}

func filterCardBorder(current, target string) string {
	if current == target {
		return "var(--accent)"
	}
	return "var(--border)"
}

templ VendorOrders(data VendorOrdersData, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorOrdersContent(data, lang, dir)
	} else {
		@layouts.VendorShell("طلبيات الصيدليات والشحنات | Orders & Shipments", "orders", lang, dir) {
			<div class="page-container">
				<!-- Header Section -->
				<div class="glass-panel p-6 mb-6">
					<div class="flex-between flex-wrap gap-4">
      <div class="stack-sm">
							<div class="d-flex items-center gap-3 mb-1">
								<div class="user-avatar-badge text-xl">
									@components.IconPackage("icon-sm")
								</div>
								<h1 class="text-2xl font-black text-primary m-0">
									طلبيات الصيدليات والشحنات
								</h1>
							</div>
							<p class="text-sm text-secondary m-0">
								مراجعة تفاصيل أصناف أوامر التوريد الواردة من الصيدليات وتأكيد التجهيز وبدء الشحن
							</p>
						</div>
					</div>

					<!-- Navigation Filter Tabs -->
					<div class="tabs-nav mt-4">
						<a
							href="/vendor/orders"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "") }
						>
							الكل ({ fmt.Sprintf("%d", data.TotalCount) })
						</a>
						<a
							href="/vendor/orders?status=pending"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "pending") }
						>
							بانتظار التأكيد ({ fmt.Sprintf("%d", data.PendingCount) })
						</a>
						<a
							href="/vendor/orders?status=confirmed"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "confirmed") }
						>
							قيد التجهيز ({ fmt.Sprintf("%d", data.ConfirmedCount) })
						</a>
						<a
							href="/vendor/orders?status=shipped"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "shipped") }
						>
							قيد التوصيل ({ fmt.Sprintf("%d", data.ShippedCount) })
						</a>
						<a
							href="/vendor/orders?status=delivered"
							class={ "tab-btn", templ.KV("active", data.FilterStatus == "delivered") }
						>
							تم التسليم ({ fmt.Sprintf("%d", data.DeliveredCount) })
						</a>
					</div>
				</div>

				<!-- Quick Status Metrics Cards -->
				<div class="dashboard-stat-grid mb-6">
					<a href="/vendor/orders" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label">إجمالي الشحنات</div>
							<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", data.TotalCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=pending" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-warning d-flex items-center gap-2">
								<span class="status-dot warning"></span>
								<span>بانتظار التأكيد</span>
							</div>
							<div class="stat-card-value text-warning tabular-nums">{ fmt.Sprintf("%d", data.PendingCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=confirmed" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-brand d-flex items-center gap-2">
								<span class="status-dot"></span>
								<span>قيد التجهيز بالمخزن</span>
							</div>
							<div class="stat-card-value text-brand tabular-nums">{ fmt.Sprintf("%d", data.ConfirmedCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=shipped" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-accent d-flex items-center gap-2">
								<span class="status-dot"></span>
								<span>قيد الشحن والتوصيل</span>
							</div>
							<div class="stat-card-value text-accent tabular-nums">{ fmt.Sprintf("%d", data.ShippedCount) }</div>
						</div>
					</a>

					<a href="/vendor/orders?status=delivered" class="text-none">
						<div class="stat-card-3d">
							<div class="stat-card-label text-success d-flex items-center gap-2">
								<span class="status-dot success"></span>
								<span>تم التسليم بنجاح</span>
							</div>
							<div class="stat-card-value text-success tabular-nums">{ fmt.Sprintf("%d", data.DeliveredCount) }</div>
						</div>
					</a>
				</div>

				<div class="stack-sm" id="vendor-orders-content">
					@VendorOrdersContent(data, lang, dir)
				</div>
			</div>
		}
	}
}

templ VendorOrdersContent(data VendorOrdersData, lang, dir string) {
	if len(data.Shipments) == 0 {
		<div class="glass-panel p-12 text-center empty-state-glass">
			<div class="text-4xl mb-3">@components.IconPackage("icon-sm")</div>
			<h3 class="text-lg font-black text-primary mb-2">لا توجد طلبيات مطابقة في هذا القسم</h3>
			<p class="text-sm text-secondary m-0">ستظهر هنا أي طلبيات جديدة يتم إجراؤها من الصيدليات والعملاء التابعين لتغطيتك الجغرافية.</p>
		</div>
	} else {
		<div class="d-flex flex-col gap-4">
			for _, sh := range data.Shipments {
				@VendorOrderShipmentCard(sh, lang)
			}

			if data.TotalCount > 0 {
				@components.B2BPagination(components.PaginationProps{
					CurrentPage: data.Page,
					PageSize:    data.PerPage,
					TotalCount:  data.TotalCount,
					BaseURL:     "/vendor/orders",
					QueryValues: url.Values{
						"status": {data.FilterStatus},
					},
				})
			}
		</div>
	}
}
