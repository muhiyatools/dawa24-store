package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorSavingPageData struct {
	Items        []*catalog.SavingProductEnriched
	Stats        *catalog.SavingProductStats
	SearchQuery  string
	FilterStatus string
	NoticeType   string
	NoticeMsg    string
}

func savingFilterBorder(current, target string) string {
	if current == target {
		return "var(--accent)"
	}
	return "var(--border)"
}

func savingProductIDStr(pid *int64) string {
	if pid != nil && *pid > 0 {
		return fmt.Sprintf("%d", *pid)
	}
	return ""
}

// VendorSavingProductsPage renders the comprehensive all-in-one saving products workspace.
templ VendorSavingProductsPage(data VendorSavingPageData, lang, dir string) {
	@layouts.VendorShell("منتجات التوفير والمساعدة للمنشأة | Saving Products", "saving_products", lang, dir) {
		<div style="max-width:1440px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem;">

			<!-- Notice / Toast Banner -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger" style="display:flex; align-items:center; justify-content:space-between; padding:1.15rem 1.5rem; border-radius:var(--radius-xl); background:rgba(239, 68, 68, 0.12); border:1px solid rgba(239, 68, 68, 0.35); color:#ef4444; box-shadow:0 10px 25px rgba(0,0,0,0.15);">
						<div style="display:flex; align-items:center; gap:0.75rem; font-weight:800; font-size:0.95rem;">
							<span class="text-2xl">⚠️</span>
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success" style="display:flex; align-items:center; justify-content:space-between; padding:1.15rem 1.5rem; border-radius:var(--radius-xl); background:rgba(16, 185, 129, 0.12); border:1px solid rgba(16, 185, 129, 0.35); color:#10b981; box-shadow:0 10px 25px rgba(0,0,0,0.15);">
						<div style="display:flex; align-items:center; gap:0.75rem; font-weight:800; font-size:0.95rem;">
							<span class="text-2xl">✅</span>
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				}
			}

			<!-- Top Header Banner (Matching Reference Image 2) -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; margin-bottom:0;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div style="display:flex; align-items:center; gap:1rem;">
						<div style="width:54px; height:54px; border-radius:var(--radius-xl); background:linear-gradient(135deg, #f59e0b 0%, #ec4899 100%); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.75rem; box-shadow:0 8px 20px rgba(245,158,11,0.25);">
							🏢
						</div>
						<div>
							<h1 style="font-size:1.65rem; font-weight:900; color:var(--text); margin:0;">
								منتجات التوفير والمساعدة للمنشأة
							</h1>
							<p style="color:var(--text-muted); font-size:0.875rem; margin:0.25rem 0 0 0;">
								إدارة واستيراد ومطابقة منتجات التوفير مع الكتالوج ومتابعة عروض الموردين والأسعار
							</p>
						</div>
					</div>

					<!-- Top Action Buttons -->
					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<button
							type="button"
							class="btn btn-primary"
							data-modal-open="saving-product-modal"
							style="background:#f59e0b; border-color:#f59e0b; color:#000; font-weight:800; font-size:0.9rem; padding:0.65rem 1.25rem; border-radius:var(--radius-lg);"
							onclick="openCreateModal()"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة منتج توفير جديد</span>
						</button>

						<a
							href="/vendor/saving-products/import"
							class="btn btn-secondary"
							style="font-weight:800; font-size:0.9rem; padding:0.65rem 1.25rem; border-radius:var(--radius-lg); text-decoration:none;"
						>
							@components.IconUpload("icon-xs")
							<span>استيراد من ملف (Excel / CSV)</span>
						</a>

						<a
							href="/vendor/saving-products/export"
							class="btn btn-secondary"
							style="background:#0f766e; border-color:#0f766e; color:#fff; font-weight:800; font-size:0.9rem; padding:0.65rem 1.25rem; border-radius:var(--radius-lg); text-decoration:none;"
							download
						>
							@components.IconDownload("icon-xs")
							<span>تصدير Excel 📊</span>
						</a>
					</div>
				</div>
			</div>

			<!-- 3 Status Metric Cards (Matching Reference Image 2) -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.25rem;">
				
				<!-- 1. All Products -->
				<a
					href="/vendor/saving-products?filter=all"
					class="card"
					style={ fmt.Sprintf("padding:1.5rem; margin:0; text-decoration:none; background:var(--surface-raised); border:2px solid %s; border-radius:var(--radius-2xl); display:flex; justify-content:space-between; align-items:center; transition:transform 0.2s;", savingFilterBorder(data.FilterStatus, "all")) }
				>
					<div>
						<div style="font-size:0.875rem; font-weight:700; color:var(--text-muted); margin-bottom:0.35rem;">
							جميع المنتجات (الكل)
						</div>
						<div style="font-size:2.2rem; font-weight:900; color:var(--text);" class="tabular-nums">
							if data.Stats != nil {
								{ fmt.Sprintf("%d", data.Stats.CountAll) }
							} else {
								0
							}
						</div>
					</div>
					<div style="width:48px; height:48px; border-radius:var(--radius-xl); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
						🏢
					</div>
				</a>

				<!-- 2. Linked Products -->
				<a
					href="/vendor/saving-products?filter=linked"
					class="card"
					style={ fmt.Sprintf("padding:1.5rem; margin:0; text-decoration:none; background:var(--surface-raised); border:2px solid %s; border-radius:var(--radius-2xl); display:flex; justify-content:space-between; align-items:center; transition:transform 0.2s;", savingFilterBorder(data.FilterStatus, "linked")) }
				>
					<div>
						<div style="font-size:0.875rem; font-weight:700; color:var(--text-muted); margin-bottom:0.35rem;">
							المنتجات المرتبطة
						</div>
						<div style="font-size:2.2rem; font-weight:900; color:#38bdf8;" class="tabular-nums">
							if data.Stats != nil {
								{ fmt.Sprintf("%d", data.Stats.CountLinked) }
							} else {
								0
							}
						</div>
					</div>
					<div style="width:48px; height:48px; border-radius:var(--radius-xl); background:rgba(56, 189, 248, 0.15); color:#38bdf8; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
						🔗
					</div>
				</a>

				<!-- 3. Unlinked Products -->
				<a
					href="/vendor/saving-products?filter=unlinked"
					class="card"
					style={ fmt.Sprintf("padding:1.5rem; margin:0; text-decoration:none; background:var(--surface-raised); border:2px solid %s; border-radius:var(--radius-2xl); display:flex; justify-content:space-between; align-items:center; transition:transform 0.2s;", savingFilterBorder(data.FilterStatus, "unlinked")) }
				>
					<div>
						<div style="font-size:0.875rem; font-weight:700; color:var(--text-muted); margin-bottom:0.35rem;">
							منتجات غير مرتبطة
						</div>
						<div style="font-size:2.2rem; font-weight:900; color:#f59e0b;" class="tabular-nums">
							if data.Stats != nil {
								{ fmt.Sprintf("%d", data.Stats.CountUnlinked) }
							} else {
								0
							}
						</div>
					</div>
					<div style="width:48px; height:48px; border-radius:var(--radius-xl); background:rgba(245, 158, 11, 0.15); color:#f59e0b; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
						⚠️
					</div>
				</a>

			</div>

			<!-- Main Content Table Card -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; margin-bottom:0;">
				
				<!-- Top Bar: Result Count & Search Input -->
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
					<div style="font-weight:800; font-size:1.05rem; color:var(--text);">
						إجمالي النتائج: <strong class="text-accent tabular-nums">{ fmt.Sprintf("%d", len(data.Items)) }</strong>
					</div>

					<div style="position:relative; width:360px; max-width:100%;">
						<input
							type="text"
							id="saving-products-search"
							value={ data.SearchQuery }
							placeholder="بحث باسم المنتج المحفوظ أو SKU..."
							class="form-input"
							style="width:100%; padding:0.6rem 1rem 0.6rem 2.5rem; border-radius:var(--radius-xl);"
							oninput="filterSavingProductsTable(this.value)"
						/>
						<div style="position:absolute; right:1rem; top:50%; transform:translateY(-50%); color:var(--text-muted);">
							@components.IconSearch("icon-xs")
						</div>
					</div>
				</div>

				<!-- Saving Products Data Table (Matching Reference Image 2) -->
				if len(data.Items) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد منتجات مساعدة مسجلة",
						Message: "يمكنك إضافة منتجات يدوياً أو استيراد كشف Excel/CSV للبحث التلقائي ومطابقة الأصناف مع عروض الموردين.",
					})
				} else {
					<div style="overflow-x:auto; border:1px solid var(--border); border-radius:var(--radius-xl);">
						<table class="table" id="saving-products-table" style="width:100%; border-collapse:collapse; margin:0;">
							<thead>
								<tr style="background:var(--surface-sunken); border-bottom:2px solid var(--border); text-align:start; font-size:0.8rem; color:var(--text-muted); text-transform:uppercase;">
									<th style="padding:0.85rem 1rem; width:60px;">#</th>
									<th style="padding:0.85rem 1rem; font-weight:800;">ORG PRODUCT NAME</th>
									<th style="padding:0.85rem 1rem; font-weight:800;">رمز SKU</th>
									<th style="padding:0.85rem 1rem; font-weight:800; text-align:center;">المنتج المرتبط بالنظام</th>
									<th style="padding:0.85rem 1rem; font-weight:800; text-align:center;">PROVIDING ORGS COUNT</th>
									<th style="padding:0.85rem 1rem; font-weight:800; text-align:center;">الكمية</th>
									<th style="padding:0.85rem 1rem; font-weight:800; text-align:center;">السعر</th>
									<th style="padding:0.85rem 1rem; font-weight:800; text-align:end;">الإجمالي</th>
									<th style="padding:0.85rem 1rem; font-weight:800; text-align:center;">العمليات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Items {
									<tr
										class="saving-row"
										data-id={ fmt.Sprintf("%d", item.ID) }
										data-name={ item.NameProduct }
										data-sku={ item.SKU }
										data-qty={ fmt.Sprintf("%.2f", item.Quantity) }
										data-price={ item.Price.String() }
										data-product-id={ savingProductIDStr(item.ProductID) }
										data-product-name={ item.LinkedProductName.Get(i18n.Lang(lang)) }
										style="border-bottom:1px solid var(--border); font-size:0.875rem;"
									>
										<!-- # ID -->
										<td style="padding:0.85rem 1rem; font-weight:700; color:var(--text-muted);" class="tabular-nums">
											#{ fmt.Sprintf("%d", item.ID) }
										</td>

										<!-- Org Product Name -->
										<td class="p-sm">
											<strong style="color:var(--text); font-size:0.95rem;">{ item.NameProduct }</strong>
										</td>

										<!-- SKU -->
										<td style="padding:0.85rem 1rem; color:var(--text-secondary);" class="tabular-nums">
											if item.SKU != "" {
												<code>{ item.SKU }</code>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Linked Product Badge / Button -->
										<td style="padding:0.85rem 1rem; text-align:center;">
											if item.ProductID != nil && *item.ProductID > 0 {
												<button
													type="button"
													class="badge badge-emerald"
													style="cursor:pointer; font-weight:800; font-size:0.8rem; padding:0.4rem 0.85rem; border:none; display:inline-flex; align-items:center; gap:0.35rem;"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openEditModalFromRow(%d)", item.ID)} }
													title="انقر لتعديل الصنف المرتبط"
												>
													<span>🔗</span>
													<span>{ item.LinkedProductName.Get(i18n.Lang(lang)) }</span>
												</button>
											} else {
												<button
													type="button"
													class="badge badge-amber"
													style="cursor:pointer; font-weight:800; font-size:0.775rem; padding:0.35rem 0.75rem; border:none; display:inline-flex; align-items:center; gap:0.35rem;"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openEditModalFromRow(%d)", item.ID)} }
													title="انقر للبحث والربط بصنف معتمد في الكتالوج"
												>
													<span>⚠️</span>
													<span>غير مرتبط (انقر للربط)</span>
												</button>
											}
										</td>

										<!-- Providing Orgs Count -->
										<td style="padding:0.85rem 1rem; text-align:center;">
											if item.ProductID != nil && *item.ProductID > 0 {
												if item.ProvidingOrgsCount > 0 {
													<button
														type="button"
														class="badge badge-indigo"
														style="cursor:pointer; font-weight:800; font-size:0.8rem; padding:0.4rem 0.85rem; border:none; display:inline-flex; align-items:center; gap:0.35rem;"
														onclick={ templ.ComponentScript{Call: fmt.Sprintf("openProvidersModal(%d, '%s')", *item.ProductID, item.LinkedProductName.Get(i18n.Lang(lang)))} }
													>
														<span>🏢</span>
														<span>{ fmt.Sprintf("%d المنظمات", item.ProvidingOrgsCount) }</span>
													</button>
												} else {
													<span class="text-muted text-sm">0</span>
												}
											} else {
												<span class="text-muted text-sm">-</span>
											}
										</td>

										<!-- Qty -->
										<td style="padding:0.85rem 1rem; text-align:center;" class="tabular-nums">
											if item.Quantity > 0 {
												<strong class="text-primary">{ fmt.Sprintf("%.0f", item.Quantity) }</strong>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Price -->
										<td style="padding:0.85rem 1rem; text-align:center;" class="tabular-nums">
											if item.Price.IsPositive() {
												<span style="color:var(--text); font-weight:700;">{ item.Price.String() } EGP</span>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Total Value -->
										<td style="padding:0.85rem 1rem; text-align:end;" class="tabular-nums">
											if item.TotalValue.IsPositive() {
												<strong style="color:var(--accent); font-size:0.95rem;">{ item.TotalValue.String() } EGP</strong>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Actions (View Providers / Edit / Delete) -->
										<td style="padding:0.85rem 1rem; text-align:center;">
											<div style="display:inline-flex; align-items:center; gap:0.35rem;">
												if item.ProductID != nil && *item.ProductID > 0 {
													<button
														type="button"
														class="btn btn-secondary btn-sm btn-icon text-accent"
														title="عرض عروض الموردين والأسعار"
														onclick={ templ.ComponentScript{Call: fmt.Sprintf("openProvidersModal(%d, '%s')", *item.ProductID, item.LinkedProductName.Get(i18n.Lang(lang)))} }
													>
														@components.IconEye("icon-xs")
													</button>
												}

												<button
													type="button"
													class="btn btn-secondary btn-sm btn-icon"
													title="تعديل المنتج والربط"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openEditModalFromRow(%d)", item.ID)} }
												>
													@components.IconEdit("icon-xs")
												</button>

												<button
													type="button"
													class="btn btn-secondary btn-sm btn-icon text-danger"
													title="حذف من قائمة المساعدة"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("confirmDeleteSavingProduct(%d)", item.ID)} }
												>
													@components.IconTrash("icon-xs")
												</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>

		<!-- MODAL 1: Create / Edit Saving Product Modal -->
		<div id="saving-product-modal" class="modal-overlay hidden">
			<div class="card" style="max-width:620px; width:100%; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
				<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.25rem;">
					<h3 id="modal-title" class="text-xl fw-900 text-primary m-0">
						إضافة منتج مساعدة جديد
					</h3>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closeCreateModal()">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<form method="POST" id="saving-product-form" action="/vendor/saving-products">
					<input type="hidden" id="form-saving-id" name="id" value="" />
					
					<div class="stack-md">
						
						<!-- Product Name -->
						<div>
							<label class="form-label text-sm fw-700 text-primary">
								اسم الصنف الدوائي للمنظمة <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								id="form-name-product"
								name="name_product"
								required
								placeholder="مثال: بنادول اكسترا 24 قرص"
								class="form-input"
								style="width:100%; border-radius:var(--radius-lg);"
							/>
						</div>

						<!-- SKU & Qty Row -->
						<div class="grid-2">
							<div>
								<label class="form-label text-sm fw-700 text-primary">
									رمز SKU (اختياري)
								</label>
								<input
									type="text"
									id="form-sku"
									name="sku"
									placeholder="كود الصنف..."
									class="form-input"
									style="width:100%; border-radius:var(--radius-lg);"
								/>
							</div>

							<div>
								<label class="form-label text-sm fw-700 text-primary">
									الكمية المتوفرة
								</label>
								<input
									type="number"
									step="any"
									id="form-qty"
									name="qty"
									placeholder="0"
									class="form-input"
									style="width:100%; border-radius:var(--radius-lg);"
								/>
							</div>
						</div>

						<!-- Price Row -->
						<div>
							<label class="form-label text-sm fw-700 text-primary">
								السعر المستهدف / سعر الوحدة (ج.م)
							</label>
							<input
								type="number"
								step="0.01"
								id="form-price"
								name="price"
								placeholder="0.00"
								class="form-input"
								style="width:100%; border-radius:var(--radius-lg);"
							/>
						</div>

						<!-- Linked Catalog Product Picker -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; flex-direction:column; gap:0.5rem;">
							<label style="font-weight:800; color:var(--text); font-size:0.875rem;">
								🔗 ربط الصنف بالكتالوج المعتمد للمنصة
							</label>
							
							<input type="hidden" id="form-product-id" name="product_id" value="" />
							
							<div id="selected-product-box" style="display:none; justify-content:space-between; align-items:center; background:var(--surface-raised); padding:0.6rem 0.85rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
								<span id="selected-product-label" style="font-weight:800; color:var(--accent); font-size:0.9rem;"></span>
								<button type="button" class="btn btn-secondary btn-sm" onclick="clearSelectedProduct()" style="font-size:0.75rem; color:var(--danger-text);">
									إلغاء الربط ✕
								</button>
							</div>

							<div id="search-product-container" style="position:relative;">
								<input
									type="text"
									id="product-search-input"
									placeholder="ابحث بالاسم أو SKU لربط الصنف بالكتالوج..."
									class="form-input"
									style="width:100%; border-radius:var(--radius-lg); font-size:0.85rem;"
									oninput="searchCatalogProductsLive(this.value)"
								/>
								<div id="product-search-dropdown" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:100; max-height:200px; overflow-y:auto; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); box-shadow:0 10px 25px rgba(0,0,0,0.3); margin-top:0.25rem;"></div>
							</div>
						</div>

					</div>

					<!-- Form Footer -->
					<div class="modal-footer-standard">
						<button type="button" class="btn btn-secondary" onclick="closeCreateModal()">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.6rem 1.5rem;">
							حفظ وتثبيت البيانات
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- MODAL 2: Bulk Import & Staged Review Wizard Modal -->
		<div id="saving-import-modal" class="modal-overlay hidden" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); align-items:center; justify-content:center; padding:1rem;">
			<div class="card" style="max-width:920px; width:100%; max-height:88vh; display:flex; flex-direction:column; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); box-shadow:0 25px 50px -12px rgba(0,0,0,0.5); overflow:hidden; margin:0;">
				
				<!-- Fixed Header -->
				<div style="flex-shrink:0; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding:1.25rem 1.5rem; background:var(--surface-raised);">
					<div class="row-center-sm">
						<span class="text-2xl" id="vendor-import-modal-icon">📥</span>
						<div>
							<h3 id="vendor-import-modal-title" class="text-xl fw-900 text-primary m-0">
								معالج استيراد ومطابقة منتجات المساعدة
							</h3>
							<p id="vendor-import-modal-subtitle" style="font-size:0.75rem; color:var(--text-muted); margin:2px 0 0 0;">
								الخطوة 1 من 3: اختيار الملف وتعيين الأعمدة
							</p>
						</div>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closeImportModal()">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<!-- Scrollable Body -->
				<div style="flex:1 1 auto; overflow-y:auto; padding:1.25rem 1.5rem;">
					
					<!-- STEP 1: Upload & Configuration -->
					<div id="vendor-import-step-config" class="stack-lg">
						
						<!-- Dropzone -->
						<div
							id="import-dropzone"
							style="border:2px dashed var(--accent); background:var(--surface-sunken); border-radius:var(--radius-xl); padding:2rem 1rem; text-align:center; cursor:pointer;"
							onclick="document.getElementById('import-file-input').click()"
						>
							<div style="font-size:2.8rem; margin-bottom:0.5rem;">📊</div>
							<strong style="color:var(--text); font-size:1rem; display:block; margin-bottom:0.25rem;">
								انقر هنا لاختيار الملف أو اسحبه هنا
							</strong>
							<p class="text-sm text-muted m-0">
								يدعم ملفات Excel (.xlsx, .xls) وكشوف CSV (.csv) بحد أقصى 32 ميجابايت
							</p>
							<div id="import-filename-preview" style="margin-top:0.75rem; font-weight:800; color:var(--accent); font-size:0.85rem;"></div>

							<input
								type="file"
								id="import-file-input"
								name="file"
								accept=".xlsx,.xls,.csv"
								required
								style="display:none;"
								onchange="handleImportFileSelect(this)"
							/>
						</div>

						<!-- Column Mapping Customizer -->
						<div id="vendor-import-columns-panel" style="display:none; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem;">
							<div style="font-weight:800; font-size:0.9rem; color:var(--text); margin-bottom:0.75rem; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
								<div class="row-center-sm">
									<span>⚙️</span>
									<span>تحديد وتعيين أعمدة الملف:</span>
								</div>
								<span class="badge badge-emerald" style="font-size:10px;">تم التحديد الذكي تلقائياً ✓</span>
							</div>

							<div id="vendor-import-columns-loading" style="display:none; text-align:center; padding:1.5rem; color:var(--accent); font-weight:700;">
								⏳ جاري قراءة أعمدة الملف وتحليل البيانات...
							</div>

							<div id="vendor-import-columns-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div>
									<label class="form-label" style="font-size:0.775rem; font-weight:700; color:var(--text); margin-bottom:0.25rem;">
										عمود اسم الصنف / المنتج <span class="text-danger">*</span>
									</label>
									<select name="col_name" id="vendor-col-name" class="form-input" style="width:100%; border-radius:var(--radius-md); font-size:0.8rem; padding:0.4rem 0.6rem;">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label" style="font-size:0.775rem; font-weight:700; color:var(--text); margin-bottom:0.25rem;">
										عمود كود الصنف / SKU / الباركود
									</label>
									<select name="col_sku" id="vendor-col-sku" class="form-input" style="width:100%; border-radius:var(--radius-md); font-size:0.8rem; padding:0.4rem 0.6rem;">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label" style="font-size:0.775rem; font-weight:700; color:var(--text); margin-bottom:0.25rem;">
										عمود الكمية المطلوبة
									</label>
									<select name="col_qty" id="vendor-col-qty" class="form-input" style="width:100%; border-radius:var(--radius-md); font-size:0.8rem; padding:0.4rem 0.6rem;">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label" style="font-size:0.775rem; font-weight:700; color:var(--text); margin-bottom:0.25rem;">
										عمود السعر المستهدف (ج.م)
									</label>
									<select name="col_price" id="vendor-col-price" class="form-input" style="width:100%; border-radius:var(--radius-md); font-size:0.8rem; padding:0.4rem 0.6rem;">
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>
							</div>

							<!-- Live Sample Preview Container -->
							<div id="vendor-import-preview-table-container"></div>
						</div>

						<!-- Match Strategy Selection -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
							<label style="font-weight:800; color:var(--text); font-size:0.875rem; display:block; margin-bottom:0.6rem;">
								🎯 طريقة مطابقة وربط الأصناف مع كتالوج الأدوية المعتمد:
							</label>
							<div style="display:flex; flex-direction:column; gap:0.6rem;">
								<label style="display:flex; align-items:flex-start; gap:0.6rem; font-size:0.825rem; color:var(--text); cursor:pointer;">
									<input type="radio" name="vendor_match_strategy" value="smart_auto" checked style="accent-color:var(--accent); margin-top:2px;" />
									<div>
										<strong style="color:var(--text);">مطابقة ذكية شاملة (موصى بها)</strong>
										<span style="display:block; color:var(--text-muted); font-size:0.75rem; margin-top:2px;">الربط بكود SKU / الباركود أولاً، ثم الاسم بالتنظيف اللغوي وتصحيح الهمزات والتطابق الصيدلاني.</span>
									</div>
								</label>
								<label style="display:flex; align-items:flex-start; gap:0.6rem; font-size:0.825rem; color:var(--text); cursor:pointer;">
									<input type="radio" name="vendor_match_strategy" value="sku_only" style="accent-color:var(--accent); margin-top:2px;" />
									<div>
										<strong style="color:var(--text);">مطابقة عبر كود SKU / الباركود فقط</strong>
										<span style="display:block; color:var(--text-muted); font-size:0.75rem; margin-top:2px;">المطابقة الحصرية عبر كود الباركود / SKU؛ الأصناف غير المتطابقة برمجياً لن ترتبط.</span>
									</div>
								</label>
								<label style="display:flex; align-items:flex-start; gap:0.6rem; font-size:0.825rem; color:var(--text); cursor:pointer;">
									<input type="radio" name="vendor_match_strategy" value="name_only" style="accent-color:var(--accent); margin-top:2px;" />
									<div>
										<strong style="color:var(--text);">مطابقة عبر اسم الصنف فقط (تجاهل كود المورد الداخلي)</strong>
										<span style="display:block; color:var(--text-muted); font-size:0.75rem; margin-top:2px;">مثالي إذا كان المورد يستخدم أكواد ERP داخلية خاصة تختلف عن أكواد الكتالوج العام.</span>
									</div>
								</label>
							</div>
						</div>

						<div style="font-size:0.8rem; color:var(--text-muted); line-height:1.5; background:rgba(56, 189, 248, 0.08); border:1px solid rgba(56, 189, 248, 0.2); padding:0.75rem 1rem; border-radius:var(--radius-lg);">
							ℹ️ <strong>معالجة آمنة في الخلفية:</strong> لن يتم حفظ أو تعديل أي صنف في قاعدة البيانات مباشرة؛ ستظهر لك نتائج المطابقة كاملة في الخطوة التالية لمراجعتها والموافقة عليها.
						</div>

					</div>

					<!-- STEP 2: Real-time Background Progress -->
					<div id="vendor-import-step-progress" style="display:none; text-align:center; padding:2.5rem 1.5rem;">
						<div style="font-size:3.5rem; margin-bottom:1rem;">⚡</div>
						<h4 id="vendor-progress-phase" style="font-size:1.15rem; font-weight:900; color:var(--text); margin-bottom:0.5rem;">
							جاري قراءة وفك تشفير ملف الإكسيل...
						</h4>
						<p id="vendor-progress-sub" style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1.75rem;">
							تتم المعالجة والمطابقة الصيدلانية في الخلفية دون تجميد المتصفح
						</p>

						<div style="width:100%; max-width:520px; margin:0 auto; background:var(--surface-sunken); border-radius:999px; height:12px; overflow:hidden; border:1px solid var(--border);">
							<div id="vendor-progress-bar" style="width:10%; height:100%; background:linear-gradient(90deg, var(--accent), #10b981); transition:width 0.3s ease;"></div>
						</div>
						<div style="display:flex; justify-content:space-between; max-width:520px; margin:0.6rem auto 0 auto; font-size:0.8rem; font-weight:700; color:var(--text-muted);">
							<span id="vendor-progress-percent">10%</span>
							<span id="vendor-progress-counter">0 / 0 صنف</span>
						</div>
					</div>

					<!-- STEP 3: Staged Review & Confirmation -->
					<div id="vendor-import-step-review" style="display:none;" class="stack-md">
						<!-- Stats Summary Grid -->
						<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:0.75rem;">
							<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.75rem 1rem; text-align:center;">
								<div style="font-size:0.725rem; color:var(--text-muted);">إجمالي الأصناف بالملف</div>
								<div id="vendor-review-total-count" style="font-size:1.35rem; font-weight:900; color:var(--text);">0</div>
							</div>
							<div style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.3); border-radius:var(--radius-lg); padding:0.75rem 1rem; text-align:center;">
								<div style="font-size:0.725rem; color:var(--emerald-600);">تم ربطها بالكتالوج</div>
								<div id="vendor-review-matched-count" style="font-size:1.35rem; font-weight:900; color:var(--emerald-600);">0</div>
							</div>
							<div style="background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.3); border-radius:var(--radius-lg); padding:0.75rem 1rem; text-align:center;">
								<div style="font-size:0.725rem; color:var(--amber-600);">أصناف غير مرتبطة / جديدة</div>
								<div id="vendor-review-unlinked-count" style="font-size:1.35rem; font-weight:900; color:var(--amber-600);">0</div>
							</div>
							<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.75rem 1rem; text-align:center;">
								<div style="font-size:0.725rem; color:var(--text-muted);">إجمالي الكمية المطلوبة</div>
								<div id="vendor-review-total-qty" style="font-size:1.35rem; font-weight:900; color:var(--accent);">0</div>
							</div>
						</div>

						<!-- Filter Tabs & Quick Search -->
						<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
							<div class="row-center-sm" style="background:var(--surface-sunken); padding:3px; border-radius:var(--radius-lg); border:1px solid var(--border);">
								<button type="button" class="btn btn-sm btn-ghost" id="vendor-tab-all" onclick="filterVendorReviewTable('all')" style="font-size:0.75rem; font-weight:800; background:var(--surface-raised);">الكل (<span id="vendor-badge-all">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="vendor-tab-matched" onclick="filterVendorReviewTable('matched')" style="font-size:0.75rem; font-weight:800;">المتطابق فقط (<span id="vendor-badge-matched">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="vendor-tab-unlinked" onclick="filterVendorReviewTable('unlinked')" style="font-size:0.75rem; font-weight:800;">غير المرتبط (<span id="vendor-badge-unlinked">0</span>)</button>
							</div>
							<input type="text" id="vendor-review-search" class="form-input" placeholder="🔍 بحث سريع في المسودة..." style="max-width:240px; font-size:0.8rem; padding:0.35rem 0.65rem;" oninput="searchVendorReviewTable(this.value)" />
						</div>

						<!-- Staged Items Table Container -->
						<div class="table-container" style="max-height:260px; overflow-y:auto; border:1px solid var(--border); border-radius:var(--radius-xl);">
							<table class="b2b-table" style="font-size:0.775rem; width:100%;">
								<thead style="position:sticky; top:0; background:var(--surface-sunken); z-index:10;">
									<tr>
										<th style="width:36px; text-align:center;">
											<input type="checkbox" id="vendor-select-all" checked onchange="toggleAllVendorStagedRows(this.checked)" />
										</th>
										<th>اسم الصنف في الملف</th>
										<th>كود SKU</th>
										<th>الصنف المطابق بالكتالوج العام</th>
										<th class="text-center">حالة المطابقة</th>
										<th class="text-center">الكمية</th>
										<th class="text-end">السعر المستهدف</th>
									</tr>
								</thead>
								<tbody id="vendor-review-table-body"></tbody>
							</table>
						</div>

						<div style="font-size:0.775rem; color:var(--text-muted); display:flex; justify-content:space-between; align-items:center;">
							<span>⚠️ لم يتم حفظ أي صنف في قاعدة البيانات بعد. اضغط "تأكيد الاستيراد والحفظ" لاعتماد البيانات.</span>
							<span>الأصناف المحددة: <strong id="vendor-selected-count" style="color:var(--accent);">0</strong></span>
						</div>
					</div>
				</div>

				<!-- Fixed Sticky Footer -->
				<div id="vendor-import-footer" style="flex-shrink:0; display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--border); padding:1rem 1.5rem; background:var(--surface-raised);">
					<div id="vendor-footer-left">
						<button type="button" id="vendor-cancel-btn" class="btn btn-secondary" onclick="handleVendorImportCancelClick()">
							إلغاء
						</button>
					</div>
					<div id="vendor-footer-right" class="row-center-sm">
						<button type="button" id="vendor-back-btn" class="btn btn-secondary" style="display:none;" onclick="backToVendorImportConfig()">
							← الرجوع لضبط الأعمدة
						</button>
						<button type="button" id="vendor-start-btn" class="btn btn-primary" style="font-weight:800; padding:0.6rem 1.5rem;" onclick="startVendorAsyncImport()">
							بدء المعالجة والمطابقة الذكية 🚀
						</button>
						<button type="button" id="vendor-commit-btn" class="btn btn-primary" style="display:none; font-weight:800; padding:0.6rem 1.75rem; background:#10b981; border-color:#10b981;" onclick="commitVendorStagedImport()">
							💾 تأكيد الاستيراد والحفظ النهائي في قائمة المنتجات
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- MODAL 3: Providing Organizations & Offers Modal -->
		<div id="providers-modal" class="modal-overlay hidden">
			<div class="card" style="max-width:860px; width:100%; max-height:85vh; overflow-y:auto; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.25rem;">
					<div>
						<h3 id="providers-modal-title" class="text-xl fw-900 text-primary m-0">
							عروض الموردين والمنظمات المتوفرة
						</h3>
						<p id="providers-modal-subtitle" style="color:var(--text-muted); font-size:0.85rem; margin:0.25rem 0 0 0;"></p>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closeProvidersModal()">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<div id="providers-modal-content">
					<div style="padding:2rem; text-align:center; color:var(--text-muted);">
						⏳ جاري تحميل عروض المنظمات والأسعار المتاحة...
					</div>
				</div>
			</div>
		</div>

		<!-- JavaScript for all-in-one Saving Products operations -->
		<script>
			function openCreateModal() {
				document.getElementById('modal-title').textContent = 'إضافة منتج توفير جديد';
				document.getElementById('saving-product-form').action = '/vendor/saving-products';
				document.getElementById('form-saving-id').value = '';
				document.getElementById('form-name-product').value = '';
				document.getElementById('form-sku').value = '';
				document.getElementById('form-qty').value = '';
				document.getElementById('form-price').value = '';
				clearSelectedProduct();
				if (window.openModal) {
					window.openModal('saving-product-modal');
				} else {
					const el = document.getElementById('saving-product-modal');
					if (el) {
						el.classList.remove('hidden');
						el.style.display = 'flex';
					}
				}
			}

			function openEditModalFromRow(id) {
				const row = document.querySelector(`.saving-row[data-id="${id}"]`);
				if (!row) return;

				document.getElementById('modal-title').textContent = 'تعديل منتج التوفير وتعيين الربط';
				document.getElementById('saving-product-form').action = `/vendor/saving-products/${id}/update`;
				document.getElementById('form-saving-id').value = id;
				document.getElementById('form-name-product').value = row.dataset.name || '';
				document.getElementById('form-sku').value = row.dataset.sku || '';
				document.getElementById('form-qty').value = row.dataset.qty || '';
				document.getElementById('form-price').value = row.dataset.price || '';

				const prodId = row.dataset.productId;
				const prodName = row.dataset.productName;
				if (prodId && prodId !== '') {
					selectCatalogProduct(prodId, prodName);
				} else {
					clearSelectedProduct();
				}

				if (window.openModal) {
					window.openModal('saving-product-modal');
				} else {
					const el = document.getElementById('saving-product-modal');
					if (el) {
						el.classList.remove('hidden');
						el.style.display = 'flex';
					}
				}
			}

			function closeCreateModal() {
				if (window.closeModal) {
					window.closeModal('saving-product-modal');
				} else {
					const el = document.getElementById('saving-product-modal');
					if (el) {
						el.classList.add('hidden');
						el.style.display = 'none';
					}
				}
			}

			function selectCatalogProduct(id, name) {
				document.getElementById('form-product-id').value = id;
				document.getElementById('selected-product-label').textContent = `🔗 ${name}`;
				document.getElementById('selected-product-box').style.display = 'flex';
				document.getElementById('search-product-container').style.display = 'none';
				document.getElementById('product-search-dropdown').style.display = 'none';
				document.getElementById('product-search-input').value = '';
			}

			function clearSelectedProduct() {
				document.getElementById('form-product-id').value = '';
				document.getElementById('selected-product-label').textContent = '';
				document.getElementById('selected-product-box').style.display = 'none';
				document.getElementById('search-product-container').style.display = 'block';
			}

			let searchDebounce = null;
			function searchCatalogProductsLive(query) {
				clearTimeout(searchDebounce);
				const dropdown = document.getElementById('product-search-dropdown');
				if (!query || query.trim().length < 2) {
					dropdown.style.display = 'none';
					return;
				}

				searchDebounce = setTimeout(() => {
					fetch('/vendor/saving-products/search-products?q=' + encodeURIComponent(query.trim()))
						.then(r => r.json())
						.then(items => {
							if (!items || items.length === 0) {
								dropdown.innerHTML = '<div style="padding:0.75rem 1rem; color:var(--text-muted); font-size:0.8rem; text-align:center;">لم يتم العثور على نتائج بالكتالوج</div>';
								dropdown.style.display = 'block';
								return;
							}

							let html = '';
							items.forEach(it => {
								const skuText = it.sku ? ('<span style="font-size:0.75rem; color:var(--text-muted); margin-inline-start:0.5rem;">(' + it.sku + ')</span>') : '';
								const safeName = (it.name || '').replace(/'/g, "\\'");
								html += '<div style="padding:0.6rem 0.85rem; border-bottom:1px solid var(--border); cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition:background 0.15s;" ' +
									'onmouseover="this.style.background=\'var(--surface-sunken)\'" onmouseout="this.style.background=\'\'" ' +
									'onclick="selectCatalogProduct(\'' + it.id + '\', \'' + safeName + '\')">' +
									'<div><strong style="color:var(--text); font-size:0.85rem;">' + it.name + '</strong>' + skuText + '</div>' +
									'<span class="badge badge-emerald text-xs">اختيار</span></div>';
							});
							dropdown.innerHTML = html;
							dropdown.style.display = 'block';
						})
						.catch(() => {
							dropdown.style.display = 'none';
						});
				}, 200);
			}

			function confirmDeleteSavingProduct(id) {
				if (confirm("هل أنت متأكد من حذف هذا المنتج من قائمة منتجات المساعدة؟")) {
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = '/vendor/saving-products/' + id + '/delete';
					document.body.appendChild(form);
					form.submit();
				}
			}

			function openImportModal() {
				document.getElementById('import-filename-preview').innerHTML = '';
				document.getElementById('import-file-input').value = '';
				if (window.openModal) {
					window.openModal('saving-import-modal');
				} else {
					const el = document.getElementById('saving-import-modal');
					if (el) {
						el.classList.remove('hidden');
						el.style.display = 'flex';
					}
				}
			}

			function closeImportModal() {
				if (window.closeModal) {
					window.closeModal('saving-import-modal');
				} else {
					const el = document.getElementById('saving-import-modal');
					if (el) {
						el.classList.add('hidden');
						el.style.display = 'none';
					}
				}
			}

			function handleImportFileSelect(input) {
				if (!input.files || !input.files[0]) return;
				const f = input.files[0];
				const size = (f.size / 1024 / 1024).toFixed(2);
				document.getElementById('import-filename-preview').innerHTML = '✓ تم اختيار: ' + f.name + ' (' + size + ' MB)';

				const panel = document.getElementById('vendor-import-columns-panel');
				const loadingEl = document.getElementById('vendor-import-columns-loading');
				const formGrid = document.getElementById('vendor-import-columns-grid');
				const previewTableEl = document.getElementById('vendor-import-preview-table-container');

				if (panel) panel.style.display = 'block';
				if (loadingEl) loadingEl.style.display = 'block';
				if (formGrid) formGrid.style.display = 'none';
				if (previewTableEl) previewTableEl.innerHTML = '';

				const formData = new FormData();
				formData.append('file', f);

				fetch('/vendor/saving-products/preview-columns', {
					method: 'POST',
					body: formData,
				})
				.then(r => r.json())
				.then(data => {
					if (loadingEl) loadingEl.style.display = 'none';
					if (!data || !data.success || !data.headers || data.headers.length === 0) {
						if (formGrid) formGrid.style.display = 'none';
						alert(data.error || 'تعذر قراءة أعمدة الملف المرفوع. تأكد من سلامة ملف Excel.');
						return;
					}

					if (formGrid) formGrid.style.display = 'grid';
					renderImportColumnDropdowns('vendor', data.headers, data.detected);
					renderImportSamplePreview('vendor', data.headers, data.sample_rows, data.detected);
				})
				.catch(err => {
					if (loadingEl) loadingEl.style.display = 'none';
					console.error('preview error', err);
				});
			}

			function renderImportColumnDropdowns(prefix, headers, detected) {
				const selects = [
					{ id: prefix + '-col-name', selected: detected.name_col },
					{ id: prefix + '-col-sku', selected: detected.sku_col },
					{ id: prefix + '-col-qty', selected: detected.qty_col },
					{ id: prefix + '-col-price', selected: detected.price_col }
				];

				selects.forEach(s => {
					const el = document.getElementById(s.id);
					if (!el) return;
					el.innerHTML = '<option value="-1">-- غير محدد (تجاهل) --</option>';
					headers.forEach((h, idx) => {
						const colLetter = String.fromCharCode(65 + idx);
						const opt = document.createElement('option');
						opt.value = idx;
						opt.textContent = `العمود ${colLetter}: [${h}]`;
						if (idx === s.selected) {
							opt.selected = true;
						}
						el.appendChild(opt);
					});

					el.onchange = function() {
						const curDetected = {
							name_col: parseInt(document.getElementById(prefix + '-col-name')?.value || -1),
							sku_col: parseInt(document.getElementById(prefix + '-col-sku')?.value || -1),
							qty_col: parseInt(document.getElementById(prefix + '-col-qty')?.value || -1),
							price_col: parseInt(document.getElementById(prefix + '-col-price')?.value || -1)
						};
						if (window[prefix + '_last_sample_rows']) {
							renderImportSamplePreview(prefix, headers, window[prefix + '_last_sample_rows'], curDetected);
						}
					};
				});
			}

			function renderImportSamplePreview(prefix, headers, sampleRows, detected) {
				window[prefix + '_last_sample_rows'] = sampleRows;
				const container = document.getElementById(prefix + '-import-preview-table-container');
				if (!container || !sampleRows || sampleRows.length === 0) return;

				let html = '<div style="margin-top:1rem; border-top:1px solid var(--border); padding-top:0.75rem;">';
				html += '<div style="font-size:0.8rem; font-weight:800; color:var(--text); margin-bottom:0.5rem; display:flex; justify-content:space-between; align-items:center;">';
				html += '<span>👀 معاينة أعمدة الملف والبيانات الحقيقية:</span>';
				html += '<span style="font-size:0.75rem; color:var(--text-muted);">أول ' + sampleRows.length + ' صفوف</span>';
				html += '</div>';
				html += '<div class="table-container" style="max-height:160px; overflow:auto; border-radius:var(--radius-md); border:1px solid var(--border);"><table class="b2b-table" style="font-size:0.75rem; width:100%;"><thead><tr>';

				headers.forEach((h, idx) => {
					let tag = '';
					if (idx === detected.name_col) tag = ' <span class="badge badge-emerald" style="font-size:9px; margin-inline-start:3px;">اسم الصنف ✓</span>';
					else if (idx === detected.sku_col) tag = ' <span class="badge badge-sky" style="font-size:9px; margin-inline-start:3px;">كود SKU ✓</span>';
					else if (idx === detected.qty_col) tag = ' <span class="badge badge-amber" style="font-size:9px; margin-inline-start:3px;">الكمية ✓</span>';
					else if (idx === detected.price_col) tag = ' <span class="badge badge-purple" style="font-size:9px; margin-inline-start:3px;">السعر ✓</span>';
					const colLetter = String.fromCharCode(65 + idx);
					html += `<th style="padding:0.4rem 0.6rem; white-space:nowrap;">${colLetter}: ${h}${tag}</th>`;
				});
				html += '</tr></thead><tbody>';

				sampleRows.forEach(row => {
					html += '<tr>';
					headers.forEach((_, idx) => {
						const cellVal = (idx < row.length) ? row[idx] : '';
						let cellStyle = 'padding:0.4rem 0.6rem; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;';
						if (idx === detected.name_col) cellStyle += ' font-weight:700; color:var(--text);';
						html += `<td style="${cellStyle}">${cellVal}</td>`;
					});
					html += '</tr>';
				});

				html += '</tbody></table></div></div>';
				container.innerHTML = html;
			}

			let vendorActiveSessionId = null;
			let vendorStagedData = null;
			let vendorCurrentTab = 'all';
			let vendorPollInterval = null;

			function startVendorAsyncImport() {
				const input = document.getElementById('import-file-input');
				if (!input.files || input.files.length === 0) {
					alert("يرجى اختيار ملف Excel أو CSV أولاً.");
					return;
				}

				const file = input.files[0];
				const formData = new FormData();
				formData.append('file', file);

				const colName = document.getElementById('vendor-col-name')?.value || '';
				const colSKU = document.getElementById('vendor-col-sku')?.value || '';
				const colQty = document.getElementById('vendor-col-qty')?.value || '';
				const colPrice = document.getElementById('vendor-col-price')?.value || '';
				const strat = document.querySelector('input[name="vendor_match_strategy"]:checked')?.value || 'smart_auto';

				formData.append('col_name', colName);
				formData.append('col_sku', colSKU);
				formData.append('col_qty', colQty);
				formData.append('col_price', colPrice);
				formData.append('match_strategy', strat);

				// Switch UI to Step 2: Progress
				showVendorImportStep('progress');
				document.getElementById('vendor-progress-bar').style.width = '10%';
				document.getElementById('vendor-progress-percent').textContent = '10%';
				document.getElementById('vendor-progress-counter').textContent = '0 / ...';
				document.getElementById('vendor-progress-phase').textContent = 'جاري رفع الملف وبدء المعالجة الذكية على السيرفر...';

				fetch('/vendor/saving-products/import/start', {
					method: 'POST',
					body: formData,
				})
				.then(r => r.json())
				.then(res => {
					if (!res.success) {
						alert(res.error || 'حدث خطأ أثناء بدء المعالجة.');
						showVendorImportStep('config');
						return;
					}
					vendorActiveSessionId = res.session_id;
					pollVendorImportProgress(res.session_id);
				})
				.catch(err => {
					console.error('start import error', err);
					alert('حدث خطأ في الاتصال بالسيرفر أثناء بدء الاستيراد.');
					showVendorImportStep('config');
				});
			}

			function pollVendorImportProgress(sessionId) {
				if (vendorPollInterval) clearInterval(vendorPollInterval);

				vendorPollInterval = setInterval(() => {
					fetch('/vendor/saving-products/import/session/' + sessionId + '/progress')
					.then(r => r.json())
					.then(sess => {
						if (!sess || !sess.success) {
							clearInterval(vendorPollInterval);
							alert(sess.error || 'فشلت معالجة الجلسة.');
							showVendorImportStep('config');
							return;
						}

						if (sess.status === 'failed') {
							clearInterval(vendorPollInterval);
							alert('فشلت المعالجة: ' + (sess.error_message || 'خطأ غير معروف'));
							showVendorImportStep('config');
							return;
						}

						// Update progress UI
						const pct = Math.max(10, Math.min(100, sess.progress || 10));
						document.getElementById('vendor-progress-bar').style.width = pct + '%';
						document.getElementById('vendor-progress-percent').textContent = pct + '%';
						document.getElementById('vendor-progress-counter').textContent = (sess.processed_rows || 0) + ' / ' + (sess.total_rows || 0) + ' صنف';
						if (sess.progress_phase) {
							document.getElementById('vendor-progress-phase').textContent = sess.progress_phase;
						}

						if (sess.status === 'ready') {
							clearInterval(vendorPollInterval);
							vendorStagedData = sess;
							renderVendorStagedReview(sess);
						}
					})
					.catch(err => {
						console.error('poll progress error', err);
					});
				}, 450);
			}

			function showVendorImportStep(step) {
				const configStep = document.getElementById('vendor-import-step-config');
				const progressStep = document.getElementById('vendor-import-step-progress');
				const reviewStep = document.getElementById('vendor-import-step-review');

				const subtitle = document.getElementById('vendor-import-modal-subtitle');
				const icon = document.getElementById('vendor-import-modal-icon');

				const startBtn = document.getElementById('vendor-start-btn');
				const commitBtn = document.getElementById('vendor-commit-btn');
				const backBtn = document.getElementById('vendor-back-btn');
				const cancelBtn = document.getElementById('vendor-cancel-btn');

				configStep.style.display = (step === 'config') ? 'block' : 'none';
				progressStep.style.display = (step === 'progress') ? 'block' : 'none';
				reviewStep.style.display = (step === 'review') ? 'block' : 'none';

				if (step === 'config') {
					subtitle.textContent = 'الخطوة 1 من 3: اختيار الملف وتعيين الأعمدة';
					icon.textContent = '📥';
					startBtn.style.display = 'inline-flex';
					commitBtn.style.display = 'none';
					backBtn.style.display = 'none';
					cancelBtn.textContent = 'إلغاء';
				} else if (step === 'progress') {
					subtitle.textContent = 'الخطوة 2 من 3: المعالجة والمطابقة في الخلفية';
					icon.textContent = '⚡';
					startBtn.style.display = 'none';
					commitBtn.style.display = 'none';
					backBtn.style.display = 'none';
					cancelBtn.textContent = 'إلغاء المعالجة';
				} else if (step === 'review') {
					subtitle.textContent = 'الخطوة 3 من 3: مراجعة المسودة وتأكيد الحفظ النهائي';
					icon.textContent = '📋';
					startBtn.style.display = 'none';
					commitBtn.style.display = 'inline-flex';
					backBtn.style.display = 'inline-flex';
					cancelBtn.textContent = 'تفريغ وإلغاء المسودة';
				}
			}

			function renderVendorStagedReview(sess) {
				showVendorImportStep('review');

				document.getElementById('vendor-review-total-count').textContent = sess.total_rows || (sess.items ? sess.items.length : 0);
				document.getElementById('vendor-review-matched-count').textContent = sess.matched_rows || 0;
				document.getElementById('vendor-review-unlinked-count').textContent = sess.unlinked_rows || 0;
				document.getElementById('vendor-review-total-qty').textContent = Number(sess.total_quantity || 0).toLocaleString();

				document.getElementById('vendor-badge-all').textContent = sess.items ? sess.items.length : 0;
				document.getElementById('vendor-badge-matched').textContent = sess.matched_rows || 0;
				document.getElementById('vendor-badge-unlinked').textContent = sess.unlinked_rows || 0;

				renderVendorReviewRows(sess.items || []);
			}

			function renderVendorReviewRows(items) {
				const tbody = document.getElementById('vendor-review-table-body');
				if (!tbody) return;

				const searchVal = (document.getElementById('vendor-review-search')?.value || '').trim().toLowerCase();

				let html = '';
				let selectedCount = 0;

				items.forEach((item, idx) => {
					const isMatched = !!item.product_id;
					if (vendorCurrentTab === 'matched' && !isMatched) return;
					if (vendorCurrentTab === 'unlinked' && isMatched) return;

					if (searchVal) {
						const n = (item.name_product || '').toLowerCase();
						const s = (item.sku || '').toLowerCase();
						const m = (item.master_product_name || '').toLowerCase();
						if (!n.includes(searchVal) && !s.includes(searchVal) && !m.includes(searchVal)) {
							return;
						}
					}

					if (item.included !== false) selectedCount++;

					let matchBadge = '<span class="badge badge-amber" style="font-size:10px;">غير مرتبط (جديد)</span>';
					if (isMatched) {
						if (item.match_type === 'exact_sku' || item.match_type === 'clean_sku') {
							matchBadge = '<span class="badge badge-emerald" style="font-size:10px;">كود SKU ✓</span>';
						} else if (item.match_type === 'exact_name' || item.match_type === 'norm_name') {
							matchBadge = '<span class="badge badge-emerald" style="font-size:10px;">اسم متطابق ✓</span>';
						} else if (item.match_type === 'core_name') {
							matchBadge = '<span class="badge badge-sky" style="font-size:10px;">اسم مجرد ✓</span>';
						} else {
							const conf = Math.round((item.confidence || 0) * 100);
							matchBadge = '<span class="badge badge-purple" style="font-size:10px;">تشابه ' + conf + '% ✓</span>';
						}
					}

					const masterDisplay = item.master_product_name ? 
						('<strong style="color:var(--emerald-600);">' + item.master_product_name + '</strong>' + (item.master_product_sku ? ' <code class="text-xs text-muted">(' + item.master_product_sku + ')</code>' : '')) : 
						'<span style="color:var(--text-muted); font-size:0.75rem;">— صنف حر غير مقيد —</span>';

					const checkedAttr = (item.included !== false) ? 'checked' : '';

					html += '<tr style="border-bottom:1px solid var(--border);">' +
						'<td style="text-align:center;">' +
							'<input type="checkbox" class="vendor-staged-row-cb" data-idx="' + idx + '" ' + checkedAttr + ' onchange="updateVendorRowInclusion(' + idx + ', this.checked)" />' +
						'</td>' +
						'<td><strong style="color:var(--text);">' + (item.name_product || '') + '</strong></td>' +
						'<td><code class="text-xs">' + (item.sku || '—') + '</code></td>' +
						'<td>' + masterDisplay + '</td>' +
						'<td class="text-center">' + matchBadge + '</td>' +
						'<td class="text-center tabular-nums font-bold">' + (item.quantity || 0) + '</td>' +
						'<td class="text-end tabular-nums font-bold" style="color:var(--accent);">' + (item.price || '0.00') + ' ج.م</td>' +
						'</tr>';
				});

				if (!html) {
					html = '<tr><td colspan="7" style="text-align:center; padding:2rem; color:var(--text-muted);">لا توجد أصناف تطابق الفلتر الحالي.</td></tr>';
				}

				tbody.innerHTML = html;
				document.getElementById('vendor-selected-count').textContent = selectedCount;
			}

			function updateVendorRowInclusion(idx, included) {
				if (vendorStagedData && vendorStagedData.items && vendorStagedData.items[idx]) {
					vendorStagedData.items[idx].included = included;
				}
				let count = 0;
				if (vendorStagedData && vendorStagedData.items) {
					vendorStagedData.items.forEach(it => { if (it.included !== false) count++; });
				}
				document.getElementById('vendor-selected-count').textContent = count;
			}

			function toggleAllVendorStagedRows(checked) {
				if (vendorStagedData && vendorStagedData.items) {
					vendorStagedData.items.forEach(it => { it.included = checked; });
				}
				const cbs = document.querySelectorAll('.vendor-staged-row-cb');
				cbs.forEach(cb => cb.checked = checked);
				document.getElementById('vendor-selected-count').textContent = checked && vendorStagedData && vendorStagedData.items ? vendorStagedData.items.length : 0;
			}

			function filterVendorReviewTable(tab) {
				vendorCurrentTab = tab;
				['all', 'matched', 'unlinked'].forEach(t => {
					const btn = document.getElementById('vendor-tab-' + t);
					if (btn) {
						if (t === tab) {
							btn.style.background = 'var(--surface-raised)';
							btn.style.color = 'var(--accent)';
						} else {
							btn.style.background = 'transparent';
							btn.style.color = 'var(--text-muted)';
						}
					}
				});
				if (vendorStagedData && vendorStagedData.items) {
					renderVendorReviewRows(vendorStagedData.items);
				}
			}

			function searchVendorReviewTable(val) {
				if (vendorStagedData && vendorStagedData.items) {
					renderVendorReviewRows(vendorStagedData.items);
				}
			}

			function commitVendorStagedImport() {
				if (!vendorActiveSessionId) return;

				const btn = document.getElementById('vendor-commit-btn');
				btn.disabled = true;
				btn.textContent = '⏳ جاري الحفظ النهائي في قاعدة البيانات...';

				fetch('/vendor/saving-products/import/session/' + vendorActiveSessionId + '/commit', {
					method: 'POST',
				})
				.then(r => r.json())
				.then(res => {
					if (!res.success) {
						alert(res.error || 'فشل حفظ الأصناف.');
						btn.disabled = false;
						btn.textContent = '💾 تأكيد الاستيراد والحفظ النهائي في قائمة المنتجات';
						return;
					}
					alert(res.message || 'تم استيراد وحفظ الأصناف بنجاح!');
					window.location.reload();
				})
				.catch(err => {
					console.error('commit error', err);
					alert('حدث خطأ في الاتصال أثناء تأكيد الحفظ.');
					btn.disabled = false;
					btn.textContent = '💾 تأكيد الاستيراد والحفظ النهائي في قائمة المنتجات';
				});
			}

			function handleVendorImportCancelClick() {
				if (vendorPollInterval) clearInterval(vendorPollInterval);

				if (vendorActiveSessionId) {
					fetch('/vendor/saving-products/import/session/' + vendorActiveSessionId + '/cancel', { method: 'POST' }).catch(() => {});
					vendorActiveSessionId = null;
					vendorStagedData = null;
				}
				closeImportModal();
			}

			function backToVendorImportConfig() {
				if (vendorPollInterval) clearInterval(vendorPollInterval);
				showVendorImportStep('config');
			}

			function openProvidersModal(productId, productName) {
				document.getElementById('providers-modal-subtitle').textContent = 'الصنف: ' + productName;
				document.getElementById('providers-modal-content').innerHTML = '<div style="padding:2rem; text-align:center; color:var(--text-muted);">⏳ جاري استرجاع عروض الموردين والأسعار...</div>';
				
				if (window.openModal) {
					window.openModal('providers-modal');
				} else {
					const el = document.getElementById('providers-modal');
					if (el) {
						el.classList.remove('hidden');
						el.style.display = 'flex';
					}
				}

				fetch('/vendor/saving-products/providers/' + productId)
					.then(r => r.json())
					.then(providers => {
						if (!providers || providers.length === 0) {
							document.getElementById('providers-modal-content').innerHTML = '<div style="padding:2rem; text-align:center; color:var(--text-muted); font-size:0.9rem;">لا توجد منظمات أو موردين آخرين مسجلين لهذا الصنف حالياً في الكتالوج.</div>';
							return;
						}

						let html = '<table class="table" style="width:100%; border-collapse:collapse; font-size:0.875rem;"><thead><tr style="background:var(--surface-sunken); border-bottom:2px solid var(--border); text-align:start; font-size:0.775rem; color:var(--text-muted);"><th class="p-sm">المورد / المنظمة</th><th class="p-sm">العبوة / التنويعة</th><th class="p-sm text-center">المخزون</th><th class="p-sm text-center">السعر قبل الخصم</th><th class="p-sm text-center">الخصم</th></tr></thead><tbody>';

						providers.forEach(p => {
							const branchText = p.branch_name ? ('<div class="text-xs text-muted">' + p.branch_name + '</div>') : '';
							const skuText = p.sku ? ('<code class="text-xs">' + p.sku + '</code>') : '';
							const stockBadge = p.stock_quantity > 0 ? 'badge-emerald' : 'badge-secondary';
							html += '<tr style="border-bottom:1px solid var(--border);">' +
								'<td class="p-sm"><strong class="text-primary">' + (p.org_name || 'مورد معتمد') + '</strong>' + branchText + '</td>' +
								'<td class="p-sm"><div>' + (p.variant_name || 'العبوة القياسية') + '</div>' + skuText + '</td>' +
								'<td class="p-sm text-center tabular-nums"><span class="badge ' + stockBadge + '">' + p.stock_quantity + ' عبوة</span></td>' +
								'<td class="p-sm text-center tabular-nums">' + p.price + ' ج.م</td>' +
								'<td class="p-sm text-center tabular-nums"><span class="badge badge-sky">' + p.discount + ' ج.م</span></td>' +
								'</tr>';
						});

						html += '</tbody></table>';
						document.getElementById('providers-modal-content').innerHTML = html;
					})
					.catch(() => {
						document.getElementById('providers-modal-content').innerHTML = '<div style="padding:2rem; text-align:center; color:var(--danger-text);">حدث خطأ أثناء تحميل عروض الموردين.</div>';
					});
			}

			function closeProvidersModal() {
				if (window.closeModal) {
					window.closeModal('providers-modal');
				} else {
					const el = document.getElementById('providers-modal');
					if (el) {
						el.classList.add('hidden');
						el.style.display = 'none';
					}
				}
			}

			function filterSavingProductsTable(query) {
				const term = (query || '').trim().toLowerCase();
				const rows = document.querySelectorAll('.saving-row');
				rows.forEach(row => {
					const name = (row.dataset.name || '').toLowerCase();
					const sku = (row.dataset.sku || '').toLowerCase();
					const pName = (row.dataset.productName || '').toLowerCase();
					if (term === '' || name.includes(term) || sku.includes(term) || pName.includes(term)) {
						row.style.display = '';
					} else {
						row.style.display = 'none';
					}
				});
			}
		</script>
	}
}
