package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorSavingPageData struct {
	Items        []*catalog.SavingProductEnriched
	Stats        *catalog.SavingProductStats
	SearchQuery  string
	FilterStatus string
	NoticeType   string
	NoticeMsg    string
	Pagination   components.PaginationProps
}

func savingFilterBorder(current, target string) string {
	if current == target {
		return "var(--accent)"
	}
	return "var(--border)"
}

func savingProductIDStr(pid *int64) string {
	if pid != nil && *pid > 0 {
		return fmt.Sprintf("%d", *pid)
	}
	return ""
}

// VendorSavingProductsPage renders the comprehensive all-in-one saving products workspace.
templ VendorSavingProductsPage(data VendorSavingPageData, lang, dir string) {
	@layouts.VendorShell("منتجات التوفير والمساعدة للمنشأة | Saving Products", "saving_products", lang, dir) {
		<div class="page-container">

			<!-- Notice / Toast Banner -->
			if data.NoticeMsg != "" {
				<div
					class={ "alert mb-4",
						templ.KV("alert-success", data.NoticeType != "error"),
						templ.KV("alert-danger", data.NoticeType == "error") }
					role="alert"
				>
					{ data.NoticeMsg }
				</div>
			}

			<!-- Top Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconBuilding("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">
								منتجات التوفير والمساعدة للمنشأة
							</h1>
							<p class="text-sm text-secondary m-0 mt-1">
								إدارة واستيراد ومطابقة منتجات التوفير مع الكتالوج ومتابعة عروض الموردين والأسعار
							</p>
						</div>
					</div>

					<!-- Top Action Buttons -->
					<div class="d-flex items-center gap-2 flex-wrap">
						<button
							type="button"
							class="btn btn-primary font-bold text-xs px-3 py-2"
							data-modal-open="saving-product-modal"
							onclick="openCreateModal()"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة منتج توفير جديد</span>
						</button>

						<a
							href="/vendor/saving-products/import"
							class="btn btn-secondary font-bold text-xs px-3 py-2 text-decoration-none"
						>
							@components.IconUpload("icon-xs")
							<span>استيراد من ملف (Excel / CSV)</span>
						</a>

						<a
							href="/vendor/saving-products/export"
							class="btn btn-secondary font-bold text-xs px-3 py-2 text-decoration-none"
							download
						>
							@components.IconDownload("icon-xs")
							<span>تصدير Excel </span>
						</a>

						if data.Stats != nil && data.Stats.CountAll > 0 {
							<form
								method="POST"
								action="/vendor/saving-products/delete-all"
								onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف جميع منتجات التوفير الخاصة بمنشأتك نهائياً؟ لا يمكن التراجع عن هذه العملية.');"
								class="m-0 d-inline"
							>
								<button
									type="submit"
									class="btn btn-secondary font-bold text-xs px-3 py-2 text-danger"
									title="حذف كافة منتجات التوفير المسجلة للمنشأة فقط"
								>
									@components.IconTrash("icon-xs")
									<span>حذف كافة منتجات التوفير</span>
								</button>
							</form>
						}
					</div>
				</div>
			</div>

			<!-- 3 Status Metric Cards -->
			<div class="dashboard-stat-grid mb-6">
				
				<!-- 1. All Products -->
				<a
					href="/vendor/saving-products?filter=all"
					class="stat-card-3d text-decoration-none"
				>
					<div class="stat-card-label">جميع المنتجات (الكل)</div>
					<div class="stat-card-value text-primary tabular-nums">
						if data.Stats != nil {
							{ fmt.Sprintf("%d", data.Stats.CountAll) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">إجمالي الأصناف المسجلة</span>
				</a>

				<!-- 2. Linked Products -->
				<a
					href="/vendor/saving-products?filter=linked"
					class="stat-card-3d text-decoration-none"
				>
					<div class="stat-card-label text-sky">المنتجات المرتبطة</div>
					<div class="stat-card-value text-sky tabular-nums">
						if data.Stats != nil {
							{ fmt.Sprintf("%d", data.Stats.CountLinked) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">مطابقة ومعتمدة بالكتالوج</span>
				</a>

				<!-- 3. Unlinked Products -->
				<a
					href="/vendor/saving-products?filter=unlinked"
					class="stat-card-3d text-decoration-none"
				>
					<div class="stat-card-label text-warning">منتجات غير مرتبطة</div>
					<div class="stat-card-value text-warning tabular-nums">
						if data.Stats != nil {
							{ fmt.Sprintf("%d", data.Stats.CountUnlinked) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">تحتاج مطابقة وربط</span>
				</a>

			</div>

			<!-- Main Content Table Card -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				
				<!-- Top Bar: Result Count & Search Input -->
				<div class="p-4 px-6 border-b flex-between items-center flex-wrap gap-4">
					<div class="text-sm font-extrabold text-primary">
						إجمالي النتائج: <strong class="text-brand tabular-nums">{ fmt.Sprintf("%d", len(data.Items)) }</strong>
					</div>

					<div class="position-relative" class="w-80 max-w-full">
						<input
							type="text"
							id="saving-products-search"
							value={ data.SearchQuery }
							placeholder="بحث باسم المنتج المحفوظ أو SKU..."
							class="form-input text-xs w-full"
							oninput="filterSavingProductsTable(this.value)"
						/>
					</div>
				</div>

				<!-- Saving Products Data Table -->
				if len(data.Items) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconBuilding("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد منتجات مساعدة مسجلة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">يمكنك إضافة منتجات يدوياً أو استيراد كشف Excel/CSV للبحث التلقائي ومطابقة الأصناف مع عروض الموردين.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0" id="saving-products-table">
							<thead>
								<tr class="bg-surface-sunken border-b-2 text-start text-xs text-muted uppercase">
									<th class="w-14">#</th>
									<th class="font-extrabold">ORG PRODUCT NAME</th>
									<th class="font-extrabold">رمز SKU</th>
									<th class="font-extrabold text-center">المنتج المرتبط بالنظام</th>
									<th class="font-extrabold text-center">PROVIDING ORGS COUNT</th>
									<th class="font-extrabold text-center">الكمية</th>
									<th class="font-extrabold text-center">السعر</th>
									<th class="font-extrabold text-end">الإجمالي</th>
									<th class="font-extrabold text-center">العمليات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Items {
									<tr
										class="saving-row"
										data-id={ fmt.Sprintf("%d", item.ID) }
										data-name={ item.NameProduct }
										data-sku={ item.SKU }
										data-qty={ fmt.Sprintf("%.2f", item.Quantity) }
										data-price={ item.Price.String() }
										data-product-id={ savingProductIDStr(item.ProductID) }
										data-product-name={ item.LinkedProductName.Get(i18n.Lang(lang)) }
										class="border-b text-sm"
									>
										<!-- # ID -->
										<td class="font-bold text-muted" class="tabular-nums">
											#{ fmt.Sprintf("%d", item.ID) }
										</td>

										<!-- Org Product Name -->
										<td class="p-sm">
											<strong class="text-primary font-bold">{ item.NameProduct }</strong>
										</td>

										<!-- SKU -->
										<td class="text-secondary" class="tabular-nums">
											if item.SKU != "" {
												<code>{ item.SKU }</code>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Linked Product Badge / Button -->
										<td class="text-center">
											if item.ProductID != nil && *item.ProductID > 0 {
												<button
													type="button"
													class="badge badge-emerald"
													
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openEditModalFromRow(%d)", item.ID)} }
													title="انقر لتعديل الصنف المرتبط"
												>
													<span>@components.IconExternalLink("icon-sm")</span>
													<span>{ item.LinkedProductName.Get(i18n.Lang(lang)) }</span>
												</button>
											} else {
												<button
													type="button"
													class="badge badge-amber"
													
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openEditModalFromRow(%d)", item.ID)} }
													title="انقر للبحث والربط بصنف معتمد في الكتالوج"
												>
													<span>@components.IconAlert("icon-sm")</span>
													<span>غير مرتبط (انقر للربط)</span>
												</button>
											}
										</td>

										<!-- Providing Orgs Count -->
										<td class="text-center">
											if item.ProductID != nil && *item.ProductID > 0 {
												if item.ProvidingOrgsCount > 0 {
													<button
														type="button"
														class="badge badge-indigo"
														
														onclick={ templ.ComponentScript{Call: fmt.Sprintf("openProvidersModal(%d, '%s')", *item.ProductID, item.LinkedProductName.Get(i18n.Lang(lang)))} }
													>
														<span>@components.IconBuilding("icon-sm")</span>
														<span>{ fmt.Sprintf("%d المنظمات", item.ProvidingOrgsCount) }</span>
													</button>
												} else {
													<span class="text-muted text-sm">0</span>
												}
											} else {
												<span class="text-muted text-sm">-</span>
											}
										</td>

										<!-- Qty -->
										<td class="text-center" class="tabular-nums">
											if item.Quantity > 0 {
												<strong class="text-primary">{ fmt.Sprintf("%.0f", item.Quantity) }</strong>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Price -->
										<td class="text-center" class="tabular-nums">
											if item.Price.IsPositive() {
												<span >{ item.Price.String() } EGP</span>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Total Value -->
										<td class="text-end" class="tabular-nums">
											if item.TotalValue.IsPositive() {
												<strong >{ item.TotalValue.String() } EGP</strong>
											} else {
												<span class="text-muted">-</span>
											}
										</td>

										<!-- Actions (View Providers / Edit / Delete) -->
										<td class="text-center">
											<div >
												if item.ProductID != nil && *item.ProductID > 0 {
													<button
														type="button"
														class="btn btn-secondary btn-sm btn-icon text-accent"
														title="عرض عروض الموردين والأسعار"
														onclick={ templ.ComponentScript{Call: fmt.Sprintf("openProvidersModal(%d, '%s')", *item.ProductID, item.LinkedProductName.Get(i18n.Lang(lang)))} }
													>
														@components.IconEye("icon-xs")
													</button>
												}

												<button
													type="button"
													class="btn btn-secondary btn-sm btn-icon"
													title="تعديل المنتج والربط"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("openEditModalFromRow(%d)", item.ID)} }
												>
													@components.IconEdit("icon-xs")
												</button>

												<button
													type="button"
													class="btn btn-secondary btn-sm btn-icon text-danger"
													title="حذف من قائمة المساعدة"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("confirmDeleteSavingProduct(%d)", item.ID)} }
												>
													@components.IconTrash("icon-xs")
												</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if data.Pagination.TotalCount > 0 {
						@components.B2BPagination(data.Pagination)
					}
				}
			</div>

		</div>

		<!-- MODAL 1: Create / Edit Saving Product Modal -->
		@components.Modal(components.ModalProps{ID: "saving-product-modal", Title: "????? ???? ?????? ????", Size: "md"}) {
			<form method="POST" id="saving-product-form" action="/vendor/saving-products" class="d-flex flex-col gap-4 m-0">
					<input type="hidden" id="form-saving-id" name="id" value="" />
					
					<div class="stack-md">
						
						<!-- Product Name -->
						<div>
							<label class="form-label text-sm fw-700 text-primary">
								اسم الصنف الدوائي للمنظمة <span class="text-danger">*</span>
							</label>
							<input
 type="text"
 id="form-name-product"
 name="name_product"
 required
 placeholder="مثال: بنادول اكسترا 24 قرص"
 class="form-input w-full-rounded"
 
 />
						</div>

						<!-- SKU & Qty Row -->
						<div class="grid-2">
							<div>
								<label class="form-label text-sm fw-700 text-primary">
									رمز SKU (اختياري)
								</label>
								<input
 type="text"
 id="form-sku"
 name="sku"
 placeholder="كود الصنف..."
 class="form-input w-full-rounded"
 
 />
							</div>

							<div>
								<label class="form-label text-sm fw-700 text-primary">
									الكمية المتوفرة
								</label>
								<input
 type="number"
 step="any"
 id="form-qty"
 name="qty"
 placeholder="0"
 class="form-input w-full-rounded"
 
 />
							</div>
						</div>

						<!-- Price Row -->
						<div>
							<label class="form-label text-sm fw-700 text-primary">
								السعر المستهدف / سعر الوحدة (ج.م)
							</label>
							<input
 type="number"
 step="0.01"
 id="form-price"
 name="price"
 placeholder="0.00"
 class="form-input w-full-rounded"
 
 />
						</div>

						<!-- Linked Catalog Product Picker -->
						<div class="bg-surface-sunken p-4 rounded-2xl border d-flex flex-col gap-2">
							<label class="font-extrabold text-primary text-sm">
								ربط الصنف بالكتالوج المعتمد للمنصة
							</label>
							
							<input type="hidden" id="form-product-id" name="product_id" value="" />
							
							<div id="selected-product-box" class="d-none flex-between items-center bg-surface-raised p-2.5 rounded-lg border">
								<span id="selected-product-label" class="font-extrabold text-accent text-sm"></span>
								<button type="button" class="btn btn-secondary btn-sm" onclick="clearSelectedProduct()" class="btn btn-secondary btn-sm text-xs text-danger font-bold">
									إلغاء الربط 
								</button>
							</div>

							<div id="search-product-container" class="relative">
								<input
									type="text"
									id="product-search-input"
									placeholder="ابحث بالاسم أو SKU لربط الصنف بالكتالوج..."
									class="form-input"
									class="w-full rounded-lg text-sm"
									oninput="searchCatalogProductsLive(this.value)"
								/>
								<div id="product-search-dropdown" class="d-none absolute top-full start-0 end-0 z-50 max-h-48 overflow-y-auto bg-surface-raised border rounded-lg shadow-xl mt-1"></div>
							</div>
						</div>

					</div>

					<!-- Form Footer -->
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary font-bold" onclick="closeCreateModal()">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary font-bold px-6">
							حفظ وتثبيت البيانات
						</button>
					</div>
				</form>
		}

		<!-- MODAL 2: Bulk Import & Staged Review Wizard Modal -->
		@components.Modal(components.ModalProps{ID: "saving-import-modal", Title: "????? ??????? ??????? ?????? ????????", Size: "xl"}) {
			<p id="vendor-import-modal-subtitle" class="text-xs text-muted mb-4">
				الخطوة 1 من 3: اختيار الملف وتعيين الأعمدة
			</p>

				<div class="stack-lg">
					
					<!-- STEP 1: Upload & Configuration -->
					<div id="vendor-import-step-config" class="stack-lg">
						
						<!-- Dropzone -->
						<div
							id="import-dropzone"
							
							onclick="document.getElementById('import-file-input').click()"
						>
							<div >@components.IconBarChart("icon-sm")</div>
							<strong >
								انقر هنا لاختيار الملف أو اسحبه هنا
							</strong>
							<p class="text-sm text-muted m-0">
								يدعم ملفات Excel (.xlsx, .xls) وكشوف CSV (.csv) بحد أقصى 32 ميجابايت
							</p>
							<div id="import-filename-preview" ></div>

							<input
								type="file"
								id="import-file-input"
								name="file"
								accept=".xlsx,.xls,.csv"
								required
								
								onchange="handleImportFileSelect(this)"
							/>
						</div>

						<!-- Column Mapping Customizer -->
						<div id="vendor-import-columns-panel" >
							<div >
								<div class="row-center-sm">
									<span>@components.IconSettings("icon-sm")</span>
									<span>تحديد وتعيين أعمدة الملف:</span>
								</div>
								<span class="badge badge-emerald font-size-10">تم التحديد الذكي تلقائياً </span>
							</div>

							<div id="vendor-import-columns-loading" >
								⏳ جاري قراءة أعمدة الملف وتحليل البيانات...
							</div>

							<div id="vendor-import-columns-grid" class="grid-halves">
								<div>
									<label class="form-label" >
										عمود اسم الصنف / المنتج <span class="text-danger">*</span>
									</label>
									<select name="col_name" id="vendor-col-name" class="form-input" >
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label" >
										عمود كود الصنف / SKU / الباركود
									</label>
									<select name="col_sku" id="vendor-col-sku" class="form-input" >
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label" >
										عمود الكمية المطلوبة
									</label>
									<select name="col_qty" id="vendor-col-qty" class="form-input" >
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>

								<div>
									<label class="form-label" >
										عمود السعر المستهدف (ج.م)
									</label>
									<select name="col_price" id="vendor-col-price" class="form-input" >
										<option value="">تلقائي (التعرف الذكي)</option>
									</select>
								</div>
							</div>

							<!-- Live Sample Preview Container -->
							<div id="vendor-import-preview-table-container"></div>
						</div>

						<!-- Match Strategy Selection -->
						<div >
							<label >
								طريقة مطابقة وربط الأصناف مع كتالوج الأدوية المعتمد:
							</label>
							<div >
								<label >
									<input type="radio" name="vendor_match_strategy" value="smart_auto" checked  />
									<div>
										<strong class="text-body">مطابقة ذكية شاملة (موصى بها)</strong>
										<span >الربط بكود SKU / الباركود أولاً، ثم الاسم بالتنظيف اللغوي وتصحيح الهمزات والتطابق الصيدلاني.</span>
									</div>
								</label>
								<label >
									<input type="radio" name="vendor_match_strategy" value="sku_only"  />
									<div>
										<strong class="text-body">مطابقة عبر كود SKU / الباركود فقط</strong>
										<span >المطابقة الحصرية عبر كود الباركود / SKU؛ الأصناف غير المتطابقة برمجياً لن ترتبط.</span>
									</div>
								</label>
								<label >
									<input type="radio" name="vendor_match_strategy" value="name_only"  />
									<div>
										<strong class="text-body">مطابقة عبر اسم الصنف فقط (تجاهل كود المورد الداخلي)</strong>
										<span >مثالي إذا كان المورد يستخدم أكواد ERP داخلية خاصة تختلف عن أكواد الكتالوج العام.</span>
									</div>
								</label>
							</div>
						</div>

						<div >
							ℹ️ <strong>معالجة آمنة في الخلفية:</strong> لن يتم حفظ أو تعديل أي صنف في قاعدة البيانات مباشرة؛ ستظهر لك نتائج المطابقة كاملة في الخطوة التالية لمراجعتها والموافقة عليها.
						</div>

					</div>

					<!-- STEP 2: Real-time Background Progress -->
					<div id="vendor-import-step-progress" >
						<div >@components.IconZap("icon-sm")</div>
						<h4 id="vendor-progress-phase" >
							جاري قراءة وفك تشفير ملف الإكسيل...
						</h4>
						<p id="vendor-progress-sub" >
							تتم المعالجة والمطابقة الصيدلانية في الخلفية دون تجميد المتصفح
						</p>

						<div >
							<div id="vendor-progress-bar" ></div>
						</div>
						<div >
							<span id="vendor-progress-percent">10%</span>
							<span id="vendor-progress-counter">0 / 0 صنف</span>
						</div>
					</div>

					<!-- STEP 3: Staged Review & Confirmation -->
					<div id="vendor-import-step-review"  class="stack-md">
						<!-- Stats Summary Grid -->
						<div >
							<div >
								<div >إجمالي الأصناف بالملف</div>
								<div id="vendor-review-total-count" >0</div>
							</div>
							<div >
								<div >تم ربطها بالكتالوج</div>
								<div id="vendor-review-matched-count" >0</div>
							</div>
							<div >
								<div >أصناف غير مرتبطة / جديدة</div>
								<div id="vendor-review-unlinked-count" >0</div>
							</div>
							<div >
								<div >إجمالي الكمية المطلوبة</div>
								<div id="vendor-review-total-qty" >0</div>
							</div>
						</div>

						<!-- Filter Tabs & Quick Search -->
						<div >
							<div class="row-center-sm" >
								<button type="button" class="btn btn-sm btn-ghost" id="vendor-tab-all" onclick="filterVendorReviewTable('all')" >الكل (<span id="vendor-badge-all">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="vendor-tab-matched" onclick="filterVendorReviewTable('matched')" >المتطابق فقط (<span id="vendor-badge-matched">0</span>)</button>
								<button type="button" class="btn btn-sm btn-ghost" id="vendor-tab-unlinked" onclick="filterVendorReviewTable('unlinked')" >غير المرتبط (<span id="vendor-badge-unlinked">0</span>)</button>
							</div>
							<input type="text" id="vendor-review-search" class="form-input" placeholder="بحث سريع في المسودة..."  oninput="searchVendorReviewTable(this.value)" />
						</div>

						<!-- Staged Items Table Container -->
						<div class="table-container m-0" >
							<table class="data-table m-0" >
								<thead >
									<tr>
										<th >
											<input type="checkbox" id="vendor-select-all" checked onchange="toggleAllVendorStagedRows(this.checked)" />
										</th>
										<th>اسم الصنف في الملف</th>
										<th>كود SKU</th>
										<th>الصنف المطابق بالكتالوج العام</th>
										<th class="text-center">حالة المطابقة</th>
										<th class="text-center">الكمية</th>
										<th class="text-end">السعر المستهدف</th>
									</tr>
								</thead>
								<tbody id="vendor-review-table-body"></tbody>
							</table>
						</div>

						<div >
							<span>لم يتم حفظ أي صنف في قاعدة البيانات بعد. اضغط "تأكيد الاستيراد والحفظ" لاعتماد البيانات.</span>
							<span>الأصناف المحددة: <strong id="vendor-selected-count" >0</strong></span>
						</div>
					</div>

				<!-- Fixed Sticky Footer -->
				<div id="vendor-import-footer" >
					<div id="vendor-footer-left">
						<button type="button" id="vendor-cancel-btn" class="btn btn-secondary" onclick="handleVendorImportCancelClick()">
							إلغاء
						</button>
					</div>
					<div id="vendor-footer-right" class="row-center-sm">
						<button type="button" id="vendor-back-btn" class="btn btn-secondary"  onclick="backToVendorImportConfig()">
							← الرجوع لضبط الأعمدة
						</button>
						<button type="button" id="vendor-start-btn" class="btn btn-primary"  onclick="startVendorAsyncImport()">
							بدء المعالجة والمطابقة الذكية 
						</button>
						<button type="button" id="vendor-commit-btn" class="btn btn-primary"  onclick="commitVendorStagedImport()">
							تأكيد الاستيراد والحفظ النهائي في قائمة المنتجات
						</button>
					</div>
				</div>
			</div>
		}

		<!-- MODAL 3: Providing Organizations & Offers Modal -->
		@components.Modal(components.ModalProps{ID: "providers-modal", Title: "???? ???????? ????????? ????????", Size: "lg"}) {
			<p id="providers-modal-subtitle" class="text-xs text-muted mb-3"></p>
			<div id="providers-modal-content" class="p-2">
				<div class="text-center text-muted p-8">
					? ???? ????? ???? ???????? ???????? ???????...
				</div>
			</div>
		}

		<!-- JavaScript for all-in-one Saving Products operations -->
		@VendorSavingScript()
	}
}
