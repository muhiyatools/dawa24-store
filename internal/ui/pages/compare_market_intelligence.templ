package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type MarketIntelligencePageData struct {
	Report     *compare.MarketIntelligenceReport
	IsCustomer bool
}

templ CompareMarketIntelligenceContent(data MarketIntelligencePageData) {
	<div class="page-container">
		
		<!-- Header Banner -->
		<div class="glass-panel p-6 mb-6">
			<div class="flex-between flex-wrap gap-4">
				<div>
					<div class="d-flex items-center gap-3 mb-1">
						<div class="user-avatar-badge text-xl">
							🧠
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							تقرير ذكاء واستخبارات السوق (Market Intelligence)
						</h1>
					</div>
					<p class="text-sm text-secondary m-0">
						رؤية تحليلية شاملة لحركة الخصومات والأسعار وفرص التوفير والوفر التنافسي ونواقص السوق عبر كافة الموردين.
					</p>
				</div>

				<div class="d-flex items-center gap-3 flex-wrap">
					<a href="/compare/tool" class="btn btn-secondary font-bold gap-2">
						@components.IconArrowLeft("icon-xs")
						<span>مركز الملفات</span>
					</a>
				</div>
			</div>

			<!-- Navigation Subtabs for all 4 Analysis Modes -->
			<div class="cb-tabs-nav mt-4 pt-3 border-t">
				<a href="/compare/results" class="cb-tab-btn">
					📊 المقارنة المجمعة بين الموردين
				</a>
				<a href="/compare/head-to-head" class="cb-tab-btn">
					🏢 مقارنة مورد بمورد
				</a>
				<a href="/compare/market-benchmark" class="cb-tab-btn">
					🧠 مقارنة مع موردين السوق
				</a>
				<a href="/compare/market-intelligence" class="cb-tab-btn active">
					🧠 تقرير ذكاء السوق
				</a>
			</div>
		</div>

		if data.Report != nil {
			<!-- 1. Market Vital KPIs -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الأصناف المرصودة</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", data.Report.KPIs.TotalTrackedProducts) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">عبر { fmt.Sprintf("%d", data.Report.KPIs.TotalActiveSuppliers) } موردين نشطين</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-success">متوسط خصم السوق العام</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Report.KPIs.OverallAvgDiscount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">مؤشر الخصم المرجعي للمنصة</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-warning">أعلى خصم متاح بالسوق</div>
					<div class="stat-card-value text-warning tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Report.KPIs.HighestMarketDisc) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">أفضل عروض التوفير الحالية</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">فرص التوفير الكبرى (Arbitrage)</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%d", data.Report.KPIs.TotalArbitrageDeals) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">فارق خصم يتجاوز 3% بين الموردين</span>
				</div>
			</div>

			<!-- 2. Actionable Smart Recommendations -->
			if len(data.Report.Recommendations) > 0 {
				<div class="glass-panel p-6 mb-6">
					<div class="d-flex items-center gap-2 mb-3">
						<span class="text-xl">💡</span>
						<h3 class="text-base font-extrabold text-primary m-0">
							توصيات الذكاء الاستراتيجي للمشتريات والتسعير
						</h3>
					</div>
					<ul class="d-flex flex-col gap-2 ps-4 m-0 text-sm text-secondary leading-relaxed">
						for _, rec := range data.Report.Recommendations {
							<li>{ rec }</li>
						}
					</ul>
				</div>
			}

			<!-- 3. Top Arbitrage Opportunities Table -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				<div class="p-4 px-6 border-b flex-between flex-wrap gap-2">
					<div class="d-flex items-center gap-2">
						<span class="text-xl">💎</span>
						<h3 class="text-base font-extrabold text-primary m-0">
							أفضل فرص الوفر والشراء الذهبية (Highest Discount Spreads)
						</h3>
					</div>
					<span class="badge badge-emerald text-xs font-bold">فروق خصومات حقيقية بين الموردين</span>
				</div>

				<div class="table-container m-0">
					<table class="data-table m-0">
						<thead>
							<tr>
								<th>اسم الصنف</th>
								<th>المورد الأفضل (أعلى خصم)</th>
								<th>المورد الأقل خصماً</th>
								<th class="text-center tabular-nums">فارق الخصم</th>
								<th class="text-center tabular-nums">الوفر لكل عبوة</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Report.TopArbitrage) == 0 {
								<tr>
									<td colspan="5" class="text-center p-8 text-muted">
										لا توجد فروق خصومات كبيرة مرصودة حالياً.
									</td>
								</tr>
							}
							for _, deal := range data.Report.TopArbitrage {
								<tr>
									<!-- الصنف -->
									<td>
										<div class="font-extrabold text-primary text-sm">
											{ deal.ProductName }
										</div>
										if deal.SKU != "" {
											<span class="text-xs text-muted tabular-nums">
												كود: { deal.SKU }
											</span>
										}
									</td>

									<!-- المورد الأفضل -->
									<td>
										<div class="d-flex items-center gap-2">
											<span class="badge badge-emerald text-xs font-extrabold">
												{ fmt.Sprintf("%.1f%%", deal.BestDiscount) }
											</span>
											<div>
												<div class="font-bold text-xs text-primary">
													{ deal.BestSupplier }
												</div>
												<div class="text-xs text-muted tabular-nums">
													صافي: { deal.BestNetPrice.String() } ج.م
												</div>
											</div>
										</div>
									</td>

									<!-- المورد الأقل -->
									<td>
										<div class="d-flex items-center gap-2">
											<span class="badge badge-slate text-xs">
												{ fmt.Sprintf("%.1f%%", deal.WorstDiscount) }
											</span>
											<div>
												<div class="font-bold text-xs text-muted">
													{ deal.WorstSupplier }
												</div>
												<div class="text-xs text-muted tabular-nums">
													صافي: { deal.WorstNetPrice.String() } ج.م
												</div>
											</div>
										</div>
									</td>

									<!-- فارق الخصم -->
									<td class="text-center tabular-nums">
										<span class="badge badge-emerald text-xs font-extrabold">
											+{ fmt.Sprintf("%.1f%%", deal.DiscountSpread) }
										</span>
									</td>

									<!-- الوفر للعبوة -->
									<td class="text-center font-extrabold text-primary text-sm tabular-nums">
										{ deal.UnitSavings.String() } ج.م
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- 4. Manufacturer / Brand Breakdown & Market Gaps (Two-column grid) -->
			<div class="dashboard-workspace-grid mb-6">
				
				<!-- Brand Discount Stats -->
				<div class="glass-panel p-0 mb-0 overflow-hidden">
					<div class="p-4 px-6 border-b flex-between items-center">
						<div class="d-flex items-center gap-2">
							<span class="text-lg">🏭</span>
							<h3 class="text-base font-extrabold text-primary m-0">
								متوسط خصومات الشركات المصنعة
							</h3>
						</div>
					</div>

					<div class="table-container m-0 max-h-360 overflow-y-auto">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>الشركة المصنعة</th>
									<th class="text-center tabular-nums">الأصناف</th>
									<th class="text-center tabular-nums">متوسط الخصم</th>
									<th class="text-center tabular-nums">أعلى خصم</th>
								</tr>
							</thead>
							<tbody>
								if len(data.Report.BrandStats) == 0 {
									<tr>
										<td colspan="4" class="text-center p-6 text-muted">
											لا تتوفر إحصائيات شركات مصنعة حالياً.
										</td>
									</tr>
								}
								for _, b := range data.Report.BrandStats {
									<tr>
										<td class="font-bold text-primary text-xs">
											{ b.BrandName }
										</td>
										<td class="text-center text-muted text-xs tabular-nums">
											{ fmt.Sprintf("%d", b.ProductCount) }
										</td>
										<td class="text-center font-extrabold text-primary text-xs tabular-nums">
											{ fmt.Sprintf("%.1f%%", b.AvgDiscount) }
										</td>
										<td class="text-center tabular-nums">
											<span class="badge badge-emerald text-xs font-bold">
												{ fmt.Sprintf("%.1f%%", b.MaxDiscount) }
											</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Market Gaps / Exclusive Offerings -->
				<div class="glass-panel p-0 mb-0 overflow-hidden">
					<div class="p-4 px-6 border-b flex-between items-center">
						<div class="d-flex items-center gap-2">
							<span class="text-lg">⭐</span>
							<h3 class="text-base font-extrabold text-primary m-0">
								حصريات الموردين ونواقص السوق
							</h3>
						</div>
						<span class="badge badge-amber text-xs font-bold">متوفر لدى مورد واحد</span>
					</div>

					<div class="table-container m-0 max-h-360 overflow-y-auto">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>اسم الصنف</th>
									<th>المورد الحصري</th>
									<th class="text-center tabular-nums">الخصم</th>
								</tr>
							</thead>
							<tbody>
								if len(data.Report.MarketGaps) == 0 {
									<tr>
										<td colspan="3" class="text-center p-6 text-muted">
											لا توجد أصناف حصرية أحادية المورد حالياً.
										</td>
									</tr>
								}
								for _, gap := range data.Report.MarketGaps {
									<tr>
										<td class="font-bold text-primary text-xs">
											{ gap.ProductName }
										</td>
										<td class="text-secondary text-xs">
											{ gap.SoleSupplier }
										</td>
										<td class="text-center tabular-nums">
											<span class="badge badge-slate text-xs font-bold">
												{ fmt.Sprintf("%.1f%%", gap.Discount) }
											</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

			</div>
		}

	</div>
}

templ CompareMarketIntelligencePage(lang, dir string, data MarketIntelligencePageData) {
	if data.IsCustomer {
		@layouts.CustomerShell("تقرير ذكاء السوق | Dawa24", "compare", lang, dir, nil) {
			@CompareMarketIntelligenceContent(data)
		}
	} else {
		@layouts.VendorShell("تقرير ذكاء السوق | Dawa24", "compare", lang, dir) {
			@CompareMarketIntelligenceContent(data)
		}
	}
}
