package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type MarketIntelligencePageData struct {
	Report     *compare.MarketIntelligenceReport
	IsCustomer bool
}

templ CompareMarketIntelligenceContent(data MarketIntelligencePageData) {
	<div class="max-w-4xl mx-auto stack-lg">
		
		<!-- Header Banner -->
		<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem 1.75rem;">
			<div class="flex-between flex-wrap gap-md">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.25rem;">
						<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
							🧠
						</div>
						<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
							تقرير ذكاء واستخبارات السوق (Market Intelligence)
						</h1>
					</div>
					<p style="color:var(--text-muted); font-size:0.875rem; margin:0;">
						رؤية تحليلية شاملة لحركة الخصومات والأسعار وفرص التوفير والوفر التنافسي ونواقص السوق عبر كافة الموردين.
					</p>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
					<a href="/compare/tool" class="btn btn-secondary fw-700">
						@components.IconArrowLeft("icon-xs")
						<span>مركز الملفات</span>
					</a>
				</div>
			</div>

			<!-- Navigation Subtabs for all 4 Analysis Modes -->
			<div style="display:flex; gap:0.5rem; margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--border); flex-wrap:wrap;">
				<a href="/compare/results" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					📊 المقارنة المجمعة بين الموردين
				</a>
				<a href="/compare/head-to-head" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					🏢 مقارنة مورد بمورد
				</a>
				<a href="/compare/market-benchmark" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					🧠 مقارنة مع موردين السوق
				</a>
				<a href="/compare/market-intelligence" class="btn btn-primary btn-sm" style="font-weight:800; border-radius:var(--radius-lg);">
					🧠 تقرير ذكاء السوق
				</a>
			</div>
		</div>

		if data.Report != nil {
			<!-- 1. Market Vital KPIs -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem;">
				
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem;">
					<div style="font-size:0.825rem; font-weight:700; color:var(--text-muted); margin-bottom:0.25rem;">
						إجمالي الأصناف المرصودة
					</div>
					<div style="font-size:1.75rem; font-weight:900; color:var(--text);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Report.KPIs.TotalTrackedProducts) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">عبر { fmt.Sprintf("%d", data.Report.KPIs.TotalActiveSuppliers) } موردين نشطين</span>
				</div>

				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(16,185,129,0.3); border-radius:var(--radius-xl); padding:1.25rem;">
					<div style="font-size:0.825rem; font-weight:700; color:#10b981; margin-bottom:0.25rem;">
						متوسط خصم السوق العام
					</div>
					<div style="font-size:1.75rem; font-weight:900; color:#10b981;" class="tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Report.KPIs.OverallAvgDiscount) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">مؤشر الخصم المرجعي للمنصة</span>
				</div>

				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(245,158,11,0.3); border-radius:var(--radius-xl); padding:1.25rem;">
					<div style="font-size:0.825rem; font-weight:700; color:#f59e0b; margin-bottom:0.25rem;">
						أعلى خصم متاح بالسوق
					</div>
					<div style="font-size:1.75rem; font-weight:900; color:#f59e0b;" class="tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Report.KPIs.HighestMarketDisc) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">أفضل عروض التوفير الحالية</span>
				</div>

				<div class="card" style="background:var(--surface-raised); border:1px solid var(--accent-subtle); border-radius:var(--radius-xl); padding:1.25rem;">
					<div style="font-size:0.825rem; font-weight:700; color:var(--accent); margin-bottom:0.25rem;">
						فرص التوفير الكبرى (Arbitrage)
					</div>
					<div style="font-size:1.75rem; font-weight:900; color:var(--accent);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Report.KPIs.TotalArbitrageDeals) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">فارق خصم يتجاوز 3% بين الموردين</span>
				</div>

			</div>

			<!-- 2. Actionable Smart Recommendations -->
			if len(data.Report.Recommendations) > 0 {
				<div class="card" style="background:linear-gradient(135deg, rgba(37,99,235,0.06), rgba(16,185,129,0.06)); border:1px solid var(--accent-subtle); border-radius:var(--radius-2xl); padding:1.25rem 1.5rem;">
					<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
						<span style="font-size:1.25rem;">💡</span>
						<h3 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">
							توصيات الذكاء الاستراتيجي للمشتريات والتسعير
						</h3>
					</div>
					<ul style="margin:0; padding-inline-start:1.25rem; display:flex; flex-direction:column; gap:0.4rem; font-size:0.875rem; color:var(--text); line-height:1.5;">
						for _, rec := range data.Report.Recommendations {
							<li>{ rec }</li>
						}
					</ul>
				</div>
			}

			<!-- 3. Top Arbitrage Opportunities Table (فرص التوفير والشراء الذهبية) -->
			<div class="card" style="padding:0; overflow:hidden; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); box-shadow:var(--shadow-sm);">
				<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
					<div class="row-center-sm">
						<span style="font-size:1.2rem;">💎</span>
						<h3 class="text-base fw-800 text-primary m-0">
							أفضل فرص الوفر والشراء الذهبية (Highest Discount Spreads)
						</h3>
					</div>
					<span class="badge badge-emerald" style="font-size:0.75rem;">فروق خصومات حقيقية بين الموردين</span>
				</div>

				<div class="table-responsive">
					<table class="table" style="margin:0; width:100%; border-collapse:collapse; font-size:0.875rem;">
						<thead>
							<tr style="background:var(--surface-sunken); border-bottom:1px solid var(--border); font-size:0.825rem; text-align:start;">
								<th style="padding:0.85rem 1rem; min-width:240px;">اسم الصنف</th>
								<th style="padding:0.85rem 1rem; min-width:180px;">المورد الأفضل (أعلى خصم)</th>
								<th style="padding:0.85rem 1rem; min-width:180px;">المورد الأقل خصماً</th>
								<th style="padding:0.85rem 0.85rem; width:120px; text-align:center;">فارق الخصم</th>
								<th style="padding:0.85rem 0.85rem; width:120px; text-align:center;">الوفر لكل عبوة</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Report.TopArbitrage) == 0 {
								<tr>
									<td colspan="5" style="text-align:center; padding:2rem; color:var(--text-muted);">
										لا توجد فروق خصومات كبيرة مرصودة حالياً.
									</td>
								</tr>
							}
							for _, deal := range data.Report.TopArbitrage {
								<tr style="border-bottom:1px solid var(--border);">
									<!-- الصنف -->
									<td style="padding:0.85rem 1rem;">
										<div style="font-weight:700; color:var(--text);">
											{ deal.ProductName }
										</div>
										if deal.SKU != "" {
											<span style="font-size:0.725rem; color:var(--text-muted); font-family:monospace;">
												كود: { deal.SKU }
											</span>
										}
									</td>

									<!-- المورد الأفضل -->
									<td style="padding:0.85rem 1rem;">
										<div style="display:flex; align-items:center; gap:0.5rem;">
											<span class="badge badge-emerald" style="font-weight:800; font-size:0.8rem;">
												{ fmt.Sprintf("%.1f%%", deal.BestDiscount) }
											</span>
											<div>
												<div style="font-weight:700; font-size:0.85rem; color:var(--text);">
													{ deal.BestSupplier }
												</div>
												<div style="font-size:0.75rem; color:var(--text-muted);">
													صافي: { deal.BestNetPrice.String() } ج.م
												</div>
											</div>
										</div>
									</td>

									<!-- المورد الأقل -->
									<td style="padding:0.85rem 1rem;">
										<div style="display:flex; align-items:center; gap:0.5rem;">
											<span class="badge badge-slate" style="font-size:0.8rem;">
												{ fmt.Sprintf("%.1f%%", deal.WorstDiscount) }
											</span>
											<div>
												<div style="font-weight:600; font-size:0.85rem; color:var(--text-muted);">
													{ deal.WorstSupplier }
												</div>
												<div style="font-size:0.75rem; color:var(--text-muted);">
													صافي: { deal.WorstNetPrice.String() } ج.م
												</div>
											</div>
										</div>
									</td>

									<!-- فارق الخصم -->
									<td style="padding:0.85rem 0.85rem; text-align:center;" class="tabular-nums">
										<span style="display:inline-block; padding:0.25rem 0.6rem; border-radius:var(--radius-full); background:rgba(16,185,129,0.12); color:#10b981; font-weight:800; font-size:0.85rem;">
											+{ fmt.Sprintf("%.1f%%", deal.DiscountSpread) }
										</span>
									</td>

									<!-- الوفر للعبوة -->
									<td style="padding:0.85rem 0.85rem; text-align:center; font-weight:800; color:var(--primary-700);" class="tabular-nums">
										{ deal.UnitSavings.String() } ج.م
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- 4. Manufacturer / Brand Breakdown & Market Gaps (Two-column grid) -->
			<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;" class="market-intelligence-grid">
				
				<!-- Brand Discount Stats -->
				<div class="card" style="padding:0; overflow:hidden; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl);">
					<div style="padding:1.15rem 1.25rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
						<div class="row-center-sm">
							<span style="font-size:1.1rem;">🏭</span>
							<h3 class="text-base fw-800 text-primary m-0">
								متوسط خصومات الشركات المصنعة
							</h3>
						</div>
					</div>

					<div class="table-responsive" style="max-height:360px; overflow-y:auto;">
						<table class="table" style="margin:0; width:100%; border-collapse:collapse; font-size:0.85rem;">
							<thead>
								<tr style="background:var(--surface-sunken); border-bottom:1px solid var(--border);">
									<th style="padding:0.75rem 1rem;">الشركة المصنعة</th>
									<th style="padding:0.75rem 0.75rem; text-align:center;">الأصناف</th>
									<th style="padding:0.75rem 0.75rem; text-align:center;">متوسط الخصم</th>
									<th style="padding:0.75rem 0.75rem; text-align:center;">أعلى خصم</th>
								</tr>
							</thead>
							<tbody>
								if len(data.Report.BrandStats) == 0 {
									<tr>
										<td colspan="4" style="text-align:center; padding:1.5rem; color:var(--text-muted);">
											لا تتوفر إحصائيات شركات مصنعة حالياً.
										</td>
									</tr>
								}
								for _, b := range data.Report.BrandStats {
									<tr style="border-bottom:1px solid var(--border);">
										<td style="padding:0.75rem 1rem; font-weight:700; color:var(--text);">
											{ b.BrandName }
										</td>
										<td style="padding:0.75rem 0.75rem; text-align:center; color:var(--text-muted);" class="tabular-nums">
											{ fmt.Sprintf("%d", b.ProductCount) }
										</td>
										<td style="padding:0.75rem 0.75rem; text-align:center; font-weight:800; color:var(--primary-700);" class="tabular-nums">
											{ fmt.Sprintf("%.1f%%", b.AvgDiscount) }
										</td>
										<td style="padding:0.75rem 0.75rem; text-align:center;" class="tabular-nums">
											<span class="badge badge-emerald" style="font-size:0.75rem;">
												{ fmt.Sprintf("%.1f%%", b.MaxDiscount) }
											</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Market Gaps / Exclusive Offerings -->
				<div class="card" style="padding:0; overflow:hidden; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl);">
					<div style="padding:1.15rem 1.25rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
						<div class="row-center-sm">
							<span style="font-size:1.1rem;">⭐</span>
							<h3 class="text-base fw-800 text-primary m-0">
								حصريات الموردين ونواقص السوق
							</h3>
						</div>
						<span class="badge badge-amber" style="font-size:0.7rem;">متوفر لدى مورد واحد</span>
					</div>

					<div class="table-responsive" style="max-height:360px; overflow-y:auto;">
						<table class="table" style="margin:0; width:100%; border-collapse:collapse; font-size:0.85rem;">
							<thead>
								<tr style="background:var(--surface-sunken); border-bottom:1px solid var(--border);">
									<th style="padding:0.75rem 1rem;">اسم الصنف</th>
									<th style="padding:0.75rem 1rem;">المورد الحصري</th>
									<th style="padding:0.75rem 0.75rem; text-align:center;">الخصم</th>
								</tr>
							</thead>
							<tbody>
								if len(data.Report.MarketGaps) == 0 {
									<tr>
										<td colspan="3" style="text-align:center; padding:1.5rem; color:var(--text-muted);">
											لا توجد أصناف حصرية أحادية المورد حالياً.
										</td>
									</tr>
								}
								for _, gap := range data.Report.MarketGaps {
									<tr style="border-bottom:1px solid var(--border);">
										<td style="padding:0.75rem 1rem; font-weight:700; color:var(--text);">
											{ gap.ProductName }
										</td>
										<td style="padding:0.75rem 1rem; color:var(--text-secondary); font-size:0.8rem;">
											{ gap.SoleSupplier }
										</td>
										<td style="padding:0.75rem 0.75rem; text-align:center;" class="tabular-nums">
											<span class="badge badge-slate" style="font-size:0.75rem;">
												{ fmt.Sprintf("%.1f%%", gap.Discount) }
											</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

			</div>
		}

	</div>
}

templ CompareMarketIntelligencePage(lang, dir string, data MarketIntelligencePageData) {
	if data.IsCustomer {
		@layouts.CustomerShell("تقرير ذكاء السوق | Dawa24", "compare", lang, dir, nil) {
			@CompareMarketIntelligenceContent(data)
		}
	} else {
		@layouts.VendorShell("تقرير ذكاء السوق | Dawa24", "compare", lang, dir) {
			@CompareMarketIntelligenceContent(data)
		}
	}
}
