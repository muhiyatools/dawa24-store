package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// تقرير التوفير الاستراتيجي والتوصيات.
//
// Every number and every sentence on this page comes from compare.StrategicSavingReport,
// which is computed from the market as loaded. Nothing here has a hardcoded
// fallback: a section whose data is absent does not render, because a page that
// prints the same three recommendations on an empty market as on a full one
// teaches its reader to ignore it.

type MarketIntelligencePageData struct {
	Report *compare.StrategicSavingReport
	// Failed distinguishes "the report could not be built" from "the market is
	// empty". They look identical on screen and are entirely different problems.
	Failed     bool
	IsCustomer bool
	// Query filters ⚡ المنتجات ذات فارق الوفر الأكبر بالسوق by name/SKU/supplier.
	Query string
	// SingleQuery filters أصناف لدى مورد واحد فقط by name/SKU/supplier.
	SingleQuery string
}

func insightTone(t compare.InsightTone) string {
	switch t {
	case compare.ToneGood:
		return "badge-emerald"
	case compare.ToneWarn:
		return "badge-amber"
	}
	return "badge-slate"
}

templ CompareMarketIntelligenceContent(data MarketIntelligencePageData) {
	<div class="page-container">
		@marketIntelHeader()
		if data.Failed {
			<div class="alert alert-danger mb-6">
				<span class="fw-800">تعذّر بناء التقرير</span>
				<span class="text-sm">حدث خطأ أثناء قراءة عروض السوق. أعد المحاولة، وإذا تكرر الخطأ راجع سجلات النظام.</span>
			</div>
		} else if data.Report == nil {
			<div class="alert alert-warning mb-6">
				<span class="fw-800">التقرير غير متاح حالياً</span>
			</div>
		} else {
			@marketIntelKPIs(data.Report)
			@marketIntelInsights("💡 التحليل الاستراتيجي التلقائي", data.Report.Analysis)
			if data.Report.HasData() {
				@marketIntelSavingsTable(data.Report, data.Query, data.SingleQuery)
				@marketIntelBestSupplier(data.Report)
				@marketIntelInsights("📌 نصيحة استراتيجية", data.Report.Advice)
				@marketIntelInsights("⚡ توجيهات الشراء المثالي", data.Report.Guidance)
				@marketIntelExclusives(data.Report, data.Query, data.SingleQuery)
			}
			@marketIntelCoverage(data.Report.Coverage)
		}
	</div>
}

templ marketIntelHeader() {
	<div class="glass-panel p-6 mb-6">
		<div class="flex-between flex-wrap gap-4">
			<div class="stack-sm">
				<div class="d-flex items-center gap-3 mb-1">
					<div class="user-avatar-badge text-xl">
						@components.IconSparkles("icon-sm")
					</div>
					<h1 class="text-2xl font-black text-primary m-0">
						🧠 تقرير التوفير الاستراتيجي والتوصيات
					</h1>
				</div>
				<p class="text-sm text-secondary m-0">
					ما الذي يوفّره شراء كل صنف من أرخص مورد له، وأين تكمن أكبر الفوارق، ومن هو المورد الأفضل إجمالاً — محسوباً من عروض السوق الفعلية.
				</p>
			</div>
			<a href="/compare/tool" class="btn btn-secondary font-bold gap-2">
				@components.IconArrowLeft("icon-xs")
				<span>مركز الملفات</span>
			</a>
		</div>
		<div class="tabs-nav mt-4">
			<a href="/compare/results" class="tab-btn">المقارنة المجمعة بين الموردين</a>
			<a href="/compare/head-to-head" class="tab-btn">مقارنة مورد بمورد</a>
			<a href="/compare/market-benchmark" class="tab-btn">مقارنة مع موردي السوق</a>
			<a href="/compare/market-intelligence" class="tab-btn active">تقرير ذكاء السوق</a>
		</div>
	</div>
}

templ marketIntelKPIs(r *compare.StrategicSavingReport) {
	<div class="dashboard-stat-grid mb-6">
		<div class="stat-card-3d">
			<div class="stat-card-label text-success">التكلفة المثلى (شراء مجزأ)</div>
			<div class="stat-card-value text-success tabular-nums">{ r.OptimalCost.String() }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				وحدة واحدة من كل صنف، من أرخص مورد له
			</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label text-danger">تكلفتك القصوى بالسوق</div>
			<div class="stat-card-value text-danger tabular-nums">{ r.WorstCost.String() }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				نفس السلة عند شراء كل صنف من أغلى مورد له
			</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label text-brand">الوفر الممكن</div>
			<div class="stat-card-value text-brand tabular-nums">{ r.PotentialSavings.String() }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				{ fmt.Sprintf("%.1f%% من التكلفة القصوى", r.SavingsPercent) }
			</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label">الأصناف القابلة للمقارنة</div>
			<div class="stat-card-value text-primary tabular-nums">
				{ fmt.Sprintf("%d", r.Coverage.ComparableProduct) }
			</div>
			<span class="text-xs text-secondary mt-1 d-block">
				{ fmt.Sprintf("من %d صنف مرصود لدى %d مورد", r.Coverage.Products, r.Coverage.Suppliers) }
			</span>
		</div>
	</div>
}

templ marketIntelInsights(title string, items []compare.Insight) {
	if len(items) > 0 {
		<div class="glass-panel p-6 mb-6">
			<h3 class="text-base font-extrabold text-primary m-0 mb-3">{ title }</h3>
			<div class="d-flex flex-col gap-3">
				for _, it := range items {
					<div class="d-flex items-start gap-3">
						<span class={ "badge", insightTone(it.Tone), "text-xs" }>
							if it.Tone == compare.ToneGood {
								فرصة
							} else if it.Tone == compare.ToneWarn {
								انتباه
							} else {
								معلومة
							}
						</span>
						<span class="text-sm text-secondary leading-relaxed">{ it.Text }</span>
					</div>
				}
			</div>
		</div>
	}
}

templ marketIntelSavingsTable(r *compare.StrategicSavingReport, query string, singleQuery string) {
	<div class="glass-panel p-0 mb-6 overflow-hidden">
		<div class="p-4 px-6 border-b">
			<h3 class="text-base font-extrabold text-primary m-0">
				⚡ المنتجات ذات فارق الوفر الأكبر بالسوق
			</h3>
			<p class="text-xs text-muted m-0 mt-1">
				مرتبة بقيمة الفارق للوحدة الواحدة، لا بالنسبة المئوية: فارق 9% على عبوة غالية يفوق فارق 60% على عبوة رخيصة.
			</p>
			<form method="GET" action="/compare/market-intelligence" class="d-flex gap-2 mt-3 flex-wrap items-center">
				if singleQuery != "" {
					<input type="hidden" name="q_single" value={ singleQuery }/>
				}
				<input
					type="text"
					name="q"
					value={ query }
					class="form-input text-sm flex-1"
					placeholder="بحث باسم الصنف، الكود، أو المورد..."
				/>
				<button type="submit" class="btn btn-primary btn-sm font-bold">بحث</button>
				if query != "" {
					<a href={ templ.SafeURL(intelKeepSingleURL(singleQuery)) } class="btn btn-secondary btn-sm">مسح</a>
				}
			</form>
		</div>
		if len(r.TopSavings) == 0 {
			<div class="p-6 text-sm text-muted">
				if query != "" {
					لا توجد نتائج مطابقة لبحثك في فارق الوفر. جرب كلمات أخرى أو امسح البحث.
				} else {
					لا يوجد صنف يتجاوز فيه فارق السعر بين الموردين 1%. السوق متقارب على الأصناف المقارَنة.
				}
			</div>
		} else {
			<div class="table-container">
				<table class="data-table intel-spread-table">
					<thead>
						<tr>
							<th>المنتج</th>
							<th class="text-center">العرض الأفضل (سعر وخصم)</th>
							<th class="text-center">العرض الأعلى (سعر وخصم)</th>
						</tr>
					</thead>
					<tbody>
						for _, it := range r.TopSavings {
							<tr>
								<td>
									<div class="fw-800 text-sm">{ it.ProductName }</div>
									<div class="text-xs text-muted tabular-nums mt-1">
										if it.SKU != "" {
											<span>SKU: { it.SKU }</span>
										} else {
											<span>SKU: —</span>
										}
									</div>
									<div class="d-flex items-center gap-2 mt-1 flex-wrap">
										if it.InCatalog {
											<span class="badge badge-emerald text-xs">مرتبط بالكتالوج</span>
										} else {
											<span class="badge badge-slate text-xs">مطابقة بالاسم</span>
										}
										<span class="text-xs text-muted tabular-nums">الوفر: { it.PriceDifference.String() } ({ fmt.Sprintf("%.1f%%", it.PricePercent) }) · { fmt.Sprintf("%d مورد", it.SupplierCount) }</span>
									</div>
								</td>
								<td class="text-center tabular-nums">
									<span class="intel-best-price">{ it.BestNet.String() }</span>
									<span class="intel-best-disc">({ fmt.Sprintf("%.1f%%", it.BestDiscount) })</span>
									<div class="text-xs text-muted mt-1">{ it.BestSupplier }</div>
								</td>
								<td class="text-center tabular-nums">
									<span class="intel-worst-price">{ it.WorstNet.String() }</span>
									<span class="intel-worst-disc">({ fmt.Sprintf("%.1f%%", it.WorstDiscount) })</span>
									<div class="text-xs text-muted mt-1">{ it.WorstSupplier }</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ marketIntelBestSupplier(r *compare.StrategicSavingReport) {
	if r.BestSupplier != nil {
		<div class="glass-panel p-6 mb-6">
			<h3 class="text-base font-extrabold text-primary m-0 mb-1">المورد الأفضل إجمالاً</h3>
			<p class="text-xs text-muted m-0 mb-4">
				ليس صاحب أكبر خصم ولا صاحب أكثر الأصناف، بل من تكلف سلة ما يعرضه أقل ما يمكن مقارنةً بأفضل أسعار السوق لنفس السلة.
			</p>
			<div class="d-flex items-center gap-3 mb-4">
				<div class="user-avatar-badge text-xl">@components.IconStar("icon-sm")</div>
				<div class="stack-sm">
					<div class="text-xl font-black text-brand">{ r.BestSupplier.SupplierName }</div>
					<div class="text-xs text-secondary">
						{ fmt.Sprintf("%d صنف مقارَن · الأرخص في %d منها (%.0f%%) · متوسط خصم %.1f%%",
							r.BestSupplier.Offers, r.BestSupplier.Wins, r.BestSupplier.WinRate, r.BestSupplier.AvgDiscount) }
					</div>
				</div>
			</div>
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th>المورد</th>
							<th class="text-end">أصناف مقارَنة</th>
							<th class="text-end">الأرخص في</th>
							<th class="text-end">متوسط الفارق عن الأفضل</th>
							<th class="text-end">متوسط الخصم</th>
							<th class="text-end">تكلفة سلته</th>
							<th class="text-end">الفائض عن الأمثل</th>
						</tr>
					</thead>
					<tbody>
						for _, st := range r.Standings {
							<tr>
								<td class="fw-800">{ st.SupplierName }</td>
								<td class="text-end tabular-nums">{ fmt.Sprintf("%d", st.Offers) }</td>
								<td class="text-end tabular-nums">{ fmt.Sprintf("%d (%.0f%%)", st.Wins, st.WinRate) }</td>
								<td class="text-end tabular-nums">
									if st.AvgPremium <= 0.05 {
										<span class="badge badge-emerald text-xs">الأفضل</span>
									} else {
										{ fmt.Sprintf("+%.1f%%", st.AvgPremium) }
									}
								</td>
								<td class="text-end tabular-nums">{ fmt.Sprintf("%.1f%%", st.AvgDiscount) }</td>
								<td class="text-end tabular-nums">{ st.BasketCost.String() }</td>
								<td class="text-end tabular-nums text-danger">{ st.Excess().String() }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ marketIntelExclusives(r *compare.StrategicSavingReport, query string, singleQuery string) {
	if len(r.Exclusives) > 0 || singleQuery != "" {
		<div class="glass-panel p-0 mb-6 overflow-hidden">
			<div class="p-4 px-6 border-b">
				<h3 class="text-base font-extrabold text-primary m-0">أصناف لدى مورد واحد فقط</h3>
				<p class="text-xs text-muted m-0 mt-1">
					لا تقبل المقارنة السعرية. أعلاها قيمة أولاً، فهي أكبر تعرّض تفاوضي.
				</p>
				<form method="GET" action="/compare/market-intelligence" class="d-flex gap-2 mt-3 flex-wrap items-center">
					if query != "" {
						<input type="hidden" name="q" value={ query }/>
					}
					<input
						type="text"
						name="q_single"
						value={ singleQuery }
						class="form-input text-sm flex-1"
						placeholder="بحث باسم الصنف، الكود، أو المورد..."
					/>
					<button type="submit" class="btn btn-primary btn-sm font-bold">بحث</button>
					if singleQuery != "" {
						<a href={ templ.SafeURL(intelKeepQueryURL(query)) } class="btn btn-secondary btn-sm">مسح</a>
					}
				</form>
			</div>
			if len(r.Exclusives) == 0 {
				<div class="p-6 text-sm text-muted">
					لا توجد نتائج مطابقة لبحثك في أصناف المورد الواحد. جرب كلمات أخرى أو امسح البحث.
				</div>
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>اسم الصنف</th>
								<th>الكود</th>
								<th>المورد الوحيد</th>
								<th class="text-end">السعر النهائي</th>
								<th class="text-end">الخصم</th>
							</tr>
						</thead>
						<tbody>
							for _, it := range r.Exclusives {
								<tr>
									<td class="fw-800">{ it.ProductName }</td>
									<td class="text-xs text-muted tabular-nums">
										if it.SKU != "" {
											{ it.SKU }
										} else {
											—
										}
									</td>
									<td class="text-sm">{ it.BestSupplier }</td>
									<td class="text-end tabular-nums fw-800">{ it.BestNet.String() }</td>
									<td class="text-end tabular-nums">{ fmt.Sprintf("%.1f%%", it.BestDiscount) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

func intelKeepSingleURL(singleQuery string) string {
	if singleQuery != "" {
		return "/compare/market-intelligence?q_single=" + url.QueryEscape(singleQuery)
	}
	return "/compare/market-intelligence"
}

func intelKeepQueryURL(query string) string {
	if query != "" {
		return "/compare/market-intelligence?q=" + url.QueryEscape(query)
	}
	return "/compare/market-intelligence"
}

templ marketIntelCoverage(c compare.MarketCoverage) {
	<div class="glass-panel p-4 mb-6">
		<p class="text-xs text-muted m-0">
			{ fmt.Sprintf("محسوب على %d عرضاً من %d ملف لدى %d مورد. %d عرضاً (%.0f%%) مرتبط بالكتالوج المركزي.",
				c.Offers, c.Files, c.Suppliers, c.MatchedOffers, c.MatchedPercent()) }
			if !c.AIEnabled {
				<span class="text-warning"> · مطابقة الذكاء الاصطناعي غير مفعّلة.</span>
			}
		</p>
	</div>
}

templ CompareMarketIntelligencePage(lang, dir string, data MarketIntelligencePageData) {
	if data.IsCustomer {
		@layouts.ShellFor("تقرير ذكاء السوق | Dawa24", "compare", lang, dir, authctx.FromContext(ctx)) {
			@CompareMarketIntelligenceContent(data)
		}
	} else {
		@layouts.VendorShell("تقرير ذكاء السوق | Dawa24", "compare", lang, dir) {
			@CompareMarketIntelligenceContent(data)
		}
	}
}
