package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ savingReviewStage(view SavingImportView) {
	{{ sess := view.Session }}
	<div class="stack-md">
		<!-- Top Action Header Panel -->
		<div class="glass-panel p-6 mb-4">
			<div class="flex-between items-center flex-wrap gap-4">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge text-xl">
						@components.IconFileText("icon-sm")
					</div>
					<div>
						<h2 class="text-xl font-black text-primary m-0">مراجعة أصناف التوفير والربط بالكتالوج المركزي</h2>
						<p class="text-xs text-secondary m-0 mt-1">راجع أسماء وأسعار وكميات الأدوية المرفوعة، واربط الأصناف غير المرتبطة بالبحث المباشر داخل الكتالوج المركزي قبل الحفظ.</p>
					</div>
				</div>

				<div class="d-flex items-center gap-2 flex-wrap">
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/%s/cancel", view.ImportURL, sess.ID)) }
						onsubmit="return confirm('هل أنت متأكد من رغبتك في إلغاء هذه الجلسة والتراجع عن الاستيراد؟');" class="m-0">
						<button type="submit" class="btn btn-secondary btn-sm text-danger font-bold">
							إلغاء الجلسة
						</button>
					</form>

					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/%s/commit", view.ImportURL, sess.ID)) }
						onsubmit="return confirm('هل أنت متأكد من رغبتك في اعتماد وحفظ الأصناف المحددة في قائمة أدوية التوفير؟');" class="m-0">
						<button type="submit" class="btn btn-primary btn-sm font-bold shadow-md">
							@components.IconCheck("icon-xs")
							<span>اعتماد وحفظ القائمة ({ fmt.Sprint(sess.TotalRows) } صنف)</span>
						</button>
					</form>
				</div>
			</div>
		</div>

		<!-- 4 KPI Stat Cards -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
			<div class="glass-panel p-4 d-flex items-center gap-3" style="border-radius:var(--radius-lg);">
				<div class="text-2xl p-2.5 rounded-xl" style="background:rgba(59, 130, 246, 0.1); border:1px solid rgba(59, 130, 246, 0.2);">
					@components.IconPackage("icon-sm")
				</div>
				<div>
					<div class="text-xs text-secondary font-bold">إجمالي الأصناف</div>
					<div class="text-xl font-black text-primary tabular-nums">{ fmt.Sprint(sess.TotalRows) }</div>
				</div>
			</div>

			<div class="glass-panel p-4 d-flex items-center gap-3" style="border-radius:var(--radius-lg);">
				<div class="text-2xl p-2.5 rounded-xl" style="background:rgba(16, 185, 129, 0.1); border:1px solid rgba(16, 185, 129, 0.2);">
					@components.IconCheck("icon-sm")
				</div>
				<div>
					<div class="text-xs text-secondary font-bold">مطابق بالكتالوج</div>
					<div class="text-xl font-black text-emerald tabular-nums">{ fmt.Sprint(sess.MatchedRows) }</div>
				</div>
			</div>

			<div class="glass-panel p-4 d-flex items-center gap-3" style="border-radius:var(--radius-lg);">
				<div class="text-2xl p-2.5 rounded-xl" style="background:rgba(245, 158, 11, 0.1); border:1px solid rgba(245, 158, 11, 0.2);">
					@components.IconAlert("icon-sm")
				</div>
				<div>
					<div class="text-xs text-secondary font-bold">غير مرتبط</div>
					<div class="text-xl font-black text-amber tabular-nums">{ fmt.Sprint(sess.UnlinkedRows) }</div>
				</div>
			</div>

			<div class="glass-panel p-4 d-flex items-center gap-3" style="border-radius:var(--radius-lg);">
				<div class="text-2xl p-2.5 rounded-xl" style="background:rgba(99, 102, 241, 0.1); border:1px solid rgba(99, 102, 241, 0.2);">
					@components.IconWallet("icon-sm")
				</div>
				<div>
					<div class="text-xs text-secondary font-bold">القيمة التقديرية</div>
					<div class="text-lg font-black text-primary tabular-nums">{ sess.TotalValue.String() } <span class="text-xs font-normal text-muted">ج.م</span></div>
				</div>
			</div>
		</div>

		<!-- Filter & Search Toolbar -->
		<div class="glass-panel p-4 mb-4">
			<div class="flex-between items-center flex-wrap gap-3">
				<div class="d-flex items-center gap-2 flex-wrap">
					@savingFilterTab(view, "", "الكل (" + fmt.Sprint(sess.TotalRows) + ")")
					@savingFilterTab(view, "matched", "مطابق بالكتالوج (" + fmt.Sprint(sess.MatchedRows) + ")")
					@savingFilterTab(view, "unmatched", "غير مرتبط (" + fmt.Sprint(sess.UnlinkedRows) + ")")
				</div>

				<form method="GET" action={ templ.SafeURL(fmt.Sprintf("%s/%s", view.ImportURL, sess.ID)) } class="d-flex items-center gap-2 flex-wrap m-0">
					if view.Filter.MatchFilter != "" {
						<input type="hidden" name="match" value={ view.Filter.MatchFilter }/>
					}
					if view.Filter.SortBy != "" {
						<input type="hidden" name="sort" value={ view.Filter.SortBy }/>
					}
					if view.Filter.SortOrder != "" {
						<input type="hidden" name="order" value={ view.Filter.SortOrder }/>
					}
					<input type="text" name="q" value={ view.Filter.Search } placeholder="بحث بالاسم أو الكود..."
						class="form-input text-xs" style="min-width:220px;"/>
					<select name="limit" onchange="this.form.submit()" class="form-select text-xs" style="width:auto;">
						<option value="10" selected?={ view.Filter.Limit == 10 }>10 صفوف</option>
						<option value="25" selected?={ view.Filter.Limit == 25 || view.Filter.Limit == 0 }>25 صنف</option>
						<option value="50" selected?={ view.Filter.Limit == 50 }>50 صنف</option>
						<option value="100" selected?={ view.Filter.Limit == 100 }>100 صنف</option>
					</select>
					<button type="submit" class="btn btn-secondary btn-xs font-bold">بحث</button>
					if view.Filter.Search != "" {
						<a href={ templ.SafeURL(buildSavingURL(view.ImportURL, sess.ID, view.Filter.MatchFilter, view.Filter.SortBy, view.Filter.SortOrder, 1, view.Filter.Limit, "")) } class="btn btn-ghost btn-xs text-xs">إلغاء</a>
					}
				</form>
			</div>
		</div>

		<!-- Table Container -->
		<div class="glass-panel p-0 mb-6 overflow-hidden">
			<div class="table-container m-0">
				<table class="data-table m-0">
					<thead>
						<tr>
							<th class="saving-review-col-index text-center" style="width:48px;">#</th>
							@savingThSort(view, "name", "اسم الصنف بالملف المرفوع")
							<th class="saving-review-col-product" style="min-width:260px;">الصنف المطابق بالكتالوج المركزي</th>
							@savingThSort(view, "score", "حالة التطابق")
							@savingThSort(view, "qty", "الكمية المطلوبة")
							@savingThSort(view, "price", "سعر الجمهور")
							@savingThSort(view, "total", "القيمة الإجمالية")
						</tr>
					</thead>
					<tbody>
						if len(view.Rows) == 0 {
							<tr>
								<td colspan="7" class="text-center p-8 text-muted text-sm">
									لا توجد أصناف مطابقة لخيارات الفلترة أو البحث الحالية.
								</td>
							</tr>
						} else {
							for _, row := range view.Rows {
								@savingProductRow(view, row)
							}
						}
					</tbody>
				</table>
			</div>

			@savingPagination(view)
		</div>
	</div>

	<!-- Centered Modal for Linking Saving Product to Master Catalog -->
	<div id="saving-catalog-match-modal" class="modal-backdrop" style="display:none; position:fixed; inset:0; width:100vw; height:100vh; margin:0; background:rgba(3,7,18,0.85); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); z-index:9999999; align-items:center; justify-content:center; padding:1.25rem;">
		<div class="card" style="margin:auto; width:100%; max-width:580px; max-height:90vh; display:flex; flex-direction:column; overflow:hidden; background:#0f172a; border:1px solid rgba(59,130,246,0.3); border-radius:var(--radius-xl); box-shadow:0 25px 50px -12px rgba(0,0,0,0.75); padding:1.5rem;">
			<div class="flex-between items-center pb-3 border-b mb-3">
				<div>
					<h3 class="text-lg font-black text-primary m-0">الربط بالكتالوج المركزي</h3>
					<p class="text-xs text-secondary m-0 mt-0.5 font-mono" id="saving-modal-item-name"></p>
				</div>
				<button type="button" class="btn btn-secondary btn-xs" onclick="closeSavingCatalogModal()" style="border-radius:var(--radius-full); width:32px; height:32px; padding:0; justify-content:center;">
					@components.IconX("icon-sm")
				</button>
			</div>

			<div class="mb-3">
				<label class="form-label text-xs mb-1">ابحث في الكتالوج المركزي:</label>
				<input type="text" id="saving-modal-search-input" class="form-input text-sm w-100" placeholder="ابحث باسم الدواء، الكود، أو المادة الفعالة..." autocomplete="off" />
			</div>

			<div id="saving-modal-results" class="flex-1 overflow-y-auto pr-1 d-flex flex-col gap-2" style="min-height:220px; max-height:360px;">
				<div class="p-6 text-center text-muted text-xs">اكتب للبحث في الكتالوج المركزي...</div>
			</div>

			<div id="saving-modal-unlink-section" class="pt-3 border-t mt-3 flex-between items-center" style="display:none;">
				<form id="saving-modal-unlink-form" method="POST" action="" class="m-0">
					<input type="hidden" name="product_id" value="0" />
					<button type="submit" class="btn btn-ghost btn-xs text-danger font-bold">
						إلغاء الربط (جعله غير مرتبط)
					</button>
				</form>
				<button type="button" class="btn btn-secondary btn-xs font-bold" onclick="closeSavingCatalogModal()">إغلاق</button>
			</div>
		</div>
	</div>

	<script>
	var currentSavingSearchURL = '';
	var currentSavingActionURL = '';
	var savingSearchDebounceTimer = null;

	function ensureSavingModalInBody() {
		var modal = document.getElementById('saving-catalog-match-modal');
		if (modal && modal.parentElement !== document.body) {
			document.body.appendChild(modal);
		}
	}

	function openSavingCatalogModal(rowIndex, searchURL, actionURL, itemName, isLinked) {
		ensureSavingModalInBody();
		currentSavingSearchURL = searchURL;
		currentSavingActionURL = actionURL;

		var modal = document.getElementById('saving-catalog-match-modal');
		var titleEl = document.getElementById('saving-modal-item-name');
		var inputEl = document.getElementById('saving-modal-search-input');
		var unlinkSec = document.getElementById('saving-modal-unlink-section');
		var unlinkForm = document.getElementById('saving-modal-unlink-form');

		if (titleEl) titleEl.textContent = 'الصنف بالملف: ' + itemName;
		if (inputEl) {
			inputEl.value = itemName;
			inputEl.oninput = function() {
				clearTimeout(savingSearchDebounceTimer);
				savingSearchDebounceTimer = setTimeout(function() {
					fetchSavingModalResults(inputEl.value);
				}, 200);
			};
		}
		if (unlinkSec && unlinkForm) {
			unlinkSec.style.display = isLinked ? 'flex' : 'none';
			unlinkForm.action = actionURL;
		}

		if (modal) modal.style.display = 'flex';
		setTimeout(function() {
			if (inputEl) {
				inputEl.focus();
				inputEl.select();
			}
			fetchSavingModalResults(itemName);
		}, 50);
	}

	function closeSavingCatalogModal() {
		var modal = document.getElementById('saving-catalog-match-modal');
		if (modal) modal.style.display = 'none';
	}

	function fetchSavingModalResults(query) {
		var resultsEl = document.getElementById('saving-modal-results');
		if (!resultsEl) return;
		resultsEl.innerHTML = '<div class="p-6 text-center text-muted text-xs">جاري البحث في الكتالوج المركزي...</div>';

		fetch(currentSavingSearchURL + '?q=' + encodeURIComponent(query))
			.then(function(res) { return res.json(); })
			.then(function(data) {
				var items = data.items || data.products || data || [];
				if (!items || items.length === 0) {
					resultsEl.innerHTML = '<div class="p-6 text-center text-muted text-xs">لم يتم العثور على أي صنف مطابق في الكتالوج.</div>';
					return;
				}
				var html = '';
				items.forEach(function(item) {
					var name = item.name_ar || item.name_en || item.name || '';
					var sku = item.sku || '';
					var id = item.id;
					var price = item.public_price || item.price || '';
					var priceStr = price ? '<span class="badge badge-slate text-xs tabular-nums font-bold">' + price + ' ج.م</span>' : '';
					var skuStr = sku ? '<span class="text-xs text-muted font-mono">' + escapeSavingHtml(sku) + '</span>' : '';

					html += '<form method="POST" action="' + currentSavingActionURL + '" class="m-0">' +
						'<input type="hidden" name="product_id" value="' + id + '" />' +
						'<input type="hidden" name="master_name" value="' + escapeSavingHtml(name) + '" />' +
						'<input type="hidden" name="master_sku" value="' + escapeSavingHtml(sku) + '" />' +
						'<button type="submit" class="p-3 w-100 text-start flex-between items-center gap-3 border rounded-xl hover-lift cursor-pointer" style="margin-bottom:0; background:rgba(30,41,59,0.7); border-color:rgba(59,130,246,0.25);">' +
						'<div><div class="text-sm font-extrabold text-primary">' + escapeSavingHtml(name) + '</div>' +
						'<div class="d-flex items-center gap-2 mt-1">' + skuStr + priceStr + '</div></div>' +
						'<span class="btn btn-primary btn-xs font-bold shrink-0">ربط </span>' +
						'</button>' +
						'</form>';
				});
				resultsEl.innerHTML = html;
			})
			.catch(function(err) {
				resultsEl.innerHTML = '<div class="p-6 text-center text-danger text-xs">تعذر جلب نتائج البحث. يرجى المحاولة ثانية.</div>';
			});
	}

	function escapeSavingHtml(text) {
		if (!text) return '';
		return String(text)
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#039;");
	}

	document.addEventListener('keydown', function(e) {
		if (e.key === 'Escape') {
			closeSavingCatalogModal();
		}
	});

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', ensureSavingModalInBody);
	} else {
		ensureSavingModalInBody();
	}
	</script>
}

templ savingThSort(view SavingImportView, colKey, label string) {
	{{
		isCurrent := view.Filter.SortBy == colKey
		nextOrder := "asc"
		if isCurrent && view.Filter.SortOrder == "asc" {
			nextOrder = "desc"
		}
		sortURL := buildSavingURL(view.ImportURL, view.Session.ID, view.Filter.MatchFilter, colKey, nextOrder, 1, view.Filter.Limit, view.Filter.Search)
	}}
	<th>
		<a href={ templ.SafeURL(sortURL) } class="row-center-xs gap-xs" style="color: inherit; text-decoration: none;">
			<span>{ label }</span>
			if isCurrent {
				if view.Filter.SortOrder == "desc" {
					<span style="font-size: 0.75rem;">▼</span>
				} else {
					<span style="font-size: 0.75rem;">▲</span>
				}
			} else {
				<span style="font-size: 0.75rem; opacity: 0.4;">⇅</span>
			}
		</a>
	</th>
}

templ savingFilterTab(view SavingImportView, matchKey, label string) {
	{{
		isActive := view.Filter.MatchFilter == matchKey
		tabURL := buildSavingURL(view.ImportURL, view.Session.ID, matchKey, view.Filter.SortBy, view.Filter.SortOrder, 1, view.Filter.Limit, view.Filter.Search)
	}}
	<a href={ templ.SafeURL(tabURL) }
		class={ "btn btn-xs font-bold", templ.KV("btn-primary", isActive), templ.KV("btn-secondary", !isActive) }>
		{ label }
	</a>
}

templ savingProductRow(view SavingImportView, row *StagedSavingItem) {
	{{
		actionBase := fmt.Sprintf("%s/%s/items/%d", view.ImportURL, view.Session.ID, row.Index)
		querySuffix := fmt.Sprintf("?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s",
			view.Filter.MatchFilter, view.Filter.SortBy, view.Filter.SortOrder, view.Filter.Page, view.Filter.Limit, view.Filter.Search)
		searchURL := view.BaseURL + "/search-products"
	}}
	<tr id={ fmt.Sprintf("saving-row-%d", row.Index) } class={ templ.KV("opacity-50", !row.Included) }>
		<td class="text-center align-middle">
			<form method="POST" action={ templ.SafeURL(actionBase + "/toggle" + querySuffix) } style="margin: 0;">
				<input type="checkbox" checked?={ row.Included } onchange="this.form.submit()" title="تضمين / استثناء" />
			</form>
		</td>

		<td class="align-middle">
			<form method="POST" action={ templ.SafeURL(actionBase + "/update" + querySuffix) } class="stack-2xs m-0">
				<div class="row-center-xs gap-xs">
					<input type="text" name="name" value={ row.NameProduct } class="form-input text-xs font-bold"
						style="padding: 0.35rem 0.5rem;" />
					<button type="submit" class="btn btn-ghost btn-xs px-1.5" title="حفظ الاسم">@components.IconCheck("icon-sm")</button>
				</div>
				if row.SKU != "" {
					<span class="text-2xs text-muted font-mono">{ row.SKU }</span>
				}
			</form>
		</td>

		<td class="align-middle saving-catalog-cell">
			<div class="row-center-sm gap-xs">
				if row.ProductID != nil && *row.ProductID > 0 {
					<div class="stack-2xs flex-1">
						<span class="text-xs font-black text-primary">{ row.MasterProductName }</span>
						if row.MasterProductSKU != "" {
							<span class="text-2xs text-muted font-mono">{ row.MasterProductSKU }</span>
						}
					</div>
					<button type="button" class="btn btn-secondary btn-xs font-bold"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openSavingCatalogModal(%d, '%s', '%s', '%s', true)", row.Index, searchURL, actionBase+"/match"+querySuffix, row.NameProduct)} }>
						تغيير
					</button>
				} else {
					<button type="button" class="btn btn-primary btn-xs font-bold d-inline-flex items-center gap-1"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openSavingCatalogModal(%d, '%s', '%s', '%s', false)", row.Index, searchURL, actionBase+"/match"+querySuffix, row.NameProduct)} }>
						@components.IconPlus("icon-xxs")
						<span>ربط بالكتالوج</span>
					</button>
				}
			</div>
		</td>

		<td class="text-center align-middle">
			if row.ProductID != nil && *row.ProductID > 0 {
				if row.MatchType == "manual" {
					<span class="badge badge-emerald text-xs font-bold">مطابقة يدوية</span>
				} else if row.Confidence >= 0.75 {
					<span class="badge badge-emerald text-xs font-bold">{ fmt.Sprintf("%.0f%%", row.Confidence*100) } (مطابق)</span>
				} else {
					<span class="badge badge-amber text-xs font-bold">{ fmt.Sprintf("%.0f%%", row.Confidence*100) }</span>
				}
			} else {
				<span class="badge badge-rose text-xs font-bold">غير مرتبط</span>
			}
		</td>

		<td class="text-center align-middle">
			<form method="POST" action={ templ.SafeURL(actionBase + "/update" + querySuffix) } class="row-center-xs justify-center gap-xs m-0">
				<input type="number" step="1" min="1" name="quantity" value={ fmt.Sprintf("%.0f", row.Quantity) }
					class="form-input text-center tabular-nums text-xs" style="padding: 0.35rem 0.4rem; width: 60px;" />
				<button type="submit" class="btn btn-ghost btn-xs px-1.5" title="حفظ الكمية">@components.IconCheck("icon-sm")</button>
			</form>
		</td>

		<td class="text-center align-middle">
			<form method="POST" action={ templ.SafeURL(actionBase + "/update" + querySuffix) } class="row-center-xs justify-center gap-xs m-0">
				<input type="number" step="0.01" min="0" name="price" value={ row.Price.String() }
					class="form-input text-center tabular-nums text-xs" style="padding: 0.35rem 0.4rem; width: 75px;" />
				<button type="submit" class="btn btn-ghost btn-xs px-1.5" title="حفظ السعر">@components.IconCheck("icon-sm")</button>
			</form>
		</td>

		<td class="text-center align-middle tabular-nums font-black text-xs text-primary">
			{ row.TotalValue.String() } ج.م
		</td>
	</tr>
}

templ savingPagination(view SavingImportView) {
	{{
		limit := view.Filter.Limit
		if limit <= 0 {
			limit = 25
		}
		totalPages := (view.RowTotal + limit - 1) / limit
		currPage := view.Filter.Page
		if currPage <= 0 {
			currPage = 1
		}
	}}
	<div class="b2b-pagination p-4 border-t flex-between items-center flex-wrap gap-3">
		<div class="b2b-pagination-info text-xs text-secondary">
			عرض <strong class="text-primary tabular-nums font-bold">{ fmt.Sprint(len(view.Rows)) }</strong> من إجمالي <strong class="text-primary tabular-nums font-bold">{ fmt.Sprint(view.RowTotal) }</strong> صنف
		</div>
		if totalPages > 1 {
			<div class="b2b-pagination-controls d-flex items-center gap-2">
				if currPage > 1 {
					<a href={ templ.SafeURL(buildSavingURL(view.ImportURL, view.Session.ID, view.Filter.MatchFilter, view.Filter.SortBy, view.Filter.SortOrder, currPage-1, limit, view.Filter.Search)) }
						class="btn btn-secondary btn-xs font-bold">
						السابق
					</a>
				}
				<span class="text-xs text-secondary px-2 tabular-nums">صفحة <strong class="text-primary font-bold">{ fmt.Sprint(currPage) }</strong> من <strong class="text-primary font-bold">{ fmt.Sprint(totalPages) }</strong></span>
				if currPage < totalPages {
					<a href={ templ.SafeURL(buildSavingURL(view.ImportURL, view.Session.ID, view.Filter.MatchFilter, view.Filter.SortBy, view.Filter.SortOrder, currPage+1, limit, view.Filter.Search)) }
						class="btn btn-secondary btn-xs font-bold">
						التالي
					</a>
				}
			</div>
		}
	</div>
}
