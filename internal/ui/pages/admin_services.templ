package pages

import (
	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminServices(lang, dir string, services []*workflow.InstitutionalService) {
	@layouts.AdminShell("الخدمات المؤسسية | Services", "services", lang, dir) {
		<div class="card" style="margin-bottom:1.25rem;">
			<h2 class="card-title" style="margin:0 0 1rem;">خدمة جديدة</h2>
			<form method="POST" action="/admin/services" style="display:flex; flex-direction:column; gap:0.9rem;">
				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="s-title-ar">العنوان (عربي)</label>
						<input type="text" id="s-title-ar" name="title_ar" required class="form-input" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="s-title-en">العنوان (إنجليزي)</label>
						<input type="text" id="s-title-en" name="title_en" class="form-input" dir="ltr" />
					</div>
				</div>
				<div class="form-group" style="margin-bottom:0;">
					<label class="form-label" for="s-desc">الوصف (عربي)</label>
					<textarea id="s-desc" name="description_ar" rows="3" class="form-textarea"></textarea>
				</div>
				<div class="form-group" style="margin-bottom:0;">
					<label class="form-label" for="s-pricing">نوع التسعير</label>
					<select id="s-pricing" name="pricing_type" class="form-input">
						<option value="free">مجانية</option>
						<option value="paid">مدفوعة</option>
						<option value="subscription">اشتراك</option>
					</select>
				</div>
				<button type="submit" class="btn btn-primary" style="justify-content:center;">
					@components.IconPlus("icon-sm")
					<span>إضافة الخدمة</span>
				</button>
			</form>
		</div>

		<div class="card">
			<h2 class="card-title" style="margin:0 0 0.75rem;">الخدمات الحالية</h2>
			if len(services) == 0 {
				<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد خدمات بعد.</p>
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead><tr><th>العنوان</th><th>النوع</th><th>الحالة</th></tr></thead>
						<tbody>
							for _, s := range services {
								<tr>
									<td>{ s.Title.Get(i18n.Lang(lang)) }</td>
									<td>{ pricingLabel(s.PricingType) }</td>
									<td><span class="badge badge-emerald">
										if s.IsActive {
											نشطة
										} else {
											معطلة
										}
									</span></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
