package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/platform/features"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminSettingsValues carries the stored platform settings, feature flags, AI gateway, and site branding.
type AdminSettingsValues struct {
	ActiveTab              string // "features", "site", "policies", "payment_methods"
	SupportEmail           string
	CommissionRate         string
	FeatureFlags           []features.FeatureFlag
	GatewaySettings        *platformadmin.GatewaySettings
	SiteSettings           *platformadmin.SiteSettings
	Policies               []*platformadmin.Policy
	PolicyKey              string
	ActivePolicy           *platformadmin.Policy
	PlatformPaymentMethods []*billing.PlatformPaymentMethod
}

templ AdminSettings(values AdminSettingsValues, lang, dir string) {
	@layouts.AdminShell("إعدادات المنصة والمنظومة | Platform Settings", "settings", lang, dir) {
		<div
			style="max-width:1100px; margin:0 auto;"
			x-data="{
				activeTab: 'features',
				isMethodModalOpen: false,
				isEditingMethod: false,
				methodForm: {
					id: '',
					name_ar: '',
					name_en: '',
					provider_type: 'bank',
					description_ar: '',
					description_en: '',
					account_name: '',
					bank_name: '',
					account_number: '',
					iban: '',
					swift_code: '',
					branch_name: '',
					instapay_handle: '',
					phone_number: '',
					is_active: true,
					is_deposit_enabled: true,
					is_checkout_enabled: true,
					display_order: 1
				},
				init() {
					const urlParams = new URLSearchParams(window.location.search);
					let tab = urlParams.get('tab') || localStorage.getItem('dawa24-admin-tab') || 'features';
					if (tab !== 'features' && tab !== 'site' && tab !== 'policies' && tab !== 'payment_methods') {
						tab = 'features';
					}
					this.activeTab = tab;
				},
				setTab(tab) {
					this.activeTab = tab;
					localStorage.setItem('dawa24-admin-tab', tab);
					const u = new URL(window.location);
					u.searchParams.set('tab', tab);
					window.history.replaceState({}, '', u);
				},
				openNewMethodModal() {
					this.isEditingMethod = false;
					this.methodForm = {
						id: '',
						name_ar: '',
						name_en: '',
						provider_type: 'bank',
						description_ar: '',
						description_en: '',
						account_name: '',
						bank_name: '',
						account_number: '',
						iban: '',
						swift_code: '',
						branch_name: '',
						instapay_handle: '',
						phone_number: '',
						is_active: true,
						is_deposit_enabled: true,
						is_checkout_enabled: true,
						display_order: 1
					};
					this.isMethodModalOpen = true;
				},
				openEditMethodModal(pm) {
					this.isEditingMethod = true;
					this.methodForm = {
						id: pm.id || '',
						name_ar: pm.name_ar || '',
						name_en: pm.name_en || '',
						provider_type: pm.provider_type || 'bank',
						description_ar: pm.description_ar || '',
						description_en: pm.description_en || '',
						account_name: pm.account_name || '',
						bank_name: pm.bank_name || '',
						account_number: pm.account_number || '',
						iban: pm.iban || '',
						swift_code: pm.swift_code || '',
						branch_name: pm.branch_name || '',
						instapay_handle: pm.instapay_handle || '',
						phone_number: pm.phone_number || '',
						is_active: pm.is_active,
						is_deposit_enabled: pm.is_deposit_enabled,
						is_checkout_enabled: pm.is_checkout_enabled,
						display_order: pm.display_order || 1
					};
					this.isMethodModalOpen = true;
				}
			}"
		>
			
			<!-- Header -->
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; gap:1rem; flex-wrap:wrap;">
				<div style="display:flex; align-items:center; gap:0.75rem;">
					<div style="width:46px; height:46px; border-radius:var(--radius-xl); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconSettings("icon-md")
					</div>
					<div>
						<h2 class="card-title" style="margin:0; font-size:1.55rem; font-weight:800;">
							إعدادات المنصة والمنظومة
						</h2>
						<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
							إدارة الهوية البصرية، بيانات التواصل، بوابة الذكاء الاصطناعي، السياسات، ومفاتيح الميزات
						</p>
					</div>
				</div>
			</div>

			<!-- Main Persistent Tabs Bar -->
			<div style="display:flex; gap:0.5rem; border-bottom:2px solid var(--border); margin-bottom:1.75rem; flex-wrap:wrap;">
				<button
					type="button"
					class="btn"
					:class="activeTab === 'features' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('features')"
				>
					@components.IconShield("icon-xs")
					<span>1. ميزات المنصة والعمولة</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'site' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('site')"
				>
					@components.IconBuilding("icon-xs")
					<span>2. إعدادات الموقع والهوية</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'policies' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('policies')"
				>
					@components.IconFile("icon-xs")
					<span>3. السياسات والشروط القانونية</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'payment_methods' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.65rem 1.25rem;"
					@click="setTab('payment_methods')"
				>
					@components.IconWallet("icon-xs")
					<span>4. طرق وقنوات الدفع المعتمدة</span>
				</button>
			</div>

			<!-- ========================================== -->
			<!-- TAB 1: Platform & Features                 -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'features'" style="display:flex; flex-direction:column; gap:1.5rem;">
				
				<!-- Feature Flags -->
				<div class="card" style="margin-bottom:0;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
						<div>
							<h3 class="card-title" style="margin:0; font-size:1.15rem; font-weight:800;">
								مفاتيح تشغيل الميزات والأنظمة (Feature Flags)
							</h3>
							<p style="font-size:0.8rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								التحكم الفوري في إظهار أو إخفاء أقسام المنصة، إعلانات التوظيف، العروض، والخدمات
							</p>
						</div>
					</div>

					<div style="display:grid; gap:0.75rem;">
						for _, flag := range values.FeatureFlags {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1.15rem; background:var(--surface-sunken); border-radius:var(--radius-lg); border:1px solid var(--border);">
								<div>
									<div style="display:flex; align-items:center; gap:0.5rem;">
										<strong style="font-size:0.9rem; color:var(--text);">
											if flag.Name["ar"] != "" {
												{ flag.Name["ar"] }
											} else {
												{ flag.Key }
											}
										</strong>
										if flag.IsEnabled {
											<span class="badge badge-emerald" style="font-size:0.7rem;">نشط ومفعل</span>
										} else {
											<span class="badge badge-slate" style="font-size:0.7rem;">معطل حالياً</span>
										}
										<span class="badge badge-sky" style="font-family:monospace; font-size:10px;">{ flag.Key }</span>
									</div>
									<div style="font-size:0.8rem; color:var(--text-secondary); margin-top:3px;">
										if flag.Description["ar"] != "" {
											{ flag.Description["ar"] }
										} else {
											{ flag.Key }
										}
									</div>
								</div>

								<form method="POST" action="/admin/settings/features/toggle" style="margin:0;">
									<input type="hidden" name="key" value={ flag.Key }/>
									<input type="hidden" name="enabled" value={ fmt.Sprintf("%t", !flag.IsEnabled) }/>
									if flag.IsEnabled {
										<button
											type="submit"
											class="btn btn-sm"
											style="min-width:120px; justify-content:center; background:#10b981; color:#ffffff; border:1px solid #059669; font-weight:700; border-radius:var(--radius-full);"
											title="انقر لتعطيل الميزة"
										>
											@components.IconCheck("icon-xs")
											<span>مفعل (Active)</span>
										</button>
									} else {
										<button
											type="submit"
											class="btn btn-sm btn-secondary"
											style="min-width:120px; justify-content:center; background:var(--surface-raised); color:var(--text-muted); border:1px solid var(--border); font-weight:600; border-radius:var(--radius-full);"
											title="انقر لتفعيل الميزة"
										>
											<span>✕ معطل (Disabled)</span>
										</button>
									}
								</form>
							</div>
						}
					</div>
				</div>

				<!-- Financial & General Config -->
				<div class="card" style="margin-bottom:0;">
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
						@components.IconSettings("icon-md")
						<h3 class="card-title" style="margin:0; font-size:1.15rem; font-weight:800;">
							الإعدادات المالية والمنظومة
						</h3>
					</div>

					<form action="/admin/settings" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">العملة الافتراضية للمعاملات</label>
								<input type="text" value="EGP (الجنيه المصري)" disabled class="form-input" style="background:var(--surface-sunken); color:var(--text-muted);"/>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">اللغات المعتمدة في النظام</label>
								<input type="text" value="العربية (الرئيسية)، English" disabled class="form-input" style="background:var(--surface-sunken); color:var(--text-muted);"/>
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">بريد إشعارات الدعم الفني *</label>
								<input type="email" name="support_email" value={ values.SupportEmail } required class="form-input" dir="ltr"/>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">نسبة عمولة المنصة الافتراضية (%) *</label>
								<input type="number" name="commission_rate" value={ values.CommissionRate } step="0.1" min="0" max="100" required class="form-input tabular-nums"/>
							</div>
						</div>

						<div style="display:flex; justify-content:flex-end; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.6rem 2rem;">
								@components.IconCheck("icon-xs")
								<span>حفظ إعدادات المنصة</span>
							</button>
						</div>
					</form>
				</div>

			</div>

			<!-- ========================================== -->
			<!-- TAB 2: Site Info & Visual Identity         -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'site'" style="display:flex; flex-direction:column; gap:1.5rem;">
				
				<div class="card" style="margin-bottom:0;" x-data="{ siteSubTab: 'contact' }">
					
					<div style="display:flex; gap:0.5rem; border-bottom:1px solid var(--border); margin-bottom:1.5rem; padding-bottom:0.75rem;">
						<button
							type="button"
							class="btn btn-sm"
							:class="siteSubTab === 'contact' ? 'btn-primary' : 'btn-secondary'"
							@click="siteSubTab = 'contact'"
							style="font-weight:700;"
						>
							@components.IconBuilding("icon-xs")
							<span>بيانات التواصل والفوتر</span>
						</button>
						<button
							type="button"
							class="btn btn-sm"
							:class="siteSubTab === 'socials' ? 'btn-primary' : 'btn-secondary'"
							@click="siteSubTab = 'socials'"
							style="font-weight:700;"
						>
							@components.IconLayers("icon-xs")
							<span>روابط التواصل الاجتماعي (10)</span>
						</button>
						<button
							type="button"
							class="btn btn-sm"
							:class="siteSubTab === 'branding' ? 'btn-primary' : 'btn-secondary'"
							@click="siteSubTab = 'branding'"
							style="font-weight:700;"
						>
							@components.IconPackage("icon-xs")
							<span>الهوية البصرية والشعار</span>
						</button>
					</div>

					<!-- 1. Contact Info Form -->
					<div x-show="siteSubTab === 'contact'">
						<form action="/admin/settings/site" method="POST" style="display:flex; flex-direction:column; gap:1.15rem;">
							<input type="hidden" name="section" value="contact"/>
							
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">اسم المنصة / الموقع (Site Name) *</label>
									<input type="text" name="site_name" value={ values.SiteSettings.SiteName } required class="form-input"/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">وصف المنصة المختصر (Tagline)</label>
									<input type="text" name="site_description" value={ values.SiteSettings.SiteDescription } class="form-input"/>
								</div>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">بريد التواصل العام (Contact Email) *</label>
									<input type="email" name="contact_email" value={ values.SiteSettings.ContactEmail } required class="form-input" dir="ltr"/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">بريد الدعم الفني (Support Email) *</label>
									<input type="email" name="support_email" value={ values.SiteSettings.SupportEmail } required class="form-input" dir="ltr"/>
								</div>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">رقم الهاتف الرسمي (Phone) *</label>
									<input type="text" name="phone" value={ values.SiteSettings.Phone } required class="form-input tabular-nums" dir="ltr"/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">رقم واتساب المباشر (WhatsApp) *</label>
									<input type="text" name="whatsapp" value={ values.SiteSettings.WhatsApp } required class="form-input tabular-nums" dir="ltr" placeholder="201065397000"/>
								</div>
							</div>

							<div class="form-group" style="margin:0;">
								<label class="form-label">العنوان الرئيسي للمقر (Head Office Address)</label>
								<input type="text" name="address" value={ values.SiteSettings.Address } class="form-input" placeholder="القاهرة، جمهورية مصر العربية"/>
							</div>

							<div style="display:flex; justify-content:flex-end; border-top:1px solid var(--border); padding-top:1rem; margin-top:0.5rem;">
								<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.6rem 2rem;">
									@components.IconCheck("icon-xs")
									<span>حفظ وتحديث بيانات التواصل</span>
								</button>
							</div>
						</form>
					</div>

					<!-- 2. Social Media Links Form -->
					<div x-show="siteSubTab === 'socials'">
						<form action="/admin/settings/site" method="POST" style="display:flex; flex-direction:column; gap:1.15rem;">
							<input type="hidden" name="section" value="socials"/>

							<p style="font-size:0.85rem; color:var(--text-secondary); margin:0 0 0.5rem 0;">
								سيتم حفظ هذه الروابط في قاعدة البيانات وعكسها تلقائياً في الفوتر وكافة الأقسام الرسمية للموقع.
							</p>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">Facebook</label>
									<input type="url" name="social_facebook" value={ values.SiteSettings.SocialLinks["facebook"] } class="form-input" dir="ltr" placeholder="https://facebook.com/dawa24"/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">Twitter / X</label>
									<input type="url" name="social_twitter" value={ values.SiteSettings.SocialLinks["twitter"] } class="form-input" dir="ltr" placeholder="https://twitter.com/dawa24"/>
								</div>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">Instagram</label>
									<input type="url" name="social_instagram" value={ values.SiteSettings.SocialLinks["instagram"] } class="form-input" dir="ltr" placeholder="https://instagram.com/dawa24"/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">LinkedIn</label>
									<input type="url" name="social_linkedin" value={ values.SiteSettings.SocialLinks["linkedin"] } class="form-input" dir="ltr" placeholder="https://linkedin.com/company/dawa24"/>
								</div>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">YouTube</label>
									<input type="url" name="social_youtube" value={ values.SiteSettings.SocialLinks["youtube"] } class="form-input" dir="ltr" placeholder="https://youtube.com/@dawa24"/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">TikTok</label>
									<input type="url" name="social_tiktok" value={ values.SiteSettings.SocialLinks["tiktok"] } class="form-input" dir="ltr" placeholder="https://tiktok.com/@dawa24"/>
								</div>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">Snapchat</label>
									<input type="url" name="social_snapchat" value={ values.SiteSettings.SocialLinks["snapchat"] } class="form-input" dir="ltr" placeholder="https://snapchat.com/add/dawa24"/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">Telegram</label>
									<input type="url" name="social_telegram" value={ values.SiteSettings.SocialLinks["telegram"] } class="form-input" dir="ltr" placeholder="https://t.me/dawa24"/>
								</div>
							</div>

							<div style="display:flex; justify-content:flex-end; border-top:1px solid var(--border); padding-top:1rem; margin-top:0.5rem;">
								<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.6rem 2rem;">
									@components.IconCheck("icon-xs")
									<span>حفظ روابط التواصل الاجتماعي</span>
								</button>
							</div>
						</form>
					</div>

					<!-- 3. Branding & Logo Form -->
					<div x-show="siteSubTab === 'branding'" x-data="{ logoPreview: '' }">
						<form action="/admin/settings/branding" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:1.25rem;">
							
							<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem; display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap;">
								<div style="width:120px; height:80px; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); display:flex; align-items:center; justify-content:center; padding:0.5rem; overflow:hidden;">
									<img
										:src="logoPreview || '/static/img/logo.png'"
										alt="Logo Preview"
										style="max-width:100%; max-height:100%; object-fit:contain;"
									/>
								</div>
								<div>
									<h4 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">
										الشعار الرسمي للمنصة (Platform Logo)
									</h4>
									<p style="font-size:0.8rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
										عند تغيير الشعار، سيتم تطبيقه فورياً على كافة واجهات الهيدر والفوتر والصفحات والشاشات.
									</p>
								</div>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin:0;">
									<label class="form-label">رفع ملف الشعار الجديد (PNG / SVG / WEBP)</label>
									<input
										type="file"
										name="logo_file"
										accept="image/*"
										class="form-input"
										@change="const file = $event.target.files[0]; if (file) logoPreview = URL.createObjectURL(file)"
									/>
								</div>
								<div class="form-group" style="margin:0;">
									<label class="form-label">أو مسار/رابط الشعار المباشر (Logo URL)</label>
									<input
										type="text"
										name="logo_url"
										value={ values.SiteSettings.LogoURL }
										class="form-input"
										dir="ltr"
										placeholder="/static/img/logo.png"
									/>
								</div>
							</div>

							<div class="form-group" style="margin:0;">
								<label class="form-label">أيقونة المتصفح المفضلة (Favicon URL / Path)</label>
								<input type="text" name="favicon_url" value={ values.SiteSettings.FaviconURL } class="form-input" dir="ltr" placeholder="/static/img/logo.png"/>
							</div>

							<div style="display:flex; justify-content:flex-end; border-top:1px solid var(--border); padding-top:1rem; margin-top:0.5rem;">
								<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.6rem 2rem;">
									@components.IconCheck("icon-xs")
									<span>حفظ وتطبيق الهوية البصرية</span>
								</button>
							</div>
						</form>
					</div>

				</div>

			</div>

			<!-- ========================================== -->
			<!-- TAB 3: Policies & Legal Documents Overview -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'policies'" style="display:flex; flex-direction:column; gap:1.5rem;">
				
				<div class="card" style="margin-bottom:0;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem; flex-wrap:wrap; gap:1rem;">
						<div>
							<h3 class="card-title" style="margin:0; font-size:1.15rem; font-weight:800;">
								السياسات والشروط القانونية
							</h3>
							<p style="font-size:0.8rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								إدارة ونشر الإصدارات المعتمدة لشروط الاستخدام وسياسة الخصوصية وسجل النسخ القانونية
							</p>
						</div>
						<a href="/admin/policies" class="btn btn-primary" style="font-weight:700; gap:0.5rem;">
							@components.IconShield("icon-xs")
							<span>إدارة وتعديل السياسات وإصداراتها</span>
						</a>
					</div>

					<!-- Policy Summary Table -->
					if len(values.Policies) > 0 {
						<div class="table-container" style="overflow-x:auto;">
							<table class="data-table" style="width:100%; border-collapse:collapse; font-size:0.85rem;">
								<thead>
									<tr>
										<th style="width:25%; text-align:start;">نوع الوثيقة</th>
										<th style="width:10%; text-align:center;">الإصدار</th>
										<th style="width:35%; text-align:start;">العنوان</th>
										<th style="width:15%; text-align:center;">حالة النشر</th>
										<th style="width:15%; text-align:start;">تاريخ التحديث</th>
									</tr>
								</thead>
								<tbody>
									for _, p := range values.Policies {
										<tr>
											<td style="text-align:start;">
												<span class="badge badge-slate" style="font-weight:700;">{ policyKeyAr(p.PolicyKey) }</span>
											</td>
											<td style="text-align:center;" class="tabular-nums">
												<strong style="color:var(--accent);">v{ p.Version }</strong>
											</td>
											<td style="text-align:start;">
												<strong>{ p.Title["ar"] }</strong>
											</td>
											<td style="text-align:center;">
												if p.IsPublished {
													<span class="badge badge-emerald">منشور ونشط</span>
												} else {
													<span class="badge badge-amber">مسودة</span>
												}
											</td>
											<td style="text-align:start;" class="tabular-nums">
												<span style="color:var(--text-muted);">{ p.UpdatedAt.Format("2006-01-02 15:04") }</span>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					} else {
						<div class="empty-state" style="padding:2.5rem; text-align:center;">
							<p style="color:var(--text-secondary); margin-bottom:1rem;">لا توجد سياسات مسجلة حالياً في قاعدة البيانات.</p>
							<a href="/admin/policies" class="btn btn-secondary btn-sm" style="font-weight:700;">
								@components.IconPlus("icon-xs")
								<span>إنشاء أول وثيقة سياسة</span>
							</a>
						</div>
					}
				</div>

			</div>

			<!-- ========================================== -->
			<!-- TAB 4: Platform Payment Methods & Banking  -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'payment_methods'" style="display:flex; flex-direction:column; gap:1.5rem;">
				
				<div class="card" style="margin-bottom:0;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem; flex-wrap:wrap; gap:1rem;">
						<div>
							<h3 class="card-title" style="margin:0; font-size:1.25rem; font-weight:800;">
								قنوات وطرق الدفع والتحويل البنكي للمنصة
							</h3>
							<p style="font-size:0.85rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
								إدارة الحسابات البنكية الرسمية، معرفات إنستاباي، بوابات الدفع الإلكتروني، وتحديد قنوات الإيداع والسداد المتاحة للصيدليات والموردين
							</p>
						</div>

						<button
							type="button"
							class="btn btn-primary"
							@click="openNewMethodModal()"
							style="font-weight:800;"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة قناة دفع جديدة</span>
						</button>
					</div>

					if len(values.PlatformPaymentMethods) == 0 {
						<div style="padding:3.5rem 1.5rem; text-align:center; border:2px dashed var(--border); border-radius:var(--radius-xl); background:var(--surface-sunken);">
							<div style="width:48px; height:48px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;">
								@components.IconWallet("icon-md")
							</div>
							<h4 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0 0 0.35rem 0;">لا توجد قنوات دفع مهيأة</h4>
							<p style="font-size:0.85rem; color:var(--text-muted); max-width:420px; margin:0 auto 1.5rem auto;">
								أضف الحسابات البنكية ومعرفات إنستاباي المعتمدة لمنصة دواء 24 لتظهر للصيدليات والموردين عند شحن المحفظة وسداد الطلبيات.
							</p>
							<button type="button" class="btn btn-primary" @click="openNewMethodModal()" style="font-weight:800;">
								@components.IconPlus("icon-xs")
								<span>إضافة أول وسيلة دفع</span>
							</button>
						</div>
					} else {
						<div style="display:flex; flex-direction:column; gap:1.25rem;">
							for _, pm := range values.PlatformPaymentMethods {
								<div style="border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem; background:var(--surface-sunken); display:flex; flex-direction:column; gap:1rem;">
									<!-- Card Header -->
									<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; border-bottom:1px solid var(--border); padding-bottom:0.85rem;">
										<div style="display:flex; align-items:center; gap:0.85rem;">
											<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
												if pm.ProviderType == "bank" {
													@components.IconBuilding("icon-sm")
												} else if pm.ProviderType == "instapay" {
													@components.IconWallet("icon-sm")
												} else {
													@components.IconShield("icon-sm")
												}
											</div>
											<div>
												<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
													<strong style="font-size:1.05rem; color:var(--text);">{ pm.Name.Get(i18n.Lang(lang)) }</strong>
													<code style="font-size:0.75rem; background:var(--surface-raised); padding:0.15rem 0.45rem; border-radius:4px; border:1px solid var(--border);" dir="ltr">#{ pm.ID }</code>
												</div>
												<div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.2rem;">
													{ pm.Name.Get("en") }
												</div>
											</div>
										</div>

										<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
											if pm.IsActive {
												<span class="badge badge-emerald" style="font-weight:700;">مفعل ونشط</span>
											} else {
												<span class="badge badge-slate" style="font-weight:700;">معطل</span>
											}

											if pm.IsDepositEnabled {
												<span class="badge badge-sky" style="font-size:0.725rem;">شحن المحفظة ✓</span>
											}
											if pm.IsCheckoutEnabled {
												<span class="badge badge-indigo" style="font-size:0.725rem;">سداد الطلبات ✓</span>
											}
										</div>
									</div>

									<!-- Card Details Grid -->
									<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem; font-size:0.875rem;">
										if pm.ProviderType == "bank" {
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">اسم البنك</span>
												<strong style="color:var(--text);">{ pm.BankName }</strong>
											</div>
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">اسم صاحب الحساب</span>
												<strong style="color:var(--text);">{ pm.AccountName }</strong>
											</div>
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">رقم الحساب</span>
												<strong style="color:var(--accent);" class="tabular-nums" dir="ltr">{ pm.AccountNumber }</strong>
											</div>
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">الآيبان الدولي (IBAN)</span>
												<strong style="color:var(--text);" class="tabular-nums" dir="ltr">{ pm.IBAN }</strong>
											</div>
										} else if pm.ProviderType == "instapay" || pm.ProviderType == "wallet" {
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">عنوان الدفع اللحظي (IPA)</span>
												<strong style="color:var(--accent);" class="tabular-nums" dir="ltr">{ pm.InstaPayHandle }</strong>
											</div>
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">رقم الهاتف المرتبط</span>
												<strong style="color:var(--text);" class="tabular-nums" dir="ltr">{ pm.PhoneNumber }</strong>
											</div>
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">اسم الحساب / المحفظة</span>
												<strong style="color:var(--text);">{ pm.AccountName }</strong>
											</div>
										} else {
											<div style="padding:0.75rem 1rem; background:var(--surface-raised); border-radius:var(--radius-md); border:1px solid var(--border);">
												<span style="font-size:0.75rem; color:var(--text-muted); display:block;">بوابة الدفع</span>
												<strong style="color:var(--text);">{ pm.BankName }</strong>
											</div>
										}
									</div>

									if pm.Description.Get("ar") != "" {
										<div style="font-size:0.825rem; color:var(--text-secondary); background:var(--surface-raised); padding:0.6rem 0.85rem; border-radius:var(--radius-md); border:1px solid var(--border);">
											<strong>التعليمات للصيدليات:</strong> { pm.Description.Get("ar") }
										</div>
									}

									<!-- Card Actions -->
									<div style="display:flex; justify-content:flex-end; align-items:center; gap:0.75rem; border-top:1px solid var(--border); padding-top:0.85rem;">
										<form method="POST" action="/admin/settings/payment-methods/toggle" style="margin:0;">
											<input type="hidden" name="id" value={ pm.ID } />
											<input type="hidden" name="enabled" value={ ternaryStr(pm.IsActive, "0", "1") } />
											if pm.IsActive {
												<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--warning-text); border-color:var(--warning-border);">
													تعطيل القناة مؤقتاً
												</button>
											} else {
												<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--success-text); border-color:var(--success-border);">
													تفعيل القناة
												</button>
											}
										</form>

										<button
											type="button"
											class="btn btn-secondary btn-sm"
											style="font-weight:700;"
											@click={ fmt.Sprintf("openEditMethodModal(%s)", pmToJSON(pm)) }
										>
											@components.IconSettings("icon-xs")
											<span>تعديل البيانات</span>
										</button>

										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/settings/payment-methods/%s/delete", pm.ID)) } style="margin:0;" onsubmit="return confirm('هل أنت متأكد من حذف وسيلة الدفع هذه نهائياً من المنصة؟');">
											<button type="submit" class="btn btn-secondary btn-sm btn-icon" style="color:var(--danger); border-color:var(--danger-border);" title="حذف وسيلة الدفع">
												@components.IconTrash("icon-xs")
											</button>
										</form>
									</div>
								</div>
							}
						</div>
					}
				</div>

			</div>

			<!-- Dynamic Modal: Add / Edit Platform Payment Channel (Centered Popup) -->
			<div
				x-show="isMethodModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.75); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isMethodModalOpen = false"
			>
				<div
					@click.outside="isMethodModalOpen = false"
					class="card"
					style="max-width:680px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconWallet("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;" x-text="isEditingMethod ? 'تعديل بيانات وسيلة وقناة الدفع' : 'إضافة وسيلة دفع جديدة للمنصة'">
							</h3>
						</div>
						<button type="button" @click="isMethodModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form action="/admin/settings/payment-methods" method="POST" style="display:flex; flex-direction:column; gap:1.25rem; text-align:start;">
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">المعرف البرمجي الفريد (ID) *</label>
								<input
									type="text"
									name="id"
									x-model="methodForm.id"
									:readonly="isEditingMethod"
									class="form-input tabular-nums"
									dir="ltr"
									placeholder="مثال: instapay, cbe_cib, vodafone_cash"
									required
								/>
							</div>

							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">نوع وسيلة الدفع (Provider Type) *</label>
								<select name="provider_type" x-model="methodForm.provider_type" class="form-select">
									<option value="bank">تحويل وحساب بنكي رسمي (Bank Account / IBAN)</option>
									<option value="instapay">إنستاباي (InstaPay IPN)</option>
									<option value="wallet">محفظة هاتف محمول (Mobile Wallet)</option>
									<option value="card">بوابة بطاقات دفع إلكتروني (Cards / Meeza)</option>
									<option value="cash">دفع نقدي عند الاستلام (Cash on Delivery)</option>
								</select>
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">الاسم بالعربية *</label>
								<input type="text" name="name_ar" x-model="methodForm.name_ar" class="form-input" placeholder="مثال: البنك التجاري الدولي CIB" required />
							</div>

							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label">الاسم بالإنجليزية *</label>
								<input type="text" name="name_en" x-model="methodForm.name_en" class="form-input" placeholder="e.g. Commercial International Bank (CIB)" required />
							</div>
						</div>

						<!-- Bank Specific Fields -->
						<div x-show="methodForm.provider_type === 'bank'" style="display:flex; flex-direction:column; gap:1rem; border:1px solid var(--border); border-radius:var(--radius-lg); padding:1rem; background:var(--surface-sunken);">
							<strong style="font-size:0.875rem; color:var(--accent);">بيانات الحساب البنكي الرسمي:</strong>
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">اسم البنك</label>
									<input type="text" name="bank_name" x-model="methodForm.bank_name" class="form-input" placeholder="مثال: البنك التجاري الدولي CIB" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">اسم صاحب الحساب</label>
									<input type="text" name="account_name" x-model="methodForm.account_name" class="form-input" placeholder="شركة دواء 24 للتجارة والتوزيع ذ.م.م" />
								</div>
							</div>
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">رقم الحساب البنكي</label>
									<input type="text" name="account_number" x-model="methodForm.account_number" class="form-input tabular-nums" dir="ltr" placeholder="100048291048" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">الفرع</label>
									<input type="text" name="branch_name" x-model="methodForm.branch_name" class="form-input" placeholder="الفرع الرئيسي" />
								</div>
							</div>
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">الآيبان الدولي (IBAN)</label>
									<input type="text" name="iban" x-model="methodForm.iban" class="form-input tabular-nums" dir="ltr" placeholder="EG3800100004829104800000000000" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">رمز السويفت (SWIFT / BIC)</label>
									<input type="text" name="swift_code" x-model="methodForm.swift_code" class="form-input tabular-nums" dir="ltr" placeholder="CIBEEGCX" />
								</div>
							</div>
						</div>

						<!-- InstaPay / Wallet Specific Fields -->
						<div x-show="methodForm.provider_type === 'instapay' || methodForm.provider_type === 'wallet'" x-cloak style="display:flex; flex-direction:column; gap:1rem; border:1px solid var(--border); border-radius:var(--radius-lg); padding:1rem; background:var(--surface-sunken);">
							<strong style="font-size:0.875rem; color:var(--accent);">بيانات الدفع اللحظي والمحافظ:</strong>
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">معرف إنستاباي اللحظي (IPA)</label>
									<input type="text" name="instapay_handle" x-model="methodForm.instapay_handle" class="form-input tabular-nums" dir="ltr" placeholder="dawa24@instapay" />
								</div>
								<div class="form-group" style="margin-bottom:0;">
									<label class="form-label">رقم الهاتف المرتبط بالمحفظة</label>
									<input type="tel" name="phone_number" x-model="methodForm.phone_number" class="form-input tabular-nums" dir="ltr" placeholder="01065397000" />
								</div>
							</div>
						</div>

						<!-- Descriptions & Instructions -->
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label">تعليمات وتفاصيل الدفع (عربي)</label>
							<textarea name="description_ar" x-model="methodForm.description_ar" rows="2" class="form-input" placeholder="تعليمات تظهر للمستخدم عند اختيار وسيلة الدفع هذه..."></textarea>
						</div>

						<!-- Settings Flags & Ordering -->
						<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:1rem; background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
							<label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
								<input type="checkbox" name="is_active" value="1" x-model="methodForm.is_active" style="width:18px; height:18px; accent-color:var(--accent);" />
								<span style="font-weight:700; font-size:0.85rem; color:var(--text);">مفعلة بالمنصة</span>
							</label>

							<label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
								<input type="checkbox" name="is_deposit_enabled" value="1" x-model="methodForm.is_deposit_enabled" style="width:18px; height:18px; accent-color:var(--accent);" />
								<span style="font-weight:700; font-size:0.85rem; color:var(--text);">متاحة لشحن المحفظة</span>
							</label>

							<label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
								<input type="checkbox" name="is_checkout_enabled" value="1" x-model="methodForm.is_checkout_enabled" style="width:18px; height:18px; accent-color:var(--accent);" />
								<span style="font-weight:700; font-size:0.85rem; color:var(--text);">متاحة لسداد الطلبات</span>
							</label>

							<div class="form-group" style="margin-bottom:0;">
								<label class="form-label" style="font-size:0.75rem;">ترتيب العرض</label>
								<input type="number" name="display_order" x-model="methodForm.display_order" class="form-input tabular-nums" min="0" />
							</div>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isMethodModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="padding-inline:2rem; font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ وسيلة الدفع</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}

func getPolicyField(policies []*platformadmin.Policy, key, field, lang, fallback string) string {
	l := i18n.Lang(lang)
	for _, p := range policies {
		if p.PolicyKey == key && p.IsPublished {
			if field == "title" {
				if v := p.Title.Get(l); v != "" {
					return v
				}
			} else if field == "content" {
				if v := p.Content.Get(l); v != "" {
					return v
				}
			}
		}
	}
	return fallback
}

func pmToJSON(pm *billing.PlatformPaymentMethod) string {
	if pm == nil {
		return "{}"
	}
	return fmt.Sprintf(
		`{"id":%q,"name_ar":%q,"name_en":%q,"provider_type":%q,"description_ar":%q,"description_en":%q,"account_name":%q,"bank_name":%q,"account_number":%q,"iban":%q,"swift_code":%q,"branch_name":%q,"instapay_handle":%q,"phone_number":%q,"is_active":%t,"is_deposit_enabled":%t,"is_checkout_enabled":%t,"display_order":%d}`,
		pm.ID,
		pm.Name.Get("ar"),
		pm.Name.Get("en"),
		pm.ProviderType,
		pm.Description.Get("ar"),
		pm.Description.Get("en"),
		pm.AccountName,
		pm.BankName,
		pm.AccountNumber,
		pm.IBAN,
		pm.SwiftCode,
		pm.BranchName,
		pm.InstaPayHandle,
		pm.PhoneNumber,
		pm.IsActive,
		pm.IsDepositEnabled,
		pm.IsCheckoutEnabled,
		pm.DisplayOrder,
	)
}

