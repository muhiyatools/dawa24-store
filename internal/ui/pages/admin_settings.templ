package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/platform/features"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminSettingsValues carries the stored platform settings, feature flags, AI gateway, and site branding.
type AdminSettingsValues struct {
	ActiveTab              string // "features", "site", "policies", "payment_methods"
	SupportEmail           string
	CommissionRate         string
	FeatureFlags           []features.FeatureFlag
	GatewaySettings        *platformadmin.GatewaySettings
	SiteSettings           *platformadmin.SiteSettings
	Policies               []*platformadmin.Policy
	PolicyKey              string
	ActivePolicy           *platformadmin.Policy
	ActivePolicyKey        string
	PlatformPaymentMethods []*billing.PlatformPaymentMethod
}

templ AdminSettings(values AdminSettingsValues, lang, dir string) {
	@layouts.AdminShell("إعدادات المنصة والمنظومة | Platform Settings", "settings", lang, dir) {
		<div
			class="settings-page d-flex flex-col gap-6"
			x-data="{
				activeTab: 'features',
				isMethodModalOpen: false,
				isEditingMethod: false,
				methodForm: {
					id: '',
					name_ar: '',
					name_en: '',
					provider_type: 'bank',
					description_ar: '',
					description_en: '',
					account_name: '',
					bank_name: '',
					account_number: '',
					iban: '',
					swift_code: '',
					branch_name: '',
					instapay_handle: '',
					phone_number: '',
					is_active: true,
					is_deposit_enabled: true,
					is_checkout_enabled: true,
					display_order: 1
				},
				init() {
					const urlParams = new URLSearchParams(window.location.search);
					let tab = urlParams.get('tab') || localStorage.getItem('dawa24-admin-tab') || 'features';
					if (tab !== 'features' && tab !== 'site' && tab !== 'policies' && tab !== 'payment_methods') {
						tab = 'features';
					}
					this.activeTab = tab;
				},
				setTab(tab) {
					this.activeTab = tab;
					localStorage.setItem('dawa24-admin-tab', tab);
					const u = new URL(window.location);
					u.searchParams.set('tab', tab);
					window.history.replaceState({}, '', u);
				},
				openNewMethodModal() {
					this.isEditingMethod = false;
					this.methodForm = {
						id: '',
						name_ar: '',
						name_en: '',
						provider_type: 'bank',
						description_ar: '',
						description_en: '',
						account_name: '',
						bank_name: '',
						account_number: '',
						iban: '',
						swift_code: '',
						branch_name: '',
						instapay_handle: '',
						phone_number: '',
						is_active: true,
						is_deposit_enabled: true,
						is_checkout_enabled: true,
						display_order: 1
					};
					const modal = document.getElementById('payment-method-modal');
					if (modal && typeof modal.showModal === 'function') modal.showModal();
				},
				openEditMethodModal(pm) {
					this.isEditingMethod = true;
					this.methodForm = {
						id: pm.id || '',
						name_ar: pm.name_ar || '',
						name_en: pm.name_en || '',
						provider_type: pm.provider_type || 'bank',
						description_ar: pm.description_ar || '',
						description_en: pm.description_en || '',
						account_name: pm.account_name || '',
						bank_name: pm.bank_name || '',
						account_number: pm.account_number || '',
						iban: pm.iban || '',
						swift_code: pm.swift_code || '',
						branch_name: pm.branch_name || '',
						instapay_handle: pm.instapay_handle || '',
						phone_number: pm.phone_number || '',
						is_active: pm.is_active,
						is_deposit_enabled: pm.is_deposit_enabled,
						is_checkout_enabled: pm.is_checkout_enabled,
						display_order: pm.display_order || 1
					};
					const modal = document.getElementById('payment-method-modal');
					if (modal && typeof modal.showModal === 'function') modal.showModal();
				}
			}"
		>
			
			<!-- Header -->
			<div class="glass-panel p-6 mb-2">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge text-xl">
						@components.IconSettings("icon-md")
					</div>
					<div>
						<h1 class="text-2xl font-black text-primary m-0">
							إعدادات المنصة والمنظومة
						</h1>
						<p class="text-sm text-secondary m-0 mt-1">
							إدارة الهوية البصرية، بيانات التواصل، السياسات، قنوات الدفع، ومفاتيح الميزات
						</p>
					</div>
				</div>
			</div>

			<!-- Main Persistent Tabs Bar -->
			<div class="cb-tabs-nav mb-2">
				<button
					type="button"
					class="cb-tab-btn"
					:class="activeTab === 'features' ? 'active' : ''"
					@click="setTab('features')"
				>
					@components.IconShield("icon-xs")
					<span>1. ميزات المنصة والعمولة</span>
				</button>

				<button
					type="button"
					class="cb-tab-btn"
					:class="activeTab === 'site' ? 'active' : ''"
					@click="setTab('site')"
				>
					@components.IconBuilding("icon-xs")
					<span>2. إعدادات الموقع والهوية</span>
				</button>

				<button
					type="button"
					class="cb-tab-btn"
					:class="activeTab === 'policies' ? 'active' : ''"
					@click="setTab('policies')"
				>
					@components.IconFileText("icon-xs")
					<span>3. السياسات والشروط القانونية</span>
				</button>

				<button
					type="button"
					class="cb-tab-btn"
					:class="activeTab === 'payment_methods' ? 'active' : ''"
					@click="setTab('payment_methods')"
				>
					@components.IconWallet("icon-xs")
					<span>4. طرق وقنوات الدفع المعتمدة</span>
				</button>
			</div>

			<!-- ========================================== -->
			<!-- TAB 1: Platform & Features                 -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'features'" x-cloak class="d-flex flex-col gap-6">
				
				<!-- Feature Flags -->
				<div class="glass-panel p-6 mb-0">
					<div class="pb-3 mb-4 border-b">
						<h3 class="text-base font-black text-primary m-0">
							مفاتيح تشغيل الميزات والأنظمة (Feature Flags)
						</h3>
						<p class="text-xs text-secondary m-0 mt-1">
							التحكم الفوري في إظهار أو إخفاء أقسام المنصة، إعلانات التوظيف، العروض، والخدمات
						</p>
					</div>

					<div class="d-flex flex-col gap-3">
						for _, flag := range values.FeatureFlags {
							<div class="feature-flag-row">
								<div class="feature-flag-info">
									<div class="feature-flag-header">
										<strong class="text-sm text-primary">
											if flag.Name["ar"] != "" {
												{ flag.Name["ar"] }
											} else {
												{ flag.Key }
											}
										</strong>
										if flag.IsEnabled {
											<span class="badge badge-emerald text-xs font-bold">نشط ومفعل</span>
										} else {
											<span class="badge badge-slate text-xs">معطل حالياً</span>
										}
										<span class="badge badge-sky text-2xs font-mono">{ flag.Key }</span>
									</div>
									<p class="feature-flag-desc">
										if flag.Description["ar"] != "" {
											{ flag.Description["ar"] }
										} else {
											{ flag.Key }
										}
									</p>
								</div>

								<form method="POST" action="/admin/settings/features/toggle" class="m-0">
									<input type="hidden" name="key" value={ flag.Key }/>
									<input type="hidden" name="enabled" value={ fmt.Sprintf("%t", !flag.IsEnabled) }/>
									if flag.IsEnabled {
										<button
											type="submit"
											class="btn btn-sm btn-primary font-bold text-xs"
											title="انقر لتعطيل الميزة"
										>
											@components.IconCheck("icon-xs")
											<span>مفعل</span>
										</button>
									} else {
										<button
											type="submit"
											class="btn btn-sm btn-secondary font-bold text-xs"
											title="انقر لتفعيل الميزة"
										>
											<span>معطل</span>
										</button>
									}
								</form>
							</div>
						}
					</div>
				</div>

				<!-- Financial & General Config -->
				<div class="glass-panel p-6 mb-0">
					<div class="d-flex items-center gap-2 pb-3 mb-4 border-b">
						@components.IconSettings("icon-sm")
						<h3 class="text-base font-black text-primary m-0">
							الإعدادات المالية والمنظومة
						</h3>
					</div>

					<form action="/admin/settings" method="POST" class="d-flex flex-col gap-4 m-0">
						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">العملة الافتراضية للمعاملات</label>
								<input type="text" value="EGP (الجنيه المصري)" disabled class="form-input text-xs"/>
							</div>
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">اللغات المعتمدة في النظام</label>
								<input type="text" value="العربية (الرئيسية)، English" disabled class="form-input text-xs"/>
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">بريد إشعارات الدعم الفني *</label>
								<input type="email" name="support_email" value={ values.SupportEmail } required class="form-input text-xs font-mono" dir="ltr"/>
							</div>
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">نسبة عمولة المنصة الافتراضية (%) *</label>
								<input type="number" name="commission_rate" value={ values.CommissionRate } step="0.1" min="0" max="100" required class="form-input text-xs tabular-nums"/>
							</div>
						</div>

						<div>
							<button type="submit" class="btn btn-primary font-bold text-xs">
								@components.IconCheck("icon-xs")
								<span>حفظ إعدادات المنصة</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- ========================================== -->
			<!-- TAB 2: Site Branding & Metadata            -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'site'" x-cloak class="d-flex flex-col gap-6">
				if values.SiteSettings != nil {
					<form action="/admin/settings/site" method="POST" class="d-flex flex-col gap-6 m-0">
						
						<!-- Identity & Slogans -->
						<div class="glass-panel p-6 mb-0">
							<div class="pb-3 mb-4 border-b">
								<h3 class="text-base font-black text-primary m-0">
									الهوية البصرية والعناوين (Branding & Identity)
								</h3>
								<p class="text-xs text-secondary m-0 mt-1">تحديد اسم المنصة، الشعار، والوصف التسويقي المعروض في الصفحة الرئيسية</p>
							</div>

							<div class="form-grid-2 mb-4">
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">اسم المنصة الرسمي *</label>
									<input type="text" name="site_name" value={ values.SiteSettings.SiteName } required class="form-input text-xs"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">عنوان ومقر الشركة</label>
									<input type="text" name="address" value={ values.SiteSettings.Address } class="form-input text-xs"/>
								</div>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">الوصف الترويجي للمنصة (Site Description)</label>
								<textarea name="site_description" rows="3" class="form-input text-xs">{ values.SiteSettings.SiteDescription }</textarea>
							</div>
						</div>

						<!-- Contact & Support Channels -->
						<div class="glass-panel p-6 mb-0">
							<div class="pb-3 mb-4 border-b">
								<h3 class="text-base font-black text-primary m-0">
									قنوات الاتصال والدعم الفني
								</h3>
							</div>

							<div class="form-grid-2 mb-4">
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">البريد الإلكتروني الرسمي للتواصل</label>
									<input type="email" name="contact_email" value={ values.SiteSettings.ContactEmail } class="form-input text-xs font-mono" dir="ltr"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">بريد الدعم الفني (Support Email)</label>
									<input type="email" name="support_email" value={ values.SiteSettings.SupportEmail } class="form-input text-xs font-mono" dir="ltr"/>
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">رقم الهاتف المباشر</label>
									<input type="tel" name="phone" value={ values.SiteSettings.Phone } class="form-input text-xs font-mono" dir="ltr"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold">رقم الواتساب للدعم اللحظي</label>
									<input type="tel" name="whatsapp" value={ values.SiteSettings.WhatsApp } class="form-input text-xs font-mono" dir="ltr"/>
								</div>
							</div>
						</div>

						<div>
							<button type="submit" class="btn btn-primary font-bold text-xs">
								@components.IconCheck("icon-xs")
								<span>حفظ إعدادات الهوية والتواصل</span>
							</button>
						</div>
					</form>
				}
			</div>

			<!-- ========================================== -->
			<!-- TAB 3: Legal Policies & Documents          -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'policies'" x-cloak class="d-flex flex-col gap-6">
				<div class="glass-panel p-6 mb-0">
					<div class="pb-3 mb-4 border-b">
						<h3 class="text-base font-black text-primary m-0">
							إدارة الشروط والسياسات القانونية
						</h3>
						<p class="text-xs text-secondary m-0 mt-1">تحديث الشروط والأحكام، سياسة الخصوصية، وسياسة الاسترجاع المعتمدة بالمنصة</p>
					</div>

					<div class="d-flex flex-col gap-4">
						for _, pol := range values.Policies {
							<div class="border rounded-xl p-4 bg-surface-sunken">
								<div class="flex-between items-center pb-2 mb-3 border-b">
									<div class="d-flex items-center gap-2">
										@components.IconFileText("icon-xs text-primary")
										<strong class="text-sm font-black text-primary">{ pol.Title.Get("ar") }</strong>
										<span class="badge badge-sky text-2xs font-mono">{ pol.PolicyKey }</span>
									</div>
									<span class="text-2xs text-muted font-mono">{ pol.UpdatedAt.Format("2006-01-02 15:04") }</span>
								</div>

								<form method="POST" action="/admin/settings/policies" class="d-flex flex-col gap-3 m-0">
									<input type="hidden" name="key" value={ pol.PolicyKey }/>
									
									<div class="form-grid-2">
										<div class="form-group mb-0">
											<label class="form-label text-xs font-bold">العنوان (عربي)</label>
											<input type="text" name="title_ar" value={ pol.Title.Get("ar") } required class="form-input text-xs"/>
										</div>
										<div class="form-group mb-0">
											<label class="form-label text-xs font-bold">العنوان (إنجليزي)</label>
											<input type="text" name="title_en" value={ pol.Title.Get("en") } required class="form-input text-xs"/>
										</div>
									</div>

									<div class="form-group mb-0">
										<label class="form-label text-xs font-bold">نص الوثيقة القانونية (Markdown / HTML مدعوم)</label>
										<textarea name="content_ar" rows="6" required class="form-input text-xs font-mono leading-relaxed">{ pol.Content.Get("ar") }</textarea>
									</div>

									<div>
										<button type="submit" class="btn btn-secondary btn-sm font-bold text-xs">
											@components.IconCheck("icon-xs")
											<span>تحديث { pol.Title.Get("ar") }</span>
										</button>
									</div>
								</form>
							</div>
						}
					</div>
				</div>
			</div>

			<!-- ========================================== -->
			<!-- TAB 4: Payment Methods & Gateways          -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'payment_methods'" x-cloak class="d-flex flex-col gap-6">
				<div class="glass-panel p-6 mb-0">
					<div class="flex-between items-center pb-3 mb-4 border-b flex-wrap gap-3">
						<div>
							<h3 class="text-base font-black text-primary m-0">
								حسابات وقنوات الدفع المعتمدة بالمنصة
							</h3>
							<p class="text-xs text-secondary m-0 mt-1">
								إدارة الحسابات البنكية الرسمية، معرفات إنستاباي (IPA)، ومحافظ الكاش المتاحة للإيداع وسداد الفواتير
							</p>
						</div>

						<button
							type="button"
							class="btn btn-primary btn-sm font-black text-xs gap-1.5"
							@click="openNewMethodModal()"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة وسيلة دفع جديدة</span>
						</button>
					</div>

					<!-- Payment Methods Cards Grid -->
					<div class="d-grid grid-auto-fit-md gap-4">
						for _, pm := range values.PlatformPaymentMethods {
							<div class="payment-method-card">
								<div>
									<div class="flex-between items-center mb-2">
										<strong class="text-sm font-black text-primary">{ pm.Name.Get("ar") }</strong>
										if pm.IsActive {
											<span class="badge badge-emerald text-2xs font-bold">مفعلة</span>
										} else {
											<span class="badge badge-slate text-2xs">معطلة</span>
										}
									</div>

									<div class="payment-method-badge-row mb-3">
										<span class="badge badge-sky text-2xs font-mono">{ pm.ProviderType }</span>
										if pm.IsDepositEnabled {
											<span class="badge badge-emerald text-2xs">شحن المحفظة</span>
										}
										if pm.IsCheckoutEnabled {
											<span class="badge badge-sky text-2xs">سداد الطلبات</span>
										}
									</div>

									if pm.ProviderType == "bank" {
										<div class="p-3 bg-surface-sunken border rounded-lg text-xs d-flex flex-col gap-1 text-secondary">
											<div><strong>البنك:</strong> { pm.BankName }</div>
											<div><strong>اسم الحساب:</strong> { pm.AccountName }</div>
											<div class="font-mono"><strong>رقم الحساب:</strong> { pm.AccountNumber }</div>
											if pm.IBAN != "" {
												<div class="font-mono text-2xs"><strong>IBAN:</strong> { pm.IBAN }</div>
											}
										</div>
									} else if pm.ProviderType == "instapay" {
										<div class="p-3 bg-surface-sunken border rounded-lg text-xs d-flex flex-col gap-1 text-secondary">
											<div><strong>إنستاباي (IPA):</strong> <code class="font-mono font-bold text-brand">{ pm.InstaPayHandle }</code></div>
											if pm.PhoneNumber != "" {
												<div><strong>الهاتف:</strong> { pm.PhoneNumber }</div>
											}
										</div>
									} else if pm.ProviderType == "wallet" {
										<div class="p-3 bg-surface-sunken border rounded-lg text-xs d-flex flex-col gap-1 text-secondary">
											<div><strong>رقم المحفظة:</strong> <code class="font-mono font-bold text-brand">{ pm.PhoneNumber }</code></div>
										</div>
									}
								</div>

								<div class="d-flex items-center justify-between pt-3 border-t gap-2">
									<button
										type="button"
										class="btn btn-secondary btn-xs font-bold text-xs"
										@click={ fmt.Sprintf("openEditMethodModal({ id: %q, name_ar: %q, name_en: %q, provider_type: %q, bank_name: %q, account_name: %q, account_number: %q, iban: %q, swift_code: %q, branch_name: %q, instapay_handle: %q, phone_number: %q, description_ar: %q, is_active: %t, is_deposit_enabled: %t, is_checkout_enabled: %t, display_order: %d })",
											pm.ID,
											pm.Name.Get("ar"),
											pm.Name.Get("en"),
											pm.ProviderType,
											pm.BankName,
											pm.AccountName,
											pm.AccountNumber,
											pm.IBAN,
											pm.SwiftCode,
											pm.BranchName,
											pm.InstaPayHandle,
											pm.PhoneNumber,
											pm.Description.Get("ar"),
											pm.IsActive,
											pm.IsDepositEnabled,
											pm.IsCheckoutEnabled,
											pm.DisplayOrder,
										) }
									>
										@components.IconEdit("icon-2xs")
										<span>تعديل</span>
									</button>

									<form method="POST" action="/admin/settings/payment-methods/toggle" class="m-0">
										<input type="hidden" name="id" value={ pm.ID }/>
										<input type="hidden" name="active" value={ fmt.Sprintf("%t", !pm.IsActive) }/>
										<button type="submit" class="btn btn-secondary btn-xs text-xs">
											if pm.IsActive {
												<span>تعطيل</span>
											} else {
												<span>تفعيل</span>
											}
										</button>
									</form>
								</div>
							</div>
						}
					</div>
				</div>
			</div>

			<!-- Dialog for Adding/Editing Payment Method -->
			<dialog id="payment-method-modal" class="modal-dialog">
				<div class="glass-panel p-6 w-full max-w-xl shadow-2xl rounded-2xl">
					<div class="flex-between items-center pb-3 mb-4 border-b">
						<div class="d-flex items-center gap-2">
							<div class="user-avatar-badge text-base">
								@components.IconWallet("icon-sm")
							</div>
							<div>
								<h3 class="text-base font-black text-primary m-0" x-text="isEditingMethod ? 'تعديل وسيلة الدفع' : 'إضافة وسيلة دفع جديدة'"></h3>
								<div class="text-xs text-secondary mt-0.5">ضبط الحسابات والقنوات المعتمدة لسداد الفواتير والشحن</div>
							</div>
						</div>
						<button type="button" onclick="document.getElementById('payment-method-modal').close()" class="btn btn-secondary btn-xs btn-icon">
							@components.IconClose("icon-sm")
						</button>
					</div>

					<form action="/admin/settings/payment-methods" method="POST" class="d-flex flex-col gap-4 m-0">
						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">المعرف الفريد (ID) *</label>
								<input type="text" name="id" x-model="methodForm.id" :readonly="isEditingMethod" class="form-input text-xs tabular-nums" dir="ltr" placeholder="instapay, cib_bank" required/>
							</div>
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">نوع وسيلة الدفع *</label>
								<select name="provider_type" x-model="methodForm.provider_type" class="form-select text-xs font-bold">
									<option value="bank">تحويل وحساب بنكي رسمي (Bank Account / IBAN)</option>
									<option value="instapay">إنستاباي (InstaPay IPN)</option>
									<option value="wallet">محفظة هاتف محمول (Mobile Wallet)</option>
									<option value="card">بطاقات دفع إلكتروني (Cards / Meeza)</option>
									<option value="cash">دفع نقدي عند الاستلام (Cash on Delivery)</option>
								</select>
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">الاسم بالعربية *</label>
								<input type="text" name="name_ar" x-model="methodForm.name_ar" class="form-input text-xs" placeholder="البنك التجاري الدولي CIB" required/>
							</div>
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold">الاسم بالإنجليزية *</label>
								<input type="text" name="name_en" x-model="methodForm.name_en" class="form-input text-xs" placeholder="Commercial International Bank" required/>
							</div>
						</div>

						<!-- Bank Fields -->
						<div x-show="methodForm.provider_type === 'bank'" class="d-flex flex-col gap-3 border rounded-xl p-4 bg-surface-sunken">
							<strong class="text-xs text-brand font-black">بيانات الحساب البنكي:</strong>
							<div class="form-grid-2">
								<div class="form-group mb-0">
									<label class="form-label text-xs">اسم البنك</label>
									<input type="text" name="bank_name" x-model="methodForm.bank_name" class="form-input text-xs" placeholder="البنك التجاري الدولي CIB"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs">اسم صاحب الحساب</label>
									<input type="text" name="account_name" x-model="methodForm.account_name" class="form-input text-xs" placeholder="شركة دواء 24 للتجارة"/>
								</div>
							</div>
							<div class="form-grid-2">
								<div class="form-group mb-0">
									<label class="form-label text-xs">رقم الحساب البنكي</label>
									<input type="text" name="account_number" x-model="methodForm.account_number" class="form-input text-xs font-mono" dir="ltr" placeholder="100048291048"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs">الفرع</label>
									<input type="text" name="branch_name" x-model="methodForm.branch_name" class="form-input text-xs" placeholder="الفرع الرئيسي"/>
								</div>
							</div>
							<div class="form-grid-2">
								<div class="form-group mb-0">
									<label class="form-label text-xs">الآيبان الدولي (IBAN)</label>
									<input type="text" name="iban" x-model="methodForm.iban" class="form-input text-xs font-mono" dir="ltr" placeholder="EG3800100004829104800000000000"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs">رمز السويفت (SWIFT)</label>
									<input type="text" name="swift_code" x-model="methodForm.swift_code" class="form-input text-xs font-mono" dir="ltr" placeholder="CIBEEGCX"/>
								</div>
							</div>
						</div>

						<!-- InstaPay / Wallet Fields -->
						<div x-show="methodForm.provider_type === 'instapay' || methodForm.provider_type === 'wallet'" x-cloak class="d-flex flex-col gap-3 border rounded-xl p-4 bg-surface-sunken">
							<strong class="text-xs text-brand font-black">بيانات الدفع اللحظي والمحافظ:</strong>
							<div class="form-grid-2">
								<div class="form-group mb-0">
									<label class="form-label text-xs">معرف إنستاباي اللحظي (IPA)</label>
									<input type="text" name="instapay_handle" x-model="methodForm.instapay_handle" class="form-input text-xs font-mono" dir="ltr" placeholder="dawa24@instapay"/>
								</div>
								<div class="form-group mb-0">
									<label class="form-label text-xs">رقم الهاتف المرتبط بالمحفظة</label>
									<input type="tel" name="phone_number" x-model="methodForm.phone_number" class="form-input text-xs font-mono" dir="ltr" placeholder="01065397000"/>
								</div>
							</div>
						</div>

						<!-- Description -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold">تعليمات وتفاصيل الدفع (عربي)</label>
							<textarea name="description_ar" x-model="methodForm.description_ar" rows="2" class="form-input text-xs" placeholder="تعليمات تظهر للمستخدم عند اختيار وسيلة الدفع هذه..."></textarea>
						</div>

						<!-- Checkboxes & Order -->
						<div class="d-grid grid-auto-fit-sm gap-3 bg-surface-sunken p-3 rounded-xl border">
							<label class="d-flex items-center gap-2 cursor-pointer">
								<input type="checkbox" name="is_active" value="1" x-model="methodForm.is_active" class="form-checkbox"/>
								<span class="font-bold text-xs">مفعلة بالمنصة</span>
							</label>
							<label class="d-flex items-center gap-2 cursor-pointer">
								<input type="checkbox" name="is_deposit_enabled" value="1" x-model="methodForm.is_deposit_enabled" class="form-checkbox"/>
								<span class="font-bold text-xs">متاحة لشحن المحفظة</span>
							</label>
							<label class="d-flex items-center gap-2 cursor-pointer">
								<input type="checkbox" name="is_checkout_enabled" value="1" x-model="methodForm.is_checkout_enabled" class="form-checkbox"/>
								<span class="font-bold text-xs">متاحة لسداد الطلبات</span>
							</label>
							<div class="form-group mb-0">
								<label class="form-label text-xs">ترتيب العرض</label>
								<input type="number" name="display_order" x-model="methodForm.display_order" class="form-input text-xs tabular-nums" min="0"/>
							</div>
						</div>

						<div class="modal-footer pt-3 border-t">
							<button type="button" onclick="document.getElementById('payment-method-modal').close()" class="btn btn-secondary btn-sm font-bold text-xs">
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary btn-sm font-black text-xs px-6">
								@components.IconCheck("icon-xs")
								<span x-text="isEditingMethod ? 'حفظ التعديلات' : 'إضافة وسيلة الدفع'"></span>
							</button>
						</div>
					</form>
				</div>
			</dialog>

		</div>
	}
}
