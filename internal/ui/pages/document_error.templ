package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/attachments"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// DocumentUnavailableView carries context about the missing document.
type DocumentUnavailableView struct {
	DocID        int64
	DocTypeLabel string
	OriginalName string
	OrgName      string
	OrgID        int64
	UploadDate   string
	StatusLabel  string
	ReturnURL    string
	IsAdmin      bool
}

// DocumentUnavailablePage renders a clear, polished error notification when a document file cannot be opened.
templ DocumentUnavailablePage(data DocumentUnavailableView, lang, dir string) {
	@layouts.Base("تعذر فتح المستند — منصة دواء24", lang, dir) {
		<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:2rem 1.5rem; background:var(--bg-app);">
			<div class="card" style="max-width:580px; width:100%; border:1px solid var(--border); border-radius:var(--radius-xl); padding:2rem; background:var(--surface-raised); box-shadow:0 12px 36px rgba(0,0,0,0.08); text-align:center;">
				
				<!-- Icon Badge -->
				<div style="width:64px; height:64px; border-radius:var(--radius-full); background:rgba(239, 68, 68, 0.1); color:#ef4444; display:flex; align-items:center; justify-content:center; font-size:1.85rem; margin:0 auto 1.25rem auto; border:1px solid rgba(239, 68, 68, 0.2);">
					@components.IconFile("icon-sm")
				</div>

				<!-- Main Title & Reason -->
				<h1 style="font-size:1.35rem; font-weight:900; color:var(--text); margin:0 0 0.5rem 0;">
					تعذر فتح المستند — الملف غير متوفر
				</h1>
				<p style="font-size:0.875rem; color:var(--text-secondary); line-height:1.6; margin:0 0 1.5rem 0;">
					لم يتم العثور على الملف الرقمي الفعلي لهذا المستند على وسائط التخزين السحابي، أو قد تم حذفه أو نقله أثناء تحديث البيئة.
				</p>

				<!-- Document Meta Details Box -->
				<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem; text-align:start; margin-bottom:1.5rem; display:flex; flex-direction:column; gap:0.75rem; font-size:0.85rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-subtle); padding-bottom:0.5rem;">
						<span class="text-muted">نوع المستند:</span>
						<strong class="text-body">{ data.DocTypeLabel }</strong>
					</div>

					<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-subtle); padding-bottom:0.5rem;">
						<span class="text-muted">اسم الملف الأصلي:</span>
						<span dir="ltr" class="tabular-nums" style="font-weight:700; color:var(--primary); font-family:var(--font-mono, monospace);">{ data.OriginalName }</span>
					</div>

					if data.OrgName != "" {
						<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-subtle); padding-bottom:0.5rem;">
							<span class="text-muted">المنشأة التابع لها:</span>
							<strong class="text-body">{ data.OrgName }</strong>
						</div>
					}

					if data.UploadDate != "" {
						<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-subtle); padding-bottom:0.5rem;">
							<span class="text-muted">تاريخ الرفع والتسجيل:</span>
							<span class="tabular-nums text-body">{ data.UploadDate }</span>
						</div>
					}

					<div style="display:flex; justify-content:space-between; align-items:center;">
						<span class="text-muted">رقم المستند بالنظام:</span>
						<code style="background:var(--surface-raised); padding:0.15rem 0.5rem; border-radius:var(--radius-sm); border:1px solid var(--border); font-weight:700; color:var(--text);">#{ fmt.Sprintf("%d", data.DocID) }</code>
					</div>
				</div>

				<!-- Administrative Guidance Notice -->
				if data.IsAdmin {
					<div style="background:rgba(2, 132, 199, 0.08); border:1px solid rgba(2, 132, 199, 0.2); border-radius:var(--radius-md); padding:0.85rem 1rem; text-align:start; margin-bottom:1.5rem; font-size:0.8rem; color:var(--text-secondary); line-height:1.5;">
						<strong style="color:var(--accent);">توجيه للإدارة:</strong> يمكنك مراسلة المنشأة أو إرسال طلب رسمي لإعادة رفع المستند عبر تبويب <strong>"طلبات المستندات"</strong> في لوحة الموافقات.
					</div>
				} else {
					<div style="background:rgba(2, 132, 199, 0.08); border:1px solid rgba(2, 132, 199, 0.2); border-radius:var(--radius-md); padding:0.85rem 1rem; text-align:start; margin-bottom:1.5rem; font-size:0.8rem; color:var(--text-secondary); line-height:1.5;">
						<strong style="color:var(--accent);">تنبيه:</strong> يمكنك إعادة رفع المستند المحدث مباشرة عبر صفحة <strong>"المستندات والتراخيص"</strong> في حسابك.
					</div>
				}

				<!-- Action Buttons -->
				<div style="display:flex; justify-content:center; gap:0.75rem; flex-wrap:wrap;">
					<a
						href={ templ.SafeURL(data.ReturnURL) }
						class="btn btn-primary"
						style="font-weight:800; padding:0.6rem 1.5rem; border-radius:var(--radius-md); display:inline-flex; align-items:center; gap:0.4rem;"
					>
						@components.IconArrowRight("icon-xs")
						<span>العودة للشاشة السابقة</span>
					</a>
				</div>

			</div>
		</div>
	}
}

func FormatDocTypeLabel(docType attachments.DocumentType) string {
	switch docType {
	case attachments.DocCommercialRegister:
		return "السجل التجاري (Commercial Register)"
	case attachments.DocTaxCard:
		return "البطاقة الضريبية (Tax Card)"
	case attachments.DocPharmacyLicense:
		return "ترخيص الصيدلية / المنشأة (Pharmacy License)"
	case attachments.DocPharmacistLicense:
		return "ترخيص مزاولة المهنة للصيدلي (Pharmacist License)"
	case attachments.DocNationalID:
		return "بطاقة الرقم القومي (National ID)"
	case attachments.DocPassport:
		return "جواز السفر (Passport)"
	case attachments.DocBankCertificate:
		return "شهادة الحساب البنكي (Bank Certificate)"
	case attachments.DocAuthorizationLetter:
		return "خطاب تفويض رسمي (Authorization Letter)"
	case attachments.DocSyndicateCard:
		return "كارنيه نقابة الصيادلة (Syndicate Card)"
	default:
		return "مستند رسمي معتمد"
	}
}
