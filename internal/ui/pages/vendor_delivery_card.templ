package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// One parcel as it appears on the dispatch board.
//
// The card answers the four questions a courier asks before opening anything:
// where is it going, how long have I had it, how much do I collect, and what
// do I do next. Everything else — the map, the item checklist, the PIN form —
// is on the parcel's own screen, one tap away.

// deliveryWaitingBadge turns an assignment date into the priority signal the
// list is sorted by. Colour is the only thing that changes with age: a courier
// scanning the top of their list should see the late one without reading a
// date, and the exact timestamp is still printed beside it.
func deliveryWaitingBadge(sh *commerce.OrderShipment) string {
	if sh == nil {
		return "badge badge-slate"
	}
	switch sh.Status {
	case commerce.StatusDelivered, commerce.StatusCompleted:
		return "badge badge-emerald"
	case commerce.StatusFailed, commerce.StatusReturned:
		return "badge badge-rose"
	case commerce.StatusCancelled:
		return "badge badge-slate"
	}
	switch {
	case sh.CourierAssignedAt == nil:
		return "badge badge-slate"
	case sh.WaitingHours() >= commerce.CourierOverdueHours:
		return "badge badge-rose"
	case sh.WaitingHours() >= 8:
		return "badge badge-amber"
	}
	return "badge badge-sky"
}

func deliveryWaitingLabel(sh *commerce.OrderShipment, langOpt ...string) string {
	lang := "ar"
	if len(langOpt) > 0 && langOpt[0] != "" {
		lang = langOpt[0]
	}
	if sh == nil {
		return ""
	}
	switch sh.Status {
	case commerce.StatusDelivered, commerce.StatusCompleted:
		return i18n.T(lang, "vendor_delivery.card.waiting_delivered")
	case commerce.StatusFailed:
		return i18n.T(lang, "vendor_delivery.card.waiting_failed")
	case commerce.StatusReturned:
		return i18n.T(lang, "vendor_delivery.card.waiting_returned")
	case commerce.StatusCancelled:
		return i18n.T(lang, "vendor_delivery.card.waiting_cancelled")
	}
	if sh.CourierAssignedAt == nil {
		return i18n.T(lang, "vendor_delivery.card.waiting_unassigned")
	}
	h := sh.WaitingHours()
	if h < 1 {
		return i18n.T(lang, "vendor_delivery.card.waiting_just_now")
	}
	if h < 24 {
		return fmt.Sprintf(i18n.T(lang, "vendor_delivery.card.waiting_hours"), h)
	}
	return fmt.Sprintf(i18n.T(lang, "vendor_delivery.card.waiting_days"), h/24)
}

templ VendorDeliveryParcelCard(sh *commerce.OrderShipment, data VendorDeliveryData, lang string) {
	<div class="glass-panel p-5 delivery-card">
		<div class="delivery-card-top">
			<div class="stack-sm min-w-0">
				<div class="d-flex items-center gap-2 flex-wrap">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d", sh.ID)) }
						class="text-base font-black text-primary tabular-nums text-decoration-none"
					>
						{ fmt.Sprintf(i18n.T(lang, "vendor_delivery.card.parcel_prefix"), sh.ShipmentNumber) }
					</a>
					@DeliveryStatusBadge(sh.Status, lang)
					<span class={ deliveryWaitingBadge(sh), "text-xs font-black" }>
						{ deliveryWaitingLabel(sh, lang) }
					</span>
					if sh.OrderNumber != "" {
						<span class="badge badge-secondary text-xs font-bold">
							{ fmt.Sprintf(i18n.T(lang, "vendor_delivery.card.po_prefix"), sh.OrderNumber) }
						</span>
					}
				</div>

				<div class="d-flex items-center gap-2 text-xs text-secondary flex-wrap">
					@components.IconBuilding("icon-2xs")
					<strong class="text-primary font-bold">{ sh.CustomerOrgName.Get(i18n.Lang(lang)) }</strong>
					if sh.CustomerBranchName.Get(i18n.Lang(lang)) != "" {
						<span>— { sh.CustomerBranchName.Get(i18n.Lang(lang)) }</span>
					}
				</div>

				if sh.CustomerBranchAddress != "" {
					<div class="text-xs text-muted leading-normal">{ sh.CustomerBranchAddress }</div>
				}

				<div class="d-flex items-center gap-3 text-xs text-muted flex-wrap">
					<span class="d-flex items-center gap-1">
						@components.IconPackage("icon-3xs")
						<span class="tabular-nums">{ fmt.Sprintf(i18n.T(lang, "vendor_delivery.card.items_units_count"), len(sh.Lines), sh.TotalUnitsCount()) }</span>
					</span>
					if sh.CourierAssignedAt != nil {
						<span class="d-flex items-center gap-1">
							@components.IconClock("icon-3xs")
							<span class="tabular-nums font-mono">
								{ fmt.Sprintf(i18n.T(lang, "vendor_delivery.card.assigned_date"), sh.CourierAssignedAt.Format("2006-01-02 03:04 PM")) }
							</span>
						</span>
					}
					if sh.CourierName != "" && !sh.IsAssignedTo(data.ActorID) {
						<span class="d-flex items-center gap-1">
							@components.IconUser("icon-3xs")
							<span>{ fmt.Sprintf(i18n.T(lang, "vendor_delivery.card.courier_label"), sh.CourierName) }</span>
						</span>
					}
				</div>
			</div>

			<div class="delivery-card-side">
				<div class="delivery-card-money">
					<span class="text-xs text-muted d-block font-bold">
						@DeliveryCollectLabel(sh, lang)
					</span>
					<strong class="text-lg font-black text-brand tabular-nums">
						@components.MoneyDisplay(components.MoneyDisplayProps{Amount: sh.CourierCollection().Amount})
					</strong>
				</div>

				<a
					href={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d", sh.ID)) }
					class="btn btn-primary btn-sm font-black text-xs gap-1.5 delivery-card-open"
				>
					@components.IconTruck("icon-2xs")
					<span>{ i18n.T(lang, "vendor_delivery.card.btn_open_parcel") }</span>
				</a>
			</div>
		</div>

		if !sh.IsClosed() {
			@deliveryCardQuickActions(sh, lang)
		}

		if data.CanAssign {
			<div class="mt-4 pt-4 border-t">
				@VendorDeliveryAssignForm(sh, data.Couriers, deliveryReturnKey(data.Queue), lang)
			</div>
		}
	</div>
}

// deliveryReturnKey names the board tab an assignment should come back to, so
// a dispatcher working through the unassigned pool stays in the unassigned
// pool rather than being bounced to the parcel they just handed over.
func deliveryReturnKey(queue commerce.CourierQueue) string {
	if queue == commerce.CourierQueueUnassigned {
		return "unassigned"
	}
	return "board"
}

// DeliveryStatusBadge renders one shipment status in the vocabulary a courier
// uses, rather than the raw enum.
templ DeliveryStatusBadge(status commerce.OrderStatus, langOpt ...string) {
	{{
		lang := "ar"
		if len(langOpt) > 0 && langOpt[0] != "" {
			lang = langOpt[0]
		}
	}}
	switch status {
		case commerce.StatusPending:
			<span class="badge badge-amber text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.pending") }</span>
		case commerce.StatusProcessing:
			<span class="badge badge-amber text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.processing") }</span>
		case commerce.StatusConfirmed:
			<span class="badge badge-sky text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.confirmed") }</span>
		case commerce.StatusOnHold:
			<span class="badge badge-slate text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.on_hold") }</span>
		case commerce.StatusShipped:
			<span class="badge badge-indigo text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.shipped") }</span>
		case commerce.StatusInTransit:
			<span class="badge badge-indigo text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.in_transit") }</span>
		case commerce.StatusOutForDelivery:
			<span class="badge badge-indigo text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.out_for_delivery") }</span>
		case commerce.StatusDelivered:
			<span class="badge badge-emerald text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.delivered") }</span>
		case commerce.StatusCompleted:
			<span class="badge badge-emerald text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.completed") }</span>
		case commerce.StatusReturned:
			<span class="badge badge-rose text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.returned") }</span>
		case commerce.StatusFailed:
			<span class="badge badge-rose text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.failed") }</span>
		case commerce.StatusCancelled:
			<span class="badge badge-rose text-xs font-black">{ i18n.T(lang, "vendor_delivery.status.cancelled") }</span>
		default:
			<span class="badge badge-slate text-xs font-black">{ string(status) }</span>
	}
}

// deliveryCardQuickActions puts the two things a courier does from a list —
// ring the door and start driving — on the card itself.
templ deliveryCardQuickActions(sh *commerce.OrderShipment, langOpt ...string) {
	{{
		lang := "ar"
		if len(langOpt) > 0 && langOpt[0] != "" {
			lang = langOpt[0]
		}
	}}
	if sh.CustomerBranchPhone != "" || sh.BranchLocationURL() != "" {
		<div class="delivery-card-quick">
			if loc := sh.BranchLocationURL(); loc != "" {
				<a
					href={ templ.SafeURL(loc) }
					target="_blank"
					rel="noopener"
					class="btn btn-secondary btn-sm font-bold text-2xs gap-1.5 delivery-quick-btn"
				>
					@components.IconLocation("icon-3xs")
					<span>{ i18n.T(lang, "vendor_delivery.card.btn_directions") }</span>
				</a>
			}
			if sh.CustomerBranchPhone != "" {
				<a
					href={ templ.SafeURL("tel:" + sh.CustomerBranchPhone) }
					class="btn btn-secondary btn-sm font-bold text-2xs gap-1.5 delivery-quick-btn"
				>
					@components.IconPhone("icon-3xs")
					<span>{ i18n.T(lang, "vendor_delivery.card.btn_call_pharmacy") }</span>
				</a>
			}
		</div>
	}
}