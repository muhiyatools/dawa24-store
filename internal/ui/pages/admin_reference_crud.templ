package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// ReferenceItem represents a generic reference row for admin CRUD.
type ReferenceItem struct {
	ID          int64  `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description"`
	Status      string `json:"status"`
	Extra       string `json:"extra"`
}

// AdminReferenceCRUDPage renders a reusable, high-craft CRUD table and toolbar for reference data.
templ AdminReferenceCRUDPage(title string, sectionKey string, itemLabel string, items []ReferenceItem, activeNav string, lang, dir string) {
	@layouts.AdminShell(title, activeNav, lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconFileText("icon-sm")
						</div>
      <div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">{ title } ({ fmt.Sprintf("%d", len(items)) })</h1>
							<p class="text-sm text-secondary m-0 mt-1">إدارة وتحديث البيانات المرجعية الأساسية للمنصة</p>
						</div>
					</div>
					<button type="button" class="btn btn-primary btn-sm font-bold text-xs gap-1" onclick="alert('جاري فتح نموذج الإضافة')">
						@components.IconPlus("icon-xs")
						<span>إضافة { itemLabel } جديد</span>
					</button>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(items) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconFileText("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد سجلات { itemLabel }</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يتم تسجيل أي بيانات بعد.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>#</th>
									<th>الاسم / العنوان</th>
									<th>الوصف / التفاصيل</th>
									<th>معلومات إضافية</th>
									<th class="text-center">الحالة</th>
									<th class="col-actions">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, it := range items {
									<tr>
										<td class="tabular-nums font-bold text-brand">#{ fmt.Sprintf("%d", it.ID) }</td>
										<td><strong class="text-xs text-primary">{ it.Name }</strong></td>
										<td class="text-xs text-secondary">{ it.Description }</td>
										<td class="text-xs text-muted">{ it.Extra }</td>
										<td class="text-center">
											if it.Status == "active" || it.Status == "" {
												<span class="badge badge-emerald text-xs font-bold">نشط</span>
											} else {
												<span class="badge badge-rose text-xs font-bold">معطل</span>
											}
										</td>
										<td class="col-actions">
											<div class="table-actions">
												<button type="button" class="btn btn-secondary btn-sm font-bold text-xs">تعديل</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
