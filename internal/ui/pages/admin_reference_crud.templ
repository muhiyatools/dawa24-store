package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// ReferenceItem represents a generic reference row for admin CRUD.
type ReferenceItem struct {
	ID          int64  `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description"`
	Status      string `json:"status"`
	Extra       string `json:"extra"`
}

// AdminReferenceCRUDPage renders a reusable, high-craft CRUD table and toolbar for reference data.
templ AdminReferenceCRUDPage(title string, sectionKey string, itemLabel string, items []ReferenceItem, activeNav string, lang, dir string) {
	@layouts.AdminShell(title, activeNav, lang, dir) {
		<div class="card mb-0">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 class="card-title" style="margin:0;">{ title } ({ fmt.Sprintf("%d", len(items)) })</h2>
					<p class="subtitle">إدارة وتحديث البيانات المرجعية الأساسية للمنصة.</p>
				</div>
				<button type="button" class="btn btn-primary btn-sm" onclick="alert('جاري فتح نموذج الإضافة')">
					@components.IconPlus("icon-xs")
					<span>إضافة { itemLabel } جديد</span>
				</button>
			</div>

			if len(items) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: fmt.Sprintf("لا توجد سجلات %s", itemLabel), Message: "لم يتم تسجيل أي بيانات بعد."})
			} else {
				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>#</th>
								<th>الاسم / العنوان</th>
								<th>الوصف / التفاصيل</th>
								<th>معلومات إضافية</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, it := range items {
								<tr>
									<td class="tabular-nums">#{ fmt.Sprintf("%d", it.ID) }</td>
									<td><strong>{ it.Name }</strong></td>
									<td>{ it.Description }</td>
									<td>{ it.Extra }</td>
									<td>
										if it.Status == "active" || it.Status == "" {
											<span class="badge badge-success">نشط</span>
										} else {
											<span class="badge badge-danger">معطل</span>
										}
									</td>
									<td class="text-end">
										<div style="display:flex; justify-content:flex-end; gap:0.5rem;">
											<button type="button" class="btn btn-secondary btn-sm">تعديل</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
