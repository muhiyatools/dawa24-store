package pages

import (

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ AdminTempWarehousesModals(data *AdminTempWarehousesData) {
	<!-- 5. Warehouse Items Modal -->
	<div
		x-show="itemsModal"
		class="fixed inset-0 z-modal flex-center bg-black/75 p-5"
		x-cloak
		@keydown.escape.window="itemsModal = false"
		@click.self="itemsModal = false"
	>
				<div
					class="glass-panel mb-0 max-w-4xl w-full max-h-[90vh] d-flex flex-col overflow-hidden p-0 bg-surface-raised rounded-2xl border shadow-2xl m-auto"
				>
					<!-- Modal Top Header -->
					<div class="p-5 border-b flex-between items-center bg-surface">
						<div class="d-flex items-center gap-2.5">
							<span class="text-xl">@components.IconPackage("icon-sm")</span>
							<h3 class="text-lg font-black text-primary m-0">
								أصناف المستودع: <span x-text="selectedWarehouse.name" class="text-accent"></span> (<span x-text="selectedWarehouse.total" class="tabular-nums"></span> صنف)
							</h3>
						</div>

						<div class="d-flex items-center gap-2.5">
							<!-- Download XLSX Button -->
							<a
								:href="$root.dataset.base + '/' + selectedWarehouse.id + '/export'"
								class="btn btn-secondary btn-sm font-bold inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-emerald"
							>
								<span>تحميل XLSX</span>
							</a>

							<!-- Close Button -->
							<button
								type="button"
								@click="itemsModal = false"
								class="btn btn-secondary btn-sm rounded-full w-8 h-8 p-0 flex-center text-lg"
							>
								&times;
							</button>
						</div>
					</div>

					<!-- Modal Body Table -->
					<div class="flex-1 overflow-y-auto p-0">
						<template x-if="modalLoading">
							<div class="p-16 text-center text-muted">
								<div class="text-3xl mb-2">⏳</div>
								<div class="font-bold">جاري تحميل أصناف المستودع...</div>
							</div>
						</template>

						<template x-if="!modalLoading && modalItems.length === 0">
							<div class="p-16 text-center text-muted">
								<div class="text-3xl mb-2">@components.IconSearch("icon-sm")</div>
								<div class="font-bold">لا توجد أصناف في هذا المستودع حالياً.</div>
							</div>
						</template>

						<template x-if="!modalLoading && modalItems.length > 0">
							<div class="table-container m-0">
								<table class="data-table m-0">
								<thead>
									<tr>
										<th class="min-w-32">الكود</th>
										<th class="min-w-80">اسم المنتج</th>
										<th class="min-w-32">سعر الجمهور</th>
										<th class="min-w-28">نسبة الخصم</th>
										<th class="w-16 text-center">حذف</th>
									</tr>
								</thead>
								<tbody>
									<template x-for="row in modalItems" :key="row.id">
										<tr>
											<!-- SKU Code -->
											<td class="tabular-nums font-mono text-xs font-black text-primary" x-text="row.sku || ('#' + row.id)"></td>
											
											<!-- Product Name -->
											<td>
												<div class="font-black text-primary text-sm" x-text="row.raw_name"></div>
											</td>

											<!-- Public Price -->
											<td class="tabular-nums font-bold text-sm text-primary" x-text="row.price + ' ج.م'"></td>

											<!-- Discount -->
											<td class="tabular-nums">
												<span class="badge badge-emerald font-black text-xs px-2.5 py-1 rounded-md" x-text="row.discount + '%'"></span>
											</td>

											<!-- Delete Single Item Button -->
											<td class="text-center">
												<button
													type="button"
													@click="deleteItem(row.id)"
													class="btn btn-secondary btn-xs text-danger rounded-md px-2 py-1 font-bold"
													title="حذف هذا الصنف من المستودع"
												>
													@components.IconX("icon-sm")
												</button>
											</td>
										</tr>
									</template>
								</tbody>
							</table>
							</div>
						</template>
					</div>

					<!-- Modal Pagination Footer -->
					<div class="p-4 border-t flex-between items-center bg-surface flex-wrap gap-4">
						<div class="text-xs text-muted font-bold tabular-nums">
							<span>عرض صفحة </span>
							<strong class="text-primary" x-text="modalPage"></strong>
							<span> من </span>
							<strong class="text-primary" x-text="modalTotalPages"></strong>
							<span> (إجمالي </span>
							<strong class="text-accent" x-text="selectedWarehouse.total"></strong>
							<span> صنف)</span>
						</div>

						<div class="d-flex items-center gap-2">
							<button
								type="button"
								@click="prevModalPage()"
								:disabled="modalPage <= 1 || modalLoading"
								class="btn btn-secondary btn-sm font-bold rounded-md px-3.5 py-1.5"
							>
								السابق
							</button>
							<button
								type="button"
								@click="nextModalPage()"
								:disabled="modalPage >= modalTotalPages || modalLoading"
								class="btn btn-secondary btn-sm font-bold rounded-md px-3.5 py-1.5"
							>
								التالي
							</button>
							<button
								type="button"
								@click="itemsModal = false"
								class="btn btn-secondary btn-sm font-bold rounded-md px-3.5 py-1.5 ms-2"
							>
								إغلاق
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- 6. Upload Modal with 100 Files Bulk Support & Auto-Naming -->
			<div
				x-show="uploadModal"
				class="fixed inset-0 z-modal flex-center bg-black/75 p-5"
				x-cloak
				@keydown.escape.window="if (!isBulkUploading) uploadModal = false"
				@click.self="if (!isBulkUploading) uploadModal = false"
			>
				<div
					class="glass-panel mb-0 max-w-3xl w-full max-h-[92vh] overflow-y-auto p-7 bg-surface-raised rounded-2xl border shadow-2xl m-auto"
				>
					<div class="flex-between items-center mb-5 pb-4 border-b">
      <div class="stack-sm">
							<h3 class="text-xl font-black text-primary m-0 d-flex items-center gap-2">
								<span>@components.IconZap("icon-sm")</span>
								<span>رفع كشوف المستودعات المجمّع (حتى 100 ملف دفعة واحدة)</span>
							</h3>
							<p class="text-xs text-muted m-0 mt-1">
								يدعم كافة أنواع الملفات (.xlsx, .xls, .csv, .txt) مع تسمية تلقائية ومعالجة متوازية فائقة السرعة
							</p>
						</div>
						<button
							type="button"
							@click="if (!isBulkUploading) uploadModal = false"
							:disabled="isBulkUploading"
							class="btn btn-secondary btn-sm rounded-full w-8 h-8 p-0 flex-center text-lg"
						>&times;</button>
					</div>

					<!-- Active Uploading Progress Overlay -->
					<template x-if="isBulkUploading">
						<div class="p-10 text-center">
							<div class="spinner-border text-primary w-14 h-14 mb-5" role="status"></div>
							<h4 class="text-lg font-black text-primary mb-2">
								جاري الرفع والمعالجة المتوازية فائقة السرعة...
							</h4>
							<p class="text-xs text-muted mb-6" x-text="uploadStatusText"></p>

							<!-- Progress Bar -->
							<div class="w-full h-3 bg-surface-sunken rounded-full overflow-hidden border mb-3">
								<div
									class="h-full bg-gradient-to-r from-accent to-emerald transition-all duration-300"
									:style="'width: ' + uploadProgress + '%'"
								></div>
							</div>
							<div class="d-flex justify-between items-center text-xs text-muted font-bold tabular-nums">
								<span x-text="'عدد الملفات المرفوعة: ' + selectedFiles.length"></span>
								<span x-text="uploadProgress + '%'"></span>
							</div>
						</div>
					</template>

					<!-- Upload Form -->
					<form
						x-show="!isBulkUploading"
						action={ templ.SafeURL(data.Base + "/upload") }
						method="POST"
						enctype="multipart/form-data"
						@submit.prevent="submitBulkUpload($event.target)"
						class="stack-lg"
					>
						<!-- Drag & Drop Bulk Zone (up to 100 files) -->
						<div
							@dragover.prevent="isDragging = true"
							@dragleave.prevent="isDragging = false"
							@drop.prevent="handleDrop($event)"
							class="border-2 border-dashed border-border rounded-2xl p-7 text-center bg-surface-sunken transition-all cursor-pointer"
							:class="{ 'border-accent bg-accent-subtle': isDragging }"
							@click="$refs.fileInput.click()"
						>
							<input
								type="file"
								name="files"
								multiple
								accept=".xlsx,.xls,.csv,.txt"
								x-ref="fileInput"
								@change="handleFilesSelect($event)"
								class="d-none"
							/>
							<div class="text-4xl mb-2">@components.IconFolderOpen("icon-sm")</div>
							<div class="text-sm font-bold text-primary mb-1">
								اسحب وأفلت الملفات هنا، أو انقر لاختيار مجموعة ملفات من جهازك
							</div>
							<div class="meta-muted">
								يدعم رفع حتى 100 ملف دفعة واحدة بكافة الصيغ (.xlsx, .xls, .csv, .txt)
							</div>
						</div>

						<!-- Selected Files Badge & List -->
						<template x-if="selectedFiles.length > 0">
							<div class="bg-surface-sunken border rounded-2xl p-4">
								<div class="flex-between items-center mb-3">
									<div class="d-flex items-center gap-2">
										<span class="badge badge-emerald font-black text-xs tabular-nums">
											تم اختيار <strong x-text="selectedFiles.length"></strong> ملف
										</span>
										<span class="text-xs text-muted tabular-nums" x-text="'(الحجم الإجمالي: ' + totalSelectedSize() + ')'"></span>
									</div>
									<button
										type="button"
										@click="clearSelectedFiles()"
										class="btn btn-secondary btn-xs text-danger font-bold rounded-md"
									>
										إفراغ القائمة
									</button>
								</div>

								<!-- Files Preview Scroll Area -->
								<div class="max-h-40 overflow-y-auto d-flex flex-col gap-1.5 pe-1">
									<template x-for="(f, idx) in selectedFiles" :key="idx">
										<div class="flex-between items-center bg-surface-raised border border-border-subtle rounded-md p-2 text-xs">
											<div class="d-flex items-center gap-1.5 truncate">
												<span class="text-muted tabular-nums" x-text="(idx+1) + '.'"></span>
												<strong class="text-primary truncate max-w-xs" x-text="f.name"></strong>
												<span class="badge badge-slate text-xs" x-text="'← مستودع: ' + cleanName(f.name)"></span>
											</div>
											<div class="d-flex items-center gap-2 shrink-0">
												<span class="text-muted tabular-nums" x-text="formatFileSize(f.size)"></span>
												<button
													type="button"
													@click.stop="removeSelectedFile(idx)"
													class="btn btn-secondary btn-xs text-danger rounded p-1"
													title="إزالة"
												></button>
											</div>
										</div>
									</template>
								</div>
							</div>
						</template>

						<!-- Case 1: Single File Custom Options -->
						<template x-if="selectedFiles.length === 1">
							<div class="stack-md">
								<div class="form-group mb-0">
									<label class="form-label text-xs font-bold text-secondary mb-1">
										اسم المورد / اسم المستودع
									</label>
									<input
										type="text"
										name="supplier_name"
										class="form-input h-10 rounded-lg text-sm"
										:value="cleanName(selectedFiles[0]?.name)"
										placeholder="مثال: مستودع الأمل، شركة النور..."
									/>
								</div>
							</div>
						</template>

						<!-- Setup Experience Option Checkbox -->
						<div class="bg-emerald-500/5 border rounded-2xl p-4 d-flex items-center gap-3">
							<input
								type="checkbox"
								id="auto_setup_check"
								x-model="autoLaunchSetup"
								class="w-4 h-4 cursor-pointer"
							/>
							<label for="auto_setup_check" class="cursor-pointer m-0">
								<strong class="text-primary d-block text-xs font-black">
									بدء معالج ضبط وتأكيد أعمدة الملفات بعد الرفع (Setup Experience)
								</strong>
								<span class="text-xs text-secondary font-medium d-block mt-0.5">
									يتيح لك مراجعة الأعمدة ومعاينة بيانات كل كشف مستودع بالتتابع وتعديل الربط بسهولة
								</span>
							</label>
						</div>

						<!-- Action Buttons -->
						<div class="d-flex justify-end gap-3 mt-3 border-t pt-4">
							<button
								type="button"
								class="btn btn-secondary font-bold rounded-lg"
								@click="uploadModal = false"
							>إلغاء</button>
							<button
								type="submit"
								class="btn btn-primary font-black rounded-lg px-7 py-2.5"
								:disabled="selectedFiles.length === 0"
							>
								<span x-show="selectedFiles.length <= 1">تأكيد ورفع المستودع ↗</span>
								<span x-show="selectedFiles.length > 1" x-text="'تأكيد ورفع ' + selectedFiles.length + ' مستودع الآن '"></span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- 7. Warehouse Column Mapping & Setup Wizard Modal -->
			<div
				x-show="mappingModal"
				class="fixed inset-0 z-modal flex-center bg-black/80 p-5"
				x-cloak
				@keydown.escape.window="if(!mappingSubmitting) mappingModal = false"
				@click.self="if(!mappingSubmitting) mappingModal = false"
			>
				<div
					class="glass-panel mb-0 max-w-4xl w-full max-h-[92vh] overflow-y-auto p-7 bg-surface-raised rounded-2xl border shadow-2xl m-auto"
				>
					<!-- Modal Header & Queue Stepper -->
					<div class="flex-between items-start mb-4 border-b pb-4 gap-4">
						<div class="d-flex items-center gap-3">
							<div class="w-11 h-11 rounded-2xl bg-accent-subtle text-accent flex-center text-xl shrink-0">
								@components.IconSettings("icon-sm")
							</div>
       <div class="stack-sm">
								<div class="d-flex items-center gap-2 mb-1">
									<span class="badge badge-emerald font-black text-xs">
										معالج ضبط وتأكيد أعمدة المستودع
									</span>
									<template x-if="mappingTotal > 1">
										<span class="badge badge-sky font-black text-xs tabular-nums" x-text="'ملف ' + mappingStep + ' من ' + mappingTotal"></span>
									</template>
								</div>
								<h3 class="text-xl font-black text-primary m-0">
									<span x-text="mappingFile.supplier_name || 'ضبط الأعمدة'"></span>
								</h3>
								<p class="text-xs text-muted mt-1 m-0">
									الملف المصدري: <strong class="text-primary font-mono" x-text="mappingFile.original_filename"></strong>
									<span class="tabular-nums" x-text="' • (' + (mappingFile.row_count || 0) + ' صنف مسجل)'"></span>
								</p>
							</div>
						</div>

						<button
							type="button"
							@click="mappingModal = false"
							:disabled="mappingSubmitting"
							class="btn btn-secondary btn-sm rounded-full w-8 h-8 p-0 flex-center text-lg"
						>&times;</button>
					</div>

					<!-- Progress Bar if in Multi-File Queue -->
					<template x-if="mappingTotal > 1">
						<div class="mb-5">
							<div class="flex-between items-center text-xs text-muted font-bold mb-1.5">
								<span>إنجاز مراجعة الملفات المرفوعة</span>
								<span class="tabular-nums" x-text="Math.round((mappingStep / mappingTotal) * 100) + '%'"></span>
							</div>
							<div class="w-full h-1.5 bg-surface-sunken rounded-full overflow-hidden border">
								<div
									class="h-full bg-gradient-to-r from-accent to-emerald transition-all duration-300"
									:style="'width: ' + ((mappingStep / mappingTotal) * 100) + '%'"
								></div>
							</div>
						</div>
					</template>

					<!-- Loading State -->
					<template x-if="mappingLoading">
						<div class="p-12 text-center">
							<div class="spinner-border text-primary w-10 h-10 mb-4" role="status"></div>
							<div class="font-bold text-secondary text-sm">
								جاري قراءة وتحليل أعمدة المستودع...
							</div>
						</div>
					</template>

					<!-- Mapping Form Content -->
					<form
						x-show="!mappingLoading"
						@submit.prevent="submitMapping($event.target)"
						class="stack-lg"
					>
						<!-- Supplier Name Edit Strip -->
						<div class="bg-surface-sunken border rounded-2xl p-4 d-flex items-center gap-4 flex-wrap">
							<div class="text-xl">@components.IconBuilding("icon-sm")</div>
							<div class="flex-1 min-w-60">
								<label class="form-label text-xs font-black text-primary mb-1">
									اسم المورد / المستودع المعروض في المنظومة
								</label>
								<input
									type="text"
									name="supplier_name"
									x-model="mappingFile.supplier_name"
									class="form-input text-xs font-bold h-9 rounded-md"
									required
								/>
							</div>
						</div>

						<!-- Column Selectors Grid (4 key columns) -->
						<div class="bg-surface-sunken border rounded-2xl p-4">
							<div class="text-sm font-black text-primary mb-3 d-flex items-center gap-1.5">
								<span>@components.IconActivity("icon-sm")</span>
								<span>تعيين وتوجيه الأعمدة لاستخراج البيانات بدقة:</span>
							</div>

							<div class="d-grid grid-auto-fit-sm gap-3">
								<!-- Code Col -->
        <div class="stack-sm">
									<label class="form-label text-xs font-black mb-1">
										كود الصنف (SKU / Barcode)
									</label>
									<select name="col_code" x-model="mappingCode" class="form-input text-xs h-9 rounded-md">
										<option value="-1">-- غير محدد --</option>
										<template x-for="(h, idx) in mappingHeaders" :key="idx">
											<option :value="idx" x-text="'عمود ' + (idx+1) + ': ' + h" :selected="mappingCode == idx"></option>
										</template>
									</select>
								</div>

								<!-- Name Col -->
        <div class="stack-sm">
									<label class="form-label text-xs font-black mb-1">
										اسم المنتج / الصنف <span class="text-danger">*</span>
									</label>
									<select name="col_name" x-model="mappingName" class="form-input text-xs font-bold h-9 rounded-md" required>
										<option value="-1">-- يرجى الاختيار --</option>
										<template x-for="(h, idx) in mappingHeaders" :key="idx">
											<option :value="idx" x-text="'عمود ' + (idx+1) + ': ' + h" :selected="mappingName == idx"></option>
										</template>
									</select>
								</div>

								<!-- Price Col -->
        <div class="stack-sm">
									<label class="form-label text-xs font-black mb-1">
										سعر الجمهور (الرسمي)
									</label>
									<select name="col_price" x-model="mappingPrice" class="form-input text-xs h-9 rounded-md">
										<option value="-1">-- غير محدد --</option>
										<template x-for="(h, idx) in mappingHeaders" :key="idx">
											<option :value="idx" x-text="'عمود ' + (idx+1) + ': ' + h" :selected="mappingPrice == idx"></option>
										</template>
									</select>
								</div>

								<!-- Discount Col -->
        <div class="stack-sm">
									<label class="form-label text-xs font-black mb-1">
										نسبة الخصم (%)
									</label>
									<select name="col_discount" x-model="mappingDiscount" class="form-input text-xs h-9 rounded-md">
										<option value="-1">-- غير محدد --</option>
										<template x-for="(h, idx) in mappingHeaders" :key="idx">
											<option :value="idx" x-text="'عمود ' + (idx+1) + ': ' + h" :selected="mappingDiscount == idx"></option>
										</template>
									</select>
								</div>
							</div>
						</div>

						<!-- Live Spreadsheet Data Preview Table -->
						<template x-if="mappingPreview.length > 0">
							<div class="bg-surface-raised border rounded-2xl overflow-hidden">
								<div class="p-3 bg-surface-sunken border-b flex-between items-center">
									<span class="text-xs font-black text-secondary">
										معاينة حية لأول 5 صفوف من ملف الإكسيل:
									</span>
									<span class="badge badge-slate text-xs tabular-nums" x-text="mappingPreview.length + ' صفوف'"></span>
								</div>
								<div class="overflow-x-auto max-h-56">
									<table class="data-table m-0 text-xs">
										<thead>
											<tr>
												<th class="w-9 text-center">#</th>
												<template x-for="(h, colIdx) in mappingHeaders" :key="colIdx">
													<th class="nowrap" :class="{ 'text-accent font-black': colIdx == mappingName, 'text-emerald mappingPrice }">
														<span x-text="h"></span>
														<template x-if="colIdx == mappingCode">
															<span class="badge badge-slate text-2xs ms-1">كود</span>
														</template>
														<template x-if="colIdx == mappingName">
															<span class="badge badge-sky text-2xs ms-1">اسم</span>
														</template>
														<template x-if="colIdx == mappingPrice">
															<span class="badge badge-emerald text-2xs ms-1">سعر</span>
														</template>
														<template x-if="colIdx == mappingDiscount">
															<span class="badge badge-amber text-2xs ms-1">خصم %</span>
														</template>
													</th>
												</template>
											</tr>
										</thead>
										<tbody>
											<template x-for="(row, rIdx) in mappingPreview" :key="rIdx">
												<tr>
													<td class="text-muted tabular-nums text-center" x-text="rIdx+1"></td>
													<template x-for="(cell, cIdx) in row" :key="cIdx">
														<td :class="{ 'font-bold': cIdx == mappingName }" x-text="cell"></td>
													</template>
												</tr>
											</template>
										</tbody>
									</table>
								</div>
							</div>
						</template>

						<!-- Modal Footer Actions -->
						<div class="flex-between items-center flex-wrap gap-3 border-t pt-4">
       <div class="stack-sm">
								<template x-if="mappingQueue.length > 0">
									<button
										type="button"
										class="btn btn-secondary btn-sm font-black rounded-lg text-xs"
										@click="skipAllMapping()"
										:disabled="mappingSubmitting"
									>
										تخطي باقي الملفات واعتماد الضبط التلقائي
									</button>
								</template>
							</div>

							<div class="d-flex items-center gap-2">
								<button
									type="button"
									class="btn btn-secondary btn-sm font-bold rounded-lg"
									@click="mappingModal = false"
									:disabled="mappingSubmitting"
								>
									إغلاق
								</button>

								<template x-if="mappingQueue.length > 0">
									<button
										type="button"
										class="btn btn-secondary btn-sm font-black rounded-lg"
										@click="skipMapping()"
										:disabled="mappingSubmitting"
									>
										تخطي للملف التالي ⏩
									</button>
								</template>

								<button
									type="submit"
									class="btn btn-primary font-black btn-sm rounded-lg px-6 py-2"
									:disabled="mappingSubmitting || mappingLoading"
								>
									<span x-show="!mappingSubmitting && mappingQueue.length === 0">حفظ وتأكيد الأعمدة </span>
									<span x-show="!mappingSubmitting && mappingQueue.length > 0">حفظ والانتقال للملف التالي </span>
									<span x-show="mappingSubmitting">جاري الحفظ والمعالجة...</span>
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>

}
