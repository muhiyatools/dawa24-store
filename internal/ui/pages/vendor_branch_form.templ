package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorBranchFormData struct {
	Branch     *org.Branch
	Cities     []*platformadmin.City
	Employees  []*org.EmployeeView
	IsEdit     bool
	NoticeType string
	NoticeMsg  string
}

func hasInstitutionalWork(b *org.Branch, key string) bool {
	if b == nil {
		return false
	}
	for _, k := range b.InstitutionalWorks {
		if k == key {
			return true
		}
	}
	return false
}

templ VendorBranchFormPage(data VendorBranchFormData, lang, dir string) {
	{{
		pageTitle := "إضافة فرع / مخزن جديد"
		if data.IsEdit && data.Branch != nil {
			if data.Branch.Name.Get(i18n.AR) != "" {
				pageTitle = "تعديل بيانات فرع: " + data.Branch.Name.Get(i18n.AR)
			} else {
				pageTitle = "تعديل بيانات الفرع"
			}
		}

		formAction := "/vendor/branches/new"
		if data.IsEdit && data.Branch != nil {
			formAction = fmt.Sprintf("/vendor/branches/%d/edit", data.Branch.ID)
		}

		nameAr := ""
		nameEn := ""
		code := ""
		warehouseType := "warehouse"
		address := ""
		phone := ""
		gmapsURL := ""
		capacitySQM := ""
		hasColdStorage := false
		isMain := false
		status := "active"
		defaultLat := "30.0444"
		defaultLon := "31.2357"

		if data.Branch != nil {
			nameAr = data.Branch.Name.Get(i18n.AR)
			nameEn = data.Branch.Name.Get(i18n.EN)
			code = data.Branch.Code
			if data.Branch.WarehouseType != "" {
				warehouseType = data.Branch.WarehouseType
			}
			address = data.Branch.Address
			phone = data.Branch.Phone
			gmapsURL = data.Branch.GoogleMapsURL
			if data.Branch.CapacitySQM > 0 {
				capacitySQM = fmt.Sprintf("%.0f", data.Branch.CapacitySQM)
			}
			hasColdStorage = data.Branch.HasColdStorage
			isMain = data.Branch.IsMain
			if data.Branch.Status != "" {
				status = data.Branch.Status
			}
			if data.Branch.Latitude != nil {
				defaultLat = fmt.Sprintf("%.6f", *data.Branch.Latitude)
			}
			if data.Branch.Longitude != nil {
				defaultLon = fmt.Sprintf("%.6f", *data.Branch.Longitude)
			}
		}
	}}
	@layouts.VendorShell(pageTitle, "branches", lang, dir) {
		<div class="container-fluid" style="max-width:1040px; margin:0 auto; padding:0.5rem 0 3.5rem 0;">
			
			<!-- Breadcrumb & Top Navigation Bar -->
			<div class="card" style="margin-bottom:1.5rem; padding:1.25rem 1.6rem; border-radius:var(--radius-2xl); border:1px solid var(--border); background:var(--surface-raised); box-shadow:var(--shadow-xs);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.8rem; color:var(--text-secondary); margin-bottom:0.35rem;">
							<a href="/vendor/branches" style="color:var(--text-secondary); text-decoration:none; font-weight:600;">شبكة الفروع والمخازن</a>
							<span>/</span>
							if data.IsEdit {
								<span style="color:var(--text); font-weight:700;">تعديل بيانات الفرع</span>
							} else {
								<span style="color:var(--text); font-weight:700;">إضافة فرع جديد</span>
							}
						</div>
						<h1 style="font-size:1.4rem; font-weight:800; color:var(--text); margin:0;">
							{ pageTitle }
						</h1>
					</div>

					<a href="/vendor/branches" class="btn btn-secondary btn-sm fw-700" style="gap:0.4rem;">
						<span>← إلغاء والعودة للفروع</span>
					</a>
				</div>
			</div>

			<!-- Notice Banner (if any) -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger" style="display:flex; align-items:center; gap:0.75rem; padding:1rem 1.25rem; border-radius:var(--radius-xl); background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:var(--rose); font-weight:700; margin-bottom:1.5rem;">
						<span style="font-size:1.25rem;">⚠️</span>
						<span>{ data.NoticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success" style="display:flex; align-items:center; gap:0.75rem; padding:1rem 1.25rem; border-radius:var(--radius-xl); background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.3); color:var(--emerald); font-weight:700; margin-bottom:1.5rem;">
						<span style="font-size:1.25rem;">✅</span>
						<span>{ data.NoticeMsg }</span>
					</div>
				}
			}

			<!-- Main Form Card -->
			<div class="card" style="padding:2rem; border-radius:var(--radius-2xl); background:var(--surface-raised); border:1px solid var(--border); box-shadow:var(--shadow-xs);">
				<form method="POST" action={ templ.SafeURL(formAction) } style="display:flex; flex-direction:column; gap:2rem;">
					
					<!-- Section 1: Basic Information -->
					<div>
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem; padding-bottom:0.6rem; border-bottom:1px solid var(--border);">
							<span style="font-size:1.2rem;">🏢</span>
							<h2 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">1. البيانات الأساسية للفرع أو المخزن</h2>
						</div>

						<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1.25rem;">
							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									اسم الفرع / المخزن (بالعربية) <span style="color:#ef4444;">*</span>
								</label>
								<input
									type="text"
									name="name_ar"
									value={ nameAr }
									required
									placeholder="مثال: مخزن الدلتا الرئيسي - طنطا"
									class="form-input w-full"
									style="font-size:0.9rem;"
								/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									اسم الفرع (بالإنجليزية)
								</label>
								<input
									type="text"
									name="name_en"
									value={ nameEn }
									placeholder="e.g. Delta Central Depot - Tanta"
									class="form-input w-full"
									style="font-size:0.9rem;"
								/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									كود الفرع (Branch Code)
								</label>
								<input
									type="text"
									name="code"
									value={ code }
									placeholder="مثال: WH-DEL-01"
									class="form-input tabular-nums w-full"
									style="font-size:0.9rem;"
								/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									نوع المنشأة اللوجستية <span style="color:#ef4444;">*</span>
								</label>
								<select name="warehouse_type" class="form-input w-full" style="font-size:0.9rem;">
									<option value="warehouse" selected?={ warehouseType == "warehouse" }>مخزن أدوية مركزي (Warehouse)</option>
									<option value="fast_hub" selected?={ warehouseType == "fast_hub" }>نقطة توزيع سريعة (Fast Hub)</option>
									<option value="cold_depot" selected?={ warehouseType == "cold_depot" }>مخزن تبريد مخصص (Cold Depot)</option>
									<option value="pharmacy_branch" selected?={ warehouseType == "pharmacy_branch" }>فرع صيدلية (Pharmacy Branch)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Section 2: City, Manager, Address, Phone, Capacity -->
					<div>
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem; padding-bottom:0.6rem; border-bottom:1px solid var(--border);">
							<span style="font-size:1.2rem;">📍</span>
							<h2 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">2. الموقع الإداري والإدارة المسؤولة</h2>
						</div>

						<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1.25rem; margin-bottom:1.25rem;">
							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									المدينة / المحافظة <span style="color:#ef4444;">*</span>
								</label>
								<select name="city_id" data-map-city required class="form-input w-full" style="font-size:0.9rem;">
									<option value="">-- اختر المدينة / المحافظة --</option>
									for _, c := range data.Cities {
										<option
											value={ fmt.Sprintf("%d", c.ID) }
											data-lat={ fmt.Sprintf("%.6f", c.Latitude) }
											data-lng={ fmt.Sprintf("%.6f", c.Longitude) }
											selected?={ data.Branch != nil && data.Branch.CityID != nil && *data.Branch.CityID == c.ID }
										>
											{ c.Name.Get(i18n.Lang(lang)) }
										</option>
									}
								</select>
							</div>

							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									مدير الفرع المسؤول
								</label>
								<select name="manager_id" class="form-input w-full" style="font-size:0.9rem;">
									<option value="">-- تعيين مدير من موظفي المنشأة --</option>
									for _, emp := range data.Employees {
										if emp.Member != nil {
											<option
												value={ fmt.Sprintf("%d", emp.Member.UserID) }
												selected?={ data.Branch != nil && data.Branch.ManagerID != nil && *data.Branch.ManagerID == emp.Member.UserID }
											>
												{ emp.UserName } ({ emp.RoleName })
											</option>
										}
									}
								</select>
							</div>

							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									رقم هاتف الفرع
								</label>
								<input
									type="tel"
									name="phone"
									value={ phone }
									placeholder="010XXXXXXXX"
									class="form-input tabular-nums w-full"
									style="font-size:0.9rem;"
								/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
									المساحة التخزينية (م²)
								</label>
								<input
									type="number"
									name="capacity_sqm"
									value={ capacitySQM }
									placeholder="500"
									class="form-input tabular-nums w-full"
									style="font-size:0.9rem;"
								/>
							</div>
						</div>

						<div>
							<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
								العنوان التفصيلي وموقع الاستلام <span style="color:#ef4444;">*</span>
							</label>
							<input
								type="text"
								name="address"
								value={ address }
								required
								placeholder="مثال: المنطقة الصناعية الثانية، قطعة 42، بجوار شركة توزيع الأدوية"
								class="form-input w-full"
								style="font-size:0.9rem;"
							/>
						</div>
					</div>

					<!-- Section 3: Interactive OpenStreetMap -->
					<div>
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem; padding-bottom:0.6rem; border-bottom:1px solid var(--border);">
							<span style="font-size:1.2rem;">🗺️</span>
							<h2 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">3. الإحداثيات الجغرافية وخريطة الموقع</h2>
						</div>

						<div class="stack-xs" style="margin-bottom:1.25rem;">
							<div
								data-map-picker
								data-default-lat={ defaultLat }
								data-default-lon={ defaultLon }
								style="border-radius:var(--radius-xl); overflow:hidden; border:1px solid var(--border); background:var(--surface-sunken); position:relative;"
							>
								<div class="map-container map-canvas" style="height:280px; width:100%; z-index:1;"></div>
								<div style="display:flex; justify-content:space-between; align-items:center; padding:0.6rem 1rem; background:var(--surface-raised); border-top:1px solid var(--border); font-size:0.825rem; flex-wrap:wrap; gap:0.5rem;">
									<div style="display:flex; align-items:center; gap:0.5rem;">
										<span style="color:var(--text-secondary); font-weight:700;">📍 الإحداثيات المحددة:</span>
										<span data-map-coords-badge class="tabular-nums fw-800 text-primary">{ defaultLat }, { defaultLon }</span>
									</div>
									<button type="button" data-map-locate class="btn btn-secondary btn-xs fw-700" style="gap:0.35rem;">
										<span>📍 تحديد موقعي الحالي GPS</span>
									</button>
								</div>
								<input type="hidden" name="latitude" data-map-input="lat" value={ defaultLat }/>
								<input type="hidden" name="longitude" data-map-input="lon" value={ defaultLon }/>
							</div>
						</div>

						<div>
							<label class="form-label" style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.35rem; display:block;">
								🔗 رابط خرائط Google (Google Maps URL)
							</label>
							<input
								type="url"
								name="google_maps_url"
								data-map-input="google_url"
								value={ gmapsURL }
								placeholder={ fmt.Sprintf("https://maps.google.com/?q=%s,%s", defaultLat, defaultLon) }
								class="form-input w-full"
								style="font-size:0.85rem;"
							/>
						</div>
					</div>

					<!-- Section 4: Institutional Works (12 Categories) -->
					<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
							<h3 style="font-size:0.95rem; font-weight:800; color:var(--text); margin:0;">
								🏛️ مجالات الأعمال المؤسسية المغطاة (Institutional Works)
							</h3>
							<span class="badge badge-sky text-xs fw-700">12 فئة معتمدة</span>
						</div>
						<p style="font-size:0.775rem; color:var(--text-muted); margin:0 0 1rem 0;">
							حدد مجالات العمل المؤسسي التي يخدمها هذا الفرع لضمان شموله في نتائج البحث والتوريد للعملاء:
						</p>

						<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.6rem;">
							for _, cat := range institutionalWorkCategories {
								<label style="display:flex; align-items:center; gap:0.5rem; font-size:0.8rem; color:var(--text-secondary); cursor:pointer; padding:0.5rem 0.75rem; border-radius:var(--radius-md); background:var(--surface-raised); border:1px solid var(--border);">
									<input
										type="checkbox"
										name="institutional_works"
										value={ cat.Key }
										checked?={ hasInstitutionalWork(data.Branch, cat.Key) }
										style="accent-color:var(--accent); width:16px; height:16px;"
									/>
									<span style="font-weight:600;">{ cat.Icon } { cat.LabelAr }</span>
								</label>
							}
						</div>
					</div>

					<!-- Section 5: Cold Storage, Main Branch, Status -->
					<div style="display:flex; flex-direction:column; gap:0.85rem; background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
						<label style="display:flex; align-items:flex-start; gap:0.65rem; cursor:pointer; font-size:0.875rem; font-weight:700; color:var(--text);">
							<input
								type="checkbox"
								name="has_cold_storage"
								value="true"
								checked?={ hasColdStorage }
								style="width:18px; height:18px; margin-top:2px; accent-color:var(--success);"
							/>
							<div>
								<span>❄️ سلسلة تبريد دوائية مجهزة (2° - 8° مئوية)</span>
								<span style="display:block; font-size:0.75rem; font-weight:500; color:var(--text-secondary); margin-top:0.2rem;">
									مخزن مجهز لتخزين وتوريد الأدوية الحيوية والأنسولين واللقاحات.
								</span>
							</div>
						</label>

						<label style="display:flex; align-items:flex-start; gap:0.65rem; cursor:pointer; font-size:0.875rem; font-weight:700; color:var(--text);">
							<input
								type="checkbox"
								name="is_main"
								value="true"
								checked?={ isMain }
								style="width:18px; height:18px; margin-top:2px; accent-color:var(--accent);"
							/>
							<div>
								<span>⭐ تعيين كفرع ومخزن رئيسي للمنشأة</span>
								<span style="display:block; font-size:0.75rem; font-weight:500; color:var(--text-secondary); margin-top:0.2rem;">
									الفرع الافتراضي الذي يظهر للصيادلة كمركز رئيسي للتوريد.
								</span>
							</div>
						</label>

						if data.IsEdit {
							<div style="padding-top:0.75rem; border-top:1px dashed var(--border); display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap;">
								<span style="font-size:0.85rem; font-weight:700; color:var(--text);">حالة تشغيل الفرع:</span>
								<label style="display:flex; align-items:center; gap:0.4rem; font-size:0.85rem; font-weight:700; cursor:pointer;">
									<input type="radio" name="status" value="active" checked?={ status != "inactive" } style="accent-color:var(--accent);" />
									<span class="badge badge-emerald">نشط وجاهز للتوريد</span>
								</label>
								<label style="display:flex; align-items:center; gap:0.4rem; font-size:0.85rem; font-weight:700; cursor:pointer;">
									<input type="radio" name="status" value="inactive" checked?={ status == "inactive" } style="accent-color:var(--accent);" />
									<span class="badge badge-slate">معطل مؤقتاً</span>
								</label>
							</div>
						}
					</div>

					<!-- Bottom Action Footer -->
					<div style="display:flex; justify-content:space-between; align-items:center; padding-top:1.5rem; border-top:1px solid var(--border); flex-wrap:wrap; gap:1rem;">
						<a href="/vendor/branches" class="btn btn-secondary btn-md fw-700">
							إلغاء والعودة بدون حفظ
						</a>

						<button type="submit" class="btn btn-primary btn-md" style="font-weight:800; padding:0.75rem 2.2rem; font-size:0.95rem; gap:0.5rem; box-shadow:var(--shadow-sm);">
							@components.IconCheck("icon-xs")
							if data.IsEdit {
								<span>💾 حفظ تحديثات الفرع</span>
							} else {
								<span>+ حفظ وإضافة الفرع</span>
							}
						</button>
					</div>

				</form>
			</div>

		</div>
	}
}
