package pages

import (
	"fmt"

	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// AdminPoliciesPanel is the policy editor. It renders inside the Policies tab
// of /admin/settings; there is no separate policies page any more, because two
// editors over platform_admin.policies could disagree about what a policy says
// (PLAN_V7 Task 2.3).
templ AdminPoliciesPanel(lang, dir string, currentKey string, policies []*platformadmin.Policy) {
	{{ _ = dir }}
	<div class="card" style="margin-bottom:0; overflow:visible;">
		<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; gap:1rem; flex-wrap:wrap;">
			<div style="display:flex; align-items:center; gap:0.6rem;">
				@components.IconFile("icon-md")
				<div>
					<h2 class="card-title" style="margin:0;">
						إدارة إصدارات السياسات والوثائق القانونية
					</h2>
					<p style="font-size:0.85rem; color:var(--neutral-500); margin-top:0.2rem;">
						تعديل ونشر الإصدارات المحدثة لشروط الاستخدام، سياسة الخصوصية، والاتفاقيات التجارية باللغتين العربية والإنجليزية.
					</p>
				</div>
			</div>

			<div style="display:flex; gap:0.75rem; align-items:center;">
				@components.ModalTrigger("create-policy-version-modal", "btn btn-primary") {
					@components.IconPlus("icon-xs")
					<span>إنشاء إصدار جديد من سياسة</span>
				}
			</div>
		</div>

		<!-- Filter by Policy Type -->
		<div style="display:flex; gap:0.5rem; margin-bottom:1.5rem; flex-wrap:wrap; border-bottom:1px solid var(--neutral-200); padding-bottom:1rem;">
			<a href="/admin/policies" class={ "btn btn-sm", templ.KV("btn-primary", currentKey == ""), templ.KV("btn-secondary", currentKey != "") }>
				<span>كافة السياسات ({ fmt.Sprintf("%d", len(policies)) })</span>
			</a>
			<a href="/admin/policies?key=terms" class={ "btn btn-sm", templ.KV("btn-primary", currentKey == "terms"), templ.KV("btn-secondary", currentKey != "terms") }>
				<span>شروط الاستخدام (Terms)</span>
			</a>
			<a href="/admin/policies?key=privacy" class={ "btn btn-sm", templ.KV("btn-primary", currentKey == "privacy"), templ.KV("btn-secondary", currentKey != "privacy") }>
				<span>سياسة الخصوصية (Privacy)</span>
			</a>
			<a href="/admin/policies?key=refund" class={ "btn btn-sm", templ.KV("btn-primary", currentKey == "refund"), templ.KV("btn-secondary", currentKey != "refund") }>
				<span>المرتجعات والتسويات (Refund)</span>
			</a>
			<a href="/admin/policies?key=vendor_agreement" class={ "btn btn-sm", templ.KV("btn-primary", currentKey == "vendor_agreement"), templ.KV("btn-secondary", currentKey != "vendor_agreement") }>
				<span>اتفاقية التوريد (Vendor Agreement)</span>
			</a>
		</div>

		if len(policies) == 0 {
			@components.EmptyState(components.EmptyStateProps{
				Title:   "لا توجد إصدارات مسجلة",
				Message: "يمكنك إنشاء إصدار جديد لأي سياسة من سياسات المنصة.",
			})
		} else {
			<div class="table-container" style="overflow:visible;">
				<table class="data-table">
					<thead>
						<tr>
							<th>السياسة القانونية</th>
							<th>رقم الإصدار</th>
							<th>العنوان (عربي / English)</th>
							<th>ملخص التعديلات</th>
							<th>حالة النشر</th>
							<th>تاريخ التحديث</th>
							<th style="text-align:end;">الإجراءات</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range policies {
							<tr>
								<td>
									<span class="badge badge-slate" style="font-weight:700;">{ policyKeyAr(p.PolicyKey) }</span>
								</td>
								<td>
									<strong class="tabular-nums" style="color:var(--primary-700); font-size:0.95rem;">v{ p.Version }</strong>
								</td>
								<td>
									<div style="font-weight:800; color:var(--neutral-900); font-size:0.9rem;">{ p.Title["ar"] }</div>
									if p.Title["en"] != "" {
										<div style="font-size:0.75rem; color:var(--neutral-500);">{ p.Title["en"] }</div>
									}
								</td>
								<td style="max-width:240px;">
									<div style="font-size:0.8rem; color:var(--neutral-600); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
										{ p.Summary["ar"] }
									</div>
								</td>
								<td>
									if p.IsPublished {
										<span class="badge badge-emerald">
											@components.IconCheck("icon-xs")
											<span>منشور ونشط</span>
										</span>
									} else {
										<span class="badge badge-amber">مسودة غير منشورة</span>
									}
								</td>
								<td style="font-size:0.8rem; color:var(--neutral-500);">
									{ p.UpdatedAt.Format("2006-01-02 15:04") }
								</td>
								<td style="text-align:end;">
									<div class="table-actions" style="justify-content:flex-end; gap:0.4rem;">
										@components.ModalTrigger(fmt.Sprintf("view-policy-modal-%d", p.ID), "btn btn-secondary btn-sm") {
											<span>معاينة</span>
										}

										if !p.IsPublished {
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/policies/%d/publish", p.ID)) } style="margin:0;">
												<button type="submit" class="btn btn-primary btn-sm">
													@components.IconCheck("icon-xs")
													<span>نشر هذا الإصدار</span>
												</button>
											</form>
										}

										<!-- View Policy Modal -->
										@components.Modal(components.ModalProps{
											ID:    fmt.Sprintf("view-policy-modal-%d", p.ID),
											Title: fmt.Sprintf("%s (الإصدار %s)", p.Title["ar"], p.Version),
											Size:  "lg",
										}) {
											<div style="display:flex; flex-direction:column; gap:1rem; text-align:start;">
												<div style="background:var(--neutral-50); padding:0.75rem 1rem; border-radius:var(--radius-md); border:1px solid var(--neutral-200); font-size:0.85rem;">
													<strong>ملخص التغييرات:</strong> { p.Summary["ar"] }
												</div>

												<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
													<div>
														<h4 style="font-weight:800; color:var(--neutral-900); margin-bottom:0.5rem; font-size:0.95rem;">المحتوى بالعربية:</h4>
														<div style="font-size:0.875rem; color:var(--neutral-700); line-height:1.8; white-space:pre-line; max-height:300px; overflow-y:auto; padding:0.75rem; background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-md);">
															{ p.Content["ar"] }
														</div>
													</div>
													<div>
														<h4 style="font-weight:800; color:var(--neutral-900); margin-bottom:0.5rem; font-size:0.95rem;">English Content:</h4>
														<div dir="ltr" style="font-size:0.875rem; color:var(--neutral-700); line-height:1.8; white-space:pre-line; max-height:300px; overflow-y:auto; padding:0.75rem; background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-md);">
															{ p.Content["en"] }
														</div>
													</div>
												</div>

												<div style="display:flex; justify-content:flex-end; margin-top:0.5rem;">
													<button type="button" class="btn btn-secondary" data-modal-close>إغلاق</button>
												</div>
											</div>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		<!-- Policy Version Creation Modal -->
		@components.Modal(components.ModalProps{
			ID:    "create-policy-version-modal",
			Title: "إنشاء إصدار جديد من سياسة المنصة",
			Size:  "lg",
		}) {
			<form method="POST" action="/admin/policies" style="display:flex; flex-direction:column; gap:1.15rem; text-align:start;">
				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-key">نوع الوثيقة القانونية *</label>
						<select id="policy-key" name="policy_key" required class="form-select">
							<option value="terms">شروط الاستخدام والخدمة (Terms of Service)</option>
							<option value="privacy">سياسة الخصوصية وحماية البيانات (Privacy Policy)</option>
							<option value="refund">سياسة المرتجعات والتسويات (Return & Refund)</option>
							<option value="vendor_agreement">اتفاقية التوريد وشروط الموردين (Vendor Supply Agreement)</option>
						</select>
					</div>
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-version">رقم الإصدار (Version) *</label>
						<input type="text" id="policy-version" name="version" required class="form-input tabular-nums" placeholder="1.1 أو 2.0" />
					</div>
				</div>

				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-title-ar">عنوان الوثيقة (عربي) *</label>
						<input type="text" id="policy-title-ar" name="title_ar" required class="form-input" placeholder="شروط الاستخدام والخدمة" />
					</div>
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-title-en">Title (English)</label>
						<input type="text" id="policy-title-en" name="title_en" class="form-input" dir="ltr" placeholder="Terms of Service" />
					</div>
				</div>

				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-summary-ar">ملخص التغييرات في هذا الإصدار (عربي)</label>
						<input type="text" id="policy-summary-ar" name="summary_ar" class="form-input" placeholder="تحديث بنود الفواتير الإلكترونية والتسويات الدوائية" />
					</div>
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-summary-en">Changelog Summary (English)</label>
						<input type="text" id="policy-summary-en" name="summary_en" class="form-input" dir="ltr" placeholder="Updated e-invoicing and settlement clauses" />
					</div>
				</div>

				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-content-ar">نص الوثيقة القانونية (عربي) *</label>
						<textarea id="policy-content-ar" name="content_ar" rows="8" required class="form-input" placeholder="أدخل نص وبنود السياسة القانونية بالتفصيل..."></textarea>
					</div>
					<div class="form-group" style="margin:0;">
						<label class="form-label" for="policy-content-en">Legal Policy Text (English)</label>
						<textarea id="policy-content-en" name="content_en" rows="8" class="form-input" dir="ltr" placeholder="Enter policy text and terms..."></textarea>
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.5rem;">
					<input type="checkbox" id="policy-publish" name="is_published" value="1" />
					<label for="policy-publish" style="font-size:0.875rem; font-weight:700; color:var(--neutral-800); cursor:pointer;">
						نشر هذا الإصدار وتفعيله للجمهور فوراً
					</label>
				</div>

				<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
					<button type="button" class="btn btn-secondary" data-modal-close>إلغاء</button>
					<button type="submit" class="btn btn-primary" style="font-weight:800;">
						@components.IconCheck("icon-xs")
						<span>حفظ الإصدار</span>
					</button>
				</div>
			</form>
		}
	</div>
}

func policyKeyAr(k string) string {
	switch k {
	case "terms":
		return "شروط الاستخدام"
	case "privacy":
		return "سياسة الخصوصية"
	case "refund":
		return "المرتجعات والتسويات"
	case "vendor_agreement":
		return "اتفاقية التوريد"
	default:
		return k
	}
}
