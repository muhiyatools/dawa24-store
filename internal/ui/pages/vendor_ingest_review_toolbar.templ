package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/shared/productmatch"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// reviewBulkBar is the review screen's actual unit of work.
templ reviewBulkBar(view VendorImportView, langOpt ...string) {
	{{
		lang := view.Lang
		if len(langOpt) > 0 && langOpt[0] != "" {
			lang = langOpt[0]
		}
		if lang == "" {
			lang = "ar"
		}
		scope := view.Filter.MatchLevel
	}}
	<form id="review-bulk" method="POST"
		action={ templ.SafeURL(view.BulkActionPath()) }
		class="glass-panel p-3 px-4 mb-4 review-bulk-bar border border-slate-200/80 rounded-2xl shadow-xs bg-surface-raised">
		<input type="hidden" name="f_match" value={ view.Filter.MatchLevel }/>
		<input type="hidden" name="f_outcome" value={ view.Filter.Outcome }/>
		<input type="hidden" name="f_q" value={ view.Filter.Search }/>

		<div class="review-bulk-row flex-between items-center flex-wrap gap-3">
			<div class="d-flex items-center gap-3 flex-wrap">
				<label class="review-bulk-pickall d-flex items-center gap-2 cursor-pointer select-none">
					<input type="checkbox" onchange="reviewToggleAll(this)" class="form-checkbox"/>
					<span class="font-extrabold text-xs text-primary">{ i18n.T(lang, "vendor_ingest.bulk.select_all_page") }</span>
				</label>
				<span class="badge badge-secondary text-2xs font-bold review-bulk-count" id="review-bulk-count">{ i18n.T(lang, "vendor_ingest.bulk.none_selected") }</span>

				<label class="review-bulk-scope d-flex items-center gap-1.5 cursor-pointer select-none text-muted">
					<input type="checkbox" name="select_scope" value="filter" class="form-checkbox"/>
					<span class="text-xs">
						{ fmt.Sprintf(i18n.T(lang, "vendor_ingest.bulk.scope_tab"), view.RowTotal) }
					</span>
				</label>
			</div>

			<div class="review-bulk-actions d-flex items-center gap-2 flex-wrap">
				if scope != "matched" {
					<button type="submit" name="bulk_action" value="confirm"
						class="btn btn-primary btn-sm font-extrabold text-xs gap-1 shadow-2xs"
						title={ i18n.T(lang, "vendor_ingest.bulk.confirm_selected_title") }>
						@components.IconCheck("icon-2xs")
						<span>{ i18n.T(lang, "vendor_ingest.bulk.confirm_selected") }</span>
					</button>
				}
				<button type="submit" name="bulk_action" value="unlink"
					class="btn btn-secondary btn-sm font-bold text-xs gap-1 shadow-2xs"
					title={ i18n.T(lang, "vendor_ingest.bulk.unlink_selected_title") }>
					@components.IconX("icon-2xs")
					<span>{ i18n.T(lang, "vendor_ingest.bulk.unlink_selected") }</span>
				</button>
				<button type="submit" name="bulk_action" value="exclude"
					class="btn btn-ghost btn-sm font-bold text-xs text-danger gap-1"
					title={ i18n.T(lang, "vendor_ingest.bulk.exclude_selected_title") }>
					@components.IconTrash("icon-2xs")
					<span>{ i18n.T(lang, "vendor_ingest.bulk.exclude_selected") }</span>
				</button>
				<button type="submit" name="bulk_action" value="include"
					class="btn btn-ghost btn-sm font-bold text-xs gap-1"
					title={ i18n.T(lang, "vendor_ingest.bulk.include_selected_title") }>
					<span>{ i18n.T(lang, "vendor_ingest.bulk.include_selected") }</span>
				</button>
			</div>
		</div>

		if scope == "review" || scope == "unmatched" {
			<div class="review-bulk-hint text-xs mt-2.5 pt-2.5 border-t border-slate-200/60 text-secondary d-flex items-center gap-2">
				@components.IconAlert("icon-2xs text-amber-500 flex-shrink-0")
				<span>
					{ i18n.T(lang, "vendor_ingest.bulk.review_tab_hint") }
				</span>
			</div>
		}
	</form>
}

templ reviewFilterTab(view VendorImportView, matchKey, label string) {
	{{
		active := (matchKey == "" && view.Filter.MatchLevel == "") || view.Filter.MatchLevel == matchKey
		href := view.ReviewURL(matchKey, view.Filter.SortBy, view.Filter.SortOrder, 1, view.PerPage, view.Filter.Search)
	}}
	<a href={ templ.SafeURL(href) }
		class={ "wiz-chip", templ.KV("is-on", active) }>
		{ label }
	</a>
}

templ reviewSortHeader(view VendorImportView, colKey, label string, langOpt ...string) {
	{{
		lang := view.Lang
		if len(langOpt) > 0 && langOpt[0] != "" {
			lang = langOpt[0]
		}
		if lang == "" {
			lang = "ar"
		}
		isCurrent := view.Filter.SortBy == colKey || (view.Filter.SortBy == "" && colKey == "row")
		nextOrder := "asc"
		icon := "⇅"
		if isCurrent {
			if view.Filter.SortOrder == "desc" {
				nextOrder = "asc"
				icon = "▼"
			} else {
				nextOrder = "desc"
				icon = "▲"
			}
		} else if colKey == "score" || colKey == "price" || colKey == "quantity" {
			nextOrder = "desc"
		}
		href := view.ReviewURL(view.Filter.MatchLevel, colKey, nextOrder, 1, view.PerPage, view.Filter.Search)
	}}
	<a href={ templ.SafeURL(href) }
		class="row-center-xs gap-xs text-secondary hover-text-primary font-extrabold"
		title={ fmt.Sprintf(i18n.T(lang, "vendor_ingest.table.sort_by"), label) }>
		<span>{ label }</span>
		<span class="text-xs">{ icon }</span>
	</a>
}

templ reviewPagination(view VendorImportView) {
	{{
		currPage := view.Page
		if currPage <= 0 {
			currPage = 1
		}
	}}
	if view.RowTotal > 0 {
		@components.B2BPagination(components.PaginationProps{
			CurrentPage: currPage,
			PageSize:    view.PerPage,
			TotalCount:  view.RowTotal,
			BaseURL:     view.SessionPath(view.Session.PublicID, ""),
			QueryValues: reviewPaginationQuery(view),
		})
	}
}

// reviewPaginationQuery carries the match-level tab, sort and search through a page change.
func reviewPaginationQuery(view VendorImportView) url.Values {
	q := url.Values{}
	if view.Filter.MatchLevel != "" {
		q.Set("match", view.Filter.MatchLevel)
	}
	if view.Filter.SortBy != "" {
		q.Set("sort", view.Filter.SortBy)
	}
	if view.Filter.SortOrder != "" {
		q.Set("order", view.Filter.SortOrder)
	}
	if view.Filter.Search != "" {
		q.Set("q", view.Filter.Search)
	}
	return q
}

func buildReviewURL(publicID, match, sortBy, sortOrder string, page, limit int, search string) string {
	u := fmt.Sprintf("/vendor/ingest/%s?page=%d&limit=%d", publicID, page, limit)
	if match != "" {
		u += "&match=" + match
	}
	if sortBy != "" {
		u += "&sort=" + sortBy
	}
	if sortOrder != "" {
		u += "&order=" + sortOrder
	}
	if search != "" {
		u += "&q=" + search
	}
	return u
}

func matchLevelText(level string, langOpt ...string) string {
	lang := "ar"
	if len(langOpt) > 0 && langOpt[0] != "" {
		lang = langOpt[0]
	}
	if lang == "en" {
		switch productmatch.MatchLevel(level) {
		case productmatch.MatchBarcode:
			return "Barcode Match"
		case productmatch.MatchCode:
			return "Code Match"
		case productmatch.MatchExact:
			return "Exact Name Match"
		case productmatch.MatchStrong:
			return "Strong Match"
		case productmatch.MatchReview:
			return "Needs Review"
		case productmatch.MatchAmbiguous:
			return "Ambiguous Match"
		default:
			return "Unmatched"
		}
	}
	switch productmatch.MatchLevel(level) {
	case productmatch.MatchBarcode:
		return "تطابق بالباركود"
	case productmatch.MatchCode:
		return "تطابق بالكود"
	case productmatch.MatchExact:
		return "تطابق تام"
	case productmatch.MatchStrong:
		return "تطابق قوي"
	case productmatch.MatchReview:
		return "يحتاج مراجعة"
	case productmatch.MatchAmbiguous:
		return "تطابق غامض"
	default:
		return "غير مطابق"
	}
}

func matchScoreBadgeTone(score float64) string {
	switch {
	case score >= productmatch.DefaultMinStrong:
		return "badge-emerald"
	case score >= productmatch.DefaultMinReview:
		return "badge-amber"
	default:
		return "badge-rose"
	}
}
