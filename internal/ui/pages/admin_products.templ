package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func derefBrandID(bid *int64) int64 {
	if bid != nil {
		return *bid
	}
	return 0
}

func getBrandLabel(bid *int64, brands []*catalog.Brand, fallback string) string {
	if bid != nil && *bid > 0 {
		for _, b := range brands {
			if b.ID == *bid {
				name := b.Name.Get("ar")
				if name == "" {
					name = b.Name.Get("en")
				}
				if name != "" {
					return name
				}
			}
		}
	}
	return fallback
}

templ AdminProducts(lang, dir string, products []*catalog.Product, brands []*catalog.Brand) {
	@layouts.AdminShell("دليل الأدوية والأصناف الأساسية", "products", lang, dir) {
		<div
			class="card"
			style="margin-bottom:0; overflow:visible;"
			x-data="{
				searchQuery: '',
				dosageFilter: 'all',
				statusFilter: 'all',
				isCreateModalOpen: false,
				isEditModalOpen: false,
				isImportModalOpen: false,
				editData: {
					id: 0,
					name_ar: '',
					name_en: '',
					generic_name: '',
					active_ingredient: '',
					dosage_form: 'أقراص',
					brand_id: 0,
					manufacturer: '',
					eda_reg_number: '',
					price: '0.00',
					image: '',
					description_ar: '',
					description_en: '',
					status: 'active'
				},
				openEdit(id, nameAr, nameEn, genericName, activeIng, dosageForm, brandId, manufacturer, edaReg, price, image, descAr, descEn, status) {
					this.editData = {
						id: id,
						name_ar: nameAr || '',
						name_en: nameEn || '',
						generic_name: genericName || '',
						active_ingredient: activeIng || '',
						dosage_form: dosageForm || 'أقراص',
						brand_id: brandId || 0,
						manufacturer: manufacturer || '',
						eda_reg_number: edaReg || '',
						price: price || '0.00',
						image: image || '',
						description_ar: descAr || '',
						description_en: descEn || '',
						status: status || 'active'
					};
					this.isEditModalOpen = true;
				}
			}"
		>
			
			<!-- Header Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; gap:1rem; flex-wrap:wrap;">
				<div class="row-center-sm">
					<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconPackage("icon-sm")
					</div>
					<div>
						<h2 class="card-title" style="margin:0; font-size:1.5rem; font-weight:800;">
							دليل الأصناف الدوائية المعتمدة ({ fmt.Sprintf("%d", len(products)) })
						</h2>
						<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
							إدارة الكتالوج الرسمي الموحد للأدوية والمستحضرات المعتمدة من هيئة الدواء المصرية (EDA)
						</p>
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
					<button type="button" @click="isImportModalOpen = true" class="btn btn-secondary" style="font-weight:700;">
						@components.IconUpload("icon-xs")
						<span>استيراد أصناف (Excel / CSV)</span>
					</button>
					<button type="button" @click="isCreateModalOpen = true" class="btn btn-primary" style="font-weight:800;">
						@components.IconPlus("icon-xs")
						<span>إضافة صنف دوائي أساسي</span>
					</button>
				</div>
			</div>

			<!-- Search and Filter Bar -->
			if len(products) > 0 {
				<div style="margin-bottom:1.25rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; background:var(--surface-sunken); padding:0.85rem 1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border);">
					<div style="flex:1; min-width:280px; max-width:480px; position:relative;">
						<input
							type="text"
							x-model="searchQuery"
							placeholder="ابحث باسم الدواء، المادة الفعالة، الشركة، أو رقم EDA..."
							class="form-input"
							style="padding-inline-start:2.25rem; font-size:0.875rem;"
						/>
						<div style="position:absolute; inset-inline-start:0.75rem; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
							@components.IconSearch("icon-xs")
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
						<select x-model="dosageFilter" class="form-select" style="font-size:0.825rem; padding:0.4rem 0.8rem;">
							<option value="all">كل الأشكال الصيدلية</option>
							<option value="أقراص">أقراص</option>
							<option value="كبسولات">كبسولات</option>
							<option value="شراب">شراب</option>
							<option value="حقن">حقن وأمبولات</option>
							<option value="نقط">نقط</option>
							<option value="فوار">فوار</option>
						</select>

						<select x-model="statusFilter" class="form-select" style="font-size:0.825rem; padding:0.4rem 0.8rem;">
							<option value="all">جميع الحالات</option>
							<option value="active">نشط ومعتمد</option>
							<option value="pending">قيد التدقيق</option>
							<option value="inactive">موقوف</option>
						</select>
					</div>
				</div>
			}

			if len(products) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد أصناف دوائية في الدليل",
					Message: "يمكنك إضافة الأصناف والمستحضرات الطبية الأساسية ليتمكن الموردون من إضافة عروض أسعارهم وتوريدها.",
				})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th style="width:50px;">الصورة</th>
								<th style="width:25%;">اسم المستحضر</th>
								<th style="width:24%;">الاسم العلمي والمادة الفعالة</th>
								<th style="width:12%;">الشكل الصيدلي</th>
								<th style="width:16%;">الشركة المصنعة</th>
								<th style="width:11%;">الحالة</th>
								<th style="width:12%; text-align:end;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range products {
								<tr
									x-show={ fmt.Sprintf("(!searchQuery || '%s %s %s %s %s'.toLowerCase().includes(searchQuery.toLowerCase())) && (dosageFilter === 'all' || '%s' === dosageFilter) && (statusFilter === 'all' || '%s' === statusFilter)",
										escapeJS(p.Name.Get("ar")),
										escapeJS(p.Name.Get("en")),
										escapeJS(p.ScientificName),
										escapeJS(p.Active),
										escapeJS(p.ManufacturingCompanies),
										escapeJS(p.DosageForm),
										p.Status) }
								>
									<td style="width:50px;">
										if p.Image != "" {
											<img src={ p.Image } alt={ p.Name.Get(i18n.Lang(lang)) } style="width:42px; height:42px; object-fit:contain; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-raised); padding:2px;" />
										} else {
											<div style="width:42px; height:42px; border-radius:var(--radius-md); background:var(--surface-sunken); display:flex; align-items:center; justify-content:center; color:var(--text-muted); border:1px solid var(--border);">
												@components.IconPill("icon-xs")
											</div>
										}
									</td>
									<td>
										<div style="font-weight:800; color:var(--text); font-size:0.95rem;">{ p.Name.Get(i18n.Lang(lang)) }</div>
										if p.Name.Get("en") != "" && lang == "ar" {
											<div style="font-size:0.75rem; color:var(--text-muted);">{ p.Name.Get("en") }</div>
										}
										if p.Barcode != "" {
											<div style="font-size:0.725rem; color:var(--text-secondary); margin-top:2px;" class="tabular-nums">EDA: { p.Barcode }</div>
										}
									</td>
									<td>
										<div style="font-weight:700; color:var(--accent); font-size:0.875rem;">{ p.ScientificName }</div>
										if p.Active != "" {
											<div style="font-size:0.75rem; color:var(--text-secondary);">{ p.Active }</div>
										}
									</td>
									<td>
										<span class="badge badge-slate" style="font-weight:700;">{ p.DosageForm }</span>
									</td>
									<td>
										if p.BrandID != nil && *p.BrandID > 0 {
											<a href="/admin/brands" class="badge badge-sky" style="font-weight:700; text-decoration:none;" title="عرض تفاصيل الشركة المصنعة">
												{ getBrandLabel(p.BrandID, brands, p.ManufacturingCompanies) }
											</a>
										} else if p.ManufacturingCompanies != "" {
											<span style="font-size:0.875rem; color:var(--text-secondary); font-weight:600;">{ p.ManufacturingCompanies }</span>
										} else {
											<span style="color:var(--text-muted); font-size:0.8rem; font-style:italic;">غير محدد</span>
										}
									</td>
									<td>
										if p.Status == "active" {
											<span class="badge badge-emerald" style="font-weight:800;">نشط ومعتمد</span>
										} else if p.Status == "pending" {
											<span class="badge badge-sky" style="font-weight:800;">قيد التدقيق</span>
										} else {
											<span class="badge badge-danger" style="font-weight:800;">موقوف</span>
										}
									</td>
									<td class="text-end">
										<div class="table-actions" style="justify-content:flex-end; gap:0.35rem;">
											
											<!-- Edit Button -->
											<button
												type="button"
												class="btn btn-secondary btn-icon"
												style="width:32px; height:32px; color:var(--accent);"
												title="تعديل بيانات الدواء"
												@click={ fmt.Sprintf("openEdit(%d, %q, %q, %q, %q, %q, %d, %q, %q, %q, %q, %q, %q, %q)",
													p.ID,
													p.Name.Get("ar"),
													p.Name.Get("en"),
													p.ScientificName,
													p.Active,
													p.DosageForm,
													derefBrandID(p.BrandID),
													p.ManufacturingCompanies,
													p.Barcode,
													p.Price.String(),
													p.Image,
													p.Description.Get("ar"),
													p.Description.Get("en"),
													string(p.Status)) }
											>
												@components.IconEdit("icon-xs")
											</button>

											<!-- Status Toggle -->
											if p.Status == "pending" || p.Status == "inactive" || p.Status == "rejected" {
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/products/%d/status", p.ID)) } class="m-0">
													<input type="hidden" name="status" value="active" />
													<button type="submit" class="btn btn-secondary btn-icon" style="width:32px; height:32px; color:var(--success-text);" title="تفعيل الصنف">
														@components.IconCheck("icon-xs")
													</button>
												</form>
											}
											if p.Status == "active" {
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/products/%d/status", p.ID)) } class="m-0">
													<input type="hidden" name="status" value="inactive" />
													<button type="submit" class="btn btn-secondary btn-icon" style="width:32px; height:32px; color:var(--warning-text);" title="إيقاف الصنف">
														@components.IconMinus("icon-xs")
													</button>
												</form>
											}

											<!-- Delete Button -->
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/products/%d/delete", p.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الصنف الدوائي الأساسي؟');">
												<button type="submit" class="btn btn-secondary btn-icon" style="width:32px; height:32px; color:var(--danger);" title="حذف الصنف">
													@components.IconTrash("icon-xs")
												</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

			<!-- Master Product Creation Modal -->
			<div
				x-show="isCreateModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isCreateModalOpen = false"
			>
				<div
					@click.outside="isCreateModalOpen = false"
					class="card"
					style="max-width:760px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div class="row-center-sm">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconPlus("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								إضافة صنف دوائي أساسي جديد (Master Product)
							</h3>
						</div>
						<button type="button" @click="isCreateModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/admin/products/new" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:1.15rem; text-align:start;">
						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الدواء / المستحضر (عربي) *</label>
								<input type="text" name="name_ar" required class="form-input" placeholder="كونجستال أقراص" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الدواء (إنجليزي) *</label>
								<input type="text" name="name_en" required class="form-input" dir="ltr" placeholder="Congestal Tablets" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الاسم العلمي (Scientific Name) *</label>
								<input type="text" name="generic_name" required class="form-input" placeholder="Paracetamol + Pseudoephedrine" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">المادة الفعالة والتركيز *</label>
								<input type="text" name="active_ingredient" required class="form-input" placeholder="Paracetamol 500mg" />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الشكل الصيدلي (Dosage Form) *</label>
								<select name="dosage_form" required class="form-select">
									<option value="أقراص">أقراص (Tablets)</option>
									<option value="كبسولات">كبسولات (Capsules)</option>
									<option value="شراب">شراب (Syrup / Suspension)</option>
									<option value="حقن">أمبولات وحقن (Injections)</option>
									<option value="مرهم / كريم">مرهم / كريم (Ointment / Cream)</option>
									<option value="نقط">نقط (Drops)</option>
									<option value="فوار">أكياس فوار (Sachets)</option>
									<option value="مستلزمات طبية">مستلزمات طبية (Medical Supplies)</option>
								</select>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">رقم التسجيل بهيئة الدواء (EDA)</label>
								<input type="text" name="eda_reg_number" class="form-input tabular-nums" placeholder="EDA-10293" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الشركة المصنعة من الدليل المعتمد (Brand)</label>
								<select name="brand_id" class="form-select">
									<option value="">-- اختر من الشركات المصنعة المعتمدة --</option>
									for _, b := range brands {
										<option value={ fmt.Sprintf("%d", b.ID) }>
											{ b.Name.Get("ar") }
											if b.Name.Get("en") != "" {
												({ b.Name.Get("en") })
											}
										</option>
									}
								</select>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">أو كتابة اسم الشركة المصنعة يدوياً</label>
								<input type="text" name="manufacturer" class="form-input" placeholder="Eva Pharma" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">صورة الصنف (رفع ملف)</label>
								<input type="file" name="product_image" accept=".png,.jpg,.jpeg,.webp" class="form-input" style="padding:0.45rem;" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">أو رابط الصورة (URL)</label>
								<input type="text" name="image_url" class="form-input" dir="ltr" placeholder="https://..." />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الوصف ودواعي الاستعمال (عربي)</label>
								<textarea name="description_ar" rows="2" class="form-input" placeholder="دواعي الاستعمال والجرعات المقترحة..."></textarea>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">الوصف (إنجليزي)</label>
								<textarea name="description_en" rows="2" class="form-input" dir="ltr" placeholder="Indications, dosage and usage..."></textarea>
							</div>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isCreateModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ وإدراج الصنف في الكتالوج</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Master Product Edit Modal -->
			<div
				x-show="isEditModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isEditModalOpen = false"
			>
				<div
					@click.outside="isEditModalOpen = false"
					class="card"
					style="max-width:760px; width:100%; max-height:90vh; overflow-y:auto; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div class="row-center-sm">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconEdit("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								تعديل بيانات الصنف الدوائي المعتمد
							</h3>
						</div>
						<button type="button" @click="isEditModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form :action="'/admin/products/' + editData.id + '/edit'" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:1.15rem; text-align:start;">
						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الدواء / المستحضر (عربي) *</label>
								<input type="text" name="name_ar" x-model="editData.name_ar" required class="form-input" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">اسم الدواء (إنجليزي) *</label>
								<input type="text" name="name_en" x-model="editData.name_en" required class="form-input" dir="ltr" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الاسم العلمي (Scientific Name) *</label>
								<input type="text" name="generic_name" x-model="editData.generic_name" required class="form-input" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">المادة الفعالة والتركيز *</label>
								<input type="text" name="active_ingredient" x-model="editData.active_ingredient" required class="form-input" />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الشكل الصيدلي (Dosage Form) *</label>
								<select name="dosage_form" x-model="editData.dosage_form" required class="form-select">
									<option value="أقراص">أقراص (Tablets)</option>
									<option value="كبسولات">كبسولات (Capsules)</option>
									<option value="شراب">شراب (Syrup / Suspension)</option>
									<option value="حقن">أمبولات وحقن (Injections)</option>
									<option value="مرهم / كريم">مرهم / كريم (Ointment / Cream)</option>
									<option value="نقط">نقط (Drops)</option>
									<option value="فوار">أكياس فوار (Sachets)</option>
									<option value="مستلزمات طبية">مستلزمات طبية (Medical Supplies)</option>
								</select>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">رقم التسجيل بهيئة الدواء (EDA)</label>
								<input type="text" name="eda_reg_number" x-model="editData.eda_reg_number" class="form-input tabular-nums" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الشركة المصنعة من الدليل المعتمد (Brand)</label>
								<select name="brand_id" x-model="editData.brand_id" class="form-select">
									<option value="0">-- اختر من الشركات المصنعة المعتمدة --</option>
									for _, b := range brands {
										<option value={ fmt.Sprintf("%d", b.ID) }>
											{ b.Name.Get("ar") }
											if b.Name.Get("en") != "" {
												({ b.Name.Get("en") })
											}
										</option>
									}
								</select>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">أو تعديل اسم الشركة المصنعة يدوياً</label>
								<input type="text" name="manufacturer" x-model="editData.manufacturer" class="form-input" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">تغيير الصورة</label>
								<input type="file" name="product_image" accept=".png,.jpg,.jpeg,.webp" class="form-input" style="padding:0.45rem;" />
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">أو رابط الصورة (URL)</label>
								<input type="text" name="image_url" x-model="editData.image" class="form-input" dir="ltr" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group" style="margin:0;">
								<label class="form-label">الوصف ودواعي الاستعمال (عربي)</label>
								<textarea name="description_ar" x-model="editData.description_ar" rows="2" class="form-input"></textarea>
							</div>
							<div class="form-group" style="margin:0;">
								<label class="form-label">الوصف (إنجليزي)</label>
								<textarea name="description_en" x-model="editData.description_en" rows="2" class="form-input" dir="ltr"></textarea>
							</div>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isEditModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>حفظ التعديلات على الصنف</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Bulk Import Modal -->
			<div
				x-show="isImportModalOpen"
				x-cloak
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1.5rem;"
				@keydown.escape.window="isImportModalOpen = false"
			>
				<div
					@click.outside="isImportModalOpen = false"
					class="card"
					style="max-width:580px; width:100%; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1rem;">
						<div class="row-center-sm">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconUpload("icon-xs")
							</div>
							<h3 style="font-size:1.25rem; font-weight:800; color:var(--text); margin:0;">
								استيراد أصناف جماعية (Bulk Import)
							</h3>
						</div>
						<button type="button" @click="isImportModalOpen = false" class="btn btn-secondary btn-icon" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/admin/products/import" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:1.25rem; text-align:start;">
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-lg); border:1px solid var(--border); font-size:0.875rem;">
							<div style="font-weight:700; color:var(--text); margin-bottom:0.35rem;">تعليمات الملف:</div>
							<p style="color:var(--text-secondary); margin:0 0 0.75rem 0; font-size:0.8rem; line-height:1.5;">
								قم برفع ملف Excel (.xlsx) أو CSV يحتوي على أعمدة الأصناف. يمكنك تحميل النموذج القياسي المعتمد:
							</p>
							<a href="/admin/products/sample.xlsx" download class="btn btn-secondary btn-sm" style="font-weight:700; color:var(--accent);">
								@components.IconDownload("icon-xs")
								<span>تحميل نموذج Excel الاسترشادي (.xlsx)</span>
							</a>
						</div>

						<div class="form-group" style="margin:0;">
							<label class="form-label">اختيار ملف الأصناف (.xlsx, .csv) *</label>
							<input type="file" name="file" accept=".xlsx,.csv" required class="form-input" style="padding:0.5rem;" />
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; border-top:1px solid var(--border); padding-top:1rem;">
							<button type="button" @click="isImportModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800; gap:0.4rem;">
								@components.IconUpload("icon-xs")
								<span>بدء استيراد وإضافة الأصناف</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}
