package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func minInt(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func totalPages(total, pageSize int) int {
	if pageSize <= 0 {
		return 1
	}
	pages := (total + pageSize - 1) / pageSize
	if pages < 1 {
		return 1
	}
	return pages
}

func calculateAdminPageNumbers(current, total int) []int {
	if total <= 1 {
		return []int{1}
	}
	start := current - 2
	if start < 1 {
		start = 1
	}
	end := start + 4
	if end > total {
		end = total
		start = end - 4
		if start < 1 {
			start = 1
		}
	}
	var nums []int
	for i := start; i <= end; i++ {
		nums = append(nums, i)
	}
	return nums
}

func buildAdminProductsPageURL(page, limit int, q, status, dosage string, brandID, catID int64) string {
	u := fmt.Sprintf("/admin/products?page=%d&limit=%d", page, limit)
	if q != "" {
		u += "&q=" + url.QueryEscape(q)
	}
	if status != "" && status != "all" {
		u += "&status=" + url.QueryEscape(status)
	}
	if dosage != "" && dosage != "all" {
		u += "&dosage=" + url.QueryEscape(dosage)
	}
	if brandID > 0 {
		u += fmt.Sprintf("&brand_id=%d", brandID)
	}
	if catID > 0 {
		u += fmt.Sprintf("&category_id=%d", catID)
	}
	return u
}

func derefBrandID(bid *int64) int64 {
	if bid != nil {
		return *bid
	}
	return 0
}

func derefCategoryID(cid *int64) int64 {
	if cid != nil {
		return *cid
	}
	return 0
}

func getCategoryDisplayLabel(c *catalog.Category, categories []*catalog.Category) string {
	if c == nil {
		return ""
	}
	name := c.Name.Get("ar")
	if name == "" {
		name = c.Name.Get("en")
	}
	if c.ParentID != nil && *c.ParentID > 0 {
		for _, parent := range categories {
			if parent.ID == *c.ParentID {
				parentName := parent.Name.Get("ar")
				if parentName == "" {
					parentName = parent.Name.Get("en")
				}
				if parentName != "" {
					return parentName + " " + name
				}
			}
		}
	}
	return name
}

func getCategoryLabel(cid *int64, categories []*catalog.Category, fallback string) string {
	if cid != nil && *cid > 0 {
		for _, c := range categories {
			if c.ID == *cid {
				return getCategoryDisplayLabel(c, categories)
			}
		}
	}
	return fallback
}

func getBrandLabel(bid *int64, brands []*catalog.Brand, fallback string) string {
	if bid != nil && *bid > 0 {
		for _, b := range brands {
			if b.ID == *bid {
				name := b.Name.Get("ar")
				if name == "" {
					name = b.Name.Get("en")
				}
				if name != "" {
					return name
				}
			}
		}
	}
	return fallback
}

templ AdminProducts(lang, dir string, products []*catalog.Product, brands []*catalog.Brand, categories []*catalog.Category, totalCount, currentPage, pageSize int, searchQuery, statusFilter, dosageFilter string, brandFilterVal, catFilterVal int64) {
	@layouts.AdminShell("دليل الأدوية والأصناف الأساسية", "products", lang, dir) {
		<div
			class="stack-lg"
			x-data="{
				searchQuery: '',
				dosageFilter: 'all',
				statusFilter: 'all',
				editData: {
					id: 0,
					name_ar: '',
					name_en: '',
					generic_name: '',
					active_ingredient: '',
					dosage_form: 'أقراص',
					brand_id: 0,
					category_id: 0,
					manufacturer: '',
					eda_reg_number: '',
					price: '0.00',
					image: '',
					description_ar: '',
					description_en: '',
					status: 'active'
				},
				openEdit(id, nameAr, nameEn, genericName, activeIng, dosageForm, brandId, categoryId, manufacturer, edaReg, price, image, descAr, descEn, status) {
					this.editData = {
						id: id,
						name_ar: nameAr || '',
						name_en: nameEn || '',
						generic_name: genericName || '',
						active_ingredient: activeIng || '',
						dosage_form: dosageForm || 'أقراص',
						brand_id: brandId || 0,
						category_id: categoryId || 0,
						manufacturer: manufacturer || '',
						eda_reg_number: edaReg || '',
						price: price || '0.00',
						image: image || '',
						description_ar: descAr || '',
						description_en: descEn || '',
						status: status || 'active'
					};
					const modal = document.getElementById('product-edit-modal');
					if (modal && typeof modal.showModal === 'function') modal.showModal();
				}
			}"
		>
			
			{{
				totalCountVal := totalCount
			}}
			<!-- Header Action Bar -->
			@components.PageHeader(components.PageHeaderProps{
				Title:      "دليل الأصناف الدوائية المعتمدة",
				Subtitle:   "إدارة الكتالوج الرسمي الموحد للأدوية والمستحضرات المعتمدة من هيئة الدواء المصرية (EDA)",
				Count:      &totalCountVal,
				CountLabel: "صنف معتمد",
			}) {
				<a href="/admin/products/import" class="btn btn-secondary font-semibold gap-2">
					@components.IconUpload("icon-xs")
					<span>استيراد ملف الكتالوج (Excel / CSV)</span>
				</a>
				<button
					type="button"
					class="btn btn-primary font-bold gap-2"
					onclick="document.getElementById('product-create-modal').showModal()"
				>
					@components.IconPlus("icon-xs")
					<span>إضافة صنف دوائي جديد +</span>
				</button>
				if totalCount > 0 {
					<form method="POST" action="/admin/products/delete-all" class="d-inline m-0"
						onsubmit="return confirm('تحذير نهائي فائق الأهمية: هل أنت متأكد من حذف جميع أصناف الكتالوج المركزي الأساسي بالكامل؟ لا يمكن التراجع عن هذا الإجراء.');">
						<button type="submit" class="btn btn-ghost text-danger font-bold gap-2">
							<span>حذف جميع أصناف الكتالوج</span>
						</button>
					</form>
				}
			}

			<!-- Table & Search Card -->
			<div class="glass-panel p-4 mb-0">
				<!-- Search & Filter Controls (Server-Side Full Database Search) -->
				<form
					method="GET"
					action="/admin/products"
					class="b2b-filter-bar mb-4"
				>
				<div class="b2b-filter-grid">
				<div class="search-input-group w-full">
					<span class="search-icon">
						@components.IconSearch("icon-sm")
					</span>
					<input
						type="text"
						name="q"
						class="form-input search-input"
						placeholder="البحث بالاسم العربي، التجاري، العلمي، أو رقم التسجيل EDA..."
						value={ searchQuery }
					/>
				</div>

    <div class="stack-sm">
					<select name="dosage" class="form-select" onchange="this.form.submit()">
						<option value="all" selected?={ dosageFilter == "" || dosageFilter == "all" }>كل الأشكال الصيدلية</option>
						<option value="أقراص" selected?={ dosageFilter == "أقراص" }>أقراص (Tablets)</option>
						<option value="كبسولات" selected?={ dosageFilter == "كبسولات" }>كبسولات (Capsules)</option>
						<option value="شراب" selected?={ dosageFilter == "شراب" }>شراب (Syrup / Suspension)</option>
						<option value="حقن" selected?={ dosageFilter == "حقن" }>أمبولات وحقن (Injections)</option>
						<option value="مرهم / كريم" selected?={ dosageFilter == "مرهم / كريم" }>مرهم / كريم (Ointment / Cream)</option>
						<option value="نقط" selected?={ dosageFilter == "نقط" }>نقط (Drops)</option>
						<option value="فوار" selected?={ dosageFilter == "فوار" }>أكياس فوار (Sachets)</option>
						<option value="مستلزمات طبية" selected?={ dosageFilter == "مستلزمات طبية" }>مستلزمات طبية (Medical Supplies)</option>
					</select>
				</div>

    <div class="stack-sm">
					<select name="brand_id" class="form-select" onchange="this.form.submit()">
						<option value="0" selected?={ brandFilterVal == 0 }>كل الشركات المصنعة</option>
						for _, b := range brands {
							<option value={ fmt.Sprintf("%d", b.ID) } selected?={ brandFilterVal == b.ID }>
								{ b.Name.Get("ar") }
							</option>
						}
					</select>
				</div>

    <div class="stack-sm">
					<select name="status" class="form-select" onchange="this.form.submit()">
						<option value="all" selected?={ statusFilter == "" || statusFilter == "all" }>كل الحالات</option>
						<option value="active" selected?={ statusFilter == "active" }>نشط ومعتمد (Active)</option>
						<option value="inactive" selected?={ statusFilter == "inactive" }>موقوف (Inactive)</option>
					</select>
				</div>

    <div class="stack-sm">
					<select name="limit" class="form-select" onchange="this.form.submit()">
						<option value="25" selected?={ pageSize == 25 }>25 صنف لكل صفحة</option>
						<option value="50" selected?={ pageSize == 50 }>50 صنف لكل صفحة</option>
						<option value="100" selected?={ pageSize == 100 }>100 صنف لكل صفحة</option>
						<option value="200" selected?={ pageSize == 200 }>200 صنف لكل صفحة</option>
					</select>
				</div>

				<div class="d-flex items-center gap-2">
					<button type="submit" class="btn btn-primary btn-sm font-extrabold px-4">
						@components.IconSearch("icon-xs")
						<span>بحث شامل</span>
					</button>
					if searchQuery != "" || (statusFilter != "" && statusFilter != "all") || (dosageFilter != "" && dosageFilter != "all") || brandFilterVal > 0 || catFilterVal > 0 {
						<a href="/admin/products" class="btn btn-ghost btn-sm font-bold" title="إعادة تعيين الفلاتر">
							إلغاء الفلاتر
						</a>
					}
				</div>
				</div>
			</form>

			<!-- Master Products Table -->
			if len(products) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد أصناف دوائية مسجلة",
					Message: "لم يتم تسجيل أدوية في الكتالوج الأساسي بعد. ابدأ بإضافة صنف أو استيراد ملف الكتالوج.",
				})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th class="w-12">الصورة</th>
								<th>الاسم والتسجيل</th>
								<th>الاسم العلمي والفعالية</th>
								<th>الشكل الصيدلي</th>
								<th>فئة المنتج</th>
								<th>الشركة المصنعة</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range products {
								<tr
									id={ fmt.Sprintf("product-row-%d", p.ID) }
									x-show={ fmt.Sprintf("(searchQuery === '' || %q.toLowerCase().includes(searchQuery.toLowerCase()) || %q.toLowerCase().includes(searchQuery.toLowerCase()) || %q.toLowerCase().includes(searchQuery.toLowerCase()) || %q.toLowerCase().includes(searchQuery.toLowerCase())) && (dosageFilter === 'all' || %q.includes(dosageFilter)) && (statusFilter === 'all' || %q === statusFilter)",
										p.Name.Get("ar"),
										p.Name.Get("en"),
										p.ScientificName,
										p.Barcode,
										p.DosageForm,
										p.Status) }
								>
									<td>
										if p.Image != "" {
											<img src={ p.Image } alt={ p.Name.Get(i18n.Lang(lang)) } />
										} else {
											<div class="stack-xs text-sm">
												@components.IconPill("icon-xs")
											</div>
										}
									</td>
									<td>
										<div class="fw-800 text-primary text-base">{ p.Name.Get(i18n.Lang(lang)) }</div>
										if p.Name.Get("en") != "" && lang == "ar" {
											<div class="text-xs text-muted">{ p.Name.Get("en") }</div>
										}
										if p.Barcode != "" {
											<div class="tabular-nums">EDA: { p.Barcode }</div>
										}
									</td>
									<td>
										<div class="stack-xs text-sm">{ p.ScientificName }</div>
										if p.Active != "" {
											<div class="text-xs text-secondary">{ p.Active }</div>
										}
									</td>
									<td>
										<span class="badge badge-slate font-bold">{ p.DosageForm }</span>
									</td>
									<td>
										<span class="badge badge-sky font-bold">
											{ getCategoryLabel(p.CategoryID, categories, "غير مصنف") }
										</span>
									</td>
									<td>
										if p.BrandID != nil && *p.BrandID > 0 {
											<a href="/admin/brands" class="badge badge-sky" title="عرض تفاصيل الشركة المصنعة">
												{ getBrandLabel(p.BrandID, brands, p.ManufacturingCompanies) }
											</a>
										} else if p.ManufacturingCompanies != "" {
											<span>{ p.ManufacturingCompanies }</span>
										} else {
											<span>غير محدد</span>
										}
									</td>
									<td>
										if p.Status == "active" {
											<span class="badge badge-emerald fw-800">نشط ومعتمد</span>
										} else {
											<span class="badge badge-danger fw-800">موقوف</span>
										}
									</td>
									<td class="text-end">
										<div class="table-actions">
											
											<!-- Edit Button -->
											<button
												type="button"
												class="btn btn-secondary btn-icon"
											
												title="تعديل بيانات الدواء"
												@click={ fmt.Sprintf("openEdit(%d, %q, %q, %q, %q, %q, %d, %d, %q, %q, %q, %q, %q, %q, %q)",
													p.ID,
													p.Name.Get("ar"),
													p.Name.Get("en"),
													p.ScientificName,
													p.Active,
													p.DosageForm,
													derefBrandID(p.BrandID),
													derefCategoryID(p.CategoryID),
													p.ManufacturingCompanies,
													p.Barcode,
													p.Price.String(),
													p.Image,
													p.Description.Get("ar"),
													p.Description.Get("en"),
													string(p.Status)) }
											>
												@components.IconEdit("icon-xs")
											</button>

											<!-- Status Toggle -->
											if p.Status == "pending" || p.Status == "inactive" || p.Status == "rejected" {
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/products/%d/status", p.ID)) } class="m-0">
													<input type="hidden" name="status" value="active" />
													<button type="submit" class="btn btn-secondary btn-icon" title="تفعيل الصنف">
														@components.IconCheck("icon-xs")
													</button>
												</form>
											}
											if p.Status == "active" {
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/products/%d/status", p.ID)) } class="m-0">
													<input type="hidden" name="status" value="inactive" />
													<button type="submit" class="btn btn-secondary btn-icon" title="إيقاف الصنف">
														@components.IconMinus("icon-xs")
													</button>
												</form>
											}

											<!-- Delete Button -->
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/products/%d/delete", p.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الصنف الدوائي الأساسي؟');">
												<button type="submit" class="btn btn-secondary btn-icon" title="حذف الصنف">
													@components.IconTrash("icon-xs")
												</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<!-- Pagination Controls -->
				if totalCount > 0 {
     <div class="stack-sm">
						<div class="stack-xs text-sm">
							{ fmt.Sprintf("عرض %d - %d من إجمالي %d صنف معتمد", minInt((currentPage-1)*pageSize+1, totalCount), minInt(currentPage*pageSize, totalCount), totalCount) }
						</div>

						<!-- Page navigation numbers -->
      <div class="stack-sm">
							if currentPage > 1 {
								<a
									href={ templ.SafeURL(buildAdminProductsPageURL(1, pageSize, searchQuery, statusFilter, dosageFilter, brandFilterVal, catFilterVal)) }
									class="btn btn-secondary btn-sm"
								
									title="الصفحة الأولى"
								>
									«
								</a>
								<a
									href={ templ.SafeURL(buildAdminProductsPageURL(currentPage-1, pageSize, searchQuery, statusFilter, dosageFilter, brandFilterVal, catFilterVal)) }
									class="btn btn-secondary btn-sm"
								
								>
									السابق
								</a>
							}

							for _, pNum := range calculateAdminPageNumbers(currentPage, totalPages(totalCount, pageSize)) {
								if pNum == currentPage {
									<span
										class="btn btn-primary btn-sm"
									
									>
										{ fmt.Sprintf("%d", pNum) }
									</span>
								} else {
									<a
										href={ templ.SafeURL(buildAdminProductsPageURL(pNum, pageSize, searchQuery, statusFilter, dosageFilter, brandFilterVal, catFilterVal)) }
										class="btn btn-secondary btn-sm"
									
									>
										{ fmt.Sprintf("%d", pNum) }
									</a>
								}
							}

							if currentPage < totalPages(totalCount, pageSize) {
								<a
									href={ templ.SafeURL(buildAdminProductsPageURL(currentPage+1, pageSize, searchQuery, statusFilter, dosageFilter, brandFilterVal, catFilterVal)) }
									class="btn btn-secondary btn-sm"
								
								>
									التالي
								</a>
								<a
									href={ templ.SafeURL(buildAdminProductsPageURL(totalPages(totalCount, pageSize), pageSize, searchQuery, statusFilter, dosageFilter, brandFilterVal, catFilterVal)) }
									class="btn btn-secondary btn-sm"
								
									title="الصفحة الأخيرة"
								>
									»
								</a>
							}
						</div>
					</div>
				}
			}
			</div>

			<!-- Master Product Creation Modal -->
			@components.Modal(components.ModalProps{
				ID:    "product-create-modal",
				Title:      "دليل الأصناف الدوائية المعتمدة",
				Size:  "lg",
			}) {
				<form action="/admin/products/new" method="POST" enctype="multipart/form-data" class="d-flex flex-col gap-4 m-0">
						<div class="modal-body d-flex flex-col gap-4">
							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">اسم الدواء / المستحضر (عربي) *</label>
									<input type="text" name="name_ar" required class="form-input" placeholder="مثال: بنادول إكسترا 500 مجم" />
								</div>
								<div class="form-group m-0">
									<label class="form-label">اسم الدواء (إنجليزي) *</label>
									<input type="text" name="name_en" required class="form-input" dir="ltr" placeholder="Panadol Extra 500mg" />
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">الاسم العلمي (Scientific Name) *</label>
									<input type="text" name="generic_name" required class="form-input" placeholder="Paracetamol + Caffeine" />
								</div>
								<div class="form-group m-0">
									<label class="form-label">المادة الفعالة والتركيز *</label>
									<input type="text" name="active_ingredient" required class="form-input" placeholder="باراسيتامول 500 مجم + كافيين 65 مجم" />
								</div>
							</div>

							<div class="grid-2">
								<div class="form-group m-0">
									<label class="form-label">الشكل الصيدلي (Dosage Form) *</label>
									<select name="dosage_form" required class="form-select">
										<option value="أقراص">أقراص (Tablets)</option>
										<option value="كبسولات">كبسولات (Capsules)</option>
										<option value="شراب">شراب (Syrup / Suspension)</option>
										<option value="حقن">أمبولات وحقن (Injections)</option>
										<option value="مرهم / كريم">مرهم / كريم (Ointment / Cream)</option>
										<option value="نقط">نقط (Drops)</option>
										<option value="فوار">أكياس فوار (Sachets)</option>
										<option value="مستلزمات طبية">مستلزمات طبية (Medical Supplies)</option>
									</select>
								</div>
								<div class="form-group m-0">
									<label class="form-label">رقم التسجيل بهيئة الدواء (EDA)</label>
									<input type="text" name="eda_reg_number" class="form-input tabular-nums" placeholder="EDA-10293" />
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">فئة المنتج (Category) *</label>
									<select name="category_id" required class="form-select font-bold">
										<option value="" disabled selected>-- اختر فئة المنتج من الدليل --</option>
										for _, cat := range categories {
											<option value={ fmt.Sprintf("%d", cat.ID) }>
												{ getCategoryDisplayLabel(cat, categories) }
											</option>
										}
									</select>
								</div>
								<div class="form-group m-0">
									<label class="form-label">الشركة المصنعة من الدليل المعتمد (Brand)</label>
									<select name="brand_id" class="form-select">
										<option value="">-- اختر من الشركات المصنعة المعتمدة --</option>
										for _, b := range brands {
											<option value={ fmt.Sprintf("%d", b.ID) }>
												{ b.Name.Get("ar") }
												if b.Name.Get("en") != "" {
													({ b.Name.Get("en") })
												}
											</option>
										}
									</select>
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">أو كتابة اسم الشركة المصنعة يدوياً</label>
									<input type="text" name="manufacturer" class="form-input" placeholder="Eva Pharma" />
								</div>
								<div class="form-group m-0">
									<label class="form-label">صورة الصنف (رفع ملف)</label>
									<input type="file" name="product_image" accept=".png,.jpg,.jpeg,.webp" class="form-input" />
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">أو رابط الصورة (URL)</label>
									<input type="text" name="image_url" class="form-input" dir="ltr" placeholder="https://..." />
								</div>
								<div class="form-group m-0">
									<label class="form-label">الوصف ودواعي الاستعمال (عربي)</label>
									<textarea name="description_ar" rows="2" class="form-input" placeholder="دواعي الاستعمال والجرعات المقترحة..."></textarea>
								</div>
							</div>
						</div>

						<div class="modal-footer">
							<button type="button" onclick="document.getElementById('product-create-modal').close()" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary fw-800">
								@components.IconCheck("icon-xs")
								<span>حفظ وإدراج الصنف في الكتالوج</span>
							</button>
						</div>
					</form>
			}

			<!-- Master Product Edit Modal -->
			@components.Modal(components.ModalProps{
				ID:    "product-edit-modal",
				Title:      "دليل الأصناف الدوائية المعتمدة",
				Size:  "lg",
			}) {
				<form :action="'/admin/products/' + editData.id + '/edit'" method="POST" enctype="multipart/form-data" class="d-flex flex-col gap-4 m-0">
						<div class="modal-body d-flex flex-col gap-4">
							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">اسم الدواء / المستحضر (عربي) *</label>
									<input type="text" name="name_ar" x-model="editData.name_ar" required class="form-input" />
								</div>
								<div class="form-group m-0">
									<label class="form-label">اسم الدواء (إنجليزي) *</label>
									<input type="text" name="name_en" x-model="editData.name_en" required class="form-input" dir="ltr" />
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">الاسم العلمي (Scientific Name) *</label>
									<input type="text" name="generic_name" x-model="editData.generic_name" required class="form-input" />
								</div>
								<div class="form-group m-0">
									<label class="form-label">المادة الفعالة والتركيز *</label>
									<input type="text" name="active_ingredient" x-model="editData.active_ingredient" required class="form-input" />
								</div>
							</div>

							<div class="grid-2">
								<div class="form-group m-0">
									<label class="form-label">الشكل الصيدلي (Dosage Form) *</label>
									<select name="dosage_form" x-model="editData.dosage_form" required class="form-select">
										<option value="أقراص">أقراص (Tablets)</option>
										<option value="كبسولات">كبسولات (Capsules)</option>
										<option value="شراب">شراب (Syrup / Suspension)</option>
										<option value="حقن">أمبولات وحقن (Injections)</option>
										<option value="مرهم / كريم">مرهم / كريم (Ointment / Cream)</option>
										<option value="نقط">نقط (Drops)</option>
										<option value="فوار">أكياس فوار (Sachets)</option>
										<option value="مستلزمات طبية">مستلزمات طبية (Medical Supplies)</option>
									</select>
								</div>
								<div class="form-group m-0">
									<label class="form-label">رقم التسجيل بهيئة الدواء (EDA)</label>
									<input type="text" name="eda_reg_number" x-model="editData.eda_reg_number" class="form-input tabular-nums" />
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">فئة المنتج (Category) *</label>
									<select name="category_id" x-model="editData.category_id" required class="form-select font-bold">
										<option value="0" disabled>-- اختر فئة المنتج --</option>
										for _, cat := range categories {
											<option value={ fmt.Sprintf("%d", cat.ID) }>
												{ getCategoryDisplayLabel(cat, categories) }
											</option>
										}
									</select>
								</div>
								<div class="form-group m-0">
									<label class="form-label">الشركة المصنعة من الدليل المعتمد (Brand)</label>
									<select name="brand_id" x-model="editData.brand_id" class="form-select">
										<option value="0">-- اختر من الشركات المصنعة المعتمدة --</option>
										for _, b := range brands {
											<option value={ fmt.Sprintf("%d", b.ID) }>
												{ b.Name.Get("ar") }
												if b.Name.Get("en") != "" {
													({ b.Name.Get("en") })
												}
											</option>
										}
									</select>
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">أو تعديل اسم الشركة المصنعة يدوياً</label>
									<input type="text" name="manufacturer" x-model="editData.manufacturer" class="form-input" />
								</div>
								<div class="form-group m-0">
									<label class="form-label">تغيير الصورة</label>
									<input type="file" name="product_image" accept=".png,.jpg,.jpeg,.webp" class="form-input" />
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">أو رابط الصورة (URL)</label>
									<input type="text" name="image_url" x-model="editData.image" class="form-input" dir="ltr" />
								</div>
								<div class="form-group m-0">
									<label class="form-label">الوصف ودواعي الاستعمال (عربي)</label>
									<textarea name="description_ar" x-model="editData.description_ar" rows="2" class="form-input"></textarea>
								</div>
							</div>

							<div class="form-grid-2">
								<div class="form-group m-0">
									<label class="form-label">الوصف (إنجليزي)</label>
									<textarea name="description_en" x-model="editData.description_en" rows="2" class="form-input" dir="ltr"></textarea>
								</div>
								<div class="form-group m-0">
									<label class="form-label">حالة الصنف</label>
									<select name="status" x-model="editData.status" class="form-select">
										<option value="active">نشط ومعتمد (Active)</option>
										<option value="inactive">موقوف (Inactive)</option>
									</select>
								</div>
							</div>
						</div>

						<div class="modal-footer">
							<button type="button" onclick="document.getElementById('product-edit-modal').close()" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-primary fw-800">
								@components.IconCheck("icon-xs")
								<span>حفظ التعديلات وتحديث الصنف</span>
							</button>
						</div>
					</form>
			}

		</div>
	}
}
