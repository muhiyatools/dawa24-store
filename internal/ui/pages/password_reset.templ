package pages

import (
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ PasswordReset(errorMsg, successMsg, email, lang, dir string) {
	@layouts.Base(i18n.T(lang, "auth.reset.title")+" | Dawa24", lang, dir) {
		<div class="auth-page-wrapper d-flex items-center justify-center min-h-screen py-12 px-4">
			<div class="auth-card glass-panel w-full max-w-md p-8 border rounded-2xl shadow-xl bg-surface">
				<div class="text-center mb-6">
					<div class="b2b-icon-box-lg mx-auto mb-3 text-brand">
						@components.IconLock("icon-lg")
					</div>
					<h1 class="text-2xl font-black text-primary m-0 mb-1">
						{ i18n.T(lang, "auth.reset.title") }
					</h1>
					<p class="text-xs text-muted m-0">
						{ i18n.T(lang, "auth.reset.desc") }
					</p>
				</div>

				if errorMsg != "" {
					<div class="alert alert-error text-xs font-semibold p-3 rounded-lg mb-4">
						{ errorMsg }
					</div>
				}
				if successMsg != "" {
					<div class="alert alert-success text-xs font-semibold p-3 rounded-lg mb-4">
						{ successMsg }
					</div>
				}

				<form action="/auth/forgot" method="POST" class="d-flex flex-col gap-4">
					<div class="form-group mb-0">
						<label class="form-label font-semibold text-xs mb-1" for="forgot-email">
							{ i18n.T(lang, "auth.login.email") }
						</label>
						<input
							type="email"
							id="forgot-email"
							name="email"
							placeholder="pharmacist@dawa24.eg"
							required
							autofocus
							value={ email }
							class="form-input tabular-nums"
						/>
					</div>

					<button type="submit" class="btn btn-primary btn-lg w-full font-bold">
						@components.IconMail("icon-xs")
						<span>{ i18n.T(lang, "auth.email.send_otp") }</span>
					</button>
				</form>

				<div class="text-center mt-6 pt-4 border-t">
					<a href="/auth/login" class="text-xs font-bold text-accent text-decoration-none d-inline-flex items-center gap-1.5">
						@components.IconArrowRight("icon-2xs")
						<span>{ i18n.T(lang, "auth.login.back_to_login") }</span>
					</a>
				</div>
			</div>
		</div>
	}
}

templ PasswordResetVerify(email, errorMsg, successMsg, lang, dir string) {
	@layouts.Base(i18n.T(lang, "auth.reset.enter_code_title")+" | Dawa24", lang, dir) {
		<div class="auth-page-wrapper d-flex items-center justify-center min-h-screen py-12 px-4">
			<div class="auth-card glass-panel w-full max-w-md p-8 border rounded-2xl shadow-xl bg-surface">
				<div class="text-center mb-6">
					<div class="b2b-icon-box-lg mx-auto mb-3 text-brand">
						@components.IconShield("icon-lg")
					</div>
					<h1 class="text-2xl font-black text-primary m-0 mb-1">
						{ i18n.T(lang, "auth.reset.enter_code_title") }
					</h1>
					<p class="text-xs text-muted m-0">
						{ i18n.T(lang, "auth.reset.enter_code_desc") }
					</p>
					if email != "" {
						<div class="badge badge-subtle font-mono text-xs mt-2 px-3 py-1">
							{ email }
						</div>
					}
				</div>

				if errorMsg != "" {
					<div class="alert alert-error text-xs font-semibold p-3 rounded-lg mb-4">
						{ errorMsg }
					</div>
				}
				if successMsg != "" {
					<div class="alert alert-success text-xs font-semibold p-3 rounded-lg mb-4">
						{ successMsg }
					</div>
				}

				<form action="/auth/forgot/verify-otp" method="POST" class="d-flex flex-col gap-4">
					<input type="hidden" name="email" value={ email } />
					<div class="form-group mb-0">
						<label class="form-label font-semibold text-xs mb-1" for="reset-otp-code">
							{ i18n.T(lang, "auth.email.enter_code") }
						</label>
						<input
							type="text"
							id="reset-otp-code"
							name="code"
							placeholder="123456"
							maxlength="6"
							required
							autofocus
							class="form-input text-center font-mono text-xl tracking-widest font-bold"
						/>
					</div>

					<button type="submit" class="btn btn-primary btn-lg w-full font-bold">
						@components.IconCheck("icon-xs")
						<span>{ i18n.T(lang, "auth.email.verify_code") }</span>
					</button>
				</form>

				<div class="flex-between items-center mt-6 pt-4 border-t text-xs">
					<form action="/auth/forgot" method="POST" class="m-0">
						<input type="hidden" name="email" value={ email } />
						<button type="submit" class="btn btn-ghost btn-sm text-xs font-semibold text-secondary">
							{ i18n.T(lang, "auth.email.resend_otp") }
						</button>
					</form>
					<a href="/auth/forgot" class="text-xs font-semibold text-accent text-decoration-none">
						{ i18n.T(lang, "auth.email.change_email") }
					</a>
				</div>
			</div>
		</div>
	}
}

templ PasswordResetConfirm(token, email, errorMsg, lang, dir string) {
	@layouts.Base(i18n.T(lang, "auth.reset.save_password")+" | Dawa24", lang, dir) {
		<div
			class="auth-page-wrapper d-flex items-center justify-center min-h-screen py-12 px-4"
			x-data="{
				newPassword: '',
				confirmPassword: '',
				showPwd: false,
				get passwordsMatch() {
					return this.newPassword && this.confirmPassword && this.newPassword === this.confirmPassword;
				}
			}"
		>
			<div class="auth-card glass-panel w-full max-w-md p-8 border rounded-2xl shadow-xl bg-surface">
				<div class="text-center mb-6">
					<div class="b2b-icon-box-lg mx-auto mb-3 text-emerald">
						@components.IconLock("icon-lg")
					</div>
					<h1 class="text-2xl font-black text-primary m-0 mb-1">
						{ i18n.T(lang, "auth.reset.save_password") }
					</h1>
					<p class="text-xs text-muted m-0">
						أدخل كلمة المرور الجديدة وتأكيدها لحسابك
					</p>
					if email != "" {
						<div class="badge badge-subtle font-mono text-xs mt-2 px-3 py-1">
							{ email }
						</div>
					}
				</div>

				if errorMsg != "" {
					<div class="alert alert-error text-xs font-semibold p-3 rounded-lg mb-4">
						{ errorMsg }
					</div>
				}

				<form action="/auth/reset" method="POST" class="d-flex flex-col gap-4">
					<input type="hidden" name="token" value={ token } />

					<div class="form-group mb-0">
						<label class="form-label font-semibold text-xs mb-1" for="new-password">
							{ i18n.T(lang, "auth.reset.new_password") }
						</label>
						<div class="pwd-input-wrap position-relative">
							<input
								:type="showPwd ? 'text' : 'password'"
								id="new-password"
								name="password"
								x-model="newPassword"
								placeholder="••••••••"
								required
								minlength="8"
								autofocus
								class="form-input w-full"
							/>
							<button
								type="button"
								class="pwd-toggle-btn position-absolute"
								style="left: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer;"
								@click="showPwd = !showPwd"
								title="إظهار / إخفاء"
							>
								@components.IconEye("icon-xs text-muted")
							</button>
						</div>
						<span class="text-2xs text-muted mt-1 d-block">8 أحرف كحد أدنى</span>
					</div>

					<div class="form-group mb-0">
						<label class="form-label font-semibold text-xs mb-1" for="confirm-password">
							{ i18n.T(lang, "auth.reset.confirm_password") }
						</label>
						<input
							:type="showPwd ? 'text' : 'password'"
							id="confirm-password"
							name="password_confirmation"
							x-model="confirmPassword"
							placeholder="••••••••"
							required
							minlength="8"
							class="form-input w-full"
							:class="{ 'border-emerald': passwordsMatch, 'border-error': confirmPassword && !passwordsMatch }"
						/>
						<template x-if="confirmPassword && !passwordsMatch">
							<span class="text-2xs text-error mt-1 d-block">كلمتا المرور غير متطابقتين</span>
						</template>
					</div>

					<button
						type="submit"
						class="btn btn-primary btn-lg w-full font-bold mt-2"
						:disabled="!passwordsMatch || newPassword.length < 8"
					>
						@components.IconCheck("icon-xs")
						<span>{ i18n.T(lang, "auth.reset.save_password") }</span>
					</button>
				</form>

				<div class="text-center mt-6 pt-4 border-t">
					<a href="/auth/login" class="text-xs font-bold text-accent text-decoration-none">
						{ i18n.T(lang, "auth.login.back_to_login") }
					</a>
				</div>
			</div>
		</div>
	}
}
