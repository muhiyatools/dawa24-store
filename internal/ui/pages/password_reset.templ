package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ PasswordReset() {
	@layouts.Base("استعادة كلمة المرور | Reset Password", "ar", "rtl") {
  <div class="stack-sm">
			<div class="card hover-lift">
    <div class="stack-sm">
					<div class="stack-xs text-sm">
						@components.IconPill("icon-lg")
					</div>
					<h1 class="page-title font-bold text-xl m-0">استعادة كلمة المرور</h1>
					<p class="text-sm text-secondary m-0">أدخل بريدك الإلكتروني المسجل وسنرسل لك رابط إعادة التعيين</p>
				</div>

				<form action="/auth/forgot" method="POST" class="stack-lg">
					<div class="form-group mb-0">
						<label class="form-label" for="email">البريد الإلكتروني المسجل</label>
						<input type="email" id="email" name="email" placeholder="pharmacist@dawa24.eg" required class="form-input" />
					</div>
					<button type="submit" class="btn btn-primary">
						@components.IconCheck("icon-xs")
						<span>إرسال رابط التعيين</span>
					</button>
				</form>

    <div class="stack-sm">
					<a href="/auth/login">العودة لتسجيل الدخول</a>
				</div>
			</div>
		</div>
	}
}

templ PasswordResetConfirm(token string) {
	@layouts.Base("تعيين كلمة المرور الجديدة | Set Password", "ar", "rtl") {
  <div class="stack-sm">
			<div class="card hover-lift">
    <div class="stack-sm">
					<h1 class="page-title font-bold text-xl m-0">تعيين كلمة المرور الجديدة</h1>
				</div>

				<form action="/auth/reset" method="POST" class="stack-lg">
					<input type="hidden" name="token" value={ token } />
					<div class="form-group mb-0">
						<label class="form-label" for="password">كلمة المرور الجديدة</label>
						<input type="password" id="password" name="password" placeholder="••••••••" required class="form-input" />
					</div>
					<button type="submit" class="btn btn-primary">
						@components.IconCheck("icon-xs")
						<span>حفظ كلمة المرور الجديدة</span>
					</button>
				</form>
			</div>
		</div>
	}
}
