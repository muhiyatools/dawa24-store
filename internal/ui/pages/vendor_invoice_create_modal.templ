package pages

import (
	"fmt"
	"time"

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// VendorInvoiceCreateModal renders the invoice issuance modal strictly for vendors/suppliers.
// In Dawa24 B2B, only suppliers (vendors) can issue invoices to pharmacies.
templ VendorInvoiceCreateModal(data InvoicesData) {
	<!-- Modal: إصدار فاتورة جديدة لطلب توريد بمبالغ ديناميكية (خاص بالموردين) -->
	@components.Modal(components.ModalProps{
		ID:    "vendor-create-invoice-modal",
		Title: "إصدار فاتورة ضريبية جديدة وربطها بطلب توريد (للموردين)",
		Size:  "lg",
	}) {
		<form action="/invoices/new" method="POST" class="d-flex flex-col gap-4 m-0">
			<div class="modal-body d-flex flex-col gap-4">
				<!-- اختيار الطلب -->
				<div class="form-group m-0">
					<label class="form-label font-bold text-xs">اختر طلب التوريد المراد فوترته <span class="text-danger">*</span></label>
					if len(data.VendorOrders) > 0 {
						<select
							id="invoice-order-select"
							name="order_id"
							class="form-select font-semibold text-xs mb-2"
							onchange="onInvoiceOrderChange(this)"
						>
							<option value="" data-amount="" data-subtotal="" data-tax="">-- اختر من الطلبيات الواردة لمستودعك --</option>
							for _, ord := range data.VendorOrders {
								<option
									value={ fmt.Sprintf("%d", ord.ID) }
									data-amount={ ord.TotalAmount.String() }
									data-subtotal={ ord.Subtotal.String() }
									data-tax={ ord.TaxAmount.String() }
								>
									طلب #{ ord.OrderNumber } - { ord.CustomerName } ({ ord.TotalAmount.String() } ج.م)
								</option>
							}
						</select>
					}
					<input
						type="text"
						id="invoice-order-number-input"
						name="order_number"
						placeholder="أو اكتب رقم الطلب مباشرة (مثال: ORD-2026-0001)..."
						class="form-control text-xs"
					/>
					<span class="text-3xs text-secondary mt-1">يتم جلب تفاصيل الأدوية والكميات والأسعار والعميل تلقائياً من الطلب المحدد.</span>
				</div>

				<!-- المبالغ المالية للفاتورة (ديناميكية وقابلة للتعديل) -->
				<div class="p-3.5 bg-slate-50 border border-slate-200/80 rounded-xl">
					<div class="flex-between items-center mb-2.5">
						<span class="font-bold text-xs text-primary d-flex items-center gap-1.5">
							@components.IconWallet("icon-2xs text-brand")
							<span>مبالغ الفاتورة (ديناميكية وقابلة للتخصيص)</span>
						</span>
						<span class="text-3xs text-muted">تُملأ تلقائياً عند اختيار الطلب مع إمكانية التعديل</span>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
						<!-- إجمالي مبلغ الفاتورة -->
						<div class="form-group m-0">
							<label class="form-label font-bold text-xs">إجمالي الفاتورة (ج.م) <span class="text-danger">*</span></label>
							<input
								type="number"
								step="0.01"
								min="0.01"
								id="invoice-total-amount"
								name="total_amount"
								placeholder="0.00"
								required
								class="form-control text-xs font-mono font-black text-brand bg-white"
							/>
						</div>

						<!-- المبلغ قبل الضريبة -->
						<div class="form-group m-0">
							<label class="form-label font-bold text-xs">المبلغ الأساسي (قبل الضريبة)</label>
							<input
								type="number"
								step="0.01"
								min="0"
								id="invoice-subtotal"
								name="subtotal"
								placeholder="0.00"
								class="form-control text-xs font-mono bg-white"
							/>
						</div>

						<!-- مبلغ الضريبة -->
						<div class="form-group m-0">
							<label class="form-label font-bold text-xs">ضريبة القيمة المضافة (VAT)</label>
							<input
								type="number"
								step="0.01"
								min="0"
								id="invoice-tax-amount"
								name="tax_amount"
								placeholder="0.00"
								class="form-control text-xs font-mono bg-white"
							/>
						</div>
					</div>

					<div id="invoice-amount-dynamic-hint" class="text-3xs text-emerald font-bold mt-2 d-none">
						<!-- JavaScript populates this dynamically -->
					</div>
				</div>

				<div class="form-grid-2">
					<!-- رقم الفاتورة (اختياري) -->
					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">رقم الفاتورة (اختياري)</label>
						<input
							type="text"
							name="invoice_number"
							placeholder="اتركه فارغاً للتوليد التلقائي (INV-YYYY-XXXXX)"
							class="form-control text-xs font-mono"
						/>
					</div>

					<!-- حالة الفاتورة -->
					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">حالة السداد *</label>
						<select name="status" class="form-select text-xs font-semibold">
							<option value="issued" selected>صادرة (بانتظار السداد)</option>
							<option value="paid">مدفوعة بالكامل (مسددة وموثقة)</option>
						</select>
					</div>
				</div>

				<div class="form-grid-2">
					<!-- تاريخ الإصدار -->
					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">تاريخ الإصدار</label>
						<input
							type="date"
							name="issue_date"
							value={ time.Now().Format("2006-01-02") }
							class="form-control text-xs"
						/>
					</div>

					<!-- تاريخ الاستحقاق -->
					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">تاريخ الاستحقاق (Due Date)</label>
						<input
							type="date"
							name="due_date"
							value={ time.Now().AddDate(0, 0, 30).Format("2006-01-02") }
							class="form-control text-xs"
						/>
					</div>
				</div>

				<!-- ملاحظات الفاتورة -->
				<div class="form-group m-0">
					<label class="form-label font-bold text-xs">ملاحظات وشروط الفاتورة</label>
					<textarea
						name="notes"
						rows="2"
						placeholder="شروط الدفع، رقم الحساب البنكي، أو أي ملاحظات أخرى تظهر في الفاتورة المطبوعة..."
						class="form-control text-xs"
					></textarea>
				</div>
			</div>

			<div class="modal-footer flex-between">
				<button type="button" onclick="document.getElementById('vendor-create-invoice-modal').close()" class="btn btn-ghost btn-sm">
					إلغاء
				</button>
				<button type="submit" class="btn btn-primary btn-sm font-bold px-5 gap-1.5 shadow-xs">
					@components.IconCheckCircle("icon-xs")
					<span>إصدار الفاتورة وحفظها</span>
				</button>
			</div>
		</form>
	}

	<script>
		function onInvoiceOrderChange(sel) {
			if (!sel) return;
			const opt = sel.options[sel.selectedIndex];
			if (!opt || !opt.value) return;
			const amount = opt.getAttribute('data-amount') || '';
			const subtotal = opt.getAttribute('data-subtotal') || '';
			const tax = opt.getAttribute('data-tax') || '';
			const totalInput = document.getElementById('invoice-total-amount');
			const subtotalInput = document.getElementById('invoice-subtotal');
			const taxInput = document.getElementById('invoice-tax-amount');
			const hint = document.getElementById('invoice-amount-dynamic-hint');
			if (totalInput && amount) totalInput.value = amount;
			if (subtotalInput && subtotal) subtotalInput.value = subtotal;
			if (taxInput && tax) taxInput.value = tax;
			if (hint && amount) {
				hint.textContent = '✓ تم ضبط المبالغ تلقائياً بقيمة الطلب المحدد (' + amount + ' ج.م) — يمكنك التعديل عليها بحرية.';
				hint.classList.remove('d-none');
			}
		}
	</script>
}
