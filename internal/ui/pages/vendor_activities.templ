package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"
	"strings"

	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func formatAuditAction(action, labelAr string) (string, string) {
	if labelAr != "" {
		return labelAr, "badge-sky"
	}
	switch strings.ToLower(action) {
	case "org.registered", "user.registered":
		return "تسجيل منشأة جديدة", "badge-emerald"
	case "user.login":
		return "تسجيل دخول", "badge-sky"
	case "offer.created", "product.created":
		return "إضافة صنف / عرض", "badge-emerald"
	case "offer.updated", "product.updated":
		return "تحديث صنف / سعر", "badge-amber"
	case "offer.deleted", "product.deleted":
		return "حذف صنف / عرض", "badge-rose"
	case "order.approved", "order.status_changed":
		return "تحديث حالة أمر توريد", "badge-indigo"
	case "invoice.created":
		return "إصدار فاتورة", "badge-sky"
	case "branch.created", "warehouse.created":
		return "إضافة فرع / مخزن", "badge-emerald"
	default:
		clean := strings.ReplaceAll(action, ".", " — ")
		clean = strings.ReplaceAll(clean, "_", " ")
		return clean, "badge-slate"
	}
}

func formatEntityType(entityType, entityTypeAr string) string {
	if entityTypeAr != "" {
		return entityTypeAr
	}
	switch strings.ToLower(entityType) {
	case "organization", "org":
		return "المنشأة"
	case "user":
		return "موظف / مستخدم"
	case "offer", "variant":
		return "عرض توريد"
	case "product":
		return "منتج دوائي"
	case "order":
		return "أمر توريد"
	case "invoice":
		return "فاتورة ضريبية"
	case "warehouse", "branch":
		return "مخزن / فرع"
	default:
		return entityType
	}
}

func formatShortID(id string) string {
	if len(id) > 12 {
		return id[:8] + "…"
	}
	return id
}

// VendorActivitiesPage renders activity history for the vendor's team.
templ VendorActivitiesPage(entries []*platformadmin.AuditEntry, lang, dir string) {
	@layouts.VendorShell("سجل نشاطات وعمليات الموظفين", "activities", lang, dir) {
		@tenantActivitiesBody(entries, "vendor", lang, dir)
	}
}

// CustomerActivitiesPage renders activity history for the pharmacy team.
templ CustomerActivitiesPage(entries []*platformadmin.AuditEntry, lang, dir string) {
	@layouts.CustomerShell("سجل نشاطات وعمليات الموظفين", "activities", lang, dir, nil) {
		@tenantActivitiesBody(entries, "customer", lang, dir)
	}
}

templ tenantActivitiesBody(entries []*platformadmin.AuditEntry, orgType string, lang, dir string) {
	<div class="page-container" x-data="{ search: '', selectedEntry: null, isDetailsOpen: false }">
		
		<!-- Header & Action Summary -->
		<div class="glass-panel p-6 mb-6 border border-slate-200/80 rounded-2xl shadow-sm">
			<div class="flex-between items-start flex-wrap gap-4">
    <div class="stack-sm">
					<div class="d-flex items-center gap-3 mb-1">
						<div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
							@components.IconClock("icon-sm")
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							if orgType == "vendor" {
								سجل نشاطات وعمليات موظفي المورّد
							} else {
								سجل نشاطات وعمليات موظفي الصيدلية
							}
						</h1>
					</div>
					<p class="text-xs text-secondary m-0 font-medium">
						تدقيق وتتبع كافة العمليات والإجراءات المنفذة بواسطة موظفي وحسابات المنشأة حصرياً لضمان الرقابة والشفافية
					</p>
				</div>

				<div class="d-flex items-center">
					<span class="badge badge-sky text-xs font-extrabold px-3.5 py-2 shadow-2xs tabular-nums">
						{ fmt.Sprintf("%d عملية مسجلة", len(entries)) }
					</span>
				</div>
			</div>

			<!-- Quick Filter Search -->
			<div class="mt-4 pt-3 border-t border-slate-100">
				<input
					type="search"
					x-model="search"
					placeholder="ابحث باسم الموظف، نوع الإجراء، أو المعرف..."
					class="form-input text-xs font-medium"
				/>
			</div>
		</div>

		if len(entries) == 0 {
			<div class="glass-panel p-8 text-center empty-state-glass border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3 text-2xl">
					@components.IconClock("icon-sm")
				</div>
				<h3 class="text-lg font-black text-primary mb-2">لا توجد نشاطات مسجلة بعد</h3>
				<p class="text-xs text-secondary max-w-md mx-auto">يتم توثيق كل عملية إضافة عروض، تعديل أسعار، إرسال طلبات، أو اعتماد فواتير هنا تلقائياً لضمان الشفافية والرقابة الداخلية على موظفي منشأتك.</p>
			</div>
		} else {
			<div class="glass-panel p-0 mb-6 overflow-hidden border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="table-container m-0 overflow-x-auto">
					<table class="data-table m-0 text-xs w-full">
						<thead>
							<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
								<th class="py-3 text-start ps-4">الموظف / المنفذ</th>
								<th class="py-3 text-start">نوع الإجراء</th>
								<th class="py-3 text-start">القسم / العنصر</th>
								<th class="py-3 text-start">المعرف</th>
								<th class="text-center py-3">عنوان IP</th>
								<th class="text-end py-3 pe-4">التاريخ والوقت</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, e := range entries {
								{{ actionLabel, badgeClass := formatAuditAction(e.Action, e.ActionLabelAr) }}
								<tr
									class="transition-colors"
									x-show={ fmt.Sprintf("search === '' || '%s'.toLowerCase().includes(search.toLowerCase()) || '%s'.toLowerCase().includes(search.toLowerCase()) || '%s'.toLowerCase().includes(search.toLowerCase())", e.ActorName, actionLabel, e.EntityID) }
								>
									<!-- Actor Info -->
									<td class="py-3 ps-4">
										<div class="d-flex items-center gap-2">
											<div class="user-avatar-badge text-xs font-black">
												if len(e.ActorName) > 0 {
													{ string([]rune(e.ActorName)[0]) }
												} else {
													م
												}
											</div>
           <div class="stack-sm">
												<div class="font-extrabold text-xs text-primary">
													if e.ActorName != "" {
														{ e.ActorName }
													} else {
														مستخدم المنشأة
													}
												</div>
												if e.ActorEmail != "" {
													<div class="text-2xs text-muted tabular-nums">
														{ e.ActorEmail }
													</div>
												}
											</div>
										</div>
									</td>

									<!-- Action -->
									<td class="py-3">
										<span class={ "badge text-xs font-bold", badgeClass }>
											{ actionLabel }
										</span>
									</td>

									<!-- Entity Type -->
									<td class="py-3">
										<span class="badge badge-slate text-xs font-bold">
											{ formatEntityType(e.EntityType, e.EntityTypeAr) }
										</span>
									</td>

									<!-- Entity ID -->
									<td class="py-3">
										if e.EntityID != "" {
											<code
												class="tabular-nums text-xs bg-surface-sunken border border-slate-200/80 px-1.5 py-0.5 rounded font-mono font-bold"
												title={ e.EntityID }
											>
												{ formatShortID(e.EntityID) }
											</code>
										} else {
											<span class="text-xs text-muted">—</span>
										}
									</td>

									<!-- IP Address -->
									<td class="text-center tabular-nums text-xs font-mono text-secondary py-3">
										if e.IPAddress != "" {
											{ e.IPAddress }
										} else {
											<span class="text-muted">داخلي</span>
										}
									</td>

									<!-- Timestamp -->
									<td class="text-end tabular-nums text-xs text-secondary font-bold py-3 pe-4">
										{ e.CreatedAt.Format("2006-01-02 03:04:05 PM") }
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>
}

