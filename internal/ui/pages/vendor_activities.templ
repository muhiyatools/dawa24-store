package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorActivitiesPage renders activity history for the vendor's team.
templ VendorActivitiesPage(lang, dir string) {
	@layouts.VendorShell("سجل نشاطات الموظفين", "activities", lang, dir) {
		<div class="card" style="margin-bottom:0;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 class="card-title" style="margin:0;">سجل نشاطات وعمليات موظفي المنشأة</h2>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.2rem;">تدقيق ومراقبة الإجراءات المنفذة بواسطة موظفي الفروع والمستودعات.</p>
				</div>
			</div>

			@components.EmptyState(components.EmptyStateProps{Title: "سجل النشاطات سليم", Message: "يتم توثيق كل عملية إنشاء عروض، تعديل أسعار، أو اعتماد شحنات هنا."})
		</div>
	}
}
