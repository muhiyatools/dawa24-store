package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminFinanceData contains aggregated financial datasets from the database.
type AdminFinanceData struct {
	ActiveTab            string // "deposits", "invoices", "payments", "wallets", "transactions", "earnings"
	Invoices             []*billing.AdminInvoiceView
	Payments             []*billing.AdminPaymentView
	Wallets              []*billing.AdminWalletView
	Transactions         []*billing.AdminWalletTransactionView
	Deposits             []*billing.AdminWalletDepositView
	TotalInvoices        int
	TotalPayments        int
	TotalWallets         int
	TotalTransactions    int
	TotalDeposits        int
	PendingDepositsCount int
	Withdrawals          []*billing.AdminWalletWithdrawalView
	TotalWithdrawals     int
	PendingWithdrawalsCount int
	TotalRevenue         money.Amount
	TotalCommission      money.Amount
	TotalPaid            money.Amount
	TotalHeld            money.Amount
	DirectCommissions    money.Amount
	OfferCommissions     money.Amount
	Query                string
	StatusFilter         string
	TypeFilter           string
	MethodFilter         string
	SelectedWalletID     int64
	Organizations        []*org.Organization
	SelectedOrgID        int64
	Page                 int
	PerPage              int
}

func getOrgLabel(o *org.Organization, lang string) string {
	prefix := ""
	if o.Type == org.TypeVendor {
		prefix = "[مورّد] "
	} else if o.Type == org.TypeCustomer {
		prefix = "[صيدلية] "
	}
	name := o.LegalName
	if name == "" && !o.TradeName.IsEmpty() {
		name = o.TradeName.Get(i18n.Lang(lang))
	}
	if name == "" {
		name = fmt.Sprintf("منشأة #%d", o.ID)
	}
	return prefix + name
}

func financePaginationQuery(tab, q, status, itemType, method string, walletID, orgID int64) url.Values {
	v := url.Values{}
	if tab != "" {
		v.Set("tab", tab)
	}
	if q != "" {
		v.Set("q", q)
	}
	if status != "" {
		v.Set("status", status)
	}
	if itemType != "" {
		v.Set("type", itemType)
	}
	if method != "" {
		v.Set("method", method)
	}
	if walletID > 0 {
		v.Set("wallet_id", strconv.FormatInt(walletID, 10))
	}
	if orgID > 0 {
		v.Set("org_id", strconv.FormatInt(orgID, 10))
	}
	return v
}

func formatFinancePaymentMethod(m string) string {
	switch strings.ToLower(strings.TrimSpace(m)) {
	case "wallet":
		return "المحفظة الإلكترونية"
	case "card", "credit_card", "visa", "mastercard":
		return "بطاقة بنكية"
	case "cash", "cod":
		return "دفع عند الاستلام"
	case "bank_transfer":
		return "تحويل بنكي"
	case "instapay":
		return "إنستاباي"
	case "vodafone_cash":
		return "فودافون كاش"
	default:
		if m == "" {
			return "غير محدد"
		}
		return m
	}
}

func calcInvoicesTotal(items []*billing.AdminInvoiceView) money.Amount {
	var totalMinor int64
	for _, it := range items {
		if it.Status != "cancelled" {
			totalMinor += it.TotalAmount.Minor()
		}
	}
	return money.FromMinor(totalMinor)
}

func countInvoicesStatus(items []*billing.AdminInvoiceView, st string) int {
	cnt := 0
	for _, it := range items {
		if string(it.Status) == st {
			cnt++
		}
	}
	return cnt
}

// AdminFinance renders the unified financial management hub.
templ AdminFinance(data AdminFinanceData, lang, dir string) {
	@layouts.AdminShell("الإدارة المالية والمحافظ والتحصيل", "finance", lang, dir) {
		<div
			class="page-container"
			x-data="{
				rejectDepositID: 0,
				rejectDepositAmount: '',
				rejectUserName: '',
				rejectWithdrawalID: 0,
				rejectWithdrawalAmount: '',
				rejectWithdrawalUserName: '',
				receiptModalURL: '',
				openRejectModal(id, amount, userName) {
					this.rejectDepositID = id;
					this.rejectDepositAmount = amount;
					this.rejectUserName = userName;
					const modal = document.getElementById('finance-reject-modal');
					if (modal && typeof modal.showModal === 'function') modal.showModal();
				},
				openRejectWithdrawalModal(id, amount, userName) {
					this.rejectWithdrawalID = id;
					this.rejectWithdrawalAmount = amount;
					this.rejectWithdrawalUserName = userName;
					const modal = document.getElementById('finance-reject-withdrawal-modal');
					if (modal && typeof modal.showModal === 'function') modal.showModal();
				},
				openReceiptModal(url) {
					this.receiptModalURL = url;
					const modal = document.getElementById('finance-receipt-modal');
					if (modal && typeof modal.showModal === 'function') modal.showModal();
				}
			}"
		>
			<!-- Header Title & Quick Export Row -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconCreditCard("icon-sm")
						</div>
      <div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">المركز المالي والمحافظ والتحصيل</h1>
							<p class="text-sm text-secondary m-0 mt-1">إدارة ومتابعة فواتير التوريد، تسويات بوابات الدفع، محافظ الصيدليات والموردين، وسجل القيود المحاسبية</p>
						</div>
					</div>

					<div class="d-flex items-center gap-2">
						<button type="button" onclick="window.print()" class="btn btn-secondary btn-sm font-bold text-xs gap-1">
							@components.IconFile("icon-xs")
							<span>طباعة تقرير</span>
						</button>
						<a href="/admin/finance?tab=wallets" class="btn btn-primary btn-sm font-bold text-xs gap-1">
							@components.IconWallet("icon-xs")
							<span>محافظ المنشآت</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Live Financial KPIs Bar -->
			<div class="dashboard-stat-grid mb-6">
				<a href="/admin/finance?tab=payments" class="stat-card-3d no-underline">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">إجمالي التحصيلات والمدفوعات</span>
						<span class="text-success">@components.IconWallet("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-primary mt-2">
						{ fmt.Sprintf("%s ج.م", data.TotalPaid.String()) }
					</div>
					<div class="text-xs text-muted mt-1">
						{ fmt.Sprintf("%d عملية دفع مسجلة", data.TotalPayments) }
					</div>
				</a>

				<a href="/admin/finance?tab=invoices" class="stat-card-3d no-underline">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">إجمالي الفواتير الصادرة</span>
						<span class="text-brand">@components.IconFile("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-primary mt-2">
						{ fmt.Sprintf("%s ج.م", data.TotalRevenue.String()) }
					</div>
					<div class="text-xs text-muted mt-1">
						{ fmt.Sprintf("%d فاتورة ضريبية", data.TotalInvoices) }
					</div>
				</a>

				<a href="/admin/finance?tab=wallets" class="stat-card-3d no-underline">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">أرصدة المحافظ المحتجزة</span>
						<span class="text-indigo">@components.IconLayers("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-primary mt-2">
						{ fmt.Sprintf("%s ج.م", data.TotalHeld.String()) }
					</div>
					<div class="text-xs text-muted mt-1">
						{ fmt.Sprintf("%d محفظة نشطة في النظام", data.TotalWallets) }
					</div>
				</a>

				<a href="/admin/finance?tab=earnings" class="stat-card-3d no-underline">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">عمولة المنصة المقدرة</span>
						<span class="text-warning">@components.IconChart("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-warning mt-2">
						{ fmt.Sprintf("%s ج.م", data.TotalCommission.String()) }
					</div>
					<div class="text-xs text-muted mt-1">
						نسبة 5% من حجم المعاملات
					</div>
				</a>
			</div>

			<!-- Unified Tabs Navigation -->
			<div class="glass-panel p-4 mb-6">
				<div class="finance-tabs-nav">
					<a href="/admin/finance?tab=deposits" class={ "finance-tab-pill", templ.KV("is-active", data.ActiveTab == "deposits" || data.ActiveTab == "") }>
						<div class="finance-tab-pill-icon">
							@components.IconCreditCard("icon-xs")
						</div>
						<span>طلبات شحن المحفظة</span>
						if data.PendingDepositsCount > 0 {
							<span class="badge badge-amber text-xs font-bold">{ fmt.Sprintf("%d معلق", data.PendingDepositsCount) }</span>
						} else {
							<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalDeposits) }</span>
						}
					</a>
					<a href="/admin/finance?tab=withdrawals" class={ "finance-tab-pill", templ.KV("is-active", data.ActiveTab == "withdrawals") }>
						<div class="finance-tab-pill-icon">
							@components.IconArrowLeft("icon-xs")
						</div>
						<span>طلبات سحب الرصيد</span>
						if data.PendingWithdrawalsCount > 0 {
							<span class="badge badge-amber text-xs font-bold">{ fmt.Sprintf("%d معلق", data.PendingWithdrawalsCount) }</span>
						} else {
							<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalWithdrawals) }</span>
						}
					</a>
					<a href="/admin/finance?tab=invoices" class={ "finance-tab-pill", templ.KV("is-active", data.ActiveTab == "invoices") }>
						<div class="finance-tab-pill-icon">
							@components.IconFile("icon-xs")
						</div>
						<span>الفواتير والمطالبات</span>
						<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalInvoices) }</span>
					</a>
					<a href="/admin/finance?tab=payments" class={ "finance-tab-pill", templ.KV("is-active", data.ActiveTab == "payments") }>
						<div class="finance-tab-pill-icon">
							@components.IconWallet("icon-xs")
						</div>
						<span>سجل المدفوعات والتحصيلات</span>
						<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalPayments) }</span>
					</a>
					<a href="/admin/finance?tab=wallets" class={ "finance-tab-pill", templ.KV("is-active", data.ActiveTab == "wallets") }>
						<div class="finance-tab-pill-icon">
							@components.IconLayers("icon-xs")
						</div>
						<span>محافظ المنشآت والأرصدة</span>
						<span class="badge badge-emerald text-xs font-bold">{ fmt.Sprintf("%d", data.TotalWallets) }</span>
					</a>
					<a href="/admin/finance?tab=transactions" class={ "finance-tab-pill", templ.KV("is-active", data.ActiveTab == "transactions") }>
						<div class="finance-tab-pill-icon">
							@components.IconActivity("icon-xs")
						</div>
						<span>سجل حركات المحافظ</span>
						<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalTransactions) }</span>
					</a>
					<a href="/admin/finance?tab=earnings" class={ "finance-tab-pill", templ.KV("is-active", data.ActiveTab == "earnings") }>
						<div class="finance-tab-pill-icon">
							@components.IconChart("icon-xs")
						</div>
						<span>تقرير الأرباح والعمولات</span>
					</a>
				</div>

    <div class="stack-sm">
					<!-- TAB 0: DEPOSIT REQUESTS REVIEW -->
					if data.ActiveTab == "deposits" || data.ActiveTab == "" {
						<div class="tab-panel active space-y-4">
							<div class="flex-between items-center flex-wrap gap-4 pb-3 border-b">
        <div class="stack-sm">
									<h2 class="text-lg font-black text-primary m-0 d-flex items-center gap-2">
										<span>@components.IconCreditCard("icon-sm")</span>
										<span>مراجعة وتدقيق طلبات شحن المحفظة</span>
									</h2>
									<p class="text-xs text-secondary mt-1 mb-0">الموافقة والاعتماد الفوري لتحويلات الصيدليات والعملاء، أو الرفض مع ذكر السبب.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" class="d-flex gap-2 items-center flex-wrap m-0">
									<input type="hidden" name="tab" value="deposits"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث بالاسم، الإيميل، الهاتف، أو المرجع..." class="form-input text-sm min-w-64"/>
									<select name="status" class="form-select text-sm w-auto">
										<option value="">كل الحالات</option>
										<option value="pending" selected?={ data.StatusFilter == "pending" }>⏳ قيد المراجعة (Pending)</option>
										<option value="approved" selected?={ data.StatusFilter == "approved" }>معتمدة ومقبولة (Approved)</option>
										<option value="rejected" selected?={ data.StatusFilter == "rejected" }>مرفوضة (Rejected)</option>
									</select>
									<select name="method" class="form-select text-sm w-auto">
										<option value="">كل وسائل الدفع</option>
										<option value="instapay" selected?={ data.MethodFilter == "instapay" }>إنستاباي InstaPay</option>
										<option value="bank_transfer" selected?={ data.MethodFilter == "bank_transfer" }>تحويل بنكي Bank</option>
										<option value="wallet" selected?={ data.MethodFilter == "wallet" }>محفظة هاتف كاش</option>
										<option value="card" selected?={ data.MethodFilter == "card" }>بطاقة دفع إلكترونية</option>
									</select>
									<select name="org_id" class="form-select text-sm w-auto">
										<option value="">كل المنشآت والشركات</option>
										for _, o := range data.Organizations {
											<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>{ getOrgLabel(o, lang) }</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary btn-sm font-bold">تصفية</button>
									if data.Query != "" || data.StatusFilter != "" || data.MethodFilter != "" || data.SelectedOrgID > 0 {
										<a href="/admin/finance?tab=deposits" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Deposits) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات إيداع مطابقة", Message: "لم يتم العثور على أي طلبات شحن محفظة تطابق معايير الفلترة المحددة."})
							} else {
								<div class="table-container m-0">
									<table class="data-table m-0">
										<thead>
											<tr>
												<th class="nowrap"># الطلب</th>
												<th>المستخدم / المنشأة</th>
												<th class="nowrap">المبلغ المودع</th>
												<th>وسيلة الدفع والرقم المرجعي</th>
												<th class="nowrap">إشعار التحويل</th>
												<th class="nowrap">تاريخ الطلب</th>
												<th>الحالة والملاحظات</th>
												<th class="col-actions nowrap min-w-40">الإجراءات والتدقيق</th>
											</tr>
										</thead>
										<tbody>
											for _, d := range data.Deposits {
												<tr class="align-middle">
													<td class="tabular-nums font-black text-accent nowrap">
														#{ fmt.Sprintf("DEP-%d", d.ID) }
													</td>
													<td>
														<div class="font-bold text-primary text-sm">{ d.UserName }</div>
														<div class="text-xs text-muted tabular-nums mt-0.5" dir="ltr">
															<span>{ d.UserEmail }</span>
															if d.UserPhone != "" {
																<span> • { d.UserPhone }</span>
															}
														</div>
														if d.OrganizationName != "" {
															<div class="mt-1">
																<span class="badge badge-sky text-xs font-bold">{ d.OrganizationName }</span>
															</div>
														}
													</td>
													<td>
														<div class="tabular-nums font-black text-success text-base nowrap">
															+ { d.Amount.String() } ج.م
														</div>
													</td>
													<td>
														<div class="d-flex flex-col gap-1">
															<span class="badge badge-purple text-xs font-black w-fit" dir="ltr">{ d.PaymentMethod }</span>
															<div class="tabular-nums text-xs font-bold text-secondary" dir="ltr">
																<span class="text-muted">المرجع:</span> { d.ReferenceNumber }
															</div>
														</div>
													</td>
													<td class="col-actions">
														if d.AttachmentURL != "" {
															<button
																type="button"
																class="btn btn-secondary btn-xs font-bold nowrap gap-1"
																@click={ fmt.Sprintf("openReceiptModal('%s')", d.AttachmentURL) }
															>
																@components.IconFile("icon-xs")
																<span>عرض الإيصال</span>
															</button>
														} else {
															<span class="text-muted text-xs">لا يوجد مرفق</span>
														}
													</td>
													<td class="tabular-nums text-xs text-muted nowrap">
														{ d.CreatedAt.Format("2006-01-02 03:04 PM") }
													</td>
													<td>
														<div class="d-flex flex-col gap-1 items-start">
															if d.Status == billing.DepositPending {
																<span class="badge badge-amber text-xs font-black">
																	<span>⏳ قيد المراجعة</span>
																</span>
															} else if d.Status == billing.DepositApproved {
																<span class="badge badge-emerald text-xs font-black">
																	<span>معتمد ومضاف</span>
																</span>
																if d.ReviewerName != "" {
																	<div class="text-xs text-muted">بواسطة: { d.ReviewerName }</div>
																}
																if d.TransactionID != nil {
																	<div class="text-xs text-muted tabular-nums">معاملة #{ fmt.Sprintf("TX-%d", *d.TransactionID) }</div>
																}
															} else if d.Status == billing.DepositRejected {
																<span class="badge badge-danger text-xs font-black">
																	<span>مرفوض</span>
																</span>
																if d.RejectionReason != "" {
																	<div class="text-xs text-danger bg-danger-subtle p-1 rounded border max-w-xs break-words">
																		<strong>السبب:</strong> { d.RejectionReason }
																	</div>
																}
																if d.ReviewerName != "" {
																	<div class="text-xs text-muted">بواسطة: { d.ReviewerName }</div>
																}
															}
															if d.UserNotes != "" {
																<div class="text-xs text-secondary bg-surface-sunken p-1 rounded border max-w-xs break-words">
																	{ d.UserNotes }
																</div>
															}
														</div>
													</td>
													<td class="col-actions nowrap">
														if d.Status == billing.DepositPending {
															<div class="table-actions">
																<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/finance/deposits/%d/approve", d.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من رغبتك في اعتماد هذا الإيداع وإضافته للرصيد الآن؟');">
																	<input type="hidden" name="_csrf" value="" x-init="if (typeof getCsrfToken === 'function') $el.value = getCsrfToken()"/>
																	<button
																		type="submit"
																		class="btn btn-success btn-xs font-bold gap-1"
																	>
																		@components.IconCheck("icon-xs")
																		<span>اعتماد</span>
																	</button>
																</form>
																<button
																	type="button"
																	class="btn btn-danger btn-xs font-bold gap-1"
																	@click={ fmt.Sprintf("openRejectModal(%d, '%s', '%s')", d.ID, d.Amount.String(), strings.ReplaceAll(d.UserName, "'", "\\'")) }
																>
																	@components.IconClose("icon-xs")
																	<span>رفض</span>
																</button>
															</div>
														} else {
															<span class="badge badge-secondary text-xs">تمت المعالجة</span>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>

								if data.TotalDeposits > 0 {
									@components.B2BPagination(components.PaginationProps{
										CurrentPage: data.Page,
										PageSize:    data.PerPage,
										TotalCount:  data.TotalDeposits,
										BaseURL:     "/admin/finance",
										QueryValues: financePaginationQuery("deposits", data.Query, data.StatusFilter, "", data.MethodFilter, data.SelectedWalletID, data.SelectedOrgID),
									})
								}
							}
						</div>
					}

					<!-- TAB 0B: WITHDRAWAL REQUESTS REVIEW -->
					if data.ActiveTab == "withdrawals" {
						<div class="tab-panel active space-y-4">
							<div class="flex-between items-center flex-wrap gap-4 pb-3 border-b">
								<div class="stack-sm">
									<h2 class="text-lg font-black text-primary m-0 d-flex items-center gap-2">
										<span>@components.IconArrowLeft("icon-sm")</span>
										<span>مراجعة وتدقيق طلبات سحب الرصيد</span>
									</h2>
									<p class="text-xs text-secondary mt-1 mb-0">الموافقة والاعتماد الفوري لسحوبات الصيدليات والموردين وخصم الرصيد، أو الرفض مع ذكر السبب.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" class="d-flex gap-2 items-center flex-wrap m-0">
									<input type="hidden" name="tab" value="withdrawals"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث بالاسم، الإيميل، الهاتف، أو الحساب..." class="form-input text-sm min-w-64"/>
									<select name="status" class="form-select text-sm w-auto">
										<option value="">كل الحالات</option>
										<option value="pending" selected?={ data.StatusFilter == "pending" }>⏳ قيد المراجعة (Pending)</option>
										<option value="approved" selected?={ data.StatusFilter == "approved" }>معتمدة ومصروفة (Approved)</option>
										<option value="rejected" selected?={ data.StatusFilter == "rejected" }>مرفوضة (Rejected)</option>
									</select>
									<select name="org_id" class="form-select text-sm w-auto">
										<option value="">كل المنشآت والشركات</option>
										for _, o := range data.Organizations {
											<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>{ getOrgLabel(o, lang) }</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary btn-sm font-bold">تصفية</button>
									if data.Query != "" || data.StatusFilter != "" || data.SelectedOrgID > 0 {
										<a href="/admin/finance?tab=withdrawals" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Withdrawals) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات سحب مطابقة", Message: "لم يتم العثور على أي طلبات سحب رصيد تطابق معايير الفلترة المحددة."})
							} else {
								<div class="table-container m-0">
									<table class="data-table m-0">
										<thead>
											<tr>
												<th class="nowrap"># الطلب</th>
												<th>المستخدم / المنشأة</th>
												<th class="nowrap">المبلغ المطلوب</th>
												<th>وسيلة وبيانات الاستلام</th>
												<th class="nowrap">تاريخ الطلب</th>
												<th>الحالة والملاحظات</th>
												<th class="col-actions nowrap min-w-40">الإجراءات والتدقيق</th>
											</tr>
										</thead>
										<tbody>
											for _, w := range data.Withdrawals {
												<tr class="align-middle">
													<td class="tabular-nums font-black text-accent nowrap">
														#{ fmt.Sprintf("WTH-%d", w.ID) }
													</td>
													<td>
														<div class="font-bold text-primary text-sm">{ w.UserName }</div>
														<div class="text-xs text-muted tabular-nums mt-0.5" dir="ltr">
															<span>{ w.UserEmail }</span>
															if w.UserPhone != "" {
																<span> • { w.UserPhone }</span>
															}
														</div>
														if w.OrganizationName != "" {
															<div class="mt-1">
																<span class="badge badge-sky text-xs font-bold">{ w.OrganizationName }</span>
															</div>
														}
													</td>
													<td>
														<div class="tabular-nums font-black text-danger text-base nowrap">
															- { w.Amount.String() } ج.م
														</div>
													</td>
													<td>
														<div class="d-flex flex-col gap-1">
															if w.PayoutMethodType != "" {
																<span class="badge badge-purple text-xs font-black w-fit">{ paymentProviderTitle(w.PayoutMethodType) }</span>
															}
															<div class="text-xs font-bold text-primary select-all">
																{ w.DestinationDetails }
															</div>
														</div>
													</td>
													<td class="tabular-nums text-xs text-muted nowrap">
														{ w.CreatedAt.Format("2006-01-02 03:04 PM") }
													</td>
													<td>
														<div class="d-flex flex-col gap-1 items-start">
															if w.Status == billing.WithdrawalPending {
																<span class="badge badge-amber text-xs font-black">
																	<span>⏳ قيد المراجعة</span>
																</span>
															} else if w.Status == billing.WithdrawalApproved {
																<span class="badge badge-emerald text-xs font-black">
																	<span>معتمد ومخصوم</span>
																</span>
																if w.ReviewerName != "" {
																	<div class="text-xs text-muted">بواسطة: { w.ReviewerName }</div>
																}
																if w.TransactionID != nil {
																	<div class="text-xs text-muted tabular-nums">معاملة #{ fmt.Sprintf("TX-%d", *w.TransactionID) }</div>
																}
															} else if w.Status == billing.WithdrawalRejected {
																<span class="badge badge-danger text-xs font-black">
																	<span>مرفوض</span>
																</span>
																if w.RejectionReason != "" {
																	<div class="text-xs text-danger bg-danger-subtle p-1 rounded border max-w-xs break-words">
																		<strong>السبب:</strong> { w.RejectionReason }
																	</div>
																}
																if w.ReviewerName != "" {
																	<div class="text-xs text-muted">بواسطة: { w.ReviewerName }</div>
																}
															}
															if w.UserNotes != "" {
																<div class="text-xs text-secondary bg-surface-sunken p-1 rounded border max-w-xs break-words">
																	{ w.UserNotes }
																</div>
															}
														</div>
													</td>
													<td class="col-actions nowrap">
														if w.Status == billing.WithdrawalPending {
															<div class="table-actions">
																<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/finance/withdrawals/%d/approve", w.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من رغبتك في اعتماد طلب السحب وخصمه من الرصيد الآن؟');">
																	<input type="hidden" name="_csrf" value="" x-init="if (typeof getCsrfToken === 'function') $el.value = getCsrfToken()"/>
																	<button
																		type="submit"
																		class="btn btn-success btn-xs font-bold gap-1"
																	>
																		@components.IconCheck("icon-xs")
																		<span>اعتماد وصرف</span>
																	</button>
																</form>
																<button
																	type="button"
																	class="btn btn-danger btn-xs font-bold gap-1"
																	@click={ fmt.Sprintf("openRejectWithdrawalModal(%d, '%s', '%s')", w.ID, w.Amount.String(), strings.ReplaceAll(w.UserName, "'", "\\'")) }
																>
																	@components.IconClose("icon-xs")
																	<span>رفض</span>
																</button>
															</div>
														} else {
															<span class="badge badge-secondary text-xs">تمت المعالجة</span>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>

								if data.TotalWithdrawals > 0 {
									@components.B2BPagination(components.PaginationProps{
										CurrentPage: data.Page,
										PageSize:    data.PerPage,
										TotalCount:  data.TotalWithdrawals,
										BaseURL:     "/admin/finance",
										QueryValues: financePaginationQuery("withdrawals", data.Query, data.StatusFilter, "", "", data.SelectedWalletID, data.SelectedOrgID),
									})
								}
							}
						</div>
					}

					<!-- TAB 1: INVOICES -->
					if data.ActiveTab == "invoices" {
						<div class="tab-panel active space-y-4">
							<div class="flex-between items-center flex-wrap gap-3 pb-3 border-b">
								<div class="stack-sm">
									<h2 class="text-lg font-black text-primary m-0 d-flex items-center gap-2">
										<span>@components.IconFile("icon-sm")</span>
										<span>الفواتير والمطالبات الضريبية</span>
									</h2>
									<p class="text-xs text-secondary mt-1 mb-0">سجل الفواتير الضريبية لأوامر التوريد والاشتراكات الصادرة في المنظومة وتدقيق عمليات التحصيل.</p>
								</div>
								<div class="d-flex items-center gap-2">
									<a href="/admin/finance?tab=invoices" class="btn btn-secondary btn-sm font-bold text-xs d-inline-flex items-center gap-1">
										@components.IconRefresh("icon-xs")
										<span>تحديث السجل</span>
									</a>
								</div>
							</div>

							<!-- Invoices Mini KPI Summary Grid -->
							<div class="finance-mini-stat-grid">
								<div class="finance-mini-stat-card">
									<div class="finance-mini-stat-label">إجمالي الفواتير المسجلة</div>
									<div class="finance-mini-stat-val text-primary">
										{ fmt.Sprintf("%d", data.TotalInvoices) }
									</div>
									<div class="text-xs text-muted mt-1">فاتورة صادرة بالنظام</div>
								</div>
								<div class="finance-mini-stat-card">
									<div class="finance-mini-stat-label">قيمة الفواتير بالصفحة</div>
									<div class="finance-mini-stat-val text-brand">
										{ fmt.Sprintf("%s ج.م", calcInvoicesTotal(data.Invoices).String()) }
									</div>
									<div class="text-xs text-muted mt-1">إجمالي المبالغ المستحقة</div>
								</div>
								<div class="finance-mini-stat-card">
									<div class="finance-mini-stat-label">الفواتير المدفوعة (بالصفحة)</div>
									<div class="finance-mini-stat-val text-success">
										{ fmt.Sprintf("%d", countInvoicesStatus(data.Invoices, "paid")) }
									</div>
									<div class="text-xs text-muted mt-1">تم سدادها بنجاح</div>
								</div>
								<div class="finance-mini-stat-card">
									<div class="finance-mini-stat-label">فواتير بانتظار التحصيل / متأخرة</div>
									<div class="finance-mini-stat-val text-warning">
										{ fmt.Sprintf("%d", countInvoicesStatus(data.Invoices, "issued") + countInvoicesStatus(data.Invoices, "overdue")) }
									</div>
									<div class="text-xs text-muted mt-1">قيد المتابعة والتحصيل</div>
								</div>
							</div>

							<!-- Quick Status Filter Pills & Search Form -->
							<div class="admin-filter-bar flex-col gap-3 items-stretch">
								<div class="flex-between items-center flex-wrap gap-2">
									<div class="finance-status-filters">
										<span class="text-xs font-bold text-muted me-1">الحالة:</span>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=invoices%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedOrgID > 0, fmt.Sprintf("&org_id=%d", data.SelectedOrgID), ""))) } class={ "finance-filter-pill", templ.KV("is-active", data.StatusFilter == "") }>
											<span>الكل</span>
											<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalInvoices) }</span>
										</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=invoices&status=paid%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedOrgID > 0, fmt.Sprintf("&org_id=%d", data.SelectedOrgID), ""))) } class={ "finance-filter-pill", templ.KV("is-active", data.StatusFilter == "paid") }>
											@components.IconCheck("icon-xxs text-emerald")
											<span>مدفوعة</span>
										</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=invoices&status=issued%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedOrgID > 0, fmt.Sprintf("&org_id=%d", data.SelectedOrgID), ""))) } class={ "finance-filter-pill", templ.KV("is-active", data.StatusFilter == "issued") }>
											@components.IconClock("icon-xxs text-sky")
											<span>صادرة (غير مدفوعة)</span>
										</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=invoices&status=overdue%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedOrgID > 0, fmt.Sprintf("&org_id=%d", data.SelectedOrgID), ""))) } class={ "finance-filter-pill", templ.KV("is-active", data.StatusFilter == "overdue") }>
											@components.IconAlertCircle("icon-xxs text-amber")
											<span>متأخرة</span>
										</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=invoices&status=draft%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedOrgID > 0, fmt.Sprintf("&org_id=%d", data.SelectedOrgID), ""))) } class={ "finance-filter-pill", templ.KV("is-active", data.StatusFilter == "draft") }>
											<span>مسودة</span>
										</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=invoices&status=cancelled%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedOrgID > 0, fmt.Sprintf("&org_id=%d", data.SelectedOrgID), ""))) } class={ "finance-filter-pill", templ.KV("is-active", data.StatusFilter == "cancelled") }>
											@components.IconX("icon-xxs text-rose")
											<span>ملغاة</span>
										</a>
									</div>
								</div>

								<!-- Search & Filter Controls -->
								<form method="GET" action="/admin/finance" class="d-flex gap-2 items-center flex-wrap m-0 pt-2 border-t">
									<input type="hidden" name="tab" value="invoices"/>
									<div class="d-flex items-center gap-2 flex-1 min-w-64">
										<input type="text" name="q" value={ data.Query } placeholder="ابحث برقم الفاتورة، أو اسم المورّد، أو الصيدلية..." class="form-input text-xs w-full"/>
									</div>
									<select name="status" class="form-select text-xs w-auto">
										<option value="">كل الحالات</option>
										<option value="paid" selected?={ data.StatusFilter == "paid" }>مدفوعة</option>
										<option value="issued" selected?={ data.StatusFilter == "issued" }>صادرة (غير مدفوعة)</option>
										<option value="draft" selected?={ data.StatusFilter == "draft" }>مسودة</option>
										<option value="overdue" selected?={ data.StatusFilter == "overdue" }>متأخرة</option>
										<option value="cancelled" selected?={ data.StatusFilter == "cancelled" }>ملغاة</option>
									</select>
									<select name="org_id" class="form-select text-xs w-auto">
										<option value="">كل المنشآت والشركات</option>
										for _, o := range data.Organizations {
											<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>{ getOrgLabel(o, lang) }</option>
										}
									</select>
									<button type="submit" class="btn btn-primary btn-sm font-bold text-xs d-inline-flex items-center gap-1">
										@components.IconSearch("icon-xs")
										<span>تصفية</span>
									</button>
									if data.Query != "" || data.StatusFilter != "" || data.SelectedOrgID > 0 {
										<a href="/admin/finance?tab=invoices" class="btn btn-ghost btn-sm font-bold text-xs text-muted d-inline-flex items-center gap-1">
											@components.IconX("icon-xxs")
											<span>إلغاء</span>
										</a>
									}
								</form>
							</div>

							if len(data.Invoices) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد فواتير مطابقة", Message: "لم يتم إصدار فواتير ضريبية أو لم يتم العثور على نتائج تطابق معايير البحث."})
							} else {
								<div class="table-container m-0">
									<table class="data-table m-0">
										<thead>
											<tr>
												<th>رقم الفاتورة</th>
												<th>المورّد (البائع)</th>
												<th>الصيدلية (المشتري)</th>
												<th>أمر التوريد</th>
												<th>المبلغ الإجمالي</th>
												<th>طريقة الدفع</th>
												<th>الحالة</th>
												<th>تاريخ الإصدار</th>
												<th class="col-actions min-w-32">الإجراءات</th>
											</tr>
										</thead>
										<tbody>
											for _, inv := range data.Invoices {
												<tr>
													<td>
														<div class="d-flex items-center gap-1.5">
															@components.IconFile("icon-xs text-brand")
															<a href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print", inv.ID)) } target="_blank" class="font-bold text-xs text-primary font-mono no-underline" title="معاينة وطباعة الفاتورة">
																{ inv.InvoiceNumber }
															</a>
														</div>
													</td>
													<td>
														<div class="font-bold text-xs text-primary">{ inv.VendorName }</div>
														<div class="text-xs text-muted font-mono mt-0.5">مورّد #{ fmt.Sprintf("%d", inv.OrganizationID) }</div>
													</td>
													<td>
														<div class="font-semibold text-xs text-primary">{ inv.CustomerName }</div>
														if inv.CustomerOrgID != nil {
															<div class="text-xs text-muted font-mono mt-0.5">صيدلية #{ fmt.Sprintf("%d", *inv.CustomerOrgID) }</div>
														}
													</td>
													<td class="tabular-nums">
														if inv.OrderNumber != "" {
															<span class="badge badge-sky text-xs font-mono font-bold">{ inv.OrderNumber }</span>
														} else {
															<span class="text-muted text-xs">-</span>
														}
													</td>
													<td class="tabular-nums font-black text-xs text-primary">
														{ fmt.Sprintf("%s ج.م", inv.TotalAmount.String()) }
													</td>
													<td>
														<span class="badge badge-secondary text-xs">{ formatFinancePaymentMethod(inv.PaymentMethod) }</span>
													</td>
													<td>
														if inv.Status == "paid" {
															<span class="badge badge-emerald text-xs font-bold d-inline-flex items-center gap-1">
																@components.IconCheck("icon-xxs")
																<span>مدفوعة</span>
															</span>
														} else if inv.Status == "issued" {
															<span class="badge badge-sky text-xs font-bold d-inline-flex items-center gap-1">
																@components.IconClock("icon-xxs")
																<span>صادرة</span>
															</span>
														} else if inv.Status == "overdue" {
															<span class="badge badge-amber text-xs font-bold d-inline-flex items-center gap-1">
																@components.IconAlertCircle("icon-xxs")
																<span>متأخرة</span>
															</span>
														} else if inv.Status == "cancelled" {
															<span class="badge badge-rose text-xs font-bold d-inline-flex items-center gap-1">
																@components.IconX("icon-xxs")
																<span>ملغاة</span>
															</span>
														} else {
															<span class="badge badge-secondary text-xs">{ string(inv.Status) }</span>
														}
													</td>
													<td class="tabular-nums text-xs text-muted whitespace-nowrap">
														{ inv.IssueDate.Format("2006-01-02") }
													</td>
													<td class="col-actions">
														<div class="table-actions">
															<a href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print", inv.ID)) } target="_blank" class="btn btn-primary btn-xs font-bold d-inline-flex items-center gap-1" title="طباعة الفاتورة أو إيصال الكاشير">
																@components.IconPrinter("icon-xxs")
																<span>طباعة</span>
															</a>
															<a href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print?autoprint=0", inv.ID)) } target="_blank" class="btn btn-secondary btn-xs font-bold d-inline-flex items-center gap-1" title="معاينة الفاتورة">
																@components.IconEye("icon-xxs")
																<span>عرض</span>
															</a>
														</div>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>

								if data.TotalInvoices > 0 {
									@components.B2BPagination(components.PaginationProps{
										CurrentPage: data.Page,
										PageSize:    data.PerPage,
										TotalCount:  data.TotalInvoices,
										BaseURL:     "/admin/finance",
										QueryValues: financePaginationQuery("invoices", data.Query, data.StatusFilter, "", "", data.SelectedWalletID, data.SelectedOrgID),
									})
								}
							}
						</div>
					}

					<!-- TAB 2: PAYMENTS -->
					if data.ActiveTab == "payments" {
						<div class="tab-panel active space-y-4">
							<div class="flex-between items-center flex-wrap gap-3 pb-3 border-b">
        <div class="stack-sm">
									<h2 class="text-lg font-black text-primary m-0">سجل المدفوعات والتحصيلات الإلكترونية</h2>
									<p class="text-xs text-secondary mt-1 mb-0">تدقيق عمليات الدفع المحصلة عبر بوابات الدفع الإلكتروني والتحويلات البنكية.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" class="d-flex gap-2 items-center flex-wrap m-0">
									<input type="hidden" name="tab" value="payments"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث برقم المعاملة أو المرجع أو الاسم..." class="form-input text-sm min-w-64"/>
									<select name="status" class="form-select text-sm w-auto">
										<option value="">كل الحالات</option>
										<option value="paid" selected?={ data.StatusFilter == "paid" }>ناجحة (مكتملة)</option>
										<option value="pending" selected?={ data.StatusFilter == "pending" }>قيد المراجعة</option>
										<option value="failed" selected?={ data.StatusFilter == "failed" }>فاشلة</option>
									</select>
									<select name="org_id" class="form-select text-sm w-auto">
										<option value="">كل المنشآت والشركات</option>
										for _, o := range data.Organizations {
											<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>{ getOrgLabel(o, lang) }</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary btn-sm font-bold">تصفية</button>
									if data.Query != "" || data.StatusFilter != "" || data.SelectedOrgID > 0 {
										<a href="/admin/finance?tab=payments" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Payments) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد عمليات دفع مسجلة", Message: "تظهر عمليات التحصيل فور إتمام العميل للدفع الإلكتروني أو تأكيد التحويل."})
							} else {
								<div class="table-container m-0">
									<table class="data-table m-0">
										<thead>
											<tr>
												<th>رقم المعاملة / المرجع</th>
												<th>أمر التوريد</th>
												<th>المستخدم والمنشأة</th>
												<th>المبلغ</th>
												<th>طريقة الدفع</th>
												<th>الحالة</th>
												<th>تاريخ وتوقيت الدفع</th>
											</tr>
										</thead>
										<tbody>
											for _, p := range data.Payments {
												<tr>
													<td class="tabular-nums">
														if p.TransactionID != "" {
															<div class="font-bold text-primary">{ p.TransactionID }</div>
														} else {
															<div class="font-bold text-primary">{ fmt.Sprintf("PAY-%d", p.ID) }</div>
														}
														if p.ReferenceNumber != "" {
															<div class="text-xs text-muted">مرجع: { p.ReferenceNumber }</div>
														}
													</td>
													<td class="tabular-nums">
														if p.OrderNumber != "" {
															<span class="badge badge-secondary">{ p.OrderNumber }</span>
														} else {
															<span class="text-muted">-</span>
														}
													</td>
													<td>
														<div class="font-bold text-primary">{ p.UserName }</div>
														if p.OrganizationName != "" {
															<div class="text-xs text-secondary">{ p.OrganizationName }</div>
														}
													</td>
													<td class="tabular-nums font-black text-success text-base">
														{ fmt.Sprintf("%s ج.م", p.Amount.String()) }
													</td>
													<td><span class="badge badge-secondary">{ p.Method }</span></td>
													<td>
														if p.Status == "paid" || p.Status == "completed" || p.Status == "success" {
															<span class="badge badge-emerald">ناجحة</span>
														} else if p.Status == "pending" {
															<span class="badge badge-amber">قيد المراجعة</span>
														} else {
															<span class="badge badge-rose">{ string(p.Status) }</span>
														}
													</td>
													<td class="tabular-nums text-xs text-muted">{ p.CreatedAt.Format("2006-01-02 03:04 PM") }</td>
												</tr>
											}
										</tbody>
									</table>
								</div>

								if data.TotalPayments > 0 {
									@components.B2BPagination(components.PaginationProps{
										CurrentPage: data.Page,
										PageSize:    data.PerPage,
										TotalCount:  data.TotalPayments,
										BaseURL:     "/admin/finance",
										QueryValues: financePaginationQuery("payments", data.Query, data.StatusFilter, "", data.MethodFilter, data.SelectedWalletID, data.SelectedOrgID),
									})
								}
							}
						</div>
					}

					<!-- TAB 3: WALLETS (محافظ المنشآت والأرصدة) -->
					if data.ActiveTab == "wallets" {
						<div class="tab-panel active space-y-4">
							<div class="flex-between items-center flex-wrap gap-3 pb-3 border-b">
        <div class="stack-sm">
									<h2 class="text-lg font-black text-primary m-0">محافظ الصيدليات والموردين والأرصدة</h2>
									<p class="text-xs text-secondary mt-1 mb-0">تدقيق وإدارة محافظ المنشآت الرقمية وإجراء الشحن والتسويات المحاسبية المباشرة.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" class="d-flex gap-2 items-center flex-wrap m-0">
									<input type="hidden" name="tab" value="wallets"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث باسم المنشأة، المالك، الهاتف، الإيميل..." class="form-input text-sm min-w-64"/>
									<select name="type" class="form-select text-sm w-auto">
										<option value="">كل المنشآت</option>
										<option value="customer" selected?={ data.TypeFilter == "customer" }>صيدليات</option>
										<option value="vendor" selected?={ data.TypeFilter == "vendor" }>موردون ومخازن</option>
									</select>
									<select name="org_id" class="form-select text-sm w-auto">
										<option value="">كل المنشآت والشركات</option>
										for _, o := range data.Organizations {
											<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>{ getOrgLabel(o, lang) }</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary btn-sm font-bold">تصفية</button>
									if data.Query != "" || data.TypeFilter != "" || data.SelectedOrgID > 0 {
										<a href="/admin/finance?tab=wallets" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Wallets) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد محافظ مطابقة", Message: "تنشأ المحافظ الرقمية تلقائياً لجميع المنشآت والمستخدمين عند التسجيل في المنصة."})
							} else {
								<div class="table-container m-0">
									<table class="data-table m-0">
										<thead>
											<tr>
												<th>رقم المحفظة</th>
												<th>المنشأة والمالك</th>
												<th>نوع النشاط</th>
												<th>الرصيد المتاح</th>
												<th>العملة</th>
												<th>إجمالي الحركات</th>
												<th>تاريخ الإنشاء</th>
												<th class="col-actions">إجراءات إدارية</th>
											</tr>
										</thead>
										<tbody>
											for _, w := range data.Wallets {
												<tr>
													<td class="tabular-nums">
														<span class="badge badge-secondary font-black font-mono">{ fmt.Sprintf("WLT-%d", w.ID) }</span>
													</td>
													<td>
														<div class="row-center-sm">
															<div class="w-9 h-9 rounded-xl bg-surface-sunken border flex-center font-black text-success text-sm shrink-0">
																if w.OrganizationName != "" {
																	{ string([]rune(w.OrganizationName)[0:1]) }
																} else {
																	{ string([]rune(w.UserName)[0:1]) }
																}
															</div>
               <div class="stack-sm">
																if w.OrganizationName != "" {
																	<div class="font-black text-primary text-base">{ w.OrganizationName }</div>
																	<div class="text-xs text-secondary">المالك: { w.UserName } • { w.UserEmail }</div>
																} else {
																	<div class="font-black text-primary text-base">{ w.UserName }</div>
																	<div class="text-xs text-secondary">{ w.UserEmail }</div>
																}
																if w.UserPhone != "" {
																	<div class="text-xs text-muted">{ w.UserPhone }</div>
																}
															</div>
														</div>
													</td>
													<td>
														if w.OrganizationType == "customer" {
															<span class="badge badge-emerald">صيدلية</span>
														} else if w.OrganizationType == "vendor" || w.OrganizationType == "supplier" {
															<span class="badge badge-indigo">مورّد معتمد</span>
														} else {
															<span class="badge badge-secondary">حساب فردي</span>
														}
													</td>
													<td class="tabular-nums font-black text-lg text-success">
														{ fmt.Sprintf("%s", w.Balance.String()) }
														<span class="text-xs font-bold text-muted mr-1">{ w.Currency }</span>
													</td>
													<td><span class="badge badge-secondary">{ w.Currency }</span></td>
													<td class="tabular-nums">
														<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=transactions&wallet_id=%d", w.ID)) } class="badge badge-sky no-underline" title="عرض سجل الحركات">
															{ fmt.Sprintf("%d حركة", w.TransactionsCount) } ↗
														</a>
													</td>
													<td class="tabular-nums text-sm text-muted">{ w.CreatedAt.Format("2006-01-02") }</td>
													<td class="col-actions">
														<div class="table-actions">
															<button type="button" onclick={ templ.JSFuncCall("openWalletAdjustModal", w.ID, w.OrganizationName, w.UserName, w.Balance.String(), w.Currency) } class="btn btn-primary btn-xs font-bold">
																<span>تعديل الرصيد</span>
															</button>
															<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=transactions&wallet_id=%d", w.ID)) } class="btn btn-secondary btn-xs font-bold" title="كشف الحساب">
																<span>كشف الحساب</span>
															</a>
														</div>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>

								if data.TotalWallets > 0 {
									@components.B2BPagination(components.PaginationProps{
										CurrentPage: data.Page,
										PageSize:    data.PerPage,
										TotalCount:  data.TotalWallets,
										BaseURL:     "/admin/finance",
										QueryValues: financePaginationQuery("wallets", data.Query, "", data.TypeFilter, "", data.SelectedWalletID, data.SelectedOrgID),
									})
								}
							}
						</div>
					}

					<!-- TAB 4: TRANSACTIONS (سجل حركات ومعاملات المحافظ) -->
					if data.ActiveTab == "transactions" {
						<div class="tab-panel active space-y-4">
							<div class="flex-between items-center flex-wrap gap-3 pb-3 border-b">
        <div class="stack-sm">
									<h2 class="text-lg font-black text-primary m-0">سجل حركات ومعاملات المحافظ التفصيلي</h2>
									<p class="text-xs text-secondary mt-1 mb-0">كشف الحركات المالية المزدوجة (إيداع، سحب، مشتريات، استرداد، تسوية).</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" class="d-flex gap-2 items-center flex-wrap m-0">
									<input type="hidden" name="tab" value="transactions"/>
									if data.SelectedWalletID > 0 {
										<input type="hidden" name="wallet_id" value={ fmt.Sprintf("%d", data.SelectedWalletID) }/>
									}
									<input type="text" name="q" value={ data.Query } placeholder="ابحث بالوصف أو المنشأة..." class="form-input text-sm min-w-64"/>
									<select name="type" class="form-select text-sm w-auto">
										<option value="">كل أنواع الحركات</option>
										<option value="deposit" selected?={ data.TypeFilter == "deposit" }>إيداع / شحن (Deposit)</option>
										<option value="withdrawal" selected?={ data.TypeFilter == "withdrawal" }>سحب رصيد (Withdrawal)</option>
										<option value="purchase" selected?={ data.TypeFilter == "purchase" }>مشتريات توريد (Purchase)</option>
										<option value="refund" selected?={ data.TypeFilter == "refund" }>استرداد أموال (Refund)</option>
										<option value="adjustment" selected?={ data.TypeFilter == "adjustment" }>تسوية إدارية (Adjustment)</option>
										<option value="bonus" selected?={ data.TypeFilter == "bonus" }>مكافأة / بونص (Bonus)</option>
										<option value="penalty" selected?={ data.TypeFilter == "penalty" }>خصم / غرامة (Penalty)</option>
									</select>
									<select name="org_id" class="form-select text-sm w-auto">
										<option value="">كل المنشآت والشركات</option>
										for _, o := range data.Organizations {
											<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>{ getOrgLabel(o, lang) }</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary btn-sm font-bold">تصفية</button>
									if data.SelectedWalletID > 0 || data.Query != "" || data.TypeFilter != "" || data.SelectedOrgID > 0 {
										<a href="/admin/finance?tab=transactions" class="btn btn-secondary btn-sm text-muted">إلغاء الفلاتر</a>
									}
								</form>
							</div>

							if data.SelectedOrgID > 0 || data.SelectedWalletID > 0 {
								<div class="d-flex items-center gap-2 flex-wrap p-2.5 bg-surface-sunken rounded-xl border">
									<span class="text-xs font-bold text-muted">الفلاتر النشطة:</span>
									if data.SelectedOrgID > 0 {
										<span class="badge badge-sky text-xs font-bold d-inline-flex items-center gap-1">
											<span>المنشأة: #{ fmt.Sprintf("%d", data.SelectedOrgID) }</span>
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=transactions%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedWalletID > 0, fmt.Sprintf("&wallet_id=%d", data.SelectedWalletID), ""))) } class="text-muted hover:text-danger">×</a>
										</span>
									}
									if data.SelectedWalletID > 0 {
										<span class="badge badge-indigo text-xs font-bold d-inline-flex items-center gap-1">
											<span>المحفظة: WLT-{ fmt.Sprintf("%d", data.SelectedWalletID) }</span>
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=transactions%s%s", ternary(data.Query != "", "&q="+url.QueryEscape(data.Query), ""), ternary(data.SelectedOrgID > 0, fmt.Sprintf("&org_id=%d", data.SelectedOrgID), ""))) } class="text-muted hover:text-danger">×</a>
										</span>
									}
									<a href="/admin/finance?tab=transactions" class="btn btn-ghost btn-xs font-bold text-muted">إلغاء الكل</a>
								</div>
							}

							if len(data.Transactions) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد معاملات مسجلة", Message: "تظهر جميع قيود الخصم والإيداع والتسويات في هذا السجل فور حدوثها."})
							} else {
								<div class="table-container m-0">
									<table class="data-table m-0">
										<thead>
											<tr>
												<th>رقم الحركة</th>
												<th>المحفظة والمنشأة</th>
												<th>نوع الحركة</th>
												<th>المبلغ</th>
												<th>الرصيد بعد الحركة</th>
												<th>المرجع والبيان</th>
												<th>التاريخ والتوقيت</th>
											</tr>
										</thead>
										<tbody>
											for _, tx := range data.Transactions {
												<tr>
													<td class="tabular-nums">
														<span class="font-black font-mono text-primary">{ fmt.Sprintf("#TX-%d", tx.ID) }</span>
													</td>
													<td>
														<div class="font-bold text-primary">
															if tx.OrganizationName != "" {
																{ tx.OrganizationName }
															} else {
																{ tx.UserName }
															}
														</div>
														<div class="text-xs text-muted font-mono d-flex items-center gap-1 mt-0.5">
															<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=transactions&wallet_id=%d", tx.WalletID)) } class="text-brand hover:underline font-bold" title="تصفية حركات هذه المحفظة">
																محفظة WLT-{ fmt.Sprintf("%d", tx.WalletID) }
															</a>
															if tx.UserEmail != "" {
																<span>• { tx.UserEmail }</span>
															}
														</div>
													</td>
													<td>
														if tx.Type == "deposit" {
															<span class="badge badge-emerald">إيداع رصيد</span>
														} else if tx.Type == "withdrawal" {
															<span class="badge badge-rose">سحب رصيد</span>
														} else if tx.Type == "purchase" {
															<span class="badge badge-amber">مشتريات توريد</span>
														} else if tx.Type == "refund" {
															<span class="badge badge-sky">استرداد</span>
														} else if tx.Type == "bonus" {
															<span class="badge badge-emerald">مكافأة / بونص</span>
														} else if tx.Type == "penalty" {
															<span class="badge badge-rose">خصم / غرامة</span>
														} else {
															<span class="badge badge-indigo">تسوية إدارية</span>
														}
													</td>
													<td class="tabular-nums text-base font-black">
														if tx.Amount.Minor() >= 0 {
															<span class="text-success">+{ tx.Amount.String() } ج.م</span>
														} else {
															<span class="text-danger">{ tx.Amount.String() } ج.م</span>
														}
													</td>
													<td class="tabular-nums font-black text-primary">
														{ fmt.Sprintf("%s ج.م", tx.BalanceAfter.String()) }
													</td>
													<td>
														<div class="text-sm text-primary max-w-xs break-words">
															if tx.Description != "" {
																{ tx.Description }
															} else {
																<span class="text-muted">-</span>
															}
														</div>
														if tx.ReferenceType != "" {
															<div class="text-xs text-muted mt-0.5">
																if tx.ReferenceType == "order" && tx.ReferenceID != nil {
																	<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders?q=%v", tx.ReferenceID)) } class="text-accent hover:underline font-bold">
																		مرجع أمر توريد #{ fmt.Sprintf("%v", tx.ReferenceID) }
																	</a>
																} else if tx.ReferenceType == "invoice" && tx.ReferenceID != nil {
																	<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=invoices&q=%v", tx.ReferenceID)) } class="text-accent hover:underline font-bold">
																		مرجع فاتورة #{ fmt.Sprintf("%v", tx.ReferenceID) }
																	</a>
																} else if tx.ReferenceType == "deposit" && tx.ReferenceID != nil {
																	<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=deposits&q=%v", tx.ReferenceID)) } class="text-accent hover:underline font-bold">
																		مرجع إيداع #{ fmt.Sprintf("%v", tx.ReferenceID) }
																	</a>
																} else if tx.ReferenceType == "withdrawal" && tx.ReferenceID != nil {
																	<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=withdrawals&q=%v", tx.ReferenceID)) } class="text-accent hover:underline font-bold">
																		مرجع سحب #{ fmt.Sprintf("%v", tx.ReferenceID) }
																	</a>
																} else {
																	<span>مرجع: { tx.ReferenceType } #{ fmt.Sprintf("%v", tx.ReferenceID) }</span>
																}
															</div>
														}
													</td>
													<td class="tabular-nums text-sm text-muted">{ tx.CreatedAt.Format("2006-01-02 03:04:05 PM") }</td>
												</tr>
											}
										</tbody>
									</table>
								</div>

								if data.TotalTransactions > 0 {
									@components.B2BPagination(components.PaginationProps{
										CurrentPage: data.Page,
										PageSize:    data.PerPage,
										TotalCount:  data.TotalTransactions,
										BaseURL:     "/admin/finance",
										QueryValues: financePaginationQuery("transactions", data.Query, "", data.TypeFilter, "", data.SelectedWalletID, data.SelectedOrgID),
									})
								}
							}
						</div>
					}

					<!-- TAB 5: EARNINGS & COMMISSIONS -->
					if data.ActiveTab == "earnings" {
						<div class="tab-panel active space-y-6">
							<div class="pb-3 border-b">
								<h2 class="text-lg font-black text-primary m-0">تقرير أرباح وعمولات المنظومة</h2>
								<p class="text-xs text-secondary mt-1 mb-0">بيان الأرباح المحققة للمنصة ونسب العمولات المحتسبة على المبيعات وأوامر التوريد المكتملة.</p>
							</div>

							<div class="d-grid grid-auto-fit-sm gap-5">
								<div class="bg-surface-sunken border rounded-2xl p-6">
									<div class="flex-between items-center">
										<span class="text-sm font-bold text-secondary">إجمالي مبيعات أوامر التوريد</span>
										@components.IconFile("icon-sm")
									</div>
									<div class="tabular-nums text-3xl font-black mt-2 text-primary">
										{ fmt.Sprintf("%s ج.م", data.TotalRevenue.String()) }
									</div>
									<div class="text-xs text-muted mt-1">
										إجمالي قيمة أوامر التوريد المسجلة في النظام
									</div>
								</div>

								<div class="bg-surface-sunken border rounded-2xl p-6">
									<div class="flex-between items-center">
										<span class="text-sm font-bold text-secondary">عمولة المنصة الإجمالية (5%)</span>
										<span class="text-success">@components.IconChart("icon-sm")</span>
									</div>
									<div class="tabular-nums text-3xl font-black text-success mt-2">
										{ fmt.Sprintf("%s ج.م", data.TotalCommission.String()) }
									</div>
									<div class="text-xs text-muted mt-1">
										نسبة المنصة من إجمالي المعاملات المالية المكتملة
									</div>
								</div>

								<div class="bg-surface-sunken border rounded-2xl p-6">
									<div class="flex-between items-center">
										<span class="text-sm font-bold text-secondary">أرصدة المحافظ المحتجزة للمستخدمين</span>
										<span class="text-indigo">@components.IconLayers("icon-sm")</span>
									</div>
									<div class="tabular-nums text-3xl font-black text-indigo mt-2">
										{ fmt.Sprintf("%s ج.م", data.TotalHeld.String()) }
									</div>
									<div class="text-xs text-muted mt-1">
										إجمالي السيولة النقدية المودعة داخل محافظ المنشآت
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- WALLET ADJUSTMENT MODAL -->
			@components.Modal(components.ModalProps{
				ID:    "walletAdjustModal",
				Title: "تعديل وشحن رصيد المحفظة",
				Size:  "md",
			}) {
				<form id="walletAdjustForm" method="POST" action="/admin/finance/wallets/0/adjust" class="d-flex flex-col gap-4 m-0 text-start">
					<input type="hidden" name="_csrf" value=""/>
					<div class="d-flex flex-col gap-3">
						<!-- Target Entity Info Banner -->
						<div class="p-3 rounded-lg bg-surface-sunken border">
							<div class="text-xs text-muted">المنشأة المستهدفة:</div>
							<div id="modalTargetName" class="font-bold text-primary text-base mt-0.5">-</div>
							<div class="text-xs text-secondary mt-0.5">
								الرصيد الحالي: <span id="modalCurrentBalance" class="font-bold text-success">0.00</span>
							</div>
						</div>

						<!-- Action Type -->
      <div class="stack-sm">
							<label class="form-label font-bold" for="modalActionType">نوع العملية المحاسبية *</label>
							<select name="action_type" id="modalActionType" class="form-select w-full" required>
								<option value="deposit">إيداع رصيد (شحن مباشر / تحويل)</option>
								<option value="withdrawal">خصم من الرصيد (سحب / تسوية مدينة)</option>
								<option value="adjustment">تسوية محاسبية يدوية (Adjustment)</option>
							</select>
						</div>

						<!-- Amount -->
      <div class="stack-sm">
							<label class="form-label font-bold" for="adjust-amount">المبلغ بالجنيه المصري (EGP) *</label>
							<input id="adjust-amount" type="number" step="0.01" min="0.01" name="amount" class="form-input w-full text-lg font-black tabular-nums" placeholder="0.00" required/>
						</div>

						<!-- Reason / Notes -->
      <div class="stack-sm">
							<label class="form-label font-bold" for="adjust-reason">سبب العملية والملاحظات المحاسبية *</label>
							<textarea id="adjust-reason" name="reason" rows="2" class="form-input w-full text-sm" placeholder="اكتب سبب الشحن أو الخصم الإداري (إيداع بنكي، تسوية فاتورة، تعويض)..." required></textarea>
						</div>
					</div>

					<div class="d-flex justify-end gap-3 mt-2">
						<button type="button" class="btn btn-secondary flex-1" data-modal-close="walletAdjustModal">إلغاء</button>
						<button type="submit" class="btn btn-primary font-bold flex-1">تأكيد وقيد المعاملة</button>
					</div>
				</form>
			}

			<script>
				function openWalletAdjustModal(walletId, orgName, userName, balance, currency) {
					var modal = document.getElementById('walletAdjustModal');
					var form = document.getElementById('walletAdjustForm');
					var targetName = document.getElementById('modalTargetName');
					var currentBal = document.getElementById('modalCurrentBalance');

					if (form) form.action = '/admin/finance/wallets/' + walletId + '/adjust';
					if (targetName) targetName.textContent = (orgName && orgName !== '') ? orgName + ' (' + userName + ')' : userName;
					if (currentBal) currentBal.textContent = balance + ' ' + currency;

					if (modal && typeof modal.showModal === 'function') modal.showModal();
				}
			</script>

			<!-- Reject Deposit Request Modal -->
			@components.Modal(components.ModalProps{
				ID:    "finance-reject-modal",
				Title: "رفض طلب شحن المحفظة",
				Size:  "sm",
			}) {
				<form :action="'/admin/finance/deposits/' + rejectDepositID + '/reject'" method="POST" class="d-flex flex-col gap-4 m-0 text-start">
					<input type="hidden" name="_csrf" value="" x-init="if (typeof getCsrfToken === 'function') $el.value = getCsrfToken()"/>
					<div class="d-flex flex-col gap-3">
						<div class="bg-danger-subtle border rounded-lg p-3 text-sm text-danger font-semibold">
							أنت على وشك رفض طلب الإيداع المقدم من <strong x-text="rejectUserName"></strong> بمبلغ <strong class="tabular-nums" x-text="rejectDepositAmount + ' ج.م'"></strong>. لن يتم شحن الرصيد.
						</div>
						<div class="form-group mb-0">
							<label class="form-label font-bold" for="rejection_reason_admin">سبب الرفض (سيظهر للمستخدم في صيدليته) *</label>
							<textarea id="rejection_reason_admin" name="rejection_reason" rows="3" class="form-input w-full" placeholder="مثال: صورة الإيصال غير واضحة / رقم المرجع لا يطابق كشف حساب البنك / لم يصل التحويل بعد..." required></textarea>
						</div>
					</div>
					<div class="d-flex justify-end gap-3 mt-2">
						<button type="button" class="btn btn-secondary" data-modal-close="finance-reject-modal">إلغاء</button>
						<button type="submit" class="btn btn-danger font-bold">
							<span>تأكيد رفض الطلب</span>
						</button>
					</div>
				</form>
			}

			<!-- Reject Withdrawal Request Modal -->
			@components.Modal(components.ModalProps{
				ID:    "finance-reject-withdrawal-modal",
				Title: "رفض طلب سحب الرصيد",
				Size:  "sm",
			}) {
				<form :action="'/admin/finance/withdrawals/' + rejectWithdrawalID + '/reject'" method="POST" class="d-flex flex-col gap-4 m-0 text-start">
					<input type="hidden" name="_csrf" value="" x-init="if (typeof getCsrfToken === 'function') $el.value = getCsrfToken()"/>
					<div class="d-flex flex-col gap-3">
						<div class="bg-danger-subtle border rounded-lg p-3 text-sm text-danger font-semibold">
							أنت على وشك رفض طلب السحب المقدم من <strong x-text="rejectWithdrawalUserName"></strong> بمبلغ <strong class="tabular-nums" x-text="rejectWithdrawalAmount + ' ج.م'"></strong>. لن يتم خصم الرصيد.
						</div>
						<div class="form-group mb-0">
							<label class="form-label font-bold" for="rejection_reason_withdrawal">سبب الرفض (سيظهر للمستخدم في حسابه) *</label>
							<textarea id="rejection_reason_withdrawal" name="rejection_reason" rows="3" class="form-input w-full" placeholder="مثال: بيانات الحساب غير صحيحة / الآيبان غير مطابق للاسم / تعذر إتمام التحويل..." required></textarea>
						</div>
					</div>
					<div class="d-flex justify-end gap-3 mt-2">
						<button type="button" class="btn btn-secondary" data-modal-close="finance-reject-withdrawal-modal">إلغاء</button>
						<button type="submit" class="btn btn-danger font-bold">
							<span>تأكيد رفض طلب السحب</span>
						</button>
					</div>
				</form>
			}

			<!-- Receipt Preview Lightbox Modal -->
			@components.Modal(components.ModalProps{
				ID:    "finance-receipt-modal",
				Title: "معاينة إشعار التحويل البنكي / الإيصال",
				Size:  "lg",
			}) {
				<div class="d-flex flex-col gap-4">
					<div class="p-4 bg-surface-sunken rounded-lg flex-center min-h-72">
						<template x-if="receiptModalURL.toLowerCase().endsWith('.pdf')">
							<iframe :src="receiptModalURL" class="w-full h-96 rounded-md border-0"></iframe>
						</template>
						<template x-if="!receiptModalURL.toLowerCase().endsWith('.pdf')">
							<img :src="receiptModalURL" alt="إشعار التحويل" class="max-w-full rounded-md shadow-md max-h-96 object-contain" />
						</template>
					</div>
					<div class="flex-between items-center">
						<a :href="receiptModalURL" target="_blank" download class="btn btn-secondary btn-xs font-bold">فتح بالحجم الكامل ↗</a>
						<button type="button" class="btn btn-secondary" data-modal-close="finance-receipt-modal">إغلاق</button>
					</div>
				</div>
			}

		</div>
	}
}

