}

// AdminPlansSubscriptionsPage renders active subscriptions.
templ AdminPlansSubscriptionsPage(lang, dir string) {
	@layouts.AdminShell("الاشتراكات وسجلات المشتركين", "finance", lang, dir) {
		<div class="card" style="margin-bottom:0;">
			<h2 class="card-title" style="margin-bottom:1.5rem;">سجل المشتركين الفعلي والترقيات</h2>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد اشتراكات نشطة", Message: "متابعة تجديدات الاشتراكات، الترقيات، وحالات الإلغاء."})
		</div>
