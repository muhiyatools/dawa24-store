package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminFinanceData contains aggregated financial datasets from the database.
type AdminFinanceData struct {
	ActiveTab            string // "deposits", "invoices", "payments", "wallets", "transactions", "earnings"
	Invoices             []*billing.AdminInvoiceView
	Payments             []*billing.AdminPaymentView
	Wallets              []*billing.AdminWalletView
	Transactions         []*billing.AdminWalletTransactionView
	Deposits             []*billing.AdminWalletDepositView
	TotalInvoices        int
	TotalPayments        int
	TotalWallets         int
	TotalTransactions    int
	TotalDeposits        int
	PendingDepositsCount int
	TotalRevenue         money.Amount
	TotalCommission      money.Amount
	TotalPaid            money.Amount
	TotalHeld            money.Amount
	DirectCommissions    money.Amount
	OfferCommissions     money.Amount
	Query                string
	StatusFilter         string
	TypeFilter           string
	MethodFilter         string
	SelectedWalletID     int64
}

// AdminFinance renders the unified financial management hub.
templ AdminFinance(data AdminFinanceData, lang, dir string) {
	@layouts.AdminShell("الإدارة المالية والمحافظ والتحصيل", "finance", lang, dir) {
		<div
			class="admin-finance-hub space-y-6"
			x-data="{
				isRejectModalOpen: false,
				rejectDepositID: 0,
				rejectDepositAmount: '',
				rejectUserName: '',
				isReceiptModalOpen: false,
				receiptModalURL: '',
				openRejectModal(id, amount, userName) {
					this.rejectDepositID = id;
					this.rejectDepositAmount = amount;
					this.rejectUserName = userName;
					this.isRejectModalOpen = true;
				},
				openReceiptModal(url) {
					this.receiptModalURL = url;
					this.isReceiptModalOpen = true;
				}
			}"
		>
			<!-- Header Title & Quick Export Row -->
			@components.PageHeader(components.PageHeaderProps{
				Title:    "المركز المالي والمحافظ والتحصيل",
				Subtitle: "إدارة ومتابعة فواتير التوريد، تسويات بوابات الدفع، محافظ الصيدليات والموردين، وسجل القيود المحاسبية",
			}) {
				<button onclick="window.print()" class="btn btn-secondary" style="font-weight:600; gap:0.4rem;">
					@components.IconFile("icon-xs")
					<span>طباعة تقرير</span>
				</button>
				<a href="/admin/finance?tab=wallets" class="btn btn-primary" style="font-weight:700; gap:0.4rem;">
					@components.IconWallet("icon-xs")
					<span>محافظ المنشآت</span>
				</a>
			}

			<!-- Live Financial KPIs Bar -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
				<a href="/admin/finance?tab=payments" style="text-decoration:none;" class="card" style="margin:0; padding:1.25rem; background:var(--surface); border:1px solid var(--border); border-top:4px solid #10b981; border-radius:14px; transition:transform 0.2s;">
					<div class="flex-between">
						<span style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">إجمالي التحصيلات والمدفوعات</span>
						<span style="color:#10b981;">@components.IconWallet("icon-sm")</span>
					</div>
					<div class="tabular-nums" style="font-size:1.5rem; font-weight:800; color:var(--text); margin-top:0.5rem;">
						{ fmt.Sprintf("%s ج.م", data.TotalPaid.String()) }
					</div>
					<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.3rem;">
						{ fmt.Sprintf("%d عملية دفع مسجلة", data.TotalPayments) }
					</div>
				</a>

				<a href="/admin/finance?tab=invoices" style="text-decoration:none;" class="card" style="margin:0; padding:1.25rem; background:var(--surface); border:1px solid var(--border); border-top:4px solid var(--primary); border-radius:14px; transition:transform 0.2s;">
					<div class="flex-between">
						<span style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">إجمالي الفواتير الصادرة</span>
						<span style="color:var(--primary);">@components.IconFile("icon-sm")</span>
					</div>
					<div class="tabular-nums" style="font-size:1.5rem; font-weight:800; color:var(--text); margin-top:0.5rem;">
						{ fmt.Sprintf("%s ج.م", data.TotalRevenue.String()) }
					</div>
					<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.3rem;">
						{ fmt.Sprintf("%d فاتورة ضريبية", data.TotalInvoices) }
					</div>
				</a>

				<a href="/admin/finance?tab=wallets" style="text-decoration:none;" class="card" style="margin:0; padding:1.25rem; background:var(--surface); border:1px solid var(--border); border-top:4px solid #6366f1; border-radius:14px; transition:transform 0.2s;">
					<div class="flex-between">
						<span style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">أرصدة المحافظ المحتجزة</span>
						<span style="color:#6366f1;">@components.IconLayers("icon-sm")</span>
					</div>
					<div class="tabular-nums" style="font-size:1.5rem; font-weight:800; color:#6366f1; margin-top:0.5rem;">
						{ fmt.Sprintf("%s ج.م", data.TotalHeld.String()) }
					</div>
					<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.3rem;">
						{ fmt.Sprintf("%d محفظة نشطة في النظام", data.TotalWallets) }
					</div>
				</a>

				<a href="/admin/finance?tab=earnings" style="text-decoration:none;" class="card" style="margin:0; padding:1.25rem; background:var(--surface); border:1px solid var(--border); border-top:4px solid #f59e0b; border-radius:14px; transition:transform 0.2s;">
					<div class="flex-between">
						<span style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">عمولة المنصة المقدرة</span>
						<span style="color:#f59e0b;">@components.IconChart("icon-sm")</span>
					</div>
					<div class="tabular-nums" style="font-size:1.5rem; font-weight:800; color:#f59e0b; margin-top:0.5rem;">
						{ fmt.Sprintf("%s ج.م", data.TotalCommission.String()) }
					</div>
					<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.3rem;">
						نسبة 5% من حجم المعاملات المكتملة
					</div>
				</a>
			</div>

			<!-- Unified Tabs Navigation -->
			<div class="card mb-0" style="border:1px solid var(--border); border-radius:18px; padding:0; overflow:hidden; box-shadow:var(--shadow-sm);">
				<div class="tab-header" style="display:flex; border-bottom:1px solid var(--border); background:var(--surface-sunken); padding:0 1rem; overflow-x:auto; gap:0.25rem;">
					<a href="/admin/finance?tab=deposits" class={ "tab-btn", templ.KV("active", data.ActiveTab == "deposits" || data.ActiveTab == "") } style="padding:1rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem; font-weight:700; color:var(--text); text-decoration:none; border-bottom:3px solid transparent; white-space:nowrap;">
						@components.IconWallet("icon-sm")
						<span>مراجعة طلبات شحن المحفظة</span>
						if data.PendingDepositsCount > 0 {
							<span class="badge badge-amber text-xs fw-800">{ fmt.Sprintf("%d قيد المراجعة", data.PendingDepositsCount) }</span>
						} else {
							<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalDeposits) }</span>
						}
					</a>
					<a href="/admin/finance?tab=invoices" class={ "tab-btn", templ.KV("active", data.ActiveTab == "invoices") } style="padding:1rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem; font-weight:700; color:var(--text); text-decoration:none; border-bottom:3px solid transparent; white-space:nowrap;">
						@components.IconFile("icon-sm")
						<span>الفواتير الضريبية والمطالبات</span>
						<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalInvoices) }</span>
					</a>
					<a href="/admin/finance?tab=payments" class={ "tab-btn", templ.KV("active", data.ActiveTab == "payments") } style="padding:1rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem; font-weight:700; color:var(--text); text-decoration:none; border-bottom:3px solid transparent; white-space:nowrap;">
						@components.IconWallet("icon-sm")
						<span>سجل المدفوعات والتحصيلات</span>
						<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalPayments) }</span>
					</a>
					<a href="/admin/finance?tab=wallets" class={ "tab-btn", templ.KV("active", data.ActiveTab == "wallets") } style="padding:1rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem; font-weight:700; color:var(--text); text-decoration:none; border-bottom:3px solid transparent; white-space:nowrap;">
						@components.IconLayers("icon-sm")
						<span>محافظ المنشآت والأرصدة</span>
						<span class="badge badge-emerald text-xs">{ fmt.Sprintf("%d", data.TotalWallets) }</span>
					</a>
					<a href="/admin/finance?tab=transactions" class={ "tab-btn", templ.KV("active", data.ActiveTab == "transactions") } style="padding:1rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem; font-weight:700; color:var(--text); text-decoration:none; border-bottom:3px solid transparent; white-space:nowrap;">
						@components.IconLayers("icon-sm")
						<span>سجل حركات ومعاملات المحافظ</span>
						<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d", data.TotalTransactions) }</span>
					</a>
					<a href="/admin/finance?tab=earnings" class={ "tab-btn", templ.KV("active", data.ActiveTab == "earnings") } style="padding:1rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem; font-weight:700; color:var(--text); text-decoration:none; border-bottom:3px solid transparent; white-space:nowrap;">
						@components.IconChart("icon-sm")
						<span>تقرير الأرباح والعمولات</span>
					</a>
				</div>

				<div class="p-card">
					<!-- ══════════════════════════════════════════
					     TAB 0: DEPOSIT REQUESTS REVIEW
					══════════════════════════════════════════ -->
					if data.ActiveTab == "deposits" || data.ActiveTab == "" {
						<div class="tab-content-pane space-y-4">
							<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
								<div>
									<h2 style="font-size:1.15rem; font-weight:800; margin:0; color:var(--text);">مراجعة وتدقيق طلبات شحن المحفظة</h2>
									<p style="font-size:0.83rem; color:var(--text-secondary); margin:0.2rem 0 0;">الموافقة والاعتماد الفوري لتحويلات الصيدليات والعملاء، أو الرفض مع ذكر السبب.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
									<input type="hidden" name="tab" value="deposits"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث برقم الإشعار، اسم العميل، الهاتف، أو المنشأة..." class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; min-width:260px; border-radius:8px;"/>
									<select name="status" class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; border-radius:8px;">
										<option value="">كل الحالات</option>
										<option value="pending" selected?={ data.StatusFilter == "pending" }>⏳ قيد المراجعة (Pending)</option>
										<option value="approved" selected?={ data.StatusFilter == "approved" }>✓ معتمدة ومقبولة (Approved)</option>
										<option value="rejected" selected?={ data.StatusFilter == "rejected" }>✕ مرفوضة (Rejected)</option>
									</select>
									<select name="method" class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; border-radius:8px;">
										<option value="">كل وسائل الدفع</option>
										<option value="instapay" selected?={ data.MethodFilter == "instapay" }>إنستاباي InstaPay</option>
										<option value="bank_transfer" selected?={ data.MethodFilter == "bank_transfer" }>تحويل بنكي Bank</option>
										<option value="wallet" selected?={ data.MethodFilter == "wallet" }>محفظة هاتف كاش</option>
										<option value="card" selected?={ data.MethodFilter == "card" }>بطاقة دفع إلكترونية</option>
									</select>
									<button type="submit" class="btn btn-secondary btn-sm">تصفية</button>
									if data.Query != "" || data.StatusFilter != "" || data.MethodFilter != "" {
										<a href="/admin/finance?tab=deposits" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Deposits) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات إيداع مطابقة", Message: "لم يتم العثور على أي طلبات شحن محفظة تطابق معايير الفلترة المحددة."})
							} else {
								<div class="table-container" style="border:1px solid var(--border); border-radius:12px; overflow:hidden;">
									<table class="b2b-table">
										<thead>
											<tr>
												<th># الطلب</th>
												<th>المستخدم / المنشأة</th>
												<th>المبلغ المودع</th>
												<th>وسيلة الدفع والرقم المرجعي</th>
												<th>إشعار التحويل / الإيصال</th>
												<th>تاريخ الطلب</th>
												<th>الحالة والملاحظات</th>
												<th class="text-end">الإجراءات والتدقيق</th>
											</tr>
										</thead>
										<tbody>
											for _, d := range data.Deposits {
												<tr>
													<td class="tabular-nums fw-700" style="color:var(--accent);">
														#{ fmt.Sprintf("DEP-%d", d.ID) }
													</td>
													<td>
														<div class="fw-800 text-primary">{ d.UserName }</div>
														<div class="text-xs text-muted tabular-nums" dir="ltr">
															<span>{ d.UserEmail }</span>
															if d.UserPhone != "" {
																<span> • { d.UserPhone }</span>
															}
														</div>
														if d.OrganizationName != "" {
															<div style="margin-top:0.25rem;">
																<span class="badge badge-sky text-xs fw-700">{ d.OrganizationName }</span>
															</div>
														}
													</td>
													<td>
														<div class="tabular-nums fw-900 text-base text-emerald" style="white-space:nowrap;">
															+ { d.Amount.String() } ج.م
														</div>
													</td>
													<td>
														<span class="badge badge-purple text-xs fw-800" dir="ltr">{ d.PaymentMethod }</span>
														<div class="tabular-nums text-xs mt-1" style="font-weight:700;" dir="ltr">
															<span class="text-muted">المرجع:</span> { d.ReferenceNumber }
														</div>
													</td>
													<td>
														if d.AttachmentURL != "" {
															<button
																type="button"
																class="btn btn-secondary btn-xs fw-700"
																style="gap:0.3rem;"
																@click={ fmt.Sprintf("openReceiptModal('%s')", d.AttachmentURL) }
															>
																@components.IconFile("icon-xs")
																<span>عرض الإيصال 📎</span>
															</button>
														} else {
															<span class="text-muted text-xs">لا يوجد مرفق</span>
														}
													</td>
													<td class="tabular-nums text-xs text-muted">
														{ d.CreatedAt.Format("2006-01-02 15:04") }
													</td>
													<td>
														if d.Status == billing.DepositPending {
															<span class="badge badge-amber text-xs fw-800">⏳ قيد المراجعة</span>
														} else if d.Status == billing.DepositApproved {
															<span class="badge badge-emerald text-xs fw-800">✓ معتمد ومضاف</span>
															if d.ReviewerName != "" {
																<div class="text-xs text-muted mt-1">بواسطة: { d.ReviewerName }</div>
															}
															if d.TransactionID != nil {
																<div class="text-xs text-muted tabular-nums">معاملة #{ fmt.Sprintf("TX-%d", *d.TransactionID) }</div>
															}
														} else if d.Status == billing.DepositRejected {
															<span class="badge badge-danger text-xs fw-800">✕ مرفوض</span>
															if d.RejectionReason != "" {
																<div class="text-xs text-danger mt-1" style="max-width:200px; word-break:break-word;">
																	<strong>السبب:</strong> { d.RejectionReason }
																</div>
															}
															if d.ReviewerName != "" {
																<div class="text-xs text-muted mt-0.5">بواسطة: { d.ReviewerName }</div>
															}
														}
														if d.UserNotes != "" {
															<div class="text-xs text-secondary mt-1" style="background:var(--surface-sunken); padding:0.25rem 0.5rem; border-radius:4px; border:1px solid var(--border); max-width:200px; word-break:break-word;">
																📝 { d.UserNotes }
															</div>
														}
													</td>
													<td class="text-end">
														if d.Status == billing.DepositPending {
															<div style="display:flex; gap:0.4rem; justify-content:flex-end;">
																<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/finance/deposits/%d/approve", d.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من رغبتك في اعتماد هذا الإيداع وإضافته للرصيد الآن؟');">
																	<button type="submit" class="btn btn-primary btn-xs fw-800" style="gap:0.25rem; background:var(--emerald); border-color:var(--emerald);">
																		@components.IconCheck("icon-xs")
																		<span>اعتماد</span>
																	</button>
																</form>
																<button
																	type="button"
																	class="btn btn-danger btn-xs fw-800"
																	style="gap:0.25rem;"
																	@click={ fmt.Sprintf("openRejectModal(%d, '%s', '%s')", d.ID, d.Amount.String(), strings.ReplaceAll(d.UserName, "'", "\\'")) }
																>
																	@components.IconClose("icon-xs")
																	<span>رفض</span>
																</button>
															</div>
														} else {
															<span class="badge badge-secondary text-xs">تمت المعالجة</span>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					}

					<!-- ══════════════════════════════════════════
					     TAB 1: INVOICES
					══════════════════════════════════════════ -->
					if data.ActiveTab == "invoices" {
						<div class="tab-content-pane space-y-4">
							<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
								<div>
									<h2 style="font-size:1.15rem; font-weight:800; margin:0; color:var(--text);">الفواتير والمطالبات الضريبية</h2>
									<p style="font-size:0.83rem; color:var(--text-secondary); margin:0.2rem 0 0;">سجل الفواتير الضريبية لأوامر التوريد والاشتراكات الصادرة في المنظومة.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
									<input type="hidden" name="tab" value="invoices"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث برقم الفاتورة أو اسم المنشأة..." class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; min-width:240px; border-radius:8px;"/>
									<select name="status" class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; border-radius:8px;">
										<option value="">كل الحالات</option>
										<option value="paid" selected?={ data.StatusFilter == "paid" }>مدفوعة</option>
										<option value="issued" selected?={ data.StatusFilter == "issued" }>صادرة (غير مدفوعة)</option>
										<option value="draft" selected?={ data.StatusFilter == "draft" }>مسودة</option>
										<option value="overdue" selected?={ data.StatusFilter == "overdue" }>متأخرة</option>
										<option value="cancelled" selected?={ data.StatusFilter == "cancelled" }>ملغاة</option>
									</select>
									<button type="submit" class="btn btn-secondary btn-sm">تصفية</button>
									if data.Query != "" || data.StatusFilter != "" {
										<a href="/admin/finance?tab=invoices" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Invoices) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد فواتير مطابقة", Message: "لم يتم إصدار فواتير ضريبية أو لم يتم العثور على نتائج تطابق معايير البحث."})
							} else {
								<div class="table-container" style="border:1px solid var(--border); border-radius:12px; overflow:hidden;">
									<table class="b2b-table">
										<thead>
											<tr>
												<th>رقم الفاتورة</th>
												<th>المورّد (البائع)</th>
												<th>الصيدلية (المشتري)</th>
												<th>أمر التوريد</th>
												<th>المبلغ الإجمالي</th>
												<th>طريقة الدفع</th>
												<th>الحالة</th>
												<th>تاريخ الإصدار</th>
												<th style="text-align:center; min-width:130px;">الإجراءات</th>
											</tr>
										</thead>
										<tbody>
											for _, inv := range data.Invoices {
												<tr>
													<td class="tabular-nums">
														<a
															href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print", inv.ID)) }
															target="_blank"
															class="fw-800 text-primary"
															style="text-decoration:none;"
														>
															{ inv.InvoiceNumber }
														</a>
													</td>
													<td>
														<div class="fw-700 text-primary">{ inv.VendorName }</div>
														<div class="text-xs text-muted">مورّد #{ fmt.Sprintf("%d", inv.OrganizationID) }</div>
													</td>
													<td>
														<div style="font-weight:600; color:var(--text);">{ inv.CustomerName }</div>
														if inv.CustomerOrgID != nil {
															<div class="text-xs text-muted">صيدلية #{ fmt.Sprintf("%d", *inv.CustomerOrgID) }</div>
														}
													</td>
													<td class="tabular-nums">
														if inv.OrderNumber != "" {
															<span class="badge badge-secondary">{ inv.OrderNumber }</span>
														} else {
															<span class="text-muted">-</span>
														}
													</td>
													<td class="tabular-nums fw-800 text-primary">
														{ fmt.Sprintf("%s ج.م", inv.TotalAmount.String()) }
													</td>
													<td><span class="badge badge-secondary">{ inv.PaymentMethod }</span></td>
													<td>
														if inv.Status == "paid" {
															<span class="badge badge-emerald">مدفوعة</span>
														} else if inv.Status == "issued" {
															<span class="badge badge-sky">صادرة</span>
														} else if inv.Status == "overdue" {
															<span class="badge badge-amber">متأخرة</span>
														} else if inv.Status == "cancelled" {
															<span class="badge badge-rose">ملغاة</span>
														} else {
															<span class="badge badge-secondary">{ string(inv.Status) }</span>
														}
													</td>
													<td class="tabular-nums" style="font-size:0.82rem; color:var(--text-muted);">{ inv.IssueDate.Format("2006-01-02") }</td>
													<td style="text-align:center;">
														<div style="display:inline-flex; align-items:center; gap:0.35rem;">
															<a
																href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print", inv.ID)) }
																target="_blank"
																class="btn btn-primary btn-xs"
																style="font-weight:700; padding:0.25rem 0.55rem;"
																title="طباعة الفاتورة أو إيصال الكاشير"
															>
																<span>🖨️ طباعة</span>
															</a>
															<a
																href={ templ.SafeURL(fmt.Sprintf("/invoices/%d/print?autoprint=0", inv.ID)) }
																target="_blank"
																class="btn btn-secondary btn-xs"
																style="font-weight:700; padding:0.25rem 0.55rem;"
																title="معاينة الفاتورة"
															>
																<span>عرض</span>
															</a>
														</div>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					}

					<!-- ══════════════════════════════════════════
					     TAB 2: PAYMENTS
					══════════════════════════════════════════ -->
					if data.ActiveTab == "payments" {
						<div class="tab-content-pane space-y-4">
							<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
								<div>
									<h2 style="font-size:1.15rem; font-weight:800; margin:0; color:var(--text);">سجل المدفوعات والتحصيلات الإلكترونية</h2>
									<p style="font-size:0.83rem; color:var(--text-secondary); margin:0.2rem 0 0;">تدقيق عمليات الدفع المحصلة عبر بوابات الدفع الإلكتروني والتحويلات البنكية.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
									<input type="hidden" name="tab" value="payments"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث برقم المعاملة أو المرجع أو الاسم..." class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; min-width:240px; border-radius:8px;"/>
									<select name="status" class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; border-radius:8px;">
										<option value="">كل الحالات</option>
										<option value="paid" selected?={ data.StatusFilter == "paid" }>ناجحة (مكتملة)</option>
										<option value="pending" selected?={ data.StatusFilter == "pending" }>قيد المراجعة</option>
										<option value="failed" selected?={ data.StatusFilter == "failed" }>فاشلة</option>
									</select>
									<button type="submit" class="btn btn-secondary btn-sm">تصفية</button>
									if data.Query != "" || data.StatusFilter != "" {
										<a href="/admin/finance?tab=payments" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Payments) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد عمليات دفع مسجلة", Message: "تظهر عمليات التحصيل فور إتمام العميل للدفع الإلكتروني أو تأكيد التحويل."})
							} else {
								<div class="table-container" style="border:1px solid var(--border); border-radius:12px; overflow:hidden;">
									<table class="b2b-table">
										<thead>
											<tr>
												<th>رقم المعاملة / المرجع</th>
												<th>أمر التوريد</th>
												<th>المستخدم والمنشأة</th>
												<th>المبلغ</th>
												<th>طريقة الدفع</th>
												<th>الحالة</th>
												<th>تاريخ وتوقيت الدفع</th>
											</tr>
										</thead>
										<tbody>
											for _, p := range data.Payments {
												<tr>
													<td class="tabular-nums">
														if p.TransactionID != "" {
															<div class="fw-700 text-primary">{ p.TransactionID }</div>
														} else {
															<div class="fw-700 text-primary">{ fmt.Sprintf("PAY-%d", p.ID) }</div>
														}
														if p.ReferenceNumber != "" {
															<div class="text-xs text-muted">مرجع: { p.ReferenceNumber }</div>
														}
													</td>
													<td class="tabular-nums">
														if p.OrderNumber != "" {
															<span class="badge badge-secondary">{ p.OrderNumber }</span>
														} else {
															<span class="text-muted">-</span>
														}
													</td>
													<td>
														<div class="fw-700 text-primary">{ p.UserName }</div>
														if p.OrganizationName != "" {
															<div class="text-xs text-secondary">{ p.OrganizationName }</div>
														}
													</td>
													<td class="tabular-nums" style="font-weight:800; color:#10b981; font-size:1rem;">
														{ fmt.Sprintf("%s ج.م", p.Amount.String()) }
													</td>
													<td><span class="badge badge-secondary">{ p.Method }</span></td>
													<td>
														if p.Status == "paid" || p.Status == "completed" || p.Status == "success" {
															<span class="badge badge-emerald">ناجحة</span>
														} else if p.Status == "pending" {
															<span class="badge badge-amber">قيد المراجعة</span>
														} else {
															<span class="badge badge-rose">{ string(p.Status) }</span>
														}
													</td>
													<td class="tabular-nums" style="font-size:0.82rem; color:var(--text-muted);">{ p.CreatedAt.Format("2006-01-02 15:04") }</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					}

					<!-- ══════════════════════════════════════════
					     TAB 3: WALLETS (محافظ المنشآت والأرصدة)
					══════════════════════════════════════════ -->
					if data.ActiveTab == "wallets" {
						<div class="tab-content-pane space-y-4">
							<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
								<div>
									<h2 style="font-size:1.15rem; font-weight:800; margin:0; color:var(--text);">محافظ الصيدليات والموردين والأرصدة</h2>
									<p style="font-size:0.83rem; color:var(--text-secondary); margin:0.2rem 0 0;">تدقيق وإدارة محافظ المنشآت الرقمية وإجراء الشحن والتسويات المحاسبية المباشرة.</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
									<input type="hidden" name="tab" value="wallets"/>
									<input type="text" name="q" value={ data.Query } placeholder="ابحث باسم المنشأة، المالك، الهاتف، الإيميل..." class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; min-width:260px; border-radius:8px;"/>
									<select name="type" class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; border-radius:8px;">
										<option value="">كل المنشآت</option>
										<option value="customer" selected?={ data.TypeFilter == "customer" }>صيدليات</option>
										<option value="vendor" selected?={ data.TypeFilter == "vendor" }>موردون ومخازن</option>
									</select>
									<button type="submit" class="btn btn-secondary btn-sm">تصفية</button>
									if data.Query != "" || data.TypeFilter != "" {
										<a href="/admin/finance?tab=wallets" class="btn btn-secondary btn-sm text-muted">إلغاء</a>
									}
								</form>
							</div>

							if len(data.Wallets) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد محافظ مطابقة", Message: "تنشأ المحافظ الرقمية تلقائياً لجميع المنشآت والمستخدمين عند التسجيل في المنصة."})
							} else {
								<div class="table-container" style="border:1px solid var(--border); border-radius:12px; overflow:hidden;">
									<table class="b2b-table">
										<thead>
											<tr>
												<th>رقم المحفظة</th>
												<th>المنشأة والمالك</th>
												<th>نوع النشاط</th>
												<th>الرصيد المتاح</th>
												<th>العملة</th>
												<th>إجمالي الحركات</th>
												<th>تاريخ الإنشاء</th>
												<th class="text-center">إجراءات إدارية</th>
											</tr>
										</thead>
										<tbody>
											for _, w := range data.Wallets {
												<tr>
													<td class="tabular-nums">
														<span class="badge badge-secondary" style="font-weight:800; font-family:monospace;">{ fmt.Sprintf("WLT-%d", w.ID) }</span>
													</td>
													<td>
														<div class="row-center-sm">
															<div style="width:36px; height:36px; border-radius:10px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.2); display:flex; align-items:center; justify-content:center; font-weight:800; color:#10b981; flex-shrink:0;">
																if w.OrganizationName != "" {
																	{ string([]rune(w.OrganizationName)[0:1]) }
																} else {
																	{ string([]rune(w.UserName)[0:1]) }
																}
															</div>
															<div>
																if w.OrganizationName != "" {
																	<div class="fw-800 text-primary text-base">{ w.OrganizationName }</div>
																	<div style="font-size:0.76rem; color:var(--text-secondary);">المالك: { w.UserName } • { w.UserEmail }</div>
																} else {
																	<div class="fw-800 text-primary text-base">{ w.UserName }</div>
																	<div style="font-size:0.76rem; color:var(--text-secondary);">{ w.UserEmail }</div>
																}
																if w.UserPhone != "" {
																	<div style="font-size:0.72rem; color:var(--text-muted);">{ w.UserPhone }</div>
																}
															</div>
														</div>
													</td>
													<td>
														if w.OrganizationType == "customer" {
															<span class="badge badge-emerald">صيدلية</span>
														} else if w.OrganizationType == "vendor" || w.OrganizationType == "supplier" {
															<span class="badge badge-indigo">مورّد معتمد</span>
														} else {
															<span class="badge badge-secondary">حساب فردي</span>
														}
													</td>
													<td class="tabular-nums" style="font-weight:900; font-size:1.15rem; color:#10b981;">
														{ fmt.Sprintf("%s", w.Balance.String()) }
														<span style="font-size:0.75rem; font-weight:700; color:var(--text-muted); margin-right:2px;">{ w.Currency }</span>
													</td>
													<td><span class="badge badge-secondary">{ w.Currency }</span></td>
													<td class="tabular-nums">
														<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=transactions&wallet_id=%d", w.ID)) } class="badge badge-sky" style="text-decoration:none;" title="عرض سجل الحركات">
															{ fmt.Sprintf("%d حركة", w.TransactionsCount) } ↗
														</a>
													</td>
													<td class="tabular-nums text-sm text-muted">{ w.CreatedAt.Format("2006-01-02") }</td>
													<td class="text-center">
														<div style="display:inline-flex; gap:0.4rem; align-items:center;">
															<button type="button" onclick={ templ.JSFuncCall("openWalletAdjustModal", w.ID, w.OrganizationName, w.UserName, w.Balance.String(), w.Currency) } class="btn btn-primary btn-sm" style="padding:0.35rem 0.65rem; font-size:0.78rem; font-weight:700;">
																<span>تعديل الرصيد</span>
															</button>
															<a href={ templ.SafeURL(fmt.Sprintf("/admin/finance?tab=transactions&wallet_id=%d", w.ID)) } class="btn btn-secondary btn-sm" style="padding:0.35rem 0.65rem; font-size:0.78rem;" title="كشف الحساب">
																<span>كشف الحساب</span>
															</a>
														</div>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					}

					<!-- ══════════════════════════════════════════
					     TAB 4: TRANSACTIONS (سجل حركات ومعاملات المحافظ)
					══════════════════════════════════════════ -->
					if data.ActiveTab == "transactions" {
						<div class="tab-content-pane space-y-4">
							<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
								<div>
									<h2 style="font-size:1.15rem; font-weight:800; margin:0; color:var(--text);">سجل حركات ومعاملات المحافظ التفصيلي</h2>
									<p style="font-size:0.83rem; color:var(--text-secondary); margin:0.2rem 0 0;">كشف الحركات المالية المزدوجة (إيداع، سحب، مشتريات، استرداد، تسوية).</p>
								</div>
								<!-- Search & Filter Form -->
								<form method="GET" action="/admin/finance" style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
									<input type="hidden" name="tab" value="transactions"/>
									if data.SelectedWalletID > 0 {
										<input type="hidden" name="wallet_id" value={ fmt.Sprintf("%d", data.SelectedWalletID) }/>
									}
									<input type="text" name="q" value={ data.Query } placeholder="ابحث بالوصف أو المنشأة..." class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; min-width:220px; border-radius:8px;"/>
									<select name="type" class="form-input" style="padding:0.45rem 0.85rem; font-size:0.85rem; border-radius:8px;">
										<option value="">كل أنواع الحركات</option>
										<option value="deposit" selected?={ data.TypeFilter == "deposit" }>إيداع / شحن (Deposit)</option>
										<option value="withdrawal" selected?={ data.TypeFilter == "withdrawal" }>سحب رصيد (Withdrawal)</option>
										<option value="purchase" selected?={ data.TypeFilter == "purchase" }>مشتريات توريد (Purchase)</option>
										<option value="refund" selected?={ data.TypeFilter == "refund" }>استرداد أموال (Refund)</option>
										<option value="adjustment" selected?={ data.TypeFilter == "adjustment" }>تسوية إدارية (Adjustment)</option>
										<option value="bonus" selected?={ data.TypeFilter == "bonus" }>مكافأة / بونص (Bonus)</option>
										<option value="penalty" selected?={ data.TypeFilter == "penalty" }>خصم / غرامة (Penalty)</option>
									</select>
									<button type="submit" class="btn btn-secondary btn-sm">تصفية</button>
									if data.SelectedWalletID > 0 || data.Query != "" || data.TypeFilter != "" {
										<a href="/admin/finance?tab=transactions" class="btn btn-secondary btn-sm text-muted">إلغاء الفلاتر</a>
									}
								</form>
							</div>

							if data.SelectedWalletID > 0 {
								<div class="alert alert-info" style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 1.25rem; border-radius:10px; background:rgba(14,165,233,0.1); border:1px solid rgba(14,165,233,0.25); color:var(--text);">
									<div style="font-size:0.88rem; font-weight:700;">
										عرض كشف حساب المحفظة: <span class="badge badge-sky">WLT-{ fmt.Sprintf("%d", data.SelectedWalletID) }</span>
									</div>
									<a href="/admin/finance?tab=transactions" class="btn btn-secondary btn-sm text-xs">عرض كل معاملات النظام</a>
								</div>
							}

							if len(data.Transactions) == 0 {
								@components.EmptyState(components.EmptyStateProps{Title: "لا توجد معاملات مسجلة", Message: "تظهر جميع قيود الخصم والإيداع والتسويات في هذا السجل فور حدوثها."})
							} else {
								<div class="table-container" style="border:1px solid var(--border); border-radius:12px; overflow:hidden;">
									<table class="b2b-table">
										<thead>
											<tr>
												<th>رقم الحركة</th>
												<th>المحفظة والمنشأة</th>
												<th>نوع الحركة</th>
												<th>المبلغ</th>
												<th>الرصيد بعد الحركة</th>
												<th>المرجع والبيان</th>
												<th>التاريخ والتوقيت</th>
											</tr>
										</thead>
										<tbody>
											for _, tx := range data.Transactions {
												<tr>
													<td class="tabular-nums">
														<span style="font-weight:800; font-family:monospace; color:var(--text);">{ fmt.Sprintf("#TX-%d", tx.ID) }</span>
													</td>
													<td>
														<div class="fw-700 text-primary">
															if tx.OrganizationName != "" {
																{ tx.OrganizationName }
															} else {
																{ tx.UserName }
															}
														</div>
														<div style="font-size:0.75rem; color:var(--text-muted); font-family:monospace;">
															محفظة WLT-{ fmt.Sprintf("%d", tx.WalletID) } • { tx.UserEmail }
														</div>
													</td>
													<td>
														if tx.Type == "deposit" {
															<span class="badge badge-emerald">إيداع رصيد</span>
														} else if tx.Type == "withdrawal" {
															<span class="badge badge-rose">سحب رصيد</span>
														} else if tx.Type == "purchase" {
															<span class="badge badge-amber">مشتريات توريد</span>
														} else if tx.Type == "refund" {
															<span class="badge badge-sky">استرداد</span>
														} else if tx.Type == "bonus" {
															<span class="badge badge-emerald">مكافأة / بونص</span>
														} else if tx.Type == "penalty" {
															<span class="badge badge-rose">خصم / غرامة</span>
														} else {
															<span class="badge badge-indigo">تسوية إدارية</span>
														}
													</td>
													<td class="tabular-nums" style="font-size:1.05rem; font-weight:900;">
														if tx.Amount.Minor() >= 0 {
															<span style="color:#10b981;">+{ tx.Amount.String() } ج.م</span>
														} else {
															<span style="color:#f43f5e;">{ tx.Amount.String() } ج.م</span>
														}
													</td>
													<td class="tabular-nums fw-800 text-primary">
														{ fmt.Sprintf("%s ج.م", tx.BalanceAfter.String()) }
													</td>
													<td>
														<div style="font-size:0.85rem; color:var(--text); max-width:280px; word-break:break-word;">
															if tx.Description != "" {
																{ tx.Description }
															} else {
																<span class="text-muted">-</span>
															}
														</div>
														if tx.ReferenceType != "" {
															<div style="font-size:0.72rem; color:var(--text-muted);">مرجع: { tx.ReferenceType } { fmt.Sprintf("#%v", tx.ReferenceID) }</div>
														}
													</td>
													<td class="tabular-nums text-sm text-muted">{ tx.CreatedAt.Format("2006-01-02 15:04:05") }</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					}

					<!-- ══════════════════════════════════════════
					     TAB 5: EARNINGS & COMMISSIONS
					══════════════════════════════════════════ -->
					if data.ActiveTab == "earnings" {
						<div class="tab-content-pane space-y-6">
							<div>
								<h2 style="font-size:1.15rem; font-weight:800; margin:0; color:var(--text);">تقرير أرباح وعمولات المنظومة</h2>
								<p style="font-size:0.83rem; color:var(--text-secondary); margin:0.2rem 0 0;">بيان الأرباح المحققة للمنصة ونسب العمولات المحتسبة على المبيعات وأوامر التوريد المكتملة.</p>
							</div>

							<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem;">
								<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:14px; padding:1.5rem;">
									<div class="flex-between">
										<span style="font-size:0.85rem; font-weight:700; color:var(--text-secondary);">إجمالي مبيعات أوامر التوريد</span>
										@components.IconFile("icon-sm")
									</div>
									<div class="tabular-nums" style="font-size:1.8rem; font-weight:900; margin-top:0.6rem; color:var(--text);">
										{ fmt.Sprintf("%s ج.م", data.TotalRevenue.String()) }
									</div>
									<div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.4rem;">
										إجمالي قيمة أوامر التوريد المسجلة في النظام
									</div>
								</div>

								<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:14px; padding:1.5rem;">
									<div class="flex-between">
										<span style="font-size:0.85rem; font-weight:700; color:var(--text-secondary);">عمولة المنصة الإجمالية (5%)</span>
										<span style="color:#10b981;">@components.IconChart("icon-sm")</span>
									</div>
									<div class="tabular-nums" style="font-size:1.8rem; font-weight:900; color:#10b981; margin-top:0.6rem;">
										{ fmt.Sprintf("%s ج.م", data.TotalCommission.String()) }
									</div>
									<div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.4rem;">
										نسبة المنصة من إجمالي المعاملات المالية المكتملة
									</div>
								</div>

								<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:14px; padding:1.5rem;">
									<div class="flex-between">
										<span style="font-size:0.85rem; font-weight:700; color:var(--text-secondary);">أرصدة المحافظ المحتجزة للمستخدمين</span>
										<span style="color:#6366f1;">@components.IconLayers("icon-sm")</span>
									</div>
									<div class="tabular-nums" style="font-size:1.8rem; font-weight:900; color:#6366f1; margin-top:0.6rem;">
										{ fmt.Sprintf("%s ج.م", data.TotalHeld.String()) }
									</div>
									<div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.4rem;">
										إجمالي السيولة النقدية المودعة داخل محافظ المنشآت
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- ══════════════════════════════════════════
			     WALLET ADJUSTMENT MODAL
			══════════════════════════════════════════ -->
			<div id="walletAdjustModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center; padding:1rem;">
				<div class="card" style="width:100%; max-width:480px; background:var(--surface); border:1px solid var(--border); border-radius:18px; box-shadow:var(--shadow-lg); overflow:hidden; animation:scaleIn 0.2s ease;">
					<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); background:var(--surface-sunken);">
						<div class="row-center-sm">
							<span style="font-size:1.3rem;">💳</span>
							<h3 style="margin:0; font-size:1.1rem; font-weight:800; color:var(--text);">تعديل وشحن رصيد المحفظة</h3>
						</div>
						<button type="button" onclick="closeWalletAdjustModal()" class="btn btn-secondary btn-sm" style="border:none; padding:0.25rem 0.5rem;">✕</button>
					</div>
					<form id="walletAdjustForm" method="POST" action="/admin/finance/wallets/0/adjust" style="padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
						<input type="hidden" name="_csrf" value=""/>
						<!-- Target Entity Info Banner -->
						<div style="padding:0.75rem 1rem; border-radius:10px; background:var(--surface-sunken); border:1px solid var(--border);">
							<div class="text-xs text-muted">المنشأة المستهدفة:</div>
							<div id="modalTargetName" style="font-weight:800; color:var(--text); font-size:1rem; margin-top:2px;">-</div>
							<div style="font-size:0.78rem; color:var(--text-secondary); margin-top:2px;">
								الرصيد الحالي: <span id="modalCurrentBalance" style="font-weight:800; color:#10b981;">0.00</span>
							</div>
						</div>

						<!-- Action Type -->
						<div>
							<label class="form-label">نوع العملية المحاسبية *</label>
							<select name="action_type" id="modalActionType" class="form-input" style="width:100%; border-radius:8px; padding:0.6rem 0.85rem;" required>
								<option value="deposit">إيداع رصيد (شحن مباشر / تحويل)</option>
								<option value="withdrawal">➖ خصم من الرصيد (سحب / تسوية مدينة)</option>
								<option value="adjustment">⚖️ تسوية محاسبية يدوية (Adjustment)</option>
							</select>
						</div>

						<!-- Amount -->
						<div>
							<label class="form-label">المبلغ بالجنيه المصري (EGP) *</label>
							<input type="number" step="0.01" min="0.01" name="amount" class="form-input" placeholder="0.00" style="width:100%; border-radius:8px; padding:0.6rem 0.85rem; font-size:1.1rem; font-weight:800;" required/>
						</div>

						<!-- Reason / Notes -->
						<div>
							<label class="form-label">سبب العملية والملاحظات المحاسبية *</label>
							<textarea name="reason" rows="2" class="form-input" placeholder="اكتب سبب الشحن أو الخصم الإداري (إيداع بنكي، تسوية فاتورة، تعويض)..." style="width:100%; border-radius:8px; padding:0.6rem 0.85rem; font-size:0.85rem;" required></textarea>
						</div>

						<div style="display:flex; gap:0.75rem; justify-content:flex-end; margin-top:0.5rem;">
							<button type="button" onclick="closeWalletAdjustModal()" class="btn btn-secondary flex-1">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="flex:1; font-weight:800;">تأكيد وقيد المعاملة</button>
						</div>
					</form>
				</div>
			</div>

			<script>
				function openWalletAdjustModal(walletId, orgName, userName, balance, currency) {
					var modal = document.getElementById('walletAdjustModal');
					var form = document.getElementById('walletAdjustForm');
					var targetName = document.getElementById('modalTargetName');
					var currentBal = document.getElementById('modalCurrentBalance');

					form.action = '/admin/finance/wallets/' + walletId + '/adjust';
					targetName.textContent = (orgName && orgName !== '') ? orgName + ' (' + userName + ')' : userName;
					currentBal.textContent = balance + ' ' + currency;

					modal.style.display = 'flex';
				}

				function closeWalletAdjustModal() {
					var modal = document.getElementById('walletAdjustModal');
					modal.style.display = 'none';
				}
			</script>

			<!-- Reject Deposit Request Modal -->
			<div
				x-show="isRejectModalOpen"
				x-cloak
				class="modal-overlay"
				@keydown.escape.window="isRejectModalOpen = false"
				style="position:fixed; inset:0; background:rgba(0,0,0,0.75); backdrop-filter:blur(4px); z-index:9999; display:flex; align-items:center; justify-content:center; padding:1rem;"
			>
				<div
					@click.outside="isRejectModalOpen = false"
					class="card"
					style="width:100%; max-width:500px; background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; box-shadow:var(--shadow-xl); padding:1.75rem; text-align:start;"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
						<div class="row-center-sm" style="color:var(--danger-text);">
							@components.IconTrash("icon-sm")
							<h3 class="text-lg fw-800 text-danger m-0">رفض طلب شحن المحفظة</h3>
						</div>
						<button type="button" @click="isRejectModalOpen = false" class="btn btn-secondary btn-icon size-7">
							@components.IconClose("icon-xs")
						</button>
					</div>
					<form :action="'/admin/finance/deposits/' + rejectDepositID + '/reject'" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
						<div style="background:var(--danger-surface); border:1px solid var(--danger-border); border-radius:var(--radius-lg); padding:0.85rem 1rem; font-size:0.85rem; color:var(--danger-text);">
							أنت على وشك رفض طلب الإيداع المقدم من <strong x-text="rejectUserName"></strong> بمبلغ <strong class="tabular-nums" x-text="rejectDepositAmount + ' ج.م'"></strong>. لن يتم شحن الرصيد.
						</div>
						<div class="form-group mb-0">
							<label class="form-label font-bold" for="rejection_reason_admin">سبب الرفض (سيظهر للمستخدم في صيدليته) *</label>
							<textarea id="rejection_reason_admin" name="rejection_reason" rows="3" class="form-input" placeholder="مثال: صورة الإيصال غير واضحة / رقم المرجع لا يطابق كشف حساب البنك / لم يصل التحويل بعد..." required></textarea>
						</div>
						<div style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:0.5rem;">
							<button type="button" @click="isRejectModalOpen = false" class="btn btn-secondary">إلغاء</button>
							<button type="submit" class="btn btn-danger fw-800">
								<span>تأكيد رفض الطلب</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Receipt Preview Lightbox Modal -->
			<div
				x-show="isReceiptModalOpen"
				x-cloak
				class="modal-overlay"
				@keydown.escape.window="isReceiptModalOpen = false"
				style="position:fixed; inset:0; background:rgba(0,0,0,0.85); backdrop-filter:blur(6px); z-index:9999; display:flex; align-items:center; justify-content:center; padding:1.5rem;"
			>
				<div
					@click.outside="isReceiptModalOpen = false"
					class="card"
					style="width:100%; max-width:760px; background:var(--surface-raised); border:1px solid var(--border); border-radius:20px; box-shadow:var(--shadow-2xl); padding:1.5rem; text-align:start;"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
						<div class="row-center-sm">
							@components.IconFile("icon-sm")
							<h3 class="text-lg fw-800 text-primary m-0">معاينة إشعار التحويل البنكي / الإيصال</h3>
						</div>
						<div class="row-center-sm" style="gap:0.5rem;">
							<a :href="receiptModalURL" target="_blank" download class="btn btn-secondary btn-xs fw-700">فتح بالحجم الكامل ↗</a>
							<button type="button" @click="isReceiptModalOpen = false" class="btn btn-secondary btn-icon size-7">
								@components.IconClose("icon-xs")
							</button>
						</div>
					</div>
					<div style="display:flex; justify-content:center; align-items:center; background:var(--surface-sunken); border-radius:var(--radius-lg); padding:1rem; min-height:280px; max-height:68vh; overflow:auto;">
						<template x-if="receiptModalURL.toLowerCase().endsWith('.pdf')">
							<iframe :src="receiptModalURL" style="width:100%; height:500px; border:none; border-radius:var(--radius-md);"></iframe>
						</template>
						<template x-if="!receiptModalURL.toLowerCase().endsWith('.pdf')">
							<img :src="receiptModalURL" alt="إشعار التحويل" style="max-width:100%; max-height:62vh; object-fit:contain; border-radius:var(--radius-md); box-shadow:var(--shadow-md);" />
						</template>
					</div>
				</div>
			</div>

		</div>
	}
}

// Backward-compatible individual template pages
templ AdminOfferOrdersPage(orders []*commerce.Order, lang, dir string) {
	@layouts.AdminShell("طلبات عروض الأسعار والمشتريات (Offer Orders)", "orders", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">طلبات العروض والمشتريات ({ fmt.Sprintf("%d", len(orders)) })</h2>
					<p class="subtitle">متابعة اعتمادات عروض الأسعار والتوريد بين الصيدليات والموردين.</p>
				</div>
			</div>

			if len(orders) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات عروض", Message: "لم يتم إنشاء طلبات عروض أسعار بعد."})
			} else {
				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>رقم الطلب</th>
								<th>المنشأة</th>
								<th>المبلغ الإجمالي</th>
								<th>الحالة</th>
								<th>التاريخ</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range orders {
								<tr>
									<td class="tabular-nums"><strong>{ o.OrderNumber }</strong></td>
									<td>
										if o.OrganizationID != nil {
											منشأة #{ fmt.Sprintf("%d", *o.OrganizationID) }
										} else {
											عميل #{ fmt.Sprintf("%d", o.CustomerID) }
										}
									</td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", o.TotalAmount.String()) }</td>
									<td><span class="badge badge-sky">{ string(o.Status) }</span></td>
									<td class="tabular-nums">{ o.CreatedAt.Format("2006-01-02") }</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/offers/%d", o.ID)) } class="btn btn-secondary btn-sm">عرض</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

templ AdminOfferOrderDetailPage(o *commerce.Order, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("طلب عروض: %s", o.OrderNumber), "orders", lang, dir) {
		<div class="card max-w-2xl mx-auto">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">طلب { o.OrderNumber }</h2>
					<p class="subtitle">حالة: { string(o.Status) } | الإجمالي: { fmt.Sprintf("%s ج.م", o.TotalAmount.String()) }</p>
				</div>
				<a href="/admin/orders?tab=offers" class="btn btn-secondary btn-sm">العودة للطلبات</a>
			</div>
		</div>
	}
}

templ AdminEarningsOrderPage(revenue, commission money.Amount, lang, dir string) {
	@AdminFinance(AdminFinanceData{ActiveTab: "earnings", TotalRevenue: revenue, TotalCommission: commission}, lang, dir)
}

templ AdminEarningsOffersPage(revenue, commission money.Amount, lang, dir string) {
	@AdminFinance(AdminFinanceData{ActiveTab: "earnings", TotalRevenue: revenue, TotalCommission: commission}, lang, dir)
}

templ AdminInvoicesPage(invoices []*billing.AdminInvoiceView, lang, dir string) {
	@AdminFinance(AdminFinanceData{ActiveTab: "invoices", Invoices: invoices}, lang, dir)
}

templ AdminPaymentsPage(payments []*billing.AdminPaymentView, lang, dir string) {
	@AdminFinance(AdminFinanceData{ActiveTab: "payments", Payments: payments}, lang, dir)
}

templ AdminWalletsPage(wallets []*billing.AdminWalletView, lang, dir string) {
	@AdminFinance(AdminFinanceData{ActiveTab: "wallets", Wallets: wallets}, lang, dir)
}

templ AdminPlansInfoPage(plans []*billing.Plan, lang, dir string) {
	@AdminPlans(lang, dir, plans)
}

templ AdminPlansSubscriptionsPage(subs []*billing.Subscription, lang, dir string) {
	@layouts.AdminShell("الاشتراكات وسجلات المشتركين", "plans", lang, dir) {
		<div class="card">
			<h2 class="card-title">الاشتراكات النشطة</h2>
			<div class="table-container">
				<table class="b2b-table">
					<thead>
						<tr>
							<th>#</th>
							<th>المستخدم</th>
							<th>الخطة</th>
							<th>الحالة</th>
							<th>تاريخ الانتهاء</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range subs {
							<tr>
								<td>{ fmt.Sprintf("%d", s.ID) }</td>
								<td>مستخدم #{ fmt.Sprintf("%d", s.UserID) }</td>
								<td>خطة #{ fmt.Sprintf("%d", s.PlanID) }</td>
								<td><span class="badge badge-emerald">{ string(s.Status) }</span></td>
								<td>{ s.ExpiresAt.Format("2006-01-02") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
