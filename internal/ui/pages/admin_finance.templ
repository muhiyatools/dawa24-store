		<div class="card" style="margin-bottom:0;">
			<h2 class="card-title" style="margin-bottom:1.5rem;">باقات وخطط الاشتراك المتوفرة</h2>
			@components.EmptyState(components.EmptyStateProps{Title: "باقات الاشتراك", Message: "تحديد باقات الصيدليات والموردين والمستودعات والخصائص المتاحة لكل باقة."})
