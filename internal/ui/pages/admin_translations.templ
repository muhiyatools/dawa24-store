package pages

import (
	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminTranslations(lang, dir string, translations []*platformadmin.Translation) {
	@layouts.AdminShell("الترجمات | Translations", "translations", lang, dir) {
		<div class="card" style="margin-bottom:1.25rem;">
			<h2 class="card-title" style="margin:0 0 1rem;">إضافة / تعديل ترجمة</h2>
			<form method="POST" action="/admin/translations" style="display:flex; flex-direction:column; gap:0.9rem;">
				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="t-key">المفتاح</label>
						<input type="text" id="t-key" name="key" required class="form-input" dir="ltr" placeholder="welcome.title" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="t-group">المجموعة</label>
						<input type="text" id="t-group" name="group" class="form-input" value="general" />
					</div>
				</div>
				<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="t-ar">النص (عربي)</label>
						<input type="text" id="t-ar" name="text_ar" class="form-input" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="t-en">النص (إنجليزي)</label>
						<input type="text" id="t-en" name="text_en" class="form-input" dir="ltr" />
					</div>
				</div>
				<button type="submit" class="btn btn-primary" style="justify-content:center;">
					@components.IconCheck("icon-sm")
					<span>حفظ الترجمة</span>
				</button>
			</form>
		</div>

		<div class="card">
			<h2 class="card-title" style="margin:0 0 0.75rem;">الترجمات الحالية</h2>
			if len(translations) == 0 {
				<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد ترجمات بعد.</p>
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead><tr><th>المفتاح</th><th>المجموعة</th><th>العربية</th><th>English</th></tr></thead>
						<tbody>
							for _, t := range translations {
								<tr>
									<td dir="ltr">{ t.Key }</td>
									<td>{ t.Group }</td>
									<td>{ t.Text.Get(i18n.AR) }</td>
									<td dir="ltr">{ t.Text.Get(i18n.EN) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
