package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// SubscriptionGateProps defines the context for a feature-gated upgrade screen.
type SubscriptionGateProps struct {
	FeatureKey   string // "feature_market_discounts" or "feature_compare_tool"
	FeatureTitle string
	FeatureDesc  string
	FeatureIcon  string
	Plans        []*billing.Plan
	Actor        authctx.Actor
}

templ SubscriptionGatePage(lang, dir string, props SubscriptionGateProps) {
	if props.Actor.IsVendor() {
		@layouts.VendorShell(props.FeatureTitle, "subscription", lang, dir) {
			@subscriptionGateContent(lang, dir, props)
		}
	} else if props.Actor.IsCustomer() {
		@layouts.CustomerShell(props.FeatureTitle, "subscription", lang, dir, props.Actor.Permissions) {
			@subscriptionGateContent(lang, dir, props)
		}
	} else {
		@layouts.PublicShell(props.FeatureTitle, lang, dir) {
			@subscriptionGateContent(lang, dir, props)
		}
	}
}

templ subscriptionGateContent(lang, dir string, props SubscriptionGateProps) {
	<div class="page-container">
		
		<!-- Hero Gating Banner -->
		<div class="glass-panel text-center p-8 mb-8">
			<div class="d-inline-flex items-center justify-center mb-4 text-brand">
				@components.IconShield("icon-md")
			</div>
			
			<div class="d-inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold mb-3 bg-rose-50 text-rose-700 border border-rose-200">
				@components.IconShield("icon-2xs")
				<span>ميزة حصرية تتطلب ترقية الباقة</span>
			</div>

			<h1 class="text-2xl md:text-3xl font-black text-primary mb-3">
				{ props.FeatureTitle }
			</h1>
			
			<p class="text-sm md:text-base text-secondary max-w-2xl mx-auto mb-6">
				{ props.FeatureDesc }
			</p>

			<div class="d-flex items-center justify-center gap-3 flex-wrap">
				<a href="/customer/subscription" class="btn btn-primary font-bold text-sm px-6 py-2.5 shadow-lg gap-1.5">
					@components.IconSparkles("icon-xs")
					<span>عرض تفاصيل الاشتراك الحالي والترقية</span>
				</a>
				<a href="/catalog" class="btn btn-secondary font-semibold text-sm px-5 py-2.5">
					<span>العودة للكتالوج</span>
				</a>
			</div>
		</div>

		<!-- Eligible Plans Offering Grid -->
		if len(props.Plans) > 0 {
			<div class="mb-6">
				<div class="text-center mb-6">
					<h2 class="text-xl font-extrabold text-primary mb-1">
						الباقات المتاحة التي تتضمن هذه الميزة
					</h2>
					<p class="text-xs text-secondary">
						اختر الباقة المناسبة لمنشأتك للوصول الفوري لكافة الصلاحيات والأدوات المتقدمة
					</p>
				</div>

				<div>
					for _, p := range props.Plans {
						<div class={ "glass-panel p-6 d-flex flex-col justify-between hover-lift rounded-2xl", templ.KV("border-2 border-brand-500", p.HasFeature(props.FeatureKey)) }>
							
							if p.Slug == "pro" {
								<div class="badge badge-primary font-extrabold text-2xs d-inline-flex items-center gap-1 shadow-2xs">
									@components.IconSparkles("icon-2xs")
									<span>الخيار الأكثر شيوعاً</span>
								</div>
							}

							<div>
								<div class="flex-between items-center mb-3">
									<h3 class="text-lg font-black text-primary m-0">
										{ p.Name.Get(i18n.Lang(lang)) }
									</h3>
									<span class="text-xs text-muted font-mono" dir="ltr"><code>{ p.Slug }</code></span>
								</div>

								<p class="text-xs text-secondary mb-4 font-medium">
									{ p.Description.Get(i18n.Lang(lang)) }
								</p>

								<!-- Price display -->
								<div class="p-4 rounded-xl mb-4 bg-surface-sunken border border-slate-200/80">
									<div class="text-xs text-secondary font-bold mb-1">قيمة الاشتراك</div>
									<div class="text-2xl font-black text-primary tabular-nums">
										{ fmt.Sprintf("%s ج.م", p.PriceMonth.String()) }
										<span class="text-xs text-muted font-normal">/ شهرياً</span>
									</div>
									<div class="text-xs text-muted mt-1 tabular-nums">
										{ fmt.Sprintf("%s ج.م / سنوياً", p.PriceYear.String()) }
									</div>
								</div>

								<!-- Features Checklist -->
								<div class="space-y-2 mb-6 text-xs text-secondary font-medium">
									<div class="d-flex items-center gap-2">
										@components.IconCheck("icon-2xs text-emerald-600 shrink-0")
										<span>الجلسات المتزامنة: <strong>{ fmt.Sprintf("%d جلسات", p.MaxLoginSessions) }</strong></span>
									</div>
									<div class="d-flex items-center gap-2">
										@components.IconCheck("icon-2xs text-emerald-600 shrink-0")
										<span>الأجهزة المسجلة: <strong>{ fmt.Sprintf("%d أجهزة", p.MaxDevices) }</strong></span>
									</div>
									<div class="d-flex items-center gap-2">
										if p.HasFeature("feature_market_discounts") {
											@components.IconCheck("icon-2xs text-emerald-600 shrink-0")
											<strong class="text-emerald-700 font-bold">خصومات السوق العامة</strong>
										} else {
											@components.IconClose("icon-2xs text-slate-400 shrink-0")
											<span class="text-muted">خصومات السوق العامة</span>
										}
									</div>
									<div class="d-flex items-center gap-2">
										if p.HasFeature("feature_compare_tool") || p.HasFeature("compare") {
											@components.IconCheck("icon-2xs text-emerald-600 shrink-0")
											<strong class="text-brand font-bold">أداة مقارنة الخصومات الخاصة</strong>
										} else {
											@components.IconClose("icon-2xs text-slate-400 shrink-0")
											<span class="text-muted">أداة مقارنة الخصومات الخاصة</span>
										}
									</div>
								</div>
							</div>

							<div>
								<a href={ templ.SafeURL(fmt.Sprintf("/customer/subscription?upgrade=%s", p.Slug)) } class="btn btn-primary w-full text-center font-bold text-xs py-2.5 gap-1.5 shadow-xs">
									<span>الترقية إلى هذه الباقة</span>
									@components.IconArrowLeft("icon-2xs")
								</a>
							</div>
						</div>
					}
				</div>
			</div>
		}
	</div>
}
