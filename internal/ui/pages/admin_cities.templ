package pages

import (
	"fmt"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminCitiesData struct {
	Governorates          []*platformadmin.Governorate
	Cities                []*platformadmin.City
	SelectedGovernorateID int64
	TotalCities           int
	TotalGovernorates     int
	TotalFiltered         int
	Page                  int
	Limit                 int
	TotalPages            int
	Query                 string
	ActiveTab             string
}

templ AdminCities(data AdminCitiesData, lang string, dir string, isHTMX bool) {
	@layouts.AdminShell("إدارة المحافظات والمدن الجغرافية", "cities", lang, dir) {
		<div
			class="page-container"
			x-data="{
				isEditOpen: false,
				isGovEditOpen: false,
				editForm: {
					id: 0,
					gov_id: '',
					name_ar: '',
					name_en: '',
					lat: '',
					lon: '',
					is_capital: false,
					is_active: true,
					map_link: '#'
				},
				govEditForm: {
					id: 0,
					name_ar: '',
					name_en: '',
					lat: '',
					lon: '',
					is_active: true
				},
				openEdit(id, govId, nameAr, nameEn, lat, lon, isCapital, isActive) {
					this.editForm = {
						id: id,
						gov_id: govId > 0 ? String(govId) : '',
						name_ar: nameAr || '',
						name_en: nameEn || '',
						lat: (lat && lat !== 0) ? String(lat) : '',
						lon: (lon && lon !== 0) ? String(lon) : '',
						is_capital: !!isCapital,
						is_active: !!isActive,
						map_link: (lat && lon) ? 'https://www.google.com/maps?q=' + lat + ',' + lon : '#'
					};
					this.isEditOpen = true;
					this.$nextTick(() => {
						if (window.dawaSetMapLocation) {
							window.dawaSetMapLocation('#edit-city-map-picker', lat || 30.0444, lon || 31.2357, 13);
						}
					});
				},
				closeEdit() {
					this.isEditOpen = false;
				},
				openGovEdit(id, nameAr, nameEn, lat, lon, isActive) {
					this.govEditForm = {
						id: id,
						name_ar: nameAr || '',
						name_en: nameEn || '',
						lat: (lat && lat !== 0) ? String(lat) : '',
						lon: (lon && lon !== 0) ? String(lon) : '',
						is_active: !!isActive
					};
					this.isGovEditOpen = true;
					this.$nextTick(() => {
						if (window.dawaSetMapLocation) {
							window.dawaSetMapLocation('#edit-gov-map-picker', lat || 30.0444, lon || 31.2357, 11);
						}
					});
				},
				closeGovEdit() {
					this.isGovEditOpen = false;
				}
			}"
			@keydown.escape.window="closeEdit(); closeGovEdit();"
		>
			<!-- Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconGlobe("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">
								المحافظات والمدن والمراكز الجغرافية
							</h1>
							<p class="text-sm text-secondary m-0 mt-1 max-w-2xl">
								منظومة التقسيم الهرمي للمحافظات والمدن والمراكز والأحياء المعتمدة في مصر مع الإحداثيات الجغرافية (GPS) لضبط نطاقات التغطية وعمليات الشحن والتوصيل.
							</p>
						</div>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap">
						<a href="#new-gov-card" class="btn btn-secondary btn-sm font-bold text-xs">
							@components.IconPlus("icon-xs")
							<span>إضافة محافظة جديدة</span>
						</a>
						<a href="#new-city-card" class="btn btn-primary btn-sm font-bold text-xs">
							@components.IconPlus("icon-xs")
							<span>إضافة مدينة / حي</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Metrics -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label text-xs">المحافظات الرئيسية</div>
					<div class="stat-card-value text-primary tabular-nums text-2xl font-black">
						if data.TotalGovernorates > 0 {
							{ fmt.Sprintf("%d", data.TotalGovernorates) }
						} else {
							{ fmt.Sprintf("%d", len(data.Governorates)) }
						}
					</div>
					<div class="stat-card-sub text-muted text-xs mt-1">محافظة مسجلة ومعتمدة</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-xs">المدن والمراكز والأحياء</div>
					<div class="stat-card-value text-brand tabular-nums text-2xl font-black">
						if data.TotalCities > 0 {
							{ fmt.Sprintf("%d", data.TotalCities) }
						} else {
							{ fmt.Sprintf("%d", len(data.Cities)) }
						}
					</div>
					<div class="stat-card-sub text-muted text-xs mt-1">مدينة وحي مسجل بالمنظومة</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-xs">جاهزية الإحداثيات المكانية</div>
					<div class="mt-2">
						<span class="badge badge-emerald text-xs font-bold">100% إحداثيات GPS دقيقة</span>
					</div>
					<div class="stat-card-sub text-muted text-xs mt-1">حساب مسافات التوصيل بالخرائط التفاعلية</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-xs">حالة النطاق الجغرافي</div>
					<div class="mt-2">
						<span class="badge badge-sky text-xs font-bold">تغطية شاملة للمحافظات</span>
					</div>
					<div class="stat-card-sub text-muted text-xs mt-1">محدثة ومطابقة للمخطط الإداري</div>
				</div>
			</div>

			<!-- Filter Bar -->
			<div class="glass-panel p-4 mb-6">
				<form method="GET" action="/admin/cities" class="d-flex flex-wrap items-center justify-between gap-3 m-0">
					<div class="d-flex flex-wrap items-center gap-3 flex-1" style="min-width: 280px;">
						<div style="min-width: 200px; flex: 1;">
							<select name="gov_id" onchange="this.form.submit()" class="form-input text-xs w-full font-bold">
								<option value="0">كل المحافظات (عرض جميع المدن)</option>
								for _, g := range data.Governorates {
									if data.SelectedGovernorateID == g.ID {
										<option value={ fmt.Sprintf("%d", g.ID) } selected>
											{ g.Name["ar"] } ({ g.Name["en"] }) - { fmt.Sprintf("%d", g.CityCount) } مدينة
										</option>
									} else {
										<option value={ fmt.Sprintf("%d", g.ID) }>
											{ g.Name["ar"] } ({ g.Name["en"] }) - { fmt.Sprintf("%d", g.CityCount) } مدينة
										</option>
									}
								}
							</select>
						</div>

						<div style="min-width: 220px; flex: 1.5;">
							<input
								type="text"
								name="q"
								value={ data.Query }
								placeholder="بحث باسم المدينة أو المحافظة..."
								class="form-input text-xs w-full"
							/>
						</div>

						<input type="hidden" name="limit" value={ fmt.Sprintf("%d", data.Limit) }/>

						<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-3">
							@components.IconSearch("icon-xs")
							<span>بحث</span>
						</button>

						if data.Query != "" || data.SelectedGovernorateID > 0 {
							<a href="/admin/cities" class="btn btn-secondary btn-sm text-xs">
								@components.IconClose("icon-xs")
								<span>إعادة ضبط</span>
							</a>
						}
					</div>

					<div class="d-flex items-center gap-3">
						<span class="text-xs text-muted font-bold">إجمالي المطابق:</span>
						<span class="badge badge-sky tabular-nums text-xs font-bold">
							{ fmt.Sprintf("%d مدينة", data.TotalFiltered) }
						</span>
					</div>
				</form>
			</div>

			<!-- Main Content Grid: Table on Left (1.8fr), Forms on Right (1.2fr) -->
			<div style="display: grid; grid-template-columns: 1.8fr 1.2fr; gap: 1.5rem; align-items: start;" class="cities-layout-grid">
				
				<!-- Left: Cities Table -->
				<div class="glass-panel p-0 mb-6 overflow-hidden">
					<div class="p-4 border-b flex-between items-center flex-wrap gap-2">
						<div>
							<h3 class="text-base font-black text-primary m-0">
								سجل المدن والمراكز المعتمدة
							</h3>
							if data.SelectedGovernorateID > 0 {
								for _, g := range data.Governorates {
									if g.ID == data.SelectedGovernorateID {
										<div class="text-xs text-brand font-bold mt-1">
											عرض مدن محافظة: { g.Name["ar"] } ({ g.Name["en"] })
										</div>
									}
								}
							}
						</div>
						<div class="d-flex items-center gap-2">
							<span class="badge badge-emerald tabular-nums text-xs font-bold">{ fmt.Sprintf("%d مدينة معروضة", len(data.Cities)) }</span>
						</div>
					</div>

					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>المدينة / الحي</th>
									<th>المحافظة التابعة</th>
									<th>الإحداثيات الجغرافية (GPS)</th>
									<th>الحالة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								if len(data.Cities) == 0 {
									<tr>
										<td colspan="5" class="p-8 text-center text-muted">
											<div class="text-3xl mb-2">@components.IconSearch("icon-sm")</div>
											<div class="font-bold text-sm text-primary">لم يتم العثور على أي مدن تطابق شروط البحث</div>
											<div class="text-xs text-secondary mt-1">جرب تغيير المحافظة أو عبارة البحث في الأعلى.</div>
										</td>
									</tr>
								}
								for _, c := range data.Cities {
									<tr>
										<td>
											<div class="font-black text-primary d-flex items-center gap-1">
												if c.IsCapital {
													<span title="عاصمة / مركز رئيسي" class="text-xs">@components.IconStar("icon-sm")</span>
												}
												if c.Name["ar"] != "" {
													<span>{ c.Name["ar"] }</span>
												} else {
													<span>{ c.Name["en"] }</span>
												}
											</div>
											if c.Name["en"] != "" && c.Name["ar"] != "" {
												<div class="text-xs text-muted font-normal">{ c.Name["en"] }</div>
											}
										</td>
										<td>
											if c.GovernorateName != nil && (*c.GovernorateName)["ar"] != "" {
												<span class="badge badge-sky text-xs font-bold">
													{ (*c.GovernorateName)["ar"] }
												</span>
											} else {
												<span class="badge badge-slate text-xs">غير محدد</span>
											}
										</td>
										<td class="font-mono text-xs tabular-nums">
											if c.Latitude != 0 && c.Longitude != 0 {
												<a
													href={ templ.SafeURL(fmt.Sprintf("https://www.google.com/maps?q=%.6f,%.6f", c.Latitude, c.Longitude)) }
													target="_blank"
													rel="noopener noreferrer"
													title="فتح الموقع على خرائط جوجل"
													class="text-brand text-xs font-bold text-decoration-none d-inline-flex items-center gap-1"
												>
													<span>{ fmt.Sprintf("%.4f, %.4f", c.Latitude, c.Longitude) }</span>
												</a>
											} else {
												<span class="text-muted text-xs">غير محدد</span>
											}
										</td>
										<td>
											if c.IsActive {
												<span class="badge badge-emerald text-xs">مفعلة</span>
											} else {
												<span class="badge badge-slate text-xs">معطلة</span>
											}
										</td>
										<td class="text-end">
											<div class="d-inline-flex items-center gap-1">
												<button
													type="button"
													class="btn btn-secondary btn-xs font-bold text-xs"
													@click={ fmt.Sprintf("openEdit(%d, %d, %q, %q, %f, %f, %t, %t)",
														c.ID,
														govIDOrDefault(c.GovernorateID),
														c.Name["ar"],
														c.Name["en"],
														c.Latitude,
														c.Longitude,
														c.IsCapital,
														c.IsActive,
													) }
												>
													<span>تعديل</span>
												</button>

												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/cities/%d/toggle", c.ID)) } class="m-0 d-inline">
													<button type="submit" class="btn btn-secondary btn-xs text-xs">
														if c.IsActive {
															<span>تعطيل</span>
														} else {
															<span>تفعيل</span>
														}
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Pagination Strip -->
					<div class="p-4 border-t flex-between items-center flex-wrap gap-3 bg-surface-sunken">
						<!-- Rows Per Page -->
						<div class="d-flex items-center gap-2 text-xs text-secondary">
							<span>صفوف لكل صفحة:</span>
							<select
								class="form-input text-xs py-1 px-2"
								style="width: auto;"
								onchange="location.href=this.value"
							>
								<option value={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d&q=%s&limit=10&page=1", data.SelectedGovernorateID, data.Query)) } selected?={ data.Limit == 10 }>10</option>
								<option value={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d&q=%s&limit=25&page=1", data.SelectedGovernorateID, data.Query)) } selected?={ data.Limit == 25 }>25</option>
								<option value={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d&q=%s&limit=50&page=1", data.SelectedGovernorateID, data.Query)) } selected?={ data.Limit == 50 }>50</option>
								<option value={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d&q=%s&limit=100&page=1", data.SelectedGovernorateID, data.Query)) } selected?={ data.Limit == 100 }>100</option>
								<option value={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d&q=%s&limit=1000&page=1", data.SelectedGovernorateID, data.Query)) } selected?={ data.Limit >= 1000 }>الكل ({ fmt.Sprintf("%d", data.TotalFiltered) })</option>
							</select>
							<span class="tabular-nums font-bold">
								(صفحة { fmt.Sprintf("%d من %d", data.Page, data.TotalPages) })
							</span>
						</div>

						<!-- Page Nav -->
						<div class="d-flex items-center gap-2">
							if data.Page > 1 {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d&q=%s&limit=%d&page=%d", data.SelectedGovernorateID, data.Query, data.Limit, data.Page-1)) }
									class="btn btn-secondary btn-xs font-bold text-xs"
								>
									@components.IconArrowRight("icon-xs")
									<span>السابق</span>
								</a>
							}
							if data.Page < data.TotalPages {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d&q=%s&limit=%d&page=%d", data.SelectedGovernorateID, data.Query, data.Limit, data.Page+1)) }
									class="btn btn-secondary btn-xs font-bold text-xs"
								>
									<span>التالي</span>
									@components.IconArrowLeft("icon-xs")
								</a>
							}
						</div>
					</div>
				</div>

				<!-- Right Side: Creation Forms -->
				<div class="d-flex flex-col gap-6">
					
					<!-- Card 1: Add New City with Interactive Map & Smart Governorate Pan -->
					<div id="new-city-card" class="glass-panel p-5 mb-0">
						<div class="d-flex items-center gap-2 pb-3 mb-4 border-b">
							<div class="user-avatar-badge text-base">
								@components.IconBuilding("icon-sm")
							</div>
							<div>
								<h3 class="text-sm font-black text-primary m-0">
									إضافة مدينة / حي فرعي
								</h3>
								<div class="text-xs text-secondary mt-0.5">إدراج منطقة جديدة تحت محافظة معتمدة وتحديدها على الخريطة</div>
							</div>
						</div>

						<form method="POST" action="/admin/cities/new" class="d-flex flex-col gap-3 m-0">
							<div>
								<label class="form-label text-xs font-bold mb-1">
									المحافظة التابعة <span class="text-danger">*</span> <span class="text-secondary font-normal">(اختيار المحافظة ينقلك إليها تلقائياً على الخريطة)</span>
								</label>
								<select name="governorate_id" required class="form-input text-xs w-full font-bold" data-gov-selector>
									<option value="" data-lat="30.0444" data-lng="31.2357">-- اختر المحافظة --</option>
									for _, g := range data.Governorates {
										if data.SelectedGovernorateID == g.ID {
											<option 
												value={ fmt.Sprintf("%d", g.ID) } 
												data-lat={ fmt.Sprintf("%.6f", g.Latitude) } 
												data-lng={ fmt.Sprintf("%.6f", g.Longitude) }
												selected
											>
												{ g.Name["ar"] } ({ g.Name["en"] })
											</option>
										} else {
											<option 
												value={ fmt.Sprintf("%d", g.ID) } 
												data-lat={ fmt.Sprintf("%.6f", g.Latitude) } 
												data-lng={ fmt.Sprintf("%.6f", g.Longitude) }
											>
												{ g.Name["ar"] } ({ g.Name["en"] })
											</option>
										}
									}
								</select>
							</div>

							<div>
								<label class="form-label text-xs font-bold mb-1">
									اسم المدينة / الحي بالعربية <span class="text-danger">*</span>
								</label>
								<input type="text" name="name_ar" required placeholder="مثال: المنصورة الجديدة" class="form-input text-xs w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold mb-1">
									اسم المدينة / الحي بالإنجليزية
								</label>
								<input type="text" name="name_en" placeholder="New Mansoura" class="form-input text-xs w-full"/>
							</div>

							<!-- Interactive Map Picker for City -->
							<div>
								<label class="form-label text-xs font-bold mb-1 d-block">
									الموقع الجغرافي والإحداثيات (GPS) <span class="text-secondary font-normal">(اضغط على الخريطة لتحديد الموقع بدقة)</span>
								</label>
								<div
									data-map-picker
									data-default-lat="30.0444"
									data-default-lon="31.2357"
									class="rounded-xl overflow-hidden border bg-surface-sunken position-relative shadow-xs"
								>
									<div class="map-container map-canvas" style="height:230px; width:100%; z-index:1;"></div>
									<div class="flex-between p-2 bg-surface-raised border-t text-xs flex-wrap gap-2">
										<div class="d-flex items-center gap-1.5">
											<span class="text-secondary font-bold">الإحداثيات:</span>
											<span data-map-coords-badge class="tabular-nums font-black text-primary">30.0444, 31.2357</span>
										</div>
										<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold gap-1">
											<span>موقعي الحالي</span>
										</button>
									</div>
								</div>
							</div>

							<div class="d-flex gap-2">
								<div class="flex-1">
									<label class="form-label text-xs font-bold mb-1">خط العرض (Lat)</label>
									<input type="number" step="any" name="city_lat" data-map-input="lat" placeholder="30.0444" class="form-input text-xs w-full font-mono"/>
								</div>
								<div class="flex-1">
									<label class="form-label text-xs font-bold mb-1">خط الطول (Lon)</label>
									<input type="number" step="any" name="city_lon" data-map-input="lon" placeholder="31.2357" class="form-input text-xs w-full font-mono"/>
								</div>
							</div>

							<button type="submit" class="btn btn-primary btn-sm font-black text-xs w-full mt-2">
								@components.IconCheck("icon-xs")
								<span>حفظ وإضافة المدينة</span>
							</button>
						</form>
					</div>

					<!-- Card 2: Add New Governorate with Interactive Map -->
					<div id="new-gov-card" class="glass-panel p-5 mb-0">
						<div class="d-flex items-center gap-2 pb-3 mb-4 border-b">
							<div class="user-avatar-badge text-base">
								@components.IconBank("icon-sm")
							</div>
							<div>
								<h3 class="text-sm font-black text-primary m-0">
									إضافة محافظة رئيسية
								</h3>
								<div class="text-xs text-secondary mt-0.5">إدراج نطاق محافظة جديد بالجمهورية مع موقعه على الخريطة</div>
							</div>
						</div>

						<form method="POST" action="/admin/governorates/new" class="d-flex flex-col gap-3 m-0">
							<div>
								<label class="form-label text-xs font-bold mb-1">
									اسم المحافظة بالعربية <span class="text-danger">*</span>
								</label>
								<input type="text" name="gov_name_ar" required placeholder="مثال: مطروح" class="form-input text-xs w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold mb-1">
									اسم المحافظة بالإنجليزية
								</label>
								<input type="text" name="gov_name_en" placeholder="Matrooh" class="form-input text-xs w-full"/>
							</div>

							<!-- Interactive Map Picker for Governorate -->
							<div>
								<label class="form-label text-xs font-bold mb-1 d-block">
									الموقع الجغرافي لمركز المحافظة (GPS) <span class="text-secondary font-normal">(حدد موقع ديوان/مركز المحافظة)</span>
								</label>
								<div
									data-map-picker
									data-default-lat="30.0444"
									data-default-lon="31.2357"
									class="rounded-xl overflow-hidden border bg-surface-sunken position-relative shadow-xs"
								>
									<div class="map-container map-canvas" style="height:200px; width:100%; z-index:1;"></div>
									<div class="flex-between p-2 bg-surface-raised border-t text-xs flex-wrap gap-2">
										<div class="d-flex items-center gap-1.5">
											<span class="text-secondary font-bold">الإحداثيات:</span>
											<span data-map-coords-badge class="tabular-nums font-black text-primary">30.0444, 31.2357</span>
										</div>
										<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold gap-1">
											<span>موقعي</span>
										</button>
									</div>
								</div>
							</div>

							<div class="d-flex gap-2">
								<div class="flex-1">
									<label class="form-label text-xs font-bold mb-1">خط العرض (Lat)</label>
									<input type="number" step="any" name="gov_lat" data-map-input="lat" placeholder="30.0444" class="form-input text-xs w-full font-mono"/>
								</div>
								<div class="flex-1">
									<label class="form-label text-xs font-bold mb-1">خط الطول (Lon)</label>
									<input type="number" step="any" name="gov_lon" data-map-input="lon" placeholder="31.2357" class="form-input text-xs w-full font-mono"/>
								</div>
							</div>

							<button type="submit" class="btn btn-secondary btn-sm font-black text-xs w-full mt-2">
								@components.IconCheck("icon-xs")
								<span>حفظ وإضافة المحافظة</span>
							</button>
						</form>
					</div>

					<!-- Card 3: Governorates Quick Filter Pills & Quick Management -->
					<div class="glass-panel p-5 mb-0">
						<div class="flex-between items-center pb-2 mb-3 border-b">
							<h4 class="text-xs font-black text-primary m-0">
								المحافظات المعتمدة ({ fmt.Sprintf("%d", len(data.Governorates)) })
							</h4>
						</div>
						<div class="d-flex flex-wrap gap-1.5" style="max-height: 220px; overflow-y: auto;">
							for _, g := range data.Governorates {
								<div class="d-inline-flex items-center gap-1 bg-surface-sunken p-1 rounded-lg border">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/cities?gov_id=%d", g.ID)) }
										class={ "badge text-xs", templ.KV("badge-primary", data.SelectedGovernorateID == g.ID), templ.KV("badge-slate", data.SelectedGovernorateID != g.ID) }
										style="text-decoration: none; cursor: pointer; padding: 0.35rem 0.6rem;"
									>
										<span>{ g.Name["ar"] }</span>
										<span class="tabular-nums opacity-75 font-mono">({ fmt.Sprintf("%d", g.CityCount) })</span>
									</a>
									<button
										type="button"
										class="btn btn-ghost btn-2xs"
										style="padding: 0.2rem 0.35rem; font-size: 0.7rem;"
										title="تعديل المحافظة على الخريطة"
										@click={ fmt.Sprintf("openGovEdit(%d, %q, %q, %f, %f, %t)", g.ID, g.Name["ar"], g.Name["en"], g.Latitude, g.Longitude, g.IsActive) }
									>
										@components.IconEdit("icon-sm")
									</button>
								</div>
							}
						</div>
					</div>

				</div>
			</div>

			<!-- Dynamic Alpine Centered Edit City Modal with Leaflet Map -->
			<div
				x-show="isEditOpen"
				x-cloak
				class="modal-backdrop"
				style="position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); padding: 1rem;"
				@click.self="closeEdit()"
			>
				<div
					class="glass-panel p-6 w-full"
					style="max-width: 540px; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-2xl); border-radius: var(--radius-2xl);"
					@click.stop
				>
					<div class="flex-between items-center pb-3 mb-4 border-b">
						<div class="d-flex items-center gap-2">
							<div class="user-avatar-badge text-base">
								@components.IconEdit("icon-sm")
							</div>
							<div>
								<h3 class="text-base font-black text-primary m-0">
									تعديل بيانات المدينة / الحي
								</h3>
								<div class="text-xs text-secondary mt-0.5">تحديث الاسم والمحافظة والإحداثيات الجغرافية على الخريطة</div>
							</div>
						</div>
						<button type="button" @click="closeEdit()" class="btn btn-secondary btn-xs btn-icon">
							@components.IconX("icon-sm")
						</button>
					</div>

					<form :action="'/admin/cities/' + editForm.id + '/edit'" method="POST" class="d-flex flex-col gap-3 m-0">
						<div>
							<label class="form-label text-xs font-bold mb-1">
								المحافظة التابعة <span class="text-danger">*</span>
							</label>
							<select name="governorate_id" x-model="editForm.gov_id" required class="form-input text-xs w-full font-bold" data-gov-selector>
								<option value="" data-lat="30.0444" data-lng="31.2357">-- اختر المحافظة --</option>
								for _, g := range data.Governorates {
									<option 
										value={ fmt.Sprintf("%d", g.ID) } 
										data-lat={ fmt.Sprintf("%.6f", g.Latitude) } 
										data-lng={ fmt.Sprintf("%.6f", g.Longitude) }
									>
										{ g.Name["ar"] } ({ g.Name["en"] })
									</option>
								}
							</select>
						</div>

						<div>
							<label class="form-label text-xs font-bold mb-1">
								اسم المدينة / الحي بالعربية <span class="text-danger">*</span>
							</label>
							<input type="text" name="name_ar" x-model="editForm.name_ar" required placeholder="مثال: مدينة نصر" class="form-input text-xs w-full"/>
						</div>

						<div>
							<label class="form-label text-xs font-bold mb-1">
								اسم المدينة / الحي بالإنجليزية
							</label>
							<input type="text" name="name_en" x-model="editForm.name_en" placeholder="Nasr City" class="form-input text-xs w-full"/>
						</div>

						<!-- Map Picker in City Edit Modal -->
						<div>
							<label class="form-label text-xs font-bold mb-1 d-block">
								الموقع الجغرافي للمدينة على الخريطة <span class="text-secondary font-normal">(حرك المؤشر أو اضغط على الموقع لتحديث الإحداثيات)</span>
							</label>
							<div
								id="edit-city-map-picker"
								data-map-picker
								data-default-lat="30.0444"
								data-default-lon="31.2357"
								class="rounded-xl overflow-hidden border bg-surface-sunken position-relative shadow-xs mb-2"
							>
								<div class="map-container map-canvas" style="height:220px; width:100%; z-index:1;"></div>
								<div class="flex-between p-2 bg-surface-raised border-t text-xs flex-wrap gap-2">
									<div class="d-flex items-center gap-1.5">
										<span class="text-secondary font-bold">الإحداثيات المحددة:</span>
										<span data-map-coords-badge class="tabular-nums font-black text-primary" x-text="(editForm.lat || '30.0444') + ', ' + (editForm.lon || '31.2357')"></span>
									</div>
									<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold gap-1">
										<span>موقعي الحالي</span>
									</button>
								</div>
							</div>
						</div>

						<div class="d-flex gap-2">
							<div class="flex-1">
								<label class="form-label text-xs font-bold mb-1">خط العرض (Lat)</label>
								<input type="number" step="any" name="city_lat" data-map-input="lat" x-model="editForm.lat" placeholder="30.0444" class="form-input text-xs w-full font-mono"/>
							</div>
							<div class="flex-1">
								<label class="form-label text-xs font-bold mb-1">خط الطول (Lon)</label>
								<input type="number" step="any" name="city_lon" data-map-input="lon" x-model="editForm.lon" placeholder="31.2357" class="form-input text-xs w-full font-mono"/>
							</div>
						</div>

						<div class="p-3 bg-surface-sunken border rounded-lg d-flex items-center gap-2 text-xs">
							<a :href="editForm.map_link" target="_blank" rel="noopener noreferrer" class="text-brand font-bold text-decoration-none d-flex items-center gap-1">
								<span>معاينة الموقع على خرائط جوجل</span>
							</a>
						</div>

						<div class="d-flex gap-4 p-3 bg-surface-sunken border rounded-lg">
							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_capital" value="true" x-model="editForm.is_capital" class="form-checkbox"/>
								<span>عاصمة / مركز رئيسي</span>
							</label>

							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_active" value="true" x-model="editForm.is_active" class="form-checkbox"/>
								<span>حالة التفعيل (نشطة)</span>
							</label>
						</div>

						<div class="flex-between items-center pt-3 mt-2 border-t gap-3">
							<button type="button" @click="closeEdit()" class="btn btn-secondary btn-sm font-bold text-xs flex-1">
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary btn-sm font-black text-xs flex-1">
								@components.IconCheck("icon-xs")
								<span>حفظ التعديلات</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Dynamic Alpine Centered Edit Governorate Modal with Leaflet Map -->
			<div
				x-show="isGovEditOpen"
				x-cloak
				class="modal-backdrop"
				style="position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); padding: 1rem;"
				@click.self="closeGovEdit()"
			>
				<div
					class="glass-panel p-6 w-full"
					style="max-width: 540px; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-2xl); border-radius: var(--radius-2xl);"
					@click.stop
				>
					<div class="flex-between items-center pb-3 mb-4 border-b">
						<div class="d-flex items-center gap-2">
							<div class="user-avatar-badge text-base">
								@components.IconBank("icon-sm")
							</div>
							<div>
								<h3 class="text-base font-black text-primary m-0">
									تعديل بيانات المحافظة والموقع الجغرافي
								</h3>
								<div class="text-xs text-secondary mt-0.5">تحديث الاسم والإحداثيات الجغرافية على الخريطة</div>
							</div>
						</div>
						<button type="button" @click="closeGovEdit()" class="btn btn-secondary btn-xs btn-icon">
							@components.IconX("icon-sm")
						</button>
					</div>

					<form :action="'/admin/governorates/' + govEditForm.id + '/edit'" method="POST" class="d-flex flex-col gap-3 m-0">
						<div>
							<label class="form-label text-xs font-bold mb-1">
								اسم المحافظة بالعربية <span class="text-danger">*</span>
							</label>
							<input type="text" name="gov_name_ar" x-model="govEditForm.name_ar" required placeholder="مثال: الإسكندرية" class="form-input text-xs w-full"/>
						</div>

						<div>
							<label class="form-label text-xs font-bold mb-1">
								اسم المحافظة بالإنجليزية
							</label>
							<input type="text" name="gov_name_en" x-model="govEditForm.name_en" placeholder="Alexandria" class="form-input text-xs w-full"/>
						</div>

						<div>
							<label class="form-label text-xs font-bold mb-1 d-block">
								الموقع الجغرافي لمركز المحافظة <span class="text-secondary font-normal">(اضغط على الخريطة لتحديث المركز)</span>
							</label>
							<div
								id="edit-gov-map-picker"
								data-map-picker
								data-default-lat="30.0444"
								data-default-lon="31.2357"
								class="rounded-xl overflow-hidden border bg-surface-sunken position-relative shadow-xs mb-2"
							>
								<div class="map-container map-canvas" style="height:210px; width:100%; z-index:1;"></div>
								<div class="flex-between p-2 bg-surface-raised border-t text-xs flex-wrap gap-2">
									<div class="d-flex items-center gap-1.5">
										<span class="text-secondary font-bold">الإحداثيات:</span>
										<span data-map-coords-badge class="tabular-nums font-black text-primary" x-text="(govEditForm.lat || '30.0444') + ', ' + (govEditForm.lon || '31.2357')"></span>
									</div>
									<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold gap-1">
										<span>موقعي الحالي</span>
									</button>
								</div>
							</div>
						</div>

						<div class="d-flex gap-2">
							<div class="flex-1">
								<label class="form-label text-xs font-bold mb-1">خط العرض (Lat)</label>
								<input type="number" step="any" name="gov_lat" data-map-input="lat" x-model="govEditForm.lat" placeholder="30.0444" class="form-input text-xs w-full font-mono"/>
							</div>
							<div class="flex-1">
								<label class="form-label text-xs font-bold mb-1">خط الطول (Lon)</label>
								<input type="number" step="any" name="gov_lon" data-map-input="lon" x-model="govEditForm.lon" placeholder="31.2357" class="form-input text-xs w-full font-mono"/>
							</div>
						</div>

						<div class="d-flex gap-4 p-3 bg-surface-sunken border rounded-lg">
							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_active" value="true" x-model="govEditForm.is_active" class="form-checkbox"/>
								<span>حالة التفعيل (نشطة ومعتمدة بالجمهورية)</span>
							</label>
						</div>

						<div class="flex-between items-center pt-3 mt-2 border-t gap-3">
							<button type="button" @click="closeGovEdit()" class="btn btn-secondary btn-sm font-bold text-xs flex-1">
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary btn-sm font-black text-xs flex-1">
								@components.IconCheck("icon-xs")
								<span>حفظ تعديلات المحافظة</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}

func govIDOrDefault(g *int64) int64 {
	if g == nil {
		return 0
	}
	return *g
}
