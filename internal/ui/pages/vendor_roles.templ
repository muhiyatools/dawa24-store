package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorRoleItem struct {
	Key         string
	NameAr      string
	NameEn      string
	Description string
	Permissions []string
	MemberCount int
	BadgeColor  string
}

templ VendorRoles(roles []*org.Role, memberCountMap map[string]int, lang, dir string) {
	@layouts.VendorShell("إدارة الأدوار وصلاحيات المنشأة", "team", lang, dir) {
		<div class="page-container max-w-6xl">
			
			<!-- Header Action Bar -->
			<div class="glass-panel p-6 mb-0">
				<div class="flex-between items-center flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconSettings("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								إدارة الأدوار ومصفوفة الصلاحيات
							</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							تحديد الصلاحيات الإدارية، العملياتية، والمالية لمدراء الفروع وموظفي التوريد والمبيعات
						</p>
					</div>

					<div class="d-flex items-center gap-2">
						<a href="/vendor/team" class="btn btn-secondary font-bold gap-2">
							@components.IconUsers("icon-xs")
							<span>فريق العمل والموظفين</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Role Cards Grid -->
			<div class="d-grid grid-cols-3 gap-4">
				
				<!-- Role 1: Owner / Super Admin -->
				<div class="glass-panel p-5 mb-0 d-flex flex-col justify-between gap-4">
     <div class="stack-sm">
						<div class="flex-between items-start mb-3">
       <div class="stack-sm">
								<h3 class="text-base font-extrabold text-primary m-0">مالك المنشأة (Owner)</h3>
								<span class="text-xs text-muted">أعلى مستوى صلاحيات للنظام</span>
							</div>
							<span class="badge badge-emerald font-bold text-xs">كامل الصلاحيات</span>
						</div>
						<p class="text-xs text-secondary leading-relaxed mb-4">
							إدارة شاملة لبيانات الشركة، الحساب البنكي، ترخيص المؤسسة، الاعتماد المالي، وتعيين كبار المدراء.
						</p>
						<div class="d-flex flex-col gap-2 text-xs text-primary">
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>تعديل إعدادات المنشأة والمستندات الرسمية</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>إدارة الحسابات البنكية والمحفظة والتحويلات</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>إضافة وحذف الفروع وتعيين المدراء</span>
							</div>
						</div>
					</div>
					<div class="border-t pt-3 flex-between items-center text-xs text-muted">
						<span>الموظفين المسندين: <strong class="text-primary tabular-nums font-bold">{ fmt.Sprintf("%d", memberCountMap["org_owner"]) }</strong></span>
						<span class="text-brand font-bold">دور نظامي أساسي</span>
					</div>
				</div>

				<!-- Role 2: Branch & Operations Manager -->
				<div class="glass-panel p-5 mb-0 d-flex flex-col justify-between gap-4">
     <div class="stack-sm">
						<div class="flex-between items-start mb-3">
       <div class="stack-sm">
								<h3 class="text-base font-extrabold text-primary m-0">مدير العمليات والتوريد (Manager)</h3>
								<span class="text-xs text-muted">إدارة الفروع والشحنات</span>
							</div>
							<span class="badge badge-sky font-bold text-xs">إداري</span>
						</div>
						<p class="text-xs text-secondary leading-relaxed mb-4">
							إدارة أوامر الشراء، التسعير، قبول طلبات الصيدليات، وجدولة تسليم الأدوية والشحنات المبردة.
						</p>
						<div class="d-flex flex-col gap-2 text-xs text-primary">
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>قبول ورفض وتحديث حالات أوامر التوريد</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>تحديث عروض الأسعار ونطاقات التغطية الجغرافية</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>متابعة أداء الموظفين وإسناد الشحنات</span>
							</div>
						</div>
					</div>
					<div class="border-t pt-3 flex-between items-center text-xs text-muted">
						<span>الموظفين المسندين: <strong class="text-primary tabular-nums font-bold">{ fmt.Sprintf("%d", memberCountMap["manager"]) }</strong></span>
						<span class="text-success font-bold">مفعل</span>
					</div>
				</div>

				<!-- Role 3: Warehouse & Inventory Keeper -->
				<div class="glass-panel p-5 mb-0 d-flex flex-col justify-between gap-4">
     <div class="stack-sm">
						<div class="flex-between items-start mb-3">
       <div class="stack-sm">
								<h3 class="text-base font-extrabold text-primary m-0">أمين المخزن (Warehouse Keeper)</h3>
								<span class="text-xs text-muted">إدارة المخزون والتشغيلات</span>
							</div>
							<span class="badge badge-amber font-bold text-xs">مخزني</span>
						</div>
						<p class="text-xs text-secondary leading-relaxed mb-4">
							جرد المخازن، تسجيل الدفعات وتواريخ الصلاحية، واستيراد وتحديث ملفات الأرصدة.
						</p>
						<div class="d-flex flex-col gap-2 text-xs text-primary">
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>تعديل وجرد الأرصدة والكميات المتاحة</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>تسجيل أرقام التشغيلات وتواريخ انتهاء الصلاحية</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>إجراء التحويلات المخزنية بين مخازن الفروع</span>
							</div>
						</div>
					</div>
					<div class="border-t pt-3 flex-between items-center text-xs text-muted">
						<span>الموظفين المسندين: <strong class="text-primary tabular-nums font-bold">{ fmt.Sprintf("%d", memberCountMap["warehouse"]) }</strong></span>
						<span class="text-success font-bold">مفعل</span>
					</div>
				</div>

				<!-- Role 4: Financial Accountant -->
				<div class="glass-panel p-5 mb-0 d-flex flex-col justify-between gap-4">
     <div class="stack-sm">
						<div class="flex-between items-start mb-3">
       <div class="stack-sm">
								<h3 class="text-base font-extrabold text-primary m-0">المحاسب المالي (Accountant)</h3>
								<span class="text-xs text-muted">الفواتير والمحفظة</span>
							</div>
							<span class="badge badge-indigo font-bold text-xs">مالي</span>
						</div>
						<p class="text-xs text-secondary leading-relaxed mb-4">
							إصدار وتدقيق فواتير التوريد، متابعة التحصيلات، كشوف الحسابات، وتسويات الأرصدة.
						</p>
						<div class="d-flex flex-col gap-2 text-xs text-primary">
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>تصدير سجل الفواتير وكشوف التوريد</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>عرض كشوف العمليات المالية للمحفظة</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>متابعة مديونيات ودفعات الصيدليات</span>
							</div>
						</div>
					</div>
					<div class="border-t pt-3 flex-between items-center text-xs text-muted">
						<span>الموظفين المسندين: <strong class="text-primary tabular-nums font-bold">{ fmt.Sprintf("%d", memberCountMap["accountant"]) }</strong></span>
						<span class="text-success font-bold">مفعل</span>
					</div>
				</div>

				<!-- Role 5: Sales Representative -->
				<div class="glass-panel p-5 mb-0 d-flex flex-col justify-between gap-4">
     <div class="stack-sm">
						<div class="flex-between items-start mb-3">
       <div class="stack-sm">
								<h3 class="text-base font-extrabold text-primary m-0">مندوب مبيعات وتوريد (Sales Rep)</h3>
								<span class="text-xs text-muted">المبيعات والتواصل مع الصيدليات</span>
							</div>
							<span class="badge badge-slate font-bold text-xs">مبيعات</span>
						</div>
						<p class="text-xs text-secondary leading-relaxed mb-4">
							الرد على طلبات تسعير الصيدليات، التنسيق مع المناديب، ومتابعة تسليم وتوقيع إيصالات الشحنات.
						</p>
						<div class="d-flex flex-col gap-2 text-xs text-primary">
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>استقبال والرد على طلبات الصيدليات المباشرة</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>تحديث خط سير ومواعيد تسليم الشحنة للصيدلية</span>
							</div>
							<div class="d-flex items-center gap-2">
								@components.IconCheck("icon-xs")
								<span>تسجيل إشعارات الاستلام الموقعة</span>
							</div>
						</div>
					</div>
					<div class="border-t pt-3 flex-between items-center text-xs text-muted">
						<span>الموظفين المسندين: <strong class="text-primary tabular-nums font-bold">{ fmt.Sprintf("%d", memberCountMap["employee"]) }</strong></span>
						<span class="text-success font-bold">مفعل</span>
					</div>
				</div>

			</div>
		</div>
	}
}
