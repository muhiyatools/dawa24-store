				</div>
				<a href="/admin/offers-packages" class="btn btn-secondary btn-sm">العودة</a>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "الحملات الترويجية", Message: "إدارة الحملات الترويجية الموجهة حسب المحافظات."})
		</div>
	}
}

// AdminAdsListPage renders advertisements table with approval actions.
templ AdminAdsListPage(lang, dir string, ads []*promo.Ad) {
	@layouts.AdminShell("إدارة الإعلانات والبنرات (Ads)", "ads", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">الإعلانات والبنرات الترويجية</h2>
					<p class="subtitle">مراجعة واعتماد بنرات الموردين والشركات على الصفحة الرئيسية وصفحات الأقسام.</p>
				</div>
				<a href="/admin/ad-plan" class="btn btn-secondary btn-sm">خطط الإعلانات</a>
			</div>
			if len(ads) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد إعلانات", Message: "لا توجد إعلانات قيد المراجعة حالياً."})
			} else {
				<div class="table-wrapper">
					<table class="table">
						<thead>
							<tr>
								<th>العنوان</th>
								<th>المورد</th>
								<th>الوسائط</th>
								<th>المشاهدات</th>
								<th>النقرات</th>
								<th>CTR</th>
								<th>الحالة</th>
								<th>إجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, ad := range ads {
								if ad != nil {
									<tr>
										<td>{ ad.DisplayTitle(lang) }</td>
										<td class="tabular-nums">
											if ad.OrganizationID != nil {
												{ fmt.Sprintf("#%d", *ad.OrganizationID) }
											} else {
												<span class="text-muted">—</span>
											}
										</td>
										<td>
											if ad.MediaType == "video" {
												<span class="badge badge-sky text-xs">فيديو</span>
											} else {
												<span class="badge badge-slate text-xs">صورة</span>
											}
										</td>
										<td class="tabular-nums">{ fmt.Sprintf("%d", ad.Impressions) }</td>
										<td class="tabular-nums">{ fmt.Sprintf("%d", ad.Clicks) }</td>
										<td class="tabular-nums">{ fmt.Sprintf("%.1f%%", ad.CTR) }</td>
										<td>
											if ad.AdminStatus == "pending" {
												<span class="badge badge-sky font-bold text-xs">قيد المراجعة</span>
											} else if ad.AdminStatus == "approved" {
												<span class="badge badge-emerald font-bold text-xs">معتمد ✓</span>
											} else {
												<span class="badge badge-rose font-bold text-xs">مرفوض ✗</span>
											}
										</td>
										<td>
											if ad.AdminStatus == "pending" {
												<div style="display:flex; gap:0.5rem;">
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/ads/%d/approve", ad.ID)) } style="display:inline;">
														<button type="submit" class="btn btn-primary btn-xs font-bold">اعتماد</button>
													</form>
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/ads/%d/reject", ad.ID)) } style="display:inline;">
														<button type="submit" class="btn btn-secondary btn-xs">رفض</button>
													</form>
												</div>
											} else {
												<span class="text-muted text-xs">—</span>
											}
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

