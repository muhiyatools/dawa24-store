package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// SponsorshipRequestsData holds the vendor's sponsorship packages, purchases,
// active purchases (with remaining credits), and submitted requests.
type SponsorshipRequestsData struct {
	Packages        []*promo.OfferPackage
	Purchases        []*promo.SponsorshipPurchase
	ActivePurchases  []*promo.SponsorshipPurchase
	Requests        []*promo.SponsorshipRequest
	OrgID           int64
}

// AdminOffersPackagesHubPage renders monetization hub.
templ AdminOffersPackagesHubPage(lang, dir string) {
	@layouts.AdminShell("باقات العروض والرعايات الترويجية (Offers Packages)", "offers_packages", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">منظومة باقات العروض والرعايات والإعلانات</h2>
					<p class="subtitle">إدارة خطط الاشتراكات المميزة للموردين، باقات الظهور، والرعايات الرسمية.</p>
				</div>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1.25rem; margin-bottom:1.5rem;">
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md);">
					<h3 style="font-size:1.05rem; font-weight:700; margin-bottom:0.5rem;">باقات العروض (Packages)</h3>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:1rem;">تحديد الباقات المتاحة للموردين لنشر عدد أكبر من العروض المميزة.</p>
					<a href="/admin/offers-packages/packages" class="btn btn-secondary btn-sm">إدارة الباقات</a>
				</div>
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md);">
					<h3 style="font-size:1.05rem; font-weight:700; margin-bottom:0.5rem;">الرعايات الرسمية (Sponsorships)</h3>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:1rem;">عروض الرعاية المدفوعة لتثبيت ظهور عروض المورد في الصدارة.</p>
					<a href="/admin/offers-packages/sponsorships" class="btn btn-secondary btn-sm">إدارة الرعايات</a>
				</div>
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md);">
					<h3 style="font-size:1.05rem; font-weight:700; margin-bottom:0.5rem;">الحملات الترويجية (Promotions)</h3>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:1rem;">حملات الخصومات المؤقتة والموجهة جغرافياً للصيدليات.</p>
					<a href="/admin/offers-packages/promotions" class="btn btn-secondary btn-sm">إدارة الحملات</a>
				</div>
			</div>
		</div>
	}
}

// AdminOfferPackagesListPage renders packages list.
templ AdminOfferPackagesListPage(lang, dir string) {
	@layouts.AdminShell("باقات العروض", "offers_packages", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">باقات العروض للموردين</h2>
				</div>
				<a href="/admin/offers-packages" class="btn btn-secondary btn-sm">العودة للمركز</a>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "باقات العروض", Message: "تتيح باقات العروض للموردين نشر عروض متعددة مع ميزات تثبيت إضافية."})
		</div>
	}
}

// AdminOfferPackageDetailPage renders package detail.
templ AdminOfferPackageDetailPage(pkgID int64, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل الباقة #%d", pkgID), "offers_packages", lang, dir) {
		<div class="card max-w-2xl mx-auto">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">باقة العروض #{ fmt.Sprintf("%d", pkgID) }</h2>
				</div>
				<a href="/admin/offers-packages/packages" class="btn btn-secondary btn-sm">العودة</a>
			</div>
		</div>
	}
}

// AdminOfferSponsorshipsPage renders sponsorships and pending requests for admin review.
templ AdminOfferSponsorshipsPage(lang, dir string, requests []*promo.SponsorshipRequest) {
	@layouts.AdminShell("الرعايات الرسمية للعروض", "offers_packages", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">مراجعة طلبات الرعاية</h2>
					<p class="subtitle">اعتمد أو ارفض طلبات الرعاية المُقدّمة من الموردين. عند الاعتماد، يظهر العنصر في صدارة الكتالوج مع وسم "مُموف".</p>
				</div>
				<a href="/admin/offers-packages" class="btn btn-secondary btn-sm">العودة</a>
			</div>
			if len(requests) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات", Message: "لا توجد طلبات رعاية قيد المراجعة حالياً."})
			} else {
				<div class="table-wrapper">
					<table class="table">
						<thead>
							<tr>
								<th>المورد</th>
								<th>النوع</th>
								<th>العنصر</th>
								<th>الباقة</th>
								<th>المستوى</th>
								<th>الحالة</th>
								<th>تاريخ</th>
								<th>إجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, req := range requests {
								if req != nil {
									<tr>
										<td class="tabular-nums">{ fmt.Sprintf("#%d", req.OrganizationID) }</td>
										<td>
											if req.ItemType == "product" {
												<span>منتج</span>
											} else {
												<span>عرض</span>
											}
										</td>
										<td class="tabular-nums">{ fmt.Sprintf("#%d", req.ItemID) }</td>
										<td class="tabular-nums">{ fmt.Sprintf("#%d", req.PackageID) }</td>
										<td>
											if req.Package != nil {
												<span class="badge badge-amber font-bold text-xs" style="background:#fef3c7; color:#92400e; border:1px solid #fcd34d;">
													{ fmt.Sprintf("%d", req.Package.TierLevel) }
												</span>
											} else {
												<span class="text-muted text-xs">—</span>
											}
										</td>
										<td>
											if req.AdminStatus == "pending" {
												<span class="badge badge-sky font-bold text-xs">قيد المراجعة</span>
											} else if req.AdminStatus == "approved" {
												<span class="badge badge-emerald font-bold text-xs">معتمد ✓</span>
											} else {
												<span class="badge badge-rose font-bold text-xs">مرفوض ✗</span>
											}
										</td>
										<td class="text-xs tabular-nums">{ req.CreatedAt.Format("2006-01-02 15:04") }</td>
										<td>
											if req.AdminStatus == "pending" {
												<div style="display:flex; gap:0.5rem;">
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers-packages/sponsorships/%d/approve", req.ID)) } style="display:inline;">
														<button type="submit" class="btn btn-primary btn-xs font-bold">اعتماد</button>
													</form>
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers-packages/sponsorships/%d/reject", req.ID)) } style="display:inline;">
														<button type="submit" class="btn btn-secondary btn-xs" onclick="return confirm('هل أنت متأكد من رفض هذا الطلب؟')">رفض</button>
													</form>
												</div>
											} else {
												<span class="text-muted text-xs">—</span>
											}
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

