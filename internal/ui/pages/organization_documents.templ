package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/attachments"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ OrganizationDocuments(lang, dir string, data *OrganizationDocumentsData, perms []string) {
	if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
		@layouts.CustomerShell("مستندات المنشأة", "documents", lang, dir, perms) {
			@OrganizationDocumentsContent(lang, data)
		}
	} else {
		@layouts.VendorShell("مستندات المنشأة", "documents", lang, dir) {
			@OrganizationDocumentsContent(lang, data)
		}
	}
}

templ OrganizationDocumentsContent(lang string, data *OrganizationDocumentsData) {
	<div style="display:flex; flex-direction:column; gap:var(--space-5);">

		if data != nil && len(data.Missing) > 0 {
			<div style="background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; border-radius:var(--radius-lg); padding:var(--space-4); display:flex; gap:var(--space-3); align-items:flex-start;">
				@components.IconAlert("icon-md")
				<div style="font-size:var(--text-sm); line-height:1.6;">
					<strong>مستندات إلزامية غير معتمدة:</strong> { data.MissingTitles() }
					— لا يمكن إتمام العمليات (نشر العروض / إنهاء الطلبات) حتى اعتمادها.
				</div>
			</div>
		}

		if data != nil && data.Error != "" {
			<div style="background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; border-radius:var(--radius-lg); padding:var(--space-4); font-size:var(--text-sm);">
				{ data.Error }
			</div>
		}

		<div class="card" style="margin-bottom:0; padding:var(--space-5);">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-4);">
				<div>
					<h3 style="font-size:var(--text-lg); font-weight:800; color:var(--text); margin:0 0 2px;">مستندات المنشأة الرسمية</h3>
					<p style="font-size:var(--text-xs); color:var(--text-secondary); margin:0;">
						تُراجع الملفات من إدارة المنصة خلال 24 ساعة من رفعها.
					</p>
				</div>
			</div>

			if data == nil || len(data.Requirements) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد متطلبات",
					Message: "لا توجد مستندات مطلوبة لهذا النوع من الحسابات.",
				})
			} else {
				<div style="display:flex; flex-direction:column; gap:var(--space-4);">
				for _, req := range data.Requirements {
					if doc := data.LatestFor(req.DocType); true {
						<div style="border:1px solid var(--border); border-radius:var(--radius-lg); padding:var(--space-4); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:var(--space-3);">
							<div style="display:flex; align-items:center; gap:var(--space-3);">
								@components.IconFile("icon-lg")
								<div>
									<div style="font-weight:700; color:var(--text); font-size:var(--text-sm); display:flex; align-items:center; gap:var(--space-2);">
										{ req.TitleAr }
										if req.Required {
											<span class="badge badge-rose" style="font-size:10px;">إلزامي</span>
										} else {
											<span class="badge badge-slate" style="font-size:10px;">اختياري</span>
										}
									</div>
									<div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px;">
										if doc == nil {
											لم يُرفع بعد
										} else {
											{ doc.OriginalName }
											<span style="margin:0 6px; color:var(--border-strong);">|</span>
											{ format.Date(doc.CreatedAt, "ar") }
										}
									</div>
								</div>
							</div>

							<div style="display:flex; align-items:center; gap:var(--space-3); flex-wrap:wrap;">
								if doc != nil {
									<span style="display:inline-flex; align-items:center; gap:var(--space-1);">
										switch doc.Status {
											case attachments.StatusVerified:
												<span class="badge badge-emerald">معتمد</span>
											case attachments.StatusRejected:
												<span class="badge badge-rose">مرفوض</span>
											default:
												<span class="badge badge-amber">قيد التدقيق</span>
										}
									</span>
									if doc.Status == attachments.StatusRejected && doc.ReviewNotes != "" {
										<span style="font-size:var(--text-xs); color:#b91c1c; max-width:220px;" title={ doc.ReviewNotes }>
											{ doc.ReviewNotes }
										</span>
									}
									<a href={ templ.SafeURL(doc.FileURL) } target="_blank" class="btn btn-secondary btn-sm">
										<span>معاينة</span>
									</a>
								}

								if doc != nil && doc.Status != attachments.StatusVerified {
									<form action="/documents/delete" method="POST" style="margin:0; display:inline;">
										<input type="hidden" name="id" value={ fmt.Sprintf("%d", doc.ID) } />
										<button type="submit" class="btn btn-secondary btn-sm" style="color:#b91c1c;">
											<span>حذف</span>
										</button>
									</form>
								}

								<form action="/documents/upload" method="POST" enctype="multipart/form-data" style="margin:0; display:inline-flex; gap:var(--space-2); align-items:center;">
									<input type="hidden" name="document_type" value={ string(req.DocType) } />
									<input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.webp" required class="form-input" style="padding:0.35rem; font-size:var(--text-xs); max-width:200px;" />
									<button type="submit" class="btn btn-primary btn-sm">
										if doc == nil {
											<span>رفع</span>
										} else {
											<span>استبدال</span>
										}
									</button>
								</form>
							</div>
						</div>
						}
					}
				</div>
			}
		</div>
	</div>
}
