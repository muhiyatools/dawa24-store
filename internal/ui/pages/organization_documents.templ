package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/attachments"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ OrganizationDocuments(lang, dir string, data *OrganizationDocumentsData, perms []string) {
	@layouts.ShellFor("المستندات والتراخيص الرسمية", "documents", lang, dir, authctx.FromContext(ctx)) {
		@OrganizationDocumentsContent(lang, data)
	}
}

templ OrganizationDocumentsContent(lang string, data *OrganizationDocumentsData) {
	<div class="jobs-container" style="max-width:1300px; margin:0 auto; padding-bottom:3.5rem; display:flex; flex-direction:column; gap:1.5rem;">

		<!-- Header Banner -->
		<div class="jobs-header" style="margin-bottom:0; display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
			<div>
				<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.35rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-xl); background:rgba(37, 99, 235, 0.1); color:var(--primary); display:flex; align-items:center; justify-content:center; font-size:1.4rem; border:1px solid rgba(37, 99, 235, 0.2);">
						📑
					</div>
					<div>
						<h1 style="font-size:1.5rem; font-weight:900; color:var(--text); margin:0;">
							المستندات والتراخيص الرسمية للمنشأة
						</h1>
						<span style="font-size:0.775rem; color:var(--text-muted); font-weight:700;">Legal Compliance & Official Licensing Records</span>
					</div>
				</div>
				<p style="font-size:0.875rem; color:var(--text-secondary); margin:0; line-height:1.6; max-width:760px;">
					إدارة وتوثيق التراخيص والسجلات القانونية لضمان مطابقة اشتراطات هيئة الدواء المصرية وبدء التداول والتعاملات الرسمية بأمان تام.
				</p>
			</div>

			<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
				if data != nil && data.VerifiedCount() > 0 && len(data.Missing) == 0 {
					<div class="badge badge-emerald" style="padding:0.55rem 1rem; font-size:0.825rem; font-weight:800; gap:0.4rem;">
						@components.IconCheckCircle("icon-xs")
						<span>موثق ومعتمد رسمياً ✓</span>
					</div>
				} else if data != nil && data.PendingCount() > 0 {
					<div class="badge badge-sky" style="padding:0.55rem 1rem; font-size:0.825rem; font-weight:800; gap:0.4rem;">
						@components.IconClock("icon-xs")
						<span>قيد المراجعة والتدقيق</span>
					</div>
				} else {
					<div class="badge badge-amber" style="padding:0.55rem 1rem; font-size:0.825rem; font-weight:800; gap:0.4rem;">
						@components.IconAlert("icon-xs")
						<span>مستندات مطلوبة للتفعيل</span>
					</div>
				}
			</div>
		</div>

		<!-- Executive Verification Strip (3-stat Grid) -->
		if data != nil {
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem;">
				
				<!-- Card 1: Completion Progress -->
				<div class="card" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center;">
							<span style="font-size:0.825rem; font-weight:700; color:var(--text-secondary);">نسبة اكتمال التوثيق</span>
							<span class="badge badge-sky text-xs fw-800 tabular-nums">{ fmt.Sprintf("%d / %d", data.VerifiedCount(), data.TotalRequirementsCount()) }</span>
						</div>
						<div class="tabular-nums" style="font-size:2rem; font-weight:900; color:var(--primary); margin-top:0.35rem; line-height:1.2;">
							{ fmt.Sprintf("%d%%", data.CompletionPercentage()) }
						</div>
						<!-- Dynamic Progress Bar -->
						<div style="width:100%; height:8px; background:var(--surface-sunken); border-radius:4px; margin-top:0.6rem; overflow:hidden; border:1px solid var(--border-subtle);">
							<div style={ fmt.Sprintf("height:100%%; width:%d%%; border-radius:4px; background:linear-gradient(90deg, var(--primary), #10b981); transition:width 0.4s ease;", data.CompletionPercentage()) }></div>
						</div>
					</div>
					<div style="font-size:0.775rem; color:var(--text-muted); margin-top:0.75rem; padding-top:0.5rem; border-top:1px solid var(--border);">
						<span>{ fmt.Sprintf("%d مستندات معتمدة ومطابقة", data.VerifiedCount()) }</span>
					</div>
				</div>

				<!-- Card 2: Legal Status -->
				<div class="card" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
					<div>
						<span style="font-size:0.825rem; font-weight:700; color:var(--text-secondary);">حالة الحساب والاعتماد</span>
						<div style="margin-top:0.4rem; display:flex; align-items:center; gap:0.6rem;">
							if data.VerifiedCount() > 0 && len(data.Missing) == 0 {
								<span style="width:12px; height:12px; border-radius:50%; background:var(--emerald); display:inline-block; box-shadow:0 0 0 3px rgba(16,185,129,0.2);"></span>
								<strong style="font-size:1.1rem; font-weight:900; color:var(--text);">منشأة موثقة ومطابقة</strong>
							} else if data.PendingCount() > 0 {
								<span style="width:12px; height:12px; border-radius:50%; background:var(--sky); display:inline-block; box-shadow:0 0 0 3px rgba(2,132,199,0.2);"></span>
								<strong style="font-size:1.1rem; font-weight:900; color:var(--text);">قيد التدقيق الإداري</strong>
							} else {
								<span style="width:12px; height:12px; border-radius:50%; background:var(--amber); display:inline-block; box-shadow:0 0 0 3px rgba(245,158,11,0.2);"></span>
								<strong style="font-size:1.1rem; font-weight:900; color:var(--text);">بانتظار استكمال المستندات</strong>
							}
						</div>
					</div>
					<div style="font-size:0.775rem; color:var(--text-muted); margin-top:0.75rem; padding-top:0.5rem; border-top:1px solid var(--border);">
						<span>تتم مراجعة كافة المستندات الرسمية المرفوعة خلال 24 ساعة</span>
					</div>
				</div>

				<!-- Card 3: Official Requests Status -->
				<div class="card" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
					<div>
						<span style="font-size:0.825rem; font-weight:700; color:var(--text-secondary);">طلبات الإدارة والمهل</span>
						<div class="tabular-nums" style="font-size:2rem; font-weight:900; color:var(--text); margin-top:0.35rem; line-height:1.2;">
							{ fmt.Sprintf("%d", len(data.ActiveDocRequests())) } <span style="font-size:0.85rem; font-weight:700; color:var(--text-muted);">طلبات معلقة</span>
						</div>
					</div>
					<div style="font-size:0.775rem; color:var(--text-muted); margin-top:0.75rem; padding-top:0.5rem; border-top:1px solid var(--border);">
						if len(data.ActiveDocRequests()) > 0 {
							<span class="text-amber fw-800">⚠️ يوجد مستندات مطلوبة من إدارة المنصة</span>
						} else {
							<span class="text-emerald fw-800">✓ لا توجد طلبات مستندات معلقة حالياً</span>
						}
					</div>
				</div>

			</div>
		}

		<!-- Missing Mandatory Documents Warning -->
		if data != nil && len(data.Missing) > 0 {
			<div class="card" style="margin:0; padding:1rem 1.25rem; background:rgba(239, 68, 68, 0.06); border:1px solid rgba(239, 68, 68, 0.25); border-radius:var(--radius-xl); display:flex; align-items:center; gap:0.85rem;">
				<div style="color:var(--rose); flex-shrink:0; font-size:1.4rem;">
					⚠️
				</div>
				<div style="font-size:0.85rem; color:var(--rose-dark, #991b1b); line-height:1.5;">
					<strong>تنبيه توثيق الحساب:</strong> يتطلب تفعيل الحساب وإتمام المعاملات اعتماد { data.MissingTitles() } من إدارة المنصة.
				</div>
			</div>
		}

		<!-- Error Message Banner -->
		if data != nil && data.Error != "" {
			<div class="card" style="margin:0; padding:1rem 1.25rem; background:rgba(239, 68, 68, 0.06); border:1px solid rgba(239, 68, 68, 0.25); border-radius:var(--radius-xl); color:var(--rose); font-size:0.875rem;">
				{ data.Error }
			</div>
		}

		<!-- SECTION 1: Administrative Document Requests (If any) -->
		if data != nil && len(data.Requests) > 0 {
			<div class="card" style="margin:0; padding:1.35rem; border:1px solid rgba(245, 158, 11, 0.35); background:rgba(245, 158, 11, 0.04); border-radius:var(--radius-xl);">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
					<div style="display:flex; align-items:center; gap:0.6rem;">
						<div style="color:#d97706; font-size:1.3rem;">
							⏳
						</div>
						<div>
							<h3 style="font-size:1.05rem; font-weight:800; color:#b45309; margin:0;">
								مستندات وتراخيص مطلوبة من إدارة المنصة
							</h3>
							<p style="font-size:0.775rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								يرجى رفع المستندات المحددة أدناه خلال المهلة الزمنية المقررة لضمان استمرار تفعيل حساب المنشأة.
							</p>
						</div>
					</div>
				</div>

				<div style="display:flex; flex-direction:column; gap:0.75rem;">
					for _, req := range data.Requests {
						if req != nil {
							<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.1rem 1.25rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; box-shadow:var(--shadow-xs);">
								<div style="max-width:600px;">
									<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
										<strong style="font-size:0.95rem; color:var(--text);">{ req.Title }</strong>
										if req.Status == attachments.DocReqFulfilled {
											<span class="badge badge-emerald text-xs fw-800">معتمد ومطابق ✓</span>
										} else if req.Status == attachments.DocReqSubmitted {
											<span class="badge badge-sky text-xs fw-800">تم الرفع (قيد المراجعة)</span>
										} else if req.IsOverdue() {
											<span class="badge badge-rose text-xs fw-800">انتهت المهلة ⚠️</span>
										} else {
											<span class="badge badge-amber text-xs fw-800">متبقي { fmt.Sprintf("%d", req.DaysRemaining()) } يوم</span>
										}
									</div>
									if req.Description != "" {
										<div style="font-size:0.825rem; color:var(--text-secondary); margin-top:0.35rem; line-height:1.4;">
											{ req.Description }
										</div>
									}
									<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.4rem;">
										الموعد النهائي: <strong class="tabular-nums text-primary">{ format.Date(req.DeadlineAt, "ar") }</strong>
									</div>
								</div>

								<div>
									if req.Status == attachments.DocReqPending {
										<form action="/documents/upload" method="POST" enctype="multipart/form-data" style="margin:0; display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
											<input type="hidden" name="request_id" value={ fmt.Sprintf("%d", req.ID) } />
											<input type="hidden" name="document_type" value={ string(req.DocumentType) } />
											<input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.webp" required class="form-control" style="max-width:220px; font-size:0.8rem; height:36px;" />
											<button type="submit" class="btn btn-primary btn-sm fw-800" style="height:36px; padding:0 1rem;">
												@components.IconUpload("icon-xs")
												<span>رفع المستند</span>
											</button>
										</form>
									} else if req.Status == attachments.DocReqSubmitted {
										<div style="display:flex; align-items:center; gap:0.4rem; font-size:0.825rem; font-weight:800; color:var(--primary);">
											@components.IconClock("icon-xs")
											<span>تم الرفع وبانتظار اعتماد الإدارة</span>
										</div>
									}
								</div>
							</div>
						}
					}
				</div>
			</div>
		}

		<!-- SECTION 2: Official Organization Documents Grid -->
		<div class="card" style="margin:0; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border); background:var(--surface-raised); box-shadow:var(--shadow-xs);">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
				<div>
					<h3 style="font-size:1.15rem; font-weight:900; color:var(--text); margin:0 0 0.2rem 0;">
						قائمة التراخيص والمستندات القانونية
					</h3>
					<p style="font-size:0.8rem; color:var(--text-secondary); margin:0;">
						يمكنك رفع المستندات بصيغة (PDF، PNG، JPG، WebP) بحد أقصى 20 ميجابايت للملف.
					</p>
				</div>
			</div>

			if data == nil || len(data.Requirements) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد متطلبات",
					Message: "لا توجد مستندات مطلوبة لهذا النوع من الحسابات.",
				})
			} else {
				<div style="display:flex; flex-direction:column; gap:1rem;">
					for _, req := range data.Requirements {
						{{ doc := data.LatestFor(req.DocType) }}
						<div
							class="doc-requirement-card"
							style="border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.35rem; background:var(--surface); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem; transition:box-shadow 0.2s ease, border-color 0.2s ease;"
						>
							<!-- Document Info -->
							<div style="display:flex; align-items:flex-start; gap:1rem; max-width:640px;">
								<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--surface-sunken); border:1px solid var(--border); color:var(--primary); display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:1.3rem; margin-top:2px;">
									if doc != nil && doc.Status == attachments.StatusVerified {
										<span style="color:var(--emerald);">✓</span>
									} else {
										<span>📄</span>
									}
								</div>
								<div>
									<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
										<h4 style="font-size:0.975rem; font-weight:800; color:var(--text); margin:0;">
											{ req.TitleAr }
										</h4>
										if req.Required {
											<span class="badge badge-rose text-xs fw-800">إلزامي</span>
										} else {
											<span class="badge badge-slate text-xs fw-700">اختياري</span>
										}

										<!-- Status Pill -->
										if doc != nil {
											switch doc.Status {
												case attachments.StatusVerified:
													<span class="badge badge-emerald text-xs fw-800">معتمد ومطابق ✓</span>
												case attachments.StatusRejected:
													<span class="badge badge-rose text-xs fw-800">مرفوض ✗</span>
												default:
													<span class="badge badge-sky text-xs fw-800">قيد التدقيق والمراجعة</span>
											}
										} else {
											<span class="badge badge-slate text-xs">لم يُرفع بعد</span>
										}
									</div>

									if req.Description != "" {
										<p style="font-size:0.8rem; color:var(--text-secondary); margin:0.25rem 0 0 0; line-height:1.4;">
											{ req.Description }
										</p>
									}

									<!-- File Meta -->
									if doc != nil {
										<div style="display:flex; align-items:center; gap:0.6rem; font-size:0.75rem; color:var(--text-muted); margin-top:0.4rem; flex-wrap:wrap;">
											<span style="font-weight:700; color:var(--text);" dir="ltr">{ doc.OriginalName }</span>
											<span style="color:var(--border-strong);">•</span>
											if doc.SizeBytes > 0 {
												<span class="tabular-nums">{ format.Bytes(doc.SizeBytes) }</span>
												<span style="color:var(--border-strong);">•</span>
											}
											<span class="tabular-nums">تاريخ الرفع: { format.Date(doc.CreatedAt, "ar") }</span>
										</div>

										if doc.Status == attachments.StatusRejected && doc.ReviewNotes != "" {
											<div style="margin-top:0.4rem; padding:0.35rem 0.65rem; background:rgba(239, 68, 68, 0.08); border-radius:var(--radius-sm); border:1px solid rgba(239, 68, 68, 0.2); font-size:0.775rem; color:var(--rose);">
												<strong>سبب الرفض:</strong> { doc.ReviewNotes }
											</div>
										}
									}
								</div>
							</div>

							<!-- Actions & Upload / Replace Buttons -->
							<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
								if doc != nil {
									<!-- View Button: Triggers Dynamic In-App Viewer Modal -->
									<button
										type="button"
										class="btn btn-secondary btn-sm fw-700"
										style="gap:0.35rem; height:34px;"
										onclick={ templ.ComponentScript{Call: fmt.Sprintf("openDocViewer(%d, %q, %q, %q, %q, %q)", doc.ID, req.TitleAr, string(doc.DocumentType), doc.OriginalName, string(doc.Status), doc.FileURL)} }
									>
										@components.IconEye("icon-xs")
										<span>معاينة</span>
									</button>

									<!-- Direct Download Button -->
									<a
										href={ templ.SafeURL(fmt.Sprintf("/documents/%d/download", doc.ID)) }
										class="btn btn-secondary btn-sm"
										style="height:34px; display:inline-flex; align-items:center; justify-content:center;"
										title="تحميل الملف إلى جهازك"
									>
										@components.IconDownload("icon-xs")
									</a>

									<!-- Replace Document Button (Opens Replacement Reason Modal) -->
									<button
										type="button"
										class="btn btn-secondary btn-sm fw-700"
										style="gap:0.35rem; height:34px;"
										onclick={ templ.ComponentScript{Call: fmt.Sprintf("openReplaceDocModal(%d, %q, %q, %q)", doc.ID, string(req.DocType), req.TitleAr, doc.OriginalName)} }
										title="استبدال وتحديث هذا المستند"
									>
										<span>🔄 استبدال المستند</span>
									</button>
								} else {
									<!-- Initial Upload Form (When doc is not uploaded yet) -->
									<form action="/documents/upload" method="POST" enctype="multipart/form-data" style="margin:0; display:inline-flex; gap:0.4rem; align-items:center;">
										<input type="hidden" name="document_type" value={ string(req.DocType) } />
										<input
											type="file"
											name="file"
											id={ fmt.Sprintf("file-input-%s", req.DocType) }
											accept=".pdf,.png,.jpg,.jpeg,.webp"
											required
											class="form-control"
											style="padding:0.25rem 0.5rem; font-size:0.775rem; max-width:180px; height:34px;"
										/>
										<button type="submit" class="btn btn-primary btn-sm fw-700" style="height:34px;">
											<span>رفع المستند</span>
										</button>
									</form>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>

	</div>

	<!-- Dynamic In-App Document Viewer Modal (PDF + Image Responsive) -->
	<div id="doc-viewer-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:99999; align-items:center; justify-content:center; padding:1rem; backdrop-filter:blur(4px);">
		<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); width:100%; max-width:980px; box-shadow:var(--shadow-2xl); overflow:hidden; display:flex; flex-direction:column; max-height:92vh;">
			<!-- Modal Header -->
			<div style="padding:1rem 1.5rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; background:var(--surface-sunken); flex-wrap:wrap; gap:0.75rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.5rem;">
						<span style="font-size:1.25rem;">📑</span>
						<h3 id="modal-doc-title" style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">
							معاينة المستند الرسمي
						</h3>
					</div>
					<div id="modal-doc-filename" style="font-size:0.775rem; color:var(--text-muted); font-family:monospace; margin-top:2px;" dir="ltr">
						filename.pdf
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.5rem;">
					<a
						id="modal-doc-tab-btn"
						href="#"
						target="_blank"
						class="btn btn-secondary btn-sm fw-700"
						style="gap:0.35rem;"
					>
						@components.IconExternalLink("icon-xs")
						<span>فتح في نافذة جديدة ↗</span>
					</a>
					<a
						id="modal-doc-download-btn"
						href="#"
						class="btn btn-primary btn-sm fw-800"
						style="gap:0.35rem;"
					>
						@components.IconDownload("icon-xs")
						<span>تحميل الملف</span>
					</a>
					<button
						type="button"
						onclick="closeDocViewer()"
						style="background:none; border:none; font-size:1.4rem; color:var(--text-muted); cursor:pointer; padding:0 0.5rem; line-height:1;"
					>
						✕
					</button>
				</div>
			</div>

			<!-- Dynamic Interactive Viewer Viewport -->
			<div id="modal-doc-viewport" style="width:100%; height:72vh; background:var(--surface-sunken); overflow:auto; display:flex; align-items:center; justify-content:center; position:relative; padding:0.5rem;">
				<!-- Mode 1: PDF Viewer Iframe -->
				<iframe
					id="modal-doc-iframe"
					src="about:blank"
					style="width:100%; height:100%; border:none; border-radius:var(--radius-md); display:none;"
					loading="lazy"
				></iframe>

				<!-- Mode 2: Image Viewer -->
				<div id="modal-doc-img-container" style="display:none; width:100%; height:100%; align-items:center; justify-content:center; overflow:auto;">
					<img
						id="modal-doc-img"
						src=""
						alt="معاينة المستند"
						style="max-width:100%; max-height:100%; object-fit:contain; border-radius:var(--radius-md); box-shadow:var(--shadow-md);"
					/>
				</div>
			</div>

			<!-- Modal Footer -->
			<div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 1.5rem; border-top:1px solid var(--border); background:var(--surface); font-size:0.8rem; color:var(--text-muted);">
				<span>🔒 مستند رقمي مشفر ومحمي لمنشأتك فقط</span>
				<button
					type="button"
					class="btn btn-secondary btn-sm"
					onclick="closeDocViewer()"
				>
					إغلاق المعاينة
				</button>
			</div>
		</div>
	</div>

	<!-- Modal: Replace Document Modal with Replacement Reason -->
	<div id="replace-doc-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:99999; align-items:center; justify-content:center; padding:1rem; backdrop-filter:blur(4px);">
		<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); width:100%; max-width:580px; box-shadow:var(--shadow-2xl); overflow:hidden; display:flex; flex-direction:column;">
			<!-- Header -->
			<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; background:var(--surface-sunken);">
				<div style="display:flex; align-items:center; gap:0.6rem;">
					<span style="font-size:1.4rem;">🔄</span>
					<div>
						<h3 id="replace-modal-title" style="font-size:1.15rem; font-weight:900; color:var(--text); margin:0;">
							استبدال وتحديث المستند
						</h3>
						<div id="replace-modal-subtitle" style="font-size:0.775rem; color:var(--text-muted); margin-top:2px;">
							رفع نسخة جديدة مع توضيح سبب الاستبدال
						</div>
					</div>
				</div>
				<button
					type="button"
					onclick="closeReplaceDocModal()"
					style="background:none; border:none; font-size:1.3rem; color:var(--text-muted); cursor:pointer; padding:0 0.4rem; line-height:1;"
				>
					✕
				</button>
			</div>

			<!-- Body Form -->
			<form action="/documents/upload" method="POST" enctype="multipart/form-data" style="padding:1.5rem; display:flex; flex-direction:column; gap:1.25rem; margin:0;">
				<input type="hidden" name="document_type" id="replace-doc-type" value="" />
				<input type="hidden" name="existing_doc_id" id="replace-existing-id" value="" />

				<!-- Current File Info Box -->
				<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem; display:flex; align-items:center; justify-content:space-between; font-size:0.825rem;">
					<span style="color:var(--text-secondary); font-weight:700;">الملف الحالي المسجل:</span>
					<span id="replace-modal-current-file" style="font-weight:800; color:var(--primary); font-family:monospace;" dir="ltr">file.pdf</span>
				</div>

				<!-- New File Upload Field -->
				<div>
					<label class="form-label" style="font-size:0.85rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
						اختر ملف المستند الجديد <span class="text-rose fw-800">*</span>
					</label>
					<input
						type="file"
						name="file"
						required
						accept=".pdf,.png,.jpg,.jpeg,.webp"
						class="form-control"
						style="padding:0.5rem 0.75rem; font-size:0.85rem; width:100%; border-radius:var(--radius-lg);"
					/>
					<span style="font-size:0.75rem; color:var(--text-muted); margin-top:0.35rem; display:block;">
						الصيغ المقبولة: PDF أو صور (PNG, JPG, WebP) بحجم أقصى 20 ميجابايت.
					</span>
				</div>

				<!-- Replacement Reason Field -->
				<div>
					<label class="form-label" style="font-size:0.85rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
						سبب استبدال / تحديث المستند <span class="text-rose fw-800">*</span>
					</label>
					<textarea
						name="replacement_reason"
						id="replace-doc-reason"
						required
						rows="3"
						class="form-control"
						placeholder="يرجى توضيح سبب الاستبدال لإدارة المنصة (مثال: تجديد ترخيص المنشأة السنوي، تصحيح خطأ بالصورة السابقة، صدور سجل تجاري محدث...)"
						style="width:100%; font-size:0.85rem; padding:0.65rem 0.85rem; border-radius:var(--radius-lg); resize:vertical;"
					></textarea>
				</div>

				<!-- Footer Actions -->
				<div style="display:flex; justify-content:flex-end; gap:0.75rem; padding-top:0.75rem; border-top:1px solid var(--border); margin-top:0.25rem;">
					<button
						type="button"
						class="btn btn-secondary"
						onclick="closeReplaceDocModal()"
					>
						إلغاء
					</button>
					<button
						type="submit"
						class="btn btn-primary"
						style="font-weight:850; padding:0 1.5rem; gap:0.4rem;"
					>
						<span>تأكيد واستبدال المستند 🔄</span>
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Viewer & Replace Modal Logic Scripts -->
	<script>
		function openDocViewer(docId, title, docType, originalName, status, rawUrl) {
			const viewUrl = '/documents/' + docId + '/view';
			const downloadUrl = '/documents/' + docId + '/download';

			const titleEl = document.getElementById('modal-doc-title');
			const filenameEl = document.getElementById('modal-doc-filename');
			const tabBtn = document.getElementById('modal-doc-tab-btn');
			const downloadBtn = document.getElementById('modal-doc-download-btn');
			const iframe = document.getElementById('modal-doc-iframe');
			const imgContainer = document.getElementById('modal-doc-img-container');
			const img = document.getElementById('modal-doc-img');
			const modal = document.getElementById('doc-viewer-modal');

			if (titleEl) titleEl.textContent = title;
			if (filenameEl) filenameEl.textContent = originalName || ('Document #' + docId);
			if (tabBtn) tabBtn.href = viewUrl;
			if (downloadBtn) downloadBtn.href = downloadUrl;

			const ext = (originalName || '').split('.').pop().toLowerCase();
			const isImage = ['png', 'jpg', 'jpeg', 'webp', 'svg', 'gif'].includes(ext);

			if (isImage) {
				if (iframe) {
					iframe.style.display = 'none';
					iframe.src = 'about:blank';
				}
				if (img && imgContainer) {
					img.src = viewUrl;
					imgContainer.style.display = 'flex';
				}
			} else {
				if (imgContainer) imgContainer.style.display = 'none';
				if (iframe) {
					iframe.src = viewUrl;
					iframe.style.display = 'block';
				}
			}

			if (modal) {
				modal.style.display = 'flex';
			}
		}

		function closeDocViewer() {
			const modal = document.getElementById('doc-viewer-modal');
			const iframe = document.getElementById('modal-doc-iframe');
			const img = document.getElementById('modal-doc-img');
			if (modal) modal.style.display = 'none';
			if (iframe) iframe.src = 'about:blank';
			if (img) img.src = '';
		}

		function openReplaceDocModal(docId, docType, titleAr, origName) {
			const modal = document.getElementById('replace-doc-modal');
			const titleEl = document.getElementById('replace-modal-title');
			const currFileEl = document.getElementById('replace-modal-current-file');
			const docTypeInput = document.getElementById('replace-doc-type');
			const existingIdInput = document.getElementById('replace-existing-id');
			const reasonInput = document.getElementById('replace-doc-reason');

			if (titleEl) titleEl.textContent = 'استبدال مستند: ' + (titleAr || '');
			if (currFileEl) currFileEl.textContent = origName || ('مستند #' + docId);
			if (docTypeInput) docTypeInput.value = docType || '';
			if (existingIdInput) existingIdInput.value = docId || '';
			if (reasonInput) reasonInput.value = '';

			if (modal) {
				modal.style.display = 'flex';
			}
		}

		function closeReplaceDocModal() {
			const modal = document.getElementById('replace-doc-modal');
			if (modal) {
				modal.style.display = 'none';
			}
		}

		// Close modals on backdrop click
		window.addEventListener('click', function(e) {
			const viewModal = document.getElementById('doc-viewer-modal');
			const replModal = document.getElementById('replace-doc-modal');
			if (e.target === viewModal) closeDocViewer();
			if (e.target === replModal) closeReplaceDocModal();
		});
	</script>
}
