package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ AdminCitiesModals(data AdminCitiesData) {
	<!-- Dynamic Alpine Centered Edit City Modal with Leaflet Map -->
	<div
		x-show="isEditOpen"
		x-cloak
		class="modal-backdrop fixed inset-0 z-50 d-flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
		@click.self="closeEdit()"
		@keydown.escape.window="closeEdit()"
	>
		<div
			class="glass-panel p-5 w-full max-w-3xl max-h-[85vh] d-flex flex-col shadow-2xl rounded-2xl border"
			@click.stop
		>
			<!-- Sticky Modal Header -->
			<div class="flex-between items-center pb-3 mb-3 border-b flex-shrink-0">
				<div class="d-flex items-center gap-2.5">
					<div class="w-8 h-8 rounded-lg bg-sky-500/10 text-sky-600 d-flex items-center justify-center border border-sky-500/20">
						@components.IconEdit("icon-xs")
					</div>
					<div>
						<h3 class="text-base font-black text-primary m-0">
							تعديل بيانات المدينة / الحي
						</h3>
						<div class="text-2xs text-secondary mt-0.5">تحديث الاسم والمحافظة والإحداثيات الجغرافية على الخريطة</div>
					</div>
				</div>
				<button type="button" @click="closeEdit()" class="btn btn-secondary btn-xs btn-icon">
					@components.IconClose("icon-xs")
				</button>
			</div>

			<!-- Scrollable Form Body with Custom Scrollbar -->
			<form :action="'/admin/cities/' + editForm.id + '/edit'" method="POST" class="flex-1 overflow-y-auto custom-scrollbar p-1 d-flex flex-col gap-3 m-0">
				<div class="d-grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
					<!-- Right Column: Basic Information & Coverage -->
					<div class="d-flex flex-col gap-3">
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold mb-1">
								المحافظة التابعة <span class="text-danger">*</span>
							</label>
							<select name="governorate_id" x-model="editForm.gov_id" required class="form-input text-xs w-full font-bold" data-gov-selector>
								<option value="" data-lat="30.0444" data-lng="31.2357">-- اختر المحافظة --</option>
								for _, g := range data.Governorates {
									<option 
										value={ fmt.Sprintf("%d", g.ID) } 
										data-lat={ fmt.Sprintf("%.6f", g.Latitude) } 
										data-lng={ fmt.Sprintf("%.6f", g.Longitude) }
									>
										{ g.Name["ar"] } ({ g.Name["en"] })
									</option>
								}
							</select>
						</div>

						<div class="d-grid grid-cols-2 gap-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold mb-1">
									الاسم بالعربية <span class="text-danger">*</span>
								</label>
								<input type="text" name="name_ar" x-model="editForm.name_ar" required placeholder="مثال: مدينة نصر" class="form-input text-xs w-full"/>
							</div>
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold mb-1">
									الاسم بالإنجليزية
								</label>
								<input type="text" name="name_en" x-model="editForm.name_en" placeholder="Nasr City" class="form-input text-xs w-full"/>
							</div>
						</div>

						<div class="form-group mb-0">
							<div class="flex-between items-center mb-1">
								<label class="form-label text-xs font-bold mb-0">
									نطاق التغطية الجغرافي للمدينة
								</label>
								<span class="text-xs font-black text-brand tabular-nums" x-text="editForm.radius ? (editForm.radius >= 1000 ? (editForm.radius / 1000).toFixed(1) + ' كم' : editForm.radius + ' متر') : '3.0 كم'"></span>
							</div>
							<div class="d-flex items-center gap-2">
								<input
									type="number"
									name="coverage_radius_meters"
									data-map-input="radius"
									x-model="editForm.radius"
									@input="setCityRadius(editForm.radius)"
									min="500"
									max="50000"
									step="500"
									placeholder="3000"
									class="form-input text-xs w-full font-mono font-bold"
								/>
								<span class="text-xs text-muted font-bold whitespace-nowrap">متر</span>
							</div>
							<div class="d-flex flex-wrap gap-1 mt-1.5">
								<button type="button" @click="setCityRadius(1500)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">1.5 كم</button>
								<button type="button" @click="setCityRadius(3000)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">3 كم (افتراضي)</button>
								<button type="button" @click="setCityRadius(5000)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">5 كم</button>
								<button type="button" @click="setCityRadius(10000)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">10 كم</button>
							</div>
						</div>

						<div class="p-2.5 bg-surface-sunken border rounded-xl d-flex items-center justify-between text-xs">
							<a :href="editForm.map_link" target="_blank" rel="noopener noreferrer" class="text-brand font-bold text-decoration-none d-flex items-center gap-1">
								@components.IconGlobe("icon-2xs")
								<span>معاينة على خرائط جوجل</span>
							</a>
						</div>

						<div class="d-flex gap-4 p-2.5 bg-surface-sunken border rounded-xl">
							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_capital" value="true" x-model="editForm.is_capital" class="form-checkbox"/>
								<span>عاصمة / مركز رئيسي</span>
							</label>

							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_active" value="true" x-model="editForm.is_active" class="form-checkbox"/>
								<span>حالة التفعيل (نشطة)</span>
							</label>
						</div>
					</div>

					<!-- Left Column: Interactive Map Picker & Coordinates -->
					<div class="d-flex flex-col gap-2">
						<label class="form-label text-xs font-bold mb-0 d-block">
							الموقع الجغرافي على الخريطة <span class="text-secondary font-normal">(انقر لتحديد المركز)</span>
						</label>
						<div
							id="edit-city-map-picker"
							data-map-picker
							data-default-lat="30.0444"
							data-default-lon="31.2357"
							data-default-radius="3000"
							class="rounded-xl overflow-hidden border bg-surface-sunken position-relative shadow-xs"
						>
							<div class="map-container map-canvas h-44 w-full relative z-1"></div>
							<div class="flex-between p-2 bg-surface-raised border-t text-2xs flex-wrap gap-2">
								<div class="d-flex items-center gap-1.5">
									<span class="text-secondary font-bold">الإحداثيات:</span>
									<span data-map-coords-badge class="tabular-nums font-black text-primary font-mono" x-text="(editForm.lat || '30.0444') + ', ' + (editForm.lon || '31.2357')"></span>
								</div>
								<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold gap-1 py-0.5">
									<span>موقعي الحالي</span>
								</button>
							</div>
						</div>

						<div class="d-grid grid-cols-2 gap-2">
							<div>
								<label class="form-label text-2xs font-bold mb-1">خط العرض (Lat)</label>
								<input type="number" step="any" name="city_lat" data-map-input="lat" x-model="editForm.lat" placeholder="30.0444" class="form-input text-xs w-full font-mono"/>
							</div>
							<div>
								<label class="form-label text-2xs font-bold mb-1">خط الطول (Lon)</label>
								<input type="number" step="any" name="city_lon" data-map-input="lon" x-model="editForm.lon" placeholder="31.2357" class="form-input text-xs w-full font-mono"/>
							</div>
						</div>
					</div>
				</div>

				<!-- Sticky Modal Footer -->
				<div class="flex-between items-center pt-3 mt-3 border-t gap-3 flex-shrink-0">
					<button type="button" @click="closeEdit()" class="btn btn-secondary btn-sm font-bold text-xs flex-1">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary btn-sm font-black text-xs flex-1">
						@components.IconCheck("icon-xs")
						<span>حفظ التعديلات</span>
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Dynamic Alpine Centered Edit Governorate Modal with Leaflet Map -->
	<div
		x-show="isGovEditOpen"
		x-cloak
		class="modal-backdrop fixed inset-0 z-50 d-flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
		@click.self="closeGovEdit()"
		@keydown.escape.window="closeGovEdit()"
	>
		<div
			class="glass-panel p-5 w-full max-w-3xl max-h-[85vh] d-flex flex-col shadow-2xl rounded-2xl border"
			@click.stop
		>
			<!-- Sticky Modal Header -->
			<div class="flex-between items-center pb-3 mb-3 border-b flex-shrink-0">
				<div class="d-flex items-center gap-2.5">
					<div class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-600 d-flex items-center justify-center border border-indigo-500/20">
						@components.IconBank("icon-xs")
					</div>
					<div>
						<h3 class="text-base font-black text-primary m-0">
							تعديل بيانات المحافظة والموقع الجغرافي
						</h3>
						<div class="text-2xs text-secondary mt-0.5">تحديث الاسم والإحداثيات الجغرافية على الخريطة</div>
					</div>
				</div>
				<button type="button" @click="closeGovEdit()" class="btn btn-secondary btn-xs btn-icon">
					@components.IconClose("icon-xs")
				</button>
			</div>

			<!-- Scrollable Form Body with Custom Scrollbar -->
			<form :action="'/admin/governorates/' + govEditForm.id + '/edit'" method="POST" class="flex-1 overflow-y-auto custom-scrollbar p-1 d-flex flex-col gap-3 m-0">
				<div class="d-grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
					<!-- Right Column: Basic Information & Radius -->
					<div class="d-flex flex-col gap-3">
						<div class="d-grid grid-cols-2 gap-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold mb-1">
									اسم المحافظة بالعربية <span class="text-danger">*</span>
								</label>
								<input type="text" name="gov_name_ar" x-model="govEditForm.name_ar" required placeholder="مثال: الإسكندرية" class="form-input text-xs w-full"/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold mb-1">
									الاسم بالإنجليزية
								</label>
								<input type="text" name="gov_name_en" x-model="govEditForm.name_en" placeholder="Alexandria" class="form-input text-xs w-full"/>
							</div>
						</div>

						<div class="form-group mb-0">
							<div class="flex-between items-center mb-1">
								<label class="form-label text-xs font-bold mb-0">
									نطاق التغطية للمحافظة
								</label>
								<span class="text-xs font-black text-brand tabular-nums" x-text="govEditForm.radius ? (govEditForm.radius / 1000).toFixed(1) + ' كم' : '25.0 كم'"></span>
							</div>
							<div class="d-flex items-center gap-2">
								<input
									type="number"
									name="gov_coverage_radius_meters"
									data-map-input="radius"
									x-model="govEditForm.radius"
									@input="setGovRadius(govEditForm.radius)"
									min="5000"
									max="100000"
									step="1000"
									placeholder="25000"
									class="form-input text-xs w-full font-mono font-bold"
								/>
								<span class="text-xs text-muted font-bold whitespace-nowrap">متر</span>
							</div>
							<div class="d-flex flex-wrap gap-1 mt-1.5">
								<button type="button" @click="setGovRadius(15000)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">15 كم</button>
								<button type="button" @click="setGovRadius(25000)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">25 كم (افتراضي)</button>
								<button type="button" @click="setGovRadius(35000)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">35 كم</button>
								<button type="button" @click="setGovRadius(50000)" class="badge badge-sky cursor-pointer hover:opacity-80 text-2xs">50 كم</button>
							</div>
						</div>

						<div class="d-flex gap-4 p-2.5 bg-surface-sunken border rounded-xl">
							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_active" value="true" x-model="govEditForm.is_active" class="form-checkbox"/>
								<span>حالة التفعيل (نشطة ومعتمدة بالجمهورية)</span>
							</label>
						</div>
					</div>

					<!-- Left Column: Interactive Map Picker & Coordinates -->
					<div class="d-flex flex-col gap-2">
						<label class="form-label text-xs font-bold mb-0 d-block">
							الموقع الجغرافي لمركز المحافظة <span class="text-secondary font-normal">(انقر لتحديد المركز)</span>
						</label>
						<div
							id="edit-gov-map-picker"
							data-map-picker
							data-default-lat="30.0444"
							data-default-lon="31.2357"
							data-default-radius="25000"
							class="rounded-xl overflow-hidden border bg-surface-sunken position-relative shadow-xs"
						>
							<div class="map-container map-canvas h-44 w-full relative z-1"></div>
							<div class="flex-between p-2 bg-surface-raised border-t text-2xs flex-wrap gap-2">
								<div class="d-flex items-center gap-1.5">
									<span class="text-secondary font-bold">الإحداثيات:</span>
									<span data-map-coords-badge class="tabular-nums font-black text-primary font-mono" x-text="(govEditForm.lat || '30.0444') + ', ' + (govEditForm.lon || '31.2357')"></span>
								</div>
								<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold gap-1 py-0.5">
									<span>موقعي الحالي</span>
								</button>
							</div>
						</div>

						<div class="d-grid grid-cols-2 gap-2">
							<div>
								<label class="form-label text-2xs font-bold mb-1">خط العرض (Lat)</label>
								<input type="number" step="any" name="gov_lat" data-map-input="lat" x-model="govEditForm.lat" placeholder="30.0444" class="form-input text-xs w-full font-mono"/>
							</div>
							<div>
								<label class="form-label text-2xs font-bold mb-1">خط الطول (Lon)</label>
								<input type="number" step="any" name="gov_lon" data-map-input="lon" x-model="govEditForm.lon" placeholder="31.2357" class="form-input text-xs w-full font-mono"/>
							</div>
						</div>
					</div>
				</div>

				<!-- Sticky Modal Footer -->
				<div class="flex-between items-center pt-3 mt-3 border-t gap-3 flex-shrink-0">
					<button type="button" @click="closeGovEdit()" class="btn btn-secondary btn-sm font-bold text-xs flex-1">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary btn-sm font-black text-xs flex-1">
						@components.IconCheck("icon-xs")
						<span>حفظ تعديلات المحافظة</span>
					</button>
				</div>
			</form>
		</div>
	</div>
}
