package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ TenantSubscriptionPage(data TenantSubscriptionPageData, orgType string, lang string, dir string) {
	if orgType == "vendor" || orgType == "supplier" {
		@layouts.VendorShell("الاشتراك والعضوية", "subscription", lang, dir) {
			@tenantSubscriptionBody(data, orgType, lang, dir)
		}
	} else {
		@layouts.CustomerShell("الاشتراك والعضوية", "subscription", lang, dir, nil) {
			@tenantSubscriptionBody(data, orgType, lang, dir)
		}
	}
}

templ tenantSubscriptionBody(data TenantSubscriptionPageData, orgType string, lang string, dir string) {
	<div
		class="d-flex flex-col gap-6 w-full"
		x-data="{
			isCheckoutOpen: false,
			selectedPlanSlug: '',
			selectedPlanName: '',
			selectedPlanMonthMinor: 0,
			selectedPlanYearMinor: 0,
			billingCycle: 'monthly',
			autoRenew: true,
			walletBalanceMinor: 0,
			openCheckout(slug, name, monthMinor, yearMinor) {
				this.selectedPlanSlug = slug;
				this.selectedPlanName = name;
				this.selectedPlanMonthMinor = Number(monthMinor) || 0;
				this.selectedPlanYearMinor = Number(yearMinor) || 0;
				this.billingCycle = 'monthly';
				this.autoRenew = true;
				this.isCheckoutOpen = true;
			},
			get currentCostMinor() {
				return this.billingCycle === 'annual' ? this.selectedPlanYearMinor : this.selectedPlanMonthMinor;
			},
			get currentCostFormatted() {
				return (this.currentCostMinor / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج.م';
			},
			get hasSufficientBalance() {
				return this.walletBalanceMinor >= this.currentCostMinor;
			},
			get remainingBalanceFormatted() {
				const rem = (this.walletBalanceMinor - this.currentCostMinor) / 100;
				return rem.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج.م';
			}
		}"
		x-init={ fmt.Sprintf(`
			walletBalanceMinor = %d;
			const upSlug = new URLSearchParams(window.location.search).get('upgrade');
			if (upSlug) {
				const btn = document.querySelector('[data-plan-slug=\"' + upSlug + '\"]');
				if (btn) btn.click();
			}
		`, data.WalletBalance.Minor()) }
	>
		<!-- Toast Notices -->
		if data.NoticeMsg != "" {
			if data.NoticeType == "error" {
				<div class="alert alert-danger mb-4 d-flex items-center gap-3 p-4 rounded-xl border border-rose-200 bg-rose-50/60">
					@components.IconAlert("icon-sm text-rose-600 flex-shrink-0")
					<span class="font-bold text-xs text-rose-800">{ data.NoticeMsg }</span>
				</div>
			} else {
				<div class="alert alert-success mb-4 d-flex items-center gap-3 p-4 rounded-xl border border-emerald-200 bg-emerald-50/60">
					@components.IconCheckCircle("icon-sm text-emerald-600 flex-shrink-0")
					<span class="font-bold text-xs text-emerald-800">{ data.NoticeMsg }</span>
				</div>
			}
		}

		<!-- Header -->
		<div class="glass-panel p-6 mb-4 border border-slate-200/80 rounded-2xl shadow-sm">
			<div class="flex-between items-center flex-wrap gap-4">
				<div>
					<div class="d-flex items-center gap-2.5 mb-1.5">
						<div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
							@components.IconSparkles("icon-sm")
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							الاشتراك وإدارة العضوية
						</h1>
					</div>
					<p class="text-xs text-secondary m-0 font-medium">
						متابعة باقة المنشأة المعتمدة، الدفع المباشر من المحفظة، تفعيل التجديد التلقائي، وحدود استهلاك الذكاء الاصطناعي
					</p>
				</div>
				<div class="d-flex items-center gap-3">
					<div class="stat-card-3d p-3" style="min-width:180px;">
						<div class="stat-card-label text-xs">رصيدك في المحفظة</div>
						<div class="text-base font-black text-primary tabular-nums mt-1">
							@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.WalletBalance })
						</div>
					</div>
					if orgType == "vendor" || orgType == "supplier" {
						<a href="/vendor/wallet" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
							@components.IconWallet("icon-xs")
							<span>شحن المحفظة</span>
						</a>
					} else {
						<a href="/customer/wallet" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
							@components.IconWallet("icon-xs")
							<span>شحن المحفظة</span>
						</a>
					}
				</div>
			</div>
		</div>

		<!-- Current Active Subscription & AI Quotas -->
		if data.Subscription != nil {
			<div class="glass-panel p-6 mb-4 border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="flex-between items-center flex-wrap gap-3 mb-6 pb-3 border-b border-slate-100">
					<div class="d-flex items-center gap-2.5">
						<div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 d-flex items-center justify-center border border-sky-200/60 shadow-2xs">
							@components.IconShield("icon-xs")
						</div>
						<div>
							<h2 class="text-base font-extrabold text-primary m-0">
								تفاصيل باقة المنشأة الحالية
							</h2>
							<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
								الحدود والكوتا المطبقة على حساب منشأتك بالكامل
							</p>
						</div>
					</div>
					<div class="d-flex items-center gap-2">
						<span class="badge badge-emerald text-xs font-bold">{ data.Subscription.Status }</span>
						if data.AutoRenew {
							<span class="badge badge-sky text-xs font-bold">التجديد التلقائي مفعّل ({ func() string { if data.BillingCycle == "annual" { return "سنوي" }; return "شهري" }() })</span>
						} else {
							<span class="badge badge-slate text-xs font-bold">التجديد التلقائي معطّل</span>
						}
						if data.Subscription.IsDefaultPlan {
							<span class="badge badge-primary text-xs font-bold">باقة افتراضية</span>
						}
					</div>
				</div>

				<div class="dashboard-stat-grid cols-4 mb-0">
					<!-- Plan Name & Duration -->
					<div class="stat-card-3d">
						<div class="stat-card-label">خطة الاشتراك المعتمدة</div>
						<div class="text-base font-black text-primary mt-1">{ data.Subscription.PlanName }</div>
						<div class="text-xs text-muted mt-1 tabular-nums">الصلاحية: { data.Subscription.ExpiresAt }</div>
					</div>

					<!-- Concurrent Login Sessions -->
					<div class="stat-card-3d">
						<div class="stat-card-label">الجلسات المتزامنة</div>
						<div class="stat-card-value text-brand tabular-nums">
							{ fmt.Sprintf("%d", data.Subscription.MaxLoginSessions) }
						</div>
						<div class="text-xs text-muted mt-1">مشتركة لكافة مستخدمي المنشأة</div>
					</div>

					<!-- Max Devices -->
					<div class="stat-card-3d">
						<div class="stat-card-label">حد الأجهزة المفتوحة</div>
						<div class="stat-card-value text-primary tabular-nums">
							{ fmt.Sprintf("%d", data.Subscription.MaxDevices) }
						</div>
						<div class="text-xs text-muted mt-1">الحد الأقصى للأجهزة المصرح بها</div>
					</div>

					<!-- AI Gateway Budget & Usage -->
					<div class="stat-card-3d d-flex flex-col justify-between">
						<div>
							<div class="flex-between items-center mb-1">
								<span class="stat-card-label text-brand font-black">بوابة الـ AI</span>
								<span class="badge badge-sky text-xs font-bold font-mono" dir="ltr">{ data.Subscription.AIPlanID }</span>
							</div>
							
							<div class="mt-2">
								if data.Subscription.HasAIBudget {
									<div class="flex-between items-baseline mb-1">
										<span class="text-xs text-secondary font-bold">استهلاك الحصة:</span>
										<div class="tabular-nums text-base font-black text-brand">
											{ fmt.Sprintf("%d%%", data.Subscription.AIPercentage()) }
										</div>
									</div>
									<div class="progress-bar-container">
										<div class="progress-bar-fill" style={ fmt.Sprintf("width:%d%%;", data.Subscription.AIPercentage()) }></div>
									</div>
									<div class="flex-between text-xs text-muted mt-1">
										<span>متبقي: <strong class="text-success tabular-nums">{ fmt.Sprintf("%d%%", 100-data.Subscription.AIPercentage()) }</strong></span>
										<span>التجديد: <strong class="text-primary">{ data.Subscription.AIResetText() }</strong></span>
									</div>
								} else {
									<div class="text-xs text-secondary font-bold mb-1">الاستهلاك الفعلي:</div>
									<div class="tabular-nums text-base font-black text-brand">{ data.Subscription.AIUsageText() }</div>
									<div class="text-xs text-muted mt-1">لم تنشر البوابة سقفاً لهذه الباقة، لذلك لا تُعرض نسبة.</div>
								}
							</div>
						</div>

						<div class="mt-3 pt-2 border-t">
							<a href={ templ.SafeURL(func() string { if orgType == "vendor" || orgType == "supplier" { return "/vendor/ai-logs" }; return "/customer/ai-logs" }()) } class="text-xs font-bold text-brand text-decoration-none d-inline-flex items-center gap-1">
								<span>سجل الاستهلاك (AI Logs) ↗</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		}

		<!-- All Available System Plans -->
		<div class="glass-panel p-6 mb-4 border border-slate-200/80 rounded-2xl shadow-xs">
			<div class="mb-6 pb-3 border-b border-slate-100">
				<h2 class="text-base font-extrabold text-primary m-0">
					باقات وعضويات المنظومة المتاحة
				</h2>
				<p class="text-xs text-secondary m-0 mt-1 font-medium">
					استعرض مميزات وحدود كل باقة، وقم بالترقية فوراً والدفع مباشرة من محفظتك المالية
				</p>
			</div>

			if len(data.Plans) == 0 {
				<div class="p-8 text-center text-muted text-xs border border-slate-200/80 rounded-xl bg-surface-sunken">
					جاري تجهيز بيانات الباقات من النظام...
				</div>
			} else {
				<div class="d-grid grid-cols-1 md:grid-cols-3 gap-5">
					for _, p := range data.Plans {
						<div class="glass-panel p-6 mb-0 d-flex flex-col justify-between border border-slate-200/80 rounded-2xl shadow-xs hover:border-brand-300 transition-all">
							<div>
								<!-- Plan Header -->
								<div class="flex-between items-start mb-3">
									<div>
										<h3 class="text-base font-extrabold text-primary m-0">
											{ p.Name.Get("ar") }
										</h3>
										<span class="text-xs text-muted font-mono d-block mt-0.5">
											{ p.Slug }
										</span>
									</div>
									if data.CurrentPlanID == p.ID || (data.CurrentPlanID <= 0 && p.IsDefault) {
										<span class="badge badge-emerald text-xs font-bold">باقتك الحالية</span>
									} else if p.IsDefault {
										<span class="badge badge-slate text-xs font-bold">الافتراضية</span>
									}
								</div>

								<!-- Description -->
								<p class="text-xs text-secondary leading-relaxed mb-4 font-medium" style="min-height:36px;">
									{ p.Description.Get("ar") }
								</p>

								<!-- Pricing Box -->
								<div class="p-3.5 rounded-xl bg-surface-sunken border border-slate-200/80 mb-4">
									<div class="flex-between items-baseline">
										<div>
											<span class="text-xl font-black text-brand tabular-nums">
												@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: p.PriceMonth })
											</span>
											<span class="text-2xs text-muted ms-1 font-semibold">/ شهرياً</span>
										</div>
										<div class="text-xs text-secondary">
											<span class="tabular-nums font-bold">@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: p.PriceYear })</span>
											<span class="text-2xs text-muted ms-1 font-semibold">/ سنوياً</span>
										</div>
									</div>
								</div>

								<!-- General Limits -->
								<div class="d-flex flex-col gap-2 mb-4 text-xs font-medium">
									<div class="flex-between text-primary">
										<span class="text-secondary d-flex items-center gap-1.5">
											@components.IconUsers("icon-2xs text-brand")
											<span>الجلسات المتزامنة:</span>
										</span>
										<strong class="text-brand tabular-nums font-bold">{ fmt.Sprintf("%d جلسات", p.MaxLoginSessions) }</strong>
									</div>
									<div class="flex-between text-primary">
										<span class="text-secondary d-flex items-center gap-1.5">
											@components.IconSettings("icon-2xs text-brand")
											<span>حد الأجهزة المصرح بها:</span>
										</span>
										<strong class="tabular-nums font-bold">{ fmt.Sprintf("%d أجهزة", p.MaxDevices) }</strong>
									</div>
									<div class="flex-between text-primary">
										<span class="text-secondary d-flex items-center gap-1.5">
											@components.IconZap("icon-2xs text-amber-500")
											<span>بوابة الذكاء الاصطناعي:</span>
										</span>
										<code dir="ltr" class="text-xs font-bold font-mono badge badge-sky text-2xs">{ p.AIPlanID }</code>
									</div>
								</div>

								<!-- Features Breakdown based on Account Type -->
								<div class="border-t border-slate-100 pt-3 mb-4">
									if orgType == "vendor" || orgType == "supplier" {
										<div class="text-2xs font-bold text-secondary mb-2">ميزات الموردين والتحليلات:</div>
										<div class="d-flex flex-col gap-1.5 text-xs font-medium">
											if p.HasFeature("feature_market_discounts") {
												<div class="d-flex items-center gap-1.5 text-emerald-600 font-bold">
													@components.IconCheck("icon-2xs")
													<span>خصومات السوق العامة ومؤشرات الأسعار</span>
												</div>
											}

											if p.HasFeature("feature_compare_tool") {
												<div class="d-flex items-center gap-1.5 text-brand-600 font-bold">
													@components.IconCheck("icon-2xs")
													<span>أداة مقارنة الخصومات وتحليل العروض</span>
												</div>
											}

											<div class="d-flex items-center gap-1.5 text-secondary">
												@components.IconCheck("icon-2xs text-emerald-500")
												<span>استيراد المخزون وإدارة فروع التوريد</span>
											</div>
										</div>
									} else {
										<div class="text-2xs font-bold text-secondary mb-2">ميزات منظومة الصيدلية:</div>
										<div class="d-flex flex-col gap-1.5 text-xs font-medium">
											<div class="d-flex items-center gap-1.5 text-emerald-600 font-bold">
												@components.IconCheck("icon-2xs")
												<span>الطلب الذكي ومطابقة نواقص الأدوية بالذكاء الاصطناعي</span>
											</div>
											<div class="d-flex items-center gap-1.5 text-secondary">
												@components.IconCheck("icon-2xs text-emerald-500")
												<span>الاستفادة المباشرة من خصومات وعروض الموردين الحصرية</span>
											</div>
											<div class="d-flex items-center gap-1.5 text-secondary">
												@components.IconCheck("icon-2xs text-emerald-500")
												<span>إدارة فروع الصيدلية والطلبيات المجمعة</span>
											</div>
										</div>
									}
								</div>
							</div>

							<!-- Action CTA Button opening Checkout Modal -->
							<div class="border-t border-slate-100 pt-4">
								<button
									type="button"
									data-plan-slug={ p.Slug }
									class={ "btn w-full justify-center font-bold text-xs gap-1.5 shadow-2xs", templ.KV("btn-secondary", data.CurrentPlanID == p.ID || (data.CurrentPlanID <= 0 && p.IsDefault)), templ.KV("btn-primary", !(data.CurrentPlanID == p.ID || (data.CurrentPlanID <= 0 && p.IsDefault))) }
									@click={ fmt.Sprintf("openCheckout('%s', '%s', %d, %d)", p.Slug, p.Name.Get("ar"), p.PriceMonth.Minor(), p.PriceYear.Minor()) }
								>
									@components.IconSparkles("icon-xs")
									if data.CurrentPlanID == p.ID || (data.CurrentPlanID <= 0 && p.IsDefault) {
										<span>تجديد أو تعديل باقتك الحالية</span>
									} else {
										<span>الاشتراك والترقية لهذه الباقة</span>
									}
								</button>
							</div>

						</div>
					}
				</div>
			}
		</div>

		<!-- In-App Wallet Checkout Modal -->
		<div
			class="modal-backdrop"
			x-show="isCheckoutOpen"
			x-cloak
			x-transition.opacity
			style="position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:9999; display:flex; align-items:center; justify-content:center; padding:1.5rem;"
		>
			<div
				class="glass-panel p-6 border border-slate-200/80 rounded-2xl shadow-xl max-w-lg w-full"
				style="max-height:90vh; overflow-y:auto;"
				@click.outside="isCheckoutOpen = false"
				@keydown.escape.window="isCheckoutOpen = false"
			>
				<!-- Modal Header -->
				<div class="flex-between items-center pb-3 mb-4 border-b border-slate-100">
					<div class="d-flex items-center gap-2">
						<div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
							@components.IconCreditCard("icon-xs")
						</div>
						<div>
							<h3 class="text-base font-black text-primary m-0">
								تأكيد الاشتراك والدفع من المحفظة
							</h3>
							<p class="text-xs text-secondary m-0 mt-0.5 font-medium" x-text="'الباقة المحددة: ' + selectedPlanName"></p>
						</div>
					</div>
					<button type="button" class="btn btn-secondary btn-xs rounded-full w-8 h-8 p-0 d-flex items-center justify-center" @click="isCheckoutOpen = false">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<form
					method="POST"
					action={ templ.SafeURL(func() string { if orgType == "vendor" || orgType == "supplier" { return "/vendor/subscription/checkout" }; return "/customer/subscription/checkout" }()) }
					class="m-0 d-flex flex-col gap-4"
				>
					<input type="hidden" name="plan_slug" :value="selectedPlanSlug" />

					<!-- Billing Cycle Choice -->
					<div>
						<label class="form-label font-bold text-xs mb-2 d-block">اختر دورة الفوترة والتجديد:</label>
						<div class="d-grid gap-2 grid-cols-1 md:grid-cols-2">
							<!-- Monthly Radio -->
							<label
								class="p-3 rounded-xl border cursor-pointer d-flex flex-col gap-1 transition-all"
								:class="billingCycle === 'monthly' ? 'bg-primary-subtle border-primary' : 'bg-surface-sunken border-slate-200/80'"
							>
								<div class="flex-between items-center">
									<span class="font-bold text-xs text-primary">اشتراك شهري</span>
									<input type="radio" name="billing_cycle" value="monthly" x-model="billingCycle" class="form-check-input" />
								</div>
								<div class="text-sm font-black text-primary tabular-nums mt-1" x-text="(selectedPlanMonthMinor / 100).toLocaleString('en-US', {minimumFractionDigits:2}) + ' ج.م / شهر'"></div>
							</label>

							<!-- Annual Radio -->
							<label
								class="p-3 rounded-xl border cursor-pointer d-flex flex-col gap-1 transition-all"
								:class="billingCycle === 'annual' ? 'bg-primary-subtle border-primary' : 'bg-surface-sunken border-slate-200/80'"
							>
								<div class="flex-between items-center">
									<span class="font-bold text-xs text-primary">اشتراك سنوي</span>
									<input type="radio" name="billing_cycle" value="annual" x-model="billingCycle" class="form-check-input" />
								</div>
								<div class="text-sm font-black text-primary tabular-nums mt-1" x-text="(selectedPlanYearMinor / 100).toLocaleString('en-US', {minimumFractionDigits:2}) + ' ج.م / سنة'"></div>
								<span class="badge badge-emerald text-xs font-bold" style="font-size:0.68rem; padding:0.1rem 0.35rem; align-self:flex-start;">وفر شهرين مجاناً</span>
							</label>
						</div>
					</div>

					<!-- Wallet Balance & Summary Card -->
					<div class="p-4 rounded-xl bg-surface-sunken border border-slate-200/80">
						<div class="flex-between items-center text-xs text-secondary mb-2 font-medium">
							<span>المبلغ الإجمالي المستحق:</span>
							<strong class="text-base font-black text-primary tabular-nums" x-text="currentCostFormatted"></strong>
						</div>
						<div class="flex-between items-center text-xs text-secondary mb-2 font-medium">
							<span>رصيدك المتاح في المحفظة:</span>
							<strong class="text-sm font-bold text-brand tabular-nums">
								@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.WalletBalance })
							</strong>
						</div>
						<div class="border-t border-slate-200 pt-2 mt-2 flex-between items-center text-xs font-medium">
							<span>الرصيد المتبقي بعد الخصم:</span>
							<strong
								class="font-black tabular-nums"
								:class="hasSufficientBalance ? 'text-success' : 'text-danger'"
								x-text="hasSufficientBalance ? remainingBalanceFormatted : 'رصيد غير كافٍ'"
							></strong>
						</div>
					</div>

					<!-- Insufficient Funds Notice -->
					<template x-if="!hasSufficientBalance && currentCostMinor > 0">
						<div class="alert alert-danger p-3 rounded-xl d-flex items-center gap-2 text-xs border border-rose-200 bg-rose-50/60">
							@components.IconAlert("icon-xs text-rose-600 flex-shrink-0")
							<div class="flex-1 font-medium">
								<strong class="text-rose-800">رصيد محفظتك غير كافٍ.</strong>
								<span class="text-rose-700">يرجى شحن المحفظة أولاً لإتمام تفعيل الاشتراك.</span>
							</div>
							if orgType == "vendor" || orgType == "supplier" {
								<a href="/vendor/wallet" class="btn btn-secondary btn-xs font-bold shadow-2xs" target="_blank">شحن الآن ↗</a>
							} else {
								<a href="/customer/wallet" class="btn btn-secondary btn-xs font-bold shadow-2xs" target="_blank">شحن الآن ↗</a>
							}
						</div>
					</template>

					<!-- Auto Renewal Checkbox -->
					<div class="p-3 rounded-xl border border-slate-200/80 bg-surface-raised d-flex items-start gap-3">
						<input
							type="checkbox"
							id="sub_auto_renew"
							name="auto_renew"
							value="true"
							x-model="autoRenew"
							class="form-check-input mt-1"
						/>
						<label for="sub_auto_renew" class="text-xs cursor-pointer">
							<strong class="text-primary d-block font-bold">تفعيل التجديد التلقائي للاشتراك</strong>
							<span class="text-muted leading-relaxed font-medium">
								سيقوم النظام تلقائياً بتجديد باقتك عند حلول موعد الاستحقاق وخصم القيمة من رصيد محفظتك بدون انقطاع في الخدمة.
							</span>
						</label>
					</div>

					<!-- Action Buttons -->
					<div class="flex-between items-center pt-3 border-t border-slate-100 gap-2">
						<button
							type="button"
							class="btn btn-secondary btn-sm font-bold"
							@click="isCheckoutOpen = false"
						>
							إلغاء
						</button>

						<button
							type="submit"
							class="btn btn-primary btn-sm font-black gap-1.5 shadow-sm"
							:disabled="!hasSufficientBalance && currentCostMinor > 0"
						>
							@components.IconCheckCircle("icon-xs")
							<span>تأكيد والخصم المباشر من المحفظة</span>
						</button>
					</div>
				</form>
			</div>
		</div>

	</div>
}

