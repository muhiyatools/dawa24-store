package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type FAQItem struct {
	Question string
	Answer   string
	Category string
}

func GetFAQs() []FAQItem {
	return []FAQItem{
		{
			Category: "عام ونظرة عامة",
			Question: "ما هي منصة دواء 24؟",
			Answer:   "دواء 24 هي أول منصة إلكترونية متخصصة في الربط والتوريد الدوائي المباشر بين شركات الأدوية والموزعين المعتمدين من جهة، وبين الصيدليات والمستشفيات والمراكز الطبية المرخصة في جمهورية مصر العربية من جهة أخرى، لضمان توافر الدواء بأفضل الأسعار وبأعلى معايير الجودة والتتبع.",
		},
		{
			Category: "عام ونظرة عامة",
			Question: "من يحق له التسجيل والشراء عبر المنصة؟",
			Answer:   "الشراء مقتصر حصراً على المؤسسات الطبية والصيدلانية المرخصة (الصيدليات العامة والخاصة، المستشفيات، المراكز الطبية، والعيادات المرخصة) بموجب ترخيص مزاولة المهنة والسجل التجاري والبطاقة الضريبية.",
		},
		{
			Category: "الطلبات والتوريد",
			Question: "كيف يتم تقسيم الطلب إذا اشتريت من أكثر من مورد؟",
			Answer:   "يقوم النظام تلقائياً بتجميع أصنافك في سلة واحدة، وتوزيع أمر التوريد إلى شحنات منفصلة لكل مورد معتمد، مع إصدار أرقام تتبع وفواتير مستقلة لكل شحنة دون أي تعقيد على الصيدلي.",
		},
		{
			Category: "الطلبات والتوريد",
			Question: "ما هو الحد الأدنى لقيمة الطلب؟",
			Answer:   "يحدد كل مورد حد أدنى خاص به لضمان مجانية الشحن، ويظهر لك في السلة قبل إتمام الطلب بوضوح. كما نوفر تنبيهات ذكية لمساعدتك في استكمال الحد الأدنى والحصول على أقصى خصم ممكن.",
		},
		{
			Category: "الشحن والجودة",
			Question: "كيف يتم ضمان سلامة الأدوية الحساسة وسلسلة التبريد (Cold-Chain)؟",
			Answer:   "يلتزم جميع الموردين وشركات التوزيع المسجلة بنقل الأدوية الحساسة كالأنسولين والأمصال عبر سيارات مجهزة بثلاجات تبريد ومجسات تتبع لدرجات الحرارة طبقاً لاشتراطات هيئة الدواء المصرية.",
		},
		{
			Category: "الدفع والفواتير",
			Question: "ما هي طرق الدفع المعتمدة؟",
			Answer:   "نوفر الدفع عند الاستلام نقداً أو بشيك مقبول الدفع لمندوب التوزيع، بالإضافة إلى التسهيلات الائتمانية والتحويلات البنكية للمؤسسات التي تمتلك حسابات معتمدة وحدود ائتمانية سارية.",
		},
		{
			Category: "الدفع والفواتير",
			Question: "هل الفواتير الصادرة فواتير ضريبية إلكترونية معتمدة؟",
			Answer:   "نعم، ترتبط منصة دواء 24 بمنظومة الفاتورة الإلكترونية لمصلحة الضرائب المصرية وتصدر الفواتير الضريبية بصيغة رقمية مطابقة للقانون فور تأكيد استلام الشحنة.",
		},
		{
			Category: "المرتجعات والضمان",
			Question: "كيف يتم التعامل مع الأدوية منتهية الصلاحية أو القريبة من الانتهاء؟",
			Answer:   "تلتزم الشركات بقبول المرتجعات وفقاً للوائح قطاع الصيدلة وقرارات الإرجاع الوزارية المنظمة، مع إمكانية تقديم طلب إرجاع إلكتروني مباشر من صفحة تفاصيل الطلب.",
		},
		{
			Category: "انضمام الموردين",
			Question: "كيف يمكن لشركات التوزيع ومصانع الأدوية الانضمام كموردين؟",
			Answer:   "يمكن التقديم عبر صفحة 'انضم كشريك' ورفع السجل التجاري ورخصة المخزن أو المصنع، ويتم مراجعة الطلب واعتماد الحساب وبدء ربط المخزون خلال 24 ساعة عمل.",
		},
	}
}

templ FAQPage(lang, dir, customTitle, customSubtitle string) {
	@layouts.PublicShell("الأسئلة الشائعة وإرشادات الاستخدام | FAQ", lang, dir) {
		<div class="faq-page-container" x-data="{ activeCategory: 'all' }">
			
			<!-- Hero Header -->
			<div class="faq-hero-card">
				<div class="faq-hero-badge">
					@components.IconHelpCircle("icon-xs")
					<span>مركز المساعدة والمعلومات</span>
				</div>
				<h1 class="faq-hero-title">
					if customTitle != "" {
						{ customTitle }
					} else {
						الأسئلة الشائعة وإرشادات الاستخدام
					}
				</h1>
				<p class="faq-hero-subtitle">
					if customSubtitle != "" {
						{ customSubtitle }
					} else {
						كل ما تحتاج لمعرفته حول طلب وتوريد الأدوية، شروط التعامل، وسياسات الدفع والشحن عبر منصة دواء 24.
					}
				</p>
			</div>

			<!-- Category Filter Tabs -->
			<div class="faq-tabs-nav">
				<button
					type="button"
					@click="activeCategory = 'all'"
					class="faq-tab-btn"
					:class="{ 'active': activeCategory === 'all' }"
				>
					جميع الأسئلة
				</button>
				<button
					type="button"
					@click="activeCategory = 'عام ونظرة عامة'"
					class="faq-tab-btn"
					:class="{ 'active': activeCategory === 'عام ونظرة عامة' }"
				>
					عام ونظرة عامة
				</button>
				<button
					type="button"
					@click="activeCategory = 'الطلبات والتوريد'"
					class="faq-tab-btn"
					:class="{ 'active': activeCategory === 'الطلبات والتوريد' }"
				>
					الطلبات والتوريد
				</button>
				<button
					type="button"
					@click="activeCategory = 'الشحن والجودة'"
					class="faq-tab-btn"
					:class="{ 'active': activeCategory === 'الشحن والجودة' }"
				>
					الشحن وسلسلة التبريد
				</button>
				<button
					type="button"
					@click="activeCategory = 'الدفع والفواتير'"
					class="faq-tab-btn"
					:class="{ 'active': activeCategory === 'الدفع والفواتير' }"
				>
					الدفع والفواتير
				</button>
				<button
					type="button"
					@click="activeCategory = 'انضمام الموردين'"
					class="faq-tab-btn"
					:class="{ 'active': activeCategory === 'انضمام الموردين' }"
				>
					انضمام الموردين
				</button>
			</div>

			<!-- FAQ List Accordion -->
			<div class="faq-accordion-list">
				for _, item := range GetFAQs() {
					<div
						class="faq-accordion-item"
						x-data="{ open: false }"
						x-show={ "activeCategory === 'all' || activeCategory === '" + item.Category + "'" }
						:class="{ 'is-open': open }"
					>
						<div
							class="faq-accordion-header"
							@click="open = !open"
						>
							<div class="faq-question-group">
								<span class="badge badge-sky">
									{ item.Category }
								</span>
								<h3 class="faq-question-title">
									{ item.Question }
								</h3>
							</div>
							<div class="faq-chevron">
								@components.IconChevronDown("icon-sm")
							</div>
						</div>
						<div
							class="faq-accordion-body"
							x-show="open"
							x-cloak
							x-collapse
						>
							{ item.Answer }
						</div>
					</div>
				}
			</div>

			<!-- Contact Support Card -->
			<div class="faq-contact-card">
				<h3 class="faq-contact-title">
					لم تجد إجابة لاستفسارك؟
				</h3>
				<p class="faq-contact-desc">
					فريق الدعم الفني وخدمة العملاء متواجد على مدار الساعة لمساعدة الصيدليات والشركات الموردة.
				</p>
				<div class="faq-contact-actions">
					<a href="/contact" class="btn btn-primary btn-sm">
						@components.IconMail("icon-xs")
						<span>إرسال استفسار عبر نموذج التواصل</span>
					</a>
					<a href="tel:01065397000" class="btn btn-secondary btn-sm">
						@components.IconPhone("icon-xs")
						<span>اتصال هاتفي: 01065397000</span>
					</a>
				</div>
			</div>
		</div>
	}
}

