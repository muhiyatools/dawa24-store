package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerProductDetail(product *catalog.Product, variants []*catalog.ProductVariant, lang, dir string) {
	@layouts.CustomerShell(productTitle(product), lang, dir) {
		<div class="product-detail-container" style="max-width:1080px; margin:1.5rem auto; display:flex; flex-direction:column; gap:2rem;">
			<div class="card" style="margin-bottom:0; display:grid; grid-template-columns:1.2fr 0.8fr; gap:2.5rem; align-items:start;">
				<div>
					<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem;">
						<span class="badge badge-slate" style="font-size:0.8rem; padding:0.3rem 0.75rem;">
							@components.IconPill("icon-xs")
							<span>{ product.DosageForm }</span>
						</span>
						<span class="badge badge-emerald" style="font-size:0.8rem; padding:0.3rem 0.75rem;">
							@components.IconCheck("icon-xs")
							<span>صنف مسجل ومعتمد</span>
						</span>
					</div>

					<h1 style="font-size:1.85rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">
						if product.Name["ar"] != "" {
							{ product.Name["ar"] }
						} else {
							{ product.Name["en"] }
						}
					</h1>
					<h2 style="font-size:1.1rem; color:var(--neutral-500); font-weight:500; margin-bottom:1.5rem;">
						{ product.Name["en"] }
					</h2>

					<div style="background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-lg); padding:1.25rem; display:flex; flex-direction:column; gap:0.75rem; font-size:0.9rem;">
						if product.ScientificName != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--neutral-200); padding-bottom:0.5rem;">
								<span style="color:var(--neutral-500);">المادة الفعالة (Active Ingredient):</span>
								<span style="font-weight:700; color:var(--neutral-900);">{ product.ScientificName }</span>
							</div>
						}
						if product.ManufacturingCompanies != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--neutral-200); padding-bottom:0.5rem;">
								<span style="color:var(--neutral-500);">الشركة المنتجة:</span>
								<span style="font-weight:700; color:var(--neutral-900);">{ product.ManufacturingCompanies }</span>
							</div>
						}
						if product.Barcode != "" {
							<div style="display:flex; justify-content:space-between;">
								<span style="color:var(--neutral-500);">الباركود الدولي (GTIN):</span>
								<span style="font-weight:700; color:var(--neutral-900);" class="tabular-nums">{ product.Barcode }</span>
							</div>
						}
					</div>
				</div>

				<div style="background:linear-gradient(135deg, var(--neutral-50) 0%, #ffffff 100%); padding:1.75rem; border-radius:var(--radius-xl); border:1px solid var(--border-card); display:flex; flex-direction:column; gap:1.25rem;">
					<div style="display:flex; align-items:center; gap:0.6rem; color:var(--primary-800); font-weight:700; font-size:1.1rem;">
						@components.IconTruck("icon-sm")
						<span>شروط التوريد والشحن</span>
					</div>
					<ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.6rem; font-size:0.875rem; color:var(--neutral-600);">
						<li style="display:flex; align-items:center; gap:0.5rem;">
							@components.IconCheckCircle("icon-xs")
							<span>التوريد متاح للصيدليات والمستشفيات المرخصة</span>
						</li>
						<li style="display:flex; align-items:center; gap:0.5rem;">
							@components.IconCheckCircle("icon-xs")
							<span>شحن مبرد معتمد (Cold-chain) للأدوية الحساسة</span>
						</li>
						<li style="display:flex; align-items:center; gap:0.5rem;">
							@components.IconCheckCircle("icon-xs")
							<span>فواتير ضريبية إلكترونية فورية</span>
						</li>
					</ul>
					<a href="/cart" class="btn btn-secondary" style="width:100%; justify-content:center; padding:0.75rem;">
						@components.IconCart("icon-sm")
						<span>عرض سلة الطلبيات</span>
					</a>
				</div>
			</div>

			<div class="card" style="margin-bottom:0;">
				<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.25rem;">
					@components.IconPackage("icon-md")
					<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">
						العبوات والتشغيلات المتاحة للطلب
					</h3>
				</div>

				if len(variants) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد عبوات متاحة حالياً",
						Message: "هذا الدواء غير متوفر في المخزون المباشر حالياً.",
					})
				} else {
					<div style="display:flex; flex-direction:column; gap:0.875rem;">
						for _, v := range variants {
							<div style="display:flex; align-items:center; justify-content:space-between; padding:1.25rem; background:#fff; border:1px solid var(--border-card); border-radius:var(--radius-lg); box-shadow:var(--shadow-xs);">
								<div>
									<div style="font-weight:700; font-size:1rem; color:var(--neutral-900); margin-bottom:0.25rem;">
										if v.Name["ar"] != "" {
											{ v.Name["ar"] }
										} else {
											{ v.Name["en"] }
										}
									</div>
									<div style="font-size:0.8rem; color:var(--neutral-500); display:flex; gap:1rem;">
										<span>SKU: <strong class="tabular-nums">{ v.SKU }</strong></span>
										if v.Barcode != "" {
											<span>باركود: <strong class="tabular-nums">{ v.Barcode }</strong></span>
										}
									</div>
								</div>

								<div style="display:flex; align-items:center; gap:1rem;">
									<form action="/cart/add" method="POST" style="display:flex; align-items:center; gap:0.5rem; margin:0;">
										<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.ID) } />
										<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", product.OrganizationID) } />
										<input type="number" name="quantity" value="1" min="1" class="form-input tabular-nums" style="width:75px; text-align:center; padding:0.5rem;" />
										<button type="submit" class="btn btn-primary" style="padding:0.55rem 1.25rem;">
											@components.IconPlus("icon-xs")
											<span>أضف للسلة</span>
										</button>
									</form>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}

func productTitle(p *catalog.Product) string {
	if p == nil {
		return "تفاصيل الصنف"
	}
	if p.Name["ar"] != "" {
		return p.Name["ar"]
	}
	return p.Name["en"]
}
