package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerProductDetail(product *catalog.Product, variants []*catalog.ProductVariant, lang, dir string) {
	@layouts.CustomerShell(productTitle(product), lang, dir) {
		<div class="product-detail-container" style="max-width:1160px; margin:1rem auto 4rem auto; display:flex; flex-direction:column; gap:2.5rem;">
			
			<!-- Breadcrumb Navigation -->
			<nav style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--neutral-500);">
				<a href="/" style="color:var(--neutral-600); text-decoration:none;">الرئيسية</a>
				<span>/</span>
				<a href="/catalog" style="color:var(--neutral-600); text-decoration:none;">كتالوج الأدوية</a>
				<span>/</span>
				<span style="color:var(--neutral-900); font-weight:700;">{ productTitle(product) }</span>
			</nav>

			<!-- 1. Hero Product Specifications & Image Gallery Card -->
			<div class="card" style="margin-bottom:0; display:grid; grid-template-columns:360px 1fr 340px; gap:2rem; align-items:start; padding:2.5rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card); box-shadow:var(--shadow-sm);" x-data="{ activeImage: 0 }">
				
				<!-- Col 1: Product Multi-Image Gallery -->
				<div style="display:flex; flex-direction:column; gap:1rem;">
					<!-- Main High-Res Preview Box -->
					<div style="width:100%; height:320px; border-radius:var(--radius-xl); background:linear-gradient(135deg, var(--neutral-50) 0%, #ffffff 100%); border:1.5px solid var(--neutral-200); display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; overflow:hidden; box-shadow:inset 0 2px 4px rgba(0,0,0,0.02);">
						
						<!-- Badge on top of image -->
						<div style="position:absolute; top:12px; inset-inline-start:12px;">
							<span class="badge badge-emerald" style="font-size:0.75rem; font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>منتج دوائي أصلي 100%</span>
							</span>
						</div>

						<!-- Image 0: Main Package -->
						<div x-show="activeImage === 0" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:1.5rem;">
							if product.Image != "" {
								<img src={ product.Image } alt={ productTitle(product) } style="max-height:220px; max-width:100%; object-fit:contain;" />
							} else {
								<div style="width:96px; height:96px; border-radius:var(--radius-2xl); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:1rem; box-shadow:var(--shadow-md);">
									@components.IconPill("icon-lg")
								</div>
								<div style="font-weight:900; font-size:1.1rem; color:var(--neutral-900);">العبوة الرسمية المعتمدة</div>
								<span style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.25rem;">مسجلة ومختومة من هيئة الدواء</span>
							}
						</div>

						<!-- Image 1: Blister / Strip -->
						<div x-show="activeImage === 1" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:1.5rem;" style="display:none;">
							<div style="width:96px; height:96px; border-radius:var(--radius-2xl); background:var(--sky-100); color:var(--sky-700); display:flex; align-items:center; justify-content:center; margin-bottom:1rem; box-shadow:var(--shadow-md);">
								@components.IconPackage("icon-lg")
							</div>
							<div style="font-weight:900; font-size:1.1rem; color:var(--neutral-900);">شريط الأقراص / الوحدات</div>
							<span style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.25rem;">أقراص مغلفة ومحكمة الغلق</span>
						</div>

						<!-- Image 2: Leaflet & Batch Specs -->
						<div x-show="activeImage === 2" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:1.5rem;" style="display:none;">
							<div style="width:96px; height:96px; border-radius:var(--radius-2xl); background:var(--amber-100); color:var(--amber-700); display:flex; align-items:center; justify-content:center; margin-bottom:1rem; box-shadow:var(--shadow-md);">
								@components.IconFile("icon-lg")
							</div>
							<div style="font-weight:900; font-size:1.1rem; color:var(--neutral-900);">بيانات التشغيلة والنشرة</div>
							<span style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.25rem;">دواعي الاستعمال والجرعات الدوائية</span>
						</div>
					</div>

					<!-- Thumbnails Selector Strip -->
					<div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:0.5rem;">
						<button
							type="button"
							@click="activeImage = 0"
							:style="activeImage === 0 ? 'border-color:var(--primary-600); background:var(--primary-50);' : 'border-color:var(--neutral-200); background:#ffffff;'"
							style="padding:0.5rem 0.25rem; border-radius:var(--radius-lg); border:1.5px solid; cursor:pointer; font-size:0.75rem; font-weight:800; text-align:center; color:var(--neutral-700); transition:all 0.15s ease;"
						>
							العبوة الخارجية
						</button>
						<button
							type="button"
							@click="activeImage = 1"
							:style="activeImage === 1 ? 'border-color:var(--primary-600); background:var(--primary-50);' : 'border-color:var(--neutral-200); background:#ffffff;'"
							style="padding:0.5rem 0.25rem; border-radius:var(--radius-lg); border:1.5px solid; cursor:pointer; font-size:0.75rem; font-weight:800; text-align:center; color:var(--neutral-700); transition:all 0.15s ease;"
						>
							شريط الأقراص
						</button>
						<button
							type="button"
							@click="activeImage = 2"
							:style="activeImage === 2 ? 'border-color:var(--primary-600); background:var(--primary-50);' : 'border-color:var(--neutral-200); background:#ffffff;'"
							style="padding:0.5rem 0.25rem; border-radius:var(--radius-lg); border:1.5px solid; cursor:pointer; font-size:0.75rem; font-weight:800; text-align:center; color:var(--neutral-700); transition:all 0.15s ease;"
						>
							النشرة والتشغيلة
						</button>
					</div>
				</div>

				<!-- Col 2: Specifications and Details -->
				<div>
					<!-- Badges & Ratings Header -->
					<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; flex-wrap:wrap; gap:0.75rem;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							<span class="badge badge-sky" style="font-size:0.8rem; padding:0.35rem 0.75rem; font-weight:800;">
								@components.IconPill("icon-xs")
								<span>
									if product.DosageForm != "" {
										{ product.DosageForm }
									} else {
										أقراص علاجية
									}
								</span>
							</span>
							<span class="badge badge-emerald" style="font-size:0.8rem; padding:0.35rem 0.75rem; font-weight:700;">
								@components.IconCheck("icon-xs")
								<span>مسجل لدى هيئة الدواء (EDA)</span>
							</span>
						</div>

						<!-- Favorite Button -->
						<form action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", product.ID)) } method="POST" style="margin:0;">
							<button type="submit" class="btn btn-secondary btn-icon" title="إضافة للمفضلة" style="color:var(--primary-600); width:36px; height:36px;">
								@components.IconHeart("icon-sm")
							</button>
						</form>
					</div>

					<!-- Titles -->
					<h1 style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.35rem; line-height:1.25;">
						if product.Name["ar"] != "" {
							{ product.Name["ar"] }
						} else {
							{ product.Name["en"] }
						}
					</h1>
					<h2 style="font-size:1.05rem; color:var(--neutral-500); font-weight:700; margin-bottom:1rem;">
						{ product.Name["en"] }
					</h2>

					<!-- Rating Stars -->
					<div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem; padding-bottom:0.85rem; border-bottom:1px solid var(--neutral-100);">
						@components.RatingStars(4.9, 148)
						<span style="color:var(--neutral-300);">•</span>
						<span style="font-size:0.85rem; color:var(--emerald-600); font-weight:700;">98% تقييم إيجابي من الصيادلة</span>
					</div>

					<!-- Medical Specifications Matrix -->
					<div style="background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-xl); padding:1.25rem; display:flex; flex-direction:column; gap:0.75rem; font-size:0.875rem;">
						if product.ScientificName != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--neutral-200); padding-bottom:0.5rem;">
								<span style="color:var(--neutral-500); font-weight:600;">المادة الفعالة:</span>
								<strong style="color:var(--neutral-900);">{ product.ScientificName }</strong>
							</div>
						}
						if product.ManufacturingCompanies != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--neutral-200); padding-bottom:0.5rem;">
								<span style="color:var(--neutral-500); font-weight:600;">الشركة المصنعة:</span>
								<strong style="color:var(--neutral-900);">{ product.ManufacturingCompanies }</strong>
							</div>
						}
						if product.Barcode != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--neutral-200); padding-bottom:0.5rem;">
								<span style="color:var(--neutral-500); font-weight:600;">الباركود الدولي:</span>
								<strong style="color:var(--neutral-900);" class="tabular-nums">{ product.Barcode }</strong>
							</div>
						}
						<div style="display:flex; justify-content:space-between;">
							<span style="color:var(--neutral-500); font-weight:600;">اشتراطات الحفظ:</span>
							<strong style="color:var(--neutral-800);">15° - 25° مئوية، بعيداً عن الرطوبة</strong>
						</div>
					</div>
				</div>

				<!-- Right Side: Lowest Price Hero Buy Box -->
				<div style="background:#ffffff; padding:2rem; border-radius:var(--radius-xl); border:1.5px solid var(--primary-300); display:flex; flex-direction:column; gap:1.25rem; box-shadow:var(--shadow-md);">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
							<div style="font-size:0.85rem; color:var(--neutral-500); font-weight:700;">أقل سعر متوفر حالياً:</div>
							<span class="badge badge-emerald" style="font-size:0.75rem;">أفضل عرض متاح</span>
						</div>
						<div style="font-size:2.35rem; font-weight:900; color:var(--primary-700); line-height:1;" class="tabular-nums">
							if len(GetOffersForProduct(product)) > 0 {
								{ GetOffersForProduct(product)[0].Price.String() } ج.م
							} else if product.EffectivePrice().IsPositive() {
								{ product.EffectivePrice().String() } ج.م
							} else {
								38.50 ج.م
							}
						</div>
						<div style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.35rem;">
							شامل ضريبة القيمة المضافة (14% ETA)
						</div>
						if len(GetOffersForProduct(product)) > 0 {
							<div style="font-size:0.825rem; color:var(--neutral-600); margin-top:0.5rem; display:flex; align-items:center; gap:0.35rem;">
								<span>المورد الأقل سعراً:</span>
								<strong style="color:var(--primary-800);">{ GetOffersForProduct(product)[0].SupplierName }</strong>
							</div>
						}
					</div>

					<form action="/cart/add" method="POST" x-data="{ qty: 1 }" style="display:flex; flex-direction:column; gap:0.85rem; margin:0;">
						<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
						if len(variants) > 0 {
							<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", variants[0].ID) } />
						} else {
							<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", product.ID) } />
						}
						if len(GetOffersForProduct(product)) > 0 {
							<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", GetOffersForProduct(product)[0].SupplierID) } />
						} else {
							<input type="hidden" name="vendor_org_id" value="1" />
						}
						<input type="hidden" name="quantity" :value="qty" />

						<div style="display:flex; align-items:center; justify-content:space-between; background:var(--neutral-50); border:1px solid var(--neutral-300); border-radius:var(--radius-md); padding:0.4rem 0.75rem;">
							<span style="font-size:0.85rem; font-weight:700; color:var(--neutral-700);">الكمية المطلوبة:</span>
							<div style="display:flex; align-items:center; gap:0.5rem;">
								<button type="button" class="btn btn-secondary btn-icon" style="width:30px; height:30px;" @click="if (qty > 1) qty--">-</button>
								<span class="tabular-nums" style="font-weight:900; font-size:1.1rem; min-width:2rem; text-align:center;" x-text="qty"></span>
								<button type="button" class="btn btn-secondary btn-icon" style="width:30px; height:30px;" @click="qty++">+</button>
							</div>
						</div>

						<button type="submit" class="btn btn-primary" style="width:100%; padding:0.85rem; font-size:0.95rem; font-weight:900; justify-content:center;">
							@components.IconPlus("icon-sm")
							<span>إضافة للطلبية بأفضل سعر متاح</span>
						</button>
					</form>

					<div style="border-top:1px solid var(--neutral-100); padding-top:1rem;">
						<div style="display:flex; align-items:center; gap:0.5rem; color:var(--primary-800); font-weight:800; font-size:0.9rem; margin-bottom:0.6rem;">
							@components.IconTruck("icon-xs")
							<span>ضمانات التوريد الدوائي الذكي</span>
						</div>
						<ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.5rem; font-size:0.8rem; color:var(--neutral-700);">
							<li style="display:flex; align-items:center; gap:0.4rem;">
								@components.IconCheckCircle("icon-xs")
								<span>توصيل مبرد معتمد (Cold-chain 2-8°C)</span>
							</li>
							<li style="display:flex; align-items:center; gap:0.4rem;">
								@components.IconCheckCircle("icon-xs")
								<span>فواتير إلكترونية فورية مطابقة لمنظومة الضرائب</span>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- 2. Multi-Supplier Marketplace Offers Matrix -->
			<div class="card" style="margin-bottom:0; padding:2.5rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card); box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; flex-wrap:wrap; gap:1rem; border-bottom:1px solid var(--neutral-100); padding-bottom:1.25rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconBuilding("icon-sm")
							</div>
							<h3 style="font-size:1.45rem; font-weight:900; color:var(--neutral-900); margin:0;">
								عروض الموردين والمستودعات المعتمدة
							</h3>
						</div>
						<p style="color:var(--neutral-500); font-size:0.9rem; margin-top:0.35rem;">
							قارن بين عروض الأسعار، الأرصدة، وتواريخ الصلاحية لدى الموردين واختر المورد المناسب لإضافته لطلبيتك
						</p>
					</div>

					<div class="badge badge-sky" style="font-size:0.85rem; padding:0.4rem 0.85rem; font-weight:800;">
						<span>3 موردين يقدمون هذا الصنف حالياً</span>
					</div>
				</div>

				<!-- Offers List -->
				<div style="display:flex; flex-direction:column; gap:1.25rem;">
					for idx, offer := range GetOffersForProduct(product) {
						<div
							x-data={ fmt.Sprintf("{ qty: %d, minQty: %d, maxStock: %d }", offer.MinOrderQty, offer.MinOrderQty, offer.AvailableStock) }
							style="display:grid; grid-template-columns:1.4fr 1.2fr 1fr 1.4fr; gap:1.5rem; align-items:center; padding:1.5rem; background:#ffffff; border:1px solid var(--neutral-200); border-radius:var(--radius-xl); transition:box-shadow 0.2s ease, border-color 0.2s ease;"
							class="hover-lift"
						>
							<!-- Col 1: Supplier Info -->
							<div>
								<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.35rem;">
									<span style="font-weight:900; font-size:1.05rem; color:var(--neutral-900);">{ offer.SupplierName }</span>
									if offer.IsVerified {
										<span class="badge badge-emerald" style="font-size:0.7rem; padding:0.15rem 0.45rem;">مورد معتمد</span>
									}
								</div>
								<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.8rem;">
									@components.RatingStars(offer.SupplierRating, offer.ReviewCount)
								</div>
							</div>

							<!-- Col 2: Batch & Delivery -->
							<div style="font-size:0.825rem; color:var(--neutral-600); display:flex; flex-direction:column; gap:0.35rem;">
								<div>
									<span style="color:var(--neutral-400);">التشغيلة:</span> <strong class="tabular-nums" style="color:var(--neutral-800);">{ offer.BatchNumber }</strong>
									<span style="margin:0 0.35rem; color:var(--neutral-300);">|</span>
									<span style="color:var(--neutral-400);">الصلاحية:</span> <strong class="tabular-nums" style="color:var(--neutral-800);">{ offer.ExpiryDate }</strong>
								</div>
								<div style="color:var(--primary-700); font-weight:700; display:flex; align-items:center; gap:0.35rem;">
									@components.IconTruck("icon-xxs")
									<span>{ offer.DeliveryEstimate }</span>
								</div>
							</div>

							<!-- Col 3: Pricing & Stock -->
							<div>
								<div style="font-size:1.35rem; font-weight:900; color:var(--primary-700);" class="tabular-nums">
									{ offer.Price.String() } ج.م
								</div>
								<div style="font-size:0.75rem; color:var(--neutral-500); margin-top:0.15rem;">
									الرصيد: <strong class="tabular-nums" style="color:var(--neutral-700);">{ fmt.Sprintf("%d", offer.AvailableStock) }</strong> عبوة
									<span style="margin:0 0.25rem; color:var(--neutral-300);">•</span>
									الحد الأدنى: <span class="tabular-nums">{ fmt.Sprintf("%d", offer.MinOrderQty) }</span>
								</div>
							</div>

							<!-- Col 4: Quantity and Add To Cart Action -->
							<div>
								<form action="/cart/add" method="POST" style="display:flex; align-items:center; gap:0.6rem; margin:0; justify-content:flex-end;">
									<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
									if len(variants) > 0 {
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", variants[0].ID) } />
									} else {
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", product.ID) } />
									}
									<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", offer.SupplierID) } />

									<!-- Stepper -->
									<div class="quantity-control" style="background:var(--neutral-100); border-radius:var(--radius-md); padding:2px; display:inline-flex; align-items:center;">
										<button
											type="button"
											class="quantity-btn"
											@click={ fmt.Sprintf("if (qty > %d) qty--", offer.MinOrderQty) }
											style="width:28px; height:28px; border:none; background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center;"
											title="تقليل الكمية"
										>
											@components.IconMinus("icon-xs")
										</button>

										<input
											type="number"
											name="quantity"
											x-model="qty"
											style="width:44px; text-align:center; border:none; background:transparent; font-weight:800; font-size:0.9rem;"
											class="tabular-nums"
											readonly
										/>

										<button
											type="button"
											class="quantity-btn"
											@click="qty++"
											style="width:28px; height:28px; border:none; background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center;"
											title="زيادة الكمية"
										>
											@components.IconPlus("icon-xs")
										</button>
									</div>

									<button
										type="submit"
										class={ "btn btn-sm", templ.KV("btn-primary", idx == 0), templ.KV("btn-secondary", idx > 0) }
										style="padding:0.6rem 1.1rem; font-weight:800; white-space:nowrap;"
									>
										@components.IconCart("icon-xs")
										<span>إضافة للطلبية</span>
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- 3. Pharmacy Customer Reviews & Ratings -->
			<div class="card" style="margin-bottom:0; padding:2.5rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card); box-shadow:var(--shadow-sm);">
				<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.5rem;">
					@components.IconCheckCircle("icon-md")
					<h3 style="font-size:1.35rem; font-weight:800; color:var(--neutral-900); margin:0;">
						تقييمات وتجارب الصيادلة
					</h3>
				</div>

				<div style="display:grid; grid-template-columns:260px 1fr; gap:2.5rem; align-items:start;">
					<!-- Score Overview Card -->
					<div style="background:var(--neutral-50); border:1px solid var(--neutral-200); border-radius:var(--radius-xl); padding:1.75rem; text-align:center;">
						<div style="font-size:3.25rem; font-weight:900; color:var(--primary-700); line-height:1;" class="tabular-nums">
							4.9
						</div>
						<div style="margin:0.5rem 0 0.25rem 0;">
							@components.RatingStars(4.9, 0)
						</div>
						<div style="font-size:0.8rem; color:var(--neutral-500);">
							بناءً على 148 تقييم صيدلية موثقة
						</div>
					</div>

					<!-- Reviews List -->
					<div style="display:flex; flex-direction:column; gap:1.25rem;">
						<div style="padding:1.25rem; background:var(--neutral-50); border-radius:var(--radius-lg); border:1px solid var(--neutral-200);">
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
								<span style="font-weight:800; font-size:0.925rem; color:var(--neutral-900);">صيدلية النصر المركزية — د. حسام فتحي</span>
								<span style="font-size:0.75rem; color:var(--neutral-400);" class="tabular-nums">منذ 3 أيام</span>
							</div>
							<div style="margin-bottom:0.4rem;">
								@components.RatingStars(5.0, 0)
							</div>
							<p style="font-size:0.875rem; color:var(--neutral-700); line-height:1.6; margin:0;">
								صنف دوائي أصلي وتاريخ صلاحية ممتد لعام 2028. تم التوريد والتسليم خلال أقل من 18 ساعة بسيارة مبردة مطابقة للمواصفات.
							</p>
						</div>

						<div style="padding:1.25rem; background:var(--neutral-50); border-radius:var(--radius-lg); border:1px solid var(--neutral-200);">
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
								<span style="font-weight:800; font-size:0.925rem; color:var(--neutral-900);">مجموعة صيدليات الحياة — فرع المعادي</span>
								<span style="font-size:0.75rem; color:var(--neutral-400);" class="tabular-nums">منذ أسبوع</span>
							</div>
							<div style="margin-bottom:0.4rem;">
								@components.RatingStars(4.8, 0)
							</div>
							<p style="font-size:0.875rem; color:var(--neutral-700); line-height:1.6; margin:0;">
								سعر منافس جداً مقارنة بالسوق وتوافر كميات كبيرة للتوريد الفوري. الفواتير الإلكترونية ممتازة ودقيقة.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}

func productTitle(p *catalog.Product) string {
	if p == nil {
		return "تفاصيل المنتج الدوائي"
	}
	if p.Name["ar"] != "" {
		return p.Name["ar"]
	}
	return p.Name["en"]
}
