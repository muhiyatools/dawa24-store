package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/imageurl"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerProductDetail(product *catalog.Product, variants []*catalog.ProductVariant, offers []SupplierOffer, lang, dir string) {
	@layouts.ShellFor(productTitle(product)+" | "+i18n.T(lang, "product.title_suffix"), "catalog", lang, dir, authctx.FromContext(ctx)) {
		<div class="py-2">
			
			<!-- Breadcrumb Navigation -->
			<nav class="d-flex items-center gap-2 text-xs text-muted mb-4 flex-wrap font-bold" aria-label={ i18n.T(lang, "nav.breadcrumb") }>
				{{ actor := authctx.FromContext(ctx) }}
				{{ dashboardURL := "/customer/dashboard" }}
				{{ if actor.IsVendor() {
					dashboardURL = "/vendor/dashboard"
				} else if actor.IsStaff {
					dashboardURL = "/admin/dashboard"
				} }}
				<a href={ templ.SafeURL(dashboardURL) } class="text-secondary transition-colors">{ i18n.T(lang, "nav.dashboard") }</a>
				<span>/</span>
				<a href="/catalog" class="text-secondary transition-colors">{ i18n.T(lang, "nav.catalog") }</a>
				<span>/</span>
				<span class="text-primary font-black">{ productTitle(product) }</span>
			</nav>

			<!-- Sponsored Product Top Banner if offer is sponsored -->
			if len(offers) > 0 && offers[0].IsSponsored {
				<div class="product-detail-sponsored-banner mb-4 shadow-xs">
					<div class="d-flex items-center gap-2.5">
						<span class="sponsored-star">★</span>
						<div class="stack-2xs text-start">
							<strong class="text-xs font-black text-amber-900 leading-tight">{ i18n.T(lang, "product.sponsored_banner_title") }</strong>
							<span class="text-2xs text-amber-800 font-medium">{ i18n.T(lang, "product.sponsored_banner_desc") }</span>
						</div>
					</div>
					<span class="badge badge-amber text-xs font-extrabold shadow-2xs">{ i18n.T(lang, "product.sponsored_ad") }</span>
				</div>
			}

			<!-- 1. Hero Product Showcase Grid (2 Columns: Media & Master Specs) -->
			<div class="glass-panel p-6 mb-6 border rounded-2xl shadow-xs">
				<div class="catalog-product-detail-layout">
					
					<!-- Col 1 (Right in RTL): Product Media, Official Package & Trust Signals -->
					<div class="d-flex flex-col gap-4">
						<div class="p-6 rounded-2xl bg-surface-raised border d-flex flex-col items-center justify-center relative overflow-hidden">
							<div class="absolute top-3 start-3">
								<span class="badge badge-emerald text-xs font-bold gap-1">
									@components.IconCheck("icon-xs")
									<span>{ i18n.T(lang, "product.certified_item") }</span>
								</span>
							</div>

							if product.Image != "" {
								@components.ProductImage(imageurl.Full(product.Image, productTitle(product), "max-h-60 max-w-full object-contain my-3"))
							} else {
								<div class="w-24 h-24 rounded-2xl bg-primary-subtle text-primary flex-center text-3xl mb-3 mt-4">
									@components.IconPill("icon-lg")
								</div>
								<div class="font-extrabold text-sm text-primary">{ i18n.T(lang, "product.official_package") }</div>
								<span class="text-xs text-muted">{ i18n.T(lang, "product.eda_compliant") }</span>
							}
						</div>

						<!-- Pharmacist Trust Signals -->
						<div class="p-3 bg-surface-raised rounded-xl border stack-2xs text-xs">
							<div class="d-flex items-center gap-2 text-success font-bold">
								@components.IconCheckCircle("icon-xs")
								<span>{ i18n.T(lang, "product.trust_expiry_check") }</span>
							</div>
							<div class="d-flex items-center gap-2 text-primary font-bold">
								@components.IconShield("icon-xs")
								<span>{ i18n.T(lang, "product.trust_secure_supply") }</span>
							</div>
						</div>
					</div>

					<!-- Col 2 (Left in RTL): Clinical Specifications & Purchasing -->
					<div class="d-flex flex-col gap-4">
						<!-- Header Block -->
						<div>
							<div class="d-flex items-center gap-2 mb-2 flex-wrap">
								if product.ManufacturingCompanies != "" {
									<span class="badge badge-slate text-xs font-bold gap-1">
										@components.IconBuilding("icon-2xs")
										<span>{ product.ManufacturingCompanies }</span>
									</span>
								}
								if product.DosageForm != "" {
									<span class="badge badge-sky text-xs font-bold">
										{ product.DosageForm }
									</span>
								}
							</div>

							<h1 class="text-2xl font-black text-primary m-0 mb-1 leading-tight">
								{ productTitle(product) }
							</h1>
							
							if product.Name["en"] != "" && product.Name["en"] != product.Name["ar"] {
								<div class="text-sm text-muted font-mono mb-2 font-bold" dir="ltr">
									{ product.Name["en"] }
								</div>
							}
						</div>

						<!-- Master Attributes Grid -->
						if product.Active != "" || (product.ScientificName != "" && product.ScientificName != product.Active) || product.Barcode != "" {
							<div class="d-grid grid-auto-fit-sm p-4 rounded-xl bg-surface-raised border text-xs gap-3">
								if product.Active != "" {
									<div>
										<span class="text-muted d-block text-xs mb-1 font-bold">{ i18n.T(lang, "product.active_ingredient") }</span>
										<strong class="text-primary font-bold">{ product.Active }</strong>
									</div>
								}
								if product.ScientificName != "" && product.ScientificName != product.Active {
									<div>
										<span class="text-muted d-block text-xs mb-1 font-bold">{ i18n.T(lang, "product.scientific_name") }</span>
										<strong class="text-primary font-bold">{ product.ScientificName }</strong>
									</div>
								}
								if product.Barcode != "" {
									<div>
										<span class="text-muted d-block text-xs mb-1 font-bold">{ i18n.T(lang, "product.gtin_barcode") }</span>
										<strong class="text-primary font-mono">{ product.Barcode }</strong>
									</div>
								}
							</div>
						}

						<!-- Variants Packaging Strip -->
						if len(variants) > 0 {
							<div>
								<label class="text-xs font-extrabold text-primary d-block mb-2">
									{ i18n.T(lang, "product.registered_variants") }
								</label>
								<div class="d-flex flex-wrap gap-2">
									for _, v := range variants {
										<div class="p-2 px-3 rounded-lg bg-surface-raised border text-xs d-flex items-center gap-2">
											<span class="font-bold text-primary">
												if v.Name["ar"] != "" {
													{ v.Name["ar"] }
												} else {
													{ v.SKU }
												}
											</span>
											if v.Price.IsPositive() {
												<span class="text-brand font-black tabular-nums font-mono">
													{ fmt.Sprintf("%s %s", v.Price.String(), i18n.T(lang, "common.currency_egp")) }
												</span>
											}
										</div>
									}
								</div>
							</div>
						}

						<!-- Primary Purchase Box / Special Sourcing Card -->
						@CustomerProductDetailBuyBox(product, offers, lang, dir)

					</div>

				</div>
			</div>

			<!-- 2. Other Supplier Offers Comparison Table -->
			@CustomerProductDetailOffersTable(product, offers, lang)

		</div>

		<script>
			function stepCatalogQty(btn, delta) {
				const form = btn.closest('form') || btn.closest('.product-detail-buy-box');
				if (!form) return;
				const input = form.querySelector('input[name="qty"]');
				if (input) {
					let val = parseInt(input.value, 10) || 1;
					val += delta;
					const min = parseInt(input.getAttribute('min') || '1', 10);
					const max = parseInt(input.getAttribute('max') || '9999', 10);
					if (val < min) val = min;
					if (val > max && max > 0) val = max;
					input.value = val;
				}
			}
		</script>
		@CustomerNegotiationModal()
	}
}
