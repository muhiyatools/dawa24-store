package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerProductDetail(product *catalog.Product, variants []*catalog.ProductVariant, offers []SupplierOffer, lang, dir string) {
	@layouts.ShellFor(productTitle(product)+" | تفاصيل عرض التوريد", "catalog", lang, dir, authctx.FromContext(ctx)) {
		<div class="py-2">
			
			<!-- Breadcrumb Navigation -->
			<nav class="d-flex items-center gap-2 text-xs text-muted mb-4 flex-wrap font-bold" aria-label="مسار التنقل">
				<a href="/customer/dashboard" class="text-secondary transition-colors">لوحة التحكم</a>
				<span>/</span>
				<a href="/catalog" class="text-secondary transition-colors">كتالوج الأدوية</a>
				<span>/</span>
				<span class="text-primary font-black">{ productTitle(product) }</span>
			</nav>

			<!-- 1. Hero Product Showcase Grid (2 Columns: Media & Master Specs) -->
			<div class="glass-panel p-6 mb-6 border rounded-2xl shadow-xs">
				<div class="catalog-product-detail-layout">
					
					<!-- Col 1 (Right in RTL): Product Media, Official Package & Trust Signals -->
					<div class="d-flex flex-col gap-4">
						<div class="p-6 rounded-2xl bg-surface-sunken border d-flex flex-col items-center justify-center relative overflow-hidden">
							<div class="absolute top-3 start-3">
								<span class="badge badge-emerald text-xs font-bold gap-1">
									@components.IconCheck("icon-xs")
									<span>صنف معتمد 100%</span>
								</span>
							</div>

							if product.Image != "" {
								<img src={ product.Image } alt={ productTitle(product) } class="max-h-60 max-w-full object-contain my-3" />
							} else {
								<div class="w-24 h-24 rounded-2xl bg-primary-subtle text-primary flex-center text-3xl mb-3 mt-4">
									@components.IconPill("icon-lg")
								</div>
								<div class="font-extrabold text-sm text-primary">العبوة الرسمية المسجلة</div>
								<span class="text-xs text-muted">مطابق لمعايير هيئة الدواء المصرية</span>
							}
						</div>

						<!-- Pharmacist Trust Signals -->
						<div class="p-3 bg-surface-sunken rounded-xl border stack-2xs text-xs">
							<div class="d-flex items-center gap-2 text-success font-bold">
								@components.IconCheckCircle("icon-xs")
								<span>فحص ومطابقة الصلاحية قبل الشحن</span>
							</div>
							<div class="d-flex items-center gap-2 text-primary font-bold">
								@components.IconShield("icon-xs")
								<span>سلسلة توريد دوائي آمنة ومباشرة</span>
							</div>
						</div>
					</div>

					<!-- Col 2 (Left in RTL): Clinical Specifications & Purchasing -->
					<div class="d-flex flex-col gap-4">
						<!-- Header Block -->
						<div>
							<div class="d-flex items-center gap-2 mb-2 flex-wrap">
								if product.ManufacturingCompanies != "" {
									<span class="badge badge-slate text-xs font-bold gap-1">
										@components.IconBuilding("icon-2xs")
										<span>{ product.ManufacturingCompanies }</span>
									</span>
								}
								if product.DosageForm != "" {
									<span class="badge badge-sky text-xs font-bold">
										{ product.DosageForm }
									</span>
								}
							</div>

							<h1 class="text-2xl font-black text-primary m-0 mb-1 leading-tight">
								{ productTitle(product) }
							</h1>
							
							if product.Name["en"] != "" && product.Name["en"] != product.Name["ar"] {
								<div class="text-sm text-muted font-mono mb-2 font-bold" dir="ltr">
									{ product.Name["en"] }
								</div>
							}
						</div>

						<!-- Master Attributes Grid -->
						<div class="d-grid grid-auto-fit-sm p-4 rounded-xl bg-surface-sunken border text-xs gap-3">
							if product.Active != "" {
								<div>
									<span class="text-muted d-block text-xs mb-1 font-bold">المادة الفعالة:</span>
									<strong class="text-primary font-bold">{ product.Active }</strong>
								</div>
							}
							if product.ScientificName != "" && product.ScientificName != product.Active {
								<div>
									<span class="text-muted d-block text-xs mb-1 font-bold">الاسم العلمي / التركيز:</span>
									<strong class="text-primary font-bold">{ product.ScientificName }</strong>
								</div>
							}
							if product.Barcode != "" {
								<div>
									<span class="text-muted d-block text-xs mb-1 font-bold">الباركود الدولي (GTIN):</span>
									<strong class="text-primary font-mono">{ product.Barcode }</strong>
								</div>
							}
						</div>

						<!-- Variants Packaging Strip -->
						if len(variants) > 0 {
							<div>
								<label class="text-xs font-extrabold text-primary d-block mb-2">
									العبوات والتنويعات المسجلة:
								</label>
								<div class="d-flex flex-wrap gap-2">
									for _, v := range variants {
										<div class="p-2 px-3 rounded-lg bg-surface-sunken border text-xs d-flex items-center gap-2">
											<span class="font-bold text-primary">
												if v.Name["ar"] != "" {
													{ v.Name["ar"] }
												} else {
													{ v.SKU }
												}
											</span>
											if v.Price.IsPositive() {
												<span class="text-brand font-black tabular-nums font-mono">
													{ v.Price.String() } ج.م
												</span>
											}
										</div>
									}
								</div>
							</div>
						}

						<!-- Primary Purchase Box / Special Sourcing Card -->
						<div class="p-5 rounded-2xl bg-surface-sunken border d-flex flex-col gap-4 shadow-xs product-detail-buy-box">
							if len(offers) > 0 {
								<!-- Supplier Info -->
								<div class="flex-between items-center pb-3 border-b">
									<div class="d-flex items-center gap-2">
										<div class="w-8 h-8 rounded-lg bg-primary-subtle text-primary flex-center text-sm">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<div class="text-xs font-extrabold text-primary">
												{ offers[0].SupplierName }
											</div>
											if offers[0].BranchName != "" {
												<div class="text-xs text-muted">
													{ offers[0].BranchName }
												</div>
											}
										</div>
									</div>

									if offers[0].IsVerified {
										<span class="badge badge-emerald text-xs font-bold">معتمد</span>
									}
								</div>

								<!-- Pricing Block -->
								<div>
									<div class="text-xs text-muted font-bold mb-1">
										سعر التوريد للصيدلية:
									</div>
									<div class="d-flex items-baseline gap-2 flex-wrap">
										<span class="tabular-nums text-2xl font-black text-brand">
											{ offers[0].Price.String() }
										</span>
										<span class="text-xs font-bold text-secondary">ج.م / عبوة</span>

										if offers[0].OldPrice.IsPositive() && offers[0].OldPrice.Minor() > offers[0].Price.Minor() {
											<span class="text-xs text-muted line-through font-mono">
												{ offers[0].OldPrice.String() } ج.م
											</span>
										}
									</div>
									if offers[0].DiscountBPS > 0 {
										<div class="mt-1.5">
											<span class="badge badge-emerald text-xs font-extrabold">
												{ fmt.Sprintf("وفرت %s (خصم %.1f%%)", offers[0].DiscountAmount.String(), float64(offers[0].DiscountBPS)/100.0) }
											</span>
										</div>
									}
								</div>

								<!-- Stock and Limits -->
								<div class="text-xs d-flex flex-col gap-2 py-3 border-t border-b">
									<div class="flex-between">
										<span class="text-muted">المخزون المتاح:</span>
										if offers[0].AvailableStock > 0 {
											<strong class="text-brand font-bold">{ fmt.Sprintf("%d عبوة", offers[0].AvailableStock) }</strong>
										} else {
											<strong class="text-danger font-bold">غير متوفر</strong>
										}
									</div>
									<div class="flex-between">
										<span class="text-muted">الحد الأدنى للطلب:</span>
										<strong class="text-primary font-bold">{ fmt.Sprintf("%d عبوة", max(1, offers[0].MinOrderQty)) }</strong>
									</div>
									if offers[0].ExpiryDate != "" {
										<div class="flex-between">
											<span class="text-muted">تاريخ الصلاحية:</span>
											<strong class="font-mono text-primary">{ offers[0].ExpiryDate }</strong>
										</div>
									}
								</div>

								<!-- Coverage Banner -->
								<div>
									if offers[0].IsCovered {
										<div class="p-2 px-3 rounded-lg bg-emerald-subtle border border-emerald text-emerald text-xs font-bold d-flex items-center gap-2">
											@components.IconTruck("icon-xs")
											<span>مشمول بالتغطية والتوصيل لفرعك</span>
										</div>
									} else {
										<div class="p-2 px-3 rounded-lg bg-danger-subtle border border-danger text-danger text-xs font-bold d-flex items-center gap-2">
											@components.IconAlert("icon-xs")
											<span>
												if offers[0].CoverageReason != "" {
													{ offers[0].CoverageReason }
												} else {
													خارج نطاق التغطية لفرعك الحالي
												}
											</span>
										</div>
									}
								</div>

								<!-- Add to Cart Form -->
								if offers[0].CanAddToCart {
									<form method="POST" action="/cart/add" class="d-flex flex-col gap-3">
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", offers[0].VariantID) } />
										<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
										<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", offers[0].SupplierID) } />
										<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", offers[0].SupplierID) } />
										<input type="hidden" name="offer_price" value={ offers[0].Price.String() } />
										
										<div class="d-flex items-center gap-2">
											<label class="text-xs font-bold text-secondary">الكمية:</label>
											<div class="cart-stepper-control flex-1 justify-between">
												<button type="button" class="cart-stepper-btn" onclick="stepCatalogQty(this, -1)">−</button>
												<input
													type="number"
													name="qty"
													value={ fmt.Sprintf("%d", max(1, offers[0].MinOrderQty)) }
													min={ fmt.Sprintf("%d", max(1, offers[0].MinOrderQty)) }
													max={ fmt.Sprintf("%d", max(1, offers[0].AvailableStock)) }
													class="cart-stepper-input flex-1"
												/>
												<button type="button" class="cart-stepper-btn" onclick="stepCatalogQty(this, 1)">+</button>
											</div>
										</div>

										<button type="submit" class="btn btn-primary font-bold text-xs w-full py-2 gap-1 shadow-sm">
											@components.IconPlus("icon-xs")
											<span>أضف إلى سلة المشتريات</span>
										</button>
									</form>
								} else {
									<button type="button" disabled class="btn btn-secondary text-xs w-full py-2 font-bold cursor-not-allowed opacity-60">
										غير متاح للطلب المباشر
									</button>
								}
							} else {
								<!-- Creative Sourcing Request State (No Offers) -->
								<div class="p-4 text-center d-flex flex-col items-center gap-3">
									<div class="w-12 h-12 rounded-xl bg-primary-subtle text-primary flex-center text-xl">
										@components.IconPackage("icon-md")
									</div>
									<div>
										<h4 class="font-extrabold text-sm text-primary m-0 mb-1">
											لا تتوفر عروض فورية لهذا الصنف حالياً
										</h4>
										<p class="text-xs text-muted m-0 leading-relaxed">
											يمكنك إرسال طلب توريد مباشر لشبكة الموردين والشركات المعتمدة في منطقتك لتلقي عروض الأسعار والتوافر.
										</p>
									</div>
									<a
										href={ templ.SafeURL(fmt.Sprintf("/customer/purchase-request?product_id=%d", product.ID)) }
										class="btn btn-primary btn-sm font-bold gap-1 mt-1"
									>
										@components.IconPlus("icon-xs")
										<span>+ إرسال طلب توريد للموردين</span>
									</a>
								</div>
							}
						</div>

					</div>

				</div>
			</div>

			<!-- 2. Other Supplier Offers Comparison Table -->
			@CustomerProductDetailOffersTable(product, offers)

		</div>

		<script>
			function stepCatalogQty(btn, delta) {
				const form = btn.closest('form') || btn.closest('.product-detail-buy-box');
				if (!form) return;
				const input = form.querySelector('input[name="qty"]');
				if (input) {
					let val = parseInt(input.value, 10) || 1;
					val += delta;
					const min = parseInt(input.getAttribute('min') || '1', 10);
					const max = parseInt(input.getAttribute('max') || '9999', 10);
					if (val < min) val = min;
					if (val > max && max > 0) val = max;
					input.value = val;
				}
			}
		</script>
	}
}

func productTitle(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	if p.Name["ar"] != "" {
		return p.Name["ar"]
	}
	return p.Name["en"]
}