package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerProductDetail(product *catalog.Product, variants []*catalog.ProductVariant, offers []SupplierOffer, lang, dir string) {
	@layouts.PublicShell(productTitle(product), lang, dir) {
		<div class="product-detail-container" style="max-width:1160px; margin:1rem auto 4rem auto; display:flex; flex-direction:column; gap:var(--space-6);">
			
			<!-- Breadcrumb Navigation -->
			<nav style="display:flex; align-items:center; gap:var(--space-2); font-size:var(--text-sm); color:var(--text-muted);">
				<a href="/" style="color:var(--text-secondary); text-decoration:none;">الرئيسية</a>
				<span>/</span>
				<a href="/catalog" style="color:var(--text-secondary); text-decoration:none;">كتالوج الأدوية</a>
				<span>/</span>
				<span style="color:var(--text); font-weight:600;">{ productTitle(product) }</span>
			</nav>

			<!-- 1. Hero Product Specifications & Image Gallery Card -->
			<div class="card" style="margin-bottom:0; display:grid; grid-template-columns:340px 1fr 320px; gap:var(--space-6); align-items:start; padding:var(--space-6); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border);" x-data="{ activeImage: 0 }">
				
				<!-- Col 1: Product Image Gallery -->
				<div style="display:flex; flex-direction:column; gap:var(--space-3);">
					<!-- Main Preview Box -->
					<div style="width:100%; height:300px; border-radius:var(--radius-lg); background:var(--surface-sunken); border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; overflow:hidden;">
						
						<!-- Badge on top of image -->
						<div style="position:absolute; top:12px; inset-inline-start:12px;">
							<span class="badge badge-emerald">
								@components.IconCheck("icon-xs")
								<span>منتج أصلي 100%</span>
							</span>
						</div>

						<!-- Image 0: Main Package -->
						<div x-show="activeImage === 0" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:var(--space-4);">
							if product.Image != "" {
								<img src={ product.Image } alt={ productTitle(product) } style="max-height:200px; max-width:100%; object-fit:contain;" />
							} else {
								<div style="width:84px; height:84px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin-bottom:var(--space-3); border:1px solid var(--border);">
									@components.IconPill("icon-xl")
								</div>
								<div style="font-weight:700; font-size:var(--text-base); color:var(--text);">العبوة الرسمية المعتمدة</div>
								<span style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px;">مسجلة لدى هيئة الدواء</span>
							}
						</div>

						<!-- Image 1: Blister / Units -->
						<div x-show="activeImage === 1" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:var(--space-4);" style="display:none;">
							<div style="width:84px; height:84px; border-radius:var(--radius-lg); background:var(--info-surface); color:var(--info-text); display:flex; align-items:center; justify-content:center; margin-bottom:var(--space-3); border:1px solid var(--info-border);">
								@components.IconPackage("icon-xl")
							</div>
							<div style="font-weight:700; font-size:var(--text-base); color:var(--text);">شريط الأقراص / الوحدات</div>
							<span style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px;">أقراص مغلفة ومحكمة الغلق</span>
						</div>

						<!-- Image 2: Leaflet & Specs -->
						<div x-show="activeImage === 2" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:var(--space-4);" style="display:none;">
							<div style="width:84px; height:84px; border-radius:var(--radius-lg); background:var(--warning-surface); color:var(--warning-text); display:flex; align-items:center; justify-content:center; margin-bottom:var(--space-3); border:1px solid var(--warning-border);">
								@components.IconFile("icon-xl")
							</div>
							<div style="font-weight:700; font-size:var(--text-base); color:var(--text);">بيانات التشغيلة والنشرة</div>
							<span style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px;">دواعي الاستعمال والجرعات</span>
						</div>
					</div>

					<!-- Thumbnails Selector Strip -->
					<div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:var(--space-2);">
						<button
							type="button"
							@click="activeImage = 0"
							:style="activeImage === 0 ? 'border-color:var(--accent); background:var(--accent-subtle); color:var(--accent-text);' : 'border-color:var(--border); background:var(--surface-raised); color:var(--text-secondary);'"
							style="padding:0.45rem 0.25rem; border-radius:var(--radius-md); border:1px solid; cursor:pointer; font-size:var(--text-xs); font-weight:600; text-align:center; font-family:inherit; transition:all 150ms var(--ease-default);"
						>
							العبوة الخارجية
						</button>
						<button
							type="button"
							@click="activeImage = 1"
							:style="activeImage === 1 ? 'border-color:var(--accent); background:var(--accent-subtle); color:var(--accent-text);' : 'border-color:var(--border); background:var(--surface-raised); color:var(--text-secondary);'"
							style="padding:0.45rem 0.25rem; border-radius:var(--radius-md); border:1px solid; cursor:pointer; font-size:var(--text-xs); font-weight:600; text-align:center; font-family:inherit; transition:all 150ms var(--ease-default);"
						>
							شريط الوحدات
						</button>
						<button
							type="button"
							@click="activeImage = 2"
							:style="activeImage === 2 ? 'border-color:var(--accent); background:var(--accent-subtle); color:var(--accent-text);' : 'border-color:var(--border); background:var(--surface-raised); color:var(--text-secondary);'"
							style="padding:0.45rem 0.25rem; border-radius:var(--radius-md); border:1px solid; cursor:pointer; font-size:var(--text-xs); font-weight:600; text-align:center; font-family:inherit; transition:all 150ms var(--ease-default);"
						>
							النشرة الطبية
						</button>
					</div>
				</div>

				<!-- Col 2: Specifications and Details -->
				<div>
					<!-- Badges & Ratings Header -->
					<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--space-3); flex-wrap:wrap; gap:var(--space-2);">
						<div style="display:flex; align-items:center; gap:var(--space-2);">
							<span class="badge badge-sky">
								@components.IconPill("icon-xs")
								<span>
									if product.DosageForm != "" {
										{ product.DosageForm }
									} else {
										أقراص علاجية
									}
								</span>
							</span>
							<span class="badge badge-emerald">
								@components.IconCheck("icon-xs")
								<span>مسجل لدى هيئة الدواء (EDA)</span>
							</span>
						</div>

						<!-- Favorite Button -->
						<form action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", product.ID)) } method="POST" class="m-0">
							<button type="submit" class="btn btn-secondary btn-icon" title="إضافة للمفضلة" style="color:var(--accent); width:34px; height:34px;">
								@components.IconHeart("icon-xs")
							</button>
						</form>
					</div>

					<!-- Titles -->
					<h1 style="font-size:var(--text-xl); font-weight:700; color:var(--text); margin-bottom:2px; line-height:1.3;">
						if product.Name["ar"] != "" {
							{ product.Name["ar"] }
						} else {
							{ product.Name["en"] }
						}
					</h1>
					<h2 style="font-size:var(--text-sm); color:var(--text-muted); font-weight:500; margin-bottom:var(--space-3);">
						{ product.Name["en"] }
					</h2>

					<!-- EDA Verified & Sales Badge -->
					<div style="display:flex; align-items:center; gap:var(--space-3); margin-bottom:var(--space-4); padding-bottom:var(--space-2); border-bottom:1px solid var(--border);">
						if product.SoldTimes > 0 {
							<span class="badge badge-sky" style="font-size:0.75rem; font-weight:700;">
								@components.IconCheckCircle("icon-xs")
								<span>تم توريدها { fmt.Sprintf("%d", product.SoldTimes) } مرة عبر المنصة</span>
							</span>
						} else {
							<span class="badge badge-slate" style="font-size:0.75rem;">
								@components.IconShield("icon-xs")
								<span>صنف دوائي معتمد وموثق</span>
							</span>
						}
					</div>

					<!-- Medical Specifications Matrix -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:var(--space-4); display:flex; flex-direction:column; gap:var(--space-2); font-size:var(--text-sm);">
						if product.ScientificName != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:var(--space-1);">
								<span class="text-muted">المادة الفعالة:</span>
								<strong style="color:var(--text);">{ product.ScientificName }</strong>
							</div>
						}
						if product.ManufacturingCompanies != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:var(--space-1);">
								<span class="text-muted">الشركة المصنعة:</span>
								<strong style="color:var(--text);">{ product.ManufacturingCompanies }</strong>
							</div>
						}
						if product.Barcode != "" {
							<div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:var(--space-1);">
								<span class="text-muted">الباركود الدولي:</span>
								<strong style="color:var(--text);" class="tabular-nums">{ product.Barcode }</strong>
							</div>
						}
						<div style="display:flex; justify-content:space-between;">
							<span class="text-muted">اشتراطات الحفظ:</span>
							<strong style="color:var(--text);">15° - 25° مئوية، بعيداً عن الرطوبة</strong>
						</div>
					</div>
				</div>

				<!-- Right Side: Lowest Price Hero Buy Box -->
				<div style="background:var(--surface-raised); padding:var(--space-5); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; flex-direction:column; gap:var(--space-4);">
					<div>
						if product.HasDiscount() {
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-1);">
								<span style="font-size:var(--text-xs); color:var(--text-muted); text-decoration:line-through;" class="tabular-nums">
									سعر الجمهور: { product.PublicPrice().String() } ج.م
								</span>
								<span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:700; font-size:11px; padding:1px 6px; border-radius:var(--radius-sm);">
									خصم { fmt.Sprintf("%d%%", product.DiscountPercent()) }
								</span>
							</div>
						}
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-1);">
							<div style="font-size:var(--text-xs); color:var(--text-secondary); font-weight:600;">سعر التوريد للصيدلية:</div>
							if len(offers) > 0 {
								<span class="badge badge-emerald">أفضل عرض</span>
							}
						</div>
						if len(offers) > 0 {
							@components.PriceTag(components.PriceBreakdown{
								ListPrice:      offers[0].OldPrice,
								Price:          offers[0].Price,
								DiscountAmount: offers[0].DiscountAmount,
								DiscountBPS:    offers[0].DiscountBPS,
								Large:          true,
							})
						} else if product.NetPrice().IsPositive() {
							@components.PriceTag(components.PriceBreakdown{ Price: product.NetPrice(), Large: true })
						} else {
							<div style="font-size:var(--text-2xl); font-weight:800; color:var(--text-muted);" class="tabular-nums">—</div>
						}
						<div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--space-1);">
							شامل ضريبة القيمة المضافة والفاتورة الإلكترونية
						</div>
						if len(offers) > 0 {
							<div style="font-size:var(--text-xs); color:var(--text-secondary); margin-top:var(--space-2); display:flex; align-items:center; gap:var(--space-1);">
								<span>المورد المعتمد:</span>
								<strong style="color:var(--text);">{ offers[0].SupplierName }</strong>
							</div>
						}
					</div>


					if len(offers) > 0 {
					<form action="/cart/add" method="POST" x-data="{ qty: 1 }" style="display:flex; flex-direction:column; gap:var(--space-3); margin:0;">
						<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
						if offers[0].VariantID > 0 {
							<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", offers[0].VariantID) } />
						} else if len(variants) > 0 {
							<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", variants[0].ID) } />
						} else {
							<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", product.ID) } />
						}
						<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", offers[0].SupplierID) } />
						<input type="hidden" name="offer_id" value={ fmt.Sprintf("%d", offers[0].OfferID) } />
						<input type="hidden" name="offer_price" value={ offers[0].Price.String() } />
						<input type="hidden" name="quantity" :value="qty" />

						<div style="display:flex; align-items:center; justify-content:space-between; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.35rem 0.65rem;">
							<span style="font-size:var(--text-xs); font-weight:600; color:var(--text-secondary);">الكمية المطلوبة:</span>
							<div style="display:flex; align-items:center; gap:var(--space-2);">
								<button type="button" class="btn btn-secondary btn-icon" style="width:28px; height:28px;" @click="if (qty > 1) qty--">-</button>
								<span class="tabular-nums" style="font-weight:700; font-size:var(--text-sm); min-width:2rem; text-align:center; color:var(--text);" x-text="qty"></span>
								<button type="button" class="btn btn-secondary btn-icon" style="width:28px; height:28px;" @click="qty++">+</button>
							</div>
						</div>

						<button type="submit" class="btn btn-primary" style="width:100%; padding:0.7rem; font-size:var(--text-sm); font-weight:600; justify-content:center;">
							@components.IconPlus("icon-xs")
							<span>إضافة للطلبية بأفضل سعر</span>
						</button>
					</form>
					} else {
						<div style="padding:var(--space-4); border:1px dashed var(--border-strong); border-radius:var(--radius-md); font-size:var(--text-xs); color:var(--text-secondary); text-align:center; background:var(--surface-sunken); line-height:1.6;">
							<div style="font-weight:700; color:var(--warning-text); margin-bottom:0.25rem;">تنبيه التغطية والمخزون</div>
							عذراً، لا توجد عروض توريد متوفرة لهذا الصنف في نطاق تغطية صيدليتك حالياً، أو نفدت الكميات من جميع الموردين القريبين.
						</div>
					}

					<div style="border-top:1px solid var(--border); padding-top:var(--space-3);">
						<div style="display:flex; align-items:center; gap:var(--space-2); color:var(--text); font-weight:600; font-size:var(--text-xs); margin-bottom:var(--space-2);">
							@components.IconTruck("icon-xs")
							<span>ضمانات التوريد الدوائي</span>
						</div>
						<ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:var(--space-1); font-size:var(--text-xs); color:var(--text-secondary);">
							<li style="display:flex; align-items:center; gap:var(--space-1);">
								@components.IconCheckCircle("icon-xs")
								<span>توصيل مبرد معتمد (Cold-chain)</span>
							</li>
							<li style="display:flex; align-items:center; gap:var(--space-1);">
								@components.IconCheckCircle("icon-xs")
								<span>فواتير إلكترونية معتمدة</span>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- 2. Multi-Supplier Marketplace Offers Matrix -->
			<div class="card" style="margin-bottom:0; padding:var(--space-6); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border);">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-6); flex-wrap:wrap; gap:var(--space-3); border-bottom:1px solid var(--border); padding-bottom:var(--space-3);">
					<div>
						<div style="display:flex; align-items:center; gap:var(--space-2);">
							<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconBuilding("icon-xs")
							</div>
							<h3 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">
								عروض الموردين والمستودعات المعتمدة
							</h3>
						</div>
						<p style="color:var(--text-muted); font-size:var(--text-xs); margin-top:2px; margin-bottom:0;">
							قارن بين عروض الأسعار، الأرصدة، وتواريخ الصلاحية لدى الموردين
						</p>
					</div>

					<div class="badge badge-sky" style="font-weight:600;">
						<span>{ fmt.Sprintf("%d", len(offers)) } موردين يقدمون هذا الصنف</span>
					</div>
				</div>

				<!-- Offers List -->
				<div style="display:flex; flex-direction:column; gap:var(--space-3);">
					if len(offers) == 0 {
						<div style="padding:var(--space-6); border:1px dashed var(--border-strong); border-radius:var(--radius-xl); text-align:center; color:var(--text-secondary); background:var(--surface-sunken);">
							<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--surface-raised); color:var(--warning-text); display:flex; align-items:center; justify-content:center; margin:0 auto var(--space-3) auto; border:1px solid var(--border);">
								@components.IconTruck("icon-sm")
							</div>
							<h4 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0 0 0.4rem 0;">
								لا توجد عروض توريد متاحة للصيدلية حالياً
							</h4>
							<p style="font-size:0.875rem; color:var(--text-secondary); margin:0; line-height:1.6; max-width:600px; margin:0 auto;">
								عذراً، لا توجد عروض توريد متوفرة لهذا الصنف في نطاق تغطية صيدليتك حالياً، أو نفدت الكميات من جميع الموردين القريبين. يمكنك مراجعة الكتالوج لاحقاً أو طلب توفير الصنف من الموردين المعتمدين.
							</p>
						</div>
					}
					for idx, offer := range offers {
						<div
							x-data={ fmt.Sprintf("{ qty: %d, minQty: %d, maxStock: %d }", offer.MinOrderQty, offer.MinOrderQty, offer.AvailableStock) }
							style="display:grid; grid-template-columns:1.4fr 1.2fr 1fr 1.4fr; gap:var(--space-4); align-items:center; padding:var(--space-4); background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-md); transition:border-color 150ms var(--ease-default);"
						>
							<!-- Col 1: Supplier Info -->
							<div>
								<div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:2px;">
									<span style="font-weight:700; font-size:var(--text-sm); color:var(--text);">{ offer.SupplierName }</span>
									if offer.IsVerified {
										<span class="badge badge-emerald" style="font-size:10px;">مورد معتمد</span>
									}
								</div>
								if offer.SupplierRating > 0 {
									<div style="display:flex; align-items:center; gap:var(--space-1); font-size:var(--text-xs);">
										@components.RatingStars(offer.SupplierRating, offer.ReviewCount)
									</div>
								}
							</div>

							<!-- Col 2: Batch & Delivery -->
							<div style="font-size:var(--text-xs); color:var(--text-secondary); display:flex; flex-direction:column; gap:2px;">
								<div>
									<span class="text-muted">التشغيلة:</span> <strong class="tabular-nums" style="color:var(--text);">{ offer.BatchNumber }</strong>
									<span style="margin:0 var(--space-1); color:var(--border-strong);">|</span>
									<span class="text-muted">الصلاحية:</span> <strong class="tabular-nums" style="color:var(--text);">{ offer.ExpiryDate }</strong>
								</div>
								if offer.DeliveryEstimate != "" {
									<div style="color:var(--accent); font-weight:600; display:flex; align-items:center; gap:var(--space-1);">
										@components.IconTruck("icon-xs")
										<span>{ offer.DeliveryEstimate }</span>
									</div>
								}
							</div>

							<!-- Col 3: Pricing & Stock -->
							<div>
								@components.PriceTag(components.PriceBreakdown{
									ListPrice:      offer.OldPrice,
									Price:          offer.Price,
									DiscountAmount: offer.DiscountAmount,
									DiscountBPS:    offer.DiscountBPS,
								})
								<div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px;">
									if offer.AvailableStock > 0 {
										الرصيد: <strong class="tabular-nums" style="color:var(--text-secondary);">{ fmt.Sprintf("%d", offer.AvailableStock) }</strong>
										<span style="margin:0 var(--space-1); color:var(--border-strong);">•</span>
									}
									الحد الأدنى: <span class="tabular-nums">{ fmt.Sprintf("%d", offer.MinOrderQty) }</span>
								</div>
							</div>

							<!-- Col 4: Quantity and Add To Cart Action -->
							<div>
								<form action="/cart/add" method="POST" style="display:flex; align-items:center; gap:var(--space-2); margin:0; justify-content:flex-end;">
									<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
									if offer.VariantID > 0 {
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", offer.VariantID) } />
									} else if len(variants) > 0 {
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", variants[0].ID) } />
									} else {
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", product.ID) } />
									}
									<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", offer.SupplierID) } />
									<input type="hidden" name="offer_id" value={ fmt.Sprintf("%d", offer.OfferID) } />
									<input type="hidden" name="offer_price" value={ offer.Price.String() } />

									<!-- Stepper -->
									<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:2px; display:inline-flex; align-items:center;">
										<button
											type="button"
											@click={ fmt.Sprintf("if (qty > %d) qty--", offer.MinOrderQty) }
											style="width:26px; height:26px; border:none; background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--text);"
											title="تقليل الكمية"
										>
											@components.IconMinus("icon-xs")
										</button>

										<input
											type="number"
											name="quantity"
											x-model="qty"
											style="width:38px; text-align:center; border:none; background:transparent; font-weight:700; font-size:var(--text-xs); color:var(--text);"
											class="tabular-nums"
											readonly
										/>

										<button
											type="button"
											@click="qty++"
											style="width:26px; height:26px; border:none; background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--text);"
											title="زيادة الكمية"
										>
											@components.IconPlus("icon-xs")
										</button>
									</div>

									<button
										type="submit"
										class={ "btn btn-sm", templ.KV("btn-primary", idx == 0), templ.KV("btn-secondary", idx > 0) }
										style="font-weight:600; white-space:nowrap;"
									>
										@components.IconCart("icon-xs")
										<span>إضافة للطلبية</span>
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- 3. Pharmacy Verified Product Standards -->
			<div class="card" style="margin-bottom:0; padding:var(--space-6); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border);">
				<div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-3);">
					@components.IconCheckCircle("icon-md")
					<h3 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">
						معايير الجودة والرقابة الدوائية
					</h3>
				</div>

				<div style="padding:var(--space-4); background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border); font-size:var(--text-sm); color:var(--text-secondary); line-height:1.7;">
					<p style="margin:0 0 0.5rem 0;">
						يتم فحص وتوريد كافة الأدوية والمستحضرات الدوائية عبر شبكة الموردين المرخصين والمعتمدين رسمياً من هيئة الدواء المصرية، مع الالتزام التام باشتراطات التخزين، النقل المبرد (Cold Chain)، وإصدار الفواتير الإلكترونية المعتمدة.
					</p>
					<div style="display:flex; gap:var(--space-4); flex-wrap:wrap; font-size:var(--text-xs); color:var(--text-muted); padding-top:var(--space-2); border-top:1px solid var(--border);">
						<span>✓ مطابقة للتشغيلات والباركود الدولي</span>
						<span>✓ صلاحية مضمونة وموثقة في الفاتورة</span>
						<span>✓ رقابة مباشرة على درجات الحرارة</span>
					</div>
				</div>
			</div>
		</div>
	}
}

func productTitle(p *catalog.Product) string {
	if p == nil {
		return "تفاصيل المنتج الدوائي"
	}
	if p.Name["ar"] != "" {
		return p.Name["ar"]
	}
	return p.Name["en"]
}
