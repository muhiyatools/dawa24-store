package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerProductDetail(product *catalog.Product, variants []*catalog.ProductVariant, offers []SupplierOffer, lang, dir string) {
	@layouts.PublicShell(productTitle(product)+" | تفاصيل عرض التوريد", lang, dir) {
		<div class="container" style="max-width:1240px; margin:1.5rem auto 4rem auto; display:flex; flex-direction:column; gap:1.75rem; padding:0 1rem;">
			
			<!-- Breadcrumb Navigation -->
			<nav style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--text-muted); flex-wrap:wrap;">
				<a href="/" style="color:var(--text-secondary); text-decoration:none; font-weight:600;">الرئيسية</a>
				<span>/</span>
				<a href="/catalog" style="color:var(--text-secondary); text-decoration:none; font-weight:600;">كتالوج عروض التوريد</a>
				<span>/</span>
				<span style="color:var(--text); font-weight:800;">{ productTitle(product) }</span>
			</nav>

			<!-- 1. Hero Variant Details Card -->
			<div class="card" style="display:grid; grid-template-columns:320px 1fr 340px; gap:1.75rem; align-items:start; padding:2rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:0 6px 24px rgba(0,0,0,0.04);">
				
				<!-- Col 1: Product Image Gallery -->
				<div class="stack-md">
					<div style="width:100%; height:290px; border-radius:var(--radius-xl); background:var(--surface-sunken); border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; overflow:hidden; padding:1.5rem;">
						<div style="position:absolute; top:12px; inset-inline-start:12px;">
							<span class="badge badge-emerald" style="font-weight:800; font-size:0.725rem;">
								@components.IconCheck("icon-xs")
								<span>صنف معتمد 100%</span>
							</span>
						</div>

						if product.Image != "" {
							<img src={ product.Image } alt={ productTitle(product) } style="max-height:220px; max-width:100%; object-fit:contain;" />
						} else {
							<div style="width:90px; height:90px; border-radius:var(--radius-2xl); background:var(--primary-subtle); color:var(--primary-700); display:flex; align-items:center; justify-content:center; font-size:2.5rem; margin-bottom:0.75rem;">
								💊
							</div>
							<div style="font-weight:800; font-size:0.95rem; color:var(--text);">العبوة الرسمية المسجلة</div>
							<span class="text-xs text-muted">مطابق لمعايير هيئة الدواء</span>
						}
					</div>
				</div>

				<!-- Col 2: Product & Variant Specifications -->
				<div class="stack-lg">
					<div>
						<!-- Dosage Badge -->
						if product.DosageForm != "" {
							<span class="badge badge-sky" style="font-size:0.75rem; font-weight:800; margin-bottom:0.5rem; display:inline-block;">
								{ product.DosageForm }
							</span>
						}

						<h1 style="font-size:1.65rem; font-weight:900; color:var(--text); margin:0 0 0.35rem; line-height:1.35;">
							{ productTitle(product) }
						</h1>
						
						if product.Name["en"] != "" && product.Name["en"] != product.Name["ar"] {
							<div style="font-size:0.875rem; color:var(--text-muted); font-weight:600; margin-bottom:0.75rem;" dir="ltr">
								{ product.Name["en"] }
							</div>
						}
					</div>

					<!-- Master Attributes Grid -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem; display:grid; grid-template-columns:1fr 1fr; gap:0.85rem; font-size:0.825rem;">
						if product.ScientificName != "" {
							<div>
								<span style="color:var(--text-muted); display:block; font-size:0.75rem; margin-bottom:2px;">الاسم العلمي / التركيز:</span>
								<strong class="text-primary">{ product.ScientificName }</strong>
							</div>
						}
						if product.Active != "" {
							<div>
								<span style="color:var(--text-muted); display:block; font-size:0.75rem; margin-bottom:2px;">المادة الفعالة:</span>
								<strong class="text-primary">{ product.Active }</strong>
							</div>
						}
						if product.ManufacturingCompanies != "" {
							<div>
								<span style="color:var(--text-muted); display:block; font-size:0.75rem; margin-bottom:2px;">الشركة المصنعة:</span>
								<strong class="text-primary">{ product.ManufacturingCompanies }</strong>
							</div>
						}
						if product.Barcode != "" {
							<div>
								<span style="color:var(--text-muted); display:block; font-size:0.75rem; margin-bottom:2px;">الباركود الدولي:</span>
								<strong style="color:var(--text); font-family:var(--font-mono, monospace);">{ product.Barcode }</strong>
							</div>
						}
					</div>

					<!-- Variants Packaging Strip -->
					if len(variants) > 0 {
						<div>
							<label style="font-size:0.825rem; font-weight:800; color:var(--text); display:block; margin-bottom:0.5rem;">
								العبوات والتنويعات المسجلة:
							</label>
							<div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
								for _, v := range variants {
									<div style="padding:0.5rem 0.85rem; border-radius:var(--radius-lg); background:var(--surface-sunken); border:1px solid var(--border); font-size:0.8rem; display:flex; align-items:center; gap:0.5rem;">
										<span class="fw-700 text-primary">
											if v.Name["ar"] != "" {
												{ v.Name["ar"] }
											} else {
												{ v.SKU }
											}
										</span>
										if v.Price.IsPositive() {
											<span style="color:var(--primary-600); font-weight:800; font-family:var(--font-mono, monospace);">
												{ v.Price.String() } ج.م
											</span>
										}
									</div>
								}
							</div>
						</div>
					}
				</div>

				<!-- Col 3: Primary Purchase Card (Best Offer) -->
				<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem; display:flex; flex-direction:column; gap:1.25rem;">
					if len(offers) > 0 {
						<!-- Supplier Info -->
						<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:0.85rem;">
							<div class="row-center-sm">
								<div style="width:34px; height:34px; border-radius:var(--radius-md); background:rgba(16,185,129,0.12); color:var(--primary-700); display:flex; align-items:center; justify-content:center; font-size:1.1rem;">
									🏢
								</div>
								<div>
									<div style="font-size:0.875rem; font-weight:800; color:var(--text);">
										{ offers[0].SupplierName }
									</div>
									if offers[0].BranchName != "" {
										<div style="font-size:0.725rem; color:var(--text-muted);">
											{ offers[0].BranchName }
										</div>
									}
								</div>
							</div>

							if offers[0].IsVerified {
								<span class="badge badge-emerald" style="font-size:0.7rem; font-weight:700;">معتمد ✓</span>
							}
						</div>

						<!-- Pricing Block -->
						<div>
							<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700; margin-bottom:0.25rem;">
								سعر التوريد للصيدلية:
							</div>
							<div style="display:flex; align-items:baseline; gap:0.5rem; flex-wrap:wrap;">
								<span class="tabular-nums" style="font-size:1.75rem; font-weight:900; color:var(--primary-600); font-family:var(--font-mono, monospace);">
									{ offers[0].Price.String() }
								</span>
								<span style="font-size:0.9rem; font-weight:700; color:var(--text-muted);">ج.م / عبوة</span>

								if offers[0].OldPrice.IsPositive() && offers[0].OldPrice.Minor() > offers[0].Price.Minor() {
									<span style="font-size:0.85rem; color:var(--text-muted); text-decoration:line-through; font-family:var(--font-mono, monospace);">
										{ offers[0].OldPrice.String() } ج.م
									</span>
								}
							</div>
							if offers[0].DiscountBPS > 0 {
								<div style="margin-top:0.35rem;">
									<span class="badge badge-emerald" style="font-weight:800; font-size:0.725rem;">
										{ fmt.Sprintf("وفرت %s (خصم %.1f%%)", offers[0].DiscountAmount.String(), float64(offers[0].DiscountBPS)/100.0) }
									</span>
								</div>
							}
						</div>

						<!-- Stock and Limits -->
						<div style="font-size:0.8rem; display:flex; flex-direction:column; gap:0.4rem; border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:0.75rem 0;">
							<div style="display:flex; justify-content:space-between;">
								<span class="text-muted">المخزون المتاح:</span>
								if offers[0].AvailableStock > 0 {
									<strong style="color:var(--primary-600);">{ fmt.Sprintf("%d عبوة", offers[0].AvailableStock) }</strong>
								} else {
									<strong class="text-danger">غير متوفر</strong>
								}
							</div>
							<div style="display:flex; justify-content:space-between;">
								<span class="text-muted">الحد الأدنى للطلب:</span>
								<strong>{ fmt.Sprintf("%d عبوة", max(1, offers[0].MinOrderQty)) }</strong>
							</div>
							if offers[0].ExpiryDate != "" {
								<div style="display:flex; justify-content:space-between;">
									<span class="text-muted">تاريخ الصلاحية:</span>
									<strong style="font-family:var(--font-mono, monospace);">{ offers[0].ExpiryDate }</strong>
								</div>
							}
						</div>

						<!-- Coverage Banner -->
						<div>
							if offers[0].IsCovered {
								<div style="padding:0.6rem 0.75rem; border-radius:var(--radius-lg); background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.25); color:var(--primary-700); font-size:0.8rem; font-weight:700; display:flex; align-items:center; gap:0.4rem;">
									<span>🚚</span>
									<span>مشمول بالتغطية والتوصيل لفرعك</span>
								</div>
							} else {
								<div style="padding:0.6rem 0.75rem; border-radius:var(--radius-lg); background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.25); color:var(--danger-text); font-size:0.8rem; font-weight:700; display:flex; align-items:center; gap:0.4rem;">
									<span>⚠️</span>
									<span>
										if offers[0].CoverageReason != "" {
											{ offers[0].CoverageReason }
										} else {
											خارج نطاق التغطية لفرعك الحالي
										}
									</span>
								</div>
							}
						</div>

						<!-- Add to Cart Form -->
						if offers[0].CanAddToCart {
							<form method="POST" action="/cart/add" style="display:flex; flex-direction:column; gap:0.75rem; margin:0;">
								<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", offers[0].VariantID) } />
								<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
								<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", offers[0].SupplierID) } />
								<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", offers[0].SupplierID) } />
								<input type="hidden" name="offer_price" value={ offers[0].Price.String() } />
								
								<div class="row-center-sm">
									<label style="font-size:0.8rem; font-weight:700; color:var(--text);">الكمية:</label>
									<input
										type="number"
										name="qty"
										value={ fmt.Sprintf("%d", max(1, offers[0].MinOrderQty)) }
										min={ fmt.Sprintf("%d", max(1, offers[0].MinOrderQty)) }
										max={ fmt.Sprintf("%d", max(1, offers[0].AvailableStock)) }
										class="form-input tabular-nums"
										style="flex:1; height:42px; text-align:center; font-weight:800; font-family:var(--font-mono, monospace); border-radius:var(--radius-lg);"
									/>
								</div>

								<button type="submit" class="btn btn-primary" style="width:100%; font-weight:800; height:44px; border-radius:var(--radius-lg); font-size:0.95rem; justify-content:center;">
									@components.IconPlus("icon-sm")
									<span>أضف إلى سلة المشتريات</span>
								</button>
							</form>
						} else {
							<button type="button" disabled class="btn btn-secondary" style="width:100%; height:44px; border-radius:var(--radius-lg); font-weight:700; opacity:0.6; cursor:not-allowed; justify-content:center;">
								غير متاح للطلب المباشر
							</button>
						}
					} else {
						<div style="text-align:center; padding:2rem 1rem; color:var(--text-muted);">
							<div style="font-size:2rem; margin-bottom:0.5rem;">📦</div>
							<div class="fw-700 text-primary">لا توجد عروض توريد نشطة</div>
							<p style="font-size:0.8rem; margin:0.25rem 0 0;">
								لم يقم أي مورد بإدراج عروض لهذا الصنف حالياً.
							</p>
						</div>
					}
				</div>

			</div>

			<!-- 2. Other Supplier Offers Comparison Table -->
			if len(offers) > 1 {
				<div class="card" style="padding:1.75rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:0 6px 24px rgba(0,0,0,0.03);">
					<h3 style="font-size:1.25rem; font-weight:900; color:var(--text); margin:0 0 1.25rem; display:flex; align-items:center; gap:0.5rem;">
						<span>عروض الموردين الآخرين لنفس الصنف</span>
						<span class="badge badge-slate text-xs">{ fmt.Sprintf("%d موردين", len(offers)) }</span>
					</h3>

					<div class="table-container" style="border:1px solid var(--border); border-radius:var(--radius-xl); overflow:hidden;">
						<table class="b2b-table" style="width:100%; border-collapse:collapse; text-align:start;">
							<thead>
								<tr style="background:var(--surface-sunken); border-bottom:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); text-transform:uppercase;">
									<th style="padding:1rem 1.25rem; font-weight:800;">المورد والفرع</th>
									<th style="padding:1rem; font-weight:800;">سعر التوريد</th>
									<th style="padding:1rem; font-weight:800;">الخصم والوفر</th>
									<th style="padding:1rem; font-weight:800;">المخزون المتاح</th>
									<th style="padding:1rem; font-weight:800;">حالة التغطية</th>
									<th style="padding:1rem 1.25rem; font-weight:800; text-align:end;">الشراء</th>
								</tr>
							</thead>
							<tbody class="text-sm">
								for _, off := range offers {
									<tr style="border-bottom:1px solid var(--border);" class="hover-row">
										<!-- Supplier -->
										<td style="padding:1rem 1.25rem;">
											<div class="fw-800 text-primary">
												{ off.SupplierName }
												if off.IsVerified {
													<span style="color:var(--primary-600); font-size:0.75rem; margin-inline-start:0.25rem;">✓</span>
												}
											</div>
											if off.BranchName != "" {
												<div class="text-xs text-muted">
													{ off.BranchName }
												</div>
											}
										</td>

										<!-- Price -->
										<td style="padding:1rem; font-weight:900; color:var(--primary-600); font-family:var(--font-mono, monospace); font-size:1.05rem;">
											{ off.Price.String() } ج.م
										</td>

										<!-- Discount -->
										<td class="p-md">
											if off.DiscountBPS > 0 {
												<span class="badge badge-emerald text-xs fw-800">
													{ fmt.Sprintf("خصم %.1f%%", float64(off.DiscountBPS)/100.0) }
												</span>
											} else {
												<span class="text-muted text-sm">سعر قياسي</span>
											}
										</td>

										<!-- Stock -->
										<td class="p-md">
											if off.AvailableStock > 0 {
												<span style="color:var(--primary-600); font-weight:700;">{ fmt.Sprintf("%d عبوة", off.AvailableStock) }</span>
											} else {
												<span style="color:var(--danger-text); font-weight:700;">نفد الرصيد</span>
											}
										</td>

										<!-- Coverage -->
										<td class="p-md">
											if off.IsCovered {
												<span class="badge badge-emerald" style="font-size:0.725rem; font-weight:700;">مشمول بالتغطية</span>
											} else {
												<span class="badge badge-rose" style="font-size:0.725rem; font-weight:700;">خارج التغطية</span>
											}
										</td>

										<!-- Action -->
										<td style="padding:1rem 1.25rem; text-align:end;">
											if off.CanAddToCart {
												<form method="POST" action="/cart/add" style="display:inline-flex; gap:0.35rem; margin:0;">
													<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", off.VariantID) } />
													<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) } />
													<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", off.SupplierID) } />
													<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", off.SupplierID) } />
													<input type="hidden" name="offer_price" value={ off.Price.String() } />
													<input type="hidden" name="qty" value={ fmt.Sprintf("%d", max(1, off.MinOrderQty)) } />
													<button type="submit" class="btn btn-primary btn-sm" style="font-weight:800; border-radius:var(--radius-lg); font-size:0.8rem;">
														<span>أضف للسلة</span>
													</button>
												</form>
											} else {
												<button type="button" disabled class="btn btn-secondary btn-sm" style="opacity:0.5; font-size:0.75rem;">
													غير متاح
												</button>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

		</div>
	}
}

func productTitle(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	if p.Name["ar"] != "" {
		return p.Name["ar"]
	}
	return p.Name["en"]
}
