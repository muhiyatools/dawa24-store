package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type TeamMemberView struct {
	ID        int64
	UserID    int64
	Name      string
	Email     string
	Phone     string
	JobTitle  string
	RoleKey   string
	RoleName  string
	IsActive  bool
	CreatedAt string
}

type RolePermissionDef struct {
	Key         string
	NameAr      string
	Description string
	Category    string
}

type VendorTeamData struct {
	Members     []*TeamMemberView
	Roles       []*identity.Role
	Permissions []RolePermissionDef
}

templ VendorTeamPage(data VendorTeamData, lang, dir string) {
	@layouts.VendorShell("إدارة الموظفين وصلاحيات فريق العمل", "team", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:2rem;">
			
			<!-- Header Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 style="font-size:1.6rem; font-weight:900; color:var(--neutral-900); margin:0;">
						فريق العمل وصلاحيات الموظفين
					</h2>
					<p style="color:var(--neutral-500); font-size:0.925rem; margin:0.25rem 0 0 0;">
						إدارة حسابات موظفي المنشأة، تعيين الأدوار، وضبط صلاحيات الوصول لكل قسم
					</p>
				</div>

				<div style="display:flex; gap:0.75rem;">
					<button type="button" class="btn btn-secondary" data-modal-open="manage-roles-modal" style="font-weight:800; padding:0.7rem 1.25rem;">
						@components.IconSettings("icon-xs")
						<span>إدارة وتعديل الأدوار</span>
					</button>

					<button type="button" class="btn btn-primary" data-modal-open="add-employer-modal" style="font-weight:800; padding:0.7rem 1.5rem;">
						@components.IconPlus("icon-xs")
						<span>إضافة موظف جديد</span>
					</button>
				</div>
			</div>

			<!-- Team Overview Cards -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem;">
				<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem 1.5rem; border-inline-start:4px solid var(--primary-600);">
					<div style="font-size:0.825rem; font-weight:700; color:var(--neutral-500);">إجمالي الموظفين</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin-top:0.25rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", len(data.Members)) }
					</div>
					<div style="font-size:0.775rem; color:var(--neutral-400); margin-top:0.25rem;">حسابات مسجلة على المنشأة</div>
				</div>

				<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem 1.5rem; border-inline-start:4px solid var(--success);">
					<div style="font-size:0.825rem; font-weight:700; color:var(--neutral-500);">الحسابات النشطة</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--success); margin-top:0.25rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", countActiveMembers(data.Members)) }
					</div>
					<div style="font-size:0.775rem; color:var(--neutral-400); margin-top:0.25rem;">تسجيل دخول وصلاحيات مفعلة</div>
				</div>

				<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem 1.5rem; border-inline-start:4px solid var(--secondary);">
					<div style="font-size:0.825rem; font-weight:700; color:var(--neutral-500);">الأدوار المعرفة</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin-top:0.25rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", len(data.Roles)) }
					</div>
					<div style="font-size:0.775rem; color:var(--neutral-400); margin-top:0.25rem;">أدوار مخصصة بصلاحيات محددة</div>
				</div>
			</div>

			<!-- Team Members Table -->
			<div class="card" style="padding:0; overflow:hidden; border:1px solid var(--neutral-200); border-radius:var(--radius-xl);">
				<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--neutral-200); display:flex; justify-content:space-between; align-items:center;">
					<h3 style="font-size:1.2rem; font-weight:800; color:var(--neutral-900); margin:0;">
						قائمة موظفي المنشأة والصلاحيات
					</h3>
				</div>

				if len(data.Members) == 0 {
					<div style="padding:4rem 2rem; text-align:center;">
						<div style="width:60px; height:60px; border-radius:var(--radius-full); background:var(--primary-50); color:var(--primary-600); display:flex; align-items:center; justify-content:center; margin:0 auto 1.25rem auto;">
							@components.IconUsers("icon-lg")
						</div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.5rem;">
							لم تقم بإضافة أي موظفين بعد
						</h3>
						<p style="color:var(--neutral-500); font-size:0.9rem; max-width:440px; margin:0 auto 1.5rem auto;">
							يمكنك إضافة موظفين وتحديد صلاحيات محددة لكل موظف مثل إدارة المخزون أو الفواتير أو الشحنات.
						</p>
						<button type="button" class="btn btn-primary" data-modal-open="add-employer-modal" style="font-weight:800;">
							@components.IconPlus("icon-xs")
							<span>إضافة أول موظف</span>
						</button>
					</div>
				} else {
					<div class="table-container" style="margin:0; border:none;">
						<table class="table" style="margin:0;">
							<thead>
								<tr>
									<th>الموظف</th>
									<th>المسمى الوظيفي</th>
									<th>الدور المعين</th>
									<th>البريد الإلكتروني</th>
									<th>الهاتف</th>
									<th>الحالة</th>
									<th>الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range data.Members {
									<tr>
										<td>
											<div style="display:flex; align-items:center; gap:0.75rem;">
												<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; font-weight:900; font-size:0.9rem;">
													@components.IconUser("icon-xs")
												</div>
												<div style="font-weight:800; color:var(--neutral-900);">{ m.Name }</div>
											</div>
										</td>
										<td>
											if m.JobTitle != "" {
												<span style="font-weight:700; color:var(--neutral-700);">{ m.JobTitle }</span>
											} else {
												<span style="color:var(--neutral-400);">غير محدد</span>
											}
										</td>
										<td>
											<span class="badge badge-sky" style="font-weight:800;">
												{ m.RoleName }
											</span>
										</td>
										<td class="tabular-nums" style="color:var(--neutral-600); font-size:0.875rem;">{ m.Email }</td>
										<td class="tabular-nums" style="color:var(--neutral-600); font-size:0.875rem;">{ m.Phone }</td>
										<td>
											if m.IsActive {
												<span class="badge badge-emerald" style="font-weight:800;">نشط</span>
											} else {
												<span class="badge badge-slate" style="font-weight:800;">معطل</span>
											}
										</td>
										<td>
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/team/%d/toggle", m.ID)) } style="margin:0;">
												<button type="submit" class="btn btn-secondary btn-sm" style="font-weight:700; font-size:0.775rem;">
													if m.IsActive {
														<span>تعطيل الحساب</span>
													} else {
														<span>تفعيل الحساب</span>
													}
												</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Add Employer Modal -->
			<div id="add-employer-modal" class="modal-overlay" style="display:none;">
				<div class="modal-card" style="max-width:580px; width:90%; background:#ffffff; border-radius:var(--radius-2xl); padding:2rem; box-shadow:var(--shadow-2xl);">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--neutral-100); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconPlus("icon-xs")
							</div>
							<h3 style="font-size:1.3rem; font-weight:900; color:var(--neutral-900); margin:0;">
								إضافة موظف جديد للمنشأة
							</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon" data-modal-close="add-employer-modal" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/vendor/team/new" style="display:flex; flex-direction:column; gap:1.25rem; margin:0;">
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div>
								<label class="form-label" for="emp-name">اسم الموظف بالكامل *</label>
								<input type="text" id="emp-name" name="name" class="form-input" placeholder="د. أحمد جمال" required />
							</div>
							<div>
								<label class="form-label" for="emp-title">المسمى الوظيفي *</label>
								<input type="text" id="emp-title" name="job_title" class="form-input" placeholder="مسؤول مبيعات وتوريد" required />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div>
								<label class="form-label" for="emp-email">البريد الإلكتروني للدخول *</label>
								<input type="email" id="emp-email" name="email" class="form-input tabular-nums" placeholder="ahmed@company.eg" required />
							</div>
							<div>
								<label class="form-label" for="emp-phone">رقم الهاتف / الواتساب *</label>
								<input type="tel" id="emp-phone" name="phone" class="form-input tabular-nums" placeholder="01099887766" required />
							</div>
						</div>

						<div>
							<label class="form-label" for="emp-role">الدور الوظيفي والصلاحيات الممنوحة *</label>
							<select id="emp-role" name="role_key" class="form-select" required>
								<option value="org_manager">مدير عمليات (كامل صلاحيات التشغيل)</option>
								<option value="org_warehouse">أمين مخزن (الأرصدة، المخازن، والتحويلات)</option>
								<option value="org_accountant">محاسب مالي (الفواتير، المحفظة، والمدفوعات)</option>
								<option value="org_employee" selected>موظف مبيعات وتوريد (الأصناف والشحنات)</option>
							</select>
							<p style="font-size:0.8rem; color:var(--neutral-500); margin-top:0.35rem;">
								يتم تقييد ظهور الصفحات في لوحة التحكم تلقائياً وفقاً للصلاحيات الممنوحة لهذا الدور.
							</p>
						</div>

						<div>
							<label class="form-label" for="emp-pass">كلمة المرور المبدئية *</label>
							<input type="password" id="emp-pass" name="password" minlength="8" class="form-input" placeholder="••••••••" required />
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" data-modal-close="add-employer-modal">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.75rem 1.75rem;">
								@components.IconCheck("icon-xs")
								<span>إنشاء حساب الموظف</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Manage Roles & Permissions Modal -->
			<div id="manage-roles-modal" class="modal-overlay" style="display:none;">
				<div class="modal-card" style="max-width:720px; width:95%; max-height:90vh; overflow-y:auto; background:#ffffff; border-radius:var(--radius-2xl); padding:2rem; box-shadow:var(--shadow-2xl);">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--neutral-100); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconSettings("icon-xs")
							</div>
							<h3 style="font-size:1.3rem; font-weight:900; color:var(--neutral-900); margin:0;">
								مصفوفة الأدوار والصلاحيات
							</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon" data-modal-close="manage-roles-modal" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<div style="display:flex; flex-direction:column; gap:1.25rem;">
						<div class="card" style="margin-bottom:0; background:var(--neutral-50); border:1px solid var(--neutral-200); padding:1.25rem;">
							<h4 style="font-size:1rem; font-weight:900; color:var(--neutral-900); margin:0 0 0.5rem 0;">
								الأدوار الافتراضية وصلاحيات كل دور:
							</h4>
							<div style="display:flex; flex-direction:column; gap:0.75rem; font-size:0.875rem;">
								<div style="background:#fff; padding:0.75rem 1rem; border-radius:var(--radius-md); border:1px solid var(--neutral-200);">
									<strong style="color:var(--primary-800);">1. مدير العمليات (Manager):</strong>
									<span style="color:var(--neutral-600); margin-inline-start:0.5rem;">إدارة المنتجات، المخازن، أوامر التوريد، الفروع، والتوظيف.</span>
								</div>
								<div style="background:#fff; padding:0.75rem 1rem; border-radius:var(--radius-md); border:1px solid var(--neutral-200);">
									<strong style="color:var(--primary-800);">2. أمين المخزن (Warehouse Keeper):</strong>
									<span style="color:var(--neutral-600); margin-inline-start:0.5rem;">تعديل الأرصدة، جرد المخازن، والتحويلات المخزنية بين الفروع.</span>
								</div>
								<div style="background:#fff; padding:0.75rem 1rem; border-radius:var(--radius-md); border:1px solid var(--neutral-200);">
									<strong style="color:var(--primary-800);">3. المحاسب المالي (Accountant):</strong>
									<span style="color:var(--neutral-600); margin-inline-start:0.5rem;">الاطلاع على الفواتير، تسوية المحفظة المالية، وعمليات السحب والإيداع.</span>
								</div>
								<div style="background:#fff; padding:0.75rem 1rem; border-radius:var(--radius-md); border:1px solid var(--neutral-200);">
									<strong style="color:var(--primary-800);">4. موظف المبيعات (Employee):</strong>
									<span style="color:var(--neutral-600); margin-inline-start:0.5rem;">متابعة الشحنات، تحديث حالات التوريد، والرد على طلبات التسعير.</span>
								</div>
							</div>
						</div>

						<div style="display:flex; justify-content:flex-end;">
							<button type="button" class="btn btn-primary" data-modal-close="manage-roles-modal" style="font-weight:800; padding:0.65rem 1.5rem;">
								إغلاق
							</button>
						</div>
					</div>
				</div>
			</div>

		</div>
	}
}

func countActiveMembers(members []*TeamMemberView) int {
	count := 0
	for _, m := range members {
		if m.IsActive {
			count++
		}
	}
	return count
}
