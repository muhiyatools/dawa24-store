package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type TeamMemberView struct {
	ID           int64
	UserID       int64
	Name         string
	Email        string
	Phone        string
	JobTitle     string
	EmployeeCode string
	BranchName   string
	RoleKey      string
	RoleName     string
	IsActive     bool
	CreatedAt    string
}

type BranchOption struct {
	ID   int64
	Name string
}

type RolePermissionDef struct {
	Key         string
	NameAr      string
	Description string
	Category    string
}

type VendorTeamData struct {
	NoticeType  string
	NoticeMsg   string
	Members     []*TeamMemberView
	Branches    []*BranchOption
	Roles       []*identity.Role
	Permissions []RolePermissionDef
}

templ VendorTeamPage(data VendorTeamData, lang, dir string) {
	@layouts.VendorShell("إدارة الموظفين وفريق العمل | دواء 24", "team", lang, dir) {
		<div
			x-data="{
				showAddModal: false,
				searchQuery: '',
				roleFilter: 'all',
				statusFilter: 'all',
				matchesFilter(m) {
					const q = this.searchQuery.toLowerCase().trim();
					const matchesSearch = !q || 
						(m.name && m.name.toLowerCase().includes(q)) || 
						(m.email && m.email.toLowerCase().includes(q)) || 
						(m.phone && m.phone.toLowerCase().includes(q)) || 
						(m.jobTitle && m.jobTitle.toLowerCase().includes(q)) || 
						(m.code && m.code.toLowerCase().includes(q));
					
					const matchesRole = this.roleFilter === 'all' || m.roleKey === this.roleFilter;
					const matchesStatus = this.statusFilter === 'all' || 
						(this.statusFilter === 'active' && m.isActive) || 
						(this.statusFilter === 'inactive' && !m.isActive);
					
					return matchesSearch && matchesRole && matchesStatus;
				}
			}"
			style="display:flex; flex-direction:column; gap:1.75rem; max-width:1380px; margin:0 auto; padding-bottom:4rem;"
		>
			
			<!-- Notice / Alert Banner -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger" style="display:flex; align-items:center; gap:0.85rem; padding:1.1rem 1.5rem; border-radius:var(--radius-xl); background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:var(--danger-text); font-weight:700; box-shadow:0 4px 16px rgba(239,68,68,0.1);">
						<span class="text-2xl">⚠️</span>
						<span style="font-size:0.95rem;">{ data.NoticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success" style="display:flex; align-items:center; gap:0.85rem; padding:1.1rem 1.5rem; border-radius:var(--radius-xl); background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.3); color:var(--primary-700); font-weight:700; box-shadow:0 4px 16px rgba(16,185,129,0.1);">
						<span class="text-2xl">✅</span>
						<span style="font-size:0.95rem;">{ data.NoticeMsg }</span>
					</div>
				}
			}

			<!-- Header Action Bar -->
			<div class="card" style="padding:1.75rem 2rem; background:linear-gradient(135deg, var(--surface-raised) 0%, var(--surface-sunken) 100%); border-radius:var(--radius-2xl); border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem; box-shadow:0 6px 24px rgba(0,0,0,0.05);">
				<div style="display:flex; align-items:center; gap:1.25rem;">
					<div style="width:54px; height:54px; border-radius:var(--radius-xl); background:linear-gradient(135deg, rgba(14,165,233,0.15), rgba(16,185,129,0.15)); border:1px solid rgba(14,165,233,0.3); color:var(--primary-600); display:flex; align-items:center; justify-content:center; font-size:1.6rem; flex-shrink:0;">
						👥
					</div>
					<div>
						<h1 style="font-size:1.65rem; font-weight:900; color:var(--text); margin:0; letter-spacing:-0.02em;">
							فريق العمل وصلاحيات الموظفين
						</h1>
						<p style="color:var(--text-secondary); font-size:0.875rem; margin:0.35rem 0 0 0; line-height:1.5;">
							إدارة حسابات موظفي المنشأة، تعيين الصلاحيات والأدوار، وتوزيع الصلاحيات التشغيلية عبر الفروع والمخازن.
						</p>
					</div>
				</div>

				<div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
					<a href="/vendor/roles" class="btn btn-secondary" style="font-weight:700; border-radius:var(--radius-xl); padding:0.65rem 1.25rem; display:inline-flex; align-items:center; gap:0.5rem; border:1px solid var(--border); background:var(--surface-raised);">
						@components.IconSettings("icon-xs")
						<span>الأدوار والصلاحيات ⚙️</span>
					</a>
					<button
						type="button"
						@click="showAddModal = true"
						class="btn btn-primary"
						style="font-weight:800; border-radius:var(--radius-xl); padding:0.65rem 1.5rem; display:inline-flex; align-items:center; gap:0.5rem; box-shadow:0 4px 14px rgba(16,185,129,0.35);"
					>
						@components.IconPlus("icon-xs")
						<span>+ إضافة موظف جديد</span>
					</button>
				</div>
			</div>

			<!-- Team Overview Metrics Cards -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.25rem;">
				<!-- Total Staff -->
				<div class="card" style="padding:1.35rem 1.6rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); border-inline-start:4px solid var(--primary-600); box-shadow:0 4px 16px rgba(0,0,0,0.03);">
					<div class="flex-between">
						<span style="font-size:0.825rem; font-weight:700; color:var(--text-muted);">إجمالي فريق العمل</span>
						<span class="text-xl">👥</span>
					</div>
					<div style="font-size:2rem; font-weight:900; color:var(--text); margin-top:0.4rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", len(data.Members)) }
					</div>
					<div style="font-size:0.775rem; color:var(--text-secondary); margin-top:0.25rem;">حساب مسجل بالمنشأة</div>
				</div>

				<!-- Active Accounts -->
				<div class="card" style="padding:1.35rem 1.6rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); border-inline-start:4px solid #10b981; box-shadow:0 4px 16px rgba(0,0,0,0.03);">
					<div class="flex-between">
						<span style="font-size:0.825rem; font-weight:700; color:var(--text-muted);">الحسابات النشطة</span>
						<span class="text-xl">⚡</span>
					</div>
					<div style="font-size:2rem; font-weight:900; color:#10b981; margin-top:0.4rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", countActiveMembers(data.Members)) }
					</div>
					<div style="font-size:0.775rem; color:var(--text-secondary); margin-top:0.25rem;">تمتلك صلاحيات تسجيل دخول فعالة</div>
				</div>

				<!-- Managers & Operations -->
				<div class="card" style="padding:1.35rem 1.6rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); border-inline-start:4px solid #6366f1; box-shadow:0 4px 16px rgba(0,0,0,0.03);">
					<div class="flex-between">
						<span style="font-size:0.825rem; font-weight:700; color:var(--text-muted);">الإدارة والعمليات</span>
						<span class="text-xl">🛡️</span>
					</div>
					<div style="font-size:2rem; font-weight:900; color:#6366f1; margin-top:0.4rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", countManagers(data.Members)) }
					</div>
					<div style="font-size:0.775rem; color:var(--text-secondary); margin-top:0.25rem;">مالك ومدراء بصلاحيات تشغيلية</div>
				</div>

				<!-- Branches Covered -->
				<div class="card" style="padding:1.35rem 1.6rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); border-inline-start:4px solid #0ea5e9; box-shadow:0 4px 16px rgba(0,0,0,0.03);">
					<div class="flex-between">
						<span style="font-size:0.825rem; font-weight:700; color:var(--text-muted);">الفروع والمخازن</span>
						<span class="text-xl">🏢</span>
					</div>
					<div style="font-size:2rem; font-weight:900; color:#0ea5e9; margin-top:0.4rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", len(data.Branches)) }
					</div>
					<div style="font-size:0.775rem; color:var(--text-secondary); margin-top:0.25rem;">مواقع تشغيل وتوريد مسجلة</div>
				</div>
			</div>

			<!-- Team Members Table Section -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 6px 24px rgba(0,0,0,0.04); overflow:hidden;">
				
				<!-- Table Control Bar: Search & Filter -->
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem; padding-bottom:1.25rem; border-bottom:1px solid var(--border);">
					<div class="row-center">
						<h3 style="font-size:1.2rem; font-weight:900; color:var(--text); margin:0;">
							قائمة موظفي المنشأة
						</h3>
						<span class="badge badge-neutral" style="font-weight:800; font-size:0.8rem; padding:0.2rem 0.65rem; border-radius:var(--radius-pill);">
							{ fmt.Sprintf("%d", len(data.Members)) }
						</span>
					</div>

					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap; flex:1; max-width:650px; justify-content:flex-end;">
						<!-- Search Input -->
						<div style="position:relative; min-width:240px; flex:1;">
							<input
								type="text"
								x-model="searchQuery"
								placeholder="بحث بالاسم، البريد، الهاتف، أو الكود..."
								class="form-input"
								style="height:42px; padding-inline-start:2.5rem; border-radius:var(--radius-xl); font-size:0.875rem;"
							/>
							<span style="position:absolute; inset-inline-start:0.9rem; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none; font-size:0.95rem;">
								🔍
							</span>
						</div>

						<!-- Role Filter -->
						<select x-model="roleFilter" class="form-input" style="height:42px; min-width:145px; border-radius:var(--radius-xl); font-size:0.85rem;">
							<option value="all">كل الأدوار</option>
							<option value="org_owner">مالك المنشأة</option>
							<option value="org_manager">مدير عمليات</option>
							<option value="org_employee">موظف مبيعات وتوريد</option>
							<option value="org_warehouse">أمين مخزن</option>
							<option value="org_accountant">محاسب مالي</option>
						</select>

						<!-- Status Filter -->
						<select x-model="statusFilter" class="form-input" style="height:42px; min-width:120px; border-radius:var(--radius-xl); font-size:0.85rem;">
							<option value="all">كل الحالات</option>
							<option value="active">النشط فقط</option>
							<option value="inactive">المعطل فقط</option>
						</select>
					</div>
				</div>

				if len(data.Members) == 0 {
					<!-- Empty State when no members exist -->
					<div style="padding:4.5rem 2rem; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center;">
						<div style="width:76px; height:76px; border-radius:var(--radius-2xl); background:linear-gradient(135deg, rgba(16,185,129,0.12), rgba(14,165,233,0.12)); border:1px dashed rgba(16,185,129,0.35); display:flex; align-items:center; justify-content:center; font-size:2.25rem; margin-bottom:1.25rem;">
							👥
						</div>
						<h4 class="text-xl fw-800 text-primary m-0">لا يوجد موظفون مضافون حالياً</h4>
						<p style="font-size:0.9rem; color:var(--text-secondary); max-width:420px; margin:0.5rem 0 1.5rem; line-height:1.6;">
							ابدأ بإضافة موظفي المبيعات، أمناء المخازن، أو المحاسبين لمنشأتك وتعيين صلاحياتهم التشغيلية فوراً.
						</p>
						<button
							type="button"
							@click="showAddModal = true"
							class="btn btn-primary"
							style="font-weight:800; border-radius:var(--radius-xl); padding:0.75rem 2rem; box-shadow:0 4px 16px rgba(16,185,129,0.35);"
						>
							@components.IconPlus("icon-xs")
							<span>+ إضافة أول موظف الآن</span>
						</button>
					</div>
				} else {
					<div style="overflow-x:auto; margin:0 -1.75rem -1.75rem -1.75rem;">
						<table style="width:100%; border-collapse:collapse; text-align:start; font-size:0.875rem;">
							<thead>
								<tr style="background:var(--surface-sunken); border-bottom:1px solid var(--border); color:var(--text-muted); font-size:0.775rem; text-transform:uppercase; font-weight:800; letter-spacing:0.04em;">
									<th style="padding:1rem 1.5rem;">الموظف والتعريف</th>
									<th class="p-card-sm">المسمى الوظيفي</th>
									<th class="p-card-sm">الدور والصلاحية</th>
									<th class="p-card-sm">الفرع / الموقع</th>
									<th class="p-card-sm">البريد الإلكتروني</th>
									<th class="p-card-sm">رقم الهاتف</th>
									<th style="padding:1rem 1.25rem; text-align:center;">الحالة</th>
									<th style="padding:1rem 1.5rem; text-align:end;">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range data.Members {
									<tr
										x-show={ fmt.Sprintf("matchesFilter({ name: %q, email: %q, phone: %q, jobTitle: %q, code: %q, roleKey: %q, isActive: %t })", m.Name, m.Email, m.Phone, m.JobTitle, m.EmployeeCode, m.RoleKey, m.IsActive) }
										style="border-bottom:1px solid var(--border); transition:background 0.15s ease;"
										onmouseover="this.style.background='var(--surface-sunken)'"
										onmouseout="this.style.background='transparent'"
									>
										<!-- Employee Info & Avatar -->
										<td style="padding:1rem 1.5rem;">
											<div style="display:flex; align-items:center; gap:0.85rem;">
												<div style="width:40px; height:40px; border-radius:var(--radius-xl); background:linear-gradient(135deg, rgba(16,185,129,0.18), rgba(14,165,233,0.18)); border:1px solid rgba(16,185,129,0.25); color:var(--primary-600); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.95rem; flex-shrink:0;">
													{ getInitials(m.Name) }
												</div>
												<div>
													<div style="font-weight:800; color:var(--text); font-size:0.925rem;">
														{ m.Name }
														if m.RoleKey == "org_owner" {
															<span style="font-size:0.7rem; font-weight:800; color:#d97706; background:rgba(217,119,6,0.12); padding:0.15rem 0.45rem; border-radius:var(--radius-pill); margin-inline-start:0.35rem; border:1px solid rgba(217,119,6,0.25);">المالك</span>
														}
													</div>
													if m.EmployeeCode != "" {
														<div class="mono" style="font-size:0.725rem; color:var(--text-muted); margin-top:0.15rem;">
															كود: #{ m.EmployeeCode }
														</div>
													}
												</div>
											</div>
										</td>

										<!-- Job Title -->
										<td style="padding:1rem 1.25rem; color:var(--text-secondary); font-weight:600;">
											if m.JobTitle != "" {
												<span>{ m.JobTitle }</span>
											} else {
												<span class="text-muted text-sm">—</span>
											}
										</td>

										<!-- Role Badge -->
										<td class="p-card-sm">
											if m.RoleKey == "org_owner" {
												<span class="badge" style="font-size:0.775rem; font-weight:800; padding:0.3rem 0.75rem; border-radius:var(--radius-pill); background:rgba(217,119,6,0.12); color:#b45309; border:1px solid rgba(217,119,6,0.3);">
													👑 { m.RoleName }
												</span>
											} else if m.RoleKey == "org_manager" {
												<span class="badge" style="font-size:0.775rem; font-weight:800; padding:0.3rem 0.75rem; border-radius:var(--radius-pill); background:rgba(99,102,241,0.12); color:#4338ca; border:1px solid rgba(99,102,241,0.3);">
													🛡️ { m.RoleName }
												</span>
											} else if m.RoleKey == "org_warehouse" {
												<span class="badge" style="font-size:0.775rem; font-weight:800; padding:0.3rem 0.75rem; border-radius:var(--radius-pill); background:rgba(16,185,129,0.12); color:#047857; border:1px solid rgba(16,185,129,0.3);">
													{ m.RoleName }
												</span>
											} else if m.RoleKey == "org_accountant" {
												<span class="badge" style="font-size:0.775rem; font-weight:800; padding:0.3rem 0.75rem; border-radius:var(--radius-pill); background:rgba(14,165,233,0.12); color:#0369a1; border:1px solid rgba(14,165,233,0.3);">
													💰 { m.RoleName }
												</span>
											} else {
												<span class="badge" style="font-size:0.775rem; font-weight:800; padding:0.3rem 0.75rem; border-radius:var(--radius-pill); background:rgba(100,116,139,0.12); color:#334155; border:1px solid rgba(100,116,139,0.3);">
													🤝 { m.RoleName }
												</span>
											}
										</td>

										<!-- Branch / Location -->
										<td style="padding:1rem 1.25rem; color:var(--text-secondary);">
											if m.BranchName != "" {
												<div class="row-center-sm">
													<span style="font-size:0.85rem;">🏢</span>
													<span class="fw-700">{ m.BranchName }</span>
												</div>
											} else {
												<span style="color:var(--text-muted); font-size:0.8rem; background:var(--surface-sunken); padding:0.2rem 0.6rem; border-radius:var(--radius-pill); border:1px solid var(--border);">
													كل الفروع / الإدارة
												</span>
											}
										</td>

										<!-- Email -->
										<td class="tabular-nums" style="padding:1rem 1.25rem; color:var(--text); font-size:0.85rem;">
											if m.Email != "" {
												<a href={ templ.SafeURL("mailto:" + m.Email) } style="color:var(--primary-600); text-decoration:none; font-weight:600;">
													{ m.Email }
												</a>
											} else {
												<span class="text-muted">—</span>
											}
										</td>

										<!-- Phone -->
										<td class="tabular-nums" style="padding:1rem 1.25rem; color:var(--text-secondary); font-size:0.85rem; font-weight:600;">
											if m.Phone != "" {
												<span>{ m.Phone }</span>
											} else {
												<span class="text-muted">—</span>
											}
										</td>

										<!-- Status Badge -->
										<td style="padding:1rem 1.25rem; text-align:center;">
											if m.IsActive {
												<span class="badge" style="display:inline-flex; align-items:center; gap:0.35rem; font-size:0.75rem; font-weight:800; padding:0.25rem 0.7rem; border-radius:var(--radius-pill); background:rgba(16,185,129,0.12); color:#047857; border:1px solid rgba(16,185,129,0.25);">
													<span style="width:6px; height:6px; border-radius:50%; background:#10b981; display:inline-block;"></span>
													<span>نشط</span>
												</span>
											} else {
												<span class="badge" style="display:inline-flex; align-items:center; gap:0.35rem; font-size:0.75rem; font-weight:800; padding:0.25rem 0.7rem; border-radius:var(--radius-pill); background:rgba(100,116,139,0.12); color:#475569; border:1px solid rgba(100,116,139,0.25);">
													<span style="width:6px; height:6px; border-radius:50%; background:#94a3b8; display:inline-block;"></span>
													<span>معطل</span>
												</span>
											}
										</td>

										<!-- Actions -->
										<td style="padding:1rem 1.5rem; text-align:end;">
											<div style="display:inline-flex; gap:0.5rem; align-items:center;">
												if m.RoleKey != "org_owner" {
													<!-- Toggle Active Status Form -->
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/team/%d/toggle", m.ID)) } class="m-0">
														<button
															type="submit"
															class="btn btn-secondary btn-xs"
															style="font-weight:700; border-radius:var(--radius-lg); padding:0.35rem 0.75rem;"
															title={ ifElseStr(m.IsActive, "تعطيل حساب الموظف", "تفعيل حساب الموظف") }
														>
															if m.IsActive {
																<span>تعطيل</span>
															} else {
																<span style="color:#047857;">تفعيل</span>
															}
														</button>
													</form>

													<!-- Delete Member Form -->
													<form
														method="POST"
														action={ templ.SafeURL(fmt.Sprintf("/vendor/team/%d/delete", m.ID)) }
														class="m-0"
														onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذا الموظف من المنشأة نهائياً؟');"
													>
														<button
															type="submit"
															class="btn btn-secondary btn-xs"
															style="font-weight:700; border-radius:var(--radius-lg); padding:0.35rem 0.75rem; color:var(--danger-text); border-color:rgba(239,68,68,0.25); background:rgba(239,68,68,0.04);"
															title="حذف الموظف"
														>
															<span>حذف</span>
														</button>
													</form>
												} else {
													<span style="font-size:0.75rem; color:var(--text-muted); font-weight:700; padding:0.25rem 0.5rem;">
														الحساب الرئيسي
													</span>
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- ========================================== -->
			<!-- Add Employee Modern Modal Dialog (Alpine) -->
			<!-- ========================================== -->
			<div
				x-show="showAddModal"
				x-cloak
				style="display:none; position:fixed; inset:0; z-index:9999; overflow-y:auto;"
				aria-labelledby="modal-title"
				role="dialog"
				aria-modal="true"
			>
				<!-- Modal Backdrop -->
				<div
					x-show="showAddModal"
					x-transition:enter="transition ease-out duration-300"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					@click="showAddModal = false"
					style="position:fixed; inset:0; background:rgba(0,0,0,0.65); backdrop-filter:blur(8px); transition:opacity 0.25s ease;"
				></div>

				<!-- Modal Dialog Wrapper -->
				<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:1.5rem; text-align:center;">
					<div
						x-show="showAddModal"
						x-transition:enter="transition ease-out duration-300"
						x-transition:enter-start="opacity-0 scale-95 translate-y-4"
						x-transition:enter-end="opacity-100 scale-100 translate-y-0"
						x-transition:leave="transition ease-in duration-200"
						x-transition:leave-start="opacity-100 scale-100 translate-y-0"
						x-transition:leave-end="opacity-0 scale-95 translate-y-4"
						@click.away="showAddModal = false"
						@keydown.escape.window="showAddModal = false"
						class="card"
						style="width:100%; max-width:680px; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:2rem 2.25rem; text-align:start; box-shadow:0 25px 60px rgba(0,0,0,0.35); position:relative; z-index:10000;"
					>
						<!-- Modal Header -->
						<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.75rem; border-bottom:1px solid var(--border); padding-bottom:1.25rem;">
							<div style="display:flex; align-items:center; gap:1rem;">
								<div style="width:48px; height:48px; border-radius:var(--radius-xl); background:linear-gradient(135deg, rgba(16,185,129,0.15), rgba(14,165,233,0.15)); color:var(--primary-600); display:flex; align-items:center; justify-content:center; font-size:1.4rem; border:1px solid rgba(16,185,129,0.3); flex-shrink:0;">
									👤
								</div>
								<div>
									<h3 id="modal-title" style="font-size:1.35rem; font-weight:900; color:var(--text); margin:0;">
										إضافة وتعيين موظف جديد
									</h3>
									<p style="font-size:0.825rem; color:var(--text-secondary); margin:0.25rem 0 0; line-height:1.4;">
										أدخل بيانات الموظف وسيتم إنشاء حسابه وربطه بصلاحيات المنشأة فوراً.
									</p>
								</div>
							</div>

							<button
								type="button"
								@click="showAddModal = false"
								style="width:36px; height:36px; border-radius:var(--radius-lg); background:var(--surface-sunken); border:1px solid var(--border); color:var(--text-muted); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:1.1rem; transition:all 0.15s ease;"
								onmouseover="this.style.color='var(--text)'; this.style.borderColor='var(--text-muted)'"
								onmouseout="this.style.color='var(--text-muted)'; this.style.borderColor='var(--border)'"
							>
								✕
							</button>
						</div>

						<!-- Modal Form -->
						<form method="POST" action="/vendor/team/new" class="stack-lg">
							<!-- Row 1: Name & Title -->
							<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.15rem;">
								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										اسم الموظف بالكامل <span class="text-danger">*</span>
									</label>
									<input type="text" name="name" class="form-input" placeholder="مثال: د. أحمد جمال" style="height:44px; border-radius:var(--radius-xl);" required />
								</div>

								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										المسمى الوظيفي <span class="text-danger">*</span>
									</label>
									<input type="text" name="job_title" class="form-input" placeholder="مثال: مسؤول مبيعات وتوريد" style="height:44px; border-radius:var(--radius-xl);" required />
								</div>
							</div>

							<!-- Row 2: Email & Phone -->
							<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.15rem;">
								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										البريد الإلكتروني للدخول <span class="text-danger">*</span>
									</label>
									<input type="email" name="email" class="form-input tabular-nums" placeholder="ahmed@company.eg" style="height:44px; border-radius:var(--radius-xl);" required />
								</div>

								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										رقم الهاتف / الواتساب <span class="text-danger">*</span>
									</label>
									<input type="tel" name="phone" class="form-input tabular-nums" placeholder="01099887766" style="height:44px; border-radius:var(--radius-xl);" required />
								</div>
							</div>

							<!-- Row 3: Role & Branch -->
							<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.15rem;">
								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										الدور الوظيفي والصلاحيات <span class="text-danger">*</span>
									</label>
									<select name="role_key" class="form-input" style="height:44px; border-radius:var(--radius-xl);" required>
										<option value="org_employee" selected>موظف مبيعات وتوريد (الأصناف والشحنات)</option>
										<option value="org_manager">مدير عمليات (صلاحيات تشغيلية كاملة)</option>
										<option value="org_warehouse">أمين مخزن (الأرصدة والمخازن)</option>
										<option value="org_accountant">محاسب مالي (الفواتير والمدفوعات)</option>
									</select>
								</div>

								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										الفرع / المخزن التابع له
									</label>
									<select name="branch_id" class="form-input" style="height:44px; border-radius:var(--radius-xl);">
										<option value="">كل الفروع / الإدارة العامة</option>
										for _, b := range data.Branches {
											<option value={ fmt.Sprintf("%d", b.ID) }>{ b.Name }</option>
										}
									</select>
								</div>
							</div>

							<!-- Row 4: Employee Code & Initial Password -->
							<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.15rem;">
								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										كود الموظف (اختياري)
									</label>
									<input type="text" name="employee_code" class="form-input" placeholder="مثال: EMP-101" style="height:44px; border-radius:var(--radius-xl);" />
								</div>

								<div>
									<label class="form-label" style="font-size:0.825rem; font-weight:800; color:var(--text); margin-bottom:0.4rem; display:block;">
										كلمة المرور المبدئية <span class="text-danger">*</span>
									</label>
									<input type="password" name="password" minlength="6" class="form-input" value="Password123!" style="height:44px; border-radius:var(--radius-xl);" required />
								</div>
							</div>

							<!-- Modal Action Footer -->
							<div style="display:flex; justify-content:flex-end; gap:0.85rem; margin-top:1rem; border-top:1px solid var(--border); padding-top:1.5rem;">
								<button
									type="button"
									@click="showAddModal = false"
									class="btn btn-secondary"
									style="font-weight:700; border-radius:var(--radius-xl); padding:0.65rem 1.35rem;"
								>
									إلغاء
								</button>
								<button
									type="submit"
									class="btn btn-primary"
									style="font-weight:800; font-size:0.95rem; border-radius:var(--radius-xl); padding:0.65rem 1.85rem; box-shadow:0 4px 14px rgba(16,185,129,0.35);"
								>
									@components.IconCheck("icon-xs")
									<span>حفظ وإضافة الموظف فوراً 💾</span>
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>

		</div>
	}
}

func countActiveMembers(members []*TeamMemberView) int {
	count := 0
	for _, m := range members {
		if m.IsActive {
			count++
		}
	}
	return count
}

func countManagers(members []*TeamMemberView) int {
	count := 0
	for _, m := range members {
		if m.RoleKey == "org_owner" || m.RoleKey == "org_manager" {
			count++
		}
	}
	return count
}

func getInitials(name string) string {
	runes := []rune(name)
	if len(runes) == 0 {
		return "م"
	}
	if len(runes) > 1 && (runes[0] == 'د' || runes[0] == 'D') && (runes[1] == '.' || runes[1] == ' ') {
		// Skip "د. " prefix if present
		trimmed := []rune(name)
		for i := 2; i < len(trimmed); i++ {
			if trimmed[i] != ' ' && trimmed[i] != '.' {
				return string(trimmed[i])
			}
		}
	}
	return string(runes[0])
}

func ifElseStr(cond bool, a, b string) string {
	if cond {
		return a
	}
	return b
}

