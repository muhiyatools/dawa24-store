package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// The assignment control.
//
// It is one component used from three screens — أوامر التوريد, the dispatch
// board, and a parcel's own page — because "hand this to a مندوب" is one
// action and a second copy of the form is a second place for the ownership
// rules to be got wrong. returnTo tells the handler which screen to come back
// to; it is a key, not a URL, so the field cannot become an open redirect.

templ VendorDeliveryAssignForm(sh *commerce.OrderShipment, couriers []DeliveryCourierOption, returnTo string) {
	if sh.Status == commerce.StatusCancelled || sh.Status == commerce.StatusReturned || sh.Status == commerce.StatusRefunded {
		<div class="d-flex items-center gap-2 text-xs text-muted">
			@components.IconCheckCircle("icon-2xs")
			<span>طرد ملغي أو مرتجع — لا يمكن تغيير المندوب المسؤول عنه.</span>
		</div>
	} else if len(couriers) == 0 {
		<div class="d-flex items-center gap-2 text-xs text-secondary flex-wrap">
			@components.IconInfo("icon-2xs")
			<span>لا يوجد مندوبو توصيل في منشأتك بعد.</span>
			<a href="/vendor/team" class="font-bold text-decoration-none">
				أضف موظفاً بدور «مندوب توصيل» من فريق العمل ←
			</a>
		</div>
	} else {
		<div class="d-flex items-center gap-2 flex-wrap">
			<form
				action={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d/assign", sh.ID)) }
				method="POST"
				class="m-0 d-flex items-center gap-2 flex-wrap"
			>
				if returnTo != "" {
					<input type="hidden" name="return_to" value={ returnTo }/>
				}
				<label class="text-xs font-bold text-secondary">
					if sh.CourierUserID == nil {
						إسناد إلى مندوب:
					} else {
						تغيير المندوب:
					}
				</label>
				<select name="courier_user_id" required class="form-select text-xs">
					<option value="">— اختر المندوب —</option>
					for _, c := range couriers {
						<option
							value={ fmt.Sprintf("%d", c.UserID) }
							selected?={ sh.IsAssignedTo(c.UserID) }
						>
							{ deliveryCourierLabel(c) }
						</option>
					}
				</select>
				<button type="submit" class="btn btn-primary btn-sm font-bold text-xs gap-1.5">
					@components.IconTruck("icon-2xs")
					<span>إسناد الطرد</span>
				</button>
			</form>

			if sh.CourierUserID != nil {
				<form
					action={ templ.SafeURL(fmt.Sprintf("/vendor/delivery/%d/unassign", sh.ID)) }
					method="POST"
					class="m-0 d-inline"
				>
					if returnTo != "" {
						<input type="hidden" name="return_to" value={ returnTo }/>
					}
					<button type="submit" class="btn btn-secondary btn-sm font-bold text-xs">
						سحب الطرد من المندوب
					</button>
				</form>
			}
		</div>

		if sh.CourierName != "" && sh.CourierAssignedAt != nil {
			<div class="text-2xs text-muted mt-2 tabular-nums font-mono">
				مسند حالياً إلى { sh.CourierName } منذ { sh.CourierAssignedAt.Format("2006-01-02 03:04 PM") }
			</div>
		}
	}
}

// deliveryCourierLabel identifies a representative the way a dispatcher picks
// one: by name, then by whatever distinguishes two people with the same one.
func deliveryCourierLabel(c DeliveryCourierOption) string {
	label := c.Name
	if c.EmployeeCode != "" {
		label += " (" + c.EmployeeCode + ")"
	}
	if c.BranchName != "" {
		label += " — " + c.BranchName
	}
	return label
}
