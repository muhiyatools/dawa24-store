package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/ingest"
	"github.com/muhiya/dawa24-store/internal/shared/productmatch"
)

templ importReviewStage(view VendorImportView) {
	<div class="card p-4">
		<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.25rem;">
			<div>
				<h2 class="wiz-head mb-1" style="font-size:1.35rem; font-weight:800;">4. مراجعة الأصناف والمطابقة</h2>
				<p class="wiz-sub mb-0 text-muted" style="font-size:0.9rem;">
					راجع جميع أصناف الملف، عدّل الأسماء والأسعار والكميات، واربط الأصناف بالكتالوج المركزي قبل الحفظ النهائي في قاعدة البيانات.
				</p>
			</div>
			<div class="row-center-sm">
				<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/back-settings") }>
					<button type="submit" class="btn btn-ghost btn-sm">⚙️ تعديل الإعدادات</button>
				</form>
				<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/cancel") }
					onsubmit="return confirm('هل أنت متأكد من إلغاء عملية الاستيراد وحذف البيانات المؤقتة؟');">
					<button type="submit" class="btn btn-ghost btn-sm text-danger">✕ إلغاء</button>
				</form>
			</div>
		</div>

		<!-- Counters Grid -->
		<div class="wiz-stats mb-4" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:0.75rem;">
			<div class="card p-3 text-center" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px;">
				<div class="text-xs text-muted font-bold">إجمالي الأصناف</div>
				<div class="font-extrabold text-xl mt-1 text-slate-800">{ fmt.Sprint(view.Session.TotalRows) }</div>
			</div>
			<div class="card p-3 text-center" style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px;">
				<div class="text-xs font-bold" style="color:#166534;">مطابق بالكتالوج</div>
				<div class="font-extrabold text-xl mt-1" style="color:#15803d;">{ fmt.Sprint(view.Session.MatchedRows) }</div>
			</div>
			<div class="card p-3 text-center" style="background:#fffbeb; border:1px solid #fde68a; border-radius:10px;">
				<div class="text-xs font-bold" style="color:#92400e;">يحتاج مراجعة</div>
				<div class="font-extrabold text-xl mt-1" style="color:#b45309;">{ fmt.Sprint(view.Session.ReviewRows) }</div>
			</div>
			<div class="card p-3 text-center" style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px;">
				<div class="text-xs font-bold" style="color:#991b1b;">غير مطابق</div>
				<div class="font-extrabold text-xl mt-1" style="color:#dc2626;">{ fmt.Sprint(view.Session.UnmatchedRows) }</div>
			</div>
			if view.Session.ErrorRows > 0 {
				<div class="card p-3 text-center" style="background:#fdf2f8; border:1px solid #fbcfe8; border-radius:10px;">
					<div class="text-xs font-bold" style="color:#9d174d;">أخطاء بالبيانات</div>
					<div class="font-extrabold text-xl mt-1" style="color:#db2777;">{ fmt.Sprint(view.Session.ErrorRows) }</div>
				</div>
			}
		</div>

		<!-- Filter Bar -->
		<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; padding:0.75rem; background:#f1f5f9; border-radius:10px; margin-bottom:1rem;">
			<!-- Filter Tabs -->
			<div class="row-center-sm" style="flex-wrap:wrap; gap:0.4rem;">
				@reviewFilterTab(view, "", "الكل (" + fmt.Sprint(view.Session.TotalRows) + ")")
				@reviewFilterTab(view, "matched", "مطابق (" + fmt.Sprint(view.Session.MatchedRows) + ")")
				@reviewFilterTab(view, "review", "يحتاج مراجعة (" + fmt.Sprint(view.Session.ReviewRows) + ")")
				@reviewFilterTab(view, "unmatched", "غير مطابق (" + fmt.Sprint(view.Session.UnmatchedRows) + ")")
			</div>

			<!-- Search & Per Page -->
			<form method="GET" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID) } style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
				if view.Filter.MatchLevel != "" {
					<input type="hidden" name="match" value={ view.Filter.MatchLevel }/>
				}
				<div style="position:relative; min-width:200px;">
					<input type="text" name="q" value={ view.Filter.Search } placeholder="بحث بالاسم أو الكود..."
						class="form-control form-control-sm" style="padding-left:1.5rem; font-size:0.85rem;"/>
				</div>
				<select name="limit" onchange="this.form.submit()" class="form-select form-select-sm" style="width:auto; font-size:0.85rem;">
					<option value="10" selected?={ view.PerPage == 10 }>10 صفوف</option>
					<option value="25" selected?={ view.PerPage == 25 || view.PerPage == 0 }>25 صنف</option>
					<option value="50" selected?={ view.PerPage == 50 }>50 صنف</option>
					<option value="100" selected?={ view.PerPage == 100 }>100 صنف</option>
				</select>
				<button type="submit" class="btn btn-secondary btn-sm">بحث</button>
				if view.Filter.Search != "" {
					<a href={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s?match=%s&limit=%d", view.Session.PublicID, view.Filter.MatchLevel, view.PerPage)) } class="btn btn-ghost btn-sm text-xs">إلغاء البحث</a>
				}
			</form>
		</div>

		<!-- Table -->
		<div class="table-wrap" style="border:1px solid #e2e8f0; border-radius:10px; overflow-x:auto;">
			<table class="table" style="margin-bottom:0; font-size:0.875rem; width:100%; border-collapse:collapse;">
				<thead style="background:#f8fafc; border-bottom:2px solid #e2e8f0;">
					<tr>
						<th style="width:40px; text-align:center; padding:0.6rem 0.5rem;">استيراد</th>
						<th style="width:45px; text-align:center; padding:0.6rem 0.5rem;">#</th>
						<th style="min-width:180px; padding:0.6rem 0.75rem;">الصنف في الملف المرفوع</th>
						<th style="min-width:220px; padding:0.6rem 0.75rem;">الصنف المطابق بالكتالوج المركزي</th>
						<th style="min-width:180px; padding:0.6rem 0.75rem;">اسم الصنف لديك (Variant Name)</th>
						<th style="width:90px; padding:0.6rem 0.5rem; text-align:center;">السعر</th>
						<th style="width:75px; padding:0.6rem 0.5rem; text-align:center;">الكمية</th>
						<th style="width:130px; text-align:center; padding:0.6rem 0.5rem;">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					if len(view.Rows) == 0 {
						<tr>
							<td colspan="8" class="text-center p-5 text-muted">
								<div style="font-size:1.1rem; font-weight:700;">لا توجد أصناف مطابقة للتصفية الحالية</div>
								<div class="text-xs mt-1">جرّب تغيير التبويب أو إزالة كلمات البحث.</div>
							</td>
						</tr>
					}
					for _, row := range view.Rows {
						@reviewTableRow(view, row)
					}
				</tbody>
			</table>
		</div>

		<!-- Pagination Footer -->
		if view.RowTotal > 0 {
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-top:1rem; padding-top:0.75rem;">
				<div class="text-xs text-muted">
					عرض <strong>{ fmt.Sprint(len(view.Rows)) }</strong> من إجمالي <strong>{ fmt.Sprint(view.RowTotal) }</strong> صنف
				</div>
				@reviewPagination(view)
			</div>
		}

		<!-- Action Footer Bar -->
		<div class="card mt-4 mb-0" style="background:#f8fafc; border:2px solid #cbd5e1; border-radius:12px; padding:1.25rem;">
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div>
					<div style="font-size:1rem; font-weight:800; color:#0f172a;">هل راجعت جميع الأصناف والتعديلات؟</div>
					<div class="text-xs text-muted mt-0.5">
						عند الضغط على الاعتماد النهائي، سيتم تطبيق وحفظ الأصناف المعتمدة وإدخال كمياتها في المخزن المختار مباشرة.
					</div>
				</div>
				<div class="row-center-sm">
					<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/commit") }
						onsubmit="return confirm('تأكيد: هل أنت متأكد من حفظ جميع الأصناف المراجعة في قاعدة البيانات؟');">
						<button type="submit" class="btn btn-primary btn-lg font-bold" style="padding:0.75rem 1.75rem; font-size:1rem;">
							✓ اعتماد وحفظ البيانات في قاعدة البيانات
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal for Manual Match Picker -->
	@catalogMatchModal(view)
}

templ reviewFilterTab(view VendorImportView, matchKey, label string) {
	{{
		active := (matchKey == "" && view.Filter.MatchLevel == "") || view.Filter.MatchLevel == matchKey
		href := fmt.Sprintf("/vendor/ingest/%s?match=%s&limit=%d", view.Session.PublicID, matchKey, view.PerPage)
		if view.Filter.Search != "" {
			href += "&q=" + view.Filter.Search
		}
	}}
	<a href={ templ.SafeURL(href) }
		class={ "btn btn-sm", templ.KV("btn-primary font-bold", active), templ.KV("btn-ghost text-slate-700", !active) }
		style="border-radius:20px; font-size:0.8rem; padding:0.35rem 0.85rem;">
		{ label }
	</a>
}

templ reviewTableRow(view VendorImportView, row *ingest.RowOutcome) {
	<tr id={ fmt.Sprintf("row-%d", row.ID) } style={ templ.KV("opacity:0.5; background:#f8fafc;", row.IsExcluded) }>
		<!-- Checkbox Exclude/Include -->
		<td style="text-align:center; vertical-align:middle;">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/toggle?match=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Page, view.PerPage, view.Filter.Search)) }>
				<input type="checkbox" checked?={ !row.IsExcluded } onchange="this.form.submit()"
					title="استيراد هذا الصنف" style="cursor:pointer; width:17px; height:17px; accent-color:#0284c7;"/>
			</form>
		</td>

		<!-- Row Number -->
		<td style="text-align:center; vertical-align:middle; font-weight:700; color:#64748b; font-size:0.8rem;">
			{ fmt.Sprint(row.SourceRow) }
		</td>

		<!-- File Product Info -->
		<td style="vertical-align:middle;">
			<div style="font-weight:700; color:#1e293b; font-size:0.9rem;">{ row.DisplayName }</div>
			<div class="row-center-sm" style="gap:0.4rem; margin-top:0.2rem;">
				if row.SourceCode != "" {
					<span class="badge badge-secondary text-xs" style="font-family:monospace;">كود: { row.SourceCode }</span>
				}
				if row.Payload != nil && row.Payload.Barcode != "" {
					<span class="badge badge-outline text-xs" style="font-family:monospace;">باركود: { row.Payload.Barcode }</span>
				}
				if row.Payload != nil && row.Payload.Unit != "" {
					<span class="text-xs text-muted">({ row.Payload.Unit })</span>
				}
			</div>
		</td>

		<!-- Matched Central Catalog Product -->
		<td style="vertical-align:middle;">
			if row.ProductID != nil && *row.ProductID > 0 {
				<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
					<span style="font-weight:700; color:#0f172a;">{ row.MatchedCatalogName() }</span>
					if row.IsManuallyMatched {
						<span class="badge" style="background:#e0e7ff; color:#3730a3; font-size:0.75rem;">مطابقة يدوية معتمدة</span>
					} else {
						<span class={ "badge text-xs", matchLevelBadgeTone(row.MatchLevel) }>
							{ matchLevelText(row.MatchLevel) } · { PercentText(row.MatchScore) }
						</span>
					}
				</div>
				if row.MatchedCatalogSKU() != "" {
					<div class="text-xs text-muted mt-0.5" style="font-family:monospace;">
						SKU: { row.MatchedCatalogSKU() }
					</div>
				}
			} else {
				<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
					<span class="badge badge-danger text-xs" style="background:#fee2e2; color:#991b1b; font-weight:700;">غير مطابق بالكتالوج</span>
					<button type="button" class="btn btn-outline btn-xs text-primary"
						data-rowid={ fmt.Sprint(row.ID) }
						data-rowname={ row.DisplayName }
						onclick="handleOpenModal(this)">
						🔍 بحث وربط بالكتالوج
					</button>
				</div>
				if len(row.Candidates) > 0 {
					<div class="text-xs text-muted mt-1">
						أقرب مرشح: <strong style="color:#334155;">{ row.Candidates[0].Name }</strong> ({ PercentText(row.Candidates[0].Score) })
					</div>
				}
			}
		</td>

		<!-- Editable Variant Name Form -->
		<td style="vertical-align:middle;">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Page, view.PerPage, view.Filter.Search)) }
				style="display:flex; align-items:center; gap:0.35rem;">
				<input type="text" name="custom_variant_name" value={ row.EffectiveVariantName() }
					class="form-control form-control-sm" style="font-size:0.85rem; padding:0.25rem 0.5rem; min-width:140px;"
					placeholder="اسم الصنف لديك..."/>
				<button type="submit" class="btn btn-ghost btn-xs text-primary font-bold" title="حفظ الاسم">✓</button>
			</form>
		</td>

		<!-- Price -->
		<td style="text-align:center; vertical-align:middle;">
			if row.Payload != nil && (row.Payload.NetPrice.IsPositive() || row.Payload.PublicPrice.IsPositive()) {
				if row.Payload.NetPrice.IsPositive() {
					<span class="font-bold text-slate-800">{ row.Payload.NetPrice.String() }</span>
				} else {
					<span class="font-bold text-slate-800">{ row.Payload.PublicPrice.String() }</span>
				}
			} else {
				<span class="text-muted text-xs">-</span>
			}
		</td>

		<!-- Quantity -->
		<td style="text-align:center; vertical-align:middle;">
			if row.Payload != nil && row.Payload.HasQuantity {
				<span class="badge badge-secondary font-bold text-xs">{ fmt.Sprint(row.Payload.Quantity) }</span>
			} else {
				<span class="text-muted text-xs">-</span>
			}
		</td>

		<!-- Row Action Buttons -->
		<td style="text-align:center; vertical-align:middle;">
			<div class="row-center-sm" style="justify-content:center; gap:0.35rem;">
				<button type="button" class="btn btn-secondary btn-xs"
					data-rowid={ fmt.Sprint(row.ID) }
					data-rowname={ row.DisplayName }
					onclick="handleOpenModal(this)"
					title="تغيير أو تحديد الصنف المطابق">
					🔗 ربط بالكتالوج
				</button>
			</div>
		</td>
	</tr>
}

templ reviewPagination(view VendorImportView) {
	{{
		limit := view.PerPage
		if limit <= 0 {
			limit = 25
		}
		totalPages := (view.RowTotal + limit - 1) / limit
		currPage := view.Page
		if currPage <= 0 {
			currPage = 1
		}
	}}
	if totalPages > 1 {
		<div class="row-center-sm" style="gap:0.3rem;">
			if currPage > 1 {
				<a href={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s?match=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, view.Filter.MatchLevel, currPage-1, limit, view.Filter.Search)) }
					class="btn btn-secondary btn-sm" style="font-size:0.8rem; padding:0.25rem 0.6rem;">
					السابق
				</a>
			}
			<span class="text-xs text-muted px-2">صفحة { fmt.Sprint(currPage) } من { fmt.Sprint(totalPages) }</span>
			if currPage < totalPages {
				<a href={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s?match=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, view.Filter.MatchLevel, currPage+1, limit, view.Filter.Search)) }
					class="btn btn-secondary btn-sm" style="font-size:0.8rem; padding:0.25rem 0.6rem;">
					التالي
				</a>
			}
		</div>
	}
}

templ catalogMatchModal(view VendorImportView) {
	<div id="match-modal"
		data-session-id={ view.Session.PublicID }
		data-filter-match={ view.Filter.MatchLevel }
		data-page={ fmt.Sprint(view.Page) }
		data-limit={ fmt.Sprint(view.PerPage) }
		data-search={ view.Filter.Search }
		style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.65); z-index:9999; justify-content:center; align-items:center; padding:1rem; backdrop-filter:blur(2px);">
		<div class="card" style="width:100%; max-width:650px; max-height:90vh; display:flex; flex-direction:column; background:#ffffff; border-radius:14px; box-shadow:0 25px 50px -12px rgba(0,0,0,0.25); overflow:hidden; padding:0;">
			<!-- Modal Header -->
			<div style="padding:1.25rem 1.5rem; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
				<div>
					<h3 class="wiz-head mb-0" style="font-size:1.15rem; font-weight:800; color:#0f172a;">اختر الصنف المطابق من الكتالوج المركزي</h3>
					<div class="text-xs text-muted mt-1" id="modal-row-title">الصنف المحدد: ...</div>
				</div>
				<button type="button" class="btn btn-ghost btn-sm text-slate-500" onclick="closeMatchModal()" style="font-size:1.2rem; line-height:1;">✕</button>
			</div>

			<!-- Modal Search Input -->
			<div style="padding:1rem 1.5rem; border-bottom:1px solid #f1f5f9;">
				<div style="display:flex; gap:0.5rem;">
					<input type="text" id="modal-search-input" placeholder="اكتب اسم الدواء أو المادة الفعالة أو الباركود..."
						class="form-control" style="font-size:0.95rem;" oninput="debounceSearch()"/>
					<button type="button" class="btn btn-primary" onclick="performCatalogSearch()">بحث</button>
				</div>
			</div>

			<!-- Modal Results Area -->
			<div id="modal-search-results" style="padding:1rem 1.5rem; overflow-y:auto; flex:1; min-height:280px; max-height:50vh;">
				<div class="text-center text-muted p-4">
					<div style="font-size:2rem; margin-bottom:0.5rem;">🔍</div>
					<div>ابحث في الكتالوج المركزي المعتمد لاختيار الصنف المطابق بدقة.</div>
				</div>
			</div>

			<!-- Modal Footer -->
			<div style="padding:0.85rem 1.5rem; background:#f8fafc; border-top:1px solid #e2e8f0; text-align:left;">
				<button type="button" class="btn btn-secondary btn-sm" onclick="closeMatchModal()">إغلاق</button>
			</div>
		</div>
	</div>

	<script>
		var activeRowId = 0;
		var searchTimer = null;

		function handleOpenModal(btn) {
			var rowId = btn.getAttribute('data-rowid');
			var rowName = btn.getAttribute('data-rowname');
			openMatchModal(rowId, rowName);
		}

		function openMatchModal(rowId, rowName) {
			activeRowId = rowId;
			document.getElementById('modal-row-title').textContent = 'الصنف بالملف: ' + rowName;
			document.getElementById('modal-search-input').value = rowName;
			document.getElementById('match-modal').style.display = 'flex';
			performCatalogSearch();
		}

		function closeMatchModal() {
			document.getElementById('match-modal').style.display = 'none';
			activeRowId = 0;
		}

		function debounceSearch() {
			clearTimeout(searchTimer);
			searchTimer = setTimeout(performCatalogSearch, 300);
		}

		function performCatalogSearch() {
			var q = document.getElementById('modal-search-input').value.trim();
			var resBox = document.getElementById('modal-search-results');
			var modal = document.getElementById('match-modal');
			var sessionId = modal.getAttribute('data-session-id');
			var matchLevel = modal.getAttribute('data-filter-match') || '';
			var page = modal.getAttribute('data-page') || '1';
			var limit = modal.getAttribute('data-limit') || '25';
			var search = modal.getAttribute('data-search') || '';

			if (!q) {
				resBox.innerHTML = '<div class="text-center text-muted p-4">يرجى كتابة كلمة للبحث</div>';
				return;
			}
			resBox.innerHTML = '<div class="text-center text-muted p-4">جارٍ البحث في الكتالوج المركزي...</div>';

			fetch('/vendor/ingest/' + encodeURIComponent(sessionId) + '/catalog-search?q=' + encodeURIComponent(q))
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (!data || data.length === 0) {
						resBox.innerHTML = '<div class="text-center text-muted p-4">لم يتم العثور على نتائج في الكتالوج</div>';
						return;
					}
					var container = document.createElement('div');
					container.style.display = 'flex';
					container.style.flexDirection = 'column';
					container.style.gap = '0.6rem';

					data.forEach(function(p) {
						var name = p.name_ar || p.name_en || 'بدون اسم';
						var card = document.createElement('div');
						card.className = 'card p-3';
						card.style.cssText = 'border:1px solid #e2e8f0; border-radius:8px; display:flex; justify-content:space-between; align-items:center; gap:0.75rem;';

						var info = document.createElement('div');
						var title = document.createElement('div');
						title.style.cssText = 'font-weight:700; font-size:0.925rem; color:#0f172a;';
						title.textContent = name;
						info.appendChild(title);

						var sub = document.createElement('div');
						sub.className = 'text-xs text-muted mt-0.5';
						sub.style.cssText = 'display:flex; gap:0.5rem; flex-wrap:wrap;';
						if (p.sku) {
							var skuSpan = document.createElement('span');
							skuSpan.style.fontFamily = 'monospace';
							skuSpan.textContent = 'SKU: ' + p.sku;
							sub.appendChild(skuSpan);
						}
						if (p.dosage_form) {
							var fSpan = document.createElement('span');
							fSpan.textContent = p.dosage_form;
							sub.appendChild(fSpan);
						}
						if (p.concentration) {
							var cSpan = document.createElement('span');
							cSpan.textContent = p.concentration;
							sub.appendChild(cSpan);
						}
						if (p.manufacturer) {
							var mSpan = document.createElement('span');
							mSpan.textContent = p.manufacturer;
							sub.appendChild(mSpan);
						}
						info.appendChild(sub);
						card.appendChild(info);

						var form = document.createElement('form');
						form.method = 'POST';
						form.action = '/vendor/ingest/' + encodeURIComponent(sessionId) + '/rows/' + encodeURIComponent(activeRowId) + '/match?match=' + encodeURIComponent(matchLevel) + '&page=' + encodeURIComponent(page) + '&limit=' + encodeURIComponent(limit) + '&q=' + encodeURIComponent(search);

						var hidden = document.createElement('input');
						hidden.type = 'hidden';
						hidden.name = 'product_id';
						hidden.value = p.id;
						form.appendChild(hidden);

						var btn = document.createElement('button');
						btn.type = 'submit';
						btn.className = 'btn btn-primary btn-sm font-bold';
						btn.textContent = 'اختيار هذا الصنف';
						form.appendChild(btn);

						card.appendChild(form);
						container.appendChild(card);
					});

					resBox.innerHTML = '';
					resBox.appendChild(container);
				})
				.catch(function(err) {
					resBox.innerHTML = '<div class="text-center text-danger p-4">تعذر الاتصال بالخادم للبحث</div>';
				});
		}
	</script>
}

func matchLevelText(level string) string {
	switch productmatch.MatchLevel(level) {
	case productmatch.MatchBarcode:
		return "تطابق بالباركود"
	case productmatch.MatchCode:
		return "تطابق بالكود"
	case productmatch.MatchExact:
		return "تطابق تام"
	case productmatch.MatchStrong:
		return "تطابق قوي"
	case productmatch.MatchReview:
		return "يحتاج مراجعة"
	case productmatch.MatchAmbiguous:
		return "تطابق غامض"
	default:
		return "غير مطابق"
	}
}

func matchLevelBadgeTone(level string) string {
	switch productmatch.MatchLevel(level) {
	case productmatch.MatchBarcode, productmatch.MatchCode, productmatch.MatchExact, productmatch.MatchStrong:
		return "badge-success"
	case productmatch.MatchReview, productmatch.MatchAmbiguous:
		return "badge-warning"
	default:
		return "badge-danger"
	}
}