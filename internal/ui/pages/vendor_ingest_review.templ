package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/ingest"
	"github.com/muhiya/dawa24-store/internal/shared/productmatch"
)

templ importReviewStage(view VendorImportView) {
	<div class="glass-panel p-6 mb-6">
		<div class="flex-between items-center flex-wrap gap-4 mb-6">
			<div>
				<h2 class="text-2xl font-black text-primary m-0">4. مراجعة الأصناف والمطابقة</h2>
				<p class="text-sm text-secondary m-0 mt-1">
					راجع أصناف الملف، عدّل الأسماء، وافحص نسبة التطابق أو اربط الأصناف بالكتالوج المركزي مباشرة قبل الحفظ النهائي في قاعدة البيانات
				</p>
			</div>
			<div class="d-flex items-center gap-2">
				<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/back-settings") }>
					<button type="submit" class="btn btn-secondary btn-sm font-bold">تعديل الإعدادات</button>
				</form>
				<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/cancel") }
					onsubmit="return confirm('هل أنت متأكد من إلغاء عملية الاستيراد وحذف البيانات المؤقتة؟');">
					<button type="submit" class="btn btn-ghost btn-sm text-danger font-bold">إلغاء</button>
				</form>
			</div>
		</div>

		<!-- Summary Stats Grid -->
		<div class="dashboard-stat-grid mb-6">
			<div class="stat-card-3d">
				<div class="stat-card-label">إجمالي الأصناف</div>
				<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprint(view.Session.TotalRows) }</div>
				<span class="text-xs text-secondary mt-1 d-block">إجمالي سطور الملف</span>
			</div>
			<div class="stat-card-3d">
				<div class="stat-card-label text-success">مطابق بالكتالوج</div>
				<div class="stat-card-value text-success tabular-nums">{ fmt.Sprint(view.Session.MatchedRows) }</div>
				<span class="text-xs text-secondary mt-1 d-block">جاهز للاستيراد فورياً</span>
			</div>
			<div class="stat-card-3d">
				<div class="stat-card-label text-warning">يحتاج مراجعة</div>
				<div class="stat-card-value text-warning tabular-nums">{ fmt.Sprint(view.Session.ReviewRows) }</div>
				<span class="text-xs text-secondary mt-1 d-block">تطابق مقترح أو غير مؤكد</span>
			</div>
			<div class="stat-card-3d">
				<div class="stat-card-label text-danger">غير مطابق</div>
				<div class="stat-card-value text-danger tabular-nums">{ fmt.Sprint(view.Session.UnmatchedRows) }</div>
				<span class="text-xs text-secondary mt-1 d-block">بحاجة لربط يدوي</span>
			</div>
		</div>

		<!-- What the AI stage did, directly under the counters it changed -->
		@aiPanel(view)

		<!-- Filter Tabs and Search Bar -->
		<div class="flex-between items-center flex-wrap gap-4 mb-4 mt-6">
			<div class="cb-tabs-nav m-0">
				@reviewFilterTab(view, "", "الكل (" + fmt.Sprint(view.Session.TotalRows) + ")")
				@reviewFilterTab(view, "matched", "مطابق (" + fmt.Sprint(view.Session.MatchedRows) + ")")
				@reviewFilterTab(view, "review", "يحتاج مراجعة (" + fmt.Sprint(view.Session.ReviewRows) + ")")
				@reviewFilterTab(view, "unmatched", "غير مطابق (" + fmt.Sprint(view.Session.UnmatchedRows) + ")")
			</div>

			<form method="GET" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID) } class="d-flex items-center gap-2 flex-wrap ms-auto">
				if view.Filter.MatchLevel != "" {
					<input type="hidden" name="match" value={ view.Filter.MatchLevel }/>
				}
				if view.Filter.SortBy != "" {
					<input type="hidden" name="sort" value={ view.Filter.SortBy }/>
				}
				if view.Filter.SortOrder != "" {
					<input type="hidden" name="order" value={ view.Filter.SortOrder }/>
				}
				<input type="text" name="q" value={ view.Filter.Search } placeholder="بحث بالاسم أو الكود..."
					class="form-input text-xs" style="min-width: 200px;"/>
				<select name="limit" onchange="this.form.submit()" class="form-select text-xs" style="width: auto;">
					<option value="10" selected?={ view.PerPage == 10 }>10 صفوف</option>
					<option value="25" selected?={ view.PerPage == 25 || view.PerPage == 0 }>25 صنف</option>
					<option value="50" selected?={ view.PerPage == 50 }>50 صنف</option>
					<option value="100" selected?={ view.PerPage == 100 }>100 صنف</option>
				</select>
				<button type="submit" class="btn btn-secondary btn-sm font-bold text-xs">بحث</button>
				if view.Filter.Search != "" {
					<a href={ templ.SafeURL(buildReviewURL(view.Session.PublicID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, 1, view.PerPage, "")) } class="btn btn-ghost btn-sm text-xs">إلغاء</a>
				}
			</form>
		</div>

		<!-- Batch Quantity Setter Card -->
		<div class="glass-panel p-3 px-4 mb-4">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/batch-quantity?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="flex-between items-center flex-wrap gap-3"
				onsubmit="return confirm('هل تريد تطبيق هذه الكمية على جميع الأصناف في الملف؟');">
				<div class="d-flex items-center gap-2">
					<span class="text-base">@components.IconPackage("icon-sm")</span>
					<span class="font-extrabold text-xs text-primary">تعيين كمية موحدة لكافة الأصناف في الملف:</span>
					<span class="text-xs text-muted">(مفيد في حال لم يحتوي ملفك على عمود للكمية)</span>
				</div>
				<div class="d-flex items-center gap-2">
					<input type="number" name="batch_quantity" min="0" placeholder="مثال: 50" required
						class="form-input text-center tabular-nums font-bold text-xs"
						style="width: 90px; height: 32px;"/>
					<button type="submit" class="btn btn-primary btn-sm font-bold text-xs" style="height: 32px;">
						تطبيق على جميع الأصناف
					</button>
				</div>
			</form>
		</div>

		@reviewBulkBar(view)

		<!-- Table -->
		<div class="glass-panel p-0 mb-6 review-table-shell">
			<div class="review-table-scroll">
				<table class="data-table review-table m-0">
					<thead>
						<tr>
							<th class="text-center review-col-pick">
								<input type="checkbox" class="review-pick-all"
									onchange="reviewToggleAll(this)"
									title="تحديد كل الأصناف المعروضة في هذه الصفحة"/>
							</th>
							<th class="text-center review-col-flag">استيراد</th>
							<th class="text-center review-col-num">
								@reviewSortHeader(view, "row", "#")
							</th>
							<th class="review-col-name">
								@reviewSortHeader(view, "name", "الصنف في الملف (قابل للتعديل)")
							</th>
							<th class="review-col-catalog">
								@reviewSortHeader(view, "catalog_name", "الصنف المطابق بالكتالوج المركزي")
							</th>
							<th class="text-center review-col-score">
								@reviewSortHeader(view, "score", "نسبة التطابق")
							</th>
							<th class="text-center review-col-money">
								@reviewSortHeader(view, "price", "سعر الجمهور")
							</th>
							<th class="text-center review-col-money">
								@reviewSortHeader(view, "discount", "نسبة الخصم %")
							</th>
							<th class="text-center review-col-money">
								السعر بعد الخصم
							</th>
							<th class="text-center review-col-qty">
								@reviewSortHeader(view, "quantity", "الكمية")
							</th>
						</tr>
					</thead>
					<tbody>
						if len(view.Rows) == 0 {
							<tr>
								<td colspan="10" class="text-center p-8 text-muted">
									<div class="font-extrabold text-sm">لا توجد أصناف مطابقة للتصفية الحالية</div>
									<div class="text-xs mt-1">جرّب تغيير التبويب أو إزالة كلمات البحث.</div>
								</td>
							</tr>
						}
						for _, row := range view.Rows {
							@reviewTableRow(view, row)
						}
					</tbody>
				</table>
			</div>

			<!-- Pagination Footer -->
			if view.RowTotal > 0 {
				@reviewPagination(view)
			}
		</div>

		<!-- Final Confirmation Footer -->
		{{ held := view.Session.ReviewRows + view.Session.UnmatchedRows }}
		<div class="glass-panel p-6 mb-0 mt-6">
			<div class="flex-between items-center flex-wrap gap-4">
				<div>
					<div class="font-black text-base text-primary">اعتماد البيانات وحفظها</div>
					<div class="text-xs text-secondary mt-1">
						سيتم حفظ الأصناف <strong>المطابقة فقط</strong> ({ fmt.Sprint(view.Session.MatchedRows) } صنف) وإدخال كمياتها في المخزن المختار.
					</div>
					if held > 0 {
						<div class="text-xs mt-2 review-gate-note">
							{ fmt.Sprint(held) } صنف لن يُستورد لأنه ما زال «يحتاج مراجعة» أو «غير مطابق».
							اعتمدها من التبويبات أعلاه — أو اتركها، فلن يُكتب منها شيء.
						</div>
					}
				</div>
				<form method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/commit") }
					data-matched={ fmt.Sprint(view.Session.MatchedRows) }
					data-held={ fmt.Sprint(held) }
					onsubmit="return confirmReviewCommit(this)">
					<button type="submit" class="btn btn-primary font-black px-6 py-2 text-sm"
						disabled?={ view.Session.MatchedRows == 0 }>
						اعتماد وحفظ الأصناف المطابقة
					</button>
				</form>
			</div>
		</div>
	</div>

	<!-- Review interaction script -->
	<script>
		// Bulk selection. Every checkbox belongs to the toolbar's form through
		// the form attribute, so "select all" is a query over the document
		// rather than over a container.
		function reviewPickBoxes() {
			return Array.prototype.slice.call(
				document.querySelectorAll('input.review-pick[form="review-bulk"]'));
		}

		function reviewToggleAll(source) {
			var on = !!source.checked;
			reviewPickBoxes().forEach(function (box) { box.checked = on; });
			document.querySelectorAll('.review-pick-all, .review-bulk-pickall input')
				.forEach(function (box) { if (box !== source) box.checked = on; });
			reviewUpdateCount();
		}

		function reviewUpdateCount() {
			var label = document.getElementById('review-bulk-count');
			if (!label) return;
			var n = reviewPickBoxes().filter(function (b) { return b.checked; }).length;
			label.textContent = n === 0
				? 'لم يتم تحديد أي صنف'
				: ('تم تحديد ' + n + ' صنف');
		}

		document.addEventListener('change', function (e) {
			if (e.target && e.target.classList && e.target.classList.contains('review-pick')) {
				reviewUpdateCount();
			}
		});

		// A commit that would silently drop rows says so first. The count comes
		// from the server-rendered figures, not from the page's checkboxes.
		function confirmReviewCommit(form) {
			var matched = parseInt(form.getAttribute('data-matched'), 10) || 0;
			var held = parseInt(form.getAttribute('data-held'), 10) || 0;
			if (matched <= 0) {
				alert('لا يوجد أي صنف مطابق لحفظه. اعتمد الأصناف من تبويب «يحتاج مراجعة» أولاً.');
				return false;
			}
			var msg = 'سيتم حفظ ' + matched + ' صنف مطابق في قاعدة البيانات.';
			if (held > 0) {
				msg += '

' + held + ' صنف لن يُستورد لأنه ما زال يحتاج مراجعة أو غير مطابق.';
			}
			return confirm(msg + '

هل تريد المتابعة؟');
		}

		var activeDropdownRowId = null;
		var catalogSearchTimer = null;

		function handleDropdownToggle(btn) {
			var rowId = btn.getAttribute('data-row-id');
			var rowName = btn.getAttribute('data-row-name') || '';
			toggleCatalogDropdown(btn, rowId, rowName);
		}

		function handleDropdownSearchInput(input) {
			var rowId = input.getAttribute('data-row-id');
			onDropdownSearchInput(input, rowId);
		}

		function toggleCatalogDropdown(btn, rowId, defaultQuery) {
			var dropdown = document.getElementById('catalog-dropdown-' + rowId);
			if (!dropdown) return;

			// Close any previously opened dropdown
			if (activeDropdownRowId && activeDropdownRowId !== rowId) {
				var prev = document.getElementById('catalog-dropdown-' + activeDropdownRowId);
				if (prev) prev.style.display = 'none';
			}

			if (dropdown.style.display === 'block') {
				dropdown.style.display = 'none';
				activeDropdownRowId = null;
			} else {
				dropdown.style.display = 'block';
				activeDropdownRowId = rowId;
				var input = dropdown.querySelector('input[type="text"]');
				if (input) {
					if (!input.value.trim()) {
						input.value = defaultQuery;
					}
					input.focus();
					searchCatalogForDropdown(rowId, input.value.trim());
				}
			}
		}

		function closeAllCatalogDropdowns() {
			if (activeDropdownRowId) {
				var el = document.getElementById('catalog-dropdown-' + activeDropdownRowId);
				if (el) el.style.display = 'none';
				activeDropdownRowId = null;
			}
		}

		document.addEventListener('click', function(e) {
			if (!e.target.closest('.catalog-cell-container')) {
				closeAllCatalogDropdowns();
			}
		});

		function onDropdownSearchInput(input, rowId) {
			clearTimeout(catalogSearchTimer);
			catalogSearchTimer = setTimeout(function() {
				searchCatalogForDropdown(rowId, input.value.trim());
			}, 300);
		}

		function searchCatalogForDropdown(rowId, query) {
			var resultsBox = document.getElementById('dropdown-results-' + rowId);
			var dropdown = document.getElementById('catalog-dropdown-' + rowId);
			if (!resultsBox || !dropdown) return;

			var sessionId = dropdown.getAttribute('data-session-id');
			var matchLevel = dropdown.getAttribute('data-filter-match') || '';
			var sortBy = dropdown.getAttribute('data-sort') || '';
			var sortOrder = dropdown.getAttribute('data-order') || '';
			var page = dropdown.getAttribute('data-page') || '1';
			var limit = dropdown.getAttribute('data-limit') || '25';
			var search = dropdown.getAttribute('data-search') || '';

			if (!query) {
				resultsBox.innerHTML = '<div class="text-center text-muted p-sm text-xs">يرجى كتابة كلمة للبحث</div>';
				return;
			}

			resultsBox.innerHTML = '<div class="text-center text-muted p-sm text-xs">جارٍ البحث في الكتالوج المركزي...</div>';

			fetch('/vendor/ingest/' + encodeURIComponent(sessionId) + '/catalog-search?q=' + encodeURIComponent(query))
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (!data || data.length === 0) {
						resultsBox.innerHTML = '<div class="text-center text-muted p-sm text-xs">لم يتم العثور على نتائج في الكتالوج</div>';
						return;
					}
					resultsBox.innerHTML = '';
					data.forEach(function(p) {
						var item = document.createElement('div');
						item.className = 'catalog-search-card';
						item.style.background = 'var(--surface-sunken)';
						item.style.border = '1px solid var(--border)';
						item.style.borderRadius = 'var(--radius-md)';
						item.style.padding = '0.55rem 0.75rem';
						item.style.marginBottom = '0.4rem';
						item.style.transition = 'all 0.15s ease';

						var form = document.createElement('form');
						form.method = 'POST';
						form.action = '/vendor/ingest/' + encodeURIComponent(sessionId) + '/rows/' + encodeURIComponent(rowId) + '/match?match=' + encodeURIComponent(matchLevel) + '&sort=' + encodeURIComponent(sortBy) + '&order=' + encodeURIComponent(sortOrder) + '&page=' + encodeURIComponent(page) + '&limit=' + encodeURIComponent(limit) + '&q=' + encodeURIComponent(search);

						var inputHidden = document.createElement('input');
						inputHidden.type = 'hidden';
						inputHidden.name = 'product_id';
						inputHidden.value = p.id;
						form.appendChild(inputHidden);

						var btn = document.createElement('button');
						btn.type = 'submit';
						btn.className = 'btn btn-ghost btn-sm w-100 text-start';
						btn.style.display = 'flex';
						btn.style.justifyContent = 'space-between';
						btn.style.alignItems = 'center';
						btn.style.width = '100%';
						btn.style.padding = '0';
						btn.style.color = 'var(--text)';

						var infoDiv = document.createElement('div');
						var nameDiv = document.createElement('div');
						nameDiv.className = 'fw-700 text-xs';
						nameDiv.style.color = 'var(--text)';
						nameDiv.textContent = p.name_ar || p.name_en || 'بدون اسم';
						infoDiv.appendChild(nameDiv);

						var metaDiv = document.createElement('div');
						metaDiv.className = 'text-xs text-muted';
						metaDiv.style.marginTop = '2px';
						var metaText = '';
						if (p.sku) metaText += 'SKU: ' + p.sku + ' ';
						if (p.dosage_form) metaText += '· ' + p.dosage_form + ' ';
						if (p.concentration) metaText += '· ' + p.concentration;
						metaDiv.textContent = metaText;
						infoDiv.appendChild(metaDiv);

						btn.appendChild(infoDiv);

						var chooseSpan = document.createElement('span');
						chooseSpan.className = 'badge badge-primary text-xs';
						chooseSpan.textContent = 'اختيار';
						btn.appendChild(chooseSpan);

						form.appendChild(btn);
						item.appendChild(form);
						resultsBox.appendChild(item);
					});
				})
				.catch(function() {
					resultsBox.innerHTML = '<div class="text-center text-danger p-sm text-xs">تعذر تحميل النتائج</div>';
				});
		}
	</script>
}

// reviewBulkBar is the review screen's actual unit of work.
//
// The per-row controls below it are for correcting one line: a price, a
// quantity, a name. They are the wrong shape for the decision that blocks an
// import, which is the same decision repeated over a page of suggestions — and
// a vendor with nine thousand rows will not make it forty times, so before this
// existed they either imported everything unreviewed or gave up.
//
// The form lives here and the row checkboxes join it through the HTML form
// attribute, because the table's cells are already full of forms and a form
// cannot contain another.
templ reviewBulkBar(view VendorImportView) {
	{{ scope := view.Filter.MatchLevel }}
	<form id="review-bulk" method="POST"
		action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/bulk?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
		class="glass-panel p-3 px-4 mb-4 review-bulk-bar">
		<!-- The filter is posted with the action so "everything matching the
		     current view" is resolved on the server from the same predicates
		     that rendered the page. -->
		<input type="hidden" name="f_match" value={ view.Filter.MatchLevel }/>
		<input type="hidden" name="f_outcome" value={ view.Filter.Outcome }/>
		<input type="hidden" name="f_q" value={ view.Filter.Search }/>

		<div class="review-bulk-row">
			<label class="review-bulk-pickall">
				<input type="checkbox" onchange="reviewToggleAll(this)"/>
				<span class="font-extrabold text-xs">تحديد كل الأصناف المعروضة</span>
			</label>
			<span class="text-xs text-muted review-bulk-count" id="review-bulk-count">لم يتم تحديد أي صنف</span>

			<label class="review-bulk-scope">
				<input type="checkbox" name="select_scope" value="filter"/>
				<span class="text-xs">
					طبّق على كل الأصناف في التبويب الحالي ({ fmt.Sprint(view.RowTotal) }) وليس هذه الصفحة فقط
				</span>
			</label>

			<div class="review-bulk-actions">
				if scope != "matched" {
					<button type="submit" name="bulk_action" value="confirm"
						class="btn btn-primary btn-sm font-extrabold text-xs"
						title="اعتماد الصنف المقترح لكل صف محدد ونقله إلى «مطابق» ليُستورد">
						اعتماد المحدد كمطابق
					</button>
				}
				<button type="submit" name="bulk_action" value="unlink"
					class="btn btn-secondary btn-sm font-bold text-xs"
					title="إلغاء الربط بالكتالوج عن الصفوف المحددة">
					إلغاء الربط
				</button>
				<button type="submit" name="bulk_action" value="exclude"
					class="btn btn-ghost btn-sm font-bold text-xs text-danger"
					title="استبعاد الصفوف المحددة من الاستيراد">
					استبعاد المحدد
				</button>
				<button type="submit" name="bulk_action" value="include"
					class="btn btn-ghost btn-sm font-bold text-xs"
					title="إعادة الصفوف المحددة إلى الاستيراد">
					↺ إعادة المحدد
				</button>
			</div>
		</div>

		if scope == "review" || scope == "unmatched" {
			<div class="review-bulk-hint text-xs">
				الأصناف في هذا التبويب <strong>لن تُستورد</strong> حتى تعتمدها. راجع الصنف المقترح لكل صف،
				ألغِ تحديد الصفوف الخاطئة، ثم اضغط «اعتماد المحدد كمطابق» — أو اربط الصف يدوياً بزر «ربط».
			</div>
		}
	</form>
}

templ reviewFilterTab(view VendorImportView, matchKey, label string) {
	{{
		active := (matchKey == "" && view.Filter.MatchLevel == "") || view.Filter.MatchLevel == matchKey
		href := buildReviewURL(view.Session.PublicID, matchKey, view.Filter.SortBy, view.Filter.SortOrder, 1, view.PerPage, view.Filter.Search)
	}}
	<a href={ templ.SafeURL(href) }
		class={ "wiz-chip", templ.KV("is-on", active) }>
		{ label }
	</a>
}

templ reviewSortHeader(view VendorImportView, colKey, label string) {
	{{
		isCurrent := view.Filter.SortBy == colKey || (view.Filter.SortBy == "" && colKey == "row")
		nextOrder := "asc"
		icon := "⇅"
		if isCurrent {
			if view.Filter.SortOrder == "desc" {
				nextOrder = "asc"
				icon = "▼"
			} else {
				nextOrder = "desc"
				icon = "▲"
			}
		} else if colKey == "score" || colKey == "price" || colKey == "quantity" {
			nextOrder = "desc"
		}
		href := buildReviewURL(view.Session.PublicID, view.Filter.MatchLevel, colKey, nextOrder, 1, view.PerPage, view.Filter.Search)
	}}
	<a href={ templ.SafeURL(href) }
		class="row-center-xs gap-xs text-secondary hover-text-primary"
		style="color: inherit; text-decoration: none; font-weight: inherit; justify-content: center; display: inline-flex;"
		title={ fmt.Sprintf("ترتيب حسب %s", label) }>
		<span>{ label }</span>
		<span class="text-xs" style="opacity: 0.75; font-size: 0.7rem;">{ icon }</span>
	</a>
}

templ reviewTableRow(view VendorImportView, row *ingest.RowOutcome) {
	<tr id={ fmt.Sprintf("row-%d", row.ID) } class={ templ.KV("opacity-50", row.IsExcluded) }>
		<!-- Bulk selection. The input belongs to the toolbar's form through the
		     form attribute, because a form cannot be nested inside the per-row
		     forms this table is built from. -->
		<td class="text-center align-middle">
			<input type="checkbox" name="row_ids" value={ fmt.Sprint(row.ID) }
				form="review-bulk" class="review-pick"
				title="تحديد هذا الصنف للإجراءات الجماعية"/>
		</td>

		<!-- Checkbox Exclude/Include -->
		<td class="text-center align-middle">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/toggle?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }>
				<input type="checkbox" checked?={ !row.IsExcluded } onchange="this.form.submit()"
					title="استيراد هذا الصنف" style="cursor: pointer; width: 16px; height: 16px;"/>
			</form>
		</td>

		<!-- Row Number -->
		<td class="text-center align-middle tabular-nums text-muted fw-700 text-xs">
			{ fmt.Sprint(row.SourceRow) }
		</td>

		<!-- File Product Name (Direct Editable in same cell with standard form-input) -->
		<td class="align-middle">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="row-center-xs gap-xs mb-1">
				<input type="text" name="display_name" value={ row.DisplayName }
					class="form-input" style="padding: 0.35rem 0.6rem; font-size: 0.85rem; max-width: 250px;"
					placeholder="اسم الصنف بالملف..."/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" title="حفظ تعديل الاسم">@components.IconCheck("icon-sm")</button>
			</form>
			<div class="row-center-xs flex-wrap gap-xs">
				if row.SourceCode != "" {
					<span class="badge badge-secondary text-xs">كود: { row.SourceCode }</span>
				}
				if row.Payload != nil && row.Payload.Barcode != "" {
					<span class="badge badge-outline text-xs">باركود: { row.Payload.Barcode }</span>
				}
				if row.Payload != nil && row.Payload.Unit != "" {
					<span class="text-xs text-muted">({ row.Payload.Unit })</span>
				}
			</div>
		</td>

		<!-- Matched Central Catalog Product (Unified with In-Cell Dropdown - No gap!) -->
		<td class="align-middle catalog-cell-container" style="position: relative;">
			<div class="row-center-xs flex-wrap gap-xs items-center">
				if row.ProductID != nil && *row.ProductID > 0 {
					<div class="fw-700 text-sm">{ row.MatchedCatalogName() }</div>
					if AIMatchedRow(row) {
						<span class="badge badge-outline text-xs"
							style="border-color: var(--primary); color: var(--primary);"
							title={ aiRowTitle(row) }>ذكاء اصطناعي</span>
					}
					<button type="button"
						data-row-id={ fmt.Sprint(row.ID) }
						data-row-name={ row.DisplayName }
						class="btn btn-ghost btn-xs text-primary"
						onclick="handleDropdownToggle(this)"
						title="تغيير الصنف المربوط بالكتالوج">
						تغيير
					</button>
				} else {
					<span class="badge badge-rose text-xs">غير مطابق بالكتالوج</span>
					<button type="button"
						data-row-id={ fmt.Sprint(row.ID) }
						data-row-name={ row.DisplayName }
						class="btn btn-secondary btn-xs"
						onclick="handleDropdownToggle(this)"
						title="بحث وربط بالكتالوج المركزي">
						ربط
					</button>
					if len(row.Candidates) > 0 {
						<span class="text-xs text-muted">أقرب: { row.Candidates[0].Name }</span>
					}
				}
			</div>

			<!-- In-Cell Dropdown Menu (100% Theme-Aware) -->
			<div id={ fmt.Sprintf("catalog-dropdown-%d", row.ID) }
				class="combobox-menu"
				data-session-id={ view.Session.PublicID }
				data-filter-match={ view.Filter.MatchLevel }
				data-sort={ view.Filter.SortBy }
				data-order={ view.Filter.SortOrder }
				data-page={ fmt.Sprint(view.Page) }
				data-limit={ fmt.Sprint(view.PerPage) }
				data-search={ view.Filter.Search }
				style="display: none; position: absolute; top: calc(100% + 4px); inset-inline-start: 0; min-width: 320px; max-width: 440px; z-index: 100; padding: 0.65rem; background: var(--surface-raised); border: 1px solid var(--border-strong); border-radius: var(--radius-xl); box-shadow: var(--shadow-xl);">
				
				<div class="mb-2">
					<input type="text" placeholder="ابحث بالاسم أو SKU في الكتالوج المركزي..."
						data-row-id={ fmt.Sprint(row.ID) }
						class="form-input"
						style="padding: 0.4rem 0.65rem; font-size: 0.85rem; width: 100%;"
						oninput="handleDropdownSearchInput(this)"/>
				</div>

				<!-- The engine's own shortlist, rendered with the page.
				     It is what the row was scored against, so it is both the
				     likeliest answer and free: a vendor accepting a suggestion
				     should not have to type a search to find the product the
				     matcher already retrieved for them. -->
				if len(row.Candidates) > 0 {
					<div class="review-suggestions">
						<div class="text-xs fw-800 mb-1">اقتراحات المطابقة</div>
						for _, c := range row.Candidates {
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/match?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }>
								<input type="hidden" name="product_id" value={ fmt.Sprint(c.ProductID) }/>
								<button type="submit" class="review-suggestion" title={ c.Reason }>
									<span class={ "badge text-xs fw-800", matchScoreBadgeTone(c.Score) }>
										{ PercentText(c.Score) }
									</span>
									<span class="review-suggestion-name">{ c.Name }</span>
									if c.Concentration != "" || c.DosageForm != "" {
										<span class="review-suggestion-meta">{ c.Concentration } { c.DosageForm }</span>
									}
								</button>
							</form>
						}
					</div>
				}

				<div id={ fmt.Sprintf("dropdown-results-%d", row.ID) } style="max-height: 200px; overflow-y: auto;">
					<div class="text-center text-muted p-sm text-xs">اكتب للبحث في الكتالوج المركزي…</div>
				</div>

				if row.ProductID != nil && *row.ProductID > 0 {
					<div style="border-top: 1px solid var(--border); padding-top: 0.4rem; margin-top: 0.4rem; text-align: start;">
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/match?product_id=0&match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }>
							<button type="submit" class="btn btn-ghost btn-xs text-danger w-100 text-start">
								إلغاء الربط (جعله غير مطابق)
							</button>
						</form>
					</div>
				}
			</div>
		</td>

		<!-- Match Score / Degree (Dedicated Column) -->
		<td class="text-center align-middle">
			if row.ProductID != nil && *row.ProductID > 0 && row.IsManuallyMatched {
				<span class="badge badge-emerald text-xs fw-800" title="تمت المطابقة يدوياً بواسطة المستخدم">100% (يدوي)</span>
			} else if row.ProductID != nil && *row.ProductID > 0 {
				<span class={ "badge text-xs fw-800", matchScoreBadgeTone(row.MatchScore) } title={ matchLevelText(row.MatchLevel) }>
					{ PercentText(row.MatchScore) }
				</span>
			} else if len(row.Candidates) > 0 {
				<span class={ "badge text-xs fw-700", matchScoreBadgeTone(row.Candidates[0].Score) } title="أقرب مرشح غير محسوم">
					{ PercentText(row.Candidates[0].Score) }
				</span>
			} else {
				<span class="badge badge-rose text-xs">0%</span>
			}
			if !reviewRowWillImport(row) {
				<div class="text-xs text-muted mt-1">لن يُستورد</div>
			}
		</td>

		<!-- Public Price (سعر الجمهور - Editable Inline) -->
		<td class="text-center align-middle tabular-nums">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="row-center-xs gap-xs" style="justify-content: center;">
				<input type="hidden" name="display_name" value={ row.DisplayName }/>
				if row.Payload != nil && row.Payload.HasQuantity {
					<input type="hidden" name="quantity" value={ fmt.Sprint(row.Payload.Quantity) }/>
				}
				<input type="number" name="price"
					value={ rowPriceValue(row) }
					step="0.01"
					min="0"
					placeholder="0.00"
					class="form-input text-center tabular-nums fw-700"
					style="width: 78px; height: 32px; padding: 0.2rem 0.35rem; font-size: 0.85rem; border-radius: var(--radius-md);"
					title="تعديل سعر الجمهور"/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" style="height: 32px; padding: 0 0.45rem;" title="حفظ سعر الجمهور">@components.IconCheck("icon-sm")</button>
			</form>
		</td>

		<!-- Discount Percentage % (نسبة الخصم - Editable Inline) -->
		<td class="text-center align-middle tabular-nums">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="row-center-xs gap-xs" style="justify-content: center;">
				<input type="hidden" name="display_name" value={ row.DisplayName }/>
				<input type="number" name="discount"
					value={ rowDiscountPercentValue(row) }
					step="0.1"
					min="0"
					max="100"
					placeholder="0.0"
					class="form-input text-center tabular-nums fw-700"
					style="width: 70px; height: 32px; padding: 0.2rem 0.35rem; font-size: 0.85rem; border-radius: var(--radius-md);"
					title="تعديل نسبة الخصم %"/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" style="height: 32px; padding: 0 0.45rem;" title="حفظ نسبة الخصم">@components.IconCheck("icon-sm")</button>
			</form>
		</td>

		<!-- Net Price (السعر بعد الخصم) -->
		<td class="text-center align-middle tabular-nums">
			<span class="fw-800 text-primary" style="font-size: 0.875rem;">
				{ rowNetPriceValue(row) } <span style="font-size:0.7rem; color:var(--text-secondary);">ج.م</span>
			</span>
		</td>

		<!-- Quantity (Editable Inline) -->
		<td class="text-center align-middle tabular-nums">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="row-center-xs gap-xs" style="justify-content: center;">
				<input type="hidden" name="display_name" value={ row.DisplayName }/>
				if row.Payload != nil && (row.Payload.NetPrice.IsPositive() || row.Payload.PublicPrice.IsPositive()) {
					if row.Payload.NetPrice.IsPositive() {
						<input type="hidden" name="price" value={ row.Payload.NetPrice.String() }/>
					} else {
						<input type="hidden" name="price" value={ row.Payload.PublicPrice.String() }/>
					}
				}
				<input type="number" name="quantity"
					value={ rowQuantityValue(row) }
					step="1"
					min="0"
					placeholder="0"
					class="form-input text-center tabular-nums fw-700"
					style="width: 70px; height: 32px; padding: 0.2rem 0.35rem; font-size: 0.85rem; border-radius: var(--radius-md);"
					title="تعديل أو إدخال الكمية يدوياً"/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" style="height: 32px; padding: 0 0.45rem;" title="حفظ الكمية">@components.IconCheck("icon-sm")</button>
			</form>
		</td>
	</tr>
}

func rowQuantityValue(row *ingest.RowOutcome) string {
	if row != nil && row.Payload != nil && row.Payload.HasQuantity {
		return fmt.Sprint(row.Payload.Quantity)
	}
	return ""
}

// rowPriceValue is the public price shown in the "سعر الجمهور" column.
func rowPriceValue(row *ingest.RowOutcome) string {
	if row != nil && row.Payload != nil {
		if row.Payload.PublicPrice.IsPositive() {
			return row.Payload.PublicPrice.String()
		}
		if row.Payload.NetPrice.IsPositive() {
			return row.Payload.NetPrice.String()
		}
	}
	return ""
}

// rowDiscountPercentValue derives the discount percentage.
func rowDiscountPercentValue(row *ingest.RowOutcome) string {
	if row == nil || row.Payload == nil {
		return "0.0"
	}
	if row.Payload.DiscountBps > 0 {
		return fmt.Sprintf("%.1f", float64(row.Payload.DiscountBps)/100.0)
	}
	list := row.Payload.PublicPrice
	net := row.Payload.NetPrice
	if list.IsPositive() && net.IsPositive() && net.Minor() < list.Minor() {
		pct := (1.0 - float64(net.Minor())/float64(list.Minor())) * 100.0
		return fmt.Sprintf("%.1f", pct)
	}
	return "0.0"
}

// rowNetPriceValue calculates the price after discount.
func rowNetPriceValue(row *ingest.RowOutcome) string {
	if row == nil || row.Payload == nil {
		return "0.00"
	}
	if row.Payload.NetPrice.IsPositive() {
		return row.Payload.NetPrice.String()
	}
	list := row.Payload.PublicPrice
	if list.IsPositive() {
		if row.Payload.DiscountBps > 0 {
			net := list.ApplyPercent(10000 - row.Payload.DiscountBps)
			return net.String()
		}
		return list.String()
	}
	return "0.00"
}

templ reviewPagination(view VendorImportView) {
	{{
		limit := view.PerPage
		if limit <= 0 {
			limit = 25
		}
		totalPages := (view.RowTotal + limit - 1) / limit
		currPage := view.Page
		if currPage <= 0 {
			currPage = 1
		}
	}}
	<div class="b2b-pagination">
		<div class="b2b-pagination-info">
			عرض <strong>{ fmt.Sprint(len(view.Rows)) }</strong> من إجمالي <strong>{ fmt.Sprint(view.RowTotal) }</strong> صنف
		</div>
		if totalPages > 1 {
			<div class="b2b-pagination-controls">
				if currPage > 1 {
					<a href={ templ.SafeURL(buildReviewURL(view.Session.PublicID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, currPage-1, limit, view.Filter.Search)) }
						class="b2b-pagination-btn">
						السابق
					</a>
				}
				<span class="text-xs px-2">صفحة { fmt.Sprint(currPage) } من { fmt.Sprint(totalPages) }</span>
				if currPage < totalPages {
					<a href={ templ.SafeURL(buildReviewURL(view.Session.PublicID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, currPage+1, limit, view.Filter.Search)) }
						class="b2b-pagination-btn">
						التالي
					</a>
				}
			</div>
		}
	</div>
}

func buildReviewURL(publicID, match, sortBy, sortOrder string, page, limit int, search string) string {
	u := fmt.Sprintf("/vendor/ingest/%s?page=%d&limit=%d", publicID, page, limit)
	if match != "" {
		u += "&match=" + match
	}
	if sortBy != "" {
		u += "&sort=" + sortBy
	}
	if sortOrder != "" {
		u += "&order=" + sortOrder
	}
	if search != "" {
		u += "&q=" + search
	}
	return u
}

func matchLevelText(level string) string {
	switch productmatch.MatchLevel(level) {
	case productmatch.MatchBarcode:
		return "تطابق بالباركود"
	case productmatch.MatchCode:
		return "تطابق بالكود"
	case productmatch.MatchExact:
		return "تطابق تام"
	case productmatch.MatchStrong:
		return "تطابق قوي"
	case productmatch.MatchReview:
		return "يحتاج مراجعة"
	case productmatch.MatchAmbiguous:
		return "تطابق غامض"
	default:
		return "غير مطابق"
	}
}

// matchScoreBadgeTone colours a score by what will actually happen to the row.
//
// The bands are the engine's own thresholds rather than round numbers, which is
// the point: green means "this will be imported", amber means "this is a
// suggestion you must accept", red means "there is nothing here". A palette
// that disagreed with the gate — green at 70%, amber down to 30%, while the
// applied threshold sat at 40% — described a different system from the one
// deciding.
func matchScoreBadgeTone(score float64) string {
	switch {
	case score >= productmatch.DefaultMinStrong:
		return "badge-emerald"
	case score >= productmatch.DefaultMinReview:
		return "badge-amber"
	default:
		return "badge-rose"
	}
}

// reviewRowWillImport reports whether the commit would write this row.
//
// It restates, in the template, the exact predicate StagedRowsForCommit uses.
// That duplication is deliberate and is the lesser evil: the alternative is a
// screen that shows a product name beside a row the commit will silently drop,
// which is the failure this whole change is about. If the two ever disagree the
// answer is to fix the predicate, not to stop showing it.
func reviewRowWillImport(row *ingest.RowOutcome) bool {
	if row == nil || row.IsExcluded || row.ProductID == nil || *row.ProductID <= 0 {
		return false
	}
	if row.IsManuallyMatched {
		return true
	}
	return productmatch.MatchLevel(row.MatchLevel).Settled()
}
