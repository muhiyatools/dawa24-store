package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerBranchFormData struct {
	Branch     *org.Branch
	Cities     []*platformadmin.City
	IsEdit     bool
	NoticeType string
	NoticeMsg  string
}

templ CustomerBranchFormPage(data CustomerBranchFormData, lang string, dir string, perms []string) {
	{{
		pageTitle := "إضافة فرع صيدلية جديد"
		if data.IsEdit && data.Branch != nil {
			if data.Branch.Name.Get(i18n.AR) != "" {
				pageTitle = "تعديل بيانات فرع: " + data.Branch.Name.Get(i18n.AR)
			} else {
				pageTitle = "تعديل بيانات الفرع"
			}
		}

		formAction := "/customer/branches/new"
		if data.IsEdit && data.Branch != nil {
			formAction = fmt.Sprintf("/customer/branches/%d/edit", data.Branch.ID)
		}

		nameAr := ""
		nameEn := ""
		code := ""
		address := ""
		phone := ""
		gmapsURL := ""
		hasColdStorage := false
		isMain := false
		status := "active"
		defaultLat := "30.0444"
		defaultLon := "31.2357"

		if data.Branch != nil {
			nameAr = data.Branch.Name.Get(i18n.AR)
			nameEn = data.Branch.Name.Get(i18n.EN)
			code = data.Branch.Code
			address = data.Branch.Address
			phone = data.Branch.Phone
			gmapsURL = data.Branch.GoogleMapsURL
			hasColdStorage = data.Branch.HasColdStorage
			isMain = data.Branch.IsMain
			status = data.Branch.Status
			if data.Branch.Latitude != nil {
				defaultLat = fmt.Sprintf("%.6f", *data.Branch.Latitude)
			}
			if data.Branch.Longitude != nil {
				defaultLon = fmt.Sprintf("%.6f", *data.Branch.Longitude)
			}
		}
	}}
	@layouts.CustomerShell(pageTitle, "branches", lang, dir, perms) {
		<div class="page-container max-w-4xl mx-auto py-4">
			
			<!-- Breadcrumb & Top Exit / Navigation Bar -->
			<div class="card p-4 mb-4">
				<div class="d-flex items-center justify-between flex-wrap gap-3">
					<div>
						<!-- Breadcrumbs -->
						<div class="d-flex items-center gap-2 text-xs text-secondary mb-1">
							<a href="/customer/branches" class="text-secondary text-decoration-none font-semibold">إدارة الفروع</a>
							<span>/</span>
							if data.IsEdit {
								<span class="text-primary font-bold">تعديل بيانات الفرع</span>
							} else {
								<span class="text-primary font-bold">إضافة فرع جديد</span>
							}
						</div>
						<h1 class="page-title text-lg font-bold text-primary m-0">
							{ pageTitle }
						</h1>
					</div>

					<!-- Prominent Exit Button (No Save) -->
					<a href="/customer/branches" class="btn btn-secondary btn-sm font-bold gap-1">
						@components.IconArrowRight("icon-xs")
						<span>إلغاء والعودة لقائمة الفروع</span>
					</a>
				</div>
			</div>

			<!-- Notice Alert Banner (if any) -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-4 p-4 d-flex items-center justify-between flex-wrap gap-2">
						<div class="d-flex items-center gap-2 font-bold text-sm">
							@components.IconAlert("icon-xs")
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 d-flex items-center justify-between flex-wrap gap-2">
						<div class="d-flex items-center gap-2 font-bold text-sm">
							@components.IconCheckCircle("icon-xs")
							<span>{ data.NoticeMsg }</span>
						</div>
					</div>
				}
			}

			<!-- Full-Page Branch Form Card -->
			<div class="card p-6">
				<form method="POST" action={ templ.SafeURL(formAction) } class="d-flex flex-col gap-6 m-0">
					
					<!-- Section 1: Basic Identity -->
					<div>
						<div class="d-flex items-center gap-2 mb-4 pb-2 border-bottom">
							@components.IconBuilding("icon-xs")
							<h2 class="text-base font-bold text-primary m-0">1. البيانات الأساسية للفرع</h2>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									اسم الفرع بالعربية <span class="text-danger">*</span>
								</label>
								<input
									type="text"
									name="name_ar"
									value={ nameAr }
									required
									placeholder="مثال: صيدلية الأمل - فرع المعادي"
									class="form-control form-control-sm font-semibold"
								/>
								<span class="text-2xs text-muted mt-1 d-block">الاسم الرسمي الذي يظهر في فواتير الشراء وأذون الاستلام</span>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									اسم الفرع بالإنجليزية (اختياري)
								</label>
								<input
									type="text"
									name="name_en"
									value={ nameEn }
									placeholder="e.g. Al-Amal Pharmacy - Maadi"
									class="form-control form-control-sm font-semibold"
								/>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									كود الفرع الداخلي
								</label>
								<input
									type="text"
									name="code"
									value={ code }
									placeholder="مثال: BR-CAI-01"
									class="form-control form-control-sm tabular-nums"
								/>
								<span class="text-2xs text-muted mt-1 d-block">كود مرجعي خاص بصيدليتك لربط الفروع بنظام ERP</span>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									المدينة / المحافظة <span class="text-danger">*</span>
								</label>
								<select name="city_id" required class="form-select form-select-sm font-semibold">
									<option value="">-- اختر المدينة / المحافظة --</option>
									for _, c := range data.Cities {
										<option
											value={ fmt.Sprintf("%d", c.ID) }
											data-lat={ fmt.Sprintf("%.6f", c.Latitude) }
											data-lng={ fmt.Sprintf("%.6f", c.Longitude) }
											selected?={ data.Branch != nil && data.Branch.CityID != nil && *data.Branch.CityID == c.ID }
										>
											if c.Name["ar"] != "" {
												{ c.Name["ar"] }
											} else {
												{ c.Name["en"] }
											}
										</option>
									}
								</select>
							</div>
						</div>
					</div>

					<!-- Section 2: Address & Contact -->
					<div>
						<div class="d-flex items-center gap-2 mb-4 pb-2 border-bottom">
							@components.IconMapPin("icon-xs")
							<h2 class="text-base font-bold text-primary m-0">2. العنوان وبيانات الاتصال</h2>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div class="form-group mb-0 md:col-span-2">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									العنوان التفصيلي وموقع الاستلام <span class="text-danger">*</span>
								</label>
								<input
									type="text"
									name="address"
									value={ address }
									required
									placeholder="مثال: شارع النصر الرئيسي، برج النور، بجوار مستشفى المعادي"
									class="form-control form-control-sm font-semibold"
								/>
								<span class="text-2xs text-muted mt-1 d-block">العنوان الدقيق لسائقي ومندوبي التوصيل التابعين لشركات التوزيع</span>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									رقم هاتف / محمول الفرع
								</label>
								<input
									type="tel"
									name="phone"
									value={ phone }
									placeholder="مثال: 01012345678"
									class="form-control form-control-sm tabular-nums"
								/>
							</div>
						</div>
					</div>

					<!-- Section 3: Interactive Map & Coordinates -->
					<div>
						<div class="d-flex items-center gap-2 mb-4 pb-2 border-bottom">
							@components.IconMapPin("icon-xs")
							<h2 class="text-base font-bold text-primary m-0">3. الموقع الجغرافي على الخريطة</h2>
						</div>

						<div class="d-flex flex-col gap-2 mb-4">
							<div class="text-xs font-bold text-primary">
								حدد موقع الفرع بدقة بالضغط على الخريطة أو استخدم زر "تحديد موقعي":
							</div>
							
							<div
								data-map-picker
								data-default-lat={ defaultLat }
								data-default-lon={ defaultLon }
								class="rounded-xl overflow-hidden border bg-surface-sunken position-relative"
							>
								<div class="map-container map-canvas"></div>
								<div class="d-flex items-center justify-between p-3 bg-surface-raised border-top text-xs flex-wrap gap-2">
									<div class="d-flex items-center gap-2">
										<span class="text-secondary font-bold">الإحداثيات المحددة:</span>
										<span data-map-coords-badge class="tabular-nums font-bold text-primary">{ defaultLat }, { defaultLon }</span>
									</div>
									<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold">
										<span>تحديد موقعي الحالي GPS</span>
									</button>
								</div>
								<input type="hidden" name="latitude" data-map-input="lat" value={ defaultLat }/>
								<input type="hidden" name="longitude" data-map-input="lon" value={ defaultLon }/>
							</div>
						</div>

						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-primary mb-1 d-block">
								رابط خرائط Google (Google Maps URL)
							</label>
							<input
								type="url"
								name="google_maps_url"
								data-map-google-url
								value={ gmapsURL }
								placeholder={ fmt.Sprintf("https://maps.google.com/?q=%s,%s", defaultLat, defaultLon) }
								class="form-control form-control-sm text-xs"
								dir="ltr"
							/>
						</div>
					</div>

					<!-- Section 4: Storage & Branch Attributes -->
					<div>
						<div class="d-flex items-center gap-2 mb-4 pb-2 border-bottom">
							@components.IconSliders("icon-xs")
							<h2 class="text-base font-bold text-primary m-0">4. خصائص الفرع وحالة التشغيل</h2>
						</div>

						<div class="d-flex flex-col gap-3 p-4 rounded-xl border">
							<label class="d-flex items-start gap-2 cursor-pointer text-xs font-bold text-primary m-0">
								<input
									type="checkbox"
									name="has_cold_storage"
									value="true"
									checked?={ hasColdStorage }
									class="form-checkbox mt-0.5"
								/>
								<div>
									<span>تتوفر ثلاجة لحفظ وتبريد الأدوية (2-8°C)</span>
									<span class="d-block text-2xs font-normal text-secondary mt-0.5">
										يتيح هذا الخيار للموردين توريد الأدوية الحيوية والأنسولين واللقاحات التي تتطلب سلسلة تبريد.
									</span>
								</div>
							</label>

							<label class="d-flex items-start gap-2 cursor-pointer text-xs font-bold text-primary m-0">
								<input
									type="checkbox"
									name="is_main"
									value="true"
									checked?={ isMain }
									class="form-checkbox mt-0.5"
								/>
								<div>
									<span>تعيين كفرع رئيسي لاستلام طلبيات الصيدلية</span>
									<span class="d-block text-2xs font-normal text-secondary mt-0.5">
										سيتم تعيين هذا الفرع كفرع افتراضي عند إنشاء الطلبيات وعمليات الطلب الذكي.
									</span>
								</div>
							</label>

							if data.IsEdit {
								<div class="pt-3 border-top d-flex items-center gap-4 flex-wrap">
									<span class="text-xs font-bold text-primary">حالة تشغيل الفرع:</span>
									<label class="d-flex items-center gap-1 text-xs font-bold cursor-pointer m-0">
										<input type="radio" name="status" value="active" checked?={ status != "inactive" } />
										<span class="badge badge-emerald text-2xs font-bold">نشط وجاهز للاستلام</span>
									</label>
									<label class="d-flex items-center gap-1 text-xs font-bold cursor-pointer m-0">
										<input type="radio" name="status" value="inactive" checked?={ status == "inactive" } />
										<span class="badge badge-slate text-2xs font-bold">معطل مؤقتاً</span>
									</label>
								</div>
							}
						</div>
					</div>

					<!-- Bottom Action Footer -->
					<div class="d-flex items-center justify-between pt-4 border-top flex-wrap gap-3">
						<a href="/customer/branches" class="btn btn-secondary font-bold">
							إلغاء والعودة بدون حفظ
						</a>

						<button type="submit" class="btn btn-primary font-bold px-6 py-2 gap-2">
							@components.IconCheck("icon-xs")
							if data.IsEdit {
								<span>حفظ تحديثات الفرع</span>
							} else {
								<span>+ حفظ وإضافة الفرع</span>
							}
						</button>
					</div>

				</form>
			</div>

		</div>
	}
}
