package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func formatRowsCount(res *compare.ComparisonResultSet) string {
	if res == nil {
		return "0"
	}
	return fmt.Sprintf("%d", len(res.Rows))
}

templ CompareResultsPage(lang, dir string, result *compare.ComparisonResultSet, activeFilter string) {
	@layouts.VendorShell("نتائج تحليل ومقارنة الخصومات", "compare", lang, dir) {
		<div class="page-container">
			
			<!-- Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconTrendingUp("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								تقرير تحليل ومقارنة عروض الموردين
							</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							مقارنة تفصيلية ذكية لأسعار وخصومات الأصناف بين كشوف الموردين واستخراج أفضل فرص الشراء وفجوات التغطية والنواقص.
						</p>
					</div>

					<div class="d-flex items-center gap-3 flex-wrap">
						<a href="/compare/tool" class="btn btn-secondary font-bold gap-2">
							@components.IconArrowLeft("icon-xs")
							<span>مركز الملفات</span>
						</a>
						<button
							type="button"
							class="btn btn-primary font-bold gap-2"
							onclick="exportComparisonTableToCSV()"
						>
							@components.IconDownload("icon-xs")
							<span>تصدير تقرير Excel / CSV</span>
						</button>
					</div>
				</div>

				<!-- Navigation Subtabs for all 4 Analysis Modes -->
				<div class="tabs-nav mt-4">
					<a href="/compare/results" class="tab-btn active">
						المقارنة المجمعة بين الموردين
					</a>
					<a href="/compare/head-to-head" class="tab-btn">
						مقارنة مورد بمورد
					</a>
					<a href="/compare/market-benchmark" class="tab-btn">
						مقارنة مع موردين السوق
					</a>
					<a href="/compare/market-intelligence" class="tab-btn">
						تقرير ذكاء السوق
					</a>
				</div>
			</div>

			<!-- KPI Summary Metric Cards -->
			<div class="dashboard-stat-grid mb-6">
				<!-- Total Compared -->
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الأصناف المقارنة</div>
					<div class="stat-card-value text-primary tabular-nums">
						if result != nil {
							{ fmt.Sprintf("%d", result.Summary.TotalProducts) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">
						if result != nil {
							{ fmt.Sprintf("عبر %d موردين", result.Summary.TotalSuppliers) }
						}
					</span>
				</div>

				<!-- Average Discount -->
				<div class="stat-card-3d">
					<div class="stat-card-label">متوسط الخصم في السوق</div>
					<div class="stat-card-value text-success tabular-nums">
						if result != nil {
							{ fmt.Sprintf("%.1f%%", result.Summary.AverageDiscount) }
						} else {
							0%
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">أفضل فرصة شراء وتوفير</span>
				</div>

				<!-- Suppliers Analyzed -->
				<div class="stat-card-3d">
					<div class="stat-card-label">الموردون المشمولون</div>
					<div class="stat-card-value text-brand tabular-nums">
						if result != nil {
							{ fmt.Sprintf("%d", result.Summary.TotalSuppliers) }
						} else {
							0
						}
					</div>
					<span class="text-xs text-secondary mt-1 d-block">كشوف أسعار نشطة ومطابقة</span>
				</div>
			</div>

			<!-- Filter Bar & Search -->
			<div class="glass-panel p-6 d-flex flex-col gap-4">
				<div class="flex-between flex-wrap gap-3">
					<!-- Quick Filter Tabs -->
					<div class="d-flex items-center gap-2 flex-wrap">
						<button
							type="button"
							class="tab-btn active"
							data-filter="all"
							onclick="applyTableFilter('all', this)"
						>
							<span>الكل ({ formatRowsCount(result) })</span>
						</button>

						<button
							type="button"
							class="tab-btn"
							data-filter="best-discount"
							onclick="applyTableFilter('best-discount', this)"
						>
							<span>خصم أعلى من 15%</span>
						</button>

						<button
							type="button"
							class="tab-btn"
							data-filter="multi-offer"
							onclick="applyTableFilter('multi-offer', this)"
						>
							<span>متوفر لدى أكثر من مورد</span>
						</button>

						<button
							type="button"
							class="tab-btn"
							data-filter="single-offer"
							onclick="applyTableFilter('single-offer', this)"
						>
							<span>أصناف حصرية لمورد واحد</span>
						</button>

						<button
							type="button"
							class="tab-btn"
							data-filter="coverage-gap"
							onclick="applyTableFilter('coverage-gap', this)"
						>
							<span>فجوات ونواقص موردين</span>
						</button>
					</div>

					<!-- Instant Search Filter -->
					<div class="min-w-280">
						<input
							type="text"
							id="comparison-table-search"
							placeholder="بحث باسم الصنف، الكود، أو المورد..."
							class="form-input text-xs"
							oninput="filterTableBySearch(this.value)"
						/>
					</div>
				</div>

				<!-- Comparison Table -->
				if result == nil || len(result.Rows) == 0 {
					<div class="empty-state-glass p-8 text-center">
						<div class="empty-state-icon-wrapper mx-auto mb-3">
							<span class="text-3xl">@components.IconBarChart("icon-sm")</span>
						</div>
						<h3 class="text-lg font-black text-primary mb-1">لا توجد أصناف مستخرجة في الكشوف المختارة</h3>
						<p class="text-sm text-muted mb-4">تأكد من ضبط تعيين الأعمدة للملفات عبر أيقونة الترس في مركز الملفات.</p>
						<a href="/compare/tool" class="btn btn-primary font-bold">
							العودة لمركز ملفات الموردين
						</a>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0" id="comparison-results-table">
							<thead>
								<tr>
									<th>الصنف وحالة الكتالوج</th>
									<th class="tabular-nums">سعر الجمهور</th>
									<th class="tabular-nums">أعلى نسبة خصم</th>
									<th>المورد الفائز بالصفقة</th>
									<th>عروض الموردين وفجوات النواقص</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range result.Rows {
									<tr
										class="comparison-row"
										data-discount={ fmt.Sprintf("%.2f", row.BestDiscount) }
										data-suppliers={ fmt.Sprintf("%d", row.TotalSuppliers) }
										data-gaps={ fmt.Sprintf("%d", len(row.MissingSuppliers)) }
										data-search={ row.ProductName + " " + row.SKU + " " + row.BestSupplier + " " + strings.Join(row.MissingSuppliers, " ") }
									>
										<!-- Product Name & Catalog Verification -->
										<td>
											<div class="d-flex items-center gap-2 flex-wrap mb-1">
												<strong class="text-sm font-extrabold text-primary">{ row.ProductName }</strong>
												if row.InCatalog {
													<span class="badge badge-emerald text-xs font-bold">معتمد</span>
												} else {
													<span class="badge badge-amber text-xs font-bold">كشف مورد</span>
												}
											</div>
											if row.SKU != "" {
												<span class="text-xs text-muted tabular-nums">كود: { row.SKU }</span>
											}
										</td>

										<!-- Best Price -->
										<td class="tabular-nums font-bold text-secondary">
											if row.BestPrice.IsPositive() {
												<span>{ row.BestPrice.String() } ج.م</span>
											} else {
												<span class="text-muted">--</span>
											}
										</td>

										<!-- Best Discount -->
										<td>
											<span class="badge badge-emerald text-xs font-extrabold tabular-nums">
												{ fmt.Sprintf("%.1f%%", row.BestDiscount) }
											</span>
										</td>

										<!-- Best Supplier -->
										<td>
											<span class="badge badge-sky text-xs font-bold">
												{ row.BestSupplier }
											</span>
										</td>

										<!-- Detailed Offers & Gaps Breakdown -->
										<td>
											<div class="d-flex flex-wrap gap-1 mb-1">
												for supName, off := range row.Offers {
													if supName == row.BestSupplier {
														<span class="badge badge-emerald text-xs font-bold" title={ fmt.Sprintf("السعر الصافي: %s ج.م", off.PriceAfterDiscount.String()) }>
															{ supName }: { fmt.Sprintf("%.1f%%", off.Discount) } ({ off.PriceAfterDiscount.String() } ج.م)
														</span>
													} else {
														<span class="badge badge-secondary text-xs" title={ fmt.Sprintf("السعر الصافي: %s ج.م", off.PriceAfterDiscount.String()) }>
															{ supName }: { fmt.Sprintf("%.1f%%", off.Discount) } ({ off.PriceAfterDiscount.String() } ج.م)
														</span>
													}
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>

		<!-- Script for filter tabs, search and CSV export -->
		<script>
			let currentFilter = 'all';

			function applyTableFilter(filter, button) {
				currentFilter = filter;
				document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
				button.classList.add('active');

				filterRows();
			}

			function filterTableBySearch(query) {
				filterRows();
			}

			function filterRows() {
				const query = (document.getElementById('comparison-table-search')?.value || '').toLowerCase().trim();
				const rows = document.querySelectorAll('.comparison-row');

				rows.forEach(row => {
					const disc = parseFloat(row.getAttribute('data-discount') || '0');
					const sups = parseInt(row.getAttribute('data-suppliers') || '1', 10);
					const gaps = parseInt(row.getAttribute('data-gaps') || '0', 10);
					const searchData = (row.getAttribute('data-search') || '').toLowerCase();

					let matchesFilter = true;
					if (currentFilter === 'best-discount') {
						matchesFilter = disc >= 15.0;
					} else if (currentFilter === 'multi-offer') {
						matchesFilter = sups > 1;
					} else if (currentFilter === 'single-offer') {
						matchesFilter = sups === 1;
					} else if (currentFilter === 'coverage-gap') {
						matchesFilter = gaps > 0;
					}

					let matchesSearch = true;
					if (query) {
						matchesSearch = searchData.includes(query);
					}

					row.style.display = (matchesFilter && matchesSearch) ? '' : 'none';
				});
			}

			function exportComparisonTableToCSV() {
				const table = document.getElementById('comparison-results-table');
				if (!table) return;

				let csv = [];
				const rows = table.querySelectorAll('tr');
				for (let i = 0; i < rows.length; i++) {
					if (rows[i].style.display === 'none') continue;
					let row = [], cols = rows[i].querySelectorAll('td, th');
					for (let j = 0; j < cols.length; j++) {
						let text = cols[j].innerText.replace(/"/g, '""').trim();
						row.push('"' + text + '"');
					}
					csv.push(row.join(','));
				}

				const csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
				const downloadLink = document.createElement("a");
				downloadLink.download = `dawa24-discount-comparison-${new Date().toISOString().slice(0,10)}.csv`;
				downloadLink.href = window.URL.createObjectURL(csvFile);
				downloadLink.style.display = "none";
				document.body.appendChild(downloadLink);
				downloadLink.click();
				document.body.removeChild(downloadLink);
			}
		</script>
	}
}
