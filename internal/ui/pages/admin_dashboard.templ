package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminDashboardStats struct {
	TotalUsers            int
	TotalOrganizations    int
	TotalPharmacies       int
	TotalVendors          int
	TotalBranches         int
	PendingApprovals      int
	PendingDepositsCount  int
	PendingDepositsAmount string
	TotalOrders           int
	ActiveOrdersCount     int
	CompletedOrdersCount  int
	TotalProducts         int
	TotalSavingProducts   int
	TotalGMV              string
	TotalCommission       string
	TotalHeldInWallets    string
	TotalVisitors         int
	TodayVisitors         int
	TopDevices            map[string]int
	TopBrowsers           map[string]int
	TopLocations          map[string]int
	GatewayOnline         bool
	GatewayURL            string
	RecentOrders          []*commerce.Order
	RecentOrganizations   []*org.Organization
}

templ AdminDashboard(stats AdminDashboardStats, pendingOrgs []*org.Organization, lang, dir string) {
	@layouts.AdminShell("لوحة التحكم والمؤشرات الرئيسية", "dashboard", lang, dir) {
		<div style="max-width:1440px; margin:0 auto; padding-bottom:3rem;">
			
			<!-- ══════════════════════════════════════════
			     EXECUTIVE HEADER BANNER
			══════════════════════════════════════════ -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; margin-bottom:1.25rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div style="display:flex; align-items:center; gap:0.85rem;">
						<div style="width:46px; height:46px; border-radius:14px; background:var(--accent-subtle, rgba(56,189,248,0.12)); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.4rem; border:1px solid rgba(56,189,248,0.25);">
							@components.IconBarChart("icon-sm")
						</div>
						<div>
							<h1 style="font-size:1.25rem; font-weight:900; color:var(--text); margin:0; display:flex; align-items:center; gap:0.5rem;">
								<span>لوحة القيادة التنفيذية والمؤشرات المركزية</span>
							</h1>
							<p style="font-size:0.82rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
								رصد حي لحجم التداول، شبكة التوريد الصيدلي، أوامر الشراء الجارية، وجاهزية الخدمات
							</p>
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
						<!-- DB & River Status Pill -->
						<div style="display:inline-flex; align-items:center; gap:0.4rem; padding:0.35rem 0.75rem; border-radius:30px; font-size:0.78rem; font-weight:700; background:var(--surface-sunken); border:1px solid var(--border);">
							<span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#10b981; box-shadow:0 0 8px #10b981;"></span>
							<span style="color:var(--text-secondary);">قاعدة البيانات:</span>
							<span style="color:#10b981;">متصلة ونشطة</span>
						</div>

						<!-- Live AI Status Pill -->
						<div style="display:inline-flex; align-items:center; gap:0.4rem; padding:0.35rem 0.75rem; border-radius:30px; font-size:0.78rem; font-weight:700; background:var(--surface-sunken); border:1px solid var(--border);">
							<span>@components.IconSparkles("icon-sm")</span>
							<span style="color:var(--text-secondary);">بوابة الـ AI:</span>
							if stats.GatewayOnline {
								<span style="color:#10b981;">متصلة ومزامنة</span>
							} else {
								<span style="color:#f59e0b;">مستعدة للربط</span>
							}
						</div>

						<!-- Quick Refresh Button -->
						<a href="/admin/dashboard" class="btn btn-secondary btn-sm fw-800" style="padding:0.4rem 0.85rem; font-size:0.8rem; gap:0.35rem; border-radius:8px;">
							@components.IconRefresh("icon-xs")
							<span>تحديث فوري</span>
						</a>
					</div>
				</div>
			</div>

			<!-- ══════════════════════════════════════════
			     1. TOP 4 HIGH-IMPACT EXECUTIVE KPI TILES
			══════════════════════════════════════════ -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1rem; margin-bottom:1.25rem;">
				
				<!-- KPI 1: GMV, Revenue & Commission -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:16px; padding:1.25rem; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; justify-content:space-between;">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<span style="font-size:0.82rem; font-weight:800; color:var(--text-secondary);">حجم التداول والمبيعات (GMV)</span>
						<div style="width:36px; height:36px; border-radius:10px; background:rgba(16, 185, 129, 0.12); color:#10b981; display:flex; align-items:center; justify-content:center; border:1px solid rgba(16, 185, 129, 0.25);">
							@components.IconChart("icon-sm")
						</div>
					</div>
					<div class="tabular-nums" style="font-size:1.85rem; font-weight:900; color:#10b981; margin:0.4rem 0 0.5rem 0; line-height:1.2;">
						if stats.TotalGMV != "" {
							{ stats.TotalGMV }
						} else {
							<span>0.00 ج.م</span>
						}
					</div>
					<div style="border-top:1px solid var(--border); padding-top:0.5rem; margin-top:auto; font-size:0.78rem; display:flex; justify-content:space-between; align-items:center; color:var(--text-muted);">
						<span>عمولة المنصة: <strong style="color:var(--text); font-weight:800;">{ stats.TotalCommission }</strong></span>
						if stats.TotalHeldInWallets != "" && stats.TotalHeldInWallets != "0.00 ج.م" {
							<span>بالمحافظ: <strong class="tabular-nums text-primary">{ stats.TotalHeldInWallets }</strong></span>
						}
					</div>
				</div>

				<!-- KPI 2: Orders & Trade Volume -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:16px; padding:1.25rem; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; justify-content:space-between;">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<span style="font-size:0.82rem; font-weight:800; color:var(--text-secondary);">أوامر التوريد والشحنات (Orders)</span>
						<div style="width:36px; height:36px; border-radius:10px; background:rgba(56, 189, 248, 0.12); color:var(--accent); display:flex; align-items:center; justify-content:center; border:1px solid rgba(56, 189, 248, 0.25);">
							@components.IconTruck("icon-sm")
						</div>
					</div>
					<div class="tabular-nums" style="font-size:1.85rem; font-weight:900; color:var(--text); margin:0.4rem 0 0.5rem 0; line-height:1.2;">
						{ fmt.Sprintf("%d", stats.TotalOrders) } <span style="font-size:0.9rem; font-weight:700; color:var(--text-muted);">طلب توريد</span>
					</div>
					<div style="border-top:1px solid var(--border); padding-top:0.5rem; margin-top:auto; font-size:0.78rem; display:flex; justify-content:space-between; align-items:center; color:var(--text-muted);">
						<span>مكتملة: <strong class="text-emerald tabular-nums">+{ fmt.Sprintf("%d", stats.CompletedOrdersCount) }</strong></span>
						<span>نشطة: <strong class="text-sky tabular-nums">{ fmt.Sprintf("%d", stats.ActiveOrdersCount) }</strong></span>
						<a href="/admin/orders" class="text-accent fw-700 no-underline">عرض الكل ←</a>
					</div>
				</div>

				<!-- KPI 3: Organizations & Supply Network -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:16px; padding:1.25rem; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; justify-content:space-between;">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<span style="font-size:0.82rem; font-weight:800; color:var(--text-secondary);">شبكة الإمداد والمنشآت (Network)</span>
						<div style="width:36px; height:36px; border-radius:10px; background:rgba(168, 85, 247, 0.12); color:#a855f7; display:flex; align-items:center; justify-content:center; border:1px solid rgba(168, 85, 247, 0.25);">
							@components.IconBuilding("icon-sm")
						</div>
					</div>
					<div class="tabular-nums" style="font-size:1.85rem; font-weight:900; color:var(--text); margin:0.4rem 0 0.5rem 0; line-height:1.2;">
						{ fmt.Sprintf("%d", stats.TotalOrganizations) } <span style="font-size:0.9rem; font-weight:700; color:var(--text-muted);">منشأة معتمدة</span>
					</div>
					<div style="border-top:1px solid var(--border); padding-top:0.5rem; margin-top:auto; font-size:0.78rem; display:flex; justify-content:space-between; align-items:center; color:var(--text-muted);">
						<span>صيدليات: <strong class="text-emerald tabular-nums">{ fmt.Sprintf("%d", stats.TotalPharmacies) }</strong></span>
						<span>موردون: <strong class="text-purple tabular-nums">{ fmt.Sprintf("%d", stats.TotalVendors) }</strong></span>
						<span>فروع: <strong class="text-sky tabular-nums">{ fmt.Sprintf("%d", stats.TotalBranches) }</strong></span>
					</div>
				</div>

				<!-- KPI 4: Governance & Pending Actions -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:16px; padding:1.25rem; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; justify-content:space-between;">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<span style="font-size:0.82rem; font-weight:800; color:var(--text-secondary);">الاعتمادات والإيداعات العاجلة</span>
						<div style="width:36px; height:36px; border-radius:10px; background:rgba(245, 158, 11, 0.12); color:#f59e0b; display:flex; align-items:center; justify-content:center; border:1px solid rgba(245, 158, 11, 0.25);">
							@components.IconShield("icon-sm")
						</div>
					</div>
					<div style="margin:0.4rem 0 0.5rem 0; display:flex; gap:0.5rem; align-items:baseline; flex-wrap:wrap;">
						if stats.PendingApprovals > 0 {
							<a href="/admin/approvals" class="badge badge-amber font-bold text-xs" style="padding:0.35rem 0.65rem; border-radius:6px; text-decoration:none;">
								⏳ { fmt.Sprintf("%d تراخيص معلقة", stats.PendingApprovals) }
							</a>
						} else {
							<span class="badge badge-emerald text-xs font-bold" style="padding:0.35rem 0.65rem; border-radius:6px;">
								التراخيص معتمدة
							</span>
						}

						if stats.PendingDepositsCount > 0 {
							<a href="/admin/finance?tab=deposits" class="badge badge-sky font-bold text-xs" style="padding:0.35rem 0.65rem; border-radius:6px; text-decoration:none;">
								{ fmt.Sprintf("%d شحن محفظة", stats.PendingDepositsCount) }
							</a>
						}
					</div>
					<div style="border-top:1px solid var(--border); padding-top:0.5rem; margin-top:auto; font-size:0.78rem; display:flex; justify-content:space-between; align-items:center; color:var(--text-muted);">
						<span>إجمالي المستخدمين: <strong class="text-primary tabular-nums">{ fmt.Sprintf("%d", stats.TotalUsers) }</strong></span>
						<a href="/admin/approvals" class="text-accent fw-700 no-underline">مراجعة الكل ←</a>
					</div>
				</div>

			</div>

			<!-- ══════════════════════════════════════════
			     2. MID SECTION (2-COLUMNS: OPERATIONS & ANALYTICS)
			══════════════════════════════════════════ -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(420px, 1fr)); gap:1.25rem; margin-bottom:1.25rem; align-items:start;">
				
				<!-- Column 1: Live Orders & Catalog Activity -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<div>
							<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
								<span>@components.IconCart("icon-sm")</span>
								<span>حركة الكتالوج وأحدث أوامر التوريد</span>
							</h3>
							<p style="font-size:0.78rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								رصد مباشر لتدفق طلبات الشراء بين الصيدليات والموردين
							</p>
						</div>
						<a href="/admin/orders" class="btn btn-secondary btn-xs fw-800" style="gap:0.25rem;">
							<span>عرض الطلبات</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					<!-- Mini Catalog Summary Strip -->
					<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.5rem; margin-bottom:1rem;">
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:10px; padding:0.6rem 0.75rem; text-align:center;">
							<div style="font-size:0.72rem; color:var(--text-muted); font-weight:700;">الكتالوج المعتمد</div>
							<div class="tabular-nums" style="font-size:1.15rem; font-weight:900; color:var(--text); margin-top:2px;">
								{ fmt.Sprintf("%d", stats.TotalProducts) }
							</div>
						</div>
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:10px; padding:0.6rem 0.75rem; text-align:center;">
							<div style="font-size:0.72rem; color:var(--text-muted); font-weight:700;">منتجات التوفير</div>
							<div class="tabular-nums" style="font-size:1.15rem; font-weight:900; color:#10b981; margin-top:2px;">
								{ fmt.Sprintf("%d", stats.TotalSavingProducts) }
							</div>
						</div>
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:10px; padding:0.6rem 0.75rem; text-align:center;">
							<div style="font-size:0.72rem; color:var(--text-muted); font-weight:700;">الفروع والمستودعات</div>
							<div class="tabular-nums" style="font-size:1.15rem; font-weight:900; color:var(--accent); margin-top:2px;">
								{ fmt.Sprintf("%d", stats.TotalBranches) }
							</div>
						</div>
					</div>

					<!-- Recent Orders Stream Table -->
					if len(stats.RecentOrders) == 0 {
						<div style="padding:2rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:12px; border:1px dashed var(--border); font-size:0.82rem; color:var(--text-muted);">
							لا توجد طلبيات مسجلة حديثاً في المنظومة.
						</div>
					} else {
						<div style="border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--surface-sunken);">
							<table class="data-table" style="font-size:0.8rem">
								<thead>
									<tr style="background:var(--surface-raised);">
										<th class="pad-sm"># الطلب</th>
										<th class="pad-sm">المنشأة / العميل</th>
										<th class="pad-sm">المبلغ الإجمالي</th>
										<th class="pad-sm">الحالة</th>
										<th class="text-end pad-sm">التاريخ</th>
									</tr>
								</thead>
								<tbody>
									for _, ord := range stats.RecentOrders {
										<tr class="rule-bottom">
											<td class="tabular-nums fw-800 text-primary pad-sm">
												<a href="/admin/orders" style="color:inherit; text-decoration:none;">
													ORD-#{ fmt.Sprintf("%d", ord.ID) }
												</a>
											</td>
											<td class="pad-sm">
												if ord.OrganizationID != nil {
													<span class="badge badge-sky text-xs fw-700">منشأة #{ fmt.Sprintf("%d", *ord.OrganizationID) }</span>
												} else {
													<span class="text-muted">عميل #{ fmt.Sprintf("%d", ord.CustomerID) }</span>
												}
											</td>
											<td class="tabular-nums fw-900 text-emerald pad-sm">
												{ ord.TotalAmount.String() } ج.م
											</td>
											<td class="pad-sm">
												if ord.Status == "completed" || ord.Status == "delivered" {
													<span class="badge badge-emerald text-xs fw-800">مكتمل</span>
												} else if ord.Status == "pending" {
													<span class="badge badge-amber text-xs fw-800">معلق</span>
												} else if ord.Status == "cancelled" || ord.Status == "rejected" {
													<span class="badge badge-danger text-xs fw-800">ملغي</span>
												} else {
													<span class="badge badge-sky text-xs fw-800">{ string(ord.Status) }</span>
												}
											</td>
											<td class="tabular-nums text-muted text-end text-xs pad-sm">
												{ ord.CreatedAt.Format("01/02 15:04") }
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Column 2: Traffic, Visitor Analytics & Infrastructure -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<div>
							<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
								<span>@components.IconGlobe("icon-sm")</span>
								<span>حركة الزوار وجاهزية البنية التحتية</span>
							</h3>
							<p style="font-size:0.78rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								توزيع أجهزة التصفح وحالة خوادم التشغيل والخدمات السحابية
							</p>
						</div>
						<a href="/admin/analytics" class="btn btn-secondary btn-xs fw-800" style="gap:0.25rem;">
							<span>تفاصيل الزوار</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					<!-- Visitor Counter & Devices Grid -->
					<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:1rem;">
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:12px; padding:0.75rem 1rem;">
							<div class="label-strong">إجمالي زوار المنصة</div>
							<div class="tabular-nums" style="font-size:1.4rem; font-weight:900; color:var(--accent); margin-top:2px;">
								{ fmt.Sprintf("%d", stats.TotalVisitors) } <span style="font-size:0.75rem; font-weight:600; color:var(--text-muted);">زائر</span>
							</div>
							<div style="font-size:0.72rem; color:var(--text-muted); margin-top:0.25rem;">
								اليوم: <strong class="text-emerald tabular-nums">+{ fmt.Sprintf("%d", stats.TodayVisitors) }</strong>
							</div>
						</div>

						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:12px; padding:0.75rem 1rem;">
							<div class="label-strong">توزيع الأجهزة (Devices)</div>
							<div style="display:flex; flex-direction:column; gap:0.35rem; margin-top:0.4rem; font-size:0.75rem;">
								for devName, devCount := range stats.TopDevices {
									<div style="display:flex; justify-content:space-between; align-items:center;">
										<span style="color:var(--text-secondary); display:flex; align-items:center; gap:0.25rem;">
											if devName == "desktop" || devName == "حاسوب مكتبي (Desktop)" {
												<span>@components.IconMonitor("icon-sm")</span>
											} else {
												<span>@components.IconPhone("icon-sm")</span>
											}
											<span>{ devName }</span>
										</span>
										<strong class="tabular-nums text-body">{ fmt.Sprintf("%d", devCount) }</strong>
									</div>
								}
								if len(stats.TopDevices) == 0 {
									<span class="text-muted">جاري جمع إحصائيات الأجهزة...</span>
								}
							</div>
						</div>
					</div>

					<!-- Infrastructure & Cloud Health Box -->
					<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:12px; padding:0.85rem 1rem;">
						<div style="font-size:0.75rem; font-weight:800; color:var(--text-secondary); margin-bottom:0.5rem;">حالة الخدمات السحابية والربط:</div>
						<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.5rem; font-size:0.78rem;">
							<div style="display:flex; justify-content:space-between; align-items:center; background:var(--surface-raised); padding:0.4rem 0.6rem; border-radius:6px; border:1px solid var(--border);">
								<span style="color:var(--text-secondary); font-weight:600;">قاعدة PostgreSQL:</span>
								<span style="color:#10b981; font-weight:800;">نشطة </span>
							</div>
							<div style="display:flex; justify-content:space-between; align-items:center; background:var(--surface-raised); padding:0.4rem 0.6rem; border-radius:6px; border:1px solid var(--border);">
								<span style="color:var(--text-secondary); font-weight:600;">طوابير River Queue:</span>
								<span style="color:#10b981; font-weight:800;">معالجة فورية </span>
							</div>
							<div style="display:flex; justify-content:space-between; align-items:center; background:var(--surface-raised); padding:0.4rem 0.6rem; border-radius:6px; border:1px solid var(--border);">
								<span style="color:var(--text-secondary); font-weight:600;">بوابة الذكاء الاصطناعي:</span>
								if stats.GatewayOnline {
									<span style="color:#10b981; font-weight:800;">متصلة ومزامنة </span>
								} else {
									<span style="color:#f59e0b; font-weight:800;">جاهزة للربط</span>
								}
							</div>
						</div>
					</div>
				</div>

			</div>

			<!-- ══════════════════════════════════════════
			     3. BOTTOM SECTION: PENDING APPROVALS & RECENT ORGANIZATIONS
			══════════════════════════════════════════ -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(420px, 1fr)); gap:1.25rem; margin-bottom:1.5rem; align-items:start;">
				
				<!-- Pending Approvals Queue -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<div>
							<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
								<span>@components.IconShield("icon-sm")</span>
								<span>طلبات اعتماد التراخيص والمنشآت</span>
								if len(pendingOrgs) > 0 {
									<span class="badge badge-amber text-xs fw-800">{ fmt.Sprintf("%d معلق", len(pendingOrgs)) }</span>
								}
							</h3>
							<p style="font-size:0.78rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								فحص السجلات التجارية ومزاولة المهنة للصيدليات والموردين
							</p>
						</div>
						<a href="/admin/approvals" class="btn btn-primary btn-xs fw-800" style="gap:0.25rem;">
							<span>قائمة التدقيق</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					if len(pendingOrgs) == 0 {
						<div style="padding:1.75rem 1rem; text-align:center; background:rgba(16, 185, 129, 0.05); border:1px solid rgba(16, 185, 129, 0.2); border-radius:12px;">
							<div style="font-size:1.5rem; margin-bottom:0.3rem;">@components.IconCheck("icon-sm")</div>
							<div style="font-weight:800; font-size:0.9rem; color:#10b981;">تم اعتماد وتدقيق كافة التراخيص بالكامل</div>
							<div style="font-size:0.75rem; color:var(--text-secondary); margin-top:0.2rem;">لا توجد منشآت أو تراخيص معلقة بانتظار المراجعة حالياً.</div>
						</div>
					} else {
						<div style="display:flex; flex-direction:column; gap:0.6rem;">
							for _, po := range pendingOrgs {
								<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:12px; padding:0.75rem 1rem; display:flex; justify-content:space-between; align-items:center; gap:0.75rem;">
									<div class="d-flex items-center gap-3">
										<div style="width:36px; height:36px; border-radius:8px; background:var(--surface-raised); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--accent);">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<div style="font-weight:800; font-size:0.88rem; color:var(--text); display:flex; align-items:center; gap:0.4rem;">
												<span>{ po.LegalName }</span>
												if string(po.Type) == "vendor" {
													<span class="badge badge-sky text-xs fw-700">مورد</span>
												} else {
													<span class="badge badge-emerald text-xs fw-700">صيدلية</span>
												}
											</div>
											<div class="text-xs text-muted tabular-nums" style="margin-top:2px;">
												if po.CommercialRegister != "" {
													<span>سجل: { po.CommercialRegister }</span>
												}
												if po.PharmacistLicense != "" {
													<span> • ترخيص: { po.PharmacistLicense }</span>
												}
											</div>
										</div>
									</div>
									<a href="/admin/approvals" class="btn btn-primary btn-xs fw-800" style="padding:0.35rem 0.75rem; border-radius:6px;">
										فحص
									</a>
								</div>
							}
						</div>
					}
				</div>

				<!-- Recent Organizations Ecosystem -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<div>
							<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
								<span>@components.IconBuilding("icon-sm")</span>
								<span>أحدث المنشآت المنضمة للمنظومة</span>
							</h3>
							<p style="font-size:0.78rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
								الصيدليات والموردين المسجلين حديثاً في شبكة إمداد دواء 24
							</p>
						</div>
						<a href="/admin/organizations" class="btn btn-secondary btn-xs fw-800" style="gap:0.25rem;">
							<span>دليل المنشآت</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					if len(stats.RecentOrganizations) == 0 {
						<div style="padding:1.75rem 1rem; text-align:center; background:var(--surface-sunken); border-radius:12px; font-size:0.82rem; color:var(--text-muted);">
							جاري تحميل بيانات شبكة المنشآت...
						</div>
					} else {
						<div style="display:flex; flex-direction:column; gap:0.6rem;">
							for _, ro := range stats.RecentOrganizations {
								<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:12px; padding:0.75rem 1rem; display:flex; justify-content:space-between; align-items:center;">
									<div class="d-flex items-center gap-3">
										<div style="width:36px; height:36px; border-radius:8px; background:var(--surface-raised); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--accent);">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<div style="font-weight:800; font-size:0.88rem; color:var(--text); display:flex; align-items:center; gap:0.4rem;">
												<span>{ ro.LegalName }</span>
												if string(ro.Type) == "vendor" {
													<span class="badge badge-purple text-xs fw-700">مورد أدوية</span>
												} else {
													<span class="badge badge-emerald text-xs fw-700">صيدلية معتمدة</span>
												}
											</div>
											<div class="text-xs text-muted tabular-nums" style="margin-top:2px;">
												منشأة #{ fmt.Sprintf("%d", ro.ID) } • { ro.CreatedAt.Format("2006-01-02") }
											</div>
										</div>
									</div>
									<div>
										if string(ro.Status) == "approved" {
											<span class="badge badge-emerald text-xs fw-700">معتمد </span>
										} else if string(ro.Status) == "pending" {
											<span class="badge badge-amber text-xs fw-700">قيد المراجعة</span>
										} else {
											<span class="badge badge-slate text-xs fw-700">{ string(ro.Status) }</span>
										}
									</div>
								</div>
							}
						</div>
					}
				</div>

			</div>

			<!-- ══════════════════════════════════════════
			     4. EXECUTIVE QUICK ACTION SHORTCUTS
			══════════════════════════════════════════ -->
			<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:16px; padding:1rem 1.25rem;">
				<div style="font-size:0.8rem; font-weight:800; color:var(--text-secondary); margin-bottom:0.6rem;">الوصول السريع للأقسام التنفيذية:</div>
				<div style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center;">
					<a href="/admin/finance" class="btn btn-secondary btn-xs fw-800" style="gap:0.35rem; padding:0.45rem 0.85rem; border-radius:8px;">
						@components.IconWallet("icon-xs")
						<span>الإدارة المالية والمحافظ</span>
					</a>
					<a href="/admin/approvals" class="btn btn-secondary btn-xs fw-800" style="gap:0.35rem; padding:0.45rem 0.85rem; border-radius:8px;">
						@components.IconShield("icon-xs")
						<span>اعتماد المنشآت والوثائق</span>
					</a>
					<a href="/admin/orders" class="btn btn-secondary btn-xs fw-800" style="gap:0.35rem; padding:0.45rem 0.85rem; border-radius:8px;">
						@components.IconTruck("icon-xs")
						<span>أوامر التوريد والشحنات</span>
					</a>
					<a href="/admin/products" class="btn btn-secondary btn-xs fw-800" style="gap:0.35rem; padding:0.45rem 0.85rem; border-radius:8px;">
						@components.IconPackage("icon-xs")
						<span>كتالوج الأدوية المعتمد</span>
					</a>
					<a href="/admin/plans" class="btn btn-secondary btn-xs fw-800" style="gap:0.35rem; padding:0.45rem 0.85rem; border-radius:8px;">
						@components.IconTag("icon-xs")
						<span>باقات وخطط الاشتراك</span>
					</a>
					<a href="/admin/users" class="btn btn-secondary btn-xs fw-800" style="gap:0.35rem; padding:0.45rem 0.85rem; border-radius:8px;">
						@components.IconUsers("icon-xs")
						<span>المستخدمون والحسابات</span>
					</a>
					<a href="/admin/settings" class="btn btn-secondary btn-xs fw-800" style="gap:0.35rem; padding:0.45rem 0.85rem; border-radius:8px;">
						@components.IconSettings("icon-xs")
						<span>إعدادات النظام العامة</span>
					</a>
				</div>
			</div>

		</div>
	}
}
