package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminDashboardStats struct {
	TotalUsers            int
	TotalOrganizations    int
	TotalPharmacies       int
	TotalVendors          int
	TotalBranches         int
	PendingApprovals      int
	PendingDepositsCount  int
	PendingDepositsAmount string
	TotalOrders           int
	ActiveOrdersCount     int
	CompletedOrdersCount  int
	TotalProducts         int
	TotalSavingProducts   int
	TotalGMV              string
	TotalCommission       string
	TotalHeldInWallets    string
	TotalVisitors         int
	TodayVisitors         int
	TopDevices            map[string]int
	TopBrowsers           map[string]int
	TopLocations          map[string]int
	GatewayOnline         bool
	GatewayURL            string
	RecentOrders          []*commerce.Order
	RecentOrganizations   []*org.Organization
}

templ AdminDashboard(stats AdminDashboardStats, pendingOrgs []*org.Organization, lang, dir string) {
	@layouts.AdminShell("لوحة التحكم والمؤشرات الرئيسية", "dashboard", lang, dir) {
		<div class="admin-page-container">
			
			<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
			     EXECUTIVE HEADER BANNER
			â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
			<div class="admin-banner">
				<div class="admin-banner-inner">
					<div class="d-flex items-center gap-3">
						<div class="admin-banner-icon primary">
							@components.IconBarChart("icon-sm")
						</div>
						<div>
							<h1 class="admin-banner-title">
								<span>لوحة القيادة التنفيذية والمؤشرات المركزية</span>
							</h1>
							<p class="admin-banner-subtitle">
								رصد حي لحجم التداول، شبكة التوريد الصيدلي، أوامر الشراء الجارية، وجاهزية الخدمات
							</p>
						</div>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap">
						<!-- DB & River Status Pill -->
						<div class="admin-status-pill">
							<span class="admin-status-dot online"></span>
							<span class="text-secondary">قاعدة البيانات:</span>
							<span class="text-success">متصلة ونشطة</span>
						</div>

						<!-- Live AI Status Pill -->
						<div class="admin-status-pill">
							<span>@components.IconSparkles("icon-sm")</span>
							<span class="text-secondary">بوابة الـ AI:</span>
							if stats.GatewayOnline {
								<span class="text-success">متصلة ومزامنة</span>
							} else {
								<span class="text-warning">مستعدة للربط</span>
							}
						</div>

						<!-- Quick Refresh Button -->
						<a href="/admin/dashboard"class="btn btn-secondary btn-sm fw-800 text-xs gap-1 rounded-md">
							@components.IconRefresh("icon-xs")
							<span>تحديث فوري</span>
						</a>
					</div>
				</div>
			</div>

			<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
			     1. TOP 4 HIGH-IMPACT EXECUTIVE KPI TILES
			â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
			<div class="admin-kpi-grid">
				
				<!-- KPI 1: GMV, Revenue & Commission -->
				<div class="admin-kpi-card">
					<div class="admin-kpi-header">
						<span class="admin-kpi-title">حجم التداول والمبيعات (GMV)</span>
						<div class="admin-kpi-icon bg-success-subtle text-success">
							@components.IconChart("icon-sm")
						</div>
					</div>
					<div class="tabular-nums admin-kpi-value text-success">
						if stats.TotalGMV != "" {
							{ stats.TotalGMV }
						} else {
							<span>0.00 ج.م</span>
						}
					</div>
					<div class="admin-kpi-footer">
						<span>عمولة المنصة: <strong class="text-primary font-bold">{ stats.TotalCommission }</strong></span>
						if stats.TotalHeldInWallets != "" && stats.TotalHeldInWallets != "0.00 ج.م" {
							<span>بالمحافظ: <strong class="tabular-nums text-primary">{ stats.TotalHeldInWallets }</strong></span>
						}
					</div>
				</div>

				<!-- KPI 2: Orders & Trade Volume -->
				<div class="admin-kpi-card">
					<div class="admin-kpi-header">
						<span class="admin-kpi-title">أوامر التوريد والشحنات (Orders)</span>
						<div class="admin-kpi-icon bg-primary-subtle text-brand">
							@components.IconTruck("icon-sm")
						</div>
					</div>
					<div class="tabular-nums admin-kpi-value text-primary">
						{ fmt.Sprintf("%d", stats.TotalOrders) } <span class="text-xs text-muted font-bold">طلب توريد</span>
					</div>
					<div class="admin-kpi-footer">
						<span>مكتملة: <strong class="text-emerald tabular-nums">+{ fmt.Sprintf("%d", stats.CompletedOrdersCount) }</strong></span>
						<span>نشطة: <strong class="text-sky tabular-nums">{ fmt.Sprintf("%d", stats.ActiveOrdersCount) }</strong></span>
						<a href="/admin/orders" class="text-accent fw-700 no-underline">عرض الكل â†</a>
					</div>
				</div>

				<!-- KPI 3: Organizations & Supply Network -->
				<div class="admin-kpi-card">
					<div class="admin-kpi-header">
						<span class="admin-kpi-title">شبكة الإمداد والمنشآت (Network)</span>
						<div class="admin-kpi-icon text-purple">
							@components.IconBuilding("icon-sm")
						</div>
					</div>
					<div class="tabular-nums admin-kpi-value text-primary">
						{ fmt.Sprintf("%d", stats.TotalOrganizations) } <span class="text-xs text-muted font-bold">منشأة معتمدة</span>
					</div>
					<div class="admin-kpi-footer">
						<span>صيدليات: <strong class="text-emerald tabular-nums">{ fmt.Sprintf("%d", stats.TotalPharmacies) }</strong></span>
						<span>موردون: <strong class="text-purple tabular-nums">{ fmt.Sprintf("%d", stats.TotalVendors) }</strong></span>
						<span>فروع: <strong class="text-sky tabular-nums">{ fmt.Sprintf("%d", stats.TotalBranches) }</strong></span>
					</div>
				</div>

				<!-- KPI 4: Governance & Pending Actions -->
				<div class="admin-kpi-card">
					<div class="admin-kpi-header">
						<span class="admin-kpi-title">الاعتمادات والإيداعات العاجلة</span>
						<div class="admin-kpi-icon bg-warning-subtle text-warning">
							@components.IconShield("icon-sm")
						</div>
					</div>
					<div class="d-flex gap-2 items-baseline flex-wrap my-1">
						if stats.PendingApprovals > 0 {
							<a href="/admin/approvals"class="badge badge-amber font-bold text-xs rounded-md no-underline">
								â³ { fmt.Sprintf("%d تراخيص معلقة", stats.PendingApprovals) }
							</a>
						} else {
							<span class="badge badge-emerald text-xs font-bold rounded-md">
								التراخيص معتمدة
							</span>
						}

						if stats.PendingDepositsCount > 0 {
							<a href="/admin/finance?tab=deposits"class="badge badge-sky font-bold text-xs rounded-md no-underline">
								{ fmt.Sprintf("%d شحن محفظة", stats.PendingDepositsCount) }
							</a>
						}
					</div>
					<div class="admin-kpi-footer">
						<span>إجمالي المستخدمين: <strong class="text-primary tabular-nums">{ fmt.Sprintf("%d", stats.TotalUsers) }</strong></span>
						<a href="/admin/approvals" class="text-accent fw-700 no-underline">مراجعة الكل â†</a>
					</div>
				</div>

			</div>

			<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
			     2. MID SECTION (2-COLUMNS: OPERATIONS & ANALYTICS)
			â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
			<div class="d-grid gap-4 items-start mb-4 grid-auto-fit-lg">
				
				<!-- Column 1: Live Orders & Catalog Activity -->
				<div class="admin-banner">
					<div class="flex-between pb-3 border-b mb-3">
						<div>
							<h3 class="text-base font-bold text-primary m-0 d-flex items-center gap-1.5">
								<span>@components.IconCart("icon-sm")</span>
								<span>حركة الكتالوج وأحدث أوامر التوريد</span>
							</h3>
							<p class="text-xs text-secondary mt-0.5 m-0">
								رصد مباشر لتدفق طلبات الشراء بين الصيدليات والموردين
							</p>
						</div>
						<a href="/admin/orders"class="btn btn-secondary btn-xs fw-800 gap-1">
							<span>عرض الطلبات</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					<!-- Mini Catalog Summary Strip -->
					<div class="d-grid grid-cols-3 gap-2 mb-3">
						<div class="bg-surface-sunken border rounded-lg p-2 text-center">
							<div class="text-xs text-muted font-bold">الكتالوج المعتمد</div>
							<div class="tabular-nums text-lg font-black text-primary mt-0.5">
								{ fmt.Sprintf("%d", stats.TotalProducts) }
							</div>
						</div>
						<div class="bg-surface-sunken border rounded-lg p-2 text-center">
							<div class="text-xs text-muted font-bold">منتجات التوفير</div>
							<div class="tabular-nums text-lg font-black text-success mt-0.5">
								{ fmt.Sprintf("%d", stats.TotalSavingProducts) }
							</div>
						</div>
						<div class="bg-surface-sunken border rounded-lg p-2 text-center">
							<div class="text-xs text-muted font-bold">الفروع والمستودعات</div>
							<div class="tabular-nums text-lg font-black text-brand mt-0.5">
								{ fmt.Sprintf("%d", stats.TotalBranches) }
							</div>
						</div>
					</div>

					<!-- Recent Orders Stream Table -->
					if len(stats.RecentOrders) == 0 {
						<div class="p-6 text-center bg-surface-sunken rounded-xl border border-dashed text-xs text-muted">
							لا توجد طلبيات مسجلة حديثاً في المنظومة.
						</div>
					} else {
						<div class="border rounded-xl overflow-hidden bg-surface-sunken">
							<table class="data-table text-xs">
								<thead>
									<tr class="bg-surface-raised">
										<th class="pad-sm"># الطلب</th>
										<th class="pad-sm">المنشأة / العميل</th>
										<th class="pad-sm">المبلغ الإجمالي</th>
										<th class="pad-sm">الحالة</th>
										<th class="text-end pad-sm">التاريخ</th>
									</tr>
								</thead>
								<tbody>
									for _, ord := range stats.RecentOrders {
										<tr class="rule-bottom">
											<td class="tabular-nums fw-800 text-primary pad-sm">
												<a href="/admin/orders" class="text-inherit no-underline">
													ORD-#{ fmt.Sprintf("%d", ord.ID) }
												</a>
											</td>
											<td class="pad-sm">
												if ord.OrganizationID != nil {
													<span class="badge badge-sky text-xs fw-700">منشأة #{ fmt.Sprintf("%d", *ord.OrganizationID) }</span>
												} else {
													<span class="text-muted">عميل #{ fmt.Sprintf("%d", ord.CustomerID) }</span>
												}
											</td>
											<td class="tabular-nums fw-900 text-emerald pad-sm">
												{ ord.TotalAmount.String() } ج.م
											</td>
											<td class="pad-sm">
												if ord.Status == "completed" || ord.Status == "delivered" {
													<span class="badge badge-emerald text-xs fw-800">مكتمل</span>
												} else if ord.Status == "pending" {
													<span class="badge badge-amber text-xs fw-800">معلق</span>
												} else if ord.Status == "cancelled" || ord.Status == "rejected" {
													<span class="badge badge-danger text-xs fw-800">ملغي</span>
												} else {
													<span class="badge badge-sky text-xs fw-800">{ string(ord.Status) }</span>
												}
											</td>
											<td class="tabular-nums text-muted text-end text-xs pad-sm">
												{ ord.CreatedAt.Format("01/02 15:04") }
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Column 2: Traffic, Visitor Analytics & Infrastructure -->
				<div class="admin-banner">
					<div class="flex-between pb-3 border-b mb-3">
						<div>
							<h3 class="text-base font-bold text-primary m-0 d-flex items-center gap-1.5">
								<span>@components.IconGlobe("icon-sm")</span>
								<span>حركة الزوار وجاهزية البنية التحتية</span>
							</h3>
							<p class="text-xs text-secondary mt-0.5 m-0">
								توزيع أجهزة التصفح وحالة خوادم التشغيل والخدمات السحابية
							</p>
						</div>
						<a href="/admin/analytics"class="btn btn-secondary btn-xs fw-800 gap-1">
							<span>تفاصيل الزوار</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					<!-- Visitor Counter & Devices Grid -->
					<div class="d-grid grid-cols-2 gap-3 mb-3">
						<div class="bg-surface-sunken border rounded-xl p-3">
							<div class="label-strong">إجمالي زوار المنصة</div>
							<div class="tabular-nums text-xl font-black text-brand mt-0.5">
								{ fmt.Sprintf("%d", stats.TotalVisitors) } <span class="text-xs text-muted font-semibold">زائر</span>
							</div>
							<div class="text-xs text-muted mt-1">
								اليوم: <strong class="text-emerald tabular-nums">+{ fmt.Sprintf("%d", stats.TodayVisitors) }</strong>
							</div>
						</div>

						<div class="bg-surface-sunken border rounded-xl p-3">
							<div class="label-strong">توزيع الأجهزة (Devices)</div>
							<div class="d-flex flex-col gap-1 mt-1 text-xs">
								for devName, devCount := range stats.TopDevices {
									<div class="admin-kpi-header">
										<span class="text-secondary d-flex items-center gap-1">
											if devName == "desktop" || devName == "حاسوب مكتبي (Desktop)" {
												<span>@components.IconMonitor("icon-sm")</span>
											} else {
												<span>@components.IconPhone("icon-sm")</span>
											}
											<span>{ devName }</span>
										</span>
										<strong class="tabular-nums text-body">{ fmt.Sprintf("%d", devCount) }</strong>
									</div>
								}
								if len(stats.TopDevices) == 0 {
									<span class="text-muted">جاري جمع إحصائيات الأجهزة...</span>
								}
							</div>
						</div>
					</div>

					<!-- Infrastructure & Cloud Health Box -->
					<div class="bg-surface-sunken border rounded-xl p-3">
						<div class="text-xs font-bold text-secondary mb-2">حالة الخدمات السحابية والربط:</div>
						<div class="d-grid gap-2 text-xs grid-auto-fit-xs">
							<div class="flex-between bg-surface-raised p-1.5 rounded-md border">
								<span class="text-secondary font-semibold">قاعدة PostgreSQL:</span>
								<span class="text-success font-bold">نشطة </span>
							</div>
							<div class="flex-between bg-surface-raised p-1.5 rounded-md border">
								<span class="text-secondary font-semibold">طوابير River Queue:</span>
								<span class="text-success font-bold">معالجة فورية </span>
							</div>
							<div class="flex-between bg-surface-raised p-1.5 rounded-md border">
								<span class="text-secondary font-semibold">بوابة الذكاء الاصطناعي:</span>
								if stats.GatewayOnline {
									<span class="text-success font-bold">متصلة ومزامنة </span>
								} else {
									<span class="text-warning font-bold">جاهزة للربط</span>
								}
							</div>
						</div>
					</div>
				</div>

			</div>

			<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
			     3. BOTTOM SECTION: PENDING APPROVALS & RECENT ORGANIZATIONS
			â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
			<div class="d-grid gap-4 items-start mb-4 grid-auto-fit-lg">
				
				<!-- Pending Approvals Queue -->
				<div class="admin-banner">
					<div class="flex-between pb-3 border-b mb-3">
						<div>
							<h3 class="text-base font-bold text-primary m-0 d-flex items-center gap-1.5">
								<span>@components.IconShield("icon-sm")</span>
								<span>طلبات اعتماد التراخيص والمنشآت</span>
								if len(pendingOrgs) > 0 {
									<span class="badge badge-amber text-xs fw-800">{ fmt.Sprintf("%d معلق", len(pendingOrgs)) }</span>
								}
							</h3>
							<p class="text-xs text-secondary mt-0.5 m-0">
								فحص السجلات التجارية ومزاولة المهنة للصيدليات والموردين
							</p>
						</div>
						<a href="/admin/approvals"class="btn btn-primary btn-xs fw-800 gap-1">
							<span>قائمة التدقيق</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					if len(pendingOrgs) == 0 {
						<div class="p-6 text-center bg-success-subtle border rounded-xl">
							<div class="text-2xl mb-1">@components.IconCheck("icon-sm")</div>
							<div class="font-bold text-sm text-success">تم اعتماد وتدقيق كافة التراخيص بالكامل</div>
							<div class="text-xs text-secondary mt-0.5">لا توجد منشآت أو تراخيص معلقة بانتظار المراجعة حالياً.</div>
						</div>
					} else {
						<div class="d-flex flex-col gap-2">
							for _, po := range pendingOrgs {
								<div class="bg-surface-sunken border rounded-xl p-3 flex-between gap-3">
									<div class="d-flex items-center gap-3">
										<div class="w-9 h-9 rounded-lg bg-surface-raised border flex-center text-brand">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<div class="font-bold text-sm text-primary d-flex items-center gap-1.5">
												<span>{ po.LegalName }</span>
												if string(po.Type) == "vendor" {
													<span class="badge badge-sky text-xs fw-700">مورد</span>
												} else {
													<span class="badge badge-emerald text-xs fw-700">صيدلية</span>
												}
											</div>
											<div class="text-xs text-muted tabular-nums mt-0.5">
												if po.CommercialRegister != "" {
													<span>سجل: { po.CommercialRegister }</span>
												}
												if po.PharmacistLicense != "" {
													<span> â€¢ ترخيص: { po.PharmacistLicense }</span>
												}
											</div>
										</div>
									</div>
									<a href="/admin/approvals"class="btn btn-primary btn-xs fw-800 rounded-md px-3 py-1.5">
										فحص
									</a>
								</div>
							}
						</div>
					}
				</div>

				<!-- Recent Organizations Ecosystem -->
				<div class="admin-banner">
					<div class="flex-between pb-3 border-b mb-3">
						<div>
							<h3 class="text-base font-bold text-primary m-0 d-flex items-center gap-1.5">
								<span>@components.IconBuilding("icon-sm")</span>
								<span>أحدث المنشآت المنضمة للمنظومة</span>
							</h3>
							<p class="text-xs text-secondary mt-0.5 m-0">
								الصيدليات والموردين المسجلين حديثاً في شبكة إمداد دواء 24
							</p>
						</div>
						<a href="/admin/organizations"class="btn btn-secondary btn-xs fw-800 gap-1">
							<span>دليل المنشآت</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>

					if len(stats.RecentOrganizations) == 0 {
						<div class="p-6 text-center bg-surface-sunken rounded-xl text-xs text-muted">
							جاري تحميل بيانات شبكة المنشآت...
						</div>
					} else {
						<div class="d-flex flex-col gap-2">
							for _, ro := range stats.RecentOrganizations {
								<div class="bg-surface-sunken border rounded-xl p-3 flex-between">
									<div class="d-flex items-center gap-3">
										<div class="w-9 h-9 rounded-lg bg-surface-raised border flex-center text-brand">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<div class="font-bold text-sm text-primary d-flex items-center gap-1.5">
												<span>{ ro.LegalName }</span>
												if string(ro.Type) == "vendor" {
													<span class="badge badge-purple text-xs fw-700">مورد أدوية</span>
												} else {
													<span class="badge badge-emerald text-xs fw-700">صيدلية معتمدة</span>
												}
											</div>
											<div class="text-xs text-muted tabular-nums mt-0.5">
												منشأة #{ fmt.Sprintf("%d", ro.ID) } â€¢ { ro.CreatedAt.Format("2006-01-02") }
											</div>
										</div>
									</div>
									<div>
										if string(ro.Status) == "approved" {
											<span class="badge badge-emerald text-xs fw-700">معتمد </span>
										} else if string(ro.Status) == "pending" {
											<span class="badge badge-amber text-xs fw-700">قيد المراجعة</span>
										} else {
											<span class="badge badge-slate text-xs fw-700">{ string(ro.Status) }</span>
										}
									</div>
								</div>
							}
						</div>
					}
				</div>

			</div>

			<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
			     4. EXECUTIVE QUICK ACTION SHORTCUTS
			â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
			<div class="bg-surface-sunken border rounded-2xl p-4">
				<div class="text-xs font-bold text-secondary mb-2">الوصول السريع للأقسام التنفيذية:</div>
				<div class="d-flex gap-2 flex-wrap items-center">
					<a href="/admin/finance"class="btn btn-secondary btn-xs fw-800 gap-1 px-3 py-1.5 rounded-md">
						@components.IconWallet("icon-xs")
						<span>الإدارة المالية والمحافظ</span>
					</a>
					<a href="/admin/approvals"class="btn btn-secondary btn-xs fw-800 gap-1 px-3 py-1.5 rounded-md">
						@components.IconShield("icon-xs")
						<span>اعتماد المنشآت والوثائق</span>
					</a>
					<a href="/admin/orders"class="btn btn-secondary btn-xs fw-800 gap-1 px-3 py-1.5 rounded-md">
						@components.IconTruck("icon-xs")
						<span>أوامر التوريد والشحنات</span>
					</a>
					<a href="/admin/products"class="btn btn-secondary btn-xs fw-800 gap-1 px-3 py-1.5 rounded-md">
						@components.IconPackage("icon-xs")
						<span>كتالوج الأدوية المعتمد</span>
					</a>
					<a href="/admin/plans"class="btn btn-secondary btn-xs fw-800 gap-1 px-3 py-1.5 rounded-md">
						@components.IconTag("icon-xs")
						<span>باقات وخطط الاشتراك</span>
					</a>
					<a href="/admin/users"class="btn btn-secondary btn-xs fw-800 gap-1 px-3 py-1.5 rounded-md">
						@components.IconUsers("icon-xs")
						<span>المستخدمون والحسابات</span>
					</a>
					<a href="/admin/settings"class="btn btn-secondary btn-xs fw-800 gap-1 px-3 py-1.5 rounded-md">
						@components.IconSettings("icon-xs")
						<span>إعدادات النظام العامة</span>
					</a>
				</div>
			</div>

		</div>
	}
}

