package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminDashboardStats struct {
	TotalUsers         int
	TotalOrganizations int
	PendingApprovals   int
	TotalOrders        int
}

templ AdminDashboard(stats AdminDashboardStats, pendingOrgs []*org.Organization, lang, dir string) {
	@layouts.AdminShell("لوحة التحكم والمؤشرات الرئيسية", "dashboard", lang, dir) {
		<div class="page-container">
			<!-- 1. KPI Stats Cards -->
			<div class="dashboard-stat-grid mb-6">
				@components.StatCard(components.StatCardProps{
					Label:    "المستخدمين المسجلين",
					Value:    fmt.Sprintf("%d مستخدم", stats.TotalUsers),
					Subtitle: "صيادلة، مديرو فروع، ومسؤولو توريد",
					Tone:     "neutral",
				})
				@components.StatCard(components.StatCardProps{
					Label:    "المؤسسات والشركات",
					Value:    fmt.Sprintf("%d منشأة", stats.TotalOrganizations),
					Subtitle: "صيدليات مرخصة ومخازن أدوية",
					Tone:     "primary",
				})
				@components.StatCard(components.StatCardProps{
					Label:    "طلبات الاعتماد المعلقة",
					Value:    fmt.Sprintf("%d طلب", stats.PendingApprovals),
					Subtitle: "منشآت جديدة بانتظار مراجعة التراخيص",
					Tone:     "warning",
				})
				@components.StatCard(components.StatCardProps{
					Label:    "إجمالي العمليات والطلبات",
					Value:    fmt.Sprintf("%d طلبية", stats.TotalOrders),
					Subtitle: "أوامر شراء مسجلة عبر المنظومة",
					Tone:     "primary",
				})
			</div>

			<!-- 2. Quick Actions & Management Links -->
			<div class="dashboard-workspace-grid">
				<!-- Approvals & Operations Card -->
				<div class="glass-panel p-6">
					<div class="flex-between mb-4 flex-wrap gap-2">
						<div>
							<h3 class="text-lg font-extrabold text-primary m-0">
								العمليات الرقابية والتحقق
							</h3>
							<p class="text-xs text-muted mt-1 m-0">
								التحقق من التراخيص الصيدلية، السجلات التجارية، وتوثيق الكيانات
							</p>
						</div>

						<a href="/admin/approvals" class="btn btn-primary btn-sm font-bold gap-1">
							<span>عرض قائمة المراجعة</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>
					if len(pendingOrgs) == 0 {
						<div class="d-flex items-center gap-3 p-4 bg-surface-sunken border rounded-xl">
							<div class="user-avatar-badge text-success">
								@components.IconCheck("icon-xs")
							</div>
							<div>
								<div class="font-extrabold text-sm text-primary">تم تدقيق واعتماد كافة تراخيص المنشآت بالكامل</div>
								<div class="text-xs text-muted mt-1">لا توجد طلبات تسجيل أو تراخيص جديدة معلقة بانتظار الفحص حالياً.</div>
							</div>
						</div>
					} else {
						<div class="d-flex flex-col gap-3">
							for _, po := range pendingOrgs {
								<div class="flex-between p-3 bg-surface-sunken border rounded-xl flex-wrap gap-2">
									<div class="d-flex items-center gap-3">
										<div class="user-avatar-badge">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<div class="d-flex items-center gap-2">
												<span class="font-extrabold text-sm text-primary">{ po.LegalName }</span>
												if string(po.Type) == "vendor" {
													<span class="badge badge-sky text-xs">مورد أدوية</span>
												} else {
													<span class="badge badge-emerald text-xs">صيدلية</span>
												}
											</div>
											<div class="text-xs text-muted mt-1 tabular-nums">
												if po.CommercialRegister != "" {
													<span>سجل تجاري: <strong>{ po.CommercialRegister }</strong></span>
												}
												if po.PharmacistLicense != "" {
													<span class="ms-2">• ترخيص: <strong>{ po.PharmacistLicense }</strong></span>
												}
											</div>
										</div>
									</div>
									<div class="d-flex items-center">
										<a href="/admin/approvals" class="btn btn-primary btn-sm font-bold">فحص واعتماد</a>
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- System Health Card -->
				<div class="glass-panel p-6">
					<h3 class="text-lg font-extrabold text-primary m-0 mb-4">
						جاهزية البنية التحتية
					</h3>

					<div class="d-flex flex-col gap-3 mb-6 text-sm">
						<div class="flex-between">
							<span class="text-secondary">قاعدة البيانات PostgreSQL:</span>
							<span class="badge badge-emerald text-xs">متصلة وتعمل بكفاءة</span>
						</div>
						<div class="flex-between">
							<span class="text-secondary">خادم التخزين المؤقت Redis:</span>
							<span class="badge badge-emerald text-xs">يعمل بكفاءة</span>
						</div>
						<div class="flex-between">
							<span class="text-secondary">طوابير المهام River Queue:</span>
							<span class="badge badge-emerald text-xs">معالجة نشطة</span>
						</div>
					</div>

					<a href="/ready" target="_blank" class="btn btn-secondary w-full justify-center font-bold gap-2">
						@components.IconRefresh("icon-xs")
						<span>فحص فوري لنقطة /ready</span>
					</a>
				</div>
			</div>
		</div>
	}
}

