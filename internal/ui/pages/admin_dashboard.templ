package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminDashboardStats struct {
	TotalUsers         int
	TotalOrganizations int
	PendingApprovals   int
	TotalOrders        int
}

templ AdminDashboard(stats AdminDashboardStats, pendingOrgs []*org.Organization, lang, dir string) {
	@layouts.AdminShell("لوحة التحكم والمؤشرات الرئيسية", "dashboard", lang, dir) {
		<div class="stack-lg">
			<!-- 1. KPI Stats Cards -->
			<div class="b2b-metric-grid">
				@components.StatCard(components.StatCardProps{
					Label:    "المستخدمين المسجلين",
					Value:    fmt.Sprintf("%d مستخدم", stats.TotalUsers),
					Subtitle: "صيادلة، مديرو فروع، ومسؤولو توريد",
					Tone:     "neutral",
				})
				@components.StatCard(components.StatCardProps{
					Label:    "المؤسسات والشركات",
					Value:    fmt.Sprintf("%d منشأة", stats.TotalOrganizations),
					Subtitle: "صيدليات مرخصة ومخازن أدوية",
					Tone:     "primary",
				})
				@components.StatCard(components.StatCardProps{
					Label:    "طلبات الاعتماد المعلقة",
					Value:    fmt.Sprintf("%d طلب", stats.PendingApprovals),
					Subtitle: "منشآت جديدة بانتظار مراجعة التراخيص",
					Tone:     "warning",
				})
				@components.StatCard(components.StatCardProps{
					Label:    "إجمالي العمليات والطلبات",
					Value:    fmt.Sprintf("%d طلبية", stats.TotalOrders),
					Subtitle: "أوامر شراء مسجلة عبر المنظومة",
					Tone:     "primary",
				})
			</div>

			<!-- 2. Quick Actions & Management Links -->
			<div style="display:grid; grid-template-columns:2fr 1fr; gap:1.5rem; align-items:start;">
				<!-- Approvals & Operations Card -->
				<div class="card" style="margin-bottom:0; padding:2rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="header-row">
						<div>
							<h3 style="font-size:1.2rem; font-weight:800; color:var(--text); margin:0;">
								العمليات الرقابية والتحقق
							</h3>
							<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.25rem;">
								التحقق من التراخيص الصيدلية، السجلات التجارية، وتوثيق الكيانات
							</p>
						</div>

						<a href="/admin/approvals" class="btn btn-primary btn-sm">
							<span>عرض قائمة المراجعة</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>
					if len(pendingOrgs) == 0 {
						<div style="display:flex; align-items:center; gap:0.75rem; padding:1.25rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg);">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--emerald-50, #ecfdf5); color:var(--emerald-600, #10b981); display:flex; align-items:center; justify-content:center;">
								@components.IconCheck("icon-xs")
							</div>
							<div>
								<div style="font-weight:800; font-size:0.925rem; color:var(--text);">تم تدقيق واعتماد كافة تراخيص المنشآت بالكامل</div>
								<div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.15rem;">لا توجد طلبات تسجيل أو تراخيص جديدة معلقة بانتظار الفحص حالياً.</div>
							</div>
						</div>
					} else {
						<div class="stack">
							for _, po := range pendingOrgs {
								<div style="display:flex; justify-content:space-between; align-items:center; padding:1rem 1.25rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg);">
									<div class="row-center">
										<div class="b2b-icon-box-sm">
											@components.IconBuilding("icon-xs")
										</div>
										<div>
											<div class="row-center-sm">
												<span style="font-weight:800; font-size:0.925rem; color:var(--text);">{ po.LegalName }</span>
												if string(po.Type) == "vendor" {
													<span class="badge badge-sky text-xs">مورد أدوية</span>
												} else {
													<span class="badge badge-emerald text-xs">صيدلية</span>
												}
											</div>
											<div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.15rem;">
												if po.CommercialRegister != "" {
													<span>سجل تجاري: <strong class="tabular-nums">{ po.CommercialRegister }</strong></span>
												}
												if po.PharmacistLicense != "" {
													<span style="margin-inline-start:0.5rem;">• ترخيص: <strong class="tabular-nums">{ po.PharmacistLicense }</strong></span>
												}
											</div>
										</div>
									</div>
									<div class="row-center-sm">
										<a href="/admin/approvals" class="btn btn-primary btn-sm fw-700">فحص واعتماد</a>
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- System Health Card -->
				<div class="card" style="margin-bottom:0; padding:2rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<h3 style="font-size:1.2rem; font-weight:800; color:var(--text); margin-bottom:1.25rem;">
						جاهزية البنية التحتية
					</h3>

					<div style="display:flex; flex-direction:column; gap:1rem; margin-bottom:1.5rem;">
						<div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
							<span class="text-secondary">قاعدة البيانات PostgreSQL:</span>
							<span class="badge badge-emerald">متصلة وتعمل بكفاءة</span>
						</div>
						<div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
							<span class="text-secondary">خادم التخزين المؤقت Redis:</span>
							<span class="badge badge-emerald">يعمل بكفاءة</span>
						</div>
						<div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
							<span class="text-secondary">طوابير المهام River Queue:</span>
							<span class="badge badge-emerald">معالجة نشطة</span>
						</div>
					</div>

					<a href="/ready" target="_blank" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:700;">
						@components.IconRefresh("icon-xs")
						<span>فحص فوري لنقطة /ready</span>
					</a>
				</div>
			</div>
		</div>
	}
}

