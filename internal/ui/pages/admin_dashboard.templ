package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminDashboardStats struct {
	TotalUsers         int
	TotalOrganizations int
	PendingApprovals   int
	TotalOrders        int
}

templ AdminDashboard(stats AdminDashboardStats, lang, dir string) {
	@layouts.AdminShell("Platform Overview", "dashboard", lang, dir) {
		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.5rem; margin-bottom:2rem;">
			<div class="card">
				<span style="font-size:0.875rem; color:var(--neutral-500); font-weight:500;">Total Users</span>
				<div style="font-size:1.875rem; font-weight:700; color:var(--neutral-900); margin-top:0.5rem;">
					{ fmt.Sprintf("%d", stats.TotalUsers) }
				</div>
			</div>
			<div class="card">
				<span style="font-size:0.875rem; color:var(--neutral-500); font-weight:500;">Active Organizations</span>
				<div style="font-size:1.875rem; font-weight:700; color:var(--primary-600); margin-top:0.5rem;">
					{ fmt.Sprintf("%d", stats.TotalOrganizations) }
				</div>
			</div>
			<div class="card">
				<span style="font-size:0.875rem; color:var(--neutral-500); font-weight:500;">Pending Approvals</span>
				<div style="font-size:1.875rem; font-weight:700; color:var(--warning); margin-top:0.5rem;">
					{ fmt.Sprintf("%d", stats.PendingApprovals) }
				</div>
			</div>
			<div class="card">
				<span style="font-size:0.875rem; color:var(--neutral-500); font-weight:500;">Total Orders</span>
				<div style="font-size:1.875rem; font-weight:700; color:var(--info); margin-top:0.5rem;">
					{ fmt.Sprintf("%d", stats.TotalOrders) }
				</div>
			</div>
		</div>

		<div class="card">
			<h2 class="card-title">System Status & Observability</h2>
			<p style="color:var(--neutral-600); font-size:0.875rem; margin-bottom:1rem;">
				PostgreSQL Connection Pool, River Queue Workers, and Redis Session Cache are healthy and operational.
			</p>
			<a href="/ready" target="_blank" class="btn btn-secondary">
				Inspect /ready Status
			</a>
		</div>
	}
}
