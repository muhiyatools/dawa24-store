package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/ingest"
	"github.com/muhiya/dawa24-store/internal/shared/productmatch"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ reviewTableRow(view VendorImportView, row *ingest.RowOutcome) {
	<tr id={ fmt.Sprintf("row-%d", row.ID) } class={ templ.KV("opacity-50", row.IsExcluded) }>
		<!-- Bulk selection -->
		<td class="text-center align-middle">
			<input type="checkbox" name="row_ids" value={ fmt.Sprint(row.ID) }
				form="review-bulk" class="review-pick"
				title="تحديد هذا الصنف للإجراءات الجماعية"/>
		</td>

		<!-- Checkbox Exclude/Include -->
		<td class="text-center align-middle">
			<form class="stack-md" method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/toggle?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }>
				<input type="checkbox" checked?={ !row.IsExcluded } onchange="this.form.submit()"
					title="استيراد هذا الصنف"/>
			</form>
		</td>

		<!-- Row Number -->
		<td class="text-center align-middle tabular-nums text-muted font-bold text-xs">
			{ fmt.Sprint(row.SourceRow) }
		</td>

		<!-- File Product Name (Direct Editable in same cell) -->
		<td class="review-col-name align-middle">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="row-center-xs gap-xs mb-1">
				<input type="text" name="display_name" value={ row.DisplayName }
					class="form-input"
					placeholder="اسم الصنف بالملف..."/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" title="حفظ تعديل الاسم">@components.IconCheck("icon-sm")</button>
			</form>
			<div class="row-center-xs gap-xs flex-wrap">
				if row.SourceCode != "" {
					<span class="badge badge-secondary text-xs">كود: { row.SourceCode }</span>
				}
				if row.Payload != nil && row.Payload.Barcode != "" {
					<span class="badge badge-outline text-xs">باركود: { row.Payload.Barcode }</span>
				}
				if row.Payload != nil && row.Payload.Unit != "" {
					<span class="text-xs text-muted">({ row.Payload.Unit })</span>
				}
			</div>
		</td>

		<!-- Matched Central Catalog Product (with In-Cell Dropdown) -->
		<td class="review-col-catalog align-middle catalog-cell-container">
			<div class="catalog-cell-match">
				if row.ProductID != nil && *row.ProductID > 0 {
					<div class="row-center-xs gap-xs flex-wrap">
						<div class="font-bold text-sm">{ row.MatchedCatalogName() }</div>
						if AIMatchedRow(row) {
							<span class="badge badge-outline text-xs"
								title={ aiRowTitle(row) }>ذكاء اصطناعي</span>
						}
					</div>
					<button type="button"
						data-row-id={ fmt.Sprint(row.ID) }
						data-row-name={ row.DisplayName }
						class="btn btn-ghost btn-xs text-primary font-bold shrink-0"
						onclick="handleDropdownToggle(this)"
						title="تغيير الصنف المربوط بالكتالوج">
						تغيير
					</button>
				} else {
					<div class="stack-2xs">
						<span class="badge badge-rose text-xs">غير مطابق بالكتالوج</span>
						if len(row.Candidates) > 0 {
							<span class="text-xs text-muted truncate max-w-xs">أقرب: { row.Candidates[0].Name }</span>
						}
					</div>
					<button type="button"
						data-row-id={ fmt.Sprint(row.ID) }
						data-row-name={ row.DisplayName }
						class="btn btn-primary btn-xs font-bold shrink-0"
						onclick="handleDropdownToggle(this)"
						title="بحث وربط بالكتالوج المركزي">
						ربط
					</button>
				}
			</div>

			<!-- In-Cell Dropdown Menu (Theme-Aware, Hidden by Default) -->
			<div id={ fmt.Sprintf("catalog-dropdown-%d", row.ID) }
				class="catalog-dropdown-menu"
				data-session-id={ view.Session.PublicID }
				data-filter-match={ view.Filter.MatchLevel }
				data-sort={ view.Filter.SortBy }
				data-order={ view.Filter.SortOrder }
				data-page={ fmt.Sprint(view.Page) }
				data-limit={ fmt.Sprint(view.PerPage) }
				data-search={ view.Filter.Search }>
				
				<div class="catalog-dialog-head">
					<span class="catalog-dialog-title" title={ row.DisplayName }>
						ربط بالكتالوج: { row.DisplayName }
					</span>
					<button type="button" class="btn btn-ghost btn-icon shrink-0"
						aria-label="إغلاق"
						onclick="closeAllCatalogDropdowns()">✕</button>
				</div>

				<div class="catalog-dialog-search">
					<input type="text" placeholder="ابحث بالاسم أو SKU في الكتالوج المركزي..."
						data-row-id={ fmt.Sprint(row.ID) }
						class="form-input"
						oninput="handleDropdownSearchInput(this)"/>
				</div>

				if len(row.Candidates) > 0 {
					<div class="review-suggestions">
						<div class="text-xs fw-800 mb-1 text-primary">اقتراحات المطابقة</div>
						for _, c := range row.Candidates {
							<form class="stack-md" method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/match?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }>
								<input type="hidden" name="product_id" value={ fmt.Sprint(c.ProductID) }/>
								<button type="submit" class="review-suggestion" title={ c.Reason }>
									<span class={ "badge text-xs fw-800", matchScoreBadgeTone(c.Score) }>
										{ PercentText(c.Score) }
									</span>
									<span class="review-suggestion-name">{ c.Name }</span>
									if c.Concentration != "" || c.DosageForm != "" {
										<span class="review-suggestion-meta">{ c.Concentration } { c.DosageForm }</span>
									}
								</button>
							</form>
						}
					</div>
				}

				<div class="catalog-dropdown-results" id={ fmt.Sprintf("dropdown-results-%d", row.ID) }>
					<div class="text-center text-muted p-sm text-xs">اكتب للبحث في الكتالوج المركزي…</div>
				</div>

				if row.ProductID != nil && *row.ProductID > 0 {
					<div class="mt-2 pt-2 border-t">
						<form class="stack-md" method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/match?product_id=0&match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }>
							<button type="submit" class="btn btn-ghost btn-xs text-danger w-100 text-start">
								إلغاء الربط (جعله غير مطابق)
							</button>
						</form>
					</div>
				}
			</div>
		</td>

		<!-- Match Score / Degree -->
		<td class="review-col-score text-center align-middle">
			if row.ProductID != nil && *row.ProductID > 0 && row.IsManuallyMatched {
				<span class="badge badge-emerald text-xs fw-800" title="تمت المطابقة يدوياً بواسطة المستخدم">100% (يدوي)</span>
			} else if row.ProductID != nil && *row.ProductID > 0 {
				<span class={ "badge text-xs fw-800", matchScoreBadgeTone(row.MatchScore) } title={ matchLevelText(row.MatchLevel) }>
					{ PercentText(row.MatchScore) }
				</span>
			} else if len(row.Candidates) > 0 {
				<span class={ "badge text-xs font-bold", matchScoreBadgeTone(row.Candidates[0].Score) } title="أقرب مرشح غير محسوم">
					{ PercentText(row.Candidates[0].Score) }
				</span>
			} else {
				<span class="badge badge-rose text-xs">0%</span>
			}
			if !reviewRowWillImport(row) {
				<div class="text-xs text-muted mt-1">لن يُستورد</div>
			}
		</td>

		<!-- Public Price (سعر الجمهور - Editable Inline) -->
		<td class="review-col-money text-center align-middle tabular-nums">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="review-money-form">
				<input type="hidden" name="display_name" value={ row.DisplayName }/>
				if row.Payload != nil && row.Payload.HasQuantity {
					<input type="hidden" name="quantity" value={ fmt.Sprint(row.Payload.Quantity) }/>
				}
				<input type="number" name="price"
					value={ rowPriceValue(row) }
					step="0.01"
					min="0"
					placeholder="0.00"
					class="form-input text-center tabular-nums font-bold"
					title="تعديل سعر الجمهور"/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" title="حفظ سعر الجمهور">@components.IconCheck("icon-sm")</button>
			</form>
		</td>

		<!-- Discount Percentage % (نسبة الخصم - Editable Inline) -->
		<td class="review-col-money text-center align-middle tabular-nums">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="review-money-form">
				<input type="hidden" name="display_name" value={ row.DisplayName }/>
				<input type="number" name="discount"
					value={ rowDiscountPercentValue(row) }
					step="0.1"
					min="0"
					max="100"
					placeholder="0.0"
					class="form-input text-center tabular-nums font-bold"
					title="تعديل نسبة الخصم %"/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" title="حفظ نسبة الخصم">@components.IconCheck("icon-sm")</button>
			</form>
		</td>

		<!-- Net Price (السعر بعد الخصم) -->
		<td class="review-col-money text-center align-middle tabular-nums">
			<span class="fw-800 text-primary">
				{ rowNetPriceValue(row) } <span>ج.م</span>
			</span>
		</td>

		<!-- Quantity (Editable Inline) -->
		<td class="review-col-qty text-center align-middle tabular-nums">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/ingest/%s/rows/%d/update?match=%s&sort=%s&order=%s&page=%d&limit=%d&q=%s", view.Session.PublicID, row.ID, view.Filter.MatchLevel, view.Filter.SortBy, view.Filter.SortOrder, view.Page, view.PerPage, view.Filter.Search)) }
				class="review-money-form">
				<input type="hidden" name="display_name" value={ row.DisplayName }/>
				if row.Payload != nil && (row.Payload.NetPrice.IsPositive() || row.Payload.PublicPrice.IsPositive()) {
					if row.Payload.NetPrice.IsPositive() {
						<input type="hidden" name="price" value={ row.Payload.NetPrice.String() }/>
					} else {
						<input type="hidden" name="price" value={ row.Payload.PublicPrice.String() }/>
					}
				}
				<input type="number" name="quantity"
					value={ rowQuantityValue(row) }
					step="1"
					min="0"
					placeholder="0"
					class="form-input text-center tabular-nums font-bold"
					title="تعديل أو إدخال الكمية يدوياً"/>
				<button type="submit" class="btn btn-secondary btn-sm px-2" title="حفظ الكمية">@components.IconCheck("icon-sm")</button>
			</form>
		</td>
	</tr>
}

func rowQuantityValue(row *ingest.RowOutcome) string {
	if row != nil && row.Payload != nil && row.Payload.HasQuantity {
		return fmt.Sprint(row.Payload.Quantity)
	}
	return ""
}

// rowPriceValue is the public price shown in the "سعر الجمهور" column.
func rowPriceValue(row *ingest.RowOutcome) string {
	if row != nil && row.Payload != nil {
		if row.Payload.PublicPrice.IsPositive() {
			return row.Payload.PublicPrice.String()
		}
		if row.Payload.NetPrice.IsPositive() {
			return row.Payload.NetPrice.String()
		}
	}
	return ""
}

// rowDiscountPercentValue derives the discount percentage.
func rowDiscountPercentValue(row *ingest.RowOutcome) string {
	if row == nil || row.Payload == nil {
		return "0.0"
	}
	if row.Payload.DiscountBps > 0 {
		return fmt.Sprintf("%.1f", float64(row.Payload.DiscountBps)/100.0)
	}
	list := row.Payload.PublicPrice
	net := row.Payload.NetPrice
	if list.IsPositive() && net.IsPositive() && net.Minor() < list.Minor() {
		pct := (1.0 - float64(net.Minor())/float64(list.Minor())) * 100.0
		return fmt.Sprintf("%.1f", pct)
	}
	return "0.0"
}

// rowNetPriceValue calculates the price after discount.
func rowNetPriceValue(row *ingest.RowOutcome) string {
	if row == nil || row.Payload == nil {
		return "0.00"
	}
	if row.Payload.NetPrice.IsPositive() {
		return row.Payload.NetPrice.String()
	}
	list := row.Payload.PublicPrice
	if list.IsPositive() {
		if row.Payload.DiscountBps > 0 {
			net := list.ApplyPercent(10000 - row.Payload.DiscountBps)
			return net.String()
		}
		return list.String()
	}
	return "0.00"
}

// reviewRowWillImport reports whether the commit would write this row.
func reviewRowWillImport(row *ingest.RowOutcome) bool {
	if row == nil || row.IsExcluded || row.ProductID == nil || *row.ProductID <= 0 {
		return false
	}
	if row.IsManuallyMatched {
		return true
	}
	return productmatch.MatchLevel(row.MatchLevel).Settled()
}