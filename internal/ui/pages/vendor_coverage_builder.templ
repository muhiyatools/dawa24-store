package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorCoverageBuilder(data VendorCoverageData, lang string) {
	<!-- Interactive Coverage Builder (The Core Enhancement) -->
	<div id="builder-section" class="glass-panel p-6 mb-6">
		<div class="flex-between items-center mb-6 pb-4 border-b">
			<div class="stack-sm">
				<h2 class="text-lg font-black text-primary m-0 d-flex items-center gap-2">
					<span>@components.IconGlobe("icon-sm")</span>
					<span>{ i18n.T(lang, "vendor_coverage.builder.title") }</span>
				</h2>
				<p class="text-xs text-muted mt-1 m-0">
					{ i18n.T(lang, "vendor_coverage.builder.desc") }
				</p>
			</div>
		</div>

		<form method="POST" action="/vendor/coverage" class="d-flex flex-col gap-6">
			<!-- CSRF & Hidden Inputs -->
			<input type="hidden" name="gorilla.csrf.Token" value=""/>

			<!-- Step 1: Branch Selection & Governorate Selection -->
			<div class="d-grid grid-auto-fit-md gap-4">
				<div class="stack-sm">
					<label class="d-block text-xs font-bold mb-2 text-primary">
						{ i18n.T(lang, "vendor_coverage.builder.branch_lbl") } <span class="text-danger">*</span>
					</label>
					<select name="branch_id" class="form-control" required>
						for _, b := range data.Branches {
							<option value={ fmt.Sprintf("%d", b.ID) }>
								{ b.Name.Get(i18n.Lang(lang)) }
								if b.IsMain {
									{ " " + i18n.T(lang, "vendor_coverage.builder.main_branch_suffix") }
								}
							</option>
						}
						if len(data.Branches) == 0 {
							<option value="1">{ i18n.T(lang, "vendor_coverage.builder.default_branch_opt") }</option>
						}
					</select>
				</div>

				<div class="stack-sm">
					<label class="d-block text-xs font-bold mb-2 text-primary">
						{ i18n.T(lang, "vendor_coverage.builder.gov_lbl") } <span class="text-danger">*</span>
					</label>
					<select name="governorate_id" x-model="selectedGovId" @change="onGovChange()" class="form-control font-bold" required>
						<option value="">{ i18n.T(lang, "vendor_coverage.builder.gov_ph") }</option>
						for _, g := range data.Governorates {
							<option value={ fmt.Sprintf("%d", g.ID) }>
								{ func() string {
									if g.Name != nil {
										return g.Name.Get(i18n.Lang(lang))
									}
									return fmt.Sprintf(i18n.T(lang, "vendor_coverage.builder.gov_fallback"), g.ID)
								}() }
							</option>
						}
					</select>
				</div>
			</div>

			<!-- Step 2: Multi-Days Selector -->
			<div class="bg-surface-sunken p-5 rounded-xl border">
				<div class="flex-between items-center mb-3 flex-wrap gap-2">
					<label class="text-sm font-bold m-0 text-primary d-flex items-center gap-2">
						<span>@components.IconClock("icon-sm")</span>
						<span>{ i18n.T(lang, "vendor_coverage.builder.days_lbl") }</span>
						<span class="text-danger">*</span>
					</label>
					<div class="d-flex gap-2">
						<button type="button" @click="selectAllDays()" class="btn btn-xs btn-secondary">
							{ i18n.T(lang, "vendor_coverage.builder.select_all_days") }
						</button>
						<button type="button" @click="clearDays()" class="btn btn-xs btn-secondary">
							{ i18n.T(lang, "vendor_coverage.builder.clear_days") }
						</button>
					</div>
				</div>

				<div class="d-grid grid-auto-fit-xs gap-2">
					<!-- Saturday (6) -->
					<label :class="{ 'is-active': selectedDays.includes(6) }" class="day-pill-toggle">
						<input type="checkbox" name="days_of_week" value="6" :checked="selectedDays.includes(6)" @change="toggleDay(6)" class="d-none"/>
						<span>{ i18n.T(lang, "vendor_coverage.builder.day_sat") }</span>
						<span x-show="selectedDays.includes(6)" class="text-xs">@components.IconCheck("icon-sm")</span>
					</label>

					<!-- Sunday (0) -->
					<label :class="{ 'is-active': selectedDays.includes(0) }" class="day-pill-toggle">
						<input type="checkbox" name="days_of_week" value="0" :checked="selectedDays.includes(0)" @change="toggleDay(0)" class="d-none"/>
						<span>{ i18n.T(lang, "vendor_coverage.builder.day_sun") }</span>
						<span x-show="selectedDays.includes(0)" class="text-xs">@components.IconCheck("icon-sm")</span>
					</label>

					<!-- Monday (1) -->
					<label :class="{ 'is-active': selectedDays.includes(1) }" class="day-pill-toggle">
						<input type="checkbox" name="days_of_week" value="1" :checked="selectedDays.includes(1)" @change="toggleDay(1)" class="d-none"/>
						<span>{ i18n.T(lang, "vendor_coverage.builder.day_mon") }</span>
						<span x-show="selectedDays.includes(1)" class="text-xs">@components.IconCheck("icon-sm")</span>
					</label>

					<!-- Tuesday (2) -->
					<label :class="{ 'is-active': selectedDays.includes(2) }" class="day-pill-toggle">
						<input type="checkbox" name="days_of_week" value="2" :checked="selectedDays.includes(2)" @change="toggleDay(2)" class="d-none"/>
						<span>{ i18n.T(lang, "vendor_coverage.builder.day_tue") }</span>
						<span x-show="selectedDays.includes(2)" class="text-xs">@components.IconCheck("icon-sm")</span>
					</label>

					<!-- Wednesday (3) -->
					<label :class="{ 'is-active': selectedDays.includes(3) }" class="day-pill-toggle">
						<input type="checkbox" name="days_of_week" value="3" :checked="selectedDays.includes(3)" @change="toggleDay(3)" class="d-none"/>
						<span>{ i18n.T(lang, "vendor_coverage.builder.day_wed") }</span>
						<span x-show="selectedDays.includes(3)" class="text-xs">@components.IconCheck("icon-sm")</span>
					</label>

					<!-- Thursday (4) -->
					<label :class="{ 'is-active': selectedDays.includes(4) }" class="day-pill-toggle">
						<input type="checkbox" name="days_of_week" value="4" :checked="selectedDays.includes(4)" @change="toggleDay(4)" class="d-none"/>
						<span>{ i18n.T(lang, "vendor_coverage.builder.day_thu") }</span>
						<span x-show="selectedDays.includes(4)" class="text-xs">@components.IconCheck("icon-sm")</span>
					</label>

					<!-- Friday (5) -->
					<label :class="{ 'is-active': selectedDays.includes(5) }" class="day-pill-toggle">
						<input type="checkbox" name="days_of_week" value="5" :checked="selectedDays.includes(5)" @change="toggleDay(5)" class="d-none"/>
						<span>{ i18n.T(lang, "vendor_coverage.builder.day_fri") }</span>
						<span x-show="selectedDays.includes(5)" class="text-xs">@components.IconCheck("icon-sm")</span>
					</label>
				</div>
			</div>

			<!-- Step 3: Subgovernorates / Cities Selection (Dynamic) -->
			<div x-show="selectedGovId" class="bg-surface-sunken p-5 rounded-xl border d-flex flex-col gap-3">
				<div class="flex-between flex-wrap gap-3">
					<div class="stack-sm">
						<label class="text-sm font-extrabold m-0 text-primary d-flex items-center gap-2">
							<span>@components.IconBuilding("icon-sm")</span>
							<span>{ i18n.T(lang, "vendor_coverage.builder.cities_lbl") }</span>
							<span class="badge badge-primary text-xs" x-text="selectedCities.length + (window.__DAWA_LANG__ === 'en' ? ' cities selected' : ' مدينة محددة')"></span>
						</label>
					</div>

					<div class="d-flex items-center gap-3">
						<input type="text" x-model="citySearch" placeholder={ i18n.T(lang, "vendor_coverage.builder.city_search_ph") } class="form-control text-xs w-48 rounded-lg"/>
						
						<button type="button" @click="toggleSelectAllCities()" class="btn btn-sm btn-primary font-bold text-xs rounded-lg">
							<span x-text="allCitiesInGov ? (window.__DAWA_LANG__ === 'en' ? 'Deselect all cities' : 'إلغاء تحديد كل المدن') : (window.__DAWA_LANG__ === 'en' ? 'Select all cities in governorate' : 'تحديد كل مدن المحافظة')"></span>
						</button>
					</div>
				</div>

				<!-- Hidden input for all_cities_in_gov -->
				<input type="hidden" name="all_cities_in_gov" :value="allCitiesInGov ? 'true' : 'false'"/>

				<!-- Grid of cities under governorate -->
				<div class="d-grid grid-auto-fit-sm gap-2 max-h-56 overflow-y-auto p-2 bg-surface rounded-lg border">
					<template x-for="c in filteredCities" :key="c.id">
						<label :class="selectedCities.includes(String(c.id)) ? 'badge-primary' : 'bg-surface-sunken'" class="p-2 rounded-lg border d-flex items-center gap-2 cursor-pointer transition">
							<input type="checkbox" name="city_ids" :value="c.id" :checked="selectedCities.includes(String(c.id))" @change="toggleCity(c.id)" class="w-4 h-4 cursor-pointer"/>
							<div class="flex-1 min-w-0">
								<div class="font-bold text-sm text-primary" x-text="window.__DAWA_LANG__ === 'en' ? (c.name_en || c.name_ar) : c.name_ar"></div>
								<div class="text-xs text-muted" x-text="window.__DAWA_LANG__ === 'en' ? c.name_ar : c.name_en"></div>
							</div>
							<span class="badge badge-slate badge-compact" x-text="((c.radius_m || 0) / 1000).toFixed(1) + (window.__DAWA_LANG__ === 'en' ? ' km' : ' كم')"></span>
							<span x-show="c.is_capital" class="badge badge-amber badge-compact">{ i18n.T(lang, "vendor_coverage.builder.capital_badge") }</span>
						</label>
					</template>
					<div x-show="filteredCities.length === 0" class="text-center py-6 text-muted text-xs col-span-full">
						{ i18n.T(lang, "vendor_coverage.builder.no_cities_found") }
					</div>
				</div>
			</div>

			<!-- Step 4: Delivery hours -->
			<div class="d-grid grid-auto-fit-md gap-4">
				<!-- Time Window -->
				<div class="bg-surface-sunken p-5 rounded-xl border">
					<label class="d-block text-xs font-bold mb-2 text-primary">
						{ i18n.T(lang, "vendor_coverage.builder.hours_lbl") }
					</label>
					<div class="d-grid grid-cols-2 gap-3 mb-2">
						<div class="stack-sm">
							<span class="text-xs text-muted font-semibold d-block mb-1">{ i18n.T(lang, "vendor_coverage.builder.from_time_lbl") }</span>
							<input type="time" name="coverage_from" x-model="coverageFrom" class="form-control text-xs"/>
						</div>
						<div class="stack-sm">
							<span class="text-xs text-muted font-semibold d-block mb-1">{ i18n.T(lang, "vendor_coverage.builder.to_time_lbl") }</span>
							<input type="time" name="coverage_to" x-model="coverageTo" class="form-control text-xs"/>
						</div>
					</div>

					<!-- 12-hour readout of the chosen window -->
					<div class="d-flex items-center gap-2 mb-3 text-xs">
						<span class="text-muted font-semibold">{ i18n.T(lang, "vendor_coverage.builder.egypt_time_lbl") }</span>
						<span class="badge badge-primary font-bold" x-text="coverageWindowLabel()"></span>
					</div>

					<!-- Time Presets -->
					<div class="d-flex flex-wrap gap-1">
						<button type="button" @click="setTimePreset('09:00', '17:00')" class="btn btn-2xs btn-secondary">{ i18n.T(lang, "vendor_coverage.builder.preset_full") }</button>
						<button type="button" @click="setTimePreset('16:00', '23:00')" class="btn btn-2xs btn-secondary">{ i18n.T(lang, "vendor_coverage.builder.preset_evening") }</button>
						<button type="button" @click="setTimePreset('', '')" class="btn btn-2xs btn-secondary">{ i18n.T(lang, "vendor_coverage.builder.preset_24h") }</button>
					</div>
				</div>
			</div>

			<!-- Step 5: Per-city delivery hours -->
			<div x-show="selectedCities.length > 0" class="bg-surface-sunken p-5 rounded-xl border d-flex flex-col gap-4">
				<div class="flex-between items-center flex-wrap gap-3">
					<div class="stack-sm">
						<h3 class="text-sm font-extrabold text-primary m-0 d-flex items-center gap-2">
							<span>⏱️</span>
							<span>{ i18n.T(lang, "vendor_coverage.builder.per_city_title") }</span>
						</h3>
						<p class="text-xs text-muted m-0 mt-1">
							{ i18n.T(lang, "vendor_coverage.builder.per_city_desc") }
						</p>
					</div>
					<button type="button" @click="applyDefaultsToAllCities()" class="btn btn-xs btn-secondary font-bold">
						{ i18n.T(lang, "vendor_coverage.builder.apply_to_all") }
					</button>
				</div>

				<div class="d-grid grid-auto-fit-md gap-3">
					<template x-for="c in getSelectedCityDetails()" :key="c.id">
						<div class="bg-surface-raised p-4 rounded-xl border d-flex flex-col gap-3 shadow-xs">
							<div class="flex-between items-start">
								<div class="stack-sm">
									<div class="font-extrabold text-sm text-brand" x-text="window.__DAWA_LANG__ === 'en' ? (c.name_en || c.name_ar) : c.name_ar"></div>
									<div class="text-xs text-muted" x-text="(window.__DAWA_LANG__ === 'en' ? c.name_ar : c.name_en) + (c.lat ? ' (' + c.lat.toFixed(4) + ', ' + c.lon.toFixed(4) + ')' : '')"></div>
								</div>
								<button type="button" @click="toggleCity(c.id)" class="btn btn-icon btn-2xs text-danger" title="إزالة هذه المدينة">@components.IconX("icon-sm")</button>
							</div>

							<div class="d-grid grid-cols-2 gap-2">
								<div class="stack-sm">
									<label class="d-block text-xs font-semibold text-muted mb-1">{ i18n.T(lang, "vendor_coverage.builder.from_time_lbl") }</label>
									<input type="time" :name="'coverage_from_' + c.id" x-model="initCityConfig(String(c.id)).from" class="form-control text-xs"/>
								</div>
								<div class="stack-sm">
									<label class="d-block text-xs font-semibold text-muted mb-1">{ i18n.T(lang, "vendor_coverage.builder.to_time_lbl") }</label>
									<input type="time" :name="'coverage_to_' + c.id" x-model="initCityConfig(String(c.id)).to" class="form-control text-xs"/>
								</div>
							</div>

							<div class="stack-sm">
								<label class="d-block text-xs font-semibold text-muted mb-1">{ i18n.T(lang, "vendor_coverage.modals.approved_radius") }:</label>
								<div class="d-flex items-center gap-2">
									<span class="badge badge-primary text-xs" x-text="((c.radius_m || 0) / 1000).toFixed(1) + ' ' + (window.__DAWA_LANG__ === 'en' ? 'km from city center' : 'كم من مركز المدينة')"></span>
									<span class="text-xs text-muted">{ i18n.T(lang, "vendor_coverage.builder.applied_auto") }</span>
								</div>
							</div>
						</div>
					</template>
				</div>
			</div>

			<!-- Live Impact Summary & Submit Button -->
			<div class="glass-panel p-5 flex-between items-center flex-wrap gap-4 border">
				<div class="d-flex items-center gap-3">
					<span class="text-2xl">@components.IconZap("icon-sm")</span>
					<div class="stack-sm">
						<div class="font-extrabold text-primary text-sm">
							{ i18n.T(lang, "vendor_coverage.builder.summary_title") }
							<span x-text="selectedDays.length" class="text-brand"></span> { i18n.T(lang, "vendor_coverage.builder.days_lbl") } ×
							<span x-text="selectedCities.length > 0 ? selectedCities.length : '1'" class="text-brand"></span> =
							<span class="text-brand font-black" x-text="(selectedDays.length * (selectedCities.length > 0 ? selectedCities.length : 1)) + (window.__DAWA_LANG__ === 'en' ? ' weekly coverage zones' : ' نطاق تغطية أسبوعية')"></span>
						</div>
						<div class="text-xs text-secondary mt-1">
							{ i18n.T(lang, "vendor_coverage.builder.summary_desc") }
						</div>
					</div>
				</div>

				<button type="submit" :disabled="selectedDays.length === 0 || !selectedGovId" class="btn btn-primary px-8 font-extrabold text-sm shadow-md">
					<span>{ i18n.T(lang, "vendor_coverage.builder.btn_submit") }</span>
					<span>←</span>
				</button>
			</div>
		</form>
	</div>
}