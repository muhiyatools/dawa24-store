package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func isStepDone(status commerce.OrderStatus, step int) bool {
	switch step {
	case 1:
		return true
	case 2:
		return status == commerce.StatusConfirmed || status == commerce.StatusProcessing || status == commerce.StatusShipped || status == commerce.StatusInTransit || status == commerce.StatusOutForDelivery || status == commerce.StatusDelivered || status == commerce.StatusCompleted
	case 3:
		return status == commerce.StatusShipped || status == commerce.StatusInTransit || status == commerce.StatusOutForDelivery || status == commerce.StatusDelivered || status == commerce.StatusCompleted
	case 4:
		return status == commerce.StatusDelivered || status == commerce.StatusCompleted
	default:
		return false
	}
}

func isStepActive(status commerce.OrderStatus, step int) bool {
	switch step {
	case 1:
		return status == commerce.StatusPending
	case 2:
		return status == commerce.StatusConfirmed || status == commerce.StatusProcessing
	case 3:
		return status == commerce.StatusShipped || status == commerce.StatusInTransit || status == commerce.StatusOutForDelivery
	case 4:
		return status == commerce.StatusDelivered || status == commerce.StatusCompleted
	default:
		return false
	}
}

func orderProgressWidth(status commerce.OrderStatus) string {
	switch status {
	case commerce.StatusPending:
		return "10%"
	case commerce.StatusConfirmed, commerce.StatusProcessing:
		return "40%"
	case commerce.StatusShipped, commerce.StatusInTransit, commerce.StatusOutForDelivery:
		return "75%"
	case commerce.StatusDelivered, commerce.StatusCompleted:
		return "100%"
	default:
		return "10%"
	}
}

func getAllOrderLines(order *commerce.Order) []*commerce.OrderLine {
	if order == nil {
		return nil
	}
	if len(order.Lines) > 0 {
		return order.Lines
	}
	var res []*commerce.OrderLine
	for _, sh := range order.Shipments {
		if sh != nil {
			res = append(res, sh.Lines...)
		}
	}
	return res
}

templ CustomerOrderDetail(order *commerce.Order, history []*commerce.OrderStatusHistory, noticeType, noticeMsg, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("طلب توريد #%s", order.OrderNumber), "orders", lang, dir, nil) {
		<div class="order-detail-page" style="max-width:100%;">
			
			<!-- Notice Feedback Banner -->
			if noticeMsg != "" {
				if noticeType == "error" {
					<div class="alert alert-danger" style="display:flex; align-items:center; gap:0.75rem; padding:1rem 1.25rem; border-radius:var(--radius-xl); background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:var(--rose); font-weight:700; margin-bottom:1.25rem;">
						<span style="font-size:1.25rem;">⚠️</span>
						<span>{ noticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success" style="display:flex; align-items:center; gap:0.75rem; padding:1rem 1.25rem; border-radius:var(--radius-xl); background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.3); color:var(--emerald); font-weight:700; margin-bottom:1.25rem;">
						<span style="font-size:1.25rem;">✅</span>
						<span>{ noticeMsg }</span>
					</div>
				}
			}

			<!-- Breadcrumb & Quick Actions Header -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem;">
				<div>
					<nav style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--text-muted); margin-bottom:0.4rem;">
						<a href="/" style="color:var(--text-secondary); text-decoration:none;">الرئيسية</a>
						<span>/</span>
						<a href="/orders" style="color:var(--text-secondary); text-decoration:none;">طلبياتي</a>
						<span>/</span>
						<span style="color:var(--text); font-weight:700;">طلب #{ order.OrderNumber }</span>
					</nav>
					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<h1 style="font-size:1.6rem; font-weight:900; color:var(--text); margin:0;" class="tabular-nums">
							طلب توريد #{ order.OrderNumber }
						</h1>
						@components.StatusBadge(string(order.Status))
						if order.PaymentStatus == commerce.PaymentPaid {
							<span class="badge badge-emerald text-xs fw-700">مدفوع بالكامل</span>
						} else {
							<span class="badge badge-amber text-xs fw-700">دفع عند الاستلام</span>
						}
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
					<a href="/orders" class="btn btn-secondary btn-sm" style="font-weight:700;">
						<span>← العودة لطلبياتي</span>
					</a>
					if order.Status != commerce.StatusPending {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", order.ID)) }
							target="_blank"
							class="btn btn-primary btn-sm"
							style="font-weight:700; gap:0.4rem; padding:0.5rem 1rem; border-radius:var(--radius-md);"
							title="طباعة الفاتورة أو إيصال الكاشير"
						>
							@components.IconPrinter("icon-xs")
							<span>طباعة الفاتورة</span>
						</a>
					}
				</div>
			</div>

			<!-- Main 2-Column Responsive Grid -->
			<div style="display:grid; grid-template-columns:minmax(0, 2fr) minmax(0, 1fr); gap:1.5rem; align-items:start;">
				
				<!-- Right Column: Primary Details -->
				<div style="display:flex; flex-direction:column; gap:1.5rem;">
					
					<!-- 1. Order Progress Timeline Card -->
					<div class="card" style="margin:0; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border); background:var(--surface); box-shadow:var(--shadow-xs);">
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.75rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
							<div class="row-center-sm">
								<span style="font-size:1.1rem;">🚚</span>
								<h2 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0;">
									مسار ومراحل التوريد
								</h2>
							</div>
							<span class="text-xs text-muted tabular-nums">
								تاريخ الطلب: { order.CreatedAt.Format("2006-01-02 15:04") }
							</span>
						</div>

						<!-- Steps Progress Bar -->
						<div style="position:relative; display:flex; justify-content:space-between; align-items:flex-start; margin:0 auto; padding-inline:0.5rem;">
							<!-- Connecting track -->
							<div style="position:absolute; top:18px; inset-inline-start:2.5rem; inset-inline-end:2.5rem; height:4px; background:var(--neutral-100); z-index:1; border-radius:2px;">
								<div style={ "height:100%; background:var(--accent); border-radius:2px; transition:width 0.4s ease; width:" + orderProgressWidth(order.Status) + ";" }></div>
							</div>

							<!-- Step 1: Placed -->
							<div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; text-align:center; flex:1;">
								<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--accent); color:#ffffff; display:flex; align-items:center; justify-content:center; margin-bottom:0.5rem; font-size:0.875rem; font-weight:800;">
									✓
								</div>
								<div style="font-weight:800; font-size:0.875rem; color:var(--text);">تم استلام الطلب</div>
								<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;" class="tabular-nums">
									{ order.CreatedAt.Format("15:04") }
								</div>
							</div>

							<!-- Step 2: Processing -->
							<div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; text-align:center; flex:1;">
								if isStepDone(order.Status, 2) {
									<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--accent); color:#ffffff; display:flex; align-items:center; justify-content:center; margin-bottom:0.5rem; font-size:0.875rem; font-weight:800;">
										✓
									</div>
								} else {
									<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--surface-sunken); border:2px solid var(--border); color:var(--text-muted); display:flex; align-items:center; justify-content:center; margin-bottom:0.5rem; font-size:0.875rem;">
										📦
									</div>
								}
								<div style="font-weight:800; font-size:0.875rem; color:var(--text);">التجهيز المخزني</div>
								<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;">فحص التشغيلات والتبريد</div>
							</div>

							<!-- Step 3: Out for Delivery -->
							<div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; text-align:center; flex:1;">
								if isStepDone(order.Status, 3) {
									<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--accent); color:#ffffff; display:flex; align-items:center; justify-content:center; margin-bottom:0.5rem; font-size:0.875rem; font-weight:800;">
										✓
									</div>
								} else {
									<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--surface-sunken); border:2px solid var(--border); color:var(--text-muted); display:flex; align-items:center; justify-content:center; margin-bottom:0.5rem; font-size:0.875rem;">
										🚚
									</div>
								}
								<div style="font-weight:800; font-size:0.875rem; color:var(--text);">الشحن والتوصيل</div>
								<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;">مع المندوب المبرد</div>
							</div>

							<!-- Step 4: Delivered -->
							<div style="position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; text-align:center; flex:1;">
								if isStepDone(order.Status, 4) {
									<div style="width:36px; height:36px; border-radius:var(--radius-full); background:#10b981; color:#ffffff; display:flex; align-items:center; justify-content:center; margin-bottom:0.5rem; font-size:0.875rem; font-weight:800;">
										✓
									</div>
								} else {
									<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--surface-sunken); border:2px solid var(--border); color:var(--text-muted); display:flex; align-items:center; justify-content:center; margin-bottom:0.5rem; font-size:0.875rem;">
										🏥
									</div>
								}
								<div style="font-weight:800; font-size:0.875rem; color:var(--text);">تم الاستلام</div>
								<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;">تسليم الصيدلية الموثق</div>
							</div>
						</div>
					</div>

					<!-- 2. Shipments & Line Items Table Card -->
					<div class="card" style="margin:0; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border); background:var(--surface); box-shadow:var(--shadow-xs);">
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
							<div class="row-center-sm">
								<span style="font-size:1.1rem;">💊</span>
								<h2 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0;">
									الأصناف والشحنات الدوائية المطلوبة
								</h2>
							</div>
							<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
								if order.Status == commerce.StatusPending {
									<span class="badge badge-amber text-xs fw-800" style="padding:0.35rem 0.75rem; gap:0.35rem;">
										<span>✏️ تعديل الكميات متاح مباشرة (قيد المراجعة)</span>
									</span>
								} else {
									<span class="badge badge-slate text-xs fw-700" style="padding:0.35rem 0.75rem; gap:0.35rem;" title="لا يمكن تعديل الطلب بعد قبوله أو معالجته من المورد">
										<span>🔒 الطلب مؤكد من المورد ولا يمكن تعديله</span>
									</span>
								}
								<span class="badge badge-sky text-xs fw-700">
									<span>نقل دوائي مبرد معتمد (2-8°C)</span>
								</span>
							</div>
						</div>

						if len(order.Shipments) == 0 && len(order.Lines) == 0 {
							@components.EmptyState(components.EmptyStateProps{
								Title:   "جاري تجهيز الشحنات",
								Message: "يقوم الموردون حالياً بتجهيز تفاصيل الشحن وأرقام التشغيلات.",
							})
						} else {
							<!-- Direct & Editable Order Lines Form -->
							if order.Status == commerce.StatusPending {
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orders/%d/edit", order.ID)) } id="main-order-lines-form">
									if len(order.Shipments) > 0 {
										<!-- Grouped by Shipment / Vendor -->
										<div style="display:flex; flex-direction:column; gap:1.25rem;">
											for idx, sh := range order.Shipments {
												<div style="border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-sunken); overflow:hidden;">
													<!-- Shipment Header -->
													<div style="display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1.15rem; background:var(--surface-raised); border-bottom:1px solid var(--border); flex-wrap:wrap; gap:0.75rem;">
														<div style="display:flex; align-items:center; gap:0.6rem;">
															<span class="badge badge-primary text-xs fw-800 tabular-nums">طرد { fmt.Sprintf("%d", idx+1) }</span>
															<strong style="font-size:0.95rem; color:var(--text); font-weight:800;">
																{ sh.VendorName.Get(i18n.Lang(lang)) }
															</strong>
															<span style="font-size:0.75rem; color:var(--text-muted); margin-inline-start:0.25rem;">
																(رقم الشحنة: <span class="tabular-nums font-mono">{ sh.ShipmentNumber }</span>)
															</span>
														</div>
														<div style="display:flex; align-items:center; gap:0.5rem;">
															if sh.TrackingNumber != "" {
																<span class="badge badge-slate text-xs font-mono">بوليصة: { sh.TrackingNumber }</span>
															}
															@components.StatusBadge(string(sh.Status))
														</div>
													</div>

													<!-- Shipment Lines Table -->
													<div class="table-container" style="padding:0; margin:0; overflow-x:auto;">
														<table class="b2b-table" style="margin:0; font-size:0.875rem;">
															<thead>
																<tr>
																	<th style="padding:0.65rem 1rem;">الصنف الدوائي</th>
																	<th style="padding:0.65rem 0.75rem; text-align:center; width:155px;">الكمية المطلوبة</th>
																	<th style="padding:0.65rem 0.75rem;" class="td-numeric">سعر الجمهور</th>
																	<th style="padding:0.65rem 0.75rem; text-align:center;">نسبة الخصم</th>
																	<th style="padding:0.65rem 1rem;" class="td-numeric">السعر بعد الخصم (الإجمالي)</th>
																	<th style="padding:0.65rem 0.5rem; text-align:center; width:45px;"></th>
																</tr>
															</thead>
															<tbody>
																for _, l := range sh.Lines {
																	<tr class="order-table-row">
																		<td style="padding:0.75rem 1rem;">
																			<div style="font-weight:800; color:var(--text); font-size:0.925rem;">
																				{ l.ProductName.Get(i18n.Lang(lang)) }
																			</div>
																			if l.VariantName.Get(i18n.Lang(lang)) != "" || l.SKU != "" {
																				<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;">
																					if l.VariantName.Get(i18n.Lang(lang)) != "" {
																						<span>{ l.VariantName.Get(i18n.Lang(lang)) }</span>
																					}
																					if l.SKU != "" {
																						<span class="font-mono text-xs" style="margin-inline-start:0.4rem;">SKU: { l.SKU }</span>
																					}
																				</div>
																			}
																			<input type="hidden" name="line_id[]" value={ fmt.Sprintf("%d", l.ID) }/>
																			<input type="hidden" name="product_name[]" value={ l.ProductName.Get(i18n.Lang(lang)) }/>
																			<input type="hidden" name="unit_price[]" value={ l.UnitPrice.String() } class="row-unit-price-input"/>
																			<input type="hidden" name="discount_amount[]" value={ l.DiscountAmount.String() } class="row-discount-input"/>
																			<input type="hidden" name="is_deleted[]" value="0" class="row-deleted-input"/>
																		</td>
																		<td style="padding:0.75rem 0.75rem; text-align:center;">
																			<!-- Direct Quantity Stepper: [ - ] 10 [ + ] -->
																			<div style="display:flex; align-items:center; gap:0.25rem; justify-content:center;">
																				<button type="button" class="btn btn-secondary btn-icon" style="width:28px; height:28px; font-weight:900; font-size:1.1rem; padding:0; line-height:1;" onclick="stepRowQty(this, -1)">−</button>
																				<input
																					type="number"
																					name="quantity[]"
																					value={ fmt.Sprintf("%d", l.Quantity) }
																					min="1"
																					required
																					class="form-input input-sm tabular-nums text-center row-qty-input"
																					style="width:58px; font-weight:800; padding:0.25rem 0.35rem; font-size:0.925rem;"
																					oninput="recalcRowTotal(this)"
																				/>
																				<button type="button" class="btn btn-secondary btn-icon" style="width:28px; height:28px; font-weight:900; font-size:1.1rem; padding:0; line-height:1;" onclick="stepRowQty(this, 1)">+</button>
																			</div>
																		</td>
																		<td style="padding:0.75rem 0.75rem;" class="td-numeric tabular-nums">
																			{ l.UnitPrice.String() } ج.م
																		</td>
																		<td style="padding:0.75rem 0.75rem; text-align:center;" class="tabular-nums">
																			{{
																				discPct := 0.0
																				if l.UnitPrice.IsPositive() && l.DiscountAmount.IsPositive() {
																					discPct = (float64(l.DiscountAmount.Minor()) / float64(l.UnitPrice.Minor())) * 100.0
																				}
																			}}
																			if discPct > 0 {
																				<span class="badge badge-emerald tabular-nums" style="font-weight:800; font-size:0.8rem;">{ fmt.Sprintf("%.1f%%", discPct) }</span>
																			} else {
																				<span class="text-xs text-muted">0%</span>
																			}
																		</td>
																		<td style="padding:0.75rem 1rem; font-weight:800; color:var(--text);" class="td-numeric tabular-nums">
																			<span class="row-total-display">{ l.TotalPrice.String() } ج.م</span>
																		</td>
																		<td style="padding:0.75rem 0.5rem; text-align:center;">
																			<button type="button" class="btn btn-secondary btn-xs" style="color:var(--danger); border-color:rgba(239,68,68,0.25); padding:0.2rem 0.45rem; font-size:0.75rem;" onclick="deleteRowLine(this)" title="حذف الصنف من الطلب">
																				✕
																			</button>
																		</td>
																	</tr>
																}
															</tbody>
														</table>
													</div>
												</div>
											}
										</div>
									} else {
										<!-- Direct Flat Lines Table -->
										<div class="table-container" style="padding:0; margin:0; border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; overflow-x:auto;">
											<table class="b2b-table" style="margin:0; font-size:0.875rem;">
												<thead>
													<tr>
														<th style="padding:0.65rem 1rem;">الصنف الدوائي</th>
														<th style="padding:0.65rem 0.75rem; text-align:center; width:155px;">الكمية المطلوبة</th>
														<th style="padding:0.65rem 0.75rem;" class="td-numeric">سعر الجمهور</th>
														<th style="padding:0.65rem 0.75rem; text-align:center;">نسبة الخصم</th>
														<th style="padding:0.65rem 1rem;" class="td-numeric">السعر بعد الخصم (الإجمالي)</th>
														<th style="padding:0.65rem 0.5rem; text-align:center; width:45px;"></th>
													</tr>
												</thead>
												<tbody>
													for _, l := range order.Lines {
														<tr class="order-table-row">
															<td style="padding:0.75rem 1rem;">
																<div style="font-weight:800; color:var(--text); font-size:0.925rem;">
																	{ l.ProductName.Get(i18n.Lang(lang)) }
																</div>
																if l.VariantName.Get(i18n.Lang(lang)) != "" || l.SKU != "" {
																	<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;">
																		if l.VariantName.Get(i18n.Lang(lang)) != "" {
																			<span>{ l.VariantName.Get(i18n.Lang(lang)) }</span>
																		}
																		if l.SKU != "" {
																			<span class="font-mono text-xs" style="margin-inline-start:0.4rem;">SKU: { l.SKU }</span>
																		}
																	</div>
																}
																<input type="hidden" name="line_id[]" value={ fmt.Sprintf("%d", l.ID) }/>
																<input type="hidden" name="product_name[]" value={ l.ProductName.Get(i18n.Lang(lang)) }/>
																<input type="hidden" name="unit_price[]" value={ l.UnitPrice.String() } class="row-unit-price-input"/>
																<input type="hidden" name="discount_amount[]" value={ l.DiscountAmount.String() } class="row-discount-input"/>
																<input type="hidden" name="is_deleted[]" value="0" class="row-deleted-input"/>
															</td>
															<td style="padding:0.75rem 0.75rem; text-align:center;">
																<!-- Direct Quantity Stepper: [ - ] 10 [ + ] -->
																<div style="display:flex; align-items:center; gap:0.25rem; justify-content:center;">
																	<button type="button" class="btn btn-secondary btn-icon" style="width:28px; height:28px; font-weight:900; font-size:1.1rem; padding:0; line-height:1;" onclick="stepRowQty(this, -1)">−</button>
																	<input
																		type="number"
																		name="quantity[]"
																		value={ fmt.Sprintf("%d", l.Quantity) }
																		min="1"
																		required
																		class="form-input input-sm tabular-nums text-center row-qty-input"
																		style="width:58px; font-weight:800; padding:0.25rem 0.35rem; font-size:0.925rem;"
																		oninput="recalcRowTotal(this)"
																	/>
																	<button type="button" class="btn btn-secondary btn-icon" style="width:28px; height:28px; font-weight:900; font-size:1.1rem; padding:0; line-height:1;" onclick="stepRowQty(this, 1)">+</button>
																</div>
															</td>
															<td style="padding:0.75rem 0.75rem;" class="td-numeric tabular-nums">
																{ l.UnitPrice.String() } ج.م
															</td>
															<td style="padding:0.75rem 0.75rem; text-align:center;" class="tabular-nums">
																{{
																	discPct := 0.0
																	if l.UnitPrice.IsPositive() && l.DiscountAmount.IsPositive() {
																		discPct = (float64(l.DiscountAmount.Minor()) / float64(l.UnitPrice.Minor())) * 100.0
																	}
																}}
																if discPct > 0 {
																	<span class="badge badge-emerald tabular-nums" style="font-weight:800; font-size:0.8rem;">{ fmt.Sprintf("%.1f%%", discPct) }</span>
																} else {
																	<span class="text-xs text-muted">0%</span>
																}
															</td>
															<td style="padding:0.75rem 1rem; font-weight:800; color:var(--text);" class="td-numeric tabular-nums">
																<span class="row-total-display">{ l.TotalPrice.String() } ج.م</span>
															</td>
															<td style="padding:0.75rem 0.5rem; text-align:center;">
																<button type="button" class="btn btn-secondary btn-xs" style="color:var(--danger); border-color:rgba(239,68,68,0.25); padding:0.2rem 0.45rem; font-size:0.75rem;" onclick="deleteRowLine(this)" title="حذف الصنف من الطلب">
																	✕
																</button>
															</td>
														</tr>
													}
												</tbody>
											</table>
										</div>
									}

									<!-- Save Edits Action Bar -->
									<div style="display:flex; justify-content:space-between; align-items:center; padding:1.1rem 1.35rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); margin-top:1.25rem; flex-wrap:wrap; gap:1rem; box-shadow:var(--shadow-xs);">
										<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--text-secondary);">
											<span style="color:#d97706; font-size:1.1rem;">⚠️</span>
											<span>الطلب في حالة <strong>قيد المراجعة</strong>: يمكنك تعديل الكميات مباشرة قبل تأكيد المورد.</span>
										</div>
										<button type="submit" class="btn btn-primary btn-md fw-800" style="gap:0.4rem; padding:0.65rem 1.85rem; box-shadow:var(--shadow-sm); font-size:0.9rem;">
											@components.IconCheck("icon-xs")
											<span>💾 حفظ تعديلات الكميات وتحديث الإجماليات</span>
										</button>
									</div>
								</form>
							} else {
								<!-- Read-Only Locked Table for Confirmed / Processed Orders -->
								if len(order.Shipments) > 0 {
									<div style="display:flex; flex-direction:column; gap:1.25rem;">
										for idx, sh := range order.Shipments {
											<div style="border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-sunken); overflow:hidden;">
												<div style="display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1.15rem; background:var(--surface-raised); border-bottom:1px solid var(--border); flex-wrap:wrap; gap:0.75rem;">
													<div style="display:flex; align-items:center; gap:0.6rem;">
														<span class="badge badge-primary text-xs fw-800 tabular-nums">طرد { fmt.Sprintf("%d", idx+1) }</span>
														<strong style="font-size:0.95rem; color:var(--text); font-weight:800;">
															{ sh.VendorName.Get(i18n.Lang(lang)) }
														</strong>
													</div>
													<div style="display:flex; align-items:center; gap:0.5rem;">
														if sh.TrackingNumber != "" {
															<span class="badge badge-slate text-xs font-mono">بوليصة: { sh.TrackingNumber }</span>
														}
														@components.StatusBadge(string(sh.Status))
													</div>
												</div>
												<div class="table-container" style="padding:0; margin:0; overflow-x:auto;">
													<table class="b2b-table" style="margin:0; font-size:0.875rem;">
														<thead>
															<tr>
																<th style="padding:0.65rem 1rem;">الصنف الدوائي</th>
																<th style="padding:0.65rem 0.75rem; text-align:center;">الكمية</th>
																<th style="padding:0.65rem 0.75rem;" class="td-numeric">السعر</th>
																<th style="padding:0.65rem 0.75rem;" class="td-numeric">الخصم</th>
																<th style="padding:0.65rem 1rem;" class="td-numeric">الإجمالي</th>
															</tr>
														</thead>
														<tbody>
															for _, l := range sh.Lines {
																<tr>
																	<td style="padding:0.75rem 1rem;">
																		<div style="font-weight:800; color:var(--text); font-size:0.925rem;">
																			{ l.ProductName.Get(i18n.Lang(lang)) }
																		</div>
																	</td>
																	<td style="padding:0.75rem 0.75rem; text-align:center;">
																		<span class="tabular-nums fw-700" style="background:var(--surface); padding:0.2rem 0.55rem; border-radius:var(--radius-sm); border:1px solid var(--border);">
																			{ fmt.Sprintf("%d", l.Quantity) }
																		</span>
																	</td>
																	<td style="padding:0.75rem 0.75rem;" class="td-numeric tabular-nums">
																		{ l.UnitPrice.String() } ج.م
																	</td>
																	<td style="padding:0.75rem 0.75rem;" class="td-numeric tabular-nums text-emerald">
																		{ l.DiscountAmount.String() } ج.م
																	</td>
																	<td style="padding:0.75rem 1rem; font-weight:800; color:var(--text);" class="td-numeric tabular-nums">
																		{ l.TotalPrice.String() } ج.م
																	</td>
																</tr>
															}
														</tbody>
													</table>
												</div>
											</div>
										}
									</div>
								} else {
									<div class="table-container" style="padding:0; margin:0; border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; overflow-x:auto;">
										<table class="b2b-table" style="margin:0; font-size:0.875rem;">
											<thead>
												<tr>
													<th style="padding:0.65rem 1rem;">الصنف الدوائي</th>
													<th style="padding:0.65rem 0.75rem; text-align:center;">الكمية</th>
													<th style="padding:0.65rem 0.75rem;" class="td-numeric">السعر</th>
													<th style="padding:0.65rem 0.75rem;" class="td-numeric">الخصم</th>
													<th style="padding:0.65rem 1rem;" class="td-numeric">الإجمالي</th>
												</tr>
											</thead>
											<tbody>
												for _, l := range order.Lines {
													<tr>
														<td style="padding:0.75rem 1rem;">
															<div style="font-weight:800; color:var(--text); font-size:0.925rem;">
																{ l.ProductName.Get(i18n.Lang(lang)) }
															</div>
														</td>
														<td style="padding:0.75rem 0.75rem; text-align:center;">
															<span class="tabular-nums fw-700" style="background:var(--surface); padding:0.2rem 0.55rem; border-radius:var(--radius-sm); border:1px solid var(--border);">
																{ fmt.Sprintf("%d", l.Quantity) }
															</span>
														</td>
														<td style="padding:0.75rem 0.75rem;" class="td-numeric tabular-nums">
															{ l.UnitPrice.String() } ج.م
														</td>
														<td style="padding:0.75rem 0.75rem;" class="td-numeric tabular-nums text-emerald">
															{ l.DiscountAmount.String() } ج.م
														</td>
														<td style="padding:0.75rem 1rem; font-weight:800; color:var(--text);" class="td-numeric tabular-nums">
															{ l.TotalPrice.String() } ج.م
														</td>
													</tr>
												}
											</tbody>
										</table>
									</div>
								}
								<div style="display:flex; align-items:center; gap:0.5rem; padding:0.75rem 1rem; border-radius:var(--radius-lg); background:var(--surface-sunken); border:1px solid var(--border); font-size:0.825rem; color:var(--text-secondary); margin-top:1rem;">
									<span>🔒</span>
									<span>تم تأكيد هذا الطلب أو بدء تجهيزه من قِبل المورد (حالة الطلب: <strong>{ string(order.Status) }</strong>). لا يمكن تعديل الكميات بعد بدء التنفيذ.</span>
								</div>
							}
						}
					</div>

					<!-- 3. Status History Timeline Card -->
					<div class="card" style="margin:0; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border); background:var(--surface); box-shadow:var(--shadow-xs);">
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
							<span style="font-size:1.1rem;">⏱</span>
							<h2 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0;">
								سجل التحديثات والمحطات
							</h2>
						</div>

						if len(history) == 0 {
							<div style="font-size:0.875rem; color:var(--text-muted); text-align:center; padding:1.5rem 0;">
								تم تسجيل أمر التوريد، وسيتم تدوين التحديثات اللحظية هنا فور انتقال الشحنة بين المحطات.
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:0.75rem;">
								for _, h := range history {
									<div style="display:flex; align-items:flex-start; gap:0.75rem; padding:0.75rem 1rem; border-radius:var(--radius-md); background:var(--surface-sunken); border:1px solid var(--border);">
										<div style="width:8px; height:8px; border-radius:50%; background:var(--accent); margin-top:0.45rem; flex-shrink:0;"></div>
										<div style="flex:1;">
											<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.2rem;">
												<span class="badge badge-sky text-xs fw-700">{ h.ToStatus }</span>
												<span class="tabular-nums text-xs text-muted">{ h.CreatedAt.Format("2006-01-02 15:04:05") }</span>
											</div>
											<div style="font-size:0.8125rem; color:var(--text-secondary);">
												if h.Notes != "" {
													{ h.Notes }
												} else {
													<span>تم تحديث حالة الشحنة بنجاح في المنظومة</span>
												}
											</div>
										</div>
									</div>
								}
							</div>
						}
					</div>

				</div>

				<!-- Left Column: Summary & Delivery Context -->
				<div style="display:flex; flex-direction:column; gap:1.5rem;">
					
					<!-- 1. Financial Breakdown Card -->
					<div class="card" style="margin:0; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border); background:var(--surface); box-shadow:var(--shadow-xs);">
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
							<span style="font-size:1.1rem;">🧾</span>
							<h2 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0;">
								الملخص المالي للفاتورة
							</h2>
						</div>

						<div style="display:flex; flex-direction:column; gap:0.75rem; font-size:0.875rem;">
							<div style="display:flex; justify-content:space-between; align-items:center;">
								<span style="color:var(--text-secondary);">إجمالي الأصناف:</span>
								<span class="tabular-nums fw-700" style="color:var(--text);">
									if order.Subtotal.Minor() > 0 {
										{ order.Subtotal.String() } ج.م
									} else {
										{ order.TotalAmount.String() } ج.م
									}
								</span>
							</div>

							if order.DiscountAmount.Minor() > 0 || order.TotalDiscount.Minor() > 0 {
								<div style="display:flex; justify-content:space-between; align-items:center; color:var(--emerald);">
									<span>إجمالي الخصم الممنوح:</span>
									<span class="tabular-nums fw-700">
										if order.TotalDiscount.Minor() > 0 {
											- { order.TotalDiscount.String() } ج.م
										} else {
											- { order.DiscountAmount.String() } ج.م
										}
									</span>
								</div>
							}

							<div style="display:flex; justify-content:space-between; align-items:center;">
								<span style="color:var(--text-secondary);">مصاريف الشحن والتوصيل:</span>
								<span class="tabular-nums fw-700" style="color:var(--text);">
									if order.ShippingFee.Minor() > 0 {
										{ order.ShippingFee.String() } ج.م
									} else {
										<span class="text-emerald">مجاناً</span>
									}
								</span>
							</div>

							if order.TaxAmount.Minor() > 0 {
								<div style="display:flex; justify-content:space-between; align-items:center;">
									<span style="color:var(--text-secondary);">ضريبة القيمة المضافة:</span>
									<span class="tabular-nums fw-700" style="color:var(--text);">{ order.TaxAmount.String() } ج.م</span>
								</div>
							}

							<div style="height:1px; background:var(--border); margin:0.35rem 0;"></div>

							<div style="display:flex; justify-content:space-between; align-items:baseline;">
								<span style="font-size:0.95rem; font-weight:800; color:var(--text);">المبلغ الصافي المستحق:</span>
								<div style="font-size:1.5rem; font-weight:900; color:var(--accent); line-height:1.2;" class="tabular-nums">
									{ order.TotalAmount.String() } <span style="font-size:0.85rem; font-weight:700; color:var(--text-secondary);">ج.م</span>
								</div>
							</div>

							<!-- Payment method pill -->
							<div style="margin-top:0.5rem; padding:0.75rem; border-radius:var(--radius-lg); background:var(--surface-sunken); border:1px solid var(--border); font-size:0.8125rem;">
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem;">
									<span style="color:var(--text-muted);">طريقة الدفع:</span>
									<span style="font-weight:700; color:var(--text);">
										if order.PaymentMethod == "cod" || order.PaymentMethod == "" {
											<span>دفع عند الاستلام (COD)</span>
										} else {
											<span>{ order.PaymentMethod }</span>
										}
									</span>
								</div>
								<div style="display:flex; justify-content:space-between; align-items:center;">
									<span style="color:var(--text-muted);">حالة السداد:</span>
									if order.PaymentStatus == commerce.PaymentPaid {
										<span class="text-emerald fw-700">✓ مدفوع بالكامل</span>
									} else {
										<span class="text-amber fw-700">مستحق عند الاستلام</span>
									}
								</div>
							</div>

							<!-- Print invoice button CTA -->
							<div style="margin-top:0.5rem;">
								if order.Status != commerce.StatusPending {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", order.ID)) }
										target="_blank"
										class="btn btn-primary"
										style="width:100%; justify-content:center; font-weight:800; padding:0.65rem 1rem; border-radius:var(--radius-lg); gap:0.4rem;"
									>
										@components.IconPrinter("icon-xs")
										<span>طباعة الفاتورة</span>
									</a>
								} else {
									<div style="background:var(--surface-sunken); border:1px dashed var(--border); border-radius:var(--radius-lg); padding:0.75rem; text-align:center; font-size:0.8rem; color:var(--text-muted);">
										<span>🔒 تتاح طباعة الفاتورة فور تأكيد وقبول المورد للطلب</span>
									</div>
								}
							</div>
						</div>
					</div>

					<!-- 2. Pharmacy Receiving Branch Card -->
					<div class="card" style="margin:0; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border); background:var(--surface); box-shadow:var(--shadow-xs);">
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
							<span style="font-size:1.1rem;">🏥</span>
							<h2 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0;">
								بيانات فرع الاستلام
							</h2>
						</div>

						<div style="display:flex; flex-direction:column; gap:0.75rem; font-size:0.875rem;">
							<div>
								<div style="font-size:0.75rem; color:var(--text-muted); font-weight:600; margin-bottom:0.15rem;">فرع الصيدلية:</div>
								<div style="font-weight:800; color:var(--text); font-size:0.95rem;">
									if order.CustomerBranchName.Get(i18n.Lang(lang)) != "" {
										{ order.CustomerBranchName.Get(i18n.Lang(lang)) }
									} else {
										<span>الفرع الرئيسي للصيدلية</span>
									}
								</div>
							</div>

							if order.CustomerManagerName != "" {
								<div>
									<div style="font-size:0.75rem; color:var(--text-muted); font-weight:600; margin-bottom:0.15rem;">الصيدلي المسؤول:</div>
									<div style="color:var(--text); font-weight:600;">{ order.CustomerManagerName }</div>
								</div>
							}

							if order.CustomerBranchPhone != "" {
								<div>
									<div style="font-size:0.75rem; color:var(--text-muted); font-weight:600; margin-bottom:0.15rem;">هاتف الفرع:</div>
									<div style="color:var(--text); font-weight:700; direction:ltr; text-align:right;" class="tabular-nums font-mono">{ order.CustomerBranchPhone }</div>
								</div>
							}

							<div>
								<div style="font-size:0.75rem; color:var(--text-muted); font-weight:600; margin-bottom:0.15rem;">عنوان التوصيل المسجل:</div>
								<div style="color:var(--text); line-height:1.4;">
									if order.CustomerBranchAddress != "" {
										{ order.CustomerBranchAddress }
									} else {
										<span class="text-muted">العنوان المسجل في ملف المنشأة</span>
									}
								</div>
							</div>

							if order.Notes != "" {
								<div style="margin-top:0.25rem; padding:0.65rem 0.85rem; border-radius:var(--radius-md); background:var(--surface-sunken); border:1px solid var(--border);">
									<div style="font-size:0.75rem; color:var(--text-muted); font-weight:600; margin-bottom:0.15rem;">ملاحظات خاصة بالتسليم:</div>
									<div style="color:var(--text); font-size:0.8125rem;">{ order.Notes }</div>
								</div>
							}
						</div>
					</div>

					<!-- 3. Quality & Cold-Chain Badge Card -->
					<div class="card" style="margin:0; padding:1.25rem 1.35rem; border-radius:var(--radius-xl); border:1px solid rgba(59, 130, 246, 0.2); background:rgba(59, 130, 246, 0.04); font-size:0.8125rem; display:flex; flex-direction:column; gap:0.6rem;">
						<div style="display:flex; align-items:center; gap:0.45rem; font-weight:800; color:var(--primary);">
							<span>❄️</span>
							<span>معايير النقل المبرد المعتمد</span>
						</div>
						<p style="margin:0; color:var(--text-secondary); line-height:1.5;">
							تخضع كافة الشحنات لرقابة درجات الحرارة وسلسلة التبريد الموثقة لضمان فاعلية ومأمونية الأصناف الدوائية.
						</p>
					</div>

				</div>

			</div>

			<!-- Edit Order Modal (Only rendered/available when order is pending) -->
			if order.Status == commerce.StatusPending {
				<div id="order-edit-modal" class="modal-overlay hidden" style="position:fixed; inset:0; z-index:99999; background:rgba(15,23,42,0.65); backdrop-filter:blur(4px); display:none; align-items:center; justify-content:center; padding:1rem;" onclick="if(event.target===this) window.closeOrderEditModal();">
					<div class="modal-card" style="background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl); width:100%; max-width:860px; max-height:90vh; display:flex; flex-direction:column; overflow:hidden;">
						<!-- Header -->
						<div style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); background:var(--surface);">
							<div style="display:flex; align-items:center; gap:0.6rem;">
								<span style="font-size:1.35rem;">✏️</span>
								<div>
									<h3 style="font-size:1.15rem; font-weight:900; color:var(--text); margin:0;">
										تعديل أصناف وكميات الطلب #{ order.OrderNumber }
									</h3>
									<p style="font-size:0.75rem; color:var(--text-muted); margin:0.15rem 0 0 0;">
										يمكنك تعديل كميات الأصناف أو إضافة صنف جديد يدوياً، وسيقوم النظام بتحديث الفاتورة فوراً.
									</p>
								</div>
							</div>
							<button type="button" class="btn btn-secondary btn-icon" onclick="window.closeOrderEditModal()" style="border:none; cursor:pointer;">
								@components.IconClose("icon-sm")
							</button>
						</div>

						<!-- Form -->
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orders/%d/edit", order.ID)) } id="order-edit-form" style="display:flex; flex-direction:column; overflow-y:auto; padding:1.5rem; gap:1.25rem;">
							<!-- Table of lines -->
							<div class="table-container" style="margin:0; border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden;">
								<table class="b2b-table" style="margin:0; font-size:0.875rem;" id="edit-lines-table">
									<thead style="background:var(--surface-sunken);">
										<tr>
											<th style="padding:0.65rem 0.85rem;">الصنف الدوائي</th>
											<th style="padding:0.65rem 0.75rem; width:135px; text-align:center;">الكمية</th>
											<th style="padding:0.65rem 0.75rem; width:110px;" class="td-numeric">سعر الوحدة</th>
											<th style="padding:0.65rem 0.75rem; width:95px;" class="td-numeric">الخصم</th>
											<th style="padding:0.65rem 0.85rem; width:110px;" class="td-numeric">الإجمالي</th>
											<th style="padding:0.65rem 0.5rem; width:45px; text-align:center;"></th>
										</tr>
									</thead>
									<tbody id="edit-lines-tbody">
										for _, line := range getAllOrderLines(order) {
											<tr class="edit-line-row">
												<td style="padding:0.65rem 0.85rem;">
													<input type="hidden" name="line_id[]" value={ fmt.Sprintf("%d", line.ID) }/>
													<input type="hidden" name="is_deleted[]" value="0" class="line-deleted-input"/>
													<input type="text" name="product_name[]" value={ line.ProductName.Get(i18n.Lang(lang)) } required class="form-input input-sm w-full fw-700" style="font-size:0.875rem;"/>
												</td>
												<td style="padding:0.65rem 0.75rem;">
													<div style="display:flex; align-items:center; gap:0.25rem; justify-content:center;">
														<button type="button" class="btn btn-secondary btn-icon" style="width:26px; height:26px; padding:0; font-size:0.9rem;" onclick="window.stepQty(this, -1)">-</button>
														<input type="number" name="quantity[]" value={ fmt.Sprintf("%d", line.Quantity) } min="1" required class="form-input input-sm tabular-nums text-center line-qty-input" style="width:55px; font-weight:800; padding:0.25rem 0.35rem;" oninput="window.recalcEditOrder()"/>
														<button type="button" class="btn btn-secondary btn-icon" style="width:26px; height:26px; padding:0; font-size:0.9rem;" onclick="window.stepQty(this, 1)">+</button>
													</div>
												</td>
												<td style="padding:0.65rem 0.75rem;" class="td-numeric">
													<input type="text" name="unit_price[]" value={ line.UnitPrice.String() } required class="form-input input-sm tabular-nums line-unit-price text-right" style="width:100%; font-weight:700;" oninput="window.recalcEditOrder()"/>
												</td>
												<td style="padding:0.65rem 0.75rem;" class="td-numeric">
													<input type="text" name="discount_amount[]" value={ line.DiscountAmount.String() } class="form-input input-sm tabular-nums line-disc-amount text-right" style="width:100%;" oninput="window.recalcEditOrder()"/>
												</td>
												<td style="padding:0.65rem 0.85rem;" class="td-numeric">
													<span class="line-total-cell tabular-nums fw-800 text-primary">{ line.TotalPrice.String() }</span>
												</td>
												<td style="padding:0.65rem 0.5rem; text-align:center;">
													<button type="button" class="btn btn-secondary btn-icon" title="حذف الصنف" onclick="window.deleteEditRow(this)" style="width:28px; height:28px; padding:0; border-radius:var(--radius-md); color:var(--rose);">
														🗑️
													</button>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>

							<!-- Button to add new line row -->
							<div style="display:flex; justify-content:flex-start;">
								<button type="button" class="btn btn-secondary btn-sm fw-700" onclick="window.addNewEditRow()" style="gap:0.4rem; border-style:dashed;">
									<span>➕ إضافة صنف جديد يدوياً للطلب</span>
								</button>
							</div>

							<!-- Notes -->
							<div>
								<label class="form-label" style="font-size:0.8rem; font-weight:700;">ملاحظات الصيدلية بخصوص التعديل (اختياري)</label>
								<input type="text" name="notes" placeholder="اكتب توضيح للمورد بخصوص تعديل الكميات أو الأصناف..." class="form-input input-sm w-full"/>
							</div>

							<!-- Summary Box -->
							<div style="background:var(--surface-sunken); padding:1rem 1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
								<div style="display:flex; gap:1.5rem; flex-wrap:wrap; font-size:0.875rem;">
									<div>
										<span style="color:var(--text-secondary);">إجمالي الأصناف:</span>
										<strong id="edit-subtotal-val" class="tabular-nums" style="margin-inline-start:0.35rem;">{ order.Subtotal.String() }</strong> ج.م
									</div>
									<div>
										<span style="color:var(--emerald);">إجمالي الخصم:</span>
										<strong id="edit-discount-val" class="tabular-nums text-emerald" style="margin-inline-start:0.35rem;">-{ order.DiscountAmount.String() }</strong> ج.م
									</div>
								</div>
								<div style="display:flex; align-items:baseline; gap:0.5rem;">
									<span style="font-weight:800; font-size:0.95rem; color:var(--text);">المبلغ الصافي الجديد:</span>
									<span id="edit-grandtotal-val" class="tabular-nums" style="font-size:1.4rem; font-weight:900; color:var(--accent);">{ order.TotalAmount.String() }</span>
									<span style="font-size:0.85rem; font-weight:700; color:var(--text-muted);">ج.م</span>
								</div>
							</div>

							<!-- Modal Footer Actions -->
							<div style="display:flex; justify-content:flex-end; gap:0.75rem; border-top:1px solid var(--border); padding-top:1rem;">
								<button type="button" class="btn btn-secondary btn-sm" onclick="window.closeOrderEditModal()">إلغاء</button>
								<button type="submit" class="btn btn-primary btn-sm fw-800" style="padding:0.55rem 1.5rem; gap:0.4rem;">
									@components.IconCheck("icon-xs")
									<span>حفظ وتحديث الطلب</span>
								</button>
							</div>
						</form>
					</div>
				</div>

				<script>
					window.stepRowQty = function(btn, delta) {
						const tr = btn.closest('.order-table-row');
						if (!tr) return;
						const input = tr.querySelector('.row-qty-input');
						if (input) {
							let val = parseInt(input.value, 10) || 1;
							val += delta;
							if (val < 1) val = 1;
							input.value = val;
							window.recalcRowTotal(input);
						}
					};

					window.recalcRowTotal = function(input) {
						const tr = input.closest('.order-table-row');
						if (!tr) return;
						const qty = parseInt(input.value, 10) || 1;
						const priceInput = tr.querySelector('.row-unit-price-input');
						const discInput = tr.querySelector('.row-discount-input');
						const totalDisplay = tr.querySelector('.row-total-display');

						const price = parseFloat(priceInput ? priceInput.value.replace(/,/g, '') : 0) || 0;
						const disc = parseFloat(discInput ? discInput.value.replace(/,/g, '') : 0) || 0;

						let effectivePrice = price - disc;
						if (effectivePrice < 0) effectivePrice = 0;
						const lineTotal = effectivePrice * qty;

						if (totalDisplay) {
							totalDisplay.textContent = lineTotal.toFixed(2) + ' ج.م';
						}
					};

					window.deleteRowLine = function(btn) {
						if (!confirm('هل أنت متأكد من رغبتك في حذف هذا الصنف من الطلب؟')) return;
						const tr = btn.closest('.order-table-row');
						if (!tr) return;
						const delInput = tr.querySelector('.row-deleted-input');
						if (delInput) {
							delInput.value = '1';
						}
						tr.style.display = 'none';
					};

					window.openOrderEditModal = function() {
						const modal = document.getElementById('order-edit-modal');
						if (modal) {
							modal.classList.remove('hidden');
							modal.style.removeProperty('display');
							modal.style.setProperty('display', 'flex', 'important');
							if (typeof window.recalcEditOrder === 'function') {
								window.recalcEditOrder();
							}
						}
					};

					window.closeOrderEditModal = function() {
						const modal = document.getElementById('order-edit-modal');
						if (modal) {
							modal.classList.add('hidden');
							modal.style.setProperty('display', 'none', 'important');
						}
					};

					window.stepQty = function(btn, delta) {
						const row = btn.closest('.edit-line-row');
						if (!row) return;
						const input = row.querySelector('.line-qty-input');
						if (input) {
							let val = parseInt(input.value) || 1;
							val += delta;
							if (val < 1) val = 1;
							input.value = val;
							if (typeof window.recalcEditOrder === 'function') {
								window.recalcEditOrder();
							}
						}
					};

					window.deleteEditRow = function(btn) {
						const row = btn.closest('.edit-line-row');
						if (!row) return;
						const lineIdInput = row.querySelector('input[name="line_id[]"]');
						if (lineIdInput && lineIdInput.value && lineIdInput.value !== "0") {
							const delInput = row.querySelector('.line-deleted-input');
							if (delInput) delInput.value = "1";
							row.style.display = 'none';
						} else {
							row.remove();
						}
						if (typeof window.recalcEditOrder === 'function') {
							window.recalcEditOrder();
						}
					};

					window.addNewEditRow = function() {
						const tbody = document.getElementById('edit-lines-tbody');
						if (!tbody) return;
						const tr = document.createElement('tr');
						tr.className = 'edit-line-row';
						tr.innerHTML = `
							<td style="padding:0.65rem 0.85rem;">
								<input type="hidden" name="line_id[]" value="0"/>
								<input type="hidden" name="is_deleted[]" value="0" class="line-deleted-input"/>
								<input type="text" name="product_name[]" placeholder="اسم الصنف الدوائي الجديد..." required class="form-input input-sm w-full fw-700" style="font-size:0.875rem;"/>
							</td>
							<td style="padding:0.65rem 0.75rem;">
								<div style="display:flex; align-items:center; gap:0.25rem; justify-content:center;">
									<button type="button" class="btn btn-secondary btn-icon" style="width:26px; height:26px; padding:0; font-size:0.9rem;" onclick="window.stepQty(this, -1)">-</button>
									<input type="number" name="quantity[]" value="1" min="1" required class="form-input input-sm tabular-nums text-center line-qty-input" style="width:55px; font-weight:800; padding:0.25rem 0.35rem;" oninput="window.recalcEditOrder()"/>
									<button type="button" class="btn btn-secondary btn-icon" style="width:26px; height:26px; padding:0; font-size:0.9rem;" onclick="window.stepQty(this, 1)">+</button>
								</div>
							</td>
							<td style="padding:0.65rem 0.75rem;" class="td-numeric">
								<input type="text" name="unit_price[]" value="0.00" required class="form-input input-sm tabular-nums line-unit-price text-right" style="width:100%; font-weight:700;" oninput="window.recalcEditOrder()"/>
							</td>
							<td style="padding:0.65rem 0.75rem;" class="td-numeric">
								<input type="text" name="discount_amount[]" value="0.00" class="form-input input-sm tabular-nums line-disc-amount text-right" style="width:100%;" oninput="window.recalcEditOrder()"/>
							</td>
							<td style="padding:0.65rem 0.85rem;" class="td-numeric">
								<span class="line-total-cell tabular-nums fw-800 text-primary">0.00</span>
							</td>
							<td style="padding:0.65rem 0.5rem; text-align:center;">
								<button type="button" class="btn btn-secondary btn-icon" title="حذف الصنف" onclick="window.deleteEditRow(this)" style="width:28px; height:28px; padding:0; border-radius:var(--radius-md); color:var(--rose);">
									🗑️
								</button>
							</td>
						`;
						tbody.appendChild(tr);
						if (typeof window.recalcEditOrder === 'function') {
							window.recalcEditOrder();
						}
					};

					window.recalcEditOrder = function() {
						const rows = document.querySelectorAll('#edit-lines-tbody .edit-line-row');
						let subtotal = 0;
						let discount = 0;

						rows.forEach(row => {
							const delInput = row.querySelector('.line-deleted-input');
							if (delInput && delInput.value === "1") return;
							if (row.style.display === 'none') return;

							const qtyInput = row.querySelector('.line-qty-input');
							const priceInput = row.querySelector('.line-unit-price');
							const discInput = row.querySelector('.line-disc-amount');
							const totalCell = row.querySelector('.line-total-cell');

							const qty = parseInt(qtyInput ? qtyInput.value : 1) || 0;
							const price = parseFloat(priceInput ? priceInput.value.replace(/,/g, '') : 0) || 0;
							const disc = parseFloat(discInput ? discInput.value.replace(/,/g, '') : 0) || 0;

							let lineEff = price - disc;
							if (lineEff < 0) lineEff = 0;
							const lineTotal = lineEff * qty;

							if (totalCell) {
								totalCell.textContent = lineTotal.toFixed(2);
							}

							subtotal += (price * qty);
							discount += (disc * qty);
						});

						const grandTotal = Math.max(0, subtotal - discount);

						const subEl = document.getElementById('edit-subtotal-val');
						const discEl = document.getElementById('edit-discount-val');
						const grandEl = document.getElementById('edit-grandtotal-val');

						if (subEl) subEl.textContent = subtotal.toFixed(2);
						if (discEl) discEl.textContent = '-' + discount.toFixed(2);
						if (grandEl) grandEl.textContent = grandTotal.toFixed(2);
					};
				</script>
			}
		</div>
	}
}

