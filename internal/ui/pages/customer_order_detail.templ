package pages

import (
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrderDetail(order *commerce.Order, history []*commerce.OrderStatusHistory, noticeType, noticeMsg, lang, dir string, reviews map[int64]*org.Review) {
	{{
		canCancel := (order.Status == commerce.StatusPending || order.Status == commerce.StatusProcessing || order.Status == commerce.StatusConfirmed || order.Status == commerce.StatusOnHold)
		if canCancel {
			for _, sh := range order.Shipments {
				if sh != nil && (sh.Status == commerce.StatusShipped || sh.Status == commerce.StatusInTransit || sh.Status == commerce.StatusOutForDelivery || sh.Status == commerce.StatusDelivered || sh.Status == commerce.StatusCompleted) {
					canCancel = false
					break
				}
			}
		}
	}}
	@layouts.ShellFor(fmt.Sprintf(i18n.T(lang, "orders.detail_title"), order.OrderNumber), "orders", lang, dir, authctx.FromContext(ctx)) {
		<div class="page-container">
			<!-- Notice Feedback Banner -->
			if noticeMsg != "" {
				<div
					class={ "alert mb-4",
						templ.KV("alert-success", noticeType != "error"),
						templ.KV("alert-danger", noticeType == "error") }
					role="alert"
				>
					<div class="d-flex items-center gap-2">
						if noticeType == "error" {
							<span>@components.IconAlert("icon-sm")</span>
						} else {
							<span>@components.IconCheck("icon-sm")</span>
						}
						<span class="font-bold">{ noticeMsg }</span>
					</div>
				</div>
			}

			<!-- Breadcrumb & Quick Actions Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="stack-sm">
						<nav class="d-flex items-center gap-2 text-xs text-muted mb-2">
							<a href="/" class="text-secondary text-decoration-none">{ i18n.T(lang, "orders.breadcrumb_home") }</a>
							<span>/</span>
							<a href="/orders" class="text-secondary text-decoration-none">{ i18n.T(lang, "orders.breadcrumb_orders") }</a>
							<span>/</span>
							<span class="text-primary font-bold">#{ order.OrderNumber }</span>
						</nav>
						<div class="d-flex items-center gap-3 flex-wrap">
							<div class="user-avatar-badge text-xl">
								@components.IconPackage("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0 tabular-nums">
								{ fmt.Sprintf(i18n.T(lang, "orders.detail_title"), order.OrderNumber) }
							</h1>
							@components.StatusBadge(string(order.Status), lang)
							if order.PaymentStatus == commerce.PaymentPaid {
								<span class="badge badge-emerald text-xs font-bold">{ i18n.T(lang, "orders.paid_full") }</span>
							} else {
								<span class="badge badge-amber text-xs font-bold">{ i18n.T(lang, "orders.cod") }</span>
							}
							if order.IsNegotiation {
								if order.NegotiationStatus == "pending" {
									<span class="badge badge-amber text-xs font-black gap-1">
										@components.IconTag("icon-2xs")
										<span>{ i18n.T(lang, "orders.negotiation_pending") }</span>
									</span>
								} else if order.NegotiationStatus == "accepted" {
									<span class="badge badge-emerald text-xs font-black gap-1">
										@components.IconCheck("icon-2xs")
										<span>{ i18n.T(lang, "orders.negotiation_accepted") }</span>
									</span>
								} else if order.NegotiationStatus == "rejected" {
									<span class="badge badge-rose text-xs font-black gap-1">
										@components.IconX("icon-2xs")
										<span>{ i18n.T(lang, "orders.negotiation_rejected") }</span>
									</span>
								}
							}
						</div>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap">
						<a href="/orders" class="btn btn-secondary btn-sm font-bold">
							<span>{ i18n.T(lang, "orders.back_to_orders") }</span>
						</a>
						if canCancel {
							<button type="button" class="btn btn-outline-danger btn-sm font-bold gap-1" onclick="window.openCancelModal()">
								@components.IconX("icon-xs")
								<span>{ i18n.T(lang, "orders.cancel_order_btn") }</span>
							</button>
						}
						if order.Status == commerce.StatusPending {
							<button type="button" class="btn btn-primary btn-sm font-bold gap-1" onclick="window.scrollToEditForm()">
								@components.IconEdit("icon-xs")
								<span>{ i18n.T(lang, "orders.edit_quantities_btn") }</span>
							</button>
						} else {
							@components.InvoiceExportDropdown(components.InvoiceExportDropdownProps{
								PrintURL: fmt.Sprintf("/orders/%d/invoice/print", order.ID),
								ExcelURL: fmt.Sprintf("/orders/%d/invoice/excel", order.ID),
								WordURL:  fmt.Sprintf("/orders/%d/invoice/word", order.ID),
								Size:     "sm",
								Align:    "end",
								Label:    i18n.T(lang, "orders.export_invoice_label"),
							})
						}
					</div>
				</div>
			</div>

			<!-- Main 2-Column Responsive Grid -->
			<div class="order-detail-layout mb-6">
				<!-- Right Column: Primary Details & Line Items -->
				<div class="d-flex flex-col gap-6">
					if order.IsNegotiation && order.NegotiationNotes != "" {
						<div class="alert alert-warning p-4 rounded-xl d-flex items-center gap-3 mb-0">
							@components.IconTag("icon-sm shrink-0")
							<div class="stack-2xs">
								<strong class="text-sm font-black">{ i18n.T(lang, "orders.negotiation_notes_title") }</strong>
								<span class="text-xs">{ fmt.Sprintf(i18n.T(lang, "orders.negotiation_notes_body"), order.NegotiationNotes) }</span>
							</div>
						</div>
					}
					if order.Status == commerce.StatusFailed {
						<div class="alert alert-danger p-4 rounded-xl d-flex items-center gap-3 mb-0">
							@components.IconAlert("icon-sm shrink-0")
							<div class="stack-2xs">
								<strong class="text-sm font-black">{ i18n.T(lang, "orders.failed_delivery_title") }</strong>
								<span class="text-xs">{ i18n.T(lang, "orders.failed_delivery_body") }</span>
							</div>
						</div>
					}
					<!-- 1. Order Progress Timeline Card -->
					<div class="glass-panel p-6 mb-0">
						<div class="flex-between items-center mb-6 pb-3 border-b flex-wrap gap-2">
							<div class="d-flex items-center gap-2">
								<span class="text-xl">@components.IconTruck("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">
									{ i18n.T(lang, "orders.timeline_title") }
								</h2>
							</div>
							<span class="text-xs text-muted tabular-nums">
								{ fmt.Sprintf(i18n.T(lang, "orders.order_date"), order.CreatedAt.Format("2006-01-02 03:04 PM")) }
							</span>
						</div>

						<!-- Steps Progress Bar (zero inline style) -->
						<div class="order-progress-stepper">
							<div class="order-progress-track">
								<div class={ "order-progress-bar", orderProgressClass(order.Status) }></div>
							</div>

							<!-- Step 1: Placed -->
							<div class="order-step-item">
								<div class="order-step-badge done">
									@components.IconCheck("icon-sm")
								</div>
								<div class="font-extrabold text-xs text-primary">{ i18n.T(lang, "orders.step_placed") }</div>
								<div class="text-xs text-muted mt-1 tabular-nums">
									{ order.CreatedAt.Format("03:04 PM") }
								</div>
							</div>

							<!-- Step 2: Processing -->
							<div class="order-step-item">
								if isStepDone(order.Status, 2) {
									<div class="order-step-badge done">
										@components.IconCheck("icon-sm")
									</div>
								} else {
									<div class="order-step-badge pending">
										@components.IconPackage("icon-sm")
									</div>
								}
								<div class="font-extrabold text-xs text-primary">{ i18n.T(lang, "orders.step_processing") }</div>
								<div class="text-xs text-muted mt-1">{ i18n.T(lang, "orders.step_processing_sub") }</div>
							</div>

							<!-- Step 3: Out for Delivery -->
							<div class="order-step-item">
								if isStepDone(order.Status, 3) {
									<div class="order-step-badge done">
										@components.IconCheck("icon-sm")
									</div>
								} else {
									<div class="order-step-badge pending">
										@components.IconTruck("icon-sm")
									</div>
								}
								<div class="font-extrabold text-xs text-primary">{ i18n.T(lang, "orders.step_transit") }</div>
								<div class="text-xs text-muted mt-1">{ i18n.T(lang, "orders.step_transit_sub") }</div>
							</div>

							<!-- Step 4: Delivered -->
							<div class="order-step-item">
								if isStepDone(order.Status, 4) {
									<div class="order-step-badge completed">
										@components.IconCheck("icon-sm")
									</div>
								} else {
									<div class="order-step-badge pending">
										@components.IconBuilding("icon-sm")
									</div>
								}
								<div class="font-extrabold text-xs text-primary">{ i18n.T(lang, "orders.step_delivered") }</div>
								<div class="text-xs text-muted mt-1">{ i18n.T(lang, "orders.step_delivered_sub") }</div>
							</div>
						</div>
					</div>

					<!-- Delivery Confirmation Code PIN Banner (for Pharmacy Recipient) -->
					for idx, sh := range order.Shipments {
						if sh != nil && sh.DeliveryCode != "" && sh.Status != commerce.StatusDelivered && sh.Status != commerce.StatusCompleted && sh.Status != commerce.StatusCancelled {
							<div class="glass-panel p-5 mb-0 border-2 border-emerald-500/80 bg-emerald-50/20 rounded-2xl shadow-xs">
								<div class="flex-between items-center flex-wrap gap-4">
									<div class="d-flex items-center gap-3">
										<div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 d-flex items-center justify-center shadow-2xs">
											@components.IconShield("icon-md")
										</div>
										<div class="stack-sm">
											<div class="d-flex items-center gap-2 flex-wrap">
												<span class="badge badge-primary font-black text-xs">{ fmt.Sprintf(i18n.T(lang, "orders.parcel_num"), idx+1) }</span>
												<h3 class="text-sm font-black text-emerald-950 m-0">
													{ fmt.Sprintf(i18n.T(lang, "orders.parcel_pin_title"), sh.VendorName.Get(i18n.ParseLang(lang))) }
												</h3>
												<span class="badge badge-emerald text-2xs font-extrabold">{ i18n.T(lang, "orders.parcel_pin_confidential") }</span>
											</div>
											<div class="d-flex items-center gap-2 mt-1 text-xs text-emerald-900 font-bold">
												<span>{ i18n.T(lang, "orders.parcel_shipment_num") } <span class="font-mono">{ sh.ShipmentNumber }</span></span>
												if sh.TrackingNumber != "" {
													<span>| { i18n.T(lang, "orders.parcel_waybill") } <span class="font-mono">{ sh.TrackingNumber }</span></span>
												}
											</div>
											<p class="text-xs text-emerald-800 m-0 mt-1 font-medium max-w-md leading-relaxed">
												{ fmt.Sprintf(i18n.T(lang, "orders.parcel_pin_instruction"), sh.VendorName.Get(i18n.ParseLang(lang))) }
											</p>
										</div>
									</div>

									<div class="text-center bg-white p-3 px-5 rounded-xl border border-emerald-300 shadow-xs">
										<span class="text-2xs text-secondary font-bold d-block mb-1">{ fmt.Sprintf(i18n.T(lang, "orders.parcel_pin_label"), idx+1) }</span>
										<div class="text-2xl font-black text-emerald-700 font-mono tracking-widest tabular-nums select-all">
											{ sh.DeliveryCode }
										</div>
									</div>
								</div>
							</div>
						}
					}

					<!-- 2. Shipments & Line Items Table Component -->
					@CustomerOrderLines(order, lang, reviews)

					<!-- 3. Status History Timeline -->
					if len(history) > 0 {
						<div class="glass-panel p-6 mb-0">
							<div class="d-flex items-center gap-2 mb-4 pb-3 border-b">
								<span class="text-xl">@components.IconFileText("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">
									{ i18n.T(lang, "orders.history_title") }
								</h2>
							</div>

							<div class="d-flex flex-col gap-3">
								for _, h := range history {
									<div class="p-3 rounded-lg bg-surface-sunken border d-flex items-start justify-between flex-wrap gap-2 text-xs">
										<div class="d-flex items-center gap-2">
											@components.StatusBadge(h.ToStatus, lang)
											if h.Notes != "" {
												<span class="text-secondary font-medium">{ h.Notes }</span>
											}
										</div>
										<span class="text-muted tabular-nums">{ h.CreatedAt.Format("2006-01-02 03:04:05 PM") }</span>
									</div>
								}
							</div>
						</div>
					}
				</div>

				<!-- Left Column: Summary & Metadata -->
				@CustomerOrderSidebar(order, lang)
			</div>

			<!-- Review Vendor Shipment Modal -->
			@CustomerOrderReviewModal(order, lang)

			<!-- Offer Bundle Manifest Modal Target Container (WO-16) -->
			<div id="order-offer-modal-container">
				@components.Modal(components.ModalProps{
					ID:    "order-offer-modal",
					Title: i18n.T(lang, "orders.btn_view_offer"),
					Icon:  "package",
					Size:  "lg",
					State: "loading",
				})
			</div>

			<!-- Cancel Order Modal Dialog -->
			if canCancel {
				@components.Modal(components.ModalProps{
					ID:       "cancel-order-dialog",
					Title:    i18n.T(lang, "orders.cancel_dialog_title"),
					Subtitle: fmt.Sprintf(i18n.T(lang, "orders.cancel_dialog_sub"), order.OrderNumber),
					Icon:     "alert",
					Size:     "md",
				}) {
					<p class="text-sm text-secondary m-0 mb-4">
						{ fmt.Sprintf(i18n.T(lang, "orders.cancel_dialog_prompt"), order.OrderNumber) }
					</p>

					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orders/%d/cancel", order.ID)) } class="stack-md m-0">
						<div class="stack-xs">
							<label class="form-label text-xs font-bold text-primary">{ i18n.T(lang, "orders.cancel_reason_label") } <span class="text-rose">*</span></label>
							<select name="reason" class="form-select form-select-sm w-full" required>
								<option value="تغيير في الاحتياجات / طلب بالخطأ">{ i18n.T(lang, "orders.cancel_reason_1") }</option>
								<option value="تأخر في موعد التجهيز أو التوريد المتوقع">{ i18n.T(lang, "orders.cancel_reason_2") }</option>
								<option value="تم إيجاد بديل أو شراء من مورد آخر">{ i18n.T(lang, "orders.cancel_reason_3") }</option>
								<option value="تعديل في الكميات أو الأصناف المطلوبة">{ i18n.T(lang, "orders.cancel_reason_4") }</option>
								<option value="أخرى">{ i18n.T(lang, "orders.cancel_reason_5") }</option>
							</select>
						</div>

						<div class="stack-xs">
							<label class="form-label text-xs font-bold text-primary">{ i18n.T(lang, "orders.cancel_notes_label") }</label>
							<textarea name="notes" rows="2" class="form-textarea form-textarea-sm w-full" placeholder={ i18n.T(lang, "orders.cancel_notes_placeholder") }></textarea>
						</div>

						<div class="modal-footer pt-3 border-t">
							<button
								type="button"
								class="btn btn-secondary btn-sm font-bold"
								data-modal-close="cancel-order-dialog"
							>
								{ i18n.T(lang, "orders.cancel_dialog_back") }
							</button>
							<button type="submit" class="btn btn-danger btn-sm font-black gap-1 px-4">
								@components.IconX("icon-xs")
								<span>{ i18n.T(lang, "orders.cancel_dialog_confirm") }</span>
							</button>
						</div>
					</form>
				}
			}

			@CustomerOrderDetailScript()
		</div>
	}
}