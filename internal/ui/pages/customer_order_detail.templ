package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrderDetail(order *commerce.Order, history []*commerce.OrderStatusHistory, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("طلب #%s | Order Detail", order.OrderNumber), lang, dir) {
		<div class="order-detail-container" style="max-width:960px; margin:2rem auto; display:flex; flex-direction:column; gap:2rem;">
			<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-xl); padding:1.5rem; display:flex; justify-content:space-between; align-items:center;">
				<div>
					<div style="font-size:0.875rem; color:var(--neutral-500);">رقم الطلب الرئيسي</div>
					<h1 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900); margin:0.2rem 0;" class="tabular-nums">
						#{ order.OrderNumber }
					</h1>
					<div style="font-size:0.85rem; color:var(--neutral-500);">
						تاريخ الإنشاء: <span class="tabular-nums">{ order.CreatedAt.Format("2006-01-02 15:04:05") }</span>
					</div>
				</div>
				<div style="text-align:end;">
					<span style="font-size:0.9rem; font-weight:700; padding:0.3rem 0.8rem; border-radius:6px; background:var(--primary-50); color:var(--primary-700);">
						الحالة: { string(order.Status) }
					</span>
					<div style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-top:0.5rem;" class="tabular-nums">
						{ order.TotalAmount.String() } EGP
					</div>
				</div>
			</div>

			<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-xl); padding:1.5rem;">
				<h3 style="font-size:1.15rem; font-weight:700; color:var(--neutral-900); margin-bottom:1rem;">
					شحنات الموردين والأصناف
				</h3>
				if len(order.Shipments) == 0 {
					<p style="color:var(--neutral-500); font-size:0.875rem;">جاري تجهيز بيانات الشحن من الموردين...</p>
				} else {
					<div style="display:flex; flex-direction:column; gap:1.25rem;">
						for _, sh := range order.Shipments {
							<div style="border:1px solid var(--neutral-200); border-radius:var(--radius-lg); padding:1rem;">
								<div style="display:flex; justify-content:space-between; margin-bottom:0.75rem; font-size:0.9rem; font-weight:600;">
									<span>شحنة المورد #{ fmt.Sprintf("%d", sh.OrganizationID) }</span>
									<span style="color:var(--primary-700);">{ string(sh.Status) }</span>
								</div>
								<div style="display:flex; flex-direction:column; gap:0.5rem;">
									for _, line := range sh.Lines {
										<div style="display:flex; justify-content:space-between; font-size:0.875rem; color:var(--neutral-700);">
											<span>{ line.ProductName["ar"] } ({ fmt.Sprintf("%d", line.Quantity) } عبوة)</span>
											<span class="tabular-nums" style="font-weight:600;">{ line.TotalPrice.String() } EGP</span>
										</div>
									}
								</div>
							</div>
						}
					</div>
				}
			</div>

			<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-xl); padding:1.5rem;">
				<h3 style="font-size:1.15rem; font-weight:700; color:var(--neutral-900); margin-bottom:1rem;">
					سجل التتبع والتحديثات (Timeline)
				</h3>
				<div style="display:flex; flex-direction:column; gap:0.75rem;">
					for _, h := range history {
						<div style="display:flex; align-items:center; gap:1rem; font-size:0.85rem;">
							<span class="tabular-nums" style="color:var(--neutral-500);">{ h.CreatedAt.Format("15:04:05 2006-01-02") }</span>
							<span style="font-weight:700; color:var(--neutral-900);">{ h.ToStatus }</span>
							if h.Notes != "" {
								<span style="color:var(--neutral-600);">- { h.Notes }</span>
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}
