package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerOrderDetail(order *commerce.Order, history []*commerce.OrderStatusHistory, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("طلب #%s | Order Detail", order.OrderNumber), lang, dir) {
		<div class="order-detail-container" style="max-width:1040px; margin:1.5rem auto; display:flex; flex-direction:column; gap:1.75rem;">
			<div class="card" style="margin-bottom:0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div>
					<div style="font-size:0.825rem; color:var(--neutral-500);">رقم أمر التوريد</div>
					<h1 style="font-size:1.65rem; font-weight:900; color:var(--neutral-900); margin:0.2rem 0;" class="tabular-nums">
						#{ order.OrderNumber }
					</h1>
					<div style="font-size:0.85rem; color:var(--neutral-500);">
						تاريخ الإنشاء: <strong class="tabular-nums">{ order.CreatedAt.Format("2006-01-02 15:04:05") }</strong>
					</div>
				</div>
				<div style="text-align:end;">
					<span class="badge badge-emerald" style="font-size:0.85rem; padding:0.35rem 0.85rem;">
						@components.IconCheckCircle("icon-xs")
						<span>{ string(order.Status) }</span>
					</span>
					<div style="font-size:1.35rem; font-weight:900; color:var(--neutral-900); margin-top:0.4rem;" class="tabular-nums">
						{ order.TotalAmount.String() } EGP
					</div>
				</div>
			</div>

			<div class="card" style="margin-bottom:0;">
				<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem;">
					@components.IconTruck("icon-sm")
					<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin:0;">
						شحنات الموردين والأصناف المطلوبة
					</h3>
				</div>

				if len(order.Shipments) == 0 {
					<p style="color:var(--neutral-500); font-size:0.875rem;">جاري تجهيز بيانات الشحن من الموردين...</p>
				} else {
					<div style="display:flex; flex-direction:column; gap:1.25rem;">
						for _, sh := range order.Shipments {
							<div style="border:1px solid var(--border-card); border-radius:var(--radius-lg); padding:1.25rem; background:var(--neutral-50);">
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.875rem; font-size:0.95rem; font-weight:700;">
									<div style="display:flex; align-items:center; gap:0.5rem;">
										@components.IconBuilding("icon-xs")
										<span>شحنة المورد #{ fmt.Sprintf("%d", sh.OrganizationID) }</span>
									</div>
									<span class="badge badge-sky">{ string(sh.Status) }</span>
								</div>
								<div style="display:flex; flex-direction:column; gap:0.6rem;">
									for _, line := range sh.Lines {
										<div style="display:flex; justify-content:space-between; font-size:0.9rem; color:var(--neutral-800); background:#fff; padding:0.6rem 0.85rem; border-radius:var(--radius-sm); border:1px solid var(--neutral-200);">
											<span>{ line.ProductName["ar"] } (<span class="tabular-nums">{ fmt.Sprintf("%d", line.Quantity) }</span> عبوة)</span>
											<span class="tabular-nums" style="font-weight:700;">{ line.TotalPrice.String() } EGP</span>
										</div>
									}
								</div>
							</div>
						}
					</div>
				}
			</div>

			<div class="card" style="margin-bottom:0;">
				<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem;">
					@components.IconRefresh("icon-sm")
					<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin:0;">
						سجل التتبع والمحطات (Timeline)
					</h3>
				</div>

				<div style="display:flex; flex-direction:column; gap:0.875rem;">
					for _, h := range history {
						<div style="display:flex; align-items:center; gap:1.25rem; font-size:0.875rem; border-bottom:1px solid var(--neutral-100); padding-bottom:0.6rem;">
							<span class="tabular-nums" style="color:var(--neutral-400); font-size:0.8rem;">{ h.CreatedAt.Format("2006-01-02 15:04:05") }</span>
							<span class="badge badge-slate">{ h.ToStatus }</span>
							if h.Notes != "" {
								<span style="color:var(--neutral-600);">{ h.Notes }</span>
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}
