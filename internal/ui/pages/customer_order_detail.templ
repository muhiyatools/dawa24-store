package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func isStepDone(status commerce.OrderStatus, step int) bool {
	switch step {
	case 1:
		return true
	case 2:
		return status == commerce.StatusConfirmed || status == commerce.StatusProcessing || status == commerce.StatusShipped || status == commerce.StatusInTransit || status == commerce.StatusOutForDelivery || status == commerce.StatusDelivered || status == commerce.StatusCompleted
	case 3:
		return status == commerce.StatusShipped || status == commerce.StatusInTransit || status == commerce.StatusOutForDelivery || status == commerce.StatusDelivered || status == commerce.StatusCompleted
	case 4:
		return status == commerce.StatusDelivered || status == commerce.StatusCompleted
	default:
		return false
	}
}

func isStepActive(status commerce.OrderStatus, step int) bool {
	switch step {
	case 1:
		return status == commerce.StatusPending
	case 2:
		return status == commerce.StatusConfirmed || status == commerce.StatusProcessing
	case 3:
		return status == commerce.StatusShipped || status == commerce.StatusInTransit || status == commerce.StatusOutForDelivery
	case 4:
		return status == commerce.StatusDelivered || status == commerce.StatusCompleted
	default:
		return false
	}
}

func orderProgressWidth(status commerce.OrderStatus) string {
	switch status {
	case commerce.StatusPending:
		return "10%"
	case commerce.StatusConfirmed, commerce.StatusProcessing:
		return "40%"
	case commerce.StatusShipped, commerce.StatusInTransit, commerce.StatusOutForDelivery:
		return "75%"
	case commerce.StatusDelivered, commerce.StatusCompleted:
		return "100%"
	default:
		return "10%"
	}
}

func getAllOrderLines(order *commerce.Order) []*commerce.OrderLine {
	if order == nil {
		return nil
	}
	if len(order.Lines) > 0 {
		return order.Lines
	}
	var res []*commerce.OrderLine
	for _, sh := range order.Shipments {
		if sh != nil {
			res = append(res, sh.Lines...)
		}
	}
	return res
}

func unitDiscountMinor(l *commerce.OrderLine) int64 {
	if l == nil || l.Quantity <= 0 || l.DiscountAmount.IsZero() {
		return 0
	}
	return l.DiscountAmount.Minor() / int64(l.Quantity)
}

func minAllowedQty(l *commerce.OrderLine) int {
	if l == nil || l.MinOrderQty <= 1 {
		return 1
	}
	return l.MinOrderQty
}

func maxAllowedQty(l *commerce.OrderLine) int {
	if l == nil {
		return 99999
	}
	maxVal := 99999
	if l.MaxQtyPerOrder > 0 {
		maxVal = l.MaxQtyPerOrder
	}
	if l.AvailableStock > 0 && l.AvailableStock < maxVal {
		maxVal = l.AvailableStock
	}
	return maxVal
}

func orderTaxRate(order *commerce.Order) float64 {
	if order == nil || order.TaxAmount.IsZero() {
		return 0.0
	}
	taxable, _ := order.Subtotal.Sub(order.DiscountAmount)
	if taxable.IsPositive() {
		return float64(order.TaxAmount.Minor()) / float64(taxable.Minor())
	}
	return 0.0
}

templ CustomerOrderDetail(order *commerce.Order, history []*commerce.OrderStatusHistory, noticeType, noticeMsg, lang, dir string) {
	@layouts.CustomerShell(fmt.Sprintf("طلب توريد #%s", order.OrderNumber), "orders", lang, dir, nil) {
		<div class="page-container">
			
			<!-- Notice Feedback Banner -->
			if noticeMsg != "" {
				<div
					class={ "alert mb-4",
						templ.KV("alert-success", noticeType != "error"),
						templ.KV("alert-danger", noticeType == "error") }
					role="alert"
				>
					<div class="d-flex items-center gap-2">
						if noticeType == "error" {
							<span>@components.IconAlert("icon-sm")</span>
						} else {
							<span>@components.IconCheck("icon-sm")</span>
						}
						<span class="font-bold">{ noticeMsg }</span>
					</div>
				</div>
			}

			<!-- Breadcrumb & Quick Actions Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div>
						<nav class="d-flex items-center gap-2 text-xs text-muted mb-2">
							<a href="/" class="text-secondary text-decoration-none">الرئيسية</a>
							<span>/</span>
							<a href="/orders" class="text-secondary text-decoration-none">طلبياتي</a>
							<span>/</span>
							<span class="text-primary font-bold">طلب #{ order.OrderNumber }</span>
						</nav>
						<div class="d-flex items-center gap-3 flex-wrap">
							<div class="user-avatar-badge text-xl">
								@components.IconPackage("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0 tabular-nums">
								طلب توريد #{ order.OrderNumber }
							</h1>
							@components.StatusBadge(string(order.Status))
							if order.PaymentStatus == commerce.PaymentPaid {
								<span class="badge badge-emerald text-xs font-bold">مدفوع بالكامل</span>
							} else {
								<span class="badge badge-amber text-xs font-bold">دفع عند الاستلام</span>
							}
						</div>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap">
						<a href="/orders" class="btn btn-secondary btn-sm font-bold">
							<span>← العودة لطلبياتي</span>
						</a>
						if order.Status == commerce.StatusPending {
							<button type="button" class="btn btn-primary btn-sm font-bold gap-1" onclick="window.scrollToEditForm()">
								@components.IconEdit("icon-xs")
								<span>تعديل كميات الطلب</span>
							</button>
						} else {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", order.ID)) }
								target="_blank"
								class="btn btn-primary btn-sm font-bold gap-1"
								title="طباعة الفاتورة أو إيصال الكاشير"
							>
								@components.IconPrinter("icon-xs")
								<span>طباعة الفاتورة</span>
							</a>
						}
					</div>
				</div>
			</div>

			<!-- Main 2-Column Responsive Grid -->
			<div class="order-detail-layout mb-6">
				
				<!-- Right Column: Primary Details & Line Items -->
				<div class="d-flex flex-col gap-6">
					
					<!-- 1. Order Progress Timeline Card -->
					<div class="glass-panel p-6 mb-0">
						<div class="flex-between items-center mb-6 pb-3 border-b flex-wrap gap-2">
							<div class="d-flex items-center gap-2">
								<span class="text-xl">@components.IconTruck("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">
									مسار ومراحل التوريد
								</h2>
							</div>
							<span class="text-xs text-muted tabular-nums">
								تاريخ الطلب: { order.CreatedAt.Format("2006-01-02 15:04") }
							</span>
						</div>

						<!-- Steps Progress Bar -->
						<div class="order-progress-stepper">
							<!-- Connecting track -->
							<div class="order-progress-track">
								<div class="order-progress-bar" style={ "width:" + orderProgressWidth(order.Status) + ";" }></div>
							</div>

							<!-- Step 1: Placed -->
							<div class="order-step-item">
								<div class="order-step-badge done">
									@components.IconCheck("icon-sm")
								</div>
								<div class="font-extrabold text-xs text-primary">تم استلام الطلب</div>
								<div class="text-xs text-muted mt-1 tabular-nums">
									{ order.CreatedAt.Format("15:04") }
								</div>
							</div>

							<!-- Step 2: Processing -->
							<div class="order-step-item">
								if isStepDone(order.Status, 2) {
									<div class="order-step-badge done">
										@components.IconCheck("icon-sm")
									</div>
								} else {
									<div class="order-step-badge pending">
										@components.IconPackage("icon-sm")
									</div>
								}
								<div class="font-extrabold text-xs text-primary">التجهيز المخزني</div>
								<div class="text-xs text-muted mt-1">فحص التشغيلات والتبريد</div>
							</div>

							<!-- Step 3: Out for Delivery -->
							<div class="order-step-item">
								if isStepDone(order.Status, 3) {
									<div class="order-step-badge done">
										@components.IconCheck("icon-sm")
									</div>
								} else {
									<div class="order-step-badge pending">
										@components.IconTruck("icon-sm")
									</div>
								}
								<div class="font-extrabold text-xs text-primary">الشحن والتوصيل</div>
								<div class="text-xs text-muted mt-1">مع المندوب المبرد</div>
							</div>

							<!-- Step 4: Delivered -->
							<div class="order-step-item">
								if isStepDone(order.Status, 4) {
									<div class="order-step-badge completed">
										@components.IconCheck("icon-sm")
									</div>
								} else {
									<div class="order-step-badge pending">
										@components.IconBuilding("icon-sm")
									</div>
								}
								<div class="font-extrabold text-xs text-primary">تم الاستلام</div>
								<div class="text-xs text-muted mt-1">تسليم الصيدلية الموثق</div>
							</div>
						</div>
					</div>

					<!-- Delivery Confirmation Code PIN Banner (for Pharmacy Recipient) -->
					for _, sh := range order.Shipments {
						if sh != nil && sh.DeliveryCode != "" && sh.Status != commerce.StatusDelivered && sh.Status != commerce.StatusCompleted && sh.Status != commerce.StatusCancelled {
							<div class="glass-panel p-5 mb-0 border-2 border-emerald-500/80 bg-emerald-50/20 rounded-2xl shadow-xs">
								<div class="flex-between items-center flex-wrap gap-4">
									<div class="d-flex items-center gap-3">
										<div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 d-flex items-center justify-center shadow-2xs">
											@components.IconShield("icon-md")
										</div>
										<div>
											<div class="d-flex items-center gap-2">
												<h3 class="text-sm font-black text-emerald-950 m-0">
													كود تأكيد الاستلام الخاص بك (Delivery PIN)
												</h3>
												<span class="badge badge-emerald text-2xs font-extrabold">سري للصيدلية</span>
											</div>
											<p class="text-xs text-emerald-800 m-0 mt-1 font-medium max-w-md leading-relaxed">
												أعطِ هذا الكود لمندوب الشحن فقط عند وصوله لمقر الصيدلية وفحص واستلام كامل الأصناف وسداد القيمة.
											</p>
										</div>
									</div>

									<div class="text-center bg-white p-3 px-5 rounded-xl border border-emerald-300 shadow-xs">
										<span class="text-2xs text-secondary font-bold d-block mb-1">كود التسليم للمندوب:</span>
										<div class="text-2xl font-black text-emerald-700 font-mono tracking-widest tabular-nums select-all">
											{ sh.DeliveryCode }
										</div>
									</div>
								</div>
							</div>
						}
					}

					<!-- 2. Shipments & Line Items Table Card -->
					<div class="glass-panel p-6 mb-0" id="order-lines-container">
						<div class="flex-between items-center mb-4 flex-wrap gap-3 pb-3 border-b">
							<div class="d-flex items-center gap-2">
								<span class="text-xl">@components.IconPill("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">
									الأصناف والشحنات الدوائية المطلوبة
								</h2>
							</div>
							<div class="d-flex items-center gap-2 flex-wrap">
								if order.Status == commerce.StatusPending {
									<span class="badge badge-amber text-xs font-black">
										<span>تعديل الكميات متاح ومحفوظ في قاعدة البيانات</span>
									</span>
									<button type="button" class="btn btn-secondary btn-xs font-bold gap-1" onclick="window.openOrderEditModal()">
										<span>إضافة / حذف صنف</span>
									</button>
								} else {
									<span class="badge badge-slate text-xs font-bold" title="لا يمكن تعديل الطلب بعد قبوله أو معالجته من المورد">
										<span>الطلب مؤكد ولا يمكن تعديله</span>
									</span>
								}
								<span class="badge badge-sky text-xs font-bold">
									<span>نقل دوائي مبرد معتمد (2-8°C)</span>
								</span>
							</div>
						</div>

						if len(order.Shipments) == 0 && len(order.Lines) == 0 {
							@components.EmptyState(components.EmptyStateProps{
								Title:   "جاري تجهيز الشحنات",
								Message: "يقوم الموردون حالياً بتجهيز تفاصيل الشحن وأرقام التشغيلات.",
							})
						} else {
							<!-- Direct & Editable Order Lines Form -->
							if order.Status == commerce.StatusPending {
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orders/%d/edit", order.ID)) } id="main-order-lines-form">
									if len(order.Shipments) > 0 {
										<!-- Grouped by Shipment / Vendor -->
										<div>
											for idx, sh := range order.Shipments {
												<div>
													<!-- Shipment Header -->
													<div>
														<div class="inline-row-06">
															<span class="badge badge-primary text-xs fw-800 tabular-nums">طرد { fmt.Sprintf("%d", idx+1) }</span>
															<strong>
																{ sh.VendorName.Get(i18n.Lang(lang)) }
															</strong>
															<span>
																(رقم الشحنة: <span class="tabular-nums font-mono">{ sh.ShipmentNumber }</span>)
															</span>
														</div>
														<div class="d-flex items-center gap-2">
															if sh.TrackingNumber != "" {
																<span class="badge badge-slate text-xs font-mono">بوليصة: { sh.TrackingNumber }</span>
															}
															@components.StatusBadge(string(sh.Status))
														</div>
													</div>

													<!-- Shipment Lines Table -->
													<div class="table-container m-0">
														<table class="data-table m-0">
															<thead>
																<tr>
																	<th>الصنف الدوائي</th>
																	<th class="text-center">الكمية المطلوبة</th>
																	<th class="text-end">سعر الجمهور</th>
																	<th class="text-center">نسبة الخصم</th>
																	<th class="text-end">السعر بعد الخصم (الإجمالي)</th>
																	<th class="text-center"></th>
																</tr>
															</thead>
															<tbody>
																for _, l := range sh.Lines {
																	<tr
																		class="order-table-row"
																		data-line-id={ fmt.Sprintf("%d", l.ID) }
																		data-unit-price-minor={ fmt.Sprintf("%d", l.UnitPrice.Minor()) }
																		data-unit-discount-minor={ fmt.Sprintf("%d", unitDiscountMinor(l)) }
																		data-min-qty={ fmt.Sprintf("%d", minAllowedQty(l)) }
																		data-max-qty={ fmt.Sprintf("%d", maxAllowedQty(l)) }
																		data-available-stock={ fmt.Sprintf("%d", l.AvailableStock) }
																	>
																		<td>
																			<div class="font-extrabold text-primary text-xs">
																				{ l.ProductName.Get(i18n.Lang(lang)) }
																			</div>
																			if l.VariantName.Get(i18n.Lang(lang)) != "" || l.SKU != "" {
																				<div class="text-xs text-muted mt-1">
																					if l.VariantName.Get(i18n.Lang(lang)) != "" {
																						<span>{ l.VariantName.Get(i18n.Lang(lang)) }</span>
																					}
																					if l.SKU != "" {
																						<span class="font-mono text-xs ms-1">SKU: { l.SKU }</span>
																					}
																				</div>
																			}
																			if l.AvailableStock > 0 {
																				<div class="mt-1">
																					<span class="badge badge-emerald text-xs font-bold">
																						المتوفر لدى المورد: { fmt.Sprintf("%d", l.AvailableStock) } قطعة
																					</span>
																				</div>
																			}
																			<input type="hidden" name="line_id[]" value={ fmt.Sprintf("%d", l.ID) }/>
																			<input type="hidden" name="product_name[]" value={ l.ProductName.Get(i18n.Lang(lang)) }/>
																			<input type="hidden" name="unit_price[]" value={ l.UnitPrice.String() } class="row-unit-price-input"/>
																			<input type="hidden" name="discount_amount[]" value={ l.DiscountAmount.String() } class="row-discount-input"/>
																			<input type="hidden" name="is_deleted[]" value="0" class="row-deleted-input"/>
																		</td>
																		<td class="text-center">
																			<!-- Direct Quantity Stepper: [ - ] 10 [ + ] -->
																			<div class="d-flex items-center gap-1 justify-center">
																				<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold" onclick="stepRowQty(this, -1)" title="إنقاص الكمية">−</button>
																				<input
																					type="number"
																					name="quantity[]"
																					value={ fmt.Sprintf("%d", l.Quantity) }
																					min={ fmt.Sprintf("%d", minAllowedQty(l)) }
																					if maxAllowedQty(l) < 99999 {
																						max={ fmt.Sprintf("%d", maxAllowedQty(l)) }
																					}
																					required
																					class="form-input text-xs tabular-nums text-center row-qty-input font-bold"
																				
																					oninput="recalcRowTotal(this)"
																				/>
																				<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold" onclick="stepRowQty(this, 1)" title="زيادة الكمية">+</button>
																			</div>
																		</td>
																		<td class="text-end tabular-nums font-bold text-xs text-primary">
																			{ l.UnitPrice.String() } ج.م
																		</td>
																		<td class="text-center tabular-nums">
																			{{
																				discPct := 0.0
																				if l.UnitPrice.IsPositive() && l.DiscountAmount.IsPositive() {
																					discPct = (float64(l.DiscountAmount.Minor()) / float64(l.UnitPrice.Minor())) * 100.0
																				}
																			}}
																			if discPct > 0 {
																				<span class="badge badge-emerald text-xs font-bold tabular-nums">{ fmt.Sprintf("%.1f%%", discPct) }</span>
																			} else {
																				<span class="text-xs text-muted">0%</span>
																			}
																		</td>
																		<td class="text-end tabular-nums font-black text-brand text-xs">
																			<span class="row-total-display">{ l.TotalPrice.String() } ج.م</span>
																		</td>
																		<td class="text-center">
																			<button type="button" class="btn btn-secondary btn-icon btn-sm text-danger" onclick="deleteRowLine(this)" title="حذف الصنف من الطلب">
																				@components.IconX("icon-sm")
																			</button>
																		</td>
																	</tr>
																}
															</tbody>
														</table>
													</div>
												</div>
											}
										</div>
									} else {
										<!-- Direct Flat Lines Table -->
										<div class="table-container m-0">
											<table class="data-table m-0">
												<thead>
													<tr>
														<th>الصنف الدوائي</th>
														<th class="text-center">الكمية المطلوبة</th>
														<th class="text-end">سعر الجمهور</th>
														<th class="text-center">نسبة الخصم</th>
														<th class="text-end">السعر بعد الخصم (الإجمالي)</th>
														<th class="text-center"></th>
													</tr>
												</thead>
												<tbody>
													for _, l := range order.Lines {
														<tr
															class="order-table-row"
															data-line-id={ fmt.Sprintf("%d", l.ID) }
															data-unit-price-minor={ fmt.Sprintf("%d", l.UnitPrice.Minor()) }
															data-unit-discount-minor={ fmt.Sprintf("%d", unitDiscountMinor(l)) }
															data-min-qty={ fmt.Sprintf("%d", minAllowedQty(l)) }
															data-max-qty={ fmt.Sprintf("%d", maxAllowedQty(l)) }
															data-available-stock={ fmt.Sprintf("%d", l.AvailableStock) }
														>
															<td>
																<div class="font-extrabold text-primary text-xs">
																	{ l.ProductName.Get(i18n.Lang(lang)) }
																</div>
																if l.VariantName.Get(i18n.Lang(lang)) != "" || l.SKU != "" {
																	<div class="text-xs text-muted mt-1">
																		if l.VariantName.Get(i18n.Lang(lang)) != "" {
																			<span>{ l.VariantName.Get(i18n.Lang(lang)) }</span>
																		}
																		if l.SKU != "" {
																			<span class="font-mono text-xs ms-1">SKU: { l.SKU }</span>
																		}
																	</div>
																}
																if l.AvailableStock > 0 {
																	<div class="mt-1">
																		<span class="badge badge-emerald text-xs font-bold">
																			المتوفر لدى المورد: { fmt.Sprintf("%d", l.AvailableStock) } قطعة
																		</span>
																	</div>
																}
																<input type="hidden" name="line_id[]" value={ fmt.Sprintf("%d", l.ID) }/>
																<input type="hidden" name="product_name[]" value={ l.ProductName.Get(i18n.Lang(lang)) }/>
																<input type="hidden" name="unit_price[]" value={ l.UnitPrice.String() } class="row-unit-price-input"/>
																<input type="hidden" name="discount_amount[]" value={ l.DiscountAmount.String() } class="row-discount-input"/>
																<input type="hidden" name="is_deleted[]" value="0" class="row-deleted-input"/>
															</td>
															<td class="text-center">
																<!-- Direct Quantity Stepper: [ - ] 10 [ + ] -->
																<div class="d-flex items-center gap-1 justify-center">
																	<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold" onclick="stepRowQty(this, -1)" title="إنقاص الكمية">−</button>
																	<input
																		type="number"
																		name="quantity[]"
																		value={ fmt.Sprintf("%d", l.Quantity) }
																		min={ fmt.Sprintf("%d", minAllowedQty(l)) }
																		if maxAllowedQty(l) < 99999 {
																			max={ fmt.Sprintf("%d", maxAllowedQty(l)) }
																		}
																		required
																		class="form-input text-xs tabular-nums text-center row-qty-input font-bold"
																	
																		oninput="recalcRowTotal(this)"
																	/>
																	<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold" onclick="stepRowQty(this, 1)" title="زيادة الكمية">+</button>
																</div>
															</td>
															<td class="text-end tabular-nums font-bold text-xs text-primary">
																{ l.UnitPrice.String() } ج.م
															</td>
															<td class="text-center tabular-nums">
																{{
																	discPct := 0.0
																	if l.UnitPrice.IsPositive() && l.DiscountAmount.IsPositive() {
																		discPct = (float64(l.DiscountAmount.Minor()) / float64(l.UnitPrice.Minor())) * 100.0
																	}
																}}
																if discPct > 0 {
																	<span class="badge badge-emerald text-xs font-bold tabular-nums">{ fmt.Sprintf("%.1f%%", discPct) }</span>
																} else {
																	<span class="text-xs text-muted">0%</span>
																}
															</td>
															<td class="text-end tabular-nums font-black text-brand text-xs">
																<span class="row-total-display">{ l.TotalPrice.String() } ج.م</span>
															</td>
															<td class="text-center">
																<button type="button" class="btn btn-secondary btn-icon btn-sm text-danger" onclick="deleteRowLine(this)" title="حذف الصنف من الطلب">
																	@components.IconX("icon-sm")
																</button>
															</td>
														</tr>
													}
												</tbody>
											</table>
										</div>
									}

									<!-- Save Edits Action Bar -->
									<div class="glass-panel p-4 flex-between items-center mt-4 flex-wrap gap-3 border-brand-subtle">
										<div class="d-flex items-center gap-3 text-xs text-secondary flex-wrap">
											<span class="badge badge-amber font-bold">قيد المراجعة</span>
											<span>تم تعديل الكميات مباشرة: سيتم حفظ التعديلات وإعادة حساب الإجمالي الصافي فوراً.</span>
											<span class="text-brand font-black ms-2 tabular-nums">الإجمالي الصافي: <span id="form-bar-total">{ order.TotalAmount.String() } ج.م</span></span>
										</div>
										<div class="d-flex items-center gap-2">
											<button type="submit" id="save-order-lines-btn" class="btn btn-primary font-bold text-xs px-5 py-2 gap-2 shadow-sm">
												@components.IconCheck("icon-xs")
												<span>حفظ تعديلات الكميات وتحديث الفاتورة</span>
											</button>
										</div>
									</div>
								</form>
							} else {
								<!-- Read-Only Locked Table for Confirmed / Processed Orders -->
								if len(order.Shipments) > 0 {
									<div class="d-flex flex-col gap-4">
										for idx, sh := range order.Shipments {
											<div class="glass-panel p-0 mb-0 overflow-hidden">
												<div class="flex-between items-center p-3 px-4 bg-surface-sunken border-b flex-wrap gap-2">
													<div class="d-flex items-center gap-2">
														<span class="badge badge-primary text-xs font-bold tabular-nums">طرد { fmt.Sprintf("%d", idx+1) }</span>
														<strong class="text-xs font-extrabold text-primary">
															{ sh.VendorName.Get(i18n.Lang(lang)) }
														</strong>
													</div>
													<div class="d-flex items-center gap-2 flex-wrap">
														if sh.TrackingNumber != "" {
															<span class="badge badge-slate text-xs font-mono">بوليصة: { sh.TrackingNumber }</span>
														}
														if sh.DeliveryCode != "" && sh.Status != commerce.StatusDelivered && sh.Status != commerce.StatusCompleted && sh.Status != commerce.StatusCancelled {
															<span class="badge badge-emerald text-xs font-black font-mono tracking-wider shadow-2xs">
																كود الاستلام: { sh.DeliveryCode }
															</span>
														}
														@components.StatusBadge(string(sh.Status))
													</div>
												</div>
												<div class="table-container m-0">
													<table class="data-table m-0">
														<thead>
															<tr>
																<th>الصنف الدوائي</th>
																<th class="text-center">الكمية</th>
																<th class="text-end">السعر</th>
																<th class="text-end">الخصم</th>
																<th class="text-end">الإجمالي</th>
															</tr>
														</thead>
														<tbody>
															for _, l := range sh.Lines {
																<tr>
																	<td>
																		<div class="font-extrabold text-primary text-xs">
																			{ l.ProductName.Get(i18n.Lang(lang)) }
																		</div>
																	</td>
																	<td class="text-center">
																		<span class="tabular-nums font-bold text-xs p-1 px-2 rounded bg-surface border">
																			{ fmt.Sprintf("%d", l.Quantity) }
																		</span>
																	</td>
																	<td class="text-end tabular-nums text-xs text-primary font-bold">
																		{ l.UnitPrice.String() } ج.م
																	</td>
																	<td class="text-end tabular-nums text-xs text-success font-bold">
																		{ l.DiscountAmount.String() } ج.م
																	</td>
																	<td class="text-end tabular-nums font-black text-brand text-xs">
																		{ l.TotalPrice.String() } ج.م
																	</td>
																</tr>
															}
														</tbody>
													</table>
												</div>
											</div>
										}
									</div>
								} else {
									<div class="table-container m-0">
										<table class="data-table m-0">
											<thead>
												<tr>
													<th>الصنف الدوائي</th>
													<th class="text-center">الكمية</th>
													<th class="text-end">السعر</th>
													<th class="text-end">الخصم</th>
													<th class="text-end">الإجمالي</th>
												</tr>
											</thead>
											<tbody>
												for _, l := range order.Lines {
													<tr>
														<td>
															<div class="font-extrabold text-primary text-xs">
																{ l.ProductName.Get(i18n.Lang(lang)) }
															</div>
														</td>
														<td class="text-center">
															<span class="tabular-nums font-bold text-xs p-1 px-2 rounded bg-surface border">
																{ fmt.Sprintf("%d", l.Quantity) }
															</span>
														</td>
														<td class="text-end tabular-nums text-xs text-primary font-bold">
															{ l.UnitPrice.String() } ج.م
														</td>
														<td class="text-end tabular-nums text-xs text-success font-bold">
															{ l.DiscountAmount.String() } ج.م
														</td>
														<td class="text-end tabular-nums font-black text-brand text-xs">
															{ l.TotalPrice.String() } ج.م
														</td>
													</tr>
												}
											</tbody>
										</table>
									</div>
								}
							}
						}
					</div>

					<!-- 3. Status History Timeline -->
					if len(history) > 0 {
						<div class="glass-panel p-6 mb-0">
							<div class="d-flex items-center gap-2 mb-4 pb-3 border-b">
								<span class="text-xl">@components.IconFileText("icon-sm")</span>
								<h2 class="text-base font-extrabold text-primary m-0">
									سجل حركات وتحديثات الطلب
								</h2>
							</div>

							<div class="d-flex flex-col gap-3">
								for _, h := range history {
									<div class="p-3 rounded-lg bg-surface-sunken border d-flex items-start justify-between flex-wrap gap-2 text-xs">
										<div class="d-flex items-center gap-2">
											@components.StatusBadge(h.ToStatus)
											if h.Notes != "" {
												<span class="text-secondary font-medium">{ h.Notes }</span>
											}
										</div>
										<span class="text-muted tabular-nums">{ h.CreatedAt.Format("2006-01-02 15:04:05") }</span>
									</div>
								}
							</div>
						</div>
					}

				</div>

				<!-- Left Column: Summary & Metadata -->
				<div class="d-flex flex-col gap-6">
					
					<!-- 1. Financial Summary Card -->
					<div class="glass-panel p-6 mb-0">
						<div class="d-flex items-center gap-2 mb-4 pb-3 border-b">
							<span class="text-xl">@components.IconFileText("icon-sm")</span>
							<h2 class="text-base font-extrabold text-primary m-0">
								الملخص المالي للفاتورة
							</h2>
						</div>

						<div class="d-flex flex-col gap-3 text-xs">
							<div class="flex-between items-center">
								<span class="text-secondary">إجمالي الأصناف:</span>
								<span id="live-summary-subtotal" class="tabular-nums font-bold text-primary">
									if order.Subtotal.Minor() > 0 {
										{ order.Subtotal.String() } ج.م
									} else {
										{ order.TotalAmount.String() } ج.م
									}
								</span>
							</div>

							<div class="flex-between items-center text-success">
								<span>إجمالي الخصم الممنوح:</span>
								<span id="live-summary-discount" class="tabular-nums font-bold">
									if order.TotalDiscount.Minor() > 0 {
										- { order.TotalDiscount.String() } ج.م
									} else if order.DiscountAmount.Minor() > 0 {
										- { order.DiscountAmount.String() } ج.م
									} else {
										0.00 ج.م
									}
								</span>
							</div>

							<div class="flex-between items-center" id="order-summary-shipping" data-shipping-minor={ fmt.Sprintf("%d", order.ShippingFee.Minor()) }>
								<span class="text-secondary">مصاريف الشحن والتوصيل:</span>
								<span class="tabular-nums font-bold text-primary">
									if order.ShippingFee.Minor() > 0 {
										{ order.ShippingFee.String() } ج.م
									} else {
										<span class="text-emerald font-bold">مجاناً</span>
									}
								</span>
							</div>

							if order.TaxAmount.Minor() > 0 {
								<div class="flex-between items-center" id="order-summary-tax" data-tax-rate={ fmt.Sprintf("%.4f", orderTaxRate(order)) }>
									<span class="text-secondary">ضريبة القيمة المضافة:</span>
									<span id="live-summary-tax" class="tabular-nums font-bold text-primary">{ order.TaxAmount.String() } ج.م</span>
								</div>
							}

							<div class="border-t my-1"></div>

							<div class="flex-between items-baseline">
								<span class="font-extrabold text-primary text-sm">المبلغ الصافي المستحق:</span>
								<div class="text-2xl font-black text-brand tabular-nums">
									<span id="live-summary-total">{ order.TotalAmount.String() }</span> <span class="text-xs font-bold text-secondary">ج.م</span>
								</div>
							</div>

							<!-- Payment method pill -->
							<div class="mt-2 p-3 rounded-lg bg-surface-sunken border text-xs">
								<div class="flex-between items-center mb-1">
									<span class="text-muted">طريقة الدفع:</span>
									<span class="font-bold text-primary">
										if order.PaymentMethod == "cod" || order.PaymentMethod == "" {
											<span>دفع عند الاستلام (COD)</span>
										} else {
											<span>{ order.PaymentMethod }</span>
										}
									</span>
								</div>
								<div class="flex-between items-center">
									<span class="text-muted">حالة السداد:</span>
									if order.PaymentStatus == commerce.PaymentPaid {
										<span class="text-emerald font-bold">مدفوع بالكامل</span>
									} else {
										<span class="text-amber font-bold">مستحق عند الاستلام</span>
									}
								</div>
							</div>

							<!-- Print invoice button CTA -->
							<div class="mt-2">
								if order.Status != commerce.StatusPending {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/orders/%d/invoice/print", order.ID)) }
										target="_blank"
										class="btn btn-primary w-full justify-center font-bold text-xs py-2 gap-1"
									>
										@components.IconPrinter("icon-xs")
										<span>طباعة الفاتورة</span>
									</a>
								} else {
									<div class="bg-surface-sunken border border-dashed rounded-lg p-3 text-center text-xs text-muted">
										<span>تتاح طباعة الفاتورة فور تأكيد وقبول المورد للطلب</span>
									</div>
								}
							</div>
						</div>
					</div>

					<!-- 2. Pharmacy Receiving Branch Card -->
					<div class="glass-panel p-6 mb-0">
						<div class="d-flex items-center gap-2 mb-4 pb-3 border-b">
							<span class="text-xl">@components.IconBuilding("icon-sm")</span>
							<h2 class="text-base font-extrabold text-primary m-0">
								بيانات فرع الاستلام
							</h2>
						</div>

						<div class="d-flex flex-col gap-3 text-xs">
							<div>
								<div class="text-muted font-bold mb-1">فرع الصيدلية:</div>
								<div class="text-primary font-bold">
									if order.CustomerBranchName.Get(i18n.Lang(lang)) != "" {
										{ order.CustomerBranchName.Get(i18n.Lang(lang)) }
									} else {
										<span>الفرع الرئيسي للصيدلية</span>
									}
								</div>
							</div>

							if order.CustomerManagerName != "" {
								<div>
									<div class="text-muted font-bold mb-1">الصيدلي المسؤول:</div>
									<div class="text-primary font-bold">{ order.CustomerManagerName }</div>
								</div>
							}

							if order.CustomerBranchPhone != "" {
								<div>
									<div class="text-muted font-bold mb-1">هاتف الفرع:</div>
									<div class="text-primary font-bold tabular-nums font-mono">{ order.CustomerBranchPhone }</div>
								</div>
							}

							<div>
								<div class="text-muted font-bold mb-1">عنوان التوصيل المسجل:</div>
								<div class="text-secondary leading-relaxed">
									if order.CustomerBranchAddress != "" {
										{ order.CustomerBranchAddress }
									} else {
										<span class="text-muted">العنوان المسجل في ملف المنشأة</span>
									}
								</div>
							</div>

							if order.Notes != "" {
								<div class="mt-1 p-3 rounded-lg bg-surface-sunken border">
									<div class="text-muted font-bold mb-1">ملاحظات خاصة بالتسليم:</div>
									<div class="text-primary text-xs">{ order.Notes }</div>
								</div>
							}
						</div>
					</div>

					<!-- 3. Quality & Cold-Chain Badge Card -->
					<div class="glass-panel p-4 mb-0 text-xs d-flex flex-col gap-2 border-brand-subtle">
						<div class="d-flex items-center gap-2 font-black text-brand">
							<span>❄️</span>
							<span>معايير النقل المبرد المعتمد</span>
						</div>
						<p class="m-0 text-secondary leading-relaxed">
							تخضع كافة الشحنات لرقابة درجات الحرارة وسلسلة التبريد الموثقة لضمان فاعلية ومأمونية الأصناف الدوائية.
						</p>
					</div>

				</div>

			</div>

			<!-- Edit Order Modal (Only rendered/available when order is pending) -->
			if order.Status == commerce.StatusPending {
				@components.Modal(components.ModalProps{
					ID:       "order-edit-modal",
					Title:    fmt.Sprintf("تعديل أصناف وكميات الطلب #%s", order.OrderNumber),
					Subtitle: "يمكنك تعديل كميات الأصناف أو إضافة صنف جديد يدوياً، وسيقوم النظام بتحديث الفاتورة فوراً",
					Size:     "xl",
					Icon:     "edit",
				}) {
					<!-- Form -->
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orders/%d/edit", order.ID)) } id="order-edit-form" class="d-flex flex-col overflow-y-auto p-6 gap-4">
						<!-- Table of lines -->
						<div class="table-container m-0">
							<table class="data-table m-0" id="edit-lines-table">
								<thead>
									<tr>
										<th>الصنف الدوائي</th>
										<th class="text-center">الكمية</th>
										<th class="text-end">سعر الوحدة</th>
										<th class="text-end">الخصم</th>
										<th class="text-end">الإجمالي</th>
										<th class="text-center"></th>
									</tr>
								</thead>
								<tbody id="edit-lines-tbody">
									for _, line := range getAllOrderLines(order) {
										<tr
											class="edit-line-row"
											data-unit-price-minor={ fmt.Sprintf("%d", line.UnitPrice.Minor()) }
											data-unit-discount-minor={ fmt.Sprintf("%d", unitDiscountMinor(line)) }
											data-min-qty={ fmt.Sprintf("%d", minAllowedQty(line)) }
											data-max-qty={ fmt.Sprintf("%d", maxAllowedQty(line)) }
										>
											<td>
												<input type="hidden" name="line_id[]" value={ fmt.Sprintf("%d", line.ID) }/>
												<input type="hidden" name="is_deleted[]" value="0" class="line-deleted-input"/>
												<input type="text" name="product_name[]" value={ line.ProductName.Get(i18n.Lang(lang)) } required class="form-input text-xs w-full font-bold"/>
												if line.AvailableStock > 0 {
													<div class="text-xs text-emerald font-bold mt-1">
														المتوفر: { fmt.Sprintf("%d", line.AvailableStock) } قطعة
													</div>
												}
											</td>
											<td>
												<div class="d-flex items-center gap-1 justify-center">
													<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold" onclick="window.stepQty(this, -1)">−</button>
													<input
														type="number"
														name="quantity[]"
														value={ fmt.Sprintf("%d", line.Quantity) }
														min={ fmt.Sprintf("%d", minAllowedQty(line)) }
														if maxAllowedQty(line) < 99999 {
															max={ fmt.Sprintf("%d", maxAllowedQty(line)) }
														}
														required
														class="form-input text-xs tabular-nums text-center line-qty-input font-bold"
													
														oninput="window.recalcEditOrder()"
													/>
													<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold" onclick="window.stepQty(this, 1)">+</button>
												</div>
											</td>
											<td class="text-end">
												<input type="text" name="unit_price[]" value={ line.UnitPrice.String() } required class="form-input text-xs tabular-nums line-unit-price text-end font-bold" oninput="window.recalcEditOrder()"/>
											</td>
											<td class="text-end">
												<input type="text" name="discount_amount[]" value={ line.DiscountAmount.String() } class="form-input text-xs tabular-nums line-disc-amount text-end" oninput="window.recalcEditOrder()"/>
											</td>
											<td class="text-end tabular-nums font-black text-brand text-xs">
												<span class="line-total-cell">{ line.TotalPrice.String() }</span>
											</td>
											<td class="text-center">
												<button type="button" class="btn btn-secondary btn-icon btn-sm text-danger" title="حذف الصنف" onclick="window.deleteEditRow(this)">
													@components.IconTrash("icon-sm")
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<!-- Button to add new line row -->
						<div class="d-flex justify-start">
							<button type="button" class="btn btn-secondary btn-sm font-bold gap-1 border-dashed" onclick="window.addNewEditRow()">
								<span>إضافة صنف جديد يدوياً للطلب</span>
							</button>
						</div>

						<!-- Notes -->
						<div>
							<label class="form-label text-xs font-bold text-secondary mb-1">ملاحظات الصيدلية بخصوص التعديل (اختياري)</label>
							<input type="text" name="notes" placeholder="اكتب توضيح للمورد بخصوص تعديل الكميات أو الأصناف..." class="form-input text-xs w-full"/>
						</div>

						<!-- Summary Box -->
						<div class="glass-panel p-4 flex-between items-center flex-wrap gap-3">
							<div class="d-flex gap-4 flex-wrap text-xs">
								<div>
									<span class="text-secondary">إجمالي الأصناف:</span>
									<strong id="edit-subtotal-val" class="tabular-nums text-primary ms-1">{ order.Subtotal.String() }</strong> ج.م
								</div>
								<div>
									<span class="text-success">إجمالي الخصم:</span>
									<strong id="edit-discount-val" class="tabular-nums text-success ms-1">-{ order.DiscountAmount.String() }</strong> ج.م
								</div>
							</div>
							<div class="d-flex items-baseline gap-2">
								<span class="font-extrabold text-xs text-primary">المبلغ الصافي الجديد:</span>
								<span id="edit-grandtotal-val" class="tabular-nums text-xl font-black text-brand">{ order.TotalAmount.String() }</span>
								<span class="text-xs text-secondary font-bold">ج.م</span>
							</div>
						</div>

						<!-- Modal Footer Actions -->
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary font-bold text-xs" onclick="window.closeOrderEditModal()">إلغاء</button>
							<button type="submit" class="btn btn-primary text-xs font-bold px-4 gap-1">
								@components.IconCheck("icon-xs")
								<span>حفظ وتحديث الطلب</span>
							</button>
						</div>
					</form>
				}

				<script>
					window.scrollToEditForm = function() {
						const el = document.getElementById('order-lines-container');
						if (el) {
							el.scrollIntoView({ behavior: 'smooth', block: 'start' });
						}
						const firstInput = document.querySelector('.row-qty-input');
						if (firstInput) {
							firstInput.focus();
							firstInput.select();
						}
					};

					window.stepRowQty = function(btn, delta) {
						const tr = btn.closest('.order-table-row');
						if (!tr) return;
						const input = tr.querySelector('.row-qty-input');
						if (!input) return;

						const minVal = parseInt(tr.getAttribute('data-min-qty'), 10) || 1;
						const maxVal = parseInt(tr.getAttribute('data-max-qty'), 10) || 99999;

						let val = parseInt(input.value, 10) || minVal;
						val += delta;
						if (val < minVal) val = minVal;
						if (val > maxVal) {
							val = maxVal;
							alert('الكمية المطلوبة تتجاوز الحد الأقصى المتاح لدى المورد (' + maxVal + ' قطعة).');
						}

						input.value = val;
						window.recalcRowTotal(input);
					};

					window.recalcRowTotal = function(input) {
						const tr = input.closest('.order-table-row');
						if (!tr) return;

						const minVal = parseInt(tr.getAttribute('data-min-qty'), 10) || 1;
						const maxVal = parseInt(tr.getAttribute('data-max-qty'), 10) || 99999;

						let qty = parseInt(input.value, 10);
						if (isNaN(qty) || qty < minVal) {
							qty = minVal;
						}
						if (qty > maxVal) {
							qty = maxVal;
							input.value = maxVal;
							alert('الكمية المطلوبة تتجاوز الحد الأقصى المتاح لدى المورد (' + maxVal + ' قطعة).');
						}

						const priceMinor = parseInt(tr.getAttribute('data-unit-price-minor'), 10) || 0;
						const discMinor = parseInt(tr.getAttribute('data-unit-discount-minor'), 10) || 0;

						const effectivePriceMinor = Math.max(0, priceMinor - discMinor);
						const lineTotalMinor = effectivePriceMinor * qty;

						const totalDisplay = tr.querySelector('.row-total-display');
						if (totalDisplay) {
							totalDisplay.textContent = (lineTotalMinor / 100).toFixed(2) + ' ج.م';
						}

						window.recalcOrderLiveTotals();
					};

					window.recalcOrderLiveTotals = function() {
						const rows = document.querySelectorAll('.order-table-row');
						let subtotalMinor = 0;
						let discountMinor = 0;

						rows.forEach(tr => {
							const delInput = tr.querySelector('.row-deleted-input');
							if (delInput && delInput.value === "1") return;
							if (tr.style.display === 'none') return;

							const qtyInput = tr.querySelector('.row-qty-input');
							const priceMinor = parseInt(tr.getAttribute('data-unit-price-minor'), 10) || 0;
							const discMinor = parseInt(tr.getAttribute('data-unit-discount-minor'), 10) || 0;

							const qty = parseInt(qtyInput ? qtyInput.value : 1, 10) || 0;
							subtotalMinor += (priceMinor * qty);
							discountMinor += (discMinor * qty);
						});

						const taxableMinor = Math.max(0, subtotalMinor - discountMinor);
						const shippingMinor = parseInt(document.getElementById('order-summary-shipping')?.getAttribute('data-shipping-minor') || '0', 10) || 0;
						const taxRate = parseFloat(document.getElementById('order-summary-tax')?.getAttribute('data-tax-rate') || '0') || 0;

						const taxMinor = Math.round(taxableMinor * taxRate);
						const totalMinor = taxableMinor + shippingMinor + taxMinor;

						const subEl = document.getElementById('live-summary-subtotal');
						if (subEl) subEl.textContent = (subtotalMinor / 100).toFixed(2) + ' ج.م';

						const discEl = document.getElementById('live-summary-discount');
						if (discEl) discEl.textContent = (discountMinor > 0 ? '-' : '') + (discountMinor / 100).toFixed(2) + ' ج.م';

						const taxEl = document.getElementById('live-summary-tax');
						if (taxEl) taxEl.textContent = (taxMinor / 100).toFixed(2) + ' ج.م';

						const totalEl = document.getElementById('live-summary-total');
						if (totalEl) totalEl.textContent = (totalMinor / 100).toFixed(2);

						const barTotalEl = document.getElementById('form-bar-total');
						if (barTotalEl) barTotalEl.textContent = (totalMinor / 100).toFixed(2) + ' ج.م';
					};

					window.deleteRowLine = function(btn) {
						if (!confirm('هل أنت متأكد من رغبتك في حذف هذا الصنف من الطلب؟')) return;
						const tr = btn.closest('.order-table-row');
						if (!tr) return;
						const delInput = tr.querySelector('.row-deleted-input');
						if (delInput) {
							delInput.value = '1';
						}
						tr.style.display = 'none';
						window.recalcOrderLiveTotals();
					};

					window.openOrderEditModal = function() {
						const modal = document.getElementById('order-edit-modal');
						if (modal && typeof modal.showModal === 'function') {
							modal.showModal();
							if (typeof window.recalcEditOrder === 'function') {
								window.recalcEditOrder();
							}
						}
					};

					window.closeOrderEditModal = function() {
						const modal = document.getElementById('order-edit-modal');
						if (modal && typeof modal.close === 'function') {
							modal.close();
						}
					};

					window.stepQty = function(btn, delta) {
						const row = btn.closest('.edit-line-row');
						if (!row) return;
						const input = row.querySelector('.line-qty-input');
						if (!input) return;

						const minVal = parseInt(row.getAttribute('data-min-qty'), 10) || 1;
						const maxVal = parseInt(row.getAttribute('data-max-qty'), 10) || 99999;

						let val = parseInt(input.value, 10) || minVal;
						val += delta;
						if (val < minVal) val = minVal;
						if (val > maxVal) {
							val = maxVal;
							alert('الكمية المطلوبة تتجاوز الحد الأقصى المتاح لدى المورد (' + maxVal + ' قطعة).');
						}

						input.value = val;
						if (typeof window.recalcEditOrder === 'function') {
							window.recalcEditOrder();
						}
					};

					window.deleteEditRow = function(btn) {
						const row = btn.closest('.edit-line-row');
						if (!row) return;
						const lineIdInput = row.querySelector('input[name="line_id[]"]');
						if (lineIdInput && lineIdInput.value && lineIdInput.value !== "0") {
							const delInput = row.querySelector('.line-deleted-input');
							if (delInput) delInput.value = "1";
							row.style.display = 'none';
						} else {
							row.remove();
						}
						if (typeof window.recalcEditOrder === 'function') {
							window.recalcEditOrder();
						}
					};

					window.addNewEditRow = function() {
						const tbody = document.getElementById('edit-lines-tbody');
						if (!tbody) return;
						const tr = document.createElement('tr');
						tr.className = 'edit-line-row';
						tr.setAttribute('data-min-qty', '1');
						tr.setAttribute('data-max-qty', '99999');
						tr.innerHTML = `
							<td>
								<input type="hidden" name="line_id[]" value="0"/>
								<input type="hidden" name="is_deleted[]" value="0" class="line-deleted-input"/>
								<input type="text" name="product_name[]" placeholder="اسم الصنف الدوائي الجديد..." required class="form-input input-sm w-full fw-700"/>
							</td>
							<td>
								<div>
									<button type="button" class="btn btn-secondary btn-icon" onclick="window.stepQty(this, -1)">-</button>
									<input type="number" name="quantity[]" value="1" min="1" required class="form-input input-sm tabular-nums text-center line-qty-input" oninput="window.recalcEditOrder()"/>
									<button type="button" class="btn btn-secondary btn-icon" onclick="window.stepQty(this, 1)">+</button>
								</div>
							</td>
							<td class="td-numeric">
								<input type="text" name="unit_price[]" value="0.00" required class="form-input input-sm tabular-nums line-unit-price text-right" oninput="window.recalcEditOrder()"/>
							</td>
							<td class="td-numeric">
								<input type="text" name="discount_amount[]" value="0.00" class="form-input input-sm tabular-nums line-disc-amount text-right" oninput="window.recalcEditOrder()"/>
							</td>
							<td class="td-numeric">
								<span class="line-total-cell tabular-nums fw-800 text-primary">0.00</span>
							</td>
							<td>
								<button type="button" class="btn btn-secondary btn-icon" title="حذف الصنف" onclick="window.deleteEditRow(this)">
									@components.IconTrash("icon-sm")
								</button>
							</td>
						`;
						tbody.appendChild(tr);
						if (typeof window.recalcEditOrder === 'function') {
							window.recalcEditOrder();
						}
					};

					window.recalcEditOrder = function() {
						const rows = document.querySelectorAll('#edit-lines-tbody .edit-line-row');
						let subtotal = 0;
						let discount = 0;

						rows.forEach(row => {
							const delInput = row.querySelector('.line-deleted-input');
							if (delInput && delInput.value === "1") return;
							if (row.style.display === 'none') return;

							const qtyInput = row.querySelector('.line-qty-input');
							const priceInput = row.querySelector('.line-unit-price');
							const discInput = row.querySelector('.line-disc-amount');
							const totalCell = row.querySelector('.line-total-cell');

							const qty = parseInt(qtyInput ? qtyInput.value : 1, 10) || 0;
							const price = parseFloat(priceInput ? priceInput.value.replace(/,/g, '') : 0) || 0;
							const disc = parseFloat(discInput ? discInput.value.replace(/,/g, '') : 0) || 0;

							let lineEff = price - disc;
							if (lineEff < 0) lineEff = 0;
							const lineTotal = lineEff * qty;

							if (totalCell) {
								totalCell.textContent = lineTotal.toFixed(2);
							}

							subtotal += (price * qty);
							discount += (disc * qty);
						});

						const grandTotal = Math.max(0, subtotal - discount);

						const subEl = document.getElementById('edit-subtotal-val');
						const discEl = document.getElementById('edit-discount-val');
						const grandEl = document.getElementById('edit-grandtotal-val');

						if (subEl) subEl.textContent = subtotal.toFixed(2);
						if (discEl) discEl.textContent = '-' + discount.toFixed(2);
						if (grandEl) grandEl.textContent = grandTotal.toFixed(2);
					};
				</script>
			}
		</div>
	}
}
