package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorOffersPackagesPageWithData(lang, dir string, data SponsorshipRequestsData) {
	@layouts.VendorShell(i18n.T(lang, "vendor_packages.shell_title"), "offers_packages", lang, dir) {
		<div
			class="page-container py-6"
			x-data={ fmt.Sprintf(`{
				lang: %q,
				showPurchaseModal: false,
				walletBalanceMinor: %d,
				selectedPkg: { id: 0, name: '', price: '', priceMinor: 0, duration: 0, credits: 0, tier: 0 },
				get selectedPkgPriceMinor() {
					return Number(this.selectedPkg.priceMinor) || 0;
				},
				get selectedPkgPriceFormatted() {
					return (this.selectedPkgPriceMinor / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + (this.lang === 'en' ? 'EGP' : 'ج.م');
				},
				get hasSufficientBalance() {
					return this.walletBalanceMinor >= this.selectedPkgPriceMinor;
				},
				get remainingBalanceFormatted() {
					const rem = (this.walletBalanceMinor - this.selectedPkgPriceMinor) / 100;
					return rem.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + (this.lang === 'en' ? 'EGP' : 'ج.م');
				}
			}`, lang, data.WalletBalance.Minor()) }
		>
			<!-- Header -->
			<div class="glass-panel p-6 mb-6 border border-slate-200/80 rounded-2xl shadow-sm">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="stack-sm">
						<div class="d-flex items-center gap-2.5 mb-1.5">
							<div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
								@components.IconBoxes("icon-sm")
							</div>
							<div class="stack-sm">
								<h1 class="text-2xl font-black text-primary m-0">{ i18n.T(lang, "vendor_packages.header_title") }</h1>
								<p class="text-xs text-secondary m-0 mt-0.5 font-medium">{ i18n.T(lang, "vendor_packages.header_desc") }</p>
							</div>
						</div>
					</div>
					<div class="d-flex items-center gap-3">
						<div class="stat-card-3d p-3 px-4 border border-slate-200/80 rounded-xl bg-surface-sunken">
							<div class="stat-card-label text-xs font-bold text-muted">{ i18n.T(lang, "vendor_packages.lbl_wallet_bal") }</div>
							<div class="text-lg font-black text-primary tabular-nums mt-0.5">
								@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.WalletBalance })
							</div>
						</div>
						<a href="/vendor/wallet" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
							@components.IconWallet("icon-xs")
							<span>{ i18n.T(lang, "billing.recharge_wallet") }</span>
						</a>
						<a href="/vendor/sponsorship-requests" class="btn btn-primary btn-sm font-extrabold gap-1.5 shadow-sm">
							@components.IconShield("icon-xs")
							<span>{ i18n.T(lang, "vendor_packages.btn_view_requests") }</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Packages Grid Cards -->
			if len(data.Packages) > 0 {
				<div class="d-grid grid-auto-fit-sm gap-5">
					for _, pkg := range data.Packages {
						if pkg != nil {
							<div class="glass-panel p-6 border border-slate-200/80 rounded-2xl shadow-xs transition-all d-flex flex-col justify-between">
								<div class="stack-sm">
									<!-- Card Top Header -->
									<div class="flex-between items-start mb-4">
										<div class="stack-sm">
											<h3 class="text-lg font-black text-primary m-0 leading-tight">
												{ pkg.Name.Get(i18n.Lang(lang)) }
											</h3>
											if pkg.TierLevel > 0 {
												<span class="badge badge-amber font-extrabold text-xs shadow-2xs mt-1.5 d-inline-flex">
													{ fmt.Sprintf(i18n.T(lang, "vendor_packages.tier_prefix"), pkg.TierLevel) }
												</span>
											}
										</div>
										<div class="text-end">
											<div class="text-2xl font-black text-brand tabular-nums">
												{ pkg.Price.String() } <span class="text-xs font-bold text-secondary">{ i18n.T(lang, "common.currency_egp") }</span>
											</div>
											<div class="text-xs text-muted font-semibold mt-0.5">
												{ fmt.Sprintf(i18n.T(lang, "vendor_packages.val_duration"), pkg.DurationDays) }
											</div>
										</div>
									</div>

									<!-- Features List -->
									<div class="border-t border-slate-100 pt-4 mb-6 d-flex flex-col gap-2.5 text-xs text-secondary font-medium">
										<div class="d-flex items-center gap-2">
											@components.IconCheckCircle("icon-xs text-emerald-500 flex-shrink-0")
											<span><strong>{ fmt.Sprintf("%d", pkg.Credits) }</strong> { i18n.T(lang, "vendor_packages.lbl_credits") }</span>
										</div>
										<div class="d-flex items-center gap-2">
											@components.IconCheckCircle("icon-xs text-emerald-500 flex-shrink-0")
											<span>{ i18n.T(lang, "vendor_packages.featured_sponsorship") }</span>
										</div>
										<div class="d-flex items-center gap-2">
											@components.IconCheckCircle("icon-xs text-emerald-500 flex-shrink-0")
											<span>{ i18n.T(lang, "vendor_packages.lbl_features") }</span>
										</div>
									</div>
								</div>

								<!-- Purchase Button with Modal Trigger -->
								<button
									type="button"
									class="btn btn-primary btn-sm w-full font-black justify-center gap-1.5 shadow-sm"
									@click={ fmt.Sprintf("showPurchaseModal = true; selectedPkg = { id: %d, name: %q, price: %q, priceMinor: %d, duration: %d, credits: %d, tier: %d };", pkg.ID, pkg.Name.Get(i18n.Lang(lang)), pkg.Price.String(), pkg.Price.Minor(), pkg.DurationDays, pkg.Credits, pkg.TierLevel) }
								>
									@components.IconCreditCard("icon-xs")
									<span>{ i18n.T(lang, "vendor_packages.btn_buy_package") }</span>
								</button>
							</div>
						}
					}
				</div>
				@PackagePurchaseConfirmationModal(data.WalletBalance, lang)
			} else {
				<div class="glass-panel p-8 text-center border border-slate-200/80 rounded-2xl shadow-xs">
					<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
						@components.IconBoxes("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary mb-1.5">{ i18n.T(lang, "vendor_packages.empty_packages_title") }</h3>
					<p class="text-xs text-secondary max-w-md mx-auto">
						{ i18n.T(lang, "vendor_packages.empty_packages_desc") }
					</p>
				</div>
			}
		</div>
	}
}

// VendorOffersPackagesPage renders vendor's available packages (legacy compat).
templ VendorOffersPackagesPage(lang, dir string) {
	@VendorOffersPackagesPageWithData(lang, dir, SponsorshipRequestsData{})
}

// VendorOffersPackagesSponsorshipsPage renders vendor sponsorships.
templ VendorOffersPackagesSponsorshipsPage(lang, dir string) {
	@VendorOffersPackagesPageWithData(lang, dir, SponsorshipRequestsData{})
}

// VendorOffersPackagesPromotionsPage renders vendor campaigns.
templ VendorOffersPackagesPromotionsPage(lang, dir string) {
	@VendorOffersPackagesPageWithData(lang, dir, SponsorshipRequestsData{})
}
