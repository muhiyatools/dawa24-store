package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ MessagesPage(lang, dir string, data MessagesData) {
	@layouts.ShellFor("الرسائل | Messages", "messages", lang, dir, authctx.FromContext(ctx)) {
		@MessagesContent(lang, dir, data)
	}
}


templ MessagesContent(lang, dir string, data MessagesData) {
	<div style="display:grid; grid-template-columns:300px 1fr; gap:1.25rem; height:70vh;">
			<aside class="card" style="margin-bottom:0; overflow-y:auto;">
				<h2 class="card-title" style="margin:0 0 0.75rem;">المحادثات</h2>
				if len(data.Items) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد محادثات بعد.</p>
				} else {
					for _, item := range data.Items {
						<a href={ templ.SafeURL(fmt.Sprintf("/messages/%d", item.Conversation.ID)) }
							style="display:block; padding:0.7rem 0.75rem; border-radius:var(--radius-md); text-decoration:none; color:inherit;"
							class={ templ.KV("active-item", data.Active != nil && data.Active.ID == item.Conversation.ID) }>
							<div style="font-weight:700; color:var(--neutral-900); font-size:0.9rem;">{ item.OtherName.Get(i18n.Lang(lang)) }</div>
							<div style="font-size:0.78rem; color:var(--neutral-500);">{ item.Conversation.Subject.Get(i18n.Lang(lang)) }</div>
						</a>
					}
				}
			</aside>

			<section class="card" style="margin-bottom:0; display:flex; flex-direction:column;">
				if data.Active == nil {
					<div style="flex:1; display:flex; align-items:center; justify-content:center; color:var(--neutral-500);">اختر محادثة من القائمة</div>
				} else {
					<div style="padding:0.75rem 1rem; border-bottom:1px solid var(--neutral-100);">
						<h2 class="card-title m-0">{ data.ActiveOther.Get(i18n.Lang(lang)) }</h2>
					</div>
					<div style="flex:1; overflow-y:auto; padding:1rem; display:flex; flex-direction:column; gap:0.75rem;">
						for _, m := range data.Thread {
							<div style="max-width:70%;" class={ templ.KV("msg-mine", m.SenderOrgID != nil && *m.SenderOrgID == data.CurrentOrgID) }>
								<div style="background:var(--neutral-100); border-radius:var(--radius-md); padding:0.6rem 0.85rem; font-size:0.9rem;">{ m.Body }</div>
								<div style="font-size:0.7rem; color:var(--neutral-400); margin-top:0.2rem;">
									if m.SenderOrgID != nil && *m.SenderOrgID == data.CurrentOrgID {
										أنت
									} else {
										الطرف الآخر
									}
									{ " · " }{ m.CreatedAt.Format("15:04") }
								</div>
							</div>
						}
					</div>
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/messages/%d/send", data.Active.ID)) } style="display:flex; gap:0.75rem; padding:0.75rem 1rem; border-top:1px solid var(--neutral-100); margin:0;">
						<input type="text" name="body" required class="form-input flex-1" placeholder="اكتب رسالتك…" />
						<button type="submit" class="btn btn-primary">إرسال</button>
					</form>
				}
			</section>
		</div>
}
