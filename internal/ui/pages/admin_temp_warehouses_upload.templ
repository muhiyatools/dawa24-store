package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminTempWarehouseUploadPage renders a dedicated standalone upload page for temporary warehouses.
templ AdminTempWarehouseUploadPage(data *AdminTempWarehousesData, lang, dir string) {
	@layouts.AdminShell(tempWarehousesShellTitle(data)+" - رفع ملفات جديدة", tempWarehousesNavKey(data), lang, dir) {
		<div
			x-data="{
				selectedFiles: [],
				fileHeaders: [],
				detectedCode: 0,
				detectedName: 1,
				detectedPrice: 2,
				detectedDiscount: 3,
				isUploading: false,
				uploadProgress: 0,
				uploadStatus: '',
				onFileChange(e) {
					const files = Array.from(e.target.files || []);
					this.selectedFiles = files;
					if (files.length === 1) {
						this.parseHeaders(files[0]);
					}
				},
				removeFile(idx) {
					this.selectedFiles.splice(idx, 1);
				},
				formatSize(bytes) {
					if (!bytes) return '0 B';
					const k = 1024;
					const sizes = ['B', 'KB', 'MB', 'GB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
				},
				cleanName(filename) {
					if (!filename) return '';
					return filename.replace(/\.[^/.]+$/, '').replace(/[_\-]/g, ' ').trim();
				},
				parseHeaders(file) {
					if (!file) return;
					if (file.name.endsWith('.csv') || file.name.endsWith('.txt')) {
						const reader = new FileReader();
						reader.onload = (e) => {
							const text = e.target.result;
							const lines = text.split(/\r?\n/).filter(l => l.trim().length > 0);
							if (lines.length > 0) {
								this.fileHeaders = lines[0].split(',').map(h => h.trim().replace(/^['\x22]|['\x22]$/g, ''));
								this.guessColumns();
							}
						};
						reader.readAsText(file);
					} else {
						this.fileHeaders = ['كود الصنف (SKU)', 'اسم المنتج / الصنف', 'سعر الجمهور', 'نسبة الخصم %', 'الكمية'];
						this.detectedCode = 0;
						this.detectedName = 1;
						this.detectedPrice = 2;
						this.detectedDiscount = 3;
					}
				},
				guessColumns() {
					this.fileHeaders.forEach((h, idx) => {
						const norm = h.toLowerCase().replace(/[\s_\-]/g, '');
						if (norm.includes('كود') || norm.includes('code') || norm.includes('sku') || norm.includes('باركود')) {
							this.detectedCode = idx;
						} else if (norm.includes('اسم') || norm.includes('name') || norm.includes('صنف') || norm.includes('منتج')) {
							this.detectedName = idx;
						} else if (norm.includes('سعر') || norm.includes('price') || norm.includes('جمهور')) {
							this.detectedPrice = idx;
						} else if (norm.includes('خصم') || norm.includes('discount') || norm.includes('%')) {
							this.detectedDiscount = idx;
						}
					});
				},
				async submitUpload(form) {
					if (this.selectedFiles.length === 0) {
						alert('يرجى اختيار ملف أو أكثر أولاً');
						return;
					}
					this.isUploading = true;
					this.uploadProgress = 20;
					this.uploadStatus = 'جاري رفع الملفات إلى الخادم...';

					const formData = new FormData();
					if (this.selectedFiles.length === 1) {
						formData.append('supplier_name', form.supplier_name ? form.supplier_name.value : '');
						formData.append('col_code', this.detectedCode);
						formData.append('col_name', this.detectedName);
						formData.append('col_price', this.detectedPrice);
						formData.append('col_discount', this.detectedDiscount);
					} else if (form.supplier_name && form.supplier_name.value) {
						formData.append('supplier_name', form.supplier_name.value);
					}

					for (let i = 0; i < this.selectedFiles.length; i++) {
						formData.append('files', this.selectedFiles[i]);
					}

					try {
						this.uploadProgress = 50;
						this.uploadStatus = 'جاري معالجة واستخراج أصناف المستودع...';
						const response = await fetch(form.action, {
							method: 'POST',
							body: formData,
							headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
						});

						this.uploadProgress = 85;
						let result = null;
						try { result = await response.json(); } catch(e) {}

						if (response.ok && result && result.success) {
							this.uploadProgress = 100;
							this.uploadStatus = 'تم رفع ومعالجة المستودع بنجاح!';
							setTimeout(() => {
								window.location.href = data.PageURL || '/admin/user/temparte-warehouses';
							}, 1200);
						} else {
							this.uploadProgress = 100;
							window.location.href = data.PageURL || '/admin/user/temparte-warehouses';
						}
					} catch(err) {
						console.error('Upload error:', err);
						window.location.href = data.PageURL || '/admin/user/temparte-warehouses';
					}
				}
			}"
			class="page-container max-w-4xl mx-auto py-6"
			dir={ dir }
		>
			<!-- Back Navigation -->
			<div class="mb-4">
				<a href={ templ.SafeURL(data.PageURL) } class="btn btn-ghost btn-sm font-bold text-secondary gap-1.5 hover:text-primary">
					<span>&larr;</span>
					<span>العودة إلى قائمة المستودعات المؤقتة</span>
				</a>
			</div>

			<!-- Header Card -->
			<div class="glass-panel p-6 mb-6 bg-surface-raised border rounded-2xl">
				<div class="d-flex items-center gap-3">
					<div class="w-12 h-12 rounded-2xl bg-accent-subtle text-accent flex-center text-2xl shrink-0">
						@components.IconUpload("icon-sm")
					</div>
					<div>
						<h1 class="text-2xl font-black text-primary m-0">رفع كشوف أسعار ومستودعات مؤقتة</h1>
						<p class="text-xs text-secondary m-0 mt-1">
							يمكنك رفع ملف أو عدة ملفات مجمعة (Excel أو CSV)، وتعيين اسم المورد وأعمدة البيانات بدقة فائقة.
						</p>
					</div>
				</div>
			</div>

			<!-- Upload Form Card -->
			<div class="glass-panel p-6 bg-surface-raised border rounded-2xl">
				<form
					method="POST"
					action={ templ.SafeURL(data.Base + "/upload") }
					enctype="multipart/form-data"
					@submit.prevent="submitUpload($event.target)"
					class="d-flex flex-col gap-6 m-0"
				>
					<!-- Drag and Drop Zone -->
					<div
						class="border-2 border-dashed border-subtle rounded-2xl p-8 text-center hover:border-accent bg-surface-sunken cursor-pointer transition-colors"
						@click="$refs.fileInput.click()"
					>
						<input
							type="file"
							name="files"
							multiple
							accept=".xlsx,.xls,.csv,.txt"
							x-ref="fileInput"
							@change="onFileChange($event)"
							class="d-none"
						/>
						<div class="text-4xl mb-3">📁</div>
						<h3 class="text-base font-black text-primary mb-1">اضغط هنا أو اسحب الملفات لإفلاتها</h3>
						<p class="text-xs text-secondary max-w-md mx-auto mb-2">
							يدعم النظام ملفات Excel (.xlsx, .xls) والملفات النصية (.csv, .txt) بأي حجم.
						</p>
						<span class="badge badge-brand text-2xs font-bold">يمكنك تحديد ملف واحد أو عدة ملفات معاً</span>
					</div>

					<!-- Selected Files Preview List -->
					<template x-if="selectedFiles.length > 0">
						<div class="stack-xs border rounded-xl p-4 bg-surface">
							<div class="flex-between items-center mb-2">
								<span class="text-xs font-bold text-primary" x-text="'الملفات المحددة (' + selectedFiles.length + '):'"></span>
								<button type="button" @click="selectedFiles = []" class="btn btn-ghost btn-xs text-rose-600 font-bold">إلغاء الكل</button>
							</div>
							<div class="d-flex flex-col gap-2 max-h-48 overflow-y-auto">
								<template x-for="(f, idx) in selectedFiles" :key="idx">
									<div class="flex-between items-center p-2 rounded-lg bg-surface-sunken border text-xs">
										<div class="d-flex items-center gap-2 truncate">
											<span class="font-mono text-muted text-2xs" x-text="'#' + (idx+1)"></span>
											<span class="font-bold text-primary truncate" x-text="f.name"></span>
											<span class="badge badge-slate text-2xs tabular-nums" x-text="formatSize(f.size)"></span>
										</div>
										<button type="button" @click="removeFile(idx)" class="btn btn-ghost btn-xs text-danger hover:bg-rose-50 p-1">
											✕
										</button>
									</div>
								</template>
							</div>
						</div>
					</template>

					<!-- Supplier Name Input -->
					<div class="form-group mb-0">
						<label class="form-label text-xs font-bold text-primary">
							اسم المورد / المستودع
							<span class="text-muted font-normal text-2xs ms-1">(اختياري — في حال تركه فارغاً سيتم اعتماده تلقائياً من اسم الملف)</span>
						</label>
						<input
							type="text"
							name="supplier_name"
							class="form-input text-xs"
							placeholder="مثال: مستودع الأمل، شركة النور للأدوية..."
							:value="selectedFiles.length === 1 ? cleanName(selectedFiles[0]?.name) : ''"
						/>
					</div>

					<!-- Column Mapping Options for Single File -->
					<template x-if="selectedFiles.length === 1">
						<div class="border rounded-xl p-4 bg-surface-sunken stack-sm">
							<div class="flex-between items-center">
								<strong class="text-xs font-black text-primary">تعيين أعمدة البيانات في الملف:</strong>
								<span class="badge badge-sky text-2xs">تم التعرف التلقائي الذكي</span>
							</div>
							<div class="d-grid grid-cols-4 gap-3">
								<div class="stack-2xs">
									<label class="form-label text-2xs font-bold">كود الصنف (SKU)</label>
									<select x-model="detectedCode" class="form-select text-xs">
										<option value="-1">-- غير محدد --</option>
										<template x-for="(h, idx) in fileHeaders" :key="idx">
											<option :value="idx" x-text="h" :selected="detectedCode == idx"></option>
										</template>
									</select>
								</div>
								<div class="stack-2xs">
									<label class="form-label text-2xs font-bold">اسم المنتج / الصنف <span class="text-danger">*</span></label>
									<select x-model="detectedName" class="form-select text-xs font-bold" required>
										<option value="-1">-- اختر العمود --</option>
										<template x-for="(h, idx) in fileHeaders" :key="idx">
											<option :value="idx" x-text="h" :selected="detectedName == idx"></option>
										</template>
									</select>
								</div>
								<div class="stack-2xs">
									<label class="form-label text-2xs font-bold">سعر الجمهور</label>
									<select x-model="detectedPrice" class="form-select text-xs">
										<option value="-1">-- غير محدد --</option>
										<template x-for="(h, idx) in fileHeaders" :key="idx">
											<option :value="idx" x-text="h" :selected="detectedPrice == idx"></option>
										</template>
									</select>
								</div>
								<div class="stack-2xs">
									<label class="form-label text-2xs font-bold">نسبة الخصم (%)</label>
									<select x-model="detectedDiscount" class="form-select text-xs">
										<option value="-1">-- غير محدد --</option>
										<template x-for="(h, idx) in fileHeaders" :key="idx">
											<option :value="idx" x-text="h" :selected="detectedDiscount == idx"></option>
										</template>
									</select>
								</div>
							</div>
						</div>
					</template>

					<!-- Progress Bar (When uploading) -->
					<div x-show="isUploading" x-cloak class="stack-xs bg-surface-sunken border rounded-xl p-4">
						<div class="flex-between items-center text-xs font-bold text-primary mb-1">
							<span x-text="uploadStatus"></span>
							<span class="tabular-nums" x-text="uploadProgress + '%'"></span>
						</div>
						<div class="w-full bg-surface-sunken rounded-full h-2.5 overflow-hidden border">
							<div class="bg-accent h-2.5 rounded-full transition-all duration-300" :style="'width: ' + uploadProgress + '%'"></div>
						</div>
					</div>

					<!-- Form Submit Button -->
					<div class="flex-between items-center pt-4 border-t">
						<a href={ templ.SafeURL(data.PageURL) } class="btn btn-secondary btn-sm font-bold">
							إلغاء والرجوع
						</a>
						<button
							type="submit"
							class="btn btn-primary btn-sm font-black px-8 py-2.5 gap-2 shadow-2xs"
							:disabled="selectedFiles.length === 0 || isUploading"
						>
							@components.IconUpload("icon-xs")
							<span x-show="!isUploading && selectedFiles.length <= 1">بدء رفع المستودع</span>
							<span x-show="!isUploading && selectedFiles.length > 1" x-text="'بدء رفع ' + selectedFiles.length + ' ملفات'"></span>
							<span x-show="isUploading">جاري الرفع والمعالجة...</span>
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}
