package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminFinder(lang, dir string, questions []*catalog.FinderQuestion, results []*catalog.FinderResult) {
	@layouts.AdminShell("دليل المنتجات | Finder", "finder", lang, dir) {
		<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin-bottom:1.25rem;">
			<div class="card">
				<h2 class="card-title" style="margin:0 0 1rem;">سؤال جديد</h2>
				<form method="POST" action="/admin/finder/question" style="display:flex; flex-direction:column; gap:0.9rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="fq-ar">السؤال (عربي)</label>
						<input type="text" id="fq-ar" name="question_ar" required class="form-input" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="fq-en">السؤال (إنجليزي)</label>
						<input type="text" id="fq-en" name="question_en" class="form-input" dir="ltr" />
					</div>
					<div style="display:flex; gap:1rem; align-items:center;">
						<select name="type" class="form-input" style="flex:1;">
							<option value="choice">اختيار</option>
							<option value="text">نص</option>
							<option value="number">رقم</option>
						</select>
						<label style="display:flex; gap:0.4rem; align-items:center; font-size:0.85rem;">
							<input type="checkbox" name="is_first" value="1" />
							<span>سؤال البداية</span>
						</label>
					</div>
					<button type="submit" class="btn btn-primary" style="justify-content:center;">إضافة السؤال</button>
				</form>
			</div>

			<div class="card">
				<h2 class="card-title" style="margin:0 0 1rem;">نتيجة جديدة</h2>
				<form method="POST" action="/admin/finder/result" style="display:flex; flex-direction:column; gap:0.9rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="fr-ar">العنوان (عربي)</label>
						<input type="text" id="fr-ar" name="title_ar" required class="form-input" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="fr-desc">الوصف</label>
						<textarea id="fr-desc" name="description_ar" rows="2" class="form-textarea"></textarea>
					</div>
					<button type="submit" class="btn btn-secondary" style="justify-content:center;">إضافة النتيجة</button>
				</form>
			</div>
		</div>

		<div class="card" style="margin-bottom:1.25rem;">
			<h2 class="card-title" style="margin:0 0 1rem;">إضافة خيار لسؤال</h2>
			<form method="POST" action="/admin/finder/option" style="display:flex; flex-direction:column; gap:0.9rem;">
				<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem;">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">السؤال</label>
						<select name="question_id" required class="form-input">
							<option value="" disabled selected>اختر السؤال</option>
							for _, q := range questions {
								<option value={ fmt.Sprintf("%d", q.ID) }>{ q.Question.Get(i18n.Lang(lang)) }</option>
							}
						</select>
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">التسمية</label>
						<input type="text" name="label_ar" required class="form-input" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label">النتيجة</label>
						<select name="result_id" required class="form-input">
							<option value="" disabled selected>اختر النتيجة</option>
							for _, res := range results {
								<option value={ fmt.Sprintf("%d", res.ID) }>{ res.Title.Get(i18n.Lang(lang)) }</option>
							}
						</select>
					</div>
				</div>
				<button type="submit" class="btn btn-secondary" style="justify-content:center;">إضافة الخيار</button>
			</form>
		</div>

		<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
			<div class="card">
				<h2 class="card-title" style="margin:0 0 0.75rem;">الأسئلة ({ fmt.Sprintf("%d", len(questions)) })</h2>
				for _, q := range questions {
					<div style="padding:0.5rem 0; border-bottom:1px solid var(--neutral-100);">
						{ q.Question.Get(i18n.Lang(lang)) }
						if q.IsFirst {
							<span class="badge badge-emerald">البداية</span>
						}
					</div>
				}
			</div>
			<div class="card">
				<h2 class="card-title" style="margin:0 0 0.75rem;">النتائج ({ fmt.Sprintf("%d", len(results)) })</h2>
				for _, res := range results {
					<div style="padding:0.5rem 0; border-bottom:1px solid var(--neutral-100);">
						{ res.Title.Get(i18n.Lang(lang)) }
					</div>
				}
			</div>
		</div>
	}
}
