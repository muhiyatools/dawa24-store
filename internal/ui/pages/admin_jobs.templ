package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/hr"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminJobView struct {
	Job         *hr.JobOffer
	CompanyName string
	CompanyType string
}

func intPtr(n int) *int { return &n }

templ AdminJobs(lang, dir string, jobs []*AdminJobView) {
	@layouts.AdminShell("إدارة فرص التوظيف وإعلانات العمل", "jobs", lang, dir) {
		<div class="stack-lg">
			@components.PageHeader(components.PageHeaderProps{
				Title:       "فرص التوظيف والوظائف المنشورة",
				Subtitle:    "متابعة إعلانات التوظيف والوظائف الشاغرة الصادرة من الصيدليات والشركات الموردة.",
				Count:       intPtr(len(jobs)),
			})

			<div class="card mb-0">
				if len(jobs) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد فرص توظيف معلنة",
						Message: "لم تقم أي صيدلية أو شركة بنشر وظائف شاغرة حتى الآن.",
					})
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th>المسمى الوظيفي</th>
									<th>الجهة المعلنة (الشركة / الصيدلية)</th>
									<th>الموقع والمحافظة</th>
									<th>الراتب / المكافأة</th>
									<th>تاريخ النشر</th>
									<th>الحالة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, j := range jobs {
									<tr>
										<td>
											<div style="font-weight:800; color:var(--text); font-size:0.95rem;">{ j.Job.Title.Get(i18n.Lang(lang)) }</div>
											<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.15rem;">معرف الإعلان: #{ fmt.Sprintf("%d", j.Job.ID) }</div>
										</td>
										<td>
											<div style="font-weight:700; color:var(--accent); font-size:0.9rem;">{ j.CompanyName }</div>
											<span class="badge badge-slate" style="font-size:0.75rem; margin-top:0.15rem;">{ orgTypeAr(j.CompanyType) }</span>
										</td>
										<td>
											<div style="font-size:0.875rem; color:var(--text); font-weight:600;">{ j.Job.Location }</div>
										</td>
										<td>
											if !j.Job.SalaryMin.IsZero() {
												<div style="font-size:0.875rem; font-weight:800; color:var(--emerald);" class="tabular-nums">
													@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: j.Job.SalaryMin })
												</div>
											} else {
												<span style="color:var(--text-muted); font-size:0.8rem;">يحدد بالمقابلة</span>
											}
										</td>
										<td style="font-size:0.825rem; color:var(--text-secondary);" class="tabular-nums">
											{ j.Job.CreatedAt.Format("2006-01-02") }
										</td>
										<td>
											if j.Job.Status == "published" {
												<span class="badge badge-emerald">معلن ونشط</span>
											} else {
												<span class="badge badge-slate">{ j.Job.Status }</span>
											}
										</td>
										<td class="text-end">
											<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", j.Job.ID)) } target="_blank" class="btn btn-secondary btn-sm fw-700">
												@components.IconExternalLink("icon-xs")
												<span>عرض الإعلان</span>
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
