package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/smartorder"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// SmartOrderMappingField is one target field with its detected column.
type SmartOrderMappingField struct {
	Key        string
	Label      string
	Required   bool
	Column     int
	Assigned   bool
	Confidence float64
}

// SmartOrderMappingData is what the mapping screen renders.
type SmartOrderMappingData struct {
	Run       *smartorder.Run
	Headers   []string
	Fields    []SmartOrderMappingField
	Preview   [][]string
	HeaderRow int
	Error     string
}

// confidenceChip renders how sure the automatic detection was.
//
// Shown per field rather than as one overall score, because the buyer needs to
// know *which* column to check, not that something somewhere is uncertain.
func confidenceChip(c float64) string {
	base := "display:inline-block; padding:0.15rem 0.5rem; border-radius:999px; font-size:0.72rem; font-weight:700; margin-inline-start:0.5rem;"
	switch {
	case c >= 0.85:
		return base + "background:rgba(16,185,129,0.14); color:var(--primary-700);"
	case c >= 0.6:
		return base + "background:rgba(245,158,11,0.14); color:var(--warning);"
	default:
		return base + "background:rgba(239,68,68,0.10); color:var(--danger);"
	}
}

// SmartOrderMappingPage is step 2: confirm or correct the column mapping.
templ SmartOrderMappingPage(lang, dir string, data SmartOrderMappingData) {
	@layouts.CustomerShell("تعيين الأعمدة", "purchase-request", lang, dir, nil) {
		<div class="container-fluid" style="max-width:1100px; margin:0 auto; padding:1.5rem 1rem;">
			<h1 style="font-size:1.6rem; font-weight:800; margin:0 0 1.5rem 0;">تعيين أعمدة الملف</h1>
			@stepBar(2)

			if data.Error != "" {
				<div style="padding:1rem 1.25rem; border-radius:var(--radius-lg); background:rgba(239,68,68,0.10); border:1px solid var(--danger); margin-bottom:1.5rem;">
					{ data.Error }
				</div>
			}

			<p style="color:var(--text-secondary); font-size:0.9rem; margin-bottom:1.5rem;">
				تعرّف النظام على الأعمدة تلقائيًا. راجع الاختيارات وصحّح أي عمود قبل بدء المطابقة — تعيين خاطئ ينتج طلبًا خاطئًا بثقة.
			</p>

			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/smart-order/%s/mapping", data.Run.PublicID)) } class="card" style="padding:2rem; display:grid; gap:1.25rem;">
				<input type="hidden" name="header_row" value={ fmt.Sprintf("%d", data.HeaderRow) }/>
				for _, f := range data.Fields {
					<div>
						<label style="display:block; font-weight:700; margin-bottom:0.4rem;">
							{ f.Label }
							if f.Required {
								<span style="color:var(--danger);">*</span>
							}
							if f.Assigned {
								<span style={ confidenceChip(f.Confidence) }>{ fmt.Sprintf("%.0f%%", f.Confidence*100) }</span>
							}
						</label>
						<select name={ "mapping_" + f.Key } style="width:100%; padding:0.6rem; border:1px solid var(--border); border-radius:var(--radius-lg);">
							<option value="">— بدون —</option>
							for i, h := range data.Headers {
								<option value={ fmt.Sprintf("%d", i) } selected?={ f.Assigned && f.Column == i }>
									{ fmt.Sprintf("عمود %d: %s", i+1, h) }
								</option>
							}
						</select>
					</div>
				}

				<div>
					<strong style="display:block; margin-bottom:0.6rem;">معاينة أول الصفوف</strong>
					<div style="overflow-x:auto; border:1px solid var(--border); border-radius:var(--radius-lg);">
						<table style="width:100%; border-collapse:collapse; font-size:0.82rem;">
							<thead>
								<tr style="background:var(--surface-sunken);">
									for i, h := range data.Headers {
										<th style="padding:0.5rem; text-align:start; white-space:nowrap;">{ fmt.Sprintf("%d: %s", i+1, h) }</th>
									}
								</tr>
							</thead>
							<tbody>
								for _, row := range data.Preview {
									<tr style="border-top:1px solid var(--border);">
										for _, cell := range row {
											<td style="padding:0.5rem; white-space:nowrap;">{ cell }</td>
										}
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<button type="submit" class="btn btn-primary" style="justify-content:center; font-weight:700; padding:0.85rem;">
					حفظ التعيين وبدء المطابقة
				</button>
			</form>
		</div>
	}
}

// SmartOrderProgressData drives the live progress screen.
type SmartOrderProgressData struct {
	Run     *smartorder.Run
	Events  []*smartorder.Event
	Failed  bool
	Message string
	// Percent is how far the run has got, 0-100.
	Percent int
	// Caption names the stage currently running, in one short phrase.
	Caption string
	// AIRunning says the deterministic engine has finished and the AI stage has
	// not. It earns its own line of text because this is the one point in the
	// run where "still working" and "nearly done" are both true, and a buyer who
	// cannot tell them apart reads the pause as a fault.
	AIRunning bool
}

// ringOffset is the stroke-dashoffset that draws Percent of the ring.
//
// The circle has r=52, so its circumference is 2*pi*52 = 326.7. The dash array
// is that whole length and the offset is the part left undrawn, which is why a
// higher percentage means a smaller offset.
func (d SmartOrderProgressData) ringOffset() string {
	const circumference = 326.7
	p := d.Percent
	if p < 0 {
		p = 0
	}
	if p > 100 {
		p = 100
	}
	return fmt.Sprintf("%.1f", circumference-circumference*float64(p)/100)
}

// SmartOrderProgressPage is step 3: processing.
//
// One number, one line of text. It used to be a spinner beside a list of every
// stage the pipeline had entered, each with a count that read "0 / 804" because
// stages reported before doing their work — four lines that told the buyer
// nothing, and read as though the system had stalled at zero.
//
// Everything shown comes from the database, not from the connection that
// started the run, which is what lets a buyer close the tab, come back from
// another device, and find the run where it got to.
templ SmartOrderProgressPage(lang, dir string, data SmartOrderProgressData) {
	@layouts.CustomerShell("جارٍ المطابقة", "purchase-request", lang, dir, nil) {
		<div class="container-fluid so-progress-page">
			<h1 class="so-progress-title">جارٍ تجهيز الطلب</h1>
			@stepBar(3)

			if data.Failed {
				<div class="so-progress-failed">
					<strong>تعذّر إكمال المطابقة</strong>
					<p class="so-progress-failed-detail">{ data.Message }</p>
				</div>
			} else {
				<div class="card so-progress-card">
					<div class="so-ring" role="progressbar" aria-valuemin="0" aria-valuemax="100"
						aria-valuenow={ fmt.Sprintf("%d", data.Percent) }
						aria-label={ data.Caption }>
						<svg class="so-ring-svg" viewBox="0 0 120 120" aria-hidden="true">
							<circle class="so-ring-track" cx="60" cy="60" r="52"></circle>
							<circle
								class="so-ring-value"
								cx="60"
								cy="60"
								r="52"
								style={ "stroke-dashoffset:" + data.ringOffset() }
							></circle>
						</svg>
						<div class="so-ring-label">
							<span class="so-ring-percent">{ fmt.Sprintf("%d%%", data.Percent) }</span>
						</div>
					</div>
					<p class="so-progress-caption">{ data.Caption }</p>
					if data.AIRunning {
						<p class="so-progress-note">
							اكتملت المطابقة المبدئية، ويجري الآن تحسين الأصناف غير المطابقة أو التي تحتاج مراجعة.
							ستظهر النتائج النهائية بعد انتهاء هذه المرحلة.
						</p>
					}
					<p class="so-progress-note">
						يمكنك إغلاق الصفحة والعودة لاحقًا — تستمر المعالجة في الخلفية.
					</p>
				</div>
				<meta http-equiv="refresh" content="3"/>
			}
		</div>
	}
}
