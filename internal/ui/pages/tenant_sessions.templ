package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type TenantSessionsViewData struct {
	Sessions         []*identity.Session
	CurrentToken     string
	CurrentUserID    int64
	IsSuperAdmin     bool
	MaxLoginSessions int
	MaxDevices       int
	PlanName         string
	IsVendor         bool
	NoticeType       string
	NoticeMessage    string
}

templ TenantSessionsPage(lang, dir string, data TenantSessionsViewData) {
	if data.IsVendor {
		@layouts.VendorShell("الأجهزة والجلسات النشطة", "sessions", lang, dir) {
			@tenantSessionsContent(lang, dir, data)
		}
	} else {
		@layouts.CustomerShell("الأجهزة والجلسات النشطة", "sessions", lang, dir, nil) {
			@tenantSessionsContent(lang, dir, data)
		}
	}
}

templ tenantSessionsContent(lang, dir string, data TenantSessionsViewData) {
	<div class="page-container">
		
		<!-- Compact Page Header -->
		<div class="page-header flex-between flex-wrap gap-4 mb-6">
			<div class="stack-xs">
				<h1 class="page-title font-bold text-xl m-0 d-flex items-center gap-2">
					<span class="text-primary">@components.IconShield("icon-sm")</span>
					<span>الأجهزة والجلسات النشطة</span>
				</h1>
				<p class="text-sm text-secondary m-0">
					إدارة الأجهزة المتصلة بحساب المنشأة وسعة الجلسات المتزامنة ({ data.PlanName })
				</p>
			</div>

			<div class="d-flex items-center gap-2 flex-wrap">
				<a
					href={ templ.SafeURL(ternary(data.IsVendor, "/vendor/mfa", "/customer/mfa")) }
					class="btn btn-secondary btn-sm font-bold rounded-lg"
				>
					<span>@components.IconShield("icon-xs")</span>
					<span>المصادقة الثنائية (MFA)</span>
				</a>
				if data.IsVendor {
					<a href="/vendor/subscription" class="btn btn-primary btn-sm font-bold rounded-lg">
						@components.IconSparkles("icon-xs")
						<span>ترقية الباقة</span>
					</a>
				} else {
					<a href="/customer/subscription" class="btn btn-primary btn-sm font-bold rounded-lg">
						@components.IconSparkles("icon-xs")
						<span>ترقية الباقة</span>
					</a>
				}
			</div>
		</div>

		<!-- Flash Notices -->
		if data.NoticeMessage != "" {
			if data.NoticeType == "error" {
				<div class="alert alert-danger mb-6 p-4 d-flex items-center gap-3">
					@components.IconAlert("icon-xs")
					<span class="font-bold text-sm">{ data.NoticeMessage }</span>
				</div>
			} else {
				<div class="alert alert-success mb-6 p-4 d-flex items-center gap-3">
					@components.IconCheckCircle("icon-xs")
					<span class="font-bold text-sm">{ data.NoticeMessage }</span>
				</div>
			}
		}

		<!-- Compact Metrics Bar -->
		<div class="card p-4 mb-6 shadow-xs">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				<div class="stat-card p-3.5 bg-surface-sunken rounded-xl border">
					<div class="stat-label text-xs text-muted font-bold mb-1">الجلسات المتصلة</div>
					<div class="tabular-nums font-bold text-base text-primary">
						{ fmt.Sprintf("%d", len(data.Sessions)) } <span class="text-xs font-normal text-muted">/ { fmt.Sprintf("%d", data.MaxLoginSessions) } مسموحة</span>
					</div>
				</div>

				<div class="stat-card p-3.5 bg-surface-sunken rounded-xl border">
					<div class="stat-label text-xs text-muted font-bold mb-1">حالة السعة</div>
					<div class="mt-1">
						if len(data.Sessions) >= data.MaxLoginSessions {
							<span class="badge badge-amber font-bold text-xs">الحد الأقصى مستنفد</span>
						} else {
							<span class="badge badge-emerald font-bold text-xs">سعة متاحة</span>
						}
					</div>
				</div>

				<div class="stat-card p-3.5 bg-surface-sunken rounded-xl border">
					<div class="stat-label text-xs text-muted font-bold mb-1">حد الأجهزة المعتمدة</div>
					<div class="tabular-nums font-bold text-base text-primary">
						{ fmt.Sprintf("%d", data.MaxDevices) } <span class="text-xs font-normal text-muted">أجهزة</span>
					</div>
				</div>

				<div class="stat-card p-3.5 bg-surface-sunken rounded-xl border">
					<div class="stat-label text-xs text-muted font-bold mb-1">باقة المنشأة</div>
					<div class="font-bold text-sm text-primary mt-0.5">
						{ data.PlanName }
					</div>
				</div>
			</div>
		</div>

		<!-- Active Sessions List -->
		<div class="card p-6 mb-6 shadow-xs">
			<div class="flex-between flex-wrap gap-3 pb-4 mb-4 border-b">
				<h2 class="card-title font-bold text-base text-primary m-0">
					الأجهزة المتصلة حالياً ({ fmt.Sprintf("%d", len(data.Sessions)) })
				</h2>

				if len(data.Sessions) > 1 {
					<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/sessions/revoke-all", "/customer/sessions/revoke-all")) } method="POST" class="m-0" onsubmit="return confirm('إنهاء كافة الجلسات الأخرى والإبقاء على هذا الجهاز فقط؟');">
						<input type="hidden" name="current_token" value={ data.CurrentToken } />
						<button type="submit" class="btn btn-outline-danger btn-xs font-bold gap-1">
							@components.IconLogout("icon-xs")
							<span>إنهاء الجلسات الأخرى</span>
						</button>
					</form>
				}
			</div>

			if len(data.Sessions) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد جلسات نشطة",
					Message: "لم يتم العثور على أي جلسات متصلة حالياً.",
				})
			} else {
				<div class="stack-md">
					for _, sess := range data.Sessions {
						<div class={ "session-item flex-between flex-wrap gap-3 p-4 rounded-xl border transition-all", templ.KV("bg-primary-subtle border-primary-subtle shadow-xs", sess.Token == data.CurrentToken), templ.KV("bg-surface-sunken border-subtle", sess.Token != data.CurrentToken) }>
							<div class="d-flex items-center gap-3">
								<div class="w-10 h-10 rounded-lg bg-surface-raised border flex-center text-primary flex-shrink-0 shadow-xs">
									if sess.Icon != "" {
										{ sess.Icon }
									} else {
										@components.IconMonitor("icon-sm")
									}
								</div>
								<div class="stack-2xs">
									<div class="d-flex items-center gap-2 flex-wrap">
										<strong class="text-sm font-bold text-primary">
											if sess.DeviceName != "" {
												{ sess.DeviceName }
											} else {
												جهاز غير محدد
											}
										</strong>
										if sess.Token == data.CurrentToken {
											<span class="badge badge-emerald text-xs font-bold">
												جهازك الحالي
											</span>
										}
									</div>
									<div class="tabular-nums text-xs text-muted d-flex items-center gap-1.5 flex-wrap">
										<span>{ sess.Email }</span>
										if sess.IP != "" {
											<span>• { sess.IP }</span>
										}
										<span>• { sess.CreatedAt.Format("2006-01-02 03:04 PM") }</span>
									</div>
								</div>
							</div>

							<div class="d-flex items-center gap-2">
								if sess.Token == data.CurrentToken {
									<form action="/auth/logout" method="POST" class="m-0">
										<button type="submit" class="btn btn-secondary btn-xs font-bold">
											<span>تسجيل الخروج</span>
										</button>
									</form>
								} else if sess.UserID == data.CurrentUserID || data.IsSuperAdmin {
									<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/sessions/revoke", "/customer/sessions/revoke")) } method="POST" class="m-0" onsubmit="return confirm('إنهاء جلسة هذا الجهاز؟');">
										<input type="hidden" name="token" value={ sess.Token } />
										<button type="submit" class="btn btn-outline-danger btn-xs font-bold">
											<span>إنهاء الجلسة</span>
										</button>
									</form>
								} else {
									<span class="badge badge-slate text-xs font-medium">
										مستخدم آخر
									</span>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>

		<!-- Password Security Form -->
		<div class="card p-6 shadow-xs">
			<div class="stack-xs mb-4 pb-3 border-b">
				<h2 class="card-title font-bold text-base text-primary m-0">
					تحديث كلمة المرور
				</h2>
				<p class="text-sm text-secondary m-0">
					تغيير كلمة المرور الخاصة بحسابك ينهي الجلسات الأخرى فوراً
				</p>
			</div>

			<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/password", "/customer/password")) } method="POST" class="stack-md max-w-lg">
				<div class="form-group mb-2">
					<label class="form-label text-xs font-bold" for="sess-current-password">كلمة المرور الحالية</label>
					<input type="password" id="sess-current-password" name="current_password" required class="form-input form-input-sm" placeholder="••••••••" />
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-2">
					<div class="form-group mb-0">
						<label class="form-label text-xs font-bold" for="sess-new-password">كلمة المرور الجديدة</label>
						<input type="password" id="sess-new-password" name="new_password" required minlength="8" class="form-input form-input-sm" placeholder="8 أحرف كحد أدنى" />
					</div>
					<div class="form-group mb-0">
						<label class="form-label text-xs font-bold" for="sess-confirm-password">تأكيد كلمة المرور</label>
						<input type="password" id="sess-confirm-password" name="confirm_password" required minlength="8" class="form-input form-input-sm" placeholder="••••••••" />
					</div>
				</div>

				<div class="pt-2">
					<button type="submit" class="btn btn-primary btn-sm font-bold px-6">
						@components.IconCheck("icon-xs")
						<span>حفظ كلمة المرور الجديدة</span>
					</button>
				</div>
			</form>
		</div>

	</div>
}
