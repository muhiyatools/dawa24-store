package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type TenantSessionsViewData struct {
	Sessions         []*identity.Session
	CurrentToken     string
	MaxLoginSessions int
	MaxDevices       int
	PlanName         string
	IsVendor         bool
	NoticeType       string
	NoticeMessage    string
}

templ TenantSessionsPage(lang, dir string, data TenantSessionsViewData) {
	if data.IsVendor {
		@layouts.VendorShell("الأجهزة والجلسات النشطة", "sessions", lang, dir) {
			@tenantSessionsContent(lang, dir, data)
		}
	} else {
		@layouts.CustomerShell("الأجهزة والجلسات النشطة", "sessions", lang, dir, nil) {
			@tenantSessionsContent(lang, dir, data)
		}
	}
}

templ tenantSessionsContent(lang, dir string, data TenantSessionsViewData) {
	<div class="page-container" style="max-width:980px; margin:0 auto; padding:1.5rem 1rem 3rem 1rem;">
		
		<!-- Compact Page Header -->
		<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem;">
			<div>
				<h1 style="font-size:1.35rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.5rem;">
					@components.IconShield("icon-sm")
					<span>الأجهزة والجلسات النشطة</span>
				</h1>
				<p style="color:var(--text-secondary); font-size:0.85rem; margin:0.25rem 0 0 0;">
					إدارة الأجهزة المتصلة بحساب المنشأة وسعة الجلسات المتزامنة ({ data.PlanName })
				</p>
			</div>

			<div style="display:flex; gap:0.5rem; align-items:center;">
				if data.IsVendor {
					<a href="/vendor/subscription" class="btn btn-outline-brand btn-sm font-bold">
						@components.IconSparkles("icon-xs")
						<span>ترقية الباقة</span>
					</a>
				} else {
					<a href="/customer/subscription" class="btn btn-outline-brand btn-sm font-bold">
						@components.IconSparkles("icon-xs")
						<span>ترقية الباقة</span>
					</a>
				}
			</div>
		</div>

		<!-- Flash Notices -->
		if data.NoticeMessage != "" {
			if data.NoticeType == "error" {
				<div class="alert alert-danger" style="border-radius:var(--radius-lg); padding:0.75rem 1rem; margin-bottom:1.25rem; font-size:0.875rem; font-weight:600; display:flex; align-items:center; gap:0.5rem;">
					@components.IconAlert("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			} else {
				<div class="alert alert-success" style="border-radius:var(--radius-lg); padding:0.75rem 1rem; margin-bottom:1.25rem; font-size:0.875rem; font-weight:600; display:flex; align-items:center; gap:0.5rem;">
					@components.IconCheckCircle("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			}
		}

		<!-- Compact Metrics Bar -->
		<div class="card p-4" style="border-radius:var(--radius-xl); margin-bottom:1.5rem; background:var(--surface);">
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1.25rem; align-items:center;">
				<div>
					<div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">الجلسات المتصلة</div>
					<div style="font-size:1.4rem; font-weight:800; color:var(--text); margin-top:0.15rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", len(data.Sessions)) } <span style="font-size:0.85rem; font-weight:600; color:var(--text-secondary);">/ { fmt.Sprintf("%d", data.MaxLoginSessions) } مسموحة</span>
					</div>
				</div>

				<div>
					<div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">حالة السعة</div>
					<div style="margin-top:0.25rem;">
						if len(data.Sessions) >= data.MaxLoginSessions {
							<span class="badge badge-amber font-bold text-xs">الحد الأقصى مستنفد</span>
						} else {
							<span class="badge badge-emerald font-bold text-xs">سعة متاحة</span>
						}
					</div>
				</div>

				<div>
					<div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">حد الأجهزة المعتمدة</div>
					<div style="font-size:1.15rem; font-weight:800; color:var(--text); margin-top:0.15rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", data.MaxDevices) } أجهزة
					</div>
				</div>

				<div>
					<div style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">باقة المنشأة</div>
					<div style="font-size:1rem; font-weight:800; color:var(--brand); margin-top:0.15rem;">
						{ data.PlanName }
					</div>
				</div>
			</div>
		</div>

		<!-- Active Sessions List -->
		<div class="card p-5" style="border-radius:var(--radius-xl); margin-bottom:1.5rem; background:var(--surface);">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.75rem;">
				<h2 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">
					الأجهزة المتصلة حالياً ({ fmt.Sprintf("%d", len(data.Sessions)) })
				</h2>

				if len(data.Sessions) > 1 {
					<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/sessions/revoke-all", "/customer/sessions/revoke-all")) } method="POST" class="m-0" onsubmit="return confirm('إنهاء كافة الجلسات الأخرى والإبقاء على هذا الجهاز فقط؟');">
						<input type="hidden" name="current_token" value={ data.CurrentToken } />
						<button type="submit" class="btn btn-outline-danger btn-xs font-bold" style="padding:0.35rem 0.75rem;">
							@components.IconLogout("icon-xs")
							<span>إنهاء الجلسات الأخرى</span>
						</button>
					</form>
				}
			</div>

			if len(data.Sessions) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد جلسات نشطة",
					Message: "لم يتم العثور على أي جلسات متصلة حالياً.",
				})
			} else {
				<div style="display:flex; flex-direction:column; gap:0.6rem;">
					for _, sess := range data.Sessions {
						<div
							style={ fmt.Sprintf("display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1rem; border-radius:var(--radius-lg); border:1px solid %s; background:%s; flex-wrap:wrap; gap:0.75rem;",
								ternary(sess.Token == data.CurrentToken, "var(--primary-subtle)", "var(--border)"),
								ternary(sess.Token == data.CurrentToken, "var(--primary-subtle)", "var(--surface-sunken)")) }
						>
							<div style="display:flex; align-items:center; gap:0.75rem; min-width:240px;">
								<span style="font-size:1.35rem; line-height:1; flex-shrink:0;">
									if sess.Icon != "" {
										{ sess.Icon }
									} else {
										💻
									}
								</span>
								<div>
									<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
										<span style="font-weight:700; font-size:0.9rem; color:var(--text);">
											if sess.DeviceName != "" {
												{ sess.DeviceName }
											} else {
												جهاز غير محدد
											}
										</span>
										if sess.Token == data.CurrentToken {
											<span class="badge badge-emerald text-xs font-bold" style="padding:0.15rem 0.5rem;">
												جهازك الحالي
											</span>
										}
									</div>
									<div style="display:flex; align-items:center; gap:0.75rem; margin-top:0.2rem; font-size:0.75rem; color:var(--text-secondary); flex-wrap:wrap;" class="tabular-nums">
										<span>{ sess.Email }</span>
										if sess.IP != "" {
											<span>• { sess.IP }</span>
										}
										<span>• { sess.CreatedAt.Format("2006-01-02 15:04") }</span>
									</div>
								</div>
							</div>

							<div>
								if sess.Token == data.CurrentToken {
									<form action="/auth/logout" method="POST" class="m-0">
										<button type="submit" class="btn btn-secondary btn-xs font-semibold" style="padding:0.35rem 0.75rem;">
											<span>تسجيل الخروج</span>
										</button>
									</form>
								} else {
									<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/sessions/revoke", "/customer/sessions/revoke")) } method="POST" class="m-0" onsubmit="return confirm('إنهاء جلسة هذا الجهاز؟');">
										<input type="hidden" name="token" value={ sess.Token } />
										<button type="submit" class="btn btn-outline-danger btn-xs font-semibold" style="padding:0.35rem 0.75rem;">
											<span>إنهاء</span>
										</button>
									</form>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>

		<!-- Password Security Form -->
		<div class="card p-5" style="border-radius:var(--radius-xl); background:var(--surface); max-width:650px;">
			<div style="margin-bottom:1rem;">
				<h2 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">
					تحديث كلمة المرور
				</h2>
				<p style="font-size:0.8rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
					تغيير كلمة المرور الخاصة بحسابك ينهي الجلسات الأخرى فوراً
				</p>
			</div>

			<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/password", "/customer/password")) } method="POST" class="stack-sm">
				<div class="form-group mb-2">
					<label class="form-label text-xs" for="sess-current-password">كلمة المرور الحالية</label>
					<input type="password" id="sess-current-password" name="current_password" required class="form-input form-input-sm" placeholder="••••••••" />
				</div>

				<div class="form-grid-2 mb-2">
					<div class="form-group mb-0">
						<label class="form-label text-xs" for="sess-new-password">كلمة المرور الجديدة</label>
						<input type="password" id="sess-new-password" name="new_password" required minlength="8" class="form-input form-input-sm" placeholder="8 أحرف كحد أدنى" />
					</div>
					<div class="form-group mb-0">
						<label class="form-label text-xs" for="sess-confirm-password">تأكيد الجديدة</label>
						<input type="password" id="sess-confirm-password" name="confirm_password" required minlength="8" class="form-input form-input-sm" placeholder="••••••••" />
					</div>
				</div>

				<div style="margin-top:0.75rem;">
					<button type="submit" class="btn btn-primary btn-sm font-bold" style="padding:0.45rem 1.25rem;">
						@components.IconCheck("icon-xs")
						<span>حفظ التغييرات</span>
					</button>
				</div>
			</form>
		</div>

	</div>
}
