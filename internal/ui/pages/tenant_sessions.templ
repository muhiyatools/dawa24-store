package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type TenantSessionsViewData struct {
	Sessions         []*identity.Session
	CurrentToken     string
	CurrentUserID    int64
	IsSuperAdmin     bool
	MaxLoginSessions int
	MaxDevices       int
	PlanName         string
	IsVendor         bool
	NoticeType       string
	NoticeMessage    string
}

templ TenantSessionsPage(lang, dir string, data TenantSessionsViewData) {
	if data.IsVendor {
		@layouts.VendorShell("الأجهزة والجلسات النشطة", "sessions", lang, dir) {
			@tenantSessionsContent(lang, dir, data)
		}
	} else {
		@layouts.CustomerShell("الأجهزة والجلسات النشطة", "sessions", lang, dir, nil) {
			@tenantSessionsContent(lang, dir, data)
		}
	}
}

templ tenantSessionsContent(lang, dir string, data TenantSessionsViewData) {
	<div class="page-container">
		
		<!-- Compact Page Header -->
  <div class="stack-sm">
   <div class="stack-sm">
				<h1 class="page-title font-bold text-xl m-0">
					@components.IconShield("icon-sm")
					<span>الأجهزة والجلسات النشطة</span>
				</h1>
    <p class="text-sm text-secondary m-0">
					إدارة الأجهزة المتصلة بحساب المنشأة وسعة الجلسات المتزامنة ({ data.PlanName })
				</p>
			</div>

   <div class="stack-sm">
				<a
 href={ templ.SafeURL(ternary(data.IsVendor, "/vendor/mfa", "/customer/mfa")) }
 class="btn btn-secondary btn-sm font-bold rounded-lg"
 
>
					<span>@components.IconShield("icon-sm")</span>
					<span>المصادقة الثنائية (MFA)</span>
				</a>
				if data.IsVendor {
					<a href="/vendor/subscription" class="btn btn-outline-brand btn-sm font-bold rounded-lg">
						@components.IconSparkles("icon-xs")
						<span>ترقية الباقة</span>
					</a>
				} else {
					<a href="/customer/subscription" class="btn btn-outline-brand btn-sm font-bold rounded-lg">
						@components.IconSparkles("icon-xs")
						<span>ترقية الباقة</span>
					</a>
				}
			</div>
		</div>

		<!-- Flash Notices -->
		if data.NoticeMessage != "" {
			if data.NoticeType == "error" {
				<div class="alert alert-danger">
					@components.IconAlert("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			} else {
				<div class="alert alert-success">
					@components.IconCheckCircle("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			}
		}

		<!-- Compact Metrics Bar -->
		<div class="card p-4">
   <div class="stack-sm">
    <div class="stack-sm">
					<div class="stat-label text-sm text-secondary">الجلسات المتصلة</div>
					<div class="tabular-nums">
						{ fmt.Sprintf("%d", len(data.Sessions)) } <span>/ { fmt.Sprintf("%d", data.MaxLoginSessions) } مسموحة</span>
					</div>
				</div>

    <div class="stack-sm">
					<div class="stat-label text-sm text-secondary">حالة السعة</div>
     <div class="stack-sm">
						if len(data.Sessions) >= data.MaxLoginSessions {
							<span class="badge badge-amber font-bold text-xs">الحد الأقصى مستنفد</span>
						} else {
							<span class="badge badge-emerald font-bold text-xs">سعة متاحة</span>
						}
					</div>
				</div>

    <div class="stack-sm">
					<div class="stat-label text-sm text-secondary">حد الأجهزة المعتمدة</div>
					<div class="tabular-nums">
						{ fmt.Sprintf("%d", data.MaxDevices) } أجهزة
					</div>
				</div>

    <div class="stack-sm">
					<div class="stat-label text-sm text-secondary">باقة المنشأة</div>
     <div class="stack-sm">
						{ data.PlanName }
					</div>
				</div>
			</div>
		</div>

		<!-- Active Sessions List -->
		<div class="card p-5">
   <div class="stack-sm">
				<h2 class="card-title font-bold text-base m-0">
					الأجهزة المتصلة حالياً ({ fmt.Sprintf("%d", len(data.Sessions)) })
				</h2>

				if len(data.Sessions) > 1 {
					<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/sessions/revoke-all", "/customer/sessions/revoke-all")) } method="POST" class="m-0" onsubmit="return confirm('إنهاء كافة الجلسات الأخرى والإبقاء على هذا الجهاز فقط؟');">
						<input type="hidden" name="current_token" value={ data.CurrentToken } />
						<button type="submit" class="btn btn-outline-danger btn-xs font-bold">
							@components.IconLogout("icon-xs")
							<span>إنهاء الجلسات الأخرى</span>
						</button>
					</form>
				}
			</div>

			if len(data.Sessions) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد جلسات نشطة",
					Message: "لم يتم العثور على أي جلسات متصلة حالياً.",
				})
			} else {
    <div class="stack-sm">
					for _, sess := range data.Sessions {
						<div class="stack-sm"
							style={ fmt.Sprintf("display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1rem; border-radius:var(--radius-lg); border:1px solid %s; background:%s; flex-wrap:wrap; gap:0.75rem;",
								ternary(sess.Token == data.CurrentToken, "var(--primary-subtle)", "var(--border)"),
								ternary(sess.Token == data.CurrentToken, "var(--primary-subtle)", "var(--surface-sunken)")) }
						>
       <div class="stack-sm">
								<span>
									if sess.Icon != "" {
										{ sess.Icon }
									} else {
										@components.IconMonitor("icon-sm")
									}
								</span>
        <div class="stack-sm">
									<div class="inline-row-wrap">
										<span>
											if sess.DeviceName != "" {
												{ sess.DeviceName }
											} else {
												جهاز غير محدد
											}
										</span>
										if sess.Token == data.CurrentToken {
											<span class="badge badge-emerald text-xs font-bold">
												جهازك الحالي
											</span>
										}
									</div>
									<div class="tabular-nums">
										<span>{ sess.Email }</span>
										if sess.IP != "" {
											<span>• { sess.IP }</span>
										}
										<span>• { sess.CreatedAt.Format("2006-01-02 15:04") }</span>
									</div>
								</div>
							</div>

       <div class="stack-sm">
								if sess.Token == data.CurrentToken {
									<form action="/auth/logout" method="POST" class="m-0">
										<button type="submit" class="btn btn-secondary btn-xs font-semibold">
											<span>تسجيل الخروج</span>
										</button>
									</form>
								} else if sess.UserID == data.CurrentUserID || data.IsSuperAdmin {
									<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/sessions/revoke", "/customer/sessions/revoke")) } method="POST" class="m-0" onsubmit="return confirm('إنهاء جلسة هذا الجهاز؟');">
										<input type="hidden" name="token" value={ sess.Token } />
										<button type="submit" class="btn btn-outline-danger btn-xs font-semibold">
											<span>إنهاء</span>
										</button>
									</form>
								} else {
									<span class="badge badge-slate text-xs font-medium">
										مستخدم آخر
									</span>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>

		<!-- Password Security Form -->
		<div class="card p-5">
   <div class="stack-sm">
				<h2 class="card-title font-bold text-base m-0">
					تحديث كلمة المرور
				</h2>
    <p class="text-sm text-secondary m-0">
					تغيير كلمة المرور الخاصة بحسابك ينهي الجلسات الأخرى فوراً
				</p>
			</div>

			<form action={ templ.SafeURL(ternary(data.IsVendor, "/vendor/password", "/customer/password")) } method="POST" class="stack-sm">
				<div class="form-group mb-2">
					<label class="form-label text-xs" for="sess-current-password">كلمة المرور الحالية</label>
					<input type="password" id="sess-current-password" name="current_password" required class="form-input form-input-sm" placeholder="••••••••" />
				</div>

				<div class="form-grid-2 mb-2">
					<div class="form-group mb-0">
						<label class="form-label text-xs" for="sess-new-password">كلمة المرور الجديدة</label>
						<input type="password" id="sess-new-password" name="new_password" required minlength="8" class="form-input form-input-sm" placeholder="8 أحرف كحد أدنى" />
					</div>
					<div class="form-group mb-0">
						<label class="form-label text-xs" for="sess-confirm-password">تأكيد الجديدة</label>
						<input type="password" id="sess-confirm-password" name="confirm_password" required minlength="8" class="form-input form-input-sm" placeholder="••••••••" />
					</div>
				</div>

    <div class="stack-sm">
					<button type="submit" class="btn btn-primary btn-sm font-bold">
						@components.IconCheck("icon-xs")
						<span>حفظ التغييرات</span>
					</button>
				</div>
			</form>
		</div>

	</div>
}
