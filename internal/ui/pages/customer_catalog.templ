package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CatalogPageData struct {
	Products    []*catalog.Product
	Categories  []*catalog.Category
	Query       string
	CategoryID  *int64
	MinPrice    string
	MaxPrice    string
	DosageForm  string
	Sort        string
	InStock     bool
}

templ CustomerCatalog(data CatalogPageData, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCatalogList(data.Products, lang)
	} else {
		@layouts.PublicShell("كتالوج الأدوية والمستلزمات الطبية المعتمدة", lang, dir) {
			<div class="container" style="max-width:1240px; margin:1.5rem auto 4rem auto; padding:0 1rem;">
				
				<!-- Page Header -->
				<div style="margin-bottom:1.5rem;">
					<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
						<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
							@components.IconPackage("icon-xs")
						</div>
						<h1 style="font-size:1.5rem; font-weight:800; color:var(--text); margin:0;">
							كتالوج الأدوية والمستلزمات الطبية
						</h1>
					</div>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0;">
						دليل الأصناف الدوائية المعتمدة والمطابقة لمعايير هيئة الدواء المصرية مع متابعة عروض التوريد الحية.
					</p>
				</div>

				<div class="catalog-page-container" style="display:grid; grid-template-columns:260px 1fr; gap:1.5rem; align-items:start;">
					
					<!-- Filter Sidebar -->
					<aside class="catalog-filters" style="background:var(--surface-raised); padding:1.25rem; border-radius:var(--radius-xl); border:1px solid var(--border); position:sticky; top:80px;">
						<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:0.75rem; margin-bottom:1rem;">
							<h2 style="font-size:0.95rem; font-weight:800; color:var(--text); margin:0;">
								الفلاتر والتصنيف
							</h2>
							<a href="/catalog" style="font-size:0.8rem; font-weight:700; color:var(--accent); text-decoration:none;">
								إعادة ضبط
							</a>
						</div>

						<form action="/catalog" method="GET" style="display:flex; flex-direction:column; gap:1.25rem;">
							if data.Query != "" {
								<input type="hidden" name="q" value={ data.Query } />
							}

							<!-- Categories -->
							<div>
								<label class="form-label" style="font-size:0.825rem; font-weight:700; margin-bottom:0.5rem; display:block;">
									الأقسام الدوائية
								</label>
								<div style="display:flex; flex-direction:column; gap:2px; max-height:220px; overflow-y:auto;">
									<a
										href="/catalog"
										class={ "filter-category-link", templ.KV("active", data.CategoryID == nil) }
										style="display:flex; justify-content:space-between; align-items:center; padding:0.4rem 0.6rem; font-size:0.825rem;"
									>
										<span>جميع الأصناف</span>
										<span class="badge badge-slate" style="font-size:10px;">الكل</span>
									</a>

									for _, cat := range data.Categories {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) }
											class={ "filter-category-link", templ.KV("active", data.CategoryID != nil && *data.CategoryID == cat.ID) }
											style="display:flex; justify-content:space-between; align-items:center; padding:0.4rem 0.6rem; font-size:0.825rem;"
										>
											<span>
												if cat.Name["ar"] != "" {
													{ cat.Name["ar"] }
												} else {
													{ cat.Name["en"] }
												}
											</span>
										</a>
									}
								</div>
							</div>

							<!-- Price Range -->
							<div style="border-top:1px solid var(--border); padding-top:1rem;">
								<label class="form-label" style="font-size:0.825rem; font-weight:700; margin-bottom:0.5rem; display:block;">
									نطاق السعر (ج.م)
								</label>
								<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
									<div>
										<input type="number" name="min_price" value={ data.MinPrice } placeholder="من 0" class="form-input tabular-nums" style="padding:0.4rem 0.5rem; font-size:0.825rem;" />
									</div>
									<div>
										<input type="number" name="max_price" value={ data.MaxPrice } placeholder="إلى 1000" class="form-input tabular-nums" style="padding:0.4rem 0.5rem; font-size:0.825rem;" />
									</div>
								</div>
							</div>

							<!-- Dosage Forms -->
							<div style="border-top:1px solid var(--border); padding-top:1rem;">
								<label class="form-label" style="font-size:0.825rem; font-weight:700; margin-bottom:0.5rem; display:block;">
									الشكل الدوائي
								</label>
								<div style="display:flex; flex-wrap:wrap; gap:0.35rem;">
									<button
										type="submit"
										name="dosage_form"
										value="أقراص"
										class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "أقراص" || data.DosageForm == "tablet"), templ.KV("btn-secondary", data.DosageForm != "أقراص" && data.DosageForm != "tablet") }
										style="padding:0.25rem 0.55rem; font-size:0.75rem;"
									>
										أقراص
									</button>
									<button
										type="submit"
										name="dosage_form"
										value="كبسولات"
										class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "كبسولات" || data.DosageForm == "capsule"), templ.KV("btn-secondary", data.DosageForm != "كبسولات" && data.DosageForm != "capsule") }
										style="padding:0.25rem 0.55rem; font-size:0.75rem;"
									>
										كبسولات
									</button>
									<button
										type="submit"
										name="dosage_form"
										value="شراب"
										class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "شراب" || data.DosageForm == "syrup"), templ.KV("btn-secondary", data.DosageForm != "شراب" && data.DosageForm != "syrup") }
										style="padding:0.25rem 0.55rem; font-size:0.75rem;"
									>
										شراب
									</button>
									<button
										type="submit"
										name="dosage_form"
										value="فوار"
										class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "فوار"), templ.KV("btn-secondary", data.DosageForm != "فوار") }
										style="padding:0.25rem 0.55rem; font-size:0.75rem;"
									>
										فوار
									</button>
								</div>
							</div>

							<!-- Availability -->
							<div style="border-top:1px solid var(--border); padding-top:0.75rem;">
								<label style="display:flex; align-items:center; gap:0.5rem; font-size:0.825rem; font-weight:600; color:var(--text); cursor:pointer;">
									<input type="checkbox" name="in_stock" value="true" checked?={ data.InStock } style="accent-color:var(--accent); width:15px; height:15px;" />
									<span>الأصناف المتوفرة فورياً</span>
								</label>
							</div>

							<button type="submit" class="btn btn-primary btn-sm" style="width:100%; justify-content:center; padding:0.55rem; font-weight:700;">
								@components.IconSearch("icon-xs")
								<span>تصفية النتائج</span>
							</button>
						</form>
					</aside>

					<!-- Main Results Column -->
					<main class="catalog-content">
						<!-- Search & Sort Top Toolbar -->
						<div style="margin-bottom:1.25rem; background:var(--surface-raised); padding:0.85rem 1rem; border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
							
							<div style="position:relative; flex:1; min-width:220px;">
								<div style="position:absolute; inset-inline-start:10px; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
									@components.IconSearch("icon-xs")
								</div>
								<input
									type="search"
									name="q"
									value={ data.Query }
									placeholder="ابحث بالاسم التجاري، المادة الفعالة، أو الباركود..."
									class="form-input"
									style="font-size:0.85rem; padding:0.45rem 0.75rem 0.45rem 2rem; border-radius:var(--radius-md);"
									hx-get="/catalog"
									hx-trigger="keyup changed delay:300ms, search"
									hx-target="#catalog-results"
									hx-push-url="true"
								/>
							</div>

							<div style="display:flex; align-items:center; gap:0.5rem;">
								<label style="font-size:0.8rem; font-weight:600; color:var(--text-secondary); white-space:nowrap;">ترتيب:</label>
								<select
									name="sort"
									class="form-select"
									style="font-size:0.8rem; padding:0.35rem 0.75rem; width:auto; border-radius:var(--radius-md);"
									onchange="window.location = '/catalog?q=' + encodeURIComponent(document.querySelector('input[name=q]').value) + '&sort=' + this.value"
								>
									<option value="" selected?={ data.Sort == "" }>الأكثر طلباً</option>
									<option value="price_asc" selected?={ data.Sort == "price_asc" }>السعر: الأقل أولاً</option>
									<option value="price_desc" selected?={ data.Sort == "price_desc" }>السعر: الأعلى أولاً</option>
									<option value="newest" selected?={ data.Sort == "newest" }>الأحدث</option>
									<option value="name" selected?={ data.Sort == "name" }>الاسم أبجدياً</option>
								</select>
							</div>
						</div>

						<!-- Results Grid Container -->
						<div id="catalog-results">
							@CustomerCatalogList(data.Products, lang)
						</div>
					</main>
				</div>
			</div>
		}
	}
}

templ CustomerCatalogList(products []*catalog.Product, lang string) {
	if len(products) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد أصناف مطابقة للبحث",
			Message:     "لم نعثر على أدوية مطابقة لمعايير البحث الحالية. يمكنك تعديل كلمات البحث أو تصفير الفلاتر.",
			ActionLabel: "عرض كافة الأدوية",
		})
	} else {
		<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:1rem;">
			for _, p := range products {
				<div class="card" style="display:flex; flex-direction:column; justify-content:space-between; padding:1.15rem; margin-bottom:0; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); transition:all 0.2s ease;">
					<div>
						<!-- Top Pills & Favorite -->
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
							<div style="display:flex; align-items:center; gap:0.35rem;">
								if p.DosageForm != "" {
									<span class="badge badge-sky" style="font-size:0.725rem; font-weight:700;">
										{ p.DosageForm }
									</span>
								}
								if p.Status == catalog.StatusActive {
									<span class="badge badge-emerald" style="font-size:0.725rem; font-weight:700;">متوفر للتوريد</span>
								}
							</div>

							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", p.ID)) } class="m-0">
								<button type="submit" class="btn btn-secondary btn-icon" style="width:28px; height:28px; color:var(--text-muted);" title="حفظ في المفضلة">
									@components.IconHeart("icon-xs")
								</button>
							</form>
						</div>

						<!-- Product Titles -->
						<h3 style="font-size:1.05rem; font-weight:800; margin:0 0 2px 0; color:var(--text); line-height:1.35;">
							<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } style="color:inherit; text-decoration:none;">
								if p.Name["ar"] != "" {
									{ p.Name["ar"] }
								} else {
									{ p.Name["en"] }
								}
							</a>
						</h3>
						if p.Name["en"] != "" && p.Name["en"] != p.Name["ar"] {
							<div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.6rem; font-weight:500;" dir="ltr">
								{ p.Name["en"] }
							</div>
						}

						<!-- Scientific Info & Manufacturer -->
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.6rem 0.75rem; margin-bottom:0.75rem; font-size:0.775rem; display:flex; flex-direction:column; gap:3px;">
							if p.ScientificName != "" {
								<div style="color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
									<span style="color:var(--text-muted);">المادة:</span> <strong>{ p.ScientificName }</strong>
								</div>
							}
							if p.ManufacturingCompanies != "" {
								<div style="color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
									<span style="color:var(--text-muted);">الشركة:</span> { p.ManufacturingCompanies }
								</div>
							}
						</div>

						<!-- Supply stats if any -->
						if p.SoldTimes > 0 {
							<div style="font-size:0.75rem; color:var(--text-muted); display:flex; align-items:center; gap:0.25rem; margin-bottom:0.5rem;">
								@components.IconCheckCircle("icon-xs")
								<span>تم توريدها { fmt.Sprintf("%d", p.SoldTimes) } مرة</span>
							</div>
						}
					</div>

					<!-- Bottom Pricing & Action -->
					<div style="border-top:1px solid var(--border); padding-top:0.75rem; margin-top:0.5rem;">
						<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.65rem;">
							<div style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">سعر الجمهور / الوحدة:</div>
							<div class="tabular-nums" style="font-size:1.15rem; font-weight:900; color:var(--accent);">
								if p.Price.IsPositive() {
									{ p.Price.String() } ج.م
								} else {
									<span style="font-size:0.85rem; color:var(--text-muted);">حسب الكمية</span>
								}
							</div>
						</div>

						<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-primary btn-sm" style="width:100%; font-size:0.825rem; font-weight:700; justify-content:center; padding:0.5rem;">
							<span>عرض عروض الموردين والطلب</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					</div>
				</div>
			}
		</div>
	}
}

