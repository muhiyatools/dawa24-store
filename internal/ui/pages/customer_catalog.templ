package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCatalog(products []*catalog.Product, categories []*catalog.Category, query string, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCatalogList(products, lang)
	} else {
		@layouts.CustomerShell("كتالوج الأدوية والمستلزمات | Catalog", lang, dir) {
			<div class="catalog-page-container" style="display:grid; grid-template-columns:260px 1fr; gap:2rem; margin-top:1rem;">
				<aside class="catalog-filters" style="background:#fff; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border-card); height:fit-content; box-shadow:var(--shadow-xs);">
					<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem; border-bottom:1px solid var(--neutral-100); padding-bottom:0.75rem;">
						@components.IconPill("icon-sm")
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin:0;">
							الأقسام الدوائية
						</h3>
					</div>
					<ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.35rem;">
						<li>
							<a href="/catalog" class="sidebar-link" style="color:var(--primary-700); font-weight:700; background:var(--primary-50); border-radius:var(--radius-md); padding:0.5rem 0.75rem; display:block;">
								<span>جميع الأدوية والمستلزمات</span>
							</a>
						</li>
						for _, cat := range categories {
							<li>
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) } class="sidebar-link" style="color:var(--neutral-700); border-radius:var(--radius-md); padding:0.5rem 0.75rem; display:block;">
									<span>
										if cat.Name["ar"] != "" {
											{ cat.Name["ar"] }
										} else {
											{ cat.Name["en"] }
										}
									</span>
								</a>
							</li>
						}
					</ul>
				</aside>

				<main class="catalog-content">
					<div class="catalog-search-bar" style="margin-bottom:1.5rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
						<div style="position:relative; flex:1; min-width:260px;">
							<input
								type="search"
								name="q"
								value={ query }
								placeholder="ابحث بالاسم التجاري، المادة الفعالة، أو الباركود..."
								class="form-input"
								style="font-size:0.95rem; padding:0.75rem 1rem; border-radius:var(--radius-lg);"
								hx-get="/catalog"
								hx-trigger="keyup changed delay:300ms, search"
								hx-target="#catalog-results"
								hx-push-url="true"
							/>
						</div>
						<select name="sort" class="form-input" style="width:auto;" onchange="window.location = '/catalog?q=' + encodeURIComponent(document.querySelector('input[name=q]').value) + '&sort=' + this.value">
							<option value="">الأكثر مبيعاً</option>
							<option value="price_asc">السعر: من الأقل</option>
							<option value="price_desc">السعر: من الأعلى</option>
							<option value="newest">الأحدث</option>
							<option value="name">الاسم</option>
						</select>
					</div>

					<div id="catalog-results">
						@CustomerCatalogList(products, lang)
					</div>
				</main>
			</div>
		}
	}
}

templ CustomerCatalogList(products []*catalog.Product, lang string) {
	if len(products) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد منتجات مطابقة",
			Message:     "لم نعثر على أي أدوية أو مستلزمات تطابق معايير البحث الحالية.",
			ActionLabel: "عرض كل المنتجات",
		})
	} else {
		<div class="product-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:1.5rem;">
			for _, p := range products {
				<div class="card hover-lift" style="display:flex; flex-direction:column; justify-content:space-between; padding:1.5rem; margin-bottom:0;">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
							<span class="badge badge-slate" style="font-size:0.75rem;">
								@components.IconPill("icon-xs")
								<span>{ p.DosageForm }</span>
							</span>

							<!-- Favorite Heart Button -->
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", p.ID)) } style="margin:0;">
								<button type="submit" class="btn btn-secondary btn-icon" style="width:30px; height:30px; color:var(--primary-600);" title="حفظ في المفضلة">
									@components.IconHeart("icon-xs")
								</button>
							</form>
						</div>

						<h4 style="font-size:1.1rem; font-weight:800; margin-bottom:0.25rem; color:var(--neutral-900); line-height:1.4;">
							if p.Name["ar"] != "" {
								{ p.Name["ar"] }
							} else {
								{ p.Name["en"] }
							}
						</h4>
						<p style="font-size:0.825rem; color:var(--neutral-500); margin-bottom:0.5rem;">
							{ p.Name["en"] }
						</p>
						if p.ManufacturingCompanies != "" {
							<div style="font-size:0.8rem; color:var(--neutral-600); margin-bottom:0.25rem;">
								الشركة: { p.ManufacturingCompanies }
							</div>
						}
						if p.Barcode != "" {
							<div style="font-size:0.75rem; color:var(--neutral-400);" class="tabular-nums">
								باركود: { p.Barcode }
							</div>
						}
					</div>

					<div style="margin-top:1.5rem; border-top:1px solid var(--neutral-100); padding-top:1rem;">
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-primary" style="width:100%; font-size:0.875rem; font-weight:700; justify-content:center;">
							@components.IconFileText("icon-xs")
							<span>التفاصيل والطلب</span>
						</a>
					</div>
				</div>
			}
		</div>
	}
}
