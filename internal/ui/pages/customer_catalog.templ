package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ CustomerCatalog(products []*catalog.Product, categories []*catalog.Category, query string, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCatalogList(products, lang)
	} else {
		@layouts.CustomerShell("كتالوج الأدوية والمستلزمات | Catalog", lang, dir) {
			<div class="catalog-page-container" style="display:grid; grid-template-columns:260px 1fr; gap:2rem; margin-top:1rem;">
				<aside class="catalog-filters" style="background:#fff; padding:1.5rem; border-radius:var(--radius-xl); border:1px solid var(--border-card); height:fit-content; box-shadow:var(--shadow-xs);">
					<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem; border-bottom:1px solid var(--neutral-100); padding-bottom:0.75rem;">
						@components.IconPill("icon-sm")
						<h3 style="font-size:1.1rem; font-weight:700; color:var(--neutral-900); margin:0;">
							الأقسام الدوائية
						</h3>
					</div>
					<ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.35rem;">
						<li>
							<a href="/catalog" class="sidebar-link" style="color:var(--primary-700); font-weight:700; background:var(--primary-50); border-radius:var(--radius-md); padding:0.5rem 0.75rem;">
								<span>جميع الأدوية والمستلزمات</span>
							</a>
						</li>
						for _, cat := range categories {
							<li>
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) } class="sidebar-link" style="color:var(--neutral-700); border-radius:var(--radius-md); padding:0.5rem 0.75rem;">
									<span>
										if cat.Name["ar"] != "" {
											{ cat.Name["ar"] }
										} else {
											{ cat.Name["en"] }
										}
									</span>
								</a>
							</li>
						}
					</ul>
				</aside>

				<main class="catalog-content">
					<div class="catalog-search-bar" style="margin-bottom:1.5rem; display:flex; gap:0.75rem;">
						<div style="position:relative; flex:1;">
							<input
								type="search"
								name="q"
								value={ query }
								placeholder="ابحث بالاسم التجاري، المادة الفعالة، أو الباركود..."
								class="form-input"
								style="font-size:0.95rem; padding:0.75rem 1rem; border-radius:var(--radius-lg);"
								hx-get="/catalog"
								hx-trigger="keyup changed delay:300ms, search"
								hx-target="#catalog-results"
								hx-push-url="true"
							/>
						</div>
					</div>

					<div id="catalog-results">
						@CustomerCatalogList(products, lang)
					</div>
				</main>
			</div>
		}
	}
}

templ CustomerCatalogList(products []*catalog.Product, lang string) {
	if len(products) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد منتجات مطابقة",
			Message:     "لم نعثر على أي أدوية أو مستلزمات تطابق معايير البحث الحالية.",
			ActionLabel: "عرض كل المنتجات",
		})
	} else {
		<div class="product-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:1.25rem;">
			for _, p := range products {
				<div class="card hover-lift" style="display:flex; flex-direction:column; justify-content:space-between; padding:1.25rem; margin-bottom:0;">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.6rem;">
							<span class="badge badge-slate" style="font-size:0.725rem;">
								@components.IconPill("icon-xs")
								<span>{ p.DosageForm }</span>
							</span>
							<span class="badge badge-emerald" style="font-size:0.725rem;">متوفر</span>
						</div>
						<h4 style="font-size:1.05rem; font-weight:700; margin-bottom:0.25rem; color:var(--neutral-900);">
							if p.Name["ar"] != "" {
								{ p.Name["ar"] }
							} else {
								{ p.Name["en"] }
							}
						</h4>
						<p style="font-size:0.8rem; color:var(--neutral-500); margin-bottom:0.5rem;">
							{ p.Name["en"] }
						</p>
						if p.ManufacturingCompanies != "" {
							<p style="font-size:0.775rem; color:var(--neutral-600); margin-bottom:0.25rem;">
								الشركة: { p.ManufacturingCompanies }
							</p>
						}
						if p.Barcode != "" {
							<p style="font-size:0.75rem; color:var(--neutral-400);" class="tabular-nums">
								باركود: { p.Barcode }
							</p>
						}
					</div>

					<div style="margin-top:1.25rem; border-top:1px solid var(--neutral-100); padding-top:0.875rem;">
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-secondary" style="width:100%; font-size:0.85rem; justify-content:center;">
							@components.IconFileText("icon-xs")
							<span>التفاصيل والأسعار</span>
						</a>
					</div>
				</div>
			}
		</div>
	}
}
