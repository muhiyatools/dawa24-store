package pages

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func buildCatalogURL(data CatalogPageData, page int, pageSize int, sort, view string) string {
	u, _ := url.Parse("/catalog")
	q := u.Query()

	if data.Query != "" {
		q.Set("q", data.Query)
	}
	if data.CategoryID != nil {
		q.Set("category_id", strconv.FormatInt(*data.CategoryID, 10))
	}
	if data.BrandID != nil {
		q.Set("brand_id", strconv.FormatInt(*data.BrandID, 10))
	}
	if data.MinPrice != "" {
		q.Set("min_price", data.MinPrice)
	}
	if data.MaxPrice != "" {
		q.Set("max_price", data.MaxPrice)
	}
	if data.DosageForm != "" {
		q.Set("dosage_form", data.DosageForm)
	}
	if data.InStock {
		q.Set("in_stock", "true")
	}
	if data.HasDiscount {
		q.Set("has_discount", "true")
	}

	if sort != "" {
		q.Set("sort", sort)
	} else if data.Sort != "" {
		q.Set("sort", data.Sort)
	}

	if view != "" {
		q.Set("view", view)
	} else if data.ViewMode != "" {
		q.Set("view", data.ViewMode)
	}

	if pageSize > 0 {
		q.Set("page_size", strconv.Itoa(pageSize))
	} else if data.PageSize > 0 {
		q.Set("page_size", strconv.Itoa(data.PageSize))
	}

	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}

	u.RawQuery = q.Encode()
	return u.String()
}

templ CustomerCatalog(data CatalogPageData, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCatalogResults(data, lang)
	} else {
		@layouts.PublicShell("كتالوج توريد الأدوية والمستلزمات الطبية | دواء 24", lang, dir) {
			<div class="page-container py-6">
				
				<!-- Page Header Strip -->
				<div class="glass-panel p-5 mb-5 flex-between flex-wrap gap-4 border border-slate-200/80 rounded-2xl shadow-sm">
					<div>
						<nav class="breadcrumb-trail text-xs text-muted mb-1.5 d-flex items-center gap-1.5 font-semibold">
							<a href="/" class="text-secondary hover:text-primary transition-colors">الرئيسية</a>
							<span class="text-slate-300">/</span>
							<span class="text-primary font-bold">كتالوج التوريد الدوائي</span>
						</nav>
						<h1 class="text-2xl font-black text-primary m-0 tracking-tight">
							كتالوج عروض توريد الأدوية والمستلزمات الطبية
						</h1>
						<p class="text-xs text-secondary mt-1 mb-0 font-medium">
							استعراض ومقارنة أسعار التوريد اللحظية من كبرى شركات التوزيع والمستودعات الدوائية المعتمدة
						</p>
					</div>

					<div class="page-actions-group d-flex items-center gap-2.5">
						<a href="/customer/purchase-request" class="btn btn-secondary btn-sm font-bold gap-2 shadow-xs">
							@components.IconZap("icon-xs text-amber-500")
							<span>طلب شراء ذكي</span>
						</a>
						<a href="/cart" class="btn btn-primary btn-sm font-extrabold gap-2 px-4 shadow-sm">
							@components.IconCart("icon-xs")
							<span>سلة المشتريات</span>
						</a>
					</div>
				</div>

				<!-- Quick Dosage Form Pills Strip -->
				<div class="dosage-pills-strip d-flex gap-2 mb-5 overflow-x-auto pb-1.5 scrollbar-none">
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == ""), templ.KV("btn-secondary", data.DosageForm != "") }
					>
						@components.IconPill("icon-xs")
						<span>كافة الأشكال الدوائية</span>
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "أقراص", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == "أقراص" || data.DosageForm == "tablet"), templ.KV("btn-secondary", data.DosageForm != "أقراص" && data.DosageForm != "tablet") }
					>
						<span>أقراص</span>
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "كبسولات", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == "كبسولات" || data.DosageForm == "capsule"), templ.KV("btn-secondary", data.DosageForm != "كبسولات" && data.DosageForm != "capsule") }
					>
						<span>كبسولات</span>
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "شراب", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == "شراب" || data.DosageForm == "syrup"), templ.KV("btn-secondary", data.DosageForm != "شراب" && data.DosageForm != "syrup") }
					>
						<span>شراب وسوائل</span>
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "حقن", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == "حقن" || data.DosageForm == "ampoule"), templ.KV("btn-secondary", data.DosageForm != "حقن" && data.DosageForm != "ampoule") }
					>
						<span>حقن وأمبولات</span>
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "مرهم", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == "مرهم" || data.DosageForm == "cream" || data.DosageForm == "ointment"), templ.KV("btn-secondary", data.DosageForm != "مرهم" && data.DosageForm != "cream" && data.DosageForm != "ointment") }
					>
						<span>مراهم وكريمات</span>
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "فوار", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == "فوار" || data.DosageForm == "sachet"), templ.KV("btn-secondary", data.DosageForm != "فوار" && data.DosageForm != "sachet") }
					>
						<span>فوار وأكياس</span>
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "قطرة", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm btn-pill gap-1.5 text-xs font-bold transition-all", templ.KV("btn-primary font-extrabold shadow-sm", data.DosageForm == "قطرة" || data.DosageForm == "drops"), templ.KV("btn-secondary", data.DosageForm != "قطرة" && data.DosageForm != "drops") }
					>
						<span>قطرات ومحاليل</span>
					</a>
				</div>

				<!-- Main 2-Column Grid Layout -->
				<div class="catalog-main-layout">
					
					<!-- Filter Sidebar (Right in RTL) -->
					<aside class="catalog-sidebar-filter glass-panel p-4.5 border border-slate-200/80 rounded-2xl shadow-xs">
						<div class="flex-between border-b border-slate-100 pb-3 mb-4">
							<div class="d-flex items-center gap-2">
								@components.IconFilter("icon-sm text-primary")
								<h2 class="text-sm font-extrabold text-primary m-0">
									الفلاتر والبحث المتقدم
								</h2>
							</div>
							<a href="/catalog" class="text-xs font-bold text-rose-600 hover:text-rose-700 transition-colors" title="تصفير الفلاتر">
								تصفير
							</a>
						</div>

						<form action="/catalog" method="GET" class="d-flex flex-col gap-4" id="catalog-filter-form">
							<!-- Anti-Scraping Honeypot Trap (Hidden from users) -->
							<input type="text" name="company_tax_ref" class="d-none" tabindex="-1" autocomplete="off" />

							if data.Query != "" {
								<input type="hidden" name="q" value={ data.Query } />
							}
							if data.Sort != "" {
								<input type="hidden" name="sort" value={ data.Sort } />
							}
							if data.ViewMode != "" {
								<input type="hidden" name="view" value={ data.ViewMode } />
							}
							if data.PageSize > 0 {
								<input type="hidden" name="page_size" value={ strconv.Itoa(data.PageSize) } />
							}
							if data.DosageForm != "" {
								<input type="hidden" name="dosage_form" value={ data.DosageForm } />
							}

							<!-- Categories Tree -->
							<div>
								<label class="form-label text-xs font-bold mb-1.5 text-primary d-flex items-center gap-1.5">
									@components.IconLayers("icon-xs text-muted")
									<span>التصنيف الدوائي</span>
								</label>
								<div class="d-flex flex-col gap-1 overflow-y-auto border border-slate-200/80 rounded-xl p-1.5 bg-surface-sunken" style="max-height: 180px;">
									<a
										href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
										class={ "sidebar-link p-2 text-xs rounded-lg font-semibold flex-between transition-colors", templ.KV("active bg-primary/10 text-primary font-bold", data.CategoryID == nil) }
									>
										<span>جميع التصنيفات</span>
										<span class="badge badge-slate text-xs font-bold">الكل</span>
									</a>

									for _, cat := range data.Categories {
										<a
											href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: &cat.ID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
											class={ "sidebar-link p-2 text-xs rounded-lg font-medium flex-between transition-colors", templ.KV("active bg-primary/10 text-primary font-bold", data.CategoryID != nil && *data.CategoryID == cat.ID) }
										>
											<span class="text-truncate">
												if cat.Name["ar"] != "" {
													{ cat.Name["ar"] }
												} else {
													{ cat.Name["en"] }
												}
											</span>
										</a>
									}
								</div>
							</div>

							<!-- Manufacturers / Brands -->
							if len(data.Brands) > 0 {
								<div class="border-t border-slate-100 pt-3.5">
									<label class="form-label text-xs font-bold mb-1.5 text-primary d-flex items-center gap-1.5">
										@components.IconBuilding("icon-xs text-muted")
										<span>الشركة المصنعة / الماركة</span>
									</label>
									<select
										name="brand_id"
										class="form-input text-xs w-full font-medium"
										onchange="document.getElementById('catalog-filter-form').submit()"
									>
										<option value="">كافة الشركات والمصانع</option>
										for _, b := range data.Brands {
											<option
												value={ strconv.FormatInt(b.ID, 10) }
												selected?={ data.BrandID != nil && *data.BrandID == b.ID }
											>
												if b.Name.Get(i18n.AR) != "" {
													{ b.Name.Get(i18n.AR) }
												} else {
													{ b.Name.Get(i18n.EN) }
												}
											</option>
										}
									</select>
								</div>
							}

							<!-- Price Range -->
							<div class="border-t border-slate-100 pt-3.5">
								<label class="form-label text-xs font-bold mb-1.5 text-primary d-flex items-center gap-1.5">
									@components.IconTag("icon-xs text-muted")
									<span>سعر التوريد للصيدلية (ج.م)</span>
								</label>
								<div class="d-grid grid-cols-2 gap-2">
									<div>
										<input type="number" name="min_price" value={ data.MinPrice } placeholder="من 0" class="form-input text-xs tabular-nums font-semibold" />
									</div>
									<div>
										<input type="number" name="max_price" value={ data.MaxPrice } placeholder="إلى 1000" class="form-input text-xs tabular-nums font-semibold" />
									</div>
								</div>
							</div>

							<!-- Availability & Discount Checkboxes -->
							<div class="border-t border-slate-100 pt-3.5 d-flex flex-col gap-2.5">
								<label class="d-flex items-center gap-2.5 text-xs font-bold text-primary cursor-pointer select-none">
									<input type="checkbox" name="in_stock" value="true" checked?={ data.InStock } class="form-checkbox text-primary rounded" onchange="document.getElementById('catalog-filter-form').submit()" />
									<span>الأصناف المتوفرة بالمخزون فقط</span>
								</label>
								<label class="d-flex items-center gap-2.5 text-xs font-bold text-primary cursor-pointer select-none">
									<input type="checkbox" name="has_discount" value="true" checked?={ data.HasDiscount } class="form-checkbox text-primary rounded" onchange="document.getElementById('catalog-filter-form').submit()" />
									<span>عروض الخصومات الإضافية %</span>
								</label>
							</div>

							<button type="submit" class="btn btn-primary btn-sm w-full justify-center font-extrabold mt-1 shadow-xs gap-2">
								@components.IconSearch("icon-xs")
								<span>تطبيق الفلاتر</span>
							</button>
						</form>
					</aside>

					<!-- Main Results Area -->
					<main class="catalog-main-content">
						
						<!-- Search Toolbar, Sorting, Rows per Page, View Switcher -->
						<div class="glass-panel p-4 mb-5 border border-slate-200/80 rounded-2xl shadow-xs">
							<div class="flex-between flex-wrap gap-3">
								
								<!-- Live Search Input -->
								<div class="flex-1" style="min-width: 260px; position: relative;">
									<div class="search-input-icon position-absolute inset-y-0 start-0 d-flex items-center ps-3.5 pointer-events-none text-muted">
										@components.IconSearch("icon-sm")
									</div>
									<input
										type="search"
										name="q"
										value={ data.Query }
										placeholder="ابحث بالاسم التجاري، المادة الفعالة، اسم الشركة، أو الباركود..."
										class="form-input ps-10 font-medium text-xs"
										hx-get="/catalog"
										hx-trigger="keyup changed delay:350ms, search"
										hx-target="#catalog-results"
										hx-push-url="true"
										autocomplete="off"
									/>
								</div>

								<!-- Controls: Rows per page, Sort, View Toggle -->
								<div class="d-flex items-center gap-3 flex-wrap">
									
									<!-- Rows Per Page Selector -->
									<div class="d-flex items-center gap-1.5 text-xs font-bold text-secondary">
										<label>عرض:</label>
										<select
											name="page_size"
											class="form-input text-xs w-auto py-1 font-semibold"
											onchange={ templ.ComponentScript{Call: "changePageSize(this.value)"} }
										>
											<option value="12" selected?={ data.PageSize == 12 }>12</option>
											<option value="24" selected?={ data.PageSize == 24 || data.PageSize == 0 }>24</option>
											<option value="48" selected?={ data.PageSize == 48 }>48</option>
											<option value="96" selected?={ data.PageSize == 96 }>96</option>
										</select>
									</div>

									<!-- Sort Selector -->
									<div class="d-flex items-center gap-1.5 text-xs font-bold text-secondary">
										<label>الترتيب:</label>
										<select
											name="sort"
											class="form-input text-xs w-auto py-1 font-semibold"
											onchange={ templ.ComponentScript{Call: "changeSort(this.value)"} }
										>
											<option value="" selected?={ data.Sort == "" }>الأقرب جغرافياً والأعلى توفراً (تلقائي)</option>
											<option value="price_asc" selected?={ data.Sort == "price_asc" }>سعر التوريد: الأقل أولاً</option>
											<option value="price_desc" selected?={ data.Sort == "price_desc" }>سعر التوريد: الأعلى أولاً</option>
											<option value="discount_desc" selected?={ data.Sort == "discount_desc" || data.Sort == "discount" }>أعلى نسبة خصم %</option>
											<option value="newest" selected?={ data.Sort == "newest" }>الأحدث إضافة</option>
											<option value="name" selected?={ data.Sort == "name" }>الاسم أبجدياً</option>
										</select>
									</div>

									<!-- View Mode Toggle: Grid vs Table -->
									<div class="cb-tabs-nav p-1 d-flex gap-1 bg-slate-100 rounded-lg border border-slate-200/60">
										<button
											type="button"
											onclick={ templ.ComponentScript{Call: "changeViewMode('grid')"} }
											class={ "btn btn-icon btn-xs", templ.KV("btn-primary shadow-xs", data.ViewMode == "grid" || data.ViewMode == ""), templ.KV("btn-ghost text-slate-500", data.ViewMode == "table") }
											title="عرض البطاقات (Grid)"
										>
											@components.IconGrid("icon-xs")
										</button>
										<button
											type="button"
											onclick={ templ.ComponentScript{Call: "changeViewMode('table')"} }
											class={ "btn btn-icon btn-xs", templ.KV("btn-primary shadow-xs", data.ViewMode == "table"), templ.KV("btn-ghost text-slate-500", data.ViewMode != "table") }
											title="عرض جدول التوريد السريع (Table)"
										>
											@components.IconList("icon-xs")
										</button>
									</div>

								</div>
							</div>

							<!-- Active Filter Chips Strip -->
							if data.Query != "" || data.ActiveCategory != "" || data.ActiveBrand != "" || data.DosageForm != "" || data.InStock || data.HasDiscount || data.MinPrice != "" || data.MaxPrice != "" {
								<div class="d-flex items-center gap-2 flex-wrap mt-3 pt-3 border-t border-slate-100 text-xs font-semibold">
									<span class="text-secondary font-bold">فلاتر نشطة:</span>
									if data.Query != "" {
										<span class="badge badge-primary gap-1">
											<span>بحث: "{ data.Query }"</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } class="text-white text-decoration-none ms-1">✕</a>
										</span>
									}
									if data.ActiveCategory != "" {
										<span class="badge badge-sky gap-1">
											<span>القسم: { data.ActiveCategory }</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } class="text-decoration-none ms-1">✕</a>
										</span>
									}
									if data.ActiveBrand != "" {
										<span class="badge badge-sky gap-1">
											<span>الشركة: { data.ActiveBrand }</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } class="text-decoration-none ms-1">✕</a>
										</span>
									}
									if data.DosageForm != "" {
										<span class="badge badge-slate gap-1">
											<span>الشكل: { data.DosageForm }</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } class="text-decoration-none ms-1">✕</a>
										</span>
									}
									if data.InStock {
										<span class="badge badge-emerald gap-1">
											<span>المتوفر بالمخزون</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } class="text-decoration-none ms-1">✕</a>
										</span>
									}
									if data.HasDiscount {
										<span class="badge badge-amber gap-1">
											<span>عروض الخصم</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } class="text-decoration-none ms-1">✕</a>
										</span>
									}
									<a href="/catalog" class="text-xs text-rose-600 hover:text-rose-700 ms-auto font-bold no-underline">
										مسح جميع الفلاتر
									</a>
								</div>
							}
						</div>

						<!-- Results Dynamic Container -->
						<div id="catalog-results">
							@CustomerCatalogResults(data, lang)
						</div>

					</main>
				</div>
			</div>

			<!-- Price Negotiation Modal -->
			@CustomerNegotiationModal()

			<script>
				function changePageSize(size) {
					const url = new URL(window.location.href);
					url.searchParams.set('page_size', size);
					url.searchParams.set('page', '1');
					window.location.href = url.toString();
				}

				function changeSort(sortVal) {
					const url = new URL(window.location.href);
					url.searchParams.set('sort', sortVal);
					url.searchParams.set('page', '1');
					window.location.href = url.toString();
				}

				function changeViewMode(mode) {
					const url = new URL(window.location.href);
					url.searchParams.set('view', mode);
					window.location.href = url.toString();
				}

				function stepCatalogQty(btn, delta) {
					const form = btn.closest('form');
					if (!form) return;
					const input = form.querySelector('input[name="qty"]');
					if (input) {
						let val = parseInt(input.value, 10) || 1;
						val += delta;
						const min = parseInt(input.getAttribute('min') || '1', 10);
						const max = parseInt(input.getAttribute('max') || '9999', 10);
						if (val < min) val = min;
						if (val > max && max > 0) val = max;
						input.value = val;
					}
				}

				function navigateToVariant(variantId, productId) {
					const id = (variantId && variantId > 0) ? variantId : productId;
					if (id > 0) {
						window.location.href = `/catalog/${id}`;
					}
				}
			</script>
		}
	}
}

templ CustomerCatalogResults(data CatalogPageData, lang string) {
	if len(data.Variants) == 0 {
		<div class="glass-panel p-10 text-center border border-slate-200/80 rounded-2xl shadow-xs">
			<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
				@components.IconSearch("icon-md")
			</div>
			<h3 class="text-base font-extrabold text-primary mb-1.5">لا توجد عروض توريد مطابقة لمعايير البحث</h3>
			<p class="text-xs text-secondary mb-4 max-w-md mx-auto">
				لم نعثر على أصناف دوائية مطابقة للبحث أو الفلاتر المحددة. جرب استخدام كلمات بحث بديلة أو إزالة بعض الفلاتر.
			</p>
			<a href="/catalog" class="btn btn-secondary btn-sm font-bold shadow-xs">
				عرض كافة الأصناف المتاحة
			</a>
		</div>
	} else {
		<!-- Mode Renderer -->
		if data.ViewMode == "table" {
			@CustomerCatalogTable(data.Variants, lang)
		} else {
			@CustomerCatalogGrid(data.Variants, lang)
		}

		<!-- Smart Pagination Bar -->
		@CustomerCatalogPagination(data)
	}
}

templ CustomerCatalogGrid(variants []*SupplierVariantCard, lang string) {
	<div class="product-grid-wrapper mb-6">
		for _, v := range variants {
			<div
				class="product-card-glass cursor-pointer"
				onclick={ templ.ComponentScript{Call: fmt.Sprintf("navigateToVariant(%d, %d)", v.VariantID, v.ProductID)} }
			>
				<div>
					<!-- Top Visual Media Box -->
					<div class="product-card-media position-relative rounded-xl overflow-hidden bg-slate-50 border border-slate-100">
						if v.ProductImage != "" {
							<img src={ v.ProductImage } alt={ v.ProductNameAr } class="product-card-img w-full h-full object-contain p-2" loading="lazy" />
						} else {
							<div class="product-card-placeholder d-flex items-center justify-center w-full h-full text-slate-300">
								@components.IconPill("icon-lg")
							</div>
						}

						<!-- Floating Badges -->
						<div class="product-card-badges-floating position-absolute top-2 start-2 d-flex flex-col gap-1 z-10">
							if v.DiscountPercent > 0 {
								<span class="badge badge-emerald font-black text-xs shadow-xs">
									خصم { fmt.Sprintf("%d%%", v.DiscountPercent) }
								</span>
							}
							if v.DosageForm != "" {
								<span class="badge badge-sky font-bold text-xs shadow-xs">
									{ v.DosageForm }
								</span>
							}
						</div>

						<!-- Favorite Button -->
						<div onclick="event.stopPropagation();" class="position-absolute top-2 end-2 z-10">
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", v.ProductID)) } class="m-0">
								<button type="submit" class="btn btn-secondary btn-icon btn-xs shadow-xs" title="حفظ في المفضلة">
									@components.IconHeart("icon-xs")
								</button>
							</form>
						</div>
					</div>

					<!-- Product Title & Subtitle -->
					<div class="mt-3 mb-2">
						<h3 class="product-card-title text-sm font-black text-primary m-0 line-clamp-2 leading-snug">
							if v.ProductNameAr != "" {
								{ v.ProductNameAr }
							} else {
								{ v.ProductNameEn }
							}
						</h3>
						if v.ProductNameEn != "" && v.ProductNameEn != v.ProductNameAr {
							<div class="text-xs text-slate-400 font-semibold mt-0.5 text-truncate" dir="ltr">
								{ v.ProductNameEn }
							</div>
						}
					</div>

					<!-- Manufacturer & Active Ingredient -->
					if v.BrandName != "" || v.Manufacturer != "" {
						<div class="product-card-brand-chip d-flex items-center gap-1.5 text-xs text-secondary mb-1">
							@components.IconBuilding("icon-xs text-muted flex-shrink-0")
							<span class="text-secondary font-medium">الشركة:</span>
							<strong class="text-primary text-truncate">
								if v.BrandName != "" {
									{ v.BrandName }
								} else {
									{ v.Manufacturer }
								}
							</strong>
						</div>
					}

					if v.ScientificName != "" {
						<div class="text-xs text-secondary mb-2 text-truncate font-medium">
							<span class="text-muted">المادة: </span>
							<span class="font-bold text-primary">{ v.ScientificName }</span>
						</div>
					}

					<!-- Supplier Info Box -->
					<div class="product-card-supplier-row bg-slate-50/80 p-2 rounded-xl border border-slate-100 mb-2.5 flex-between">
						<div class="d-flex items-center gap-1.5 text-truncate">
							@components.IconTruck("icon-xs text-primary flex-shrink-0")
							<div class="text-truncate">
								<div class="text-xs font-extrabold text-primary text-truncate">
									{ v.SupplierName }
								</div>
								if v.CityName != "" || v.BranchName != "" {
									<div class="text-xs text-muted text-truncate">
										if v.CityName != "" {
											{ v.CityName }
										} else {
											{ v.BranchName }
										}
									</div>
								}
							</div>
						</div>
						<div class="d-flex items-center gap-1 flex-shrink-0">
							if v.DistanceText != "" {
								<span class="badge badge-sky text-xs font-mono" title="المسافة التقديرية عن فرعكم">
									{ v.DistanceText }
								</span>
							}
							if v.IsVerified {
								<span class="badge badge-emerald text-xs font-bold" title="مورد معتمد">
									معتمد
								</span>
							}
						</div>
					</div>

					<!-- Stock & Expiry -->
					<div class="product-card-stock-row flex-between text-xs mb-3 font-semibold">
						<div>
							if v.AvailableStock > 0 {
								<span class="badge badge-emerald gap-1">
									<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
									<span>متاح ({ fmt.Sprintf("%d", v.AvailableStock) } عبوة)</span>
								</span>
							} else {
								<span class="badge badge-rose gap-1">
									<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
									<span>غير متوفر</span>
								</span>
							}
						</div>
						if v.ExpiryDate != "" {
							<div class="tabular-nums text-muted text-xs">
								صلاحية: { v.ExpiryDate }
							</div>
						}
					</div>
				</div>

				<!-- Pricing & Action Footer -->
				<div class="product-card-pricing-footer border-t border-slate-100 pt-3 mt-auto">
					<div class="product-card-price-row flex-between items-baseline mb-2.5">
						<div>
							<span class="text-xs text-secondary font-bold d-block">سعر التوريد:</span>
							if v.OriginalPrice.IsPositive() && v.OriginalPrice.Minor() > v.Price.Minor() {
								<span class="text-xs text-muted line-through tabular-nums font-semibold">
									{ v.OriginalPrice.String() } ج.م
								</span>
							} else if v.PublicPrice.IsPositive() && v.PublicPrice.Minor() > v.Price.Minor() {
								<span class="text-xs text-muted line-through tabular-nums font-semibold" title="سعر الجمهور">
									{ v.PublicPrice.String() } ج.م
								</span>
							}
						</div>
						<div class="product-card-price-value text-base font-black text-brand tabular-nums">
							if v.Price.IsPositive() {
								{ v.Price.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
							} else {
								<span class="text-xs text-secondary font-bold">حسب الكمية</span>
							}
						</div>
					</div>

					if v.CanAddToCart {
						<div onclick="event.stopPropagation();">
							<form method="POST" action="/cart/add" class="product-card-actions-row d-flex items-center gap-1.5 m-0">
								<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.VariantID) } />
								<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
								<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
								<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
								<input type="hidden" name="offer_price" value={ v.Price.String() } />
								
								<div class="cart-stepper-control d-flex items-center border border-slate-200 rounded-lg bg-white overflow-hidden shadow-2xs">
									<button type="button" class="cart-stepper-btn px-2 py-1 bg-slate-50 hover:bg-slate-100 text-slate-700 font-extrabold border-0 cursor-pointer" onclick="stepCatalogQty(this, -1)">−</button>
									<input
										type="number"
										name="qty"
										value={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
										min={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
										max={ fmt.Sprintf("%d", max(1, v.AvailableStock)) }
										class="tabular-nums border-0 bg-transparent text-center font-extrabold text-xs px-1 w-9"
									/>
									<button type="button" class="cart-stepper-btn px-2 py-1 bg-slate-50 hover:bg-slate-100 text-slate-700 font-extrabold border-0 cursor-pointer" onclick="stepCatalogQty(this, 1)">+</button>
								</div>

								<button type="submit" class="btn btn-primary btn-sm flex-1 font-extrabold justify-center gap-1 shadow-xs">
									@components.IconPlus("icon-xs")
									<span>أضف للسلة</span>
								</button>
							</form>

							if v.IsNegotiable {
								<button
									type="button"
									class="btn btn-secondary btn-xs w-full mt-1.5 font-bold justify-center text-amber-700 hover:text-amber-800 gap-1.5 shadow-2xs"
									data-variant-id={ fmt.Sprintf("%d", v.VariantID) }
									data-product-id={ fmt.Sprintf("%d", v.ProductID) }
									data-vendor-id={ fmt.Sprintf("%d", v.SupplierID) }
									data-product-name={ v.ProductNameAr }
									data-current-price={ v.Price.String() }
									data-min-qty={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
									onclick="triggerNegotiationModal(this)"
								>
									@components.IconRefresh("icon-xs")
									<span>تفاوض على السعر</span>
								</button>
							}
						</div>
					} else {
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="btn btn-secondary btn-sm w-full font-bold justify-center gap-1.5 shadow-xs">
							<span>تفاصيل الصنف والموردين</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					}
				</div>
			</div>
		}
	</div>
}

templ CustomerCatalogTable(variants []*SupplierVariantCard, lang string) {
	<div class="glass-panel p-0 mb-6 overflow-hidden border border-slate-200/80 rounded-2xl shadow-xs">
		<div class="table-container m-0 overflow-x-auto">
			<table class="data-table m-0 text-xs w-full">
				<thead>
					<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
						<th class="w-12 text-center py-3"></th>
						<th class="py-3 text-start">الصنف الدوائي والمادة الفعالة</th>
						<th class="py-3 text-start">الشركة المصنعة</th>
						<th class="py-3 text-start">المورد والفرع</th>
						<th class="text-center py-3">المخزون والصلاحية</th>
						<th class="text-center tabular-nums py-3">سعر الجمهور</th>
						<th class="text-center py-3">نسبة الخصم</th>
						<th class="tabular-nums text-end py-3">السعر بعد الخصم</th>
						<th class="text-center w-52 py-3">الكمية والطلب</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					for _, v := range variants {
						<tr class="hover:bg-slate-50/50 transition-colors">
							<td class="text-center py-3">
								<div class="w-9 h-9 rounded-lg bg-slate-100 overflow-hidden d-flex items-center justify-center mx-auto border border-slate-200/50">
									if v.ProductImage != "" {
										<img src={ v.ProductImage } alt={ v.ProductNameAr } class="w-full h-full object-contain p-0.5" loading="lazy" />
									} else {
										<span class="text-slate-300">
											@components.IconPill("icon-xs")
										</span>
									}
								</div>
							</td>
							<td class="py-3">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="text-inherit no-underline block">
									<div class="font-extrabold text-primary text-xs hover:text-brand transition-colors">
										if v.ProductNameAr != "" {
											{ v.ProductNameAr }
										} else {
											{ v.ProductNameEn }
										}
									</div>
									if v.ScientificName != "" {
										<div class="text-xs text-muted mt-0.5 font-medium">
											{ v.ScientificName }
										</div>
									}
								</a>
							</td>
							<td class="py-3">
								<div class="font-bold text-primary">
									if v.BrandName != "" {
										{ v.BrandName }
									} else if v.Manufacturer != "" {
										{ v.Manufacturer }
									} else {
										<span class="text-muted">-</span>
									}
								</div>
								if v.DosageForm != "" {
									<span class="badge badge-slate text-xs mt-1 font-semibold">
										{ v.DosageForm }
									</span>
								}
							</td>
							<td class="py-3">
								<div class="font-bold text-primary d-flex items-center gap-1">
									<span>{ v.SupplierName }</span>
									if v.IsVerified {
										<span class="badge badge-emerald text-xs font-bold">معتمد</span>
									}
								</div>
								<div class="d-flex items-center gap-1 mt-1">
									if v.BranchName != "" {
										<span class="text-xs text-muted font-medium">
											{ v.BranchName }
										</span>
									}
									if v.DistanceText != "" {
										<span class="badge badge-sky text-xs font-mono">
											{ v.DistanceText }
										</span>
									}
								</div>
							</td>
							<td class="text-center py-3">
								if v.AvailableStock > 0 {
									<span class="badge badge-emerald font-extrabold text-xs tabular-nums">
										{ fmt.Sprintf("%d", v.AvailableStock) } عبوة
									</span>
								} else {
									<span class="badge badge-rose font-extrabold text-xs">
										نفد المخزون
									</span>
								}
								if v.ExpiryDate != "" {
									<div class="text-xs text-muted tabular-nums mt-0.5">
										{ v.ExpiryDate }
									</div>
								}
							</td>
							<!-- سعر الجمهور -->
							<td class="text-center tabular-nums font-bold text-primary py-3">
								if v.PublicPrice.IsPositive() {
									<div>
										{ v.PublicPrice.String() } <span class="text-xs text-secondary font-medium">ج.م</span>
									</div>
								} else if v.OriginalPrice.IsPositive() {
									<div>
										{ v.OriginalPrice.String() } <span class="text-xs text-secondary font-medium">ج.م</span>
									</div>
								} else {
									<div>
										{ v.Price.String() } <span class="text-xs text-secondary font-medium">ج.م</span>
									</div>
								}
							</td>
							<!-- نسبة الخصم -->
							<td class="text-center py-3">
								if v.DiscountPercent > 0 {
									<span class="badge badge-emerald tabular-nums font-black text-xs">
										{ fmt.Sprintf("%d%%", v.DiscountPercent) }
									</span>
								} else {
									<span class="text-muted text-xs font-medium">0%</span>
								}
							</td>
							<!-- السعر بعد الخصم -->
							<td class="tabular-nums text-end font-black text-brand text-sm py-3">
								{ v.Price.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
							</td>
							<td class="text-center py-3">
								if v.CanAddToCart {
									<form method="POST" action="/cart/add" class="d-flex items-center justify-center gap-1.5 m-0">
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.VariantID) } />
										<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
										<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
										<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
										<input type="hidden" name="offer_price" value={ v.Price.String() } />
										
										<div class="cart-stepper-control d-flex items-center border border-slate-200 rounded-lg bg-white overflow-hidden shadow-2xs">
											<button type="button" class="cart-stepper-btn px-1.5 py-0.5 bg-slate-50 hover:bg-slate-100 text-slate-700 font-extrabold border-0 cursor-pointer text-xs" onclick="stepCatalogQty(this, -1)">−</button>
											<input
												type="number"
												name="qty"
												value={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
												min={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
												max={ fmt.Sprintf("%d", max(1, v.AvailableStock)) }
												class="tabular-nums border-0 bg-transparent text-center font-extrabold text-xs w-8"
											/>
											<button type="button" class="cart-stepper-btn px-1.5 py-0.5 bg-slate-50 hover:bg-slate-100 text-slate-700 font-extrabold border-0 cursor-pointer text-xs" onclick="stepCatalogQty(this, 1)">+</button>
										</div>

										<button type="submit" class="btn btn-primary btn-sm font-bold shadow-2xs gap-1 text-xs py-1 px-2.5">
											@components.IconPlus("icon-2xs")
											<span>للسلة</span>
										</button>
									</form>
								} else {
									<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="btn btn-secondary btn-xs font-bold shadow-2xs">
										التفاصيل
									</a>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ CustomerCatalogPagination(data CatalogPageData) {
	<div class="glass-panel p-4 border border-slate-200/80 rounded-2xl shadow-xs flex-between flex-wrap gap-3">
		
		<!-- Results Summary -->
		<div class="text-xs text-secondary font-medium">
			if data.TotalItems > 0 {
				<span>عرض <strong class="tabular-nums text-primary font-bold">{ strconv.Itoa(data.StartItem) } - { strconv.Itoa(data.EndItem) }</strong> من إجمالي <strong class="tabular-nums text-primary font-black">{ strconv.Itoa(data.TotalItems) }</strong> صنف دوائي</span>
				<span class="ms-1.5 text-muted">(صفحة <span class="tabular-nums font-bold text-primary">{ strconv.Itoa(data.Page) }</span> من <span class="tabular-nums font-bold text-primary">{ strconv.Itoa(data.TotalPages) }</span>)</span>
			} else {
				<span>لا توجد أصناف للعرض</span>
			}
		</div>

		<!-- Page Number Navigation Buttons -->
		if data.TotalPages > 1 {
			<div class="d-flex items-center gap-1.5">
				<!-- Previous Button -->
				if data.HasPrev {
					<a
						href={ templ.SafeURL(buildCatalogURL(data, data.PrevPage, data.PageSize, data.Sort, data.ViewMode)) }
						class="btn btn-secondary btn-sm font-bold gap-1 text-xs shadow-2xs"
					>
						@components.IconArrowRight("icon-xs")
						<span>السابق</span>
					</a>
				} else {
					<button disabled class="btn btn-secondary btn-sm font-bold gap-1 text-xs opacity-40 cursor-not-allowed">
						@components.IconArrowRight("icon-xs")
						<span>السابق</span>
					</button>
				}

				<!-- Page Number Links -->
				<div class="d-flex items-center gap-1">
					if data.Page > 3 {
						<a href={ templ.SafeURL(buildCatalogURL(data, 1, data.PageSize, data.Sort, data.ViewMode)) } class="btn btn-secondary btn-xs tabular-nums font-bold w-8 h-8 p-0 justify-center">1</a>
						if data.Page > 4 {
							<span class="text-slate-400 px-1">…</span>
						}
					}

					for p := max(1, data.Page-2); p <= min(data.TotalPages, data.Page+2); p++ {
						if p == data.Page {
							<span class="btn btn-primary btn-xs tabular-nums font-black w-8 h-8 p-0 justify-center shadow-xs">{ strconv.Itoa(p) }</span>
						} else {
							<a href={ templ.SafeURL(buildCatalogURL(data, p, data.PageSize, data.Sort, data.ViewMode)) } class="btn btn-secondary btn-xs tabular-nums font-bold w-8 h-8 p-0 justify-center">{ strconv.Itoa(p) }</a>
						}
					}

					if data.Page < data.TotalPages-2 {
						if data.Page < data.TotalPages-3 {
							<span class="text-slate-400 px-1">…</span>
						}
						<a href={ templ.SafeURL(buildCatalogURL(data, data.TotalPages, data.PageSize, data.Sort, data.ViewMode)) } class="btn btn-secondary btn-xs tabular-nums font-bold w-8 h-8 p-0 justify-center">{ strconv.Itoa(data.TotalPages) }</a>
					}
				</div>

				<!-- Next Button -->
				if data.HasNext {
					<a
						href={ templ.SafeURL(buildCatalogURL(data, data.NextPage, data.PageSize, data.Sort, data.ViewMode)) }
						class="btn btn-secondary btn-sm font-bold gap-1 text-xs shadow-2xs"
					>
						<span>التالي</span>
						@components.IconArrowLeft("icon-xs")
					</a>
				} else {
					<button disabled class="btn btn-secondary btn-sm font-bold gap-1 text-xs opacity-40 cursor-not-allowed">
						<span>التالي</span>
						@components.IconArrowLeft("icon-xs")
					</button>
				}
			</div>
		}

	</div>
}

func resolveTargetID(variantID, productID int64) int64 {
	if variantID > 0 {
		return variantID
	}
	return productID
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func max(a, b int) int {
	if a > b {
		return a
	}
	return b
}

templ CustomerNegotiationModal() {
	<!-- Price Negotiation Modal Dialog -->
	<div id="negotiation-modal" class="modal-overlay hidden">
		<div class="card max-w-lg w-full bg-surface-raised border border-slate-200 rounded-2xl p-6 shadow-2xl">
			<div class="flex-between border-b border-slate-100 pb-3.5 mb-4">
				<div class="d-flex items-center gap-2.5">
					<div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 d-flex items-center justify-center border border-amber-200/60 shadow-2xs">
						@components.IconRefresh("icon-sm")
					</div>
					<div>
						<h3 class="text-base font-black text-primary m-0">طلب تفاوض على سعر الصنف</h3>
						<span class="text-xs text-secondary font-medium">إرسال عرض سعر خاص ومباشر للمورّد</span>
					</div>
				</div>
				<button type="button" class="btn btn-ghost btn-sm text-slate-400 hover:text-slate-600" onclick="closeNegotiationModal()">✕</button>
			</div>

			<form method="POST" action="/customer/negotiate-order" id="negotiation-form" class="d-flex flex-col gap-4 m-0">
				<input type="hidden" name="variant_id" id="neg-variant-id" />
				<input type="hidden" name="vendor_org_id" id="neg-vendor-id" />

				<div class="bg-surface-sunken p-3.5 rounded-xl border border-slate-200/80">
					<div class="text-xs text-muted font-bold">الصنف الدوائي المختار:</div>
					<div class="text-sm font-black text-primary mt-0.5" id="neg-product-name">-</div>
					<div class="text-xs text-secondary mt-1 font-semibold">سعر التوريد الحالي المعلن: <strong id="neg-current-price" class="tabular-nums text-primary font-black">-</strong> ج.م</div>
				</div>

				<div class="grid-2">
					<div>
						<label class="form-label font-bold text-primary text-xs mb-1.5 d-block">
							السعر المقترح للعبوة (ج.م) *
						</label>
						<input
							type="number"
							step="0.01"
							min="0.01"
							name="proposed_price"
							id="neg-proposed-price"
							required
							placeholder="0.00"
							class="form-input tabular-nums font-black text-sm"
						/>
					</div>

					<div>
						<label class="form-label font-bold text-primary text-xs mb-1.5 d-block">
							الكمية المطلوبة (عبوة) *
						</label>
						<input
							type="number"
							min="1"
							name="qty"
							id="neg-qty"
							value="1"
							required
							class="form-input tabular-nums font-black text-sm"
						/>
					</div>
				</div>

				<div>
					<label class="form-label font-bold text-primary text-xs mb-1.5 d-block">
						ملاحظات إضافية للمورّد (اختياري)
					</label>
					<textarea
						name="notes"
						rows="2"
						placeholder="اكتب أي شروط أو تفاصيل إضافية بخصوص جدول الاستلام أو التوريد..."
						class="form-input text-xs"
					></textarea>
				</div>

				<div class="modal-footer-standard d-flex justify-end gap-2 pt-2 border-t border-slate-100">
					<button type="button" class="btn btn-secondary font-bold text-xs" onclick="closeNegotiationModal()">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary font-black text-xs px-4 shadow-sm">
						إرسال طلب التفاوض للمورّد
					</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		function triggerNegotiationModal(btn) {
			openNegotiationModal({
				variant_id: btn.getAttribute('data-variant-id'),
				product_id: btn.getAttribute('data-product-id'),
				vendor_org_id: btn.getAttribute('data-vendor-id'),
				name: btn.getAttribute('data-product-name'),
				current_price: btn.getAttribute('data-current-price'),
				min_qty: parseInt(btn.getAttribute('data-min-qty') || '1', 10)
			});
		}
		function openNegotiationModal(data) {
			document.getElementById('neg-variant-id').value = data.variant_id || '';
			document.getElementById('neg-vendor-id').value = data.vendor_org_id || '';
			document.getElementById('neg-product-name').innerText = data.name || 'صنف دوائي';
			document.getElementById('neg-current-price').innerText = data.current_price || '0.00';
			document.getElementById('neg-qty').value = data.min_qty || 1;
			document.getElementById('neg-proposed-price').value = data.current_price || '';
			const m = document.getElementById('negotiation-modal');
			if (m) {
				m.style.display = 'flex';
				m.classList.remove('hidden');
			}
		}
		function closeNegotiationModal() {
			const m = document.getElementById('negotiation-modal');
			if (m) {
				m.style.display = 'none';
				m.classList.add('hidden');
			}
		}
	</script>
}

