package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CatalogPageData struct {
	Products    []*catalog.Product
	Categories  []*catalog.Category
	Query       string
	CategoryID  *int64
	MinPrice    string
	MaxPrice    string
	DosageForm  string
	Sort        string
	InStock     bool
}

templ CustomerCatalog(data CatalogPageData, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCatalogList(data.Products, lang)
	} else {
		@layouts.CustomerShell("كتالوج الأدوية والمستلزمات | Catalog", lang, dir) {
			<div class="catalog-page-container" style="display:grid; grid-template-columns:280px 1fr; gap:var(--space-6); margin-top:var(--space-4); align-items:start;">
				
				<!-- Right Filter Sidebar -->
				<aside class="catalog-filters" style="background:var(--surface-raised); padding:var(--space-6); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; flex-direction:column; gap:var(--space-6);">
					<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:var(--space-3);">
						<div style="display:flex; align-items:center; gap:var(--space-2);">
							@components.IconPill("icon-sm")
							<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin:0;">
								الفلاتر والتصنيف
							</h3>
						</div>
						<a href="/catalog" style="font-size:var(--text-xs); font-weight:600; color:var(--accent); text-decoration:none;">
							إعادة ضبط
						</a>
					</div>

					<form action="/catalog" method="GET" style="display:flex; flex-direction:column; gap:var(--space-5);">
						if data.Query != "" {
							<input type="hidden" name="q" value={ data.Query } />
						}

						<!-- 1. Categories Section -->
						<div>
							<h4 style="font-size:var(--text-sm); font-weight:600; color:var(--text); margin-bottom:var(--space-2);">
								الأقسام الدوائية
							</h4>
							<div style="display:flex; flex-direction:column; gap:2px; max-height:260px; overflow-y:auto; padding-inline-end:4px;">
								<a
									href="/catalog"
									class={ "filter-category-link", templ.KV("active", data.CategoryID == nil) }
									style="display:flex; justify-content:space-between; align-items:center;"
								>
									<span>جميع الأدوية والمستلزمات</span>
									<span class="badge badge-slate" style="font-size:10px;">الكل</span>
								</a>

								for _, cat := range data.Categories {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/catalog?category_id=%d", cat.ID)) }
										class={ "filter-category-link", templ.KV("active", data.CategoryID != nil && *data.CategoryID == cat.ID) }
										style="display:flex; justify-content:space-between; align-items:center;"
									>
										<span>
											if cat.Name["ar"] != "" {
												{ cat.Name["ar"] }
											} else {
												{ cat.Name["en"] }
											}
										</span>
									</a>
								}
							</div>
						</div>

						<!-- 2. Price Range -->
						<div style="border-top:1px solid var(--border); padding-top:var(--space-4);">
							<h4 style="font-size:var(--text-sm); font-weight:600; color:var(--text); margin-bottom:var(--space-2);">
								نطاق السعر (ج.م)
							</h4>
							<div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-2); margin-bottom:var(--space-2);">
								<div>
									<label class="form-label" style="font-size:var(--text-xs); margin-bottom:2px;">من</label>
									<input type="number" name="min_price" value={ data.MinPrice } placeholder="0" class="form-input tabular-nums" style="padding:0.4rem 0.6rem; font-size:var(--text-sm);" />
								</div>
								<div>
									<label class="form-label" style="font-size:var(--text-xs); margin-bottom:2px;">إلى</label>
									<input type="number" name="max_price" value={ data.MaxPrice } placeholder="1000" class="form-input tabular-nums" style="padding:0.4rem 0.6rem; font-size:var(--text-sm);" />
								</div>
							</div>
						</div>

						<!-- 3. Dosage Forms -->
						<div style="border-top:1px solid var(--border); padding-top:var(--space-4);">
							<h4 style="font-size:var(--text-sm); font-weight:600; color:var(--text); margin-bottom:var(--space-2);">
								الشكل الصيدلي
							</h4>
							<div style="display:flex; flex-wrap:wrap; gap:var(--space-1);">
								<button
									type="submit"
									name="dosage_form"
									value="tablet"
									class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "tablet"), templ.KV("btn-secondary", data.DosageForm != "tablet") }
								>
									أقراص
								</button>
								<button
									type="submit"
									name="dosage_form"
									value="capsule"
									class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "capsule"), templ.KV("btn-secondary", data.DosageForm != "capsule") }
								>
									كبسولات
								</button>
								<button
									type="submit"
									name="dosage_form"
									value="syrup"
									class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "syrup"), templ.KV("btn-secondary", data.DosageForm != "syrup") }
								>
									شراب
								</button>
								<button
									type="submit"
									name="dosage_form"
									value="injection"
									class={ "btn btn-sm", templ.KV("btn-primary", data.DosageForm == "injection"), templ.KV("btn-secondary", data.DosageForm != "injection") }
								>
									أمبولات وحقن
								</button>
							</div>
						</div>

						<!-- 4. Availability -->
						<div style="border-top:1px solid var(--border); padding-top:var(--space-4);">
							<label style="display:flex; align-items:center; gap:var(--space-2); font-size:var(--text-sm); font-weight:500; color:var(--text); cursor:pointer;">
								<input type="checkbox" name="in_stock" value="true" checked?={ data.InStock } style="accent-color:var(--accent); width:16px; height:16px;" />
								<span>المتوفر بالمخازن فقط</span>
							</label>
						</div>

						<button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:0.6rem; font-weight:600; font-size:var(--text-sm);">
							@components.IconSearch("icon-xs")
							<span>تطبيق الفلاتر</span>
						</button>
					</form>
				</aside>

				<!-- Main Catalog Content -->
				<main class="catalog-content">
					<!-- Top Search and Sorting Controls -->
					<div class="catalog-search-bar" style="margin-bottom:var(--space-6); background:var(--surface-raised); padding:var(--space-4); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:var(--space-4); flex-wrap:wrap;">
						
						<!-- Live Search Input -->
						<div style="position:relative; flex:1; min-width:260px;">
							<div style="position:absolute; inset-inline-start:12px; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
								@components.IconSearch("icon-xs")
							</div>
							<input
								type="search"
								name="q"
								value={ data.Query }
								placeholder="ابحث بالاسم التجاري، المادة الفعالة، أو الباركود..."
								class="form-input"
								style="font-size:var(--text-sm); padding:0.55rem 1rem 0.55rem 2.2rem; border-radius:var(--radius-md);"
								hx-get="/catalog"
								hx-trigger="keyup changed delay:300ms, search"
								hx-target="#catalog-results"
								hx-push-url="true"
							/>
						</div>

						<!-- Sort Dropdown -->
						<div style="display:flex; align-items:center; gap:var(--space-2);">
							<label style="font-size:var(--text-sm); font-weight:600; color:var(--text-secondary); white-space:nowrap;">ترتيب حسب:</label>
							<select
								name="sort"
								class="form-select"
								style="font-size:var(--text-sm); padding:0.45rem 0.85rem; width:auto; border-radius:var(--radius-md);"
								onchange="window.location = '/catalog?q=' + encodeURIComponent(document.querySelector('input[name=q]').value) + '&sort=' + this.value"
							>
								<option value="" selected?={ data.Sort == "" }>الأكثر طلباً ومبيعاً</option>
								<option value="price_asc" selected?={ data.Sort == "price_asc" }>السعر: من الأقل للأعلى</option>
								<option value="price_desc" selected?={ data.Sort == "price_desc" }>السعر: من الأعلى للأقل</option>
								<option value="newest" selected?={ data.Sort == "newest" }>الأحدث إضافة</option>
								<option value="name" selected?={ data.Sort == "name" }>الاسم أبجدياً</option>
							</select>
						</div>
					</div>

					<!-- Product Results Grid -->
					<div id="catalog-results">
						@CustomerCatalogList(data.Products, lang)
					</div>
				</main>
			</div>
		}
	}
}

templ CustomerCatalogList(products []*catalog.Product, lang string) {
	if len(products) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد أصناف مطابقة للبحث",
			Message:     "لم نعثر على أي أدوية تطابق خيارات الفلترة المحددة. جرب البحث بكلمات أخرى أو إعادة ضبط الفلاتر.",
			ActionLabel: "عرض جميع الأدوية",
		})
	} else {
		<div class="product-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(270px, 1fr)); gap:var(--space-5);">
			for _, p := range products {
				<div class="card" style="display:flex; flex-direction:column; justify-content:space-between; padding:var(--space-5); margin-bottom:0; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg);">
					<div>
						<!-- Top Badges & Favorite -->
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-3);">
							<div style="display:flex; align-items:center; gap:var(--space-2); flex-wrap:wrap;">
								<span class="badge badge-sky">
									@components.IconPill("icon-xs")
									<span>
										if p.DosageForm != "" {
											{ p.DosageForm }
										} else {
											أقراص
										}
									</span>
								</span>
								<span class="badge badge-emerald">متوفر</span>
							</div>

							<!-- Favorite Heart Button -->
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", p.ID)) } style="margin:0;">
								<button type="submit" class="btn btn-secondary btn-icon" style="width:32px; height:32px; color:var(--accent);" title="حفظ في المفضلة">
									@components.IconHeart("icon-xs")
								</button>
							</form>
						</div>

						<!-- Product Titles -->
						<h4 style="font-size:var(--text-base); font-weight:700; margin-bottom:2px; color:var(--text); line-height:1.35;">
							<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } style="color:inherit; text-decoration:none;">
								if p.Name["ar"] != "" {
									{ p.Name["ar"] }
								} else {
									{ p.Name["en"] }
								}
							</a>
						</h4>
						<p style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--space-3); font-weight:500;">
							{ p.Name["en"] }
						</p>

						<!-- Active Ingredient / Manufacturer -->
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:var(--space-3); margin-bottom:var(--space-3); font-size:var(--text-xs); display:flex; flex-direction:column; gap:2px;">
							if p.ScientificName != "" {
								<div style="color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
									<span style="color:var(--text-muted);">المادة الفعالة:</span> <strong>{ p.ScientificName }</strong>
								</div>
							}
							if p.ManufacturingCompanies != "" {
								<div style="color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
									<span style="color:var(--text-muted);">الشركة:</span> { p.ManufacturingCompanies }
								</div>
							}
						</div>

						<!-- Star Ratings -->
						<div style="margin-bottom:var(--space-3);">
							@components.RatingStars(4.8, 128)
						</div>
					</div>

					<!-- Bottom Pricing & Multi-Supplier Action (Laravel Parity Structure) -->
					<div style="border-top:1px solid var(--border); padding-top:var(--space-3); margin-top:var(--space-3); display:flex; flex-direction:column; gap:var(--space-3);">
						<!-- Pricing Display -->
						<div>
							if p.HasDiscount() {
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
									<span style="font-size:var(--text-xs); color:var(--text-muted); text-decoration:line-through;" class="tabular-nums">
										سعر الجمهور: { p.PublicPrice().String() } ج.م
									</span>
									<span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:700; font-size:11px; padding:1px 6px; border-radius:var(--radius-sm);">
										خصم { fmt.Sprintf("%d%%", p.DiscountPercent()) }
									</span>
								</div>
							}
							<div style="display:flex; justify-content:space-between; align-items:flex-end;">
								<div>
									<div style="font-size:var(--text-xs); color:var(--text-secondary); font-weight:600;">سعر الصيدلية (التوريد):</div>
									<div style="font-size:var(--text-xl); font-weight:800; color:var(--accent);" class="tabular-nums">
										if p.NetPrice().IsPositive() {
											{ p.NetPrice().String() } ج.م
										} else {
											38.50 ج.م
										}
									</div>
								</div>

								<!-- Supplier Count Pill -->
								<div class="badge badge-sky" style="font-weight:600; font-size:11px;">
									@components.IconBuilding("icon-xs")
									<span>3 موردين</span>
								</div>
							</div>
						</div>

						<!-- CTA Button -->
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-primary" style="width:100%; font-size:var(--text-sm); font-weight:600; justify-content:center; padding:0.55rem;">
							@components.IconCart("icon-xs")
							<span>عرض عروض الموردين والطلب</span>
						</a>
					</div>
				</div>
			}

		</div>
	}
}
