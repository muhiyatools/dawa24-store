package pages

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func buildCatalogURL(data CatalogPageData, page int, pageSize int, sort, view string) string {
	u, _ := url.Parse("/catalog")
	q := u.Query()

	if data.Query != "" {
		q.Set("q", data.Query)
	}
	if data.CategoryID != nil {
		q.Set("category_id", strconv.FormatInt(*data.CategoryID, 10))
	}
	if data.BrandID != nil {
		q.Set("brand_id", strconv.FormatInt(*data.BrandID, 10))
	}
	if data.MinPrice != "" {
		q.Set("min_price", data.MinPrice)
	}
	if data.MaxPrice != "" {
		q.Set("max_price", data.MaxPrice)
	}
	if data.DosageForm != "" {
		q.Set("dosage_form", data.DosageForm)
	}
	if data.InStock {
		q.Set("in_stock", "true")
	}
	if data.HasDiscount {
		q.Set("has_discount", "true")
	}

	if sort != "" {
		q.Set("sort", sort)
	} else if data.Sort != "" {
		q.Set("sort", data.Sort)
	}

	if view != "" {
		q.Set("view", view)
	} else if data.ViewMode != "" {
		q.Set("view", data.ViewMode)
	}

	if pageSize > 0 {
		q.Set("page_size", strconv.Itoa(pageSize))
	} else if data.PageSize > 0 {
		q.Set("page_size", strconv.Itoa(data.PageSize))
	}

	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}

	u.RawQuery = q.Encode()
	return u.String()
}

templ CustomerCatalog(data CatalogPageData, lang, dir string, isPartial bool) {
	if isPartial {
		@CustomerCatalogResults(data, lang)
	} else {
		@layouts.PublicShell("كتالوج توريد الأدوية والمستلزمات | دواء 24", lang, dir) {
			<div class="container" style="max-width:1380px; margin:1.25rem auto 4rem auto; padding:0 1rem;">
				
				<!-- Page Header Strip -->
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem; background:var(--surface-raised); padding:1.25rem 1.5rem; border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xs);">
					<div>
						<nav style="display:flex; align-items:center; gap:0.4rem; font-size:0.8rem; color:var(--text-secondary); margin-bottom:0.25rem;">
							<a href="/" style="color:var(--text-secondary); text-decoration:none;">الرئيسية</a>
							<span>/</span>
							<span style="color:var(--text); font-weight:700;">كتالوج التوريد الدوائي</span>
						</nav>
						<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
							كتالوج عروض توريد الأدوية والمستلزمات الطبية
						</h1>
						<p style="font-size:0.825rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
							استعراض ومقارنة أسعار التوريد اللحظية من كبرى شركات التوزيع والمستودعات المعتمدة
						</p>
					</div>

					<div style="display:flex; align-items:center; gap:0.65rem; flex-wrap:wrap;">
						<a href="/customer/purchase-request" class="btn btn-secondary btn-sm" style="font-weight:700; gap:0.4rem;">
							<span>⚡ طلب شراء ذكي</span>
						</a>
						<a href="/cart" class="btn btn-primary btn-sm" style="font-weight:800; gap:0.4rem; padding:0.5rem 1.1rem;">
							@components.IconCart("icon-xs")
							<span>سلة المشتريات</span>
						</a>
					</div>
				</div>

				<!-- Quick Dosage Form Pills Strip -->
				<div style="margin-bottom:1.25rem; overflow-x:auto; padding-bottom:0.35rem; display:flex; gap:0.5rem; scrollbar-width:none;" class="dosage-pills-strip">
					<a
						href={ templ.SafeURL(buildCatalogURL(data, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm", templ.KV("btn-primary fw-800", data.DosageForm == ""), templ.KV("btn-secondary", data.DosageForm != "") }
						style="white-space:nowrap; border-radius:var(--radius-full); font-size:0.8rem; padding:0.35rem 0.9rem;"
					>
						✨ كافة الأشكال الدوائية
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "أقراص", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm", templ.KV("btn-primary fw-800", data.DosageForm == "أقراص" || data.DosageForm == "tablet"), templ.KV("btn-secondary", data.DosageForm != "أقراص" && data.DosageForm != "tablet") }
						style="white-space:nowrap; border-radius:var(--radius-full); font-size:0.8rem; padding:0.35rem 0.9rem;"
					>
						💊 أقراص
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "كبسولات", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm", templ.KV("btn-primary fw-800", data.DosageForm == "كبسولات" || data.DosageForm == "capsule"), templ.KV("btn-secondary", data.DosageForm != "كبسولات" && data.DosageForm != "capsule") }
						style="white-space:nowrap; border-radius:var(--radius-full); font-size:0.8rem; padding:0.35rem 0.9rem;"
					>
						💊 كبسولات
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "شراب", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm", templ.KV("btn-primary fw-800", data.DosageForm == "شراب" || data.DosageForm == "syrup"), templ.KV("btn-secondary", data.DosageForm != "شراب" && data.DosageForm != "syrup") }
						style="white-space:nowrap; border-radius:var(--radius-full); font-size:0.8rem; padding:0.35rem 0.9rem;"
					>
						🧪 شراب وسوائل
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "حقن", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm", templ.KV("btn-primary fw-800", data.DosageForm == "حقن" || data.DosageForm == "ampoule"), templ.KV("btn-secondary", data.DosageForm != "حقن" && data.DosageForm != "ampoule") }
						style="white-space:nowrap; border-radius:var(--radius-full); font-size:0.8rem; padding:0.35rem 0.9rem;"
					>
						💉 حقن وأمبولات
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "مرهم", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm", templ.KV("btn-primary fw-800", data.DosageForm == "مرهم" || data.DosageForm == "cream" || data.DosageForm == "ointment"), templ.KV("btn-secondary", data.DosageForm != "مرهم" && data.DosageForm != "cream" && data.DosageForm != "ointment") }
						style="white-space:nowrap; border-radius:var(--radius-full); font-size:0.8rem; padding:0.35rem 0.9rem;"
					>
						🧴 مراهم وكريمات
					</a>
					<a
						href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: "فوار", InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
						class={ "btn btn-sm", templ.KV("btn-primary fw-800", data.DosageForm == "فوار" || data.DosageForm == "sachet"), templ.KV("btn-secondary", data.DosageForm != "فوار" && data.DosageForm != "sachet") }
						style="white-space:nowrap; border-radius:var(--radius-full); font-size:0.8rem; padding:0.35rem 0.9rem;"
					>
						✨ فوار وأكياس
					</a>
				</div>

				<!-- Main 2-Column Grid -->
				<div class="catalog-page-container" style="display:grid; grid-template-columns:270px minmax(0, 1fr); gap:1.5rem; align-items:start;">
					
					<!-- Filter Sidebar (Right in RTL) -->
					<aside class="catalog-filters" style="background:var(--surface-raised); padding:1.35rem; border-radius:var(--radius-2xl); border:1px solid var(--border); position:sticky; top:85px; box-shadow:var(--shadow-xs);">
						<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:0.75rem; margin-bottom:1.15rem;">
							<div style="display:flex; align-items:center; gap:0.45rem;">
								<span style="font-size:1.1rem;">⚙️</span>
								<h2 style="font-size:0.95rem; font-weight:800; color:var(--text); margin:0;">
									الفلاتر والبحث المتقدم
								</h2>
							</div>
							<a href="/catalog" style="font-size:0.8rem; font-weight:700; color:var(--rose); text-decoration:none;" title="تصفير الفلاتر">
								تصفير
							</a>
						</div>

						<form action="/catalog" method="GET" class="stack-md" id="catalog-filter-form">
							<!-- Anti-Scraping Honeypot Trap (Hidden from users) -->
							<input type="text" name="company_tax_ref" style="display:none !important; position:absolute; left:-9999px; opacity:0; pointer-events:none;" tabindex="-1" autocomplete="off" />

							if data.Query != "" {
								<input type="hidden" name="q" value={ data.Query } />
							}
							if data.Sort != "" {
								<input type="hidden" name="sort" value={ data.Sort } />
							}
							if data.ViewMode != "" {
								<input type="hidden" name="view" value={ data.ViewMode } />
							}
							if data.PageSize > 0 {
								<input type="hidden" name="page_size" value={ strconv.Itoa(data.PageSize) } />
							}

							<!-- Categories Tree -->
							<div>
								<label class="form-label" style="font-size:0.825rem; font-weight:700; margin-bottom:0.45rem; display:block; color:var(--text);">
									التصنيف الدوائي
								</label>
								<div style="display:flex; flex-direction:column; gap:3px; max-height:180px; overflow-y:auto; padding-inline-end:0.25rem;">
									<a
										href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
										class={ "filter-category-link", templ.KV("active fw-800", data.CategoryID == nil) }
										style="display:flex; justify-content:space-between; align-items:center; padding:0.4rem 0.6rem; font-size:0.825rem; border-radius:var(--radius-md); text-decoration:none; color:var(--text);"
									>
										<span>جميع التصنيفات</span>
										<span class="badge badge-slate" style="font-size:10px;">الكل</span>
									</a>

									for _, cat := range data.Categories {
										<a
											href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: &cat.ID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) }
											class={ "filter-category-link", templ.KV("active fw-800", data.CategoryID != nil && *data.CategoryID == cat.ID) }
											style="display:flex; justify-content:space-between; align-items:center; padding:0.4rem 0.6rem; font-size:0.825rem; border-radius:var(--radius-md); text-decoration:none; color:var(--text);"
										>
											<span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
												if cat.Name["ar"] != "" {
													{ cat.Name["ar"] }
												} else {
													{ cat.Name["en"] }
												}
											</span>
										</a>
									}
								</div>
							</div>

							<!-- Manufacturers / Brands -->
							if len(data.Brands) > 0 {
								<div style="border-top:1px solid var(--border); padding-top:0.9rem;">
									<label class="form-label" style="font-size:0.825rem; font-weight:700; margin-bottom:0.45rem; display:block; color:var(--text);">
										الشركة المصنعة / الماركة
									</label>
									<select
										name="brand_id"
										class="form-input"
										style="font-size:0.825rem; height:38px; border-radius:var(--radius-lg);"
										onchange="document.getElementById('catalog-filter-form').submit()"
									>
										<option value="">كافة الشركات والمصانع</option>
										for _, b := range data.Brands {
											<option
												value={ strconv.FormatInt(b.ID, 10) }
												selected?={ data.BrandID != nil && *data.BrandID == b.ID }
											>
												if b.Name.Get(i18n.AR) != "" {
													{ b.Name.Get(i18n.AR) }
												} else {
													{ b.Name.Get(i18n.EN) }
												}
											</option>
										}
									</select>
								</div>
							}

							<!-- Price Range -->
							<div style="border-top:1px solid var(--border); padding-top:0.9rem;">
								<label class="form-label" style="font-size:0.825rem; font-weight:700; margin-bottom:0.45rem; display:block; color:var(--text);">
									سعر التوريد للصيدلية (ج.م)
								</label>
								<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
									<div>
										<input type="number" name="min_price" value={ data.MinPrice } placeholder="من 0" class="form-input tabular-nums" style="height:36px; padding:0.35rem 0.5rem; font-size:0.825rem; border-radius:var(--radius-md);" />
									</div>
									<div>
										<input type="number" name="max_price" value={ data.MaxPrice } placeholder="إلى 1000" class="form-input tabular-nums" style="height:36px; padding:0.35rem 0.5rem; font-size:0.825rem; border-radius:var(--radius-md);" />
									</div>
								</div>
							</div>

							<!-- Availability & Discount Checkboxes -->
							<div style="border-top:1px solid var(--border); padding-top:0.9rem; display:flex; flex-direction:column; gap:0.65rem;">
								<label style="display:flex; align-items:center; gap:0.5rem; font-size:0.825rem; font-weight:600; color:var(--text); cursor:pointer;">
									<input type="checkbox" name="in_stock" value="true" checked?={ data.InStock } style="accent-color:var(--accent); width:16px; height:16px;" onchange="document.getElementById('catalog-filter-form').submit()" />
									<span>الأصناف المتوفرة بالمخزون فقط</span>
								</label>
								<label style="display:flex; align-items:center; gap:0.5rem; font-size:0.825rem; font-weight:600; color:var(--text); cursor:pointer;">
									<input type="checkbox" name="has_discount" value="true" checked?={ data.HasDiscount } style="accent-color:var(--accent); width:16px; height:16px;" onchange="document.getElementById('catalog-filter-form').submit()" />
									<span>عروض الخصومات الإضافية %</span>
								</label>
							</div>

							<button type="submit" class="btn btn-primary btn-sm" style="width:100%; justify-content:center; padding:0.6rem; font-weight:800; border-radius:var(--radius-lg); margin-top:0.25rem;">
								@components.IconSearch("icon-xs")
								<span>تطبيق الفلاتر</span>
							</button>
						</form>
					</aside>

					<!-- Main Results Area -->
					<main class="catalog-main-content">
						
						<!-- Search Toolbar, Sorting, Rows per Page, View Switcher -->
						<div style="background:var(--surface-raised); padding:0.9rem 1.25rem; border-radius:var(--radius-2xl); border:1px solid var(--border); margin-bottom:1.15rem; box-shadow:var(--shadow-xs);">
							<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
								
								<!-- Live Search Input -->
								<div style="position:relative; flex:1; min-width:260px;">
									<div style="position:absolute; inset-inline-start:12px; top:50%; transform:translateY(-50%); color:var(--text-secondary); pointer-events:none;">
										@components.IconSearch("icon-xs")
									</div>
									<input
										type="search"
										name="q"
										value={ data.Query }
										placeholder="ابحث بالاسم التجاري، المادة الفعالة، اسم الشركة، أو الباركود..."
										class="form-input"
										style="font-size:0.875rem; height:42px; padding-inline-start:2.35rem; border-radius:var(--radius-xl); border:1px solid var(--border);"
										hx-get="/catalog"
										hx-trigger="keyup changed delay:350ms, search"
										hx-target="#catalog-results"
										hx-push-url="true"
										autocomplete="off"
									/>
								</div>

								<!-- Controls: Rows per page, Sort, View Toggle -->
								<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
									
									<!-- Rows Per Page Selector -->
									<div class="row-center-sm" style="font-size:0.8rem;">
										<label style="font-weight:700; color:var(--text-secondary); white-space:nowrap;">عرض:</label>
										<select
											name="page_size"
											class="form-input"
											style="font-size:0.8rem; height:38px; width:auto; border-radius:var(--radius-lg); font-weight:700; padding:0.25rem 0.5rem;"
											onchange={ templ.ComponentScript{Call: "changePageSize(this.value)"} }
										>
											<option value="12" selected?={ data.PageSize == 12 }>12</option>
											<option value="24" selected?={ data.PageSize == 24 || data.PageSize == 0 }>24</option>
											<option value="48" selected?={ data.PageSize == 48 }>48</option>
											<option value="96" selected?={ data.PageSize == 96 }>96</option>
										</select>
									</div>

									<!-- Sort Selector -->
									<div class="row-center-sm" style="font-size:0.8rem;">
										<label style="font-weight:700; color:var(--text-secondary); white-space:nowrap;">الترتيب:</label>
										<select
											name="sort"
											class="form-input"
											style="font-size:0.8rem; height:38px; width:auto; border-radius:var(--radius-lg); font-weight:700; padding:0.25rem 0.6rem;"
											onchange={ templ.ComponentScript{Call: "changeSort(this.value)"} }
										>
											<option value="" selected?={ data.Sort == "" }>الأفضل تقييماً والأحدث</option>
											<option value="price_asc" selected?={ data.Sort == "price_asc" }>سعر التوريد: الأقل أولاً</option>
											<option value="price_desc" selected?={ data.Sort == "price_desc" }>سعر التوريد: الأعلى أولاً</option>
											<option value="discount_desc" selected?={ data.Sort == "discount_desc" }>أعلى نسبة خصم %</option>
											<option value="newest" selected?={ data.Sort == "newest" }>الأحدث إضافة</option>
											<option value="name" selected?={ data.Sort == "name" }>الاسم أبجدياً</option>
										</select>
									</div>

									<!-- View Mode Toggle: Grid vs Table -->
									<div style="display:flex; background:var(--surface-sunken); padding:2px; border-radius:var(--radius-lg); border:1px solid var(--border);">
										<button
											type="button"
											onclick={ templ.ComponentScript{Call: "changeViewMode('grid')"} }
											class={ "btn btn-icon btn-xs", templ.KV("btn-primary", data.ViewMode == "grid" || data.ViewMode == ""), templ.KV("btn-ghost", data.ViewMode == "table") }
											style="width:32px; height:32px; border-radius:var(--radius-md);"
											title="عرض البطاقات (Grid)"
										>
											⊞
										</button>
										<button
											type="button"
											onclick={ templ.ComponentScript{Call: "changeViewMode('table')"} }
											class={ "btn btn-icon btn-xs", templ.KV("btn-primary", data.ViewMode == "table"), templ.KV("btn-ghost", data.ViewMode != "table") }
											style="width:32px; height:32px; border-radius:var(--radius-md);"
											title="عرض جدول التوريد B2B السريع (Table)"
										>
											☰
										</button>
									</div>

								</div>
							</div>

							<!-- Active Filter Chips Strip -->
							if data.Query != "" || data.ActiveCategory != "" || data.ActiveBrand != "" || data.DosageForm != "" || data.InStock || data.HasDiscount || data.MinPrice != "" || data.MaxPrice != "" {
								<div style="display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap; margin-top:0.85rem; padding-top:0.75rem; border-top:1px dashed var(--border); font-size:0.775rem;">
									<span style="color:var(--text-secondary); font-weight:700;">فلاتر نشطة:</span>
									if data.Query != "" {
										<span class="badge badge-primary" style="gap:0.35rem; padding:0.25rem 0.6rem;">
											<span>بحث: "{ data.Query }"</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } style="color:inherit; text-decoration:none; font-weight:900;">✕</a>
										</span>
									}
									if data.ActiveCategory != "" {
										<span class="badge badge-sky" style="gap:0.35rem; padding:0.25rem 0.6rem;">
											<span>القسم: { data.ActiveCategory }</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } style="color:inherit; text-decoration:none; font-weight:900;">✕</a>
										</span>
									}
									if data.ActiveBrand != "" {
										<span class="badge badge-sky" style="gap:0.35rem; padding:0.25rem 0.6rem;">
											<span>الشركة: { data.ActiveBrand }</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } style="color:inherit; text-decoration:none; font-weight:900;">✕</a>
										</span>
									}
									if data.DosageForm != "" {
										<span class="badge badge-slate" style="gap:0.35rem; padding:0.25rem 0.6rem;">
											<span>الشكل: { data.DosageForm }</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, InStock: data.InStock, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } style="color:inherit; text-decoration:none; font-weight:900;">✕</a>
										</span>
									}
									if data.InStock {
										<span class="badge badge-emerald" style="gap:0.35rem; padding:0.25rem 0.6rem;">
											<span>المتوفر بالمخزون</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, HasDiscount: data.HasDiscount, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } style="color:inherit; text-decoration:none; font-weight:900;">✕</a>
										</span>
									}
									if data.HasDiscount {
										<span class="badge badge-amber" style="gap:0.35rem; padding:0.25rem 0.6rem;">
											<span>عروض الخصم</span>
											<a href={ templ.SafeURL(buildCatalogURL(CatalogPageData{Query: data.Query, CategoryID: data.CategoryID, BrandID: data.BrandID, MinPrice: data.MinPrice, MaxPrice: data.MaxPrice, DosageForm: data.DosageForm, InStock: data.InStock, PageSize: data.PageSize, ViewMode: data.ViewMode}, 1, data.PageSize, data.Sort, data.ViewMode)) } style="color:inherit; text-decoration:none; font-weight:900;">✕</a>
										</span>
									}
									<a href="/catalog" style="font-size:0.75rem; color:var(--rose); text-decoration:underline; margin-inline-start:auto; font-weight:700;">
										مسح جميع الفلاتر
									</a>
								</div>
							}
						</div>

						<!-- Results Dynamic Container -->
						<div id="catalog-results">
							@CustomerCatalogResults(data, lang)
						</div>

					</main>
				</div>
			</div>

			<!-- Price Negotiation Modal -->
			@CustomerNegotiationModal()

			<script>
				function changePageSize(size) {
					const url = new URL(window.location.href);
					url.searchParams.set('page_size', size);
					url.searchParams.set('page', '1');
					window.location.href = url.toString();
				}

				function changeSort(sortVal) {
					const url = new URL(window.location.href);
					url.searchParams.set('sort', sortVal);
					url.searchParams.set('page', '1');
					window.location.href = url.toString();
				}

				function changeViewMode(mode) {
					const url = new URL(window.location.href);
					url.searchParams.set('view', mode);
					window.location.href = url.toString();
				}

				function stepCatalogQty(btn, delta) {
					const form = btn.closest('form');
					if (!form) return;
					const input = form.querySelector('input[name="qty"]');
					if (input) {
						let val = parseInt(input.value, 10) || 1;
						val += delta;
						const min = parseInt(input.getAttribute('min') || '1', 10);
						const max = parseInt(input.getAttribute('max') || '9999', 10);
						if (val < min) val = min;
						if (val > max && max > 0) val = max;
						input.value = val;
					}
				}

				function navigateToVariant(variantId, productId) {
					const id = (variantId && variantId > 0) ? variantId : productId;
					if (id > 0) {
						window.location.href = `/catalog/${id}`;
					}
				}
			</script>
		}
	}
}

templ CustomerCatalogResults(data CatalogPageData, lang string) {
	if len(data.Variants) == 0 {
		<div class="card" style="background:var(--surface-raised); padding:3rem 1.5rem; border-radius:var(--radius-2xl); border:1px solid var(--border); text-align:center;">
			@components.EmptyState(components.EmptyStateProps{
				Title:       "لا توجد عروض توريد مطابقة لمعايير البحث",
				Message:     "لم نعثر على أصناف دوائية مطابقة للبحث أو الفلاتر المحددة. جرب استخدام كلمات بحث بديلة أو إزالة بعض الفلاتر.",
				ActionLabel: "عرض كافة الأصناف المتاحة",
			})
		</div>
	} else {
		<!-- Mode Renderer -->
		if data.ViewMode == "table" {
			@CustomerCatalogTable(data.Variants, lang)
		} else {
			@CustomerCatalogGrid(data.Variants, lang)
		}

		<!-- Smart Pagination Bar -->
		@CustomerCatalogPagination(data)
	}
}

templ CustomerCatalogGrid(variants []*SupplierVariantCard, lang string) {
	<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(290px, 1fr)); gap:1.25rem; margin-bottom:1.5rem;">
		for _, v := range variants {
			<div
				class="card variant-clickable-card"
				onclick={ templ.ComponentScript{Call: fmt.Sprintf("navigateToVariant(%d, %d)", v.VariantID, v.ProductID)} }
				style="display:flex; flex-direction:column; justify-content:space-between; padding:1.2rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); transition:all 0.2s cubic-bezier(0.16, 1, 0.3, 1); box-shadow:var(--shadow-xs); cursor:pointer; position:relative; overflow:hidden;"
				onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='var(--shadow-md)'; this.style.borderColor='var(--accent)';"
				onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-xs)'; this.style.borderColor='var(--border)';"
			>
				<div>
					<!-- Top Visual Media Box -->
					<div style="position:relative; width:100%; height:130px; border-radius:var(--radius-xl); background:linear-gradient(135deg, var(--surface-sunken) 0%, rgba(37,99,235,0.05) 100%); display:flex; align-items:center; justify-content:center; overflow:hidden; border:1px solid var(--border); margin-bottom:0.85rem;">
						if v.ProductImage != "" {
							<img src={ v.ProductImage } alt={ v.ProductNameAr } style="max-height:105px; max-width:88%; object-fit:contain; filter:drop-shadow(0 4px 6px rgba(0,0,0,0.06));" loading="lazy" />
						} else {
							<div style="font-size:3rem; filter:drop-shadow(0 4px 8px rgba(0,0,0,0.08));">
								💊
							</div>
						}

						<!-- Floating Badges -->
						<div style="position:absolute; top:8px; inset-inline-start:8px; display:flex; flex-direction:column; gap:4px; align-items:flex-start;">
							if v.DiscountPercent > 0 {
								<span class="badge" style="background:#10b981; color:#ffffff; font-weight:900; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:var(--radius-full); box-shadow:0 2px 6px rgba(16,185,129,0.35);">
									خصم { fmt.Sprintf("%d%%", v.DiscountPercent) }
								</span>
							}
							if v.DosageForm != "" {
								<span class="badge badge-sky" style="font-size:0.7rem; font-weight:800; padding:0.15rem 0.5rem; border-radius:var(--radius-full);">
									{ v.DosageForm }
								</span>
							}
						</div>

						<!-- Favorite Button -->
						<div onclick="event.stopPropagation();" style="position:absolute; top:8px; inset-inline-end:8px; margin:0;">
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", v.ProductID)) } class="m-0">
								<button type="submit" class="btn btn-secondary btn-icon" style="width:30px; height:30px; background:var(--surface-raised); border-radius:var(--radius-full); box-shadow:var(--shadow-xs); color:var(--text-secondary);" title="حفظ في المفضلة">
									@components.IconHeart("icon-xs")
								</button>
							</form>
						</div>
					</div>

					<!-- Product Title & Subtitle -->
					<div style="margin-bottom:0.5rem;">
						<h3 style="font-size:1.05rem; font-weight:800; margin:0; color:var(--text); line-height:1.35;">
							if v.ProductNameAr != "" {
								{ v.ProductNameAr }
							} else {
								{ v.ProductNameEn }
							}
						</h3>
						if v.ProductNameEn != "" && v.ProductNameEn != v.ProductNameAr {
							<div style="font-size:0.75rem; color:var(--text-secondary); font-weight:600; margin-top:2px;" dir="ltr">
								{ v.ProductNameEn }
							</div>
						}
					</div>

					<!-- Manufacturer & Active Ingredient -->
					if v.BrandName != "" || v.Manufacturer != "" {
						<div style="display:flex; align-items:center; gap:0.4rem; margin-bottom:0.45rem; font-size:0.75rem; color:var(--text-secondary); background:var(--surface-sunken); padding:0.3rem 0.6rem; border-radius:var(--radius-md); border:1px solid var(--border);">
							<span style="color:var(--text-secondary);">🏭</span>
							<span style="color:var(--text-secondary); font-weight:600; flex-shrink:0;">الشركة:</span>
							<strong style="color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
								if v.BrandName != "" {
									{ v.BrandName }
								} else {
									{ v.Manufacturer }
								}
							</strong>
						</div>
					}

					if v.ScientificName != "" {
						<div style="font-size:0.725rem; color:var(--text-secondary); margin-bottom:0.6rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
							<span style="color:var(--text-secondary);">المادة: </span>
							<span style="font-weight:700; color:var(--text);">{ v.ScientificName }</span>
						</div>
					}

					<!-- Supplier Info Box -->
					<div style="border-top:1px dashed var(--border); border-bottom:1px dashed var(--border); padding:0.5rem 0; margin-bottom:0.65rem; display:flex; justify-content:space-between; align-items:center;">
						<div class="row-center-sm">
							<span style="font-size:0.95rem;">🏢</span>
							<div>
								<div style="font-size:0.8rem; font-weight:800; color:var(--text);">
									{ v.SupplierName }
								</div>
								if v.BranchName != "" {
									<div style="font-size:0.7rem; color:var(--text-secondary);">
										{ v.BranchName }
									</div>
								}
							</div>
						</div>
						if v.IsVerified {
							<span class="badge badge-emerald" style="font-size:0.65rem; padding:0.15rem 0.45rem; font-weight:800;">
								معتمد ✓
							</span>
						}
					</div>

					<!-- Stock & Expiry -->
					<div style="display:flex; justify-content:space-between; align-items:center; font-size:0.75rem; color:var(--text-secondary); margin-bottom:0.65rem;">
						<div>
							if v.AvailableStock > 0 {
								<span style="color:var(--emerald); font-weight:800;">
									🟢 متاح ({ fmt.Sprintf("%d", v.AvailableStock) } عبوة)
								</span>
							} else {
								<span style="color:var(--rose); font-weight:800;">
									🔴 غير متوفر
								</span>
							}
						</div>
						if v.ExpiryDate != "" {
							<div class="tabular-nums font-mono" style="color:var(--text-secondary); font-size:0.725rem;">
								صلاحية: { v.ExpiryDate }
							</div>
						}
					</div>
				</div>

				<!-- Pricing & Action Footer -->
				<div style="border-top:1px solid var(--border); padding-top:0.75rem; margin-top:0.25rem;">
					<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.65rem;">
						<div>
							<span style="font-size:0.7rem; color:var(--text-secondary); font-weight:700; display:block;">سعر التوريد:</span>
							if v.OriginalPrice.IsPositive() && v.OriginalPrice.Minor() > v.Price.Minor() {
								<span style="font-size:0.75rem; color:var(--text-secondary); text-decoration:line-through;" class="tabular-nums">
									{ v.OriginalPrice.String() } ج.م
								</span>
							} else if v.PublicPrice.IsPositive() && v.PublicPrice.Minor() > v.Price.Minor() {
								<span style="font-size:0.75rem; color:var(--text-secondary); text-decoration:line-through;" class="tabular-nums" title="سعر الجمهور">
									{ v.PublicPrice.String() } ج.م
								</span>
							}
						</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--accent);">
							if v.Price.IsPositive() {
								{ v.Price.String() } <span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary);">ج.م</span>
							} else {
								<span class="text-sm text-secondary">حسب الكمية</span>
							}
						</div>
					</div>

					if v.CanAddToCart {
						<div onclick="event.stopPropagation();">
							<form method="POST" action="/cart/add" style="display:flex; gap:0.4rem; margin:0;">
								<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.VariantID) } />
								<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
								<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
								<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
								<input type="hidden" name="offer_price" value={ v.Price.String() } />
								
								<div style="display:flex; align-items:center; border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; background:var(--surface-sunken);">
									<button type="button" class="btn btn-ghost btn-xs" style="width:26px; height:38px; padding:0; font-weight:900; font-size:1rem;" onclick="stepCatalogQty(this, -1)">−</button>
									<input
										type="number"
										name="qty"
										value={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
										min={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
										max={ fmt.Sprintf("%d", max(1, v.AvailableStock)) }
										class="tabular-nums"
										style="width:46px; height:38px; text-align:center; font-weight:800; border:none; background:transparent; font-size:0.875rem;"
									/>
									<button type="button" class="btn btn-ghost btn-xs" style="width:26px; height:38px; padding:0; font-weight:900; font-size:1rem;" onclick="stepCatalogQty(this, 1)">+</button>
								</div>

								<button type="submit" class="btn btn-primary btn-sm" style="flex:1; font-weight:800; justify-content:center; height:38px; border-radius:var(--radius-lg); font-size:0.85rem; gap:0.35rem;">
									@components.IconPlus("icon-xs")
									<span>أضف للسلة</span>
								</button>
							</form>

							if v.IsNegotiable {
								<button
									type="button"
									class="btn btn-secondary btn-xs"
									data-variant-id={ fmt.Sprintf("%d", v.VariantID) }
									data-product-id={ fmt.Sprintf("%d", v.ProductID) }
									data-vendor-id={ fmt.Sprintf("%d", v.SupplierID) }
									data-product-name={ v.ProductNameAr }
									data-current-price={ v.Price.String() }
									data-min-qty={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
									onclick="triggerNegotiationModal(this)"
									style="width:100%; margin-top:0.4rem; font-weight:800; justify-content:center; height:32px; border-radius:var(--radius-md); font-size:0.75rem; background:rgba(245,158,11,0.08); color:#d97706; border:1px solid rgba(245,158,11,0.25); gap:0.3rem;"
								>
									<span>🤝</span>
									<span>تفاوض على السعر</span>
								</button>
							}
						</div>
					} else {
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="btn btn-secondary btn-sm" style="width:100%; font-weight:700; justify-content:center; height:38px; border-radius:var(--radius-lg); font-size:0.825rem;">
							<span>تفاصيل الصنف والموردين</span>
							@components.IconArrowLeft("icon-xs")
						</a>
					}
				</div>
			</div>
		}
	</div>
}

templ CustomerCatalogTable(variants []*SupplierVariantCard, lang string) {
	<div class="card" style="background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); overflow:hidden; margin-bottom:1.5rem; box-shadow:var(--shadow-xs);">
		<div class="table-container" style="padding:0; margin:0; overflow-x:auto;">
			<table class="b2b-table" style="margin:0; font-size:0.85rem;">
				<thead>
					<tr>
						<th style="padding:0.75rem 1rem; width:40px;"></th>
						<th style="padding:0.75rem 1rem;">الصنف الدوائي والمادة الفعالة</th>
						<th style="padding:0.75rem 0.85rem;">الشركة المصنعة</th>
						<th style="padding:0.75rem 0.85rem;">المورد والفرع</th>
						<th style="padding:0.75rem 0.75rem; text-align:center;">المخزون والصلاحية</th>
						<th style="padding:0.75rem 0.85rem;" class="td-numeric">سعر التوريد والخصم</th>
						<th style="padding:0.75rem 1rem; text-align:center; width:220px;">الكمية والطلب</th>
					</tr>
				</thead>
				<tbody>
					for _, v := range variants {
						<tr style="transition:background 0.15s ease;">
							<td style="padding:0.6rem 0.5rem 0.6rem 1rem; text-align:center;">
								<div style="width:42px; height:42px; border-radius:var(--radius-md); background:var(--surface-sunken); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; overflow:hidden;">
									if v.ProductImage != "" {
										<img src={ v.ProductImage } alt={ v.ProductNameAr } style="max-height:36px; max-width:36px; object-fit:contain;" loading="lazy" />
									} else {
										<span style="font-size:1.2rem;">💊</span>
									}
								</div>
							</td>
							<td style="padding:0.65rem 1rem;">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } style="text-decoration:none; color:inherit;">
									<div style="font-weight:800; color:var(--text); font-size:0.925rem;">
										if v.ProductNameAr != "" {
											{ v.ProductNameAr }
										} else {
											{ v.ProductNameEn }
										}
									</div>
									if v.ScientificName != "" {
										<div style="font-size:0.75rem; color:var(--text-secondary); margin-top:2px;">
											{ v.ScientificName }
										</div>
									}
								</a>
							</td>
							<td style="padding:0.65rem 0.85rem;">
								<div style="font-weight:700; color:var(--text);">
									if v.BrandName != "" {
										{ v.BrandName }
									} else if v.Manufacturer != "" {
										{ v.Manufacturer }
									} else {
										<span class="text-secondary">-</span>
									}
								</div>
								if v.DosageForm != "" {
									<span class="badge badge-slate" style="font-size:0.65rem; margin-top:2px;">
										{ v.DosageForm }
									</span>
								}
							</td>
							<td style="padding:0.65rem 0.85rem;">
								<div style="font-weight:700; color:var(--text); display:flex; align-items:center; gap:0.35rem;">
									<span>{ v.SupplierName }</span>
									if v.IsVerified {
										<span class="badge badge-emerald" style="font-size:0.6rem; padding:0.1rem 0.35rem;">✓</span>
									}
								</div>
								if v.BranchName != "" {
									<div style="font-size:0.725rem; color:var(--text-secondary);">
										{ v.BranchName }
									</div>
								}
							</td>
							<td style="padding:0.65rem 0.75rem; text-align:center;">
								if v.AvailableStock > 0 {
									<div style="color:var(--emerald); font-weight:800; font-size:0.8rem;" class="tabular-nums">
										{ fmt.Sprintf("%d", v.AvailableStock) } عبوة
									</div>
								} else {
									<div style="color:var(--rose); font-weight:800; font-size:0.8rem;">
										نفد المخزون
									</div>
								}
								if v.ExpiryDate != "" {
									<div style="font-size:0.7rem; color:var(--text-secondary);" class="tabular-nums font-mono">
										{ v.ExpiryDate }
									</div>
								}
							</td>
							<td style="padding:0.65rem 0.85rem;" class="td-numeric">
								<div class="tabular-nums" style="font-weight:900; font-size:1.05rem; color:var(--accent);">
									{ v.Price.String() } ج.م
								</div>
								if v.DiscountPercent > 0 {
									<span class="badge badge-emerald" style="font-size:0.65rem; font-weight:800;">
										خصم { fmt.Sprintf("%d%%", v.DiscountPercent) }
									</span>
								}
							</td>
							<td style="padding:0.65rem 1rem; text-align:center;">
								if v.CanAddToCart {
									<form method="POST" action="/cart/add" style="display:flex; gap:0.35rem; margin:0; justify-content:center;">
										<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.VariantID) } />
										<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
										<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
										<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
										<input type="hidden" name="offer_price" value={ v.Price.String() } />
										
										<div style="display:flex; align-items:center; border:1px solid var(--border); border-radius:var(--radius-md); overflow:hidden; background:var(--surface-sunken);">
											<button type="button" class="btn btn-ghost btn-xs" style="width:22px; height:34px; padding:0; font-weight:900;" onclick="stepCatalogQty(this, -1)">−</button>
											<input
												type="number"
												name="qty"
												value={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
												min={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
												max={ fmt.Sprintf("%d", max(1, v.AvailableStock)) }
												class="tabular-nums"
												style="width:40px; height:34px; text-align:center; font-weight:800; border:none; background:transparent; font-size:0.8rem;"
											/>
											<button type="button" class="btn btn-ghost btn-xs" style="width:22px; height:34px; padding:0; font-weight:900;" onclick="stepCatalogQty(this, 1)">+</button>
										</div>

										<button type="submit" class="btn btn-primary btn-sm" style="font-weight:800; height:34px; border-radius:var(--radius-md); font-size:0.775rem; padding:0 0.75rem;">
											+ للسلة
										</button>
									</form>
								} else {
									<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="btn btn-secondary btn-xs" style="font-weight:700; height:34px; border-radius:var(--radius-md);">
										التفاصيل
									</a>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ CustomerCatalogPagination(data CatalogPageData) {
	<div class="card" style="background:var(--surface-raised); padding:1rem 1.5rem; border-radius:var(--radius-2xl); border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; box-shadow:var(--shadow-xs);">
		
		<!-- Results Summary -->
		<div style="font-size:0.85rem; color:var(--text-secondary);">
			if data.TotalItems > 0 {
				<span>عرض <strong class="tabular-nums" style="color:var(--text);">{ strconv.Itoa(data.StartItem) } - { strconv.Itoa(data.EndItem) }</strong> من إجمالي <strong class="tabular-nums" style="color:var(--accent);">{ strconv.Itoa(data.TotalItems) }</strong> صنف دوائي</span>
				<span style="margin-inline-start:0.5rem; color:var(--text-secondary);">(صفحة <span class="tabular-nums fw-700">{ strconv.Itoa(data.Page) }</span> من <span class="tabular-nums fw-700">{ strconv.Itoa(data.TotalPages) }</span>)</span>
			} else {
				<span>لا توجد أصناف للعرض</span>
			}
		</div>

		<!-- Page Number Navigation Buttons -->
		if data.TotalPages > 1 {
			<div style="display:flex; align-items:center; gap:0.35rem;">
				<!-- Previous Button -->
				if data.HasPrev {
					<a
						href={ templ.SafeURL(buildCatalogURL(data, data.PrevPage, data.PageSize, data.Sort, data.ViewMode)) }
						class="btn btn-secondary btn-sm"
						style="font-weight:700; gap:0.3rem; border-radius:var(--radius-lg); padding:0.4rem 0.8rem; font-size:0.8rem;"
					>
						<span>→ السابق</span>
					</a>
				} else {
					<button disabled class="btn btn-secondary btn-sm" style="opacity:0.45; cursor:not-allowed; border-radius:var(--radius-lg); padding:0.4rem 0.8rem; font-size:0.8rem;">
						<span>→ السابق</span>
					</button>
				}

				<!-- Page Number Links -->
				<div style="display:flex; align-items:center; gap:0.25rem;">
					if data.Page > 3 {
						<a href={ templ.SafeURL(buildCatalogURL(data, 1, data.PageSize, data.Sort, data.ViewMode)) } class="btn btn-secondary btn-xs tabular-nums" style="width:34px; height:34px; padding:0; border-radius:var(--radius-md);">1</a>
						if data.Page > 4 {
							<span style="color:var(--text-secondary); padding:0 2px;">…</span>
						}
					}

					for p := max(1, data.Page-2); p <= min(data.TotalPages, data.Page+2); p++ {
						if p == data.Page {
							<span class="btn btn-primary btn-xs tabular-nums fw-900" style="width:34px; height:34px; padding:0; border-radius:var(--radius-md); box-shadow:0 2px 6px rgba(37,99,235,0.3);">{ strconv.Itoa(p) }</span>
						} else {
							<a href={ templ.SafeURL(buildCatalogURL(data, p, data.PageSize, data.Sort, data.ViewMode)) } class="btn btn-secondary btn-xs tabular-nums" style="width:34px; height:34px; padding:0; border-radius:var(--radius-md);">{ strconv.Itoa(p) }</a>
						}
					}

					if data.Page < data.TotalPages-2 {
						if data.Page < data.TotalPages-3 {
							<span style="color:var(--text-secondary); padding:0 2px;">…</span>
						}
						<a href={ templ.SafeURL(buildCatalogURL(data, data.TotalPages, data.PageSize, data.Sort, data.ViewMode)) } class="btn btn-secondary btn-xs tabular-nums" style="width:34px; height:34px; padding:0; border-radius:var(--radius-md);">{ strconv.Itoa(data.TotalPages) }</a>
					}
				</div>

				<!-- Next Button -->
				if data.HasNext {
					<a
						href={ templ.SafeURL(buildCatalogURL(data, data.NextPage, data.PageSize, data.Sort, data.ViewMode)) }
						class="btn btn-secondary btn-sm"
						style="font-weight:700; gap:0.3rem; border-radius:var(--radius-lg); padding:0.4rem 0.8rem; font-size:0.8rem;"
					>
						<span>التالي ←</span>
					</a>
				} else {
					<button disabled class="btn btn-secondary btn-sm" style="opacity:0.45; cursor:not-allowed; border-radius:var(--radius-lg); padding:0.4rem 0.8rem; font-size:0.8rem;">
						<span>التالي ←</span>
					</button>
				}
			</div>
		}

	</div>
}

func resolveTargetID(variantID, productID int64) int64 {
	if variantID > 0 {
		return variantID
	}
	return productID
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func max(a, b int) int {
	if a > b {
		return a
	}
	return b
}

templ CustomerNegotiationModal() {
	<!-- Price Negotiation Modal Dialog -->
	<div id="negotiation-modal" class="modal-overlay hidden">
		<div class="card" style="max-width:540px; width:100%; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.75rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
			<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem; margin-bottom:1.25rem;">
				<div class="row-center-sm">
					<div style="width:38px; height:38px; border-radius:var(--radius-lg); background:rgba(245,158,11,0.15); color:#d97706; display:flex; align-items:center; justify-content:center; font-size:1.2rem;">
						🤝
					</div>
					<div>
						<h3 style="font-size:1.15rem; font-weight:900; color:var(--text); margin:0;">طلب تفاوض على سعر الصنف</h3>
						<span class="text-xs text-muted">إرسال عرض سعر خاص ومباشر للمورّد</span>
					</div>
				</div>
				<button type="button" class="btn btn-ghost btn-sm" onclick="closeNegotiationModal()" style="font-size:1.2rem; line-height:1; padding:0.25rem 0.5rem;">✕</button>
			</div>

			<form method="POST" action="/customer/negotiate-order" id="negotiation-form" style="display:flex; flex-direction:column; gap:1.15rem; margin:0;">
				<input type="hidden" name="variant_id" id="neg-variant-id" />
				<input type="hidden" name="vendor_org_id" id="neg-vendor-id" />

				<div style="background:var(--surface-sunken); padding:0.85rem 1rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
					<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700;">الصنف الدوائي المختار:</div>
					<div style="font-size:0.95rem; font-weight:800; color:var(--text); margin-top:2px;" id="neg-product-name">-</div>
					<div style="font-size:0.8rem; color:var(--text-secondary); margin-top:4px;">سعر التوريد الحالي المعلن: <strong id="neg-current-price" class="tabular-nums" style="color:var(--primary-600);">-</strong> ج.م</div>
				</div>

				<div class="grid-2">
					<div>
						<label class="form-label" style="font-weight:700; color:var(--text); font-size:0.85rem; margin-bottom:0.35rem; display:block;">
							السعر المقترح للعبوة (ج.م) *
						</label>
						<input
							type="number"
							step="0.01"
							min="0.01"
							name="proposed_price"
							id="neg-proposed-price"
							required
							placeholder="0.00"
							class="form-input tabular-nums"
							style="width:100%; font-weight:800; font-size:1rem; border-radius:var(--radius-lg);"
						/>
					</div>

					<div>
						<label class="form-label" style="font-weight:700; color:var(--text); font-size:0.85rem; margin-bottom:0.35rem; display:block;">
							الكمية المطلوبة (عبوة) *
						</label>
						<input
							type="number"
							min="1"
							name="qty"
							id="neg-qty"
							value="1"
							required
							class="form-input tabular-nums"
							style="width:100%; font-weight:800; font-size:1rem; border-radius:var(--radius-lg);"
						/>
					</div>
				</div>

				<div>
					<label class="form-label" style="font-weight:700; color:var(--text); font-size:0.85rem; margin-bottom:0.35rem; display:block;">
						ملاحظات إضافية للمورّد (اختياري)
					</label>
					<textarea
						name="notes"
						rows="2"
						placeholder="اكتب أي شروط أو تفاصيل إضافية بخصوص خط الدفع أو جدول التوريد..."
						class="form-input"
						style="width:100%; font-size:0.85rem; border-radius:var(--radius-lg); resize:vertical;"
					></textarea>
				</div>

				<div class="modal-footer-standard">
					<button type="button" class="btn btn-secondary fw-700" onclick="closeNegotiationModal()">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary" style="background:#d97706; border-color:#d97706; color:#fff; font-weight:800; padding:0.6rem 1.5rem; border-radius:var(--radius-lg);">
						إرسال طلب التفاوض للمورّد
					</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		function triggerNegotiationModal(btn) {
			openNegotiationModal({
				variant_id: btn.getAttribute('data-variant-id'),
				product_id: btn.getAttribute('data-product-id'),
				vendor_org_id: btn.getAttribute('data-vendor-id'),
				name: btn.getAttribute('data-product-name'),
				current_price: btn.getAttribute('data-current-price'),
				min_qty: parseInt(btn.getAttribute('data-min-qty') || '1', 10)
			});
		}
		function openNegotiationModal(data) {
			document.getElementById('neg-variant-id').value = data.variant_id || '';
			document.getElementById('neg-vendor-id').value = data.vendor_org_id || '';
			document.getElementById('neg-product-name').innerText = data.name || 'صنف دوائي';
			document.getElementById('neg-current-price').innerText = data.current_price || '0.00';
			document.getElementById('neg-qty').value = data.min_qty || 1;
			document.getElementById('neg-proposed-price').value = data.current_price || '';
			const m = document.getElementById('negotiation-modal');
			if (m) {
				m.style.display = 'flex';
				m.classList.remove('hidden');
			}
		}
		function closeNegotiationModal() {
			const m = document.getElementById('negotiation-modal');
			if (m) {
				m.style.display = 'none';
				m.classList.add('hidden');
			}
		}
	</script>
}
