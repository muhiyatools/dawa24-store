package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// SupplierProfileReviewsTab renders the public reviews and vendor replies on the supplier profile page.
templ SupplierProfileReviewsTab(reviews []*org.Review, overallRating float64, totalCount int, lang, activeTab string) {
	<div id="tab-content-reviews" class={ "tab-panel", templ.KV("d-none", activeTab != "reviews") }>
		if len(reviews) == 0 {
			<div class="glass-panel p-8 text-center border rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-amber-50 text-amber-600 font-bold d-flex items-center justify-center mx-auto mb-3 border border-amber-200">
					@components.IconStar("icon-md")
				</div>
				<h3 class="text-sm font-extrabold text-primary mb-1">مورد معتمد موثق</h3>
				<p class="text-xs text-secondary mb-0 max-w-md mx-auto font-medium">
					لم يتم تسجيل تقييمات مكتوبة بعد. عند استلام طلبيتك القادمة يمكنك إضافة تقييمك للمندوب والخدمة والسرعة من تفاصيل الطلب.
				</p>
			</div>
		} else {
			<div class="d-flex flex-col gap-4">
				
				<!-- Rating Summary Header Card -->
				<div class="glass-panel p-4 flex-between flex-wrap gap-3 border rounded-2xl shadow-xs bg-surface-sunken">
					<div class="d-flex items-center gap-3">
						<div class="text-2xl font-black text-amber tabular-nums">
							{ fmt.Sprintf("%.1f", overallRating) }
						</div>
						<div class="stack-2xs">
							<div class="d-flex items-center gap-1.5">
								@components.RatingStars(overallRating, totalCount)
							</div>
							<span class="text-2xs text-muted font-bold">
								مبني على { fmt.Sprintf("%d", totalCount) } تقييم صيدلية موثق
							</span>
						</div>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap text-2xs text-secondary font-bold">
						<span class="px-2.5 py-1 rounded-lg bg-surface border">تقييم المندوب ★</span>
						<span class="px-2.5 py-1 rounded-lg bg-surface border">جودة الخدمة ★</span>
						<span class="px-2.5 py-1 rounded-lg bg-surface border">سرعة التوصيل ★</span>
					</div>
				</div>

				<!-- Reviews List Cards -->
				for _, rv := range reviews {
					<div class="glass-panel p-5 border rounded-2xl shadow-xs">
						
						<!-- Reviewer Top Line -->
						<div class="flex-between items-start flex-wrap gap-2 pb-3 border-b mb-3">
							<div class="d-flex items-center gap-2.5">
								<div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 font-black d-flex items-center justify-center text-xs border border-emerald-200">
									@components.IconBuilding("icon-2xs")
								</div>
								<div>
									<strong class="text-xs font-black text-primary d-block">
										{ rv.ReviewerOrgName }
									</strong>
									<span class="text-2xs text-muted font-medium">
										{ format.Date(rv.CreatedAt, lang) }
									</span>
								</div>
							</div>

							<div class="d-flex items-center gap-2">
								@components.RatingStars(float64(rv.Rating), 0)
								<span class="badge badge-amber text-2xs font-black tabular-nums">
									{ fmt.Sprintf("%d/5", rv.Rating) }
								</span>
							</div>
						</div>

						<!-- 3 Criteria Badges -->
						<div class="d-flex items-center gap-2 flex-wrap mb-3">
							<span class="badge badge-surface text-2xs font-bold text-secondary border">
								المندوب:
								<strong class="text-primary tabular-nums ms-1">
									if rv.ScoreRep > 0 {
										{ fmt.Sprintf("%d ★", rv.ScoreRep) }
									} else {
										{ fmt.Sprintf("%d ★", rv.Rating) }
									}
								</strong>
							</span>
							<span class="badge badge-surface text-2xs font-bold text-secondary border">
								الخدمة:
								<strong class="text-primary tabular-nums ms-1">
									if rv.ScoreQuality > 0 {
										{ fmt.Sprintf("%d ★", rv.ScoreQuality) }
									} else {
										{ fmt.Sprintf("%d ★", rv.Rating) }
									}
								</strong>
							</span>
							<span class="badge badge-surface text-2xs font-bold text-secondary border">
								السرعة:
								<strong class="text-primary tabular-nums ms-1">
									if rv.ScoreSpeed > 0 {
										{ fmt.Sprintf("%d ★", rv.ScoreSpeed) }
									} else {
										{ fmt.Sprintf("%d ★", rv.Rating) }
									}
								</strong>
							</span>
						</div>

						<!-- Pharmacy Review Text -->
						if rv.ReviewText != "" {
							<p class="text-xs text-primary font-medium leading-relaxed mb-3">
								{ rv.ReviewText }
							</p>
						}

						<!-- Vendor Reply Card -->
						if rv.Response != "" {
							<div class="p-3.5 bg-brand-subtle border border-brand/20 rounded-xl mt-3">
								<div class="flex-between items-center mb-1">
									<div class="d-flex items-center gap-1.5 text-xs font-black text-brand">
										@components.IconCheck("icon-2xs")
										<span>رد المورد الرسمي:</span>
									</div>
									if rv.ResponseAt != nil {
										<span class="text-2xs text-muted font-medium">
											{ format.Date(*rv.ResponseAt, lang) }
										</span>
									}
								</div>
								<p class="text-xs text-primary m-0 font-medium leading-relaxed">
									{ rv.Response }
								</p>
							</div>
						}

					</div>
				}

			</div>
		}
	</div>
}