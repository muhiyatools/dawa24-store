package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/hr"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorJobItem struct {
	Job               *hr.JobOffer
	ApplicationsCount int
}

type VendorJobsData struct {
	Jobs              []*VendorJobItem
	Branches          []*org.Branch
	TotalCount        int
	PublishedCount    int
	ClosedCount       int
	TotalApplications int
	Page              int
	PerPage           int
	NoticeType        string
	NoticeMsg         string
}

templ VendorJobs(lang, dir string, data VendorJobsData) {
	@layouts.VendorShell("إدارة التوظيف والوظائف | دواء 24", "jobs", lang, dir) {
		<div class="page-container">
			
			<!-- Notice Toast -->
			if data.NoticeMsg != "" {
				<div
					class={ "alert mb-4",
						templ.KV("alert-success", data.NoticeType != "error"),
						templ.KV("alert-danger", data.NoticeType == "error") }
					role="alert"
				>
					{ data.NoticeMsg }
				</div>
			}

			<!-- Top Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconBriefcase("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								الوظائف وفرص العمل
							</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							نشر الوظائف الشاغرة لمنشأتك، متابعة المتقدمين واستعراض السير الذاتية وإدارة الشواغر بكل سهولة
						</p>
					</div>
					<button type="button" class="btn btn-primary font-bold px-4 py-2" data-modal-open="add-job-modal" onclick="openAddJobModal()">
						@components.IconPlus("icon-xs")
						<span>نشر وظيفة جديدة</span>
					</button>
				</div>
			</div>

			<!-- Metric Stats Cards -->
			<div class="dashboard-stat-grid mb-6">
				<!-- Card 1 -->
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الوظائف</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", data.TotalCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">كافة الشواغر المسجلة</span>
				</div>

				<!-- Card 2 -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-success">الوظائف النشطة</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%d", data.PublishedCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">متاحة لاستقبال المتقدمين</span>
				</div>

				<!-- Card 3 -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-muted">الوظائف المغلقة</div>
					<div class="stat-card-value text-secondary tabular-nums">
						{ fmt.Sprintf("%d", data.ClosedCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">شواغر مكتملة أو مؤرشفة</span>
				</div>

				<!-- Card 4 -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-warning">طلبات التقديم</div>
					<div class="stat-card-value text-warning tabular-nums">
						{ fmt.Sprintf("%d", data.TotalApplications) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">سيرة ذاتية وطلب مستلم</span>
				</div>
			</div>

			<!-- Main Jobs Table Card -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				<div class="p-4 px-6 border-b flex-between items-center">
					<h2 class="text-base font-extrabold text-primary m-0 d-flex items-center gap-2">
						<span>قائمة الشواغر الوظيفية</span>
						<span class="badge badge-slate text-xs">{ fmt.Sprintf("%d وظيفة", len(data.Jobs)) }</span>
					</h2>
				</div>

				if len(data.Jobs) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconFileText("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لم يتم نشر أي وظائف بعد</h3>
						<p class="text-sm text-secondary max-w-md mx-auto mb-4">
							ابدأ بنشر أول وظيفة شاغرة لاستقطاب الكفاءات والصيادلة لمؤسستك.
						</p>
						<button type="button" class="btn btn-primary btn-sm font-bold" onclick="openAddJobModal()">
							@components.IconPlus("icon-xs")
							<span>نشر أول وظيفة الآن</span>
						</button>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>المسمى الوظيفي</th>
									<th>الموقع</th>
									<th>نطاق الراتب</th>
									<th class="text-center">المتقدمون</th>
									<th class="text-center">الحالة</th>
									<th>تاريخ النشر</th>
									<th class="col-actions">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Jobs {
									<tr>
										<!-- Title & Short Desc -->
										<td>
											<div class="font-extrabold text-primary text-sm">
												{ item.Job.Title.Get(i18n.Lang(lang)) }
											</div>
											if item.Job.Description != "" {
												<div class="text-xs text-muted mt-1 truncate" class="max-w-xs">
													{ item.Job.Description }
												</div>
											}
										</td>

										<!-- Location -->
										<td>
											if item.Job.Location != "" {
												<div class="d-flex items-center gap-1 text-xs text-secondary font-bold">
													<span>@components.IconMapPin("icon-sm")</span>
													<span>{ item.Job.Location }</span>
												</div>
											} else {
												<span class="text-muted text-xs">غير محدد</span>
											}
										</td>

										<!-- Salary Range -->
										<td class="tabular-nums text-xs font-mono">
											if item.Job.SalaryMin.IsPositive() || item.Job.SalaryMax.IsPositive() {
												<span class="font-bold text-primary">
													if item.Job.SalaryMin.IsPositive() {
														{ item.Job.SalaryMin.String() }
													}
													if item.Job.SalaryMin.IsPositive() && item.Job.SalaryMax.IsPositive() {
														<span> - </span>
													}
													if item.Job.SalaryMax.IsPositive() {
														{ item.Job.SalaryMax.String() }
													}
													<span class="text-xs text-muted"> ج.م</span>
												</span>
											} else {
												<span class="text-muted text-xs">يحدد بالمقابلة</span>
											}
										</td>

										<!-- Applicants Count -->
										<td class="col-actions">
											<button
												type="button"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("viewApplicants(%d, '%s')", item.Job.ID, item.Job.Title.Get(i18n.Lang(lang)))} }
												class="btn btn-secondary btn-sm text-xs font-bold px-3 py-1 gap-1"
											>
												<span>@components.IconUsers("icon-sm")</span>
												<span>{ fmt.Sprintf("%d متقدم", item.ApplicationsCount) }</span>
											</button>
										</td>

										<!-- Status -->
										<td class="text-center">
											if item.Job.Status == "published" {
												<span class="badge badge-emerald text-xs font-bold">
													منشورة ومتاحة
												</span>
											} else {
												<span class="badge badge-slate text-xs font-bold">
													مغلقة
												</span>
											}
										</td>

										<!-- Date -->
										<td class="text-xs text-muted tabular-nums">
											{ item.Job.CreatedAt.Format("2006-01-02") }
										</td>

										<!-- Actions -->
										<td class="col-actions">
											<div class="table-actions">
												
												<!-- Edit Job Button -->
												<button
													type="button"
													class="btn btn-secondary btn-sm font-bold text-xs px-3"
													data-job-id={ fmt.Sprintf("%d", item.Job.ID) }
													data-title-ar={ item.Job.Title.Get(i18n.AR) }
													data-title-en={ item.Job.Title.Get(i18n.EN) }
													data-location={ item.Job.Location }
													data-sal-min={ item.Job.SalaryMin.String() }
													data-sal-max={ item.Job.SalaryMax.String() }
													data-status={ item.Job.Status }
													data-desc={ item.Job.Description }
													data-reqs={ item.Job.Requirements }
													onclick="openEditJobModalFromBtn(this)"
													title="تعديل بيانات وحالة الوظيفة"
												>
													@components.IconEdit("icon-xs")
													<span>تعديل</span>
												</button>

												<!-- Toggle Status Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/jobs/%d/toggle", item.Job.ID)) } class="m-0">
													if item.Job.Status == "published" {
														<button type="submit" class="btn btn-secondary btn-sm text-xs font-bold" title="إغلاق استقبال الطلبات">
															إغلاق
														</button>
													} else {
														<button type="submit" class="btn btn-secondary btn-sm text-xs font-bold text-brand" title="إعادة نشر الوظيفة">
															إعادة النشر
														</button>
													}
												</form>

												<!-- Delete Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/jobs/%d/delete", item.Job.ID)) } onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذه الوظيفة نهائياً؟');" class="m-0">
													<button type="submit" class="btn btn-secondary btn-sm btn-icon text-danger" title="حذف الوظيفة">
														@components.IconTrash("icon-xs")
													</button>
												</form>

											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if data.TotalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.TotalCount,
							BaseURL:     "/vendor/jobs",
						})
					}
				}
			</div>

		</div>

		<!-- MODAL: Add New Job Modal -->
		@components.Modal(components.ModalProps{ID: "add-job-modal", Title: "إضافة وظيفة شاغرة جديدة", Size: "lg"}) {
			<form method="POST" action="/vendor/jobs" class="stack-lg">
				<!-- Titles -->
				<div class="grid-2">
     <div class="stack-sm">
						<label class="form-label">
							المسمى الوظيفي (بالعربية) <span class="text-danger">*</span>
						</label>
						<input
							type="text"
							name="title_ar"
							required
							class="form-input field-height"
							placeholder="مثال: صيدلي أول / مندوب مبيعات"
						/>
					</div>

     <div class="stack-sm">
						<label class="form-label">
							المسمى الوظيفي (بالإنجليزية)
						</label>
						<input
							type="text"
							name="title_en"
							class="form-input field-height"
							placeholder="e.g. Senior Pharmacist"
							dir="ltr"
						/>
					</div>
				</div>

				<!-- Location & Branch Selection -->
    <div class="stack-sm">
					<label class="form-label">
						الفرع / مقر العمل المخصص للوظيفة <span class="text-danger">*</span>
					</label>
					if len(data.Branches) == 0 {
						<div class="p-3 bg-surface-sunken border border-dashed rounded-lg text-xs text-secondary">
							<span>لا توجد فروع مسجلة حالياً. سيتم ربط الوظيفة بـ <strong>(الفرع الرئيسي)</strong>. يمكنك إضافة فروع من <a href="/vendor/branches" class="text-primary font-bold text-decoration-none">إدارة الفروع ←</a>.</span>
						</div>
						<input type="hidden" name="location" value="الفرع الرئيسي" />
					} else {
						<select
							name="branch_id"
							required
							class="form-input field-cta"
						>
							<option value="">-- اختر الفرع المتاح للوظيفة --</option>
							for _, b := range data.Branches {
								<option value={ fmt.Sprintf("%d", b.ID) }>
									{ b.Name.Get(i18n.ParseLang(lang)) }
									if b.IsMain {
										(الفرع الرئيسي)
									}
								</option>
							}
						</select>
					}
				</div>

				<!-- Salary Range -->
				<div class="grid-2">
     <div class="stack-sm">
						<label class="form-label">
							الحد الأدنى للراتب (ج.م)
						</label>
						<input
							type="number"
							step="100"
							name="salary_min"
							class="form-input h-11 font-mono rounded-lg"
							placeholder="5000"
						/>
					</div>

     <div class="stack-sm">
						<label class="form-label">
							الحد الأقصى للراتب (ج.م)
						</label>
						<input
							type="number"
							step="100"
							name="salary_max"
							class="form-input h-11 font-mono rounded-lg"
							placeholder="12000"
						/>
					</div>
				</div>

				<!-- Description -->
    <div class="stack-sm">
					<label class="form-label">
						الوصف الوظيفي والمهام والمسؤوليات <span class="text-danger">*</span>
					</label>
					<textarea
						name="description"
						rows="4"
						required
						class="form-input rounded-lg p-3 text-sm"
						placeholder="اكتب نبذة عن الدور الوظيفي، المهام اليومية، وساعات العمل..."
					></textarea>
				</div>

				<!-- Requirements -->
    <div class="stack-sm">
					<label class="form-label">
						المتطلبات والمؤهلات المطلوبة
					</label>
					<textarea
						name="requirements"
						rows="3"
						class="form-input rounded-lg p-3 text-sm"
						placeholder="اكتب نبذة عن الدور الوظيفي، المهام اليومية، وساعات العمل..."
					></textarea>
				</div>

				<!-- Form Footer -->
				<div class="modal-footer pt-3 border-t flex-between items-center">
					<button type="button" class="btn btn-secondary font-bold" onclick="closeAddJobModal()">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary font-bold px-6">
						نشر الوظيفة الآن
					</button>
				</div>
			</form>
		}

		<!-- MODAL: Edit Job Modal -->
		@components.Modal(components.ModalProps{ID: "edit-job-modal", Title: "تعديل بيانات وإعدادات الوظيفة الشاغرة", Size: "lg"}) {
			<form id="edit-job-form" method="POST" action="" class="stack-lg">
				<input type="hidden" id="edit-job-id" name="id" value="" />

				<!-- Status & Active Switch -->
				<div class="grid-2 bg-surface-sunken p-3.5 border rounded-xl items-center">
     <div class="stack-sm">
						<label class="form-label mb-1">
							حالة الوظيفة الحالية
						</label>
						<select id="edit-job-status" name="status" class="form-input h-10 font-bold">
							<option value="published">قيد النشر (ظاهرة للباحثين ومتاحة للتقديم)</option>
							<option value="closed">مغلقة (مخفية ولا تستقبل طلبات جديدة)</option>
							<option value="draft">مسودة (غير منشورة)</option>
						</select>
					</div>

					<div class="flex-between">
      <div class="stack-sm">
							<span class="d-block font-extrabold text-sm text-primary">تفعيل واستقبال التقديم</span>
							<span class="d-block text-xs text-muted">تظهر للباحثين في منصة التوظيف المعتمدة</span>
						</div>
						<input type="checkbox" id="edit-job-is-active" name="is_active" value="true" class="form-check-input" />
					</div>
				</div>

				<!-- Titles -->
				<div class="grid-2">
     <div class="stack-sm">
						<label class="form-label">
							المسمى الوظيفي (بالعربية) <span class="text-danger">*</span>
						</label>
						<input
							type="text"
							id="edit-job-title-ar"
							name="title_ar"
							required
							class="form-input field-height"
						/>
					</div>

     <div class="stack-sm">
						<label class="form-label">
							المسمى الوظيفي (بالإنجليزية)
						</label>
						<input
							type="text"
							id="edit-job-title-en"
							name="title_en"
							class="form-input field-height"
							dir="ltr"
						/>
					</div>
				</div>

				<!-- Location & Branch Selection -->
				<div class="stack-sm">
					<label class="form-label">
						الفرع / مقر العمل المخصص للوظيفة
					</label>
					<select id="edit-job-branch-id" name="branch_id" class="form-input h-11 rounded-lg">
						<option value="">-- اختر الفرع المتاح للوظيفة --</option>
						for _, b := range data.Branches {
							<option value={ fmt.Sprintf("%d", b.ID) }>
								{ b.Name.Get(i18n.ParseLang(lang)) }
								if b.IsMain {
									(الفرع الرئيسي)
								}
							</option>
						}
					</select>
				</div>

				<!-- Salary Range -->
				<div class="grid-2">
					<div class="stack-sm">
						<label class="form-label">
							الحد الأدنى للراتب (ج.م)
						</label>
						<input
							type="number"
							step="100"
							id="edit-job-salary-min"
							name="salary_min"
							class="form-input h-11 font-mono rounded-lg"
						/>
					</div>

					<div class="stack-sm">
						<label class="form-label">
							الحد الأقصى للراتب (ج.م)
						</label>
						<input
							type="number"
							step="100"
							id="edit-job-salary-max"
							name="salary_max"
							class="form-input h-11 font-mono rounded-lg"
						/>
					</div>
				</div>

				<!-- Description -->
    <div class="stack-sm">
					<label class="form-label">
						الوصف الوظيفي والمهام والمسؤوليات <span class="text-danger">*</span>
					</label>
					<textarea
						id="edit-job-description"
						name="description"
						rows="4"
						required
						class="form-input rounded-lg"
					></textarea>
				</div>

				<!-- Requirements -->
				<div class="stack-sm">
					<label class="form-label">
						المتطلبات والمؤهلات
					</label>
					<textarea
						id="edit-job-requirements"
						name="requirements"
						rows="3"
						class="form-input rounded-lg"
					></textarea>
				</div>

				<!-- Form Footer -->
				<div class="modal-footer pt-3 border-t flex-between items-center">
					<button type="button" class="btn btn-secondary font-bold" onclick="closeEditJobModal()">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary font-bold px-6">
						@components.IconCheck("icon-xs")
						<span>حفظ التعديلات</span>
					</button>
				</div>
			</form>
		}

		<!-- ================= APPLICANTS MODAL ================= -->
		@components.Modal(components.ModalProps{ID: "job-applicants-modal", Title: "طلبات التقديم للوظيفة الشاغرة", Size: "lg"}) {
			<div id="applicants-modal-subtitle" class="text-xs text-brand font-bold mb-3">
				الوظيفة: -
			</div>
			<!-- Dynamic Content -->
			<div id="applicants-modal-content" class="modal-body p-0">
				<!-- Populated by JS -->
			</div>
		}

		<!-- ================= ONBOARD EMPLOYEE MODAL ================= -->
		@components.Modal(components.ModalProps{ID: "onboard-modal", Title: "قبول وتعيين المتقدم بالمنشأة", Size: "md"}) {
			<div id="onboard-modal-subtitle" class="text-xs text-secondary mb-3">
				الوظيفة: -
			</div>
			<form id="onboard-employee-form" onsubmit="submitOnboardEmployee(event)" class="d-flex flex-col gap-4 m-0">
				<input type="hidden" id="onboard-app-id" name="applicant_id" value="" />

				<div class="stack-sm">
					<label class="form-label">
						البريد الإلكتروني المهني <span class="text-danger">*</span>
					</label>
					<input
						type="email"
						id="onboard-email"
						name="email"
						required
						placeholder="employee@domain.com"
						class="form-input"
						dir="ltr"
					/>
				</div>

				<div class="stack-sm">
					<label class="form-label">
						كلمة المرور المبدئية <span class="text-danger">*</span>
					</label>
					<input
						type="password"
						id="onboard-password"
						name="password"
						required
						minlength="8"
						placeholder="8 أحرف كحد أدنى"
						class="form-input"
					/>
				</div>

				<div class="stack-sm">
					<label class="form-label">
						الدور الوظيفي والصلاحيات <span class="text-danger">*</span>
					</label>
					<select id="onboard-role" name="role" required class="form-input font-bold">
						<option value="pharmacist">صيدلي (Pharmacist)</option>
						<option value="sales_rep">مندوب مبيعات (Sales Representative)</option>
						<option value="accountant">محاسب (Accountant)</option>
						<option value="data_entry">مدخل بيانات (Data Entry)</option>
						<option value="manager">مدير فرع / مسؤول (Manager)</option>
					</select>
				</div>

				<div class="modal-footer pt-3 border-t flex-between items-center">
					<button type="button" class="btn btn-secondary font-bold" onclick="closeOnboardModal()">
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary font-bold px-6">
						@components.IconCheck("icon-xs")
						<span>تأكيد التعيين والربط</span>
					</button>
				</div>
			</form>
		}

		<script>
			let currentJobId = 0;
			let currentJobTitle = '';

			function openAddJobModal() {
				const el = document.getElementById('add-job-modal');
				if (el && typeof el.showModal === 'function') {
					el.showModal();
				}
			}

			function closeAddJobModal() {
				const el = document.getElementById('add-job-modal');
				if (el && typeof el.close === 'function') {
					el.close();
				}
			}

			function openEditJobModalFromBtn(btn) {
				if (!btn) return;
				const jobId = btn.getAttribute('data-job-id');
				const titleAr = btn.getAttribute('data-title-ar') || '';
				const titleEn = btn.getAttribute('data-title-en') || '';
				const location = btn.getAttribute('data-location') || '';
				const salMin = btn.getAttribute('data-sal-min') || '';
				const salMax = btn.getAttribute('data-sal-max') || '';
				const status = btn.getAttribute('data-status') || '';
				const desc = btn.getAttribute('data-desc') || '';
				const reqs = btn.getAttribute('data-reqs') || '';

				const form = document.getElementById('edit-job-form');
				if (form) form.action = `/vendor/jobs/${jobId}/edit`;

				const titleArInput = document.getElementById('edit-job-title-ar');
				const titleEnInput = document.getElementById('edit-job-title-en');
				const locationInput = document.getElementById('edit-job-location');
				const branchSelect = document.getElementById('edit-job-branch-id');
				const statusInput = document.getElementById('edit-job-status');
				const salMinInput = document.getElementById('edit-job-salary-min');
				const salMaxInput = document.getElementById('edit-job-salary-max');
				const descInput = document.getElementById('edit-job-description');
				const reqsInput = document.getElementById('edit-job-requirements');

				if (titleArInput) titleArInput.value = titleAr || '';
				if (titleEnInput) titleEnInput.value = titleEn || '';
				if (locationInput) locationInput.value = location || '';
				if (branchSelect) {
					let matched = false;
					if (location) {
						for (let i = 0; i < branchSelect.options.length; i++) {
							const opt = branchSelect.options[i];
							const optText = opt.textContent.trim();
							const optName = opt.getAttribute('data-branch-name') || '';
							const optNameAr = opt.getAttribute('data-branch-name-ar') || '';
							const optNameEn = opt.getAttribute('data-branch-name-en') || '';
							if (optText.includes(location) || optName === location || optNameAr === location || optNameEn === location) {
								branchSelect.selectedIndex = i;
								matched = true;
								break;
							}
						}
					}
					if (!matched && branchSelect.options.length > 1) {
						branchSelect.selectedIndex = 1;
					}
				}
				if (statusInput) statusInput.value = status || 'published';
				if (salMinInput) salMinInput.value = salMin || '';
				if (salMaxInput) salMaxInput.value = salMax || '';
				if (descInput) descInput.value = desc || '';
				if (reqsInput) reqsInput.value = reqs || '';

				const modal = document.getElementById('edit-job-modal');
				if (modal && typeof modal.showModal === 'function') {
					modal.showModal();
				}
			}

			function closeEditJobModal() {
				const modal = document.getElementById('edit-job-modal');
				if (modal && typeof modal.close === 'function') {
					modal.close();
				}
			}

			function openApplicantsModal() {
				const el = document.getElementById('job-applicants-modal');
				if (el && typeof el.showModal === 'function') {
					el.showModal();
				}
			}

			function closeApplicantsModal() {
				const el = document.getElementById('job-applicants-modal');
				if (el && typeof el.close === 'function') {
					el.close();
				}
			}

			function openOnboardModal(appId, applicantName, jobTitle) {
				document.getElementById('onboard-job-id').value = currentJobId;
				document.getElementById('onboard-app-id').value = appId;
				document.getElementById('onboard-modal-subtitle').textContent = `المتقدم: ${applicantName} • الوظيفة: ${jobTitle}`;
				document.getElementById('onboard-job-title').value = jobTitle || '';
				const modal = document.getElementById('onboard-modal');
				if (modal && typeof modal.showModal === 'function') {
					modal.showModal();
				}
			}

			function closeOnboardModal() {
				const modal = document.getElementById('onboard-modal');
				if (modal && typeof modal.close === 'function') {
					modal.close();
				}
			}

			async function viewApplicants(jobId, jobTitle) {
				currentJobId = jobId;
				currentJobTitle = jobTitle;
				document.getElementById('applicants-modal-subtitle').textContent = `الوظيفة: ${jobTitle}`;
				document.getElementById('applicants-modal-content').innerHTML = `
					<div class="p-10 text-center text-muted">
						<div class="text-2xl mb-2">⏳</div>
						<div class="stat-card-label">جاري استرجاع طلبات التقديم والسير الذاتية...</div>
					</div>
				`;
				openApplicantsModal();

				try {
					const res = await fetch(`/vendor/jobs/${jobId}/applications`);
					if (!res.ok) throw new Error('فشل في جلب البيانات');
					const apps = await res.json();

					if (!apps || apps.length === 0) {
						document.getElementById('applicants-modal-content').innerHTML = `
							<div class="text-center p-12">
								<div class="text-4xl mb-2">@components.IconMail("icon-sm")</div>
								<h4 class="text-primary font-extrabold m-0">لا يوجد متقدمين حتى الآن</h4>
								<p class="text-muted text-xs mt-1">
									لم يقم أي مستخدم بالتقديم على هذه الوظيفة بعد.
								</p>
							</div>
						`;
						return;
					}

					let html = `<div class="d-flex flex-col gap-3">`;

					apps.forEach(app => {
						const dateStr = app.created_at ? new Date(app.created_at).toLocaleDateString('ar-EG') : '';
						const cvBtn = app.cv_storage_key 
							? `<a href="${app.cv_storage_key}" target="_blank" class="btn btn-secondary btn-sm" class="text-xs font-bold gap-1 text-accent">
									<span>@components.IconFile("icon-sm")</span>
									<span>تحميل السيرة الذاتية (CV)</span>
							   </a>`
							: `<span class="text-xs text-muted">لم يرفق CV</span>`;

						let statusBadge = '';
						let actionButtons = '';

						if (app.status === 'accepted' || app.status === 'hired') {
							const branchText = app.branch_name ? `فرع: ${app.branch_name}` : 'المقر الرئيسي';
							statusBadge = `<span class="badge badge-emerald text-xs font-bold">تم القبول والتعيين (${branchText})</span>`;
						} else if (app.status === 'rejected') {
							statusBadge = `<span class="badge badge-slate text-xs font-bold">تم رفض الطلب</span>`;
						} else {
							statusBadge = `<span class="badge badge-sky text-xs font-bold">⏳ قيد المراجعة</span>`;
							actionButtons = `
								<div class="d-flex gap-1.5 items-center">
									<button type="button" class="btn btn-primary btn-sm fw-800" onclick="openOnboardModal(${app.id}, '${app.applicant_name}', '${jobTitle}')" class="text-xs px-3 py-1.5 gap-1">
										<span>@components.IconCheckCircle("icon-sm")</span>
										<span>قبول وتعيين</span>
									</button>
									<button type="button" class="btn btn-secondary btn-sm text-danger" onclick="rejectApplicant(${jobId}, ${app.id})" class="text-xs px-2.5 py-1.5">
										<span>رفض</span>
									</button>
								</div>
							`;
						}

						html += `
							<div class="p-4 bg-surface-sunken border rounded-2xl flex-between items-center flex-wrap gap-4">
        <div class="stack-sm">
									<div class="inline-row-06">
										<span class="font-black text-base text-primary">${app.applicant_name || 'متقدم'}</span>
										${statusBadge}
									</div>
									<div class="d-flex gap-4 text-xs text-muted mt-1 flex-wrap">
										<span>${app.applicant_email || '-'}</span>
										<span>${app.applicant_phone || '-'}</span>
										<span>${dateStr}</span>
									</div>
								</div>
								<div class="d-flex items-center gap-3 flex-wrap">
									${cvBtn}
									${actionButtons}
								</div>
							</div>
						`;
					});

					html += `</div>`;
					document.getElementById('applicants-modal-content').innerHTML = html;
				} catch (err) {
					document.getElementById('applicants-modal-content').innerHTML = `
						<div class="alert alert-danger p-md">
							حدث خطأ أثناء تحميل المتقدمين: ${err.message}
						</div>
					`;
				}
			}

			async function submitOnboardEmployee(e) {
				e.preventDefault();
				const jobId = document.getElementById('onboard-job-id').value;
				const appId = document.getElementById('onboard-app-id').value;
				const branchId = document.getElementById('onboard-branch-id').value;
				const roleKey = document.getElementById('onboard-role-key').value;
				const jobTitle = document.getElementById('onboard-job-title').value;
				const baseSalary = document.getElementById('onboard-base-salary').value;
				const notes = document.getElementById('onboard-notes').value;

				const submitBtn = document.getElementById('onboard-submit-btn');
				submitBtn.disabled = true;
				submitBtn.innerHTML = '<span>جاري التعيين...</span>';

				try {
					const res = await fetch(`/vendor/jobs/${jobId}/applications/${appId}/accept`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							branch_id: branchId ? parseInt(branchId) : 0,
							role_key: roleKey,
							job_title: jobTitle,
							base_salary: baseSalary,
							notes: notes
						})
					});
					const data = await res.json();
					if (!res.ok || data.error) throw new Error(data.error || 'فشلت العملية');

					closeOnboardModal();
					alert('تم قبول المتقدم وتعيينه كموظف بنجاح وإرسال إشعار رسمي له!');
					viewApplicants(currentJobId, currentJobTitle);
				} catch (err) {
					alert('حدث خطأ: ' + err.message);
				} finally {
					submitBtn.disabled = false;
					submitBtn.innerHTML = '<span>تأكيد القبول وتعيين الموظف</span>';
				}
			}

			async function rejectApplicant(jobId, appId) {
				if (!confirm('هل أنت متأكد من رفض هذا الطلب؟ سيتم إرسال إشعار اعتذار للمتقدم.')) return;
				try {
					const res = await fetch(`/vendor/jobs/${jobId}/applications/${appId}/reject`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ notes: 'تمت المراجعة والاعتذار عن الطلب' })
					});
					const data = await res.json();
					if (!res.ok || data.error) throw new Error(data.error || 'فشلت العملية');

					alert('تم رفض الطلب وإرسال إشعار للمتقدم.');
					viewApplicants(currentJobId, currentJobTitle);
				} catch (err) {
					alert('حدث خطأ: ' + err.message);
				}
			}

			// Close on backdrop click
			window.addEventListener('click', function(e) {
				const addModal = document.getElementById('add-job-modal');
				const editModal = document.getElementById('edit-job-modal');
				const appModal = document.getElementById('job-applicants-modal');
				const onbModal = document.getElementById('onboard-modal');
				if (e.target === addModal) closeAddJobModal();
				if (e.target === editModal) closeEditJobModal();
				if (e.target === appModal) closeApplicantsModal();
				if (e.target === onbModal) closeOnboardModal();
			});
		</script>
	}
}
