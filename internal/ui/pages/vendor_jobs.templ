package pages

import (
	"github.com/muhiya/dawa24-store/internal/modules/hr"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorJobs(lang, dir string, jobs []*hr.JobOffer) {
	@layouts.VendorShell("الوظائف", "jobs", lang, dir) {
		<div class="card" style="margin-bottom:1.25rem;">
			<h2 class="card-title" style="margin:0 0 1rem;">نشر وظيفة جديدة</h2>
			<form method="POST" action="/vendor/jobs" style="display:flex; flex-direction:column; gap:0.9rem;">
				<div class="form-grid-2">
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="vj-title-ar">المسمى الوظيفي (عربي)</label>
						<input type="text" id="vj-title-ar" name="title_ar" required class="form-input" />
					</div>
					<div class="form-group" style="margin-bottom:0;">
						<label class="form-label" for="vj-title-en">المسمى الوظيفي (إنجليزي)</label>
						<input type="text" id="vj-title-en" name="title_en" class="form-input" dir="ltr" />
					</div>
				</div>
				<div class="form-group" style="margin-bottom:0;">
					<label class="form-label" for="vj-location">الموقع</label>
					<input type="text" id="vj-location" name="location" class="form-input" placeholder="القاهرة" />
				</div>
				<div class="form-group" style="margin-bottom:0;">
					<label class="form-label" for="vj-desc">الوصف</label>
					<textarea id="vj-desc" name="description" rows="3" class="form-textarea"></textarea>
				</div>
				<div class="form-group" style="margin-bottom:0;">
					<label class="form-label" for="vj-req">المتطلبات</label>
					<textarea id="vj-req" name="requirements" rows="2" class="form-textarea"></textarea>
				</div>
				<button type="submit" class="btn btn-primary" style="justify-content:center;">
					@components.IconPlus("icon-sm")
					<span>نشر الوظيفة</span>
				</button>
			</form>
		</div>

		<div class="card">
			<h2 class="card-title" style="margin:0 0 0.75rem;">وظائفك المنشورة</h2>
			if len(jobs) == 0 {
				<p style="color:var(--neutral-500); font-size:0.9rem;">لم تنشر أي وظائف بعد.</p>
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead><tr><th>المسمى</th><th>الموقع</th><th>الحالة</th></tr></thead>
						<tbody>
							for _, j := range jobs {
								<tr>
									<td>{ j.Title.Get(i18n.Lang(lang)) }</td>
									<td>{ j.Location }</td>
									<td><span class="badge badge-emerald">{ j.Status }</span></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
