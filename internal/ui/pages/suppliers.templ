package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ SuppliersDirectory(lang, dir string, data SupplierDirectoryData) {
	if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
		@layouts.CustomerShell("دليل الموردين المعتمدين | Suppliers Directory", "suppliers", lang, dir, nil) {
			@SuppliersDirectoryContent(lang, dir, data)
		}
	} else {
		@layouts.PublicShell("دليل الموردين المعتمدين | Suppliers Directory", lang, dir) {
			@SuppliersDirectoryContent(lang, dir, data)
		}
	}
}

templ SuppliersDirectoryContent(lang, dir string, data SupplierDirectoryData) {

		<div class="suppliers-page-container" style="max-width:1160px; margin:1.5rem auto 5rem auto;">
			
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:var(--space-4); margin-bottom:var(--space-8);">
				<div>
					<div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-1);">
						<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
							@components.IconBuilding("icon-sm")
						</div>
						<h1 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin:0;">
							دليل شركات وموردي الأدوية المعتمدين
						</h1>
					</div>
					<p style="color:var(--text-muted); font-size:var(--text-sm); margin:0;">
						شبكة مستودعات التوزيع الدوائي والمستلزمات الطبية في مصر مع ضمانات التبريد والشحن المعتمد
					</p>
				</div>

				<a href="/suppliers/followed" class="btn btn-secondary" style="font-weight:600;">
					@components.IconHeart("icon-xs")
					<span>الموردون المتابعون</span>
				</a>
			</div>

			if len(data.Suppliers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لا يوجد موردون معتمدون حالياً",
					Message:     "لم يتم العثور على موردين مسجلين في الدليل.",
					ActionLabel: "تصفح كتالوج الأدوية",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:var(--space-6);">
					for _, s := range data.Suppliers {
						<div class="card" style="display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0; padding:var(--space-6); border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-raised);">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:var(--space-4);">
									<div style="display:flex; align-items:center; gap:var(--space-3);">
										<div style="width:44px; height:44px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; border:1px solid var(--border);">
											@components.IconBuilding("icon-md")
										</div>
										<div>
											<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin:0;">
												if s.TradeName.Get(i18n.Lang(lang)) != "" {
													{ s.TradeName.Get(i18n.Lang(lang)) }
												} else {
													{ s.LegalName }
												}
											</h3>
											<span class="badge badge-sky" style="font-size:var(--text-xs); margin-top:2px;">{ OrgTypeLabel(s.Type) }</span>
										</div>
									</div>
								</div>

								<div style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.6; margin-bottom:var(--space-3);">
									if s.LegalName != "" && s.LegalName != s.TradeName.Get(i18n.Lang(lang)) {
										<div><strong>الاسم القانوني:</strong> { s.LegalName }</div>
									}
									if s.CommercialRegister != "" {
										<div style="margin-top:2px; color:var(--text-muted);"><strong>السجل التجاري:</strong> <span class="tabular-nums">{ s.CommercialRegister }</span></div>
									}
								</div>

								<div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-4);">
									<div style="display:inline-flex; align-items:center; gap:4px; font-size:var(--text-xs); font-weight:700; background:var(--surface-sunken); padding:4px 8px; border-radius:var(--radius-md); border:1px solid var(--border);">
										<span style="color:#f59e0b;">★</span>
										if s.Rating > 0 {
											<span class="tabular-nums">{ fmt.Sprintf("%.1f", float64(s.Rating)) }</span>
										} else {
											<span class="text-muted">5.0</span>
										}
									</div>
									<span class="badge badge-emerald" style="font-size:11px;">مورد معتمد</span>
								</div>
							</div>


							<div style="border-top:1px solid var(--border); padding-top:var(--space-4);">
								<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.ID)) } class="btn btn-primary" style="width:100%; justify-content:center; font-weight:600;">
									@components.IconBuilding("icon-xs")
									<span>عرض ملف المورد والكتالوج</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
}


templ SupplierProfile(lang, dir string, data SupplierProfileData) {
	@layouts.PublicShell(fmt.Sprintf("%s | ملف المورد المعتمد", data.Org.TradeName.Get(i18n.Lang(lang))), lang, dir) {
		<div class="supplier-profile-container" style="max-width:1200px; margin:1.5rem auto 4rem auto; padding:0 1rem; display:flex; flex-direction:column; gap:1.5rem;">
			
			<!-- Breadcrumbs -->
			<nav style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--text-muted);">
				<a href="/" style="color:var(--text-secondary); text-decoration:none;">الرئيسية</a>
				<span>/</span>
				<a href="/suppliers" style="color:var(--text-secondary); text-decoration:none;">دليل الموردين</a>
				<span>/</span>
				<span style="color:var(--text); font-weight:700;">{ data.Org.TradeName.Get(i18n.Lang(lang)) }</span>
			</nav>

			<!-- 1. Verified Supplier Flagship Header Banner -->
			<div class="card mb-0" style="padding:1.75rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.5rem;">
					
					<!-- Left Info -->
					<div style="display:flex; align-items:flex-start; gap:1.25rem; flex:1; min-width:280px;">
						<div style="width:64px; height:64px; border-radius:var(--radius-xl); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; border:1px solid var(--border); flex-shrink:0;">
							@components.IconBuilding("icon-lg")
						</div>
						<div>
							<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.25rem;">
								<h1 style="font-size:1.65rem; font-weight:900; color:var(--text); margin:0;">
									{ data.Org.TradeName.Get(i18n.Lang(lang)) }
								</h1>
								<span class="badge badge-emerald" style="font-weight:700; font-size:0.75rem;">
									@components.IconCheckCircle("icon-xs")
									<span>موزع أدوية معتمد</span>
								</span>
							</div>

							if data.Org.LegalName != "" && data.Org.LegalName != data.Org.TradeName.Get(i18n.Lang(lang)) {
								<p style="color:var(--text-secondary); font-size:0.875rem; margin:0 0 0.5rem 0; font-weight:600;">
									{ data.Org.LegalName }
								</p>
							}

							<!-- Credentials & Real Rating Strip -->
							<div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap; font-size:0.85rem; color:var(--text-secondary); margin-top:0.35rem;">
								if data.ReviewCount > 0 {
									<div style="display:flex; align-items:center; gap:0.35rem;">
										@components.RatingStars(data.Rating, data.ReviewCount)
									</div>
								} else {
									<span style="font-size:0.8rem; color:var(--text-muted);">(لا توجد تقييمات مسجلة بعد)</span>
								}
								if data.Org.CommercialRegister != "" {
									<span style="color:var(--border);">•</span>
									<span class="tabular-nums">السجل التجاري: <strong style="color:var(--text);">{ data.Org.CommercialRegister }</strong></span>
								}
								if data.Org.TaxNumber != "" {
									<span style="color:var(--border);">•</span>
									<span class="tabular-nums">البطاقة الضريبية: <strong style="color:var(--text);">{ data.Org.TaxNumber }</strong></span>
								}
							</div>
						</div>
					</div>

					<!-- Right Action Buttons -->
					<div style="display:flex; flex-direction:column; gap:0.5rem; min-width:220px;">
						<!-- Request Quote Modal Trigger Button -->
						<button
							type="button"
							class="btn btn-primary"
							data-modal-open={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }
							style="width:100%; justify-content:center; font-weight:700; font-size:0.875rem;"
						>
							@components.IconPlus("icon-xs")
							<span>طلب عرض أسعار خاص</span>
						</button>

						<!-- Contact Links -->
						<div style="display:flex; gap:0.5rem;">
							<a href="https://wa.me/201012345678" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="flex:1; justify-content:center; font-weight:700; color:var(--success-text);">
								@components.IconWhatsApp("icon-xs")
								<span>واتساب</span>
							</a>

							<!-- Follow / Unfollow Toggle -->
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/follow", data.Org.ID)) } class="m-0" style="flex:1;">
								if data.IsFollowing {
									<button type="submit" class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; font-weight:700; color:var(--danger-text);">
										@components.IconHeart("icon-xs")
										<span>إلغاء المتابعة</span>
									</button>
								} else {
									<button type="submit" class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; font-weight:700; color:var(--accent);">
										@components.IconHeart("icon-xs")
										<span>متابعة</span>
									</button>
								}
							</form>
						</div>
					</div>
				</div>
			</div>

			<!-- Featured Sections Quick-Access Bar (Polished & Prominent) -->
			if len(data.Sections) > 0 {
				<div class="card mb-0" style="padding:1.5rem 1.75rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); box-shadow:var(--shadow-sm);">
					<div style="display:flex; flex-direction:column; gap:1rem;">
						<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
							<div style="display:flex; align-items:center; gap:0.65rem;">
								<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.15rem;">
									✨
								</div>
								<div>
									<h2 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0;">
										نبذة وأقسام المنشأة
									</h2>
									<span style="font-size:0.775rem; color:var(--text-muted);">انقر على أي قسم لعرض التفاصيل والمعلومات الرسمية</span>
								</div>
							</div>
							<span class="badge badge-secondary" style="font-size:0.75rem; padding:0.3rem 0.75rem;">
								{ fmt.Sprintf("%d أقسام متوفرة", len(data.Sections)) }
							</span>
						</div>

						<div style="display:flex; align-items:center; gap:0.85rem; flex-wrap:wrap; margin-top:0.25rem;">
							for _, s := range data.Sections {
								if s.IsActive && s.ShowInHeader {
									<button
										type="button"
										class="supplier-section-btn"
										data-modal-open={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
										style={ fmt.Sprintf("display:inline-flex; align-items:center; gap:0.75rem; padding:0.75rem 1.35rem; min-height:48px; border-radius:var(--radius-xl); background:var(--surface-sunken); border:1.5px solid %s; color:var(--text); cursor:pointer; font-weight:800; font-size:0.95rem; box-shadow:0 2px 8px rgba(0,0,0,0.12); transition:all 0.2s cubic-bezier(0.16, 1, 0.3, 1);", s.Color) }
										onmouseover={ templ.ComponentScript{Call: fmt.Sprintf("this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px -4px %s66';", s.Color)} }
										onmouseout={ templ.ComponentScript{Call: "this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.12)';"} }
									>
										<span style={ fmt.Sprintf("width:32px; height:32px; border-radius:var(--radius-md); background:%s20; color:%s; display:flex; align-items:center; justify-content:center; font-size:1.15rem; flex-shrink:0;", s.Color, s.Color) }>
											{ sectionTypeIcon(s.SectionType) }
										</span>
										<span style="letter-spacing:-0.01em;">{ s.Title.Get(i18n.Lang(lang)) }</span>
										<span style="font-size:0.85rem; opacity:0.6; margin-inline-start:0.15rem;">←</span>
									</button>
								}
							}
						</div>
					</div>
				</div>
			}

			<!-- 2. Main Content: Product Catalog (Left) & Policies/Reviews Sidebar (Right) -->
			<div style="display:grid; grid-template-columns:1fr 340px; gap:1.5rem; align-items:start;">
				
				<!-- Left: Supplier Product Catalog -->
				<div>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
						<div>
							<h2 style="font-size:1.15rem; font-weight:800; color:var(--text); margin:0;">
								كتالوج الأدوية والأصناف المتاحة للتوريد
							</h2>
							<span style="font-size:0.8rem; color:var(--text-secondary);">الأرصدة والأسعار المحدثة من المنشأة مباشرة</span>
						</div>
						<span class="badge badge-secondary" style="font-size:0.8rem;">{ fmt.Sprintf("%d صنف معروض", len(data.Products)) }</span>
					</div>

					if len(data.Products) == 0 {
						<div class="card" style="padding:3rem 1.5rem; text-align:center; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
							@components.IconPill("icon-lg")
							<h3 style="font-size:1rem; font-weight:700; color:var(--text); margin:0.75rem 0 0.25rem 0;">لا توجد أصناف معروضة حالياً</h3>
							<p style="color:var(--text-muted); font-size:0.85rem; margin:0;">يقوم المورد بتحديث قائمة الأدوية والأسعار بانتظام.</p>
						</div>
					} else {
						<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:1rem;">
							for _, p := range data.Products {
								<div class="card" style="margin-bottom:0; padding:1rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; flex-direction:column; justify-content:space-between;">
									<div>
										<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.5rem;">
											<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
												@components.IconPill("icon-xs")
											</div>
											if p.DosageForm != "" {
												<span class="badge badge-sky" style="font-size:10px; font-weight:700;">
													{ p.DosageForm }
												</span>
											}
										</div>

										<h3 style="font-size:0.95rem; font-weight:800; margin:0 0 2px 0; color:var(--text); line-height:1.35;">
											<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } style="color:inherit; text-decoration:none;">
												if p.Name["ar"] != "" {
													{ p.Name["ar"] }
												} else {
													{ p.Name["en"] }
												}
											</a>
										</h3>
										if p.Name["en"] != "" && p.Name["en"] != p.Name["ar"] {
											<div style="font-size:0.725rem; color:var(--text-muted); margin-bottom:0.5rem;" dir="ltr">
												{ p.Name["en"] }
											</div>
										}

										<div style="font-size:1.15rem; font-weight:900; color:var(--accent); margin-bottom:0.75rem;" class="tabular-nums">
											if p.Price.IsPositive() {
												{ p.Price.String() } ج.م
											} else {
												<span style="font-size:0.8rem; color:var(--text-muted);">حسب الكمية</span>
											}
										</div>
									</div>

									<div style="border-top:1px solid var(--border); padding-top:0.75rem; display:flex; gap:0.5rem;">
										<form action="/cart/add" method="POST" style="flex:1; margin:0;">
											<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", p.ID) } />
											<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", p.ID) } />
											<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", data.Org.ID) } />
											<input type="hidden" name="quantity" value="1" />
											<button type="submit" class="btn btn-primary btn-sm" style="width:100%; justify-content:center; font-weight:700; font-size:0.8rem;">
												@components.IconCart("icon-xs")
												<span>إضافة للسلة</span>
											</button>
										</form>
										<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-secondary btn-sm btn-icon" title="عرض التفاصيل">
											@components.IconArrowLeft("icon-xs")
										</a>
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- Right: Real Policies & Reviews Sidebar -->
				<div style="display:flex; flex-direction:column; gap:1.25rem;">
					
					<!-- Commercial Terms & Policies Card -->
					<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.85rem;">
							<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconShield("icon-xs")
							</div>
							<h3 style="font-size:0.95rem; font-weight:800; color:var(--text); margin:0;">
								شروط وسياسات التوريد
							</h3>
						</div>

						if len(data.Policies) == 0 {
							<div style="padding:0.75rem; background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border); font-size:0.8rem; color:var(--text-secondary); line-height:1.6;">
								<strong style="color:var(--text); display:block; margin-bottom:0.25rem;">الشروط القياسية المعتمدة:</strong>
								تخضع طلبيات التوريد للمعايير القياسية لمنصة دواء 24، مع الالتزام بشروط حفظ وتبريد الأدوية والفواتير الضريبية المعتمدة.
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:0.6rem;">
								for _, pol := range data.Policies {
									<div style="padding:0.75rem; background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
										<strong style="color:var(--text); font-size:0.85rem; display:block; margin-bottom:0.2rem;">{ pol.Title }</strong>
										<p style="font-size:0.775rem; color:var(--text-secondary); margin:0; line-height:1.5;">{ pol.Content }</p>
									</div>
								}
							</div>
						}
					</div>

					<!-- Real Reviews Card -->
					<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.85rem;">
							<div style="display:flex; align-items:center; gap:0.5rem;">
								<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
									@components.IconUser("icon-xs")
								</div>
								<h3 style="font-size:0.95rem; font-weight:800; color:var(--text); margin:0;">
									تقييمات وتجارب الصيادلة
								</h3>
							</div>
						</div>

						if len(data.Reviews) == 0 {
							<div style="padding:1rem; text-align:center; background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
								<div style="font-weight:700; color:var(--text); font-size:0.85rem; margin-bottom:0.25rem;">مورد معتمد موثق</div>
								<p style="font-size:0.775rem; color:var(--text-muted); margin:0;">لم يتم تسجيل تقييمات بعد. عند استلام أول طلبية يمكنك تقييم الخدمة والتوريد.</p>
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:0.75rem;">
								for _, rv := range data.Reviews {
									<div style="padding:0.6rem; background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
										<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem;">
											<strong style="font-size:0.8rem; color:var(--text);">صيدلية معتمدة</strong>
											@components.RatingStars(float64(rv.Rating), 0)
										</div>
										<p style="font-size:0.775rem; color:var(--text-secondary); margin:0; line-height:1.5;">{ rv.ReviewText }</p>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>

			<!-- 3. Universal Quote Request Modal -->
			<div id={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } class="modal-overlay hidden">
				<div class="modal-card" style="max-width:520px; padding:1.5rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">
							طلب عرض سعر مخصص
						</h3>
						<button type="button" class="btn btn-secondary btn-icon" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } style="border:none;">
							@components.IconClose("icon-sm")
						</button>
					</div>

					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/quote", data.Org.ID)) } style="display:flex; flex-direction:column; gap:1rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-product" style="font-size:0.85rem; font-weight:700;">اختر الصنف الدوائي (اختياري)</label>
							<select id="q-product" name="product_id" class="form-select">
								<option value="">طلب عرض سعر عام لكافة الاحتياجات</option>
								for _, p := range data.Products {
									<option value={ fmt.Sprintf("%d", p.ID) }>
										if p.Name["ar"] != "" {
											{ p.Name["ar"] }
										} else {
											{ p.Name["en"] }
										}
									</option>
								}
							</select>
						</div>

						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-qty" style="font-size:0.85rem; font-weight:700;">الكمية التقديرية المطلوبة (عبوة) *</label>
							<input type="number" id="q-qty" name="quantity" required min="1" value="50" class="form-input tabular-nums" />
						</div>

						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-notes" style="font-size:0.85rem; font-weight:700;">ملاحظات وشروط التوريد المطلوبة</label>
							<textarea id="q-notes" name="notes" rows="3" placeholder="حدد شروط السداد المطلوبة أو مواعيد التسليم المفضلة..." class="form-textarea"></textarea>
						</div>

						<div style="display:flex; gap:0.75rem; justify-content:flex-end; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }>
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary" style="font-weight:700;">
								@components.IconCheck("icon-xs")
								<span>إرسال طلب عرض السعر</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- 4. Featured Section Modals (Centered & Polished) -->
			for _, s := range data.Sections {
				<div
					id={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
					class="modal-overlay hidden"
					style="position:fixed; inset:0; z-index:99999; display:none; align-items:center; justify-content:center; background:rgba(6, 10, 20, 0.82); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); padding:1.25rem;"
				>
					<div
						class="modal-card"
						style="width:min(94vw, 580px); background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:2rem; box-shadow:0 25px 60px -15px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.06); position:relative; overflow:hidden;"
					>
						<!-- Colored Top Accent Line -->
						<div style={ fmt.Sprintf("position:absolute; top:0; left:0; right:0; height:4px; background:%s;", s.Color) }></div>

						<!-- Header -->
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1.25rem;">
							<div style="display:flex; align-items:center; gap:0.85rem;">
								<div style={ fmt.Sprintf("width:48px; height:48px; border-radius:var(--radius-xl); background:%s20; color:%s; display:flex; align-items:center; justify-content:center; font-size:1.5rem; border:1px solid %s40; flex-shrink:0;", s.Color, s.Color, s.Color) }>
									{ sectionTypeIcon(s.SectionType) }
								</div>
								<div>
									<h3 style="font-size:1.35rem; font-weight:900; color:var(--text); margin:0; line-height:1.3;">
										{ s.Title.Get(i18n.Lang(lang)) }
									</h3>
								</div>
							</div>
							<button
								type="button"
								class="btn btn-secondary btn-icon"
								data-modal-close={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
								style="border-radius:var(--radius-full); width:38px; height:38px; min-width:38px; background:var(--surface-sunken); border:1px solid var(--border); cursor:pointer;"
								title="إغلاق النافذة"
							>
								@components.IconClose("icon-xs")
							</button>
						</div>

						<!-- Rich Content / Description -->
						<div style="font-size:1.025rem; color:var(--text); line-height:1.95; white-space:pre-line; margin-bottom:1.75rem; background:var(--surface-sunken); padding:1.5rem 1.75rem; border-radius:var(--radius-xl); border:1px solid var(--border); max-height:55vh; overflow-y:auto;">
							{ s.Description.Get(i18n.Lang(lang)) }
						</div>

						<!-- Footer Button -->
						<div style="display:flex; justify-content:flex-end;">
							<button
								type="button"
								class="btn btn-primary"
								data-modal-close={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
								style="font-weight:800; font-size:0.95rem; padding:0.65rem 2.25rem; border-radius:var(--radius-xl);"
							>
								إغلاق
							</button>
						</div>
					</div>
				</div>
			}

		</div>
	}
}
