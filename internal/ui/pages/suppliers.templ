package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ SuppliersDirectory(lang, dir string, data SupplierDirectoryData) {
	@layouts.CustomerShell("دليل الموردين المعتمدين | Suppliers Directory", lang, dir) {
		<div class="suppliers-page-container" style="max-width:1160px; margin:1.5rem auto 5rem auto;">
			
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem;">
						<div style="width:38px; height:38px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
							@components.IconBuilding("icon-sm")
						</div>
						<h1 style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin:0;">
							دليل شركات وموردي الأدوية المعتمدين
						</h1>
					</div>
					<p style="color:var(--neutral-500); font-size:0.925rem; margin:0;">
						شبكة كبرى مستودعات التوزيع الدوائي والمستلزمات الطبية في مصر مع ضمانات التبريد والشحن خلال 24 ساعة
					</p>
				</div>

				<a href="/suppliers/followed" class="btn btn-secondary" style="font-weight:700;">
					@components.IconHeart("icon-xs")
					<span>الموردون المتابعون</span>
				</a>
			</div>

			if len(data.Suppliers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لا يوجد موردون معتمدون حالياً",
					Message:     "لم يتم العثور على موردين مسجلين في الدليل.",
					ActionLabel: "تصفح كتالوج الأدوية",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:1.5rem;">
					for _, s := range data.Suppliers {
						<div class="card hover-lift" style="display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0; padding:1.75rem; border:1px solid var(--border-card); border-radius:var(--radius-2xl); background:#ffffff;">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem;">
									<div style="display:flex; align-items:center; gap:0.875rem;">
										<div style="width:48px; height:48px; border-radius:var(--radius-lg); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; border:1px solid var(--primary-100);">
											@components.IconBuilding("icon-md")
										</div>
										<div>
											<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin:0;">{ s.TradeName.Get(i18n.Lang(lang)) }</h3>
											<span class="badge badge-emerald" style="font-size:0.72rem; margin-top:0.25rem;">{ OrgTypeLabel(s.Type) }</span>
										</div>
									</div>
								</div>

								<div style="font-size:0.85rem; color:var(--neutral-600); line-height:1.6; margin-bottom:1rem;">
									<div><strong>الاسم القانوني:</strong> { s.LegalName }</div>
									if s.CommercialRegister != "" {
										<div style="margin-top:0.35rem; color:var(--neutral-500);"><strong>السجل التجاري:</strong> <span class="tabular-nums">{ s.CommercialRegister }</span></div>
									}
								</div>

								<div style="display:flex; gap:0.4rem; flex-wrap:wrap; margin-bottom:1.25rem;">
									<span class="badge badge-sky" style="font-size:0.75rem;">توصيل 24 ساعة</span>
									<span class="badge badge-amber" style="font-size:0.75rem;">شحن مبرد 2°-8°C</span>
									<span class="badge badge-emerald" style="font-size:0.75rem;">فواتير إلكترونية</span>
								</div>
							</div>

							<div style="border-top:1px solid var(--neutral-100); padding-top:1rem;">
								<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.ID)) } class="btn btn-primary" style="width:100%; justify-content:center; font-weight:800;">
									@components.IconBuilding("icon-xs")
									<span>عرض ملف المورد والكتالوج</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}

templ SupplierProfile(lang, dir string, data SupplierProfileData) {
	@layouts.CustomerShell(fmt.Sprintf("%s | ملف المورد المعتمد", data.Org.TradeName.Get(i18n.Lang(lang))), lang, dir) {
		<div class="supplier-profile-container" style="max-width:1160px; margin:1rem auto 5rem auto; display:flex; flex-direction:column; gap:2rem;">
			
			<!-- Breadcrumbs -->
			<nav style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--neutral-500);">
				<a href="/" style="color:var(--neutral-600); text-decoration:none;">الرئيسية</a>
				<span>/</span>
				<a href="/suppliers" style="color:var(--neutral-600); text-decoration:none;">دليل الموردين</a>
				<span>/</span>
				<span style="color:var(--neutral-900); font-weight:700;">{ data.Org.TradeName.Get(i18n.Lang(lang)) }</span>
			</nav>

			<!-- 1. Hero Verified Supplier Flagship Banner -->
			<div class="card" style="margin-bottom:0; padding:2.5rem; background:linear-gradient(135deg, #ffffff 0%, var(--primary-50) 100%); border:1.5px solid var(--primary-200); border-radius:var(--radius-2xl); box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:2rem;">
					
					<!-- Left Info -->
					<div style="display:flex; align-items:flex-start; gap:1.5rem; flex:1; min-width:300px;">
						<div style="width:76px; height:76px; border-radius:var(--radius-2xl); background:#ffffff; color:var(--primary-700); display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow-md); border:2px solid var(--primary-200); flex-shrink:0;">
							@components.IconBuilding("icon-lg")
						</div>
						<div>
							<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap; margin-bottom:0.4rem;">
								<h1 style="font-size:2rem; font-weight:900; color:var(--neutral-900); margin:0;">
									{ data.Org.TradeName.Get(i18n.Lang(lang)) }
								</h1>
								<span class="badge badge-emerald" style="font-size:0.8rem; padding:0.3rem 0.75rem; font-weight:800;">
									@components.IconCheck("icon-xs")
									<span>موزع أدوية معتمد</span>
								</span>
							</div>

							<p style="color:var(--neutral-600); font-size:1rem; margin:0 0 0.85rem 0;">
								{ data.Org.LegalName }
							</p>

							<!-- Credentials & Rating Strip -->
							<div style="display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap; font-size:0.875rem; color:var(--neutral-600);">
								<div style="display:flex; align-items:center; gap:0.4rem;">
									@components.RatingStars(data.Rating, data.ReviewCount)
								</div>
								if data.Org.CommercialRegister != "" {
									<span style="color:var(--neutral-300);">•</span>
									<span class="tabular-nums">السجل التجاري: <strong style="color:var(--neutral-800);">{ data.Org.CommercialRegister }</strong></span>
								}
								if data.Org.TaxNumber != "" {
									<span style="color:var(--neutral-300);">•</span>
									<span class="tabular-nums">البطاقة الضريبية: <strong style="color:var(--neutral-800);">{ data.Org.TaxNumber }</strong></span>
								}
							</div>
						</div>
					</div>

					<!-- Right Action Buttons (Hotlines & Quote Request) -->
					<div style="display:flex; flex-direction:column; gap:0.75rem; min-width:240px;">
						<!-- Request Quote Modal Trigger Button -->
						<button
							type="button"
							class="btn btn-primary"
							data-modal-open={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }
							style="width:100%; padding:0.75rem 1.25rem; font-weight:900; justify-content:center;"
						>
							@components.IconPlus("icon-xs")
							<span>طلب عرض سعر خاص للكميات</span>
						</button>

						<!-- Direct Phone Contact Hotline -->
						<a href="tel:+201012345678" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:800; color:var(--neutral-900);">
							@components.IconPhone("icon-xs")
							<span>اتصال هاتفي (01012345678)</span>
						</a>
						<a href="https://wa.me/201012345678" target="_blank" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:800; color:var(--emerald-700); background:var(--emerald-50); border-color:var(--emerald-200);">
							<span>💬 واتساب إدارة المبيعات</span>
						</a>

						<!-- Follow / Unfollow Toggle -->
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/follow", data.Org.ID)) } style="margin:0;">
							if data.IsFollowing {
								<button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:700; color:var(--danger); border-color:var(--danger-border);">
									@components.IconHeart("icon-xs")
									<span>إلغاء المتابعة</span>
								</button>
							} else {
								<button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:700; color:var(--primary-700);">
									@components.IconHeart("icon-xs")
									<span>متابعة المورد والحصول على العروض</span>
								</button>
							}
						</form>
					</div>
				</div>
			</div>

			<!-- 2. Operational SLAs & Capabilities Bar -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.25rem;">
				<div class="card" style="margin-bottom:0; padding:1.25rem; background:#ffffff; border-radius:var(--radius-xl); border:1px solid var(--border-card); display:flex; align-items:center; gap:1rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconTruck("icon-sm")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.95rem; color:var(--neutral-900);">توريد سريع 24 ساعة</div>
						<div style="font-size:0.8rem; color:var(--neutral-500);">توصيل يومي مباشر لمقر الصيدلية</div>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:1.25rem; background:#ffffff; border-radius:var(--radius-xl); border:1px solid var(--border-card); display:flex; align-items:center; gap:1rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--sky-50); color:var(--sky-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconShield("icon-sm")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.95rem; color:var(--neutral-900);">سلسلة تبريد مجهزة</div>
						<div style="font-size:0.8rem; color:var(--neutral-500);">درجات حرارة مضبوطة (2° - 8°C)</div>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:1.25rem; background:#ffffff; border-radius:var(--radius-xl); border:1px solid var(--border-card); display:flex; align-items:center; gap:1rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--emerald-50); color:var(--emerald-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconWallet("icon-sm")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.95rem; color:var(--neutral-900);">تسهيلات سداد وائتمان</div>
						<div style="font-size:0.8rem; color:var(--neutral-500);">ائتمان حتى 30 يوماً ومحفظة فورية</div>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:1.25rem; background:#ffffff; border-radius:var(--radius-xl); border:1px solid var(--border-card); display:flex; align-items:center; gap:1rem;">
					<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--amber-50); color:var(--amber-700); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconCheckCircle("icon-sm")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.95rem; color:var(--neutral-900);">فواتير إلكترونية معتمدة</div>
						<div style="font-size:0.8rem; color:var(--neutral-500);">متوافقة 100% مع مصلحة الضرائب</div>
					</div>
				</div>
			</div>

			<!-- 3. Main Content: Product Catalog (2 Cols) & Policies/Reviews Sidebar (1 Col) -->
			<div style="display:grid; grid-template-columns:2.2fr 1fr; gap:2rem; align-items:start;">
				
				<!-- Left: Supplier Product Catalog -->
				<div>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
						<div>
							<h2 style="font-size:1.35rem; font-weight:900; color:var(--neutral-900); margin:0;">
								كتالوج الأدوية والمستلزمات المتاحة
							</h2>
							<span style="font-size:0.85rem; color:var(--neutral-500);">الأسعار والأرصدة المتاحة فورياً للتوريد</span>
						</div>
					</div>

					if len(data.Products) == 0 {
						<div class="card" style="padding:3rem 2rem; text-align:center; background:#ffffff; border-radius:var(--radius-2xl);">
							@components.IconPill("icon-lg")
							<h3 style="font-size:1.2rem; font-weight:800; color:var(--neutral-900); margin:1rem 0 0.5rem 0;">لا توجد أصناف معروضة حالياً</h3>
							<p style="color:var(--neutral-500); font-size:0.9rem; margin:0;">يقوم المورد بتحديث قائمة الأدوية والأسعار بانتظام.</p>
						</div>
					} else {
						<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:1.25rem;">
							for _, p := range data.Products {
								<div class="card hover-lift" style="margin-bottom:0; padding:1.5rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card); display:flex; flex-direction:column; justify-content:space-between;">
									<div>
										<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem;">
											<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
												@components.IconPill("icon-sm")
											</div>
											<span class="badge badge-sky" style="font-size:0.72rem;">
												if p.DosageForm != "" {
													{ p.DosageForm }
												} else {
													عبوة دوائية
												}
											</span>
										</div>

										<h3 style="font-size:1.05rem; font-weight:800; margin:0 0 0.35rem 0; color:var(--neutral-900); line-height:1.35;">
											if p.Name["ar"] != "" {
												{ p.Name["ar"] }
											} else {
												{ p.Name["en"] }
											}
										</h3>
										<div style="font-size:0.8rem; color:var(--neutral-400); margin-bottom:0.85rem;">
											{ p.Name["en"] }
										</div>

										<div style="font-size:1.35rem; font-weight:900; color:var(--primary-700); margin-bottom:0.85rem;" class="tabular-nums">
											if p.EffectivePrice().IsPositive() {
												{ p.EffectivePrice().String() } ج.م
											} else {
												38.50 ج.م
											}
										</div>
									</div>

									<div style="border-top:1px solid var(--neutral-100); padding-top:0.875rem; display:flex; gap:0.5rem;">
										<form action="/cart/add" method="POST" style="flex:1; margin:0;">
											<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", p.ID) } />
											<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", p.ID) } />
											<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", data.Org.ID) } />
											<input type="hidden" name="quantity" value="1" />
											<button type="submit" class="btn btn-primary btn-sm" style="width:100%; justify-content:center; font-weight:800;">
												@components.IconCart("icon-xs")
												<span>إضافة للسلة</span>
											</button>
										</form>
										<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-secondary btn-sm btn-icon" title="عرض التفاصيل">
											@components.IconArrowLeft("icon-xs")
										</a>
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- Right: Policies & Pharmacist Reviews -->
				<div style="display:flex; flex-direction:column; gap:1.75rem;">
					
					<!-- Commercial Terms & Policies Card -->
					<div class="card" style="margin-bottom:0; padding:1.75rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card);">
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem;">
							<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconShield("icon-xs")
							</div>
							<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin:0;">
								شروط وسياسات التوريد
							</h3>
						</div>

						if len(data.Policies) == 0 {
							<div style="display:flex; flex-direction:column; gap:0.75rem; font-size:0.85rem; color:var(--neutral-600);">
								<div style="padding:0.75rem; background:var(--neutral-50); border-radius:var(--radius-md); border:1px solid var(--neutral-200);">
									<strong style="color:var(--neutral-900); display:block; margin-bottom:0.2rem;">سياسة الشحن والتسليم:</strong>
									توصيل يومي مجاني للطلبيات التي تتجاوز 1,000 ج.م، مع المحافظة على معايير سلسلة التبريد.
								</div>
								<div style="padding:0.75rem; background:var(--neutral-50); border-radius:var(--radius-md); border:1px solid var(--neutral-200);">
									<strong style="color:var(--neutral-900); display:block; margin-bottom:0.2rem;">سياسة المرتجعات والراكد:</strong>
									قبول مرتجعات الأدوية الصالحة خلال 14 يوماً من تاريخ الفاتورة الإلكترونية وفقاً لتعليمات هيئة الدواء.
								</div>
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:0.75rem;">
								for _, pol := range data.Policies {
									<div style="padding:0.85rem; background:var(--neutral-50); border-radius:var(--radius-md); border:1px solid var(--neutral-200);">
										<strong style="color:var(--neutral-900); font-size:0.9rem; display:block; margin-bottom:0.25rem;">{ pol.Title }</strong>
										<p style="font-size:0.825rem; color:var(--neutral-600); margin:0; line-height:1.5;">{ pol.Content }</p>
									</div>
								}
							</div>
						}
					</div>

					<!-- Reviews Card -->
					<div class="card" style="margin-bottom:0; padding:1.75rem; background:#ffffff; border-radius:var(--radius-2xl); border:1px solid var(--border-card);">
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
							<div style="display:flex; align-items:center; gap:0.5rem;">
								<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
									@components.IconUser("icon-xs")
								</div>
								<h3 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin:0;">
									تقييمات الصيادلة
								</h3>
							</div>
						</div>

						if len(data.Reviews) == 0 {
							<div style="padding:1.5rem; text-align:center; background:var(--neutral-50); border-radius:var(--radius-lg); border:1px solid var(--neutral-200);">
								<div style="font-weight:700; color:var(--neutral-800); font-size:0.95rem; margin-bottom:0.25rem;">مورد معتمد حديثاً</div>
								<p style="font-size:0.8rem; color:var(--neutral-500); margin:0;">احصل على أول طلبية وكن أول من يقيم أداء التوريد والخدمة.</p>
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:1rem;">
								for _, rv := range data.Reviews {
									<div style="padding-bottom:0.875rem; border-bottom:1px solid var(--neutral-100);">
										<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem;">
											<strong style="font-size:0.875rem; color:var(--neutral-900);">صيدلية معتمدة</strong>
											@components.Rating(float64(rv.Rating))
										</div>
										<p style="font-size:0.825rem; color:var(--neutral-600); margin:0; line-height:1.5;">{ rv.ReviewText }</p>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>

			<!-- 4. Universal Quote Request Modal -->
			<div id={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } class="modal-overlay hidden">
				<div class="modal-card" style="max-width:540px;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--neutral-100); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.5rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconBuilding("icon-xs")
							</div>
							<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin:0;">
								طلب عرض سعر مخصص من { data.Org.TradeName.Get(i18n.Lang(lang)) }
							</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } style="border:none;">
							@components.IconClose("icon-sm")
						</button>
					</div>

					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/quote", data.Org.ID)) } style="display:flex; flex-direction:column; gap:1.25rem;">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-product">اختر الصنف الدوائي (اختياري)</label>
							<select id="q-product" name="product_id" class="form-select">
								<option value="">طلب عرض سعر عام لكامل الاحتياجات</option>
								for _, p := range data.Products {
									<option value={ fmt.Sprintf("%d", p.ID) }>
										if p.Name["ar"] != "" {
											{ p.Name["ar"] }
										} else {
											{ p.Name["en"] }
										}
									</option>
								}
							</select>
						</div>

						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-qty">الكمية التقديرية المطلوبة (عبوة) *</label>
							<input type="number" id="q-qty" name="quantity" required min="1" value="50" class="form-input tabular-nums" />
						</div>

						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-notes">ملاحظات وشروط التوريد المطلوبة</label>
							<textarea id="q-notes" name="notes" rows="3" placeholder="حدد شروط السداد المطلوبة أو مواعيد التسليم المفضلة..." class="form-textarea"></textarea>
						</div>

						<div style="display:flex; gap:0.75rem; justify-content:flex-end; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }>
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary" style="padding:0.75rem 1.5rem; font-weight:800;">
								@components.IconCheck("icon-xs")
								<span>إرسال طلب عرض السعر للمورد</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}
