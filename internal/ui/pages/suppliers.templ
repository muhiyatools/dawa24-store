package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ SuppliersDirectory(lang, dir string, data SupplierDirectoryData) {
	if actor, ok := authctx.From(ctx); ok && (actor.Role == "pharmacy" || actor.Role == "chain_pharmacy") {
		@layouts.PharmacyShell("دليل الموردين المعتمدين | Suppliers Directory", "suppliers", lang, dir, nil) {
			@SuppliersDirectoryContent(lang, dir, data)
		}
	} else {
		@layouts.CustomerShell("دليل الموردين المعتمدين | Suppliers Directory", lang, dir) {
			@SuppliersDirectoryContent(lang, dir, data)
		}
	}
}

templ SuppliersDirectoryContent(lang, dir string, data SupplierDirectoryData) {

		<div class="suppliers-page-container" style="max-width:1160px; margin:1.5rem auto 5rem auto;">
			
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:var(--space-4); margin-bottom:var(--space-8);">
				<div>
					<div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-1);">
						<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
							@components.IconBuilding("icon-sm")
						</div>
						<h1 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin:0;">
							دليل شركات وموردي الأدوية المعتمدين
						</h1>
					</div>
					<p style="color:var(--text-muted); font-size:var(--text-sm); margin:0;">
						شبكة مستودعات التوزيع الدوائي والمستلزمات الطبية في مصر مع ضمانات التبريد والشحن المعتمد
					</p>
				</div>

				<a href="/suppliers/followed" class="btn btn-secondary" style="font-weight:600;">
					@components.IconHeart("icon-xs")
					<span>الموردون المتابعون</span>
				</a>
			</div>

			if len(data.Suppliers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لا يوجد موردون معتمدون حالياً",
					Message:     "لم يتم العثور على موردين مسجلين في الدليل.",
					ActionLabel: "تصفح كتالوج الأدوية",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:var(--space-6);">
					for _, s := range data.Suppliers {
						<div class="card" style="display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0; padding:var(--space-6); border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-raised);">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:var(--space-4);">
									<div style="display:flex; align-items:center; gap:var(--space-3);">
										<div style="width:44px; height:44px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; border:1px solid var(--border);">
											@components.IconBuilding("icon-md")
										</div>
										<div>
											<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin:0;">{ s.TradeName.Get(i18n.Lang(lang)) }</h3>
											<span class="badge badge-emerald" style="font-size:var(--text-xs); margin-top:2px;">{ OrgTypeLabel(s.Type) }</span>
										</div>
									</div>
								</div>

								<div style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.6; margin-bottom:var(--space-4);">
									<div><strong>الاسم القانوني:</strong> { s.LegalName }</div>
									if s.CommercialRegister != "" {
										<div style="margin-top:2px; color:var(--text-muted);"><strong>السجل التجاري:</strong> <span class="tabular-nums">{ s.CommercialRegister }</span></div>
									}
								</div>

								<div style="display:flex; gap:var(--space-1); flex-wrap:wrap; margin-bottom:var(--space-4);">
									<span class="badge badge-sky">توصيل 24 ساعة</span>
									<span class="badge badge-amber">شحن مبرد</span>
									<span class="badge badge-emerald">فواتير إلكترونية</span>
								</div>
							</div>

							<div style="border-top:1px solid var(--border); padding-top:var(--space-4);">
								<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.ID)) } class="btn btn-primary" style="width:100%; justify-content:center; font-weight:600;">
									@components.IconBuilding("icon-xs")
									<span>عرض ملف المورد والكتالوج</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
}


templ SupplierProfile(lang, dir string, data SupplierProfileData) {
	@layouts.CustomerShell(fmt.Sprintf("%s | ملف المورد المعتمد", data.Org.TradeName.Get(i18n.Lang(lang))), lang, dir) {
		<div class="supplier-profile-container" style="max-width:1160px; margin:1rem auto 5rem auto; display:flex; flex-direction:column; gap:var(--space-6);">
			
			<!-- Breadcrumbs -->
			<nav style="display:flex; align-items:center; gap:var(--space-2); font-size:var(--text-sm); color:var(--text-muted);">
				<a href="/" style="color:var(--text-secondary); text-decoration:none;">الرئيسية</a>
				<span>/</span>
				<a href="/suppliers" style="color:var(--text-secondary); text-decoration:none;">دليل الموردين</a>
				<span>/</span>
				<span style="color:var(--text); font-weight:600;">{ data.Org.TradeName.Get(i18n.Lang(lang)) }</span>
			</nav>

			<!-- 1. Hero Verified Supplier Flagship Banner -->
			<div class="card" style="margin-bottom:0; padding:var(--space-8); background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg);">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:var(--space-6);">
					
					<!-- Left Info -->
					<div style="display:flex; align-items:flex-start; gap:var(--space-4); flex:1; min-width:280px;">
						<div style="width:68px; height:68px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; border:1px solid var(--border); flex-shrink:0;">
							@components.IconBuilding("icon-xl")
						</div>
						<div>
							<div style="display:flex; align-items:center; gap:var(--space-2); flex-wrap:wrap; margin-bottom:var(--space-1);">
								<h1 style="font-size:var(--text-2xl); font-weight:700; color:var(--text); margin:0;">
									{ data.Org.TradeName.Get(i18n.Lang(lang)) }
								</h1>
								<span class="badge badge-emerald" style="font-weight:600;">
									@components.IconCheckCircle("icon-xs")
									<span>موزع أدوية معتمد</span>
								</span>
							</div>

							<p style="color:var(--text-secondary); font-size:var(--text-sm); margin:0 0 var(--space-3) 0;">
								{ data.Org.LegalName }
							</p>

							<!-- Credentials & Rating Strip -->
							<div style="display:flex; align-items:center; gap:var(--space-4); flex-wrap:wrap; font-size:var(--text-sm); color:var(--text-secondary);">
								<div style="display:flex; align-items:center; gap:var(--space-1);">
									@components.RatingStars(data.Rating, data.ReviewCount)
								</div>
								if data.Org.CommercialRegister != "" {
									<span style="color:var(--border-strong);">•</span>
									<span class="tabular-nums">السجل التجاري: <strong style="color:var(--text);">{ data.Org.CommercialRegister }</strong></span>
								}
								if data.Org.TaxNumber != "" {
									<span style="color:var(--border-strong);">•</span>
									<span class="tabular-nums">البطاقة الضريبية: <strong style="color:var(--text);">{ data.Org.TaxNumber }</strong></span>
								}
							</div>
						</div>
					</div>

					<!-- Right Action Buttons -->
					<div style="display:flex; flex-direction:column; gap:var(--space-2); min-width:220px;">
						<!-- Request Quote Modal Trigger Button -->
						<button
							type="button"
							class="btn btn-primary"
							data-modal-open={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }
							style="width:100%; justify-content:center; font-weight:600;"
						>
							@components.IconPlus("icon-xs")
							<span>طلب عرض سعر خاص</span>
						</button>

						<!-- Direct Phone Contact Hotline -->
						<a href="tel:+201012345678" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:600;">
							@components.IconPhone("icon-xs")
							<span>اتصال هاتفي (01012345678)</span>
						</a>
						<a href="https://wa.me/201012345678" target="_blank" rel="noopener" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:600; color:var(--success-text); background:var(--success-surface); border-color:var(--success-border);">
							@components.IconWhatsApp("icon-xs")
							<span>واتساب إدارة المبيعات</span>
						</a>

						<!-- Follow / Unfollow Toggle -->
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/follow", data.Org.ID)) } style="margin:0;">
							if data.IsFollowing {
								<button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:600; color:var(--danger-text); border-color:var(--danger-border);">
									@components.IconHeart("icon-xs")
									<span>إلغاء المتابعة</span>
								</button>
							} else {
								<button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:600; color:var(--accent);">
									@components.IconHeart("icon-xs")
									<span>متابعة المورد</span>
								</button>
							}
						</form>
					</div>
				</div>
			</div>

			<!-- 2. Operational Capabilities Bar -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:var(--space-4);">
				<div class="card" style="margin-bottom:0; padding:var(--space-4); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; align-items:center; gap:var(--space-3);">
					<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconTruck("icon-sm")
					</div>
					<div>
						<div style="font-weight:600; font-size:var(--text-sm); color:var(--text);">توريد سريع 24 ساعة</div>
						<div style="font-size:var(--text-xs); color:var(--text-muted);">توصيل مباشر لمقر الصيدلية</div>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:var(--space-4); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; align-items:center; gap:var(--space-3);">
					<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--info-surface); color:var(--info-text); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconShield("icon-sm")
					</div>
					<div>
						<div style="font-weight:600; font-size:var(--text-sm); color:var(--text);">سلسلة تبريد مجهزة</div>
						<div style="font-size:var(--text-xs); color:var(--text-muted);">درجات حرارة مضبوطة (2° - 8°C)</div>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:var(--space-4); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; align-items:center; gap:var(--space-3);">
					<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--success-surface); color:var(--success-text); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconWallet("icon-sm")
					</div>
					<div>
						<div style="font-weight:600; font-size:var(--text-sm); color:var(--text);">تسهيلات سداد وائتمان</div>
						<div style="font-size:var(--text-xs); color:var(--text-muted);">ائتمان ومحفظة فورية</div>
					</div>
				</div>

				<div class="card" style="margin-bottom:0; padding:var(--space-4); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; align-items:center; gap:var(--space-3);">
					<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--warning-surface); color:var(--warning-text); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
						@components.IconCheckCircle("icon-sm")
					</div>
					<div>
						<div style="font-weight:600; font-size:var(--text-sm); color:var(--text);">فواتير إلكترونية معتمدة</div>
						<div style="font-size:var(--text-xs); color:var(--text-muted);">متوافقة مع الضرائب المصرية</div>
					</div>
				</div>
			</div>

			<!-- 3. Main Content: Product Catalog (2 Cols) & Policies Sidebar (1 Col) -->
			<div style="display:grid; grid-template-columns:2.2fr 1fr; gap:var(--space-6); align-items:start;">
				
				<!-- Left: Supplier Product Catalog -->
				<div>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-4); flex-wrap:wrap; gap:var(--space-2);">
						<div>
							<h2 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">
								كتالوج الأدوية والمستلزمات المتاحة
							</h2>
							<span style="font-size:var(--text-xs); color:var(--text-muted);">الأسعار والأرصدة المتاحة فورياً للتوريد</span>
						</div>
					</div>

					if len(data.Products) == 0 {
						<div class="card" style="padding:var(--space-10); text-align:center; background:var(--surface-raised); border-radius:var(--radius-lg);">
							@components.IconPill("icon-lg")
							<h3 style="font-size:var(--text-base); font-weight:600; color:var(--text); margin:var(--space-3) 0 var(--space-1) 0;">لا توجد أصناف معروضة حالياً</h3>
							<p style="color:var(--text-muted); font-size:var(--text-sm); margin:0;">يقوم المورد بتحديث قائمة الأدوية والأسعار بانتظام.</p>
						</div>
					} else {
						<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:var(--space-4);">
							for _, p := range data.Products {
								<div class="card" style="margin-bottom:0; padding:var(--space-5); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border); display:flex; flex-direction:column; justify-content:space-between;">
									<div>
										<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:var(--space-2);">
											<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
												@components.IconPill("icon-sm")
											</div>
											<span class="badge badge-sky" style="font-size:10px;">
												if p.DosageForm != "" {
													{ p.DosageForm }
												} else {
													عبوة دوائية
												}
											</span>
										</div>

										<h3 style="font-size:var(--text-sm); font-weight:600; margin:0 0 2px 0; color:var(--text); line-height:1.35;">
											if p.Name["ar"] != "" {
												{ p.Name["ar"] }
											} else {
												{ p.Name["en"] }
											}
										</h3>
										<div style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--space-2);">
											{ p.Name["en"] }
										</div>

										<div style="font-size:var(--text-lg); font-weight:700; color:var(--accent); margin-bottom:var(--space-3);" class="tabular-nums">
											if p.EffectivePrice().IsPositive() {
												{ p.EffectivePrice().String() } ج.م
											} else {
												38.50 ج.م
											}
										</div>
									</div>

									<div style="border-top:1px solid var(--border); padding-top:var(--space-3); display:flex; gap:var(--space-2);">
										<form action="/cart/add" method="POST" style="flex:1; margin:0;">
											<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", p.ID) } />
											<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", p.ID) } />
											<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", data.Org.ID) } />
											<input type="hidden" name="quantity" value="1" />
											<button type="submit" class="btn btn-primary btn-sm" style="width:100%; justify-content:center; font-weight:600;">
												@components.IconCart("icon-xs")
												<span>إضافة للسلة</span>
											</button>
										</form>
										<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-secondary btn-sm btn-icon" title="عرض التفاصيل">
											@components.IconArrowLeft("icon-xs")
										</a>
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- Right: Policies & Pharmacist Reviews -->
				<div style="display:flex; flex-direction:column; gap:var(--space-6);">
					
					<!-- Commercial Terms & Policies Card -->
					<div class="card" style="margin-bottom:0; padding:var(--space-6); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-3);">
							<div style="width:30px; height:30px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconShield("icon-xs")
							</div>
							<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin:0;">
								شروط وسياسات التوريد
							</h3>
						</div>

						if len(data.Policies) == 0 {
							<div style="display:flex; flex-direction:column; gap:var(--space-3); font-size:var(--text-sm); color:var(--text-secondary);">
								<div style="padding:var(--space-3); background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
									<strong style="color:var(--text); display:block; margin-bottom:2px;">سياسة الشحن والتسليم:</strong>
									توصيل يومي مجاني للطلبيات التي تتجاوز 1,000 ج.م، مع المحافظة على معايير سلسلة التبريد.
								</div>
								<div style="padding:var(--space-3); background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
									<strong style="color:var(--text); display:block; margin-bottom:2px;">سياسة المرتجعات والراكد:</strong>
									قبول مرتجعات الأدوية الصالحة خلال 14 يوماً من تاريخ الفاتورة الإلكترونية وفقاً لتعليمات هيئة الدواء.
								</div>
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:var(--space-3);">
								for _, pol := range data.Policies {
									<div style="padding:var(--space-3); background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
										<strong style="color:var(--text); font-size:var(--text-sm); display:block; margin-bottom:2px;">{ pol.Title }</strong>
										<p style="font-size:var(--text-xs); color:var(--text-secondary); margin:0; line-height:1.5;">{ pol.Content }</p>
									</div>
								}
							</div>
						}
					</div>

					<!-- Reviews Card -->
					<div class="card" style="margin-bottom:0; padding:var(--space-6); background:var(--surface-raised); border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-3);">
							<div style="display:flex; align-items:center; gap:var(--space-2);">
								<div style="width:30px; height:30px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
									@components.IconUser("icon-xs")
								</div>
								<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin:0;">
									تقييمات الصيادلة
								</h3>
							</div>
						</div>

						if len(data.Reviews) == 0 {
							<div style="padding:var(--space-4); text-align:center; background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
								<div style="font-weight:600; color:var(--text); font-size:var(--text-sm); margin-bottom:2px;">مورد معتمد حديثاً</div>
								<p style="font-size:var(--text-xs); color:var(--text-muted); margin:0;">احصل على أول طلبية وكن أول من يقيم أداء التوريد والخدمة.</p>
							</div>
						} else {
							<div style="display:flex; flex-direction:column; gap:var(--space-3);">
								for _, rv := range data.Reviews {
									<div style="padding-bottom:var(--space-2); border-bottom:1px solid var(--border);">
										<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
											<strong style="font-size:var(--text-xs); color:var(--text);">صيدلية معتمدة</strong>
											@components.RatingStars(float64(rv.Rating), 0)
										</div>
										<p style="font-size:var(--text-xs); color:var(--text-secondary); margin:0; line-height:1.5;">{ rv.ReviewText }</p>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>

			<!-- 4. Universal Quote Request Modal -->
			<div id={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } class="modal-overlay hidden">
				<div class="modal-card" style="max-width:540px;">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-4); border-bottom:1px solid var(--border); padding-bottom:var(--space-3);">
						<div style="display:flex; align-items:center; gap:var(--space-2);">
							<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconBuilding("icon-xs")
							</div>
							<h3 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin:0;">
								طلب عرض سعر مخصص من { data.Org.TradeName.Get(i18n.Lang(lang)) }
							</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } style="border:none;">
							@components.IconClose("icon-sm")
						</button>
					</div>

					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/quote", data.Org.ID)) } style="display:flex; flex-direction:column; gap:var(--space-4);">
						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-product">اختر الصنف الدوائي (اختياري)</label>
							<select id="q-product" name="product_id" class="form-select">
								<option value="">طلب عرض سعر عام لكامل الاحتياجات</option>
								for _, p := range data.Products {
									<option value={ fmt.Sprintf("%d", p.ID) }>
										if p.Name["ar"] != "" {
											{ p.Name["ar"] }
										} else {
											{ p.Name["en"] }
										}
									</option>
								}
							</select>
						</div>

						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-qty">الكمية التقديرية المطلوبة (عبوة) *</label>
							<input type="number" id="q-qty" name="quantity" required min="1" value="50" class="form-input tabular-nums" />
						</div>

						<div class="form-group" style="margin-bottom:0;">
							<label class="form-label" for="q-notes">ملاحظات وشروط التوريد المطلوبة</label>
							<textarea id="q-notes" name="notes" rows="3" placeholder="حدد شروط السداد المطلوبة أو مواعيد التسليم المفضلة..." class="form-textarea"></textarea>
						</div>

						<div style="display:flex; gap:var(--space-3); justify-content:flex-end; margin-top:var(--space-2);">
							<button type="button" class="btn btn-secondary" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }>
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary" style="font-weight:600;">
								@components.IconCheck("icon-xs")
								<span>إرسال طلب عرض السعر</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}
