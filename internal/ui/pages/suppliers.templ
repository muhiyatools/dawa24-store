package pages

import (
	"fmt"
	"strings"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ SuppliersDirectory(lang, dir string, data SupplierDirectoryData) {
	if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
		@layouts.CustomerShell("دليل الموردين المعتمدين | Suppliers Directory", "suppliers", lang, dir, nil) {
			@SuppliersDirectoryContent(lang, dir, data)
		}
	} else {
		@layouts.PublicShell("دليل الموردين المعتمدين | Suppliers Directory", lang, dir) {
			@SuppliersDirectoryContent(lang, dir, data)
		}
	}
}

templ SuppliersDirectoryContent(lang, dir string, data SupplierDirectoryData) {
	<!-- Leaflet is served from this application and loaded on demand by
	     app.js (ensureLeaflet). It was previously fetched from unpkg here and
	     again from the document head on every page in the platform. -->
	
	<style>
		@keyframes supplier-pulse-ring {
			0% {
				transform: scale(0.85);
				opacity: 0.9;
			}
			70% {
				transform: scale(1.6);
				opacity: 0;
			}
			100% {
				transform: scale(1.8);
				opacity: 0;
			}
		}
		.supplier-active-pin-container {
			z-index: 10000 !important;
		}
	</style>

	<div class="page-container">
		
		<!-- Top Banner & Header -->
		<div class="glass-panel p-6 mb-6">
			<div class="flex-between items-center flex-wrap gap-4">
				<div>
					<div class="d-flex items-center gap-3 mb-1">
						<div class="user-avatar-badge text-xl">
							@components.IconBuilding("icon-sm")
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							دليل شركات ومخازن التوزيع الدوائي
						</h1>
						<span class="badge badge-primary text-xs font-bold tabular-nums">
							{ fmt.Sprintf("%d مورد معتمد", len(data.Suppliers)) }
						</span>
					</div>
					<p class="text-sm text-secondary m-0">
						مواعيد العمل اللحظية، نطاقات التغطية الجغرافية، والطلب المباشر لصيدليتك مع ضمان سلسلة التبريد الدوائي
					</p>
				</div>

				<div class="d-flex items-center gap-2 flex-wrap">
					<a href="/suppliers/followed" class="btn btn-secondary btn-sm font-bold gap-1">
						@components.IconHeart("icon-xs")
						<span>الموردون المتابعون</span>
					</a>
				</div>
			</div>
		</div>

		<!-- Control Toolbar: Search, Filters & View Toggle -->
		<div class="glass-panel p-4 mb-6 flex-between items-center flex-wrap gap-4">
			
			<!-- Search Form -->
			<form method="GET" action="/suppliers" class="d-flex gap-2 flex-1" style="min-width:280px; max-width:540px;">
				<div class="position-relative flex-1">
					<input
						type="text"
						name="q"
						value={ data.Query }
						placeholder="ابحث باسم شركة الأدوية، الموزع، أو المدينة المغطاة..."
						class="form-input text-xs w-full"
					/>
				</div>
				<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-3">
					<span>بحث</span>
				</button>
				if data.Query != "" {
					<a href="/suppliers" class="btn btn-secondary btn-sm text-xs">
						<span>إلغاء</span>
					</a>
				}
			</form>

			<!-- View Switcher (List View vs Map View) -->
			<div class="cb-tabs-nav m-0">
				<button
					type="button"
					id="view-toggle-list"
					onclick="switchSupplierView('list')"
					class={ "cb-tab-btn", templ.KV("active", data.ActiveTab != "map") }
				>
					@components.IconBuilding("icon-xs")
					<span>عرض القائمة</span>
				</button>
				<button
					type="button"
					id="view-toggle-map"
					onclick="switchSupplierView('map')"
					class={ "cb-tab-btn", templ.KV("active", data.ActiveTab == "map") }
				>
					@components.IconLocation("icon-xs")
					<span>عرض الخريطة</span>
				</button>
			</div>
		</div>

		<!-- View 1: List / Grid View -->
		<div id="suppliers-list-view" style={ templ.KV("display:none;", data.ActiveTab == "map") }>
			if len(data.Suppliers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لا يوجد موردون مطابقون للبحث",
					Message:     "لم يتم العثور على شركات أو مخازن أدوية مطابقة لمعايير البحث الحالية.",
					ActionLabel: "عرض كافة الموردين",
					ActionURL:   "/suppliers",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(360px, 1fr)); gap:1.25rem;">
					for _, s := range data.Suppliers {
						<div class="glass-panel p-6 mb-0 d-flex flex-col justify-between">
							<div>
								<!-- Header Strip: Logo, Name, Verified & Status Badge -->
								<div class="flex-between items-start mb-4 gap-3">
									<div class="d-flex items-center gap-3">
										<div class="user-avatar-badge text-lg">
											@components.IconBuilding("icon-sm")
										</div>
										<div>
											<h3 class="text-base font-extrabold text-primary m-0 leading-tight">
												<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.Org.ID)) } class="text-primary text-decoration-none">
													if s.Org.TradeName.Get(i18n.Lang(lang)) != "" {
														{ s.Org.TradeName.Get(i18n.Lang(lang)) }
													} else {
														{ s.Org.LegalName }
													}
												</a>
											</h3>
											<div class="d-flex items-center gap-2 mt-1">
												<span class="badge badge-sky text-xs font-bold">{ OrgTypeLabel(s.Org.Type) }</span>
												<span class="badge badge-emerald text-xs font-bold">معتمد</span>
											</div>
										</div>
									</div>

									<!-- Rating pill -->
									<div class="badge badge-amber text-xs font-black tabular-nums">
										<span>★</span>
										<span>{ fmt.Sprintf("%.1f", s.Rating) }</span>
									</div>
								</div>

								<!-- Working Hours & Live Open/Closed Status Section -->
								<div class="p-3 rounded-lg bg-surface-sunken border mb-4 d-flex flex-col gap-2 text-xs">
									
									<!-- Open / Closed Indicator -->
									<div class="flex-between items-center flex-wrap gap-2">
										<div class="d-flex items-center gap-2">
											if s.IsOpenNow {
												<span class="badge badge-emerald text-xs font-bold">
													<span>مفتوح الآن</span>
												</span>
											} else {
												<span class="badge badge-slate text-xs font-bold">
													<span>مغلق حالياً</span>
												</span>
											}
											<span class="text-xs text-secondary font-bold">{ s.StatusNote }</span>
										</div>

										<span class="badge badge-slate text-xs" style="direction:ltr;">
											2-8°C مبرد
										</span>
									</div>

									<!-- Working Hours Details -->
									<div class="d-flex items-center gap-2 text-primary mt-1">
										<span class="text-muted">⏱ مواعيد العمل:</span>
										<strong class="tabular-nums font-bold">{ s.WorkingHours }</strong>
									</div>

									<!-- Coverage Days & Radius -->
									<div class="d-flex items-center gap-2 text-secondary">
										<span class="text-muted">أيام التغطية:</span>
										<span>{ s.CoverageDays }</span>
									</div>

									<!-- Covered Areas Tags -->
									if len(s.CoverageAreas) > 0 {
										<div class="d-flex items-center gap-1 flex-wrap mt-1">
											<span class="text-xs text-muted">المناطق المغطاة:</span>
											for _, area := range s.CoverageAreas {
												<span class="badge badge-slate text-xs font-mono">
													{ area }
												</span>
											}
										</div>
									}

									<!-- Minimum Order Limit -->
									<div class="flex-between items-center border-t pt-2 mt-1">
										<span class="text-muted">الحد الأدنى للطلب:</span>
										if s.MinOrderPrice.Minor() > 0 {
											<strong class="tabular-nums font-bold text-primary">{ s.MinOrderPrice.String() } ج.م</strong>
										} else {
											<span class="text-emerald font-bold">بدون حد أدنى</span>
										}
									</div>

								</div>
							</div>

							<!-- Action Buttons Footer -->
							<div class="border-t pt-3 d-flex gap-2 items-center">
								<a
									href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", s.Org.ID)) }
									class="btn btn-primary btn-sm flex-1 justify-center font-bold text-xs gap-1"
								>
									@components.IconPackage("icon-xs")
									<span>عرض الكتالوج والمنتجات</span>
								</a>
								if s.Phone != "" {
									<a
										href={ templ.SafeURL("https://wa.me/" + s.Phone) }
										target="_blank"
										rel="noopener"
										class="btn btn-secondary btn-sm btn-icon text-emerald"
										title="تواصل واتساب"
									>
										@components.IconWhatsApp("icon-xs")
									</a>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>

		<!-- View 2: Interactive Map View -->
		<div id="suppliers-map-view" style={ templ.KV("display:none;", data.ActiveTab != "map") }>
			<div style="display:grid; grid-template-columns:360px 1fr; gap:1.25rem; align-items:stretch; min-height:620px;">
				
				<!-- Map Side Panel: Quick List & Focus -->
				<div class="card" style="margin:0; padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); display:flex; flex-direction:column; max-height:680px; overflow-y:auto;">
					<div style="margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
						<h3 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">
							مواقع مخازن التوزيع الدوائي
						</h3>
						<span style="font-size:0.775rem; color:var(--text-muted);">انقر على أي مورد للتركيز عليه على الخريطة</span>
					</div>

					<div style="display:flex; flex-direction:column; gap:0.65rem;">
						for idx, s := range data.Suppliers {
							<div
								class="map-supplier-item"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("focusSupplierOnMap(%f, %f, %d)", s.Latitude, s.Longitude, idx)} }
								style="padding:0.75rem 0.9rem; border-radius:var(--radius-lg); background:var(--surface-sunken); border:1px solid var(--border); cursor:pointer; transition:all 0.2s ease;"
							>
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.3rem;">
									<strong style="font-size:0.9rem; color:var(--text);">
										if s.Org.TradeName.Get(i18n.Lang(lang)) != "" {
											{ s.Org.TradeName.Get(i18n.Lang(lang)) }
										} else {
											{ s.Org.LegalName }
										}
									</strong>
									if s.IsOpenNow {
										<span class="badge badge-emerald text-xs fw-700">مفتوح</span>
									} else {
										<span class="badge badge-slate text-xs">مغلق</span>
									}
								</div>
								<div style="font-size:0.75rem; color:var(--text-muted); display:flex; align-items:center; gap:0.25rem;">
									<span>⏱</span>
									<span>{ s.WorkingHours }</span>
								</div>
							</div>
						}
					</div>
				</div>

				<!-- Map Container -->
				<div class="card" style="margin:0; padding:0; border:1px solid var(--border); border-radius:var(--radius-xl); overflow:hidden; position:relative; min-height:600px;">
					<div id="suppliers-leaflet-map" style="width:100%; height:100%; min-height:600px; z-index:1;"></div>
				</div>

			</div>
		</div>

	</div>

	<!-- JSON Data for Map Integration -->
	<script id="suppliers-data-json" type="application/json">
		{ templ.Raw(SuppliersJSON(data.Suppliers, lang)) }
	</script>

	<!-- Interactive Map & View Switcher Script -->
	<script>
		let mapInstance = null;
		const markers = [];

		function getSuppliersData() {
			try {
				const el = document.getElementById('suppliers-data-json');
				return el ? JSON.parse(el.textContent || '[]') : [];
			} catch (e) {
				return [];
			}
		}

		let activeMarkerIdx = -1;

		function getNormalPinIcon(isOpen) {
			const statusColor = isOpen ? '#10b981' : '#64748b';
			return L.divIcon({
				className: 'custom-map-pin',
				html: `<div style="background:${statusColor}; color:#fff; width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:18px; font-weight:800; border:3px solid #fff; box-shadow:0 4px 14px rgba(0,0,0,0.35); transition:transform 0.2s;"></div>`,
				iconSize: [38, 38],
				iconAnchor: [19, 38],
				popupAnchor: [0, -38]
			});
		}

		function getActiveLargePinIcon() {
			return L.divIcon({
				className: 'supplier-active-pin-container',
				html: `
					<div class="supplier-active-pin" style="position:relative; width:56px; height:56px; display:flex; align-items:center; justify-content:center;">
						<div style="position:absolute; inset:-8px; border-radius:50%; background:rgba(37,99,235,0.35); animation:supplier-pulse-ring 1.8s infinite cubic-bezier(0.215, 0.61, 0.355, 1);"></div>
						<div style="background:linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #0284c7 100%); color:#fff; width:54px; height:54px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:26px; font-weight:900; border:3.5px solid #ffffff; box-shadow:0 8px 24px rgba(37,99,235,0.6); position:relative; z-index:2;">@components.IconBuilding("icon-sm")</div>
					</div>
				`,
				iconSize: [56, 56],
				iconAnchor: [28, 56],
				popupAnchor: [0, -56]
			});
		}

		function initSuppliersMap() {
			if (mapInstance) return;
			const mapEl = document.getElementById('suppliers-leaflet-map');
			if (!mapEl) return;

			// Leaflet arrives on demand; retry once it has.
			if (typeof L === 'undefined') {
				if (typeof ensureLeaflet === 'function') {
					ensureLeaflet().then(initSuppliersMap).catch(function (err) {
						mapEl.setAttribute('data-map-failed', 'true');
						console.error('suppliers map:', err);
					});
				}
				return;
			}

			// Egypt center: Cairo (30.0444, 31.2357)
			mapInstance = L.map('suppliers-leaflet-map').setView([30.0444, 31.2357], 7);

			L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
				maxZoom: 19,
				attribution: '© OpenStreetMap contributors'
			}).addTo(mapInstance);

			const data = getSuppliersData();
			data.forEach((s, idx) => {
				if (!s.lat || !s.lng) return;

				const statusText = s.isOpen ? 'مفتوح الآن ' : 'مغلق حالياً ';
				const customIcon = getNormalPinIcon(s.isOpen);

				const marker = L.marker([parseFloat(s.lat), parseFloat(s.lng)], { icon: customIcon }).addTo(mapInstance);

				const linkHtml = '<a href="/suppliers/' + s.id + '" style="display:block; text-align:center; background:#2563eb; color:#fff; padding:7px 14px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:800; box-shadow:0 2px 8px rgba(37,99,235,0.3);">عرض الكتالوج والطلب ↗</a>';
				const popupContent = '<div style="font-family:inherit; direction:rtl; text-align:right; min-width:240px; padding:0.4rem;">' +
					'<div style="font-size:15px; font-weight:900; color:#0f172a; margin-bottom:6px; display:flex; align-items:center; gap:0.4rem;"><span></span> ' + s.name + '</div>' +
					'<div style="font-size:12px; margin-bottom:8px;"><span style="background:' + (s.isOpen ? '#dcfce7' : '#f1f5f9') + '; color:' + (s.isOpen ? '#15803d' : '#475569') + '; padding:3px 10px; border-radius:6px; font-weight:800;">' + statusText + '</span></div>' +
					'<div style="font-size:12px; color:#475569; margin-bottom:5px;">⏱ <strong>مواعيد العمل:</strong> ' + s.hours + '</div>' +
					'<div style="font-size:12px; color:#475569; margin-bottom:6px;"><strong>أيام التغطية:</strong> ' + s.coverageDays + '</div>' +
					(s.address ? '<div style="font-size:12px; color:#64748b; margin-bottom:8px;">' + s.address + '</div>' : '') +
					'<div style="margin-top:10px; border-top:1px solid #e2e8f0; padding-top:8px;">' + linkHtml + '</div>' +
				'</div>';

				marker.bindPopup(popupContent);
				
				marker.on('click', function() {
					focusSupplierOnMap(parseFloat(s.lat), parseFloat(s.lng), idx);
				});

				markers.push(marker);
			});
		}

		function focusSupplierOnMap(lat, lng, idx) {
			switchSupplierView('map');
			if (mapInstance) {
				// Reset previously active marker
				if (activeMarkerIdx >= 0 && markers[activeMarkerIdx]) {
					const prevData = getSuppliersData()[activeMarkerIdx];
					if (prevData) {
						markers[activeMarkerIdx].setIcon(getNormalPinIcon(prevData.isOpen));
					}
				}

				// Set current marker to active large glowing pin
				if (markers[idx]) {
					markers[idx].setIcon(getActiveLargePinIcon());
					activeMarkerIdx = idx;
					mapInstance.flyTo([lat, lng], 15, { animate: true, duration: 1.2 });
					setTimeout(() => {
						markers[idx].openPopup();
					}, 400);
				} else {
					mapInstance.flyTo([lat, lng], 15, { animate: true, duration: 1.2 });
				}
			}
		}

		function switchSupplierView(view) {
			const listView = document.getElementById('suppliers-list-view');
			const mapView = document.getElementById('suppliers-map-view');
			const listBtn = document.getElementById('view-toggle-list');
			const mapBtn = document.getElementById('view-toggle-map');

			if (view === 'map') {
				if (listView) listView.style.display = 'none';
				if (mapView) mapView.style.display = 'block';
				if (listBtn) { listBtn.classList.remove('btn-primary'); listBtn.classList.add('btn-secondary'); }
				if (mapBtn) { mapBtn.classList.remove('btn-secondary'); mapBtn.classList.add('btn-primary'); }
				setTimeout(() => {
					initSuppliersMap();
					if (mapInstance) mapInstance.invalidateSize();
				}, 100);
			} else {
				if (listView) listView.style.display = 'block';
				if (mapView) mapView.style.display = 'none';
				if (listBtn) { listBtn.classList.remove('btn-secondary'); listBtn.classList.add('btn-primary'); }
				if (mapBtn) { mapBtn.classList.remove('btn-primary'); mapBtn.classList.add('btn-secondary'); }
			}
		}

		document.addEventListener('DOMContentLoaded', () => {
			const urlParams = new URLSearchParams(window.location.search);
			if (urlParams.get('view') === 'map') {
				switchSupplierView('map');
			}
		});
	</script>
}


func dosageFormIcon(form string) string {
	form = strings.ToLower(form)
	switch {
	case strings.Contains(form, "قرص") || strings.Contains(form, "اقراص") || strings.Contains(form, "أقراص") || strings.Contains(form, "tablet") || strings.Contains(form, "tab"):
		return ""
	case strings.Contains(form, "كبسول") || strings.Contains(form, "capsule") || strings.Contains(form, "cap"):
		return ""
	case strings.Contains(form, "شراب") || strings.Contains(form, "syrup") || strings.Contains(form, "liquid"):
		return ""
	case strings.Contains(form, "فوار") || strings.Contains(form, "effervescent") || strings.Contains(form, "sachet") || strings.Contains(form, "أكياس"):
		return ""
	case strings.Contains(form, "حقن") || strings.Contains(form, "امبول") || strings.Contains(form, "أمبول") || strings.Contains(form, "ampoule") || strings.Contains(form, "vial"):
		return ""
	case strings.Contains(form, "كريم") || strings.Contains(form, "مرهم") || strings.Contains(form, "gel") || strings.Contains(form, "cream") || strings.Contains(form, "ointment"):
		return ""
	case strings.Contains(form, "قطرة") || strings.Contains(form, "drop"):
		return ""
	case strings.Contains(form, "بخاخ") || strings.Contains(form, "spray"):
		return ""
	default:
		return ""
	}
}

templ SupplierProfile(lang, dir string, data SupplierProfileData) {
	@layouts.PublicShell(fmt.Sprintf("%s | ملف المورد والكتالوج", data.Org.TradeName.Get(i18n.Lang(lang))), lang, dir) {
		<div class="sp-container">
			
			<!-- Breadcrumbs -->
			<nav style="display:flex; align-items:center; gap:0.5rem; font-size:0.8125rem; color:var(--text-muted); margin-bottom:0.25rem;">
				<a href="/" style="color:var(--text-secondary); text-decoration:none;">الرئيسية</a>
				<span>/</span>
				<a href="/suppliers" style="color:var(--text-secondary); text-decoration:none;">دليل الموردين</a>
				<span>/</span>
				<span style="color:var(--text); font-weight:700;">{ data.Org.TradeName.Get(i18n.Lang(lang)) }</span>
			</nav>

			<!-- 1. Verified Supplier Flagship Header Banner -->
			<div class="sp-hero-card">
				<div class="sp-hero-identity">
					<div class="sp-hero-logo">
						@components.IconBuilding("icon-sm")
					</div>
					<div class="sp-hero-details">
						<div class="sp-hero-title-row">
							<h1 class="sp-hero-title">
								{ data.Org.TradeName.Get(i18n.Lang(lang)) }
							</h1>
							<span class="badge badge-emerald text-xs fw-700">
								@components.IconCheckCircle("icon-xs")
								<span>موزع أدوية معتمد</span>
							</span>
						</div>

						if data.Org.LegalName != "" && data.Org.LegalName != data.Org.TradeName.Get(i18n.Lang(lang)) {
							<p class="sp-hero-legal-name">
								{ data.Org.LegalName }
							</p>
						}

						<!-- Credentials & Real Rating Strip -->
						<div class="sp-hero-meta-row">
							if data.ReviewCount > 0 {
								<div class="row-center-xs">
									@components.RatingStars(data.Rating, data.ReviewCount)
								</div>
							} else {
								<span class="text-xs text-muted">(مورد معتمد موثق)</span>
							}
							if data.Org.CommercialRegister != "" {
								<span style="color:var(--border);">•</span>
								<span class="tabular-nums">السجل التجاري: <strong class="text-primary">{ data.Org.CommercialRegister }</strong></span>
							}
							if data.Org.TaxNumber != "" {
								<span style="color:var(--border);">•</span>
								<span class="tabular-nums">البطاقة الضريبية: <strong class="text-primary">{ data.Org.TaxNumber }</strong></span>
							}
						</div>
					</div>
				</div>

				<!-- Right Action Buttons -->
				<div class="sp-hero-actions">
					<button
						type="button"
						class="btn btn-primary"
						data-modal-open={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }
						style="width:100%; justify-content:center; font-weight:700; font-size:0.875rem; border-radius:var(--radius-md);"
					>
						@components.IconPlus("icon-xs")
						<span>طلب عرض أسعار خاص</span>
					</button>

					<div class="row-center-sm" style="display:flex; gap:0.5rem;">
						<a href="https://wa.me/201012345678" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="flex:1; justify-content:center; font-weight:700; color:var(--success-text); border-radius:var(--radius-md);">
							@components.IconWhatsApp("icon-xs")
							<span>واتساب</span>
						</a>

						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/follow", data.Org.ID)) } style="flex:1; margin:0;">
							if data.IsFollowing {
								<button type="submit" class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; font-weight:700; color:var(--danger-text); border-radius:var(--radius-md);">
									@components.IconHeart("icon-xs")
									<span>إلغاء المتابعة</span>
								</button>
							} else {
								<button type="submit" class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; font-weight:700; color:var(--accent); border-radius:var(--radius-md);">
									@components.IconHeart("icon-xs")
									<span>متابعة</span>
								</button>
							}
						</form>
					</div>
				</div>
			</div>

			<!-- 2. Operational & Coverage Live Command Strip -->
			<div class="sp-ops-strip">
				<!-- Working Hours -->
				<div class="sp-ops-item">
					<div class="sp-ops-icon">
						⏱
					</div>
					<div class="sp-ops-content">
						<div class="sp-ops-label">
							if data.IsOpenNow {
								<span class="badge badge-emerald text-xs fw-700" style="padding:0.15rem 0.5rem; gap:0.3rem;">
									<span style="width:6px; height:6px; border-radius:50%; background:#10b981; display:inline-block;"></span>
									<span>مفتوح الآن</span>
								</span>
							} else {
								<span class="badge badge-slate text-xs fw-700" style="padding:0.15rem 0.5rem; gap:0.3rem;">
									<span style="width:6px; height:6px; border-radius:50%; background:#94a3b8; display:inline-block;"></span>
									<span>مغلق حالياً</span>
								</span>
							}
						</div>
						<div class="sp-ops-val tabular-nums">
							{ data.WorkingHours }
						</div>
					</div>
				</div>

				<!-- Coverage Days & Cold Storage -->
				<div class="sp-ops-item">
					<div class="sp-ops-icon">
						@components.IconTruck("icon-sm")
					</div>
					<div class="sp-ops-content">
						<div class="sp-ops-label">أيام التغطية والتوصيل</div>
						<div class="sp-ops-val">
							{ data.CoverageDays }
						</div>
					</div>
				</div>

				<!-- Covered Areas -->
				if len(data.CoverageAreas) > 0 {
					<div class="sp-ops-item">
						<div class="sp-ops-icon">
							@components.IconMapPin("icon-sm")
						</div>
						<div class="sp-ops-content">
							<div class="sp-ops-label">المناطق المشمولة</div>
							<div class="sp-ops-val" style="font-size:0.8125rem;">
								{ strings.Join(data.CoverageAreas, "، ") }
							</div>
						</div>
					</div>
				}

				<!-- Minimum Order -->
				<div class="sp-ops-item">
					<div class="sp-ops-icon">
						@components.IconCreditCard("icon-sm")
					</div>
					<div class="sp-ops-content">
						<div class="sp-ops-label">الحد الأدنى للطلب</div>
						<div class="sp-ops-val tabular-nums text-primary">
							if data.Org.MinOrderPrice.Minor() > 0 {
								{ data.Org.MinOrderPrice.String() } ج.م
							} else {
								<span class="text-emerald">بدون حد أدنى</span>
							}
						</div>
					</div>
				</div>
			</div>

			<!-- 3. Navigation Tabs -->
			<div class="sp-tabs-nav">
				<button type="button" class={ "sp-tab-btn", templ.KV("active", data.ActiveTab == "catalog" || data.ActiveTab == "") } id="tab-btn-catalog" onclick="switchProfileTab('catalog')">
					@components.IconPackage("icon-xs")
					<span>كتالوج الأصناف والتشغيلات ({ fmt.Sprintf("%d", data.TotalVariants) })</span>
				</button>

				if len(data.Sections) > 0 {
					<button type="button" class={ "sp-tab-btn", templ.KV("active", data.ActiveTab == "sections") } id="tab-btn-sections" onclick="switchProfileTab('sections')">
						<span>@components.IconSparkles("icon-sm")</span>
						<span>نبذة وأقسام المنشأة ({ fmt.Sprintf("%d", len(data.Sections)) })</span>
					</button>
				}

				<button type="button" class={ "sp-tab-btn", templ.KV("active", data.ActiveTab == "policies") } id="tab-btn-policies" onclick="switchProfileTab('policies')">
					@components.IconShield("icon-xs")
					<span>شروط وسياسات التوريد ({ fmt.Sprintf("%d", len(data.Policies)) })</span>
				</button>

				<button type="button" class={ "sp-tab-btn", templ.KV("active", data.ActiveTab == "branches") } id="tab-btn-branches" onclick="switchProfileTab('branches')">
					@components.IconBuilding("icon-xs")
					<span>فروع ومخازن التوزيع ({ fmt.Sprintf("%d", len(data.Branches)) })</span>
				</button>

				<button type="button" class={ "sp-tab-btn", templ.KV("active", data.ActiveTab == "reviews") } id="tab-btn-reviews" onclick="switchProfileTab('reviews')">
					@components.IconUser("icon-xs")
					<span>تقييمات الصيادلة ({ fmt.Sprintf("%d", data.ReviewCount) })</span>
				</button>
			</div>

			<!-- 4. Tab 1: Catalog & Batches Content -->
			<div id="tab-content-catalog" class="sp-tab-panel" style={ templ.KV("display:none;", data.ActiveTab != "" && data.ActiveTab != "catalog") }>
				
				<!-- Catalog Controls Toolbar -->
				<div class="sp-catalog-toolbar">
					<form method="GET" class="sp-catalog-search">
						<div style="position:relative; flex:1;">
							<input
								type="text"
								name="q"
								value={ data.SearchQuery }
								placeholder="ابحث في أصناف وتشغيلات المورد بالاسم أو الباركود أو المادة الفعالة..."
								class="form-input input-sm"
								style="width:100%; padding-inline-start:2.25rem; border-radius:var(--radius-md);"
							/>
							<div style="position:absolute; inset-inline-start:0.75rem; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
								@components.IconSearch("icon-xs")
							</div>
						</div>
						<button type="submit" class="btn btn-primary btn-sm fw-700" style="border-radius:var(--radius-md);">
							بحث
						</button>
						if data.SearchQuery != "" {
							<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", data.Org.ID)) } class="btn btn-secondary btn-sm" style="border-radius:var(--radius-md);">
								إعادة تعيين
							</a>
						}
					</form>

					<div class="d-flex items-center gap-2">
						<span class="badge badge-sky text-xs fw-700">
							{ fmt.Sprintf("%d صنف معتمد", data.TotalVariants) }
						</span>
						<div style="display:flex; align-items:center; background:var(--surface-sunken); padding:0.2rem; border-radius:var(--radius-md); border:1px solid var(--border);">
							<button type="button" id="cat-view-table-btn" onclick="switchCatalogView('table')" class="btn btn-sm btn-primary" style="padding:0.25rem 0.6rem; font-size:0.75rem; border-radius:var(--radius-sm);" title="عرض الجدول التفصيلي">
								جدول
							</button>
							<button type="button" id="cat-view-grid-btn" onclick="switchCatalogView('grid')" class="btn btn-sm btn-secondary" style="padding:0.25rem 0.6rem; font-size:0.75rem; border-radius:var(--radius-sm);" title="عرض البطاقات">
								⊞ بطاقات
							</button>
						</div>
					</div>
				</div>

				if len(data.Variants) == 0 {
					<div class="card" style="padding:3.5rem 1.5rem; text-align:center; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
						@components.IconPill("icon-lg")
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0.85rem 0 0.35rem 0;">لا توجد أصناف مطابقة للبحث</h3>
						<p class="text-sm text-muted m-0">يقوم المورد بتحديث قائمة الأدوية والأسعار بانتظام.</p>
					</div>
				} else {
					<!-- Table View (Swiss B2B High Density) -->
					<div id="catalog-table-view" class="sp-catalog-table-wrap">
						<table class="sp-table">
							<thead>
								<tr>
									<th>الصنف الدوائي والمواصفات</th>
									<th>التشغيلة والصلاحية</th>
									<th>سعر الجمهور</th>
									<th>نسبة الخصم</th>
									<th>السعر بعد الخصم</th>
									<th>حالة المخزون والتغطية</th>
									<th class="text-center">طلب الصنف وإضافته للسلة</th>
								</tr>
							</thead>
							<tbody>
								for _, v := range data.Variants {
									{{
										availStock := data.GetAvailableStock(v)
										isCovered := data.IsVariantCovered(v)
										canAdd := data.CanAddToCart(v)
										minOrderQty := data.GetMinOrderQty(v)
									}}
									<tr>
										<!-- Product Identity & Image -->
										<td>
											<div class="sp-product-cell">
												<div class="sp-product-thumb">
													if img := data.GetProductImage(v); img != "" {
														<img src={ img } alt={ v.Name.Get(i18n.Lang(lang)) } loading="lazy" />
													} else {
														<span>{ dosageFormIcon(data.GetDosageForm(v)) }</span>
													}
												</div>
												<div class="sp-product-info">
													<h4 class="sp-product-title">
														<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", v.ProductID)) }>
															if v.Name.Get(i18n.Lang(lang)) != "" {
																{ v.Name.Get(i18n.Lang(lang)) }
															} else {
																{ fmt.Sprintf("تشغيلة رقم #%d", v.ID) }
															}
														</a>
													</h4>
													if sci := data.GetScientificName(v); sci != "" {
														<span class="sp-product-scientific">{ sci }</span>
													}
													<div class="sp-badges-row">
														if form := data.GetDosageForm(v); form != "" {
															<span class="badge badge-slate" style="font-size:0.7rem; padding:0.1rem 0.45rem;">
																{ form }
															</span>
														}
														if conc := data.GetConcentration(v); conc != "" {
															<span class="badge badge-secondary" style="font-size:0.7rem; padding:0.1rem 0.45rem;">
																{ conc }
															</span>
														}
														if v.Unit != "" {
															<span class="badge badge-sky" style="font-size:0.7rem; padding:0.1rem 0.45rem;">
																{ v.Unit }
															</span>
														}
													</div>
												</div>
											</div>
										</td>

										<!-- Batch & Expiry -->
										<td>
											<div style="display:flex; flex-direction:column; gap:0.25rem; font-size:0.8125rem;">
												if v.BatchNumber != "" {
													<div><span class="text-muted">تشغيلة:</span> <strong class="tabular-nums text-primary">{ v.BatchNumber }</strong></div>
												}
												if v.ExpiryDate != nil {
													<div><span class="text-muted">صلاحية:</span> <strong class="tabular-nums text-emerald">{ v.ExpiryDate.Format("2006-01") }</strong></div>
												}
												if v.MinOrderQty > 1 {
													<span class="badge badge-slate text-xs">حد أدنى: { fmt.Sprintf("%d", v.MinOrderQty) }</span>
												}
											</div>
										</td>

										<!-- 1. Retail Public Price (سعر الجمهور) -->
										<td>
											if p := data.GetProduct(v.ProductID); p != nil && p.PublicPrice().IsPositive() {
												<div style="font-size:0.95rem; font-weight:700; color:var(--text);" class="tabular-nums">
													{ p.PublicPrice().String() } <span style="font-size:0.75rem; color:var(--text-secondary);">ج.م</span>
												</div>
											} else if v.Price.IsPositive() {
												<div style="font-size:0.95rem; font-weight:700; color:var(--text);" class="tabular-nums">
													{ v.Price.String() } <span style="font-size:0.75rem; color:var(--text-secondary);">ج.م</span>
												</div>
											} else {
												<span class="text-xs text-muted">-</span>
											}
										</td>

										<!-- 2. Discount Percentage (نسبة الخصم %) -->
										<td>
											{{
												discPct := 0.0
												if p := data.GetProduct(v.ProductID); p != nil && p.PublicPrice().IsPositive() && v.Price.IsPositive() && v.Price.Minor() < p.PublicPrice().Minor() {
													discPct = (1.0 - float64(v.Price.Minor())/float64(p.PublicPrice().Minor())) * 100.0
												} else if v.Discount.IsPositive() {
													discPct = float64(v.Discount.Minor()) / 100.0
												}
											}}
											if discPct > 0 {
												<span class="badge badge-emerald tabular-nums" style="font-size:0.825rem; font-weight:800; padding:0.2rem 0.55rem;">
													{ fmt.Sprintf("%.0f%%", discPct) }
												</span>
											} else {
												<span class="text-xs text-muted">0%</span>
											}
										</td>

										<!-- 3. Price After Discount (السعر بعد الخصم) -->
										<td>
											<div style="display:flex; flex-direction:column; gap:0.15rem;">
												<div style="font-size:1.1rem; font-weight:900; color:var(--primary-600);" class="tabular-nums">
													if v.Price.IsPositive() {
														{ v.Price.String() } <span style="font-size:0.8rem; font-weight:600;">ج.م</span>
													} else {
														<span class="text-sm text-muted">حسب الكمية</span>
													}
												</div>
											</div>
										</td>

										<!-- 4. Stock & Coverage Status -->
										<td>
											<div style="display:flex; flex-direction:column; gap:0.3rem;">
												if availStock > 0 {
													<span class="badge badge-emerald text-xs font-bold tabular-nums" style="width:fit-content;">
														متوفر ({ fmt.Sprintf("%d", availStock) } عبوة)
													</span>
												} else {
													<span class="badge badge-rose text-xs font-bold" style="width:fit-content;">
														نفد من المخزون
													</span>
												}
												if !isCovered {
													<span class="badge badge-rose text-xs font-bold" style="width:fit-content;" title={ data.GetCoverageReason(v) }>
														خارج التغطية
													</span>
												} else {
													<span class="text-xs text-muted text-xs">
														مشمول بالتوصيل
													</span>
												}
											</div>
										</td>

										<!-- 5. Order Action & Stepper -->
										<td class="text-center">
											if canAdd {
												<form
													action="/cart/add"
													method="POST"
													hx-post="/cart/add"
													hx-swap="none"
													x-data="{ added: false, loading: false }"
													@submit="loading = true"
													@htmx:after-request="loading = false; added = true; setTimeout(() => added = false, 2500)"
													class="sp-stepper-form"
													style="justify-content:center;"
												>
													<input type="hidden" name="return_to" value={ fmt.Sprintf("/suppliers/%d", data.Org.ID) } />
													<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
													<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.ID) } />
													<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", data.Org.ID) } />
													<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", data.Org.ID) } />
													<input type="hidden" name="offer_price" value={ v.Price.String() } />
													
													<input
														type="number"
														name="quantity"
														min={ fmt.Sprintf("%d", minOrderQty) }
														max={ fmt.Sprintf("%d", availStock) }
														value={ fmt.Sprintf("%d", minOrderQty) }
														class="sp-stepper-input tabular-nums"
														title={ fmt.Sprintf("الكمية المطلوبة (الحد الأقصى المتاح بالمخزن: %d)", availStock) }
													/>
													<button
														type="submit"
														:disabled="loading"
														class="btn btn-primary btn-sm fw-700"
														style="padding:0.4rem 0.85rem; border-radius:var(--radius-md); font-size:0.8125rem; gap:0.35rem;"
													>
														<span x-show="!loading && !added">@components.IconCart("icon-xs")</span>
														<span x-show="!loading && !added">+ إضافة للسلة</span>
														<span x-show="loading" style="display:none;">⏳ جارٍ الإضافة...</span>
														<span x-show="added" style="display:none;" class="text-emerald font-bold">تمت الإضافة!</span>
													</button>
													<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", v.ProductID)) } class="btn btn-secondary btn-sm btn-icon" style="border-radius:var(--radius-md);" title="تفاصيل الصنف">
														@components.IconArrowLeft("icon-xs")
													</a>
												</form>
											} else {
												<div class="row-center-xs" style="justify-content:center; gap:0.5rem;">
													if !isCovered {
														<span class="badge badge-rose text-xs font-bold" title={ data.GetCoverageReason(v) }>
															غير مغطى
														</span>
													} else if availStock <= 0 {
														<span class="badge badge-slate text-xs font-bold">
															غير متوفر
														</span>
													} else {
														<span class="badge badge-slate text-xs font-bold">
															غير متاح للطلب
														</span>
													}
													<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", v.ProductID)) } class="btn btn-secondary btn-sm btn-icon" style="border-radius:var(--radius-md);" title="تفاصيل الصنف">
														@components.IconArrowLeft("icon-xs")
													</a>
												</div>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Compact Grid View (Hidden by Default) -->
					<div id="catalog-grid-view" style="display:none; grid-template-columns:repeat(auto-fill, minmax(270px, 1fr)); gap:1rem;">
						for _, v := range data.Variants {
							{{
								availStock := data.GetAvailableStock(v)
								isCovered := data.IsVariantCovered(v)
								canAdd := data.CanAddToCart(v)
								minOrderQty := data.GetMinOrderQty(v)
							}}
							<div class="card hover-lift" style="display:flex; flex-direction:column; justify-content:space-between; margin:0; padding:1.15rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); box-shadow:var(--shadow-xs);">
								<div>
									<!-- Top Row: Thumbnail + Dosage Badge -->
									<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem; gap:0.5rem;">
										<div class="sp-product-thumb" style="width:44px; height:44px;">
											if img := data.GetProductImage(v); img != "" {
												<img src={ img } alt={ v.Name.Get(i18n.Lang(lang)) } loading="lazy" />
											} else {
												<span>{ dosageFormIcon(data.GetDosageForm(v)) }</span>
											}
										</div>
										<div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.2rem;">
											if form := data.GetDosageForm(v); form != "" {
												<span class="badge badge-slate text-xs">{ form }</span>
											}
											if v.Unit != "" {
												<span class="badge badge-secondary text-xs">{ v.Unit }</span>
											}
										</div>
									</div>

									<h4 style="font-size:0.95rem; font-weight:800; color:var(--text); margin:0 0 0.35rem 0; line-height:1.35;">
										<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", v.ProductID)) } style="color:inherit; text-decoration:none;">
											if v.Name.Get(i18n.Lang(lang)) != "" {
												{ v.Name.Get(i18n.Lang(lang)) }
											} else {
												{ fmt.Sprintf("تشغيلة رقم #%d", v.ID) }
											}
										</a>
									</h4>

									if sci := data.GetScientificName(v); sci != "" {
										<div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.5rem; font-style:italic;">{ sci }</div>
									}

									<!-- Batch & Expiry Tag -->
									<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.4rem 0.65rem; margin-bottom:0.75rem; font-size:0.75rem; display:flex; flex-direction:column; gap:0.15rem;">
										if v.BatchNumber != "" {
											<div><span class="text-muted">تشغيلة:</span> <strong class="tabular-nums text-primary">{ v.BatchNumber }</strong></div>
										}
										if v.ExpiryDate != nil {
											<div><span class="text-muted">صلاحية:</span> <strong class="tabular-nums text-emerald">{ v.ExpiryDate.Format("2006-01") }</strong></div>
										}
									</div>

									<!-- Stock & Coverage Pills -->
									<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; flex-wrap:wrap; gap:0.35rem;">
										if availStock > 0 {
											<span class="badge badge-emerald text-xs font-bold tabular-nums">
												متوفر ({ fmt.Sprintf("%d", availStock) })
											</span>
										} else {
											<span class="badge badge-rose text-xs font-bold">
												نفد المخزون
											</span>
										}
										if !isCovered {
											<span class="badge badge-rose text-xs font-bold" title={ data.GetCoverageReason(v) }>
												خارج التغطية
											</span>
										}
									</div>

									<!-- Pricing Row -->
									<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.75rem;">
										<span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">سعر التوريد:</span>
										<div style="font-size:1.15rem; font-weight:900; color:var(--primary-600);" class="tabular-nums">
											if v.Price.IsPositive() {
												{ v.Price.String() } <span style="font-size:0.8rem; font-weight:600;">ج.م</span>
											} else {
												<span class="text-sm text-muted">حسب الكمية</span>
											}
										</div>
									</div>
								</div>

								<!-- Action Form -->
								<div style="border-top:1px solid var(--border); padding-top:0.75rem;">
									if canAdd {
										<form
											action="/cart/add"
											method="POST"
											hx-post="/cart/add"
											hx-swap="none"
											x-data="{ added: false, loading: false }"
											@submit="loading = true"
											@htmx:after-request="loading = false; added = true; setTimeout(() => added = false, 2500)"
											style="display:flex; gap:0.4rem; margin:0;"
										>
											<input type="hidden" name="return_to" value={ fmt.Sprintf("/suppliers/%d", data.Org.ID) } />
											<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
											<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.ID) } />
											<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", data.Org.ID) } />
											<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", data.Org.ID) } />
											<input type="hidden" name="offer_price" value={ v.Price.String() } />
											<input
												type="number"
												name="quantity"
												min={ fmt.Sprintf("%d", minOrderQty) }
												max={ fmt.Sprintf("%d", availStock) }
												value={ fmt.Sprintf("%d", minOrderQty) }
												class="sp-stepper-input tabular-nums"
												style="width:50px; height:36px;"
												title={ fmt.Sprintf("الكمية المطلوبة (المتاح بالمخزن: %d)", availStock) }
											/>
											<button
												type="submit"
												:disabled="loading"
												class="btn btn-primary btn-sm fw-700"
												style="flex:1; justify-content:center; font-size:0.8125rem; border-radius:var(--radius-md); gap:0.25rem;"
											>
												<span x-show="!loading && !added">@components.IconCart("icon-xs")</span>
												<span x-show="!loading && !added">إضافة للسلة</span>
												<span x-show="loading" style="display:none;">⏳...</span>
												<span x-show="added" style="display:none;" class="text-emerald font-bold">أضيف!</span>
											</button>
										</form>
									} else {
										<div class="row-center-xs" style="justify-content:center; gap:0.4rem;">
											if !isCovered {
												<span class="badge badge-rose text-xs font-bold w-full text-center py-2" title={ data.GetCoverageReason(v) }>
													خارج نطاق التغطية
												</span>
											} else if availStock <= 0 {
												<span class="badge badge-slate text-xs font-bold w-full text-center py-2">
													نفد من المخزون
												</span>
											} else {
												<span class="badge badge-slate text-xs font-bold w-full text-center py-2">
													غير متاح للطلب
												</span>
											}
										</div>
									}
								</div>
							</div>
						}
					</div>

					<!-- Pagination Bar -->
					if data.TotalPages > 1 {
						<div style="display:flex; justify-content:center; align-items:center; gap:0.75rem; padding:1.25rem 0; border-top:1px solid var(--border); margin-top:1.25rem;">
							if data.CurrentPage > 1 {
								<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d?q=%s&page=%d", data.Org.ID, data.SearchQuery, data.CurrentPage-1)) } class="btn btn-secondary btn-sm" style="border-radius:var(--radius-md);">
									@components.IconArrowRight("icon-xs")
									<span>الصفحة السابقة</span>
								</a>
							}
							<span style="font-size:0.875rem; color:var(--text-secondary); font-weight:700;" class="tabular-nums">
								صفحة { fmt.Sprintf("%d", data.CurrentPage) } من { fmt.Sprintf("%d", data.TotalPages) }
							</span>
							if data.CurrentPage < data.TotalPages {
								<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d?q=%s&page=%d", data.Org.ID, data.SearchQuery, data.CurrentPage+1)) } class="btn btn-secondary btn-sm" style="border-radius:var(--radius-md);">
									<span>الصفحة التالية</span>
									@components.IconArrowLeft("icon-xs")
								</a>
							}
						</div>
					}
				}

			</div>

			<!-- 5. Tab 2: About & Highlights -->
			if len(data.Sections) > 0 {
				<div id="tab-content-sections" class="sp-tab-panel" style={ templ.KV("display:none;", data.ActiveTab != "sections") }>
					<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:1.25rem;">
						for _, s := range data.Sections {
							if s.IsActive {
								<div class="card hover-lift" style="margin:0; padding:1.5rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); box-shadow:var(--shadow-xs);">
									<div style="display:flex; align-items:center; gap:0.85rem; margin-bottom:1rem;">
										<div style={ fmt.Sprintf("width:44px; height:44px; border-radius:var(--radius-lg); background:%s20; color:%s; display:flex; align-items:center; justify-content:center; font-size:1.35rem; border:1px solid %s40; flex-shrink:0;", s.Color, s.Color, s.Color) }>
											{ sectionTypeIcon(s.SectionType) }
										</div>
										<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0;">
											{ s.Title.Get(i18n.Lang(lang)) }
										</h3>
									</div>
									<div style="font-size:0.9rem; color:var(--text-secondary); line-height:1.75; white-space:pre-line; margin-bottom:1.25rem; max-height:120px; overflow:hidden;">
										{ s.Description.Get(i18n.Lang(lang)) }
									</div>
									<button
										type="button"
										class="btn btn-secondary btn-sm fw-700"
										data-modal-open={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
										style="width:100%; justify-content:center; border-radius:var(--radius-md);"
									>
										<span>عرض التفاصيل الكاملة ←</span>
									</button>
								</div>
							}
						}
					</div>
				</div>
			}

			<!-- 6. Tab 3: Supply Policies -->
			<div id="tab-content-policies" class="sp-tab-panel" style={ templ.KV("display:none;", data.ActiveTab != "policies") }>
				if len(data.Policies) == 0 {
					<div class="card" style="padding:2rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
						<div style="display:flex; align-items:center; gap:0.65rem; margin-bottom:0.75rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconShield("icon-sm")
							</div>
							<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0;">
								الشروط والسياسات القياسية المعتمدة
							</h3>
						</div>
						<p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.75; margin:0;">
							تخضع كافة طلبيات التوريد الصادرة عبر المنصة لضوابط ومعايير هيئة الدواء المصرية، مع الالتزام بتوفير فواتير ضريبية إلكترونية معتمدة وضمان سلامة سلسلة التبريد وسرعة التوصيل خلال المواعيد المحددة.
						</p>
					</div>
				} else {
					<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(340px, 1fr)); gap:1.25rem;">
						for _, pol := range data.Policies {
							<div class="card" style="margin:0; padding:1.5rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border); box-shadow:var(--shadow-xs);">
								<div style="display:flex; align-items:center; gap:0.65rem; margin-bottom:0.85rem;">
									<div style="width:34px; height:34px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
										@components.IconShield("icon-xs")
									</div>
									<h4 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">
										{ pol.Title }
									</h4>
								</div>
								<p style="font-size:0.875rem; color:var(--text-secondary); margin:0; line-height:1.75; white-space:pre-line;">
									{ pol.Content }
								</p>
							</div>
						}
					</div>
				}
			</div>

			<!-- 7. Tab 4: Branches & Warehouses -->
			<div id="tab-content-branches" class="sp-tab-panel" style={ templ.KV("display:none;", data.ActiveTab != "branches") }>
				if len(data.Branches) == 0 {
					<div class="card" style="padding:2.5rem; text-align:center; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
						@components.IconBuilding("icon-lg")
						<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0.75rem 0 0.25rem 0;">المخزن الرئيسي للمورد</h3>
						<p class="text-sm text-muted m-0">يتم شحن وتجهيز الطلبيات من المخزن المركزي للمورد في نطاق المحافظات المشمولة.</p>
					</div>
				} else {
					<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(340px, 1fr)); gap:1.25rem;">
						for _, b := range data.Branches {
							<div class="card" style="margin:0; padding:1.5rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border); box-shadow:var(--shadow-xs);">
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem;">
									<div style="display:flex; align-items:center; gap:0.65rem;">
										<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
											@components.IconBuilding("icon-sm")
										</div>
										<div>
											<h4 style="font-size:1rem; font-weight:800; color:var(--text); margin:0;">
												{ b.Name.Get(i18n.Lang(lang)) }
											</h4>
											if b.IsMain {
												<span class="badge badge-primary text-xs" style="margin-top:2px;">المخزن الرئيسي</span>
											}
										</div>
									</div>
									if b.HasColdStorage {
										<span class="badge badge-sky text-xs">مبرد</span>
									}
								</div>

								<div style="display:flex; flex-direction:column; gap:0.4rem; font-size:0.8125rem; color:var(--text-secondary); margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid var(--border);">
									if b.Address != "" {
										<div><span class="text-muted">العنوان:</span> <strong>{ b.Address }</strong></div>
									}
									if b.OperatingHours != "" {
										<div><span class="text-muted">ساعات العمل:</span> <strong class="tabular-nums">{ b.OperatingHours }</strong></div>
									}
									if b.Phone != "" {
										<div><span class="text-muted">الهاتف:</span> <strong class="tabular-nums">{ b.Phone }</strong></div>
									}
									if b.ManagerName != "" {
										<div><span class="text-muted">مسؤول الفرع:</span> <strong>{ b.ManagerName }</strong></div>
									}
								</div>
							</div>
						}
					</div>
				}
			</div>

			<!-- 8. Tab 5: Reviews -->
			<div id="tab-content-reviews" class="sp-tab-panel" style={ templ.KV("display:none;", data.ActiveTab != "reviews") }>
				if len(data.Reviews) == 0 {
					<div class="card" style="padding:3rem 1.5rem; text-align:center; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
						<div style="font-size:2rem; margin-bottom:0.5rem;">@components.IconStar("icon-sm")</div>
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0 0 0.25rem 0;">مورد معتمد موثق</h3>
						<p class="text-sm text-muted m-0">لم يتم تسجيل تقييمات مكتوبة بعد. عند استلام طلبيتك القادمة يمكنك إضافة تقييمك للخدمة والتوريد.</p>
					</div>
				} else {
					<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:1.25rem;">
						for _, rv := range data.Reviews {
							<div class="card" style="margin:0; padding:1.25rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border); box-shadow:var(--shadow-xs);">
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
									<strong style="font-size:0.875rem; color:var(--text);">صيدلية معتمدة</strong>
									@components.RatingStars(float64(rv.Rating), 0)
								</div>
								<p style="font-size:0.8125rem; color:var(--text-secondary); margin:0; line-height:1.6;">
									{ rv.ReviewText }
								</p>
							</div>
						}
					</div>
				}
			</div>

			<!-- Universal Quote Request Modal -->
			<div id={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } class="modal-overlay hidden">
				<div class="modal-card" style="max-width:520px; padding:1.75rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border); box-shadow:var(--shadow-lg);">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
						<h3 class="text-lg fw-800 text-primary m-0">
							طلب عرض سعر مخصص من المورد
						</h3>
						<button type="button" class="btn btn-secondary btn-icon" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) } style="border:none;">
							@components.IconClose("icon-sm")
						</button>
					</div>

					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/suppliers/%d/quote", data.Org.ID)) } class="stack-md">
						<div class="form-group mb-0">
							<label class="form-label" for="q-product" style="font-size:0.85rem; font-weight:700;">اختر الصنف الدوائي (اختياري)</label>
							<select id="q-product" name="product_id" class="form-select">
								<option value="">طلب عرض سعر عام لكافة الاحتياجات</option>
								for _, p := range data.Products {
									<option value={ fmt.Sprintf("%d", p.ID) }>
										if p.Name["ar"] != "" {
											{ p.Name["ar"] }
										} else {
											{ p.Name["en"] }
										}
									</option>
								}
							</select>
						</div>

						<div class="form-group mb-0">
							<label class="form-label" for="q-qty" style="font-size:0.85rem; font-weight:700;">الكمية التقديرية المطلوبة (عبوة) *</label>
							<input type="number" id="q-qty" name="quantity" required min="1" value="50" class="form-input tabular-nums" />
						</div>

						<div class="form-group mb-0">
							<label class="form-label" for="q-notes" style="font-size:0.85rem; font-weight:700;">ملاحظات وشروط التوريد المطلوبة</label>
							<textarea id="q-notes" name="notes" rows="3" placeholder="حدد شروط السداد المطلوبة أو مواعيد التسليم المفضلة..." class="form-textarea"></textarea>
						</div>

						<div style="display:flex; gap:0.75rem; justify-content:flex-end; margin-top:0.75rem;">
							<button type="button" class="btn btn-secondary" data-modal-close={ fmt.Sprintf("quote-modal-%d", data.Org.ID) }>
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary fw-700">
								@components.IconCheck("icon-xs")
								<span>إرسال طلب عرض السعر</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Featured Section Modals -->
			for _, s := range data.Sections {
				<div
					id={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
					class="modal-overlay hidden"
					style="position:fixed; inset:0; z-index:99999; display:none; align-items:center; justify-content:center; background:rgba(6, 10, 20, 0.82); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); padding:1.25rem;"
				>
					<div
						class="modal-card"
						style="width:min(94vw, 580px); background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:2rem; box-shadow:0 25px 60px -15px rgba(0,0,0,0.7); position:relative; overflow:hidden;"
					>
						<div style={ fmt.Sprintf("position:absolute; top:0; left:0; right:0; height:4px; background:%s;", s.Color) }></div>

						<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border); padding-bottom:1.25rem;">
							<div style="display:flex; align-items:center; gap:0.85rem;">
								<div style={ fmt.Sprintf("width:48px; height:48px; border-radius:var(--radius-xl); background:%s20; color:%s; display:flex; align-items:center; justify-content:center; font-size:1.5rem; border:1px solid %s40; flex-shrink:0;", s.Color, s.Color, s.Color) }>
									{ sectionTypeIcon(s.SectionType) }
								</div>
								<div>
									<h3 style="font-size:1.35rem; font-weight:900; color:var(--text); margin:0; line-height:1.3;">
										{ s.Title.Get(i18n.Lang(lang)) }
									</h3>
								</div>
							</div>
							<button
								type="button"
								class="btn btn-secondary btn-icon"
								data-modal-close={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
								style="border-radius:var(--radius-full); width:38px; height:38px; min-width:38px; background:var(--surface-sunken); border:1px solid var(--border); cursor:pointer;"
								title="إغلاق النافذة"
							>
								@components.IconClose("icon-xs")
							</button>
						</div>

						<div style="font-size:1.025rem; color:var(--text); line-height:1.95; white-space:pre-line; margin-bottom:1.75rem; background:var(--surface-sunken); padding:1.5rem 1.75rem; border-radius:var(--radius-xl); border:1px solid var(--border); max-height:55vh; overflow-y:auto;">
							{ s.Description.Get(i18n.Lang(lang)) }
						</div>

						<div class="flex justify-end">
							<button
								type="button"
								class="btn btn-primary"
								data-modal-close={ fmt.Sprintf("supplier-sec-modal-%d", s.ID) }
								style="font-weight:800; font-size:0.95rem; padding:0.65rem 2.25rem; border-radius:var(--radius-xl);"
							>
								إغلاق
							</button>
						</div>
					</div>
				</div>
			}

		</div>

		<!-- Client Tab & View Switcher Script -->
		<script>
			function switchProfileTab(tabName, updateUrl) {
				if (updateUrl === undefined) updateUrl = true;
				const tabs = ['catalog', 'sections', 'policies', 'branches', 'reviews'];
				if (!tabs.includes(tabName)) tabName = 'catalog';

				tabs.forEach(t => {
					const btn = document.getElementById('tab-btn-' + t);
					const panel = document.getElementById('tab-content-' + t);
					if (btn) {
						if (t === tabName) {
							btn.classList.add('active');
						} else {
							btn.classList.remove('active');
						}
					}
					if (panel) {
						if (t === tabName) {
							panel.style.display = 'block';
						} else {
							panel.style.display = 'none';
						}
					}
				});

				try {
					if (updateUrl) {
						if (window.history && window.history.replaceState) {
							window.history.replaceState(null, null, '#' + tabName);
						} else {
							window.location.hash = '#' + tabName;
						}
					}
					sessionStorage.setItem('dawa24_active_tab_' + window.location.pathname, tabName);
				} catch (e) {}
			}

			function restoreActiveProfileTab() {
				let targetTab = '';
				// 1. Priority to URL Hash (#policies)
				if (window.location.hash) {
					targetTab = window.location.hash.replace('#', '').trim();
				}
				// 2. Query param (?tab=policies)
				if (!targetTab) {
					try {
						const params = new URLSearchParams(window.location.search);
						targetTab = params.get('tab') || '';
					} catch (e) {}
				}
				// 3. Session storage
				if (!targetTab) {
					try {
						targetTab = sessionStorage.getItem('dawa24_active_tab_' + window.location.pathname) || '';
					} catch (e) {}
				}

				if (targetTab && ['catalog', 'sections', 'policies', 'branches', 'reviews'].includes(targetTab)) {
					switchProfileTab(targetTab, false);
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', restoreActiveProfileTab);
			} else {
				restoreActiveProfileTab();
			}
			window.addEventListener('hashchange', function() {
				restoreActiveProfileTab();
			});

			function switchCatalogView(view) {
				const tbl = document.getElementById('catalog-table-view');
				const grd = document.getElementById('catalog-grid-view');
				const tblBtn = document.getElementById('cat-view-table-btn');
				const grdBtn = document.getElementById('cat-view-grid-btn');

				if (view === 'grid') {
					if (tbl) tbl.style.display = 'none';
					if (grd) grd.style.display = 'grid';
					if (tblBtn) { tblBtn.classList.remove('btn-primary'); tblBtn.classList.add('btn-secondary'); }
					if (grdBtn) { grdBtn.classList.remove('btn-secondary'); grdBtn.classList.add('btn-primary'); }
				} else {
					if (tbl) tbl.style.display = 'block';
					if (grd) grd.style.display = 'none';
					if (tblBtn) { tblBtn.classList.remove('btn-secondary'); tblBtn.classList.add('btn-primary'); }
					if (grdBtn) { grdBtn.classList.remove('btn-primary'); grdBtn.classList.add('btn-secondary'); }
				}
			}
		</script>
	}
}
