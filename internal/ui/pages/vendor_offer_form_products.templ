package pages

import (
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// VendorOfferFormProducts renders the dynamic product picker and selected items table in the offer form.
templ VendorOfferFormProducts(isEdit bool, lang string) {
	<div class="glass-panel p-6 d-flex flex-col gap-4">
		<div class="flex-between items-center flex-wrap gap-4 pb-3 border-b">
			<div class="stack-sm">
				<div class="d-flex items-center gap-2">
					<span class="text-xl">@components.IconPill("icon-sm")</span>
					<h3 class="text-lg font-black text-primary m-0">
						{ i18n.T(lang, "vendor_offer_form.products_section_title") }
					</h3>
				</div>
				<p class="text-xs text-secondary mt-1 mb-0">
					{ i18n.T(lang, "vendor_offer_form.products_section_desc") }
				</p>
			</div>
			
			<div class="text-xs font-bold text-brand bg-surface-sunken p-2 px-3 rounded-lg border">
				<span>{ i18n.T(lang, "vendor_offer_form.added_products_count") } </span>
				<strong class="tabular-nums font-black" x-text="selectedItems.length"></strong>
			</div>
		</div>

		<!-- Product Search & Picker Box -->
		<div class="position-relative">
			<label class="form-label text-xs font-bold text-primary mb-1 d-block">
				{ i18n.T(lang, "vendor_offer_form.lbl_search_products") }
			</label>
			<div class="d-flex gap-2">
				<input
					type="text"
					x-model="searchQuery"
					@focus="showDropdown = true"
					@input="showDropdown = true"
					placeholder={ i18n.T(lang, "vendor_offer_form.search_products_placeholder") }
					class="form-input text-xs flex-1"
				/>
				<button type="button" @click="showDropdown = !showDropdown" class="btn btn-secondary btn-sm text-xs font-bold px-3">
					<span x-text={ "showDropdown ? '" + i18n.T(lang, "vendor_offer_form.btn_close_items") + "' : '" + i18n.T(lang, "vendor_offer_form.btn_browse_items") + "'" }></span>
				</button>
			</div>

			<!-- Autocomplete Results Dropdown -->
			<div
				x-show="showDropdown"
				@click.outside="showDropdown = false"
				class="position-absolute z-50 w-full bg-surface-raised border rounded-xl shadow-2xl p-2 mt-1 overflow-y-auto"
				x-cloak
			>
				<template x-for="item in filteredItems" :key="item.variant_id">
					<div
						@click="addItem(item)"
						class="p-2 rounded-lg cursor-pointer d-flex items-center justify-between gap-3 border-b text-xs transition-colors"
					>
						<div class="d-flex items-center gap-2">
							<span class="text-base">@components.IconPackage("icon-sm")</span>
							<div class="stack-sm">
								<strong class="text-primary font-bold d-block" x-text="item.name_ar || item.name_en || item.sku"></strong>
								<div class="text-muted text-xs tabular-nums">
									<span x-text="'SKU: ' + item.sku"></span>
									<span x-show="item.batch_number" x-text="' • ' + item.batch_number"></span>
									<span x-show="item.warehouse_name" x-text="' • ' + item.warehouse_name"></span>
								</div>
							</div>
						</div>
						<div class="text-end">
							<span class="badge badge-emerald text-xs tabular-nums font-bold" x-text="item.available_stock"></span>
							<div class="text-primary font-extrabold tabular-nums mt-1" x-text="item.price"></div>
						</div>
					</div>
				</template>
				<div x-show="filteredItems.length === 0" class="p-4 text-center text-xs text-muted">
					{ i18n.T(lang, "vendor_offer_form.no_search_results") }
				</div>
			</div>
		</div>

		<!-- Selected Items Table -->
		<div class="table-container m-0 border rounded-xl overflow-hidden mt-2">
			<table class="data-table m-0">
				<thead>
					<tr>
						<th class="text-center">{ i18n.T(lang, "vendor_offer_form.th_index") }</th>
						<th>{ i18n.T(lang, "vendor_offer_form.th_drug_batch") }</th>
						<th>{ i18n.T(lang, "vendor_offer_form.th_warehouse_stock") }</th>
						<th class="text-center">{ i18n.T(lang, "vendor_offer_form.th_qty") }</th>
						<th class="text-end">{ i18n.T(lang, "vendor_offer_form.th_public_price") }</th>
						<th class="text-center">{ i18n.T(lang, "vendor_offer_form.th_discount_pct") }</th>
						<th class="text-end">{ i18n.T(lang, "vendor_offer_form.th_price_after_disc") }</th>
						<th class="text-end">{ i18n.T(lang, "vendor_offer_form.th_net_total") }</th>
						<th class="text-center">{ i18n.T(lang, "vendor_offer_form.th_delete") }</th>
					</tr>
				</thead>
				<tbody>
					<template x-for="(item, idx) in selectedItems" :key="item.variant_id">
						<tr>
							<td class="d-none">
								<input type="hidden" name="selected_variants" :value="item.variant_id"/>
								<input type="hidden" :name="'qty_' + item.variant_id" :value="item.qty"/>
								<input type="hidden" :name="'discount_pct_' + item.variant_id" :value="item.discount_pct"/>
								<input type="hidden" :name="'custom_price_' + item.variant_id" :value="item.custom_price"/>
							</td>

							<td class="text-center text-xs text-muted tabular-nums font-bold" x-text="idx + 1"></td>
							
							<td>
								<strong class="text-primary text-xs font-black d-block" x-text="item.name"></strong>
								<div class="text-xs text-muted tabular-nums mt-0.5">
									<span x-text="'SKU: ' + item.sku"></span>
									<span x-show="item.batch" x-text="' • ' + item.batch"></span>
								</div>
							</td>

							<td>
								<div class="text-xs font-bold text-primary" x-text="item.warehouse || '-'"></div>
								<span class="badge badge-emerald text-xs tabular-nums font-bold mt-1" x-text="item.stock"></span>
							</td>

							<td>
								<input
									type="number"
									x-model.number="item.qty"
									min="1"
									:max="item.stock || 9999"
									class="form-input text-xs tabular-nums text-center w-full"
								/>
							</td>

							<td class="text-end tabular-nums font-bold text-xs text-primary" x-text="item.original_price_str"></td>

							<td>
								<div class="position-relative">
									<input
										type="number"
										step="0.1"
										min="0"
										max="100"
										x-model.number="item.discount_pct"
										@input="onDiscountChange(item)"
										placeholder="0%"
										class="form-input text-xs tabular-nums text-center w-full"
									/>
								</div>
							</td>

							<td>
								<div class="position-relative">
									<input
										type="number"
										step="0.01"
										min="0"
										x-model.number="item.custom_price"
										@input="onPriceChange(item)"
										class="form-input text-xs tabular-nums text-center w-full font-bold text-brand"
									/>
								</div>
							</td>

							<td class="text-end tabular-nums font-black text-xs text-primary" x-text="((item.qty || 1) * (item.custom_price || 0)).toFixed(2)"></td>

							<td class="col-actions">
								<button
									type="button"
									@click="removeItem(idx)"
									class="btn btn-secondary btn-icon btn-sm text-danger"
									title={ i18n.T(lang, "vendor_offer_form.th_delete") }
								>
									@components.IconX("icon-sm")
								</button>
							</td>
						</tr>
					</template>

					<tr x-show="selectedItems.length === 0">
						<td colspan="9" class="p-8 text-center text-muted text-xs">
							<div class="text-2xl mb-2">@components.IconPackage("icon-sm")</div>
							<p class="m-0 font-bold">{ i18n.T(lang, "vendor_offer_form.empty_items_title") }</p>
							<span class="text-xs text-secondary">{ i18n.T(lang, "vendor_offer_form.empty_items_desc") }</span>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<div class="flex-between items-center gap-3 pt-4 border-t mt-3">
			<a href="/vendor/offers" class="btn btn-secondary font-bold text-xs px-5">
				{ i18n.T(lang, "vendor_offer_form.btn_cancel") }
			</a>
			<button type="submit" class="btn btn-primary font-black text-sm px-8 py-2.5">
				@components.IconCheck("icon-xs")
				if isEdit {
					<span>{ i18n.T(lang, "vendor_offer_form.btn_submit_edit") }</span>
				} else {
					<span>{ i18n.T(lang, "vendor_offer_form.btn_submit_new") }</span>
				}
			</button>
		</div>
	</div>
}
