package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ OffersPage(lang, dir string, offers []*promo.Offer) {
	if actor, ok := authctx.From(ctx); ok && (actor.Role == "pharmacy" || actor.Role == "chain_pharmacy") {
		@layouts.PharmacyShell("العروض المتاحة والتخفيضات | Pharmacy Offers", "offers", lang, dir, nil) {
			@OffersContent(lang, offers)
		}
	} else {
		@layouts.CustomerShell("العروض الحصرية والتخفيضات | Exclusive Offers", lang, dir) {
			@OffersContent(lang, offers)
		}
	}
}

templ OffersContent(lang string, offers []*promo.Offer) {
	<div style="display:flex; flex-direction:column; gap:var(--space-6);">

		<!-- Header Banner -->
		<div class="card" style="background:linear-gradient(135deg, var(--accent-subtle) 0%, var(--surface-raised) 100%); border:1px solid var(--accent); margin-bottom:0; padding:var(--space-6);">
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:var(--space-4);">
				<div>
					<div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-2);">
						<span class="badge badge-emerald" style="font-weight:700;">عروض نشطة ومباشرة</span>
						<span class="badge badge-sky">تغطية جغرافية معتمدة</span>
					</div>
					<h2 style="font-size:var(--text-2xl); font-weight:800; color:var(--text); margin:0 0 var(--space-2);">
						العروض والتخفيضات المتاحة للتوريد الدوائي
					</h2>
					<p style="font-size:var(--text-sm); color:var(--text-secondary); max-width:620px; margin:0; line-height:1.6;">
						استفد من خصومات كبرى شركات الأدوية والموزعين المعتمدين في منطقتك، مع إمكانية الطلب المباشر وإصدار فواتير إلكترونية فورية.
					</p>
				</div>
				<a href="/catalog" class="btn btn-primary" style="font-weight:700;">
					@components.IconPackage("icon-xs")
					<span>تصفح كافة الأصناف</span>
				</a>
			</div>
		</div>

		<!-- Section 1: Featured Supplier Offers (عروض الموردين المباشرة) -->
		<div>
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-4);">
				<div style="display:flex; align-items:center; gap:var(--space-2);">
					@components.IconTag("icon-sm")
					<h3 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">
						عروض التوريد الحصرية والتخفيضات المعتمدة
					</h3>
				</div>
				<span style="font-size:var(--text-xs); color:var(--text-muted); font-weight:600;">
					{ fmt.Sprintf("%d عروض متاحة في نطاق تغطيتك", len(offers)) }
				</span>
			</div>

			if len(offers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لا توجد عروض نشطة حالياً",
					Message:     "يتم تحديث العروض الدوائية والتخفيضات أسبوعياً من كبرى الشركات المعتمدة.",
					ActionLabel: "تصفح كتالوج الأدوية",
				})
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:var(--space-5);">
					for _, o := range offers {
						<div class="card" style="margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-raised); padding:var(--space-5); transition:border-color 150ms;">
							<div>
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-3);">
									<span class="badge badge-emerald" style="font-weight:700; font-size:11px;">عرض سارٍ</span>
									<span class="badge badge-rose" style="font-weight:800; font-size:12px; padding:2px 8px;">
										خصم { o.DiscountValue.String() }
										if o.DiscountType == promo.DiscountPercentage {
											{ "%" }
										}
									</span>
								</div>

								<h4 style="font-size:var(--text-base); font-weight:700; color:var(--text); margin:0 0 var(--space-2); line-height:1.4;">
									{ o.Title.Get(i18n.Lang(lang)) }
								</h4>
								<p style="font-size:var(--text-xs); color:var(--text-secondary); margin:0 0 var(--space-4); line-height:1.6;">
									{ o.Description.Get(i18n.Lang(lang)) }
								</p>
							</div>

							<div style="border-top:1px solid var(--border); padding-top:var(--space-3); margin-top:var(--space-2); display:flex; justify-content:space-between; align-items:center;">
								<span style="font-size:var(--text-xs); color:var(--text-muted);">
									ينتهي في: <strong class="tabular-nums" style="color:var(--text);">{ o.ExpiresAt.Format("2006-01-02") }</strong>
								</span>
								<a href={ templ.SafeURL(fmt.Sprintf("/offers/%d", o.ID)) } class="btn btn-primary btn-sm" style="font-weight:600; font-size:var(--text-xs); padding:0.35rem 0.85rem;">
									<span>تفاصيل العرض والطلب</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ OfferDetail(lang, dir string, o *promo.Offer) {
	if actor, ok := authctx.From(ctx); ok && (actor.Role == "pharmacy" || actor.Role == "chain_pharmacy") {
		@layouts.PharmacyShell("تفاصيل العرض | Offer Detail", "offers", lang, dir, nil) {
			@OfferDetailContent(lang, o)
		}
	} else {
		@layouts.CustomerShell("تفاصيل العرض | Offer Detail", lang, dir) {
			@OfferDetailContent(lang, o)
		}
	}
}

templ OfferDetailContent(lang string, o *promo.Offer) {
	<div style="max-width:680px; margin:0 auto;">
		<div class="card" style="margin-bottom:0; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:var(--space-6);">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-4);">
				<span class="badge badge-emerald" style="font-weight:700;">عرض معتمد ونشط</span>
				<a href="/offers" style="font-size:var(--text-xs); color:var(--accent); text-decoration:none; font-weight:600;">← العودة لكافة العروض</a>
			</div>

			<h2 style="font-size:var(--text-2xl); font-weight:800; color:var(--text); margin:0 0 var(--space-3); line-height:1.3;">
				{ o.Title.Get(i18n.Lang(lang)) }
			</h2>
			<p style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.7; margin-bottom:var(--space-5);">
				{ o.Description.Get(i18n.Lang(lang)) }
			</p>

			<div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-4); margin-bottom:var(--space-6);">
				<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:var(--space-4);">
					<div style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--space-1);">نسبة وقيمة الخصم</div>
					<div style="font-size:var(--text-2xl); font-weight:800; color:var(--accent);" class="tabular-nums">
						{ o.DiscountValue.String() }
						if o.DiscountType == promo.DiscountPercentage {
							{ "%" }
						}
					</div>
				</div>
				<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:var(--space-4);">
					<div style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--space-1);">صلاحية العرض حتى</div>
					<div style="font-size:var(--text-lg); font-weight:700; color:var(--text);" class="tabular-nums">
						{ o.ExpiresAt.Format("2006-01-02") }
					</div>
				</div>
			</div>

			<div style="display:flex; gap:var(--space-3);">
				<a href="/catalog" class="btn btn-primary" style="flex:1; justify-content:center; font-weight:700; font-size:var(--text-sm); padding:0.65rem;">
					@components.IconCart("icon-xs")
					<span>تطبيق الخصم وبدء الطلب من الكتالوج</span>
				</a>
			</div>
		</div>
	</div>
}

