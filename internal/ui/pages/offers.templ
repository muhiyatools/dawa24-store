package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ OffersPage(lang, dir string, offers []*promo.Offer) {
	if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
		@layouts.CustomerShell("العروض المتاحة والتخفيضات | Pharmacy Offers", "offers", lang, dir, nil) {
			@OffersContent(lang, offers)
		}
	} else {
		@layouts.PublicShell("العروض الحصرية والتخفيضات | Exclusive Offers", lang, dir) {
			@OffersContent(lang, offers)
		}
	}
}

templ OffersContent(lang string, offers []*promo.Offer) {
	<div class="page-container">

		<!-- Header Banner -->
		<div class="glass-panel p-6">
			<div class="flex-between flex-wrap gap-4">
				<div>
					<div class="d-flex items-center gap-2 mb-2">
						<span class="badge badge-emerald font-bold">عروض نشطة ومباشرة</span>
						<span class="badge badge-sky">تغطية جغرافية معتمدة</span>
					</div>
					<h2 class="text-2xl font-black text-primary mb-2">
						العروض والتخفيضات المتاحة للتوريد الدوائي
					</h2>
					<p class="text-xs text-secondary max-w-2xl m-0 leading-relaxed">
						استفد من خصومات كبرى شركات الأدوية والموزعين المعتمدين في منطقتك، مع إمكانية الطلب المباشر وإصدار فواتير إلكترونية فورية.
					</p>
				</div>
				<a href="/catalog" class="btn btn-primary font-bold">
					@components.IconPackage("icon-xs")
					<span>تصفح كافة الأصناف</span>
				</a>
			</div>
		</div>

		<!-- Section 1: Featured Supplier Offers (عروض الموردين المباشرة) -->
		<div>
			<div class="flex-between items-center mb-4">
				<div class="d-flex items-center gap-2">
					@components.IconTag("icon-sm")
					<h3 class="text-lg font-extrabold text-primary m-0">
						عروض التوريد الحصرية والتخفيضات المعتمدة
					</h3>
				</div>
				<span class="text-xs text-muted font-bold">
					{ fmt.Sprintf("%d عروض متاحة في نطاق تغطيتك", len(offers)) }
				</span>
			</div>

			if len(offers) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "لا توجد عروض نشطة حالياً",
					Message:     "يتم تحديث العروض الدوائية والتخفيضات أسبوعياً من كبرى الشركات المعتمدة.",
					ActionLabel: "تصفح كتالوج الأدوية",
				})
			} else {
				<div class="product-grid-wrapper">
					for _, o := range offers {
						<div class="glass-panel p-5 d-flex flex-col justify-between">
							<div>
								<div class="flex-between items-center mb-3">
									<span class="badge badge-emerald font-bold text-xs">عرض سارٍ</span>
									<span class="badge badge-rose font-extrabold text-xs">
										خصم { o.DiscountValue.String() }
										if o.DiscountType == promo.DiscountPercentage {
											{ "%" }
										}
									</span>
								</div>

								<h4 class="text-base font-bold text-primary mb-2 leading-snug">
									{ o.Title.Get(i18n.Lang(lang)) }
								</h4>
								<p class="text-xs text-secondary mb-4 leading-relaxed">
									{ o.Description.Get(i18n.Lang(lang)) }
								</p>
							</div>

							<div class="border-t pt-3 mt-2 flex-between items-center">
								<span class="text-xs text-muted">
									ينتهي في: <strong class="tabular-nums text-primary">{ o.ExpiresAt.Format("2006-01-02") }</strong>
								</span>
								<a href={ templ.SafeURL(fmt.Sprintf("/offers/%d", o.ID)) } class="btn btn-primary btn-sm font-semibold text-xs">
									<span>تفاصيل العرض والطلب</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ OfferDetail(lang, dir string, o *promo.Offer) {
	if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
		@layouts.CustomerShell("تفاصيل العرض | Offer Detail", "offers", lang, dir, nil) {
			@OfferDetailContent(lang, o)
		}
	} else {
		@layouts.PublicShell("تفاصيل العرض | Offer Detail", lang, dir) {
			@OfferDetailContent(lang, o)
		}
	}
}

templ OfferDetailContent(lang string, o *promo.Offer) {
	<div class="max-w-2xl mx-auto">
		<div class="glass-panel p-6">
			<div class="flex-between items-center mb-4">
				<span class="badge badge-emerald font-bold">عرض معتمد ونشط</span>
				<a href="/offers" class="text-xs text-brand text-decoration-none font-bold">← العودة لكافة العروض</a>
			</div>

			<h2 class="text-2xl font-black text-primary mb-3 leading-tight">
				{ o.Title.Get(i18n.Lang(lang)) }
			</h2>
			<p class="text-sm text-secondary leading-relaxed mb-5">
				{ o.Description.Get(i18n.Lang(lang)) }
			</p>

			<div class="d-grid grid-cols-2 gap-4 mb-6">
				<div class="bg-surface-sunken border rounded-lg p-4">
					<div class="text-xs text-muted mb-1">نسبة وقيمة الخصم</div>
					<div class="text-2xl font-black text-brand tabular-nums">
						{ o.DiscountValue.String() }
						if o.DiscountType == promo.DiscountPercentage {
							{ "%" }
						}
					</div>
				</div>
				<div class="bg-surface-sunken border rounded-lg p-4">
					<div class="text-xs text-muted mb-1">صلاحية العرض حتى</div>
					<div class="text-lg font-bold text-primary tabular-nums">
						{ o.ExpiresAt.Format("2006-01-02") }
					</div>
				</div>
			</div>

			<div class="d-flex gap-3">
				<a href="/catalog" class="btn btn-primary flex-1 justify-center font-bold text-sm py-2">
					@components.IconCart("icon-xs")
					<span>تطبيق الخصم وبدء الطلب من الكتالوج</span>
				</a>
			</div>
		</div>
	</div>
}

