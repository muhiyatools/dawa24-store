package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerCatalogTable(variants []*SupplierVariantCard, lang string) {
	<div class="glass-panel p-0 mb-6 overflow-hidden shadow-xs border rounded-2xl">
		<div class="table-container m-0 overflow-x-auto">
			<table class="catalog-data-table m-0 w-full">
				<thead>
					<tr>
						<th class="col-product">الصنف الدوائي والتفاصيل</th>
						<th class="col-brand">الشركة المصنعة</th>
						<th class="col-supplier">المورد والفرع</th>
						<th class="col-stock text-center">المخزون والصلاحية</th>
						<th class="col-public-price text-start">سعر الجمهور</th>
						<th class="col-price text-start">سعر التوريد الصافي</th>
						<th class="col-discount text-center">نسبة الخصم</th>
						<th class="col-action text-center">الطلب والإجراءات</th>
					</tr>
				</thead>
				<tbody>
					for _, v := range variants {
						<tr>
							<!-- Col 1: Product info, image, dosage, active ingredient -->
							<td class="col-product">
								<div class="d-flex items-center gap-2.5">
									<div class="catalog-thumb-box">
										if v.ProductImage != "" {
											<img src={ v.ProductImage } alt={ v.ProductNameAr } class="w-full h-full object-contain p-0.5" loading="lazy" />
										} else {
											<span class="text-muted">
												@components.IconPill("icon-xs")
											</span>
										}
									</div>
									<div class="stack-2xs min-w-0 flex-1">
										<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="text-inherit no-underline block">
											<div class="font-black text-primary text-xs transition-colors hover-text-brand leading-snug">
												if v.ProductNameAr != "" {
													{ v.ProductNameAr }
												} else {
													{ v.ProductNameEn }
												}
											</div>
										</a>
										<div class="d-flex items-center gap-1.5 flex-wrap">
											if v.DosageForm != "" {
												<span class="badge badge-slate text-2xs font-semibold py-0 px-1.5">
													{ v.DosageForm }
												</span>
											}
											if v.ScientificName != "" {
												<span class="text-2xs text-muted font-medium">
													{ v.ScientificName }
												</span>
											}
										</div>
										if v.IsSponsored {
											<div class="mt-0.5">
												@components.SponsoredBadge(lang)
											</div>
										}
									</div>
								</div>
							</td>

							<!-- Col 2: Manufacturer / Brand -->
							<td class="col-brand">
								<div class="font-bold text-primary text-xs">
									if v.BrandName != "" {
										{ v.BrandName }
									} else if v.Manufacturer != "" {
										{ v.Manufacturer }
									} else {
										<span class="text-muted">-</span>
									}
								</div>
							</td>

							<!-- Col 3: Supplier & Branch & Distance -->
							<td class="col-supplier">
								<div class="d-flex items-center gap-1.5 flex-wrap">
									<span class="font-extrabold text-primary text-xs">{ v.SupplierName }</span>
									if v.IsVerified {
										<span class="badge badge-emerald text-2xs font-bold py-0 px-1">معتمد</span>
									}
								</div>
								<div class="d-flex items-center gap-1 mt-0.5">
									if v.BranchName != "" {
										<span class="text-2xs text-muted font-medium">
											{ v.BranchName }
										</span>
									}
									if v.DistanceText != "" {
										<span class="badge badge-sky text-2xs font-mono py-0 px-1">
											{ v.DistanceText }
										</span>
									}
								</div>
							</td>

							<!-- Col 4: Stock & Expiry -->
							<td class="col-stock text-center">
								if v.AvailableStock > 0 {
									<span class="badge badge-emerald font-extrabold text-2xs tabular-nums">
										{ fmt.Sprintf("%d", v.AvailableStock) } عبوة
									</span>
								} else {
									<span class="badge badge-rose font-extrabold text-2xs">
										نفد المخزون
									</span>
								}
								if v.ExpiryDate != "" {
									<div class="text-2xs text-muted tabular-nums mt-0.5 font-mono">
										{ v.ExpiryDate }
									</div>
								}
							</td>

							<!-- Col 5: Public Price (سعر الجمهور) -->
							<td class="col-public-price">
								if v.PublicPrice.IsPositive() {
									<div class="d-flex items-baseline gap-1 font-black text-primary text-sm tabular-nums">
										<span>{ v.PublicPrice.String() }</span>
										<span class="text-2xs font-bold text-secondary">ج.م</span>
									</div>
								} else {
									<span class="text-xs text-muted font-bold">-</span>
								}
							</td>

							<!-- Col 6: Net Supply Price (سعر التوريد الصافي) -->
							<td class="col-price">
								<div class="d-flex items-baseline gap-1 font-black text-brand text-sm tabular-nums">
									<span>{ v.Price.String() }</span>
									<span class="text-2xs font-bold text-secondary">ج.م</span>
								</div>
							</td>

							<!-- Col 7: Discount Percentage (نسبة الخصم) -->
							<td class="col-discount text-center">
								if v.DiscountPercent > 0 {
									<span class="badge badge-emerald font-black text-xs tabular-nums py-0.5 px-2 shadow-2xs">
										-{ fmt.Sprintf("%d%%", v.DiscountPercent) }
									</span>
								} else {
									<span class="text-xs text-muted font-bold">-</span>
								}
							</td>

							<!-- Col 8: Cart & Favorite Actions -->
							<td class="col-actions col-action">
								<div class="table-actions">
									<!-- Favorite Button -->
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", v.ProductID)) } class="m-0">
										<button
											type="submit"
											class={ "btn btn-icon btn-xs", templ.KV("btn-secondary text-rose", v.IsFavorite), templ.KV("btn-ghost text-muted", !v.IsFavorite) }
											title="حفظ في المفضلة"
										>
											if v.IsFavorite {
												@components.IconHeartFilled("icon-xs text-rose")
											} else {
												@components.IconHeart("icon-xs")
											}
										</button>
									</form>

									if v.CanAddToCart {
										<form method="POST" action="/cart/add" class="d-flex items-center gap-1 m-0">
											<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.VariantID) } />
											<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
											<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
											<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
											<input type="hidden" name="offer_price" value={ v.Price.String() } />
											<input type="hidden" name="qty" value={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) } />
											
											<button type="submit" class="btn btn-primary btn-xs font-bold shadow-2xs gap-1 px-2.5">
												@components.IconPlus("icon-2xs")
												<span>للسلة</span>
											</button>
										</form>
									} else {
										<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="btn btn-secondary btn-xs font-bold shadow-2xs">
											التفاصيل
										</a>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}