package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminProductsImportReport renders the outcome of a bulk catalogue import.
//
// It is a page and not a toast because an import has more to say than a
// sentence: which worksheet was read, how each column was interpreted, how many
// rows landed, and exactly which rows need the admin's attention. Redirecting
// with the message in the query string — what this replaced — put a wall of
// percent-encoded Arabic in the address bar and threw the detail away.
templ AdminProductsImportReport(lang, dir string, view ImportReportView) {
	@layouts.AdminShell("نتيجة استيراد الأصناف", "import", lang, dir) {
		<div class="import-report">
			@importBanner(view)
			if view.Fatal == "" {
				@importStats(view)
			}
			if len(view.Bindings) > 0 {
				@importBindings(view)
			}
			if view.HasFindings() {
				@importFindings(view)
			}
			<div class="import-actions">
				<a href="/admin/products/import" class="btn btn-secondary">استيراد ملف آخر</a>
				<a href="/admin/products" class="btn btn-primary">عرض الكتالوج المعتمد</a>
			</div>
		</div>
	}
}

templ importBanner(view ImportReportView) {
	<div class={ "import-banner", templ.KV("import-banner--error", view.Fatal != ""), templ.KV("import-banner--ok", view.Fatal == "") }>
		<h1 class="import-banner-title">{ view.Title }</h1>
		if view.Fatal != "" {
			<p class="import-banner-text">{ view.Fatal }</p>
			if view.FatalDetail != "" {
				<p class="import-banner-detail">{ view.FatalDetail }</p>
			}
		} else if summary := view.Summary(); summary != "" {
			<p class="import-banner-text">{ summary }</p>
		}
		if view.FileName != "" {
			<p class="import-banner-detail">
				{ fmt.Sprintf("الملف: %s", view.FileName) }
				if view.Source != "" {
					{ fmt.Sprintf(" — %s", view.Source) }
				}
			</p>
		}
		for _, sheet := range view.SheetsSkipped {
			<p class="import-banner-detail">
				{ fmt.Sprintf("تنبيه: ورقة العمل «%s» تحتوي على بيانات ولم تتم قراءتها. تتم قراءة ورقة واحدة فقط في كل عملية استيراد.", sheet) }
			</p>
		}
	</div>
}

templ importStats(view ImportReportView) {
	<div class="import-stats">
		@importStat(fmt.Sprintf("%d", view.Inserted), "صنف جديد", "ok")
		@importStat(fmt.Sprintf("%d", view.Updated), "صنف محدَّث", "ok")
		@importStat(fmt.Sprintf("%d", view.RowsRead), "صف تمت قراءته", "")
		@importStat(fmt.Sprintf("%d", view.Skipped), "صف فارغ أو مكرر الطباعة", "")
		if view.Merged > 0 {
			@importStat(fmt.Sprintf("%d", view.Merged), "صف مكرر تم دمجه", "warn")
		}
		if view.Rejected > 0 {
			@importStat(fmt.Sprintf("%d", view.Rejected), "صف مرفوض", "error")
		}
		if view.BrandsCreated > 0 {
			@importStat(fmt.Sprintf("%d", view.BrandsCreated), "شركة مصنعة جديدة", "")
		}
	</div>
}

templ importStat(value, label, tone string) {
	<div class={ "import-stat", templ.KV("import-stat--ok", tone == "ok"), templ.KV("import-stat--warn", tone == "warn"), templ.KV("import-stat--error", tone == "error") }>
		<span class="import-stat-value">{ value }</span>
		<span class="import-stat-label">{ label }</span>
	</div>
}

// importBindings shows how each column of the uploaded file was interpreted, so
// an admin can confirm the reading before trusting the catalogue — a column
// mapped with low confidence is exactly what they should check.
templ importBindings(view ImportReportView) {
	<div class="card mb-0">
		<h2 class="import-section-title">كيف تمت قراءة أعمدة الملف</h2>
		<p class="import-note">
			تعرّف النظام تلقائياً على الأعمدة التالية. يرجى مراجعة أي عمود بثقة «منخفضة» للتأكد من صحة الاستيراد.
		</p>
		<div class="table-container">
			<table class="data-table">
				<thead>
					<tr>
						<th>العمود</th>
						<th>عنوان العمود في الملف</th>
						<th>الحقل المرتبط</th>
						<th>درجة الثقة</th>
					</tr>
				</thead>
				<tbody>
					for _, b := range view.Bindings {
						<tr>
							<td class="tabular-nums">{ b.Column }</td>
							<td>{ b.Header }</td>
							<td>{ b.Field }</td>
							<td>
								<span class={ "badge", importConfidenceBadge(b.Confidence) }>{ b.Confidence }</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(view.Unmapped) > 0 {
			<p class="import-note">أعمدة لم يتم ربطها بأي حقل وتم تجاهل محتواها:</p>
			<div class="import-chip-list">
				for _, header := range view.Unmapped {
					<span class="badge badge-slate">{ header }</span>
				}
			</div>
		}
	</div>
}

templ importFindings(view ImportReportView) {
	<div class="card mb-0">
		<h2 class="import-section-title">
			{ fmt.Sprintf("ملاحظات على البيانات (%d خطأ، %d تنبيه)", len(view.Errors), len(view.Warnings)) }
		</h2>
		<p class="import-note">
			أرقام الصفوف مطابقة لأرقام الصفوف في ملف Excel، ليسهل الرجوع إليها وتصحيحها.
		</p>
		<div class="table-container import-scroll">
			<table class="data-table">
				<thead>
					<tr>
						<th>الصف</th>
						<th>النوع</th>
						<th>العمود</th>
						<th>القيمة</th>
						<th>التفاصيل</th>
					</tr>
				</thead>
				<tbody>
					for _, issue := range view.Errors {
						@importFindingRow(issue)
					}
					for _, issue := range view.Warnings {
						@importFindingRow(issue)
					}
				</tbody>
			</table>
		</div>
		if view.TruncatedIssues {
			<p class="import-note">
				تم عرض أول { fmt.Sprintf("%d", maxRenderedIssues) } ملاحظة فقط. الأعداد الظاهرة أعلاه تشمل جميع الملاحظات.
			</p>
		}
	</div>
}

templ importFindingRow(issue catalog.RowIssue) {
	<tr>
		<td class="tabular-nums">{ IssueRowLabel(issue) }</td>
		<td>
			if issue.Severity == catalog.SeverityError {
				<span class="badge badge-rose">خطأ</span>
			} else {
				<span class="badge badge-amber">تنبيه</span>
			}
		</td>
		<td>
			if issue.Column != "" {
				{ issue.Column }
			} else {
				—
			}
		</td>
		<td>
			if issue.Value != "" {
				{ issue.Value }
			} else {
				—
			}
		</td>
		<td>{ issue.Message }</td>
	</tr>
}

// importConfidenceBadge picks the badge colour for a mapping confidence.
func importConfidenceBadge(confidence string) string {
	switch confidence {
	case "مؤكدة":
		return "badge-emerald"
	case "عالية":
		return "badge-sky"
	default:
		return "badge-amber"
	}
}
