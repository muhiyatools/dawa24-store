package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminOffersData struct {
	Offers       []*promo.SpecialOffer
	FilterStatus string
	Counts       map[string]int
}

func countAdminSpecialOffers(offers []*promo.SpecialOffer, status string) int {
	count := 0
	for _, o := range offers {
		if o == nil {
			continue
		}
		switch status {
		case "active":
			if o.AdminStatus == "approved" && o.Status == "active" {
				count++
			}
		case "pending":
			if o.AdminStatus == "pending" || o.AdminStatus == "" {
				count++
			}
		case "rejected":
			if o.AdminStatus == "rejected" {
				count++
			}
		case "draft", "inactive":
			if o.Status == "draft" || o.Status == "inactive" {
				count++
			}
		case "coverage":
			if len(o.Locations) > 0 {
				count++
			}
		}
	}
	return count
}

templ AdminOffers(data AdminOffersData, lang, dir string) {
	@layouts.AdminShell("إدارة العروض وباقات الموردين الخاصة", "offers", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							🎁
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">العروض وباقات الموردين الخاصة</h1>
							<p class="text-sm text-secondary m-0 mt-1">مراجعة واعتماد عروض وباقات الأدوية المجمعة المقدمة من الموردين، وإدارة التغطية الجغرافية وأسعار الباقات</p>
						</div>
					</div>
				</div>
			</div>

			<!-- KPI Summary Strip -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">إجمالي الباقات والعروض</span>
						<span class="text-brand">@components.IconShoppingBag("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-primary mt-2">
						{ fmt.Sprintf("%d", len(data.Offers)) }
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">العروض المعتمدة والنشطة</span>
						<span class="text-success">@components.IconCheckCircle("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-success mt-2">
						{ fmt.Sprintf("%d", countAdminSpecialOffers(data.Offers, "active")) }
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">بانتظار المراجعة والاعتماد</span>
						<span class="text-warning">@components.IconClock("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-warning mt-2">
						{ fmt.Sprintf("%d", countAdminSpecialOffers(data.Offers, "pending")) }
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="flex-between items-center">
						<span class="text-xs font-bold text-muted">عروض ذات تغطية جغرافية</span>
						<span class="text-cyan">@components.IconMapPin("icon-sm")</span>
					</div>
					<div class="tabular-nums text-2xl font-black text-cyan mt-2">
						{ fmt.Sprintf("%d", countAdminSpecialOffers(data.Offers, "coverage")) }
					</div>
				</div>
			</div>

			<!-- Status Filter Tabs -->
			<div class="glass-panel p-6 mb-6">
				<div class="cb-tabs-nav m-0">
					<a href="/admin/offers" class={ "cb-tab-btn", templ.KV("active", data.FilterStatus == "" || data.FilterStatus == "all") }>
						<span>كافة العروض</span>
						<span class="badge badge-slate text-xs font-bold tabular-nums">{ fmt.Sprintf("%d", len(data.Offers)) }</span>
					</a>
					<a href="/admin/offers?status=pending" class={ "cb-tab-btn", templ.KV("active", data.FilterStatus == "pending") }>
						<span>بانتظار الاعتماد</span>
						if pendingCount := countAdminSpecialOffers(data.Offers, "pending"); pendingCount > 0 {
							<span class="badge badge-amber text-xs font-bold tabular-nums">{ fmt.Sprintf("%d", pendingCount) }</span>
						}
					</a>
					<a href="/admin/offers?status=active" class={ "cb-tab-btn", templ.KV("active", data.FilterStatus == "active") }>
						<span>المعتمدة والنشطة</span>
						<span class="badge badge-emerald text-xs font-bold tabular-nums">{ fmt.Sprintf("%d", countAdminSpecialOffers(data.Offers, "active")) }</span>
					</a>
					<a href="/admin/offers?status=draft" class={ "cb-tab-btn", templ.KV("active", data.FilterStatus == "draft") }>
						<span>المسودات والمعطلة</span>
						<span class="badge badge-slate text-xs font-bold tabular-nums">{ fmt.Sprintf("%d", countAdminSpecialOffers(data.Offers, "draft")) }</span>
					</a>
					<a href="/admin/offers?status=rejected" class={ "cb-tab-btn", templ.KV("active", data.FilterStatus == "rejected") }>
						<span>المرفوضة</span>
						<span class="badge badge-rose text-xs font-bold tabular-nums">{ fmt.Sprintf("%d", countAdminSpecialOffers(data.Offers, "rejected")) }</span>
					</a>
				</div>
			</div>

			<!-- Main Offers Table Card -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(data.Offers) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">🎁</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد عروض وباقات موردين</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يقم أي مورد بإدراج عروض خاصة حتى الآن.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>العرض / باقة الأدوية</th>
									<th>الشركة الموردة</th>
									<th>الأصناف والكميات المشمولة</th>
									<th>السعر قبل الخصم</th>
									<th>الخصم</th>
									<th>الحد الأدنى</th>
									<th>نطاق التغطية والمدن</th>
									<th class="text-center">حالة الاعتماد والنشر</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, o := range data.Offers {
									<tr>
										<!-- Offer Title & Info -->
										<td>
											<div style="display:flex; align-items:flex-start; gap:0.75rem;">
												<div style="width:40px; height:40px; border-radius:var(--radius-lg); background:var(--accent-subtle); border:1px solid var(--accent); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.25rem; flex-shrink:0;">
													🎁
												</div>
												<div>
													<div style="font-weight:800; color:var(--text); font-size:0.95rem;">
														{ o.Title.Get(i18n.Lang(lang)) }
													</div>
													if !o.Description.IsEmpty() {
														<div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px; max-width:260px; white-space:normal;">
															{ o.Description.Get(i18n.Lang(lang)) }
														</div>
													}
													<div style="font-size:0.7rem; color:var(--text-secondary); margin-top:3px;" class="tabular-nums">
														#{ fmt.Sprintf("%d", o.ID) } • { o.CreatedAt.Format("2006-01-02") }
													</div>
												</div>
											</div>
										</td>

										<!-- Supplier Org & Branch -->
										<td>
											<div style="font-weight:700; color:var(--accent); font-size:0.9rem;">
												if o.OrganizationName != "" {
													{ o.OrganizationName }
												} else {
													<span>مورد #{ fmt.Sprintf("%d", o.OrganizationID) }</span>
												}
											</div>
											if o.BranchName != "" {
												<div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">
													فرع: { o.BranchName }
												</div>
											} else {
												<div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">
													كافة الفروع
												</div>
											}
										</td>

										<!-- Bundled Products List -->
										<td>
											if len(o.Products) == 0 {
												<span style="color:var(--text-muted); font-size:0.8rem;">عرض عام (بدون باقة مخصصة)</span>
											} else {
												<div style="display:flex; flex-direction:column; gap:0.25rem;">
													for idx, p := range o.Products {
														if idx < 3 {
															<div style="font-size:0.8rem; color:var(--text); display:flex; align-items:center; gap:0.35rem;">
																<span class="badge badge-slate" style="font-weight:800; padding:0.1rem 0.35rem; font-size:0.7rem;" class="tabular-nums">
																	{ fmt.Sprintf("%dx", p.Quantity) }
																</span>
																<span style="font-weight:600;">
																	if p.VariantName != "" {
																		{ p.VariantName }
																	} else {
																		<span>صنف #{ fmt.Sprintf("%d", p.VariantID) }</span>
																	}
																</span>
																if !p.CustomPrice.IsZero() {
																	<span class="tabular-nums text-muted text-xs">({ p.CustomPrice.String() } ج.م)</span>
																}
															</div>
														}
													}
													if len(o.Products) > 3 {
														<div style="font-size:0.75rem; color:var(--accent); font-weight:700;">
															+ { fmt.Sprintf("%d أصناف أخرى", len(o.Products)-3) }
														</div>
													}
												</div>
											}
										</td>

										<!-- Total Price Before Discount -->
										<td>
											<div class="tabular-nums" style="font-weight:900; color:var(--emerald); font-size:1rem;">
												{ o.TotalPrice.String() } ج.م
											</div>
										</td>

										<!-- Discount -->
										<td>
											if o.DiscountPercentage > 0 {
												<div style="font-size:0.85rem; color:var(--accent); font-weight:800;" class="tabular-nums">
													{ fmt.Sprintf("%.1f%%", o.DiscountPercentage) }
												</div>
											} else {
												<div style="font-size:0.85rem; color:var(--accent); font-weight:800;" class="tabular-nums">
													{ o.DiscountAmount.String() } ج.م
												</div>
											}
										</td>

										<!-- Min Order Amount -->
										<td>
											if !o.MinOrderAmount.IsZero() {
												<div class="tabular-nums" style="font-size:0.85rem; font-weight:700; color:var(--text);">
													{ o.MinOrderAmount.String() } ج.م
												</div>
											} else {
												<span style="color:var(--text-muted); font-size:0.8rem;">بدون حد أدنى</span>
											}
										</td>

										<!-- Geographic Coverage -->
										<td>
											if len(o.Locations) == 0 {
												<span class="badge badge-slate text-xs">تغطية عامة</span>
											} else {
												<div style="display:flex; flex-direction:column; gap:0.2rem;">
													<div style="display:flex; align-items:center; gap:0.3rem;">
														@components.IconMapPin("icon-xs")
														<span style="font-weight:700; font-size:0.8rem; color:var(--sky);">
															{ fmt.Sprintf("%d مناطق/مدن", len(o.Locations)) }
														</span>
													</div>
													<div style="font-size:0.75rem; color:var(--text-secondary);">
														for idx, loc := range o.Locations {
															if idx < 2 && loc.CityName != "" {
																<span>{ loc.CityName }</span>
																if idx < len(o.Locations)-1 && idx < 1 {
																	<span>، </span>
																}
															}
														}
													</div>
												</div>
											}
										</td>

										<!-- Status & Moderation Badges -->
										<td>
											<div style="display:flex; flex-direction:column; gap:0.35rem; align-items:flex-start;">
												<!-- Admin Moderation Status -->
												if o.AdminStatus == "approved" {
													<span class="badge badge-emerald text-xs">معتمد من الإدارة</span>
												} else if o.AdminStatus == "rejected" {
													<span class="badge badge-rose text-xs">مرفوض</span>
												} else {
													<span class="badge badge-amber text-xs">قيد المراجعة</span>
												}

												<!-- Publishing / Active Status -->
												if o.Status == "active" {
													<span class="badge badge-sky text-xs">🟢 معروض ونشط</span>
												} else if o.Status == "draft" {
													<span class="badge badge-slate text-xs">📝 مسودة</span>
												} else {
													<span class="badge badge-slate text-xs">⚪ غير نشط</span>
												}
											</div>
										</td>

										<!-- Admin Action Buttons -->
										<td class="text-end">
											<div class="row-center-xs" style="justify-content:flex-end; gap:0.4rem;">
												if o.AdminStatus != "approved" {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers/%d/approve", o.ID)) } class="m-0">
														<button type="submit" class="btn btn-primary btn-sm fw-700" title="اعتماد ونشر العرض">
															@components.IconCheck("icon-xs")
															<span>اعتماد</span>
														</button>
													</form>
												}

												if o.AdminStatus != "rejected" {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers/%d/reject", o.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من رفض هذا العرض؟');">
														<button type="submit" class="btn btn-secondary btn-sm fw-700 text-danger" title="رفض العرض">
															@components.IconX("icon-xs")
															<span>رفض</span>
														</button>
													</form>
												}

												if o.Status == "active" {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers/%d/status", o.ID)) } class="m-0">
														<input type="hidden" name="active" value="false" />
														<button type="submit" class="btn btn-secondary btn-sm fw-700" title="إيقاف تفعيل العرض مؤقتاً">
															<span>تعطيل</span>
														</button>
													</form>
												} else {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/offers/%d/status", o.ID)) } class="m-0">
														<input type="hidden" name="active" value="true" />
														<button type="submit" class="btn btn-secondary btn-sm fw-700" title="تفعيل العرض">
															<span>تفعيل</span>
														</button>
													</form>
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

