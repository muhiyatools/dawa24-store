package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerCatalogResults(data CatalogPageData, lang string) {
	if len(data.Variants) == 0 {
		<div class="glass-panel p-10 text-center border rounded-2xl shadow-xs">
			<div class="w-12 h-12 rounded-full bg-primary-subtle text-primary d-flex items-center justify-center mx-auto mb-3">
				@components.IconSearch("icon-md")
			</div>
			<h3 class="text-base font-extrabold text-primary mb-1.5">لا توجد عروض توريد مطابقة لمعايير البحث</h3>
			<p class="text-xs text-secondary mb-4 max-w-md mx-auto">
				لم نعثر على أصناف دوائية مطابقة للبحث أو الفلاتر المحددة. جرب استخدام كلمات بحث بديلة أو إزالة بعض الفلاتر.
			</p>
			<a href="/catalog" class="btn btn-secondary btn-sm font-bold shadow-xs">
				عرض كافة الأصناف المتاحة
			</a>
		</div>
	} else {
		<!-- Mode Renderer -->
		if data.ViewMode == "table" {
			@CustomerCatalogTable(data.Variants, lang)
		} else {
			@CustomerCatalogGrid(data.Variants, lang)
		}

		<!-- Smart Pagination Bar -->
		@CustomerCatalogPagination(data)
	}
}

func getSponsoredTierLabel(tier int) string {
	switch tier {
	case 5:
		return "باقة ماسية"
	case 4:
		return "باقة بلاتينية"
	case 3:
		return "باقة ذهبية"
	case 2:
		return "باقة فضية"
	default:
		return "إعلان ممول"
	}
}

templ CustomerCatalogGrid(variants []*SupplierVariantCard, lang string) {
	<div class="product-grid-wrapper mb-6">
		for _, v := range variants {
			<div
				class={ "product-card-glass", templ.KV("is-sponsored", v.IsSponsored) }
				onclick={ templ.ComponentScript{Call: fmt.Sprintf("navigateToVariant(%d, %d)", v.VariantID, v.ProductID)} }
			>
				if v.IsSponsored {
					<div class="product-card-sponsored-bar">
						<div class="d-flex items-center gap-1.5">
							<span class="sponsored-star">★</span>
							<span class="sponsored-title">إعلان ممول</span>
						</div>
						if v.SponsoredTier > 0 {
							<span class="sponsored-tier-tag">{ getSponsoredTierLabel(v.SponsoredTier) }</span>
						}
					</div>
				}

				<div class="product-card-body">
					<!-- Top Visual Media Box -->
					<div class="product-card-media">
						if v.ProductImage != "" {
							<img src={ v.ProductImage } alt={ v.ProductNameAr } class="product-card-img" loading="lazy" />
						} else {
							<div class="product-card-placeholder">
								@components.IconPill("icon-lg")
								<span class="text-xs font-bold opacity-60">صورة الصنف</span>
							</div>
						}

						<!-- Favorite Button -->
						<div onclick="event.stopPropagation();" class="product-card-fav-btn">
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/toggle", v.ProductID)) } class="m-0 flex-center">
								<button
									type="submit"
									class={ "fav-icon-btn", templ.KV("is-active", v.IsFavorite) }
									title="حفظ في المفضلة"
								>
									if v.IsFavorite {
										@components.IconHeartFilled("icon-xs text-rose")
									} else {
										@components.IconHeart("icon-xs")
									}
								</button>
							</form>
						</div>
					</div>

					<!-- Product Title & Subtitle -->
					<div class="mb-2">
						<h3 class="text-sm font-black text-primary m-0 line-clamp-2 leading-snug">
							if v.ProductNameAr != "" {
								{ v.ProductNameAr }
							} else {
								{ v.ProductNameEn }
							}
						</h3>
						if v.ProductNameEn != "" && v.ProductNameEn != v.ProductNameAr {
							<div class="text-xs text-muted font-bold mt-0.5 text-truncate" dir="ltr">
								{ v.ProductNameEn }
							</div>
						}
					</div>

					<!-- Manufacturer & Dosage Form Meta -->
					<div class="d-flex items-center gap-1.5 text-xs text-secondary mb-1.5 flex-wrap">
						if v.BrandName != "" || v.Manufacturer != "" {
							<div class="d-flex items-center gap-1 min-w-0">
								@components.IconBuilding("icon-xs text-muted flex-shrink-0")
								<span class="text-muted font-medium">الشركة:</span>
								<strong class="text-primary text-truncate">
									if v.BrandName != "" {
										{ v.BrandName }
									} else {
										{ v.Manufacturer }
									}
								</strong>
							</div>
						}
						if v.DosageForm != "" {
							<span class="badge badge-sky text-2xs font-bold py-0.5 px-2">
								{ v.DosageForm }
							</span>
						}
					</div>

					if v.ScientificName != "" {
						<div class="text-xs text-secondary mb-2 text-truncate font-medium">
							<span class="text-muted">المادة: </span>
							<span class="font-bold text-primary">{ v.ScientificName }</span>
						</div>
					}

					<!-- Supplier Info Box -->
					<div class="p-2.5 rounded-xl bg-surface-sunken border mb-2.5 flex-between items-center">
						<div class="d-flex items-center gap-2 text-truncate">
							@components.IconTruck("icon-xs text-primary flex-shrink-0")
							<div class="text-truncate">
								<div class="text-xs font-black text-primary text-truncate">
									{ v.SupplierName }
								</div>
								if v.CityName != "" || v.BranchName != "" {
									<div class="text-2xs text-muted text-truncate font-medium">
										if v.CityName != "" {
											{ v.CityName }
										} else {
											{ v.BranchName }
										}
									</div>
								}
							</div>
						</div>
						<div class="d-flex items-center gap-1 flex-shrink-0">
							if v.DistanceText != "" {
								<span class="badge badge-sky text-2xs font-mono font-bold" title="المسافة التقديرية عن فرعكم">
									{ v.DistanceText }
								</span>
							}
							if v.IsVerified {
								<span class="badge badge-emerald text-2xs font-bold" title="مورد معتمد">
									معتمد
								</span>
							}
						</div>
					</div>

					<!-- Stock & Expiry -->
					<div class="flex-between text-xs mb-3 font-semibold items-center">
						<div class="d-flex items-center gap-1.5 flex-wrap">
							if v.AvailableStock > 0 {
								<span class="badge badge-emerald gap-1 font-bold text-xs py-0.5 px-2">
									<span>متاح ({ fmt.Sprintf("%d", v.AvailableStock) } عبوة)</span>
								</span>
							} else {
								<span class="badge badge-rose gap-1 font-bold text-xs py-0.5 px-2">
									<span>غير متوفر</span>
								</span>
							}
							if !v.IsCovered {
								<span class="badge badge-rose gap-1 font-bold text-xs py-0.5 px-2" title={ v.CoverageReason }>
									@components.IconAlert("icon-2xs")
									<span>خارج التغطية اليوم</span>
								</span>
							}
						</div>
						if v.ExpiryDate != "" {
							<div class="tabular-nums text-muted text-2xs font-mono font-medium">
								صلاحية: { v.ExpiryDate }
							</div>
						}
					</div>

					<!-- Pricing & Action Footer -->
					<div class="border-t pt-2.5 mt-auto">
						<div class="p-2.5 rounded-xl bg-surface-sunken border mb-3">
							<div class="flex-between items-center gap-2">
								<div class="d-flex flex-col gap-1">
									<!-- سعر الجمهور -->
									<div class="d-flex items-baseline gap-1 text-xs">
										<span class="text-secondary font-medium">سعر الجمهور:</span>
										if v.PublicPrice.IsPositive() {
											<span class="font-bold text-secondary line-through tabular-nums">
												{ v.PublicPrice.String() } <small class="text-2xs text-muted font-bold">ج.م</small>
											</span>
										} else if v.OriginalPrice.IsPositive() {
											<span class="font-bold text-secondary line-through tabular-nums">
												{ v.OriginalPrice.String() } <small class="text-2xs text-muted font-bold">ج.م</small>
											</span>
										} else {
											<span class="text-muted tabular-nums">—</span>
										}
									</div>

									<!-- سعر بعد الخصم (مباشرة بعد النقطتين) -->
									<div class="d-flex items-baseline gap-1.5">
										<span class="text-primary font-black text-xs">سعر بعد الخصم:</span>
										if v.Price.IsPositive() {
											<span class="text-base font-black text-emerald-500 tabular-nums">
												{ v.Price.String() } <small class="text-xs font-extrabold text-secondary">ج.م</small>
											</span>
										} else {
											<span class="text-xs font-bold text-secondary">حسب الكمية</span>
										}
									</div>
								</div>

								<!-- نسبة الخصم -->
								if v.DiscountPercent > 0 {
									<div class="flex-shrink-0">
										<span class="badge badge-emerald font-black text-xs py-1 px-2.5 tabular-nums shadow-2xs">
											خصم { fmt.Sprintf("%d%%", v.DiscountPercent) }
										</span>
									</div>
								}
							</div>
						</div>

						if v.CanAddToCart {
							<div onclick="event.stopPropagation();">
								<form method="POST" action="/cart/add" class="d-flex items-center gap-2 m-0">
									<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", v.VariantID) } />
									<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", v.ProductID) } />
									<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
									<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", v.SupplierID) } />
									<input type="hidden" name="offer_price" value={ v.Price.String() } />
									
									<button
										type="submit"
										class="btn btn-primary btn-sm flex-1 font-black justify-center gap-1.5 shadow-xs"
									>
										@components.IconPlus("icon-xs")
										<span>أضف للسلة</span>
									</button>

									<div class="cart-stepper-control">
										<button type="button" class="cart-stepper-btn" onclick="stepCatalogQty(this, -1)">−</button>
										<input
											type="number"
											name="qty"
											value={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
											min={ fmt.Sprintf("%d", max(1, v.MinOrderQty)) }
											max={ fmt.Sprintf("%d", max(1, v.AvailableStock)) }
											class="cart-stepper-input"
										/>
										<button type="button" class="cart-stepper-btn" onclick="stepCatalogQty(this, 1)">+</button>
									</div>
								</form>

								if v.IsNegotiable {
									<button
										type="button"
										class="btn btn-secondary btn-xs w-full mt-1.5 font-bold justify-center text-amber-700 gap-1.5 shadow-2xs"
										data-variant-id={ fmt.Sprintf("%d", v.VariantID) }
										data-product-id={ fmt.Sprintf("%d", v.ProductID) }
										data-vendor-id={ fmt.Sprintf("%d", v.SupplierID) }
										onclick="openNegotiationModal(this)"
									>
										@components.IconTag("icon-2xs")
										<span>طلب تفاوض على السعر</span>
									</button>
								}
							</div>
						} else {
							<div class="d-flex flex-col gap-1 w-full text-center">
								if !v.IsCovered && v.CoverageReason != "" {
									<span class="text-2xs text-danger font-bold d-block truncate" title={ v.CoverageReason }>
										{ v.CoverageReason }
									</span>
								}
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", resolveTargetID(v.VariantID, v.ProductID))) } class="btn btn-secondary btn-sm w-full font-bold justify-center gap-1.5 shadow-xs">
									<span>تفاصيل الصنف والموردين</span>
									@components.IconArrowLeft("icon-xs")
								</a>
							</div>
						}
					</div>
				</div>
			</div>
		}
	</div>
}

templ CustomerCatalogPagination(data CatalogPageData) {
	if data.TotalItems > 0 {
		<div class="glass-panel p-4 border rounded-2xl shadow-xs">
			@components.B2BPagination(components.PaginationProps{
				CurrentPage:     data.Page,
				PageSize:        data.PageSize,
				TotalCount:      data.TotalItems,
				BaseURL:         "/catalog",
				QueryValues:     catalogQueryValues(data),
				PageSizeOptions: []int{12, 24, 48, 96},
				SizeParam:       "page_size",
			})
		</div>
	}
}