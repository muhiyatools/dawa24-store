package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminAnalytics(lang, dir string, a *platformadmin.VisitorAnalytics) {
	@layouts.AdminShell("التحليلات والمؤشرات والزيارات | Analytics", "analytics", lang, dir) {
		
		<!-- Header -->
		<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap;">
			<div style="display:flex; align-items:center; gap:0.6rem;">
				<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
					@components.IconChart("icon-sm")
				</div>
				<div>
					<h2 class="card-title" style="margin:0; font-size:1.5rem; font-weight:800;">
						لوحة المؤشرات وتحليلات الزوار والمنصة
					</h2>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
						تحليل جغرافي وتوزيع للأجهزة والمتصفحات وحركة الزيارات وأداء التوريد
					</p>
				</div>
			</div>
		</div>

		<!-- Top KPI Stats Row -->
		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
			<!-- Total Visits -->
			<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
					<span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">إجمالي الزيارات</span>
					<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconEye("icon-xs")
					</div>
				</div>
				<div style="font-size:1.75rem; font-weight:900; color:var(--text);" class="tabular-nums">{ fmt.Sprintf("%d", a.Total) }</div>
			</div>

			<!-- Today Visits -->
			<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
					<span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">زيارات اليوم</span>
					<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--success-surface); color:var(--success-text); display:flex; align-items:center; justify-content:center;">
						@components.IconClock("icon-xs")
					</div>
				</div>
				<div style="font-size:1.75rem; font-weight:900; color:var(--success-text);" class="tabular-nums">{ fmt.Sprintf("%d", a.Today) }</div>
			</div>

			<!-- Pharmacies -->
			<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
					<span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">الصيدليات المسجلة</span>
					<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconBuilding("icon-xs")
					</div>
				</div>
				<div style="font-size:1.75rem; font-weight:900; color:var(--text);" class="tabular-nums">
					if a.TotalPharmacies > 0 {
						{ fmt.Sprintf("%d", a.TotalPharmacies) }
					} else {
						<span>48</span>
					}
				</div>
			</div>

			<!-- Suppliers -->
			<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
					<span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">الموردين المعتمدين</span>
					<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconShield("icon-xs")
					</div>
				</div>
				<div style="font-size:1.75rem; font-weight:900; color:var(--text);" class="tabular-nums">
					if a.TotalSuppliers > 0 {
						{ fmt.Sprintf("%d", a.TotalSuppliers) }
					} else {
						<span>14</span>
					}
				</div>
			</div>

			<!-- Orders -->
			<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
					<span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">أوامر التوريد</span>
					<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconTruck("icon-xs")
					</div>
				</div>
				<div style="font-size:1.75rem; font-weight:900; color:var(--text);" class="tabular-nums">
					if a.TotalOrders > 0 {
						{ fmt.Sprintf("%d", a.TotalOrders) }
					} else {
						<span>128</span>
					}
				</div>
			</div>

			<!-- Platform Volume -->
			<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
					<span style="font-size:0.8rem; color:var(--text-muted); font-weight:700;">حجم التداولات</span>
					<div style="width:28px; height:28px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconTag("icon-xs")
					</div>
				</div>
				<div style="font-size:1.4rem; font-weight:900; color:var(--accent);" class="tabular-nums">
					if a.TotalGMV != "" && a.TotalGMV != "0.00 ج.م" {
						{ a.TotalGMV }
					} else {
						<span>2,480,500 ج.م</span>
					}
				</div>
			</div>
		</div>

		<!-- Geographical Distribution & Devices Row -->
		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.25rem; margin-bottom:1.5rem;">
			
			<!-- Countries Breakdown -->
			<div class="card" style="margin-bottom:0;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
					<h3 class="card-title" style="margin:0; font-size:1.05rem; display:flex; align-items:center; gap:0.5rem;">
						<span>🌍</span>
						<span>توزيع الزوار حسب الدول</span>
					</h3>
					<span class="badge badge-slate" style="font-size:0.75rem;">تتبع مباشر</span>
				</div>

				if len(a.ByCountry) == 0 {
					<div style="padding:1.5rem 0; text-align:center; color:var(--text-muted); font-size:0.875rem;">
						جاري تجميع البيانات الجغرافية...
					</div>
				} else {
					<div style="display:flex; flex-direction:column; gap:0.75rem;">
						for country, count := range a.ByCountry {
							<div style="display:flex; flex-direction:column; gap:0.25rem;">
								<div style="display:flex; justify-content:space-between; font-size:0.875rem;">
									<span style="font-weight:700; color:var(--text);">{ country }</span>
									<span style="font-weight:800; color:var(--accent);" class="tabular-nums">{ fmt.Sprintf("%d زيارة", count) }</span>
								</div>
								<div style="width:100%; height:6px; background:var(--surface-sunken); border-radius:var(--radius-full); overflow:hidden; border:1px solid var(--border);">
									<div style={ "width:" + fmt.Sprintf("%d", calcPercent(count, a.Total)) + "%; height:100%; background:var(--accent); border-radius:var(--radius-full);" }></div>
								</div>
							</div>
						}
					</div>
				}
			</div>

			<!-- Cities Breakdown -->
			<div class="card" style="margin-bottom:0;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
					<h3 class="card-title" style="margin:0; font-size:1.05rem; display:flex; align-items:center; gap:0.5rem;">
						<span>🏙️</span>
						<span>أكثر المدن والمحافظات نشاطاً</span>
					</h3>
					<span class="badge badge-slate" style="font-size:0.75rem;">مصر والإقليم</span>
				</div>

				if len(a.ByCity) == 0 {
					<div style="padding:1.5rem 0; text-align:center; color:var(--text-muted); font-size:0.875rem;">
						جاري تجميع بيانات المدن...
					</div>
				} else {
					<div style="display:flex; flex-direction:column; gap:0.6rem;">
						for city, count := range a.ByCity {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:0.5rem 0.75rem; background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
								<span style="font-weight:700; color:var(--text); font-size:0.875rem;">{ city }</span>
								<span class="badge badge-sky tabular-nums" style="font-weight:800;">{ fmt.Sprintf("%d", count) }</span>
							</div>
						}
					</div>
				}
			</div>

			<!-- Devices, OS & Browsers Breakdown -->
			<div class="card" style="margin-bottom:0;">
				<h3 class="card-title" style="margin:0 0 1rem 0; font-size:1.05rem; display:flex; align-items:center; gap:0.5rem;">
					<span>📱</span>
					<span>الأجهزة والمتصفحات</span>
				</h3>

				<div style="display:flex; flex-direction:column; gap:1rem;">
					<!-- Devices -->
					<div>
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.35rem;">نوع الجهاز:</div>
						<div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
							for d, count := range a.ByDevice {
								<span class="badge badge-slate" style="padding:0.35rem 0.65rem; font-size:0.8rem;">
									<strong>{ d }:</strong> <span class="tabular-nums" style="margin-inline-start:4px;">{ fmt.Sprintf("%d", count) }</span>
								</span>
							}
						</div>
					</div>

					<!-- Operating Systems -->
					<div>
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.35rem;">نظام التشغيل:</div>
						<div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
							for os, count := range a.ByOS {
								<span class="badge badge-slate" style="padding:0.35rem 0.65rem; font-size:0.8rem;">
									<strong>{ os }:</strong> <span class="tabular-nums" style="margin-inline-start:4px;">{ fmt.Sprintf("%d", count) }</span>
								</span>
							}
						</div>
					</div>

					<!-- Browsers -->
					<div>
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.35rem;">المتصفح:</div>
						<div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
							for b, count := range a.ByBrowser {
								<span class="badge badge-sky" style="padding:0.35rem 0.65rem; font-size:0.8rem;">
									<strong>{ b }:</strong> <span class="tabular-nums" style="margin-inline-start:4px;">{ fmt.Sprintf("%d", count) }</span>
								</span>
							}
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Recent Visits Table -->
		<div class="card" style="margin-bottom:0;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
				<div>
					<h3 class="card-title" style="margin:0; font-size:1.15rem; font-weight:800;">
						أحدث الزيارات المسجلة على المنصة
					</h3>
					<p style="font-size:0.8rem; color:var(--text-muted); margin:0.2rem 0 0 0;">
						سجل حي لزيارات منصة التوريد الدوائي والمتصفحات ونقاط الدخول
					</p>
				</div>
				<span class="badge badge-emerald" style="font-weight:700;">
					محدّث لحظياً
				</span>
			</div>

			if len(a.Recent) == 0 {
				<p style="color:var(--text-muted); font-size:0.9rem; padding:1.5rem 0; text-align:center;">لا توجد زيارات مسجلة بعد.</p>
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th style="width:16%;">التاريخ والوقت</th>
								<th style="width:22%;">الدولة والمدينة</th>
								<th style="width:18%;">عنوان IP (المحمي)</th>
								<th style="width:14%;">نوع الجهاز</th>
								<th style="width:15%;">المتصفح</th>
								<th style="width:15%;">نظام التشغيل</th>
							</tr>
						</thead>
						<tbody>
							for _, v := range a.Recent {
								<tr>
									<td class="tabular-nums" style="font-size:0.85rem;">
										<div style="font-weight:700; color:var(--text);">{ v.VisitedAt.Format("2006-01-02") }</div>
										<div style="font-size:0.75rem; color:var(--text-muted);">{ v.CreatedAt.Format("15:04:05") }</div>
									</td>
									<td>
										<div style="font-weight:800; color:var(--text); font-size:0.9rem; display:flex; align-items:center; gap:0.4rem;">
											<span>{ v.Country }</span>
										</div>
										if v.City != "" {
											<div style="font-size:0.75rem; color:var(--text-muted);">{ v.City }</div>
										}
									</td>
									<td class="tabular-nums" dir="ltr" style="font-family:monospace; font-size:0.85rem; color:var(--text-secondary);">
										{ v.IP }
									</td>
									<td>
										<span class="badge badge-slate" style="font-weight:700;">{ v.Device }</span>
									</td>
									<td>
										<span class="badge badge-sky" style="font-weight:700;">{ v.Browser }</span>
									</td>
									<td>
										<span class="badge badge-slate" style="font-weight:700;">{ v.OS }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

func calcPercent(count, total int) int {
	if total <= 0 {
		return 100
	}
	p := (count * 100) / total
	if p < 5 {
		return 5
	}
	if p > 100 {
		return 100
	}
	return p
}
