package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminAnalytics(lang, dir string, a *platformadmin.VisitorAnalytics) {
	@layouts.AdminShell("تحليلات الزوار | Analytics", "analytics", lang, dir) {
		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
			<div class="card hover-lift" style="margin-bottom:0;">
				<span style="font-size:0.8rem; color:var(--neutral-500); font-weight:600;">إجمالي الزوار</span>
				<div style="font-size:2rem; font-weight:900; color:var(--primary-700); margin-top:0.5rem;" class="tabular-nums">{ fmt.Sprintf("%d", a.Total) }</div>
			</div>
			<div class="card hover-lift" style="margin-bottom:0;">
				<span style="font-size:0.8rem; color:var(--neutral-500); font-weight:600;">زيارات اليوم</span>
				<div style="font-size:2rem; font-weight:900; color:var(--info); margin-top:0.5rem;" class="tabular-nums">{ fmt.Sprintf("%d", a.Today) }</div>
			</div>
		</div>

		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem; margin-bottom:1.5rem;">
			@breakdownCard("الأجهزة", a.ByDevice)
			@breakdownCard("أنظمة التشغيل", a.ByOS)
			@breakdownCard("المتصفحات", a.ByBrowser)
		</div>

		<div class="card">
			<h2 class="card-title" style="margin:0 0 0.75rem;">أحدث الزيارات</h2>
			if len(a.Recent) == 0 {
				<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد زيارات مسجلة بعد.</p>
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead><tr><th>التاريخ</th><th>IP</th><th>الجهاز</th><th>المتصفح</th><th>النظام</th></tr></thead>
						<tbody>
							for _, v := range a.Recent {
								<tr>
									<td>{ v.VisitedAt.Format("2006-01-02") }</td>
									<td class="tabular-nums" dir="ltr">{ v.IP }</td>
									<td>{ v.Device }</td>
									<td>{ v.Browser }</td>
									<td>{ v.OS }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

templ breakdownCard(title string, m map[string]int) {
	<div class="card" style="margin-bottom:0;">
		<h3 class="card-title" style="margin:0 0 0.6rem;">{ title }</h3>
		if len(m) == 0 {
			<p style="color:var(--neutral-500); font-size:0.85rem;">لا توجد بيانات.</p>
		} else {
			for k, v := range m {
				<div style="display:flex; justify-content:space-between; padding:0.45rem 0; border-bottom:1px solid var(--neutral-100);">
					<span style="color:var(--neutral-700);">{ k }</span>
					<span style="font-weight:700; color:var(--neutral-900);" class="tabular-nums">{ fmt.Sprintf("%d", v) }</span>
				</div>
			}
		}
	</div>
}
