package pages

import (
	"fmt"

	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminAnalytics(lang, dir string, a *platformadmin.VisitorAnalytics) {
	@layouts.AdminShell("التحليلات والمؤشرات الحية | Platform Analytics", "analytics", lang, dir) {
		
		<!-- Header -->
		<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap;">
			<div class="row-center-sm">
				<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
					@components.IconChart("icon-sm")
				</div>
				<div>
					<h2 class="card-title" style="margin:0; font-size:1.5rem; font-weight:800;">
						التحليلات والمؤشرات الحية
					</h2>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
						تحليل جغرافي وتوزيع للأجهزة وحركة الزيارات وأداء التوريد الحقيقي من قاعدة البيانات
					</p>
				</div>
			</div>

			<div class="row-center">
				<span class="badge badge-emerald" style="font-weight:700; padding:0.4rem 0.85rem; font-size:0.8rem;">
					@components.IconCheck("icon-xs")
					<span>بيانات حية ومتزامنة</span>
				</span>
			</div>
		</div>

		<!-- 1. Live KPI Summary Cards (100% Real Database Queries) -->
		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1.75rem;">
			
			<!-- Total Visits -->
			<div class="card hover-lift" style="padding:1.25rem; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-inline-start:4px solid var(--accent);">
				<div style="display:flex; justify-content:space-between; align-items:flex-start;">
					<span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary);">إجمالي الزيارات</span>
					<div style="color:var(--accent);">@components.IconEye("icon-sm")</div>
				</div>
				<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.35rem;" class="tabular-nums">
					{ fmt.Sprintf("%d", a.Total) }
				</div>
				<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">زيارات موثقة تراكمياً</div>
			</div>

			<!-- Today Visits -->
			<div class="card hover-lift" style="padding:1.25rem; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-inline-start:4px solid #10b981;">
				<div style="display:flex; justify-content:space-between; align-items:flex-start;">
					<span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary);">زيارات اليوم</span>
					<div style="color:#10b981;">@components.IconClock("icon-sm")</div>
				</div>
				<div style="font-size:1.85rem; font-weight:800; color:#10b981; margin-top:0.35rem;" class="tabular-nums">
					{ fmt.Sprintf("%d", a.Today) }
				</div>
				<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">خلال الـ 24 ساعة الحالية</div>
			</div>

			<!-- Registered Pharmacies -->
			<div class="card hover-lift" style="padding:1.25rem; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-inline-start:4px solid #3b82f6;">
				<div style="display:flex; justify-content:space-between; align-items:flex-start;">
					<span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary);">الصيدليات المسجلة</span>
					<div style="color:#3b82f6;">@components.IconBuilding("icon-sm")</div>
				</div>
				<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.35rem;" class="tabular-nums">
					{ fmt.Sprintf("%d", a.TotalPharmacies) }
				</div>
				<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">صيدليات معتمدة بالنظام</div>
			</div>

			<!-- Approved Suppliers -->
			<div class="card hover-lift" style="padding:1.25rem; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-inline-start:4px solid #8b5cf6;">
				<div style="display:flex; justify-content:space-between; align-items:flex-start;">
					<span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary);">الموردين المعتمدين</span>
					<div style="color:#8b5cf6;">@components.IconShield("icon-sm")</div>
				</div>
				<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.35rem;" class="tabular-nums">
					{ fmt.Sprintf("%d", a.TotalSuppliers) }
				</div>
				<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">شركات ومستودعات توزيع</div>
			</div>

			<!-- Supply Orders -->
			<div class="card hover-lift" style="padding:1.25rem; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-inline-start:4px solid #f59e0b;">
				<div style="display:flex; justify-content:space-between; align-items:flex-start;">
					<span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary);">أوامر التوريد</span>
					<div style="color:#f59e0b;">@components.IconTruck("icon-sm")</div>
				</div>
				<div style="font-size:1.85rem; font-weight:800; color:var(--text); margin-top:0.35rem;" class="tabular-nums">
					{ fmt.Sprintf("%d", a.TotalOrders) }
				</div>
				<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">إجمالي عمليات الشراء</div>
			</div>

			<!-- Platform GMV -->
			<div class="card hover-lift" style="padding:1.25rem; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-inline-start:4px solid #06b6d4;">
				<div style="display:flex; justify-content:space-between; align-items:flex-start;">
					<span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary);">حجم التداولات</span>
					<div style="color:#06b6d4;">@components.IconTag("icon-sm")</div>
				</div>
				<div style="font-size:1.45rem; font-weight:800; color:var(--accent); margin-top:0.35rem;" class="tabular-nums">
					{ a.TotalGMV }
				</div>
				<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">قيمة أوامر التوريد المنفذة</div>
			</div>

		</div>

		<!-- 2. Geographic & Devices Distribution -->
		<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.25rem; margin-bottom:1.5rem;">
			
			<!-- Countries Breakdown -->
			<div class="card mb-0">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
					<h3 class="card-title" style="margin:0; font-size:1.05rem; display:flex; align-items:center; gap:0.5rem;">
						<span>🌍</span>
						<span>توزيع الزوار حسب الدول</span>
					</h3>
					<span class="badge badge-slate" style="font-size:0.75rem;">تتبع مباشر</span>
				</div>

				if len(a.ByCountry) == 0 {
					<div style="padding:1.5rem 0; text-align:center; color:var(--text-muted); font-size:0.875rem;">
						جاري تجميع البيانات الجغرافية...
					</div>
				} else {
					<div style="display:flex; flex-direction:column; gap:0.75rem;">
						for country, count := range a.ByCountry {
							<div style="display:flex; flex-direction:column; gap:0.25rem;">
								<div style="display:flex; justify-content:space-between; font-size:0.875rem;">
									<span style="font-weight:700; color:var(--text);">{ country }</span>
									<span style="font-weight:800; color:var(--accent);" class="tabular-nums">{ fmt.Sprintf("%d زيارة", count) }</span>
								</div>
								<div style="width:100%; height:6px; background:var(--surface-sunken); border-radius:var(--radius-full); overflow:hidden; border:1px solid var(--border);">
									<div style={ "width:" + fmt.Sprintf("%d", calcPercent(count, a.Total)) + "%; height:100%; background:var(--accent); border-radius:var(--radius-full);" }></div>
								</div>
							</div>
						}
					</div>
				}
			</div>

			<!-- Cities Breakdown -->
			<div class="card mb-0">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
					<h3 class="card-title" style="margin:0; font-size:1.05rem; display:flex; align-items:center; gap:0.5rem;">
						<span>🏙️</span>
						<span>أكثر المدن والمحافظات نشاطاً</span>
					</h3>
					<span class="badge badge-slate" style="font-size:0.75rem;">المناطق والمدن</span>
				</div>

				if len(a.ByCity) == 0 {
					<div style="padding:1.5rem 0; text-align:center; color:var(--text-muted); font-size:0.875rem;">
						جاري رصد بيانات المدن والمناطق...
					</div>
				} else {
					<div style="display:flex; flex-direction:column; gap:0.6rem;">
						for city, count := range a.ByCity {
							<div style="display:flex; justify-content:space-between; align-items:center; padding:0.5rem 0.85rem; background:var(--surface-sunken); border-radius:var(--radius-md); border:1px solid var(--border);">
								<span style="font-weight:700; font-size:0.875rem; color:var(--text);">{ city }</span>
								<span class="badge badge-sky" style="font-weight:800; font-size:0.8rem;">{ fmt.Sprintf("%d", count) }</span>
							</div>
						}
					</div>
				}
			</div>

			<!-- Devices, OS & Browsers -->
			<div class="card mb-0">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
					<h3 class="card-title" style="margin:0; font-size:1.05rem; display:flex; align-items:center; gap:0.5rem;">
						<span>📱</span>
						<span>الأجهزة والمتصفحات</span>
					</h3>
				</div>

				<div style="display:flex; flex-direction:column; gap:0.85rem;">
					<!-- Device -->
					<div>
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700; margin-bottom:0.35rem;">نوع الجهاز:</div>
						<div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
							for d, count := range a.ByDevice {
								<span class="badge badge-slate" style="font-size:0.75rem;">
									{ d }: <strong>{ fmt.Sprintf("%d", count) }</strong>
								</span>
							}
						</div>
					</div>

					<!-- OS -->
					<div>
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700; margin-bottom:0.35rem;">نظام التشغيل:</div>
						<div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
							for os, count := range a.ByOS {
								<span class="badge badge-purple" style="font-size:0.75rem;">
									{ os }: <strong>{ fmt.Sprintf("%d", count) }</strong>
								</span>
							}
						</div>
					</div>

					<!-- Browser -->
					<div>
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700; margin-bottom:0.35rem;">المتصفح:</div>
						<div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
							for b, count := range a.ByBrowser {
								<span class="badge badge-emerald" style="font-size:0.75rem;">
									{ b }: <strong>{ fmt.Sprintf("%d", count) }</strong>
								</span>
							}
						</div>
					</div>
				</div>
			</div>

		</div>

		<!-- 3. Recent Visits Table (Fixed RTL Column Alignment) -->
		<div class="card mb-0">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.85rem;">
				<div>
					<h3 class="card-title" style="margin:0; font-size:1.15rem; font-weight:800;">
						أحدث الزيارات المسجلة على المنصة
					</h3>
					<p style="font-size:0.8rem; color:var(--text-secondary); margin:0.15rem 0 0 0;">
						سجل حي لزيارات منصة التوريد الدوائي والمتصفحات ونقاط الدخول
					</p>
				</div>
				<span class="badge badge-emerald" style="font-size:0.75rem;">محدّث لحظياً</span>
			</div>

			if len(a.Recent) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد زيارات مسجلة",
					Message: "سيتم تسجيل الزيارات فور استخدام المنصة.",
				})
			} else {
				<div class="table-container" style="overflow-x:auto;">
					<table class="data-table" style="min-width:1000px; width:100%; border-collapse:collapse;">
						<thead>
							<tr>
								<th style="width:18%; text-align:start;">التاريخ والوقت</th>
								<th style="width:22%; text-align:start;">الدولة والمدينة</th>
								<th style="width:18%; text-align:center;">عنوان IP (المحمي)</th>
								<th style="width:14%; text-align:center;">نوع الجهاز</th>
								<th style="width:14%; text-align:center;">المتصفح</th>
								<th style="width:14%; text-align:center;">نظام التشغيل</th>
							</tr>
						</thead>
						<tbody>
							for _, v := range a.Recent {
								<tr>
									<!-- 1. Timestamp (Start Aligned) -->
									<td class="text-start">
										<div class="tabular-nums" style="font-weight:700; color:var(--text); font-size:0.85rem;">
											{ v.VisitedAt.Format("2006-01-02") }
										</div>
										<div class="tabular-nums" style="font-size:0.75rem; color:var(--text-muted);">
											{ v.CreatedAt.Format("15:04:05") }
										</div>
									</td>

									<!-- 2. Country & City (Start Aligned) -->
									<td class="text-start">
										<div style="font-weight:700; color:var(--text); font-size:0.875rem;">
											{ v.Country }
										</div>
										<div style="font-size:0.775rem; color:var(--text-muted); margin-top:2px;">
											{ v.City }
										</div>
									</td>

									<!-- 3. IP (Center Aligned) -->
									<td style="text-align:center;">
										<span class="badge badge-slate tabular-nums" style="font-family:monospace; font-size:0.775rem; direction:ltr;">
											{ v.IP }
										</span>
									</td>

									<!-- 4. Device (Center Aligned) -->
									<td style="text-align:center;">
										<span class="badge badge-sky" style="font-size:0.75rem; text-transform:capitalize;">
											{ v.Device }
										</span>
									</td>

									<!-- 5. Browser (Center Aligned) -->
									<td style="text-align:center;">
										<span class="badge badge-purple" style="font-size:0.75rem; text-transform:capitalize;">
											{ v.Browser }
										</span>
									</td>

									<!-- 6. OS (Center Aligned) -->
									<td style="text-align:center;">
										<span class="badge badge-slate" style="font-size:0.75rem; text-transform:capitalize;">
											{ v.OS }
										</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>

	}
}

func calcPercent(count, total int) int {
	if total <= 0 {
		return 100
	}
	p := (count * 100) / total
	if p > 100 {
		return 100
	}
	if p < 1 && count > 0 {
		return 1
	}
	return p
}
