package pages

import (
	"fmt"

	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminAnalytics(lang, dir string, a *platformadmin.VisitorAnalytics) {
	@layouts.AdminShell("التحليلات والمؤشرات الحية | Platform Analytics", "analytics", lang, dir) {
		<div class="page-container">
			<!-- Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								📈
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								التحليلات والمؤشرات الحية
							</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							تحليل جغرافي وتوزيع للأجهزة وحركة الزيارات وأداء التوريد الحقيقي من قاعدة البيانات
						</p>
					</div>
					<div class="d-flex items-center gap-3">
						<span class="badge badge-emerald text-xs font-bold gap-2 p-2 px-3">
							@components.IconCheck("icon-xs")
							<span>بيانات حية ومتزامنة</span>
						</span>
					</div>
				</div>
			</div>

			<!-- 1. Live KPI Summary Cards -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الزيارات</div>
					<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", a.Total) }</div>
					<span class="text-xs text-secondary mt-1 d-block">زيارات موثقة تراكمياً</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">زيارات اليوم</div>
					<div class="stat-card-value text-brand tabular-nums">{ fmt.Sprintf("%d", a.Today) }</div>
					<span class="text-xs text-secondary mt-1 d-block">خلال الـ 24 ساعة الحالية</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-sky">الصيدليات المسجلة</div>
					<div class="stat-card-value text-sky tabular-nums">{ fmt.Sprintf("%d", a.TotalPharmacies) }</div>
					<span class="text-xs text-secondary mt-1 d-block">صيدليات معتمدة بالنظام</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-accent">الموردين المعتمدين</div>
					<div class="stat-card-value text-accent tabular-nums">{ fmt.Sprintf("%d", a.TotalSuppliers) }</div>
					<span class="text-xs text-secondary mt-1 d-block">شركات ومخازن توزيع</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-warning">أوامر التوريد</div>
					<div class="stat-card-value text-warning tabular-nums">{ fmt.Sprintf("%d", a.TotalOrders) }</div>
					<span class="text-xs text-secondary mt-1 d-block">إجمالي عمليات الشراء</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-success">حجم التداولات</div>
					<div class="stat-card-value text-success tabular-nums">{ a.TotalGMV }</div>
					<span class="text-xs text-secondary mt-1 d-block">قيمة أوامر التوريد المنفذة</span>
				</div>
			</div>

			<!-- 2. Geographic & Devices Distribution -->
			<div class="analytics-distribution-grid mb-6">
				
				<!-- Countries Breakdown -->
				<div class="glass-panel p-6 mb-0">
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<h3 class="text-base font-extrabold text-primary m-0 d-flex items-center gap-2">
							@components.IconGlobe("icon-xs")
							<span>توزيع الزوار حسب الدول</span>
						</h3>
						<span class="badge badge-slate text-xs font-bold">تتبع مباشر</span>
					</div>

					if len(a.ByCountry) == 0 {
						<div class="py-6 text-center text-muted text-xs">
							جاري تجميع البيانات الجغرافية...
						</div>
					} else {
						<div class="d-flex flex-col gap-3">
							for country, count := range a.ByCountry {
								<div class="d-flex flex-col gap-1">
									<div class="flex-between text-xs font-bold">
										<span class="text-primary">{ country }</span>
										<span class="tabular-nums text-brand">{ fmt.Sprintf("%d زيارة", count) }</span>
									</div>
									<div class="w-full h-2 rounded-full overflow-hidden bg-surface-sunken border">
										<div class="h-full bg-brand rounded-full" style={ fmt.Sprintf("width: %d%%", calcPercent(count, a.Total)) }></div>
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- Cities Breakdown -->
				<div class="glass-panel p-6 mb-0">
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<h3 class="text-base font-extrabold text-primary m-0 d-flex items-center gap-2">
							@components.IconMapPin("icon-xs")
							<span>أكثر المدن والمحافظات نشاطاً</span>
						</h3>
						<span class="badge badge-slate text-xs font-bold">المناطق والمدن</span>
					</div>

					if len(a.ByCity) == 0 {
						<div class="py-6 text-center text-muted text-xs">
							جاري رصد بيانات المدن والمناطق...
						</div>
					} else {
						<div class="d-flex flex-col gap-2">
							for city, count := range a.ByCity {
								<div class="flex-between items-center p-3 bg-surface-sunken rounded-lg border text-xs">
									<span class="font-bold text-primary">{ city }</span>
									<span class="badge badge-sky text-xs font-black">{ fmt.Sprintf("%d", count) }</span>
								</div>
							}
						</div>
					}
				</div>

				<!-- Devices, OS & Browsers -->
				<div class="glass-panel p-6 mb-0">
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<h3 class="text-base font-extrabold text-primary m-0 d-flex items-center gap-2">
							@components.IconMonitor("icon-xs")
							<span>الأجهزة والمتصفحات</span>
						</h3>
					</div>

					<div class="d-flex flex-col gap-4 text-xs">
						<!-- Device -->
						<div>
							<div class="text-muted font-bold mb-2">نوع الجهاز:</div>
							<div class="d-flex gap-2 flex-wrap">
								for d, count := range a.ByDevice {
									<span class="badge badge-slate text-xs font-bold">
										{ d }: <strong class="tabular-nums">{ fmt.Sprintf("%d", count) }</strong>
									</span>
								}
							</div>
						</div>

						<!-- OS -->
						<div>
							<div class="text-muted font-bold mb-2">نظام التشغيل:</div>
							<div class="d-flex gap-2 flex-wrap">
								for os, count := range a.ByOS {
									<span class="badge badge-purple text-xs font-bold">
										{ os }: <strong class="tabular-nums">{ fmt.Sprintf("%d", count) }</strong>
									</span>
								}
							</div>
						</div>

						<!-- Browser -->
						<div>
							<div class="text-muted font-bold mb-2">المتصفح:</div>
							<div class="d-flex gap-2 flex-wrap">
								for b, count := range a.ByBrowser {
									<span class="badge badge-emerald text-xs font-bold">
										{ b }: <strong class="tabular-nums">{ fmt.Sprintf("%d", count) }</strong>
									</span>
								}
							</div>
						</div>
					</div>
				</div>

			</div>

			<!-- 3. Recent Visits Table -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				<div class="p-4 px-6 border-b flex-between items-center">
					<div>
						<h3 class="text-base font-extrabold text-primary m-0">
							أحدث الزيارات المسجلة على المنصة
						</h3>
						<p class="text-xs text-secondary m-0 mt-1">
							سجل حي لزيارات منصة التوريد الدوائي والمتصفحات ونقاط الدخول
						</p>
					</div>
					<span class="badge badge-emerald text-xs font-bold">محدّث لحظياً</span>
				</div>

				if len(a.Recent) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">🌐</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد زيارات مسجلة</h3>
						<p class="text-sm text-secondary m-0">سيتم تسجيل الزيارات فور استخدام المنصة.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>التاريخ والوقت</th>
									<th>الدولة والمدينة</th>
									<th class="text-center">عنوان IP (المحمي)</th>
									<th class="text-center">نوع الجهاز</th>
									<th class="text-center">المتصفح</th>
									<th class="text-center">نظام التشغيل</th>
								</tr>
							</thead>
							<tbody>
								for _, v := range a.Recent {
									<tr>
										<!-- 1. Timestamp -->
										<td>
											<div class="tabular-nums font-bold text-primary text-xs">
												{ v.VisitedAt.Format("2006-01-02") }
											</div>
											<div class="tabular-nums text-xs text-muted">
												{ v.CreatedAt.Format("15:04:05") }
											</div>
										</td>

										<!-- 2. Country & City -->
										<td>
											<div class="text-xs font-extrabold text-primary">
												{ v.Country }
											</div>
											<div class="text-xs text-muted">
												{ v.City }
											</div>
										</td>

										<!-- 3. IP -->
										<td class="text-center">
											<span class="badge badge-slate tabular-nums text-xs font-mono">
												{ v.IP }
											</span>
										</td>

										<!-- 4. Device -->
										<td class="text-center">
											<span class="badge badge-sky text-xs font-bold capitalize">
												{ v.Device }
											</span>
										</td>

										<!-- 5. Browser -->
										<td class="text-center">
											<span class="badge badge-purple text-xs font-bold capitalize">
												{ v.Browser }
											</span>
										</td>

										<!-- 6. OS -->
										<td class="text-center">
											<span class="badge badge-slate text-xs font-bold capitalize">
												{ v.OS }
											</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}

func calcPercent(count, total int) int {
	if total <= 0 {
		return 100
	}
	p := (count * 100) / total
	if p > 100 {
		return 100
	}
	if p < 1 && count > 0 {
		return 1
	}
	return p
}
