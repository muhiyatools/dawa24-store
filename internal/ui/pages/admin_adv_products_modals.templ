package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

func orgDisplayName(o *org.Organization, lang string) string {
	if o == nil {
		return ""
	}
	if name := o.TradeName.Get(i18n.ParseLang(lang)); name != "" {
		return name
	}
	if o.LegalName != "" {
		return o.LegalName
	}
	return fmt.Sprintf("منشأة #%d", o.ID)
}

templ AdminAdvProductsModals(data AdminAdvProductsData, lang string) {
	<!-- ================= ADD PRODUCT SPONSORSHIP MODAL ================= -->
	<div x-show="addModalOpen" x-cloak class="modal-backdrop" @click.self="addModalOpen = false">
		<div class="modal-content max-w-lg w-full mx-4 glass-panel border rounded-3xl shadow-2xl overflow-hidden text-start" @click.stop>
			<div class="modal-header p-5 border-b flex-between items-center">
				<div class="d-flex items-center gap-2.5">
					<div class="w-9 h-9 rounded-xl bg-accent-subtle text-accent d-flex items-center justify-center">
						@components.IconSparkles("icon-xs")
					</div>
					<div class="stack-xs text-start">
						<h3 class="text-base font-black text-primary m-0">إضافة وتفعيل رعاية منتج يدوياً</h3>
						<span class="text-2xs text-muted">تثبيت وترويج منتج في صدارة الكتالوج لصالح مورد محدد</span>
					</div>
				</div>
				<button type="button" @click="addModalOpen = false" class="btn btn-ghost btn-sm text-slate-400 hover:text-slate-600">
					@components.IconClose("icon-xs")
				</button>
			</div>

			<form method="POST" action="/admin/adv-products/new" class="p-6 d-flex flex-col gap-4 m-0">
				<!-- Vendor Selection -->
				<div class="stack-xs">
					<label class="form-label text-xs font-bold text-primary">
						المنشأة / المورد المستفيد <span class="text-danger">*</span>
					</label>
					<select name="org_id" required class="form-select text-xs w-full">
						<option value="">-- اختر المنشأة أو المورد --</option>
						for _, v := range data.Vendors {
							if v != nil {
								<option value={ fmt.Sprintf("%d", v.ID) }>
									{ orgDisplayName(v, lang) }
									if v.OrganizationNumber != "" {
										<span> ({ v.OrganizationNumber })</span>
									}
								</option>
							}
						}
					</select>
				</div>

				<!-- Product Selection -->
				<div class="stack-xs">
					<label class="form-label text-xs font-bold text-primary">
						المنتج المراد تثبيته ورعايته <span class="text-danger">*</span>
					</label>
					<select name="product_id" required class="form-select text-xs w-full">
						<option value="">-- اختر المنتج من الكتالوج --</option>
						for _, prod := range data.CatalogProducts {
							if prod != nil {
								<option value={ fmt.Sprintf("%d", prod.ID) }>
									{ prod.Name.Get(i18n.ParseLang(lang)) }
									if prod.PublicID != "" {
										<span> ({ prod.PublicID })</span>
									}
								</option>
							}
						}
					</select>
				</div>

				<!-- Package & Duration Selection -->
				<div class="d-grid grid-cols-2 gap-3">
					<div class="stack-xs">
						<label class="form-label text-xs font-bold text-primary">
							باقة الرعاية <span class="text-danger">*</span>
						</label>
						<select name="package_id" required class="form-select text-xs w-full">
							<option value="">-- اختر الباقة --</option>
							for _, p := range data.Packages {
								if p != nil {
									<option value={ fmt.Sprintf("%d", p.ID) }>
										{ p.Name.Get(i18n.ParseLang(lang)) } - { advTierName(p.TierLevel) }
									</option>
								}
							}
						</select>
					</div>

					<div class="stack-xs">
						<label class="form-label text-xs font-bold text-primary">
							مدة التثبيت (بالأيام) <span class="text-danger">*</span>
						</label>
						<input
							type="number"
							name="duration_days"
							value="30"
							min="1"
							max="365"
							required
							class="form-input text-xs font-bold tabular-nums w-full"
						/>
					</div>
				</div>

				<!-- Form Actions -->
				<div class="d-flex justify-between items-center pt-4 border-t mt-2">
					<button
						type="button"
						class="btn btn-secondary font-bold"
						@click="addModalOpen = false"
					>
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary font-bold px-6">
						@components.IconCheck("icon-xs")
						<span>+ تأكيد وتفعيل رعاية المنتج فوراً</span>
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- ================= REJECT / REVOKE MODAL ================= -->
	<div x-show="rejectModalOpen" x-cloak class="modal-backdrop" @click.self="rejectModalOpen = false">
		<div class="modal-content max-w-md w-full mx-4 glass-panel border border-rose-200 rounded-3xl shadow-2xl overflow-hidden text-start" @click.stop>
			<div class="modal-header p-5 border-b border-rose-100 flex-between items-center bg-rose-50/70">
				<div class="d-flex items-center gap-2.5">
					<div class="w-9 h-9 rounded-xl bg-rose-500 text-white d-flex items-center justify-center">
						@components.IconAlert("icon-xs")
					</div>
					<div class="stack-xs text-start">
						<h3 class="text-base font-black text-rose-700 m-0">رفض أو إلغاء رعاية المنتج</h3>
						<span class="text-2xs text-muted">إيقاف التثبيت في الصدارة وإعادة الرصيد للمورد</span>
					</div>
				</div>
				<button type="button" @click="rejectModalOpen = false" class="btn btn-ghost btn-sm text-slate-400 hover:text-slate-600">
					@components.IconClose("icon-xs")
				</button>
			</div>

			<form :action="rejectAction" method="POST" class="p-6 d-flex flex-col gap-4 m-0">
				<p class="text-xs text-secondary m-0">
					سيتم رفض طلب الرعاية وإيقاف ظهوره في الصدارة وإعادة رصيد الرعاية للمورد مع إرسال إشعار بالملاحظات المدونة أدناه.
				</p>

				<div class="stack-xs">
					<label class="form-label text-xs font-bold text-primary">
						سبب الرفض أو الملاحظات للمورد
					</label>
					<textarea
						name="notes"
						rows="3"
						placeholder="اكتب سبب الرفض أو التوجيهات للمورد..."
						class="form-input text-xs w-full"
					></textarea>
				</div>

				<div class="d-flex justify-between items-center pt-4 border-t mt-2">
					<button
						type="button"
						class="btn btn-secondary font-bold"
						@click="rejectModalOpen = false"
					>
						تراجع
					</button>
					<button type="submit" class="btn btn-danger font-bold px-6">
						تأكيد الرفض والإلغاء
					</button>
				</div>
			</form>
		</div>
	</div>
}
