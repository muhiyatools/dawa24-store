package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminUserOrgData struct {
	UserOrgs   []*org.UserOrganization
	ActiveTab  string
	TotalCount int
}

templ AdminUserOrganizationsPage(lang, dir string, data *AdminUserOrgData) {
	@layouts.AdminShell("إدارة مستخدمي المنظمات | لوحة الإدارة", "user_organization", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.5rem;">
			
			<!-- Header Banner -->
			<div class="card" style="margin:0; padding:1.5rem 1.75rem; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div>
					<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
						مستخدمو المنظمات (User Organizations Directory)
					</h1>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
						سجل ربط الصيدليات والمستخدمين بالموردين والشركات وأرقام المنظمات المعتمدة.
					</p>
				</div>
			</div>

			<!-- Filter Tabs -->
			if data != nil {
				<div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
					<a
						href="/admin/user-organization?status=all"
						class={ "btn btn-sm fw-800", templ.KV("btn-primary", data.ActiveTab == "" || data.ActiveTab == "all"), templ.KV("btn-secondary", data.ActiveTab != "" && data.ActiveTab != "all") }
						style="border-radius:var(--radius-full);"
					>
						<span>الكل ({ fmt.Sprintf("%d", data.TotalCount) })</span>
					</a>
					<a
						href="/admin/user-organization?status=pending"
						class={ "btn btn-sm fw-800", templ.KV("btn-primary", data.ActiveTab == "pending"), templ.KV("btn-secondary", data.ActiveTab != "pending") }
						style="border-radius:var(--radius-full);"
					>
						<span>قيد الانتظار</span>
					</a>
					<a
						href="/admin/user-organization?status=approved"
						class={ "btn btn-sm fw-800", templ.KV("btn-primary", data.ActiveTab == "approved"), templ.KV("btn-secondary", data.ActiveTab != "approved") }
						style="border-radius:var(--radius-full);"
					>
						<span>معتمد (Approval ✓)</span>
					</a>
					<a
						href="/admin/user-organization?status=rejected"
						class={ "btn btn-sm fw-800", templ.KV("btn-primary", data.ActiveTab == "rejected"), templ.KV("btn-secondary", data.ActiveTab != "rejected") }
						style="border-radius:var(--radius-full);"
					>
						<span>مرفوض ✗</span>
					</a>
				</div>
			}

			<!-- Table -->
			if data == nil || len(data.UserOrgs) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد سجلات",
					Message: "لم يتم العثور على سجلات ربط منظمات في النظام.",
				})
			} else {
				<div class="table-container overflow-visible">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>#</th>
								<th>المستخدم / الصيدلية</th>
								<th>المورد المستهدف</th>
								<th>رقم المنظمة (Org Number)</th>
								<th>الحالة</th>
								<th>تاريخ الإنشاء</th>
								<th>ملاحظات</th>
							</tr>
						</thead>
						<tbody>
							for _, uo := range data.UserOrgs {
								if uo != nil {
									<tr>
										<td class="tabular-nums">#{ fmt.Sprintf("%d", uo.ID) }</td>
										<td>
											<strong class="text-primary">{ uo.UserName }</strong>
											<div style="font-size:0.75rem; color:var(--text-muted);" dir="ltr">{ uo.UserEmail }</div>
											if uo.CustomerOrgName != "" {
												<div style="font-size:0.75rem; color:var(--text-secondary);">{ uo.CustomerOrgName }</div>
											}
										</td>
										<td>
											<strong style="color:var(--text);">{ uo.VendorOrgName }</strong>
											<div style="font-size:0.75rem; color:var(--text-muted);">معرف: #{ fmt.Sprintf("%d", uo.VendorOrgID) }</div>
										</td>
										<td>
											<span class="badge badge-sky text-xs fw-800 tabular-nums" style="font-family:var(--font-mono, monospace);" dir="ltr">
												{ uo.OrganizationNumber }
											</span>
										</td>
										<td>
											switch uo.Status {
												case org.UserOrgStatusApproved:
													<span class="badge badge-emerald text-xs fw-800">Approval ✓</span>
												case org.UserOrgStatusRejected:
													<span class="badge badge-rose text-xs fw-800">مرفوض ✗</span>
												default:
													<span class="badge badge-amber text-xs fw-800">قيد الانتظار</span>
											}
										</td>
										<td>
											<span class="tabular-nums" style="font-size:0.8rem; color:var(--text-muted);">
												{ format.Date(uo.CreatedAt, "ar") }
											</span>
										</td>
										<td>
											if uo.Notes != "" {
												<span style="font-size:0.8rem; color:var(--text-secondary);">{ uo.Notes }</span>
											} else {
												<span style="color:var(--text-muted);">-</span>
											}
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			}

		</div>
	}
}
