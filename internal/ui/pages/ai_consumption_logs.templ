package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AIConsumptionLogsPage renders the full AI request logs screen for either Customer or Vendor.
templ AIConsumptionLogsPage(data AIConsumptionLogsPageData, lang, dir string) {
	if data.IsVendor {
		@layouts.VendorShell("سجل استهلاك الذكاء الاصطناعي", "ai_logs", lang, dir) {
			@aiConsumptionLogsBody(data, lang, dir)
		}
	} else {
		@layouts.CustomerShell("سجل استهلاك الذكاء الاصطناعي", "ai_logs", lang, dir, nil) {
			@aiConsumptionLogsBody(data, lang, dir)
		}
	}
}

templ aiConsumptionLogsBody(data AIConsumptionLogsPageData, lang, dir string) {
	<div class="page-container">
		
		<!-- Header Banner -->
		<div class="glass-panel p-6 mb-6">
			<div class="flex-between items-center flex-wrap gap-4">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge text-xl">
						✨
					</div>
					<div>
						<h1 class="text-2xl font-black text-primary m-0">
							سجل استهلاك وعمليات الذكاء الاصطناعي
						</h1>
						<p class="text-sm text-secondary m-0 mt-1">
							متابعة استدعاءات بوابات الذكاء الاصطناعي، وتتبع استهلاك الحصة ومعدل التوكنز للعمليات التشغيلية
						</p>
					</div>
				</div>

				<div class="d-flex items-center gap-3 flex-wrap">
					<div class="d-inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs" style="background:var(--surface-sunken);">
						<span class="text-secondary font-bold">معرّف البوابة:</span>
						<code dir="ltr" class="font-bold text-brand font-mono">{ data.AIUserID }</code>
					</div>
					<a href={ templ.SafeURL(func() string { if data.IsVendor { return "/vendor/subscription" }; return "/customer/subscription" }()) } class="btn btn-secondary btn-sm font-bold text-xs gap-1">
						@components.IconSparkles("icon-xs")
						<span>إدارة الباقة والاشتراك</span>
					</a>
				</div>
			</div>
		</div>

		<!-- Executive Quota & Metric Cards Strip -->
		<div class="dashboard-stat-grid mb-6">
			
			<!-- Card 1: Quota Usage Percentage & Progress -->
			<div class="stat-card-3d">
				<div class="flex-between items-center">
					<span class="text-xs font-bold text-muted">استهلاك الحصة الشهرية</span>
					<span class="badge badge-sky text-xs font-bold" dir="ltr">{ data.AIPlanID }</span>
				</div>
				
				<div class="tabular-nums text-2xl font-black text-brand mt-2">
					{ fmt.Sprintf("%d%%", data.UsagePercentage) }
				</div>

				<!-- Working Dynamic Progress Bar -->
				<div style="width:100%; height:7px; background:var(--surface-sunken); border-radius:4px; margin-top:0.5rem; overflow:hidden;">
					<div style={ fmt.Sprintf("height:100%%; width:%d%%; border-radius:4px; background:linear-gradient(90deg, var(--brand-primary, #0ea5e9), #8b5cf6); transition:width 0.4s ease;", data.UsagePercentage) }></div>
				</div>

				<div class="flex-between items-center text-xs text-muted mt-2 pt-2 border-t">
					<span>متبقي: <strong class="text-success">{ fmt.Sprintf("%d%%", 100-data.UsagePercentage) }</strong></span>
					<span>التجديد: <strong class="text-primary">{ data.ResetCountdown() }</strong></span>
				</div>
			</div>

			<!-- Card 2: Total AI Requests -->
			<div class="stat-card-3d">
				<div class="flex-between items-center">
					<span class="text-xs font-bold text-muted">إجمالي الاستدعاءات</span>
					<span class="text-brand">⚡</span>
				</div>
				<div class="tabular-nums text-2xl font-black text-primary mt-2">
					{ fmt.Sprintf("%d", data.TotalRequests) } <span class="text-xs text-muted font-normal">طلب</span>
				</div>
				<div class="text-xs text-muted mt-2 pt-2 border-t">
					العمليات التشغيلية التراكمية المسجلة
				</div>
			</div>

			<!-- Card 3: Processed Tokens (In / Out) -->
							<th style="padding:0.75rem 1rem;">التوكنز (In / Out)</th>
							<th style="padding:0.75rem 1rem;">زمن الاستجابة</th>
							<th style="padding:0.75rem 1rem; text-align:center;">الحالة</th>
						</tr>
					</thead>
					<tbody>
						for _, log := range data.Logs {
							if log != nil {
								<tr
									class="ai-log-row"
									data-log-id={ strings.ToLower(log.ID) }
									data-log-feature={ strings.ToLower(log.FeatureKey + " " + log.FeatureName + " " + log.SourceContext) }
									data-log-model={ strings.ToLower(log.ModelAlias) }
									data-log-status={ log.Status }
									style="border-bottom:1px solid var(--border); transition:background 0.15s ease;"
								>
									<!-- Request ID & Timestamp -->
									<td style="padding:0.75rem 1rem; vertical-align:middle;">
										<div style="display:flex; flex-direction:column; gap:0.15rem;">
											<code dir="ltr" style="font-size:0.8rem; font-weight:800; color:var(--primary);">{ log.ID }</code>
											<span class="tabular-nums text-xs text-muted">{ log.TimeFormatted }</span>
										</div>
									</td>

									<!-- Feature Name & Context -->
									<td style="padding:0.75rem 1rem; vertical-align:middle;">
										<div style="display:flex; flex-direction:column; gap:0.2rem;">
											<strong style="font-size:0.875rem; color:var(--text);">{ log.FeatureName }</strong>
											if log.SourceContext != "" {
												<span style="font-size:0.75rem; color:var(--text-secondary); display:flex; align-items:center; gap:0.3rem;">
													<span>📌</span>
													<span>{ log.SourceContext }</span>
												</span>
											}
										</div>
									</td>

									<!-- Model & Tier -->
									<td style="padding:0.75rem 1rem; vertical-align:middle;">
										<div style="display:flex; align-items:center; gap:0.4rem;">
											<code dir="ltr" class="text-xs fw-700" style="background:var(--surface-sunken); padding:0.15rem 0.4rem; border-radius:var(--radius-sm); border:1px solid var(--border);">{ log.ModelAlias }</code>
											if log.ModelTier == "quality" {
												<span class="badge badge-purple text-xs">Quality</span>
											} else {
												<span class="badge badge-sky text-xs">Fast</span>
											}
										</div>
									</td>

									<!-- Tokens (Clean In / Out format - No '0 tokens' badge) -->
									<td style="padding:0.75rem 1rem; vertical-align:middle;">
										<div class="tabular-nums" dir="ltr" style="font-family:monospace; font-size:0.825rem; font-weight:700; color:var(--text);">
											In: { fmt.Sprintf("%d", log.InputTokens) } · Out: { fmt.Sprintf("%d", log.OutputTokens) }
										</div>
									</td>

									<!-- Latency -->
									<td style="padding:0.75rem 1rem; vertical-align:middle;">
										<span class="tabular-nums text-xs" style="color:var(--text-secondary); font-weight:700;">
											if log.DurationMs > 0 {
												{ fmt.Sprintf("%d ms", log.DurationMs) }
											} else {
												<span>-</span>
											}
										</span>
									</td>

									<!-- Status Badge -->
									<td style="padding:0.75rem 1rem; vertical-align:middle; text-align:center;">
										if log.Status == "success" || log.Status == "completed" {
											<span class="badge badge-emerald text-xs fw-700">
												@components.IconCheckCircle("icon-xs")
												<span>{ log.StatusLabel }</span>
											</span>
										} else if log.Status == "cached" {
											<span class="badge badge-sky text-xs fw-700">
												@components.IconZap("icon-xs")
												<span>ذاكرة سريعة</span>
											</span>
										} else {
											<span class="badge badge-amber text-xs fw-700">
												<span>{ log.StatusLabel }</span>
											</span>
										}
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		}

	</div>

	<!-- Client-side Filtering Script -->
	<script>
		function filterAILogs() {
			const q = (document.getElementById('ai-logs-search')?.value || '').toLowerCase().trim();
			const feature = (document.getElementById('ai-logs-feature-filter')?.value || '').toLowerCase().trim();
			const status = (document.getElementById('ai-logs-status-filter')?.value || '').toLowerCase().trim();
			const rows = document.querySelectorAll('#ai-logs-table tbody .ai-log-row');

			rows.forEach(row => {
				const id = row.getAttribute('data-log-id') || '';
				const f = row.getAttribute('data-log-feature') || '';
				const m = row.getAttribute('data-log-model') || '';
				const s = row.getAttribute('data-log-status') || '';

				const matchesQ = !q || id.includes(q) || f.includes(q) || m.includes(q);
				const matchesFeature = !feature || f.includes(feature);
				const matchesStatus = !status || s.includes(status);

				if (matchesQ && matchesFeature && matchesStatus) {
					row.style.display = '';
				} else {
					row.style.display = 'none';
				}
			});
		}
	</script>
}
