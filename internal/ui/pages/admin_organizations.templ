package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/attachments"
	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// ══════════════════════════════════════════════════════════════════════════
// DATA MODELS FOR DEDICATED ADMIN SCREENS
// ══════════════════════════════════════════════════════════════════════════

type AdminOrganizationsPageData struct {
	Organizations   []*org.Organization
	TotalOrgs       int
	TotalPharmacies int
	TotalVendors    int
	PendingCount    int
	ApprovedCount   int
	BranchCounts    map[int64]int
	UserCounts      map[int64]int
	SearchQuery     string
	TypeFilter      string
	StatusFilter    string
}

type AdminBranchesPageData struct {
	Branches         []*org.Branch
	Organizations    []*org.Organization
	OrgNames         map[int64]string
	OrgTypes         map[int64]string
	TotalBranches    int
	ActiveBranches   int
	PharmacyBranches int
	VendorWarehouses int
	SearchQuery      string
	SelectedOrgID    int64
	StatusFilter     string
}

type AdminUsersPageData struct {
	Users            []*identity.User
	Organizations    []*org.Organization
	OrgNames         map[int64]string
	DeletionRequests []*identity.AccountDeletionRequest
	TotalUsers       int
	CustomerUsers    int
	VendorUsers      int
	StaffUsers       int
	ActiveUsers      int
	SuspendedUsers   int
	SearchQuery      string
	RoleFilter       string
	StatusFilter     string
	// StaffRoles are the roles a new administrator may be created into. It is
	// populated only for a viewer who may assign roles, so the create form is
	// absent rather than present-and-refused for everyone else.
	StaffRoles []AdminUserRoleOption
	Notice     string
	NoticeKind string
}

type AdminOrgDetailData struct {
	Organization     *org.Organization
	Branches         []*org.Branch
	Employees        []*org.EmployeeView
	Documents        []*attachments.Document
	Wallet           *billing.Wallet
	RecentTxs        []*billing.WalletTransaction
	RecentDeposits   []*billing.WalletDeposit
	OrdersCount      int
	RecentOrders     []*commerce.Order
	AIUserID         string
	AIVirtualKey     string
}

// Backward compatibility legacy hub data
type AdminEnterpriseHubData struct {
	Organizations      []*org.Organization
	Branches           []*org.Branch
	Users              []*identity.User
	DeletionRequests   []*identity.AccountDeletionRequest
	ActiveTab          string
	CurrentType        string
	OrgNames           map[int64]string
	OrgTypes           map[int64]string
	BranchCounts       map[int64]int
	UserCounts         map[int64]int
	TotalOrgsCount     int
	TotalBranchesCount int
	TotalUsersCount    int
}

// ══════════════════════════════════════════════════════════════════════════
// 1. DEDICATED ORGANIZATIONS DIRECTORY PAGE
// ══════════════════════════════════════════════════════════════════════════

templ AdminOrganizationsPage(data AdminOrganizationsPageData, lang, dir string) {
	@layouts.AdminShell("إدارة المنشآت والمؤسسات الطبية", "organizations", lang, dir) {
		<div style="max-width:1440px; margin:0 auto; padding-bottom:3rem;">
			
			<!-- Header Banner & Quick Actions -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; margin-bottom:1.25rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div style="display:flex; align-items:center; gap:0.85rem;">
						<div style="width:46px; height:46px; border-radius:14px; background:rgba(168, 85, 247, 0.12); color:#a855f7; display:flex; align-items:center; justify-content:center; font-size:1.4rem; border:1px solid rgba(168, 85, 247, 0.25);">
							@components.IconBuilding("icon-sm")
						</div>
						<div>
							<h1 style="font-size:1.25rem; font-weight:900; color:var(--text); margin:0; display:flex; align-items:center; gap:0.5rem;">
								<span>إدارة المنشآت والمؤسسات المعتمدة</span>
								<span class="badge badge-purple text-xs fw-800 tabular-nums">{ fmt.Sprintf("%d منشأة", data.TotalOrgs) }</span>
							</h1>
							<p style="font-size:0.82rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
								الدليل الشامل لإدارة وتدقيق واعتماد شبكة الصيدليات ومستودعات وموردي الأدوية
							</p>
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
						<a href="/admin/approvals" class="btn btn-secondary btn-sm fw-800" style="padding:0.45rem 0.9rem; font-size:0.82rem; gap:0.35rem; border-radius:8px;">
							@components.IconShield("icon-xs")
							<span>مركز فحص التراخيص</span>
							if data.PendingCount > 0 {
								<span class="badge badge-amber text-xs tabular-nums">{ fmt.Sprintf("%d", data.PendingCount) }</span>
							}
						</a>
						<a href="/admin/organizations" class="btn btn-secondary btn-sm fw-800" style="padding:0.45rem 0.9rem; font-size:0.82rem; gap:0.35rem; border-radius:8px;">
							@components.IconRefresh("icon-xs")
							<span>تحديث</span>
						</a>
					</div>
				</div>

				<!-- Stats KPI Strip -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.75rem; margin-top:1.25rem; border-top:1px solid var(--border); padding-top:1rem;">
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">إجمالي المنشآت</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--text); margin-top:2px;">{ fmt.Sprintf("%d", data.TotalOrgs) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">الصيدليات المعتمدة</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:#10b981; margin-top:2px;">{ fmt.Sprintf("%d", data.TotalPharmacies) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">الموردون وشركات الأدوية</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:#a855f7; margin-top:2px;">{ fmt.Sprintf("%d", data.TotalVendors) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">بانتظار الاعتماد</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:#f59e0b; margin-top:2px;">{ fmt.Sprintf("%d", data.PendingCount) }</div>
					</div>
				</div>
			</div>

			<!-- Filter Bar -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:14px; padding:1rem 1.25rem; margin-bottom:1.25rem;">
				<form method="GET" action="/admin/organizations" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin:0;">
					<div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap; flex:1;">
						<input
							type="text"
							name="q"
							value={ data.SearchQuery }
							placeholder="ابحث بالاسم، السجل التجاري، الرقم الضريبي، أو الترخيص..."
							class="form-input"
							style="padding:0.5rem 0.9rem; font-size:0.85rem; min-width:280px; border-radius:8px;"
						/>
						<select name="type" class="form-select" style="padding:0.5rem 0.9rem; font-size:0.85rem; border-radius:8px; width:auto; font-weight:700;">
							<option value="">كل أنواع المنشآت</option>
							<option value="customer" selected?={ data.TypeFilter == "customer" }>صيدليات ومراكز طبية</option>
							<option value="vendor" selected?={ data.TypeFilter == "vendor" }>موردون ومخازن أدوية</option>
						</select>
						<select name="status" class="form-select" style="padding:0.5rem 0.9rem; font-size:0.85rem; border-radius:8px; width:auto; font-weight:700;">
							<option value="">كل حالات الاعتماد</option>
							<option value="approved" selected?={ data.StatusFilter == "approved" }>معتمدة ومفعلة (Approved)</option>
							<option value="pending" selected?={ data.StatusFilter == "pending" }>⏳ قيد المراجعة (Pending)</option>
							<option value="rejected" selected?={ data.StatusFilter == "rejected" }>مرفوضة (Rejected)</option>
						</select>
						<button type="submit" class="btn btn-secondary btn-sm fw-800" style="padding:0.5rem 1.1rem; border-radius:8px;">
							تصفية
						</button>
						if data.SearchQuery != "" || data.TypeFilter != "" || data.StatusFilter != "" {
							<a href="/admin/organizations" class="btn btn-secondary btn-sm text-muted rounded-md">إلغاء</a>
						}
					</div>
				</form>
			</div>

			<!-- Organizations Table -->
			if len(data.Organizations) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد منشآت مطابقة",
					Message: "لم يتم العثور على أي منشآت أو شركات تطابق معايير البحث والفلترة المحددة.",
				})
			} else {
				<div class="table-container" style="border:1px solid var(--border); border-radius:14px; overflow:hidden; background:var(--surface-raised); box-shadow:var(--shadow-sm);">
					<table class="data-table">
						<thead>
							<tr>
								<th class="nowrap"># المعرف</th>
								<th>المنشأة والاسم التجاري</th>
								<th class="nowrap">نوع النشاط</th>
								<th>السجل والضريبة والترخيص</th>
								<th class="nowrap">الفروع</th>
								<th class="nowrap">تاريخ الانضمام</th>
								<th class="nowrap">حالة الاعتماد</th>
								<th class="text-end" style="white-space:nowrap; min-width:140px;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range data.Organizations {
								<tr style="vertical-align:middle;">
									<td class="tabular-nums fw-800 text-primary nowrap">
										#{ fmt.Sprintf("ORG-%d", o.ID) }
									</td>
									<td>
										<div style="display:flex; align-items:center; gap:0.65rem;">
											<div style="width:36px; height:36px; border-radius:10px; background:var(--surface-sunken); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-weight:900; color:var(--text); font-size:0.9rem;">
												if len(o.LegalName) > 0 {
													{ string([]rune(o.LegalName)[0]) }
												} else {
													O
												}
											</div>
											<div>
												<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", o.ID)) } style="font-weight:800; font-size:0.92rem; color:var(--text); text-decoration:none;">
													{ o.LegalName }
												</a>
												if o.TradeName["ar"] != "" && o.TradeName["ar"] != o.LegalName {
													<div style="font-size:0.75rem; color:var(--text-secondary); margin-top:1px;">{ o.TradeName["ar"] }</div>
												}
											</div>
										</div>
									</td>
									<td>
										if string(o.Type) == "vendor" {
											<span class="badge badge-purple text-xs fw-800" style="padding:0.25rem 0.6rem; border-radius:6px;">مورد أدوية</span>
										} else {
											<span class="badge badge-emerald text-xs fw-800" style="padding:0.25rem 0.6rem; border-radius:6px;">صيدلية</span>
										}
									</td>
									<td>
										<div style="font-size:0.78rem; display:flex; flex-direction:column; gap:0.2rem;" class="tabular-nums text-muted">
											if o.CommercialRegister != "" {
												<div><strong style="color:var(--text-secondary);">سجل:</strong> { o.CommercialRegister }</div>
											}
											if o.TaxNumber != "" {
												<div><strong style="color:var(--text-secondary);">ضريبة:</strong> { o.TaxNumber }</div>
											}
											if o.PharmacistLicense != "" {
												<div><strong style="color:var(--text-secondary);">ترخيص:</strong> { o.PharmacistLicense }</div>
											}
										</div>
									</td>
									<td>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/branches?org_id=%d", o.ID)) } class="badge badge-sky text-xs fw-800" style="padding:0.25rem 0.6rem; border-radius:6px; text-decoration:none;" title="استعراض فروع هذه المنشأة">
											{ fmt.Sprintf("%d فرع", data.BranchCounts[o.ID]) }
										</a>
									</td>
									<td class="tabular-nums text-xs text-muted nowrap">
										{ o.CreatedAt.Format("2006-01-02") }
									</td>
									<td>
										if string(o.Status) == "approved" {
											<span class="badge badge-emerald text-xs fw-800" style="padding:0.25rem 0.6rem; border-radius:6px;">معتمد ومفعل</span>
										} else if string(o.Status) == "pending" {
											<span class="badge badge-amber text-xs fw-800" style="padding:0.25rem 0.6rem; border-radius:6px;">⏳ قيد التدقيق</span>
										} else if string(o.Status) == "rejected" {
											<span class="badge badge-danger text-xs fw-800" style="padding:0.25rem 0.6rem; border-radius:6px;">مرفوض</span>
										} else {
											<span class="badge badge-slate text-xs fw-800" style="padding:0.25rem 0.6rem; border-radius:6px;">{ string(o.Status) }</span>
										}
									</td>
									<td class="text-end nowrap">
										<div style="display:inline-flex; gap:0.4rem; justify-content:flex-end; align-items:center;">
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", o.ID)) } class="btn btn-secondary btn-xs fw-800" style="padding:0.35rem 0.75rem; border-radius:6px;">
												<span>الملف الشامل ↗</span>
											</a>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

		</div>
	}
}

// ══════════════════════════════════════════════════════════════════════════
// 2. DEDICATED BRANCHES & WAREHOUSES DIRECTORY PAGE
// ══════════════════════════════════════════════════════════════════════════

templ AdminBranchesPage(data AdminBranchesPageData, lang, dir string) {
	@layouts.AdminShell("دليل الفروع ومواقع التخزين", "branches", lang, dir) {
		<div style="max-width:1440px; margin:0 auto; padding-bottom:3rem;">
			
			<!-- Header Banner -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; margin-bottom:1.25rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div style="display:flex; align-items:center; gap:0.85rem;">
						<div style="width:46px; height:46px; border-radius:14px; background:rgba(56, 189, 248, 0.12); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.4rem; border:1px solid rgba(56, 189, 248, 0.25);">
							@components.IconMapPin("icon-sm")
						</div>
						<div>
							<h1 style="font-size:1.25rem; font-weight:900; color:var(--text); margin:0; display:flex; align-items:center; gap:0.5rem;">
								<span>دليل الفروع ومواقع التخزين والمستودعات</span>
								<span class="badge badge-sky text-xs fw-800 tabular-nums">{ fmt.Sprintf("%d فرع ومخزن", data.TotalBranches) }</span>
							</h1>
							<p style="font-size:0.82rem; color:var(--text-secondary); margin:0.2rem 0 0 0;">
								إدارة ومتابعة كافة نقاط الاستلام والتوريد ومواقع التخزين المركزية للصيدليات والموردين
							</p>
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
						<a href="/admin/weekly-coverages" class="btn btn-secondary btn-sm fw-800" style="padding:0.45rem 0.9rem; font-size:0.82rem; gap:0.35rem; border-radius:8px;">
							@components.IconTruck("icon-xs")
							<span>جداول التغطية الأسبوعية</span>
						</a>
						<a href="/admin/branches" class="btn btn-secondary btn-sm fw-800" style="padding:0.45rem 0.9rem; font-size:0.82rem; gap:0.35rem; border-radius:8px;">
							@components.IconRefresh("icon-xs")
							<span>تحديث</span>
						</a>
					</div>
				</div>

				<!-- Stats KPI Strip -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.75rem; margin-top:1.25rem; border-top:1px solid var(--border); padding-top:1rem;">
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">إجمالي الفروع والمخازن</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--text); margin-top:2px;">{ fmt.Sprintf("%d", data.TotalBranches) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">الفروع النشطة</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:#10b981; margin-top:2px;">{ fmt.Sprintf("%d", data.ActiveBranches) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">فروع الصيدليات</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:#10b981; margin-top:2px;">{ fmt.Sprintf("%d", data.PharmacyBranches) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.75rem 1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">مستودعات الموردين</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:#a855f7; margin-top:2px;">{ fmt.Sprintf("%d", data.VendorWarehouses) }</div>
					</div>
				</div>
			</div>

			<!-- Filter Bar -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:14px; padding:1rem 1.25rem; margin-bottom:1.25rem;">
				<form method="GET" action="/admin/branches" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin:0;">
					<div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap; flex:1;">
						<input
							type="text"
							name="q"
							value={ data.SearchQuery }
							placeholder="ابحث باسم الفرع، الكود، العنوان، أو المنشأة..."
							class="form-input"
							style="padding:0.5rem 0.9rem; font-size:0.85rem; min-width:280px; border-radius:8px;"
						/>
						<select name="org_id" class="form-select" style="padding:0.5rem 0.9rem; font-size:0.85rem; border-radius:8px; width:auto; font-weight:700;">
							<option value="0">كافة المنشآت والشركات</option>
							for _, o := range data.Organizations {
								<option value={ fmt.Sprintf("%d", o.ID) } selected?={ o.ID == data.SelectedOrgID }>{ o.LegalName }</option>
							}
						</select>
						<select name="status" class="form-select" style="padding:0.5rem 0.9rem; font-size:0.85rem; border-radius:8px; width:auto; font-weight:700;">
							<option value="">كل الحالات</option>
							<option value="active" selected?={ data.StatusFilter == "active" }>نشط ومفعل</option>
							<option value="inactive" selected?={ data.StatusFilter == "inactive" }>معطل</option>
						</select>
						<button type="submit" class="btn btn-secondary btn-sm fw-800" style="padding:0.5rem 1.1rem; border-radius:8px;">
							تصفية
						</button>
						if data.SearchQuery != "" || data.SelectedOrgID > 0 || data.StatusFilter != "" {
							<a href="/admin/branches" class="btn btn-secondary btn-sm text-muted rounded-md">إلغاء</a>
						}
					</div>
				</form>
			</div>

			<!-- Branches Table -->
			if len(data.Branches) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد فروع مسجلة",
					Message: "لم يتم العثور على فروع أو مواقع تخزين تطابق معايير الفلترة المحددة.",
				})
			} else {
				<div class="table-container" style="border:1px solid var(--border); border-radius:14px; overflow:hidden; background:var(--surface-raised); box-shadow:var(--shadow-sm);">
					<table class="data-table">
						<thead>
							<tr>
								<th>اسم الفرع والكود</th>
								<th>المنشأة التابع لها</th>
								<th class="nowrap">نوع الفرع اللوجستي</th>
								<th>العنوان وبيانات الاتصال</th>
								<th class="nowrap">الحالة</th>
								<th class="text-end" style="white-space:nowrap; min-width:140px;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, b := range data.Branches {
								<tr style="vertical-align:middle;">
									<td>
										<div style="font-weight:800; font-size:0.92rem; color:var(--text);">
											if b.Name["ar"] != "" {
												{ b.Name["ar"] }
											} else {
												{ b.Name["en"] }
											}
										</div>
										if b.Code != "" {
											<div class="text-xs text-muted tabular-nums" style="margin-top:2px;" dir="ltr">
												<code>{ b.Code }</code>
											</div>
										}
									</td>
									<td>
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", b.OrganizationID)) } style="font-weight:800; color:var(--text); text-decoration:none;">
											{ getOrgLegalName(b.OrganizationID, data.OrgNames) }
										</a>
										<div style="margin-top:2px;">
											<span class="badge badge-slate text-xs">{ getOrgTypeBadge(b.OrganizationID, data.OrgTypes) }</span>
										</div>
									</td>
									<td>
										<span class="badge badge-sky text-xs fw-800">
											if b.WarehouseType != "" {
												{ b.WarehouseType }
											} else {
												<span>فرع تشغيلي</span>
											}
										</span>
									</td>
									<td>
										<div style="font-size:0.8rem; color:var(--text);">{ b.Address }</div>
										if b.Phone != "" {
											<div class="text-xs text-muted tabular-nums" style="margin-top:2px;">{ b.Phone }</div>
										}
									</td>
									<td>
										if b.Status == "active" || b.Status == "" {
											<span class="badge badge-emerald text-xs fw-800">نشط ومفعل</span>
										} else {
											<span class="badge badge-danger text-xs fw-800">معطل</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/branches/%d", b.ID)) } class="btn btn-secondary btn-xs fw-800" style="padding:0.35rem 0.75rem; border-radius:6px;">
											<span>التفاصيل ↗</span>
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

		</div>
	}
}

// ══════════════════════════════════════════════════════════════════════════
// 3. DEDICATED USERS & ACCOUNTS MANAGEMENT PAGE
// ══════════════════════════════════════════════════════════════════════════

templ AdminUsersPage(data AdminUsersPageData, lang, dir string) {
	@layouts.AdminShell("إدارة المستخدمين والحسابات", "users", lang, dir) {
		<div style="max-width:1440px; margin:0 auto; padding-bottom:3rem;" x-data="{ showAddStaff: false }">
			@roleNotice(data.NoticeKind, data.Notice)
			@adminStaffCreateForm(data)
			
			<!-- Header Banner -->
			<div class="glass-panel p-5 mb-5 border border-slate-200/80 rounded-2xl shadow-sm">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 d-flex items-center justify-center border border-indigo-200/60 shadow-2xs">
							@components.IconUsers("icon-sm")
						</div>
						<div>
							<h1 class="text-xl font-black text-primary m-0 d-flex items-center gap-2">
								<span>إدارة المستخدمين والحسابات المركزية</span>
								<span class="badge badge-indigo text-xs font-black tabular-nums">{ fmt.Sprintf("%d حساب", data.TotalUsers) }</span>
							</h1>
							<p class="text-xs text-secondary m-0 mt-0.5 font-medium">
								التحكم في حسابات الصيادلة، مدراء وموظفي الموردين، ومشرفي وإدارة المنصة
							</p>
						</div>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap">
						if len(data.StaffRoles) > 0 {
							<button type="button" class="btn btn-primary btn-sm font-black gap-1.5 shadow-sm" @click="showAddStaff = !showAddStaff">
								@components.IconPlus("icon-xs")
								<span>مشرف جديد</span>
							</button>
						}
						<a href="/admin/roles" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
							@components.IconShield("icon-xs")
							<span>الأدوار والصلاحيات (RBAC)</span>
						</a>
						<a href="/admin/users" class="btn btn-secondary btn-sm font-bold gap-1.5 shadow-xs">
							@components.IconRefresh("icon-xs")
							<span>تحديث</span>
						</a>
					</div>
				</div>

				<!-- Stats KPI Strip -->
				<div class="d-grid grid-cols-2 md:grid-cols-4 gap-3 mt-4 pt-3.5 border-t border-slate-100">
					<div class="bg-surface-sunken p-3 rounded-xl border border-slate-200/70">
						<div class="text-xs text-muted font-bold">إجمالي المستخدمين</div>
						<div class="tabular-nums text-lg font-black text-primary mt-0.5">{ fmt.Sprintf("%d", data.TotalUsers) }</div>
					</div>
					<div class="bg-surface-sunken p-3 rounded-xl border border-slate-200/70">
						<div class="text-xs text-muted font-bold">عملاء الصيدليات</div>
						<div class="tabular-nums text-lg font-black text-emerald-600 mt-0.5">{ fmt.Sprintf("%d", data.CustomerUsers) }</div>
					</div>
					<div class="bg-surface-sunken p-3 rounded-xl border border-slate-200/70">
						<div class="text-xs text-muted font-bold">حسابات الموردين</div>
						<div class="tabular-nums text-lg font-black text-purple-600 mt-0.5">{ fmt.Sprintf("%d", data.VendorUsers) }</div>
					</div>
					<div class="bg-surface-sunken p-3 rounded-xl border border-slate-200/70">
						<div class="text-xs text-muted font-bold">إدارة المنصة (Staff)</div>
						<div class="tabular-nums text-lg font-black text-brand mt-0.5">{ fmt.Sprintf("%d", data.StaffUsers) }</div>
					</div>
				</div>
			</div>

			<!-- Filter Bar -->
			<div class="glass-panel p-4 mb-5 border border-slate-200/80 rounded-2xl shadow-xs">
				<form method="GET" action="/admin/users" class="flex-between items-center flex-wrap gap-3 m-0">
					<div class="d-flex gap-2 items-center flex-wrap flex-1">
						<input
							type="text"
							name="q"
							value={ data.SearchQuery }
							placeholder="ابحث بالاسم، البريد الإلكتروني، أو رقم الهاتف..."
							class="form-input text-xs"
							style="min-width:280px;"
						/>
						<select name="role" class="form-select text-xs font-bold w-auto">
							<option value="">كل الأدوار الوظيفية</option>
							<option value="customer" selected?={ data.RoleFilter == "customer" }>صيدلي / عميل</option>
							<option value="vendor" selected?={ data.RoleFilter == "vendor" }>مورد / موظف مورد</option>
							<option value="staff" selected?={ data.RoleFilter == "staff" }>إدارة ومشرفو المنصة</option>
						</select>
						<select name="status" class="form-select text-xs font-bold w-auto">
							<option value="">كل الحالات</option>
							<option value="active" selected?={ data.StatusFilter == "active" }>نشط ومفعل</option>
							<option value="suspended" selected?={ data.StatusFilter == "suspended" }>موقوف / معلق</option>
						</select>
						<button type="submit" class="btn btn-secondary btn-sm font-black shadow-2xs">
							تصفية
						</button>
						if data.SearchQuery != "" || data.RoleFilter != "" || data.StatusFilter != "" {
							<a href="/admin/users" class="btn btn-secondary btn-sm text-muted font-bold shadow-2xs">إلغاء</a>
						}
					</div>
				</form>
			</div>

			<!-- Users Table -->
			if len(data.Users) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا يوجد مستخدمون",
					Message: "لم يتم العثور على أي مستخدمين يطابقون معايير الفلترة المحددة.",
				})
			} else {
				<div class="glass-panel p-0 border border-slate-200/80 rounded-2xl shadow-xs overflow-hidden">
					<div class="table-container m-0 overflow-x-auto">
						<table class="data-table m-0 text-xs w-full">
							<thead>
								<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
									<th class="py-3 text-start ps-4">المستخدم</th>
									<th class="py-3 text-start">البريد الإلكتروني ورقم الهاتف</th>
									<th class="py-3 text-start">الدور الوظيفي والصلاحية</th>
									<th class="py-3 text-center">تاريخ الانضمام</th>
									<th class="py-3 text-center">الحالة</th>
									<th class="text-end py-3 pe-4">الإجراءات</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								for _, u := range data.Users {
									<tr class="hover:bg-slate-50/50 transition-colors">
										<td class="py-3 ps-4">
											<div class="d-flex items-center gap-2.5">
												<div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-100 d-flex items-center justify-center font-black text-xs shadow-2xs">
													if len(userDisplayName(u)) > 0 {
														{ string([]rune(userDisplayName(u))[0]) }
													} else {
														U
													}
												</div>
												<div>
													<div class="font-extrabold text-primary text-xs">{ userDisplayName(u) }</div>
													<div class="text-2xs text-muted tabular-nums font-mono">#{ fmt.Sprintf("USR-%d", u.ID) }</div>
												</div>
											</div>
										</td>
										<td class="py-3">
											<div class="tabular-nums text-xs font-mono text-secondary" dir="ltr">{ u.Email }</div>
											if u.Phone != "" {
												<div class="text-2xs text-muted mt-0.5 tabular-nums">{ u.Phone }</div>
											}
										</td>
										<td class="py-3">
											<span class={ "badge text-xs font-bold shadow-2xs", roleBadgeClass(u.Role) }>
												{ roleDisplayAr(u.Role) }
											</span>
										</td>
										<td class="tabular-nums text-xs text-muted text-center py-3">
											{ u.CreatedAt.Format("2006-01-02") }
										</td>
										<td class="text-center py-3">
											if u.Status == identity.StatusActive {
												<span class="badge badge-emerald text-xs font-black shadow-2xs">نشط ومفعل</span>
											} else if u.Status == identity.StatusSuspended {
												<span class="badge badge-rose text-xs font-black shadow-2xs">موقوف / معلق</span>
											} else {
												<span class="badge badge-amber text-xs font-black shadow-2xs">قيد المراجعة</span>
											}
										</td>
										<td class="text-end py-3 pe-4">
											<div class="d-inline-flex gap-1.5 justify-end items-center">
												if u.Status == identity.StatusActive {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/suspend", u.ID)) } class="m-0" onsubmit="return confirm('هل أنت متأكد من رغبتك في تعليق هذا الحساب؟');">
														<button type="submit" class="btn btn-secondary btn-xs font-bold text-rose-600 shadow-2xs">
															تعليق
														</button>
													</form>
												} else {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reactivate", u.ID)) } class="m-0">
														<button type="submit" class="btn btn-primary btn-xs font-bold shadow-2xs">
															تفعيل
														</button>
													</form>
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}


		</div>
	}
}

// ══════════════════════════════════════════════════════════════════════════
// 4. DEEP 360° ORGANIZATION PROFILE OVERHAUL (/admin/organizations/{id})
// ══════════════════════════════════════════════════════════════════════════

templ AdminOrganizationDetailPage(data AdminOrgDetailData, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("ملف المنشأة: %s", data.Organization.LegalName), "organizations", lang, dir) {
		<div style="max-width:1440px; margin:0 auto; padding-bottom:3rem;">
			
			<!-- Executive Header Card -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.5rem; margin-bottom:1.25rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem;">
					<div style="display:flex; align-items:center; gap:1rem;">
						<div style="width:58px; height:58px; border-radius:16px; background:var(--surface-sunken); border:2px solid var(--border); display:flex; align-items:center; justify-content:center; font-weight:900; font-size:1.5rem; color:var(--accent);">
							if len(data.Organization.LegalName) > 0 {
								{ string([]rune(data.Organization.LegalName)[0]) }
							} else {
								@components.IconBuilding("icon-sm")
							}
						</div>
						<div>
							<div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
								<h1 style="font-size:1.4rem; font-weight:900; color:var(--text); margin:0;">
									{ data.Organization.LegalName }
								</h1>
								if string(data.Organization.Type) == "vendor" {
									<span class="badge badge-purple text-xs fw-800" style="padding:0.3rem 0.75rem; border-radius:6px;">مورد أدوية معتمد</span>
								} else {
									<span class="badge badge-emerald text-xs fw-800" style="padding:0.3rem 0.75rem; border-radius:6px;">صيدلية معتمدة</span>
								}
								<span class="tabular-nums text-xs text-muted font-bold">#{ fmt.Sprintf("ORG-%d", data.Organization.ID) }</span>
							</div>
							if data.Organization.TradeName["ar"] != "" && data.Organization.TradeName["ar"] != data.Organization.LegalName {
								<div style="font-size:0.85rem; color:var(--text-secondary); margin-top:2px;">
									الاسم التجاري: <strong class="text-body">{ data.Organization.TradeName["ar"] }</strong>
								</div>
							}
							<div style="display:flex; align-items:center; gap:1rem; margin-top:0.4rem; font-size:0.8rem; color:var(--text-muted); flex-wrap:wrap;">
								<span>تاريخ التسجيل: <strong class="tabular-nums text-secondary">{ data.Organization.CreatedAt.Format("2006-01-02 15:04") }</strong></span>
								if string(data.Organization.Status) == "approved" {
									<span class="badge badge-emerald text-xs fw-800">معتمد ومفعل في المنظومة</span>
								} else if string(data.Organization.Status) == "pending" {
									<span class="badge badge-amber text-xs fw-800">⏳ قيد المراجعة والتدقيق</span>
								} else if string(data.Organization.Status) == "rejected" {
									<span class="badge badge-danger text-xs fw-800">مرفوض</span>
								}
							</div>
						</div>
					</div>

					<!-- Header Actions Bar -->
					<div class="inline-row-wrap">
						if string(data.Organization.Status) == "pending" {
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/approve", data.Organization.ID)) } class="m-0" onsubmit="return confirm('تأكيد اعتماد هذه المنشأة وتفعيل حسابها بالكامل؟');">
								<button type="submit" class="btn btn-xs fw-800" style="background:#059669; color:#ffffff !important; border:1px solid #10b981; padding:0.45rem 1rem; border-radius:8px; font-size:0.85rem;">
									@components.IconCheck("icon-xs")
									<span style="color:#ffffff !important;">اعتماد المنشأة فوراً </span>
								</button>
							</form>
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/reject", data.Organization.ID)) } class="m-0" onsubmit="return confirm('تأكيد رفض هذه المنشأة؟');">
								<button type="submit" class="btn btn-xs fw-800" style="background:#dc2626; color:#ffffff !important; border:1px solid #ef4444; padding:0.45rem 1rem; border-radius:8px; font-size:0.85rem;">
									@components.IconClose("icon-xs")
									<span style="color:#ffffff !important;">رفض المنشأة </span>
								</button>
							</form>
						} else if string(data.Organization.Status) == "approved" {
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/suspend", data.Organization.ID)) } class="m-0" onsubmit="return confirm('تأكيد تعليق هذه المنشأة؟');">
								<button type="submit" class="btn btn-secondary btn-sm fw-800 text-danger rounded-md">
									تعليق المنشأة
								</button>
							</form>
						}

						<a href="/admin/organizations" class="btn btn-secondary btn-sm fw-800" style="gap:0.3rem; border-radius:8px;">
							@components.IconArrowRight("icon-xs")
							<span>العودة للمنشآت</span>
						</a>
					</div>
				</div>

				<!-- 4 High-Impact Stat Tiles -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:0.75rem; margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1.25rem;">
					<div style="background:var(--surface-sunken); padding:0.85rem 1.1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">الفروع ومواقع التخزين</div>
						<div class="tabular-nums" style="font-size:1.4rem; font-weight:900; color:var(--accent); margin-top:2px;">
							{ fmt.Sprintf("%d", len(data.Branches)) } <span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">فرع ومخزن</span>
						</div>
					</div>

					<div style="background:var(--surface-sunken); padding:0.85rem 1.1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">فريق العمل والموظفون</div>
						<div class="tabular-nums" style="font-size:1.4rem; font-weight:900; color:#a855f7; margin-top:2px;">
							{ fmt.Sprintf("%d", len(data.Employees)) } <span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">عضو مسجل</span>
						</div>
					</div>

					<div style="background:var(--surface-sunken); padding:0.85rem 1.1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">رصيد المحفظة المالية</div>
						<div class="tabular-nums" style="font-size:1.4rem; font-weight:900; color:#10b981; margin-top:2px;">
							if data.Wallet != nil {
								{ data.Wallet.Balance.String() } ج.م
							} else {
								<span>0.00 ج.م</span>
							}
						</div>
					</div>

					<div style="background:var(--surface-sunken); padding:0.85rem 1.1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">أوامر التوريد والعمليات</div>
						<div class="tabular-nums" style="font-size:1.4rem; font-weight:900; color:var(--text); margin-top:2px;">
							{ fmt.Sprintf("%d", data.OrdersCount) } <span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">طلب توريد</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Main 2-Column Overview Grid -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(440px, 1fr)); gap:1.25rem; margin-bottom:1.25rem; align-items:start;">
				
				<!-- Card 1: Legal & Registration Profile -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
							<span>@components.IconFileText("icon-sm")</span>
							<span>البيانات القانونية والتراخيص الرسمية</span>
						</h3>
					</div>

					<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; font-size:0.85rem;">
						<div>
							<div class="label-strong">الاسم القانوني المسجل</div>
							<div style="font-weight:800; color:var(--text); margin-top:3px;">{ data.Organization.LegalName }</div>
						</div>

						<div>
							<div class="label-strong">نوع النشاط</div>
							<div style="margin-top:3px;">
								if string(data.Organization.Type) == "vendor" {
									<span class="badge badge-purple text-xs fw-800">مورد ومستودع أدوية</span>
								} else {
									<span class="badge badge-emerald text-xs fw-800">صيدلية مرخصة</span>
								}
							</div>
						</div>

						<div style="background:var(--surface-sunken); padding:0.6rem 0.75rem; border-radius:8px; border:1px solid var(--border);">
							<div class="label-strong">رقم السجل التجاري (CR)</div>
							<div class="tabular-nums" style="font-weight:900; color:var(--text); font-size:1rem; margin-top:2px;">
								if data.Organization.CommercialRegister != "" {
									{ data.Organization.CommercialRegister }
								} else {
									<span class="text-muted text-xs">غير مسجل</span>
								}
							</div>
						</div>

						<div style="background:var(--surface-sunken); padding:0.6rem 0.75rem; border-radius:8px; border:1px solid var(--border);">
							<div class="label-strong">الرقم الضريبي (Tax ID)</div>
							<div class="tabular-nums" style="font-weight:900; color:var(--text); font-size:1rem; margin-top:2px;">
								if data.Organization.TaxNumber != "" {
									{ data.Organization.TaxNumber }
								} else {
									<span class="text-muted text-xs">غير مسجل</span>
								}
							</div>
						</div>

						<div style="grid-column:span 2; background:var(--surface-sunken); padding:0.6rem 0.75rem; border-radius:8px; border:1px solid var(--border);">
							<div class="label-strong">رقم ترخيص الصيدلي / المنشأة</div>
							<div class="tabular-nums" style="font-weight:900; color:var(--accent); font-size:1.05rem; margin-top:2px;">
								if data.Organization.PharmacistLicense != "" {
									{ data.Organization.PharmacistLicense }
								} else {
									<span class="text-muted text-xs">غير مسجل</span>
								}
							</div>
						</div>
					</div>

					<!-- AI Gateway Credentials Box -->
					<div style="margin-top:1rem; padding-top:1rem; border-top:1px solid var(--border);">
						<div style="font-size:0.75rem; font-weight:800; color:var(--text-secondary); margin-bottom:0.4rem;">إعدادات بوابة الذكاء الاصطناعي (AI Gateway):</div>
						<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:10px; padding:0.6rem 0.85rem; font-size:0.78rem; display:flex; flex-direction:column; gap:0.3rem;">
							<div style="display:flex; justify-content:space-between;">
								<span class="text-muted">معرف الـ AI User:</span>
								<strong class="tabular-nums" dir="ltr">{ data.AIUserID }</strong>
							</div>
							<div style="display:flex; justify-content:space-between;">
								<span class="text-muted">حالة المفتاح الافتراضي:</span>
								if data.AIVirtualKey != "" {
									<span style="color:#10b981; font-weight:800;">مفعل ومربوط </span>
								} else {
									<span style="color:#f59e0b; font-weight:800;">جاهز للتوليد</span>
								}
							</div>
						</div>
					</div>
				</div>

				<!-- Card 2: Uploaded Compliance Documents -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
							<span>@components.IconFileText("icon-sm")</span>
							<span>المستندات والتراخيص المرفوعة</span>
							<span class="badge badge-sky text-xs fw-800 tabular-nums">{ fmt.Sprintf("%d مستند", len(data.Documents)) }</span>
						</h3>
						<a href="/admin/approvals?tab=documents" class="btn btn-secondary btn-xs fw-800">
							مركز المستندات
						</a>
					</div>

					if len(data.Documents) == 0 {
						<div style="padding:2rem 1rem; text-align:center; background:var(--surface-sunken); border:1px dashed var(--border); border-radius:12px; font-size:0.82rem; color:var(--text-muted);">
							لم يتم رفع أي مستندات أو وثائق تراخيص لهذه المنشأة حتى الآن.
						</div>
					} else {
						<div style="display:flex; flex-direction:column; gap:0.6rem;">
							for _, doc := range data.Documents {
								<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:12px; padding:0.75rem 1rem; display:flex; justify-content:space-between; align-items:center; gap:0.75rem;">
									<div class="inline-row-06">
										<div style="width:34px; height:34px; border-radius:8px; background:var(--surface-raised); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--accent);">
											@components.IconFile("icon-xs")
										</div>
										<div>
											<div style="font-weight:800; font-size:0.85rem; color:var(--text);">{ doc.Title }</div>
											<div class="text-xs text-muted tabular-nums">{ string(doc.DocumentType) } • { doc.CreatedAt.Format("2006-01-02") }</div>
										</div>
									</div>
									<div class="inline-row-04">
										if doc.Status == "verified" {
											<span class="badge badge-emerald text-xs fw-800">معتمد </span>
										} else if doc.Status == "rejected" {
											<span class="badge badge-danger text-xs fw-800">مرفوض</span>
										} else {
											<span class="badge badge-amber text-xs fw-800">قيد المراجعة</span>
										}
										if doc.FileURL != "" {
											<a href={ templ.SafeURL(doc.FileURL) } target="_blank" class="btn btn-secondary btn-xs fw-800" style="padding:0.25rem 0.6rem;">
												معاينة 
											</a>
										}
									</div>
								</div>
							}
						</div>
					}
				</div>

			</div>

			<!-- Lower Grid: Branches & Team -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(440px, 1fr)); gap:1.25rem; margin-bottom:1.25rem; align-items:start;">
				
				<!-- Branches Table Card -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
							<span>@components.IconMapPin("icon-sm")</span>
							<span>الفروع والمستودعات التابعة</span>
							<span class="badge badge-sky text-xs fw-800 tabular-nums">{ fmt.Sprintf("%d", len(data.Branches)) }</span>
						</h3>
					</div>

					if len(data.Branches) == 0 {
						<div style="padding:2rem 1rem; text-align:center; background:var(--surface-sunken); border:1px dashed var(--border); border-radius:12px; font-size:0.82rem; color:var(--text-muted);">
							لا توجد فروع أو مخازن مسجلة تابعة لهذه المنشأة.
						</div>
					} else {
						<div style="border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--surface-sunken);">
							<table class="data-table" style="font-size:0.8rem">
								<thead>
									<tr style="background:var(--surface-raised);">
										<th>اسم الفرع</th>
										<th>الكود</th>
										<th>العنوان</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, b := range data.Branches {
										<tr class="rule-bottom">
											<td style="font-weight:800; color:var(--text);">
												if b.Name["ar"] != "" {
													{ b.Name["ar"] }
												} else {
													{ b.Name["en"] }
												}
											</td>
											<td class="tabular-nums" dir="ltr"><code>{ b.Code }</code></td>
											<td>{ b.Address }</td>
											<td>
												if b.Status == "active" || b.Status == "" {
													<span class="badge badge-emerald text-xs fw-800">نشط</span>
												} else {
													<span class="badge badge-danger text-xs fw-800">معطل</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Team Members Table Card -->
				<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.25rem 1.5rem; box-shadow:var(--shadow-sm);">
					<div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.75rem; border-bottom:1px solid var(--border); margin-bottom:1rem;">
						<h3 style="font-size:1.05rem; font-weight:800; color:var(--text); margin:0; display:flex; align-items:center; gap:0.4rem;">
							<span>@components.IconUsers("icon-sm")</span>
							<span>فريق العمل والمستخدمون المرتبطون</span>
							<span class="badge badge-indigo text-xs fw-800 tabular-nums">{ fmt.Sprintf("%d", len(data.Employees)) }</span>
						</h3>
					</div>

					if len(data.Employees) == 0 {
						<div style="padding:2rem 1rem; text-align:center; background:var(--surface-sunken); border:1px dashed var(--border); border-radius:12px; font-size:0.82rem; color:var(--text-muted);">
							لم يتم إضافة أي موظفين أو مستخدمين تابعين لهذه المنشأة.
						</div>
					} else {
						<div style="border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--surface-sunken);">
							<table class="data-table" style="font-size:0.8rem">
								<thead>
									<tr style="background:var(--surface-raised);">
										<th>الاسم</th>
										<th>البريد الإلكتروني</th>
										<th>الدور الوظيفي</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, e := range data.Employees {
										<tr class="rule-bottom">
											<td style="font-weight:800; color:var(--text);">{ e.UserName }</td>
											<td class="tabular-nums text-muted text-xs" dir="ltr">{ e.UserEmail }</td>
											<td><span class="badge badge-secondary text-xs">{ e.RoleName }</span></td>
											<td>
												if e.Member != nil && e.Member.IsActive {
													<span class="badge badge-emerald text-xs fw-800">نشط</span>
												} else {
													<span class="badge badge-danger text-xs fw-800">معطل</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

			</div>

		</div>
	}
}

// ══════════════════════════════════════════════════════════════════════════
// BACKWARD COMPATIBILITY ALIASES & HELPERS
// ══════════════════════════════════════════════════════════════════════════

templ AdminOrganizations(data AdminEnterpriseHubData, lang, dir string) {
	@AdminOrganizationsPage(AdminOrganizationsPageData{
		Organizations:   data.Organizations,
		TotalOrgs:       data.TotalOrgsCount,
		TotalPharmacies: data.TotalOrgsCount,
		TotalVendors:    0,
		PendingCount:    0,
		ApprovedCount:   data.TotalOrgsCount,
		BranchCounts:    data.BranchCounts,
		UserCounts:      data.UserCounts,
		SearchQuery:     "",
		TypeFilter:      data.CurrentType,
		StatusFilter:    "",
	}, lang, dir)
}

templ AdminOrganizationDetail(o *org.Organization, branches []*org.Branch, employees []*org.EmployeeView, activeTab string, lang, dir string) {
	@AdminOrganizationDetailPage(AdminOrgDetailData{
		Organization: o,
		Branches:     branches,
		Employees:    employees,
	}, lang, dir)
}

func getOrgLegalName(id int64, names map[int64]string) string {
	if name, ok := names[id]; ok && name != "" {
		return name
	}
	if id > 0 {
		return fmt.Sprintf("منشأة #%d", id)
	}
	return "المنصة الرئيسية"
}

func getOrgTypeBadge(id int64, types map[int64]string) string {
	if t, ok := types[id]; ok {
		if t == "vendor" {
			return "مورد"
		}
		return "صيدلية"
	}
	return "منشأة"
}

func dayOfWeekAr(day int) string {
	days := []string{"الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"}
	if day >= 0 && day < len(days) {
		return days[day]
	}
	return "—"
}

// AdminBranchDetailPage renders detail for a single branch.
templ AdminBranchDetailPage(b *org.Branch, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل الفرع: %s", b.Name.Get("ar")), "branches", lang, dir) {
		<div style="max-width:1100px; margin:0 auto; padding-bottom:3rem;">
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.5rem; margin-bottom:1.25rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div>
						<h1 style="font-size:1.3rem; font-weight:900; color:var(--text); margin:0;">{ b.Name.Get("ar") }</h1>
						<p style="font-size:0.85rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
							كود الفرع: <strong class="tabular-nums">{ b.Code }</strong> | منشأة #{ fmt.Sprintf("%d", b.OrganizationID) }
						</p>
					</div>
					<a href="/admin/branches" class="btn btn-secondary btn-sm fw-800 rounded-md">العودة لدليل الفروع ←</a>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.25rem; margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1.25rem;">
					<div style="background:var(--surface-sunken); padding:1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">العنوان الجغرافي</div>
						<div style="font-weight:800; color:var(--text); margin-top:0.25rem;">{ b.Address }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">هاتف التواصل</div>
						<div class="tabular-nums" style="font-weight:800; color:var(--text); margin-top:0.25rem;">{ b.Phone }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">ساعات العمل والتشغيل</div>
						<div style="font-weight:800; color:var(--text); margin-top:0.25rem;">⏰ { b.OperatingHours }</div>
					</div>
				</div>
			</div>
		</div>
	}
}

// AdminWeeklyCoveragesData carries view models for weekly coverages admin inspection.
type AdminWeeklyCoveragesData struct {
	Coverages     []*workflow.CoverageView
	Organizations []*org.Organization
	Branches      []*org.Branch
	Cities        []*platformadmin.City
	SelectedOrgID int64
}

func countActiveCoverages(coverages []*workflow.CoverageView) int {
	c := 0
	for _, cov := range coverages {
		if cov.IsActive {
			c++
		}
	}
	return c
}

func countCoveredCities(coverages []*workflow.CoverageView) int {
	cities := make(map[string]bool)
	for _, cov := range coverages {
		if cov.CityName != "" {
			cities[cov.CityName] = true
		}
	}
	return len(cities)
}

// AdminWeeklyCoveragesPage renders weekly coverage rules filtered by selected organization with full controls.
templ AdminWeeklyCoveragesPage(data AdminWeeklyCoveragesData, lang, dir string) {
	@layouts.AdminShell("إدارة نطاقات وتغطية التوصيل الأسبوعية", "weekly_coverages", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.5rem; max-width:1440px; margin:0 auto 3rem auto;" x-data="{ addModalOpen: false, editModalOpen: false, currentItem: {} }">
			
			<!-- Header Card -->
			<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.5rem; box-shadow:var(--shadow-sm);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.35rem;">
							<div style="width:44px; height:44px; border-radius:12px; background:rgba(56, 189, 248, 0.12); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
								@components.IconTruck("icon-sm")
							</div>
							<div>
								<h1 style="font-size:1.3rem; font-weight:900; color:var(--text); margin:0;">نطاقات وجداول التغطية الأسبوعية</h1>
								<span style="font-size:0.75rem; font-weight:700; color:var(--accent); text-transform:uppercase;">Weekly Delivery Schedules & Routes</span>
							</div>
						</div>
						<p style="font-size:0.85rem; color:var(--text-secondary); margin:0.35rem 0 0 0;">استعراض، تدقيق، وإدارة مواعيد ومناطق تسليم الموردين للصيدليات في مختلف المحافظات بدقة تامة.</p>
					</div>

					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<form method="GET" action="/admin/weekly-coverages" style="display:flex; align-items:center; gap:0.5rem; margin:0;">
							<label style="font-size:0.825rem; font-weight:700; color:var(--text-secondary); white-space:nowrap;">تصفية المنشأة:</label>
							<select name="org_id" class="form-select" onchange="this.form.submit()" style="font-size:0.85rem; padding:0.45rem 0.85rem; min-width:240px; border-radius:8px; font-weight:700;">
								<option value="0" selected?={ data.SelectedOrgID == 0 }>كافة المنشآت والموردين</option>
								for _, o := range data.Organizations {
									<option value={ fmt.Sprintf("%d", o.ID) } selected?={ o.ID == data.SelectedOrgID }>
										{ o.LegalName }
									</option>
								}
							</select>
						</form>

						<button type="button" class="btn btn-primary btn-sm fw-800" @click="addModalOpen = true" style="padding:0.5rem 1rem; border-radius:8px; gap:0.35rem;">
							<span>@components.IconPlus("icon-sm")</span>
							<span>إضافة جدول تغطية جديد</span>
						</button>
					</div>
				</div>

				<!-- Stats KPI Strip -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1.25rem;">
					<div style="background:var(--surface-sunken); padding:0.85rem 1.1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">إجمالي جداول التغطية</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--text); margin-top:2px;">{ fmt.Sprintf("%d", len(data.Coverages)) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.85rem 1.1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">الجداول النشطة للتوصيل</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:#10b981; margin-top:2px;">{ fmt.Sprintf("%d", countActiveCoverages(data.Coverages)) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.85rem 1.1rem; border-radius:12px; border:1px solid var(--border);">
						<div class="label-strong">المدن والمحافظات المشمولة</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--accent); margin-top:2px;">{ fmt.Sprintf("%d", countCoveredCities(data.Coverages)) }</div>
					</div>
				</div>
			</div>

			<!-- Coverages List Table -->
			<div style="border:1px solid var(--border); background:var(--surface-raised); border-radius:18px; overflow:hidden; box-shadow:var(--shadow-sm);">
				if len(data.Coverages) == 0 {
					<div style="padding:3rem 1.5rem;">
						@components.EmptyState(components.EmptyStateProps{
							Title:   "لا توجد جداول تغطية أسبوعية",
							Message: "لم يتم ضبط أي جداول تغطية أسبوعية تطابق معايير الاختيار الحالية. يمكنك إضافة جدول تغطية جديد عبر الزر أعلاه.",
						})
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table">
							<thead>
								<tr>
									<th>يوم التوصيل</th>
									<th>المنشأة / المورد</th>
									<th>المدينة / المحافظة</th>
									<th>الفرع أو المخزن المنفذ</th>
									<th>نطاق التغطية</th>
									<th>مواعيد التوصيل</th>
									<th>حالة التغطية</th>
									<th class="text-end">الإجراءات والتحكم</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range data.Coverages {
									<tr style="vertical-align:middle;">
										<td>
											<span class="badge badge-sky fw-800" style="font-size:0.825rem; padding:0.3rem 0.75rem; border-radius:6px;">
												{ dayOfWeekAr(c.DayOfWeek) }
											</span>
										</td>
										<td>
											if c.OrgName != "" {
												<strong class="text-body">{ c.OrgName }</strong>
											} else {
												<span class="text-muted">منشأة #{ fmt.Sprintf("%d", c.OrganizationID) }</span>
											}
										</td>
										<td>
											if c.CityName != "" {
												<strong class="text-primary">{ c.CityName }</strong>
											} else {
												<span class="text-muted">كافة المناطق</span>
											}
										</td>
										<td>
											if c.BranchName != "" {
												<span>{ c.BranchName }</span>
											} else {
												<span class="text-muted">المقر الرئيسي</span>
											}
										</td>
										<td class="tabular-nums">
											<strong class="text-accent">{ fmt.Sprintf("%d كم", c.DistanceMeters/1000) }</strong>
										</td>
										<td class="tabular-nums">
											if c.CoverageFrom != nil && c.CoverageTo != nil {
												<span class="fw-700">{ *c.CoverageFrom } - { *c.CoverageTo }</span>
											} else {
												<span class="badge badge-slate text-xs">طوال اليوم</span>
											}
										</td>
										<td>
											if c.IsActive {
												<span class="badge badge-emerald fw-800">نشط ومتاح</span>
											} else {
												<span class="badge badge-danger fw-800">معطل</span>
											}
										</td>
										<td class="text-end">
											<div style="display:inline-flex; align-items:center; gap:0.4rem;">
												<!-- Toggle Button Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/weekly-coverages/%d/toggle", c.ID)) } class="m-0">
													<input type="hidden" name="is_active" value={ fmt.Sprintf("%t", !c.IsActive) } />
													<input type="hidden" name="org_id" value={ fmt.Sprintf("%d", data.SelectedOrgID) } />
													if c.IsActive {
														<button type="submit" class="btn btn-secondary btn-xs fw-800" title="تعطيل هذا الجدول" style="padding:0.3rem 0.65rem; border-radius:6px;">
															تعطيل
														</button>
													} else {
														<button type="submit" class="btn btn-primary btn-xs fw-800" title="تفعيل هذا الجدول" style="padding:0.3rem 0.65rem; border-radius:6px;">
															تفعيل
														</button>
													}
												</form>

												<!-- Delete Button Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/weekly-coverages/%d/delete", c.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف جدول التغطية هذا؟');" class="m-0">
													<input type="hidden" name="org_id" value={ fmt.Sprintf("%d", data.SelectedOrgID) } />
													<button type="submit" class="btn btn-danger btn-xs fw-800" style="padding:0.3rem 0.55rem; border-radius:6px;" title="حذف">
														@components.IconTrash("icon-xs")
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Add Schedule Modal -->
			<div x-show="addModalOpen" x-cloak class="modal-overlay">
				<div @click.away="addModalOpen = false" class="modal-card modal-md" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px;">
					<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; background:var(--surface-sunken);">
						<h3 style="font-size:1.1rem; font-weight:800; margin:0; color:var(--text);">إضافة جدول تغطية أسبوعية جديد</h3>
						<button type="button" @click="addModalOpen = false" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text-muted);">@components.IconX("icon-sm")</button>
					</div>

					<form method="POST" action="/admin/weekly-coverages/new" style="padding:1.5rem; display:flex; flex-direction:column; gap:1rem; margin:0;">
						<input type="hidden" name="redirect_org_id" value={ fmt.Sprintf("%d", data.SelectedOrgID) } />

						<div>
							<label class="form-label text-085-bold">المنشأة / المورد المعتمد *</label>
							<select name="organization_id" class="form-select" required style="width:100%; font-size:0.85rem;">
								for _, o := range data.Organizations {
									<option value={ fmt.Sprintf("%d", o.ID) } selected?={ o.ID == data.SelectedOrgID }>
										{ o.LegalName }
									</option>
								}
							</select>
						</div>

						<div class="grid-halves">
							<div>
								<label class="form-label text-085-bold">الفرع أو المخزن المنفذ *</label>
								<select name="branch_id" class="form-select" required style="width:100%; font-size:0.85rem;">
									for _, b := range data.Branches {
										<option value={ fmt.Sprintf("%d", b.ID) }>
											if b.Name["ar"] != "" {
												{ b.Name["ar"] }
											} else {
												{ b.Name["en"] }
											}
										</option>
									}
								</select>
							</div>

							<div>
								<label class="form-label text-085-bold">المدينة / المحافظة المشمولة</label>
								<select name="city_id" class="form-select" style="width:100%; font-size:0.85rem;">
									<option value="0">كافة مدن النطاق</option>
									for _, ct := range data.Cities {
										<option value={ fmt.Sprintf("%d", ct.ID) }>
											{ ct.Name.Get(i18n.AR) }
										</option>
									}
								</select>
							</div>
						</div>

						<div class="grid-halves">
							<div>
								<label class="form-label text-085-bold">يوم التوصيل *</label>
								<select name="day_of_week" class="form-select" required style="width:100%; font-size:0.85rem; font-weight:700;">
									<option value="0">الأحد (Sunday)</option>
									<option value="1">الاثنين (Monday)</option>
									<option value="2">الثلاثاء (Tuesday)</option>
									<option value="3">الأربعاء (Wednesday)</option>
									<option value="4">الخميس (Thursday)</option>
									<option value="5">الجمعة (Friday)</option>
									<option value="6">السبت (Saturday)</option>
								</select>
							</div>

							<div>
								<label class="form-label text-085-bold">نصف قطر التغطية (كم) *</label>
								<input type="number" name="distance_km" value="50" min="1" max="500" required class="form-input tabular-nums" style="width:100%; font-size:0.85rem; font-weight:700;" />
							</div>
						</div>

						<div class="grid-halves">
							<div>
								<label class="form-label text-085-bold">من الساعة (اختياري)</label>
								<input type="text" name="coverage_from" placeholder="مثال: 08:00" pattern="^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" class="form-input tabular-nums" style="width:100%; font-size:0.85rem;" />
							</div>

							<div>
								<label class="form-label text-085-bold">إلى الساعة (اختياري)</label>
								<input type="text" name="coverage_to" placeholder="مثال: 18:00" pattern="^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" class="form-input tabular-nums" style="width:100%; font-size:0.85rem;" />
							</div>
						</div>

						<div>
							<label class="form-label text-085-bold">ملاحظات العنوان أو خط السير</label>
							<input type="text" name="address" placeholder="مثال: خط سير الصيدليات المركزية والمستشفيات" class="form-input" style="width:100%; font-size:0.85rem;" />
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.6rem; border-top:1px solid var(--border); padding-top:1rem; margin-top:0.5rem;">
							<button type="button" @click="addModalOpen = false" class="btn btn-secondary fw-700">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.5rem 1.5rem;">حفظ الجدول</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}

// adminStaffCreateForm creates a moderator or administrator in one step.
//
// The role list is the same one the role editor manages, filtered to roles
// marked staff — so a role a super admin invents this morning is selectable
// this afternoon without a code change. That was the missing half of the
// feature: roles could be defined and nobody could be created to hold them.
templ adminStaffCreateForm(data AdminUsersPageData) {
	if len(data.StaffRoles) > 0 {
		<div
			x-show="showAddStaff"
			x-cloak
			style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px; padding:1.5rem; margin-bottom:1.25rem; box-shadow:var(--shadow-sm);"
		>
			<h2 style="font-size:1.05rem; font-weight:900; color:var(--text); margin:0 0 0.35rem 0;">إنشاء حساب مشرف جديد</h2>
			<p style="font-size:0.82rem; color:var(--text-secondary); margin:0 0 1.25rem 0;">
				يحدد الدور المختار الصفحات والإجراءات المتاحة للمشرف داخل لوحة الإدارة. يمكنك تعديل صلاحيات أي دور من صفحة الأدوار.
			</p>
			<form method="POST" action="/admin/users/staff" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem;">
				<div>
					<label class="form-label" for="staff-name-ar">الاسم بالعربية</label>
					<input id="staff-name-ar" class="form-input" type="text" name="name_ar" required maxlength="120"/>
				</div>
				<div>
					<label class="form-label" for="staff-name-en">الاسم بالإنجليزية</label>
					<input id="staff-name-en" class="form-input" type="text" name="name_en" maxlength="120"/>
				</div>
				<div>
					<label class="form-label" for="staff-email">البريد الإلكتروني</label>
					<input id="staff-email" class="form-input" type="email" name="email" required autocomplete="off"/>
				</div>
				<div>
					<label class="form-label" for="staff-phone">رقم الهاتف</label>
					<input id="staff-phone" class="form-input" type="tel" name="phone" maxlength="20"/>
				</div>
				<div>
					<label class="form-label" for="staff-password">كلمة مرور مبدئية</label>
					<input id="staff-password" class="form-input" type="password" name="password" required minlength="8" autocomplete="new-password"/>
				</div>
				<div>
					<label class="form-label" for="staff-role">الدور الإداري</label>
					<select id="staff-role" class="form-input" name="role" required>
						for _, role := range data.StaffRoles {
							<option value={ role.Key }>{ role.Name }</option>
						}
					</select>
				</div>
				<div style="grid-column:1/-1; display:flex; align-items:center; gap:0.75rem;">
					<button type="submit" class="btn btn-primary fw-800">إنشاء الحساب</button>
					<button type="button" class="btn btn-secondary" @click="showAddStaff = false">إلغاء</button>
					<span style="font-size:0.78rem; color:var(--text-muted);">
						يُنشأ الحساب مفعّلاً؛ يغيّر المشرف كلمة المرور المبدئية عند أول دخول.
					</span>
				</div>
			</form>
		</div>
	}
}
