package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AdminOrganizations(lang, dir string, currentType string, orgs []*org.Organization) {
	@layouts.AdminShell("دليل وإدارة المنشآت المسجلة", "organizations", lang, dir) {
		<div class="card" style="margin-bottom:0; overflow:visible;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; gap:1rem; flex-wrap:wrap;">
				<div class="row-center-sm">
					@components.IconBuilding("icon-md")
					<div>
						<h2 class="card-title" style="margin:0;">
							إدارة الموردين والشركات والصيدليات ({ fmt.Sprintf("%d", len(orgs)) })
						</h2>
						<p class="subtitle">
							متابعة سجلات التوريد، التراخيص الدوائية، وإدارة نشاط الحسابات المؤسسية على المنصة.
						</p>
					</div>
				</div>
			</div>

			<!-- Organization Type Tabs -->
			<div style="display:flex; gap:0.5rem; margin-bottom:1.5rem; flex-wrap:wrap; border-bottom:1px solid var(--border); padding-bottom:1rem;">
				<a href="/admin/organizations" class={ "btn btn-sm", templ.KV("btn-primary", currentType == ""), templ.KV("btn-secondary", currentType != "") }>
					<span>كافة المنشآت ({ fmt.Sprintf("%d", len(orgs)) })</span>
				</a>
				<a href="/admin/organizations?type=vendor" class={ "btn btn-sm", templ.KV("btn-primary", currentType == "vendor"), templ.KV("btn-secondary", currentType != "vendor") }>
					<span>الموردون وشركات الأدوية (Vendors)</span>
				</a>
				<a href="/admin/organizations?type=customer" class={ "btn btn-sm", templ.KV("btn-primary", currentType == "customer"), templ.KV("btn-secondary", currentType != "customer") }>
					<span>الصيدليات والمراكز الطبية (Customers)</span>
				</a>
			</div>

			if len(orgs) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "لا توجد منشآت مطابقة للنوع المحدد",
					Message: "لم يتم العثور على منشآت مسجلة في هذا القسم حالياً.",
				})
			} else {
				<div class="table-container" style="overflow:visible;">
					<table class="data-table">
						<thead>
							<tr>
								<th>الاسم والبيانات التجارية</th>
								<th>نوع المنشأة</th>
								<th>السجل والبطاقة الضريبية</th>
								<th>ترخيص هيئة الدواء</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range orgs {
								<tr>
									<td>
										<div style="font-weight:800; color:var(--text); font-size:0.95rem;">{ o.LegalName }</div>
										<div style="font-size:0.8rem; color:var(--text-secondary); margin-top:0.15rem;">
											if o.TradeName["ar"] != "" {
												{ o.TradeName["ar"] }
											} else {
												{ o.TradeName["en"] }
											}
										</div>
									</td>
									<td>
										if string(o.Type) == "vendor" {
											<span class="badge badge-sky">مورد / شركة أدوية</span>
										} else {
											<span class="badge badge-emerald">صيدلية مرخصة</span>
										}
									</td>
									<td>
										<div style="font-size:0.85rem;"><span style="color:var(--text-secondary);">سجل:</span> <strong class="tabular-nums">{ o.CommercialRegister }</strong></div>
										if o.TaxNumber != "" {
											<div style="font-size:0.8rem; color:var(--text-secondary);"><span style="color:var(--text-secondary);">ضريبة:</span> <span class="tabular-nums">{ o.TaxNumber }</span></div>
										}
									</td>
									<td>
										if o.PharmacistLicense != "" {
											<span class="tabular-nums" style="font-weight:700; color:var(--accent); font-size:0.875rem;">{ o.PharmacistLicense }</span>
										} else {
											<span style="color:var(--text-secondary); font-size:0.8rem;">—</span>
										}
									</td>
									<td>
										if string(o.Status) == "approved" {
											<span class="badge badge-success">معتمد ومفعل</span>
										} else if string(o.Status) == "rejected" {
											<span class="badge badge-danger">مرفوض</span>
										} else {
											<span class="badge badge-warning">قيد المراجعة</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", o.ID)) } class="btn btn-secondary btn-sm" style="font-weight:700;">
											<span>عرض الملف</span>
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminOrganizationDetail renders tabbed organization detail views.
templ AdminOrganizationDetail(o *org.Organization, branches []*org.Branch, employees []*org.EmployeeView, activeTab string, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("ملف المنشأة: %s", o.LegalName), "organizations", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.5rem;">
			<div class="card" style="margin-bottom:0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
						<h1 style="font-size:1.5rem; font-weight:800; color:var(--text); margin:0;">{ o.LegalName }</h1>
						if string(o.Type) == "vendor" {
							<span class="badge badge-sky">مورد</span>
						} else {
							<span class="badge badge-emerald">صيدلية</span>
						}
					</div>
					<p style="color:var(--text-secondary); font-size:0.875rem; margin:0;">
						سجل تجاري: <strong class="tabular-nums">{ o.CommercialRegister }</strong> | بطاقة ضريبية: <span class="tabular-nums">{ o.TaxNumber }</span>
					</p>
				</div>
				<div>
					<a href="/admin/organizations" class="btn btn-secondary btn-sm">
						@components.IconArrowRight("icon-xs")
						<span>العودة لدليل المنشآت</span>
					</a>
				</div>
			</div>

			<!-- Tabs -->
			<div style="display:flex; gap:0.5rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "overview"), templ.KV("btn-secondary", activeTab != "overview") }>نظرة عامة</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/info", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "info"), templ.KV("btn-secondary", activeTab != "info") }>البيانات والتراخيص</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/users", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "users"), templ.KV("btn-secondary", activeTab != "users") }>فريق العمل ({ fmt.Sprintf("%d", len(employees)) })</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/branches", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "branches"), templ.KV("btn-secondary", activeTab != "branches") }>الفروع والمستودعات ({ fmt.Sprintf("%d", len(branches)) })</a>
			</div>

			<!-- Tab Contents -->
			<div class="card mb-0">
				if activeTab == "users" {
					<h3 style="font-size:1.1rem; font-weight:700; margin-bottom:1rem;">أعضاء وفريق العمل بالمنشأة</h3>
					if len(employees) == 0 {
						@components.EmptyState(components.EmptyStateProps{Title: "لا يوجد أعضاء مسجلين", Message: "لم يتم إضافة موظفين لهذه المنشأة بعد."})
					} else {
						<div class="table-container">
							<table class="data-table">
								<thead>
									<tr>
										<th>الاسم</th>
										<th>البريد الإلكتروني</th>
										<th>الدور الوظيفي</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, e := range employees {
										<tr>
											<td><strong>{ e.UserName }</strong></td>
											<td class="tabular-nums">{ e.UserEmail }</td>
											<td><span class="badge badge-secondary">{ e.RoleName }</span></td>
											<td>
												if e.Member != nil && e.Member.IsActive {
													<span class="badge badge-success">نشط</span>
												} else {
													<span class="badge badge-danger">معطل</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				} else if activeTab == "branches" {
					<h3 style="font-size:1.1rem; font-weight:700; margin-bottom:1rem;">فروع ومستودعات المنشأة</h3>
					if len(branches) == 0 {
						@components.EmptyState(components.EmptyStateProps{Title: "لا توجد فروع مسجلة", Message: "لم يتم إضافة فروع أو مستودعات لهذه المنشأة بعد."})
					} else {
						<div class="table-container">
							<table class="data-table">
								<thead>
									<tr>
										<th>اسم الفرع</th>
										<th>الكود</th>
										<th>العنوان</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, b := range branches {
										<tr>
											<td><strong>{ b.Name.Get("ar") }</strong></td>
											<td class="tabular-nums">{ b.Code }</td>
											<td>{ b.Address }</td>
											<td>
												if b.Status == "active" {
													<span class="badge badge-success">مفعل</span>
												} else {
													<span class="badge badge-danger">غير مفعل</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				} else {
					<h3 style="font-size:1.1rem; font-weight:700; margin-bottom:1rem;">تفاصيل المنشأة وبيانات التسجيل</h3>
					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.5rem;">
						<div>
							<div style="font-size:0.8rem; color:var(--text-secondary);">الاسم القانوني</div>
							<div style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.LegalName }</div>
						</div>
						<div>
							<div style="font-size:0.8rem; color:var(--text-secondary);">رقم السجل التجاري</div>
							<div class="tabular-nums" style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.CommercialRegister }</div>
						</div>
						<div>
							<div style="font-size:0.8rem; color:var(--text-secondary);">الرقم الضريبي</div>
							<div class="tabular-nums" style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.TaxNumber }</div>
						</div>
						<div>
							<div style="font-size:0.8rem; color:var(--text-secondary);">رقم ترخيص الصيدلي / المنشأة</div>
							<div class="tabular-nums" style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.PharmacistLicense }</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
}

// AdminBranchesPage renders cross-organization branch directory.
templ AdminBranchesPage(branches []*org.Branch, lang, dir string) {
	@layouts.AdminShell("دليل الفروع والمستودعات الشامل", "branches", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title" style="margin:0;">كافة الفروع والمستودعات ({ fmt.Sprintf("%d", len(branches)) })</h2>
					<p class="subtitle">إدارة ومراقبة كافة الفروع ومستودعات التوريد لكافة المنشآت على المنصة.</p>
				</div>
			</div>

			if len(branches) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد فروع مسجلة", Message: "لم يتم العثور على فروع أو مستودعات مسجلة حالياً."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>اسم الفرع</th>
								<th>الكود</th>
								<th>المنشأة التابع لها</th>
								<th>العنوان</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, b := range branches {
								<tr>
									<td><strong>{ b.Name.Get("ar") }</strong></td>
									<td class="tabular-nums">{ b.Code }</td>
									<td>#{ fmt.Sprintf("%d", b.OrganizationID) }</td>
									<td>{ b.Address }</td>
									<td>
										if b.Status == "active" {
											<span class="badge badge-success">نشط</span>
										} else {
											<span class="badge badge-danger">معطل</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/branches/%d", b.ID)) } class="btn btn-secondary btn-sm">عرض التفاصيل</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminBranchDetailPage renders detail for a single branch.
templ AdminBranchDetailPage(b *org.Branch, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل الفرع: %s", b.Name.Get("ar")), "branches", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title" style="margin:0;">{ b.Name.Get("ar") }</h2>
					<p class="subtitle">كود الفرع: { b.Code } | منشأة #{ fmt.Sprintf("%d", b.OrganizationID) }</p>
				</div>
				<a href="/admin/branches" class="btn btn-secondary btn-sm">العودة لدليل الفروع</a>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.5rem;">
				<div>
					<div style="font-size:0.8rem; color:var(--text-secondary);">العنوان</div>
					<div style="font-weight:700; margin-top:0.25rem;">{ b.Address }</div>
				</div>
				<div>
					<div style="font-size:0.8rem; color:var(--text-secondary);">هاتف التواصل</div>
					<div class="tabular-nums" style="font-weight:700; margin-top:0.25rem;">{ b.Phone }</div>
				</div>
				<div>
					<div style="font-size:0.8rem; color:var(--text-secondary);">ساعات العمل</div>
					<div style="font-weight:700; margin-top:0.25rem;">{ b.OperatingHours }</div>
				</div>
			</div>
		</div>
	}
}

// AdminWeeklyCoveragesData carries view models for weekly coverages admin inspection.
type AdminWeeklyCoveragesData struct {
	Coverages     []*workflow.CoverageView
	Organizations []*org.Organization
	SelectedOrgID int64
}

// AdminWeeklyCoveragesPage renders weekly coverage rules filtered by selected organization.
templ AdminWeeklyCoveragesPage(data AdminWeeklyCoveragesData, lang, dir string) {
	@layouts.AdminShell("إدارة نطاقات وتغطية التوصيل الأسبوعية", "coverage", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.25rem; max-width:1400px; margin:0 auto 3rem auto;">
			
			<!-- Header Card -->
			<div class="card mb-0" style="border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); padding:1.75rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.35rem;">
							<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconTruck("icon-md")
							</div>
							<h1 style="font-size:1.35rem; font-weight:800; color:var(--text); margin:0;">نطاقات وجداول التغطية الأسبوعية</h1>
						</div>
						<p style="font-size:0.9rem; color:var(--text-secondary); margin:0;">
							استعراض ومتابعة جدول أيام التوصيل ونطاق المسافات المسجلة لمستودعات وفروع كل منشأة.
						</p>
					</div>
					<div style="display:flex; gap:0.5rem;">
						<a href="/admin/weekly-coverages" class="btn btn-secondary btn-sm" style="display:flex; align-items:center; gap:0.4rem;">
							@components.IconRefresh("icon-xs")
							<span>تحديث</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Organization Selector Dropdown Card -->
			<div class="card mb-0" style="border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem; background:var(--surface);">
				<form method="GET" action="/admin/weekly-coverages" style="display:flex; align-items:flex-end; gap:1rem; flex-wrap:wrap;">
					<div class="form-group" style="margin-bottom:0; flex:1; min-width:280px;">
						<label class="form-label" style="font-size:0.875rem; font-weight:700; color:var(--text); margin-bottom:0.4rem;">
							اختر المنشأة / المورد لعرض نطاقات التغطية التابعة لها:
						</label>
						<select name="org_id" class="form-input" onchange="this.form.submit()" style="height:42px; font-size:0.9rem;">
							if len(data.Organizations) == 0 {
								<option value="">لا توجد منشآت مسجلة</option>
							}
							for _, o := range data.Organizations {
								<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>
									if o.LegalName != "" {
										{ o.LegalName }
									} else {
										{ o.TradeName.Get("ar") }
									}
									({ string(o.Type) }) — #{ fmt.Sprintf("%d", o.ID) }
								</option>
							}
						</select>
					</div>
					<button type="submit" class="btn btn-primary btn-sm" style="height:42px; padding:0 1.5rem; display:flex; align-items:center; gap:0.4rem;">
						@components.IconSearch("icon-xs")
						<span>عرض نطاقات المنشأة</span>
					</button>
				</form>
			</div>

			<!-- Coverages Table Card -->
			<div class="card mb-0" style="border:1px solid var(--border); border-radius:var(--radius-xl); padding:0; overflow:hidden; background:var(--surface);">
				<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border-subtle); display:flex; justify-content:space-between; align-items:center;">
					<div style="font-weight:700; font-size:1rem; color:var(--text);">
						سجلات نطاق التغطية ({ fmt.Sprintf("%d", len(data.Coverages)) })
					</div>
				</div>

				if len(data.Coverages) == 0 {
					<div style="padding:4rem 2rem; text-align:center;">
						<div style="width:54px; height:54px; border-radius:var(--radius-full); background:var(--surface-raised); color:var(--text-muted); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;">
							@components.IconTruck("icon-md")
						</div>
						<h3 style="font-size:1.1rem; font-weight:700; color:var(--text); margin:0 0 0.5rem 0;">لا توجد نطاقات تغطية مسجلة لهذه المنشأة</h3>
						<p style="font-size:0.875rem; color:var(--text-secondary); max-width:420px; margin:0 auto;">
							تقوم المنشأة بضبط وإدارة نطاقات التغطية الأسبوعية لفروعها مباشرة من خلال لوحة تحكم المورد الخاصة بها.
						</p>
					</div>
				} else {
					<div class="table-container">
						<table class="data-table" style="margin:0;">
							<thead>
								<tr>
									<th style="width:60px;">#</th>
									<th>الفرع / المستودع</th>
									<th>يوم التوصيل الأسبوعي</th>
									<th>أقصى نطاق تغطية</th>
									<th>ساعات العمل / التوصيل</th>
									<th>العنوان / خط السير</th>
									<th>الحالة</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range data.Coverages {
									<tr>
										<td class="tabular-nums" style="color:var(--text-muted); font-size:0.8rem;">
											#{ fmt.Sprintf("%d", c.ID) }
										</td>
										<td>
											if c.BranchName != "" {
												<strong style="color:var(--text);">{ c.BranchName }</strong>
											} else {
												<span>فرع #{ fmt.Sprintf("%d", c.BranchID) }</span>
											}
											if c.CityName != "" {
												<span class="badge badge-secondary" style="margin-inline-start:0.35rem; font-size:0.75rem;">
													{ c.CityName }
												</span>
											}
										</td>
										<td>
											<span class="badge badge-sky" style="font-size:0.825rem; font-weight:700; padding:3px 10px;">
												{ dayNameArabic(c.DayOfWeek) }
											</span>
										</td>
										<td class="tabular-nums" style="font-weight:700; color:var(--text);">
											{ fmt.Sprintf("%.1f كم", float64(c.DistanceMeters)/1000.0) }
											<span style="font-size:0.75rem; color:var(--text-muted); font-weight:normal;">({ fmt.Sprintf("%d م", c.DistanceMeters) })</span>
										</td>
										<td>
											if c.CoverageFrom != nil && c.CoverageTo != nil {
												<span class="tabular-nums" style="font-weight:600; color:var(--text);">{ *c.CoverageFrom } - { *c.CoverageTo }</span>
											} else {
												<span style="color:var(--text-muted);">طوال اليوم</span>
											}
										</td>
										<td style="font-size:0.85rem; color:var(--text-secondary); max-width:260px;">
											if c.Address != "" {
												{ c.Address }
											} else {
												<span style="color:var(--text-muted); font-style:italic;">غير محدد</span>
											}
										</td>
										<td>
											if c.IsActive {
												<span class="badge badge-success">مفعل ونشط</span>
											} else {
												<span class="badge badge-danger">معطل</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}
