package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminEnterpriseHubData struct {
	Organizations    []*org.Organization
	Branches         []*org.Branch
	Users            []*identity.User
	DeletionRequests []*identity.AccountDeletionRequest
	ActiveTab        string
	CurrentType      string
	OrgNames         map[int64]string
	OrgTypes         map[int64]string
	BranchCounts     map[int64]int
	UserCounts       map[int64]int
}

func getOrgLegalName(id int64, names map[int64]string) string {
	if name, ok := names[id]; ok && name != "" {
		return name
	}
	if id > 0 {
		return fmt.Sprintf("منشأة #%d", id)
	}
	return "المنصة الرئيسية"
}

func getOrgTypeBadge(id int64, types map[int64]string) string {
	if t, ok := types[id]; ok {
		if t == "vendor" {
			return "مورد"
		}
		return "صيدلية"
	}
	return "منشأة"
}

func dayOfWeekAr(day int) string {
	days := []string{"الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"}
	if day >= 0 && day < len(days) {
		return days[day]
	}
	return "—"
}

templ AdminOrganizations(data AdminEnterpriseHubData, lang, dir string) {
	@layouts.AdminShell("إدارة المنشآت والفروع والمستخدمين", "organizations", lang, dir) {
		<div
			style="max-width:1400px; margin:0 auto 3rem auto; display:flex; flex-direction:column; gap:1.25rem;"
			x-data={ fmt.Sprintf(`{
				activeTab: '%s',
				orgFilter: '%s',
				userGroupFilter: 'all',
				branchOrgFilter: 'all',
				branchTypeFilter: 'all',
				searchQuery: '',
				init() {
					const urlParams = new URLSearchParams(window.location.search);
					let tab = urlParams.get('tab') || '%s';
					if (['organizations', 'branches', 'users', 'deletion_requests'].includes(tab)) {
						this.activeTab = tab;
					}
					let orgId = urlParams.get('org_id');
					if (orgId) {
						this.branchOrgFilter = orgId;
					}
				},
				setTab(tab) {
					this.activeTab = tab;
					const u = new URL(window.location);
					u.searchParams.set('tab', tab);
					window.history.replaceState({}, '', u);
				}
			}`, data.ActiveTab, data.CurrentType, data.ActiveTab) }
		>
			<!-- Header Card -->
			<div class="card mb-0" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.75rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div class="row-center">
						<div class="b2b-icon-box-lg">
							@components.IconBuilding("icon-lg")
						</div>
						<div>
							<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
								إدارة المنشآت والفروع والمستخدمين
							</h1>
							<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
								المنظومة المركزية الشاملة لإدارة المنشآت الطبية والتوريدية، شبكة الفروع والمخازن، وحسابات الكوادر والمشرفين.
							</p>
						</div>
					</div>

					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<span class="badge badge-sky" style="font-weight:700; font-size:0.85rem; padding:0.4rem 0.8rem;">
							{ fmt.Sprintf("%d", len(data.Organizations)) } منشأة
						</span>
						<span class="badge badge-emerald" style="font-weight:700; font-size:0.85rem; padding:0.4rem 0.8rem;">
							{ fmt.Sprintf("%d", len(data.Branches)) } فرع ومخزن
						</span>
						<span class="badge badge-indigo" style="font-weight:700; font-size:0.85rem; padding:0.4rem 0.8rem;">
							{ fmt.Sprintf("%d", len(data.Users)) } مستخدم
						</span>
					</div>
				</div>
			</div>

			<!-- Main Top-Level Navigation Tabs -->
			<div style="display:flex; gap:0.5rem; border-bottom:2px solid var(--border); flex-wrap:wrap;">
				<button
					type="button"
					class="btn"
					:class="activeTab === 'organizations' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.7rem 1.35rem; font-size:0.9rem;"
					@click="setTab('organizations')"
				>
					@components.IconBuilding("icon-xs")
					<span>المؤسسات والشركات ({ fmt.Sprintf("%d", len(data.Organizations)) })</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'branches' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.7rem 1.35rem; font-size:0.9rem;"
					@click="setTab('branches')"
				>
					@components.IconLayers("icon-xs")
					<span>الفروع والمخازن ({ fmt.Sprintf("%d", len(data.Branches)) })</span>
				</button>

				<button
					type="button"
					class="btn"
					:class="activeTab === 'users' ? 'btn-primary' : 'btn-secondary'"
					style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.7rem 1.35rem; font-size:0.9rem;"
					@click="setTab('users')"
				>
					@components.IconUsers("icon-xs")
					<span>المستخدمين والحسابات ({ fmt.Sprintf("%d", len(data.Users)) })</span>
				</button>

				if len(data.DeletionRequests) > 0 {
					<button
						type="button"
						class="btn"
						:class="activeTab === 'deletion_requests' ? 'btn-danger' : 'btn-secondary'"
						style="font-weight:800; border-radius:var(--radius-lg) var(--radius-lg) 0 0; padding:0.7rem 1.35rem; font-size:0.9rem;"
						@click="setTab('deletion_requests')"
					>
						@components.IconTrash("icon-xs")
						<span>طلبات حذف الحسابات ({ fmt.Sprintf("%d", countPendingDeletions(data.DeletionRequests)) })</span>
					</button>
				}
			</div>

			<!-- TAB 1: Organizations -->
			<div x-show="activeTab === 'organizations'" class="stack-lg">
				<div class="card mb-0" style="padding:0.9rem 1.25rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
						<div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
							<button
								type="button"
								class="btn btn-sm"
								:class="orgFilter === '' ? 'btn-primary' : 'btn-secondary'"
								@click="orgFilter = ''"
								style="font-weight:700; border-radius:var(--radius-full); padding:0.35rem 0.9rem;"
							>
								كافة المنشآت ({ fmt.Sprintf("%d", len(data.Organizations)) })
							</button>
							<button
								type="button"
								class="btn btn-sm"
								:class="orgFilter === 'vendor' ? 'btn-primary' : 'btn-secondary'"
								@click="orgFilter = 'vendor'"
								style="font-weight:700; border-radius:var(--radius-full); padding:0.35rem 0.9rem;"
							>
								الموردون وشركات الأدوية (Vendors)
							</button>
							<button
								type="button"
								class="btn btn-sm"
								:class="orgFilter === 'customer' ? 'btn-primary' : 'btn-secondary'"
								@click="orgFilter = 'customer'"
								style="font-weight:700; border-radius:var(--radius-full); padding:0.35rem 0.9rem;"
							>
								الصيدليات والمراكز الطبية (Customers)
							</button>
						</div>

						<div style="min-width:260px;">
							<input
								type="text"
								x-model="searchQuery"
								class="form-input"
								placeholder="بحث باسم المنشأة، السجل، أو الترخيص..."
								style="font-size:0.85rem; padding:0.4rem 0.75rem;"
							/>
						</div>
					</div>
				</div>

				<div class="card mb-0 overflow-visible">
					if len(data.Organizations) == 0 {
						@components.EmptyState(components.EmptyStateProps{
							Title:   "لا توجد منشآت مسجلة",
							Message: "لم يتم العثور على منشآت مسجلة في هذا القسم حالياً.",
						})
					} else {
						<div class="table-container">
							<table class="b2b-table">
								<thead>
									<tr>
										<th>الاسم والبيانات التجارية</th>
										<th>نوع المنشأة</th>
										<th>السجل والبطاقة الضريبية</th>
										<th>ترخيص هيئة الدواء</th>
										<th>الهيكل التابع</th>
										<th>الحالة</th>
										<th class="text-end">الإجراءات</th>
									</tr>
								</thead>
								<tbody>
									for _, o := range data.Organizations {
										<tr
											x-show={ fmt.Sprintf("(orgFilter === '' || orgFilter === '%s') && ('%s'.toLowerCase().includes(searchQuery.toLowerCase()) || '%s'.toLowerCase().includes(searchQuery.toLowerCase()) || '%s'.includes(searchQuery))", string(o.Type), o.LegalName, o.TradeName["ar"], o.CommercialRegister) }
										>
											<td>
												<div class="fw-800 text-primary text-base">{ o.LegalName }</div>
												<div style="font-size:0.8rem; color:var(--text-secondary); margin-top:0.15rem;">
													if o.TradeName["ar"] != "" {
														{ o.TradeName["ar"] }
													} else {
														{ o.TradeName["en"] }
													}
												</div>
											</td>
											<td>
												if string(o.Type) == "vendor" {
													<span class="badge badge-sky fw-700">مورد / شركة أدوية</span>
												} else {
													<span class="badge badge-emerald fw-700">صيدلية مرخصة</span>
												}
											</td>
											<td>
												<div style="font-size:0.85rem;"><span class="text-secondary">سجل:</span> <strong class="tabular-nums">{ o.CommercialRegister }</strong></div>
												if o.TaxNumber != "" {
													<div class="text-sm text-secondary"><span class="text-secondary">ضريبة:</span> <span class="tabular-nums">{ o.TaxNumber }</span></div>
												}
											</td>
											<td>
												if o.PharmacistLicense != "" {
													<span class="tabular-nums" style="font-weight:700; color:var(--accent); font-size:0.875rem;">{ o.PharmacistLicense }</span>
												} else {
													<span style="color:var(--text-secondary); font-size:0.8rem;">—</span>
												}
											</td>
											<td>
												<div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
													<button
														type="button"
														class="badge badge-indigo"
														style="cursor:pointer; border:none; font-weight:700;"
														@click={ fmt.Sprintf("setTab('branches'); branchOrgFilter = '%d';", o.ID) }
														title="انتقال لاستعراض فروع هذه المنشأة"
													>
														{ fmt.Sprintf("%d", data.BranchCounts[o.ID]) } فرع
													</button>
												</div>
											</td>
											<td>
												if string(o.Status) == "approved" {
													<span class="badge badge-emerald">معتمد ومفعل</span>
												} else if string(o.Status) == "rejected" {
													<span class="badge badge-rose">مرفوض</span>
												} else {
													<span class="badge badge-amber">قيد المراجعة</span>
												}
											</td>
											<td class="text-end">
												<div class="table-actions" style="justify-content:flex-end; gap:0.4rem;">
													<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", o.ID)) } class="btn btn-secondary btn-sm fw-700">
														<span>عرض الملف الشامل ↗</span>
													</a>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>

			<!-- TAB 2: Branches -->
			<div x-show="activeTab === 'branches'" class="stack-lg">
				<div class="card mb-0" style="padding:0.9rem 1.25rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
						<div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center;">
							<div class="row-center-sm">
								<label style="font-size:0.825rem; font-weight:700; color:var(--text-secondary);">تصفية بالمنشأة:</label>
								<select x-model="branchOrgFilter" class="form-select" style="font-size:0.825rem; padding:0.35rem 0.75rem; max-width:240px;">
									<option value="all">كافة المنشآت والشركات</option>
									for _, o := range data.Organizations {
										<option value={ fmt.Sprintf("%d", o.ID) }>{ o.LegalName }</option>
									}
								</select>
							</div>

							<div class="row-center-sm">
								<label style="font-size:0.825rem; font-weight:700; color:var(--text-secondary);">النوع:</label>
								<select x-model="branchTypeFilter" class="form-select" style="font-size:0.825rem; padding:0.35rem 0.75rem;">
									<option value="all">كافة الأنواع</option>
									<option value="warehouse">مخزن أدوية مركزي (Warehouse)</option>
									<option value="fast_hub">نقطة توزيع سريعة (Fast Hub)</option>
									<option value="cold_depot">مخزن تبريد (Cold Depot)</option>
									<option value="pharmacy_branch">فرع صيدلية (Pharmacy Branch)</option>
								</select>
							</div>

							<button
								type="button"
								class="btn btn-secondary btn-sm text-sm"
								x-show="branchOrgFilter !== 'all' || branchTypeFilter !== 'all'"
								@click="branchOrgFilter = 'all'; branchTypeFilter = 'all';"
							
							>
								إلغاء التصفية
							</button>
						</div>

						<div style="min-width:260px;">
							<input
								type="text"
								x-model="searchQuery"
								class="form-input"
								placeholder="بحث باسم الفرع، الكود، أو العنوان..."
								style="font-size:0.85rem; padding:0.4rem 0.75rem;"
							/>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					if len(data.Branches) == 0 {
						@components.EmptyState(components.EmptyStateProps{
							Title:   "لا توجد فروع مسجلة",
							Message: "لم يتم العثور على فروع أو مخازن مسجلة حالياً.",
						})
					} else {
						<div class="table-container">
							<table class="b2b-table">
								<thead>
									<tr>
										<th>اسم الفرع والكود</th>
										<th>المنشأة التابع لها</th>
										<th>نوع المنشأة اللوجستية</th>
										<th>العنوان وبيانات التواصل</th>
										<th>الحالة</th>
										<th class="text-end">الإجراءات</th>
									</tr>
								</thead>
								<tbody>
									for _, b := range data.Branches {
										<tr
											x-show={ fmt.Sprintf("(branchOrgFilter === 'all' || branchOrgFilter === '%d') && ('%s'.toLowerCase().includes(searchQuery.toLowerCase()) || '%s'.toLowerCase().includes(searchQuery.toLowerCase()) || '%s'.toLowerCase().includes(searchQuery.toLowerCase()))", b.OrganizationID, b.Name.Get("ar"), b.Code, b.Address) }
										>
											<td>
												<div class="fw-800 text-primary text-base">{ b.Name.Get("ar") }</div>
												if b.Code != "" {
													<div style="font-size:0.8rem; color:var(--text-secondary); margin-top:0.15rem;" dir="ltr">
														<code class="fw-700">{ b.Code }</code>
													</div>
												}
											</td>
											<td>
												<div style="font-weight:700; color:var(--text); font-size:0.9rem;">
													{ getOrgLegalName(b.OrganizationID, data.OrgNames) }
												</div>
												<div style="margin-top:0.15rem;">
													<span class="badge badge-slate text-xs">
														{ getOrgTypeBadge(b.OrganizationID, data.OrgTypes) }
													</span>
												</div>
											</td>
											<td>
												<span class="badge badge-sky fw-700">
													if b.WarehouseType != "" {
														{ b.WarehouseType }
													} else {
														فرع تشغيلي
													}
												</span>
											</td>
											<td>
												<div style="font-size:0.85rem; color:var(--text);">{ b.Address }</div>
												if b.Phone != "" {
													<div style="font-size:0.8rem; color:var(--text-secondary); margin-top:0.15rem;" class="tabular-nums">
														📞 { b.Phone }
													</div>
												}
											</td>
											<td>
												if b.Status == "active" {
													<span class="badge badge-emerald">نشط</span>
												} else {
													<span class="badge badge-rose">معطل</span>
												}
											</td>
											<td class="text-end">
												<a href={ templ.SafeURL(fmt.Sprintf("/admin/branches/%d", b.ID)) } class="btn btn-secondary btn-sm fw-700">
													<span>عرض التفاصيل</span>
												</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>

			<!-- TAB 3: Users -->
			<div x-show="activeTab === 'users'" class="stack-lg">
				<div class="card mb-0" style="padding:0.9rem 1.25rem;">
					<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
						<div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
							<button
								type="button"
								class="btn btn-sm"
								:class="userGroupFilter === 'all' ? 'btn-primary' : 'btn-secondary'"
								@click="userGroupFilter = 'all'"
								style="font-weight:700; border-radius:var(--radius-full); padding:0.35rem 0.9rem;"
							>
								جميع المستخدمين ({ fmt.Sprintf("%d", len(data.Users)) })
							</button>
							<button
								type="button"
								class="btn btn-sm"
								:class="userGroupFilter === 'pharmacy' ? 'btn-primary' : 'btn-secondary'"
								@click="userGroupFilter = 'pharmacy'"
								style="font-weight:700; border-radius:var(--radius-full); padding:0.35rem 0.9rem;"
							>
								الصيدليات والعملاء ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "pharmacy")) })
							</button>
							<button
								type="button"
								class="btn btn-sm"
								:class="userGroupFilter === 'supplier' ? 'btn-primary' : 'btn-secondary'"
								@click="userGroupFilter = 'supplier'"
								style="font-weight:700; border-radius:var(--radius-full); padding:0.35rem 0.9rem;"
							>
								الموردون والشركات ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "supplier")) })
							</button>
							<button
								type="button"
								class="btn btn-sm"
								:class="userGroupFilter === 'staff' ? 'btn-primary' : 'btn-secondary'"
								@click="userGroupFilter = 'staff'"
								style="font-weight:700; border-radius:var(--radius-full); padding:0.35rem 0.9rem;"
							>
								إدارة ومشرفو المنصة ({ fmt.Sprintf("%d", countUsersByGroup(data.Users, "staff")) })
							</button>
						</div>

						<div style="min-width:260px;">
							<input
								type="text"
								x-model="searchQuery"
								class="form-input"
								placeholder="بحث بالاسم، البريد، أو الهاتف..."
								style="font-size:0.85rem; padding:0.4rem 0.75rem;"
							/>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					if len(data.Users) == 0 {
						@components.EmptyState(components.EmptyStateProps{
							Title:   "لا يوجد مستخدمون",
							Message: "لم يتم العثور على أي مستخدمين مسجلين في هذا القسم.",
						})
					} else {
						<div class="table-container">
							<table class="b2b-table">
								<thead>
									<tr>
										<th>المستخدم</th>
										<th>البريد الإلكتروني</th>
										<th>الدور الوظيفي</th>
										<th>الحالة</th>
										<th class="text-end">الإجراءات</th>
									</tr>
								</thead>
								<tbody>
									for _, u := range data.Users {
										<tr
											data-group={ getUserGroup(u.Role) }
											data-search={ strings.ToLower(fmt.Sprintf("%s %s %s %s", userDisplayName(u), u.Email, u.Phone, roleDisplayAr(u.Role))) }
											x-show="(userGroupFilter === 'all' || $el.getAttribute('data-group') === userGroupFilter) && (!searchQuery || $el.getAttribute('data-search').includes(searchQuery.toLowerCase()))"
										>
											<td>
												<div class="row-center-sm">
													<div style="width:34px; height:34px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.825rem;">
														if len(userDisplayName(u)) > 0 {
															{ string([]rune(userDisplayName(u))[0]) }
														} else {
															U
														}
													</div>
													<div>
														<div class="fw-800 text-primary text-base">{ userDisplayName(u) }</div>
														if u.Phone != "" {
															<div style="font-size:0.75rem; color:var(--neutral-500); margin-top:0.05rem;" class="tabular-nums">📞 { u.Phone }</div>
														}
													</div>
												</div>
											</td>
											<td>
												<div class="text-sm text-secondary tabular-nums" dir="ltr">{ u.Email }</div>
											</td>
											<td>
												<span class={ "badge", roleBadgeClass(u.Role) } class="fw-700">
													{ roleDisplayAr(u.Role) }
												</span>
											</td>
											<td>
												if u.Status == identity.StatusActive {
													<span class="badge badge-emerald">نشط ومفعل</span>
												} else if u.Status == identity.StatusSuspended {
													<span class="badge badge-rose">موقوف / معلق</span>
												} else {
													<span class="badge badge-amber">قيد المراجعة</span>
												}
											</td>
											<td class="text-end">
												<div class="table-actions" style="justify-content:flex-end; gap:0.35rem;">
													if u.Status == identity.StatusActive {
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/suspend", u.ID)) } class="m-0 inline" onsubmit="return confirm('تأكيد تعليق هذا الحساب؟');">
															<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); font-weight:700;">
																تعليق الحساب
															</button>
														</form>
													} else {
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/reactivate", u.ID)) } class="m-0 inline">
															<button type="submit" class="btn btn-primary btn-sm fw-700">
																إعادة التفعيل
															</button>
														</form>
													}
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>

			<!-- TAB 4: Deletions -->
			if len(data.DeletionRequests) > 0 {
				<div x-show="activeTab === 'deletion_requests'" class="stack-lg">
					<div class="card mb-0">
						<div class="header-row mb-md">
							<div>
								<h2 class="card-title" style="margin:0; font-size:1.2rem; font-weight:800; color:var(--danger);">
									طلبات حذف الحسابات المعلقة ({ fmt.Sprintf("%d", countPendingDeletions(data.DeletionRequests)) })
								</h2>
								<p class="subtitle" style="margin:0.2rem 0 0 0;">
									مراجعة طلبات المستخدمين لحذف حساباتهم بموجب لوائح الخصوصية وحماية البيانات.
								</p>
							</div>
						</div>

						<div class="table-container">
							<table class="b2b-table">
								<thead>
									<tr>
										<th>المستخدم</th>
										<th>البريد الإلكتروني</th>
										<th>سبب الحذف</th>
										<th>تاريخ الطلب</th>
										<th>الحالة</th>
										<th class="text-end">الإجراءات</th>
									</tr>
								</thead>
								<tbody>
									for _, req := range data.DeletionRequests {
										<tr>
											<td><strong>{ req.UserName }</strong></td>
											<td class="tabular-nums" dir="ltr">{ req.UserEmail }</td>
											<td>{ req.Reason }</td>
											<td class="tabular-nums">{ req.CreatedAt.Format("2006-01-02 15:04") }</td>
											<td>
												if req.Status == "pending" {
													<span class="badge badge-amber">قيد المراجعة</span>
												} else if req.Status == "approved" {
													<span class="badge badge-rose">تم الحذف</span>
												} else {
													<span class="badge badge-slate">مرفوض</span>
												}
											</td>
											<td class="text-end">
												if req.Status == "pending" {
													<div style="display:flex; justify-content:flex-end; gap:0.4rem;">
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/approve", req.ID)) } class="m-0" onsubmit="return confirm('تأكيد الموافقة على حذف الحساب وتعليقه فورياً؟');">
															<button type="submit" class="btn btn-sm btn-danger fw-700">
																موافقة وحذف
															</button>
														</form>
														<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/reject", req.ID)) } class="m-0">
															<button type="submit" class="btn btn-sm btn-secondary fw-700">
																رفض الطلب
															</button>
														</form>
													</div>
												} else {
													<span style="color:var(--text-secondary); font-size:0.85rem;">تمت المعالجة</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			}
		</div>
	}
}

// AdminOrganizationDetail renders tabbed organization detail views.
templ AdminOrganizationDetail(o *org.Organization, branches []*org.Branch, employees []*org.EmployeeView, activeTab string, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("ملف المنشأة: %s", o.LegalName), "organizations", lang, dir) {
		<div class="stack-lg">
			<div class="card" style="margin-bottom:0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div>
					<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
						<h1 class="text-2xl fw-800 text-primary m-0">{ o.LegalName }</h1>
						if string(o.Type) == "vendor" {
							<span class="badge badge-sky">مورد</span>
						} else {
							<span class="badge badge-emerald">صيدلية</span>
						}
					</div>
					<p style="color:var(--text-secondary); font-size:0.875rem; margin:0;">
						سجل تجاري: <strong class="tabular-nums">{ o.CommercialRegister }</strong> | بطاقة ضريبية: <span class="tabular-nums">{ o.TaxNumber }</span>
					</p>
				</div>
				<div>
					<a href="/admin/organizations" class="btn btn-secondary btn-sm">
						@components.IconArrowRight("icon-xs")
						<span>العودة للمنظومة المركزية</span>
					</a>
				</div>
			</div>

			<!-- Tabs -->
			<div style="display:flex; gap:0.5rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "overview"), templ.KV("btn-secondary", activeTab != "overview") }>نظرة عامة</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/info", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "info"), templ.KV("btn-secondary", activeTab != "info") }>البيانات والتراخيص</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/users", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "users"), templ.KV("btn-secondary", activeTab != "users") }>فريق العمل ({ fmt.Sprintf("%d", len(employees)) })</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d/branches", o.ID)) } class={ "btn btn-sm", templ.KV("btn-primary", activeTab == "branches"), templ.KV("btn-secondary", activeTab != "branches") }>الفروع والمخازن ({ fmt.Sprintf("%d", len(branches)) })</a>
			</div>

			<!-- Tab Contents -->
			<div class="card mb-0">
				if activeTab == "users" {
					<h3 style="font-size:1.1rem; font-weight:700; margin-bottom:1rem;">أعضاء وفريق العمل بالمنشأة</h3>
					if len(employees) == 0 {
						@components.EmptyState(components.EmptyStateProps{Title: "لا يوجد أعضاء مسجلين", Message: "لم يتم إضافة موظفين لهذه المنشأة بعد."})
					} else {
						<div class="table-container">
							<table class="b2b-table">
								<thead>
									<tr>
										<th>الاسم</th>
										<th>البريد الإلكتروني</th>
										<th>الدور الوظيفي</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, e := range employees {
										<tr>
											<td><strong>{ e.UserName }</strong></td>
											<td class="tabular-nums">{ e.UserEmail }</td>
											<td><span class="badge badge-secondary">{ e.RoleName }</span></td>
											<td>
												if e.Member != nil && e.Member.IsActive {
													<span class="badge badge-emerald">نشط</span>
												} else {
													<span class="badge badge-rose">معطل</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				}
				if activeTab == "branches" {
					<h3 style="font-size:1.1rem; font-weight:700; margin-bottom:1rem;">فروع ومخازن المنشأة</h3>
					if len(branches) == 0 {
						@components.EmptyState(components.EmptyStateProps{Title: "لا توجد فروع مسجلة", Message: "لم يتم إضافة فروع أو مخازن لهذه المنشأة بعد."})
					} else {
						<div class="table-container">
							<table class="b2b-table">
								<thead>
									<tr>
										<th>اسم الفرع</th>
										<th>الكود</th>
										<th>العنوان</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, b := range branches {
										<tr>
											<td><strong>{ b.Name.Get("ar") }</strong></td>
											<td class="tabular-nums">{ b.Code }</td>
											<td>{ b.Address }</td>
											<td>
												if b.Status == "active" {
													<span class="badge badge-emerald">مفعل</span>
												} else {
													<span class="badge badge-rose">غير مفعل</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				}
				if activeTab != "users" && activeTab != "branches" {
					<h3 style="font-size:1.1rem; font-weight:700; margin-bottom:1rem;">تفاصيل المنشأة وبيانات التسجيل</h3>
					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.5rem;">
						<div>
							<div class="text-sm text-secondary">الاسم القانوني</div>
							<div style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.LegalName }</div>
						</div>
						<div>
							<div class="text-sm text-secondary">رقم السجل التجاري</div>
							<div class="tabular-nums" style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.CommercialRegister }</div>
						</div>
						<div>
							<div class="text-sm text-secondary">الرقم الضريبي</div>
							<div class="tabular-nums" style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.TaxNumber }</div>
						</div>
						<div>
							<div class="text-sm text-secondary">رقم ترخيص الصيدلي / المنشأة</div>
							<div class="tabular-nums" style="font-weight:700; font-size:1rem; margin-top:0.25rem;">{ o.PharmacistLicense }</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
}

// AdminBranchesPage renders cross-organization branch directory.
templ AdminBranchesPage(branches []*org.Branch, lang, dir string) {
	@layouts.AdminShell("دليل الفروع والمخازن الشامل", "branches", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">كافة الفروع والمخازن ({ fmt.Sprintf("%d", len(branches)) })</h2>
					<p class="subtitle">إدارة ومراقبة كافة الفروع ومخازن التوريد لكافة المنشآت على المنصة.</p>
				</div>
			</div>

			if len(branches) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد فروع مسجلة", Message: "لم يتم العثور على فروع أو مخازن مسجلة حالياً."})
			} else {
				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>اسم الفرع</th>
								<th>الكود</th>
								<th>المنشأة التابع لها</th>
								<th>العنوان</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, b := range branches {
								<tr>
									<td><strong>{ b.Name.Get("ar") }</strong></td>
									<td class="tabular-nums">{ b.Code }</td>
									<td>#{ fmt.Sprintf("%d", b.OrganizationID) }</td>
									<td>{ b.Address }</td>
									<td>
										if b.Status == "active" {
											<span class="badge badge-emerald">نشط</span>
										} else {
											<span class="badge badge-rose">معطل</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/branches/%d", b.ID)) } class="btn btn-secondary btn-sm">عرض التفاصيل</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminBranchDetailPage renders detail for a single branch.
templ AdminBranchDetailPage(b *org.Branch, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل الفرع: %s", b.Name.Get("ar")), "branches", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">{ b.Name.Get("ar") }</h2>
					<p class="subtitle">كود الفرع: { b.Code } | منشأة #{ fmt.Sprintf("%d", b.OrganizationID) }</p>
				</div>
				<a href="/admin/organizations?tab=branches" class="btn btn-secondary btn-sm">العودة لدليل الفروع</a>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.5rem;">
				<div>
					<div class="text-sm text-secondary">العنوان</div>
					<div style="font-weight:700; margin-top:0.25rem;">{ b.Address }</div>
				</div>
				<div>
					<div class="text-sm text-secondary">هاتف التواصل</div>
					<div class="tabular-nums" style="font-weight:700; margin-top:0.25rem;">{ b.Phone }</div>
				</div>
				<div>
					<div class="text-sm text-secondary">ساعات العمل</div>
					<div style="font-weight:700; margin-top:0.25rem;">{ b.OperatingHours }</div>
				</div>
			</div>
		</div>
	}
}

// AdminWeeklyCoveragesData carries view models for weekly coverages admin inspection.
type AdminWeeklyCoveragesData struct {
	Coverages     []*workflow.CoverageView
	Organizations []*org.Organization
	Branches      []*org.Branch
	Cities        []*platformadmin.City
	SelectedOrgID int64
}

func countActiveCoverages(coverages []*workflow.CoverageView) int {
	c := 0
	for _, cov := range coverages {
		if cov.IsActive {
			c++
		}
	}
	return c
}

func countCoveredCities(coverages []*workflow.CoverageView) int {
	cities := make(map[string]bool)
	for _, cov := range coverages {
		if cov.CityName != "" {
			cities[cov.CityName] = true
		}
	}
	return len(cities)
}

// AdminWeeklyCoveragesPage renders weekly coverage rules filtered by selected organization with full controls.
templ AdminWeeklyCoveragesPage(data AdminWeeklyCoveragesData, lang, dir string) {
	@layouts.AdminShell("إدارة نطاقات وتغطية التوصيل الأسبوعية", "weekly_coverages", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.5rem; max-width:1400px; margin:0 auto 3rem auto;" x-data="{ addModalOpen: false, editModalOpen: false, currentItem: {} }">
			
			<!-- Header Card -->
			<div class="card mb-0" style="border:1px solid var(--border); background:linear-gradient(135deg, var(--surface-raised) 0%, var(--surface-sunken) 100%); border-radius:var(--radius-xl); padding:1.75rem; box-shadow:0 4px 20px rgba(0,0,0,0.03);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.35rem;">
							<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
								
							</div>
							<div>
								<h1 style="font-size:1.4rem; font-weight:900; color:var(--text); margin:0;">نطاقات وجداول التغطية الأسبوعية</h1>
								<span style="font-size:0.75rem; font-weight:700; color:var(--accent); text-transform:uppercase;">Weekly Delivery Schedules & Routes</span>
							</div>
						</div>
						<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.35rem 0 0 0; line-height:1.5;">استعراض، تدقيق، وإدارة مواعيد ومناطق تسليم الموردين للصيدليات في مختلف المحافظات بدقة تامة.</p>
					</div>

					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<form method="GET" action="/admin/weekly-coverages" style="display:flex; align-items:center; gap:0.5rem; margin:0;">
							<label style="font-size:0.825rem; font-weight:700; color:var(--text-secondary); white-space:nowrap;">تصفية المنشأة:</label>
							<select name="org_id" class="form-select" onchange="this.form.submit()" style="font-size:0.85rem; padding:0.45rem 0.85rem; min-width:240px; border-radius:var(--radius-lg); font-weight:700;">
								<option value="0" selected?={ data.SelectedOrgID == 0 }>كافة المنشآت والموردين</option>
								for _, o := range data.Organizations {
									<option value={ fmt.Sprintf("%d", o.ID) } selected?={ o.ID == data.SelectedOrgID }>
										{ o.LegalName }
									</option>
								}
							</select>
						</form>

						<button type="button" class="btn btn-primary" @click="addModalOpen = true" style="font-weight:800; font-size:0.85rem; padding:0.55rem 1.1rem; border-radius:var(--radius-lg); gap:0.4rem;">
							<span></span>
							<span>إضافة جدول تغطية جديد</span>
						</button>
					</div>
				</div>

				<!-- Stats KPI Strip -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1.25rem;">
					<div style="background:var(--surface-raised); padding:0.85rem 1.1rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700;">إجمالي جداول التغطية</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--text); margin-top:2px;">{ fmt.Sprintf("%d", len(data.Coverages)) }</div>
					</div>
					<div style="background:var(--surface-raised); padding:0.85rem 1.1rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700;">الجداول النشطة للتوصيل</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--primary-600); margin-top:2px;">{ fmt.Sprintf("%d", countActiveCoverages(data.Coverages)) }</div>
					</div>
					<div style="background:var(--surface-raised); padding:0.85rem 1.1rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
						<div style="font-size:0.75rem; color:var(--text-muted); font-weight:700;">المدن والمحافظات المشمولة</div>
						<div class="tabular-nums" style="font-size:1.35rem; font-weight:900; color:var(--text); margin-top:2px;">{ fmt.Sprintf("%d", countCoveredCities(data.Coverages)) }</div>
					</div>
				</div>
			</div>

			<!-- Coverages List Table -->
			<div class="card mb-0" style="border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,0.03);">
				if len(data.Coverages) == 0 {
					<div style="padding:3rem 1.5rem;">
						@components.EmptyState(components.EmptyStateProps{
							Title:   "لا توجد جداول تغطية أسبوعية",
							Message: "لم يتم ضبط أي جداول تغطية أسبوعية تطابق معايير الاختيار الحالية. يمكنك إضافة جدول تغطية جديد عبر الزر أعلاه.",
						})
					</div>
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th>يوم التوصيل</th>
									<th>المنشأة / المورد</th>
									<th>المدينة / المحافظة</th>
									<th>الفرع أو المخزن المنفذ</th>
									<th>نطاق التغطية</th>
									<th>مواعيد التوصيل</th>
									<th>حالة التغطية</th>
									<th class="text-end">الإجراءات والتحكم</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range data.Coverages {
									<tr>
										<td>
											<span class="badge badge-sky" style="font-weight:800; font-size:0.825rem; padding:0.3rem 0.75rem;">
												{ dayOfWeekAr(c.DayOfWeek) }
											</span>
										</td>
										<td>
											if c.OrgName != "" {
												<strong>{ c.OrgName }</strong>
											} else {
												<span class="text-muted">منشأة #{ fmt.Sprintf("%d", c.OrganizationID) }</span>
											}
										</td>
										<td>
											if c.CityName != "" {
												<strong class="text-primary">{ c.CityName }</strong>
											} else {
												<span class="text-muted">كافة المناطق</span>
											}
										</td>
										<td>
											if c.BranchName != "" {
												<span>{ c.BranchName }</span>
											} else {
												<span class="text-muted">المقر الرئيسي</span>
											}
										</td>
										<td class="tabular-nums">
											<strong class="text-accent">{ fmt.Sprintf("%d كم", c.DistanceMeters/1000) }</strong>
										</td>
										<td class="tabular-nums">
											if c.CoverageFrom != nil && c.CoverageTo != nil {
												<span class="fw-700">{ *c.CoverageFrom } - { *c.CoverageTo }</span>
											} else {
												<span class="badge badge-slate text-xs">طوال اليوم</span>
											}
										</td>
										<td>
											if c.IsActive {
												<span class="badge badge-success fw-800">✓ نشط ومتاح</span>
											} else {
												<span class="badge badge-danger fw-800">✕ معطل</span>
											}
										</td>
										<td class="text-end">
											<div style="display:inline-flex; align-items:center; gap:0.4rem;">
												<!-- Toggle Button Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/weekly-coverages/%d/toggle", c.ID)) } class="m-0">
													<input type="hidden" name="is_active" value={ fmt.Sprintf("%t", !c.IsActive) } />
													<input type="hidden" name="org_id" value={ fmt.Sprintf("%d", data.SelectedOrgID) } />
													if c.IsActive {
														<button type="submit" class="btn btn-secondary btn-sm" title="تعطيل هذا الجدول" style="font-size:0.75rem; padding:0.25rem 0.6rem;">
															تعطيل
														</button>
													} else {
														<button type="submit" class="btn btn-primary btn-sm" title="تفعيل هذا الجدول" style="font-size:0.75rem; padding:0.25rem 0.6rem;">
															تفعيل
														</button>
													}
												</form>

												<!-- Delete Button Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/weekly-coverages/%d/delete", c.ID)) } onsubmit="return confirm('هل أنت متأكد من حذف جدول التغطية هذا؟');" class="m-0">
													<input type="hidden" name="org_id" value={ fmt.Sprintf("%d", data.SelectedOrgID) } />
													<button type="submit" class="btn btn-danger btn-sm" style="font-size:0.75rem; padding:0.25rem 0.5rem;" title="حذف">
														
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Add Schedule Modal -->
			<div x-show="addModalOpen" x-cloak class="modal-overlay">
				<div @click.away="addModalOpen = false" class="modal-card modal-md">
					<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; background:var(--surface-sunken);">
						<div class="row-center-sm">
							<span style="font-size:1.2rem;"></span>
							<h3 style="font-size:1.1rem; font-weight:800; margin:0; color:var(--text);">إضافة جدول تغطية أسبوعية جديد</h3>
						</div>
						<button type="button" @click="addModalOpen = false" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text-muted);">✕</button>
					</div>

					<form method="POST" action="/admin/weekly-coverages/new" style="padding:1.5rem; display:flex; flex-direction:column; gap:1rem; margin:0;">
						<input type="hidden" name="redirect_org_id" value={ fmt.Sprintf("%d", data.SelectedOrgID) } />

						<div>
							<label class="form-label">المنشأة / المورد المعتمد *</label>
							<select name="organization_id" class="form-select" required style="width:100%; font-size:0.85rem;">
								for _, o := range data.Organizations {
									<option value={ fmt.Sprintf("%d", o.ID) } selected?={ o.ID == data.SelectedOrgID }>
										{ o.LegalName }
									</option>
								}
							</select>
						</div>

						<div class="grid-2">
							<div>
								<label class="form-label">الفرع أو المخزن المنفذ *</label>
								<select name="branch_id" class="form-select" required style="width:100%; font-size:0.85rem;">
									for _, b := range data.Branches {
										<option value={ fmt.Sprintf("%d", b.ID) }>
											if b.Name["ar"] != "" {
												{ b.Name["ar"] }
											} else {
												{ b.Name["en"] }
											}
										</option>
									}
								</select>
							</div>

							<div>
								<label class="form-label">المدينة / المحافظة المشمولة</label>
								<select name="city_id" class="form-select" style="width:100%; font-size:0.85rem;">
									<option value="0">كافة مدن النطاق</option>
									for _, ct := range data.Cities {
										<option value={ fmt.Sprintf("%d", ct.ID) }>
											{ ct.Name.Get(i18n.AR) }
										</option>
									}
								</select>
							</div>
						</div>

						<div class="grid-2">
							<div>
								<label class="form-label">يوم التوصيل *</label>
								<select name="day_of_week" class="form-select" required style="width:100%; font-size:0.85rem; font-weight:700;">
									<option value="0">الأحد (Sunday)</option>
									<option value="1">الاثنين (Monday)</option>
									<option value="2">الثلاثاء (Tuesday)</option>
									<option value="3">الأربعاء (Wednesday)</option>
									<option value="4">الخميس (Thursday)</option>
									<option value="5">الجمعة (Friday)</option>
									<option value="6">السبت (Saturday)</option>
								</select>
							</div>

							<div>
								<label class="form-label">نصف قطر التغطية (كم) *</label>
								<input type="number" name="distance_km" value="50" min="1" max="500" required class="form-input tabular-nums" style="width:100%; font-size:0.85rem; font-weight:700;" />
							</div>
						</div>

						<div class="grid-2">
							<div>
								<label class="form-label">من الساعة (اختياري)</label>
								<input type="text" name="coverage_from" placeholder="مثال: 08:00" pattern="^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" class="form-input tabular-nums" style="width:100%; font-size:0.85rem;" />
							</div>

							<div>
								<label class="form-label">إلى الساعة (اختياري)</label>
								<input type="text" name="coverage_to" placeholder="مثال: 18:00" pattern="^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" class="form-input tabular-nums" style="width:100%; font-size:0.85rem;" />
							</div>
						</div>

						<div>
							<label class="form-label">ملاحظات العنوان أو خط السير</label>
							<input type="text" name="address" placeholder="مثال: خط سير الصيدليات المركزية والمستشفيات" class="form-input" style="width:100%; font-size:0.85rem;" />
						</div>

						<div class="modal-footer-standard">
							<button type="button" @click="addModalOpen = false" class="btn btn-secondary fw-700">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.5rem 1.5rem;">حفظ الجدول</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}
