package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorCoverageTable(data VendorCoverageData, lang string) {
	<!-- Active Weekly Coverages Table & Filters -->
	<div class="glass-panel p-6 mb-6">
		<div class="flex-between items-center mb-6 pb-4 border-b flex-wrap gap-4">
			<div class="stack-sm">
				<h2 class="text-lg font-black text-primary m-0 d-flex items-center gap-2">
					<span>@components.IconFileText("icon-sm")</span>
					<span>سجل نطاقات التغطية والتوزيع المسجلة</span>
					<span class="tabular-nums text-brand" x-text="'(' + totalFilteredCount + ')'">({ fmt.Sprintf("%d", len(data.Coverages)) })</span>
					<span x-show="totalFilteredCount !== allCoverages.length" class="text-xs text-muted font-normal" x-text="'من أصل ' + allCoverages.length"></span>
				</h2>
				<p class="text-xs text-muted mt-1 m-0">
					استعرض وعدل جداول التوزيع الخاصة بأسطولك حسب الفرع واليوم والمحافظة والمدينة مع خيارات التصفية والتصفح.
				</p>
			</div>

			<!-- Filter Controls & Actions -->
			<div class="d-flex items-center gap-3 flex-wrap">
				<!-- Filter Branch -->
				if len(data.Branches) > 0 {
					<div class="d-flex items-center gap-1.5 text-xs">
						<label class="text-muted font-bold whitespace-nowrap">الفرع:</label>
						<select x-model="filterBranch" @change="currentPage = 1; updateQueryParams()" class="form-control text-xs font-bold w-40">
							<option value="all">كل الفروع</option>
							for _, b := range data.Branches {
								<option value={ fmt.Sprintf("%d", b.ID) }>
									{ b.Name.Get("ar") }
									if b.IsMain {
										 (الرئيسي)
									}
								</option>
							}
						</select>
					</div>
				}

				<!-- Filter Day -->
				<div class="d-flex items-center gap-1.5 text-xs">
					<label class="text-muted font-bold whitespace-nowrap">اليوم:</label>
					<select x-model="filterDay" @change="currentPage = 1; updateQueryParams()" class="form-control text-xs font-bold w-36">
						<option value="all">كل الأيام</option>
						<option value="6">السبت</option>
						<option value="0">الأحد</option>
						<option value="1">الاثنين</option>
						<option value="2">الثلاثاء</option>
						<option value="3">الأربعاء</option>
						<option value="4">الخميس</option>
						<option value="5">الجمعة</option>
					</select>
				</div>

				<!-- Search query -->
				<div class="relative">
					<input type="text" x-model="searchQuery" @input="currentPage = 1" placeholder="بحث بالمدينة أو المحافظة أو الفرع..." class="form-control text-xs w-48"/>
				</div>

				<!-- Reset Filters Button -->
				<button
					type="button"
					x-show="filterBranch !== 'all' || filterDay !== 'all' || searchQuery !== ''"
					@click="filterBranch = 'all'; filterDay = 'all'; searchQuery = ''; currentPage = 1; updateQueryParams()"
					class="btn btn-xs btn-secondary font-bold"
					title="إعادة ضبط الفلاتر"
				>
					إعادة ضبط
				</button>

				<!-- Delete All Button -->
				if len(data.Coverages) > 0 {
					<button type="button" @click="openDeleteAllModal()" class="btn btn-sm btn-danger font-bold d-flex items-center gap-2" title="حذف جميع نطاقات التغطية المسجلة">
						@components.IconTrash("icon-sm")
						<span>حذف كل التغطيات</span>
					</button>
				}
			</div>
		</div>

		if len(data.Coverages) == 0 {
			<div class="empty-state-glass p-8 text-center">
				<div class="empty-state-icon-wrapper mx-auto mb-3">
					<span class="text-3xl">@components.IconGlobe("icon-sm")</span>
				</div>
				<h3 class="text-lg font-black text-primary mb-1">لا توجد نطاقات تغطية مضافة حتى الآن</h3>
				<p class="text-sm text-muted mb-4 max-w-md mx-auto">
					قم بإنشاء جدول التغطية الأسبوعية لفرعك ومندوبيك لتتمكن الصيدليات الواقعة في نطاق مدنك من رؤية منتجاتك وطلبها.
				</p>
				<a href="#builder-section" class="btn btn-primary font-bold">+ إنشاء أول نطاق تغطية</a>
			</div>
		} else {
			<div class="table-container m-0">
				<table class="data-table m-0">
					<thead>
						<tr>
							<th>يوم التغطية</th>
							<th>المحافظة والمدينة</th>
							<th>الإحداثيات الجغرافية (GPS)</th>
							<th>نصف القطر (المدى)</th>
							<th>مواعيد العمل</th>
							<th>الفرع</th>
							<th>الحالة</th>
							<th class="col-actions">الإجراءات</th>
						</tr>
					</thead>
					<tbody>
						<!-- Filtered Empty State -->
						<tr x-show="allCoverages.length > 0 && totalFilteredCount === 0">
							<td colspan="8" class="text-center py-8 text-muted">
								<div class="d-flex flex-col items-center gap-2">
									<span class="text-2xl">@components.IconSearch("icon-md")</span>
									<span class="font-bold text-sm">لا توجد نطاقات تغطية تطابق خيارات التصفية الحالية</span>
									<span class="text-xs text-secondary">جرب اختيار فرع آخر أو يوم مختلف أو مسح كلمة البحث</span>
									<button type="button" @click="filterBranch = 'all'; filterDay = 'all'; searchQuery = ''; currentPage = 1; updateQueryParams()" class="btn btn-xs btn-secondary mt-1 font-bold">
										إعادة ضبط الفلاتر
									</button>
								</div>
							</td>
						</tr>

						<!-- Paginated Rows via Alpine -->
						<template x-for="c in paginatedCoverages" :key="c.id">
							<tr>
								<!-- Day Badge -->
								<td>
									<span :class="'badge ' + c.day_badge_class" x-text="c.day_name_ar"></span>
								</td>

								<!-- Governorate & City -->
								<td>
									<div class="font-extrabold text-sm text-primary">
										<span x-text="c.governorate_name"></span>
										<template x-if="c.city_name">
											<span>
												<span class="text-muted mx-1">›</span>
												<span class="text-brand" x-text="c.city_name"></span>
											</span>
										</template>
									</div>
									<div x-show="c.address && c.address !== c.city_name" class="text-xs text-muted mt-1" x-text="c.address"></div>
								</td>

								<!-- GPS Coordinates & Map Link -->
								<td class="font-mono text-xs">
									<template x-if="c.latitude != null && c.longitude != null">
										<div class="d-flex items-center gap-2">
											<span x-text="c.lat_lng_str"></span>
											<a :href="c.map_url" target="_blank" title="معاينة على خرائط جوجل" class="text-decoration-none">
												@components.IconGlobe("icon-sm")
											</a>
										</div>
									</template>
									<template x-if="c.latitude == null || c.longitude == null">
										<span class="text-muted text-xs">إحداثيات مركز الفرع</span>
									</template>
								</td>

								<!-- Radius Distance -->
								<td>
									<span class="badge badge-primary" x-text="c.distance_km"></span>
								</td>

								<!-- Coverage Time Window (Egyptian 12-hour) -->
								<td>
									<span class="badge badge-secondary font-bold" x-text="c.coverage_window"></span>
								</td>

								<!-- Branch -->
								<td class="text-sm font-semibold text-primary" x-text="c.branch_name"></td>

								<!-- Status Toggle -->
								<td>
									<form method="POST" :action="'/vendor/coverage/' + c.id + '/toggle'" class="d-inline">
										<input type="hidden" name="gorilla.csrf.Token" value=""/>
										<input type="hidden" name="id" :value="c.id"/>
										<input type="hidden" name="return_branch" :value="filterBranch"/>
										<template x-if="c.is_active">
											<button type="submit" class="badge badge-emerald border-0 cursor-pointer font-bold" title="اضغط للتعطيل">
												● نشط ومتاح
											</button>
										</template>
										<template x-if="!c.is_active">
											<button type="submit" class="badge badge-secondary border-0 cursor-pointer font-bold" title="اضغط للتفعيل">
												○ معطل مؤقتاً
											</button>
										</template>
									</form>
								</td>

								<!-- Actions -->
								<td class="col-actions">
									<div class="table-actions">
										<button type="button" @click="openEdit(c)" class="btn btn-2xs btn-secondary" title="تعديل النطاق">
											@components.IconEdit("icon-sm")
										</button>

										<form method="POST" :action="'/vendor/coverage/' + c.id + '/delete'" onsubmit="return confirm('هل أنت متأكد من حذف نطاق التغطية هذا؟');" class="d-inline">
											<input type="hidden" name="gorilla.csrf.Token" value=""/>
											<input type="hidden" name="id" :value="c.id"/>
											<input type="hidden" name="return_branch" :value="filterBranch"/>
											<button type="submit" class="btn btn-2xs btn-danger" title="حذف النطاق">
												@components.IconTrash("icon-sm")
											</button>
										</form>
									</div>
								</td>
							</tr>
						</template>
					</tbody>
				</table>
			</div>

			<!-- Pagination Bar -->
			<div x-show="totalFilteredCount > 0" class="b2b-pagination p-3 px-4 bg-surface-sunken border-t flex-between items-center flex-wrap gap-3 mt-0 rounded-b-xl">
				<div class="b2b-pagination-info text-xs text-secondary d-flex items-center gap-3">
					<span>
						عرض <strong class="tabular-nums" x-text="pageSize === -1 ? ('1 - ' + totalFilteredCount) : (startIndex + ' - ' + endIndex)"></strong> من أصل <strong class="tabular-nums" x-text="totalFilteredCount"></strong> نطاق
						<span x-show="totalFilteredCount !== allCoverages.length" class="text-muted">
							(مفلتر من إجمالي <span class="tabular-nums" x-text="allCoverages.length"></span>)
						</span>
					</span>
					<label class="d-flex items-center gap-1.5 text-xs text-muted">
						<span>لكل صفحة:</span>
						<select
							class="form-select form-select-xs py-1 px-2 text-xs font-bold"
							x-model.number="pageSize"
							@change="currentPage = 1"
						>
							<option :value="10">10 نطاقات</option>
							<option :value="15">15 نطاق</option>
							<option :value="25">25 نطاق</option>
							<option :value="50">50 نطاق</option>
							<option :value="100">100 نطاق</option>
							<option :value="-1">عرض الكل</option>
						</select>
					</label>
				</div>

				<div class="b2b-pagination-controls d-flex items-center gap-1" x-show="totalPages > 1">
					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage <= 1"
						@click="goToPage(1)"
						title="الصفحة الأولى"
					>«</button>
					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage <= 1"
						@click="prevPage()"
						title="السابق"
					>‹</button>

					<span class="text-xs px-2 font-bold tabular-nums">
						صفحة <span x-text="currentPage"></span> من <span x-text="totalPages"></span>
					</span>

					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage >= totalPages"
						@click="nextPage()"
						title="التالي"
					>›</button>
					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage >= totalPages"
						@click="goToPage(totalPages)"
						title="الصفحة الأخيرة"
					>»</button>
				</div>
			</div>
		}
	</div>
}

templ VendorCoverageActiveTableAndBands(data VendorCoverageData, lang string) {
	@VendorCoverageTable(data, lang)
	@VendorCoverageBands(data, lang)
}