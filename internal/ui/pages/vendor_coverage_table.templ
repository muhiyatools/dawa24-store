package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorCoverageTable(data VendorCoverageData, lang string) {
	<!-- Active Weekly Coverages Table & Filters -->
	<div class="glass-panel p-6 mb-6">
		<div class="flex-between items-center mb-6 pb-4 border-b flex-wrap gap-4">
			<div class="stack-sm">
				<h2 class="text-lg font-black text-primary m-0 d-flex items-center gap-2">
					<span>@components.IconFileText("icon-sm")</span>
					<span>{ i18n.T(lang, "vendor_coverage.table.title") }</span>
					<span class="tabular-nums text-brand" x-text="'(' + totalFilteredCount + ')'">({ fmt.Sprintf("%d", len(data.Coverages)) })</span>
					<span x-show="totalFilteredCount !== allCoverages.length" class="text-xs text-muted font-normal" x-text="(window.__DAWA_LANG__ === 'en' ? 'out of ' : 'من أصل ') + allCoverages.length"></span>
				</h2>
				<p class="text-xs text-muted mt-1 m-0">
					{ i18n.T(lang, "vendor_coverage.table.desc") }
				</p>
			</div>

			<!-- Filter Controls & Actions -->
			<div class="d-flex items-center gap-3 flex-wrap">
				<!-- Filter Branch -->
				if len(data.Branches) > 0 {
					<div class="d-flex items-center gap-1.5 text-xs">
						<label class="text-muted font-bold whitespace-nowrap">{ i18n.T(lang, "vendor_coverage.table.filter_branch") }</label>
						<select x-model="filterBranch" @change="currentPage = 1; updateQueryParams()" class="form-control text-xs font-bold w-40">
							<option value="all">{ i18n.T(lang, "vendor_coverage.table.all_branches") }</option>
							for _, b := range data.Branches {
								<option value={ fmt.Sprintf("%d", b.ID) }>
									{ b.Name.Get(i18n.Lang(lang)) }
									if b.IsMain {
										 (الرئيسي)
									}
								</option>
							}
						</select>
					</div>
				}

				<!-- Filter Day -->
				<div class="d-flex items-center gap-1.5 text-xs">
					<label class="text-muted font-bold whitespace-nowrap">{ i18n.T(lang, "vendor_coverage.table.filter_day") }</label>
					<select x-model="filterDay" @change="currentPage = 1; updateQueryParams()" class="form-control text-xs font-bold w-36">
						<option value="all">{ i18n.T(lang, "vendor_coverage.table.all_days") }</option>
						<option value="6">{ i18n.T(lang, "vendor_coverage.builder.day_sat") }</option>
						<option value="0">{ i18n.T(lang, "vendor_coverage.builder.day_sun") }</option>
						<option value="1">{ i18n.T(lang, "vendor_coverage.builder.day_mon") }</option>
						<option value="2">{ i18n.T(lang, "vendor_coverage.builder.day_tue") }</option>
						<option value="3">{ i18n.T(lang, "vendor_coverage.builder.day_wed") }</option>
						<option value="4">{ i18n.T(lang, "vendor_coverage.builder.day_thu") }</option>
						<option value="5">{ i18n.T(lang, "vendor_coverage.builder.day_fri") }</option>
					</select>
				</div>

				<!-- Search query -->
				<div class="relative">
					<input type="text" x-model="searchQuery" @input="currentPage = 1" placeholder={ i18n.T(lang, "vendor_coverage.table.search_ph") } class="form-control text-xs w-48"/>
				</div>

				<!-- Reset Filters Button -->
				<button
					type="button"
					x-show="filterBranch !== 'all' || filterDay !== 'all' || searchQuery !== ''"
					@click="filterBranch = 'all'; filterDay = 'all'; searchQuery = ''; currentPage = 1; updateQueryParams()"
					class="btn btn-xs btn-secondary font-bold"
					title={ i18n.T(lang, "vendor_coverage.table.reset_filters") }
				>
					{ i18n.T(lang, "vendor_coverage.table.reset_filters") }
				</button>

				<!-- Delete All Button -->
				if len(data.Coverages) > 0 {
					<button type="button" @click="openDeleteAllModal()" class="btn btn-sm btn-danger font-bold d-flex items-center gap-2" title={ i18n.T(lang, "vendor_coverage.table.btn_delete_all") }>
						@components.IconTrash("icon-sm")
						<span>{ i18n.T(lang, "vendor_coverage.table.btn_delete_all") }</span>
					</button>
				}
			</div>
		</div>

		if len(data.Coverages) == 0 {
			<div class="empty-state-glass p-8 text-center">
				<div class="empty-state-icon-wrapper mx-auto mb-3">
					<span class="text-3xl">@components.IconGlobe("icon-sm")</span>
				</div>
				<h3 class="text-lg font-black text-primary mb-1">{ i18n.T(lang, "vendor_coverage.table.empty_title") }</h3>
				<p class="text-sm text-muted mb-4 max-w-md mx-auto">
					{ i18n.T(lang, "vendor_coverage.table.empty_desc") }
				</p>
				<a href="#builder-section" class="btn btn-primary font-bold">{ i18n.T(lang, "vendor_coverage.table.btn_create_first") }</a>
			</div>
		} else {
			<div class="table-container m-0">
				<table class="data-table m-0">
					<thead>
						<tr>
							<th>{ i18n.T(lang, "vendor_coverage.table.th_day") }</th>
							<th>{ i18n.T(lang, "vendor_coverage.table.th_gov_city") }</th>
							<th>{ i18n.T(lang, "vendor_coverage.table.th_gps") }</th>
							<th>{ i18n.T(lang, "vendor_coverage.table.th_radius") }</th>
							<th>{ i18n.T(lang, "vendor_coverage.table.th_hours") }</th>
							<th>{ i18n.T(lang, "vendor_coverage.table.th_branch") }</th>
							<th>{ i18n.T(lang, "vendor_coverage.table.th_status") }</th>
							<th class="col-actions">{ i18n.T(lang, "vendor_coverage.table.th_actions") }</th>
						</tr>
					</thead>
					<tbody>
						<!-- Filtered Empty State -->
						<tr x-show="allCoverages.length > 0 && totalFilteredCount === 0">
							<td colspan="8" class="text-center py-8 text-muted">
								<div class="d-flex flex-col items-center gap-2">
									<span class="text-2xl">@components.IconSearch("icon-md")</span>
									<span class="font-bold text-sm">{ i18n.T(lang, "vendor_coverage.table.no_match_title") }</span>
									<span class="text-xs text-secondary">{ i18n.T(lang, "vendor_coverage.table.no_match_desc") }</span>
									<button type="button" @click="filterBranch = 'all'; filterDay = 'all'; searchQuery = ''; currentPage = 1; updateQueryParams()" class="btn btn-xs btn-secondary mt-1 font-bold">
										{ i18n.T(lang, "vendor_coverage.table.reset_filters") }
									</button>
								</div>
							</td>
						</tr>

						<!-- Paginated Rows via Alpine -->
						<template x-for="c in paginatedCoverages" :key="c.id">
							<tr>
								<!-- Day Badge -->
								<td>
									<span :class="'badge ' + c.day_badge_class" x-text="c.day_name_ar"></span>
								</td>

								<!-- Governorate & City -->
								<td>
									<div class="font-extrabold text-sm text-primary">
										<span x-text="c.governorate_name"></span>
										<template x-if="c.city_name">
											<span>
												<span class="text-muted mx-1">›</span>
												<span class="text-brand" x-text="c.city_name"></span>
											</span>
										</template>
									</div>
									<div x-show="c.address && c.address !== c.city_name" class="text-xs text-muted mt-1" x-text="c.address"></div>
								</td>

								<!-- GPS Coordinates & Map Link -->
								<td class="font-mono text-xs">
									<template x-if="c.latitude != null && c.longitude != null">
										<div class="d-flex items-center gap-2">
											<span x-text="c.lat_lng_str"></span>
											<a :href="c.map_url" target="_blank" title="معاينة على خرائط جوجل" class="text-decoration-none">
												@components.IconGlobe("icon-sm")
											</a>
										</div>
									</template>
									<template x-if="c.latitude == null || c.longitude == null">
										<span class="text-muted text-xs">{ i18n.T(lang, "vendor_coverage.table.branch_center_coords") }</span>
									</template>
								</td>

								<!-- Radius Distance -->
								<td>
									<span class="badge badge-primary" x-text="c.distance_km"></span>
								</td>

								<!-- Coverage Time Window -->
								<td>
									<span class="badge badge-secondary font-bold" x-text="c.coverage_window"></span>
								</td>

								<!-- Branch -->
								<td class="text-sm font-semibold text-primary" x-text="c.branch_name"></td>

								<!-- Status Toggle -->
								<td>
									<form method="POST" :action="'/vendor/coverage/' + c.id + '/toggle'" class="d-inline">
										<input type="hidden" name="gorilla.csrf.Token" value=""/>
										<input type="hidden" name="id" :value="c.id"/>
										<input type="hidden" name="return_branch" :value="filterBranch"/>
										<template x-if="c.is_active">
											<button type="submit" class="badge badge-emerald border-0 cursor-pointer font-bold" title="اضغط للتعطيل">
												{ i18n.T(lang, "vendor_coverage.table.status_active") }
											</button>
										</template>
										<template x-if="!c.is_active">
											<button type="submit" class="badge badge-secondary border-0 cursor-pointer font-bold" title="اضغط للتفعيل">
												{ i18n.T(lang, "vendor_coverage.table.status_inactive") }
											</button>
										</template>
									</form>
								</td>

								<!-- Actions -->
								<td class="col-actions">
									<div class="table-actions">
										<button type="button" @click="openEdit(c)" class="btn btn-2xs btn-secondary" title={ i18n.T(lang, "vendor_coverage.table.edit_title") }>
											@components.IconEdit("icon-sm")
										</button>

										<form method="POST" :action="'/vendor/coverage/' + c.id + '/delete'" :onsubmit="'return confirm(\'' + (window.__DAWA_LANG__ === 'en' ? 'Are you sure you want to delete this coverage zone?' : 'هل أنت متأكد من حذف نطاق التغطية هذا؟') + '\');'" class="d-inline">
											<input type="hidden" name="gorilla.csrf.Token" value=""/>
											<input type="hidden" name="id" :value="c.id"/>
											<input type="hidden" name="return_branch" :value="filterBranch"/>
											<button type="submit" class="btn btn-2xs btn-danger" title={ i18n.T(lang, "vendor_coverage.table.delete_title") }>
												@components.IconTrash("icon-sm")
											</button>
										</form>
									</div>
								</td>
							</tr>
						</template>
					</tbody>
				</table>
			</div>

			<!-- Pagination Bar -->
			<div x-show="totalFilteredCount > 0" class="b2b-pagination p-3 px-4 bg-surface-sunken border-t flex-between items-center flex-wrap gap-3 mt-0 rounded-b-xl">
				<div class="b2b-pagination-info text-xs text-secondary d-flex items-center gap-3">
					<span>
						if lang == "en" {
							Showing <strong class="tabular-nums" x-text="pageSize === -1 ? ('1 - ' + totalFilteredCount) : (startIndex + ' - ' + endIndex)"></strong> of <strong class="tabular-nums" x-text="totalFilteredCount"></strong> zones
							<span x-show="totalFilteredCount !== allCoverages.length" class="text-muted">
								(filtered from <span class="tabular-nums" x-text="allCoverages.length"></span>)
							</span>
						} else {
							عرض <strong class="tabular-nums" x-text="pageSize === -1 ? ('1 - ' + totalFilteredCount) : (startIndex + ' - ' + endIndex)"></strong> من أصل <strong class="tabular-nums" x-text="totalFilteredCount"></strong> نطاق
							<span x-show="totalFilteredCount !== allCoverages.length" class="text-muted">
								(مفلتر من إجمالي <span class="tabular-nums" x-text="allCoverages.length"></span>)
							</span>
						}
					</span>
					<label class="d-flex items-center gap-1.5 text-xs text-muted">
						<span>{ i18n.T(lang, "vendor_coverage.table.show_label") }</span>
						<select
							class="form-select form-select-xs py-1 px-2 text-xs font-bold"
							x-model.number="pageSize"
							@change="currentPage = 1"
						>
							<option :value="10">10</option>
							<option :value="15">15</option>
							<option :value="25">25</option>
							<option :value="50">50</option>
							<option :value="100">100</option>
							<option :value="-1">{ i18n.T(lang, "vendor_delivery.items.opt_all") }</option>
						</select>
					</label>
				</div>

				<div class="b2b-pagination-controls d-flex items-center gap-1" x-show="totalPages > 1">
					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage <= 1"
						@click="goToPage(1)"
						title="First Page"
					>«</button>
					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage <= 1"
						@click="prevPage()"
						title="Previous"
					>‹</button>

					<span class="text-xs px-2 font-bold tabular-nums">
						if lang == "en" {
							Page <span x-text="currentPage"></span> of <span x-text="totalPages"></span>
						} else {
							صفحة <span x-text="currentPage"></span> من <span x-text="totalPages"></span>
						}
					</span>

					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage >= totalPages"
						@click="nextPage()"
						title="Next"
					>›</button>
					<button
						type="button"
						class="b2b-pagination-btn"
						:disabled="currentPage >= totalPages"
						@click="goToPage(totalPages)"
						title="Last Page"
					>»</button>
				</div>
			</div>
		}
	</div>
}

templ VendorCoverageActiveTableAndBands(data VendorCoverageData, lang string) {
	@VendorCoverageTable(data, lang)
	@VendorCoverageBands(data, lang)
}