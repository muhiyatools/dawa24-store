package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminEmployeeActivitiesData holds context for the admin employee activity logs screen.
type AdminEmployeeActivitiesData struct {
	Entries        []*platformadmin.AuditEntry
	TotalCount     int
	Page           int
	PerPage        int
	TotalPages     int
	SearchQuery    string
	SelectedOrgID  int64
	SelectedUserID int64
	SelectedAction string
	Organizations  []*org.Organization
	Users          []*identity.User
}


// AdminFullUserPage renders the categorized user list.
templ AdminFullUserPage(users []*identity.User, activeFilter string, lang, dir string) {
	@layouts.AdminShell("إدارة ودليل المستخدمين الشامل", "users", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 d-flex items-center justify-center border border-indigo-200/60 shadow-2xs">
							@components.IconUsers("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">دليل المستخدمين والحسابات ({ fmt.Sprintf("%d", len(users)) })</h1>
							<p class="text-sm text-secondary m-0 mt-1">متابعة حسابات العملاء، مسؤولي الصيدليات، والمشرفين عبر المنصة</p>
						</div>
					</div>
				</div>

				<!-- Filter Tabs -->
				<div class="cb-tabs-nav m-0 mt-6 pt-4 border-t">
					<a href="/admin/users" class={ "cb-tab-btn", templ.KV("active", activeFilter == "all") }>كافة المستخدمين</a>
					<a href="/admin/users?type=customer" class={ "cb-tab-btn", templ.KV("active", activeFilter == "customers") }>الصيدليات والعملاء</a>
					<a href="/admin/users?type=vendor" class={ "cb-tab-btn", templ.KV("active", activeFilter == "vendors") }>الموردون والشركات</a>
					<a href="/admin/users?type=staff" class={ "cb-tab-btn", templ.KV("active", activeFilter == "staff") }>المشرفون والإداريون</a>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden border border-slate-200/80 rounded-2xl shadow-xs">
				if len(users) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
							@components.IconUsers("icon-md")
						</div>
						<h3 class="text-lg font-black text-primary mb-2">لا يوجد مستخدمون</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يتم العثور على مستخدمين مسجلين في هذا القسم.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>الاسم</th>
									<th>البريد الإلكتروني</th>
									<th>الهاتف</th>
									<th>الدور</th>
									<th class="text-center">الحالة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, u := range users {
									<tr>
										<td><strong class="text-primary text-xs">{ u.Name.Get("ar") }</strong></td>
										<td class="tabular-nums text-xs font-mono">{ u.Email }</td>
										<td class="tabular-nums text-xs">{ u.Phone }</td>
										<td><span class="badge badge-secondary text-xs font-bold">{ u.Role }</span></td>
										<td class="text-center">
											if u.Status == identity.StatusActive {
												<span class="badge badge-emerald text-xs font-bold">نشط</span>
											} else {
												<span class="badge badge-rose text-xs font-bold">معطل</span>
											}
										</td>
										<td class="text-end">
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/users/%d", u.ID)) } class="btn btn-secondary btn-sm font-bold text-xs">عرض الملف</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

// AdminUserDetailPage renders a detailed view of a user.
// AdminUserRoleOption is one assignable platform role.
type AdminUserRoleOption struct {
	Key      string
	Name      string
	IsStaff  bool
	Selected bool
}

// AdminUserDetailView carries the account and what may be done to it.
type AdminUserDetailView struct {
	User *identity.User
	// Roles is empty when the viewer may not assign roles; the form is then
	// not rendered at all, which matches what the route would answer.
	Roles []AdminUserRoleOption
	// SelfEdit marks the viewer looking at their own account. Assigning your
	// own role is refused by the handler, so the form says why rather than
	// offering a control that always fails.
	SelfEdit bool
}

templ AdminUserDetailPage(v AdminUserDetailView, lang, dir string) {
	{{ u := v.User }}
	@layouts.AdminShell(fmt.Sprintf("ملف المستخدم: %s", u.Name.Get("ar")), "users", lang, dir) {
		<div class="page-container max-w-2xl mx-auto">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center mb-4 pb-3 border-b">
					<div>
						<h2 class="text-xl font-black text-primary m-0">{ u.Name.Get("ar") }</h2>
						<p class="text-xs text-secondary m-0 mt-1">معرف #{ fmt.Sprintf("%d", u.ID) } | دور: { u.Role }</p>
					</div>
					<a href="/admin/users" class="btn btn-secondary btn-sm font-bold text-xs">العودة لدليل المستخدمين</a>
				</div>

				<div>
					<div>
						<div class="text-xs text-secondary font-bold">البريد الإلكتروني</div>
						<div class="tabular-nums text-sm font-bold text-primary mt-1 font-mono">{ u.Email }</div>
					</div>
					<div>
						<div class="text-xs text-secondary font-bold">رقم الهاتف</div>
						<div class="tabular-nums text-sm font-bold text-primary mt-1">{ u.Phone }</div>
					</div>
					<div>
						<div class="text-xs text-secondary font-bold">الحالة</div>
						<div class="mt-1">
							if u.Status == identity.StatusActive {
								<span class="badge badge-emerald text-xs font-bold">نشط</span>
							} else {
								<span class="badge badge-rose text-xs font-bold">معطل</span>
							}
						</div>
					</div>
				</div>
			</div>
			@adminUserRoleForm(v)
		</div>
	}
}

// adminUserRoleForm assigns the account a platform role.
//
// Changing a role ends every session the account holds, because permissions
// are resolved per request from the role: leaving the old sessions open would
// let the user keep acting under authority that was just taken away until
// their cookie happened to expire.
templ adminUserRoleForm(v AdminUserDetailView) {
	if len(v.Roles) > 0 {
		<div class="glass-panel p-6">
			<h3 class="text-base font-extrabold text-primary mt-0 mb-1">الدور على مستوى المنصة</h3>
			<p class="text-xs text-secondary mb-4">
				يحدد الدور ما يراه هذا الحساب داخل لوحة الإدارة. صلاحياته داخل منشأته تأتي من عضويته وليس من هنا.
			</p>
			if v.SelfEdit {
				<p class="text-sm text-secondary m-0">
					لا يمكنك تغيير دور حسابك بنفسك؛ يقوم بذلك مشرف آخر.
				</p>
			} else {
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/role", v.User.ID)) } class="d-flex items-center gap-3">
					<select name="role" class="form-input">
						for _, role := range v.Roles {
							<option value={ role.Key } selected?={ role.Selected }>
								if role.IsStaff {
									{ role.Name + " — لوحة الإدارة" }
								} else {
									{ role.Name }
								}
							</option>
						}
					</select>
					<button type="submit" class="btn btn-primary font-bold">حفظ الدور</button>
					<span class="text-xs text-muted">سيتم إنهاء جلسات المستخدم الحالية فوراً.</span>
				</form>
			}
		</div>
	}
}

// AdminDeletionRequestsPage renders deletion requests.
templ AdminDeletionRequestsPage(requests []*identity.AccountDeletionRequest, lang, dir string) {
	@layouts.AdminShell("طلبات حذف الحسابات", "users", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge text-xl">
						@components.IconTrash("icon-sm")
					</div>
					<div>
						<h1 class="text-2xl font-black text-primary m-0">طلبات حذف الحسابات ({ fmt.Sprintf("%d", len(requests)) })</h1>
						<p class="text-sm text-secondary m-0 mt-1">مراجعة طلبات المستخدمين لحذف الحسابات نهائياً من المنصة</p>
					</div>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(requests) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconTrash("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد طلبات حذف معلقة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لا توجد أي طلبات لحذف الحسابات حالياً.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>#</th>
									<th>معرف المستخدم</th>
									<th>السبب</th>
									<th class="text-center">الحالة</th>
									<th>تاريخ الطلب</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, r := range requests {
									<tr>
										<td class="tabular-nums font-bold text-brand">#{ fmt.Sprintf("%d", r.ID) }</td>
										<td class="text-xs">مستخدم #{ fmt.Sprintf("%d", r.UserID) }</td>
										<td class="text-xs">{ r.Reason }</td>
										<td class="text-center"><span class="badge badge-amber text-xs font-bold">{ r.Status }</span></td>
										<td class="text-xs tabular-nums">{ r.CreatedAt.Format("2006-01-02 15:04") }</td>
										<td class="text-end">
											<div class="d-inline-flex gap-2">
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/approve", r.ID)) }>
													<button type="submit" class="btn btn-ghost btn-sm text-danger font-bold">موافقة وحذف</button>
												</form>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/reject", r.ID)) }>
													<button type="submit" class="btn btn-secondary btn-sm font-bold text-xs">رفض الطلب</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

// AdminEmployeeActivitiesPage renders employee activity logs with full multi-parameter filtering.
templ AdminEmployeeActivitiesPage(data AdminEmployeeActivitiesData, lang, dir string) {
	@layouts.AdminShell("سجل نشاطات وعمليات الموظفين بالمنشآت", "employee_activities", lang, dir) {
		<div class="page-container" x-data="{ selected: null, isDetailsOpen: false }">
			
			<!-- Page Header -->
			<div class="glass-panel p-6 mb-6 border border-slate-200/80 rounded-2xl shadow-sm">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="w-11 h-11 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs text-xl">
							@components.IconClock("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">سجل نشاطات وعمليات الموظفين بالمنشآت</h1>
							<p class="text-xs text-secondary m-0 mt-1 font-medium">
								تدقيق وتتبع كافة الإجراءات والعمليات المنفذة من قِبل موظفي الصيدليات والشركات الموردة ({ fmt.Sprintf("%d عملية موثقة", data.TotalCount) })
							</p>
						</div>
					</div>

					<div class="d-flex items-center gap-2">
						<a href="/admin/employee-activities" class="btn btn-secondary btn-sm font-bold text-xs gap-1.5 shadow-xs">
							@components.IconRefresh("icon-xs")
							<span>تحديث السجل</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Filter Strip -->
			<div class="glass-panel p-5 mb-6 border border-slate-200/80 rounded-2xl shadow-xs">
				<form method="GET" action="/admin/employee-activities" class="d-flex flex-col gap-3 m-0">
					<div class="d-grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
						<!-- Search Query -->
						<div>
							<label class="form-label text-xs font-bold text-secondary mb-1 d-block">البحث العام</label>
							<input
								type="text"
								name="q"
								value={ data.SearchQuery }
								placeholder="اسم الموظف، البريد، الإجراء، أو المعرف..."
								class="form-input text-xs font-medium w-full"
							/>
						</div>

						<!-- Organization Filter -->
						<div>
							<label class="form-label text-xs font-bold text-secondary mb-1 d-block">المنشأة التابع لها</label>
							<select name="org_id" class="form-input text-xs font-medium w-full">
								<option value="0">كافة المنشآت (صيدليات وموردين)</option>
								for _, o := range data.Organizations {
									<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>
										if o.TradeName["ar"] != "" {
											{ o.TradeName["ar"] }
										} else {
											{ o.LegalName }
										}
										(ID #{ fmt.Sprintf("%d", o.ID) })
									</option>
								}
							</select>
						</div>

						<!-- User / Employee Filter -->
						<div>
							<label class="form-label text-xs font-bold text-secondary mb-1 d-block">الموظف المنفذ</label>
							<select name="user_id" class="form-input text-xs font-medium w-full">
								<option value="0">كافة المستخدمين والموظفين</option>
								for _, u := range data.Users {
									<option value={ fmt.Sprintf("%d", u.ID) } selected?={ data.SelectedUserID == u.ID }>
										{ u.Name.Get("ar") } ({ u.Email })
									</option>
								}
							</select>
						</div>

						<!-- Action Filter & Buttons -->
						<div class="d-flex items-center gap-2">
							<div class="flex-1">
								<label class="form-label text-xs font-bold text-secondary mb-1 d-block">نوع العملية</label>
								<select name="action" class="form-input text-xs font-medium w-full">
									<option value="">كافة العمليات</option>
									<option value="user" selected?={ data.SelectedAction == "user" }>المستخدمين والصلاحيات</option>
									<option value="org" selected?={ data.SelectedAction == "org" }>المنشآت والفروع</option>
									<option value="offer" selected?={ data.SelectedAction == "offer" }>العروض والأسعار</option>
									<option value="order" selected?={ data.SelectedAction == "order" }>طلبات وأوامر التوريد</option>
									<option value="invoice" selected?={ data.SelectedAction == "invoice" }>الفواتير والمدفوعات</option>
									<option value="warehouse" selected?={ data.SelectedAction == "warehouse" }>المخازن والمستودعات</option>
								</select>
							</div>

							<button type="submit" class="btn btn-primary btn-sm font-black text-xs px-4 shadow-sm">
								@components.IconSearch("icon-xs")
								<span>تصفية</span>
							</button>

							if data.SearchQuery != "" || data.SelectedOrgID > 0 || data.SelectedUserID > 0 || data.SelectedAction != "" {
								<a href="/admin/employee-activities" class="btn btn-secondary btn-sm text-xs font-bold">
									إلغاء
								</a>
							}
						</div>
					</div>
				</form>
			</div>

			<!-- Activities Table Panel -->
			<div class="glass-panel p-0 mb-6 overflow-hidden border border-slate-200/80 rounded-2xl shadow-xs">
				if len(data.Entries) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3 text-2xl">
							@components.IconClock("icon-sm")
						</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد أنشطة مسجلة</h3>
						<p class="text-xs text-secondary max-w-md mx-auto">لم يتم العثور على أي عمليات تطابق معايير التصفية والبحث الحالية في سجل النظام.</p>
					</div>
				} else {
					<div class="table-container m-0 overflow-x-auto">
						<table class="data-table m-0 text-xs w-full">
							<thead>
								<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
									<th class="py-3 text-center ps-4"># ID</th>
									<th class="py-3 text-start">التوقيت والتاريخ</th>
									<th class="py-3 text-start">الموظف المنفذ</th>
									<th class="py-3 text-start">المنشأة التابع لها</th>
									<th class="py-3 text-start">نوع الإجراء</th>
									<th class="py-3 text-start">القسم / العنصر</th>
									<th class="py-3 text-start">معرف الصنف</th>
									<th class="text-center py-3">عنوان IP</th>
									<th class="text-end py-3 pe-4">الإجراءات</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								for _, e := range data.Entries {
									{{ actionLabel, badgeClass := formatAuditAction(e.Action, e.ActionLabelAr) }}
									<tr class="hover:bg-slate-50/50 transition-colors">
										<!-- 1. ID -->
										<td class="text-center ps-4">
											<span class="tabular-nums font-mono font-bold text-muted">
												#{ fmt.Sprintf("%d", e.ID) }
											</span>
										</td>

										<!-- 2. Timestamp -->
										<td class="text-start">
											<div class="tabular-nums font-bold text-primary">
												{ e.CreatedAt.Format("2006-01-02") }
											</div>
											<div class="tabular-nums text-2xs text-muted mt-0.5">
												{ e.CreatedAt.Format("15:04:05") }
											</div>
										</td>

										<!-- 3. Actor -->
										<td class="text-start">
											<div class="d-flex items-center gap-2">
												<div class="user-avatar-badge text-xs font-black">
													if len(e.ActorName) > 0 {
														{ string([]rune(e.ActorName)[0]) }
													} else {
														م
													}
												</div>
												<div>
													<div class="font-extrabold text-xs text-primary">
														{ e.ActorName }
													</div>
													if e.ActorEmail != "" {
														<div class="text-2xs text-muted tabular-nums" dir="ltr">
															{ e.ActorEmail }
														</div>
													}
												</div>
											</div>
										</td>

										<!-- 4. Organization -->
										<td class="text-start">
											<div class="font-bold text-primary text-xs">
												{ e.OrganizationName }
											</div>
											if e.OrganizationID != nil && *e.OrganizationID > 0 {
												<div class="text-2xs text-muted tabular-nums">
													ID #{ fmt.Sprintf("%d", *e.OrganizationID) }
												</div>
											}
										</td>

										<!-- 5. Action -->
										<td class="text-start">
											<span class={ "badge text-xs font-bold", badgeClass }>
												{ actionLabel }
											</span>
										</td>

										<!-- 6. Entity Type -->
										<td class="text-start">
											<span class="badge badge-slate text-xs font-bold">
												{ formatEntityType(e.EntityType, e.EntityTypeAr) }
											</span>
										</td>

										<!-- 7. Entity ID -->
										<td class="text-start">
											if e.EntityID != "" {
												<code class="tabular-nums text-xs bg-surface-sunken border border-slate-200/80 px-1.5 py-0.5 rounded font-mono font-bold">
													{ formatShortID(e.EntityID) }
												</code>
											} else {
												<span class="text-xs text-muted">—</span>
											}
										</td>

										<!-- 8. IP Address -->
										<td class="text-center tabular-nums text-xs font-mono text-secondary">
											if e.IPAddress != "" {
												{ e.IPAddress }
											} else {
												<span class="text-muted">داخلي</span>
											}
										</td>

										<!-- 9. Actions -->
										<td class="text-end pe-4">
											<button
												type="button"
												class="btn btn-secondary btn-xs font-bold gap-1 shadow-2xs"
												@click={ fmt.Sprintf("selected = %s; isDetailsOpen = true;", func() string { s, _ := templ.JSONString(e); return s }()) }
											>
												@components.IconEye("icon-2xs")
												<span>تفاصيل</span>
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Pagination Footer -->
					if data.TotalPages > 1 {
						<div class="p-4 px-6 border-t border-slate-100 flex-between items-center flex-wrap gap-4">
							<div class="text-xs text-muted font-bold tabular-nums">
								إجمالي السجلات: <strong>{ fmt.Sprintf("%d", data.TotalCount) }</strong> (صفحة { fmt.Sprintf("%d", data.Page) } من { fmt.Sprintf("%d", data.TotalPages) })
							</div>

							<div class="d-flex items-center gap-1">
								if data.Page > 1 {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/employee-activities?page=%d&q=%s&org_id=%d&user_id=%d&action=%s", data.Page-1, data.SearchQuery, data.SelectedOrgID, data.SelectedUserID, data.SelectedAction)) }
										class="btn btn-secondary btn-sm font-bold text-xs"
									>
										السابق
									</a>
								} else {
									<button class="btn btn-secondary btn-sm text-xs" disabled>السابق</button>
								}

								<span class="btn btn-primary btn-sm font-black tabular-nums text-xs">
									{ fmt.Sprintf("%d", data.Page) }
								</span>

								if data.Page < data.TotalPages {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/employee-activities?page=%d&q=%s&org_id=%d&user_id=%d&action=%s", data.Page+1, data.SearchQuery, data.SelectedOrgID, data.SelectedUserID, data.SelectedAction)) }
										class="btn btn-secondary btn-sm font-bold text-xs"
									>
										التالي
									</a>
								} else {
									<button class="btn btn-secondary btn-sm text-xs" disabled>التالي</button>
								}
							</div>
						</div>
					}
				}
			</div>

			<!-- Details & JSON Diff Modal -->
			<div
				x-show="isDetailsOpen"
				x-cloak
				x-transition.opacity
				class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs"
			
				@keydown.escape.window="isDetailsOpen = false"
			>
				<div
					@click.outside="isDetailsOpen = false"
					class="glass-panel p-6 border border-slate-200/80 rounded-2xl shadow-2xl max-w-2xl w-full bg-white relative mx-auto my-auto overflow-hidden"
				
				>
					<div class="flex-between items-center pb-3 mb-4 border-b border-slate-100">
						<div class="d-flex items-center gap-2.5">
							<div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
								@components.IconClock("icon-sm")
							</div>
							<div>
								<h3 class="text-base font-black text-primary m-0" x-text="'تفاصيل العملية #' + (selected ? selected.id : '')"></h3>
								<p class="text-2xs text-secondary m-0 mt-0.5 font-medium" x-text="selected ? (selected.action + ' • ' + selected.entity_type) : ''"></p>
							</div>
						</div>
						<button type="button" @click="isDetailsOpen = false" class="btn btn-secondary btn-icon btn-sm">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<template x-if="selected">
						<div class="d-flex flex-col gap-4">
							<div class="d-grid grid-cols-2 gap-3 p-3.5 bg-surface-sunken rounded-xl border border-slate-200/80 text-xs">
								<div>
									<span class="text-muted d-block text-2xs">الموظف المنفذ:</span>
									<strong class="text-primary font-bold" x-text="selected.actor_name"></strong>
								</div>
								<div>
									<span class="text-muted d-block text-2xs">المنشأة:</span>
									<strong class="text-primary font-bold" x-text="selected.organization_name"></strong>
								</div>
								<div>
									<span class="text-muted d-block text-2xs">عنوان IP:</span>
									<code class="font-mono text-secondary" x-text="selected.ip_address || 'داخلي'"></code>
								</div>
								<div>
									<span class="text-muted d-block text-2xs">التوقيت:</span>
									<span class="tabular-nums font-bold text-secondary" x-text="selected.created_at"></span>
								</div>
							</div>

							<!-- Before / After JSON Payloads -->
							<div class="d-grid grid-cols-1 md:grid-cols-2 gap-3">
								<div class="p-3 bg-rose-50/40 rounded-xl border border-rose-100">
									<div class="text-2xs font-extrabold text-rose-800 mb-1.5">البيانات السابقة (Before):</div>
									<pre class="text-2xs font-mono bg-white p-2.5 rounded-lg border border-rose-200 overflow-x-auto text-slate-700" x-text="JSON.stringify(selected.before || {}, null, 2)"></pre>
								</div>
								<div class="p-3 bg-emerald-50/40 rounded-xl border border-emerald-100">
									<div class="text-2xs font-extrabold text-emerald-800 mb-1.5">البيانات بعد التعديل (After):</div>
									<pre class="text-2xs font-mono bg-white p-2.5 rounded-lg border border-emerald-200 overflow-x-auto text-slate-700" x-text="JSON.stringify(selected.after || {}, null, 2)"></pre>
								</div>
							</div>
						</div>
					</template>

					<div class="flex-between items-center pt-3 mt-4 border-t border-slate-100">
						<span></span>
						<button type="button" @click="isDetailsOpen = false" class="btn btn-secondary btn-sm font-bold px-6">
							إغلاق
						</button>
					</div>
				</div>
			</div>

		</div>
	}
}


