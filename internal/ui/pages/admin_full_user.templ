package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminFullUserPage renders the categorized user list.
templ AdminFullUserPage(users []*identity.User, activeFilter string, lang, dir string) {
	@layouts.AdminShell("إدارة ودليل المستخدمين الشامل", "users", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							👥
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">دليل المستخدمين والحسابات ({ fmt.Sprintf("%d", len(users)) })</h1>
							<p class="text-sm text-secondary m-0 mt-1">متابعة حسابات العملاء، مسؤولي الصيدليات، والمشرفين عبر المنصة</p>
						</div>
					</div>
				</div>

				<!-- Filter Tabs -->
				<div class="cb-tabs-nav m-0 mt-6 pt-4 border-t">
					<a href="/admin/full-user" class={ "cb-tab-btn", templ.KV("active", activeFilter == "all") }>كافة المستخدمين</a>
					<a href="/admin/customer-list" class={ "cb-tab-btn", templ.KV("active", activeFilter == "customers") }>الصيدليات والعملاء</a>
					<a href="/admin/vendor-list" class={ "cb-tab-btn", templ.KV("active", activeFilter == "vendors") }>الموردون والشركات</a>
					<a href="/admin/admin-list" class={ "cb-tab-btn", templ.KV("active", activeFilter == "staff") }>المشرفون والإداريون</a>
					<a href="/admin/want-delete" class="cb-tab-btn text-danger">طلبات الحذف</a>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(users) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">👥</div>
						<h3 class="text-lg font-black text-primary mb-2">لا يوجد مستخدمون</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يتم العثور على مستخدمين مسجلين في هذا القسم.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>الاسم</th>
									<th>البريد الإلكتروني</th>
									<th>الهاتف</th>
									<th>الدور</th>
									<th class="text-center">الحالة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, u := range users {
									<tr>
										<td><strong class="text-primary text-xs">{ u.Name.Get("ar") }</strong></td>
										<td class="tabular-nums text-xs font-mono">{ u.Email }</td>
										<td class="tabular-nums text-xs">{ u.Phone }</td>
										<td><span class="badge badge-secondary text-xs font-bold">{ u.Role }</span></td>
										<td class="text-center">
											if u.Status == identity.StatusActive {
												<span class="badge badge-emerald text-xs font-bold">نشط</span>
											} else {
												<span class="badge badge-rose text-xs font-bold">معطل</span>
											}
										</td>
										<td class="text-end">
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/users/%d", u.ID)) } class="btn btn-secondary btn-sm font-bold text-xs">عرض الملف</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

// AdminUserDetailPage renders a detailed view of a user.
// AdminUserRoleOption is one assignable platform role.
type AdminUserRoleOption struct {
	Key      string
	Name      string
	IsStaff  bool
	Selected bool
}

// AdminUserDetailView carries the account and what may be done to it.
type AdminUserDetailView struct {
	User *identity.User
	// Roles is empty when the viewer may not assign roles; the form is then
	// not rendered at all, which matches what the route would answer.
	Roles []AdminUserRoleOption
	// SelfEdit marks the viewer looking at their own account. Assigning your
	// own role is refused by the handler, so the form says why rather than
	// offering a control that always fails.
	SelfEdit bool
}

templ AdminUserDetailPage(v AdminUserDetailView, lang, dir string) {
	{{ u := v.User }}
	@layouts.AdminShell(fmt.Sprintf("ملف المستخدم: %s", u.Name.Get("ar")), "users", lang, dir) {
		<div class="page-container max-w-2xl mx-auto">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center mb-4 pb-3 border-b">
					<div>
						<h2 class="text-xl font-black text-primary m-0">{ u.Name.Get("ar") }</h2>
						<p class="text-xs text-secondary m-0 mt-1">معرف #{ fmt.Sprintf("%d", u.ID) } | دور: { u.Role }</p>
					</div>
					<a href="/admin/users" class="btn btn-secondary btn-sm font-bold text-xs">العودة لدليل المستخدمين</a>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem;">
					<div>
						<div class="text-xs text-secondary font-bold">البريد الإلكتروني</div>
						<div class="tabular-nums text-sm font-bold text-primary mt-1 font-mono">{ u.Email }</div>
					</div>
					<div>
						<div class="text-xs text-secondary font-bold">رقم الهاتف</div>
						<div class="tabular-nums text-sm font-bold text-primary mt-1">{ u.Phone }</div>
					</div>
					<div>
						<div class="text-xs text-secondary font-bold">الحالة</div>
						<div class="mt-1">
							if u.Status == identity.StatusActive {
								<span class="badge badge-emerald text-xs font-bold">نشط</span>
							} else {
								<span class="badge badge-rose text-xs font-bold">معطل</span>
							}
						</div>
					</div>
				</div>
			</div>
			@adminUserRoleForm(v)
		</div>
	}
}

// adminUserRoleForm assigns the account a platform role.
//
// Changing a role ends every session the account holds, because permissions
// are resolved per request from the role: leaving the old sessions open would
// let the user keep acting under authority that was just taken away until
// their cookie happened to expire.
templ adminUserRoleForm(v AdminUserDetailView) {
	if len(v.Roles) > 0 {
		<div class="glass-panel p-6">
			<h3 class="text-base font-extrabold text-primary mt-0 mb-1">الدور على مستوى المنصة</h3>
			<p class="text-xs text-secondary mb-4">
				يحدد الدور ما يراه هذا الحساب داخل لوحة الإدارة. صلاحياته داخل منشأته تأتي من عضويته وليس من هنا.
			</p>
			if v.SelfEdit {
				<p class="text-sm text-secondary m-0">
					لا يمكنك تغيير دور حسابك بنفسك؛ يقوم بذلك مشرف آخر.
				</p>
			} else {
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/role", v.User.ID)) } class="d-flex items-center gap-3">
					<select name="role" class="form-input" style="max-width:320px;">
						for _, role := range v.Roles {
							<option value={ role.Key } selected?={ role.Selected }>
								if role.IsStaff {
									{ role.Name + " — لوحة الإدارة" }
								} else {
									{ role.Name }
								}
							</option>
						}
					</select>
					<button type="submit" class="btn btn-primary font-bold">حفظ الدور</button>
					<span class="text-xs text-muted">سيتم إنهاء جلسات المستخدم الحالية فوراً.</span>
				</form>
			}
		</div>
	}
}

// AdminDeletionRequestsPage renders deletion requests.
templ AdminDeletionRequestsPage(requests []*identity.AccountDeletionRequest, lang, dir string) {
	@layouts.AdminShell("طلبات حذف الحسابات", "users", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge text-xl">
						🗑️
					</div>
					<div>
						<h1 class="text-2xl font-black text-primary m-0">طلبات حذف الحسابات ({ fmt.Sprintf("%d", len(requests)) })</h1>
						<p class="text-sm text-secondary m-0 mt-1">مراجعة طلبات المستخدمين لحذف الحسابات نهائياً من المنصة</p>
					</div>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(requests) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">🗑️</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد طلبات حذف معلقة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لا توجد أي طلبات لحذف الحسابات حالياً.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>#</th>
									<th>معرف المستخدم</th>
									<th>السبب</th>
									<th class="text-center">الحالة</th>
									<th>تاريخ الطلب</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, r := range requests {
									<tr>
										<td class="tabular-nums font-bold text-brand">#{ fmt.Sprintf("%d", r.ID) }</td>
										<td class="text-xs">مستخدم #{ fmt.Sprintf("%d", r.UserID) }</td>
										<td class="text-xs">{ r.Reason }</td>
										<td class="text-center"><span class="badge badge-amber text-xs font-bold">{ r.Status }</span></td>
										<td class="text-xs tabular-nums">{ r.CreatedAt.Format("2006-01-02 15:04") }</td>
										<td class="text-end">
											<div class="d-inline-flex gap-2">
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/approve", r.ID)) }>
													<button type="submit" class="btn btn-ghost btn-sm text-danger font-bold">موافقة وحذف</button>
												</form>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/deletion/%d/reject", r.ID)) }>
													<button type="submit" class="btn btn-secondary btn-sm font-bold text-xs">رفض الطلب</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

// AdminEmployeeActivitiesPage renders employee activity logs.
templ AdminEmployeeActivitiesPage(activities []any, lang, dir string) {
	@layouts.AdminShell("سجل نشاطات الموظفين والعمليات", "employee_activities", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<h1 class="text-2xl font-black text-primary m-0 mb-4">سجل نشاطات الموظفين بالمنشآت</h1>
				<div class="p-8 text-center empty-state-glass">
					<div class="text-4xl mb-3">📋</div>
					<h3 class="text-lg font-black text-primary mb-2">سجل العمليات فارغ</h3>
					<p class="text-sm text-secondary max-w-md mx-auto">يتم تسجيل عمليات الموظفين والموردين تلقائياً عند إجراء التعديلات على المنتجات والأسعار.</p>
				</div>
			</div>
		</div>
	}
}

