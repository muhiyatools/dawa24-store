package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)



// AdminFullUserPage renders the categorized user list.
templ AdminFullUserPage(users []*identity.User, activeFilter string, lang, dir string) {
	@layouts.AdminShell("إدارة ودليل المستخدمين الشامل", "users", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 d-flex items-center justify-center border border-indigo-200/60 shadow-2xs">
							@components.IconUsers("icon-sm")
						</div>
      <div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">دليل المستخدمين والحسابات ({ fmt.Sprintf("%d", len(users)) })</h1>
							<p class="text-sm text-secondary m-0 mt-1">متابعة حسابات العملاء، مسؤولي الصيدليات، والمشرفين عبر المنصة</p>
						</div>
					</div>
				</div>

				<!-- Filter Tabs -->
				<div class="tabs-nav mt-6">
					<a href="/admin/users" class={ "tab-btn", templ.KV("active", activeFilter == "all") }>كافة المستخدمين</a>
					<a href="/admin/users?type=customer" class={ "tab-btn", templ.KV("active", activeFilter == "customers") }>الصيدليات والعملاء</a>
					<a href="/admin/users?type=vendor" class={ "tab-btn", templ.KV("active", activeFilter == "vendors") }>الموردون والشركات</a>
					<a href="/admin/users?type=staff" class={ "tab-btn", templ.KV("active", activeFilter == "staff") }>المشرفون والإداريون</a>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden border border-slate-200/80 rounded-2xl shadow-xs">
				if len(users) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3">
							@components.IconUsers("icon-md")
						</div>
						<h3 class="text-lg font-black text-primary mb-2">لا يوجد مستخدمون</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يتم العثور على مستخدمين مسجلين في هذا القسم.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>الاسم</th>
									<th>البريد الإلكتروني</th>
									<th>الهاتف</th>
									<th>الدور</th>
									<th class="text-center">الحالة</th>
									<th class="col-actions">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, u := range users {
									<tr>
										<td>
											<div class="d-flex items-center gap-2">
												if u.AvatarURL != "" {
													<div class="w-7 h-7 rounded-lg border overflow-hidden flex-shrink-0 bg-surface-sunken">
														<img src={ u.AvatarURL } alt={ u.Name.Get("ar") } class="w-full h-full object-cover" onerror="this.style.display='none'" />
													</div>
												}
												<strong class="text-primary text-xs">{ u.Name.Get("ar") }</strong>
											</div>
										</td>
										<td class="tabular-nums text-xs font-mono">{ u.Email }</td>
										<td class="tabular-nums text-xs">{ u.Phone }</td>
										<td><span class="badge badge-secondary text-xs font-bold">{ u.Role }</span></td>
										<td class="text-center">
											if u.Status == identity.StatusActive {
												<span class="badge badge-emerald text-xs font-bold">نشط</span>
											} else {
												<span class="badge badge-rose text-xs font-bold">معطل</span>
											}
										</td>
										<td class="col-actions">
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/users/%d", u.ID)) } class="btn btn-secondary btn-sm font-bold text-xs">عرض الملف</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

// AdminUserDetailPage renders a detailed view of a user.
// AdminUserRoleOption is one assignable platform role.
type AdminUserRoleOption struct {
	Key      string
	Name      string
	IsStaff  bool
	Selected bool
}

// AdminUserDetailView carries the account and what may be done to it.
type AdminUserDetailView struct {
	User *identity.User
	// Roles is empty when the viewer may not assign roles; the form is then
	// not rendered at all, which matches what the route would answer.
	Roles []AdminUserRoleOption
	// SelfEdit marks the viewer looking at their own account. Assigning your
	// own role is refused by the handler, so the form says why rather than
	// offering a control that always fails.
	SelfEdit bool
	// IsModerator says the account holds the مشرف role, which is the only role
	// the hierarchy applies to.
	IsModerator bool
	// ModeratorParentID is whose team they are on, or nil for a top-level
	// (main) moderator.
	ModeratorParentID *int64
	// SubordinateCount is how many moderators report to this one. A moderator
	// who leads a team cannot be moved under somebody else without their team
	// being moved first, and the form says so rather than failing on submit.
	SubordinateCount int
	// MainModerators are the top-level moderators this one may be placed under.
	MainModerators []AdminModeratorOption
	// CanAssignModerator gates the form on identity.moderator.assign.
	CanAssignModerator bool
}

templ AdminUserDetailPage(v AdminUserDetailView, lang, dir string) {
	{{ u := v.User }}
	@layouts.AdminShell(fmt.Sprintf("ملف المستخدم: %s", u.Name.Get("ar")), "users", lang, dir) {
		<div class="page-container max-w-2xl mx-auto">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center mb-4 pb-3 border-b">
					<div class="d-flex items-center gap-3">
						if u.AvatarURL != "" {
							<div class="w-12 h-12 rounded-xl border overflow-hidden flex-shrink-0 bg-surface-sunken shadow-2xs">
								<img src={ u.AvatarURL } alt={ u.Name.Get("ar") } class="w-full h-full object-cover" onerror="this.style.display='none'" />
							</div>
						}
						<div class="stack-sm">
							<h2 class="text-xl font-black text-primary m-0">{ u.Name.Get("ar") }</h2>
							<p class="text-xs text-secondary m-0 mt-1">معرف #{ fmt.Sprintf("%d", u.ID) } | دور: { u.Role }</p>
						</div>
					</div>
					<a href="/admin/users" class="btn btn-secondary btn-sm font-bold text-xs">العودة لدليل المستخدمين</a>
				</div>

    <div class="stack-sm">
     <div class="stack-sm">
						<div class="text-xs text-secondary font-bold">البريد الإلكتروني</div>
						<div class="tabular-nums text-sm font-bold text-primary mt-1 font-mono">{ u.Email }</div>
					</div>
     <div class="stack-sm">
						<div class="text-xs text-secondary font-bold">رقم الهاتف</div>
						<div class="tabular-nums text-sm font-bold text-primary mt-1">{ u.Phone }</div>
					</div>
     <div class="stack-sm">
						<div class="text-xs text-secondary font-bold">الحالة</div>
						<div class="mt-1">
							if u.Status == identity.StatusActive {
								<span class="badge badge-emerald text-xs font-bold">نشط</span>
							} else {
								<span class="badge badge-rose text-xs font-bold">معطل</span>
							}
						</div>
					</div>
				</div>
			</div>
			@adminUserRoleForm(v)
			@adminModeratorHierarchyForm(v)
		</div>
	}
}

// adminUserRoleForm assigns the account a platform role.
//
// Changing a role ends every session the account holds, because permissions
// are resolved per request from the role: leaving the old sessions open would
// let the user keep acting under authority that was just taken away until
// their cookie happened to expire.
templ adminUserRoleForm(v AdminUserDetailView) {
	if len(v.Roles) > 0 {
		<div class="glass-panel p-6">
			<h3 class="text-base font-extrabold text-primary mt-0 mb-1">الدور على مستوى المنصة</h3>
			<p class="text-xs text-secondary mb-4">
				يحدد الدور ما يراه هذا الحساب داخل لوحة الإدارة. صلاحياته داخل منشأته تأتي من عضويته وليس من هنا.
			</p>
			if v.SelfEdit {
				<p class="text-sm text-secondary m-0">
					لا يمكنك تغيير دور حسابك بنفسك؛ يقوم بذلك مشرف آخر.
				</p>
			} else {
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/role", v.User.ID)) } class="d-flex items-center gap-3">
					<select name="role" class="form-input">
						for _, role := range v.Roles {
							<option value={ role.Key } selected?={ role.Selected }>
								if role.IsStaff {
									{ role.Name + " — لوحة الإدارة" }
								} else {
									{ role.Name }
								}
							</option>
						}
					</select>
					<button type="submit" class="btn btn-primary font-bold">حفظ الدور</button>
					<span class="text-xs text-muted">سيتم إنهاء جلسات المستخدم الحالية فوراً.</span>
				</form>
			}
		</div>
	}
}

// adminModeratorHierarchyForm places a moderator in the hierarchy.
//
// It is a separate form from the role form on purpose: changing who a moderator
// reports to changes who can read the temporary warehouses they upload, which
// is an access-control decision with its own permission and its own audit
// entry. Bundling it into "save role" would hide that.
templ adminModeratorHierarchyForm(v AdminUserDetailView) {
	if v.IsModerator && v.CanAssignModerator {
		<div class="glass-panel p-6">
			<h3 class="text-base font-extrabold text-primary mt-0 mb-1">موقع المشرف في التسلسل</h3>
			<p class="text-xs text-secondary mb-4">
				المشرف الرئيسي المستقل يتبع مدير النظام مباشرة ويرى مستودعات المشرفين المعيّنين تحته.
				المشرف التابع يرى مستودعاته وحده.
			</p>
			if v.SubordinateCount > 0 {
				<p class="text-sm text-secondary m-0 mb-3">
					{ fmt.Sprintf("يدير هذا المشرف %d مشرفاً. لنقله تحت إدارة مشرف آخر، انقل من يتبعونه أولاً.", v.SubordinateCount) }
				</p>
			}
			<form
				method="POST"
				action={ templ.SafeURL(fmt.Sprintf("/admin/users/%d/moderator-parent", v.User.ID)) }
				class="stack-sm"
				x-data={ "{ level: '" + moderatorLevelOf(v) + "' }" }
			>
				<label class="form-label d-flex items-center gap-2">
					<input type="radio" name="moderator_level" value="main" x-model="level"/>
					<span class="text-body">مشرف رئيسي مستقل</span>
				</label>
				<label class="form-label d-flex items-center gap-2">
					<input
						type="radio"
						name="moderator_level"
						value="sub"
						x-model="level"
						disabled?={ v.SubordinateCount > 0 || len(v.MainModerators) == 0 }
					/>
					<span class="text-body">يعمل تحت إدارة مشرف رئيسي</span>
				</label>
				<div x-show="level === 'sub'" x-cloak>
					if len(v.MainModerators) > 0 {
						<select name="moderator_parent_id" class="form-input">
							<option value="">— اختر المشرف الرئيسي —</option>
							for _, m := range v.MainModerators {
								<option
									value={ fmt.Sprintf("%d", m.UserID) }
									selected?={ v.ModeratorParentID != nil && *v.ModeratorParentID == m.UserID }
								>
									{ m.Name } ({ fmt.Sprintf("%d مشرف تحته", m.Team) })
								</option>
							}
						</select>
					} else {
						<p class="text-xs text-warning m-0">لا يوجد مشرف رئيسي مستقل آخر لتعيينه.</p>
					}
				</div>
				<div class="d-flex items-center gap-3 mt-2">
					<button type="submit" class="btn btn-primary font-bold">حفظ التبعية</button>
				</div>
			</form>
		</div>
	}
}

// moderatorLevelOf is the radio group's initial selection.
func moderatorLevelOf(v AdminUserDetailView) string {
	if v.ModeratorParentID != nil {
		return "sub"
	}
	return "main"
}


