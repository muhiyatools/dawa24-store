package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/ingest"
	"github.com/muhiya/dawa24-store/internal/shared/productmatch"
)

// Stages four to five: confirmation, the running import, and the results.

// --- stage 4: confirmation -------------------------------------------------

templ importConfirmStage(view VendorImportView) {
	@importFileSummary(view)
	<div class="glass-panel p-6">
		<h2 class="wiz-head">4. راجع ثم أكّد</h2>
		<p class="wiz-sub">هذا ما سيحدث عند الضغط على «ابدأ الاستيراد». لا شيء قد كُتب حتى الآن.</p>
		<div class="wiz-map">
			@importSummaryItem("المخزن", importWarehouseName(view))
			@importSummaryItem("طريقة التعامل مع الأصناف", view.Session.Settings.Mode.Label())
			@importSummaryItem("طريقة التعامل مع الأرصدة", view.Session.Settings.StockMode.Label())
			@importSummaryItem("الأصناف غير المطابقة", "تُعرض في التقرير ولا تُضاف للكتالوج المعتمد")
			@importSummaryItem("عدد صفوف الملف", fmt.Sprint(view.Session.Source.TotalRows))
		</div>
	</div>
	if view.Session.Mapping != nil {
		<div class="glass-panel p-6">
			<h3 class="wiz-head">الأعمدة التي ستُقرأ</h3>
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th>العمود في ملفك</th>
							<th>سيُقرأ كـ</th>
							<th>المصدر</th>
						</tr>
					</thead>
					<tbody>
						for _, col := range view.Session.Mapping.Columns {
							if col.Field != "" {
								<tr>
									<td class="font-bold">{ col.Header }</td>
									<td>{ col.Label }</td>
									<td>
										<span class={ "badge", ConfidenceTone(col.Confidence), "text-xs" }>
											if col.Source == productmatch.SourceManual {
												تحديد يدوي
											} else if col.Source == productmatch.SourceCompleted {
												أُكمل تلقائياً بعد مراجعتك
											} else {
												تحليل تلقائي · { PercentText(col.Score) }
											}
										</span>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	}
	<div class="glass-panel p-6 mb-0">
		<div class="wiz-actions">
			<span class="wiz-actions-note">
				if view.Session.Settings.Mode.Destructive() {
					تنبيه: سيتم إيقاف عرض كل صنف لديك غير موجود في هذا الملف.
				} else {
					يمكنك العودة وتعديل أي خطوة قبل البدء.
				}
			</span>
			<div class="row-center">
				<form class="stack-md" method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/back") }>
					<button type="submit" class="btn btn-ghost">← تعديل الربط</button>
				</form>
				<form class="stack-md" method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/confirm") } hx-boost="false"
					if view.Session.Settings.Mode.Destructive() {
						onsubmit="return confirm('سيتم إيقاف عرض كل صنف غير موجود في هذا الملف. هل أنت متأكد؟');"
					}
				>
					<button type="submit" class="btn btn-primary">ابدأ الاستيراد</button>
				</form>
			</div>
		</div>
	</div>
}

templ importSummaryItem(label, value string) {
	<div class="wiz-map-item">
		<span class="wiz-map-label">{ label }</span>
		<span class="wiz-map-hint">{ value }</span>
	</div>
}

// --- stage 5: processing ---------------------------------------------------

templ importProcessingStage(view VendorImportView) {
	<div class="glass-panel p-6" id="import-progress-card" data-import={ view.Session.PublicID }>
		<h2 class="wiz-head">جارٍ تنفيذ الاستيراد</h2>
		<p class="wiz-sub" id="import-progress-note">{ view.Session.ProgressNote }</p>
		<div class="wiz-progress">
			<div class="wiz-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100">
				<div
					class="wiz-progress-fill"
					id="import-progress-bar"
					style={ templ.SafeCSS(fmt.Sprintf("width:%d%%", view.Session.ProgressPercent)) }
				></div>
			</div>
			<div class="wiz-progress-meta">
				<span id="import-progress-count" class="tabular-nums"></span>
				<span id="import-progress-percent" class="wiz-progress-percent">
					{ fmt.Sprintf("%d%%", view.Session.ProgressPercent) }
				</span>
			</div>
		</div>
		<p class="text-xs text-muted mt-2">
			يمكنك إغلاق هذه الصفحة؛ ستستمر العملية وستجد نتيجتها في سجل عمليات الاستيراد.
		</p>
	</div>
	<script>
		// Deferred scripts have NOT run yet when this one does.
		//
		// import-progress.js is loaded with `defer` in the head, so it executes
		// after the document is parsed — while this inline script runs DURING
		// parsing. window.ImportProgress was therefore undefined, the guard
		// below returned, and nothing ever polled: the bar kept the percentage
		// the server had rendered into the HTML and sat on it, on an import
		// that had already finished. That is the "stuck at 1% forever" report.
		//
		// DOMContentLoaded is the fence: every deferred script has executed by
		// the time it fires. When the DOM is already parsed (an htmx swap, a
		// bfcache restore) it will never fire, so that case runs immediately.
		(function () {
			function startProgress() {
				const card = document.getElementById('import-progress-card');
				if (!card) return;
				if (typeof window.ImportProgress !== 'function') {
					console.error('import-progress.js did not load; the progress bar cannot update');
					return;
				}
				const bar = new window.ImportProgress({
					fill:    document.getElementById('import-progress-bar'),
					label:   document.getElementById('import-progress-note'),
					percent: document.getElementById('import-progress-percent'),
					count:   document.getElementById('import-progress-count'),
					onDone:  function () { setTimeout(function () { window.location.reload(); }, 500); },
				});
				bar.follow('/vendor/ingest/' + card.dataset.import + '/stream',
					'/vendor/ingest/' + card.dataset.import + '/progress', 1500);
			}
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', startProgress);
			} else {
				startProgress();
			}
		})();
	</script>
}

// --- stage 6: results ------------------------------------------------------

templ importResultsStage(view VendorImportView) {
	<div class="glass-panel p-6">
		<h2 class="wiz-head">
			if view.Session.Phase == ingest.PhaseFailed {
				لم يكتمل الاستيراد
			} else if view.Session.Phase == ingest.PhaseCancelled {
				تم إلغاء الاستيراد
			} else {
				اكتمل الاستيراد
			}
		</h2>
		if view.Session.ErrorMessage != "" {
			<p class="wiz-sub text-danger">{ view.Session.ErrorMessage }</p>
		}
		<div class="wiz-stats">
			@importStat("تمت الإضافة", fmt.Sprint(view.Session.InsertedRows))
			@importStat("تم التحديث", fmt.Sprint(view.Session.UpdatedRows))
			if view.Session.ErrorRows > 0 {
				@importStat("أخطاء", fmt.Sprint(view.Session.ErrorRows))
			}
			@importStat("إجمالي الصفوف", fmt.Sprint(view.Session.TotalRows))
		</div>
		<p class="text-xs text-muted mt-2">
			{ fmt.Sprintf("اكتملت معالجة وحفظ البيانات بنجاح في قاعدة البيانات ومخزنك المختار (%d صنف تمت معالجته).", view.Session.InsertedRows + view.Session.UpdatedRows) }
		</p>
		<div class="row-center mt-3">
			<a href="/vendor/products" class="btn btn-primary btn-sm">عرض أصناف المورد ←</a>
			<a href="/vendor/ingest" class="btn btn-secondary btn-sm">استيراد ملف جديد</a>
		</div>
	</div>
	if len(view.Session.Findings) > 0 {
		<div class="glass-panel p-6">
			<h3 class="wiz-head">ملاحظات على الصفوف</h3>
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr><th>الصف</th><th>الحقل</th><th>القيمة</th><th>الملاحظة</th></tr>
					</thead>
					<tbody>
						for i, f := range view.Session.Findings {
							if i < 100 {
								<tr>
									<td>{ fmt.Sprint(f.Row) }</td>
									<td class="text-xs">{ f.Column }</td>
									<td class="text-xs text-muted">{ f.Value }</td>
									<td>
										<span class={ "badge", SeverityTone(f.Severity), "text-xs" }>
											if f.Severity == productmatch.SeverityError {
												خطأ
											} else if f.Severity == productmatch.SeverityWarning {
												تنبيه
											} else {
												معلومة
											}
										</span>
										<span class="text-sm">{ f.Message }</span>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	}
	if len(view.Rows) > 0 {
		@importRowsTable(view)
	}
}

templ importRowsTable(view VendorImportView) {
	<div class="glass-panel p-6">
  <div class="stack-sm">
			<h3 class="wiz-head m-0">{ fmt.Sprintf("سجل الصفوف (%d)", view.RowTotal) }</h3>
			<div class="row-center-sm">
				@importRowFilter(view, "", "الكل")
				@importRowFilter(view, ingest.OutcomeInserted, "أضيف")
				@importRowFilter(view, ingest.OutcomeUpdated, "حُدّث")
				@importRowFilter(view, ingest.OutcomeSkipped, "تخطي")
				@importRowFilter(view, ingest.OutcomeError, "أخطاء")
			</div>
		</div>
		<div class="table-container">
			<table class="data-table">
				<thead>
					<tr>
						<th>#</th>
						<th>اسم الصنف في الملف</th>
						<th>الصنف المطابق المعتمد في المنصة (الأدوية المعتمدة)</th>
						<th class="text-center">النتيجة</th>
						<th class="text-center">درجة المطابقة</th>
						<th>تفاصيل وملاحظات الذكاء الصيدلاني</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range view.Rows {
						<tr class="rule-bottom">
							<td class="text-center tabular-nums font-bold text-muted">{ fmt.Sprint(row.SourceRow) }</td>
							<td>
								<div class="font-bold text-primary text-09">{ row.DisplayName }</div>
								if row.SourceCode != "" {
									<div class="text-xs text-muted">
										كود الصنف بالملف: <code class="text-xs">{ row.SourceCode }</code>
									</div>
								}
							</td>
							<td>
								if row.MatchedCatalogName() != "" {
									<div class="font-bold">
										{ row.MatchedCatalogName() }
									</div>
									if row.MatchedCatalogSKU() != "" {
										<div class="text-xs text-muted">
											كود الكتالوج: <code class="text-xs">{ row.MatchedCatalogSKU() }</code>
										</div>
									}
								} else if row.MatchLevel == "none" || row.Outcome == ingest.OutcomeInserted {
									<span class="badge badge-amber text-xs">
										صنف جديد غير مسجل مسبقاً بالكتالوج المركزي
									</span>
								} else {
									<span class="text-xs text-muted">—</span>
								}
							</td>
							<td class="text-center">
								<span class={ "badge", OutcomeTone(row.Outcome), "text-xs" }>
									{ OutcomeLabel(row.Outcome) }
								</span>
							</td>
							<td class="text-center text-xs">
        <div class="stack-sm">
									<span class={ "badge", MatchLevelBadgeClass(row.MatchLevel), "text-xs" }>
										{ MatchLevelLabel(row.MatchLevel) }
									</span>
								</div>
								if row.MatchScore > 0 {
									<div class="text-muted tabular-nums font-bold">
										{ PercentText(row.MatchScore) }
									</div>
								}
							</td>
							<td class="text-xs">
								{ row.Message }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ importRowFilter(view VendorImportView, outcome, label string) {
	<a
		class={ "wiz-chip", templ.KV("is-on", view.Filter.Outcome == outcome) }
		href={ templ.SafeURL(importRowsURL(view.Session.PublicID, outcome)) }
	>
		{ label }
	</a>
}
