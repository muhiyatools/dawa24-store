package pages

import (
	"fmt"

	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminDevelopersValues struct {
	ActiveTab       string // "sql", "ai", "errors", "audit"
	GatewaySettings *platformadmin.GatewaySettings
	AISettings      *platformadmin.AISettings
	SQLLogs         []*platformadmin.SQLLog
	ErrorLogs       []*platformadmin.ErrorLog
	ErrorMetrics    struct {
		Total         int
		Critical24h   int
		Unresolved    int
		AffectedUsers int
	}
	ErrorLevelFilter  string
	ErrorStatusFilter string
	ErrorSearch       string
	AuditEntries      []*platformadmin.AuditEntry
}

templ AdminDevelopersPage(values AdminDevelopersValues, lang, dir string) {
	@layouts.AdminShell("أدوات المطورين وتشخيص النظام | Developer Tools & Diagnostics", "developers", lang, dir) {
		<div class="page-container" x-data={ fmt.Sprintf("adminDevelopersManager(%q)", values.ActiveTab) }>
			
			<!-- Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconMonitor("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">أدوات المطورين وتشخيص النظام</h1>
							<p class="text-sm text-secondary m-0 mt-1">وحدة استعلامات SQL، بوابة الذكاء الاصطناعي، نظام مراقبة الأخطاء المتقدم، وسجلات التدقيق</p>
						</div>
					</div>
				</div>

				<!-- Main Persistent Tabs Bar -->
				<div class="cb-tabs-nav m-0 mt-6 pt-4 border-t">
					<button
						type="button"
						class="cb-tab-btn"
						:class="{ 'active': activeTab === 'sql' }"
						@click="setTab('sql')"
					>
						@components.IconDatabase("icon-xs")
						<span>1. وحدة استعلامات SQL</span>
					</button>

					<button
						type="button"
						class="cb-tab-btn"
						:class="{ 'active': activeTab === 'ai' }"
						@click="setTab('ai')"
					>
						@components.IconSparkles("icon-xs")
						<span>2. بوابة الذكاء الاصطناعي</span>
					</button>

					<button
						type="button"
						class="cb-tab-btn"
						:class="{ 'active': activeTab === 'errors' }"
						@click="setTab('errors')"
					>
						@components.IconBug("icon-xs")
						<span>3. سجلات وتشخيص الأخطاء</span>
					</button>

					<button
						type="button"
						class="cb-tab-btn"
						:class="{ 'active': activeTab === 'audit' }"
						@click="setTab('audit')"
					>
						@components.IconClock("icon-xs")
						<span>4. سجلات الأنشطة والتدقيق</span>
					</button>
				</div>
			</div>

			<!-- ========================================== -->
			<!-- TAB 1: SQL Console & Query Log             -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'sql'" class="stack-lg" x-data="adminSQLManager()" x-cloak>
				
				<div class="card mb-0">
					<div class="flex-between items-center mb-4 pb-3 border-b flex-wrap gap-2">
						<div>
							<h3 class="card-title m-0 text-lg font-black">
								وحدة استعلامات SQL التفاعلية
							</h3>
							<p class="text-xs text-secondary mt-0.5 mb-0">
								تنفيذ استعلامات قواعد البيانات المباشرة وعرض النتائج ومعدل زمن الاستجابة
							</p>
						</div>

						<!-- Quick Query Presets -->
						<div class="d-flex gap-1.5 flex-wrap">
							<button type="button" @click="setQuery('SELECT id, name, type, status, created_at FROM org.organizations ORDER BY id DESC LIMIT 10;')" class="btn btn-secondary btn-xs">منظمات</button>
							<button type="button" @click="setQuery('SELECT id, name, generic_name, dosage_form, status FROM catalog.products LIMIT 10;')" class="btn btn-secondary btn-xs">أصناف</button>
							<button type="button" @click="setQuery('SELECT id, status, total_amount, currency, created_at FROM commerce.orders ORDER BY id DESC LIMIT 10;')" class="btn btn-secondary btn-xs">طلبيات</button>
							<button type="button" @click="setQuery('SELECT count(*) AS total_users FROM identity.users;')" class="btn btn-secondary btn-xs">المستخدمين</button>
						</div>
					</div>

					<form @submit.prevent="runQuery()" class="stack">
						<div class="form-group m-0">
							<textarea
								x-model="sqlQuery"
								rows="5"
								required
								class="form-input font-mono text-sm leading-relaxed bg-slate-900 text-sky-400 border-slate-700"
								dir="ltr"
								placeholder="SELECT * FROM catalog.products LIMIT 10;"
							></textarea>
						</div>

						<div class="flex-between flex-wrap gap-3">
							<div class="text-xs text-muted">
								الاستعلامات مسجلة وموثقة في سجل المطورين الزمني.
							</div>
							<div class="row-center-sm">
								<button type="button" @click="sqlQuery = ''" class="btn btn-secondary btn-sm">مسح</button>
								<button type="submit" class="btn btn-primary font-bold px-6 py-2" :disabled="isRunning">
									<span x-show="!isRunning">▶ تنفيذ الاستعلام (Execute)</span>
									<span x-show="isRunning">جاري التنفيذ...</span>
								</button>
							</div>
						</div>
					</form>

					<!-- Query Output Area -->
					<div x-show="queryExecuted" class="mt-6 pt-5 border-t">
						
						<!-- Execution Summary Pill -->
						<div class="flex-between items-center mb-3 flex-wrap gap-2">
							<div class="row-center-sm">
								<template x-if="!queryResult.error">
									<span class="badge badge-emerald">نجاح التنفيذ</span>
								</template>
								<template x-if="queryResult.error">
									<span class="badge badge-rose">خطأ في الاستعلام</span>
								</template>
								<span class="text-sm text-muted tabular-nums" x-text="'المدة: ' + queryResult.duration_ms + ' ms'"></span>
								<span class="text-sm text-muted tabular-nums" x-text="'الصفوف: ' + queryResult.rows_affected"></span>
							</div>
						</div>

						<!-- Error Display if any -->
						<template x-if="queryResult.error">
							<div class="bg-danger-subtle border border-danger rounded-xl p-4 text-danger font-mono text-sm text-start overflow-x-auto" dir="ltr" x-text="queryResult.error"></div>
						</template>

						<!-- Results Table -->
						<template x-if="!queryResult.error && queryResult.columns && queryResult.columns.length > 0">
							<div class="table-container m-0 max-h-96 overflow-y-auto">
								<table class="data-table m-0 font-mono text-xs">
									<thead>
										<tr class="sticky top-0 z-1">
											<template x-for="col in queryResult.columns" :key="col">
												<th x-text="col"></th>
											</template>
										</tr>
									</thead>
									<tbody>
										<template x-for="(row, rIdx) in queryResult.rows" :key="rIdx">
											<tr>
												<template x-for="(cell, cIdx) in row" :key="cIdx">
													<td class="max-w-xs truncate nowrap" x-text="cell"></td>
												</template>
											</tr>
										</template>
									</tbody>
								</table>
							</div>
						</template>

					</div>
				</div>

				<!-- SQL Execution History Table -->
				<div class="glass-panel p-6 mb-6">
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<h4 class="text-sm font-black text-primary m-0">
							سجل الاستعلامات السابقة (Query Execution History)
						</h4>
						<span class="badge badge-slate text-xs">{ fmt.Sprintf("%d استعلام مسجل", len(values.SQLLogs)) }</span>
					</div>

					if len(values.SQLLogs) == 0 {
						<div class="p-6 text-center text-muted text-xs">
							لم يتم تنفيذ أي استعلامات بعد.
						</div>
					} else {
						<div class="table-container m-0">
							<table class="data-table m-0 text-xs">
								<thead>
									<tr>
										<th class="w-1/5">التوقيت والمستخدم</th>
										<th class="w-1/2">نص الاستعلام (SQL Query)</th>
										<th class="text-center w-24">المدة (ms)</th>
										<th class="text-center w-20">الصفوف</th>
										<th class="text-center w-24">الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, log := range values.SQLLogs {
										<tr>
											<td class="text-start">
												<div class="tabular-nums font-bold text-primary">{ log.CreatedAt.Format("2006-01-02 15:04:05") }</div>
												<div class="text-xs text-muted">{ log.ActorName }</div>
											</td>
											<td class="text-start">
												<code class="bg-surface-sunken p-1 rounded font-mono block max-w-lg truncate" dir="ltr">{ log.Query }</code>
											</td>
											<td class="text-center tabular-nums">
												<span>{ fmt.Sprintf("%d", log.DurationMS) } ms</span>
											</td>
											<td class="text-center tabular-nums">
												<span>{ fmt.Sprintf("%d", log.RowsAffected) }</span>
											</td>
											<td class="text-center">
												if log.ErrorMessage == "" {
													<span class="badge badge-emerald">نجاح</span>
												} else {
													<span class="badge badge-rose" title={ log.ErrorMessage }>خطأ</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

			</div>

			<!-- ========================================== -->
			<!-- TAB 2: AI Gateway & Live Model Fetcher     -->
			<!-- ========================================== -->
			<div
				x-show="activeTab === 'ai'"
				class="stack-lg"
				x-data={ fmt.Sprintf("adminAIManager(%q, %q)", values.GatewaySettings.EndpointURL, values.GatewaySettings.APIKey) }
				x-cloak
			>
				
				<div class="card mb-0">
					<div class="flex-between items-center mb-5 pb-3 border-b">
						<div class="row-center">
							<div class="b2b-icon-box">
								@components.IconSparkles("icon-sm")
							</div>
							<div>
								<h3 class="card-title m-0 text-lg font-black">
									بوابة الذكاء الاصطناعي (AI Gateway — api.muhiya.com)
								</h3>
								<p class="text-xs text-secondary mt-0.5 mb-0">
									إدارة نقطة النهاية (Endpoint)، ومزامنة باقات الذكاء الاصطناعي مع خطط الاشتراك الموحدة.
								</p>
							</div>
						</div>
						if values.GatewaySettings.IsActive {
							<span class="badge badge-emerald">البوابة نشطة ومتصلة</span>
						} else {
							<span class="badge badge-slate">معطلة</span>
						}
					</div>

					if values.GatewaySettings.CredentialLooksMisconfigured() {
						<!--
						  The stored administrator credential looks like a database
						  connection secret. It is sent as Basic auth to the Gateway
						  host on every management call, so the operator has to be
						  told even though they are not the one who typed it.
						-->
						<div class="bg-danger-subtle border border-danger rounded-xl p-4 text-sm leading-relaxed">
							<strong class="text-danger block mb-1">بيانات الاعتماد المحفوظة تبدو غير صحيحة</strong>
							<span class="text-secondary">
								القيمة المحفوظة في حقل بيانات اعتماد المدير تطابق شكل بيانات اتصال قاعدة بيانات، وليست بيانات اعتماد بوابة الذكاء الاصطناعي.
								<strong>تُرسل هذه القيمة إلى خادم البوابة الخارجي عند كل عملية مزامنة أو استعلام.</strong>
								يرجى تغيير كلمة مرور قاعدة البيانات فوراً، ثم إدخال بيانات اعتماد مدير البوابة الصحيحة هنا.
							</span>
						</div>
					}

					<!-- Informational Architecture Alert -->
					<div class="bg-sky-subtle border border-sky-500/20 rounded-xl p-4 text-xs leading-relaxed">
						<strong class="text-primary block mb-1">ℹ️ مبدأ عمل وعزل الذكاء الاصطناعي للمنشآت:</strong>
						<span class="text-secondary">
							مفتاح الربط والمصادقة هنا يُستخدم فقط من قِبل إدارة منصة دواء 24 لمزامنة الباقات وتوليد مفاتيح المنشآت. جميع طلبات الذكاء الاصطناعي للمنشآت والمستخدمين تعمل تلقائياً باستخدام <strong>المفتاح الافتراضي المخصص لكل منشأة (Organization Virtual Key)</strong> وبناءً على خطة اشتراكها وحصتها المحددة في باقات الاشتراك الموحدة.
						</span>
					</div>

					<form action="/admin/developers/ai" method="POST" class="stack-lg">
						
						<!-- Gateway Endpoint -->
						<div class="d-grid grid-cols-2 gap-4">
							<div class="form-group m-0">
								<label class="form-label">رابط بوابة الذكاء الاصطناعي (Gateway Endpoint URL) *</label>
								<input
									type="url"
									name="endpoint_url"
									x-model="gatewayURL"
									required
									class="form-input"
									dir="ltr"
									placeholder="https://api.muhiya.com"
								/>
							</div>

							<div class="form-group m-0">
								<label class="form-label">حالة البوابة</label>
								<select name="is_active" class="form-select">
									<option value="true" selected?={ values.GatewaySettings.IsActive }>مفعلة (Active)</option>
									<option value="false" selected?={ !values.GatewaySettings.IsActive }>معطلة (Disabled)</option>
								</select>
							</div>
						</div>

						<!-- Admin Credentials (Username & Password) -->
						<div class="d-grid grid-cols-2 gap-4">
							<div class="form-group m-0">
								<label class="form-label">اسم مستخدم مدير البوابة (Admin Username) *</label>
								<input
									type="text"
									name="admin_username"
									x-model="gatewayUser"
									required
									class="form-input"
									dir="ltr"
									placeholder="admin"
								/>
							</div>

							<div class="form-group m-0">
								<label class="form-label">كلمة مرور مدير البوابة (ADMIN_PASSWORD) *</label>
								<div class="relative d-flex items-center">
									<input
										:type="showKey ? 'text' : 'password'"
										name="api_key"
										x-model="gatewayKey"
										class="form-input pe-12"
										dir="ltr"
										placeholder="أدخل كلمة مرور تسجيل الدخول للوحة البوابة..."
									/>
									<button
										type="button"
										@click="showKey = !showKey"
										class="absolute end-3 bg-transparent border-0 text-muted cursor-pointer text-xs font-bold"
										x-text="showKey ? 'إخفاء' : 'إظهار'"
									></button>
								</div>
							</div>
						</div>
						<p class="text-xs text-muted -mt-2 mb-0">
							أدخل نفس بيانات تسجيل الدخول التي تستخدمها للدخول إلى لوحة البوابة <code>/admin/</code> (المحددة في ADMIN_PASSWORD بسيرفر البوابة).
						</p>

						<!-- Models and the provisioned admin-panel identity -->
						<div class="grid-2">
							<div class="form-group m-0">
								<label class="form-label">نموذج المهام السريعة (Fast)</label>
								<input
									type="text"
									name="fast_model"
									value={ values.GatewaySettings.FastModel }
									class="form-input"
									dir="ltr"
									placeholder="qwen3.7-flash"
								/>
								<span class="text-xs text-muted">
									يُستخدم في مطابقة الأصناف وتوسيع البحث.
								</span>
							</div>
							<div class="form-group m-0">
								<label class="form-label">نموذج المهام الدقيقة (Quality)</label>
								<input
									type="text"
									name="quality_model"
									value={ values.GatewaySettings.QualityModel }
									class="form-input"
									dir="ltr"
									placeholder="qwen3.7-flash"
								/>
								<span class="text-xs text-muted">
									يُستخدم في استكمال بيانات الأصناف أثناء الاستيراد.
								</span>
							</div>
						</div>
						<p class="text-xs text-muted -mt-2 mb-0">
							اتركهما فارغين لاستخدام النموذج الافتراضي. يجب أن يكون الاسم مطابقاً لما تنشره البوابة.
						</p>

						<div class="p-4 border rounded-lg bg-surface-sunken">
							<div class="text-sm font-bold mb-1">
								مفتاح لوحة التحكم (Admin Panel Key)
							</div>
							if values.GatewaySettings.VirtualKey != "" {
								<div class="text-xs text-success font-bold">
									تم إنشاؤه تلقائياً — المستخدم:
									<code dir="ltr">{ values.GatewaySettings.AIUserID }</code>
								</div>
							} else {
								<div class="text-xs text-muted">
									سيتم إنشاؤه تلقائياً من بيانات مدير البوابة أعلاه عند أول استخدام للذكاء الاصطناعي.
								</div>
							}
							<div class="text-xs text-muted mt-1">
								هذا المفتاح مستقل عن مفاتيح المنشآت، ويُستخدم لعمليات المنصة نفسها مثل استيراد الكتالوج.
							</div>
						</div>

						<!-- Test Connection & Role Breakdown -->
						<div class="d-grid grid-cols-2 gap-4 items-start">
							<div>
								<button
									type="button"
									class="btn btn-secondary w-full font-bold h-11 justify-center gap-1.5"
									@click="testConnection()"
									:disabled="isTesting"
								>
									@components.IconSparkles("icon-xs")
									<span x-show="!isTesting">اختبار الاتصال بالبوابة (Live Test)</span>
									<span x-show="isTesting">جاري فحص الاتصال...</span>
								</button>
								<div x-show="testResult" class="mt-2" x-cloak>
									<div :class="testResult && testResult.status === 'healthy' ? 'badge badge-emerald' : 'badge badge-rose'" class="w-full p-2 justify-center font-bold" x-text="testResult ? testResult.message : ''"></div>
								</div>
							</div>

							<div class="bg-surface-sunken border rounded-xl p-3 text-xs">
								<div class="font-bold text-primary mb-1">أدوار النماذج المعتمدة بالمنظومة:</div>
								<div class="d-flex flex-col gap-1 text-secondary">
									<div>• <strong>المحادثة الأساسية:</strong> <code>assistant.primary</code></div>
									<div>• <strong>تحليل المرفقات:</strong> <code>assistant.attachment</code></div>
									<div>• <strong>التفريغ الصوتي:</strong> <code>assistant.transcribe</code></div>
								</div>
							</div>
						</div>

						<div class="form-group m-0">
							<label class="form-label">التعليمات التوجيهية للذكاء الاصطناعي (System Prompt)</label>
							if values.AISettings != nil && values.AISettings.SystemPrompt != "" {
								<textarea name="system_prompt" rows="3" class="form-input">{ values.AISettings.SystemPrompt }</textarea>
							} else {
								<textarea name="system_prompt" rows="3" class="form-input">أنت المساعد الذكي لمنصة دواء 24، متخصص في مساعدة الصيدليات والموردين في العمليات الدوائية وإدارة المخزون والتوريد.</textarea>
							}
						</div>

						<div class="d-flex justify-end border-t pt-4">
							<button type="submit" class="btn btn-primary font-bold px-8 py-2.5">
								@components.IconCheck("icon-xs")
								<span>حفظ إعدادات بوابة الذكاء الاصطناعي</span>
							</button>
						</div>
					</form>
				</div>

			</div>

			<!-- ========================================== -->
			<!-- TAB 3: Advanced Error Diagnostics          -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'errors'" class="stack-lg" x-data="adminErrorsManager()" x-cloak>
				
				<!-- Diagnostics Header Strip & Metrics -->
				<div class="dashboard-stat-grid mb-4">
					<div class="card mb-0 p-5 border-s-4 border-s-accent">
						<div class="text-xs font-bold text-muted">إجمالي الاستثناءات المسجلة</div>
						<div class="text-2xl font-black text-primary mt-1 tabular-nums">
							{ fmt.Sprintf("%d", values.ErrorMetrics.Total) }
						</div>
						<div class="text-xs text-muted mt-0.5">سجل تشخيصي شامل</div>
					</div>

					<div class="card mb-0 p-5 border-s-4 border-s-danger">
						<div class="text-xs font-bold text-muted">أخطاء حرجة (24 ساعة)</div>
						<div class="text-2xl font-black text-danger mt-1 tabular-nums">
							{ fmt.Sprintf("%d", values.ErrorMetrics.Critical24h) }
						</div>
						<div class="text-xs text-muted mt-0.5">تتطلب تدخلاً فورياً</div>
					</div>

					<div class="card mb-0 p-5 border-s-4 border-s-warning">
						<div class="text-xs font-bold text-muted">أخطاء قيد المتابعة</div>
						<div class="text-2xl font-black text-warning mt-1 tabular-nums">
							{ fmt.Sprintf("%d", values.ErrorMetrics.Unresolved) }
						</div>
						<div class="text-xs text-muted mt-0.5">حالة New أو Investigating</div>
					</div>

					<div class="card mb-0 p-5 border-s-4 border-s-success">
						<div class="text-xs font-bold text-muted">المستخدمين المتأثرين</div>
						<div class="text-2xl font-black text-primary mt-1 tabular-nums">
							{ fmt.Sprintf("%d", values.ErrorMetrics.AffectedUsers) }
						</div>
						<div class="text-xs text-muted mt-0.5">حسابات صادفت أخطاء</div>
					</div>
				</div>

				<!-- Filter Strip -->
				<div class="card mb-0 p-4">
					<form method="GET" action="/admin/developers" class="d-flex gap-3 items-center flex-wrap m-0">
						<input type="hidden" name="tab" value="errors"/>

						<div class="flex-1 min-w-60">
							<input
								type="text"
								name="err_q"
								value={ values.ErrorSearch }
								placeholder="بحث برسالة الخطأ، الكلاس، أو اسم المستخدم..."
								class="form-input text-sm"
							/>
						</div>

						<div class="min-w-36">
							<select name="err_level" class="form-select text-sm">
								<option value="">كافة المستويات</option>
								<option value="CRITICAL" selected?={ values.ErrorLevelFilter == "CRITICAL" }>حرج (CRITICAL)</option>
								<option value="ERROR" selected?={ values.ErrorLevelFilter == "ERROR" }>خطأ (ERROR)</option>
								<option value="WARNING" selected?={ values.ErrorLevelFilter == "WARNING" }>تحذير (WARNING)</option>
								<option value="EXCEPTION" selected?={ values.ErrorLevelFilter == "EXCEPTION" }>استثناء (EXCEPTION)</option>
							</select>
						</div>

						<div class="min-w-36">
							<select name="err_status" class="form-select text-sm">
								<option value="">كافة الحالات</option>
								<option value="NEW" selected?={ values.ErrorStatusFilter == "NEW" }>جديد (NEW)</option>
								<option value="INVESTIGATING" selected?={ values.ErrorStatusFilter == "INVESTIGATING" }>قيد التحقيق</option>
								<option value="RESOLVED" selected?={ values.ErrorStatusFilter == "RESOLVED" }>تم الحل (RESOLVED)</option>
							</select>
						</div>

						<button type="submit" class="btn btn-primary btn-sm font-bold">
							@components.IconSearch("icon-xs")
							<span>تصفية</span>
						</button>
					</form>
				</div>

				<!-- Error Diagnostics Table -->
				if len(values.ErrorLogs) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconBug("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد أخطاء مسجلة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">النظام يعمل بكفاءة واستقرار تام. لم يتم تسجيل أي أخطاء أو استثناءات تطابق التصفية الحالية.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0 min-w-full text-xs">
							<thead>
								<tr class="bg-surface-sunken border-b">
									<th class="w-16 text-center">المعرف</th>
									<th class="w-28 text-start">التوقيت</th>
									<th class="w-24 text-center">المستوى</th>
									<th class="w-36 text-start">المستخدم / المنظمة</th>
									<th class="text-start">رسالة الخطأ والاستثناء</th>
									<th class="w-32 text-start">المسار / IP</th>
									<th class="w-24 text-center">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, err := range values.ErrorLogs {
									<tr class="rule-bottom">
										<td class="text-center tabular-nums">
											<strong class="text-muted">#{ fmt.Sprintf("%d", err.ID) }</strong>
										</td>
										<td class="text-start">
											<div class="tabular-nums font-bold text-primary">{ err.CreatedAt.Format("2006-01-02") }</div>
											<div class="tabular-nums text-xs text-muted">{ err.CreatedAt.Format("15:04:05") }</div>
										</td>
										<td class="text-center">
											if err.ErrorLevel == "CRITICAL" || err.ErrorLevel == "FATAL" {
												<span class="badge badge-danger font-black">{ err.ErrorLevel }</span>
											} else if err.ErrorLevel == "WARNING" {
												<span class="badge badge-amber font-bold">{ err.ErrorLevel }</span>
											} else {
												<span class="badge badge-sky font-bold">{ err.ErrorLevel }</span>
											}
										</td>
										<td class="text-start">
											if err.UserName != "" {
												<div class="font-bold text-primary">{ err.UserName }</div>
											} else {
												<div class="text-muted">مستخدم غير مسجل (Guest)</div>
											}
											if err.OrganizationName != "" {
												<div class="text-xs text-secondary">{ err.OrganizationName }</div>
											}
										</td>
										<td class="text-start">
											<div class="font-bold text-primary font-mono text-xs text-start truncate max-w-xs" dir="ltr">
												{ err.ErrorMessage }
											</div>
											if err.ExceptionClass != "" {
												<div class="text-xs text-accent font-mono text-start mt-0.5" dir="ltr">
													{ err.ExceptionClass }
												</div>
											}
										</td>
										<td class="text-start">
											<div class="font-mono text-xs text-start truncate max-w-32" dir="ltr">
												<strong class="text-accent">{ err.HTTPMethod }</strong> { err.URLPath }
											</div>
											<div class="text-xs text-muted font-mono text-start" dir="ltr">
												{ err.IPAddress }
											</div>
										</td>
										<td class="text-center">
											<button
												type="button"
												class="btn btn-secondary btn-sm text-xs font-bold text-accent"
												@click={ fmt.Sprintf("openErrorDetails(%d)", err.ID) }
											>
												@components.IconEye("icon-xs")
												<span>تشخيص</span>
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}

				<!-- Error Details Diagnostic Modal -->
				@components.Modal(components.ModalProps{
					ID:    "dev-error-modal",
					Title: "سجل تشخيص الخطأ",
					Size:  "lg",
				}) {
					<template x-if="selectedError">
						<div class="d-flex flex-col gap-4 text-start">
							<!-- Diagnostic Info Grid -->
							<div class="d-grid gap-3 p-4 bg-surface-sunken rounded-xl border grid-auto-fit-sm">
								<div>
									<div class="text-xs text-muted">المستخدم المتأثر:</div>
									<div class="text-sm font-bold text-primary" x-text="selectedError.user_name || 'زائر غير مسجل'"></div>
									<div class="text-xs text-secondary" x-text="selectedError.user_email"></div>
								</div>
								<div>
									<div class="text-xs text-muted">المنظمة:</div>
									<div class="font-bold text-primary" x-text="selectedError.organization_name || 'عام'"></div>
								</div>
								<div>
									<div class="text-xs text-muted">المسار وعنوان IP:</div>
									<div class="font-mono text-xs text-primary text-start" dir="ltr" x-text="selectedError.http_method + ' ' + selectedError.url_path"></div>
									<div class="text-xs text-muted font-mono text-start" dir="ltr" x-text="selectedError.ip_address"></div>
								</div>
								<div>
									<div class="text-xs text-muted">التوقيت والمستوى:</div>
									<div class="text-sm font-bold text-primary" x-text="selectedError.created_at"></div>
									<span class="badge badge-rose" x-text="selectedError.error_level"></span>
								</div>
							</div>

							<!-- Error Message Box -->
							<div class="bg-surface-sunken text-danger p-4 rounded-lg font-mono text-sm text-start" dir="ltr">
								<div class="text-muted text-xs mb-1">ERROR MESSAGE:</div>
								<div x-text="selectedError.error_message"></div>
							</div>

							<!-- Stack Trace Viewer -->
							<div>
								<div class="text-xs font-bold text-secondary mb-1">
									تتبع مكدس الاستدعاءات (Stack Trace & Code Location):
								</div>
								<pre
									class="bg-surface-sunken text-secondary p-4 rounded-lg font-mono text-xs max-h-64 overflow-auto text-start m-0"
									dir="ltr"
									x-text="selectedError.stack_trace || 'لا يتوفر تتبع مكدس مسجل لهذا الخطأ.'"
								></pre>
							</div>

							<div class="d-flex justify-between items-center pt-3 border-t mt-2">
								<form :action="'/admin/developers/errors/' + (selectedError ? selectedError.id : 0) + '/status'" method="POST" class="d-flex gap-2 m-0">
									<input type="hidden" name="status" value="RESOLVED"/>
									<button type="submit" class="btn btn-primary btn-sm font-bold">
										@components.IconCheck("icon-xs")
										<span>وضع علامة تم الحل (Mark Resolved)</span>
									</button>
								</form>
								<button type="button" class="btn btn-secondary" data-modal-close="dev-error-modal">إغلاق</button>
							</div>
						</div>
					</template>
				}

				<!-- Embedded Error Log Data Scripts -->
				for _, err := range values.ErrorLogs {
					<script type="application/json" id={ fmt.Sprintf("err-data-%d", err.ID) }>
						{
							"id": { fmt.Sprintf("%d", err.ID) },
							"user_name": { fmt.Sprintf("%q", err.UserName) },
							"user_email": { fmt.Sprintf("%q", err.UserEmail) },
							"organization_name": { fmt.Sprintf("%q", err.OrganizationName) },
							"error_level": { fmt.Sprintf("%q", err.ErrorLevel) },
							"error_message": { fmt.Sprintf("%q", err.ErrorMessage) },
							"exception_class": { fmt.Sprintf("%q", err.ExceptionClass) },
							"stack_trace": { fmt.Sprintf("%q", err.StackTrace) },
							"http_method": { fmt.Sprintf("%q", err.HTTPMethod) },
							"url_path": { fmt.Sprintf("%q", err.URLPath) },
							"ip_address": { fmt.Sprintf("%q", err.IPAddress) },
							"status": { fmt.Sprintf("%q", err.Status) },
							"created_at": { fmt.Sprintf("%q", err.CreatedAt.Format("2006-01-02 15:04:05")) }
						}
					</script>
				}

			</div>

			<!-- ========================================== -->
			<!-- TAB 4: Audit Logs & Diffs (Moved here)     -->
			<!-- ========================================== -->
			<div x-show="activeTab === 'audit'" class="stack-lg" x-data="adminAuditManager()" x-cloak>
				
				<div class="card mb-0">
					<div class="flex-between items-center mb-4 pb-3 border-b">
						<div>
							<h3 class="card-title m-0 text-lg font-black">
								سجلات الأنشطة والتدقيق الأمني ({ fmt.Sprintf("%d", len(values.AuditEntries)) })
							</h3>
							<p class="text-xs text-secondary mt-0.5 mb-0">
								سجل متزامن للعمليات الإدارية، التراخيص، تعديلات الأدوية، وحركات الحسابات
							</p>
						</div>
					</div>

					if len(values.AuditEntries) == 0 {
						<div class="p-8 text-center empty-state-glass">
							<div class="text-4xl mb-3">@components.IconFileText("icon-sm")</div>
							<h3 class="text-lg font-black text-primary mb-2">لا توجد عمليات مسجلة</h3>
							<p class="text-sm text-secondary max-w-md mx-auto">لم يتم تسجيل أي عمليات تطابق معايير البحث الحالية في سجل النظام.</p>
						</div>
					} else {
						<div class="table-container m-0">
							<table class="data-table m-0 min-w-full text-xs">
								<thead>
									<tr class="bg-surface-sunken border-b">
										<th class="w-16 text-center">المعرف</th>
										<th class="w-28 text-start">التوقيت</th>
										<th class="w-36 text-start">المستخدم</th>
										<th class="w-32 text-start">المنظمة</th>
										<th class="w-36 text-start">القسم والإجراء</th>
										<th class="text-start">العنوان والوصف</th>
										<th class="w-20 text-center">الأهمية</th>
										<th class="w-20 text-center">الإجراءات</th>
									</tr>
								</thead>
								<tbody>
									for _, e := range values.AuditEntries {
										<tr class="rule-bottom">
											<td class="text-center tabular-nums">
												<strong class="text-muted">#{ fmt.Sprintf("%d", e.ID) }</strong>
											</td>
											<td class="text-start">
												<div class="tabular-nums font-bold text-primary">{ e.CreatedAt.Format("2006-01-02") }</div>
												<div class="tabular-nums text-xs text-muted">{ e.CreatedAt.Format("15:04:05") }</div>
											</td>
											<td class="text-start">
												<div class="font-bold text-primary">{ e.ActorName }</div>
												if e.ActorEmail != "" {
													<div class="text-xs text-muted font-mono text-start" dir="ltr">{ e.ActorEmail }</div>
												}
											</td>
											<td class="text-start">
												<div class="font-bold text-primary">{ e.OrganizationName }</div>
											</td>
											<td class="text-start">
												<div class="d-flex flex-col gap-1">
													<span class={ "badge", auditBadgeClass(e.Action) } class="font-bold text-xs self-start">
														if e.ActionLabelAr != "" {
															{ e.ActionLabelAr }
														} else {
															{ e.Action }
														}
													</span>
													if e.Module != "" {
														<span class="text-xs text-muted">القسم: { e.Module }</span>
													} else {
														<span class="text-xs text-muted">القسم: المنظومة العامة</span>
													}
												</div>
											</td>
											<td class="text-start">
												<div class="font-bold text-primary">
													if e.Title != "" {
														{ e.Title }
													} else if e.ActionLabelAr != "" {
														{ e.ActionLabelAr }
													} else {
														{ e.Action }
													}
												</div>
												<div class="text-xs text-secondary mt-0.5 leading-relaxed">
													if e.Description != "" {
														{ e.Description }
													} else {
														<span>عملية إدارية مسجلة بالنظام</span>
													}
												</div>
											</td>
											<td class="text-center">
												if e.Severity != "" && e.Severity != "-" {
													<span class={ "badge", severityBadgeClass(e.Severity) } class="text-xs font-bold">
														{ e.Severity }
													</span>
												} else {
													<span class="badge badge-slate text-xs font-bold">
														عادي (Info)
													</span>
												}
											</td>
											<td class="text-center">
												<button
													type="button"
													class="btn btn-secondary btn-sm text-xs font-bold text-accent"
													@click={ fmt.Sprintf("openDetails(%d)", e.ID) }
												>
													@components.IconEye("icon-xs")
													<span>تفاصيل</span>
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Audit Inspection Modal -->
				@components.Modal(components.ModalProps{
					ID:    "dev-audit-modal",
					Title: "تفاصيل العملية والتدقيق",
					Size:  "lg",
				}) {
					<template x-if="selected">
						<div class="d-flex flex-col gap-4 text-start">
							<div class="bg-surface-sunken p-4 rounded-xl border">
								<div class="text-xs font-bold text-secondary mb-1">بيان العملية:</div>
								<div class="text-sm text-primary font-bold" x-text="selected.description"></div>
							</div>

							<!-- Side-by-Side Diff -->
							<div class="d-grid grid-cols-2 gap-4">
								<div class="bg-surface-sunken border rounded-xl p-4">
									<div class="font-bold text-xs text-primary mb-2">الحالة السابقة (Before)</div>
									<pre class="bg-surface-raised border rounded-md p-3 text-xs font-mono text-start max-h-56 overflow-auto m-0" dir="ltr" x-text="selected.before ? JSON.stringify(selected.before, null, 2) : 'لا توجد بيانات سابقة'"></pre>
								</div>

								<div class="bg-surface-sunken border rounded-xl p-4">
									<div class="font-bold text-xs text-primary mb-2">الحالة الجديدة (After)</div>
									<pre class="bg-surface-raised border rounded-md p-3 text-xs font-mono text-start max-h-56 overflow-auto m-0" dir="ltr" x-text="selected.after ? JSON.stringify(selected.after, null, 2) : 'لا توجد بيانات محدثة'"></pre>
								</div>
							</div>

							<div class="d-flex justify-end pt-3 border-t mt-2">
								<button type="button" class="btn btn-secondary" data-modal-close="dev-audit-modal">إغلاق</button>
							</div>
						</div>
					</template>
				}

				<!-- Embedded Audit JSON Data -->
				for _, e := range values.AuditEntries {
					<script type="application/json" id={ fmt.Sprintf("audit-data-%d", e.ID) }>
						{
							"id": { fmt.Sprintf("%d", e.ID) },
							"actor_name": { fmt.Sprintf("%q", e.ActorName) },
							"actor_email": { fmt.Sprintf("%q", e.ActorEmail) },
							"organization_name": { fmt.Sprintf("%q", e.OrganizationName) },
							"action": { fmt.Sprintf("%q", e.Action) },
							"action_label_ar": { fmt.Sprintf("%q", e.ActionLabelAr) },
							"module": { fmt.Sprintf("%q", e.Module) },
							"title": { fmt.Sprintf("%q", e.Title) },
							"description": { fmt.Sprintf("%q", e.Description) },
							"severity": { fmt.Sprintf("%q", e.Severity) },
							"before": { templ.JSONString(e.Before) },
							"after": { templ.JSONString(e.After) }
						}
					</script>
				}

			</div>

		</div>

		<script>
			function adminDevelopersManager(initialTab) {
				const urlParams = new URLSearchParams(window.location.search);
				const storedTab = urlParams.get('tab') || localStorage.getItem('dawa24-dev-tab') || initialTab || 'sql';

				return {
					activeTab: storedTab,

					setTab(tab) {
						this.activeTab = tab;
						localStorage.setItem('dawa24-dev-tab', tab);
						const u = new URL(window.location);
						u.searchParams.set('tab', tab);
						window.history.replaceState({}, '', u);
					}
				};
			}

			function adminSQLManager() {
				return {
					sqlQuery: 'SELECT id, name, type, status, created_at FROM org.organizations ORDER BY id DESC LIMIT 10;',
					isRunning: false,
					queryExecuted: false,
					queryResult: {
						columns: [],
						rows: [],
						duration_ms: 0,
						rows_affected: 0,
						error: ''
					},

					setQuery(q) {
						this.sqlQuery = q;
					},

					async runQuery() {
						if (!this.sqlQuery.trim()) return;
						this.isRunning = true;
						try {
							const form = new FormData();
							form.append('query', this.sqlQuery);
							const resp = await fetch('/admin/developers/sql', {
								method: 'POST',
								body: form
							});
							const data = await resp.json();
							this.queryResult = data;
							this.queryExecuted = true;
						} catch (e) {
							this.queryResult = {
								columns: [],
								rows: [],
								duration_ms: 0,
								rows_affected: 0,
								error: 'Network / server error: ' + e.message
							};
							this.queryExecuted = true;
						} finally {
							this.isRunning = false;
						}
					}
				};
			}

			function adminAIManager(initURL, initKey) {
				let user = 'admin';
				let key = initKey || '';
				if (key.includes(':')) {
					const parts = key.split(':');
					user = parts[0];
					key = parts[1];
				}
				return {
					showKey: false,
					gatewayURL: initURL || 'https://api.muhiya.com',
					gatewayUser: user,
					gatewayKey: key,
					isTesting: false,
					testResult: null,

					async testConnection() {
						this.isTesting = true;
						this.testResult = null;
						try {
							const form = new FormData();
							form.append('endpoint_url', this.gatewayURL);
							form.append('admin_username', this.gatewayUser);
							form.append('api_key', this.gatewayKey);
							const resp = await fetch('/admin/developers/ai/test', {
								method: 'POST',
								body: form
							});
							const data = await resp.json();
							this.testResult = data;
						} catch (e) {
							this.testResult = { status: 'error', message: 'تعذر الاتصال بالخادم: ' + e.message };
						} finally {
							this.isTesting = false;
						}
					}
				};
			}

			function adminErrorsManager() {
				return {
					selectedError: null,

					openErrorDetails(id) {
						const script = document.getElementById('err-data-' + id);
						if (!script) return;
						try {
							const raw = script.textContent.trim();
							this.selectedError = JSON.parse(raw);
						} catch (e) {
							console.warn('Error JSON parse fallback for id ' + id + ':', e);
							this.selectedError = {
								id: id,
								error_message: 'تفاصيل الخطأ المسجل #' + id,
								error_level: 'ERROR'
							};
						}
						const modal = document.getElementById('dev-error-modal');
						if (modal && typeof modal.showModal === 'function') modal.showModal();
					}
				};
			}

			function adminAuditManager() {
				return {
					selected: null,

					openDetails(id) {
						const script = document.getElementById('audit-data-' + id);
						if (!script) {
							console.warn('Script element not found: audit-data-' + id);
							return;
						}
						try {
							const raw = script.textContent.trim();
							this.selected = JSON.parse(raw);
						} catch (e) {
							console.warn('Audit JSON parse fallback for id ' + id + ':', e);
							this.selected = {
								id: id,
								title: 'سجل العملية #' + id,
								description: 'تفاصيل العملية مسجلة بالنظام',
								action: 'audit_log',
								action_label_ar: 'سجل تدقيق',
								actor_name: 'مدير المنصة',
								organization_name: 'المنصة الرئيسية'
							};
						}
						const modal = document.getElementById('dev-audit-modal');
						if (modal && typeof modal.showModal === 'function') modal.showModal();
					}
				};
			}
		</script>
	}
}
