package pages

templ VendorSavingScript() {
	<script>
		function openCreateModal() {
			const titleEl = document.getElementById('saving-product-modal-title') || document.getElementById('modal-title');
			if (titleEl) titleEl.textContent = 'إضافة منتج توفير جديد';

			const form = document.getElementById('saving-product-form');
			if (form) form.action = '/vendor/saving-products';

			const idInput = document.getElementById('form-saving-id');
			if (idInput) idInput.value = '';
			const nameInput = document.getElementById('form-name-product');
			if (nameInput) nameInput.value = '';
			const skuInput = document.getElementById('form-sku');
			if (skuInput) skuInput.value = '';
			const qtyInput = document.getElementById('form-qty');
			if (qtyInput) qtyInput.value = '';
			const priceInput = document.getElementById('form-price');
			if (priceInput) priceInput.value = '';

			clearSelectedProduct();

			const el = document.getElementById('saving-product-modal');
			if (el) {
				if (typeof el.showModal === 'function') el.showModal();
				else el.setAttribute('open', '');
			}
		}

		function openEditModalFromRow(id) {
			const row = document.querySelector(`.saving-row[data-id="${id}"]`);
			if (!row) return;

			const titleEl = document.getElementById('saving-product-modal-title') || document.getElementById('modal-title');
			if (titleEl) titleEl.textContent = 'تعديل صنف التوفير وتعيين الربط بالكتالوج';

			const form = document.getElementById('saving-product-form');
			if (form) form.action = `/vendor/saving-products/${id}/update`;

			const idInput = document.getElementById('form-saving-id');
			if (idInput) idInput.value = id;
			const nameInput = document.getElementById('form-name-product');
			if (nameInput) nameInput.value = row.dataset.name || '';
			const skuInput = document.getElementById('form-sku');
			if (skuInput) skuInput.value = row.dataset.sku || '';
			const qtyInput = document.getElementById('form-qty');
			if (qtyInput) qtyInput.value = row.dataset.qty || '';
			const priceInput = document.getElementById('form-price');
			if (priceInput) priceInput.value = row.dataset.price || '';

			const prodId = row.dataset.productId;
			const prodName = row.dataset.productName;
			if (prodId && prodId !== '' && prodId !== '0') {
				selectCatalogProduct(prodId, prodName);
			} else {
				clearSelectedProduct();
				const searchInput = document.getElementById('product-search-input');
				if (searchInput && row.dataset.name) {
					searchInput.value = row.dataset.name;
					searchCatalogProductsLive(row.dataset.name);
				}
			}

			const el = document.getElementById('saving-product-modal');
			if (el) {
				if (typeof el.showModal === 'function') el.showModal();
				else el.setAttribute('open', '');
			}
		}

		function closeCreateModal() {
			const el = document.getElementById('saving-product-modal');
			if (el) {
				if (typeof el.close === 'function') el.close();
				else el.removeAttribute('open');
			}
		}

		function selectCatalogProduct(id, name) {
			const prodIdInput = document.getElementById('form-product-id');
			if (prodIdInput) prodIdInput.value = id;
			const label = document.getElementById('selected-product-label');
			if (label) label.textContent = `${name}`;
			const selectedBox = document.getElementById('selected-product-box');
			if (selectedBox) selectedBox.classList.remove('d-none');
			const searchContainer = document.getElementById('search-product-container');
			if (searchContainer) searchContainer.classList.add('d-none');
			const dropdown = document.getElementById('product-search-dropdown');
			if (dropdown) dropdown.classList.add('d-none');
			const searchInput = document.getElementById('product-search-input');
			if (searchInput) searchInput.value = '';
		}

		function clearSelectedProduct() {
			const prodIdInput = document.getElementById('form-product-id');
			if (prodIdInput) prodIdInput.value = '';
			const label = document.getElementById('selected-product-label');
			if (label) label.textContent = '';
			const selectedBox = document.getElementById('selected-product-box');
			if (selectedBox) selectedBox.classList.add('d-none');
			const searchContainer = document.getElementById('search-product-container');
			if (searchContainer) searchContainer.classList.remove('d-none');
		}

		let searchDebounce = null;
		function searchCatalogProductsLive(query) {
			clearTimeout(searchDebounce);
			const dropdown = document.getElementById('product-search-dropdown');
			if (!dropdown) return;
			if (!query || query.trim().length < 2) {
				dropdown.classList.add('d-none');
				return;
			}

			searchDebounce = setTimeout(() => {
				fetch('/vendor/saving-products/search-products?q=' + encodeURIComponent(query.trim()))
					.then(r => r.json())
					.then(items => {
						if (!items || items.length === 0) {
							dropdown.innerHTML = '<div class="p-3 text-sm text-secondary text-center">لم يتم العثور على نتائج بالكتالوج العام</div>';
							dropdown.classList.remove('d-none');
							return;
						}

						let html = '';
						items.forEach(it => {
							const skuText = it.sku ? (' <code class="text-xs text-secondary">(' + it.sku + ')</code>') : '';
							const safeName = (it.name || '').replace(/'/g, "\\'");
							html += '<div class="d-flex items-center justify-between p-2 rounded cursor-pointer hover-bg-surface border-b" ' +
								'onclick="selectCatalogProduct(\\'' + it.id + '\\', \\'' + safeName + '\\')">' +
								'<div class="stack-xs"><strong class="text-xs text-primary">' + it.name + '</strong>' + skuText + '</div>' +
								'<span class="badge badge-emerald text-xs font-bold">اختيار</span></div>';
						});
						dropdown.innerHTML = html;
						dropdown.classList.remove('d-none');
					})
					.catch(() => {
						dropdown.classList.add('d-none');
					});
			}, 200);
		}

		function getCsrfToken() {
			if (typeof getCookie === 'function') {
				const t = getCookie('dawa_csrf');
				if (t) return t;
			}
			const match = document.cookie.match(/(?:^|;\s*)dawa_csrf=([^;]+)/);
			return match ? decodeURIComponent(match[1]) : '';
		}

		function submitWithCsrf(action, method = 'POST', fields = {}) {
			const form = document.createElement('form');
			form.method = method;
			form.action = action;
			const csrf = getCsrfToken();
			if (csrf) {
				const input = document.createElement('input');
				input.type = 'hidden';
				input.name = '_csrf';
				input.value = csrf;
				form.appendChild(input);
			}
			for (const [k, v] of Object.entries(fields)) {
				const input = document.createElement('input');
				input.type = 'hidden';
				input.name = k;
				input.value = v;
				form.appendChild(input);
			}
			document.body.appendChild(form);
			if (typeof form.requestSubmit === 'function') form.requestSubmit();
			else form.submit();
		}

		function confirmDeleteSavingProduct(id) {
			if (!confirm("هل أنت متأكد من حذف هذا المنتج من قائمة منتجات المساعدة؟")) return;
			submitWithCsrf('/vendor/saving-products/' + id + '/delete');
		}

		function vendorSavingManager() {
			return {
				selectedIds: [],
				toggleSelectAll(el) {
					const rows = document.querySelectorAll('.saving-row');
					const visibleIds = [];
					rows.forEach(r => {
						const isVisible = !r.classList.contains('d-none') && r.style.display !== 'none';
						if (isVisible) {
							const id = r.getAttribute('data-id');
							if (id) visibleIds.push(String(id));
						}
					});
					if (el.checked) {
						const set = new Set(this.selectedIds);
						visibleIds.forEach(id => set.add(id));
						this.selectedIds = Array.from(set);
					} else {
						const removeSet = new Set(visibleIds);
						this.selectedIds = this.selectedIds.filter(id => !removeSet.has(id));
					}
				},
				isAllSelected() {
					const rows = document.querySelectorAll('.saving-row');
					const visibleIds = [];
					rows.forEach(r => {
						const isVisible = !r.classList.contains('d-none') && r.style.display !== 'none';
						if (isVisible) {
							const id = r.getAttribute('data-id');
							if (id) visibleIds.push(String(id));
						}
					});
					if (visibleIds.length === 0) return false;
					return visibleIds.every(id => this.selectedIds.includes(String(id)));
				},
				clearSelection() {
					this.selectedIds = [];
				},
				confirmBulkDelete(e) {
					if (this.selectedIds.length === 0) {
						e.preventDefault();
						return;
					}
					if (!confirm(`هل أنت متأكد من رغبتك في حذف ${this.selectedIds.length} منتج من قائمة المساعدة؟ لا يمكن التراجع عن هذه العملية.`)) {
						e.preventDefault();
						return;
					}
				}
			};
		}

		function openProvidersModal(productId, productName) {
			const subtitleEl = document.getElementById('providers-modal-subtitle');
			if (subtitleEl) subtitleEl.textContent = 'الصنف: ' + productName;
			const contentEl = document.getElementById('providers-modal-content');
			if (contentEl) contentEl.innerHTML = '<div class="text-center text-muted p-6">⏳ جاري استرجاع عروض الموردين والأسعار...</div>';
			
			const el = document.getElementById('providers-modal');
			if (el) {
				if (typeof el.showModal === 'function') el.showModal();
				else el.setAttribute('open', '');
			}

			fetch('/vendor/saving-products/providers/' + productId)
				.then(r => r.json())
				.then(providers => {
					if (!providers || providers.length === 0) {
						if (contentEl) contentEl.innerHTML = '<div class="text-center p-6 text-secondary font-bold">لا توجد منظمات أو موردين آخرين مسجلين لهذا الصنف حالياً في الكتالوج.</div>';
						return;
					}

					let html = '<div class="table-container m-0"><table class="data-table"><thead><tr>' +
						'<th class="text-start">المورد / المنظمة</th>' +
						'<th class="text-start">العبوة / التنويعة</th>' +
						'<th class="text-center">المخزون</th>' +
						'<th class="text-center">سعر الجمهور</th>' +
						'<th class="text-center">نسبة الخصم</th>' +
						'<th class="text-center">السعر بعد الخصم</th>' +
						'</tr></thead><tbody>';

					providers.forEach(p => {
						const branchText = p.branch_name ? ('<div class="text-xs text-muted">' + p.branch_name + '</div>') : '';
						const skuText = p.sku ? ('<code class="text-xs">' + p.sku + '</code>') : '';
						const stockBadge = p.stock_quantity > 0 ? 'badge-emerald' : 'badge-secondary';
						const publicPrice = p.public_price || p.cost_price || p.price;
						const discountPct = p.discount_percentage ? (p.discount_percentage + '%') : (p.discount ? (p.discount + '%') : '0%');
						const netPrice = p.price_after_discount || p.price;

						html += '<tr class="rule-bottom">' +
							'<td class="font-bold text-primary">' + (p.org_name || 'مورد معتمد') + branchText + '</td>' +
							'<td><div class="stack-xs text-sm">' + (p.variant_name || 'العبوة القياسية') + '</div>' + skuText + '</td>' +
							'<td class="text-center tabular-nums"><span class="badge ' + stockBadge + '">' + (p.stock_quantity || 0) + ' عبوة</span></td>' +
							'<td class="text-center tabular-nums">' + (publicPrice ? publicPrice + ' ج.م' : '—') + '</td>' +
							'<td class="text-center tabular-nums"><span class="badge badge-emerald">' + discountPct + '</span></td>' +
							'<td class="text-center tabular-nums"><strong class="text-primary tabular-nums">' + (netPrice ? netPrice + ' ج.م' : '—') + '</strong></td>' +
							'</tr>';
					});

					html += '</tbody></table></div>';
					if (contentEl) contentEl.innerHTML = html;
				})
				.catch(() => {
					if (contentEl) contentEl.innerHTML = '<div class="text-danger text-center p-4">حدث خطأ أثناء تحميل عروض الموردين.</div>';
				});
		}

		function closeProvidersModal() {
			const el = document.getElementById('providers-modal');
			if (el) {
				if (typeof el.close === 'function') el.close();
				else el.removeAttribute('open');
			}
		}

		function filterSavingProductsTable(query) {
			const term = (query || '').trim().toLowerCase();
			const rows = document.querySelectorAll('.saving-row');
			rows.forEach(row => {
				const name = (row.dataset.name || '').toLowerCase();
				const sku = (row.dataset.sku || '').toLowerCase();
				const pName = (row.dataset.productName || '').toLowerCase();
				if (term === '' || name.includes(term) || sku.includes(term) || pName.includes(term)) {
					row.style.display = '';
				} else {
					row.style.display = 'none';
				}
			});
		}

		window.openCreateModal = openCreateModal;
		window.openEditModalFromRow = openEditModalFromRow;
		window.closeCreateModal = closeCreateModal;
		window.selectCatalogProduct = selectCatalogProduct;
		window.clearSelectedProduct = clearSelectedProduct;
		window.searchCatalogProductsLive = searchCatalogProductsLive;
		window.openProvidersModal = openProvidersModal;
		window.closeProvidersModal = closeProvidersModal;
		window.filterSavingProductsTable = filterSavingProductsTable;
	</script>
}
