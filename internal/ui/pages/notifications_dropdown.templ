package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/notifications"
)

// NotificationsDropdownPanel is the bell dropdown content, returned as an
// HTMX partial so the header stays light and the list is always fresh.
templ NotificationsDropdownPanel(logs []*notifications.NotificationLog, unread int) {
	<div style="min-width:360px;">
		<div style="display:flex; justify-content:space-between; align-items:center; padding:0.65rem 1rem; border-bottom:1px solid var(--neutral-100);">
			<span style="font-weight:800; color:var(--neutral-900); font-size:0.9rem;">الإشعارات</span>
			if unread > 0 {
				<span class="badge badge-rose">{ fmt.Sprintf("%d", unread) } غير مقروء</span>
			}
		</div>
		if len(logs) == 0 {
			<div style="padding:1.5rem 1rem; text-align:center; color:var(--neutral-500); font-size:0.85rem;">لا توجد إشعارات بعد.</div>
		} else {
			for _, n := range logs {
				<div style="padding:0.7rem 1rem; border-bottom:1px solid var(--neutral-50); display:flex; gap:0.6rem; align-items:flex-start;">
					if !n.IsRead {
						<span style="width:8px; height:8px; border-radius:50%; background:var(--primary-500); margin-top:0.4rem; flex-shrink:0;"></span>
					} else {
						<span style="width:8px; height:8px; margin-top:0.4rem; flex-shrink:0;"></span>
					}
					<div style="flex:1;">
						<div style="font-weight:700; color:var(--neutral-900); font-size:0.88rem;">{ n.Title }</div>
						<div style="font-size:0.8rem; color:var(--neutral-600);">{ n.Body }</div>
						<div style="font-size:0.72rem; color:var(--neutral-400); margin-top:0.2rem;">{ RelTime(n.CreatedAt) }</div>
					</div>
				</div>
			}
		}
		<div style="display:flex; border-top:1px solid var(--neutral-100);">
			<a href="/notifications" style="flex:1; display:block; text-align:center; padding:0.65rem; font-size:0.85rem; font-weight:600;">عرض كل الإشعارات</a>
			<form method="POST" action="/notifications/read-all" style="margin:0; flex:1;">
				<button type="submit" class="btn btn-secondary btn-sm" style="width:100%; border:none; background:none; color:var(--primary-700);">تعليم الكل كمقروء</button>
			</form>
		</div>
	</div>
}

// NotificationsUnreadBadge is the tiny polled badge on the bell.
templ NotificationsUnreadBadge(unread int) {
	if unread > 0 {
		<span class="badge badge-rose" style="margin-inline-start:0.25rem;">{ fmt.Sprintf("%d", unread) }</span>
	}
}
