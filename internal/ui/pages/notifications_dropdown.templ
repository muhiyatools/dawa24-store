package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/notifications"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// NotificationsDropdownPanel is the bell dropdown content, returned as an
// HTMX partial so the header stays light and the list is always fresh.
templ NotificationsDropdownPanel(logs []*notifications.NotificationLog, unread int) {
	<div class="notification-panel">
		<!-- Header -->
		<div class="notification-header">
			<div class="d-flex items-center gap-2">
				@components.IconBell("icon-xs")
				<span class="notification-title">الإشعارات</span>
			</div>
			if unread > 0 {
				<span class="badge badge-rose text-2xs font-bold tabular-nums">{ fmt.Sprintf("%d غير مقروء", unread) }</span>
			}
		</div>

		<!-- Feed / Content -->
		if len(logs) == 0 {
			<div class="notification-empty">
				<div class="notification-empty-icon">
					@components.IconBell("icon-sm")
				</div>
				<div class="text-xs text-muted font-bold">لا توجد إشعارات جديدة</div>
			</div>
		} else {
			<div class="notification-feed">
				for _, n := range logs {
					<a href="/notifications" class={ "notification-card-row", templ.KV("is-unread", !n.IsRead), templ.KV("is-read", n.IsRead) }>
						<div class={ "notif-card-icon", notifBadgeClass(n.Title, n.IsRead) }>
							@notifIcon(n.Title)
						</div>
						<div class="notif-card-content">
							<div class="notif-card-top">
								<span class={ "notif-card-title", templ.KV("font-black text-primary", !n.IsRead), templ.KV("font-bold text-secondary", n.IsRead) }>{ n.Title }</span>
								<span class="notif-card-time tabular-nums">{ RelTime(n.CreatedAt) }</span>
							</div>
							<div class="notif-card-desc">{ n.Body }</div>
						</div>
						if !n.IsRead {
							<span class="notif-card-dot" title="إشعار غير مقروء"></span>
						}
					</a>
				}
			</div>
		}

		<!-- Footer -->
		<div class="notification-footer">
			<a href="/notifications" class="notification-footer-link">عرض كل الإشعارات ↗</a>
			if unread > 0 {
				<form method="POST" action="/notifications/read-all" hx-post="/notifications/read-all" hx-target="#notif-dropdown-content" hx-swap="innerHTML" class="m-0">
					<button type="submit" class="btn btn-secondary btn-xs font-bold">تعليم الكل كمقروء</button>
				</form>
			}
		</div>
	</div>
}

// NotificationsUnreadBadge is the tiny polled badge on the bell.
templ NotificationsUnreadBadge(unread int) {
	if unread > 0 {
		<span class="notif-badge-pill tabular-nums">
			{ fmt.Sprintf("%d", unread) }
		</span>
	}
}