package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/notifications"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// NotificationsDropdownPanel is the bell dropdown content, returned as an
// HTMX partial so the header stays light and the list is always fresh.
templ NotificationsDropdownPanel(logs []*notifications.NotificationLog, unread int) {
 <div class="stack-sm">
  <div class="stack-sm">
			<div class="row-center-sm">
				@components.IconBell("icon-xs")
				<span>الإشعارات</span>
			</div>
			if unread > 0 {
				<span class="badge badge-rose tabular-nums">{ fmt.Sprintf("%d", unread) } غير مقروء</span>
			}
		</div>

		if len(logs) == 0 {
   <div class="stack-sm">
				<div class="stack-xs text-sm">
					@components.IconBell("icon-sm")
				</div>
				<div class="stack-xs text-sm">لا توجد إشعارات جديدة</div>
			</div>
		} else {
   <div class="stack-sm">
				for _, n := range logs {
     <div class="stack-sm">
						if !n.IsRead {
							<span></span>
						} else {
							<span></span>
						}
						<div class="flex-1">
							<div class="stack-xs text-sm">{ n.Title }</div>
							<div class="stack-xs text-sm">{ n.Body }</div>
							<div class="tabular-nums">{ RelTime(n.CreatedAt) }</div>
						</div>
					</div>
				}
			</div>
		}

  <div class="stack-sm">
			<a href="/notifications">عرض كل الإشعارات</a>
			if unread > 0 {
				<form class="stack-md" method="POST" action="/notifications/read-all" hx-post="/notifications/read-all" hx-target="closest .dropdown-menu">
					<button type="submit" class="btn btn-secondary btn-sm">تعليم الكل كمقروء</button>
				</form>
			}
		</div>
	</div>
}

// NotificationsUnreadBadge is the tiny polled badge on the bell.
templ NotificationsUnreadBadge(unread int) {
	if unread > 0 {
		<span class="badge badge-rose tabular-nums">
			{ fmt.Sprintf("%d", unread) }
		</span>
	}
}
