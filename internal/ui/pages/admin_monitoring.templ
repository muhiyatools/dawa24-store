package pages

import (
	"fmt"

	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminFullErrorLogsPage renders error logs directory.
templ AdminFullErrorLogsPage(logs []*platformadmin.ErrorLog, total int, activeStatus, activeSeverity string, lang, dir string) {
	@layouts.AdminShell("سجلات الأخطاء والتشخيص (Full Error Logs)", "audit", lang, dir) {
		<div class="card" style="margin-bottom:0;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 class="card-title" style="margin:0;">سجلات تشخيص واستثناءات النظام ({ fmt.Sprintf("%d", len(logs)) })</h2>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.2rem;">مراقبة الأخطاء البرمجية، استثناءات قاعدة البيانات، واستجابات 5xx.</p>
				</div>
			</div>

			if len(logs) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد أخطاء مسجلة", Message: "النظام يعمل بكفاءة عالية دون أي استثناءات حالياً."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>#</th>
								<th>الرسالة</th>
								<th>المسار / Route</th>
								<th>مستوى الخطورة</th>
								<th>الحالة</th>
								<th>التاريخ</th>
								<th style="text-align:end;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, l := range logs {
								<tr>
									<td class="tabular-nums">#{ fmt.Sprintf("%d", l.ID) }</td>
									<td><strong>{ l.ErrorMessage }</strong></td>
									<td><code>{ l.URLPath }</code></td>
									<td>
										if l.ErrorLevel == "CRITICAL" || l.ErrorLevel == "ERROR" {
											<span class="badge badge-danger">{ l.ErrorLevel }</span>
										} else {
											<span class="badge badge-warning">{ l.ErrorLevel }</span>
										}
									</td>
									<td><span class="badge badge-sky">{ l.Status }</span></td>
									<td class="tabular-nums">{ l.CreatedAt.Format("2006-01-02 15:04:05") }</td>
									<td style="text-align:end;">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/full-error-logs/%d", l.ID)) } class="btn btn-secondary btn-sm">عرض التفاصيل</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminFullErrorLogDetailPage renders single error log details and transition action.
templ AdminFullErrorLogDetailPage(l *platformadmin.ErrorLog, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل الخطأ #%d", l.ID), "audit", lang, dir) {
		<div class="card" style="max-width:900px; margin:0 auto;">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 class="card-title" style="margin:0;">خطأ #{ fmt.Sprintf("%d", l.ID) }: { l.ErrorMessage }</h2>
					<p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.2rem;">مسار: <code>{ l.URLPath }</code> | خطورة: { l.ErrorLevel }</p>
				</div>
				<a href="/admin/full-error-logs" class="btn btn-secondary btn-sm">العودة للسجلات</a>
			</div>

			<div style="margin-bottom:1.5rem;">
				<h3 style="font-size:0.95rem; font-weight:700; margin-bottom:0.5rem;">Stack Trace:</h3>
				<pre style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-md); overflow-x:auto; font-size:0.8rem;">{ l.StackTrace }</pre>
			</div>

			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/full-error-logs/%d/status", l.ID)) } style="display:flex; justify-content:flex-end; gap:0.75rem;">
				<button type="submit" name="status" value="INVESTIGATING" class="btn btn-secondary">قيد التحقيق</button>
				<button type="submit" name="status" value="RESOLVED" class="btn btn-primary">تم الحل والتسوية</button>
				<button type="submit" name="status" value="IGNORED" class="btn btn-secondary" style="color:var(--text-muted);">تجاهل</button>
			</form>
		</div>
	}
}

// AdminNotificationsPage renders platform notifications oversight.
templ AdminNotificationsPage(lang, dir string) {
	@layouts.AdminShell("إدارة الإشعارات المركزية للمنصة", "audit", lang, dir) {
		<div class="card" style="margin-bottom:0;">
			<h2 class="card-title" style="margin-bottom:1.5rem;">الإشعارات العامة والتنبيهات الموجهة</h2>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد تنبيهات عامة", Message: "يتم بث الإشعارات المركزية للمستخدمين والتطبيقات عند الأحداث الهامة."})
		</div>
	}
}

// AdminSystemResourcesPage renders system health & resource availability.
templ AdminSystemResourcesPage(systemName string, lang, dir string) {
	@layouts.AdminShell("حالة موارد النظام والخدمات", "developer", lang, dir) {
		<div class="card" style="margin-bottom:0;">
			<h2 class="card-title" style="margin-bottom:1.5rem;">موارد النظام وقدرات المنصة ({ systemName })</h2>
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem;">
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md);">
					<div style="font-size:0.85rem; color:var(--text-secondary);">قاعدة البيانات PostgreSQL</div>
					<div style="margin-top:0.5rem;"><span class="badge badge-success">متصل ونشط</span></div>
				</div>
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md);">
					<div style="font-size:0.85rem; color:var(--text-secondary);">بوابة الذكاء الاصطناعي AI Gateway</div>
					<div style="margin-top:0.5rem;"><span class="badge badge-success">جاهز للخدمة</span></div>
				</div>
				<div style="background:var(--surface-sunken); padding:1.25rem; border-radius:var(--radius-md);">
					<div style="font-size:0.85rem; color:var(--text-secondary);">نظام التخزين Storage S3/Local</div>
					<div style="margin-top:0.5rem;"><span class="badge badge-success">يعمل بكفاءة</span></div>
				</div>
			</div>
		</div>
	}
}

// AdminFirstLookPage renders admin onboarding walkthrough.
templ AdminFirstLookPage(lang, dir string) {
	@layouts.AdminShell("جولة في لوحة التحكم (First Look)", "dashboard", lang, dir) {
		<div class="card" style="max-width:800px; margin:0 auto;">
			<h2 class="card-title" style="margin-bottom:0.75rem;">مرحباً بك في لوحة تحكم منصة دواء 24</h2>
			<p style="font-size:0.95rem; line-height:1.6; color:var(--text-secondary); margin-bottom:1.5rem;">
				تم بناء المنصة بأعلى معايير الأداء والسرعة في Go مع واجهات سريعة وتجربة مستخدم مخصصة لإدارة العمليات الصيدلانية وشبكات التوريد بدقة كاملة.
			</p>
			<a href="/admin/dashboard" class="btn btn-primary">الانتقال للرئيسية</a>
		</div>
	}
}
