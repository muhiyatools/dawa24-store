package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/smartorder"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// SmartOrderBranch is a delivery branch offered on the import screen.
type SmartOrderBranch struct {
	ID     int64
	Name   string
	City   string
	IsMain bool
}

// SmartOrderNewData is everything the import screen needs.
type SmartOrderNewData struct {
	Branches []SmartOrderBranch
	Profile  *smartorder.Profile
	// AIAvailable is false when the Gateway is unreachable, has no adjudication
	// model configured, or the organisation has no virtual key. The toggle then
	// renders disabled with a reason rather than enabled-but-broken.
	AIAvailable         bool
	AIUnavailableReason string

	// Error is why the previous attempt was refused. Rendered at the top of the
	// form, because the buyer needs to know what to change before they try the
	// same thing again.
	Error string
}

// SmartOrderNewPage is step 1: upload and configuration.
templ SmartOrderNewPage(lang, dir string, data SmartOrderNewData) {
	@layouts.CustomerShell("الطلب الذكي", "purchase-request", lang, dir, nil) {
		<div class="page-container max-w-4xl so-new-order-page">
			<h1 class="so-page-title">الطلب الذكي، استيراد ملف</h1>
			@WizardRail(OrderRail(StepFile))
			if data.Error != "" {
				<div class="so-alert so-alert-error">
					{ data.Error }
				</div>
			}
			<form method="POST" action="/customer/smart-order" enctype="multipart/form-data" class="glass-panel p-6 mb-0 so-new-order-form">
				<div class="so-form-field">
					<label class="so-field-label">ملف الأصناف المطلوبة</label>
					<input type="file" name="file" accept=".xlsx,.xls,.csv" required class="so-file-input"/>
					<p class="so-help-text">
						الصيغ المدعومة: xlsx، xls، csv — بدون حد لعدد الأصناف.
					</p>
				</div>

				<div class="so-form-field">
					<label class="so-field-label">فرع التسليم</label>
					<select name="branch_id" required class="form-select">
						for _, b := range data.Branches {
							<option value={ fmt.Sprintf("%d", b.ID) } selected?={ b.IsMain }>
								{ b.Name }
								if b.City != "" {
									{ " — " + b.City }
								}
							</option>
						}
					</select>
					<p class="so-help-text">
						موقع الفرع هو ما تُقاس عليه تغطية الموردين، وهو عنوان تسليم الطلب.
					</p>
				</div>

				<fieldset class="so-criteria-fieldset">
					<legend class="so-field-label">معايير اختيار الموردين</legend>
					<p class="so-help-text so-criteria-help">
						رتّب المعايير حسب الأولوية. المعيار الأعلى يقرر، بشرط ألا يتجاوز المورد نطاق التسامح فوق أقل سعر صافٍ.
					</p>
					for i, c := range []struct{ Key, Label string }{
						{"followed_suppliers", "الموردون المتابَعون"},
						{"highest_discount", "أعلى خصم"},
						{"lowest_price", "أقل سعر"},
					} {
						<label class="so-criteria-row">
							<input type="checkbox" name="criteria" value={ c.Key } checked/>
							<span class="so-criteria-label">{ c.Label }</span>
							<input type="number" name={ "priority_" + c.Key } value={ fmt.Sprintf("%d", i+1) } min="1" max="3" class="so-priority-input"/>
						</label>
					}
					<div class="so-tolerance-field">
						<label class="so-subfield-label">نطاق التسامح (%)</label>
						<input type="number" name="tolerance_pct" value="5" min="0" max="100" step="0.5" class="so-tolerance-input"/>
						<p class="so-help-text so-help-text-small">
							مورد متابَع أغلى من أرخص عرض بأكثر من هذه النسبة يُستبعَد، ويُذكر ذلك في نتيجة الصنف.
						</p>
					</div>
				</fieldset>

				<div class="so-form-grid">
					<div class="so-form-field">
						<label class="so-subfield-label">الكمية الافتراضية</label>
						<input type="number" name="default_quantity" value="0" min="0" class="form-control"/>
						<p class="so-help-text so-help-text-small">
							تُطبَّق فقط على الصفوف التي لا تحمل كمية في الملف.
						</p>
					</div>
					<div class="so-form-field">
						<label class="so-subfield-label">أقل نسبة مطابقة (%)</label>
						<input type="number" name="min_match_score" value="50" min="25" max="100" class="form-control"/>
						<p class="so-help-text so-help-text-small">
							المطابقة بالاسم أولاً ثم الذكاء الاصطناعي. ما دون هذه النسبة لا يُعرض ولا يُراجَع.
						</p>
					</div>
					<div class="so-form-field">
						<label class="so-subfield-label">الحد الأقصى للميزانية (اختياري)</label>
						<input type="text" name="max_budget" inputmode="decimal" placeholder="مثال: 150000.00" class="form-control"/>
						<p class="so-help-text so-help-text-small">
							للعرض فقط: لا يمنع الطلب ولا يحذف أي صنف.
						</p>
					</div>
				</div>

				<div class="so-options">
					<label class="so-option-row">
						<input type="checkbox" name="use_saving_products" checked?={ data.Profile != nil && data.Profile.UseSavingProducts }/>
						<span>استخدام منتجات التوفير في المطابقة</span>
					</label>
					<label class="so-option-row">
						<input type="checkbox" name="use_ai_matching" disabled?={ !data.AIAvailable } checked?={ data.AIAvailable && (data.Profile == nil || data.Profile.UseAIMatching) }/>
						<span>تفعيل مطابقة الذكاء الاصطناعي</span>
					</label>
					if !data.AIAvailable {
						<p class="so-option-warning">
							{ data.AIUnavailableReason }
						</p>
					}
				</div>

				<button type="submit" class="btn btn-primary so-new-order-submit">
					<span>رفع الملف والمتابعة</span>
					@components.IconArrowLeft("icon-xs")
				</button>
			</form>
		</div>
	}
}
