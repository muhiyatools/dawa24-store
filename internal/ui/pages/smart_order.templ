package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/smartorder"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// SmartOrderBranch is a delivery branch offered on the import screen.
type SmartOrderBranch struct {
	ID     int64
	Name   string
	City   string
	IsMain bool
}

// SmartOrderNewData is everything the import screen needs.
type SmartOrderNewData struct {
	Branches []SmartOrderBranch
	Profile  *smartorder.Profile
	// AIAvailable is false when the Gateway is unreachable, has no adjudication
	// model configured, or the organisation has no virtual key. The toggle then
	// renders disabled with a reason rather than enabled-but-broken.
	AIAvailable         bool
	AIUnavailableReason string

	// Error is why the previous attempt was refused. Rendered at the top of the
	// form, because the buyer needs to know what to change before they try the
	// same thing again.
	Error string
}

// stepBar renders the five-step indicator.
templ stepBar(current int) {
	<div style="display:flex; gap:0.5rem; margin-bottom:2rem; flex-wrap:wrap;">
		for i, label := range []string{"استيراد الملف", "تعيين الأعمدة", "المطابقة", "النتائج", "مراجعة الطلب"} {
			<div style={ stepStyle(i+1, current) }>
				<span style="font-weight:700;">{ fmt.Sprintf("%d", i+1) }</span>
				<span>{ label }</span>
			</div>
		}
	</div>
}

func stepStyle(step, current int) string {
	base := "flex:1; min-width:130px; display:flex; align-items:center; gap:0.5rem; padding:0.65rem 0.9rem; border-radius:var(--radius-lg); font-size:0.85rem; border:1px solid var(--border);"
	switch {
	case step < current:
		return base + "background:rgba(16,185,129,0.10); color:var(--primary-700); border-color:var(--primary-600);"
	case step == current:
		return base + "background:var(--primary-600); color:#fff; border-color:var(--primary-600); font-weight:700;"
	default:
		return base + "background:var(--surface-sunken); color:var(--text-secondary);"
	}
}

// SmartOrderNewPage is step 1: upload and configuration.
templ SmartOrderNewPage(lang, dir string, data SmartOrderNewData) {
	@layouts.CustomerShell("الطلب الذكي", "purchase-request", lang, dir, nil) {
		<div class="container-fluid" style="max-width:1000px; margin:0 auto; padding:1.5rem 1rem;">
			<h1 style="font-size:1.6rem; font-weight:800; margin:0 0 1.5rem 0;">الطلب الذكي — استيراد ملف</h1>
			@stepBar(1)
			if data.Error != "" {
				<div style="padding:1rem 1.25rem; border-radius:var(--radius-lg); background:rgba(239,68,68,0.10); border:1px solid var(--danger); margin-bottom:1.5rem; font-weight:600;">
					{ data.Error }
				</div>
			}
			<form method="POST" action="/customer/smart-order" enctype="multipart/form-data" class="card" style="padding:2rem; display:grid; gap:1.75rem;">
				<div>
					<label style="display:block; font-weight:700; margin-bottom:0.5rem;">ملف الأصناف المطلوبة</label>
					<input type="file" name="file" accept=".xlsx,.xls,.csv" required style="width:100%; padding:0.75rem; border:1px dashed var(--border); border-radius:var(--radius-lg);"/>
					<p style="color:var(--text-secondary); font-size:0.85rem; margin:0.5rem 0 0 0;">
						الصيغ المدعومة: xlsx، xls، csv — بدون حد لعدد الأصناف.
					</p>
				</div>

				<div>
					<label style="display:block; font-weight:700; margin-bottom:0.5rem;">فرع التسليم</label>
					<select name="branch_id" required style="width:100%; padding:0.65rem; border:1px solid var(--border); border-radius:var(--radius-lg);">
						for _, b := range data.Branches {
							<option value={ fmt.Sprintf("%d", b.ID) } selected?={ b.IsMain }>
								{ b.Name }
								if b.City != "" {
									{ " — " + b.City }
								}
							</option>
						}
					</select>
					<p style="color:var(--text-secondary); font-size:0.85rem; margin:0.5rem 0 0 0;">
						موقع الفرع هو ما تُقاس عليه تغطية الموردين، وهو عنوان تسليم الطلب.
					</p>
				</div>

				<fieldset style="border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem;">
					<legend style="font-weight:700; padding:0 0.5rem;">معايير اختيار الموردين</legend>
					<p style="color:var(--text-secondary); font-size:0.85rem; margin:0 0 1rem 0;">
						رتّب المعايير حسب الأولوية. المعيار الأعلى يقرر، بشرط ألا يتجاوز المورد نطاق التسامح فوق أقل سعر صافٍ.
					</p>
					for i, c := range []struct{ Key, Label string }{
						{"followed_suppliers", "الموردون المتابَعون"},
						{"highest_discount", "أعلى خصم"},
						{"lowest_price", "أقل سعر"},
					} {
						<label style="display:flex; align-items:center; gap:0.75rem; padding:0.5rem 0;">
							<input type="checkbox" name="criteria" value={ c.Key } checked/>
							<span style="flex:1;">{ c.Label }</span>
							<input type="number" name={ "priority_" + c.Key } value={ fmt.Sprintf("%d", i+1) } min="1" max="3" style="width:70px; padding:0.4rem; border:1px solid var(--border); border-radius:var(--radius-md);"/>
						</label>
					}
					<div style="margin-top:1rem;">
						<label style="display:block; font-weight:600; margin-bottom:0.4rem;">نطاق التسامح (%)</label>
						<input type="number" name="tolerance_pct" value="5" min="0" max="100" step="0.5" style="width:120px; padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius-md);"/>
						<p style="color:var(--text-secondary); font-size:0.8rem; margin:0.35rem 0 0 0;">
							مورد متابَع أغلى من أرخص عرض بأكثر من هذه النسبة يُستبعَد، ويُذكر ذلك في نتيجة الصنف.
						</p>
					</div>
				</fieldset>

				<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1.25rem;">
					<div>
						<label style="display:block; font-weight:700; margin-bottom:0.4rem;">الكمية الافتراضية</label>
						<input type="number" name="default_quantity" value="0" min="0" style="width:100%; padding:0.6rem; border:1px solid var(--border); border-radius:var(--radius-lg);"/>
						<p style="color:var(--text-secondary); font-size:0.8rem; margin:0.35rem 0 0 0;">
							تُطبَّق فقط على الصفوف التي لا تحمل كمية في الملف.
						</p>
					</div>
					<div>
						<label style="display:block; font-weight:700; margin-bottom:0.4rem;">الحد الأقصى للميزانية (اختياري)</label>
						<input type="text" name="max_budget" inputmode="decimal" placeholder="مثال: 150000.00" style="width:100%; padding:0.6rem; border:1px solid var(--border); border-radius:var(--radius-lg);"/>
						<p style="color:var(--text-secondary); font-size:0.8rem; margin:0.35rem 0 0 0;">
							للعرض فقط: لا يمنع الطلب ولا يحذف أي صنف.
						</p>
					</div>
				</div>

				<div style="display:grid; gap:0.75rem;">
					<label style="display:flex; align-items:center; gap:0.75rem;">
						<input type="checkbox" name="use_saving_products" checked?={ data.Profile != nil && data.Profile.UseSavingProducts }/>
						<span>استخدام منتجات التوفير في المطابقة</span>
					</label>
					<label style="display:flex; align-items:center; gap:0.75rem;">
						<input type="checkbox" name="use_ai_matching" disabled?={ !data.AIAvailable } checked?={ data.AIAvailable && (data.Profile == nil || data.Profile.UseAIMatching) }/>
						<span>تحسين المطابقة بالذكاء الاصطناعي للأصناف غير المؤكدة</span>
					</label>
					<p style="color:var(--text-secondary); font-size:0.85rem; margin:-0.35rem 0 0 0; padding-inline-start:1.9rem;">
						تعمل المطابقة العادية أولاً، ثم يراجع الذكاء الاصطناعي فقط الأصناف غير المطابقة أو التي تحتاج مراجعة. لن تظهر النتائج قبل انتهاء المرحلتين.
					</p>
					if !data.AIAvailable {
						<p style="color:var(--warning); font-size:0.85rem; margin:0; padding-inline-start:1.9rem;">
							{ data.AIUnavailableReason }
						</p>
					}
				</div>

				<button type="submit" class="btn btn-primary" style="justify-content:center; font-weight:700; padding:0.85rem;">
					<span>رفع الملف والمتابعة</span>
					@components.IconArrowLeft("icon-xs")
				</button>
			</form>
		</div>
	}
}
