package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ ContactPage(lang, dir string, submitted bool) {
	@layouts.PublicShell("تواصل معنا | خدمة العملاء والدعم الفني", lang, dir) {
		<div class="contact-page-container">
			
			<!-- Page Header -->
			<div>
				<div>
					@components.IconPhone("icon-xs")
					<span>مركز التواصل وخدمة الشركاء</span>
				</div>
				<h1>
					تواصل مع فريق دواء 24
				</h1>
				<p>
					فريق الدعم الفني والخدمات الصيدلانية متاح للإجابة على استفسارات الصيدليات والموردين على مدار الساعة.
				</p>
			</div>

			if submitted {
				<div>
					@components.IconCheckCircle("icon-md")
					<div>
						<strong>تم إرسال رسالتك بنجاح!</strong>
						<span class="text-sm text-secondary">سيتواصل معك ممثل خدمة العملاء المختص خلال أقرب وقت ممكن.</span>
					</div>
				</div>
			}

			<div>
				
				<!-- Left: Direct Contact Channels & Headquarters Info -->
				<div class="stack-lg">
					
					<!-- Direct Hotline Card -->
					<div class="card mb-0">
						<div>
							<div>
								@components.IconPhone("icon-sm")
							</div>
							<div>
								<div>الخط الساخن للمبيعات والطلبيات</div>
								<a href="tel:01065397000" class="tabular-nums">
									01065397000
								</a>
							</div>
						</div>

						<div>
							<div>
								@components.IconWhatsApp("icon-sm")
							</div>
							<div class="flex-1">
								<div>محادثة واتساب للطلبيات العاجلة</div>
								<a href="https://wa.me/201065397000" target="_blank" rel="noopener">
									تحدث مباشرة مع مسؤول التوزيع ←
								</a>
							</div>
						</div>
					</div>

					<!-- Email & Support Hours Card -->
					<div class="card mb-0">
						<div>
							<div>
								@components.IconMail("icon-xs")
							</div>
							<div>
								<div>البريد الإلكتروني المعتمد</div>
								<a href="mailto:support@dawa24.com">
									support@dawa24.com
								</a>
							</div>
						</div>

						<div>
							<div>
								@components.IconBuilding("icon-xs")
							</div>
							<div>
								<div>المقر الرئيسي</div>
								<div>
									القاهرة، جمهورية مصر العربية
								</div>
							</div>
						</div>

						<div>
							<div>
								@components.IconClock("icon-xs")
							</div>
							<div>
								<div>ساعات العمل والدعم</div>
								<div>
									الدعم الفني متاح 24/7 للصيدليات والمخازن
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Right: Contact Form Card -->
				<div class="card mb-0">
					<h3>
						أرسل استفسارك أو طلبك
					</h3>

					<form method="POST" action="/contact" class="stack-md">
						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label" for="c-name">الاسم بالكامل *</label>
								<input type="text" id="c-name" name="name" required class="form-input" placeholder="د. أحمد محمود" />
							</div>
							<div class="form-group mb-0">
								<label class="form-label" for="c-email">البريد الإلكتروني *</label>
								<input type="email" id="c-email" name="email" required class="form-input tabular-nums" placeholder="name@pharmacy.com" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label" for="c-phone">رقم الهاتف / الواتساب *</label>
								<input type="tel" id="c-phone" name="phone" required class="form-input tabular-nums" placeholder="01012345678" />
							</div>
							<div class="form-group mb-0">
								<label class="form-label" for="c-subject">نوع الاستفسار *</label>
								<select id="c-subject" name="subject" required class="form-select">
									<option value="استفسار عن طلبية أو توريد">استفسار عن طلبية أو توريد</option>
									<option value="طلب انضمام صيدلية">طلب انضمام صيدلية جديدة</option>
									<option value="طلب انضمام مورد أو شركة">طلب انضمام مورد أو شركة أدوية</option>
									<option value="استفسار عن الفواتير والمدفوعات">استفسار عن الفواتير والمدفوعات</option>
									<option value="دعم فني واقتراحات">دعم فني واقتراحات تطويرية</option>
								</select>
							</div>
						</div>

						<div class="form-group mb-0">
							<label class="form-label" for="c-message">نص الرسالة أو الاستفسار *</label>
							<textarea id="c-message" name="message" required rows="4" placeholder="اكتب تفاصيل طلبك أو استفسارك هنا..." class="form-textarea"></textarea>
						</div>

						<button type="submit" class="btn btn-primary">
							@components.IconCheck("icon-xs")
							<span>إرسال الرسالة الآن</span>
						</button>
					</form>
				</div>
			</div>
		</div>
	}
}

