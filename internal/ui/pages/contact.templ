package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ ContactPage(lang, dir string, submitted bool) {
	@layouts.PublicShell("تواصل معنا | خدمة العملاء والدعم الفني", lang, dir) {
		<div class="contact-page-container">
			
			<!-- Page Hero Banner -->
			<div class="contact-hero-card">
				<div class="contact-hero-badge">
					@components.IconPhone("icon-xs")
					<span>مركز التواصل وخدمة الشركاء</span>
				</div>
				<h1 class="page-title font-black text-2xl m-0">
					تواصل مع فريق دواء 24
				</h1>
				<p class="text-sm text-secondary m-0 max-w-xl text-center leading-relaxed">
					فريق الدعم الفني والخدمات الصيدلانية متاح للإجابة على استفسارات الصيدليات والموردين والمستودعات على مدار الساعة.
				</p>
			</div>

			if submitted {
				<div class="alert alert-success d-flex items-center gap-3 p-4 rounded-xl">
					@components.IconCheckCircle("icon-md text-success")
					<div class="d-flex flex-col gap-1">
						<strong class="font-bold text-sm">تم إرسال رسالتك بنجاح!</strong>
						<span class="text-xs text-secondary">سيتواصل معك ممثل خدمة العملاء المختص خلال أقرب وقت ممكن.</span>
					</div>
				</div>
			}

			<!-- Main 2-Column Contact Grid -->
			<div class="contact-layout-grid">
				
				<!-- Left Column: Direct Communication Channels -->
				<div class="contact-channels-column">
					
					<!-- Direct Hotline & WhatsApp Card -->
					<div class="contact-card">
						<div class="contact-item-row">
							<div class="contact-icon-box">
								@components.IconPhone("icon-sm")
							</div>
							<div class="contact-item-content">
								<span class="contact-item-label">الخط الساخن للمبيعات والطلبيات</span>
								<a href="tel:01065397000" class="contact-item-val tabular-nums">
									01065397000
								</a>
								<span class="text-2xs text-muted">متاح يومياً للرد على كافة الاستفسارات</span>
							</div>
						</div>

						<div class="contact-item-row">
							<div class="contact-icon-box whatsapp">
								@components.IconWhatsApp("icon-sm")
							</div>
							<div class="contact-item-content">
								<span class="contact-item-label">محادثة واتساب للطلبيات العاجلة</span>
								<a href="https://wa.me/201065397000" target="_blank" rel="noopener" class="contact-item-val text-xs text-brand">
									تحدث مباشرة مع مسؤول التوزيع ←
								</a>
								<span class="text-2xs text-muted">رد فوري للصيدليات والطلبيات الطارئة</span>
							</div>
						</div>
					</div>

					<!-- Headquarters & Email Card -->
					<div class="contact-card">
						<div class="contact-item-row">
							<div class="contact-icon-box">
								@components.IconMail("icon-sm")
							</div>
							<div class="contact-item-content">
								<span class="contact-item-label">البريد الإلكتروني المعتمد</span>
								<a href="mailto:support@dawa24.com" class="contact-item-val font-mono text-xs" dir="ltr">
									support@dawa24.com
								</a>
							</div>
						</div>

						<div class="contact-item-row">
							<div class="contact-icon-box">
								@components.IconBuilding("icon-sm")
							</div>
							<div class="contact-item-content">
								<span class="contact-item-label">المقر الرئيسي للشركة</span>
								<span class="contact-item-val text-xs">
									القاهرة، جمهورية مصر العربية
								</span>
							</div>
						</div>

						<div class="contact-item-row">
							<div class="contact-icon-box">
								@components.IconClock("icon-sm")
							</div>
							<div class="contact-item-content">
								<span class="contact-item-label">ساعات العمل والدعم</span>
								<span class="contact-item-val text-xs">
									الدعم الفني متاح 24/7 للصيدليات والمخازن
								</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Right Column: Contact & Inquiry Form Card -->
				<div class="contact-form-card">
					<div class="pb-3 border-b">
						<h3 class="font-black text-lg text-primary m-0">
							أرسل استفسارك أو طلبك
						</h3>
						<p class="text-xs text-secondary m-0 mt-1">يرجى ملء البيانات وسيقوم الفريق التجاري أو التقني بالرد عليك فوراً</p>
					</div>

					<form method="POST" action="/contact" class="d-flex flex-col gap-4 m-0">
						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold" for="c-name">الاسم بالكامل *</label>
								<input type="text" id="c-name" name="name" required class="form-input text-xs" placeholder="د. أحمد محمود" />
							</div>
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold" for="c-email">البريد الإلكتروني *</label>
								<input type="email" id="c-email" name="email" required class="form-input text-xs tabular-nums" placeholder="name@pharmacy.com" dir="ltr" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold" for="c-phone">رقم الهاتف / الواتساب *</label>
								<input type="tel" id="c-phone" name="phone" required class="form-input text-xs tabular-nums" placeholder="01012345678" dir="ltr" />
							</div>
							<div class="form-group mb-0">
								<label class="form-label text-xs font-bold" for="c-subject">نوع الاستفسار *</label>
								<select id="c-subject" name="subject" required class="form-select text-xs">
									<option value="استفسار عن طلبية أو توريد">استفسار عن طلبية أو توريد</option>
									<option value="طلب انضمام صيدلية">طلب انضمام صيدلية جديدة</option>
									<option value="طلب انضمام مورد أو شركة">طلب انضمام مورد أو شركة أدوية</option>
									<option value="استفسار عن الفواتير والمدفوعات">استفسار عن الفواتير والمدفوعات</option>
									<option value="دعم فني واقتراحات">دعم فني واقتراحات تطويرية</option>
								</select>
							</div>
						</div>

						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold" for="c-message">نص الرسالة أو الاستفسار *</label>
							<textarea id="c-message" name="message" required rows="5" placeholder="اكتب تفاصيل طلبك أو استفسارك هنا..." class="form-textarea text-xs leading-relaxed"></textarea>
						</div>

						<div class="d-flex justify-end pt-2">
							<button type="submit" class="btn btn-primary font-bold text-xs gap-2">
								@components.IconCheck("icon-xs")
								<span>إرسال الرسالة الآن</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}