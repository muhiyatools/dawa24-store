package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorOrganizationPage(lang, dir string, profile *org.SupplierOrgProfile, pendingReq *org.OrganizationChangeRequest, history []*org.OrganizationChangeRequest, noticeType, noticeMsg string) {
	@layouts.VendorShell("بيانات المنشأة والهوية التجارية | دواء 24", "organization", lang, dir) {
		<div class="page-container max-w-6xl">
			
			<!-- Notice Toast -->
			if noticeMsg != "" {
				if noticeType == "error" {
					<div class="alert alert-danger mb-0">
						<span class="text-xl">@components.IconAlert("icon-sm")</span>
						<span>{ noticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success mb-0">
						<span class="text-xl">@components.IconCheckCircle("icon-sm")</span>
						<span>{ noticeMsg }</span>
					</div>
				}
			}

			<!-- Pending Change Request Banner -->
			if pendingReq != nil {
				<div class="alert alert-warning mb-0 border rounded-xl p-4">
					<div class="d-flex items-start gap-3">
						<span class="text-2xl text-amber">@components.IconClock("icon-md")</span>
						<div class="flex-1 min-w-0">
							<div class="flex-between items-center flex-wrap gap-2 mb-1">
								<strong class="text-primary font-bold text-base">يوجد طلب تعديل بيانات قيد المراجعة والتدقيق</strong>
								<span class="badge badge-amber font-bold">طلب #{ fmt.Sprintf("%d", pendingReq.ID) }</span>
							</div>
							<p class="text-xs text-secondary leading-relaxed m-0">
								البيانات المعروضة أدناه هي البيانات المعتمدة حالياً في النظام. تم تقديم طلب تعديل جديد بتاريخ <span class="font-bold tabular-nums">{ FormatDateTime(pendingReq.CreatedAt) }</span>، وهو قيد المراجعة من قبل إدارة المنصة. في حال إرسال تعديلات جديدة سيتم تحديث الطلب المعلق.
							</p>
							if len(pendingReq.ChangedFieldLabels()) > 0 {
								<div class="d-flex items-center gap-1.5 flex-wrap mt-2 pt-2 border-t border-amber-subtle">
									<span class="text-xs text-muted font-bold">الحقول قيد التعديل:</span>
									for _, lbl := range pendingReq.ChangedFieldLabels() {
										<span class="badge badge-amber text-xs font-bold">{ lbl }</span>
									}
								</div>
							}
						</div>
					</div>
				</div>
			}

			<!-- Top Banner -->
			<div class="glass-panel p-6 mb-0">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconBuilding("icon-sm")
						</div>
						<div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">
								بيانات المنشأة والهوية التجارية
							</h1>
							<p class="text-sm text-secondary m-0 mt-1">
								تعديل الاسم التجاري، حدود أسعار الطلبات، أرقام التواصل والتراخيص، والشعار الرسمي للمنشأة.
							</p>
						</div>
					</div>
					if profile.ID > 0 {
						<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", profile.ID)) } target="_blank" class="btn btn-secondary font-bold gap-2">
							@components.IconGlobe("icon-xs")
							<span>عرض الصفحة العامة للمورد </span>
						</a>
					}
				</div>
			</div>

			<!-- Main Form -->
			<form method="POST" action="/vendor/organization" enctype="multipart/form-data" class="glass-panel p-6 mb-0 d-flex flex-col gap-6">
				
				<!-- 1. Identity Section -->
				<div class="d-flex flex-col gap-4">
					<div class="d-flex items-center gap-3 pb-3 border-b">
						<div class="user-avatar-badge">
							@components.IconBuilding("icon-sm")
						</div>
						<div>
							<h3 class="text-base font-extrabold text-primary m-0">
								البيانات الأساسية والهوية
							</h3>
							<p class="text-xs text-muted m-0">الاسم الرسمي للمؤسسة والتصنيف التجاري</p>
						</div>
					</div>

					<div class="d-grid grid-cols-3 gap-4">
						<div>
							<label class="form-label">
								اسم المؤسسة بالعربية <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								name="name_ar"
								value={ profile.NameAr }
								required
								class="form-input"
								placeholder="مثال: سمارت كودز لتوزيع الأدوية"
							/>
						</div>

						<div>
							<label class="form-label">
								اسم المؤسسة بالإنجليزية <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								name="name_en"
								value={ profile.NameEn }
								required
								class="form-input"
								placeholder="Example: Smart Codes Pharma Distribution"
							/>
						</div>

						<div>
							<label class="form-label">
								النوع / التصنيف <span class="text-danger">*</span>
							</label>
							<select name="type" class="form-select">
								<option value="supplier" selected?={ profile.Type == "supplier" || profile.Type == "vendor" }>مورد (Supplier)</option>
								<option value="company" selected?={ profile.Type == "company" }>شركة توزيع (Company)</option>
								<option value="agency" selected?={ profile.Type == "agency" }>وكالة / مستورد (Agency)</option>
							</select>
						</div>
					</div>
				</div>

				<!-- 2. Order Price Limits Section -->
				<div class="glass-panel p-5 mb-0 d-flex flex-col gap-4 border">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-lg">
							@components.IconWallet("icon-sm")
						</div>
						<div>
							<h3 class="text-base font-extrabold text-primary m-0">
								إعدادات الحد الأدنى والأقصى لسعر الطلب
							</h3>
							<p class="text-xs text-muted m-0 mt-1">
								تحديد القيود المالية لقيمة الطلبات المسموح بها لهذه المنظمة
							</p>
						</div>
					</div>

					<div class="d-grid grid-cols-2 gap-4">
						<div>
							<label class="form-label">
								الحد الأدنى لسعر الطلب <span class="text-danger">*</span>
							</label>
							<div class="position-relative d-flex items-center">
								<input
									type="number"
									step="0.01"
									min="0"
									name="min_order_price"
									value={ profile.MinOrderPrice.String() }
									required
									class="form-input font-bold tabular-nums"
									placeholder="10.00"
								/>
							</div>
						</div>

						<div>
							<label class="form-label">
								الحد الأقصى لسعر الطلب <span class="text-danger">*</span>
							</label>
							<div class="position-relative d-flex items-center">
								<input
									type="number"
									step="0.01"
									min="0"
									name="max_order_price"
									value={ profile.MaxOrderPrice.String() }
									required
									class="form-input font-bold tabular-nums"
									placeholder="50.00"
								/>
							</div>
						</div>
					</div>
				</div>

				<!-- 3. Contact & Location Section -->
				<div class="d-flex flex-col gap-4">
					<div class="d-flex items-center gap-3 pb-3 border-b">
						<div class="user-avatar-badge">
							@components.IconPhone("icon-sm")
						</div>
						<div>
							<h3 class="text-base font-extrabold text-primary m-0">
								معلومات الاتصال والضرائب
							</h3>
							<p class="text-xs text-muted m-0">بيانات التواصل الرسمي والعنوان والرقم الضريبي</p>
						</div>
					</div>

					<div class="d-grid grid-cols-3 gap-4">
						<div>
							<label class="form-label">
								رقم المنظمة
							</label>
							<input
								type="text"
								name="organization_number"
								value={ profile.OrganizationNumber }
								class="form-input"
								placeholder="مثال: 267244"
							/>
						</div>

						<div>
							<label class="form-label">
								البريد الإلكتروني
							</label>
							<input
								type="email"
								name="email"
								value={ profile.Email }
								class="form-input"
								placeholder="info@smartcodes.com"
							/>
						</div>

						<div>
							<label class="form-label">
								رقم الهاتف
							</label>
							<input
								type="text"
								name="phone"
								value={ profile.Phone }
								class="form-input"
								placeholder="01099887766"
							/>
						</div>

						<div>
							<label class="form-label">
								الرقم الضريبي
							</label>
							<input
								type="text"
								name="tax_number"
								value={ profile.TaxNumber }
								class="form-input"
								placeholder="TX431256"
							/>
						</div>

						<div class="col-span-2">
							<label class="form-label">
								العنوان الرئيسي
							</label>
							<input
								type="text"
								name="address"
								value={ profile.Address }
								class="form-input"
								placeholder="الجيزة، مصر"
							/>
						</div>
					</div>
				</div>

				<!-- 4. Description, Logo & Cover Section -->
				<div class="d-flex flex-col gap-4">
					<div class="d-flex items-center gap-3 pb-3 border-b">
						<div class="user-avatar-badge">
							@components.IconEdit("icon-sm")
						</div>
						<div>
							<h3 class="text-base font-extrabold text-primary m-0">
								الوصف والشعار وصورة الغلاف
							</h3>
							<p class="text-xs text-muted m-0">نبذة عن المورد وصور الهوية البصرية المعروضة للعملاء</p>
						</div>
					</div>

					<div class="d-grid grid-cols-2 gap-4">
						<div>
							<label class="form-label">
								الوصف (بالعربية)
							</label>
							<textarea
								name="description_ar"
								rows="3"
								class="form-input"
								placeholder="شركة متخصصة في توزيع وتوريد الأدوية والمستلزمات الطبية..."
							>{ profile.DescriptionAr }</textarea>
						</div>

						<div>
							<label class="form-label">
								الوصف (بالإنجليزية)
							</label>
							<textarea
								name="description_en"
								rows="3"
								class="form-input"
								placeholder="Specialized company in pharmaceutical and healthcare distribution..."
							>{ profile.DescriptionEn }</textarea>
						</div>
					</div>

					<!-- Logo & Cover Upload Row -->
					<div class="d-grid grid-cols-2 gap-4 mt-2">
						
						<!-- Logo Upload -->
						<div class="glass-panel p-4 mb-0 d-flex flex-col gap-3 border">
							<div class="flex-between">
								<label class="form-label font-bold text-xs m-0">
									شعار المنظمة (Logo)
								</label>
								<span class="text-xs text-muted">PNG, JPG (Max: 2MB)</span>
							</div>

							<div class="d-flex items-center gap-3 flex-wrap">
								if profile.Image != "" {
									<div class="user-avatar-badge">
										<img src={ profile.Image } alt="Logo" class="product-thumb-img" />
									</div>
								}
								<div class="flex-1 min-w-0">
									<input type="file" name="logo_file" accept="image/*" class="form-input text-xs" />
								</div>
							</div>
						</div>

						<!-- Coverage Image Upload -->
						<div class="glass-panel p-4 mb-0 d-flex flex-col gap-3 border">
							<div class="flex-between">
								<label class="form-label font-bold text-xs m-0">
									صورة الغلاف (Coverage Image)
								</label>
								<span class="text-xs text-muted">PNG, JPG (Max: 2MB)</span>
							</div>

							<div class="d-flex items-center gap-3 flex-wrap">
								if profile.CoverageImage != "" {
									<div class="stack-sm">
										<img src={ profile.CoverageImage } alt="Cover" />
									</div>
								}
								<div class="flex-1 min-w-0">
									<input type="file" name="coverage_file" accept="image/*" class="form-input text-xs" />
								</div>
							</div>
						</div>

					</div>
				</div>

				<!-- Form Actions -->
				<div class="flex-between items-center border-t pt-4 flex-wrap gap-3">
					<a href="/vendor/dashboard" class="btn btn-secondary font-bold">
						إلغاء والعودة
					</a>
					<button type="submit" class="btn btn-primary font-extrabold px-6">
						@components.IconSend("icon-xs")
						<span>إرسال طلب التعديل للمراجعة</span>
					</button>
				</div>

			</form>

			<!-- 5. Change Requests History Section -->
			if len(history) > 0 {
				<div class="glass-panel p-6 mb-0 d-flex flex-col gap-4">
					<div class="flex-between items-center flex-wrap gap-2 pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<div class="user-avatar-badge">
								@components.IconClock("icon-xs")
							</div>
							<h3 class="text-base font-extrabold text-primary m-0">
								سجل طلبات تعديل البيانات السابقة
							</h3>
						</div>
						<span class="text-xs text-muted font-bold tabular-nums">({ fmt.Sprintf("%d", len(history)) } طلبات)</span>
					</div>

					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>رقم الطلب</th>
									<th>تاريخ الإرسال</th>
									<th>الحقول المطلوبة</th>
									<th>الحالة</th>
									<th>ملاحظات الإدارة / سبب الرفض</th>
								</tr>
							</thead>
							<tbody>
								for _, hItem := range history {
									<tr>
										<td>
											<span class="font-bold font-mono text-primary">#{ fmt.Sprintf("%d", hItem.ID) }</span>
										</td>
										<td>
											<span class="text-xs text-secondary tabular-nums">
												{ FormatDateTime(hItem.CreatedAt) }
											</span>
										</td>
										<td>
											<div class="d-flex flex-wrap gap-1">
												for _, lbl := range hItem.ChangedFieldLabels() {
													<span class="badge badge-sky text-xs">{ lbl }</span>
												}
											</div>
										</td>
										<td>
											if hItem.Status == org.ChangeRequestPending {
												<span class="badge badge-amber font-bold">قيد المراجعة</span>
											} else if hItem.Status == org.ChangeRequestApproved {
												<span class="badge badge-emerald font-bold">معتمد</span>
											} else if hItem.Status == org.ChangeRequestRejected {
												<span class="badge badge-rose font-bold">مرفوض</span>
											} else {
												<span class="badge badge-secondary font-bold">{ string(hItem.Status) }</span>
											}
										</td>
										<td>
											if hItem.RejectionReason != "" {
												<span class="text-xs text-rose font-bold">{ hItem.RejectionReason }</span>
											} else if hItem.AdminNotes != "" {
												<span class="text-xs text-secondary">{ hItem.AdminNotes }</span>
											} else if hItem.Status == org.ChangeRequestPending {
												<span class="text-xs text-muted">قيد فحص ومطابقة المشرف</span>
											} else {
												<span class="text-xs text-muted">—</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

		</div>
	}
}
