package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorOrganizationPage(lang, dir string, profile *org.SupplierOrgProfile, noticeType, noticeMsg string) {
	@layouts.VendorShell("بيانات المنشأة والهوية التجارية | دواء 24", "organization", lang, dir) {
		<div class="page-container max-w-6xl">
			
			<!-- Notice Toast -->
			if noticeMsg != "" {
				if noticeType == "error" {
					<div class="alert alert-danger mb-0">
						<span class="text-xl">@components.IconAlert("icon-sm")</span>
						<span>{ noticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success mb-0">
						<span class="text-xl">@components.IconCheckCircle("icon-sm")</span>
						<span>{ noticeMsg }</span>
					</div>
				}
			}

			<!-- Top Banner -->
			<div class="glass-panel p-6 mb-0">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconBuilding("icon-sm")
						</div>
      <div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">
								بيانات المنشأة والهوية التجارية
							</h1>
							<p class="text-sm text-secondary m-0 mt-1">
								تعديل الاسم التجاري، حدود أسعار الطلبات، أرقام التواصل والتراخيص، والشعار الرسمي للمنشأة.
							</p>
						</div>
					</div>
					if profile.ID > 0 {
						<a href={ templ.SafeURL(fmt.Sprintf("/suppliers/%d", profile.ID)) } target="_blank" class="btn btn-secondary font-bold gap-2">
							@components.IconGlobe("icon-xs")
							<span>عرض الصفحة العامة للمورد </span>
						</a>
					}
				</div>
			</div>

			<!-- Main Form -->
			<form method="POST" action="/vendor/organization" enctype="multipart/form-data" class="glass-panel p-6 mb-0 d-flex flex-col gap-6">
				
				<!-- 1. Identity Section -->
				<div class="d-flex flex-col gap-4">
					<div class="d-flex items-center gap-3 pb-3 border-b">
						<div class="user-avatar-badge">
							@components.IconBuilding("icon-sm")
						</div>
      <div class="stack-sm">
							<h3 class="text-base font-extrabold text-primary m-0">
								البيانات الأساسية والهوية
							</h3>
							<p class="text-xs text-muted m-0">الاسم الرسمي للمؤسسة والتصنيف التجاري</p>
						</div>
					</div>

					<div class="d-grid grid-cols-3 gap-4">
      <div class="stack-sm">
							<label class="form-label">
								اسم المؤسسة بالعربية <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								name="name_ar"
								value={ profile.NameAr }
								required
								class="form-input"
								placeholder="مثال: سمارت كودز لتوزيع الأدوية"
							/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								اسم المؤسسة بالإنجليزية <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								name="name_en"
								value={ profile.NameEn }
								required
								class="form-input"
								placeholder="Example: Smart Codes Pharma Distribution"
							/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								النوع / التصنيف <span class="text-danger">*</span>
							</label>
							<select name="type" class="form-select">
								<option value="supplier" selected?={ profile.Type == "supplier" || profile.Type == "vendor" }>مورد (Supplier)</option>
								<option value="company" selected?={ profile.Type == "company" }>شركة توزيع (Company)</option>
								<option value="agency" selected?={ profile.Type == "agency" }>وكالة / مستورد (Agency)</option>
							</select>
						</div>
					</div>
				</div>

				<!-- 2. Order Price Limits Section -->
				<div class="glass-panel p-5 mb-0 d-flex flex-col gap-4 border">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-lg">
							@components.IconWallet("icon-sm")
						</div>
      <div class="stack-sm">
							<h3 class="text-base font-extrabold text-primary m-0">
								إعدادات الحد الأدنى والأقصى لسعر الطلب
							</h3>
							<p class="text-xs text-muted m-0 mt-1">
								تحديد القيود المالية لقيمة الطلبات المسموح بها لهذه المنظمة
							</p>
						</div>
					</div>

					<div class="d-grid grid-cols-2 gap-4">
      <div class="stack-sm">
							<label class="form-label">
								الحد الأدنى لسعر الطلب <span class="text-danger">*</span>
							</label>
							<div class="position-relative d-flex items-center">
								<input
									type="number"
									step="0.01"
									min="0"
									name="min_order_price"
									value={ profile.MinOrderPrice.String() }
									required
									class="form-input font-bold tabular-nums"
									placeholder="10.00"
								/>
							</div>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								الحد الأقصى لسعر الطلب <span class="text-danger">*</span>
							</label>
							<div class="position-relative d-flex items-center">
								<input
									type="number"
									step="0.01"
									min="0"
									name="max_order_price"
									value={ profile.MaxOrderPrice.String() }
									required
									class="form-input font-bold tabular-nums"
									placeholder="50.00"
								/>
							</div>
						</div>
					</div>
				</div>

				<!-- 3. Contact & Location Section -->
				<div class="d-flex flex-col gap-4">
					<div class="d-flex items-center gap-3 pb-3 border-b">
						<div class="user-avatar-badge">
							@components.IconPhone("icon-sm")
						</div>
      <div class="stack-sm">
							<h3 class="text-base font-extrabold text-primary m-0">
								معلومات الاتصال والضرائب
							</h3>
							<p class="text-xs text-muted m-0">بيانات التواصل الرسمي والعنوان والرقم الضريبي</p>
						</div>
					</div>

					<div class="d-grid grid-cols-3 gap-4">
      <div class="stack-sm">
							<label class="form-label">
								رقم المنظمة
							</label>
							<input
								type="text"
								name="organization_number"
								value={ profile.OrganizationNumber }
								class="form-input"
								placeholder="مثال: 267244"
							/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								البريد الإلكتروني
							</label>
							<input
								type="email"
								name="email"
								value={ profile.Email }
								class="form-input"
								placeholder="info@smartcodes.com"
							/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								رقم الهاتف
							</label>
							<input
								type="text"
								name="phone"
								value={ profile.Phone }
								class="form-input"
								placeholder="01099887766"
							/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								الرقم الضريبي
							</label>
							<input
								type="text"
								name="tax_number"
								value={ profile.TaxNumber }
								class="form-input"
								placeholder="TX431256"
							/>
						</div>

						<div class="col-span-2">
							<label class="form-label">
								العنوان الرئيسي
							</label>
							<input
								type="text"
								name="address"
								value={ profile.Address }
								class="form-input"
								placeholder="الجيزة، مصر"
							/>
						</div>
					</div>
				</div>

				<!-- 4. Description, Logo & Cover Section -->
				<div class="d-flex flex-col gap-4">
					<div class="d-flex items-center gap-3 pb-3 border-b">
						<div class="user-avatar-badge">
							@components.IconEdit("icon-sm")
						</div>
      <div class="stack-sm">
							<h3 class="text-base font-extrabold text-primary m-0">
								الوصف والشعار وصورة الغلاف
							</h3>
							<p class="text-xs text-muted m-0">نبذة عن المورد وصور الهوية البصرية المعروضة للعملاء</p>
						</div>
					</div>

					<div class="d-grid grid-cols-2 gap-4">
      <div class="stack-sm">
							<label class="form-label">
								الوصف (بالعربية)
							</label>
							<textarea
								name="description_ar"
								rows="3"
								class="form-input"
								placeholder="شركة متخصصة في توزيع وتوريد الأدوية والمستلزمات الطبية..."
							>{ profile.DescriptionAr }</textarea>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								الوصف (بالإنجليزية)
							</label>
							<textarea
								name="description_en"
								rows="3"
								class="form-input"
								placeholder="Specialized company in pharmaceutical and healthcare distribution..."
							>{ profile.DescriptionEn }</textarea>
						</div>
					</div>

					<!-- Logo & Cover Upload Row -->
					<div class="d-grid grid-cols-2 gap-4 mt-2">
						
						<!-- Logo Upload -->
						<div class="glass-panel p-4 mb-0 d-flex flex-col gap-3 border">
							<div class="flex-between">
								<label class="form-label font-bold text-xs m-0">
									شعار المنظمة (Logo)
								</label>
								<span class="text-xs text-muted">PNG, JPG (Max: 2MB)</span>
							</div>

							<div class="d-flex items-center gap-3 flex-wrap">
								if profile.Image != "" {
									<div class="user-avatar-badge">
										<img src={ profile.Image } alt="Logo" class="product-thumb-img" />
									</div>
								}
								<div class="flex-1 min-w-0">
									<input type="file" name="logo_file" accept="image/*" class="form-input text-xs" />
								</div>
							</div>
						</div>

						<!-- Coverage Image Upload -->
						<div class="glass-panel p-4 mb-0 d-flex flex-col gap-3 border">
							<div class="flex-between">
								<label class="form-label font-bold text-xs m-0">
									صورة الغلاف (Coverage Image)
								</label>
								<span class="text-xs text-muted">PNG, JPG (Max: 2MB)</span>
							</div>

							<div class="d-flex items-center gap-3 flex-wrap">
								if profile.CoverageImage != "" {
         <div class="stack-sm">
										<img src={ profile.CoverageImage } alt="Cover" />
									</div>
								}
								<div class="flex-1 min-w-0">
									<input type="file" name="coverage_file" accept="image/*" class="form-input text-xs" />
								</div>
							</div>
						</div>

					</div>
				</div>

				<!-- Form Actions -->
				<div class="flex-between items-center border-t pt-4 flex-wrap gap-3">
					<a href="/vendor/dashboard" class="btn btn-secondary font-bold">
						إلغاء والعودة
					</a>
					<button type="submit" class="btn btn-primary font-extrabold px-6">
						<span>حفظ التعديلات والتحديث الفوري </span>
					</button>
				</div>

			</form>

		</div>
	}
}
