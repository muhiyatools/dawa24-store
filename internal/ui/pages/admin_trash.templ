package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// ModelMetaEntry carries model info for rendering.
type ModelMetaEntry struct {
	Key          string
	NameAr       string
	NameEn       string
	SchemaTable  string
	TotalCount   int
	TrashedCount int
}



// AdminTrashListPage renders trash overview across models.
templ AdminTrashListPage(models []ModelMetaEntry, lang, dir string) {
	@layouts.AdminShell("سلة المحذوفات المركزية (Trash List)", "trash", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">سلة المحذوفات واسترجاع البيانات ({ fmt.Sprintf("%d", len(models)) })</h2>
					<p class="subtitle">استرجاع البيانات المحذوفة مؤقتاً أو الحذف النهائي مع الحفاظ على سلامة العلاقات.</p>
				</div>
			</div>

			<div class="table-container">
				<table class="b2b-table">
					<thead>
						<tr>
							<th>الجدول / النموذج</th>
							<th>الاسم</th>
							<th>السجلات في السلة</th>
							<th class="text-end">الإجراءات</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range models {
							<tr>
								<td><code>{ m.SchemaTable }</code></td>
								<td><strong>{ m.NameAr }</strong></td>
								<td class="tabular-nums">
									if m.TrashedCount > 0 {
										<span class="badge badge-rose">{ fmt.Sprintf("%d محذوف", m.TrashedCount) }</span>
									} else {
										<span class="badge badge-emerald">فارغ</span>
									}
								</td>
								<td class="text-end">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/trash-list/%s", m.Key)) } class="btn btn-secondary btn-sm">فتح السلة</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

// TrashRowView is one soft-deleted record in the trash listing.
type TrashRowView struct {
	ID        int64
	Label     string
	DeletedAt string
}

// AdminTrashListModelPage lists the deleted rows of one table, with restore and
// purge actions that reach the database.
templ AdminTrashListModelPage(modelKey string, rows []TrashRowView, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("سلة محذوفات %s", modelKey), "trash", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">سلة محذوفات { modelKey }</h2>
					<p class="subtitle">
						الاسترجاع يعيد السجل للنظام. الحذف النهائي لا يمكن التراجع عنه ويُسجَّل في سجل التدقيق.
					</p>
				</div>
				<a href="/admin/trash-list" class="btn btn-secondary btn-sm">العودة للسلة</a>
			</div>
			if len(rows) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "السلة فارغة",
					Message: "لا توجد سجلات محذوفة مؤقتاً لهذا النموذج.",
				})
			} else {
				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th style="width:90px;">المعرف</th>
								<th>السجل</th>
								<th style="width:160px;">تاريخ الحذف</th>
								<th style="width:220px; text-align:end;">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range rows {
								<tr>
									<td class="tabular-nums">{ fmt.Sprintf("%d", row.ID) }</td>
									<td><strong>{ row.Label }</strong></td>
									<td class="tabular-nums">{ row.DeletedAt }</td>
									<td style="text-align:end; display:flex; gap:0.5rem; justify-content:flex-end;">
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/trash-list/%s/%d/restore", modelKey, row.ID)) } class="m-0">
											<button type="submit" class="btn btn-secondary btn-sm">استرجاع</button>
										</form>
										<form
											method="POST"
											action={ templ.SafeURL(fmt.Sprintf("/admin/trash-list/%s/%d/purge", modelKey, row.ID)) }
											class="m-0"
											onsubmit="return confirm('حذف نهائي لا يمكن التراجع عنه. هل أنت متأكد؟');"
										>
											<button type="submit" class="btn btn-danger btn-sm">حذف نهائي</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
