package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// ModelMetaEntry carries model info for rendering.
type ModelMetaEntry struct {
	Key          string
	NameAr       string
	NameEn       string
	SchemaTable  string
	TotalCount   int
	TrashedCount int
}

func calcTotalTrashed(models []ModelMetaEntry) int {
	total := 0
	for _, m := range models {
		total += m.TrashedCount
	}
	return total
}

func calcTotalActive(models []ModelMetaEntry) int {
	total := 0
	for _, m := range models {
		active := m.TotalCount - m.TrashedCount
		if active > 0 {
			total += active
		}
	}
	return total
}

// AdminTrashListPage renders trash overview across models.
templ AdminTrashListPage(models []ModelMetaEntry, lang, dir string) {
	@layouts.AdminShell("سلة المحذوفات المركزية واسترجاع البيانات", "trash", lang, dir) {
		<div class="stack-lg">
			@components.PageHeader(components.PageHeaderProps{
				Title:       "سلة المحذوفات واسترجاع البيانات",
				Subtitle:    "إدارة واسترجاع السجلات المحذوفة مؤقتاً (Soft-Deleted) عبر كافة أقسام المنظومة، مع إمكانية الاستعادة الفورية أو الحذف النهائي الموثق أمنياً.",
				Count:       intPtr(len(models)),
			})

			<!-- KPI Summary Strip -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1.25rem;">
				<div class="card mb-0" style="padding:1.25rem; display:flex; align-items:center; gap:1rem;">
					<div class="b2b-icon-box" style="background:var(--rose-subtle); color:var(--danger);">
						@components.IconTrash("icon-md")
					</div>
					<div>
						<div class="tabular-nums" style="font-size:1.6rem; font-weight:900; color:var(--text); line-height:1.1;">
							{ fmt.Sprintf("%d", calcTotalTrashed(models)) }
						</div>
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); margin-top:2px;">إجمالي السجلات في السلة</div>
					</div>
				</div>

				<div class="card mb-0" style="padding:1.25rem; display:flex; align-items:center; gap:1rem;">
					<div class="b2b-icon-box" style="background:var(--emerald-subtle); color:var(--emerald);">
						@components.IconCheckCircle("icon-md")
					</div>
					<div>
						<div class="tabular-nums" style="font-size:1.6rem; font-weight:900; color:var(--text); line-height:1.1;">
							{ fmt.Sprintf("%d", calcTotalActive(models)) }
						</div>
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); margin-top:2px;">السجلات النشطة بالنظام</div>
					</div>
				</div>

				<div class="card mb-0" style="padding:1.25rem; display:flex; align-items:center; gap:1rem;">
					<div class="b2b-icon-box" style="background:var(--sky-subtle); color:var(--sky);">
						@components.IconShield("icon-md")
					</div>
					<div>
						<div class="tabular-nums" style="font-size:1.6rem; font-weight:900; color:var(--text); line-height:1.1;">
							{ fmt.Sprintf("%d", len(models)) }
						</div>
						<div style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); margin-top:2px;">أقسام محمية بحذف آمن</div>
					</div>
				</div>
			</div>

			<!-- Guidance Box -->
			<div class="card mb-0" style="background:var(--surface-raised); border:1px solid var(--border); padding:1.25rem 1.5rem;">
				<div style="display:flex; align-items:flex-start; gap:1rem;">
					<div class="b2b-icon-box" style="flex-shrink:0;">
						@components.IconInfo("icon-sm")
					</div>
					<div style="font-size:0.85rem; color:var(--text-secondary); line-height:1.7;">
						<div style="font-weight:800; color:var(--text); font-size:0.95rem; margin-bottom:0.35rem;">
							كيف يعمل نظام سلة المحذوفات والاسترجاع؟
						</div>
						<div>
							• <strong>الحذف المؤقت (Soft Delete)</strong>: عند حذف أي صنف، منشأة، طلب أو مستخدم، لا يُحذف السجل نهائياً بل يتم وضع وسم وتاريخ الحذف ونقله للسلة فوراً لمنع فقدان البيانات.<br/>
							• <strong>الاسترجاع الفوري (Restore)</strong>: يمكنك في أي وقت استعادة السجل المحذوف ليعود إلى حالته النشطة بكافة تفاصيله وعلاقاته.<br/>
							• <strong>الحذف النهائي (Purge)</strong>: إجراء قطعي لا يمكن التراجع عنه يقوم بإزالة السجل نهائياً من قاعدة البيانات، ويتم تلقائياً توثيق لقطة كاملة (Snapshot) للسجل في سجل التدقيق الأمني (Audit Log).
						</div>
					</div>
				</div>
			</div>

			<!-- Table of Models -->
			<div class="card mb-0">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
					<h3 class="card-title m-0" style="font-size:1.1rem;">
						جداول ونماذج البيانات المشمولة بالسلة ({ fmt.Sprintf("%d", len(models)) })
					</h3>
					<span class="badge badge-sky text-xs">كشف تلقائي من قاعدة البيانات</span>
				</div>

				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>القسم / النموذج في المنظومة</th>
								<th>الجدول البرمجي</th>
								<th>السجلات النشطة</th>
								<th>السجلات في السلة</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, m := range models {
								<tr>
									<td>
										<div style="font-weight:800; color:var(--text); font-size:0.95rem;">{ m.NameAr }</div>
										<div style="font-size:0.75rem; color:var(--text-muted); direction:ltr; text-align:start;">{ m.NameEn }</div>
									</td>
									<td>
										<code style="font-size:0.8rem; background:var(--surface-sunken); padding:0.2rem 0.5rem; border-radius:var(--radius-sm); border:1px solid var(--border);">{ m.SchemaTable }</code>
									</td>
									<td class="tabular-nums" style="font-weight:700; color:var(--text);">
										{ fmt.Sprintf("%d", m.TotalCount - m.TrashedCount) }
									</td>
									<td class="tabular-nums">
										if m.TrashedCount > 0 {
											<span class="badge badge-rose" style="font-weight:800;">{ fmt.Sprintf("%d محذوف", m.TrashedCount) }</span>
										} else {
											<span class="badge badge-emerald">فارغ (0)</span>
										}
									</td>
									<td>
										if m.TrashedCount > 0 {
											<span class="badge badge-amber text-xs">تتطلب مراجعة أو استرجاع</span>
										} else {
											<span class="badge badge-slate text-xs">سليمة بالكامل</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/trash-list/%s", m.Key)) } class="btn btn-secondary btn-sm fw-700">
											@components.IconFolderOpen("icon-xs")
											<span>معاينة واسترجاع السجلات ({ fmt.Sprintf("%d", m.TrashedCount) })</span>
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

// TrashRowView is one soft-deleted record in the trash listing.
type TrashRowView struct {
	ID        int64
	Label     string
	DeletedAt string
}

// AdminTrashListModelPage lists the deleted rows of one table, with restore and purge actions.
templ AdminTrashListModelPage(modelKey string, rows []TrashRowView, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("سلة محذوفات: %s", modelKey), "trash", lang, dir) {
		<div class="stack-lg">
			@components.PageHeader(components.PageHeaderProps{
				Title:    fmt.Sprintf("سلة محذوفات: %s", modelKey),
				Subtitle: "استعراض كافة السجلات المحذوفة مؤقتاً في هذا القسم، مع خيارات الاسترجاع الفوري أو الحذف النهائي الموثق.",
				Count:    intPtr(len(rows)),
			}) {
				<a href="/admin/trash-list" class="btn btn-secondary btn-sm fw-700">
					@components.IconArrowRight("icon-xs")
					<span>العودة لسلة المحذوفات</span>
				</a>
			}

			<div class="card mb-0">
				if len(rows) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "سلة هذا القسم فارغة تماماً",
						Message: "لا توجد سجلات محذوفة مؤقتاً في هذا النموذج حالياً.",
					})
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th style="width:100px;">المعرف (ID)</th>
									<th>بيان وتفاصيل السجل المحذوف</th>
									<th style="width:180px;">تاريخ ووقت الحذف</th>
									<th style="width:240px; text-align:end;">الإجراءات والخيارات</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range rows {
									<tr>
										<td class="tabular-nums" style="font-weight:800; color:var(--text-muted);">
											#{ fmt.Sprintf("%d", row.ID) }
										</td>
										<td>
											<div style="font-weight:800; color:var(--text); font-size:0.95rem;">
												if row.Label != "" {
													{ row.Label }
												} else {
													<span class="text-muted">سجل رقم #{ fmt.Sprintf("%d", row.ID) }</span>
												}
											</div>
										</td>
										<td class="tabular-nums" style="font-size:0.85rem; color:var(--text-secondary);">
											{ row.DeletedAt }
										</td>
										<td style="text-align:end;">
											<div class="row-center-xs" style="justify-content:flex-end;">
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/trash-list/%s/%d/restore", modelKey, row.ID)) } class="m-0">
													<button type="submit" class="btn btn-secondary btn-sm fw-700" title="استرجاع السجل للنظام">
														@components.IconRefresh("icon-xs")
														<span>استرجاع</span>
													</button>
												</form>
												<form
													method="POST"
													action={ templ.SafeURL(fmt.Sprintf("/admin/trash-list/%s/%d/purge", modelKey, row.ID)) }
													class="m-0"
													onsubmit="return confirm('تنبيه أمني: هذا الحذف نهائي وقطعي ولا يمكن التراجع عنه. سيتم حفظ لقطة أمنية في سجل التدقيق. هل أنت متأكد؟');"
												>
													<button type="submit" class="btn btn-danger btn-sm fw-700" title="حذف نهائي من قاعدة البيانات">
														@components.IconTrash("icon-xs")
														<span>حذف نهائي</span>
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

