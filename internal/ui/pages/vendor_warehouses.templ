package pages

import (
	"fmt"
	"net/url"
	"time"

	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorWarehousesPage renders the list of vendor warehouses.
templ VendorWarehousesPage(warehouses []*inventory.Warehouse, branches []*org.Branch, lang, dir string) {
	@layouts.VendorShell("المخازن ومواقع التخزين", "warehouses", lang, dir) {
		<div x-data="{ showAddModal: false, editModal: false, editWh: { id: 0, name: '', code: '', address: '', phone: '', branch_id: 0, is_active: true } }" class="page-container">
			
			<!-- Header & Action Bar -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconBuilding("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">مخازن ومواقع تخزين المنشأة</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							إدارة مراكز التخزين، ربطها بالفروع التوزيعية، ومتابعة الأرصدة والتحويلات
						</p>
					</div>
					<div class="d-flex items-center gap-3 flex-wrap">
						<a href="/vendor/transfers" class="btn btn-secondary btn-sm">
							@components.IconRefresh("icon-xs")
							<span>التحويلات المخزنية</span>
						</a>
						<button type="button" class="btn btn-primary btn-sm font-bold" @click="showAddModal = true">
							@components.IconPlus("icon-xs")
							<span>إضافة مخزن جديد</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Quick Metric Stat Cards -->
			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي المخازن</div>
					<div class="stat-card-value text-primary tabular-nums">{ fmt.Sprintf("%d", len(warehouses)) }</div>
					<span class="text-xs text-secondary mt-1 d-block">مراكز التخزين المسجلة</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-success">المخازن النشطة</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%d", func() int {
							c := 0
							for _, w := range warehouses {
								if w.IsActive { c++ }
							}
							return c
						}()) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">جاهزة للتوريد والعمليات</span>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">الفروع التوزيعية</div>
					<div class="stat-card-value text-brand tabular-nums">{ fmt.Sprintf("%d", len(branches)) }</div>
					<span class="text-xs text-secondary mt-1 d-block">فروع وخطوط توزيع مرتبطة</span>
				</div>
			</div>

			<!-- Warehouses Table Card -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(warehouses) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconBuilding("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد مخازن مسجلة</h3>
						<p class="text-sm text-secondary m-0">يمكنك تسجيل مخازن جديدة لتخزين الأدوية وربطها بالفروع التوزيعية.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>المخزن</th>
									<th>الكود</th>
									<th>الفرع المرتبط</th>
									<th>العنوان ورقم التواصل</th>
									<th class="text-center">الحالة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, w := range warehouses {
									<tr>
										<td>
											<div class="d-flex items-center gap-3">
												<div class="user-avatar-badge">
													@components.IconBuilding("icon-xs")
												</div>
            <div class="stack-sm">
													<strong class="text-primary text-sm font-extrabold">{ w.Name }</strong>
													<div class="text-xs text-muted">ID #{ fmt.Sprintf("%d", w.ID) }</div>
												</div>
											</div>
										</td>
										<td>
											<code class="text-xs bg-surface-sunken p-1 px-2 rounded">{ w.Code }</code>
										</td>
										<td>
											if w.BranchID != nil && *w.BranchID > 0 {
												<span class="badge badge-sky text-xs font-bold">
													فرع #{ fmt.Sprintf("%d", *w.BranchID) }
												</span>
											} else {
												<span class="text-muted text-xs">مخزن عام</span>
											}
										</td>
										<td>
											<div class="text-xs text-primary">
												if w.Address != "" {
													<div class="stack-xs text-sm">{ w.Address }</div>
												}
												if w.Phone != "" {
													<div class="text-xs text-muted tabular-nums mt-1">{ w.Phone }</div>
												}
											</div>
										</td>
										<td class="text-center">
											if w.IsActive {
												<span class="badge badge-emerald text-xs font-bold">نشط</span>
											} else {
												<span class="badge badge-rose text-xs font-bold">معطل</span>
											}
										</td>
										<td class="text-end">
											<div class="d-flex items-center justify-end gap-2">
												<a href={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", w.ID)) } class="btn btn-secondary btn-sm font-bold text-xs" title="عرض الأصناف والأرصدة">
													@components.IconPackage("icon-xs")
													<span>عرض المخزون</span>
												</a>
												<button
													type="button"
													class="btn btn-secondary btn-sm font-bold text-xs"
													@click={ fmt.Sprintf("editWh = { id: %d, name: %q, code: %q, address: %q, phone: %q, branch_id: %d, is_active: %t }; editModal = true;", w.ID, w.Name, w.Code, w.Address, w.Phone, func() int64 { if w.BranchID != nil { return *w.BranchID }; return 0 }(), w.IsActive) }
												>
													تعديل
												</button>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d/toggle", w.ID)) } class="m-0">
													<button type="submit" class="btn btn-secondary btn-sm text-muted text-xs">
														if w.IsActive {
															تعطيل
														} else {
															تفعيل
														}
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Add Warehouse Modal -->
			<div
				x-show="showAddModal"
				x-cloak
				x-transition.opacity
				class="fixed inset-0 z-50 d-flex items-center justify-center p-4 bg-slate-900/60"
				@keydown.escape.window="showAddModal = false"
			>
				<div
					@click.outside="showAddModal = false"
					class="glass-panel p-6 w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden relative mx-auto my-auto"
				>
					<div class="flex-between items-center mb-4 pb-3 border-b border-slate-100">
						<div class="d-flex items-center gap-2.5">
							<div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
								@components.IconBuilding("icon-sm")
							</div>
       <div class="stack-sm">
								<h3 class="text-base font-black text-primary m-0">إضافة مخزن / مركز تخزين جديد</h3>
								<p class="text-2xs text-secondary m-0 mt-0.5 font-medium">تسجيل موقع تخزين جديد لربطه بالفروع والمخزون</p>
							</div>
						</div>
						<button type="button" @click="showAddModal = false" class="btn btn-secondary btn-icon btn-sm">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/vendor/warehouses" class="d-flex flex-col gap-4 m-0">
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">اسم المخزن <span class="text-danger">*</span></label>
							<input type="text" name="name" required class="form-input text-xs font-semibold w-full" placeholder="مثلاً: مخزن القاهرة الرئيسي / مخزن مدينة نصر" />
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">كود المخزن (اختياري)</label>
							<input type="text" name="code" class="form-input text-xs font-mono w-full" placeholder="WH-01" />
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">الفرع التوزيعي المرتبط</label>
							<select name="branch_id" class="form-input text-xs font-semibold w-full">
								<option value="">بدون فرع محدد (مخزن عام رئيسي)</option>
								for _, b := range branches {
									<option value={ fmt.Sprintf("%d", b.ID) }>
										if b.Name["ar"] != "" {
											{ b.Name["ar"] }
										} else {
											{ b.Name["en"] }
										}
										(فرع #{ fmt.Sprintf("%d", b.ID) })
									</option>
								}
							</select>
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">العنوان بالتفصيل</label>
							<input type="text" name="address" class="form-input text-xs w-full" placeholder="المنطقة الصناعية، القطعة 14، القاهرة" />
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">رقم الهاتف والتواصل</label>
							<input type="text" name="phone" class="form-input text-xs tabular-nums w-full" placeholder="01012345678" />
						</div>

						<div class="flex-between items-center gap-3 mt-2 pt-3 border-t border-slate-100">
							<button type="button" class="btn btn-secondary text-xs font-bold" @click="showAddModal = false">إلغاء</button>
							<button type="submit" class="btn btn-primary text-xs font-bold px-6 shadow-sm">حفظ وتفعيل المخزن</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Edit Warehouse Modal -->
			<div
				x-show="editModal"
				x-cloak
				x-transition.opacity
				class="fixed inset-0 z-50 d-flex items-center justify-center p-4 bg-slate-900/60"
				@keydown.escape.window="editModal = false"
			>
				<div
					@click.outside="editModal = false"
					class="glass-panel p-6 w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden relative mx-auto my-auto"
				>
					<div class="flex-between items-center mb-4 pb-3 border-b border-slate-100">
						<div class="d-flex items-center gap-2.5">
							<div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 d-flex items-center justify-center border border-amber-200/60 shadow-2xs">
								@components.IconEdit("icon-sm")
							</div>
       <div class="stack-sm">
								<h3 class="text-base font-black text-primary m-0">تعديل بيانات المخزن</h3>
								<p class="text-2xs text-secondary m-0 mt-0.5 font-medium">تحديث معلومات وبيانات موقع التخزين</p>
							</div>
						</div>
						<button type="button" @click="editModal = false" class="btn btn-secondary btn-icon btn-sm">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form :action="'/vendor/warehouses/' + editWh.id" method="POST" class="d-flex flex-col gap-4 m-0">
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">اسم المخزن <span class="text-danger">*</span></label>
							<input type="text" name="name" x-model="editWh.name" required class="form-input text-xs font-semibold w-full" />
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">كود المخزن</label>
							<input type="text" name="code" x-model="editWh.code" class="form-input text-xs font-mono w-full" />
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">الفرع التوزيعي المرتبط</label>
							<select name="branch_id" x-model="editWh.branch_id" class="form-input text-xs font-semibold w-full">
								<option value="0">بدون فرع محدد (مخزن رئيسي)</option>
								for _, b := range branches {
									<option value={ fmt.Sprintf("%d", b.ID) }>
										if b.Name["ar"] != "" {
											{ b.Name["ar"] }
										} else {
											{ b.Name["en"] }
										}
										(فرع #{ fmt.Sprintf("%d", b.ID) })
									</option>
								}
							</select>
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">العنوان بالتفصيل</label>
							<input type="text" name="address" x-model="editWh.address" class="form-input text-xs w-full" />
						</div>

      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-primary mb-1.5 d-block">رقم الهاتف والتواصل</label>
							<input type="text" name="phone" x-model="editWh.phone" class="form-input text-xs tabular-nums w-full" />
						</div>

      <div class="stack-sm">
							<label class="d-flex items-center gap-2 cursor-pointer text-xs font-bold text-primary">
								<input type="checkbox" name="is_active" value="true" x-model="editWh.is_active" class="form-checkbox" />
								<span>المخزن مفعل ونشط لإدارة المخزون</span>
							</label>
						</div>

						<div class="flex-between items-center gap-3 mt-2 pt-3 border-t border-slate-100">
							<button type="button" class="btn btn-secondary text-xs font-bold" @click="editModal = false">إلغاء</button>
							<button type="submit" class="btn btn-primary text-xs font-bold px-6 shadow-sm">حفظ التغييرات</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}

// VendorWarehouseStockFilter carries search, status, sorting, and pagination parameters.
type VendorWarehouseStockFilter struct {
	Query        string
	StockStatus  string
	ExpiryStatus string
	Sort         string
	Page         int
	PerPage      int
}

// VendorWarehouseStats calculates inventory analytics for a single warehouse.
type VendorWarehouseStats struct {
	TotalItems        int
	TotalUnits        int
	LowStockCount     int
	OutOfStockCount   int
	ExpiringSoonCount int
	ExpiredCount      int
}

// VendorWarehouseDetailData contains all context needed to render warehouse stock management.
type VendorWarehouseDetailData struct {
	Warehouse     *inventory.Warehouse
	Stocks        []*inventory.DetailedWarehouseStockView
	Stats         VendorWarehouseStats
	Filter        VendorWarehouseStockFilter
	TotalFiltered int
	TotalPages    int
	FromItem      int
	ToItem        int
	NoticeType    string
	NoticeMsg     string
}

func buildWarehouseInventoryURL(whID int64, f VendorWarehouseStockFilter, page, perPage int) string {
	q := url.Values{}
	if f.Query != "" {
		q.Set("q", f.Query)
	}
	if f.StockStatus != "" && f.StockStatus != "all" {
		q.Set("stock_status", f.StockStatus)
	}
	if f.ExpiryStatus != "" && f.ExpiryStatus != "all" {
		q.Set("expiry_status", f.ExpiryStatus)
	}
	if f.Sort != "" && f.Sort != "updated_desc" {
		q.Set("sort", f.Sort)
	}
	if page > 1 {
		q.Set("page", fmt.Sprint(page))
	}
	if perPage > 0 && perPage != 20 {
		q.Set("limit", fmt.Sprint(perPage))
	}
	qs := q.Encode()
	if qs != "" {
		return fmt.Sprintf("/vendor/warehouses/%d?%s", whID, qs)
	}
	return fmt.Sprintf("/vendor/warehouses/%d", whID)
}

func isExpiringSoon(exp *time.Time) bool {
	if exp == nil {
		return false
	}
	now := time.Now()
	sixMonths := now.AddDate(0, 6, 0)
	return exp.After(now) && exp.Before(sixMonths)
}

func isExpired(exp *time.Time) bool {
	if exp == nil {
		return false
	}
	return exp.Before(time.Now())
}

// VendorWarehouseDetailPage renders complete warehouse inventory details, filters, KPIs, and stock adjustment tools.
templ VendorWarehouseDetailPage(data VendorWarehouseDetailData, lang, dir string) {
	@layouts.VendorShell(fmt.Sprintf("مخزن: %s | جرد المخزون", data.Warehouse.Name), "warehouses", lang, dir) {
		<div x-data="{ adjustModal: false, adjustStock: { id: 0, name: '', batch: '', qty: 0, min: 0 } }" class="page-container">
			
			<!-- Breadcrumb & Top Action Navigation -->
			<div class="flex-between items-center flex-wrap gap-4 mb-4">
				<div class="d-flex items-center gap-2 text-sm text-secondary">
					<a href="/vendor/warehouses" class="text-brand font-bold text-decoration-none">المخازن ومواقع التخزين</a>
					<span>/</span>
					<span class="text-primary font-extrabold">{ data.Warehouse.Name }</span>
				</div>
				<div class="d-flex items-center gap-2 flex-wrap">
					<a href="/vendor/warehouses" class="btn btn-secondary btn-sm font-bold gap-1">
						@components.IconArrowRight("icon-xs")
						<span>العودة للمخازن</span>
					</a>
					<a href="/vendor/transfers" class="btn btn-secondary btn-sm font-bold gap-1">
						@components.IconRefresh("icon-xs")
						<span>التحويلات المخزنية</span>
					</a>
					<a href="/vendor/ingest" class="btn btn-secondary btn-sm font-bold gap-1">
						@components.IconPackage("icon-xs")
						<span>استيراد كشف أسعار ومخزون</span>
					</a>
					<a href="/vendor/inventory" class="btn btn-primary btn-sm font-black gap-1">
						@components.IconPackage("icon-xs")
						<span>إدارة المخزون الشامل</span>
					</a>
				</div>
			</div>

			<!-- Notice / Alert Banner -->
			if data.NoticeMsg != "" {
				<div
					class={ "alert mb-4",
						templ.KV("alert-success", data.NoticeType == "success"),
						templ.KV("alert-danger", data.NoticeType == "error"),
						templ.KV("alert-info", data.NoticeType != "success" && data.NoticeType != "error") }
					role="alert"
				>
					{ data.NoticeMsg }
				</div>
			}

			<!-- Warehouse Header Profile Card -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-start flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-2 flex-wrap">
							<div class="user-avatar-badge text-xl">
								@components.IconBuilding("icon-sm")
							</div>
       <div class="stack-sm">
								<div class="d-flex items-center gap-3 flex-wrap">
									<h1 class="text-2xl font-black text-primary m-0">
										مخزن { data.Warehouse.Name }
									</h1>
									if data.Warehouse.IsActive {
										<span class="badge badge-emerald text-xs font-black">
											نشط وجاهز للعمليات
										</span>
									} else {
										<span class="badge badge-rose text-xs font-black">
											معطل حالياً
										</span>
									}
								</div>
								<div class="text-xs text-secondary mt-1">
									مركز توزيع وموقع تخزيني للمستحضرات والأدوية
								</div>
							</div>
						</div>
						
						<div class="d-flex gap-4 flex-wrap text-xs text-secondary mt-3 pt-3 border-t">
							<div class="d-flex items-center gap-1">
								<span class="text-muted">كود المخزن:</span>
								<code class="bg-surface-sunken border p-1 px-2 rounded font-bold font-mono text-brand">{ data.Warehouse.Code }</code>
							</div>
							if data.Warehouse.BranchID != nil && *data.Warehouse.BranchID > 0 {
								<div class="d-flex items-center gap-1">
									<span class="text-muted">الفرع التابع له:</span>
									<strong class="text-primary font-bold">#{ fmt.Sprintf("%d", *data.Warehouse.BranchID) }</strong>
								</div>
							} else {
								<div class="d-flex items-center gap-1">
									<span class="text-muted">النوع:</span>
									<span class="badge badge-slate text-xs font-bold">مخزن عام رئيسي</span>
								</div>
							}
							if data.Warehouse.Address != "" {
								<div class="d-flex items-center gap-1">
									<span>@components.IconMapPin("icon-sm")</span>
									<span>{ data.Warehouse.Address }</span>
								</div>
							}
							if data.Warehouse.Phone != "" {
								<div class="d-flex items-center gap-1 tabular-nums">
									<span>@components.IconPhone("icon-sm")</span>
									<span>{ data.Warehouse.Phone }</span>
								</div>
							}
						</div>
					</div>
				</div>
			</div>

			<!-- 4 High-Impact KPI Metric Cards -->
			<div class="dashboard-stat-grid mb-6">
				<!-- Card 1: Total Items -->
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الأصناف المسجلة</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.TotalItems) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">صنف دوائي مسجل بالمخزن</span>
				</div>

				<!-- Card 2: Total Units -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">إجمالي الوحدات والعبوات</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.TotalUnits) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">عبوة / وحدة مخزنة حالياً</span>
				</div>

				<!-- Card 3: Low Stock -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-warning">أصناف قاربت النفاد</div>
					<div class="stat-card-value text-warning tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.LowStockCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">تحت حد إعادة الطلب والأمان</span>
				</div>

				<!-- Card 4: Expiring Soon / Expired -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-danger">تنبيهات الصلاحية</div>
					<div class="stat-card-value text-danger tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.ExpiringSoonCount + data.Stats.ExpiredCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">
						if data.Stats.ExpiredCount > 0 {
							<span>({ fmt.Sprintf("%d", data.Stats.ExpiredCount) } منتهي الصلاحية)</span>
						} else {
							<span>(خلال الـ 6 أشهر القادمة)</span>
						}
					</span>
				</div>
			</div>

			<!-- Filter & Control Toolbar Card -->
			<div class="glass-panel p-4 mb-6">
				<form method="GET" action={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", data.Warehouse.ID)) } class="d-flex flex-col gap-3" hx-boost="false">
					<div class="d-grid gap-3 items-end">
						
						<!-- Search Query -->
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-secondary mb-1">البحث في أصناف المخزن</label>
							<div class="position-relative">
								<input
									type="text"
									name="q"
									value={ data.Filter.Query }
									class="form-input text-xs w-full"
									placeholder="ابحث باسم الدواء، الكود SKU، الباركود، رقم التشغيلة..."
								/>
							</div>
						</div>

						<!-- Stock Status Filter -->
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-secondary mb-1">حالة الرصيد</label>
							<select name="stock_status" class="form-select text-xs w-full">
								<option value="all" selected?={ data.Filter.StockStatus == "" || data.Filter.StockStatus == "all" }>كافة الأرصدة</option>
								<option value="available" selected?={ data.Filter.StockStatus == "available" }>متوفر (فوق حد الأمان)</option>
								<option value="low" selected?={ data.Filter.StockStatus == "low" }>منخفض المخزون</option>
								<option value="out_of_stock" selected?={ data.Filter.StockStatus == "out_of_stock" }>نفد من الرصيد (0)</option>
							</select>
						</div>

						<!-- Expiry Status Filter -->
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-secondary mb-1">حالة الصلاحية</label>
							<select name="expiry_status" class="form-select text-xs w-full">
								<option value="all" selected?={ data.Filter.ExpiryStatus == "" || data.Filter.ExpiryStatus == "all" }>كافة التواريخ</option>
								<option value="expiring_soon" selected?={ data.Filter.ExpiryStatus == "expiring_soon" }>⏳ ينتهي قريباً (خلال 6 أشهر)</option>
								<option value="expired" selected?={ data.Filter.ExpiryStatus == "expired" }>منتهي الصلاحية</option>
							</select>
						</div>

						<!-- Sort Selector -->
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-secondary mb-1">الترتيب حسب</label>
							<select name="sort" class="form-select text-xs w-full">
								<option value="updated_desc" selected?={ data.Filter.Sort == "updated_desc" || data.Filter.Sort == "" }>الأحدث حركة وتحديثاً</option>
								<option value="name_asc" selected?={ data.Filter.Sort == "name_asc" }>الاسم أبجدياً (أ - ي)</option>
								<option value="name_desc" selected?={ data.Filter.Sort == "name_desc" }>الاسم عكسي (ي - أ)</option>
								<option value="qty_desc" selected?={ data.Filter.Sort == "qty_desc" }>الرصيد: من الأعلى للأقل</option>
								<option value="qty_asc" selected?={ data.Filter.Sort == "qty_asc" }>الرصيد: من الأقل للأعلى</option>
								<option value="expiry_asc" selected?={ data.Filter.Sort == "expiry_asc" }>الصلاحية: الأقرب انتهاءً أولاً</option>
							</select>
						</div>

						<!-- Filter Buttons -->
						<div class="d-flex items-center gap-2">
							<button type="submit" class="btn btn-primary text-xs font-bold px-4">
								@components.IconSearch("icon-xs")
								<span>تصفية</span>
							</button>
							if data.Filter.Query != "" || (data.Filter.StockStatus != "" && data.Filter.StockStatus != "all") || (data.Filter.ExpiryStatus != "" && data.Filter.ExpiryStatus != "all") || (data.Filter.Sort != "" && data.Filter.Sort != "updated_desc") {
								<a href={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", data.Warehouse.ID)) } class="btn btn-secondary text-xs px-3" title="إلغاء الفلاتر">
									إلغاء
								</a>
							}
						</div>
					</div>
				</form>
			</div>

			<!-- Inventory Data Table Section -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				<div class="p-4 px-6 border-b flex-between items-center flex-wrap gap-2">
     <div class="stack-sm">
						<h2 class="text-base font-extrabold text-primary m-0">
							سجل الأرصدة والمخزون الفعلي
						</h2>
						<p class="text-xs text-secondary m-0 mt-1">
							عرض تفصيلي لبيانات الأدوية، التشغيلات، تواريخ الصلاحية، وأسعار التوريد
						</p>
					</div>
					<div class="badge badge-slate text-xs font-black tabular-nums">
						إجمالي النتائج: { fmt.Sprintf("%d", data.TotalFiltered) } صنف
					</div>
				</div>

				if len(data.Stocks) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconSearch("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">
							لا توجد أصناف مطابقة لمعايير البحث
						</h3>
						<p class="text-sm text-secondary max-w-md mx-auto mb-4">
							لم نجد أي صنف مخزن يتطابق مع الفلاتر المحددة حالياً. يمكنك تعديل كلمات البحث أو تصفير الفلاتر.
						</p>
						<a href={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", data.Warehouse.ID)) } class="btn btn-secondary btn-sm font-bold">
							إعادة ضبط الفلاتر وعرض كافة الأصناف
						</a>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>#</th>
									<th>الصنف الدوائي والمواصفات</th>
									<th>الأكواد والتشغيلة والصلاحية</th>
									<th>الأسعار والخصم</th>
									<th>الرصيد الفعلي المتاح</th>
									<th class="text-center">حد الأمان</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for idx, s := range data.Stocks {
									<tr>
										<!-- Index -->
										<td class="tabular-nums text-muted text-xs">
											{ fmt.Sprintf("%d", data.FromItem + idx) }
										</td>

										<!-- Product Information -->
										<td>
											<div class="font-extrabold text-primary text-sm">
												if s.ProductName != "" {
													{ s.ProductName }
												} else if s.VariantName != "" {
													{ s.VariantName }
												} else {
													{ fmt.Sprintf("الصنف #%d", s.ProductID) }
												}
											</div>
											
											if s.VariantName != "" && s.VariantName != s.ProductName {
												<div class="text-xs text-brand font-bold mt-1">
													{ s.VariantName }
												</div>
											}

											if s.ScientificName != "" {
												<div class="text-xs text-muted mt-1">
													{ s.ScientificName }
												</div>
											}

											<div class="d-flex items-center gap-1 mt-1 flex-wrap">
												if s.DosageForm != "" {
													<span class="badge badge-slate text-xs">
														{ s.DosageForm }
													</span>
												}
												if s.Manufacturer != "" {
													<span class="badge badge-slate text-xs">
														{ s.Manufacturer }
													</span>
												}
											</div>
										</td>

										<!-- Codes, Batch & Expiry -->
										<td>
											if s.SKU != "" || s.Barcode != "" {
												<div class="d-flex items-center gap-1 flex-wrap mb-1">
													if s.SKU != "" {
														<code class="bg-surface-sunken border p-1 rounded text-xs font-mono">SKU: { s.SKU }</code>
													}
													if s.Barcode != "" {
														<code class="bg-surface-sunken border p-1 rounded text-xs font-mono">باركود: { s.Barcode }</code>
													}
												</div>
											}

											if s.BatchNumber != "" {
												<div class="text-xs text-muted tabular-nums mt-1">
													تشغيلة: <strong class="text-primary font-bold">{ s.BatchNumber }</strong>
												</div>
											}

											if s.ExpiryDate != nil {
												<div class="mt-1">
													if isExpired(s.ExpiryDate) {
														<span class="badge badge-rose text-xs tabular-nums font-black" title="صلاحية منتهية">
															منتهي: { s.ExpiryDate.Format("2006-01-02") }
														</span>
													} else if isExpiringSoon(s.ExpiryDate) {
														<span class="badge badge-amber text-xs tabular-nums font-black" title="ينتهي قريباً خلال 6 أشهر">
															ينتهي: { s.ExpiryDate.Format("2006-01-02") }
														</span>
													} else {
														<span class="text-xs text-muted tabular-nums">
															الصلاحية: { s.ExpiryDate.Format("2006-01-02") }
														</span>
													}
												</div>
											}
										</td>

										<!-- Pricing -->
										<td>
											<div class="tabular-nums font-black text-sm text-primary">
												{ s.PriceStr } <span class="text-xs font-bold text-secondary">ج.م</span>
											</div>
											if s.PublicPriceStr != "" && s.PublicPriceStr != "0.00" && s.PublicPriceStr != s.PriceStr {
												<div class="tabular-nums text-xs text-muted line-through mt-1">
													الجمهور: { s.PublicPriceStr } ج.م
												</div>
											}
											if s.DiscountStr != "" && s.DiscountStr != "0.00" && s.DiscountStr != "0" {
												<div class="badge badge-emerald text-xs tabular-nums font-black mt-1 d-inline-block">
													خصم { s.DiscountStr }%
												</div>
											}
										</td>

										<!-- Actual Stock Balance -->
										<td>
											if s.Quantity == 0 {
												<div class="badge badge-rose text-xs font-black tabular-nums">
													0 عبوة (نافد)
												</div>
											} else if s.Quantity <= s.MinThreshold {
            <div class="stack-sm">
													<span class="badge badge-amber text-xs font-black tabular-nums">
														{ fmt.Sprintf("%d", s.Quantity) } عبوة
													</span>
													<div class="text-xs text-warning font-bold mt-1">
														مخزون منخفض
													</div>
												</div>
											} else {
												<span class="badge badge-emerald text-xs font-black tabular-nums">
													{ fmt.Sprintf("%d", s.Quantity) } عبوة
												</span>
											}
										</td>

										<!-- Reorder Threshold -->
										<td class="tabular-nums text-center">
											<span class="badge badge-slate text-xs font-bold">
												{ fmt.Sprintf("%d", s.MinThreshold) }
											</span>
										</td>

										<!-- Actions -->
										<td class="text-end">
											<div class="d-flex items-center justify-end gap-2">
												<button
													type="button"
													class="btn btn-secondary btn-sm font-black text-xs px-3"
													@click={ fmt.Sprintf("adjustStock = { id: %d, name: %q, batch: %q, qty: %d, min: %d }; adjustModal = true;", s.StockID, func() string { if s.ProductName != "" { return s.ProductName }; return s.VariantName }(), s.BatchNumber, s.Quantity, s.MinThreshold) }
													title="تعديل الرصيد الفعلي لهذا الصنف"
												>
													<span>تعديل</span>
												</button>
												<a href="/vendor/products" class="btn btn-ghost btn-sm text-xs font-bold" title="عرض في قائمة الأصناف">
													↗
												</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Pagination Footer -->
					<div class="p-4 px-6 border-t flex-between items-center flex-wrap gap-4">
						<div class="text-xs text-muted font-bold tabular-nums">
							عرض من <strong>{ fmt.Sprintf("%d", data.FromItem) }</strong> إلى <strong>{ fmt.Sprintf("%d", data.ToItem) }</strong> من إجمالي <strong>{ fmt.Sprintf("%d", data.TotalFiltered) }</strong> صنف (صفحة { fmt.Sprintf("%d", data.Filter.Page) } من { fmt.Sprintf("%d", data.TotalPages) })
						</div>

						if data.TotalPages > 1 {
							<div class="d-flex items-center gap-1">
								<!-- Previous Page Button -->
								if data.Filter.Page > 1 {
									<a
										href={ templ.SafeURL(buildWarehouseInventoryURL(data.Warehouse.ID, data.Filter, data.Filter.Page-1, data.Filter.PerPage)) }
										class="btn btn-secondary btn-sm font-bold text-xs"
									>
										السابق
									</a>
								} else {
									<button type="button" class="btn btn-secondary btn-sm text-xs" disabled>السابق</button>
								}

								<!-- Page Numbers -->
								for p := 1; p <= data.TotalPages; p++ {
									if p == data.Filter.Page {
										<span class="btn btn-primary btn-sm font-black tabular-nums text-xs">
											{ fmt.Sprintf("%d", p) }
										</span>
									} else if p <= 3 || p >= data.TotalPages - 2 || (p >= data.Filter.Page - 1 && p <= data.Filter.Page + 1) {
										<a
											href={ templ.SafeURL(buildWarehouseInventoryURL(data.Warehouse.ID, data.Filter, p, data.Filter.PerPage)) }
											class="btn btn-secondary btn-sm tabular-nums font-bold text-xs"
										>
											{ fmt.Sprintf("%d", p) }
										</a>
									} else if p == 4 && data.Filter.Page > 4 {
										<span class="text-muted px-1 text-xs">...</span>
									} else if p == data.TotalPages - 3 && data.Filter.Page < data.TotalPages - 3 {
										<span class="text-muted px-1 text-xs">...</span>
									}
								}

								<!-- Next Page Button -->
								if data.Filter.Page < data.TotalPages {
									<a
										href={ templ.SafeURL(buildWarehouseInventoryURL(data.Warehouse.ID, data.Filter, data.Filter.Page+1, data.Filter.PerPage)) }
										class="btn btn-secondary btn-sm font-bold text-xs"
									>
										التالي
									</a>
								} else {
									<button type="button" class="btn btn-secondary btn-sm text-xs" disabled>التالي</button>
								}
							</div>
						}
					</div>
				}
			</div>

			<!-- Quick Stock Adjustment Modal -->
			<div class="stack-sm"
				x-show="adjustModal"
				x-cloak
				@keydown.escape.window="adjustModal = false"
				@click.self="adjustModal = false"
			>
				<div
					class="glass-panel p-6"
				>
					<div class="flex-between items-center mb-4 pb-2 border-b">
      <div class="stack-sm">
							<h3 class="text-base font-black text-primary m-0">
								تعديل رصيد الصنف بالمخزن
							</h3>
							<p class="text-xs text-secondary m-0 mt-1">
								تسجيل تسوية جردية أو تصحيح الكمية المتاحة فعلياً
							</p>
						</div>
						<button type="button" @click="adjustModal = false" class="btn btn-secondary btn-icon btn-sm">&times;</button>
					</div>

					<form :action={ fmt.Sprintf("'/vendor/warehouses/%d/stocks/' + adjustStock.id + '/adjust'", data.Warehouse.ID) } method="POST" class="d-flex flex-col gap-4">
						<!-- Product Summary Header -->
						<div class="p-3 bg-surface-sunken rounded-lg border">
							<div class="text-xs text-muted font-bold mb-1">الصنف المختار:</div>
							<div class="font-extrabold text-primary text-sm" x-text="adjustStock.name"></div>
							<div class="d-flex gap-3 mt-1 text-xs text-secondary" x-show="adjustStock.batch">
								<span>رقم التشغيلة: <strong class="text-primary tabular-nums" x-text="adjustStock.batch"></strong></span>
							</div>
						</div>

						<!-- Current vs New Quantity -->
						<div class="d-grid gap-3" class="grid-cols-2">
       <div class="stack-sm">
								<label class="form-label text-xs font-bold text-secondary mb-1">الرصيد الحالي بالمخزن</label>
								<div class="form-input text-center font-black tabular-nums text-muted bg-surface-sunken text-sm flex-center" x-text="adjustStock.qty + ' عبوة'"></div>
							</div>

       <div class="stack-sm">
								<label class="form-label text-xs font-bold text-brand mb-1">الرصيد الفعلي الجديد <span class="text-danger">*</span></label>
								<input
									type="number"
									name="new_quantity"
									min="0"
									required
									class="form-input text-center font-black tabular-nums text-sm w-full"
									:value="adjustStock.qty"
									placeholder="0"
								/>
							</div>
						</div>

						<!-- Reason for Adjustment -->
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-secondary mb-1">سبب التسوية / التعديل <span class="text-danger">*</span></label>
							<select name="reason" class="form-select text-xs w-full" required>
								<option value="جرد دوري ومطابقة فعلية">جرد دوري ومطابقة فعلية</option>
								<option value="استلام شحنة إضافية / توريد">استلام شحنة إضافية / توريد</option>
								<option value="تسوية تلفيات أو إرجاع مورد">تسوية تلفيات أو إرجاع مورد</option>
								<option value="تصحيح خطأ في إدخال الرصيد السابق">تصحيح خطأ في إدخال الرصيد السابق</option>
								<option value="تسوية أخرى">تسوية أخرى</option>
							</select>
						</div>

						<div class="d-flex items-center justify-end gap-3 mt-2">
							<button type="button" class="btn btn-secondary text-xs" @click="adjustModal = false">إلغاء</button>
							<button type="submit" class="btn btn-primary text-xs font-bold">حفظ وتحديث الرصيد فورياً</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}


