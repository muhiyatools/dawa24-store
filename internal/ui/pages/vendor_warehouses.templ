package pages

import (
	"fmt"
	"net/url"
	"time"

	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorWarehousesPage renders the list of vendor warehouses.
templ VendorWarehousesPage(warehouses []*inventory.Warehouse, branches []*org.Branch, lang, dir string) {
	@layouts.VendorShell("المخازن ومواقع التخزين", "warehouses", lang, dir) {
		<div x-data="{ showAddModal: false, editModal: false, editWh: { id: 0, name: '', code: '', address: '', phone: '', branch_id: 0, is_active: true } }" class="space-y-6">
			
			<!-- Header & Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem;">
				<div>
					<h1 class="text-2xl fw-800 text-primary m-0">مخازن ومواقع تخزين المنشأة</h1>
					<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
						إدارة مراكز التخزين، ربطها بالفروع التوزيعية، ومتابعة الأرصدة والتحويلات.
					</p>
				</div>
				<div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
					<a href="/vendor/transfers" class="btn btn-secondary btn-sm">
						@components.IconRefresh("icon-xs")
						<span>التحويلات المخزنية</span>
					</a>
					<button type="button" class="btn btn-primary btn-sm" @click="showAddModal = true">
						@components.IconPlus("icon-xs")
						<span>إضافة مخزن جديد</span>
					</button>
				</div>
			</div>

			<!-- Quick Metric Stat Cards -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
				<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="form-label">إجمالي المخازن</div>
					<div style="font-size:1.65rem; font-weight:900; color:var(--text);" class="tabular-nums">{ fmt.Sprintf("%d", len(warehouses)) }</div>
				</div>

				<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="form-label">المخازن النشطة</div>
					<div style="font-size:1.65rem; font-weight:900; color:var(--success-text);" class="tabular-nums">
						{ fmt.Sprintf("%d", func() int {
							c := 0
							for _, w := range warehouses {
								if w.IsActive { c++ }
							}
							return c
						}()) }
					</div>
				</div>

				<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="form-label">الفروع التوزيعية</div>
					<div style="font-size:1.65rem; font-weight:900; color:var(--accent);" class="tabular-nums">{ fmt.Sprintf("%d", len(branches)) }</div>
				</div>
			</div>

			<!-- Warehouses Table Card -->
			<div class="card mb-0" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem;">
				if len(warehouses) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:       "لا توجد مخازن مسجلة",
						Message:     "يمكنك تسجيل مخازن جديدة لتخزين الأدوية وربطها بالفروع التوزيعية.",
						ActionLabel: "إضافة مخزن جديد",
					})
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th>المخزن</th>
									<th>الكود</th>
									<th>الفرع المرتبط</th>
									<th>العنوان ورقم التواصل</th>
									<th>الحالة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, w := range warehouses {
									<tr>
										<td>
											<div class="row-center-sm">
												<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
													@components.IconBuilding("icon-xs")
												</div>
												<div>
													<strong style="color:var(--text); font-size:0.95rem;">{ w.Name }</strong>
													<div class="text-xs text-muted">ID #{ fmt.Sprintf("%d", w.ID) }</div>
												</div>
											</div>
										</td>
										<td>
											<code style="background:var(--surface-sunken); padding:0.2rem 0.5rem; border-radius:var(--radius-sm); font-size:0.825rem;">{ w.Code }</code>
										</td>
										<td>
											if w.BranchID != nil && *w.BranchID > 0 {
												<span class="badge badge-sky text-sm">
													فرع #{ fmt.Sprintf("%d", *w.BranchID) }
												</span>
											} else {
												<span class="text-muted text-sm">مخزن عام</span>
											}
										</td>
										<td>
											<div style="font-size:0.825rem; color:var(--text);">
												if w.Address != "" {
													<div>{ w.Address }</div>
												}
												if w.Phone != "" {
													<div class="text-xs text-muted tabular-nums">📞 { w.Phone }</div>
												}
											</div>
										</td>
										<td>
											if w.IsActive {
												<span class="badge badge-emerald">نشط</span>
											} else {
												<span class="badge badge-rose">معطل</span>
											}
										</td>
										<td class="text-end">
											<div style="display:flex; justify-content:flex-end; align-items:center; gap:0.4rem;">
												<a href={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", w.ID)) } class="btn btn-secondary btn-sm" title="عرض الأصناف والأرصدة">
													@components.IconPackage("icon-xs")
													<span>عرض المخزون</span>
												</a>
												<button
													type="button"
													class="btn btn-secondary btn-sm"
													@click={ fmt.Sprintf("editWh = { id: %d, name: %q, code: %q, address: %q, phone: %q, branch_id: %d, is_active: %t }; editModal = true;", w.ID, w.Name, w.Code, w.Address, w.Phone, func() int64 { if w.BranchID != nil { return *w.BranchID }; return 0 }(), w.IsActive) }
												>
													تعديل
												</button>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d/toggle", w.ID)) } class="m-0">
													<button type="submit" class="btn btn-secondary btn-sm text-muted">
														if w.IsActive {
															تعطيل
														} else {
															تفعيل
														}
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Add Warehouse Modal -->
			<div
				x-show="showAddModal"
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.6); display:flex; align-items:center; justify-content:center; padding:1rem;"
				x-cloak
				@keydown.escape.window="showAddModal = false"
			>
				<div
					@click.away="showAddModal = false"
					class="card mb-0"
					style="max-width:560px; width:100%; max-height:90vh; overflow-y:auto; padding:1.75rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
						<h3 class="text-lg fw-800 text-primary m-0">إضافة مخزن / مركز تخزين جديد</h3>
						<button type="button" @click="showAddModal = false" class="btn btn-secondary btn-icon btn-sm">&times;</button>
					</div>

					<form method="POST" action="/vendor/warehouses" class="stack-lg">
						<div class="form-group mb-0">
							<label class="form-label">اسم المخزن <span class="text-danger">*</span></label>
							<input type="text" name="name" required class="form-input" placeholder="مثلاً: مخزن القاهرة الرئيسي / مخزن مدينة نصر" />
						</div>

						<div class="form-group mb-0">
							<label class="form-label">كود المخزن (اختياري)</label>
							<input type="text" name="code" class="form-input" placeholder="WH-01" />
						</div>

						<div class="form-group mb-0">
							<label class="form-label">الفرع التوزيعي المرتبط</label>
							<select name="branch_id" class="form-select">
								<option value="">بدون فرع محدد (مخزن رئيسي)</option>
								for _, b := range branches {
									<option value={ fmt.Sprintf("%d", b.ID) }>
										if b.Name["ar"] != "" {
											{ b.Name["ar"] }
										} else {
											{ b.Name["en"] }
										}
										(فرع #{ fmt.Sprintf("%d", b.ID) })
									</option>
								}
							</select>
						</div>

						<div class="form-group mb-0">
							<label class="form-label">العنوان بالتفصيل</label>
							<input type="text" name="address" class="form-input" placeholder="المنطقة الصناعية، القطعة 14، القاهرة" />
						</div>

						<div class="form-group mb-0">
							<label class="form-label">رقم الهاتف والتواصل</label>
							<input type="text" name="phone" class="form-input" placeholder="01012345678" />
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" @click="showAddModal = false">إلغاء</button>
							<button type="submit" class="btn btn-primary">حفظ وتفعيل المخزن</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Edit Warehouse Modal -->
			<div
				x-show="editModal"
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.6); display:flex; align-items:center; justify-content:center; padding:1rem;"
				x-cloak
				@keydown.escape.window="editModal = false"
			>
				<div
					@click.away="editModal = false"
					class="card mb-0"
					style="max-width:560px; width:100%; max-height:90vh; overflow-y:auto; padding:1.75rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
						<h3 class="text-lg fw-800 text-primary m-0">تعديل بيانات المخزن</h3>
						<button type="button" @click="editModal = false" class="btn btn-secondary btn-icon btn-sm">&times;</button>
					</div>

					<form :action="'/vendor/warehouses/' + editWh.id" method="POST" class="stack-lg">
						<div class="form-group mb-0">
							<label class="form-label">اسم المخزن <span class="text-danger">*</span></label>
							<input type="text" name="name" x-model="editWh.name" required class="form-input" />
						</div>

						<div class="form-group mb-0">
							<label class="form-label">كود المخزن</label>
							<input type="text" name="code" x-model="editWh.code" class="form-input" />
						</div>

						<div class="form-group mb-0">
							<label class="form-label">الفرع التوزيعي المرتبط</label>
							<select name="branch_id" x-model="editWh.branch_id" class="form-select">
								<option value="0">بدون فرع محدد (مخزن رئيسي)</option>
								for _, b := range branches {
									<option value={ fmt.Sprintf("%d", b.ID) }>
										if b.Name["ar"] != "" {
											{ b.Name["ar"] }
										} else {
											{ b.Name["en"] }
										}
										(فرع #{ fmt.Sprintf("%d", b.ID) })
									</option>
								}
							</select>
						</div>

						<div class="form-group mb-0">
							<label class="form-label">العنوان بالتفصيل</label>
							<input type="text" name="address" x-model="editWh.address" class="form-input" />
						</div>

						<div class="form-group mb-0">
							<label class="form-label">رقم الهاتف والتواصل</label>
							<input type="text" name="phone" x-model="editWh.phone" class="form-input" />
						</div>

						<div class="form-group mb-0">
							<label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
								<input type="checkbox" name="is_active" value="true" x-model="editWh.is_active" style="accent-color:var(--accent); width:16px; height:16px;" />
								<span style="font-weight:600; font-size:0.875rem; color:var(--text);">المخزن مفعل ونشط لإدارة المخزون</span>
							</label>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" @click="editModal = false">إلغاء</button>
							<button type="submit" class="btn btn-primary">حفظ التغييرات</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}

// VendorWarehouseStockFilter carries search, status, sorting, and pagination parameters.
type VendorWarehouseStockFilter struct {
	Query        string
	StockStatus  string
	ExpiryStatus string
	Sort         string
	Page         int
	PerPage      int
}

// VendorWarehouseStats calculates inventory analytics for a single warehouse.
type VendorWarehouseStats struct {
	TotalItems        int
	TotalUnits        int
	LowStockCount     int
	OutOfStockCount   int
	ExpiringSoonCount int
	ExpiredCount      int
}

// VendorWarehouseDetailData contains all context needed to render warehouse stock management.
type VendorWarehouseDetailData struct {
	Warehouse     *inventory.Warehouse
	Stocks        []*inventory.DetailedWarehouseStockView
	Stats         VendorWarehouseStats
	Filter        VendorWarehouseStockFilter
	TotalFiltered int
	TotalPages    int
	FromItem      int
	ToItem        int
	NoticeType    string
	NoticeMsg     string
}

func buildWarehouseInventoryURL(whID int64, f VendorWarehouseStockFilter, page, perPage int) string {
	q := url.Values{}
	if f.Query != "" {
		q.Set("q", f.Query)
	}
	if f.StockStatus != "" && f.StockStatus != "all" {
		q.Set("stock_status", f.StockStatus)
	}
	if f.ExpiryStatus != "" && f.ExpiryStatus != "all" {
		q.Set("expiry_status", f.ExpiryStatus)
	}
	if f.Sort != "" && f.Sort != "updated_desc" {
		q.Set("sort", f.Sort)
	}
	if page > 1 {
		q.Set("page", fmt.Sprint(page))
	}
	if perPage > 0 && perPage != 20 {
		q.Set("limit", fmt.Sprint(perPage))
	}
	qs := q.Encode()
	if qs != "" {
		return fmt.Sprintf("/vendor/warehouses/%d?%s", whID, qs)
	}
	return fmt.Sprintf("/vendor/warehouses/%d", whID)
}

func isExpiringSoon(exp *time.Time) bool {
	if exp == nil {
		return false
	}
	now := time.Now()
	sixMonths := now.AddDate(0, 6, 0)
	return exp.After(now) && exp.Before(sixMonths)
}

func isExpired(exp *time.Time) bool {
	if exp == nil {
		return false
	}
	return exp.Before(time.Now())
}

// VendorWarehouseDetailPage renders complete warehouse inventory details, filters, KPIs, and stock adjustment tools.
templ VendorWarehouseDetailPage(data VendorWarehouseDetailData, lang, dir string) {
	@layouts.VendorShell(fmt.Sprintf("مخزن: %s | جرد المخزون", data.Warehouse.Name), "warehouses", lang, dir) {
		<div x-data="{ adjustModal: false, adjustStock: { id: 0, name: '', batch: '', qty: 0, min: 0 } }" class="space-y-6">
			
			<!-- Breadcrumb & Top Action Navigation -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div class="row-center-sm gap-xs text-sm text-muted">
					<a href="/vendor/warehouses" class="text-primary fw-700">المخازن ومواقع التخزين</a>
					<span>/</span>
					<span class="text-foreground fw-800">{ data.Warehouse.Name }</span>
				</div>
				<div class="row-center gap-xs flex-wrap">
					<a href="/vendor/warehouses" class="btn btn-secondary btn-sm">
						@components.IconArrowRight("icon-xs")
						<span>العودة للمخازن</span>
					</a>
					<a href="/vendor/transfers" class="btn btn-secondary btn-sm">
						@components.IconRefresh("icon-xs")
						<span>التحويلات المخزنية</span>
					</a>
					<a href="/vendor/ingest" class="btn btn-secondary btn-sm">
						@components.IconPackage("icon-xs")
						<span>استيراد كشف أسعار ومخزون</span>
					</a>
					<a href="/vendor/inventory" class="btn btn-primary btn-sm">
						@components.IconPackage("icon-xs")
						<span>إدارة المخزون الشامل</span>
					</a>
				</div>
			</div>

			<!-- Notice / Alert Banner -->
			if data.NoticeMsg != "" {
				<div
					class={ "alert",
						templ.KV("alert-success", data.NoticeType == "success"),
						templ.KV("alert-danger", data.NoticeType == "error"),
						templ.KV("alert-info", data.NoticeType != "success" && data.NoticeType != "error") }
					role="alert"
				>
					{ data.NoticeMsg }
				</div>
			}

			<!-- Warehouse Header Profile Card -->
			<div class="card mb-0" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem;">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem;">
					<div>
						<div class="row-center-sm gap-sm mb-sm flex-wrap">
							<div class="b2b-icon-box-sm" style="background:var(--accent-subtle); color:var(--accent); width:40px; height:40px; border-radius:var(--radius-lg); display:flex; align-items:center; justify-content:center;">
								@components.IconBuilding("icon-sm")
							</div>
							<h1 style="font-size:1.5rem; font-weight:900; color:var(--text); margin:0;">
								مخزن { data.Warehouse.Name }
							</h1>
							if data.Warehouse.IsActive {
								<span class="badge badge-emerald">🟢 نشط وجاهز للعمليات</span>
							} else {
								<span class="badge badge-rose">🔴 معطل حالياً</span>
							}
						</div>
						<div style="display:flex; gap:1.5rem; flex-wrap:wrap; font-size:0.875rem; color:var(--text-secondary); margin-top:0.6rem;">
							<div>كود المخزن: <code style="background:var(--surface-sunken); padding:0.2rem 0.6rem; border-radius:var(--radius-md); font-weight:700;">{ data.Warehouse.Code }</code></div>
							if data.Warehouse.BranchID != nil && *data.Warehouse.BranchID > 0 {
								<div>🏢 مرتبط بالفرع رقم: <strong>#{ fmt.Sprintf("%d", *data.Warehouse.BranchID) }</strong></div>
							} else {
								<div>🏢 مخزن عام رئيسي للمنشأة</div>
							}
							if data.Warehouse.Address != "" {
								<div>📍 { data.Warehouse.Address }</div>
							}
							if data.Warehouse.Phone != "" {
								<div class="tabular-nums">📞 { data.Warehouse.Phone }</div>
							}
						</div>
					</div>
				</div>
			</div>

			<!-- 4 High-Impact KPI Metric Cards -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem;">
				<!-- Card 1: Total Items -->
				<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="row-center-sm gap-xs text-muted text-xs fw-700 mb-1">
						<span>📦</span>
						<span>إجمالي الأصناف المسجلة</span>
					</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--text);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.TotalItems) }
						<span style="font-size:0.9rem; font-weight:600; color:var(--text-muted);">صنف دوائي</span>
					</div>
				</div>

				<!-- Card 2: Total Units -->
				<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="row-center-sm gap-xs text-muted text-xs fw-700 mb-1">
						<span>📊</span>
						<span>إجمالي الوحدات والعبوات</span>
					</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--primary);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.TotalUnits) }
						<span style="font-size:0.9rem; font-weight:600; color:var(--text-muted);">عبوة / وحدة</span>
					</div>
				</div>

				<!-- Card 3: Low Stock -->
				<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="row-center-sm gap-xs text-muted text-xs fw-700 mb-1">
						<span>⚠️</span>
						<span>أصناف قاربت النفاد</span>
					</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--warning-text, #d97706);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.LowStockCount) }
						<span style="font-size:0.9rem; font-weight:600; color:var(--text-muted);">تحت حد الأمان</span>
					</div>
				</div>

				<!-- Card 4: Expiring Soon / Expired -->
				<div class="card mb-0" style="padding:1.25rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl);">
					<div class="row-center-sm gap-xs text-muted text-xs fw-700 mb-1">
						<span>⏳</span>
						<span>تنبيهات الصلاحية</span>
					</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--danger-text, #dc2626);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Stats.ExpiringSoonCount + data.Stats.ExpiredCount) }
						<span style="font-size:0.9rem; font-weight:600; color:var(--text-muted);">
							if data.Stats.ExpiredCount > 0 {
								({ fmt.Sprintf("%d", data.Stats.ExpiredCount) } منتهي)
							} else {
								(خلال 6 أشهر)
							}
						</span>
					</div>
				</div>
			</div>

			<!-- Filter & Control Toolbar Card -->
			<div class="card mb-0" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem;">
				<form method="GET" action={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", data.Warehouse.ID)) } class="stack-md" hx-boost="false">
					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:0.85rem; align-items:flex-end;">
						
						<!-- Search Query -->
						<div style="grid-column: span 2; min-width:260px;">
							<label class="form-label text-xs fw-700">البحث في المخزن</label>
							<div style="position:relative;">
								<input
									type="text"
									name="q"
									value={ data.Filter.Query }
									class="form-input"
									placeholder="ابحث باسم الدواء، الكود SKU، الباركود، رقم التشغيلة، المادة الفعالة..."
									style="padding-inline-start:2.25rem; height:42px;"
								/>
								<span style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:0.95rem; pointer-events:none;">
									🔍
								</span>
							</div>
						</div>

						<!-- Stock Status Filter -->
						<div>
							<label class="form-label text-xs fw-700">حالة الرصيد</label>
							<select name="stock_status" class="form-select" style="height:42px;">
								<option value="all" selected?={ data.Filter.StockStatus == "" || data.Filter.StockStatus == "all" }>كافة الأرصدة</option>
								<option value="available" selected?={ data.Filter.StockStatus == "available" }>🟢 متوفر (فوق حد الأمان)</option>
								<option value="low" selected?={ data.Filter.StockStatus == "low" }>🟡 منخفض المخزون</option>
								<option value="out_of_stock" selected?={ data.Filter.StockStatus == "out_of_stock" }>🔴 نفد من الرصيد (0)</option>
							</select>
						</div>

						<!-- Expiry Status Filter -->
						<div>
							<label class="form-label text-xs fw-700">حالة الصلاحية</label>
							<select name="expiry_status" class="form-select" style="height:42px;">
								<option value="all" selected?={ data.Filter.ExpiryStatus == "" || data.Filter.ExpiryStatus == "all" }>كافة التواريخ</option>
								<option value="expiring_soon" selected?={ data.Filter.ExpiryStatus == "expiring_soon" }>⏳ ينتهي قريباً (خلال 6 أشهر)</option>
								<option value="expired" selected?={ data.Filter.ExpiryStatus == "expired" }>⛔ منتهي الصلاحية</option>
							</select>
						</div>

						<!-- Sort Selector -->
						<div>
							<label class="form-label text-xs fw-700">الترتيب حسب</label>
							<select name="sort" class="form-select" style="height:42px;">
								<option value="updated_desc" selected?={ data.Filter.Sort == "updated_desc" || data.Filter.Sort == "" }>الأحدث حركة وتحديثاً</option>
								<option value="name_asc" selected?={ data.Filter.Sort == "name_asc" }>الاسم أبجدياً (أ - ي)</option>
								<option value="name_desc" selected?={ data.Filter.Sort == "name_desc" }>الاسم عكسي (ي - أ)</option>
								<option value="qty_desc" selected?={ data.Filter.Sort == "qty_desc" }>الرصيد: من الأعلى للأقل</option>
								<option value="qty_asc" selected?={ data.Filter.Sort == "qty_asc" }>الرصيد: من الأقل للأعلى</option>
								<option value="expiry_asc" selected?={ data.Filter.Sort == "expiry_asc" }>الصلاحية: الأقرب انتهاءً أولاً</option>
							</select>
						</div>

						<!-- Per Page Selector -->
						<div>
							<label class="form-label text-xs fw-700">عدد السجلات</label>
							<select name="limit" class="form-select" style="height:42px;">
								<option value="10" selected?={ data.Filter.PerPage == 10 }>10 لكل صفحة</option>
								<option value="20" selected?={ data.Filter.PerPage == 20 || data.Filter.PerPage == 0 }>20 لكل صفحة</option>
								<option value="50" selected?={ data.Filter.PerPage == 50 }>50 لكل صفحة</option>
								<option value="100" selected?={ data.Filter.PerPage == 100 }>100 لكل صفحة</option>
							</select>
						</div>

						<!-- Filter Buttons -->
						<div class="row-center gap-xs">
							<button type="submit" class="btn btn-primary fw-800" style="height:42px; flex:1;">
								تطبيق التصفية
							</button>
							if data.Filter.Query != "" || (data.Filter.StockStatus != "" && data.Filter.StockStatus != "all") || (data.Filter.ExpiryStatus != "" && data.Filter.ExpiryStatus != "all") || (data.Filter.Sort != "" && data.Filter.Sort != "updated_desc") {
								<a href={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", data.Warehouse.ID)) } class="btn btn-secondary" style="height:42px;" title="إلغاء الفلاتر">
									إعادة تعيين
								</a>
							}
						</div>
					</div>
				</form>
			</div>

			<!-- Inventory Data Table Section -->
			<div class="card mb-0" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
					<div>
						<h2 class="text-lg fw-900 text-primary m-0">الأصناف والأرصدة الفعلية في المخزن</h2>
						<p class="text-xs text-muted mb-0 mt-1">
							عرض تفصيلي لبيانات الأدوية، التشغيلات، تواريخ الصلاحية، وأسعار التوريد.
						</p>
					</div>
					<div class="badge badge-slate text-xs fw-800 tabular-nums">
						إجمالي النتائج: { fmt.Sprintf("%d", data.TotalFiltered) } صنف
					</div>
				</div>

				if len(data.Stocks) == 0 {
					<div style="padding:3rem 1.5rem; text-align:center;">
						<div style="font-size:2.5rem; margin-bottom:0.75rem;">🔍</div>
						<h3 class="fw-800 text-foreground mb-1">لا توجد أصناف مطابقة لمعايير البحث</h3>
						<p class="text-sm text-muted mb-3">
							لم نجد أي صنف مخزن يتطابق مع الفلاتر المحددة حالياً. يمكنك تعديل كلمات البحث أو تصفير الفلاتر.
						</p>
						<a href={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", data.Warehouse.ID)) } class="btn btn-secondary btn-sm">
							إعادة ضبط الفلاتر وعرض كافة الأصناف
						</a>
					</div>
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th style="width:50px;">#</th>
									<th style="min-width:240px;">الصنف الدوائي والمواصفات</th>
									<th style="min-width:180px;">الأكواد والتشغيلة والصلاحية</th>
									<th style="min-width:140px;">الأسعار والخصم</th>
									<th style="min-width:140px;">الرصيد الفعلي المتاح</th>
									<th style="min-width:100px;">حد الأمان</th>
									<th class="text-end" style="min-width:120px;">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for idx, s := range data.Stocks {
									<tr>
										<!-- Index -->
										<td class="tabular-nums text-muted text-xs">
											{ fmt.Sprintf("%d", data.FromItem + idx) }
										</td>

										<!-- Product Information -->
										<td>
											<div class="fw-800 text-foreground" style="font-size:0.95rem;">
												if s.ProductName != "" {
													{ s.ProductName }
												} else if s.VariantName != "" {
													{ s.VariantName }
												} else {
													{ fmt.Sprintf("الصنف #%d", s.ProductID) }
												}
											</div>
											
											if s.VariantName != "" && s.VariantName != s.ProductName {
												<div class="text-xs text-primary fw-600 mt-0.5">
													{ s.VariantName }
												</div>
											}

											if s.ScientificName != "" {
												<div class="text-xs text-muted mt-0.5">
													🧪 { s.ScientificName }
												</div>
											}

											<div class="row-center-sm gap-xs mt-1 flex-wrap">
												if s.DosageForm != "" {
													<span class="badge badge-slate text-xs" style="padding:0.15rem 0.45rem;">
														💊 { s.DosageForm }
													</span>
												}
												if s.Manufacturer != "" {
													<span class="badge badge-slate text-xs" style="padding:0.15rem 0.45rem;">
														🏭 { s.Manufacturer }
													</span>
												}
											</div>
										</td>

										<!-- Codes, Batch & Expiry -->
										<td>
											if s.SKU != "" || s.Barcode != "" {
												<div class="row-center-sm gap-xs flex-wrap mb-1">
													if s.SKU != "" {
														<code style="background:var(--surface-sunken); padding:0.15rem 0.4rem; border-radius:var(--radius-sm); font-size:0.75rem;">SKU: { s.SKU }</code>
													}
													if s.Barcode != "" {
														<code style="background:var(--surface-sunken); padding:0.15rem 0.4rem; border-radius:var(--radius-sm); font-size:0.75rem;">باركود: { s.Barcode }</code>
													}
												</div>
											}

											if s.BatchNumber != "" {
												<div class="text-xs text-muted tabular-nums">
													تشغيلة: <strong class="text-foreground">{ s.BatchNumber }</strong>
												</div>
											}

											if s.ExpiryDate != nil {
												<div class="mt-1">
													if isExpired(s.ExpiryDate) {
														<span class="badge badge-rose text-xs tabular-nums" title="صلاحية منتهية">
															⛔ منتهي: { s.ExpiryDate.Format("2006-01-02") }
														</span>
													} else if isExpiringSoon(s.ExpiryDate) {
														<span class="badge badge-amber text-xs tabular-nums" title="ينتهي قريباً خلال 6 أشهر">
															⚠️ ينتهي: { s.ExpiryDate.Format("2006-01-02") }
														</span>
													} else {
														<span class="text-xs text-muted tabular-nums">
															📅 الصلاحية: { s.ExpiryDate.Format("2006-01-02") }
														</span>
													}
												</div>
											}
										</td>

										<!-- Pricing -->
										<td>
											<div class="text-sm fw-800 text-foreground tabular-nums">
												{ s.PriceStr } ج.م
											</div>
											if s.PublicPriceStr != "" && s.PublicPriceStr != "0.00" && s.PublicPriceStr != s.PriceStr {
												<div class="text-xs text-muted tabular-nums">
													الجمهور: { s.PublicPriceStr } ج.م
												</div>
											}
											if s.DiscountStr != "" && s.DiscountStr != "0.00" && s.DiscountStr != "0" {
												<div class="badge badge-emerald text-xs tabular-nums mt-0.5" style="padding:0.1rem 0.35rem;">
													خصم { s.DiscountStr }%
												</div>
											}
										</td>

										<!-- Actual Stock Balance -->
										<td>
											if s.Quantity == 0 {
												<div class="badge badge-rose text-sm fw-900 tabular-nums">
													0 عبوة (نافد)
												</div>
											} else if s.Quantity <= s.MinThreshold {
												<div>
													<span class="badge badge-amber text-sm fw-900 tabular-nums">
														{ fmt.Sprintf("%d", s.Quantity) } عبوة
													</span>
													<div class="text-xs text-muted mt-0.5 fw-600" style="color:var(--warning-text, #d97706);">
														⚠️ مخزون منخفض
													</div>
												</div>
											} else {
												<span class="badge badge-emerald text-sm fw-900 tabular-nums">
													{ fmt.Sprintf("%d", s.Quantity) } عبوة
												</span>
											}
										</td>

										<!-- Reorder Threshold -->
										<td class="tabular-nums">
											<span class="badge badge-slate text-xs fw-700">
												{ fmt.Sprintf("%d", s.MinThreshold) }
											</span>
										</td>

										<!-- Actions -->
										<td class="text-end">
											<div style="display:flex; justify-content:flex-end; align-items:center; gap:0.35rem;">
												<button
													type="button"
													class="btn btn-secondary btn-sm fw-700"
													style="padding:0.3rem 0.65rem;"
													@click={ fmt.Sprintf("adjustStock = { id: %d, name: %q, batch: %q, qty: %d, min: %d }; adjustModal = true;", s.StockID, func() string { if s.ProductName != "" { return s.ProductName }; return s.VariantName }(), s.BatchNumber, s.Quantity, s.MinThreshold) }
													title="تعديل الرصيد الفعلي لهذا الصنف"
												>
													<span>تعديل</span>
													<span>✏️</span>
												</button>
												<a href="/vendor/products" class="btn btn-secondary btn-sm btn-icon" title="عرض في قائمة الأصناف">
													↗
												</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					<!-- Pagination Footer -->
					<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-top:1.5rem; padding-top:1.25rem; border-top:1px solid var(--border);">
						<div class="text-xs text-muted fw-700 tabular-nums">
							عرض من <strong>{ fmt.Sprintf("%d", data.FromItem) }</strong> إلى <strong>{ fmt.Sprintf("%d", data.ToItem) }</strong> من إجمالي <strong>{ fmt.Sprintf("%d", data.TotalFiltered) }</strong> صنف (صفحة { fmt.Sprintf("%d", data.Filter.Page) } من { fmt.Sprintf("%d", data.TotalPages) })
						</div>

						if data.TotalPages > 1 {
							<div class="row-center gap-xs">
								<!-- Previous Page Button -->
								if data.Filter.Page > 1 {
									<a
										href={ templ.SafeURL(buildWarehouseInventoryURL(data.Warehouse.ID, data.Filter, data.Filter.Page-1, data.Filter.PerPage)) }
										class="btn btn-secondary btn-sm"
									>
										السابق
									</a>
								} else {
									<button class="btn btn-secondary btn-sm" disabled>السابق</button>
								}

								<!-- Page Numbers -->
								for p := 1; p <= data.TotalPages; p++ {
									if p == data.Filter.Page {
										<span class="btn btn-primary btn-sm fw-900 tabular-nums" style="min-width:34px;">
											{ fmt.Sprintf("%d", p) }
										</span>
									} else if p <= 3 || p >= data.TotalPages - 2 || (p >= data.Filter.Page - 1 && p <= data.Filter.Page + 1) {
										<a
											href={ templ.SafeURL(buildWarehouseInventoryURL(data.Warehouse.ID, data.Filter, p, data.Filter.PerPage)) }
											class="btn btn-secondary btn-sm tabular-nums"
											style="min-width:34px;"
										>
											{ fmt.Sprintf("%d", p) }
										</a>
									} else if p == 4 && data.Filter.Page > 4 {
										<span class="text-muted px-1">...</span>
									} else if p == data.TotalPages - 3 && data.Filter.Page < data.TotalPages - 3 {
										<span class="text-muted px-1">...</span>
									}
								}

								<!-- Next Page Button -->
								if data.Filter.Page < data.TotalPages {
									<a
										href={ templ.SafeURL(buildWarehouseInventoryURL(data.Warehouse.ID, data.Filter, data.Filter.Page+1, data.Filter.PerPage)) }
										class="btn btn-secondary btn-sm"
									>
										التالي
									</a>
								} else {
									<button class="btn btn-secondary btn-sm" disabled>التالي</button>
								}
							</div>
						}
					</div>
				}
			</div>

			<!-- Quick Stock Adjustment Modal -->
			<div
				x-show="adjustModal"
				style="position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; padding:1rem;"
				x-cloak
				@keydown.escape.window="adjustModal = false"
			>
				<div
					@click.away="adjustModal = false"
					class="card mb-0"
					style="max-width:520px; width:100%; max-height:90vh; overflow-y:auto; padding:1.75rem; background:var(--surface-raised); border-radius:var(--radius-2xl); border:1px solid var(--border); box-shadow:var(--shadow-xl);"
				>
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
						<div>
							<h3 class="text-lg fw-900 text-primary m-0">تعديل رصيد الصنف في المخزن</h3>
							<p class="text-xs text-muted m-0 mt-0.5">تسجيل تسوية جردية أو تصحيح الكمية المتاحة</p>
						</div>
						<button type="button" @click="adjustModal = false" class="btn btn-secondary btn-icon btn-sm">&times;</button>
					</div>

					<form :action={ fmt.Sprintf("'/vendor/warehouses/%d/stocks/' + adjustStock.id + '/adjust'", data.Warehouse.ID) } method="POST" class="stack-lg">
						<!-- Product Summary Header -->
						<div style="background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-lg); border:1px solid var(--border);">
							<div class="text-xs text-muted fw-700 mb-0.5">الصنف المختار:</div>
							<div class="fw-800 text-foreground text-sm" x-text="adjustStock.name"></div>
							<div class="row-center-sm gap-md mt-1 text-xs text-muted" x-show="adjustStock.batch">
								<span>رقم التشغيلة: <strong class="text-foreground tabular-nums" x-text="adjustStock.batch"></strong></span>
							</div>
						</div>

						<!-- Current vs New Quantity -->
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div class="form-group mb-0">
								<label class="form-label text-xs fw-700">الرصيد الحالي بالمخزن</label>
								<div class="form-input text-center fw-900 tabular-nums text-muted" style="background:var(--surface-sunken); font-size:1.1rem; height:44px; display:flex; align-items:center; justify-content:center;" x-text="adjustStock.qty + ' عبوة'"></div>
							</div>

							<div class="form-group mb-0">
								<label class="form-label text-xs fw-700 text-primary">الرصيد الفعلي الجديد <span class="text-danger">*</span></label>
								<input
									type="number"
									name="new_quantity"
									min="0"
									required
									class="form-input text-center fw-900 tabular-nums"
									style="font-size:1.1rem; height:44px; border-color:var(--primary);"
									:value="adjustStock.qty"
									placeholder="0"
								/>
							</div>
						</div>

						<!-- Reason for Adjustment -->
						<div class="form-group mb-0">
							<label class="form-label text-xs fw-700">سبب التسوية / التعديل <span class="text-danger">*</span></label>
							<select name="reason" class="form-select" required style="height:44px;">
								<option value="جرد دوري ومطابقة فعلية">جرد دوري ومطابقة فعلية</option>
								<option value="استلام شحنة إضافية / توريد">استلام شحنة إضافية / توريد</option>
								<option value="تسوية تلفيات أو إرجاع مورد">تسوية تلفيات أو إرجاع مورد</option>
								<option value="تصحيح خطأ في إدخال الرصيد السابق">تصحيح خطأ في إدخال الرصيد السابق</option>
								<option value="تسوية أخرى">تسوية أخرى</option>
							</select>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" @click="adjustModal = false">إلغاء</button>
							<button type="submit" class="btn btn-primary fw-800">حفظ وتحديث الرصيد فورياً</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}


