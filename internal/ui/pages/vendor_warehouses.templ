package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorWarehousesPage renders the list of vendor warehouses.
templ VendorWarehousesPage(warehouses []*inventory.Warehouse, lang, dir string) {
	@layouts.VendorShell("المستودعات والمخازن", "warehouses", lang, dir) {
		<div class="card mb-0">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 class="card-title" style="margin:0;">مستودعات المنشأة ({ fmt.Sprintf("%d", len(warehouses)) })</h2>
					<p class="subtitle">إدارة المستودعات، نسب الإشغال، والتحويلات المخزنية بين الفروع.</p>
				</div>
				<a href="/vendor/transfers" class="btn btn-secondary btn-sm">التحويلات المخزنية</a>
			</div>

			if len(warehouses) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد مستودعات مسجلة", Message: "المستودع الرئيسي يتم إنشاؤه تلقائياً مع تفعيل حساب المورد."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>المستودع</th>
								<th>الكود</th>
								<th>العنوان</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, w := range warehouses {
								<tr>
									<td><strong>{ w.Name }</strong></td>
									<td><code>{ w.Code }</code></td>
									<td>{ w.Address }</td>
									<td>
										if w.IsActive {
											<span class="badge badge-success">نشط</span>
										} else {
											<span class="badge badge-danger">معطل</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/vendor/warehouses/%d", w.ID)) } class="btn btn-secondary btn-sm">عرض المخزون</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// VendorWarehouseDetailPage renders single warehouse details and its stocks.
templ VendorWarehouseDetailPage(w *inventory.Warehouse, stocks []*inventory.Stock, lang, dir string) {
	@layouts.VendorShell(fmt.Sprintf("مستودع: %s", w.Name), "warehouses", lang, dir) {
		<div class="card mb-0">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 class="card-title" style="margin:0;">مستودع { w.Name }</h2>
					<p class="subtitle">كود: <code>{ w.Code }</code> | عنوان: { w.Address }</p>
				</div>
				<a href="/vendor/warehouses" class="btn btn-secondary btn-sm">العودة للمستودعات</a>
			</div>

			if len(stocks) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد أصناف بالمستودع", Message: "يمكنك إضافة أرصدة أو استيراد كميات لهذا المستودع."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>#</th>
								<th>الصنف</th>
								<th>الكمية المتاحة</th>
								<th>الحد الأدنى للطلب</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range stocks {
								<tr>
									<td class="tabular-nums">#{ fmt.Sprintf("%d", s.ID) }</td>
									<td>صنف #{ fmt.Sprintf("%d", s.ProductVariantID) }</td>
									<td class="tabular-nums"><strong>{ fmt.Sprintf("%d", s.Quantity) }</strong></td>
									<td class="tabular-nums">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
