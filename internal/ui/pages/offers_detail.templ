templ OfferDetail(lang, dir string, data OfferDetailPageData) {
	@layouts.CustomerShell(data.Offer.Title.Get(i18n.Lang(lang))+" | تفاصيل العرض الترويجي", "offers", lang, dir, nil) {
		@OfferDetailContent(lang, data)
	}
}

