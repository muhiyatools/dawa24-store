package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/hr"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type JobItemView struct {
	Job              *hr.JobOffer
	CompanyName      string
	CompanyLogoURL   string
	CategoryName     string
	IsVerified       bool
	ApplicationCount int
}

type JobsPageData struct {
	Jobs        []*JobItemView
	TotalCount  int
	Cities      []*platformadmin.City
	Actor       authctx.Actor
	IsLoggedIn  bool
	IsCustomer  bool
	IsVendor    bool
	IsAdmin     bool
	IsJobSeeker bool
	CanPostJob  bool
	PostJobURL  string
}

type JobDetailData struct {
	Job         *hr.JobOffer
	CompanyName string
	CompanyLogo string
	Actor       authctx.Actor
	IsLoggedIn  bool
	IsCustomer  bool
	IsVendor    bool
	IsAdmin     bool
	IsJobSeeker bool
	Submitted   bool
	UserEmail   string
	UserName    string
	UserPhone   string
}

func jobInitial(company string) string {
	runes := []rune(strings.TrimSpace(company))
	if len(runes) >= 2 {
		return string(runes[0:1])
	}
	return ""
}

// JobsContent renders the core jobs board view.
templ JobsContent(data JobsPageData, lang, dir string) {
	<div class="jobs-container">
		
		<!-- Header Banner -->
		<div class="jobs-header-card">
			<div>
				<div class="d-flex items-center gap-2 mb-2">
					<div class="user-avatar-badge">
						@components.IconBriefcase("icon-sm")
					</div>
					<h1 class="page-title font-bold text-xl m-0">
						شواغر وفرص العمل في القطاع الصيدلاني
					</h1>
				</div>
				<p class="text-sm text-secondary m-0">
					بوابة التوظيف المعتمدة للصيادلة، مدراء الفروع، مسؤولي المشتريات، وسلاسل الإمداد الطبي الموثقة في مصر.
				</p>
			</div>

			<!-- Post Job Button (Shown for Pharmacies, Vendors & Admins) -->
			if data.CanPostJob {
				<div class="d-flex items-center gap-2">
					<a href={ templ.SafeURL(data.PostJobURL) } class="btn btn-primary btn-sm fw-700">
						@components.IconPlus("icon-xs")
						<span>نشر وظيفة جديدة</span>
					</a>
				</div>
			}
		</div>

		<!-- Metrics Summary Strip -->
		<div class="jobs-metrics-grid">
			<div class="jobs-metric-card">
				<div class="jobs-metric-label">
					إجمالي الشواغر النشطة
				</div>
				<div class="jobs-metric-val tabular-nums">
					{ fmt.Sprintf("%d", data.TotalCount) } <span class="text-xs font-normal text-muted">وظيفة متاحة</span>
				</div>
			</div>

			<div class="jobs-metric-card">
				<div class="jobs-metric-label">
					القطاعات والتخصصات
				</div>
				<div class="font-bold text-sm text-primary">
					صيدليات • مخازن • توزيع
				</div>
			</div>

			<div class="jobs-metric-card">
				<div class="jobs-metric-label">
					متوسط الرواتب المعلنة
				</div>
				<div class="jobs-metric-val tabular-nums">
					8,000 - 25,000 <span class="text-xs font-normal text-muted">ج.م</span>
				</div>
			</div>

			<div class="jobs-metric-card">
				<div class="jobs-metric-label">
					ضمان الاعتماد
				</div>
				<div>
					<span class="badge badge-emerald text-xs fw-700">
						@components.IconCheckCircle("icon-xs")
						<span>100% جهات عمل معتمدة</span>
					</span>
				</div>
			</div>
		</div>

		<!-- Instant Filter & Search Strip -->
		<div class="jobs-filter-strip">
			<!-- Search Input -->
			<div class="jobs-search-box">
				<span class="jobs-search-icon">
					@components.IconSearch("icon-xs")
				</span>
				<input
					type="text"
					id="jobs-search-input"
					placeholder="ابحث بالمسمى الوظيفي، التخصص، أو جهة العمل..."
					class="form-input input-sm w-full"
					oninput="filterJobsList()"
				/>
			</div>

			<!-- City Filter -->
			<select id="jobs-city-filter" class="form-input input-sm" onchange="filterJobsList()">
				<option value="">كل المحافظات والمدن</option>
				for _, c := range data.Cities {
					<option value={ c.Name["ar"] }>
						if c.Name["ar"] != "" {
							{ c.Name["ar"] }
						} else {
							{ c.Name["en"] }
						}
					</option>
				}
			</select>

			<!-- Quick Type Filter Buttons -->
			<div class="job-type-pills-group">
				<button type="button" class="job-type-pill active" onclick="setJobTypeFilter('', this)">الكل</button>
				<button type="button" class="job-type-pill" onclick="setJobTypeFilter('دوام كامل', this)">دوام كامل</button>
				<button type="button" class="job-type-pill" onclick="setJobTypeFilter('دوام جزئي', this)">دوام جزئي</button>
				<button type="button" class="job-type-pill" onclick="setJobTypeFilter('شيفت', this)">شيفتات</button>
			</div>
		</div>

		<!-- Job Listings Grid -->
		if len(data.Jobs) == 0 {
			<div class="card text-center p-6">
				<div class="mb-2 text-2xl text-muted">
					@components.IconBriefcase("icon-md")
				</div>
				<h3 class="font-bold text-sm m-0">لا توجد فرص توظيف معلنة حالياً</h3>
				<p class="text-sm text-muted m-0 mt-1">لم يتم نشر أي شواغر وظيفية جديدة في الوقت الراهن. يرجى مراجعة القسم لاحقاً.</p>
			</div>
		} else {
			<div class="jobs-grid" id="jobs-cards-grid">
				for _, item := range data.Jobs {
					if item != nil && item.Job != nil {
						<div
							class="job-card"
							data-job-title={ strings.ToLower(item.Job.Title.Get(i18n.AR) + " " + item.Job.Title.Get(i18n.EN) + " " + item.CompanyName) }
							data-job-location={ item.Job.Location }
							data-job-desc={ strings.ToLower(item.Job.Description + " " + item.Job.Requirements) }
						>
							<div>
								<!-- Header: Company Initials Avatar + Verification + Date -->
								<div class="job-card-header">
									<div class="job-card-company-lockup">
										<div class="job-avatar-initial">
											{ jobInitial(item.CompanyName) }
										</div>
										<div>
											<span class="job-card-company-name">{ item.CompanyName }</span>
											<div>
												<span class="badge badge-emerald text-2xs fw-700">
													@components.IconCheckCircle("icon-xs")
													<span>معتمد</span>
												</span>
											</div>
										</div>
									</div>

									<span class="tabular-nums text-xs text-muted nowrap">
										{ item.Job.CreatedAt.Format("2006-01-02") }
									</span>
								</div>

								<!-- Title -->
								<h3 class="job-card-title">
									<a href={ templ.SafeURL(func() string { if data.IsCustomer { return fmt.Sprintf("/customer/jobs/%d", item.Job.ID) }; return fmt.Sprintf("/jobs/%d", item.Job.ID) }()) }>
										{ item.Job.Title.Get(i18n.ParseLang(lang)) }
									</a>
								</h3>

								<!-- Badges Row -->
								<div class="job-card-badges">
									if item.Job.Location != "" {
										<span class="badge badge-slate text-xs">
											@components.IconLocation("icon-xs")
											<span>{ item.Job.Location }</span>
										</span>
									}
									<span class="badge badge-sky text-xs">
										دوام كامل
									</span>
								</div>

								<!-- Description Excerpt -->
								<p class="job-card-desc">
									{ item.Job.Description }
								</p>
							</div>

							<!-- Footer: Salary & Action CTA -->
							<div class="job-card-footer">
								<div>
									if !item.Job.SalaryMin.IsZero() || !item.Job.SalaryMax.IsZero() {
										<div class="job-card-salary tabular-nums">
											@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: item.Job.SalaryMin })
											if !item.Job.SalaryMax.IsZero() {
												<span> - </span>
												@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: item.Job.SalaryMax })
											}
										</div>
									} else {
										<span class="text-xs text-muted font-bold">الراتب يحدد بالمقابلة</span>
									}
								</div>

								<a
									href={ templ.SafeURL(func() string { if data.IsCustomer { return fmt.Sprintf("/customer/jobs/%d", item.Job.ID) }; return fmt.Sprintf("/jobs/%d", item.Job.ID) }()) }
									class="btn btn-primary btn-sm fw-700"
								>
									<span>التفاصيل والتقديم</span>
									@components.IconArrowLeft("icon-xs")
								</a>
							</div>
						</div>
					}
				}
			</div>
		}

	</div>

	<!-- Client-side filtering script -->
	<script>
		let activeJobTypeFilter = '';

		function setJobTypeFilter(typeVal, btnEl) {
			activeJobTypeFilter = typeVal.toLowerCase();
			document.querySelectorAll('.job-type-pill').forEach(b => b.classList.remove('active'));
			if (btnEl) btnEl.classList.add('active');
			filterJobsList();
		}

		function filterJobsList() {
			const q = (document.getElementById('jobs-search-input')?.value || '').toLowerCase().trim();
			const city = (document.getElementById('jobs-city-filter')?.value || '').toLowerCase().trim();
			const cards = document.querySelectorAll('#jobs-cards-grid .job-card');

			cards.forEach(card => {
				const title = card.getAttribute('data-job-title') || '';
				const loc = card.getAttribute('data-job-location') || '';
				const desc = card.getAttribute('data-job-desc') || '';

				const matchesQ = !q || title.includes(q) || desc.includes(q) || loc.includes(q);
				const matchesCity = !city || loc.includes(city);
				const matchesType = !activeJobTypeFilter || desc.includes(activeJobTypeFilter) || title.includes(activeJobTypeFilter);

				if (matchesQ && matchesCity && matchesType) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		}
	</script>
}

// JobDetailContent renders the high-craft job detail and application screen.
templ JobDetailContent(data JobDetailData, lang, dir string) {
	<div class="jobs-container">
		
		<!-- Back Button & Breadcrumbs -->
		<div class="d-flex items-center justify-between flex-wrap gap-3">
			<a href={ templ.SafeURL(func() string { if data.IsCustomer { return "/customer/jobs" }; return "/jobs" }()) } class="btn btn-secondary btn-sm fw-700">
				@components.IconArrowRight("icon-xs")
				<span>العودة لكافة الوظائف والفرص</span>
			</a>
			
			<div class="text-xs text-muted">
				<span>كود الشاغر: </span>
				<span class="tabular-nums fw-700 text-primary">REF-JOB-{ fmt.Sprintf("%d", data.Job.ID) }</span>
			</div>
		</div>

		<!-- 2-Column Responsive Grid -->
		<div class="job-detail-grid">
			
			<!-- Left Column: Details, Scope & Requirements -->
			<div class="d-flex flex-col gap-4">
				
				<!-- Hero Header Card -->
				<div class="job-detail-card">
					<div>
						<div class="d-flex items-center justify-between flex-wrap gap-2 mb-2">
							<div class="d-flex items-center gap-2">
								<span class="badge badge-emerald text-xs fw-700">
									@components.IconCheckCircle("icon-xs")
									<span>فرصة عمل معتمدة</span>
								</span>
								<span class="badge badge-sky text-xs fw-700">دوام كامل</span>
							</div>

							<span class="tabular-nums text-xs text-muted">
								تاريخ النشر: { data.Job.CreatedAt.Format("2006-01-02") }
							</span>
						</div>

						<h1 class="page-title font-bold text-xl m-0">
							{ data.Job.Title.Get(i18n.ParseLang(lang)) }
						</h1>

						<div class="d-flex items-center gap-4 flex-wrap mt-2 text-xs text-secondary">
							<div class="d-flex items-center gap-2">
								<div class="job-avatar-initial">
									{ jobInitial(data.CompanyName) }
								</div>
								<strong class="text-primary">{ data.CompanyName }</strong>
							</div>

							if data.Job.Location != "" {
								<div class="d-flex items-center gap-1">
									@components.IconLocation("icon-xs")
									<span>{ data.Job.Location }</span>
								</div>
							}
						</div>
					</div>

					<!-- Key Specs Matrix -->
					<div class="job-specs-matrix">
						<div class="job-spec-item">
							<span class="job-spec-label">نظام العمل</span>
							<span class="job-spec-value">دوام كامل (Full-Time)</span>
						</div>
						<div class="job-spec-item">
							<span class="job-spec-label">الخبرة المطلوبة</span>
							<span class="job-spec-value">1 - 3 سنوات في المجال</span>
						</div>
						<div class="job-spec-item">
							<span class="job-spec-label">المؤهل الدراسي</span>
							<span class="job-spec-value">بكالوريوس صيدلة معتمد</span>
						</div>
						<div class="job-spec-item">
							<span class="job-spec-label">ترخيص المزاولة</span>
							<span class="job-spec-value">كارنيه نقابة ساري</span>
						</div>
					</div>
				</div>

				<!-- Section: Job Description & Responsibilities -->
				<div class="job-detail-card">
					<h3 class="font-bold text-sm m-0 d-flex items-center gap-2">
						@components.IconFile("icon-xs")
						<span>الوصف الوظيفي والمسؤوليات الأساسية</span>
					</h3>
					<div class="text-sm text-secondary leading-relaxed">
						{ data.Job.Description }
					</div>
				</div>

				<!-- Section: Qualifications & Requirements -->
				if data.Job.Requirements != "" {
					<div class="job-detail-card">
						<h3 class="font-bold text-sm m-0 d-flex items-center gap-2">
							@components.IconCheckCircle("icon-xs")
							<span>المؤهلات والشروط المطلوبة</span>
						</h3>
						<div class="text-sm text-secondary leading-relaxed">
							{ data.Job.Requirements }
						</div>
					</div>
				}

				<!-- Section: Benefits & Work Environment -->
				<div class="job-detail-card">
					<h3 class="font-bold text-sm m-0 d-flex items-center gap-2">
						@components.IconSparkles("icon-xs")
						<span>المزايا وبيئة العمل</span>
					</h3>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-secondary">
						<div class="d-flex items-center gap-2">
							<span class="text-emerald">@components.IconCheck("icon-sm")</span>
							<span>تأمينات اجتماعية وطبية شاملة</span>
						</div>
						<div class="d-flex items-center gap-2">
							<span class="text-emerald">@components.IconCheck("icon-sm")</span>
							<span>حوافز شهرية ومكافآت أداء</span>
						</div>
						<div class="d-flex items-center gap-2">
							<span class="text-emerald">@components.IconCheck("icon-sm")</span>
							<span>إجازات سنوية ورسمية مدفوعة</span>
						</div>
						<div class="d-flex items-center gap-2">
							<span class="text-emerald">@components.IconCheck("icon-sm")</span>
							<span>فرص ترقي وتطوير مهني مستمر</span>
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Sticky Application & Compensation Sidebar -->
			<div class="d-flex flex-col gap-4">
				
				<!-- Salary & Compensation Card -->
				<div class="job-detail-card">
					<div class="text-xs text-muted font-bold">
						الراتب والمخصصات المقترحة:
					</div>
					if !data.Job.SalaryMin.IsZero() || !data.Job.SalaryMax.IsZero() {
						<div class="tabular-nums font-bold text-lg text-primary">
							@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.Job.SalaryMin })
							if !data.Job.SalaryMax.IsZero() {
								<span> - </span>
								@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.Job.SalaryMax })
							}
							<span class="text-xs text-muted font-normal">/ شهرياً</span>
						</div>
					} else {
						<div class="font-bold text-sm text-primary">
							يحدد بناءً على المقابلة والخبرة
						</div>
					}
				</div>

				<!-- Job Application Box -->
				<div class="job-detail-card">
					<h3 class="font-bold text-base m-0 text-primary">
						التقديم على هذه الفرصة
					</h3>

					if data.Submitted {
						<div class="alert alert-success p-4 d-flex flex-col gap-2">
							<div class="d-flex items-center gap-2 font-bold">
								@components.IconCheckCircle("icon-md")
								<strong>تم إرسال طلب التوظيف بنجاح!</strong>
							</div>
							<p class="text-xs text-secondary m-0">
								تم استلام طلبك وإرفاق بياناتك بنجاح. سيقوم مسؤول التوظيف بمراجعة سيرتك الذاتية والتواصل معك في أقرب وقت.
							</p>
						</div>
					} else if !data.IsLoggedIn {
						<div class="p-4 bg-surface-sunken rounded-xl border text-center d-flex flex-col items-center gap-2">
							<div class="user-avatar-badge">
								@components.IconUser("icon-xs")
							</div>
							<h4 class="font-bold text-sm m-0 text-primary">
								التقديم متاح لحسابات (باحث عن عمل)
							</h4>
							<p class="text-xs text-secondary m-0">
								يرجى تسجيل الدخول بحساب باحث عن عمل لإرسال سيرتك الذاتية ومتابعة طلبك.
							</p>
							<div class="d-flex flex-col gap-2 w-full mt-2">
								<a href={ templ.SafeURL(fmt.Sprintf("/auth/login?redirect=/jobs/%d", data.Job.ID)) } class="btn btn-primary btn-sm fw-700 w-full">
									<span>تسجيل الدخول كباحث عن عمل</span>
								</a>
								<a href="/auth/register" class="btn btn-secondary btn-sm w-full">
									<span>إنشاء حساب باحث عن عمل</span>
								</a>
							</div>
						</div>
					} else if !data.IsJobSeeker {
						<div class="p-4 bg-surface-sunken rounded-xl border text-center d-flex flex-col items-center gap-2">
							<div class="text-amber">@components.IconAlert("icon-sm")</div>
							<h4 class="font-bold text-sm m-0 text-primary">
								التقديم متاح فقط لحسابات (باحث عن عمل)
							</h4>
							<p class="text-xs text-secondary m-0">
								أنت مسجل حالياً بحساب منشأة. للتقديم على الوظائف الشاغرة كصيدلي أو كادر طبي، يرجى استخدام حساب باحث عن عمل.
							</p>
							<a href="/auth/register" class="btn btn-secondary btn-sm w-full mt-2">
								<span>إنشاء حساب باحث عن عمل جديد</span>
							</a>
						</div>
					} else {
						<form class="d-flex flex-col gap-3 m-0" method="POST" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/apply", data.Job.ID)) } enctype="multipart/form-data">
							<div>
								<label class="form-label text-xs font-bold mb-1">الاسم الثلاثي / المهني <span class="text-danger">*</span></label>
								<input type="text" name="applicant_name" required value={ data.UserName } placeholder="د. أحمد محمود" class="form-input input-sm w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold mb-1">البريد الإلكتروني <span class="text-danger">*</span></label>
								<input type="email" name="applicant_email" required value={ data.UserEmail } placeholder="pharmacist@example.com" class="form-input input-sm tabular-nums w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold mb-1">رقم الهاتف / الواتساب <span class="text-danger">*</span></label>
								<input type="tel" name="applicant_phone" required value={ data.UserPhone } placeholder="01012345678" class="form-input input-sm tabular-nums w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold mb-1">إرفاق السيرة الذاتية (CV / PDF) <span class="text-danger">*</span></label>
								<input type="file" name="resume_file" accept=".pdf,.doc,.docx" required class="form-input input-sm w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold mb-1">ملاحظات أو نبذة عن الخبرة (اختياري)</label>
								<textarea name="notes" rows="2" placeholder="أبرز الخبرات والمهارات..." class="form-input input-sm w-full"></textarea>
							</div>

							<button type="submit" class="btn btn-primary btn-sm fw-800 w-full mt-1">
								@components.IconCheck("icon-xs")
								<span>إرسال طلب التوظيف الآن</span>
							</button>
						</form>
					}
				</div>

				<!-- Safety & Verification Notice -->
				<div class="p-3 bg-surface-sunken rounded-lg border text-2xs text-muted leading-relaxed">
					<strong class="text-primary d-block mb-1">ضمان الأمان والنزاهة:</strong>
					تضمن منصة دواء24 التحقق من كافة جهات العمل المنشورة. لا تطلب أي جهة معتمدة رسوماً مقابل التقديم للوظائف.
				</div>

			</div>

		</div>

	</div>
}

// JobsPage renders the complete job board adapted to the user's dashboard shell.
templ JobsPage(data JobsPageData, lang string, dir string) {
	if data.IsCustomer {
		@layouts.CustomerShell(i18n.T(lang, "nav.jobs_and_careers"), "jobs", lang, dir, data.Actor.Permissions) {
			@JobsContent(data, lang, dir)
		}
	} else if data.IsVendor {
		@layouts.VendorShell(i18n.T(lang, "nav.jobs_and_careers"), "jobs", lang, dir) {
			@JobsContent(data, lang, dir)
		}
	} else if data.IsAdmin {
		@layouts.AdminShell(i18n.T(lang, "nav.jobs_and_careers"), "jobs", lang, dir) {
			@JobsContent(data, lang, dir)
		}
	} else {
		@layouts.PublicShell(i18n.T(lang, "nav.jobs_and_careers"), lang, dir) {
			@JobsContent(data, lang, dir)
		}
	}
}

// JobDetail renders the vacancy details adapted to the user's dashboard shell.
templ JobDetail(data JobDetailData, lang string, dir string) {
	if data.IsCustomer {
		@layouts.CustomerShell(data.Job.Title.Get(i18n.ParseLang(lang)), "jobs", lang, dir, data.Actor.Permissions) {
			@JobDetailContent(data, lang, dir)
		}
	} else if data.IsVendor {
		@layouts.VendorShell(data.Job.Title.Get(i18n.ParseLang(lang)), "jobs", lang, dir) {
			@JobDetailContent(data, lang, dir)
		}
	} else if data.IsAdmin {
		@layouts.AdminShell(data.Job.Title.Get(i18n.ParseLang(lang)), "jobs", lang, dir) {
			@JobDetailContent(data, lang, dir)
		}
	} else {
		@layouts.PublicShell(data.Job.Title.Get(i18n.ParseLang(lang)), lang, dir) {
			@JobDetailContent(data, lang, dir)
		}
	}
}


