package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/hr"
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type JobItemView struct {
	Job              *hr.JobOffer
	CompanyName      string
	CompanyLogoURL   string
	CategoryName     string
	IsVerified       bool
	ApplicationCount int
}

type JobsPageData struct {
	Jobs       []*JobItemView
	TotalCount int
	Cities     []*platformadmin.City
	Actor      authctx.Actor
	IsLoggedIn bool
	IsCustomer bool
	IsVendor   bool
	IsAdmin    bool
	CanPostJob bool
}

type JobDetailData struct {
	Job         *hr.JobOffer
	CompanyName string
	CompanyLogo string
	Actor       authctx.Actor
	IsLoggedIn  bool
	IsCustomer  bool
	IsVendor    bool
	IsAdmin     bool
	Submitted   bool
	UserEmail   string
	UserName    string
	UserPhone   string
}

func jobInitial(company string) string {
	runes := []rune(strings.TrimSpace(company))
	if len(runes) >= 2 {
		return string(runes[0:1])
	}
	return "🏢"
}

// JobsContent renders the core jobs board view.
templ JobsContent(data JobsPageData, lang, dir string) {
	<div class="jobs-container">
		
		<!-- Header Banner -->
		<div class="jobs-header">
			<div>
				<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.35rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
						@components.IconBriefcase("icon-sm")
					</div>
					<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
						شواغر وفرص العمل في القطاع الصيدلاني
					</h1>
				</div>
				<p style="font-size:0.875rem; color:var(--text-secondary); margin:0; max-width:680px; line-height:1.6;">
					بوابة التوظيف المعتمدة للصيادلة، مدراء الفروع، مسؤولي المشتريات، وسلاسل الإمداد الطبي الموثقة في مصر.
				</p>
			</div>

			<!-- Post Job Button (Shown ONLY for Vendors & Admins, NEVER for Pharmacy Customers) -->
			if data.CanPostJob {
				<div style="display:flex; align-items:center; gap:0.5rem;">
					<a href="/vendor/jobs" class="btn btn-primary btn-sm fw-700" style="gap:0.4rem;">
						@components.IconPlus("icon-xs")
						<span>نشر وظيفة جديدة</span>
					</a>
				</div>
			}
		</div>

		<!-- Metrics Summary Strip -->
		<div class="jobs-metrics-grid">
			<div class="jobs-metric-card">
				<div style="font-size:0.8rem; font-weight:600; color:var(--text-muted);">
					إجمالي الشواغر النشطة
				</div>
				<div style="font-size:1.75rem; font-weight:800; color:var(--text);" class="tabular-nums">
					{ fmt.Sprintf("%d", data.TotalCount) } <span style="font-size:0.85rem; font-weight:600; color:var(--text-secondary);">وظيفة متاحة</span>
				</div>
			</div>

			<div class="jobs-metric-card">
				<div style="font-size:0.8rem; font-weight:600; color:var(--text-muted);">
					القطاعات والتخصصات
				</div>
				<div style="font-size:1.05rem; font-weight:800; color:var(--accent);">
					صيدليات • مستودعات • توزيع
				</div>
			</div>

			<div class="jobs-metric-card">
				<div style="font-size:0.8rem; font-weight:600; color:var(--text-muted);">
					متوسط الرواتب المعلنة
				</div>
				<div style="font-size:1.25rem; font-weight:800; color:var(--text);" class="tabular-nums">
					8,000 - 25,000 <span style="font-size:0.8rem; font-weight:700; color:var(--text-muted);">ج.م</span>
				</div>
			</div>

			<div class="jobs-metric-card">
				<div style="font-size:0.8rem; font-weight:600; color:var(--text-muted);">
					ضمان الاعتماد
				</div>
				<div style="display:flex; align-items:center; gap:0.4rem; margin-top:0.25rem;">
					<span class="badge badge-emerald text-xs fw-700">
						@components.IconCheckCircle("icon-xs")
						<span>100% جهات عمل معتمدة</span>
					</span>
				</div>
			</div>
		</div>

		<!-- Instant Filter & Search Strip -->
		<div class="jobs-filter-strip">
			<!-- Search Input -->
			<div style="position:relative; flex:1; min-width:260px;">
				<input
					type="text"
					id="jobs-search-input"
					placeholder="ابحث بالمسمى الوظيفي، التخصص، أو جهة العمل..."
					class="form-input input-sm w-full"
					style="padding-inline-start:2rem;"
					oninput="filterJobsList()"
				/>
				<div style="position:absolute; inset-inline-start:0.65rem; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
					@components.IconSearch("icon-xs")
				</div>
			</div>

			<!-- City Filter -->
			<select id="jobs-city-filter" class="form-input input-sm" style="width:190px;" onchange="filterJobsList()">
				<option value="">كل المحافظات والمدن</option>
				for _, c := range data.Cities {
					<option value={ c.Name["ar"] }>
						if c.Name["ar"] != "" {
							{ c.Name["ar"] }
						} else {
							{ c.Name["en"] }
						}
					</option>
				}
			</select>

			<!-- Quick Type Filter Buttons -->
			<div style="display:flex; align-items:center; gap:0.35rem; flex-wrap:wrap;">
				<button type="button" class="btn btn-secondary btn-xs fw-700 job-type-pill active" onclick="setJobTypeFilter('', this)">الكل</button>
				<button type="button" class="btn btn-secondary btn-xs fw-700 job-type-pill" onclick="setJobTypeFilter('دوام كامل', this)">دوام كامل</button>
				<button type="button" class="btn btn-secondary btn-xs fw-700 job-type-pill" onclick="setJobTypeFilter('دوام جزئي', this)">دوام جزئي</button>
				<button type="button" class="btn btn-secondary btn-xs fw-700 job-type-pill" onclick="setJobTypeFilter('شيفت', this)">شيفتات</button>
			</div>
		</div>

		<!-- Job Listings Grid -->
		if len(data.Jobs) == 0 {
			<div class="card" style="padding:3.5rem 1.5rem; text-align:center; background:var(--surface-raised); border-radius:var(--radius-xl); border:1px solid var(--border);">
				<div style="width:48px; height:48px; border-radius:50%; background:var(--surface-sunken); color:var(--text-muted); display:flex; align-items:center; justify-content:center; margin:0 auto 0.75rem auto;">
					@components.IconBriefcase("icon-md")
				</div>
				<h3 style="font-size:1.15rem; font-weight:800; color:var(--text); margin:0 0 0.35rem 0;">لا توجد فرص توظيف معلنة حالياً</h3>
				<p class="text-sm text-muted m-0">لم يتم نشر أي شواغر وظيفية جديدة في الوقت الراهن. يرجى مراجعة القسم لاحقاً.</p>
			</div>
		} else {
			<div class="jobs-grid" id="jobs-cards-grid">
				for _, item := range data.Jobs {
					if item != nil && item.Job != nil {
						<div
							class="job-card"
							data-job-title={ strings.ToLower(item.Job.Title.Get(i18n.AR) + " " + item.Job.Title.Get(i18n.EN) + " " + item.CompanyName) }
							data-job-location={ item.Job.Location }
							data-job-desc={ strings.ToLower(item.Job.Description + " " + item.Job.Requirements) }
						>
							<div>
								<!-- Header: Company Initials Avatar + Verification + Date -->
								<div class="job-card-header">
									<div style="display:flex; align-items:center; gap:0.65rem;">
										<div style="width:40px; height:40px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.95rem; border:1px solid var(--border); flex-shrink:0;">
											{ jobInitial(item.CompanyName) }
										</div>
										<div style="display:flex; flex-direction:column; gap:0.15rem;">
											<span class="job-card-company">{ item.CompanyName }</span>
											<div style="display:flex; align-items:center; gap:0.35rem;">
												<span class="badge badge-emerald text-xs fw-700" style="padding:0.15rem 0.4rem;">
													@components.IconCheckCircle("icon-xs")
													<span>معتمد</span>
												</span>
											</div>
										</div>
									</div>

									<span class="tabular-nums text-xs text-muted" style="white-space:nowrap;">
										{ item.Job.CreatedAt.Format("2006-01-02") }
									</span>
								</div>

								<!-- Title -->
								<h3 class="job-card-title" style="margin-top:0.75rem;">
									<a href={ templ.SafeURL(func() string { if data.IsCustomer { return fmt.Sprintf("/customer/jobs/%d", item.Job.ID) }; return fmt.Sprintf("/jobs/%d", item.Job.ID) }()) }>
										{ item.Job.Title.Get(i18n.ParseLang(lang)) }
									</a>
								</h3>

								<!-- Badges Row -->
								<div class="job-card-badges">
									if item.Job.Location != "" {
										<span class="badge badge-slate text-xs">
											@components.IconLocation("icon-xs")
											<span>{ item.Job.Location }</span>
										</span>
									}
									<span class="badge badge-sky text-xs">
										💼 دوام كامل
									</span>
								</div>

								<!-- Description Excerpt -->
								<p class="job-card-desc">
									{ item.Job.Description }
								</p>
							</div>

							<!-- Footer: Salary & Action CTA -->
							<div class="job-card-footer">
								<div>
									if !item.Job.SalaryMin.IsZero() || !item.Job.SalaryMax.IsZero() {
										<div style="font-size:0.95rem; font-weight:800; color:var(--accent);" class="tabular-nums">
											@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: item.Job.SalaryMin })
											if !item.Job.SalaryMax.IsZero() {
												<span> - </span>
												@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: item.Job.SalaryMax })
											}
										</div>
									} else {
										<span style="font-size:0.8rem; color:var(--text-muted); font-weight:600;">الراتب يحدد بالمقابلة</span>
									}
								</div>

								<a
									href={ templ.SafeURL(func() string { if data.IsCustomer { return fmt.Sprintf("/customer/jobs/%d", item.Job.ID) }; return fmt.Sprintf("/jobs/%d", item.Job.ID) }()) }
									class="btn btn-primary btn-sm fw-700"
									style="padding:0.4rem 0.85rem; font-size:0.825rem; gap:0.35rem;"
								>
									<span>التفاصيل والتقديم</span>
									@components.IconArrowLeft("icon-xs")
								</a>
							</div>
						</div>
					}
				}
			</div>
		}

	</div>

	<!-- Client-side filtering script -->
	<script>
		let activeJobTypeFilter = '';

		function setJobTypeFilter(typeVal, btnEl) {
			activeJobTypeFilter = typeVal.toLowerCase();
			document.querySelectorAll('.job-type-pill').forEach(b => b.classList.remove('active'));
			if (btnEl) btnEl.classList.add('active');
			filterJobsList();
		}

		function filterJobsList() {
			const q = (document.getElementById('jobs-search-input')?.value || '').toLowerCase().trim();
			const city = (document.getElementById('jobs-city-filter')?.value || '').toLowerCase().trim();
			const cards = document.querySelectorAll('#jobs-cards-grid .job-card');

			cards.forEach(card => {
				const title = card.getAttribute('data-job-title') || '';
				const loc = card.getAttribute('data-job-location') || '';
				const desc = card.getAttribute('data-job-desc') || '';

				const matchesQ = !q || title.includes(q) || desc.includes(q) || loc.includes(q);
				const matchesCity = !city || loc.includes(city);
				const matchesType = !activeJobTypeFilter || desc.includes(activeJobTypeFilter) || title.includes(activeJobTypeFilter);

				if (matchesQ && matchesCity && matchesType) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		}
	</script>
}

// JobDetailContent renders the high-craft job detail and application screen.
templ JobDetailContent(data JobDetailData, lang, dir string) {
	<div class="jobs-container" style="max-width:1100px; margin:0 auto;">
		
		<!-- Back Button & Breadcrumbs -->
		<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.5rem;">
			<a href={ templ.SafeURL(func() string { if data.IsCustomer { return "/customer/jobs" }; return "/jobs" }()) } class="btn btn-secondary btn-sm fw-700" style="gap:0.4rem;">
				@components.IconArrowRight("icon-xs")
				<span>العودة لكافة الوظائف والفرص</span>
			</a>
			
			<div style="font-size:0.775rem; color:var(--text-muted); font-weight:600;">
				<span>كود الشاغر: </span>
				<span class="tabular-nums fw-700 text-primary">REF-JOB-{ fmt.Sprintf("%d", data.Job.ID) }</span>
			</div>
		</div>

		<!-- 2-Column Responsive Grid -->
		<div class="job-detail-grid">
			
			<!-- Left Column: Details, Scope & Requirements -->
			<div style="display:flex; flex-direction:column; gap:1.25rem;">
				
				<!-- Hero Header Card -->
				<div class="job-detail-card">
					<div>
						<div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.65rem;">
							<div style="display:flex; align-items:center; gap:0.5rem;">
								<span class="badge badge-emerald text-xs fw-700">
									@components.IconCheckCircle("icon-xs")
									<span>فرصة عمل معتمدة</span>
								</span>
								<span class="badge badge-sky text-xs fw-700">دوام كامل</span>
							</div>

							<span class="tabular-nums text-xs text-muted">
								تاريخ النشر: { data.Job.CreatedAt.Format("2006-01-02") }
							</span>
						</div>

						<h1 style="font-size:1.65rem; font-weight:900; color:var(--text); margin:0 0 0.5rem 0; line-height:1.35;">
							{ data.Job.Title.Get(i18n.ParseLang(lang)) }
						</h1>

						<div style="display:flex; align-items:center; gap:0.85rem; flex-wrap:wrap; color:var(--text-secondary); font-size:0.9rem; margin-top:0.5rem;">
							<div style="display:flex; align-items:center; gap:0.35rem;">
								<div style="width:24px; height:24px; border-radius:var(--radius-sm); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.75rem;">
									{ jobInitial(data.CompanyName) }
								</div>
								<strong class="text-primary">{ data.CompanyName }</strong>
							</div>

							if data.Job.Location != "" {
								<div style="display:flex; align-items:center; gap:0.35rem;">
									@components.IconLocation("icon-xs")
									<span>{ data.Job.Location }</span>
								</div>
							}
						</div>
					</div>

					<!-- Key Specs Matrix -->
					<div class="job-specs-matrix">
						<div class="job-spec-item">
							<span class="job-spec-label">نظام العمل</span>
							<span class="job-spec-value">دوام كامل (Full-Time)</span>
						</div>
						<div class="job-spec-item">
							<span class="job-spec-label">الخبرة المطلوبة</span>
							<span class="job-spec-value">1 - 3 سنوات في المجال</span>
						</div>
						<div class="job-spec-item">
							<span class="job-spec-label">المؤهل الدراسي</span>
							<span class="job-spec-value">بكالوريوس صيدلة معتمد</span>
						</div>
						<div class="job-spec-item">
							<span class="job-spec-label">ترخيص المزاولة</span>
							<span class="job-spec-value">كارنيه نقابة ساري</span>
						</div>
					</div>
				</div>

				<!-- Section: Job Description & Responsibilities -->
				<div class="job-detail-card">
					<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0 0 0.5rem 0; display:flex; align-items:center; gap:0.4rem;">
						@components.IconFile("icon-xs")
						<span>الوصف الوظيفي والمسؤوليات الأساسية</span>
					</h3>
					<div style="white-space:pre-line; color:var(--text-secondary); line-height:1.9; font-size:0.925rem;">
						{ data.Job.Description }
					</div>
				</div>

				<!-- Section: Qualifications & Requirements -->
				if data.Job.Requirements != "" {
					<div class="job-detail-card">
						<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0 0 0.5rem 0; display:flex; align-items:center; gap:0.4rem;">
							@components.IconCheckCircle("icon-xs")
							<span>المؤهلات والشروط المطلوبة</span>
						</h3>
						<div style="white-space:pre-line; color:var(--text-secondary); line-height:1.9; font-size:0.925rem;">
							{ data.Job.Requirements }
						</div>
					</div>
				}

				<!-- Section: Benefits & Work Environment -->
				<div class="job-detail-card">
					<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0 0 0.5rem 0; display:flex; align-items:center; gap:0.4rem;">
						@components.IconSparkles("icon-xs")
						<span>المزايا وبيئة العمل</span>
					</h3>
					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:0.75rem; margin-top:0.25rem;">
						<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem; color:var(--text-secondary);">
							<span style="color:var(--success);">✓</span>
							<span>تأمينات اجتماعية وطبية شاملة</span>
						</div>
						<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem; color:var(--text-secondary);">
							<span style="color:var(--success);">✓</span>
							<span>حوافز شهرية ومكافآت أداء</span>
						</div>
						<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem; color:var(--text-secondary);">
							<span style="color:var(--success);">✓</span>
							<span>إجازات سنوية ورسمية مدفوعة</span>
						</div>
						<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem; color:var(--text-secondary);">
							<span style="color:var(--success);">✓</span>
							<span>فرص ترقي وتطوير مهني مستمر</span>
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Sticky Application & Compensation Sidebar -->
			<div style="display:flex; flex-direction:column; gap:1.25rem; position:sticky; top:calc(var(--header-height) + 1rem);">
				
				<!-- Salary & Compensation Card -->
				<div class="job-detail-card" style="padding:1.35rem;">
					<div style="font-size:0.8rem; font-weight:600; color:var(--text-muted); margin-bottom:0.25rem;">
						الراتب والمخصصات المقترحة:
					</div>
					if !data.Job.SalaryMin.IsZero() || !data.Job.SalaryMax.IsZero() {
						<div style="font-size:1.45rem; font-weight:900; color:var(--accent);" class="tabular-nums">
							@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.Job.SalaryMin })
							if !data.Job.SalaryMax.IsZero() {
								<span> - </span>
								@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.Job.SalaryMax })
							}
							<span style="font-size:0.85rem; font-weight:700; color:var(--text-secondary);">/ شهرياً</span>
						</div>
					} else {
						<div style="font-size:1.15rem; font-weight:800; color:var(--text);">
							يحدد بناءً على المقابلة والخبرة
						</div>
					}
				</div>

				<!-- Job Application Box -->
				<div class="job-detail-card" style="padding:1.5rem;">
					<h3 style="font-size:1.1rem; font-weight:800; color:var(--text); margin:0 0 0.85rem 0;">
						التقديم على هذه الفرصة
					</h3>

					if data.Submitted {
						<div style="background:var(--accent-subtle); border:1px solid var(--accent); padding:1.25rem; border-radius:var(--radius-lg); display:flex; flex-direction:column; gap:0.5rem;">
							<div style="display:flex; align-items:center; gap:0.5rem; color:var(--accent-text);">
								@components.IconCheckCircle("icon-md")
								<strong style="font-size:1rem;">تم إرسال طلب التوظيف بنجاح!</strong>
							</div>
							<p style="font-size:0.825rem; color:var(--text-secondary); margin:0; line-height:1.6;">
								تم استلام طلبك وإرفاق بياناتك بنجاح. سيقوم مسؤول التوظيف بمراجعة سيرتك الذاتية والتواصل معك في أقرب وقت.
							</p>
						</div>
					} else if !data.IsLoggedIn {
						<div style="text-align:center; padding:1.25rem; background:var(--surface-sunken); border:1px dashed var(--border); border-radius:var(--radius-lg);">
							<div style="width:40px; height:40px; border-radius:50%; background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; margin:0 auto 0.75rem auto;">
								@components.IconUser("icon-xs")
							</div>
							<h4 style="font-weight:800; font-size:0.95rem; color:var(--text); margin:0 0 0.25rem 0;">
								يتطلب التقديم تسجيل الدخول
							</h4>
							<p style="font-size:0.8rem; color:var(--text-secondary); margin:0 0 1rem 0; line-height:1.5;">
								يرجى تسجيل الدخول بحسابك على المنصة لإرفاق سيرتك الذاتية ومتابعة طلبك.
							</p>
							<div style="display:flex; flex-direction:column; gap:0.4rem;">
								<a href={ templ.SafeURL(fmt.Sprintf("/auth/login?redirect=/jobs/%d", data.Job.ID)) } class="btn btn-primary btn-sm fw-700" style="justify-content:center;">
									<span>تسجيل الدخول للتقديم</span>
								</a>
								<a href="/auth/register" class="btn btn-secondary btn-sm" style="justify-content:center;">
									<span>إنشاء حساب جديد</span>
								</a>
							</div>
						</div>
					} else {
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/jobs/%d/apply", data.Job.ID)) } enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:0.85rem;">
							<div>
								<label class="form-label" style="font-size:0.8rem; font-weight:700;">الاسم الثلاثي / المهني <span class="text-danger">*</span></label>
								<input type="text" name="applicant_name" required value={ data.UserName } placeholder="د. أحمد محمود" class="form-input input-sm w-full"/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.8rem; font-weight:700;">البريد الإلكتروني <span class="text-danger">*</span></label>
								<input type="email" name="applicant_email" required value={ data.UserEmail } placeholder="pharmacist@example.com" class="form-input input-sm tabular-nums w-full"/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.8rem; font-weight:700;">رقم الهاتف / الواتساب <span class="text-danger">*</span></label>
								<input type="tel" name="applicant_phone" required value={ data.UserPhone } placeholder="01012345678" class="form-input input-sm tabular-nums w-full"/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.8rem; font-weight:700;">إرفاق السيرة الذاتية (CV / PDF) <span class="text-danger">*</span></label>
								<input type="file" name="resume_file" accept=".pdf,.doc,.docx" required class="form-input input-sm w-full" style="padding:0.35rem; font-size:0.775rem;"/>
							</div>

							<div>
								<label class="form-label" style="font-size:0.8rem; font-weight:700;">ملاحظات أو نبذة عن الخبرة (اختياري)</label>
								<textarea name="notes" rows="2" placeholder="أبرز الخبرات والمهارات..." class="form-input input-sm w-full" style="resize:vertical;"></textarea>
							</div>

							<button type="submit" class="btn btn-primary btn-sm fw-800" style="justify-content:center; padding:0.65rem; width:100%; margin-top:0.25rem;">
								@components.IconCheck("icon-xs")
								<span>إرسال طلب التوظيف الآن</span>
							</button>
						</form>
					}
				</div>

				<!-- Safety & Verification Notice -->
				<div style="background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.85rem 1rem; font-size:0.775rem; color:var(--text-muted); line-height:1.5;">
					<div style="font-weight:700; color:var(--text-secondary); margin-bottom:0.25rem;">🛡️ ضمان الأمان والنزاهة</div>
					تضمن منصة دواء24 التحقق من كافة جهات العمل المنشورة. لا تطلب أي جهة معتمدة رسوماً مقابل التقديم للوظائف.
				</div>

			</div>

		</div>

	</div>
}

// JobsPage renders the complete job board adapted to the user's dashboard shell.
templ JobsPage(data JobsPageData, lang string, dir string) {
	if data.IsCustomer {
		@layouts.CustomerShell(i18n.T(lang, "nav.jobs_and_careers"), "jobs", lang, dir, data.Actor.Permissions) {
			@JobsContent(data, lang, dir)
		}
	} else if data.IsVendor {
		@layouts.VendorShell(i18n.T(lang, "nav.jobs_and_careers"), "jobs", lang, dir) {
			@JobsContent(data, lang, dir)
		}
	} else if data.IsAdmin {
		@layouts.AdminShell(i18n.T(lang, "nav.jobs_and_careers"), "jobs", lang, dir) {
			@JobsContent(data, lang, dir)
		}
	} else {
		@layouts.PublicShell(i18n.T(lang, "nav.jobs_and_careers"), lang, dir) {
			<div style="max-width:1240px; margin:1.5rem auto 4rem auto; padding:0 1.25rem;">
				@JobsContent(data, lang, dir)
			</div>
		}
	}
}

// JobDetail renders the vacancy details adapted to the user's dashboard shell.
templ JobDetail(data JobDetailData, lang string, dir string) {
	if data.IsCustomer {
		@layouts.CustomerShell(data.Job.Title.Get(i18n.ParseLang(lang)), "jobs", lang, dir, data.Actor.Permissions) {
			@JobDetailContent(data, lang, dir)
		}
	} else if data.IsVendor {
		@layouts.VendorShell(data.Job.Title.Get(i18n.ParseLang(lang)), "jobs", lang, dir) {
			@JobDetailContent(data, lang, dir)
		}
	} else if data.IsAdmin {
		@layouts.AdminShell(data.Job.Title.Get(i18n.ParseLang(lang)), "jobs", lang, dir) {
			@JobDetailContent(data, lang, dir)
		}
	} else {
		@layouts.PublicShell(data.Job.Title.Get(i18n.ParseLang(lang)), lang, dir) {
			<div style="max-width:1100px; margin:1.5rem auto 4rem auto; padding:0 1.25rem;">
				@JobDetailContent(data, lang, dir)
			</div>
		}
	}
}


