package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CourierShipmentDetails(data CourierDeliveryData, lang, dir string) {
	if data.Shipment != nil {
		<!-- Card 1: Status & Identification Card -->
		<div class="courier-card">
			<div class="flex-between items-center flex-wrap gap-2 mb-2">
				<div class="stack-2xs text-start">
					<span class="text-2xs text-muted font-mono font-bold">رقم الشحنة:</span>
					<h2 class="text-base font-black text-primary font-mono m-0">{ data.Shipment.ShipmentNumber }</h2>
					if data.Shipment.TrackingNumber != "" {
						<span class="text-2xs text-secondary font-mono font-bold">بوليصة: { data.Shipment.TrackingNumber }</span>
					}
				</div>
				<div>
					if data.Shipment.Status == commerce.StatusDelivered || data.Shipment.Status == commerce.StatusCompleted {
						<span class="badge badge-emerald font-black text-xs py-1.5 px-3 gap-1.5 shadow-2xs">
							@components.IconCheckCircle("icon-2xs")
							<span>تم التسليم بنجاح</span>
						</span>
					} else if data.Shipment.Status == commerce.StatusCancelled {
						<span class="badge badge-rose font-black text-xs py-1.5 px-3 gap-1.5">
							@components.IconClose("icon-2xs")
							<span>شحنة ملغاة</span>
						</span>
					} else {
						<span class="badge badge-sky font-black text-xs py-1.5 px-3 gap-1.5 shadow-2xs">
							@components.IconTruck("icon-2xs")
							<span>جاهز للتسليم بالفرع</span>
						</span>
					}
				</div>
			</div>

			if data.Shipment.VendorName.Get(i18n.ParseLang(lang)) != "" {
				<div class="pt-2 border-t mt-2 flex-between items-center text-xs">
					<span class="text-muted font-medium">المورد / شركة التوزيع:</span>
					<strong class="text-primary font-bold">{ data.Shipment.VendorName.Get(i18n.ParseLang(lang)) }</strong>
				</div>
			}
		</div>

		<!-- Card 2: Recipient Pharmacy Info Card -->
		<div class="courier-card">
			<div class="d-flex items-center gap-2 mb-3 pb-2 border-b text-primary">
				@components.IconMapPin("icon-xs text-brand")
				<h3 class="text-xs font-black m-0">بيانات الصيدلية المستلمة</h3>
			</div>

			<div class="d-flex flex-col gap-2.5 text-xs text-start">
				<div class="flex-between items-baseline flex-wrap gap-1">
					<span class="text-secondary font-medium">اسم الصيدلية:</span>
					<strong class="text-primary font-extrabold text-sm">{ data.Shipment.CustomerOrgName.Get(i18n.ParseLang(lang)) }</strong>
				</div>

				if data.Shipment.CustomerBranchName.Get(i18n.ParseLang(lang)) != "" {
					<div class="flex-between items-baseline flex-wrap gap-1">
						<span class="text-secondary font-medium">الفرع:</span>
						<span class="text-primary font-bold">{ data.Shipment.CustomerBranchName.Get(i18n.ParseLang(lang)) }</span>
					</div>
				}

				if data.Shipment.CustomerBranchAddress != "" {
					<div class="pt-2 border-t">
						<span class="text-secondary font-medium d-block mb-1">العنوان التفصيلي:</span>
						<div class="p-2.5 rounded-lg bg-surface-sunken border text-primary font-bold leading-relaxed">
							{ data.Shipment.CustomerBranchAddress }
						</div>
					</div>
				}

				<!-- Pharmacist Contact, Phone Call & Maps Navigation -->
				<div class="pt-2 border-t flex-between items-center gap-2 flex-wrap">
					<div class="stack-2xs text-start">
						<span class="text-2xs text-muted font-medium">المسؤول بالفرع:</span>
						<span class="text-xs font-bold text-primary">
							if data.Shipment.CustomerManagerName != "" {
								{ data.Shipment.CustomerManagerName }
							} else {
								<span>الصيدلي المسؤول</span>
							}
						</span>
					</div>

					<div class="d-flex items-center gap-2 flex-wrap">
						if data.Shipment.CustomerBranchPhone != "" {
							<a
								href={ templ.SafeURL("tel:" + data.Shipment.CustomerBranchPhone) }
								class="courier-action-btn-call"
								title="اتصال هاتفي بالصيدلي"
							>
								@components.IconPhone("icon-2xs")
								<span class="tabular-nums font-mono">{ data.Shipment.CustomerBranchPhone }</span>
							</a>
						}
						if data.Shipment.CustomerBranchAddress != "" {
							<a
								href={ templ.SafeURL("https://www.google.com/maps/search/?api=1&query=" + url.QueryEscape(data.Shipment.CustomerBranchAddress)) }
								target="_blank"
								rel="noopener noreferrer"
								class="courier-action-btn-map"
								title="فتح العنوان على خرائط جوجل"
							>
								@components.IconMapPin("icon-2xs")
								<span>الخريطة</span>
							</a>
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Card 3: Financial Collection Alert Box -->
		<div class="courier-card">
			<div class="d-flex items-center gap-2 mb-3 pb-2 border-b text-primary">
				@components.IconWallet("icon-xs text-brand")
				<h3 class="text-xs font-black m-0">التحصيل والمبالغ المالية</h3>
			</div>

			if data.Shipment.PaymentMethod == "cod" || data.Shipment.PaymentStatus != commerce.PaymentPaid {
				<div class="courier-cash-alert-cod">
					<span class="text-xs font-extrabold text-amber-800 d-block mb-1">
						المبلغ المطلوب تحصيله نقداً من الصيدلية:
					</span>
					<div class="text-2xl font-black text-amber-900 tabular-nums font-mono">
						@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: data.Shipment.TotalAmount })
					</div>
					<div class="d-inline-flex items-center gap-1.5 mt-2 px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 text-2xs font-extrabold">
						<span>⚠️</span>
						<span>الدفع عند الاستلام (COD) — يرجى استلام النقدية قبل تسليم الأصناف</span>
					</div>
				</div>
			} else {
				<div class="courier-cash-alert-prepaid">
					<div class="text-sm font-black text-emerald-800 mb-1 d-flex items-center justify-center gap-1.5">
						@components.IconCheckCircle("icon-xs text-emerald-600")
						<span>مدفوع إلكترونياً بالكامل مسبقاً</span>
					</div>
					<div class="text-xs text-emerald-700 font-medium">
						المبلغ المطلوب تحصيله: 0.00 ج.م — لا تلزم أي مبالغ نقدية من الصيدلية.
					</div>
				</div>
			}
		</div>

		<!-- Card 4: Items Summary Table -->
		<div class="courier-card">
			<div class="d-flex items-center gap-2 mb-3 pb-2 border-b text-primary">
				@components.IconPackage("icon-xs text-brand")
				<h3 class="text-xs font-black m-0">
					محتويات وأصناف الشحنة ({ fmt.Sprintf("%d", len(data.Shipment.Lines)) } صنف)
				</h3>
			</div>

			<div class="d-flex flex-col gap-2">
				for _, line := range data.Shipment.Lines {
					<div class="courier-item-row">
						<div class="flex-1 min-w-0 text-start">
							<div class="text-xs font-bold text-primary truncate">{ line.ProductName.Get(i18n.ParseLang(lang)) }</div>
							if line.VariantName.Get(i18n.ParseLang(lang)) != "" {
								<div class="text-2xs text-muted truncate">{ line.VariantName.Get(i18n.ParseLang(lang)) }</div>
							}
						</div>
						<div class="text-end flex-shrink-0">
							<span class="badge badge-secondary font-black text-xs tabular-nums">
								{ fmt.Sprintf("%d", line.Quantity) } عبوة
							</span>
						</div>
					</div>
				}
			</div>
		</div>

		<!-- Card 5: Handover Verification Form / Success Card -->
		if data.Shipment.Status != commerce.StatusDelivered && data.Shipment.Status != commerce.StatusCompleted && data.Shipment.Status != commerce.StatusCancelled {
			<div class="courier-card border-brand shadow-md">
				<div class="text-center mb-4">
					<div class="courier-hero-icon">
						@components.IconShield("icon-sm")
					</div>
					<h3 class="text-sm font-black text-primary m-0">
						تأكيد تسليم الشحنة بالكود
					</h3>
					<p class="text-xs text-secondary m-0 mt-1 font-medium leading-relaxed">
						اطلب من الصيدلي المسؤول إعطاءك «كود تأكيد الاستلام» الظاهر في حسابه وفاتورته لإتمام التسليم
					</p>
				</div>

				<form method="POST" action="/delivery/verify" class="m-0 d-flex flex-col gap-4">
					if data.Shipment.TrackingNumber != "" {
						<input type="hidden" name="tracking" value={ data.Shipment.TrackingNumber }/>
					} else {
						<input type="hidden" name="tracking" value={ data.Shipment.ShipmentNumber }/>
					}
					<input type="hidden" name="shipment_id" value={ fmt.Sprintf("%d", data.Shipment.ID) }/>

					<div class="stack-xs text-center">
						<label class="form-label text-xs font-black text-primary d-block text-center mb-2">
							أدخل كود تأكيد الاستلام المكون من 6 أرقام:
						</label>
						<input
							type="text"
							name="delivery_code"
							required
							maxlength="6"
							pattern="[0-9]{6}"
							inputmode="numeric"
							autocomplete="one-time-code"
							placeholder="••••••"
							class="courier-pin-input"
						/>
					</div>

					if data.Shipment.PaymentMethod == "cod" || data.Shipment.PaymentStatus != commerce.PaymentPaid {
						<div class="p-3 rounded-xl bg-surface-sunken border text-start">
							<label class="d-flex items-center gap-2.5 cursor-pointer select-none">
								<input
									type="checkbox"
									name="confirm_collected"
									value="true"
									required
									class="w-4 h-4 cursor-pointer"
								/>
								<span class="text-xs font-bold text-primary">
									أؤكد تحصيل كامل المبلغ المطلوب ({ data.Shipment.TotalAmount.String() } ج.م) نقداً من الصيدلي
								</span>
							</label>
						</div>
					}

					<div class="stack-2xs text-start">
						<label class="form-label text-2xs font-bold text-secondary d-block mb-1">
							ملاحظات التسليم (اختياري):
						</label>
						<input
							type="text"
							name="notes"
							placeholder="مثال: تم التسليم للدكتور فلان بالفرع"
							class="form-input text-xs w-full rounded-xl"
						/>
					</div>

					<button
						type="submit"
						class="btn btn-primary w-full py-3 font-black text-sm rounded-xl gap-2 shadow-sm d-flex items-center justify-center"
					>
						@components.IconCheckCircle("icon-sm")
						<span>تأكيد الاستلام وإغلاق الشحنة فوراً</span>
					</button>
				</form>
			</div>
		} else if data.Shipment.Status == commerce.StatusDelivered || data.Shipment.Status == commerce.StatusCompleted {
			<div class="courier-card text-center p-6 bg-surface shadow-xs">
				<div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-700 d-inline-flex items-center justify-center mb-3 shadow-2xs">
					@components.IconCheckCircle("icon-md")
				</div>
				<h3 class="text-base font-black text-primary m-0 mb-1">
					تم تسليم الشحنة وتوثيقها بنجاح
				</h3>
				<p class="text-xs text-secondary m-0 font-medium">
					تم التحقق من كود الاستلام وإشعار المورد والصيدلية باكتمال أمر التوريد.
				</p>
				if data.Shipment.DeliveredAt != nil {
					<div class="text-2xs text-secondary mt-2 font-mono tabular-nums">
						وقت التسليم: { data.Shipment.DeliveredAt.Format("2006-01-02 03:04 PM") }
					</div>
				}

				<div class="pt-4 mt-4 border-t">
					<a href="/delivery" class="btn btn-secondary text-xs font-bold py-2.5 px-5 d-inline-flex items-center gap-2">
						@components.IconTruck("icon-2xs")
						<span>تسليم شحنة أخرى</span>
					</a>
				</div>
			</div>
		}

		<div class="text-center pt-2">
			<a href="/delivery" class="text-xs font-bold text-secondary text-decoration-none">
				<span>← البحث عن شحنة أخرى</span>
			</a>
		</div>
	}
}