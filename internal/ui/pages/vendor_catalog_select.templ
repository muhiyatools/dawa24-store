package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorCatalogSelectPage renders the master catalog selector.
templ VendorCatalogSelectPage(products []*catalog.Product, search string, lang, dir string) {
	@layouts.VendorShell("اختيار المنتجات المتاحة بالمخزن", "catalog_select", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconPill("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">تحديد المستحضرات المتاحة بالمخزن ({ fmt.Sprintf("%d", len(products)) })</h1>
						</div>
						<p class="text-sm text-secondary m-0">اختر من الكتالوج المركزي الأدوية والمستحضرات المتوفرة لديك لإضافتها إلى قائمة عروضك</p>
					</div>
				</div>

				<form method="GET" action="/vendor/catalog/select" class="mt-4 pt-3 border-t">
					<div class="d-flex gap-2" style="max-width:500px;">
						<input type="text" name="q" value={ search } placeholder="ابحث بالاسم التجاري أو العلمي أو الكود..." class="form-input text-xs flex-1" />
						<button type="submit" class="btn btn-secondary text-xs font-bold px-4">بحث</button>
					</div>
				</form>
			</div>

			if len(products) == 0 {
				<div class="glass-panel p-8 text-center empty-state-glass">
					<div class="text-4xl mb-3">@components.IconSearch("icon-sm")</div>
					<h3 class="text-lg font-black text-primary mb-2">لا توجد نتائج مطابقة</h3>
					<p class="text-sm text-secondary m-0">لم يتم العثور على منتجات مطابقة لكلمات البحث في الكتالوج العام.</p>
				</div>
			} else {
				<form method="POST" action="/vendor/catalog/select">
					<div class="glass-panel p-0 mb-6 overflow-hidden">
						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th style="width:40px;" class="text-center">اختيار</th>
										<th>المنتج الدوائي</th>
										<th>الاسم العلمي والمواصفات</th>
										<th>سعر الجمهور</th>
										<th class="text-center">الحالة</th>
									</tr>
								</thead>
								<tbody>
									for _, p := range products {
										<tr>
											<td class="text-center">
												<input type="checkbox" name="product_ids" value={ fmt.Sprintf("%d", p.ID) } class="form-checkbox" />
											</td>
											<td class="font-extrabold text-primary text-sm">{ p.Name.Get("ar") }</td>
											<td class="text-xs text-muted">{ p.ScientificName }</td>
											<td class="tabular-nums font-bold text-xs">{ fmt.Sprintf("%s ج.م", p.Price.String()) }</td>
											<td class="text-center"><span class="badge badge-emerald text-xs font-bold">متاح بالكتالوج</span></td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
					<div class="d-flex justify-end">
						<button type="submit" class="btn btn-primary font-bold px-5 py-2 text-xs">إضافة المنتجات المحددة لكتالوج المنشأة</button>
					</div>
				</form>
			}
		</div>
	}
}
