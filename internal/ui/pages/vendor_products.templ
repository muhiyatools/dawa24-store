package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorVariantView struct {
	Variant        *catalog.ProductVariant
	MasterProduct  *catalog.Product
	BranchName     string
}

type VendorVariantsData struct {
	Variants []*VendorVariantView
}

templ VendorProducts(data VendorVariantsData, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorVariantsTable(data.Variants, lang)
	} else {
		@layouts.VendorShell("عروض وأصناف التوريد المتاحة", "products", lang, dir) {
			<div style="display:flex; flex-direction:column; gap:2rem;">
				
				<!-- Header Bar -->
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
					<div>
						<h2 style="font-size:1.6rem; font-weight:900; color:var(--neutral-900); margin:0;">
							قائمة أصناف وعروض التوريد
						</h2>
						<p style="color:var(--neutral-500); font-size:0.925rem; margin:0.25rem 0 0 0;">
							إدارة أسعار التوريد، العبوات، تواريخ الصلاحية، والأرصدة المتاحة للطلب من الصيدليات
						</p>
					</div>

					<a href="/vendor/variants/new" class="btn btn-primary" style="font-weight:800; padding:0.7rem 1.5rem;">
						@components.IconPlus("icon-xs")
						<span>إضافة عرض توريد لصنف</span>
					</a>
				</div>

				<!-- Variants Content -->
				<div id="vendor-products-content">
					@VendorVariantsTable(data.Variants, lang)
				</div>
			</div>
		}
	}
}

templ VendorVariantsTable(variants []*VendorVariantView, lang string) {
	if len(variants) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد أصناف توريد مسجلة",
			Message:     "قم باختيار الأدوية من الكتالوج المعتمد وإضافة عروض الأسعار والكميات المتاحة لديك.",
			ActionLabel: "+ إضافة عرض توريد جديد",
		})
	} else {
		<div class="card" style="padding:0; overflow:hidden; border:1px solid var(--neutral-200); border-radius:var(--radius-xl);">
			<div class="table-container" style="margin:0; border:none;">
				<table class="table" style="margin:0;">
					<thead>
						<tr>
							<th>الصنف الدوائي المعتمد</th>
							<th>اسم العبوة والمواصفات</th>
							<th>رقم التشغيلة</th>
							<th>سعر التوريد</th>
							<th>الرصيد المتاح</th>
							<th>تاريخ الصلاحية</th>
							<th>مستودع الشحن</th>
							<th>الحالة</th>
							<th>الإجراءات</th>
						</tr>
					</thead>
					<tbody>
						for _, v := range variants {
							<tr id={ fmt.Sprintf("variant-row-%d", v.Variant.ID) }>
								<td>
									<div style="display:flex; align-items:center; gap:0.75rem;">
										<div style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--primary-50); border:1px solid var(--neutral-200); display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;">
											if v.MasterProduct != nil && v.MasterProduct.Image != "" {
												<img src={ v.MasterProduct.Image } alt="Product" style="width:100%; height:100%; object-fit:cover;" />
											} else {
												@components.IconPill("icon-xs")
											}
										</div>
										<div>
											<div style="font-weight:800; color:var(--neutral-900);">
												if v.MasterProduct != nil {
													{ v.MasterProduct.Name.Get(i18n.Lang(lang)) }
												} else {
													صنف دوائي
												}
											</div>
											if v.MasterProduct != nil && v.MasterProduct.DosageForm != "" {
												<div style="font-size:0.75rem; color:var(--neutral-500);">{ v.MasterProduct.DosageForm }</div>
											}
										</div>
									</div>
								</td>
								<td>
									<strong style="color:var(--neutral-800);">{ v.Variant.Name.Get(i18n.Lang(lang)) }</strong>
									if v.Variant.SKU != "" {
										<div style="font-size:0.75rem; color:var(--neutral-500);" class="tabular-nums">SKU: { v.Variant.SKU }</div>
									}
								</td>
								<td class="tabular-nums" style="font-weight:700; color:var(--neutral-700);">
									if v.Variant.BatchNumber != "" {
										{ v.Variant.BatchNumber }
									} else {
										<span style="color:var(--neutral-400); font-weight:normal;">-</span>
									}
								</td>
								<td class="tabular-nums" style="font-weight:900; color:var(--primary-800); font-size:1.05rem;">
									{ v.Variant.Price.String() } ج.م
								</td>
								<td class="tabular-nums" style="font-weight:800; color:var(--neutral-900);">
									{ fmt.Sprintf("%d عبوة", v.Variant.StockQty) }
								</td>
								<td class="tabular-nums" style="color:var(--neutral-600); font-size:0.85rem;">
									if v.Variant.ExpiryDate != nil {
										{ v.Variant.ExpiryDate.Format("2006-01-02") }
									} else {
										<span style="color:var(--neutral-400);">-</span>
									}
								</td>
								<td>
									if v.BranchName != "" {
										<span class="badge badge-slate" style="font-weight:700;">{ v.BranchName }</span>
									} else {
										<span style="color:var(--neutral-400); font-size:0.85rem;">المستودع الرئيسي</span>
									}
								</td>
								<td>
									if v.Variant.Status == "active" || v.Variant.Status == "" {
										<span class="badge badge-emerald" style="font-weight:800;">متاح للطلب</span>
									} else {
										<span class="badge badge-slate" style="font-weight:800;">غير متاح</span>
									}
								</td>
								<td>
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/variants/%d/delete", v.Variant.ID)) } style="margin:0;" onsubmit="return confirm('هل تريد إزالة هذا العرض من الكتالوج؟');">
										<button type="submit" class="btn btn-icon" style="color:var(--danger); background:transparent; border:none; width:32px; height:32px;" title="حذف العرض">
											@components.IconClose("icon-xs")
										</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
