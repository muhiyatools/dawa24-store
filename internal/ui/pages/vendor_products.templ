package pages

import (
	"fmt"
	"net/url"
	"time"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorVariantView struct {
	Variant       *catalog.ProductVariant
	MasterProduct *catalog.Product
	BranchName    string
	StockQuantity int
}

type VendorBranchOption struct {
	ID     int64
	Name   string
	IsMain bool
}

type VendorVariantsData struct {
	Variants   []*VendorVariantView
	Branches   []VendorBranchOption
	Filter     catalog.VendorVariantQuery
	PageSizes  []int
	Total      int
	Stats      catalog.VendorVariantStats
	LoadError  string
	NoticeType string
	NoticeMsg  string
}

templ VendorProducts(data VendorVariantsData, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorVariantsTable(data.Variants, lang)
	} else {
		@layouts.VendorShell("أصناف وعروض التوريد", "products", lang, dir) {
			<div class="page-container">
				
				<!-- Notice / Toast Banner -->
				if data.NoticeMsg != "" {
					if data.NoticeType == "error" {
						<div class="alert alert-danger mb-4 p-4 flex-between">
							<div class="d-flex items-center gap-3 font-extrabold text-sm">
								<span class="text-2xl">@components.IconAlert("icon-sm")</span>
								<span>{ data.NoticeMsg }</span>
							</div>
						</div>
					} else {
						<div class="alert alert-success mb-4 p-4 flex-between">
							<div class="d-flex items-center gap-3 font-extrabold text-sm">
								<span class="text-2xl">@components.IconCheckCircle("icon-sm")</span>
								<span>{ data.NoticeMsg }</span>
							</div>
						</div>
					}
				}

				if data.LoadError != "" {
					<div class="alert alert-danger mb-4 p-4 font-bold">
						<span>تعذر تحميل الأصناف: { data.LoadError }</span>
					</div>
				}

				<!-- Header Bar -->
				@components.PageHeader(components.PageHeaderProps{
					Title:      "أصناف وعروض التوريد والمخزون",
					Subtitle:   "إدارة عروض أسعار الجملة، أرقام التشغيلات، وتواريخ الصلاحية والربط مع الكتالوج المركزي",
					Count:      &data.Total,
					CountLabel: "عرض توريد",
				}) {
					<button
						type="button"
						class="btn btn-primary font-bold gap-2"
						data-modal-open="add-from-catalog-modal"
						onclick="openAddFromCatalogModal()"
					>
						@components.IconPlus("icon-xs")
						<span>إضافة من الكتالوج العام</span>
					</button>

					<button
						type="button"
						class="btn btn-secondary font-semibold gap-2"
						data-modal-open="add-custom-variant-modal"
						onclick="openAddCustomVariantModal()"
					>
						@components.IconPlus("icon-xs")
						<span>إضافة صنف مخصص</span>
					</button>

					<a href="/vendor/ingest" class="btn btn-secondary font-semibold gap-2">
						@components.IconUpload("icon-xs")
						<span>استيراد ملف الكتالوج (Excel)</span>
					</a>

					if data.Total > 0 {
						<form method="POST" action="/vendor/products/delete-all" class="d-inline m-0"
							onsubmit="return confirm('تحذير: هل أنت متأكد من حذف جميع أصناف وعروض التوريد الخاصة بك بالكامل؟ لا يمكن التراجع عن هذا الإجراء.');">
							<button type="submit" class="btn btn-ghost text-danger font-bold gap-2">
								<span>حذف جميع أصنافي</span>
							</button>
						</form>
					}
				}

				<!-- Headline Stats Strip -->
				if data.Stats.Total > 0 || len(data.Variants) > 0 {
					<div class="dashboard-stat-grid mb-6">
						@components.StatCard(components.StatCardProps{
							Label: "إجمالي أصناف التوريد",
							Value: fmt.Sprintf("%d صنف", data.Stats.Total),
							Tone:  "neutral",
						})
						@components.StatCard(components.StatCardProps{
							Label: "متوفر بالمخزون",
							Value: fmt.Sprintf("%d صنف", data.Stats.InStock),
							Tone:  "primary",
						})
						@components.StatCard(components.StatCardProps{
							Label: "أصناف منخفضة الرصيد",
							Value: fmt.Sprintf("%d صنف", data.Stats.LowStock),
							Tone:  "warning",
						})
						@components.StatCard(components.StatCardProps{
							Label: "أصناف نفد رصيدها",
							Value: fmt.Sprintf("%d صنف", data.Stats.OutOfStock),
							Tone:  "danger",
						})
						@components.StatCard(components.StatCardProps{
							Label: "تنتهي خلال 90 يوماً",
							Value: fmt.Sprintf("%d صنف", data.Stats.Expiring),
							Tone:  "warning",
						})
					</div>
				}

				<!-- Search, Filter & Sort Toolbar -->
				<div class="glass-panel p-4 mb-6">
					<form method="GET" action="/vendor/products" id="vendor-products-filter-form" class="d-flex flex-col gap-4">
						if data.Filter.PerPage > 0 {
							<input type="hidden" name="limit" value={ fmt.Sprintf("%d", data.Filter.PerPage) } />
						}

						<div class="flex-between flex-wrap gap-4">
							<!-- Search Input -->
							<div class="flex-1 min-w-0 max-w-xl position-relative d-flex gap-2">
								<div class="position-relative flex-1">
									<input
										type="text"
										name="q"
										value={ data.Filter.Query }
										placeholder="ابحث باسم الدواء، المادة الفعالة، رقم التشغيلة، الباركود أو SKU..."
										class="form-input ps-8"
									/>
									<div class="position-absolute start-3 top-half translate-middle-y text-muted pointer-events-none">
										@components.IconSearch("icon-xs")
									</div>
								</div>
								<button type="submit" class="btn btn-primary font-bold px-4">
									بحث
								</button>
								if data.Filter.Query != "" || data.Filter.Stock != "" || data.Filter.Expiring || data.Filter.Status != "" || data.Filter.Sort != "" {
									<a href="/vendor/products" class="btn btn-secondary" title="إعادة تعيين الفلاتر">
										إعادة تعيين
									</a>
								}
							</div>

							<!-- Sort Dropdown -->
							<div class="d-flex items-center gap-2">
								<label for="sort-select" class="text-xs text-secondary font-bold whitespace-nowrap">
									ترتيب حسب:
								</label>
								<select
									id="sort-select"
									name="sort"
									class="form-select form-input-sm font-bold"
									onchange="document.getElementById('vendor-products-filter-form').submit()"
								>
									<option value="" selected?={ data.Filter.Sort == "" }>الأحدث إضافة</option>
									<option value="oldest" selected?={ data.Filter.Sort == "oldest" }>الأقدم إضافة</option>
									<option value="name" selected?={ data.Filter.Sort == "name" }>الاسم أبجدياً (أ-ي)</option>
									<option value="price_asc" selected?={ data.Filter.Sort == "price_asc" }>السعر: من الأقل للأعلى</option>
									<option value="price_desc" selected?={ data.Filter.Sort == "price_desc" }>السعر: من الأعلى للأقل</option>
									<option value="stock_asc" selected?={ data.Filter.Sort == "stock_asc" }>الرصيد: من الأقل للأعلى</option>
									<option value="stock_desc" selected?={ data.Filter.Sort == "stock_desc" }>الرصيد: من الأعلى للأقل</option>
									<option value="expiry" selected?={ data.Filter.Sort == "expiry" }>تاريخ الصلاحية الأقرب</option>
								</select>
							</div>
						</div>

						<!-- Quick Stock & Expiry Filter Pills -->
						<div class="d-flex items-center gap-2 flex-wrap border-t pt-3">
							<span class="text-xs text-muted font-bold me-1">
								تصفية المخزون:
							</span>
							<a
								href={ templ.SafeURL(vendorFilterURL(data.Filter, catalog.StockFilterAny, false)) }
								class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.Filter.Stock == catalog.StockFilterAny && !data.Filter.Expiring), templ.KV("btn-secondary", data.Filter.Stock != catalog.StockFilterAny || data.Filter.Expiring) }
							>
								الكل ({ fmt.Sprintf("%d", data.Stats.Total) })
							</a>
							<a
								href={ templ.SafeURL(vendorFilterURL(data.Filter, catalog.StockFilterIn, false)) }
								class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.Filter.Stock == catalog.StockFilterIn && !data.Filter.Expiring), templ.KV("btn-secondary", data.Filter.Stock != catalog.StockFilterIn || data.Filter.Expiring) }
							>
								متوفر بالمخزن ({ fmt.Sprintf("%d", data.Stats.InStock) })
							</a>
							<a
								href={ templ.SafeURL(vendorFilterURL(data.Filter, catalog.StockFilterLow, false)) }
								class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.Filter.Stock == catalog.StockFilterLow && !data.Filter.Expiring), templ.KV("btn-secondary", data.Filter.Stock != catalog.StockFilterLow || data.Filter.Expiring) }
							>
								رصيد منخفض ({ fmt.Sprintf("%d", data.Stats.LowStock) })
							</a>
							<a
								href={ templ.SafeURL(vendorFilterURL(data.Filter, catalog.StockFilterOut, false)) }
								class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.Filter.Stock == catalog.StockFilterOut && !data.Filter.Expiring), templ.KV("btn-secondary", data.Filter.Stock != catalog.StockFilterOut || data.Filter.Expiring) }
							>
								نفد الرصيد ({ fmt.Sprintf("%d", data.Stats.OutOfStock) })
							</a>
							<a
								href={ templ.SafeURL(vendorFilterURL(data.Filter, catalog.StockFilterAny, true)) }
								class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.Filter.Expiring), templ.KV("btn-secondary", !data.Filter.Expiring) }
							>
								⏳ قرب انتهاء الصلاحية ({ fmt.Sprintf("%d", data.Stats.Expiring) })
							</a>
						</div>
					</form>
				</div>

				<!-- Variants Table -->
				<div id="vendor-products-content">
					if len(data.Variants) == 0 {
						if data.Filter.Query != "" || data.Filter.Stock != "" || data.Filter.Expiring || data.Filter.Status != "" {
							<div class="empty-state-glass p-8 text-center">
								<div class="empty-state-icon-wrapper mx-auto mb-3">@components.IconSearch("icon-sm")</div>
								<h3 class="font-extrabold text-lg text-primary m-0 mb-2">لا توجد أصناف تطابق معايير البحث المحددة</h3>
								<p class="text-sm text-muted mb-4 max-w-md mx-auto">
									جرب البحث بكلمات مختلفة أو قم بإزالة عوامل التصفية لعرض جميع أصناف التوريد.
								</p>
								<a href="/vendor/products" class="btn btn-secondary font-bold">
									إلغاء التصفية وعرض جميع الأصناف
								</a>
							</div>
						} else {
							@components.EmptyState(components.EmptyStateProps{
								Title:       "لا توجد أصناف توريد مسجلة حالياً",
								Message:     "قم باختيار الأدوية من الكتالوج العام وإضافة عروض الأسعار والكميات المتاحة لديك لبدء استقبال طلبيات الصيدليات.",
								ActionLabel: "+ إضافة صنف من الكتالوج العام",
								ActionURL:   "javascript:openAddFromCatalogModal()",
							})
						}
					} else {
						@VendorVariantsTable(data.Variants, lang)
					}
				</div>

				<!-- Bottom Pagination & Rows-Per-Page Controls -->
				if data.Total > 0 {
					<div class="glass-panel p-4 mt-4">
						<div class="flex-between flex-wrap gap-4">
							@components.B2BPagination(components.PaginationProps{
								CurrentPage: data.Filter.PageNumber,
								PageSize:    data.Filter.PerPage,
								TotalCount:  data.Total,
								BaseURL:     "/vendor/products",
								QueryValues: vendorPaginationQuery(data.Filter),
							})

							<form method="GET" action="/vendor/products" class="d-flex items-center gap-2 m-0">
								if data.Filter.Query != "" {
									<input type="hidden" name="q" value={ data.Filter.Query } />
								}
								if data.Filter.Status != "" {
									<input type="hidden" name="status" value={ data.Filter.Status } />
								}
								if data.Filter.Stock != "" {
									<input type="hidden" name="stock" value={ string(data.Filter.Stock) } />
								}
								if data.Filter.Expiring {
									<input type="hidden" name="expiring" value="1" />
								}
								if data.Filter.Sort != "" {
									<input type="hidden" name="sort" value={ data.Filter.Sort } />
								}
								<input type="hidden" name="page" value="1" />
								<label for="bottom-limit-select" class="text-xs text-secondary font-bold whitespace-nowrap">
									عرض في الصفحة:
								</label>
								<select
									id="bottom-limit-select"
									name="limit"
									class="form-input"
									class="w-auto font-bold text-xs rounded-md px-2 py-1"
									onchange="this.form.submit()"
								>
									for _, sz := range data.PageSizes {
										<option value={ fmt.Sprintf("%d", sz) } selected?={ data.Filter.PerPage == sz }>
											{ fmt.Sprintf("%d صنف", sz) }
										</option>
									}
								</select>
							</form>
						</div>
					</div>
				}

			</div>

			<!-- MODAL 1: Master Catalog Selection Modal -->
			@components.Modal(components.ModalProps{ID: "add-from-catalog-modal", Title: "????? ??? ?? ???????? ??????? ?????", Size: "xl"}) {
				<form method="POST" action="/vendor/products/add-from-catalog" id="add-from-catalog-form" class="d-flex flex-col flex-1 overflow-y-auto pe-1">
						<input type="hidden" id="cat-select-product-id" name="product_id" value="" />
						<input type="hidden" id="cat-select-name-ar" name="name_ar" value="" />
						<input type="hidden" id="cat-select-name-en" name="name_en" value="" />
						<input type="hidden" id="cat-select-sku" name="sku" value="" />
						<input type="hidden" id="cat-select-barcode" name="barcode" value="" />
						<input type="hidden" id="cat-select-unit" name="unit" value="" />

						<div class="stack-lg" class="flex-1">
							
							<!-- Search Input for General Catalog -->
							<div class="relative w-full">
								<label class="form-label" class="font-extrabold text-primary text-sm mb-1">
									1. ابحث في الكتالوج المركزي العام <span class="text-danger">*</span>
								</label>
								<div class="relative w-full">
									<input
										type="text"
										id="cat-search-input"
										placeholder="اكتب اسم الدواء، المادة الفعالة، أو كود SKU..."
										class="form-input"
										class="w-full rounded-lg ps-11 text-sm h-11"
										oninput="searchMasterCatalogLive(this.value)"
										autocomplete="off"
									/>
									<div class="absolute start-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none d-flex items-center">
										@components.IconSearch("icon-sm")
									</div>
								</div>

								<!-- Dropdown Results in flow -->
								<div id="cat-search-dropdown" class="d-none max-h-72 overflow-y-auto bg-surface-sunken border rounded-2xl shadow-xl mt-2"></div>
							</div>

							<!-- Selected Product Info Card Preview -->
							<div id="cat-selected-preview" class="d-none bg-surface-sunken border border-accent rounded-2xl p-5">
								<div class="flex-between items-start mb-3">
									<div>
										<span class="badge badge-emerald" class="badge badge-emerald text-xs font-black mb-1 inline-block">صنف معتمد تم اختياره</span>
										<h4 id="cat-preview-name" class="text-base font-black text-primary m-0"></h4>
										<div id="cat-preview-scientific" class="text-xs text-muted mt-0.5"></div>
									</div>
									<button type="button" class="btn btn-secondary btn-sm" onclick="resetSelectedMasterProduct()" class="btn btn-secondary btn-sm text-xs text-danger font-bold">
										تغيير الصنف 
									</button>
								</div>
								
								<div class="d-flex gap-2 flex-wrap text-xs text-secondary">
									<span id="cat-preview-dosage" class="badge badge-slate"></span>
									<span id="cat-preview-sku" class="badge badge-slate"></span>
									<span id="cat-preview-price" class="badge badge-sky"></span>
								</div>
							</div>

							<!-- Vendor Customization Fields -->
							<div id="cat-vendor-fields" class="d-none flex-col gap-4 border-t pt-5">
								<div class="font-extrabold text-sm text-primary">
									2. حدد شروط وسعر التوريد الخاص بك:
								</div>

								<div class="grid-2">
									<div>
										<label class="form-label fw-700 text-primary text-sm">
											سعر الجمهور (ج.م) <span class="text-danger">*</span>
										</label>
										<input
											type="number"
											step="0.01"
											id="cat-field-price"
											name="price"
											required
											placeholder="0.00"
											class="form-input w-full-rounded"
										/>
									</div>

									<div>
										<label class="form-label fw-700 text-primary text-sm">
											نسبة الخصم للصيدليات (%)
										</label>
										<input
											type="number"
											step="0.1"
											min="0"
											max="100"
											id="cat-field-discount"
											name="discount"
											placeholder="مثال: 15.5%"
											class="form-input w-full-rounded"
										/>
									</div>
								</div>

								<div class="grid-2">
									<div>
										<label class="form-label fw-700 text-primary text-sm d-flex items-center gap-1">
											<span>سعر التكلفة (ج.م)</span>
											<span class="badge badge-slate text-xs">اختياري</span>
										</label>
										<input
											type="number"
											step="0.01"
											min="0"
											id="cat-field-cost"
											name="cost_price"
											placeholder="0.00 (إن وجد)"
											class="form-input w-full-rounded"
										/>
									</div>

									<div>
										<label class="form-label fw-700 text-primary text-sm d-flex items-center gap-1">
											<span>خصم التكلفة (%)</span>
											<span class="badge badge-slate text-xs">اختياري</span>
										</label>
										<input
											type="number"
											step="0.1"
											min="0"
											max="100"
											id="cat-field-cost-discount"
											name="cost_discount_percentage"
											placeholder="0.0%"
											class="form-input w-full-rounded"
										/>
									</div>
								</div>

								<div class="grid-2">
									<div>
										<label class="form-label fw-700 text-primary text-sm">
											الرصيد المتاح حالياً (الكمية الافتتاحية)
										</label>
										<input
 type="number"
 id="cat-field-stock"
 name="stock_qty"
 placeholder="50"
 class="form-input w-full-rounded"
 
 />
									</div>

									<div>
										<label class="form-label fw-700 text-primary text-sm">
											الحد الأدنى للطلب (عبوة)
										</label>
										<input
 type="number"
 id="cat-field-min-qty"
 name="min_order_qty"
 value="1"
 min="1"
 class="form-input w-full-rounded"
 
 />
									</div>
								</div>

								<div class="grid-2">
									<div>
										<label class="form-label fw-700 text-primary text-sm">
											رقم التشغيلة (Batch Number)
										</label>
										<input
 type="text"
 id="cat-field-batch"
 name="batch_number"
 placeholder="مثال: B202604"
 class="form-input w-full-rounded"
 
 />
									</div>

									<div>
										<label class="form-label fw-700 text-primary text-sm">
											تاريخ انتهاء الصلاحية
										</label>
										<input
 type="date"
 id="cat-field-expiry"
 name="expiry_date"
 class="form-input w-full-rounded"
 
 />
									</div>
								</div>

								<div class="grid-2">
									<div>
										<label class="form-label fw-700 text-primary text-sm">
											مخزن / فرع الشحن
										</label>
										<select name="branch_id" id="cat-field-branch" class="form-input w-full-rounded">
											for _, b := range data.Branches {
												<option value={ fmt.Sprintf("%d", b.ID) } selected?={ b.IsMain }>
													{ b.Name }
													if b.IsMain {
														<span> (الفرع الرئيسي)</span>
													}
												</option>
											}
										</select>
									</div>

									<div>
										<label class="form-label fw-700 text-primary text-sm">
											قابل للتفاوض على السعر؟
										</label>
										<select name="is_negotiable" id="cat-field-negotiable" class="form-input" class="form-input w-full rounded-lg font-bold">
											<option value="false">لا (سعر توريد ثابت)</option>
											<option value="true">نعم (يسمح بالتفاوض على السعر)</option>
										</select>
									</div>
								</div>

								<div class="modal-footer">
									<button type="button" class="btn btn-secondary font-bold" onclick="closeAddFromCatalogModal()">
										إلغاء
									</button>
									<button type="submit" class="btn btn-primary font-bold px-6">
										حفظ وإضافة الصنف للتوريد
									</button>
								</div>
							</div>

						</div>
					</form>
			}

			<!-- MODAL 2: Quick Edit Variant Modal -->
			@components.Modal(components.ModalProps{ID: "edit-variant-modal", Title: "????? ?????? ???? ??? ???????", Size: "md"}) {
				<form method="POST" id="edit-variant-form" action="/vendor/variants/0/update">
						<div class="stack-md">
							
							<div>
								<label class="form-label fw-700 text-primary text-sm">
									اسم العرض / التعبئة (عربي)
								</label>
								<input
 type="text"
 id="edit-form-name-ar"
 name="name_ar"
 required
 class="form-input w-full-rounded"
 
 />
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm">
										سعر الجمهور (ج.م) <span class="text-danger">*</span>
									</label>
									<input
										type="number"
										step="0.01"
										id="edit-form-price"
										name="price"
										required
										class="form-input w-full-rounded"
									/>
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										نسبة الخصم (%)
									</label>
									<input
										type="number"
										step="0.1"
										min="0"
										max="100"
										id="edit-form-discount"
										name="discount"
										placeholder="0.0%"
										class="form-input w-full-rounded"
									/>
								</div>
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm d-flex items-center gap-1">
										<span>سعر التكلفة (ج.م)</span>
										<span class="badge badge-slate text-xs">اختياري</span>
									</label>
									<input
										type="number"
										step="0.01"
										min="0"
										id="edit-form-cost"
										name="cost_price"
										placeholder="0.00 (إن وجد)"
										class="form-input w-full-rounded"
									/>
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm d-flex items-center gap-1">
										<span>خصم التكلفة (%)</span>
										<span class="badge badge-slate text-xs">اختياري</span>
									</label>
									<input
										type="number"
										step="0.1"
										min="0"
										max="100"
										id="edit-form-cost-discount"
										name="cost_discount_percentage"
										placeholder="0.0%"
										class="form-input w-full-rounded"
									/>
								</div>
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm">
										تحديث الرصيد بالمخزن (عبوة)
									</label>
									<input
 type="number"
 id="edit-form-stock"
 name="stock_qty"
 placeholder="الكمية الحالية..."
 class="form-input w-full-rounded"
 
 />
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										الحد الأدنى للطلب
									</label>
									<input
 type="number"
 id="edit-form-min-qty"
 name="min_order_qty"
 min="1"
 class="form-input w-full-rounded"
 
 />
								</div>
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm">
										رقم التشغيلة (Batch Number)
									</label>
									<input
 type="text"
 id="edit-form-batch"
 name="batch_number"
 class="form-input w-full-rounded"
 
 />
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										تاريخ الصلاحية
									</label>
									<input
 type="date"
 id="edit-form-expiry"
 name="expiry_date"
 class="form-input w-full-rounded"
 
 />
								</div>
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm">
										مخزن / فرع الشحن
									</label>
									<select name="branch_id" id="edit-form-branch" class="form-input w-full-rounded">
										for _, b := range data.Branches {
											<option value={ fmt.Sprintf("%d", b.ID) } selected?={ b.IsMain }>
												{ b.Name }
												if b.IsMain {
													<span> (الفرع الرئيسي)</span>
												}
											</option>
										}
									</select>
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										حالة العرض
									</label>
									<select name="status" id="edit-form-status" class="form-input w-full-rounded">
										<option value="active">نشط ومتاح للطلب</option>
										<option value="inactive">معطل مؤقتاً</option>
									</select>
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										قابل للتفاوض على السعر؟
									</label>
									<select name="is_negotiable" id="edit-form-negotiable" class="form-input" class="form-input w-full rounded-lg font-bold">
										<option value="false">لا (سعر توريد ثابت)</option>
										<option value="true">نعم (يسمح بالتفاوض على السعر)</option>
									</select>
								</div>
							</div>

						</div>

						<div class="modal-footer">
							<button type="button" class="btn btn-secondary font-bold" onclick="closeEditVariantModal()">
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary font-bold px-6">
								حفظ التعديلات
							</button>
						</div>
					</form>
			}

			<!-- MODAL 3: Add Custom Variant Modal -->
			@components.Modal(components.ModalProps{ID: "add-custom-variant-modal", Title: "????? ??? ?? ?????? ????? ?????", Size: "md"}) {
				<form method="POST" action="/vendor/variants/new">
						<div class="stack-md">
							
							<div>
								<label class="form-label fw-700 text-primary text-sm">
									اسم الصنف / العرض (عربي) <span class="text-danger">*</span>
								</label>
								<input
 type="text"
 name="name_ar"
 required
 placeholder="مثال: بانادول إكسترا 24 قرص"
 class="form-input w-full-rounded"
 
 />
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm">
										كود SKU (اختياري)
									</label>
									<input
 type="text"
 name="sku"
 placeholder="PAN-EXT-24"
 class="form-input w-full-rounded"
 
 />
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										سعر الجمهور (ج.م) <span class="text-danger">*</span>
									</label>
									<input
 type="number"
 step="0.01"
 name="price"
 required
 placeholder="0.00"
 class="form-input w-full-rounded"
 
 />
								</div>
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm">
										نسبة الخصم (%)
									</label>
									<input
										type="number"
										step="0.1"
										min="0"
										max="100"
										name="discount"
										placeholder="0.0%"
										class="form-input w-full-rounded"
									/>
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										الرصيد المتاح (الكمية الافتتاحية)
									</label>
									<input
										type="number"
										name="stock_qty"
										placeholder="50"
										class="form-input w-full-rounded"
									/>
								</div>
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm d-flex items-center gap-1">
										<span>سعر التكلفة (ج.م)</span>
										<span class="badge badge-slate text-xs">اختياري</span>
									</label>
									<input
										type="number"
										step="0.01"
										min="0"
										name="cost_price"
										placeholder="0.00 (إن وجد)"
										class="form-input w-full-rounded"
									/>
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm d-flex items-center gap-1">
										<span>خصم التكلفة (%)</span>
										<span class="badge badge-slate text-xs">اختياري</span>
									</label>
									<input
										type="number"
										step="0.1"
										min="0"
										max="100"
										name="cost_discount_percentage"
										placeholder="0.0%"
										class="form-input w-full-rounded"
									/>
								</div>
							</div>

							<div class="grid-2">
								<div>
									<label class="form-label fw-700 text-primary text-sm">
										رقم التشغيلة (Batch Number)
									</label>
									<input
 type="text"
 name="batch_number"
 placeholder="B12345"
 class="form-input w-full-rounded"
 
 />
								</div>

								<div>
									<label class="form-label fw-700 text-primary text-sm">
										تاريخ الصلاحية
									</label>
									<input
 type="date"
 name="expiry_date"
 class="form-input w-full-rounded"
 
 />
								</div>
							</div>

							<div>
								<label class="form-label fw-700 text-primary text-sm">
									مخزن / فرع الشحن
								</label>
								<select name="branch_id" class="form-input w-full-rounded">
									for _, b := range data.Branches {
										<option value={ fmt.Sprintf("%d", b.ID) } selected?={ b.IsMain }>
											{ b.Name }
											if b.IsMain {
												<span> (الفرع الرئيسي)</span>
											}
										</option>
									}
								</select>
							</div>

						</div>

						<div class="modal-footer">
							<button type="button" class="btn btn-secondary font-bold" onclick="closeAddCustomVariantModal()">
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary font-bold px-6">
								نشر الصنف في الكتالوج
							</button>
						</div>
					</form>
			}

			<!-- Live JS Logic for all Modals and Autocomplete -->
			<script>
				function openAddFromCatalogModal() {
					resetSelectedMasterProduct();
					document.getElementById('cat-search-input').value = '';
					const el = document.getElementById('add-from-catalog-modal');
					if (el && typeof el.showModal === 'function') {
						el.showModal();
					}
				}

				function closeAddFromCatalogModal() {
					const el = document.getElementById('add-from-catalog-modal');
					if (el && typeof el.close === 'function') {
						el.close();
					}
				}

				function openAddCustomVariantModal() {
					const el = document.getElementById('add-custom-variant-modal');
					if (el && typeof el.showModal === 'function') {
						el.showModal();
					}
				}

				function closeAddCustomVariantModal() {
					const el = document.getElementById('add-custom-variant-modal');
					if (el && typeof el.close === 'function') {
						el.close();
					}
				}

				function openEditVariantModal(id) {
					const row = document.querySelector(`.vendor-variant-row[data-id="${id}"]`);
					if (!row) return;

					document.getElementById('edit-variant-form').action = `/vendor/variants/${id}/update`;
					document.getElementById('edit-form-name-ar').value = row.dataset.name || '';
					document.getElementById('edit-form-price').value = row.dataset.price || '';
					document.getElementById('edit-form-discount').value = row.dataset.discount || '';
					if (document.getElementById('edit-form-cost')) {
						document.getElementById('edit-form-cost').value = row.dataset.costPrice || '';
					}
					if (document.getElementById('edit-form-cost-discount')) {
						document.getElementById('edit-form-cost-discount').value = (row.dataset.costDiscount && row.dataset.costDiscount !== '0.00') ? row.dataset.costDiscount : '';
					}
					document.getElementById('edit-form-stock').value = row.dataset.stock || '';
					document.getElementById('edit-form-min-qty').value = row.dataset.minQty || '1';
					document.getElementById('edit-form-batch').value = row.dataset.batch || '';
					document.getElementById('edit-form-expiry').value = row.dataset.expiry || '';
					
					const branchSelect = document.getElementById('edit-form-branch');
					if (branchSelect) {
						if (row.dataset.branchId && row.dataset.branchId !== '' && row.dataset.branchId !== '0') {
							branchSelect.value = row.dataset.branchId;
						}
						if (!branchSelect.value && branchSelect.options.length > 0) {
							branchSelect.selectedIndex = 0;
						}
					}

					const el = document.getElementById('edit-variant-modal');
					if (el && typeof el.showModal === 'function') {
						el.showModal();
					}
				}

				function closeEditVariantModal() {
					const el = document.getElementById('edit-variant-modal');
					if (el && typeof el.close === 'function') {
						el.close();
					}
				}

				let catSearchDebounce = null;
				function searchMasterCatalogLive(query) {
					clearTimeout(catSearchDebounce);
					const dropdown = document.getElementById('cat-search-dropdown');
					if (!query || query.trim().length < 2) {
						dropdown.style.display = 'none';
						return;
					}

					catSearchDebounce = setTimeout(() => {
						fetch('/vendor/catalog/search-json?q=' + encodeURIComponent(query.trim()))
							.then(r => r.json())
							.then(items => {
								if (!items || items.length === 0) {
									dropdown.innerHTML = '<div class="p-3 text-muted text-xs text-center">لم يتم العثور على أدوية مطابقة بالكتالوج</div>';
									dropdown.style.display = 'block';
									return;
								}

								let html = '';
								items.forEach(it => {
									const dosage = it.dosage_form ? ('<span class="badge badge-slate text-xs">' + it.dosage_form + '</span>') : '';
									const priceBadge = it.price ? ('<span class="badge badge-sky text-xs">' + it.price + ' ج.م</span>') : '';
									const safeName = (it.name_ar || it.name_en || '').replace(/'/g, "\\'");
									const safeSci = (it.scientific_name || '').replace(/'/g, "\\'");
									const safeSku = (it.sku || '').replace(/'/g, "\\'");
									const safeUnit = (it.unit || '').replace(/'/g, "\\'");
									
									html += '<div class="p-3 border-b cursor-pointer flex-between items-center transition-colors" ' +
										'onmouseover="this.style.background=\'var(--surface-sunken)\'" onmouseout="this.style.background=\'\'" ' +
										'onclick="selectMasterProductForStaging(' + it.id + ', \'' + safeName + '\', \'' + safeSci + '\', \'' + (it.dosage_form || '') + '\', \'' + safeSku + '\', \'' + (it.price || '') + '\', \'' + safeUnit + '\')">' +
										'<div>' +
											'<div class="font-extrabold text-primary text-sm">' + (it.name_ar || it.name_en) + '</div>' +
											'<div class="text-xs text-muted mt-0.5">' + (it.scientific_name || '') + '</div>' +
										'</div>' +
										'<div class="row-center-sm">' +
											dosage + priceBadge +
											'<span class="badge badge-emerald text-xs fw-800">اختيار</span>' +
										'</div>' +
									'</div>';
								});
								dropdown.innerHTML = html;
								dropdown.style.display = 'block';
							})
							.catch(() => {
								dropdown.style.display = 'none';
							});
					}, 200);
				}

				function selectMasterProductForStaging(id, name, scientific, dosage, sku, price, unit) {
					document.getElementById('cat-select-product-id').value = id;
					document.getElementById('cat-select-name-ar').value = name;
					document.getElementById('cat-select-sku').value = sku;
					document.getElementById('cat-select-unit').value = unit;

					document.getElementById('cat-preview-name').textContent = name;
					document.getElementById('cat-preview-scientific').textContent = scientific ? ('المادة الفعالة: ' + scientific) : '';
					document.getElementById('cat-preview-dosage').textContent = dosage ? ('الشكل: ' + dosage) : 'شكل دوائي قياسي';
					document.getElementById('cat-preview-sku').textContent = sku ? ('SKU: ' + sku) : '';
					document.getElementById('cat-preview-price').textContent = price ? ('السعر بالكتالوج: ' + price + ' ج.م') : '';

					if (price && price !== '') {
						document.getElementById('cat-field-price').value = price;
					}

					document.getElementById('cat-search-dropdown').style.display = 'none';
					document.getElementById('cat-selected-preview').style.display = 'block';
					document.getElementById('cat-vendor-fields').style.display = 'flex';
				}

				function resetSelectedMasterProduct() {
					document.getElementById('cat-select-product-id').value = '';
					document.getElementById('cat-select-name-ar').value = '';
					document.getElementById('cat-select-sku').value = '';
					document.getElementById('cat-selected-preview').style.display = 'none';
					document.getElementById('cat-vendor-fields').style.display = 'none';
				}
			</script>
		}
	}
}

templ VendorVariantsTable(variants []*VendorVariantView, lang string) {
	<div class="table-container">
		<table class="data-table">
			<thead>
				<tr>
					<th>الصنف الدوائي المعتمد</th>
					<th>المواصفات و SKU</th>
					<th class="tabular-nums">سعر الجمهور والخصم</th>
					<th class="tabular-nums">سعر التكلفة والخصم</th>
					<th class="tabular-nums">صافي ربح الوحدة</th>
					<th class="text-center">الرصيد المتاح</th>
					<th>تاريخ الصلاحية</th>
					<th>مخزن الشحن</th>
					<th class="text-center">الإجراءات</th>
				</tr>
			</thead>
			<tbody>
				for _, v := range variants {
					<tr
						class="vendor-variant-row"
						data-id={ fmt.Sprintf("%d", v.Variant.ID) }
						data-name={ v.Variant.Name.Get(i18n.AR) }
						data-price={ v.Variant.Price.String() }
						data-discount={ v.Variant.Discount.String() }
						data-cost-price={ formatCostPrice(v.Variant) }
						data-cost-discount={ fmt.Sprintf("%.2f", v.Variant.CostDiscountPercentage) }
						data-stock={ fmt.Sprintf("%d", v.Variant.StockQty) }
						data-min-qty={ fmt.Sprintf("%d", v.Variant.MinOrderQty) }
						data-batch={ v.Variant.BatchNumber }
						data-expiry={ formatExpiryDate(v.Variant.ExpiryDate) }
						data-branch-id={ branchIDStr(v.Variant.BranchID) }
						id={ fmt.Sprintf("variant-row-%d", v.Variant.ID) }
					>
						<!-- Product Info & Avatar -->
						<td>
							<div class="d-flex items-center gap-3">
								<div class="user-avatar-badge">
									if v.MasterProduct != nil && v.MasterProduct.Image != "" {
										<img src={ v.MasterProduct.Image } alt="Product" class="w-full h-full object-contain p-1" />
									} else {
										<div class="text-brand">
											@components.IconPill("icon-sm")
										</div>
									}
								</div>
								<div class="d-flex flex-col min-w-0">
									<div class="font-extrabold text-primary text-sm line-clamp-2">
										if v.MasterProduct != nil {
											{ v.MasterProduct.Name.Get(i18n.Lang(lang)) }
										} else {
											{ v.Variant.Name.Get(i18n.Lang(lang)) }
										}
									</div>
									<div class="d-flex items-center gap-2 text-xs text-muted mt-1">
										if v.MasterProduct != nil && v.MasterProduct.DosageForm != "" {
											<span class="badge badge-slate text-xs">{ v.MasterProduct.DosageForm }</span>
										}
										if v.MasterProduct != nil && v.MasterProduct.ManufacturingCompanies != "" {
											<span class="text-truncate max-w-140">{ v.MasterProduct.ManufacturingCompanies }</span>
										}
									</div>
								</div>
							</div>
						</td>

						<!-- Variant Name & SKU -->
						<td>
							<div class="text-xs font-bold text-primary">
								{ v.Variant.Name.Get(i18n.Lang(lang)) }
							</div>
							if v.Variant.SKU != "" {
								<div class="tabular-nums text-xs text-muted mt-1">
									<code>SKU: { v.Variant.SKU }</code>
								</div>
							}
							if v.Variant.BatchNumber != "" {
								<div class="tabular-nums text-xs text-secondary mt-1">
									تشغيلة: { v.Variant.BatchNumber }
								</div>
							}
						</td>

						<!-- Public Selling Price & Discount -->
						<td>
							<div class="tabular-nums font-black text-brand text-sm">
								if v.Variant.Discount.IsPositive() {
									{ v.Variant.Price.ApplyPercent(int64((100.0 - (float64(v.Variant.Discount.Minor())/100.0)) * 100)).String() } <span class="text-xs font-semibold text-secondary">ج.م</span>
								} else {
									{ v.Variant.Price.String() } <span class="text-xs font-semibold text-secondary">ج.م</span>
								}
							</div>
							<div class="d-flex items-center gap-1 text-xs text-muted mt-1">
								<span class="text-xs">الجمهور: { v.Variant.Price.String() }</span>
								if v.Variant.Discount.IsPositive() {
									<span class="badge badge-emerald text-xs font-bold">-{ v.Variant.Discount.String() }%</span>
								}
							</div>
							if v.Variant.MinOrderQty > 1 {
								<div class="text-xs text-muted mt-0.5">
									أقل طلب: { fmt.Sprintf("%d", v.Variant.MinOrderQty) }
								</div>
							}
						</td>

						<!-- Cost Price & Cost Discount -->
						<td>
							if v.Variant.HasCostPrice() {
								<div class="tabular-nums font-bold text-primary text-sm">
									{ v.Variant.DiscountedCost().String() } <span class="text-xs font-semibold text-secondary">ج.م</span>
								</div>
								<div class="d-flex items-center gap-1 text-xs text-muted mt-1">
									<span>الأصل: { v.Variant.CostPrice.String() }</span>
									if v.Variant.CostDiscountPercentage > 0 {
										<span class="badge badge-sky text-xs font-bold">-{ fmt.Sprintf("%.1f%%", v.Variant.CostDiscountPercentage) }</span>
									}
								</div>
							} else {
								<span class="badge badge-slate text-xs">غير محدد (ربح كامل)</span>
							}
						</td>

						<!-- Net Profit & Margin -->
						<td>
							<div class="tabular-nums font-black text-success text-sm">
								+{ v.Variant.UnitNetProfit().String() } <span class="text-xs font-semibold text-secondary">ج.م</span>
							</div>
							<div class="text-xs text-brand font-bold mt-1">
								هامش: { fmt.Sprintf("%.1f%%", v.Variant.ProfitMarginPercent()) }
							</div>
						</td>

						<!-- Stock Quantity -->
						<td class="text-center">
							if v.StockQuantity > 10 {
								<span class="badge badge-emerald tabular-nums font-extrabold text-xs">
									{ fmt.Sprintf("%d عبوة", v.StockQuantity) }
								</span>
							} else if v.StockQuantity > 0 {
								<span class="badge badge-amber tabular-nums font-extrabold text-xs">
									{ fmt.Sprintf("%d متبقي", v.StockQuantity) }
								</span>
							} else {
								<span class="badge badge-rose tabular-nums font-bold text-xs">
									نفد الرصيد
								</span>
							}
						</td>

						<!-- Expiry Date -->
						<td>
							if v.Variant.ExpiryDate != nil {
								<div class="tabular-nums font-bold text-secondary text-xs">
									{ v.Variant.ExpiryDate.Format("2006-01-02") }
								</div>
							} else {
								<span class="text-muted text-sm">-</span>
							}
						</td>

						<!-- Shipping Branch / Warehouse -->
						<td>
							if v.BranchName != "" {
								<span class="badge badge-sky font-bold text-xs">
									{ v.BranchName }
								</span>
							} else {
								<span class="text-secondary text-xs">المخزن الرئيسي</span>
							}
						</td>

						<!-- Actions -->
						<td class="text-center">
							<div class="d-flex items-center justify-center gap-1">
								<button
									type="button"
									class="btn btn-secondary btn-icon text-brand"
									title="تعديل بيانات وسعر الصنف"
									data-variant-id={ fmt.Sprintf("%d", v.Variant.ID) }
									onclick="openEditVariantModal(this.getAttribute('data-variant-id'))"
								>
									@components.IconEdit("icon-xs")
								</button>

								if v.Variant.ProductID > 0 {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", v.Variant.ProductID)) }
										target="_blank"
										class="btn btn-secondary btn-icon text-muted"
										title="معاينة في المتجر"
									>
										@components.IconEye("icon-xs")
									</a>
								}

								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/variants/%d/delete", v.Variant.ID)) } class="m-0 d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا العرض من قائمة التوريد؟');">
									<button
										type="submit"
										class="btn btn-secondary btn-icon text-danger"
										title="حذف العرض"
									>
										@components.IconTrash("icon-xs")
									</button>
								</form>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

func vendorPaginationQuery(filter catalog.VendorVariantQuery) url.Values {
	q := url.Values{}
	if filter.Query != "" {
		q.Set("q", filter.Query)
	}
	if filter.Status != "" {
		q.Set("status", filter.Status)
	}
	if filter.Stock != "" {
		q.Set("stock", string(filter.Stock))
	}
	if filter.Expiring {
		q.Set("expiring", "1")
	}
	if filter.Sort != "" {
		q.Set("sort", filter.Sort)
	}
	if filter.PerPage > 0 {
		q.Set("limit", fmt.Sprintf("%d", filter.PerPage))
	}
	return q
}

func vendorFilterURL(filter catalog.VendorVariantQuery, stock catalog.StockFilter, expiring bool) string {
	q := url.Values{}
	if filter.Query != "" {
		q.Set("q", filter.Query)
	}
	if filter.Status != "" {
		q.Set("status", filter.Status)
	}
	if stock != "" {
		q.Set("stock", string(stock))
	}
	if expiring {
		q.Set("expiring", "1")
	}
	if filter.Sort != "" {
		q.Set("sort", filter.Sort)
	}
	if filter.PerPage > 0 {
		q.Set("limit", fmt.Sprintf("%d", filter.PerPage))
	}
	encoded := q.Encode()
	if encoded == "" {
		return "/vendor/products"
	}
	return "/vendor/products?" + encoded
}

func formatExpiryDate(t *time.Time) string {
	if t == nil {
		return ""
	}
	return t.Format("2006-01-02")
}

func formatCostPrice(v *catalog.ProductVariant) string {
	if v == nil || v.CostPrice == nil || v.CostPrice.IsZero() {
		return ""
	}
	return v.CostPrice.String()
}

func branchIDStr(id *int64) string {
	if id != nil && *id > 0 {
		return fmt.Sprintf("%d", *id)
	}
	return ""
}
