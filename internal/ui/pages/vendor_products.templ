package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorProducts(products []*catalog.Product, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorProductsTable(products)
	} else {
		@layouts.VendorShell("إدارة الأدوية والمنتجات | Products", "products", lang, dir) {
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">قائمة الأدوية المتاحة</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">إدارة الأسعار والتوافر والعبوات المعروضة للصيدليات</p>
				</div>
				<a href="/vendor/products/new" class="btn btn-primary">
					+ إضافة منتج جديد
				</a>
			</div>

			<div id="vendor-products-content">
				@VendorProductsTable(products)
			</div>
		}
	}
}

templ VendorProductsTable(products []*catalog.Product) {
	if len(products) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:       "لا توجد منتجات مسجلة",
			Message:     "لم تقم بإضافة أي أدوية أو مستلزمات لكتالوج شركتك بعد.",
			ActionLabel: "+ إضافة منتج جديد",
		})
	} else {
		<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-lg); overflow:hidden;">
			<table style="width:100%; border-collapse:collapse; text-align:start; font-size:0.9rem;">
				<thead>
					<tr style="background:var(--neutral-50); border-bottom:1px solid var(--neutral-200);">
						<th style="padding:0.75rem 1rem;">الاسم العربي</th>
						<th style="padding:0.75rem 1rem;">الاسم الإنجليزي</th>
						<th style="padding:0.75rem 1rem;">الشكل الصيدلي</th>
						<th style="padding:0.75rem 1rem;">الحالة</th>
						<th style="padding:0.75rem 1rem; text-align:end;">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range products {
						<tr style="border-bottom:1px solid var(--neutral-100);">
							<td style="padding:0.75rem 1rem; font-weight:700; color:var(--neutral-900);">{ p.Name["ar"] }</td>
							<td style="padding:0.75rem 1rem; color:var(--neutral-600);">{ p.Name["en"] }</td>
							<td style="padding:0.75rem 1rem;">{ p.DosageForm }</td>
							<td style="padding:0.75rem 1rem;">
								<span style="font-size:0.75rem; padding:0.2rem 0.5rem; border-radius:4px; background:var(--success-50); color:var(--success-700); font-weight:600;">
									{ string(p.Status) }
								</span>
							</td>
							<td style="padding:0.75rem 1rem; text-align:end;">
								<a href={ templ.SafeURL(fmt.Sprintf("/vendor/products/%d", p.ID)) } class="btn btn-secondary" style="font-size:0.8rem; padding:0.3rem 0.6rem;">
									تعديل ✏️
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
