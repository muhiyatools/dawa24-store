package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ WalletPage(data WalletViewData, lang, dir string) {
	@layouts.ShellFor(i18n.T(lang, "wallet.title"), "wallet", lang, dir, authctx.FromContext(ctx)) {
		@walletContent(data, lang, dir)
	}
}

templ walletContent(data WalletViewData, lang, dir string) {
	{{
		pendingCount := computePendingDepositsCount(data.DepositRequests) + computePendingWithdrawalsCount(data.WithdrawalRequests)
		completedCount := len(data.Transactions)
		totalOpsCount := completedCount + pendingCount
	}}
	<div
		class="page-container"
		x-data={ walletState(data) }
	>
		<!-- Compact Page Header -->
		<div class="d-flex items-center justify-between flex-wrap gap-3 mb-4">
			<div>
				<h1 class="page-title font-bold text-xl m-0 d-flex items-center gap-2">
					@components.IconWallet("icon-sm")
					<span>{ i18n.T(lang, "wallet.title") }</span>
				</h1>
				<p class="text-xs text-secondary m-0 mt-1">
					{ i18n.T(lang, "wallet.desc") }
				</p>
			</div>

			<div class="d-flex items-center gap-2">
				<button
					type="button"
					class="btn btn-secondary btn-sm font-bold"
					@click="openWithdrawModal()"
				>
					@components.IconArrowLeft("icon-xs")
					<span>{ i18n.T(lang, "wallet.withdraw_title") }</span>
				</button>

				<button
					type="button"
					class="btn btn-primary btn-sm font-bold"
					@click="openDepositModal()"
				>
					@components.IconPlus("icon-xs")
					<span>{ i18n.T(lang, "wallet.deposit_title") }</span>
				</button>
			</div>
		</div>

		<!-- Flash Notices -->
		if data.NoticeMessage != "" {
			if data.NoticeType == "error" {
				<div class="alert alert-danger mb-4">
					@components.IconAlert("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			} else {
				<div class="alert alert-success mb-4">
					@components.IconCheckCircle("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			}
		}

		<!-- Financial Balance Bar (4 Stat Cards) -->
		<div class="dashboard-stat-grid cols-4 mb-4">
			<!-- Card 1: Available Balance -->
			<div class="stat-card-3d">
				<div class="stat-card-label">{ i18n.T(lang, "wallet.available_balance") }</div>
				<div class={ "stat-card-value tabular-nums", walletAvailableBalanceClass(data.Wallet) }>
					{ walletAvailableBalance(data.Wallet) }
				</div>
				<div class="stat-card-sub">
					{ i18n.T(lang, "wallet.available_balance_sub") }
				</div>
			</div>

			<!-- Card 2: Pending Withdrawal Balance -->
			<div class="stat-card-3d">
				<div class="stat-card-label">{ i18n.T(lang, "wallet.pending_balance") }</div>
				<div class="stat-card-value text-amber tabular-nums">
					{ walletPendingWithdrawal(data.Wallet) }
				</div>
				<div class="stat-card-sub">
					{ fmt.Sprintf(i18n.T(lang, "wallet.pending_withdrawals_count"), computePendingWithdrawalsCount(data.WithdrawalRequests)) }
				</div>
			</div>

			<!-- Card 3: Total Balance -->
			<div class="stat-card-3d">
				<div class="stat-card-label">{ i18n.T(lang, "wallet.total_balance") }</div>
				<div class={ "stat-card-value tabular-nums", walletBalanceClass(data.Wallet) }>
					{ walletBalance(data.Wallet) }
				</div>
				<div class="stat-card-sub">
					{ i18n.T(lang, "wallet.total_balance_sub") }
				</div>
			</div>

			<!-- Card 4: Total Operations Count -->
			<div class="stat-card-3d">
				<div class="stat-card-label">{ i18n.T(lang, "wallet.total_ops") }</div>
				<div class="stat-card-value tabular-nums">
					{ fmt.Sprintf("%d", totalOpsCount) } <span class="text-xs font-normal text-muted">{ i18n.T(lang, "wallet.ops_unit") }</span>
				</div>
				<div class="stat-card-sub">
					{ i18n.T(lang, "wallet.total_ops_sub") }
				</div>
			</div>
		</div>

		<!-- Section Tabs Navigation (2 Unified Tabs) -->
		<div class="tabs-nav mb-4">
			<button
				type="button"
				class="tab-btn"
				:class="{ 'active': activeSection === 'transactions' }"
				@click="activeSection = 'transactions'"
			>
				@components.IconCreditCard("icon-xs")
				<span>{ fmt.Sprintf(i18n.T(lang, "wallet.tab_transactions"), totalOpsCount) }</span>
			</button>

			<button
				type="button"
				class="tab-btn"
				:class="{ 'active': activeSection === 'payments' }"
				@click="activeSection = 'payments'"
			>
				@components.IconShield("icon-xs")
				<span>{ fmt.Sprintf(i18n.T(lang, "wallet.tab_payment_methods"), len(data.PaymentMethods)) }</span>
			</button>
		</div>

		<!-- Section 1: Unified Transactions Table -->
		<div x-show="activeSection === 'transactions'">
			<div class="glass-panel p-4 mb-4">
				<form method="GET" action={ templ.SafeURL(walletBaseURL(data.IsVendor)) } class="d-flex items-center gap-3 flex-wrap m-0">
					<div class="w-44">
						<select name="status" class="form-select w-full text-xs font-bold" onchange="this.form.submit()">
							<option value="">{ i18n.T(lang, "common.all_statuses") }</option>
							<option value="pending" selected?={ data.TxStatus == "pending" }>{ i18n.T(lang, "status.pending") }</option>
							<option value="completed" selected?={ data.TxStatus == "completed" }>{ i18n.T(lang, "status.completed") }</option>
							<option value="rejected" selected?={ data.TxStatus == "rejected" }>{ i18n.T(lang, "status.rejected") }</option>
						</select>
					</div>
					<div class="w-44">
						<select name="type" class="form-select w-full text-xs font-bold" onchange="this.form.submit()">
							<option value="">{ i18n.T(lang, "common.all_types") }</option>
							<option value="deposit" selected?={ data.TxType == "deposit" }>{ i18n.T(lang, "wallet.filter_deposit") }</option>
							<option value="withdrawal" selected?={ data.TxType == "withdrawal" }>{ i18n.T(lang, "wallet.filter_withdrawal") }</option>
							<option value="purchase" selected?={ data.TxType == "purchase" }>{ i18n.T(lang, "wallet.filter_purchase") }</option>
						</select>
					</div>
					if data.TxStatus != "" || data.TxType != "" {
						<a href={ templ.SafeURL(walletBaseURL(data.IsVendor)) } class="btn btn-ghost btn-sm font-bold text-muted">
							{ i18n.T(lang, "common.reset") }
						</a>
					}
				</form>
			</div>
			if data.IsVendor {
				@WalletTransactionsTable(data.Transactions, data.DepositRequests, data.WithdrawalRequests, data.Page, data.PerPage, data.TotalCount, "/vendor/wallet", walletTxQueryValues(data), lang)
			} else {
				@WalletTransactionsTable(data.Transactions, data.DepositRequests, data.WithdrawalRequests, data.Page, data.PerPage, data.TotalCount, "/customer/wallet", walletTxQueryValues(data), lang)
			}
		</div>

		<!-- Section 2: Saved Payment Methods -->
		<div class="d-flex flex-col gap-4" x-show="activeSection === 'payments'">
			<div class="d-flex items-center justify-between flex-wrap gap-3">
				<div>
					<h2 class="font-bold text-base m-0">
						{ i18n.T(lang, "wallet.payment_methods") }
					</h2>
					<p class="text-xs text-secondary m-0 mt-1">
						{ i18n.T(lang, "wallet.payment_methods_desc") }
					</p>
				</div>

				<button
					type="button"
					class="btn btn-primary btn-sm font-bold"
					@click="openPaymentAdd()"
				>
					@components.IconPlus("icon-xs")
					<span>{ i18n.T(lang, "wallet.add_method_new") }</span>
				</button>
			</div>

			<!-- Saved Methods Grid -->
			if len(data.PaymentMethods) == 0 {
				<div class="glass-panel p-6 text-center">
					<div class="mb-2 text-2xl text-muted">@components.IconCreditCard("icon-sm")</div>
					<h3 class="font-bold text-sm m-0">{ i18n.T(lang, "wallet.no_payment_methods") }</h3>
					<p class="text-xs text-secondary m-0 mt-1 max-w-sm mx-auto">
						{ i18n.T(lang, "wallet.payment_methods_desc") }
					</p>
					<button
						type="button"
						class="btn btn-outline-brand btn-sm font-bold mt-3 mx-auto"
						@click="openPaymentAdd()"
					>
						@components.IconPlus("icon-xs")
						<span>{ i18n.T(lang, "wallet.add_method_new") }</span>
					</button>
				</div>
			} else {
				<div class="wallet-methods-grid">
					for _, pm := range data.PaymentMethods {
						<div class="wallet-method-card">
							<div class="wallet-method-identity">
								<div class="wallet-method-icon">
									if pm.Provider == "bank" {
										@components.IconBank("icon-sm")
									} else if pm.Provider == "instapay" {
										@components.IconZap("icon-sm")
									} else if pm.Provider == "wallet" || pm.Provider == "vodafone_cash" {
										@components.IconPhone("icon-sm")
									} else {
										@components.IconCreditCard("icon-sm")
									}
								</div>
								<div>
									<div class="d-flex items-center gap-2">
										<span class="font-bold text-xs">
											{ paymentProviderTitle(pm.Provider) }
										</span>
										if pm.IsDefault {
											<span class="badge badge-emerald text-2xs font-bold">{ i18n.T(lang, "common.default") }</span>
										}
									</div>
									<div class="text-xs text-muted tabular-nums">
										{ pm.AccountIdentifier }
									</div>
								</div>
							</div>

							<div class="d-flex items-center gap-1">
								if !pm.IsDefault {
									<form action={ templ.SafeURL(fmt.Sprintf("%s/payment-methods/%d/default", walletBaseURL(data.IsVendor), pm.ID)) } method="POST" class="m-0">
										<button type="submit" class="btn btn-icon btn-ghost btn-xs" title={ i18n.T(lang, "wallet.set_default_tooltip") }>
											@components.IconCheckCircle("icon-xs")
										</button>
									</form>
								}
								<button
									type="button"
									class="btn btn-icon btn-ghost btn-xs"
									title={ i18n.T(lang, "wallet.edit_method_title") }
									data-payment-method={ paymentMethodJSON(pm) }
									@click="openPaymentEdit($el)"
								>
									@components.IconEdit("icon-xs")
								</button>
								<form action={ templ.SafeURL(fmt.Sprintf("%s/payment-methods/%d/delete", walletBaseURL(data.IsVendor), pm.ID)) } method="POST" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف وسيلة الدفع؟');">
									<button type="submit" class="btn btn-icon btn-ghost btn-xs text-danger" title={ i18n.T(lang, "common.delete") }>
										@components.IconTrash("icon-xs")
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}

			<!-- Official Platform Bank Details for Recharge -->
			<div class="glass-panel p-4">
				<div class="d-flex items-center gap-2 mb-3 text-primary font-bold text-xs">
					@components.IconInfo("icon-xs")
					<span>{ i18n.T(lang, "wallet.official_accounts_title") }</span>
				</div>
				<div class="wallet-official-grid">
					<div class="wallet-official-card">
						<div class="wallet-official-title">البنك التجاري الدولي (CIB)</div>
						<div class="text-2xs text-secondary">شركة دوا 24 للتجارة الإلكترونية</div>
						<div class="wallet-official-code tabular-nums">EG1200100001234567890123</div>
					</div>
					<div class="wallet-official-card">
						<div class="wallet-official-title">إنستاباي (InstaPay)</div>
						<div class="text-2xs text-secondary">dawa24@instapay</div>
						<div class="wallet-official-code">dawa24@instapay</div>
					</div>
					<div class="wallet-official-card">
						<div class="wallet-official-title">فودافون كاش (Vodafone Cash)</div>
						<div class="text-2xs text-secondary">01000000024</div>
						<div class="wallet-official-code tabular-nums">01000000024</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Modals Component -->
		@WalletModals(data, lang)
	</div>
}