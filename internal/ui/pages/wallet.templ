package pages

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type WalletViewData struct {
	IsVendor               bool
	Wallet                 *billing.Wallet
	Transactions           []*billing.WalletTransaction
	DepositRequests        []*billing.WalletDeposit
	PaymentMethods         []*billing.UserPaymentMethod
	PlatformPaymentMethods []*billing.PlatformPaymentMethod
	NoticeType             string
	NoticeMessage          string
	// TxStatus filters billing.wallet_deposits.status: pending|completed|rejected.
	TxStatus string
	// TxType filters billing.wallet_transactions.type: deposit|withdrawal|purchase.
	TxType       string
	Page         int
	PerPage      int
	TotalCount   int
}

templ WalletPage(data WalletViewData, lang, dir string) {
	@layouts.ShellFor("المحفظة والرصيد", "wallet", lang, dir, authctx.FromContext(ctx)) {
		@walletContent(data, lang, dir)
	}
}

templ walletContent(data WalletViewData, lang, dir string) {
	{{
		pendingCount := computePendingDepositsCount(data.DepositRequests)
		completedCount := len(data.Transactions)
		totalOpsCount := completedCount + pendingCount
	}}
	<div
		class="page-container"
		x-data="{
			activeSection: 'transactions',
			isDepositModalOpen: false,
			isWithdrawModalOpen: false,
			isAddPaymentModalOpen: false,
			paymentType: 'bank'
		}"
	>
		<!-- Compact Page Header -->
		<div class="d-flex items-center justify-between flex-wrap gap-3 mb-4">
			<div>
				<h1 class="page-title font-bold text-xl m-0 d-flex items-center gap-2">
					@components.IconWallet("icon-sm")
					<span>المحفظة والرصيد المالي</span>
				</h1>
				<p class="text-xs text-secondary m-0 mt-1">
					إدارة الرصيد المتاح، شحن المحفظة، وسجل العمليات المالية وطرق الدفع
				</p>
			</div>

			<div class="d-flex items-center gap-2">
				<button
					type="button"
					class="btn btn-secondary btn-sm font-bold"
					@click="isWithdrawModalOpen = true"
				>
					@components.IconArrowLeft("icon-xs")
					<span>طلب سحب رصيد</span>
				</button>

				<button
					type="button"
					class="btn btn-primary btn-sm font-bold"
					@click="isDepositModalOpen = true"
				>
					@components.IconPlus("icon-xs")
					<span>شحن رصيد المحفظة</span>
				</button>
			</div>
		</div>

		<!-- Flash Notices -->
		if data.NoticeMessage != "" {
			if data.NoticeType == "error" {
				<div class="alert alert-danger mb-4">
					@components.IconAlert("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			} else {
				<div class="alert alert-success mb-4">
					@components.IconCheckCircle("icon-xs")
					<span>{ data.NoticeMessage }</span>
				</div>
			}
		}

		<!-- Financial Balance Bar (4 Stat Cards) -->
		<div class="dashboard-stat-grid cols-4 mb-4">
			<!-- Card 1: Available Balance -->
			<div class="stat-card-3d">
				<div class="stat-card-label">الرصيد الفعلي المتاح</div>
				<div class={ "stat-card-value tabular-nums", walletBalanceClass(data.Wallet) }>
					{ walletBalance(data.Wallet) }
				</div>
				<div class="stat-card-sub">
					جاهز للاستخدام في الاشتراكات في المنصة
				</div>
			</div>

			<!-- Card 2: Pending Transactions -->
			<div class="stat-card-3d">
				<div class="stat-card-label">عدد المعاملات قيد الانتظار</div>
				<div class="stat-card-value text-amber tabular-nums">
					{ fmt.Sprintf("%d", pendingCount) } <span class="text-xs font-normal text-muted">معاملة</span>
				</div>
				<div class="stat-card-sub">
					بانتظار المراجعة والاعتماد
				</div>
			</div>

			<!-- Card 3: Completed Transactions -->
			<div class="stat-card-3d">
				<div class="stat-card-label">عدد المعاملات المكتملة</div>
				<div class="stat-card-value text-emerald tabular-nums">
					{ fmt.Sprintf("%d", completedCount) } <span class="text-xs font-normal text-muted">معاملة</span>
				</div>
				<div class="stat-card-sub">
					مسجلة ومعتمدة في دفتر الأستاذ
				</div>
			</div>

			<!-- Card 4: Total Operations Count -->
			<div class="stat-card-3d">
				<div class="stat-card-label">إجمالي العمليات</div>
				<div class="stat-card-value tabular-nums">
					{ fmt.Sprintf("%d", totalOpsCount) } <span class="text-xs font-normal text-muted">عملية</span>
				</div>
				<div class="stat-card-sub">
					إجمالي الحركات والطلبات
				</div>
			</div>
		</div>

		<!-- Section Tabs Navigation (2 Unified Tabs) -->
		<div class="tabs-nav mb-4">
			<button
				type="button"
				class="tab-btn"
				:class="{ 'active': activeSection === 'transactions' }"
				@click="activeSection = 'transactions'"
			>
				@components.IconCreditCard("icon-xs")
				<span>سجل المعاملات المالية ({ fmt.Sprintf("%d", totalOpsCount) })</span>
			</button>

			<button
				type="button"
				class="tab-btn"
				:class="{ 'active': activeSection === 'payments' }"
				@click="activeSection = 'payments'"
			>
				@components.IconShield("icon-xs")
				<span>طرق الدفع والحسابات ({ fmt.Sprintf("%d", len(data.PaymentMethods)) })</span>
			</button>
		</div>

		<!-- Section 1: Unified Transactions Table -->
		<div x-show="activeSection === 'transactions'">
			<div class="glass-panel p-4 mb-4">
				<form method="GET" action={ templ.SafeURL(walletBaseURL(data.IsVendor)) } class="d-flex items-center gap-3 flex-wrap m-0">
					<div class="w-44">
						<select name="status" class="form-select w-full text-xs font-bold" onchange="this.form.submit()">
							<option value="">كافة الحالات</option>
							<option value="pending" selected?={ data.TxStatus == "pending" }>قيد المراجعة</option>
							<option value="completed" selected?={ data.TxStatus == "completed" }>مكتمل</option>
							<option value="rejected" selected?={ data.TxStatus == "rejected" }>مرفوض</option>
						</select>
					</div>
					<div class="w-44">
						<select name="type" class="form-select w-full text-xs font-bold" onchange="this.form.submit()">
							<option value="">كافة الأنواع</option>
							<option value="deposit" selected?={ data.TxType == "deposit" }>إيداع</option>
							<option value="withdrawal" selected?={ data.TxType == "withdrawal" }>عملية سحب</option>
							<option value="purchase" selected?={ data.TxType == "purchase" }>مشتريات</option>
						</select>
					</div>
					if data.TxStatus != "" || data.TxType != "" {
						<a href={ templ.SafeURL(walletBaseURL(data.IsVendor)) } class="btn btn-ghost btn-sm font-bold text-muted">
							إعادة تعيين
						</a>
					}
				</form>
			</div>
			if data.IsVendor {
				@WalletTransactionsTable(data.Transactions, data.DepositRequests, data.Page, data.PerPage, data.TotalCount, "/vendor/wallet", walletTxQueryValues(data))
			} else {
				@WalletTransactionsTable(data.Transactions, data.DepositRequests, data.Page, data.PerPage, data.TotalCount, "/customer/wallet", walletTxQueryValues(data))
			}
		</div>

		<!-- Section 2: Saved Payment Methods -->
		<div class="d-flex flex-col gap-4" x-show="activeSection === 'payments'">
			<div class="d-flex items-center justify-between flex-wrap gap-3">
				<div>
					<h2 class="font-bold text-base m-0">
						طرق الدفع والحسابات البنكية المعتمدة
					</h2>
					<p class="text-xs text-secondary m-0 mt-1">
						الحسابات والبطاقات المستخدمة في سداد الفواتير وشحن المحفظة وسحب المستحقات
					</p>
				</div>

				<button
					type="button"
					class="btn btn-primary btn-sm font-bold"
					@click="isAddPaymentModalOpen = true"
				>
					@components.IconPlus("icon-xs")
					<span>إضافة وسيلة دفع جديدة</span>
				</button>
			</div>

			<!-- Saved Methods Grid -->
			if len(data.PaymentMethods) == 0 {
				<div class="glass-panel p-6 text-center">
					<div class="mb-2 text-2xl text-muted">@components.IconCreditCard("icon-sm")</div>
					<h3 class="font-bold text-sm m-0">لم يتم حفظ أي وسيلة دفع</h3>
					<p class="text-xs text-secondary m-0 mt-1 max-w-sm mx-auto">
						أضف حسابك البنكي أو محفظتك لتسهيل تسوية العمليات المالية وسحب الرصيد
					</p>
					<button
						type="button"
						class="btn btn-outline-brand btn-sm font-bold mt-3 mx-auto"
						@click="isAddPaymentModalOpen = true"
					>
						@components.IconPlus("icon-xs")
						<span>إضافة وسيلة دفع الآن</span>
					</button>
				</div>
			} else {
				<div class="wallet-methods-grid">
					for _, pm := range data.PaymentMethods {
						<div class="wallet-method-card">
							<div class="wallet-method-identity">
								<div class="wallet-method-icon">
									if pm.Provider == "bank" {
										@components.IconBank("icon-sm")
									} else if pm.Provider == "instapay" {
										@components.IconZap("icon-sm")
									} else if pm.Provider == "wallet" || pm.Provider == "vodafone_cash" {
										@components.IconPhone("icon-sm")
									} else {
										@components.IconCreditCard("icon-sm")
									}
								</div>
								<div>
									<div class="d-flex items-center gap-2">
										<span class="font-bold text-xs">
											{ paymentProviderTitle(pm.Provider) }
										</span>
										if pm.IsDefault {
											<span class="badge badge-emerald text-2xs font-bold">افتراضي</span>
										}
									</div>
									<div class="text-xs text-muted tabular-nums">
										{ pm.AccountIdentifier }
									</div>
								</div>
							</div>

							<div>
								<form action={ templ.SafeURL(fmt.Sprintf("%s/payment-methods/%d/delete", ternary(data.IsVendor, "/vendor/wallet", "/customer/wallet"), pm.ID)) } method="POST" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف وسيلة الدفع؟');">
									<button type="submit" class="btn btn-icon btn-ghost btn-xs text-danger" title="حذف وسيلة الدفع">
										@components.IconTrash("icon-xs")
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}

			<!-- Official Platform Bank Details for Recharge -->
			<div class="glass-panel p-4">
				<div class="d-flex items-center gap-2 mb-3 text-primary font-bold text-xs">
					@components.IconInfo("icon-xs")
					<span>الحسابات الرسمية المعتمدة للتحويل والإيداع</span>
				</div>
				<div class="wallet-official-grid">
					<div class="wallet-official-card">
						<div class="wallet-official-title">البنك التجاري الدولي (CIB)</div>
						<div class="text-2xs text-secondary">اسم الحساب: شركة دواء 24 للتجارة الإلكترونية</div>
						<div class="wallet-official-code tabular-nums">EG1200100001234567890123</div>
					</div>
					<div class="wallet-official-card">
						<div class="wallet-official-title">إنستاباي (InstaPay)</div>
						<div class="text-2xs text-secondary">عنوان الدفع اللحظي:</div>
						<div class="wallet-official-code">dawa24@instapay</div>
					</div>
					<div class="wallet-official-card">
						<div class="wallet-official-title">فودافون كاش (Vodafone Cash)</div>
						<div class="text-2xs text-secondary">رقم المحفظة المعتمد:</div>
						<div class="wallet-official-code tabular-nums">01000000024</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Modals Component -->
		@WalletModals(data.IsVendor)
	</div>
}

func walletBaseURL(isVendor bool) string {
	if isVendor {
		return "/vendor/wallet"
	}
	return "/customer/wallet"
}

func walletTxQueryValues(data WalletViewData) url.Values {
	q := url.Values{}
	if data.TxStatus != "" {
		q.Set("status", data.TxStatus)
	}
	if data.TxType != "" {
		q.Set("type", data.TxType)
	}
	return q
}

func walletBalance(w *billing.Wallet) string {
	if w == nil {
		return "0.00 ج.م"
	}
	return w.Balance.String() + " ج.م"
}

func walletBalanceClass(w *billing.Wallet) string {
	if w == nil || w.Balance.Minor() == 0 {
		return "text-primary"
	}
	if w.Balance.Minor() < 0 {
		return "text-rose text-danger"
	}
	return "text-emerald text-success"
}

func computePendingDepositsCount(deps []*billing.WalletDeposit) int {
	count := 0
	for _, d := range deps {
		if d != nil && d.Status != "approved" {
			count++
		}
	}
	return count
}

func txTypeBadgeClass(t billing.TransactionType) string {
	switch t {
	case billing.TxDeposit:
		return "badge-emerald"
	case billing.TxWithdrawal:
		return "badge-amber"
	case billing.TxPurchase:
		return "badge-purple"
	case billing.TxRefund:
		return "badge-cyan"
	case billing.TxBonus:
		return "badge-indigo"
	case billing.TxTransferIn:
		return "badge-teal"
	case billing.TxTransferOut:
		return "badge-orange"
	case billing.TxPenalty:
		return "badge-pink"
	default:
		return "badge-gray"
	}
}

func txTypeLabel(t billing.TransactionType) string {
	switch t {
	case billing.TxDeposit:
		return "إيداع رصيد"
	case billing.TxWithdrawal:
		return "سحب رصيد"
	case billing.TxPurchase:
		return "سداد فاتورة/طلب"
	case billing.TxRefund:
		return "استرداد أموال"
	case billing.TxBonus:
		return "مكافأة / بونص"
	case billing.TxTransferIn:
		return "تحويل وارد"
	case billing.TxTransferOut:
		return "تحويل صادر"
	case billing.TxPenalty:
		return "غرامة/خصم"
	default:
		return "معاملة مالية"
	}
}

func paymentProviderTitle(provider string) string {
	switch strings.ToLower(provider) {
	case "instapay":
		return "إنستاباي (InstaPay)"
	case "vodafone_cash", "wallet":
		return "محفظة هاتف ذكي"
	case "card":
		return "بطاقة بنكية"
	case "bank", "bank_transfer":
		return "تحويل بنكي رسمي"
	default:
		return provider
	}
}