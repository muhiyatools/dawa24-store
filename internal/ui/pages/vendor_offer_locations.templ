package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/modules/promo"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorOfferLocationsData struct {
	Offer     *promo.SpecialOffer
	Locations []*promo.SpecialOfferLocation
	Cities    []*platformadmin.City
}

var daysOfWeek = []struct {
	ID   int
	Name string
}{
	{ID: 1, Name: "السبت (Saturday)"},
	{ID: 2, Name: "الأحد (Sunday)"},
	{ID: 3, Name: "الاثنين (Monday)"},
	{ID: 4, Name: "الثلاثاء (Tuesday)"},
	{ID: 5, Name: "الأربعاء (Wednesday)"},
	{ID: 6, Name: "الخميس (Thursday)"},
	{ID: 7, Name: "الجمعة (Friday)"},
}

templ VendorOfferLocationsPage(data VendorOfferLocationsData, lang, dir string) {
	@layouts.VendorShell("نطاقات التغطية الجغرافية للعرض | Offer Locations", "offers", lang, dir) {
  <div class="stack-sm">
			
			<!-- Header -->
   <div class="stack-sm">
				<div class="d-flex items-center gap-2">
					<div class="stack-xs text-sm">
						@components.IconGlobe("icon-sm")
					</div>
     <div class="stack-sm">
						<div class="stack-xs text-sm">
							تغطية العرض الجغرافية
						</div>
						<h1 class="text-2xl fw-800 text-primary m-0">
							نطاقات التغطية وأوقات التوصيل: { data.Offer.Title.Get(i18n.Lang(lang)) }
						</h1>
					</div>
				</div>

				<a href="/vendor/offers" class="btn btn-secondary btn-sm fw-700">
					<span>← العودة لجميع العروض</span>
				</a>
			</div>

			<!-- Split Layout: Form on Left, List on Right -->
			<div class="locations-grid">
				
				<!-- Add New Location Coverage Form -->
    <div class="stack-sm">
					<h3 class="font-bold text-sm m-0">
						+ إضافة نطاق تغطية جغرافي جديد
					</h3>

					<form class="stack-md" action={ templ.SafeURL(fmt.Sprintf("/vendor/offers/%d/locations/new", data.Offer.ID)) } method="POST">
						
						<!-- Leaflet Map Picker with Radius Circle -->
						<div class="stack-sm">
       <label class="form-label">
								حدد مركز ونصف قطر التغطية على الخريطة
							</label>

							<div class="stack-sm" data-map-picker data-default-lat="30.0444" data-default-lon="31.2357" data-default-radius="1000">
								<div class="map-container map-canvas"></div>

								
        <div class="stack-sm">
									<span data-map-coords-badge>30.0444, 31.2357</span>
									<button type="button" data-map-locate class="btn btn-secondary btn-xs">موقعي</button>
								</div>

								<input type="hidden" name="latitude" data-map-input="lat" value="30.0444"/>
								<input type="hidden" name="longitude" data-map-input="lon" value="31.2357"/>
							</div>
						</div>

      <div class="stack-sm">
       <div class="stack-sm">
								<label class="form-label">
									المدينة / المحافظة <span class="text-danger">*</span>
								</label>
								<select name="city_id" data-map-city class="form-input w-full">
									<option value="">-- اختر المدينة --</option>
									for _, c := range data.Cities {
										<option value={ fmt.Sprintf("%d", c.ID) }>
											{ c.Name.Get(i18n.Lang(lang)) }
										</option>
									}
								</select>

							</div>

       <div class="stack-sm">
								<label class="form-label">
									نصف قطر التغطية (بالمتر)
								</label>
								<input type="number" name="radius" data-map-radius value="1000" step="100" min="200" max="50000" class="form-input tabular-nums w-full"/>
							</div>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								العنوان والمنطقة المغطاة (بالعربية)
							</label>
							<input type="text" name="address_ar" placeholder="مثال: مدينة نصر ومصر الجديدة والتجمع الخامس" class="form-input w-full"/>
						</div>

      <div class="stack-sm">
       <div class="stack-sm">
								<label class="form-label">
									يوم التوصيل
								</label>
								<select name="day_of_week" class="form-input w-full">
									for _, d := range daysOfWeek {
										<option value={ fmt.Sprintf("%d", d.ID) }>{ d.Name }</option>
									}
								</select>
							</div>

       <div class="stack-sm">
								<label class="form-label">
									من الساعة
								</label>
								<input type="time" name="time_from" value="09:00" class="form-input"/>
							</div>

       <div class="stack-sm">
								<label class="form-label">
									إلى الساعة
								</label>
								<input type="time" name="time_to" value="18:00" class="form-input"/>
							</div>
						</div>

						<button type="submit" class="btn btn-primary">
							@components.IconPlus("icon-xs")
							<span>حفظ نطاق التغطية للعرض</span>
						</button>
					</form>
				</div>

				<!-- Existing Locations List -->
    <div class="stack-sm">
     <div class="stack-sm">
						<h3 class="text-lg fw-800 text-primary m-0">
							النطاقات المسجلة لهذا العرض
						</h3>
						<span class="badge badge-sky tabular-nums fw-700">
							{ fmt.Sprintf("%d نطاقات", len(data.Locations)) }
						</span>
					</div>

					if len(data.Locations) == 0 {
						<div class="stack-xs text-sm">
							لا توجد نطاقات جغرافية مضافة لهذا العرض بعد. استخدم النموذج لإضافة أول نطاق.
						</div>
					} else {
      <div class="stack-sm">
							for _, loc := range data.Locations {
        <div class="stack-sm">
         <div class="stack-sm">
										<div class="stack-xs text-sm">
											{ loc.CityName } - { loc.AddressAr }
										</div>
          <div class="stack-sm">
											<div class="stack-sm">نصف قطر التغطية: <strong class="tabular-nums text-accent">{ fmt.Sprintf("%d م", loc.Radius) }</strong></div>
											<div class="stack-xs text-sm">أوقات التوصيل: { formatDayName(loc.DayOfWeek) } ({ loc.TimeFrom } - { loc.TimeTo })</div>
										</div>
									</div>

									<span class="badge badge-emerald">نشط</span>
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
}

func formatDayName(day int) string {
	for _, d := range daysOfWeek {
		if d.ID == day {
			return d.Name
		}
	}
	return "يوم محدد"
}
