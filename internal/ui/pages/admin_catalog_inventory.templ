package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminProductDetailPage renders master product view.
templ AdminProductDetailPage(p *catalog.Product, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل المنتج: %s", p.Name.Get("ar")), "products", lang, dir) {
		<div class="card max-w-2xl mx-auto">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">{ p.Name.Get("ar") }</h2>
					<p class="subtitle">SKU: { p.SKU } | باركود: { p.Barcode }</p>
				</div>
				<a href="/admin/products" class="btn btn-secondary btn-sm">العودة للمنتجات</a>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem;">
				<div>
					<div class="text-sm text-secondary">الاسم العلمي</div>
					<div style="font-weight:700; margin-top:0.25rem;">{ p.ScientificName }</div>
				</div>
				<div>
					<div class="text-sm text-secondary">الشركة المصنعة / الماركة</div>
					<div style="font-weight:700; margin-top:0.25rem; color:var(--accent);">
						if p.ManufacturingCompanies != "" {
							{ p.ManufacturingCompanies }
						} else {
							<span class="text-muted">غير محدد</span>
						}
					</div>
				</div>
				<div>
					<div class="text-sm text-secondary">سعر الجمهور القياسي</div>
					<div class="tabular-nums" style="font-weight:700; margin-top:0.25rem;">{ fmt.Sprintf("%s ج.م", p.Price.String()) }</div>
				</div>
				<div>
					<div class="text-sm text-secondary">الحالة</div>
					<div style="margin-top:0.25rem;">
						if p.Status == catalog.StatusActive {
							<span class="badge badge-emerald">نشط ومتاح</span>
						} else {
							<span class="badge badge-rose">معطل</span>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// AdminProductChildrenPage renders vendor variant listings with real database structure.
templ AdminProductChildrenPage(data AdminProductChildrenData, lang, dir string) {
	@layouts.AdminShell("أصناف الموردين وعروض التوريد", "product_child", lang, dir) {
		<div class="stack-lg">
			
			<!-- Header Card -->
			<div class="card mb-0">
				<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
					<div class="row-center-sm">
						@components.IconLayers("icon-lg")
						<div>
							<h2 class="card-title" style="margin:0; font-size:1.35rem;">
								أصناف الموردين وعروض الفروع ({ fmt.Sprintf("%d", len(data.Items)) })
							</h2>
							<p style="font-size:0.875rem; color:var(--neutral-500); margin-top:0.25rem; margin-bottom:0;">
								متابعة أصناف الموردين والشركات، الأسعار والخصومات، والمخزون الحي بالمخازن.
							</p>
						</div>
					</div>

					<div style="display:flex; gap:0.5rem; align-items:center;">
						<a href="/admin/product-child" class={ "btn btn-sm", templ.KV("btn-primary", data.StatusFilter == "" || data.StatusFilter == "all"), templ.KV("btn-secondary", data.StatusFilter != "" && data.StatusFilter != "all") }>
							<span>الكل</span>
						</a>
						<a href="/admin/product-child?status=active" class={ "btn btn-sm", templ.KV("btn-primary", data.StatusFilter == "active"), templ.KV("btn-secondary", data.StatusFilter != "active") }>
							<span>النشطة</span>
						</a>
						<a href="/admin/product-child?status=inactive" class={ "btn btn-sm", templ.KV("btn-primary", data.StatusFilter == "inactive"), templ.KV("btn-secondary", data.StatusFilter != "inactive") }>
							<span>الموقوفة</span>
						</a>
					</div>
				</div>

				<!-- Search Toolbar -->
				<form method="GET" action="/admin/product-child" style="margin-top:1rem; display:flex; gap:0.75rem;">
					<input type="hidden" name="status" value={ data.StatusFilter } />
					<div class="search-input-group flex-1">
						<span class="search-icon">
							@components.IconSearch("icon-sm")
						</span>
						<input
							type="text"
							name="q"
							value={ data.SearchQuery }
							class="form-input search-input"
							placeholder="البحث باسم الصنف، SKU، الباركود، أو رقم التشغيلة..."
						/>
					</div>
					<button type="submit" class="btn btn-primary fw-700">بحث</button>
				</form>
			</div>

			<!-- Variants Table -->
			<div class="card" style="margin-bottom:0; overflow:visible;">
				if len(data.Items) == 0 {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "لا توجد أصناف موردين مسجلة",
						Message: "لم يقم الموردون بتسجيل أصناف أو عروض توريد مطابقة لبحثك بعد.",
					})
				} else {
					<div class="table-container overflow-visible">
						<table class="b2b-table">
							<thead>
								<tr>
									<th style="width:50px;">الصورة</th>
									<th>المنتج / SKU</th>
									<th>المنظمة (المورد)</th>
									<th>السعر قبل الخصم</th>
									<th>الخصم</th>
									<th>المخزون</th>
									<th>حالة المنتج</th>
									<th>حالة الصورة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Items {
									{{ v := item.Variant }}
									<tr id={ fmt.Sprintf("variant-row-%d", v.ID) }>
										<!-- 1. الصورة -->
										<td style="width:50px;">
											if item.DisplayImage != "" {
												<img src={ item.DisplayImage } alt={ v.Name.Get("ar") } style="width:44px; height:44px; object-fit:contain; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-raised); padding:2px;" />
											} else {
												<div style="width:44px; height:44px; border-radius:var(--radius-md); background:var(--surface-sunken); display:flex; align-items:center; justify-content:center; color:var(--text-muted); border:1px solid var(--border);">
													@components.IconPill("icon-xs")
												</div>
											}
										</td>

										<!-- 2. المنتج / SKU -->
										<td>
											<div class="fw-800 text-primary text-base">
												{ v.Name.Get("ar") }
											</div>
											if v.Name.Get("en") != "" {
												<div style="font-size:0.775rem; color:var(--neutral-500);" dir="ltr">
													{ v.Name.Get("en") }
												</div>
											}
											if item.ParentProdName != "" {
												<div style="font-size:0.75rem; color:var(--accent); margin-top:2px;">
													صنف رئيسي: { item.ParentProdName }
												</div>
											}
											<div style="font-size:0.75rem; color:var(--neutral-500); margin-top:2px; display:flex; gap:0.5rem; flex-wrap:wrap;">
												if v.SKU != "" {
													<span class="tabular-nums">SKU: <strong class="text-primary">{ v.SKU }</strong></span>
												}
												if v.Barcode != "" {
													<span class="tabular-nums">باركود: { v.Barcode }</span>
												}
												if v.BatchNumber != "" {
													<span>تشغيلة: { v.BatchNumber }</span>
												}
											</div>
										</td>

										<!-- 3. المنظمة -->
										<td>
											<strong style="color:var(--text); font-size:0.9rem;">
												if item.OrgName != "" {
													{ item.OrgName }
												} else {
													مورد #{ fmt.Sprintf("%d", v.OrganizationID) }
												}
											</strong>
											<div style="font-size:0.75rem; color:var(--neutral-500); margin-top:2px;">
												معرف المؤسسة: #{ fmt.Sprintf("%d", v.OrganizationID) }
											</div>
										</td>

										<!-- 4. السعر قبل الخصم -->
										<td>
											<div class="tabular-nums fw-800 text-primary text-base">
												@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: v.Price })
											</div>
										</td>

										<!-- 5. الخصم -->
										<td>
											<div class="tabular-nums fw-800 text-base">
												@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: v.Discount })
											</div>
										</td>

										<!-- 5. المخزون -->
										<td>
											if v.StockQty > 0 {
												<span class="badge badge-emerald tabular-nums" style="font-size:0.825rem; font-weight:800;">
													{ fmt.Sprintf("%d", v.StockQty) } وحدة
												</span>
											} else {
												<span class="badge badge-rose" style="font-size:0.825rem; font-weight:800;">
													نفذ المخزون (0)
												</span>
											}
											if v.MinOrderQty > 1 {
												<div style="font-size:0.75rem; color:var(--neutral-500); margin-top:2px;">
													أقل كمية: { fmt.Sprintf("%d", v.MinOrderQty) }
												</div>
											}
										</td>

										<!-- 6. حالة المنتج -->
										<td>
											if string(v.Status) == "active" {
												<span class="badge badge-emerald">نشط ومعروض</span>
											} else {
												<span class="badge badge-slate">موقوف / معطل</span>
											}
										</td>

										<!-- 7. حالة الصورة -->
										<td>
											if v.Image != "" {
												<span class="badge badge-emerald" style="font-size:11px; font-weight:700;">خاصة بالصنف ✓</span>
											} else if item.IsParentImage {
												<span class="badge badge-sky" style="font-size:11px; font-weight:700;" title="تم استخدام صورة الصنف الأساسي المعتمد">من الصنف الأساسي ⮞</span>
											} else {
												<span class="badge badge-amber" style="font-size:11px; font-weight:700;">غير متوفرة ⚠️</span>
											}
										</td>

										<!-- 8. الإجراءات -->
										<td class="text-end">
											<div class="table-actions" style="justify-content:flex-end; gap:0.4rem;">
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/product-child/%d/status", v.ID)) } class="m-0 inline">
													if string(v.Status) == "active" {
														<button type="submit" class="btn btn-secondary btn-sm text-warning" title="تعطيل العرض">
															تعطيل
														</button>
													} else {
														<button type="submit" class="btn btn-secondary btn-sm text-success" title="تفعيل العرض">
															تفعيل
														</button>
													}
												</form>

												if v.ProductID > 0 {
													<a
														href={ templ.SafeURL(fmt.Sprintf("/admin/products/%d", v.ProductID)) }
														class="btn btn-secondary btn-sm"
														title="معاينة الصنف الأساسي في الكتالوج"
													>
														@components.IconEye("icon-xs")
													</a>
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}

// AdminApisProductsPage renders external API connector.
templ AdminApisProductsPage(lang, dir string) {
	@layouts.AdminShell("ربط وتزامن واجهات API للمنتجات", "catalog", lang, dir) {
		<div class="card max-w-2xl mx-auto">
			<h2 class="card-title mb-sm">مزامنة المنتجات عبر واجهات API الخارجية</h2>
			<p style="font-size:0.875rem; color:var(--text-secondary); margin-bottom:1.5rem;">إعداد وتوصيل روابط Webhook وEndpoints لمزامنة الأسعار والمخزون الحي للموردين.</p>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد روابط API متصلة", Message: "قم بإضافة موفر API لمزامنة المخزون تلقائياً."})
		</div>
	}
}

// AdminStocksPage renders inventory stocks across warehouses.
templ AdminStocksPage(stocks []*inventory.Stock, lang, dir string) {
	@layouts.AdminShell("إدارة الأرصدة والمخزون الحي", "stocks", lang, dir) {
		<div class="card mb-0">
			<h2 class="card-title mb-lg">أرصدة المخزون بالمنشآت والمخازن ({ fmt.Sprintf("%d", len(stocks)) })</h2>
			if len(stocks) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "المخزون فارغ", Message: "لم يتم تسجيل أرصدة مخزون في المخازن بعد."})
			} else {
				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>#</th>
								<th>المنشأة</th>
								<th>المخزن</th>
								<th>الكمية الحالية</th>
								<th>حد الأمان</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range stocks {
								<tr>
									<td class="tabular-nums">#{ fmt.Sprintf("%d", s.ID) }</td>
									<td>منشأة #{ fmt.Sprintf("%d", s.OrganizationID) }</td>
									<td>مخزن #{ fmt.Sprintf("%d", s.WarehouseID) }</td>
									<td class="tabular-nums"><strong>{ fmt.Sprintf("%d", s.Quantity) }</strong></td>
									<td class="tabular-nums">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminWarehouseRowView wraps a warehouse with owner organization metadata.
type AdminWarehouseRowView struct {
	Warehouse *inventory.Warehouse
	OrgName   string
}

// AdminWarehousesPage renders permanent warehouses with live in-page inventory modals.
templ AdminWarehousesPage(warehouses []*AdminWarehouseRowView, lang, dir string) {
	@layouts.AdminShell("إدارة المخازن ومراكز التوزيع", "warehouses", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.5rem; max-width:1400px; margin:0 auto 3rem auto;"
			x-data="{
				modalOpen: false,
				loading: false,
				error: '',
				activeWh: {},
				stocks: [],
				searchQuery: '',
				get filteredStocks() {
					if (!this.searchQuery) return this.stocks;
					const q = this.searchQuery.toLowerCase();
					return this.stocks.filter(s =>
						(s.product_name && s.product_name.toLowerCase().includes(q)) ||
						(s.variant_name && s.variant_name.toLowerCase().includes(q)) ||
						(s.sku && s.sku.toLowerCase().includes(q)) ||
						(s.batch_number && s.batch_number.toLowerCase().includes(q))
					);
				},
				openStocks(wh) {
					this.activeWh = wh;
					this.stocks = [];
					this.error = '';
					this.searchQuery = '';
					this.loading = true;
					this.modalOpen = true;
					fetch('/admin/warehouses/' + wh.id + '/stocks-json')
						.then(res => {
							if (!res.ok) throw new Error('فشل جلب بيانات المخزون من الخادم');
							return res.json();
						})
						.then(data => {
							this.stocks = data || [];
							this.loading = false;
						})
						.catch(err => {
							this.error = err.message || 'تعذر تحميل بيانات المخزون';
							this.loading = false;
						});
				}
			}"
		>
			<!-- Header Banner -->
			<div class="card mb-0" style="border:1px solid var(--border); background:linear-gradient(135deg, var(--surface-raised) 0%, var(--surface-sunken) 100%); border-radius:var(--radius-xl); padding:1.75rem; box-shadow:0 4px 20px rgba(0,0,0,0.03);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.35rem;">
							<div style="width:44px; height:44px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
								🏬
							</div>
							<div>
								<h1 style="font-size:1.4rem; font-weight:900; color:var(--text); margin:0;">دليل المخازن ومراكز التوزيع</h1>
								<span style="font-size:0.75rem; font-weight:700; color:var(--accent); text-transform:uppercase;">Central Distribution & Storage Facilities</span>
							</div>
						</div>
						<p style="font-size:0.875rem; color:var(--text-secondary); margin:0.35rem 0 0 0; line-height:1.5;">استعراض المخازن التابعة لكافة الموردين مع إمكانية فحص وإدارة المخزون الداخلي بدقة عبر النافذة التفاعلية المباشرة.</p>
					</div>

					<div class="row-center">
						<div class="badge badge-sky" style="font-size:0.85rem; font-weight:800; padding:0.4rem 0.85rem;">
							{ fmt.Sprintf("إجمالي %d مخزن معتمد", len(warehouses)) }
						</div>
					</div>
				</div>
			</div>

			<!-- Warehouses Table Card -->
			<div class="card mb-0" style="border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,0.03);">
				if len(warehouses) == 0 {
					<div style="padding:3rem 1.5rem;">
						@components.EmptyState(components.EmptyStateProps{Title: "لا توجد مخازن", Message: "لم يتم تسجيل مخازن بالمنصة بعد."})
					</div>
				} else {
					<div class="table-container">
						<table class="b2b-table">
							<thead>
								<tr>
									<th>اسم المخزن</th>
									<th>المنشأة التابع لها</th>
									<th>العنوان وموقع التوزيع</th>
									<th>الهاتف</th>
									<th>الحالة</th>
									<th class="text-end">مخزون المخزن</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range warehouses {
									<tr>
										<td>
											<div class="row-center-sm">
												<span style="font-size:1.1rem;">🏬</span>
												<div>
													<strong style="color:var(--text); font-size:0.925rem;">{ row.Warehouse.Name }</strong>
													if row.Warehouse.Code != "" {
														<div style="font-size:0.75rem; color:var(--text-muted); font-family:var(--font-mono, monospace);">كود: { row.Warehouse.Code }</div>
													}
												</div>
											</div>
										</td>
										<td>
											if row.OrgName != "" {
												<span class="badge badge-slate" style="font-weight:700; font-size:0.8rem;">
													{ row.OrgName }
												</span>
											} else {
												<span class="text-muted text-sm">منشأة #{ fmt.Sprintf("%d", row.Warehouse.OrganizationID) }</span>
											}
										</td>
										<td>
											if row.Warehouse.Address != "" {
												<span style="font-size:0.85rem; color:var(--text);">{ row.Warehouse.Address }</span>
											} else {
												<span class="text-muted text-sm">غير محدد</span>
											}
										</td>
										<td class="tabular-nums">
											if row.Warehouse.Phone != "" {
												<span style="font-weight:600; font-size:0.85rem;">{ row.Warehouse.Phone }</span>
											} else {
												<span class="text-muted text-sm">-</span>
											}
										</td>
										<td>
											if row.Warehouse.IsActive {
												<span class="badge badge-success fw-800">✓ نشط</span>
											} else {
												<span class="badge badge-danger fw-800">✕ معطل</span>
											}
										</td>
										<td class="text-end">
											<button
												type="button"
												class="btn btn-secondary btn-sm"
												@click={ fmt.Sprintf("openStocks({ id: %d, name: '%s', org_name: '%s', address: '%s', phone: '%s' })", row.Warehouse.ID, row.Warehouse.Name, row.OrgName, row.Warehouse.Address, row.Warehouse.Phone) }
												style="font-weight:800; font-size:0.8rem; padding:0.4rem 0.85rem; border-radius:var(--radius-md); gap:0.4rem;"
											>
												
												<span>عرض المخزون للمخزن</span>
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Live Stock Inspection Modal -->
			<div x-show="modalOpen" x-cloak class="modal-overlay" @keydown.escape.window="modalOpen = false">
				<div @click.outside="modalOpen = false" class="modal-card modal-xl">
					
					<!-- Modal Header -->
					<div style="padding:1.25rem 1.75rem; border-bottom:1px solid var(--border); background:var(--surface-sunken); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
						<div class="row-center">
							<div style="width:40px; height:40px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.2rem;">
								
							</div>
							<div>
								<div class="row-center-sm">
									<h3 style="font-size:1.15rem; font-weight:900; margin:0; color:var(--text);" x-text="'مخزون مخزن: ' + activeWh.name"></h3>
									<span class="badge badge-sky text-xs fw-700" x-show="activeWh.org_name" x-text="activeWh.org_name"></span>
								</div>
								<div style="font-size:0.8rem; color:var(--text-secondary); margin-top:2px;" x-text="activeWh.address ? ('العنوان: ' + activeWh.address) : 'تفاصيل المخزون المسجل بالمنظومة'"></div>
							</div>
						</div>

						<div class="row-center">
							<button type="button" @click="modalOpen = false" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-full); width:32px; height:32px; padding:0; display:flex; align-items:center; justify-content:center;">✕</button>
						</div>
					</div>

					<!-- Modal Search & Stats Filter Bar -->
					<div style="padding:1rem 1.75rem; border-bottom:1px solid var(--border); background:var(--surface-raised); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
						<div style="position:relative; flex:1; min-width:260px;">
							<input
								type="text"
								x-model="searchQuery"
								placeholder="بحث باسم الدواء، الصنف، كود SKU، أو رقم التشغيلة…"
								class="form-input"
								style="width:100%; font-size:0.85rem; padding:0.45rem 1rem; border-radius:var(--radius-lg);"
							/>
						</div>

						<div style="display:flex; align-items:center; gap:0.5rem; font-size:0.8rem;">
							<span class="badge badge-slate" x-text="'الأصناف المعروضة: ' + filteredStocks.length" style="font-weight:700; padding:0.35rem 0.75rem;"></span>
						</div>
					</div>

					<!-- Modal Body Table Content -->
					<div style="flex:1; overflow-y:auto; padding:1.25rem 1.75rem;">
						
						<!-- Loading Spinner -->
						<div x-show="loading" style="padding:3rem 1rem; text-align:center;">
							<div style="display:inline-block; font-size:2rem; animation:spin 1s linear infinite;">⏳</div>
							<p style="font-size:0.875rem; color:var(--text-secondary); font-weight:700; margin-top:0.75rem;">جاري جلب أرصدة المخزون وتفاصيل الأصناف من قاعدة البيانات…</p>
						</div>

						<!-- Error Message -->
						<div x-show="!loading && error" style="padding:2rem 1rem; text-align:center; color:var(--danger-text);">
							<p x-text="error" style="font-weight:700; font-size:0.9rem;"></p>
						</div>

						<!-- Empty State inside modal -->
						<div x-show="!loading && !error && filteredStocks.length === 0" style="padding:3rem 1rem; text-align:center;">
							<div style="font-size:2.5rem; margin-bottom:0.5rem;"></div>
							<h4 class="text-base fw-800 text-primary m-0">لا توجد أصناف مخزنة مطابقة</h4>
							<p style="font-size:0.825rem; color:var(--text-secondary); margin-top:0.35rem;">لم يتم تسجيل أي رصيد مخزني لهذا المخزن يطابق معايير البحث.</p>
						</div>

						<!-- Live Table -->
						<div x-show="!loading && !error && filteredStocks.length > 0" class="table-container" style="border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden;">
							<table class="b2b-table m-0">
								<thead>
									<tr>
										<th>اسم الدواء والصنف</th>
										<th>كود SKU والباركود</th>
										<th>رقم التشغيلة والصلاحية</th>
										<th>سعر التوريد قبل الخصم</th>
										<th>الخصم</th>
										<th>قابل للتفاوض</th>
										<th>الرصيد المتاح</th>
										<th>حد الأمان</th>
										<th>الحالة</th>
									</tr>
								</thead>
								<tbody>
									<template x-for="st in filteredStocks" :key="st.stock_id">
										<tr>
											<td>
												<div>
													<strong style="color:var(--text); font-size:0.9rem;" x-text="st.product_name || 'صنف دوائي'"></strong>
													<div class="text-xs text-muted" x-show="st.variant_name" x-text="st.variant_name"></div>
												</div>
											</td>
											<td class="tabular-nums" style="font-family:var(--font-mono, monospace); font-size:0.8rem;">
												<span x-text="st.sku || st.barcode || '-'"></span>
											</td>
											<td class="tabular-nums">
												<div class="text-sm fw-700" x-text="st.batch_number ? ('تشغيلة: ' + st.batch_number) : '-'"></div>
												<div style="font-size:0.725rem; color:var(--text-muted);" x-show="st.expiry_date" x-text="'صلاحية: ' + (st.expiry_date ? st.expiry_date.substring(0,10) : '')"></div>
											</td>
											<td class="tabular-nums" style="font-weight:700; color:var(--primary-600);">
												<span x-text="st.price_str ? (st.price_str + ' ج.م') : '-'"></span>
											</td>
											<td class="tabular-nums" style="font-weight:700; color:var(--emerald);">
												<span x-text="(st.discount_str || '0.00') + ' ج.م'"></span>
											</td>
											<td>
												<span class="badge badge-amber" x-show="st.is_negotiable" style="font-size:0.725rem; font-weight:800;">نعم</span>
												<span class="badge badge-slate text-xs" x-show="!st.is_negotiable">لا (ثابت)</span>
											</td>
											<td class="tabular-nums">
												<strong class="text-base" :style="st.quantity > st.min_threshold ? 'color:var(--primary-600);' : 'color:var(--danger-text);'" x-text="st.quantity"></strong>
											</td>
											<td class="tabular-nums" style="color:var(--text-muted); font-size:0.85rem;" x-text="st.min_threshold"></td>
											<td>
												<span class="badge badge-emerald" x-show="st.quantity > st.min_threshold">متوفر</span>
												<span class="badge badge-amber" x-show="st.quantity > 0 && st.quantity <= st.min_threshold">منخفض</span>
												<span class="badge badge-rose" x-show="st.quantity <= 0">نفد المخزون</span>
											</td>
										</tr>
									</template>
								</tbody>
							</table>
						</div>

					</div>

					<!-- Modal Footer -->
					<div style="padding:1rem 1.75rem; border-top:1px solid var(--border); background:var(--surface-sunken); display:flex; justify-content:flex-end;">
						<button type="button" @click="modalOpen = false" class="btn btn-secondary" style="font-weight:700; font-size:0.85rem; padding:0.45rem 1.5rem;">إغلاق</button>
					</div>

				</div>
			</div>

		</div>
	}
}

// AdminWarehouseDetailPage renders warehouse detail fallback.
templ AdminWarehouseDetailPage(wh *inventory.Warehouse, stocks []*inventory.Stock, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("مخزن: %s", wh.Name), "warehouses", lang, dir) {
		<div class="card" style="max-width:800px; margin:0 auto 1.5rem auto;">
			<div class="flex-between">
				<div>
					<h2 class="card-title m-0">{ wh.Name }</h2>
					<p class="subtitle">منشأة #{ fmt.Sprintf("%d", wh.OrganizationID) } | { wh.Address }</p>
				</div>
				<a href="/admin/warehouses" class="btn btn-secondary btn-sm">العودة للمخازن</a>
			</div>
		</div>
	}
}

// AdminTempWarehousesPage renders temp warehouses list.
templ AdminTempWarehousesPage(items []any, lang, dir string) {
	@layouts.AdminShell("إدارة المستودعات المؤقتة وملفات التوريد", "temp_warehouses", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">المستودعات المؤقتة وملفات الأسعار المرفوعة</h2>
					<p class="subtitle">مستودعات مؤقتة يتم رفعها لمطابقة الأسعار والخصومات دون دمجها الدائم في الكتالوج.</p>
				</div>
				<a href="/admin/import" class="btn btn-primary btn-sm">رفع مستودع مؤقت جديد</a>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد مستودعات مؤقتة", Message: "يتم إنشاء المستودعات المؤقتة تلقائياً عند رفع ملفات جداول الأسعار."})
		</div>
	}
}

// SavingUserOrgOption provides select option details for organizations and users.
type SavingUserOrgOption struct {
	ID   int64
	Name string
	Type string
}

// AdminSavingProductsData carries all view models for the admin saving products page.
type AdminSavingProductsData struct {
	Items          []*catalog.SavingProductAdminView
	Stats          *catalog.SavingProductAdminStats
	Organizations  []*SavingUserOrgOption
	Users          []*SavingUserOrgOption
	SelectedOrgID  int64
	SelectedUserID int64
	SearchQuery    string
	ActiveFilter   string
}

// AdminSavingProductsPage renders the full platform-wide saving products manager for admins.
templ AdminSavingProductsPage(data AdminSavingProductsData, lang, dir string) {
	@layouts.AdminShell("إدارة منتجات التوفير للمستخدمين (Saving Products)", "saving_products", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:1.5rem; max-width:1400px; margin:0 auto 3rem auto;">
			
			<!-- Header Banner -->
			<div class="card mb-0" style="border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); padding:1.75rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.35rem;">
							<div class="b2b-icon-box">
								@components.IconTag("icon-md")
							</div>
							<h1 class="text-xl fw-800 text-primary m-0">منتجات التوفير لجميع مستخدمي المنصة</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							متابعة ورصد قوائم منتجات التوفير والأسعار المستهدفة المسجلة من قبل الصيدليات والعملاء بالمنظومة.
						</p>
					</div>
					<div class="row-center">
						<a href="/admin/saving-products" class="btn btn-secondary btn-sm row-center-sm">
							@components.IconRefresh("icon-xs")
							<span>تحديث البيانات</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Stats KPI Cards -->
			if data.Stats != nil {
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem;">
					<div class="card mb-0" style="padding:1.25rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface);">
						<div style="font-size:0.825rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">إجمالي منتجات التوفير</div>
						<div class="tabular-nums" style="font-size:1.75rem; font-weight:800; color:var(--text);">{ fmt.Sprintf("%d", data.Stats.TotalProducts) }</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">منتج مسجل عبر المنصة</div>
					</div>

					<div class="card mb-0" style="padding:1.25rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface);">
						<div style="font-size:0.825rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">المستخدمون والمنشآت</div>
						<div class="tabular-nums" style="font-size:1.75rem; font-weight:800; color:var(--accent);">{ fmt.Sprintf("%d", data.Stats.TotalUsers) } <span style="font-size:1rem; font-weight:600; color:var(--text-secondary);">مستخدم / { fmt.Sprintf("%d", data.Stats.TotalOrganizations) } منشأة</span></div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">أصحاب طلبات التوفير</div>
					</div>

					<div class="card mb-0" style="padding:1.25rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface);">
						<div style="font-size:0.825rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">إجمالي الكميات المطلوبة</div>
						<div class="tabular-nums" style="font-size:1.75rem; font-weight:800; color:var(--success);">{ fmt.Sprintf("%.0f", data.Stats.TotalQuantity) }</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">وحدة / عبوة دوائية</div>
					</div>

					<div class="card mb-0" style="padding:1.25rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface);">
						<div style="font-size:0.825rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.35rem;">حالة الربط بالكتالوج</div>
						<div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.25rem;">
							<span class="badge badge-emerald" style="font-size:0.825rem; padding:0.3rem 0.6rem;">{ fmt.Sprintf("%d", data.Stats.CountLinked) } مربوط</span>
							<span class="badge badge-amber" style="font-size:0.825rem; padding:0.3rem 0.6rem;">{ fmt.Sprintf("%d", data.Stats.CountUnlinked) } غير مربوط</span>
						</div>
						<div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.35rem;">ربط مع الأدوية المعتمدة</div>
					</div>
				</div>
			}

			<!-- Filter & Search Toolbar -->
			<div class="card mb-0" style="border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem; background:var(--surface);">
				<form method="GET" action="/admin/saving-products" class="stack-md">
					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; align-items:flex-end;">
						
						<!-- Org Selector -->
						<div class="form-group mb-0">
							<label class="form-label" style="font-size:0.825rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.35rem;">المنشأة / الصيدلية</label>
							<select name="org_id" class="form-input" style="font-size:0.875rem; height:42px;">
								<option value="">-- كل المنشآت ({ fmt.Sprintf("%d", len(data.Organizations)) }) --</option>
								for _, o := range data.Organizations {
									<option value={ fmt.Sprintf("%d", o.ID) } selected?={ data.SelectedOrgID == o.ID }>
										{ o.Name } ({ o.Type })
									</option>
								}
							</select>
						</div>

						<!-- User Selector -->
						<div class="form-group mb-0">
							<label class="form-label" style="font-size:0.825rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.35rem;">المستخدم / الصيدلي</label>
							<select name="user_id" class="form-input" style="font-size:0.875rem; height:42px;">
								<option value="">-- كل المستخدمين ({ fmt.Sprintf("%d", len(data.Users)) }) --</option>
								for _, u := range data.Users {
									<option value={ fmt.Sprintf("%d", u.ID) } selected?={ data.SelectedUserID == u.ID }>
										{ u.Name }
									</option>
								}
							</select>
						</div>

						<!-- Linking Filter -->
						<div class="form-group mb-0">
							<label class="form-label" style="font-size:0.825rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.35rem;">حالة الربط بالكتالوج</label>
							<select name="filter" class="form-input" style="font-size:0.875rem; height:42px;">
								<option value="all" selected?={ data.ActiveFilter == "all" || data.ActiveFilter == "" }>جميع الحالات</option>
								<option value="linked" selected?={ data.ActiveFilter == "linked" }>مربوط بكتالوج المنصة فقط</option>
								<option value="unlinked" selected?={ data.ActiveFilter == "unlinked" }>غير مربوط (يحتاج مطابقة)</option>
							</select>
						</div>

						<!-- Search Query -->
						<div class="form-group mb-0">
							<label class="form-label" style="font-size:0.825rem; font-weight:700; color:var(--text-secondary); margin-bottom:0.35rem;">بحث بالاسم أو الكود</label>
							<div style="position:relative;">
								<input 
									type="text" 
									name="q" 
									value={ data.SearchQuery } 
									placeholder="اسم الدواء، SKU، اسم المستخدم..." 
									class="form-input" 
									style="padding-inline-start:2.25rem; font-size:0.875rem; height:42px;"
								/>
								<div style="position:absolute; inset-inline-start:0.75rem; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none;">
									@components.IconSearch("icon-xs")
								</div>
							</div>
						</div>
					</div>

					<!-- Filter Actions -->
					<div style="display:flex; justify-content:flex-end; gap:0.75rem; align-items:center; border-top:1px solid var(--border-subtle); padding-top:0.75rem;">
						if data.SelectedOrgID > 0 || data.SelectedUserID > 0 || data.SearchQuery != "" || (data.ActiveFilter != "all" && data.ActiveFilter != "") {
							<a href="/admin/saving-products" class="btn btn-ghost btn-sm text-muted">
								إلغاء التصفية
							</a>
						}
						<button type="submit" class="btn btn-primary btn-sm" style="display:flex; align-items:center; gap:0.4rem; padding:0.5rem 1.25rem;">
							@components.IconSearch("icon-xs")
							<span>تطبيق الفلترة والبحث</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Saving Products Table -->
			<div class="card mb-0" style="border:1px solid var(--border); border-radius:var(--radius-xl); padding:0; overflow:hidden; background:var(--surface);">
				<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border-subtle); display:flex; justify-content:space-between; align-items:center;">
					<div style="font-weight:700; font-size:1rem; color:var(--text);">
						سجلات منتجات التوفير ({ fmt.Sprintf("%d", len(data.Items)) })
					</div>
				</div>

				if len(data.Items) == 0 {
					<div style="padding:4rem 2rem; text-align:center;">
						<div style="width:54px; height:54px; border-radius:var(--radius-full); background:var(--surface-raised); color:var(--text-muted); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem auto;">
							@components.IconTag("icon-md")
						</div>
						<h3 style="font-size:1.1rem; font-weight:700; color:var(--text); margin:0 0 0.5rem 0;">لا توجد نتائج مطابقة</h3>
						<p style="font-size:0.875rem; color:var(--text-secondary); max-width:420px; margin:0 auto 1.5rem auto;">
							لم يتم العثور على منتجات توفير تطابق معايير الفلترة المحددة. جرب تغيير خيارات البحث أو إعادة ضبط التصفية.
						</p>
						<a href="/admin/saving-products" class="btn btn-secondary btn-sm">عرض كل منتجات التوفير</a>
					</div>
				} else {
					<div class="table-container">
						<table class="b2b-table m-0">
							<thead>
								<tr>
									<th style="width:60px;">#</th>
									<th>اسم المنتج المطلوب</th>
									<th>المستخدم والمنشأة</th>
									<th>الربط بالكتالوج العام</th>
									<th>الكمية</th>
									<th>السعر المستهدف</th>
									<th>القيمة الإجمالية</th>
									<th>تاريخ التسجيل</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Items {
									<tr>
										<td class="tabular-nums text-muted text-sm">
											#{ fmt.Sprintf("%d", item.ID) }
										</td>
										<td>
											<div class="fw-700 text-primary">{ item.NameProduct }</div>
											if item.SKU != "" {
												<div style="font-size:0.75rem; color:var(--text-muted); font-family:monospace; margin-top:2px;">
													SKU: { item.SKU }
												</div>
											}
										</td>
										<td>
											<div style="display:flex; flex-direction:column; gap:2px;">
												<div style="font-weight:600; color:var(--text); font-size:0.875rem;">
													{ item.UserName }
												</div>
												<div style="display:flex; align-items:center; gap:0.4rem; font-size:0.75rem; color:var(--text-secondary);">
													<span class="badge badge-secondary" style="font-size:0.7rem; padding:1px 6px;">
														{ item.OrganizationName }
													</span>
													if item.UserPhone != "" {
														<span dir="ltr" class="tabular-nums">{ item.UserPhone }</span>
													}
												</div>
											</div>
										</td>
										<td>
											if item.ProductID != nil && *item.ProductID > 0 {
												<div>
													<span class="badge badge-emerald" style="font-size:0.75rem; padding:2px 8px; display:inline-flex; align-items:center; gap:4px; margin-bottom:3px;">
														@components.IconCheck("icon-xs")
														<span>مربوط: #{ fmt.Sprintf("%d", *item.ProductID) }</span>
													</span>
													<div style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">
														{ item.MasterProductName }
													</div>
												</div>
											} else {
												<span class="badge badge-amber" style="font-size:0.75rem; padding:2px 8px;">
													غير مربوط بكتالوج
												</span>
											}
										</td>
										<td class="tabular-nums fw-700 text-primary">
											{ fmt.Sprintf("%.0f", item.Quantity) }
										</td>
										<td class="tabular-nums" style="font-weight:700; color:var(--accent);">
											{ fmt.Sprintf("%s ج.م", item.Price.String()) }
										</td>
										<td class="tabular-nums" style="font-weight:700; color:var(--success);">
											{ fmt.Sprintf("%s ج.م", item.TotalValue.String()) }
										</td>
										<td style="font-size:0.8rem; color:var(--text-muted); white-space:nowrap;">
											{ item.CreatedAt.Format("2006-01-02 15:04") }
										</td>
										<td class="text-end">
											if item.ProductID != nil && *item.ProductID > 0 {
												<a href={ templ.SafeURL(fmt.Sprintf("/admin/products/%d", *item.ProductID)) } class="btn btn-secondary btn-sm" title="عرض تفاصيل الصنف بالكتالوج">
													عرض الصنف
												</a>
											} else {
												<a href={ templ.SafeURL(fmt.Sprintf("/admin/products?q=%s", item.NameProduct)) } class="btn btn-ghost btn-sm" title="بحث في الكتالوج للمطابقة">
													مطابقة
												</a>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}

