package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminProductDetailPage renders master product view.
templ AdminProductDetailPage(p *catalog.Product, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل المنتج: %s", p.Name.Get("ar")), "catalog", lang, dir) {
		<div class="card" style="max-width:800px; margin:0 auto;">
			<div class="header-row">
				<div>
					<h2 class="card-title" style="margin:0;">{ p.Name.Get("ar") }</h2>
					<p class="subtitle">SKU: { p.SKU } | باركود: { p.Barcode }</p>
				</div>
				<a href="/admin/products" class="btn btn-secondary btn-sm">العودة للمنتجات</a>
			</div>

			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem;">
				<div>
					<div style="font-size:0.8rem; color:var(--text-secondary);">الاسم العلمي</div>
					<div style="font-weight:700; margin-top:0.25rem;">{ p.ScientificName }</div>
				</div>
				<div>
					<div style="font-size:0.8rem; color:var(--text-secondary);">سعر الجمهور القياسي</div>
					<div class="tabular-nums" style="font-weight:700; margin-top:0.25rem;">{ fmt.Sprintf("%s ج.م", p.Price.String()) }</div>
				</div>
				<div>
					<div style="font-size:0.8rem; color:var(--text-secondary);">الحالة</div>
					<div style="margin-top:0.25rem;">
						if p.Status == catalog.StatusActive {
							<span class="badge badge-success">نشط ومتاح</span>
						} else {
							<span class="badge badge-danger">معطل</span>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// AdminProductChildrenPage renders vendor variant listings.
templ AdminProductChildrenPage(products []*catalog.Product, lang, dir string) {
	@layouts.AdminShell("إدارة عروض وفروع المنتجات (Product Children)", "catalog", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title" style="margin:0;">عروض المنتجات بالمنشآت والمستودعات ({ fmt.Sprintf("%d", len(products)) })</h2>
					<p class="subtitle">متابعة عروض التوريد، الخصومات، والكميات المسجلة لدى الموردين.</p>
				</div>
			</div>

			if len(products) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد عروض", Message: "لم يتم تسجيل عروض لمنتجات الموردين بعد."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>المنتج</th>
								<th>الاسم العلمي</th>
								<th>سعر الجمهور</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range products {
								<tr>
									<td><strong>{ p.Name.Get("ar") }</strong></td>
									<td>{ p.ScientificName }</td>
									<td class="tabular-nums">{ fmt.Sprintf("%s ج.م", p.Price.String()) }</td>
									<td>
										if p.Status == catalog.StatusActive {
											<span class="badge badge-success">نشط</span>
										} else {
											<span class="badge badge-danger">معطل</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/products/%d", p.ID)) } class="btn btn-secondary btn-sm">عرض التفاصيل</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminAdvProductsPage renders advanced ingest (alias for AdminProductsImportPage).
templ AdminAdvProductsPage(lang, dir string) {
	@AdminProductsImportPage(lang, dir)
}

// AdminProductsImportPage renders the comprehensive bulk catalog import wizard.
templ AdminProductsImportPage(lang, dir string) {
	@layouts.AdminShell("معالج الاستيراد الشامل للأدوية والكتالوج العام", "import", lang, dir) {
		<div style="max-width:1100px; margin:0 auto 3rem auto; display:flex; flex-direction:column; gap:1.5rem;">
			
			<!-- Header Card -->
			<div class="card mb-0" style="border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); padding:1.75rem;">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem;">
					<div>
						<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.35rem;">
							<div style="width:40px; height:40px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconUpload("icon-sm")
							</div>
							<h1 style="font-size:1.6rem; font-weight:900; color:var(--text); margin:0;">
								معالج الاستيراد الشامل للكتالوج العام
							</h1>
						</div>
						<p style="font-size:0.9rem; color:var(--text-secondary); margin:0;">
							استيراد وتحديث آلاف الأصناف الدوائية والمستحضرات المعتمدة دفعة واحدة عبر ملفات Excel و CSV.
						</p>
					</div>

					<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
						<a href="/admin/products/sample.xlsx" class="btn btn-secondary" style="font-weight:700; font-size:0.875rem;">
							@components.IconDownload("icon-xs")
							<span>تحميل قالب Excel (.xlsx)</span>
						</a>
						<a href="/admin/products/sample.csv" class="btn btn-secondary" style="font-weight:700; font-size:0.875rem;">
							@components.IconDownload("icon-xs")
							<span>تحميل قالب CSV (.csv)</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Main Upload Wizard Card -->
			<div class="card mb-0" style="border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); padding:2rem;">
				<h2 style="font-size:1.2rem; font-weight:800; color:var(--text); margin:0 0 1.25rem 0;">
					رفع ملف الأصناف ومزامنة البيانات
				</h2>

				<form
					method="POST"
					action="/admin/products/import"
					enctype="multipart/form-data"
					style="display:flex; flex-direction:column; gap:1.5rem;"
					x-data="{ fileName: '', isDragging: false }"
				>
					<!-- Drag & Drop Zone -->
					<div
						@dragover.prevent="isDragging = true"
						@dragleave.prevent="isDragging = false"
						@drop.prevent="isDragging = false; if ($event.dataTransfer.files.length) { $refs.fileInput.files = $event.dataTransfer.files; fileName = $event.dataTransfer.files[0].name; }"
						:style="isDragging ? 'border-color:var(--accent); background:var(--accent-subtle);' : 'border-color:var(--border); background:var(--surface-sunken);'"
						style="border:2px dashed var(--border); border-radius:var(--radius-xl); padding:3rem 2rem; text-align:center; transition:all 0.2s ease; cursor:pointer;"
						@click="$refs.fileInput.click()"
					>
						<input
							type="file"
							name="import_file"
							x-ref="fileInput"
							accept=".xlsx, .xls, .csv"
							required
							style="display:none;"
							@change="if ($refs.fileInput.files.length) fileName = $refs.fileInput.files[0].name"
						/>

						<div style="width:56px; height:56px; margin:0 auto 1rem auto; border-radius:var(--radius-xl); background:var(--surface-raised); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--accent);">
							@components.IconUpload("icon-md")
						</div>

						<template x-if="!fileName">
							<div>
								<div style="font-weight:800; font-size:1.1rem; color:var(--text); margin-bottom:0.35rem;">
									اسحب وأفلت ملف البيانات هنا، أو انقر للاختيار من جهازك
								</div>
								<div style="font-size:0.85rem; color:var(--text-secondary);">
									يدعم ملفات Excel الحديثة (.xlsx) وملفات CSV المشفرة بـ UTF-8 (الحد الأقصى 32 ميجابايت)
								</div>
							</div>
						</template>

						<template x-if="fileName">
							<div style="display:flex; align-items:center; justify-content:center; gap:0.5rem; color:var(--success-text); font-weight:800; font-size:1.05rem;">
								@components.IconCheckCircle("icon-sm")
								<span x-text="'تم اختيار الملف: ' + fileName"></span>
							</div>
						</template>
					</div>

					<!-- Options & Submit Button -->
					<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; border-top:1px solid var(--border); padding-top:1.25rem;">
						<div style="display:flex; align-items:center; gap:0.5rem; color:var(--text-secondary); font-size:0.85rem;">
							@components.IconInfo("icon-xs")
							<span>سيتم فك تشفير البيانات والتحقق من صحة الأسعار وأرقام التسجيل قبل الحفظ.</span>
						</div>

						<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.75rem 2rem; font-size:1rem;">
							@components.IconCheckCircle("icon-xs")
							<span>بدء المعالجة والاستيراد</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Column Mapping & Schema Reference Table -->
			<div class="card mb-0" style="border:1px solid var(--border); background:var(--surface-raised); border-radius:var(--radius-xl); padding:1.75rem;">
				<h3 style="font-size:1.15rem; font-weight:800; color:var(--text); margin:0 0 0.5rem 0;">
					هيكل الأعمدة والبيانات المدعومة في ملف الاستيراد
				</h3>
				<p style="font-size:0.85rem; color:var(--text-secondary); margin:0 0 1.25rem 0;">
					تأكد من مطابقة السطر الأول (Header) في ملفك للأعمدة الموضحة أدناه أو استخدم القالب الجاهز مباشرة:
				</p>

				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>اسم العمود في الملف</th>
								<th>المعرّف الإنجليزي</th>
								<th>نوع البيانات</th>
								<th>حالة الحقل</th>
								<th>مثال توضيحي</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td><strong>اسم الصنف بالعربي</strong></td>
								<td dir="ltr" class="tabular-nums"><code>name_ar</code></td>
								<td>نص عربي</td>
								<td><span class="badge badge-emerald">إلزامي</span></td>
								<td>كونجستال أقراص</td>
							</tr>
							<tr>
								<td><strong>اسم الصنف بالإنجليزي</strong></td>
								<td dir="ltr" class="tabular-nums"><code>name_en</code></td>
								<td>نص إنجليزي</td>
								<td><span class="badge badge-emerald">إلزامي</span></td>
								<td>Congestal Tablets</td>
							</tr>
							<tr>
								<td><strong>سعر الجمهور القياسي</strong></td>
								<td dir="ltr" class="tabular-nums"><code>price</code></td>
								<td>رقم عشري (EGP)</td>
								<td><span class="badge badge-emerald">إلزامي</span></td>
								<td>25.00</td>
							</tr>
							<tr>
								<td><strong>المادة الفعالة</strong></td>
								<td dir="ltr" class="tabular-nums"><code>active_ingredient</code></td>
								<td>نص</td>
								<td><span class="badge badge-secondary">اختياري</span></td>
								<td>Paracetamol 500mg</td>
							</tr>
							<tr>
								<td><strong>الاسم العلمي</strong></td>
								<td dir="ltr" class="tabular-nums"><code>generic_name</code></td>
								<td>نص</td>
								<td><span class="badge badge-secondary">اختياري</span></td>
								<td>Paracetamol + Pseudoephedrine</td>
							</tr>
							<tr>
								<td><strong>الشكل الصيدلي</strong></td>
								<td dir="ltr" class="tabular-nums"><code>dosage_form</code></td>
								<td>نص (أقراص، كبسولات...)</td>
								<td><span class="badge badge-secondary">اختياري</span></td>
								<td>أقراص</td>
							</tr>
							<tr>
								<td><strong>الشركة المصنعة</strong></td>
								<td dir="ltr" class="tabular-nums"><code>manufacturer</code></td>
								<td>نص</td>
								<td><span class="badge badge-secondary">اختياري</span></td>
								<td>Eva Pharma</td>
							</tr>
							<tr>
								<td><strong>رقم التسجيل EDA</strong></td>
								<td dir="ltr" class="tabular-nums"><code>eda_reg_number</code></td>
								<td>نص / كود</td>
								<td><span class="badge badge-secondary">اختياري</span></td>
								<td>EDA-10293</td>
							</tr>
							<tr>
								<td><strong>الوصف بالعربي</strong></td>
								<td dir="ltr" class="tabular-nums"><code>description_ar</code></td>
								<td>نص طويل</td>
								<td><span class="badge badge-secondary">اختياري</span></td>
								<td>لعلاج أعراض نزلات البرد والإنفلونزا</td>
							</tr>
							<tr>
								<td><strong>الوصف بالإنجليزي</strong></td>
								<td dir="ltr" class="tabular-nums"><code>description_en</code></td>
								<td>نص طويل</td>
								<td><span class="badge badge-secondary">اختياري</span></td>
								<td>For cold and flu relief</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

// AdminApisProductsPage renders external API connector.
templ AdminApisProductsPage(lang, dir string) {
	@layouts.AdminShell("ربط وتزامن واجهات API للمنتجات", "catalog", lang, dir) {
		<div class="card" style="max-width:800px; margin:0 auto;">
			<h2 class="card-title" style="margin-bottom:0.5rem;">مزامنة المنتجات عبر واجهات API الخارجية</h2>
			<p style="font-size:0.875rem; color:var(--text-secondary); margin-bottom:1.5rem;">إعداد وتوصيل روابط Webhook وEndpoints لمزامنة الأسعار والمخزون الحي للموردين.</p>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد روابط API متصلة", Message: "قم بإضافة موفر API لمزامنة المخزون تلقائياً."})
		</div>
	}
}

// AdminStocksPage renders inventory stocks across warehouses.
templ AdminStocksPage(stocks []*inventory.Stock, lang, dir string) {
	@layouts.AdminShell("إدارة الأرصدة والمخزون الحي", "inventory", lang, dir) {
		<div class="card mb-0">
			<h2 class="card-title" style="margin-bottom:1.5rem;">أرصدة المخزون بالمنشآت والمستودعات ({ fmt.Sprintf("%d", len(stocks)) })</h2>
			if len(stocks) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "المخزون فارغ", Message: "لم يتم تسجيل أرصدة مخزون في المستودعات بعد."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>#</th>
								<th>المنشأة</th>
								<th>المستودع</th>
								<th>الكمية الحالية</th>
								<th>حد الأمان</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range stocks {
								<tr>
									<td class="tabular-nums">#{ fmt.Sprintf("%d", s.ID) }</td>
									<td>منشأة #{ fmt.Sprintf("%d", s.OrganizationID) }</td>
									<td>مستودع #{ fmt.Sprintf("%d", s.WarehouseID) }</td>
									<td class="tabular-nums"><strong>{ fmt.Sprintf("%d", s.Quantity) }</strong></td>
									<td class="tabular-nums">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminWarehousesPage renders permanent warehouses.
templ AdminWarehousesPage(warehouses []*inventory.Warehouse, lang, dir string) {
	@layouts.AdminShell("إدارة المستودعات ومراكز التوزيع", "inventory", lang, dir) {
		<div class="card mb-0">
			<h2 class="card-title" style="margin-bottom:1.5rem;">دليل المستودعات المسجلة ({ fmt.Sprintf("%d", len(warehouses)) })</h2>
			if len(warehouses) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد مستودعات", Message: "لم يتم تسجيل مستودعات بالمنصة بعد."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>اسم المستودع</th>
								<th>المنشأة التابع لها</th>
								<th>العنوان</th>
								<th>الهاتف</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, w := range warehouses {
								<tr>
									<td><strong>{ w.Name }</strong></td>
									<td>منشأة #{ fmt.Sprintf("%d", w.OrganizationID) }</td>
									<td>{ w.Address }</td>
									<td class="tabular-nums">{ w.Phone }</td>
									<td>
										if w.IsActive {
											<span class="badge badge-success">نشط</span>
										} else {
											<span class="badge badge-danger">معطل</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/warehouses/%d", w.ID)) } class="btn btn-secondary btn-sm">عرض المخزون</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminWarehouseDetailPage renders warehouse detail.
templ AdminWarehouseDetailPage(wh *inventory.Warehouse, stocks []*inventory.Stock, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("مستودع: %s", wh.Name), "inventory", lang, dir) {
		<div class="card" style="max-width:800px; margin:0 auto 1.5rem auto;">
			<div style="display:flex; justify-content:space-between; align-items:center;">
				<div>
					<h2 class="card-title" style="margin:0;">{ wh.Name }</h2>
					<p class="subtitle">منشأة #{ fmt.Sprintf("%d", wh.OrganizationID) } | { wh.Address }</p>
				</div>
				<a href="/admin/warehouses" class="btn btn-secondary btn-sm">العودة للمستودعات</a>
			</div>
		</div>

		<div class="card" style="max-width:800px; margin:0 auto;">
			<h3 style="font-size:1rem; font-weight:700; margin-bottom:1rem;">أرصدة هذا المستودع ({ fmt.Sprintf("%d", len(stocks)) })</h3>
			if len(stocks) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد أرصدة", Message: "المستودع لا يحتوي على منتجات مسجلة حالياً."})
			} else {
				<div class="table-container">
					<table class="data-table">
						<thead>
							<tr>
								<th>#</th>
								<th>الكمية</th>
								<th>حد الأمان</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range stocks {
								<tr>
									<td class="tabular-nums">#{ fmt.Sprintf("%d", s.ID) }</td>
									<td class="tabular-nums"><strong>{ fmt.Sprintf("%d", s.Quantity) }</strong></td>
									<td class="tabular-nums">{ fmt.Sprintf("%d", s.MinThreshold) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminTempWarehousesPage renders temp warehouses list.
templ AdminTempWarehousesPage(items []any, lang, dir string) {
	@layouts.AdminShell("إدارة المستودعات المؤقتة وملفات التوريد", "inventory", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title" style="margin:0;">المستودعات المؤقتة وملفات الأسعار المرفوعة</h2>
					<p class="subtitle">مستودعات مؤقتة يتم رفعها لمطابقة الأسعار والخصومات دون دمجها الدائم في الكتالوج.</p>
				</div>
				<a href="/admin/import" class="btn btn-primary btn-sm">رفع مستودع مؤقت جديد</a>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد مستودعات مؤقتة", Message: "يتم إنشاء المستودعات المؤقتة تلقائياً عند رفع ملفات جداول الأسعار."})
		</div>
	}
}

// AdminSavingProductsPage renders saving products.
templ AdminSavingProductsPage(items []any, lang, dir string) {
	@layouts.AdminShell("إدارة منتجات التوفير (Saving Products)", "catalog", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
				<div>
					<h2 class="card-title" style="margin:0;">منتجات التوفير المتاحة بالمنصة</h2>
					<p class="subtitle">قوائم المنتجات ذات الخصومات المرتفعة والتوفير المباشر للصيدليات.</p>
				</div>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد منتجات توفير", Message: "يتم احتساب منتجات التوفير تلقائياً عبر محرك الخصومات والمقارنة."})
		</div>
	}
}
