package pages

import "fmt"

templ ShipmentLinesPagination(totalCount int) {
	if totalCount > 0 {
		<div x-show="totalPages > 1 || total > 20" class="b2b-pagination p-3 px-4 bg-surface-sunken border-t flex-between items-center flex-wrap gap-3">
			<div class="b2b-pagination-info text-xs text-secondary d-flex items-center gap-3">
				<span>
					عرض <strong class="tabular-nums" x-text="pageSize === -1 ? ('1 - ' + total) : (startIdx + ' - ' + endIdx)"></strong> من إجمالي <strong class="tabular-nums" x-text="total"></strong> صنف
				</span>
				<label class="d-flex items-center gap-1.5 text-xs text-muted">
					<span>عرض:</span>
					<select
						class="form-select form-select-xs py-1 px-2 text-xs"
						@change="changePageSize($event.target.value)"
					>
						<option value="25" selected>25 صنف</option>
						<option value="50">50 صنف</option>
						<option value="100">100 صنف</option>
						<option value="-1">عرض الكل</option>
					</select>
				</label>
			</div>

			<div class="b2b-pagination-controls d-flex items-center gap-1" x-show="totalPages > 1">
				<button
					type="button"
					class="b2b-pagination-btn"
					:disabled="page <= 1"
					@click="setPage(1)"
					title="الصفحة الأولى"
				>«</button>
				<button
					type="button"
					class="b2b-pagination-btn"
					:disabled="page <= 1"
					@click="prevPage()"
					title="السابق"
				>‹</button>

				<span class="text-xs px-2 font-bold tabular-nums">
					صفحة <span x-text="page"></span> من <span x-text="totalPages"></span>
				</span>

				<button
					type="button"
					class="b2b-pagination-btn"
					:disabled="page >= totalPages"
					@click="nextPage()"
					title="التالي"
				>›</button>
				<button
					type="button"
					class="b2b-pagination-btn"
					:disabled="page >= totalPages"
					@click="setPage(totalPages)"
					title="الصفحة الأخيرة"
				>»</button>
			</div>
		</div>
	}
}

func shipmentPaginationAlpineData(count int) string {
	return fmt.Sprintf(`{
		page: 1,
		pageSize: 25,
		total: %d,
		get totalPages() { return Math.ceil(this.total / (this.pageSize > 0 ? this.pageSize : this.total)) || 1 },
		get startIdx() { return this.pageSize === -1 ? 1 : (this.page - 1) * this.pageSize + 1 },
		get endIdx() { return this.pageSize === -1 ? this.total : Math.min(this.page * this.pageSize, this.total) },
		nextPage() { if (this.page < this.totalPages) this.page++ },
		prevPage() { if (this.page > 1) this.page-- },
		setPage(p) { if (p >= 1 && p <= this.totalPages) this.page = p },
		changePageSize(s) { this.pageSize = parseInt(s, 10); this.page = 1 }
	}`, count)
}
