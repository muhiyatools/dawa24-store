package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HeadToHeadPageData struct {
	Result       *compare.HeadToHeadComparisonResult
	Files        []*compare.CompareFile
	SourceFileID int64
	TargetFileID int64
	Query        string
	MinPrice     string
	MaxPrice     string
	MinDiscount  string
	MaxDiscount  string
	ActiveTab    string // "all", "your_better", "equal", "competitor_better"
	IsCustomer   bool
}

func buildHeadToHeadURL(sourceID, targetID int64, q, minP, maxP, minD, maxD, tab string) string {
	vals := url.Values{}
	if sourceID > 0 {
		vals.Set("source", fmt.Sprintf("%d", sourceID))
	}
	if targetID > 0 {
		vals.Set("target", fmt.Sprintf("%d", targetID))
	}
	if q != "" {
		vals.Set("q", q)
	}
	if minP != "" {
		vals.Set("min_price", minP)
	}
	if maxP != "" {
		vals.Set("max_price", maxP)
	}
	if minD != "" {
		vals.Set("min_discount", minD)
	}
	if maxD != "" {
		vals.Set("max_discount", maxD)
	}
	if tab != "" && tab != "all" {
		vals.Set("tab", tab)
	}
	base := "/compare/head-to-head"
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

templ CompareHeadToHeadContent(data HeadToHeadPageData) {
	<div class="max-w-4xl mx-auto stack-lg">
		
		<!-- Header Banner -->
		<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.5rem 1.75rem;">
			<div class="flex-between flex-wrap gap-md">
				<div>
					<div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.25rem;">
						<div style="width:42px; height:42px; border-radius:var(--radius-lg); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
							🏢
						</div>
						<h1 style="font-size:1.45rem; font-weight:900; color:var(--text); margin:0;">
							مقارنة مورد بمورد (رأس برأس)
						</h1>
					</div>
					<p style="color:var(--text-muted); font-size:0.875rem; margin:0;">
						تحليل مقارن مباشر ودقيق لأسعار وخصومات الأصناف بين موردين اثنين مع تحديد نقاط التفوق والضعف والتوفير الصافي.
					</p>
				</div>

				<div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
					<a href="/compare/tool" class="btn btn-secondary fw-700">
						@components.IconArrowLeft("icon-xs")
						<span>مركز الملفات</span>
					</a>
					if data.Result != nil && len(data.Result.Rows) > 0 {
						<button
							type="button"
							class="btn btn-primary fw-800"
							onclick="exportHeadToHeadToCSV()"
						>
							@components.IconDownload("icon-xs")
							<span>تصدير التقرير</span>
						</button>
					}
				</div>
			</div>

			<!-- Navigation Subtabs for all 4 Analysis Modes -->
			<div style="display:flex; gap:0.5rem; margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--border); flex-wrap:wrap;">
				<a href="/compare/results" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					📊 المقارنة المجمعة بين الموردين
				</a>
				<a href="/compare/head-to-head" class="btn btn-primary btn-sm" style="font-weight:800; border-radius:var(--radius-lg);">
					🏢 مقارنة مورد بمورد
				</a>
				<a href="/compare/market-benchmark" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					🧠 مقارنة مع موردين السوق
				</a>
				<a href="/compare/market-intelligence" class="btn btn-secondary btn-sm" style="font-weight:700; border-radius:var(--radius-lg);">
					🧠 تقرير ذكاء السوق
				</a>
			</div>
		</div>

		<!-- Supplier Selector Form -->
		<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.25rem 1.5rem;">
			<form method="GET" action="/compare/head-to-head" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)) auto; gap:1rem; align-items:end; margin:0;">
				<div>
					<label class="form-label" style="font-weight:700; font-size:0.85rem; color:var(--text); margin-bottom:0.35rem; display:block;">
						المورد الأساسي (كشفك / المصدر)
					</label>
					<select name="source" class="form-select" style="width:100%; height:40px; font-size:0.875rem;" required>
						<option value="">-- اختر المورد الأساسي --</option>
						for _, f := range data.Files {
							<option value={ fmt.Sprintf("%d", f.ID) } selected?={ f.ID == data.SourceFileID }>
								{ f.SupplierName } ({ fmt.Sprintf("%d صنف", f.RowCount) })
							</option>
						}
					</select>
				</div>

				<div>
					<label class="form-label" style="font-weight:700; font-size:0.85rem; color:var(--text); margin-bottom:0.35rem; display:block;">
						المورد المقارن به (المنافس / الهدف)
					</label>
					<select name="target" class="form-select" style="width:100%; height:40px; font-size:0.875rem;" required>
						<option value="">-- اختر المورد المقارن به --</option>
						for _, f := range data.Files {
							<option value={ fmt.Sprintf("%d", f.ID) } selected?={ f.ID == data.TargetFileID }>
								{ f.SupplierName } ({ fmt.Sprintf("%d صنف", f.RowCount) })
							</option>
						}
					</select>
				</div>

				<button type="submit" class="btn btn-primary fw-800" style="height:40px; padding:0 1.5rem;">
					⚡ بدء المقارنة
				</button>
			</form>
		</div>

		if data.Result != nil {
			<!-- KPI Summary Metric Cards -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.85rem;">
				
				<!-- Shared Products -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.25rem;">
						الأصناف المشتركة
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:var(--text);" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.TotalShared) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">صنف متطابق بين الكشفين</span>
				</div>

				<!-- Your Better (خصمك أفضل منهم) -->
				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(16,185,129,0.3); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:#10b981; margin-bottom:0.25rem;">
						🟢 خصمك أفضل منهم
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:#10b981;" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.YourBetterCount) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">
						if data.Result.TotalShared > 0 {
							{ fmt.Sprintf("%.1f%% من الأصناف", float64(data.Result.YourBetterCount)/float64(data.Result.TotalShared)*100.0) }
						}
					</span>
				</div>

				<!-- Equal Discount (نفس الخصم) -->
				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(59,130,246,0.3); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:#3b82f6; margin-bottom:0.25rem;">
						🔵 نفس الخصم
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:#3b82f6;" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.EqualCount) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">
						if data.Result.TotalShared > 0 {
							{ fmt.Sprintf("%.1f%% من الأصناف", float64(data.Result.EqualCount)/float64(data.Result.TotalShared)*100.0) }
						}
					</span>
				</div>

				<!-- Competitor Better (خصم أفضل منك) -->
				<div class="card" style="background:var(--surface-raised); border:1px solid rgba(239,68,68,0.3); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:#ef4444; margin-bottom:0.25rem;">
						🔴 خصم أفضل منك
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:#ef4444;" class="tabular-nums">
						{ fmt.Sprintf("%d", data.Result.CompetitorBetter) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">
						if data.Result.TotalShared > 0 {
							{ fmt.Sprintf("%.1f%% من الأصناف", float64(data.Result.CompetitorBetter)/float64(data.Result.TotalShared)*100.0) }
						}
					</span>
				</div>

				<!-- Competitive Win Rate -->
				<div class="card" style="background:var(--surface-raised); border:1px solid var(--accent-subtle); border-radius:var(--radius-xl); padding:1rem 1.25rem;">
					<div style="font-size:0.8rem; font-weight:700; color:var(--accent); margin-bottom:0.25rem;">
						معدل التفوق التنافسي
					</div>
					<div style="font-size:1.6rem; font-weight:900; color:var(--accent);" class="tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Result.WinRatePercent) }
					</div>
					<span style="font-size:0.75rem; color:var(--text-secondary);">نسبة تفوقك أو تطابقك</span>
				</div>

			</div>

			<!-- Filter Bar (Matching Image 1: Price and Discount Range Inputs) -->
			<div class="card" style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); padding:1.25rem 1.5rem; display:flex; flex-direction:column; gap:1rem;">
				
				<form method="GET" action="/compare/head-to-head" style="margin:0;">
					<input type="hidden" name="source" value={ fmt.Sprintf("%d", data.SourceFileID) } />
					<input type="hidden" name="target" value={ fmt.Sprintf("%d", data.TargetFileID) } />
					<input type="hidden" name="tab" value={ data.ActiveTab } />

					<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)) 1.5fr auto; gap:0.75rem; align-items:end;">
						
						<!-- الحد الأدنى للسعر -->
						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأدنى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="min_price"
								value={ data.MinPrice }
								placeholder="0.00"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<!-- الحد الأقصى للسعر -->
						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأقصى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="max_price"
								value={ data.MaxPrice }
								placeholder="1000.00"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<!-- الحد الأدنى للخصم -->
						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأدنى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="min_discount"
								value={ data.MinDiscount }
								placeholder="0%"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<!-- الحد الأقصى للخصم -->
						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								الحد الأقصى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="max_discount"
								value={ data.MaxDiscount }
								placeholder="50%"
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<!-- بحث بالاسم -->
						<div>
							<label style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:0.3rem; display:block;">
								بحث باسم الصنف أو الكود
							</label>
							<input
								type="text"
								name="q"
								value={ data.Query }
								placeholder="اسم الصنف..."
								class="form-control"
								style="height:38px; font-size:0.875rem;"
							/>
						</div>

						<button type="submit" class="btn btn-primary fw-800" style="height:38px; padding:0 1.25rem;">
							تطبيق الفلتر
						</button>

					</div>
				</form>

				<!-- Quick Filter Tabs -->
				<div style="display:flex; align-items:center; gap:0.5rem; border-top:1px solid var(--border); padding-top:0.85rem; flex-wrap:wrap;">
					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "all")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "all" || data.ActiveTab == ""), templ.KV("btn-secondary", data.ActiveTab != "all" && data.ActiveTab != "") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						الكل ({ fmt.Sprintf("%d", len(data.Result.Rows)) })
					</a>

					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "your_better")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "your_better"), templ.KV("btn-secondary", data.ActiveTab != "your_better") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						🟢 خصمك أفضل منهم ({ fmt.Sprintf("%d", data.Result.YourBetterCount) })
					</a>

					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "equal")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "equal"), templ.KV("btn-secondary", data.ActiveTab != "equal") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						🔵 نفس الخصم ({ fmt.Sprintf("%d", data.Result.EqualCount) })
					</a>

					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "competitor_better")) }
						class={ "btn btn-sm", templ.KV("btn-primary", data.ActiveTab == "competitor_better"), templ.KV("btn-secondary", data.ActiveTab != "competitor_better") }
						style="font-weight:700; border-radius:var(--radius-full);"
					>
						🔴 خصم أفضل منك ({ fmt.Sprintf("%d", data.Result.CompetitorBetter) })
					</a>
				</div>

			</div>

			<!-- Main Comparison Table Matching Image 1 Exactly -->
			<div class="card" style="padding:0; overflow:hidden; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-2xl); box-shadow:var(--shadow-sm);">
				<div class="table-responsive">
					<table class="table" id="head-to-head-table" style="margin:0; width:100%; border-collapse:collapse; font-size:0.875rem;">
						<thead>
							<tr style="background:var(--surface-sunken); border-bottom:2px solid var(--border); font-size:0.825rem; text-align:start;">
								<!-- 1. المنتج -->
								<th style="padding:0.9rem 1rem; min-width:260px;">المنتج</th>
								
								<!-- 2. سعر الجمهور -->
								<th style="padding:0.9rem 0.85rem; width:120px; text-align:center;">سعر الجمهور</th>
								
								<!-- 3. نسبة الخصم -->
								<th style="padding:0.9rem 0.85rem; width:100px; text-align:center;">
									نسبة الخصم ({ data.Result.SourceSupplierName })
								</th>
								
								<!-- 4. خصم أفضل منك -->
								<th style="padding:0.9rem 1rem; min-width:140px; text-align:center; color:#ef4444;">
									خصم أفضل منك
								</th>
								
								<!-- 5. نفس الخصم -->
								<th style="padding:0.9rem 0.85rem; width:110px; text-align:center; color:#3b82f6;">
									نفس الخصم
								</th>
								
								<!-- 6. خصمك أفضل منهم -->
								<th style="padding:0.9rem 1rem; min-width:140px; text-align:center; color:#10b981;">
									خصمك أفضل منهم
								</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Result.Rows) == 0 {
								<tr>
									<td colspan="6" style="text-align:center; padding:3rem 1rem; color:var(--text-muted);">
										<div style="font-size:2rem; margin-bottom:0.5rem;">🔍</div>
										<div style="font-weight:700; font-size:1rem; color:var(--text);">لا توجد نتائج تطابق خيارات الفلترة المحددة</div>
										<div style="font-size:0.85rem; margin-top:0.25rem;">جرب تعديل نطاق الأسعار أو نسب الخصم أو اختيار موردين آخرين.</div>
									</td>
								</tr>
							}
							for _, r := range data.Result.Rows {
								<tr style="border-bottom:1px solid var(--border);">
									
									<!-- 1. المنتج -->
									<td style="padding:0.85rem 1rem;">
										<div style="font-weight:700; color:var(--text); line-height:1.4;">
											{ r.ProductName }
										</div>
										if r.SKU != "" {
											<span style="font-size:0.725rem; color:var(--text-muted); font-family:monospace;">
												كود: { r.SKU }
											</span>
										}
									</td>

									<!-- 2. السعر -->
									<td style="padding:0.85rem 0.85rem; text-align:center; font-weight:700; color:var(--text);" class="tabular-nums">
										{ r.Price.String() } ج.م
									</td>

									<!-- 3. الخصم -->
									<td style="padding:0.85rem 0.85rem; text-align:center; font-weight:800; font-size:0.9rem;" class="tabular-nums">
										if r.YourDiscount > 0 {
											<span class="badge badge-slate" style="font-size:0.8rem; padding:0.25rem 0.5rem;">
												{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
											</span>
										} else {
											<span style="color:var(--text-muted);">0%</span>
										}
									</td>

									<!-- 4. خصم أفضل منك -->
									<td style="padding:0.85rem 1rem; text-align:center;" class="tabular-nums">
										if r.Outcome == compare.OutcomeCompetitorBetter {
											<div style="display:inline-flex; flex-direction:column; align-items:center; gap:0.15rem; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.25); border-radius:var(--radius-md); padding:0.25rem 0.6rem;">
												<span style="font-weight:900; color:#ef4444; font-size:0.85rem;">
													{ fmt.Sprintf("%.1f%%", r.CompetitorDiscount) }
												</span>
												<span style="font-size:0.7rem; color:#ef4444; font-weight:700;">
													(+{ fmt.Sprintf("%.1f%%", r.CompetitorDiff) } للمنافس)
												</span>
											</div>
										} else {
											<span style="color:var(--text-muted);">—</span>
										}
									</td>

									<!-- 5. نفس الخصم -->
									<td style="padding:0.85rem 0.85rem; text-align:center;" class="tabular-nums">
										if r.Outcome == compare.OutcomeEqual {
											<span style="display:inline-block; padding:0.2rem 0.5rem; border-radius:var(--radius-full); background:rgba(59,130,246,0.12); color:#3b82f6; font-weight:800; font-size:0.8rem;">
												{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
											</span>
										} else {
											<span style="color:var(--text-muted);">—</span>
										}
									</td>

									<!-- 6. خصمك أفضل منهم -->
									<td style="padding:0.85rem 1rem; text-align:center;" class="tabular-nums">
										if r.Outcome == compare.OutcomeYourBetter {
											<div style="display:inline-flex; flex-direction:column; align-items:center; gap:0.15rem; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.25); border-radius:var(--radius-md); padding:0.25rem 0.6rem;">
												<span style="font-weight:900; color:#10b981; font-size:0.85rem;">
													{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
												</span>
												<span style="font-size:0.7rem; color:#10b981; font-weight:700;">
													(+{ fmt.Sprintf("%.1f%%", r.BetterDiff) } أفضلية لك)
												</span>
											</div>
										} else {
											<span style="color:var(--text-muted);">—</span>
										}
									</td>

								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}

	</div>

	<!-- Export Table to CSV Script -->
	<script>
		function exportHeadToHeadToCSV() {
			var table = document.getElementById("head-to-head-table");
			if (!table) return;
			var rows = table.querySelectorAll("tr");
			var csv = [];
			for (var i = 0; i < rows.length; i++) {
				var row = [], cols = rows[i].querySelectorAll("td, th");
				for (var j = 0; j < cols.length; j++) {
					var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
					data = data.replace(/"/g, '""');
					row.push('"' + data + '"');
				}
				csv.push(row.join(","));
			}
			var csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
			var downloadLink = document.createElement("a");
			downloadLink.download = "head_to_head_comparison.csv";
			downloadLink.href = window.URL.createObjectURL(csvFile);
			downloadLink.style.display = "none";
			document.body.appendChild(downloadLink);
			downloadLink.click();
			document.body.removeChild(downloadLink);
		}
	</script>
}

templ CompareHeadToHeadPage(lang, dir string, data HeadToHeadPageData) {
	if data.IsCustomer {
		@layouts.CustomerShell("مقارنة مورد بمورد | Dawa24", "compare", lang, dir, nil) {
			@CompareHeadToHeadContent(data)
		}
	} else {
		@layouts.VendorShell("مقارنة مورد بمورد | Dawa24", "compare", lang, dir) {
			@CompareHeadToHeadContent(data)
		}
	}
}
