package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type HeadToHeadPageData struct {
	Result       *compare.HeadToHeadComparisonResult
	Files        []*compare.CompareFile
	SourceFileID int64
	TargetFileID int64
	Query        string
	MinPrice     string
	MaxPrice     string
	MinDiscount  string
	MaxDiscount  string
	ActiveTab    string // "all", "your_better", "equal", "competitor_better"
	IsCustomer   bool
}

func buildHeadToHeadURL(sourceID, targetID int64, q, minP, maxP, minD, maxD, tab string) string {
	vals := url.Values{}
	if sourceID > 0 {
		vals.Set("source", fmt.Sprintf("%d", sourceID))
	}
	if targetID > 0 {
		vals.Set("target", fmt.Sprintf("%d", targetID))
	}
	if q != "" {
		vals.Set("q", q)
	}
	if minP != "" {
		vals.Set("min_price", minP)
	}
	if maxP != "" {
		vals.Set("max_price", maxP)
	}
	if minD != "" {
		vals.Set("min_discount", minD)
	}
	if maxD != "" {
		vals.Set("max_discount", maxD)
	}
	if tab != "" && tab != "all" {
		vals.Set("tab", tab)
	}
	base := "/compare/head-to-head"
	if len(vals) > 0 {
		return base + "?" + vals.Encode()
	}
	return base
}

templ CompareHeadToHeadContent(data HeadToHeadPageData) {
	<div class="page-container">
		
		<!-- Header Banner -->
		<div class="glass-panel p-6 mb-6">
			<div class="flex-between flex-wrap gap-4">
    <div class="stack-sm">
					<div class="d-flex items-center gap-3 mb-1">
						<div class="user-avatar-badge text-xl">
							@components.IconBuilding("icon-sm")
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							مقارنة مورد بمورد (رأس برأس)
						</h1>
					</div>
					<p class="text-sm text-secondary m-0">
						تحليل مقارن مباشر ودقيق لأسعار وخصومات الأصناف بين موردين اثنين مع تحديد نقاط التفوق والضعف والتوفير الصافي.
					</p>
				</div>

				<div class="d-flex items-center gap-3 flex-wrap">
					<a href="/compare/tool" class="btn btn-secondary font-bold gap-2">
						@components.IconArrowLeft("icon-xs")
						<span>مركز الملفات</span>
					</a>
					if data.Result != nil && len(data.Result.Rows) > 0 {
						<button
							type="button"
							class="btn btn-primary font-bold gap-2"
							onclick="exportHeadToHeadToCSV()"
						>
							@components.IconDownload("icon-xs")
							<span>تصدير التقرير</span>
						</button>
					}
				</div>
			</div>

			<!-- Navigation Subtabs for all 4 Analysis Modes -->
			<div class="cb-tabs-nav mt-4 pt-3 border-t">
				<a href="/compare/results" class="cb-tab-btn">
					المقارنة المجمعة بين الموردين
				</a>
				<a href="/compare/head-to-head" class="cb-tab-btn active">
					مقارنة مورد بمورد
				</a>
				<a href="/compare/market-benchmark" class="cb-tab-btn">
					مقارنة مع موردين السوق
				</a>
				<a href="/compare/market-intelligence" class="cb-tab-btn">
					تقرير ذكاء السوق
				</a>
			</div>
		</div>

		<!-- Supplier Selector Form -->
		<div class="glass-panel p-6 mb-6">
			<form method="GET" action="/compare/head-to-head" class="d-grid gap-4 items-end m-0">
    <div class="stack-sm">
					<label class="form-label font-bold text-xs text-primary mb-1 d-block">
						المورد الأساسي (كشفك / المصدر)
					</label>
					<select name="source" class="form-select text-xs w-full" required>
						<option value="">-- اختر المورد الأساسي --</option>
						for _, f := range data.Files {
							<option value={ fmt.Sprintf("%d", f.ID) } selected?={ f.ID == data.SourceFileID }>
								{ f.SupplierName } ({ fmt.Sprintf("%d صنف", f.RowCount) })
							</option>
						}
					</select>
				</div>

    <div class="stack-sm">
					<label class="form-label font-bold text-xs text-primary mb-1 d-block">
						المورد المقارن به (المنافس / الهدف)
					</label>
					<select name="target" class="form-select text-xs w-full" required>
						<option value="">-- اختر المورد المقارن به --</option>
						for _, f := range data.Files {
							<option value={ fmt.Sprintf("%d", f.ID) } selected?={ f.ID == data.TargetFileID }>
								{ f.SupplierName } ({ fmt.Sprintf("%d صنف", f.RowCount) })
							</option>
						}
					</select>
				</div>

				<button type="submit" class="btn btn-primary font-bold px-6">
					بدء المقارنة
				</button>
			</form>
		</div>

		if data.Result != nil {
			<!-- KPI Summary Metric Cards -->
			<div class="dashboard-stat-grid mb-6">
				<!-- Shared Products -->
				<div class="stat-card-3d">
					<div class="stat-card-label">الأصناف المشتركة</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", data.Result.TotalShared) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">صنف متطابق بين الكشفين</span>
				</div>

				<!-- Your Better (خصمك أفضل منهم) -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-success">خصمك أفضل منهم</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%d", data.Result.YourBetterCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">
						if data.Result.TotalShared > 0 {
							{ fmt.Sprintf("%.1f%% من الأصناف", float64(data.Result.YourBetterCount)/float64(data.Result.TotalShared)*100.0) }
						}
					</span>
				</div>

				<!-- Equal Discount (نفس الخصم) -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">نفس الخصم</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%d", data.Result.EqualCount) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">
						if data.Result.TotalShared > 0 {
							{ fmt.Sprintf("%.1f%% من الأصناف", float64(data.Result.EqualCount)/float64(data.Result.TotalShared)*100.0) }
						}
					</span>
				</div>

				<!-- Competitor Better (خصم أفضل منك) -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-danger">خصم أفضل منك</div>
					<div class="stat-card-value text-danger tabular-nums">
						{ fmt.Sprintf("%d", data.Result.CompetitorBetter) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">
						if data.Result.TotalShared > 0 {
							{ fmt.Sprintf("%.1f%% من الأصناف", float64(data.Result.CompetitorBetter)/float64(data.Result.TotalShared)*100.0) }
						}
					</span>
				</div>

				<!-- Competitive Win Rate -->
				<div class="stat-card-3d">
					<div class="stat-card-label">معدل التفوق التنافسي</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%.1f%%", data.Result.WinRatePercent) }
					</div>
					<span class="text-xs text-secondary mt-1 d-block">نسبة تفوقك أو تطابقك</span>
				</div>
			</div>

			<!-- Filter Bar -->
			<div class="glass-panel p-6 mb-6 d-flex flex-col gap-4">
				<form method="GET" action="/compare/head-to-head" class="m-0">
					<input type="hidden" name="source" value={ fmt.Sprintf("%d", data.SourceFileID) } />
					<input type="hidden" name="target" value={ fmt.Sprintf("%d", data.TargetFileID) } />
					<input type="hidden" name="tab" value={ data.ActiveTab } />

					<div class="d-grid gap-3 items-end">
						<!-- الحد الأدنى للسعر -->
      <div class="stack-sm">
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأدنى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="min_price"
								value={ data.MinPrice }
								placeholder="0.00"
								class="form-input text-xs"
							/>
						</div>

						<!-- الحد الأقصى للسعر -->
      <div class="stack-sm">
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأقصى للسعر
							</label>
							<input
								type="number"
								step="0.01"
								name="max_price"
								value={ data.MaxPrice }
								placeholder="1000.00"
								class="form-input text-xs"
							/>
						</div>

						<!-- الحد الأدنى للخصم -->
      <div class="stack-sm">
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأدنى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="min_discount"
								value={ data.MinDiscount }
								placeholder="0%"
								class="form-input text-xs"
							/>
						</div>

						<!-- الحد الأقصى للخصم -->
      <div class="stack-sm">
							<label class="text-xs font-bold text-muted mb-1 d-block">
								الحد الأقصى للخصم
							</label>
							<input
								type="number"
								step="0.1"
								name="max_discount"
								value={ data.MaxDiscount }
								placeholder="50%"
								class="form-input text-xs"
							/>
						</div>

						<!-- بحث بالاسم -->
      <div class="stack-sm">
							<label class="text-xs font-bold text-muted mb-1 d-block">
								بحث باسم الصنف أو الكود
							</label>
							<input
								type="text"
								name="q"
								value={ data.Query }
								placeholder="اسم الصنف..."
								class="form-input text-xs"
							/>
						</div>

						<button type="submit" class="btn btn-primary font-bold px-4">
							تطبيق الفلتر
						</button>
					</div>
				</form>

				<!-- Quick Filter Tabs -->
				<div class="d-flex items-center gap-2 pt-3 border-t flex-wrap">
					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "all")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "all" || data.ActiveTab == ""), templ.KV("btn-secondary", data.ActiveTab != "all" && data.ActiveTab != "") }
					>
						الكل ({ fmt.Sprintf("%d", len(data.Result.Rows)) })
					</a>

					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "your_better")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "your_better"), templ.KV("btn-secondary", data.ActiveTab != "your_better") }
					>
						خصمك أفضل منهم ({ fmt.Sprintf("%d", data.Result.YourBetterCount) })
					</a>

					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "equal")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "equal"), templ.KV("btn-secondary", data.ActiveTab != "equal") }
					>
						نفس الخصم ({ fmt.Sprintf("%d", data.Result.EqualCount) })
					</a>

					<a
						href={ templ.SafeURL(buildHeadToHeadURL(data.SourceFileID, data.TargetFileID, data.Query, data.MinPrice, data.MaxPrice, data.MinDiscount, data.MaxDiscount, "competitor_better")) }
						class={ "btn btn-sm font-bold", templ.KV("btn-primary", data.ActiveTab == "competitor_better"), templ.KV("btn-secondary", data.ActiveTab != "competitor_better") }
					>
						خصم أفضل منك ({ fmt.Sprintf("%d", data.Result.CompetitorBetter) })
					</a>
				</div>
			</div>

			<!-- Main Comparison Table Matching Image 1 Exactly -->
			<div class="glass-panel p-0 mb-0 overflow-hidden">
				<div class="table-container m-0">
					<table class="data-table m-0" id="head-to-head-table">
						<thead>
							<tr>
								<!-- 1. المنتج -->
								<th>المنتج</th>
								
								<!-- 2. سعر الجمهور -->
								<th class="text-center tabular-nums">سعر الجمهور</th>
								
								<!-- 3. نسبة الخصم -->
								<th class="text-center tabular-nums">
									نسبة الخصم ({ data.Result.SourceSupplierName })
								</th>
								
								<!-- 4. خصم أفضل منك -->
								<th class="text-center text-danger">
									خصم أفضل منك
								</th>
								
								<!-- 5. نفس الخصم -->
								<th class="text-center text-brand">
									نفس الخصم
								</th>
								
								<!-- 6. خصمك أفضل منهم -->
								<th class="text-center text-success">
									خصمك أفضل منهم
								</th>
							</tr>
						</thead>
						<tbody>
							if len(data.Result.Rows) == 0 {
								<tr>
									<td colspan="6" class="text-center p-8 text-muted">
										<div class="text-3xl mb-2">@components.IconSearch("icon-sm")</div>
										<div class="font-extrabold text-base text-primary">لا توجد نتائج تطابق خيارات الفلترة المحددة</div>
										<div class="text-xs text-muted mt-1">جرب تعديل نطاق الأسعار أو نسب الخصم أو اختيار موردين آخرين.</div>
									</td>
								</tr>
							}
							for _, r := range data.Result.Rows {
								<tr>
									<!-- 1. المنتج -->
									<td>
										<div class="font-extrabold text-primary text-sm">
											{ r.ProductName }
										</div>
										if r.SKU != "" {
											<span class="text-xs text-muted tabular-nums">
												كود: { r.SKU }
											</span>
										}
									</td>

									<!-- 2. السعر -->
									<td class="text-center font-bold text-secondary tabular-nums">
										{ r.Price.String() } ج.م
									</td>

									<!-- 3. الخصم -->
									<td class="text-center font-extrabold text-primary tabular-nums">
										if r.YourDiscount > 0 {
											<span class="badge badge-slate text-xs">
												{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
											</span>
										} else {
											<span class="text-muted">0%</span>
										}
									</td>

									<!-- 4. خصم أفضل منك -->
									<td class="text-center tabular-nums">
										if r.Outcome == compare.OutcomeCompetitorBetter {
											<div class="d-inline-flex flex-col items-center gap-1 p-1 px-2 bg-danger-subtle border border-danger rounded-lg">
												<span class="font-extrabold text-danger text-xs">
													{ fmt.Sprintf("%.1f%%", r.CompetitorDiscount) }
												</span>
												<span class="text-xs text-danger font-bold">
													(+{ fmt.Sprintf("%.1f%%", r.CompetitorDiff) } للمنافس)
												</span>
											</div>
										} else {
											<span class="text-muted">—</span>
										}
									</td>

									<!-- 5. نفس الخصم -->
									<td class="text-center tabular-nums">
										if r.Outcome == compare.OutcomeEqual {
											<span class="badge badge-sky text-xs font-bold">
												{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
											</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>

									<!-- 6. خصمك أفضل منهم -->
									<td class="text-center tabular-nums">
										if r.Outcome == compare.OutcomeYourBetter {
											<div class="d-inline-flex flex-col items-center gap-1 p-1 px-2 bg-emerald-subtle border border-emerald rounded-lg">
												<span class="font-extrabold text-success text-xs">
													{ fmt.Sprintf("%.1f%%", r.YourDiscount) }
												</span>
												<span class="text-xs text-success font-bold">
													(+{ fmt.Sprintf("%.1f%%", r.BetterDiff) } أفضلية لك)
												</span>
											</div>
										} else {
											<span class="text-muted">—</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>

	<!-- Export Table to CSV Script -->
	<script>
		function exportHeadToHeadToCSV() {
			var table = document.getElementById("head-to-head-table");
			if (!table) return;
			var rows = table.querySelectorAll("tr");
			var csv = [];
			for (var i = 0; i < rows.length; i++) {
				var row = [], cols = rows[i].querySelectorAll("td, th");
				for (var j = 0; j < cols.length; j++) {
					var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
					data = data.replace(/"/g, '""');
					row.push('"' + data + '"');
				}
				csv.push(row.join(","));
			}
			var csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
			var downloadLink = document.createElement("a");
			downloadLink.download = "head_to_head_comparison.csv";
			downloadLink.href = window.URL.createObjectURL(csvFile);
			downloadLink.style.display = "none";
			document.body.appendChild(downloadLink);
			downloadLink.click();
			document.body.removeChild(downloadLink);
		}
	</script>
}

templ CompareHeadToHeadPage(lang, dir string, data HeadToHeadPageData) {
	if data.IsCustomer {
		@layouts.ShellFor("مقارنة مورد بمورد | Dawa24", "compare", lang, dir, authctx.FromContext(ctx)) {
			@CompareHeadToHeadContent(data)
		}
	} else {
		@layouts.VendorShell("مقارنة مورد بمورد | Dawa24", "compare", lang, dir) {
			@CompareHeadToHeadContent(data)
		}
	}
}
