package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ FinderQuestionPage(lang, dir string, q *catalog.FinderQuestion, options []*catalog.FinderOption) {
	@layouts.CustomerShell("دليل اختيار المنتج | Finder", lang, dir) {
		<div style="max-width:560px;">
			<div class="card" style="margin-bottom:0;">
				<h2 style="font-size:1.25rem; font-weight:900; color:var(--neutral-900); margin:0 0 1.25rem;">{ q.Question.Get(i18n.Lang(lang)) }</h2>
				if len(options) == 0 {
					<p style="color:var(--neutral-500); font-size:0.9rem;">لا توجد خيارات لهذا السؤال بعد.</p>
				} else {
					<div style="display:flex; flex-direction:column; gap:0.75rem;">
						for _, o := range options {
							<form method="POST" action="/finder/answer" style="margin:0;">
								<input type="hidden" name="option_id" value={ fmt.Sprintf("%d", o.ID) } />
								<input type="hidden" name="question_id" value={ fmt.Sprintf("%d", q.ID) } />
								<button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center;">{ o.Label.Get(i18n.Lang(lang)) }</button>
							</form>
						}
					</div>
				}
			</div>
		</div>
	}
}

templ FinderResultPage(lang, dir string, r *catalog.FinderResult) {
	@layouts.CustomerShell("النتيجة | Finder", lang, dir) {
		<div style="max-width:560px;">
			<div class="card" style="margin-bottom:0; text-align:center;">
				<h2 style="font-size:1.4rem; font-weight:900; color:var(--primary-700); margin:0 0 0.75rem;">{ r.Title.Get(i18n.Lang(lang)) }</h2>
				<p style="color:var(--neutral-600); line-height:1.8; margin:0 0 1.5rem;">{ r.Description.Get(i18n.Lang(lang)) }</p>
				<a href="/catalog" class="btn btn-primary" style="justify-content:center;">تصفح المنتجات</a>
				<a href="/finder" class="btn btn-secondary" style="justify-content:center;">إعادة البدء</a>
			</div>
		</div>
	}
}
