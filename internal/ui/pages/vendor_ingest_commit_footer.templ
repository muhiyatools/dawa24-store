package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/ingest"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// importCommitFooter is the last thing a vendor reads before their catalogue
// changes, so it states what the run will do rather than what the mode is
// called.
//
// The four numbers come from the commit's own planner (ingest.CommitPlan): the
// same decide() the write uses, run over the same rows, counted instead of
// written. Before that this panel printed the MATCHED count under every mode —
// right for the default, wrong for "add new only" by every product the vendor
// already stocks, wrong for "update existing only" by every product they do
// not, and silent under "this file is my whole catalogue" about the only figure
// that mode turns on, which is how many items are about to come off sale.
templ importCommitFooter(view VendorImportView, held int) {
	{{ plan := view.Plan }}
	{{ mode := view.Session.Settings.Mode }}
	{{ writes := 0 }}
	if plan != nil {
		{{ writes = plan.Writes() }}
	}
	<div class={ "glass-panel p-5 mb-0 border rounded-2xl shadow-xs",
		templ.KV("border-rose-300/80 bg-rose-50/20", plan != nil && plan.Retire > 0),
		templ.KV("border-slate-200/80", plan == nil || plan.Retire == 0) }>
		<div class="flex-between items-start flex-wrap gap-4">
			<div class="stack-sm">
				<div class="font-black text-base text-primary">اعتماد البيانات وحفظها في الكتالوج والمخزن</div>

				if plan == nil {
					<div class="text-xs text-secondary mt-0.5">
						سيتم حفظ الأصناف المعتمدة في كتالوجك وإيداع كمياتها في المخزن المختار (<strong>{ importWarehouseName(view) }</strong>).
					</div>
				} else {
					<!-- What this run will actually write -->
					<div class="d-flex items-center gap-4 flex-wrap mt-1.5 text-xs">
						@commitPlanFigure("إضافة أصناف جديدة", plan.Insert, "text-emerald-600")
						@commitPlanFigure("تحديث أصناف موجودة", plan.Update, "text-brand-600")
						if plan.SkippedByMode > 0 {
							@commitPlanFigure("تخطٍّ بحكم نمط الاستيراد", plan.SkippedByMode, "text-muted")
						}
						if plan.Retire > 0 {
							@commitPlanFigure("إيقاف عرض أصناف غائبة عن الملف", plan.Retire, "text-rose-600")
						}
					</div>

					<div class="text-xs text-secondary mt-1.5">
						switch mode {
							case ingest.ModeAddOnly:
								سيتم حفظ الأصناف <strong>الجديدة فقط</strong>؛ وأي صنف تملكه بالفعل سيُترك بسعره ورصيده كما هو.
							case ingest.ModeUpdateOnly:
								سيتم تحديث الأصناف <strong>الموجودة مسبقاً فقط</strong>؛ ولن يُضاف أي صنف جديد إلى كتالوجك.
							case ingest.ModeReplace:
								سيتم اعتماد هذا الملف <strong>ككتالوجك الكامل</strong>: تُضاف وتُحدّث أصناف الملف، ويتوقف عرض كل صنف آخر في كتالوجك مع تصفير رصيده في المخزن المختار.
							default:
								سيتم تحديث الأصناف المطابقة وإضافة الجديدة، وإيداع الكميات في المخزن المختار (<strong>{ importWarehouseName(view) }</strong>).
						}
					</div>

					if mode == ingest.ModeReplace && plan.Retire > 0 {
						<div class="text-xs mt-2 font-bold text-rose-600 d-flex items-start gap-1.5">
							@components.IconAlert("icon-2xs mt-0.5 flex-shrink-0")
							<span>
								{ fmt.Sprint(plan.Retire) } صنفاً من كتالوجك الحالي غير موجود في هذا الملف وسيتوقف عرضه للصيدليات.
								هذا الإجراء قابل للتراجع من شاشة كتالوجك (بإعادة تفعيل الصنف)، لكنه يؤثر فوراً على الطلبات الجديدة.
							</span>
						</div>
					}
					if mode == ingest.ModeReplace && plan.Retire == 0 && writes > 0 {
						<div class="text-xs mt-2 font-semibold text-secondary">
							لا يوجد صنف في كتالوجك خارج هذا الملف، فلن يتوقف عرض أي صنف.
						</div>
					}

					if plan.SkippedByMode > 0 {
						<div class="text-xs mt-1.5 font-semibold text-muted">
							{ fmt.Sprint(plan.SkippedByMode) } صنفاً مطابقاً لن يُكتب لأن نمط الاستيراد الحالي يستبعده. غيّر النمط إن أردت حفظه.
						</div>
					}
				}

				if held > 0 {
					<div class="text-xs mt-1.5 review-gate-note font-semibold text-amber-600">
						{ fmt.Sprint(held) } صنف لن يُستورد لأنه ما زال «يحتاج مراجعة» أو «غير مطابق».
						اعتمدها من التبويبات أعلاه — أو اتركها، فلن يُكتب منها شيء.
						if mode == ingest.ModeReplace {
							<span class="d-block mt-0.5 font-medium text-secondary">
								لن يتوقف عرض أصناف هذه الصفوف: الملف يذكرها، وإن لم تُعتمد مطابقتها.
							</span>
						}
					</div>
				}
			</div>

			<form class="m-0" method="POST" action={ templ.SafeURL("/vendor/ingest/" + view.Session.PublicID + "/commit") }
				data-writes={ fmt.Sprint(writes) }
				data-held={ fmt.Sprint(held) }
				data-retire={ fmt.Sprint(planRetire(plan)) }
				onsubmit="return confirmReviewCommit(this)">
				<button type="submit"
					class={ "btn font-black px-6 py-2.5 text-sm gap-2 shadow-sm",
						templ.KV("btn-danger", plan != nil && plan.Retire > 0),
						templ.KV("btn-primary", plan == nil || plan.Retire == 0) }
					disabled?={ plan != nil && writes == 0 }>
					@components.IconCheckCircle("icon-xs")
					<span>{ commitButtonLabel(view) }</span>
				</button>
			</form>
		</div>
	</div>
}

// commitPlanFigure is one number of the plan, labelled.
templ commitPlanFigure(label string, value int, tone string) {
	<div class="d-flex items-baseline gap-1.5">
		<span class={ "font-black tabular-nums text-base", tone }>{ fmt.Sprint(value) }</span>
		<span class="text-2xs text-secondary font-semibold">{ label }</span>
	</div>
}
