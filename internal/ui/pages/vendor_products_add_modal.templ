package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorProductsAddFromCatalogModal(data VendorVariantsData, lang string) {
	@components.Modal(components.ModalProps{ID: "add-from-catalog-modal", Title: i18n.T(lang, "vendor_products.add_from_catalog_title"), Size: "xl"}) {
		<form method="POST" action="/vendor/products/add-from-catalog" id="add-from-catalog-form" class="d-flex flex-col flex-1 overflow-y-auto pe-1">
			<input type="hidden" id="cat-select-product-id" name="product_id" value="" />
			<input type="hidden" id="cat-select-name-ar" name="name_ar" value="" />
			<input type="hidden" id="cat-select-name-en" name="name_en" value="" />
			<input type="hidden" id="cat-select-sku" name="sku" value="" />
			<input type="hidden" id="cat-select-barcode" name="barcode" value="" />
			<input type="hidden" id="cat-select-unit" name="unit" value="" />

			<div class="stack-lg flex-1">
				
				<!-- Search Input for General Catalog -->
				<div class="relative w-full">
					<label class="form-label font-extrabold text-primary text-sm mb-1">
						{ i18n.T(lang, "vendor_products.search_central_catalog_label") } <span class="text-danger">*</span>
					</label>
					<div class="relative w-full">
						<input
							type="text"
							id="cat-search-input"
							placeholder={ i18n.T(lang, "vendor_products.search_drug_ph") }
							class="form-input w-full rounded-lg ps-11 text-sm h-11"
							oninput="searchMasterCatalogLive(this.value)"
							autocomplete="off"
						/>
						<div class="absolute start-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none d-flex items-center">
							@components.IconSearch("icon-sm")
						</div>
					</div>

					<!-- Dropdown Results in flow -->
					<div id="cat-search-dropdown" class="d-none max-h-72 overflow-y-auto bg-surface-sunken border rounded-2xl shadow-xl mt-2"></div>
				</div>

				<!-- Selected Product Info Card Preview -->
				<div id="cat-selected-preview" class="d-none bg-surface-sunken border border-accent rounded-2xl p-5">
					<div class="flex-between items-start mb-3">
						<div class="stack-sm">
							<span class="badge badge-emerald text-xs font-black mb-1 inline-block">{ i18n.T(lang, "vendor_products.selected_approved_item") }</span>
							<h4 id="cat-preview-name" class="text-base font-black text-primary m-0"></h4>
							<div id="cat-preview-scientific" class="text-xs text-muted mt-0.5"></div>
						</div>
						<button type="button" class="btn btn-secondary btn-sm text-xs text-danger font-bold" onclick="resetSelectedMasterProduct()">
							{ i18n.T(lang, "vendor_products.change_item_btn") }
						</button>
					</div>
					
					<div class="d-flex gap-2 flex-wrap text-xs text-secondary">
						<span id="cat-preview-dosage" class="badge badge-slate"></span>
						<span id="cat-preview-sku" class="badge badge-slate"></span>
						<span id="cat-preview-price" class="badge badge-sky"></span>
					</div>
				</div>

				<!-- Vendor Customization Fields -->
				<div id="cat-vendor-fields" class="d-none flex-col gap-4 border-t pt-5">
					<div class="font-extrabold text-sm text-primary">
						{ i18n.T(lang, "vendor_products.step2_pricing_title") }
					</div>

					<div class="grid-2">
						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_public_price") } <span class="text-danger">*</span>
							</label>
							<input
								type="number"
								step="0.01"
								id="cat-field-price"
								name="price"
								required
								placeholder="0.00"
								class="form-input w-full-rounded"
							/>
						</div>

						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_discount_pct") }
							</label>
							<input
								type="number"
								step="0.1"
								min="0"
								max="100"
								id="cat-field-discount"
								name="discount"
								placeholder="0.0%"
								class="form-input w-full-rounded"
							/>
						</div>
					</div>

					<div class="grid-2">
						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm d-flex items-center gap-1">
								<span>{ i18n.T(lang, "vendor_products.fld_cost_price") }</span>
								<span class="badge badge-slate text-xs">{ i18n.T(lang, "vendor_products.badge_optional") }</span>
							</label>
							<input
								type="number"
								step="0.01"
								min="0"
								id="cat-field-cost"
								name="cost_price"
								placeholder="0.00"
								class="form-input w-full-rounded"
							/>
						</div>

						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm d-flex items-center gap-1">
								<span>{ i18n.T(lang, "vendor_products.fld_cost_discount") }</span>
								<span class="badge badge-slate text-xs">{ i18n.T(lang, "vendor_products.badge_optional") }</span>
							</label>
							<input
								type="number"
								step="0.1"
								min="0"
								max="100"
								id="cat-field-cost-discount"
								name="cost_discount_percentage"
								placeholder="0.0%"
								class="form-input w-full-rounded"
							/>
						</div>
					</div>

					<div class="grid-2">
						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_available_stock") }
							</label>
							<input
								type="number"
								id="cat-field-stock"
								name="stock_qty"
								placeholder="50"
								class="form-input w-full-rounded"
							/>
						</div>

						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_min_order_qty") }
							</label>
							<input
								type="number"
								id="cat-field-min-qty"
								name="min_order_qty"
								value="1"
								min="1"
								class="form-input w-full-rounded"
							/>
						</div>
					</div>

					<div class="grid-2">
						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_batch_num") }
							</label>
							<input
								type="text"
								id="cat-field-batch"
								name="batch_number"
								placeholder="B202604"
								class="form-input w-full-rounded"
							/>
						</div>

						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_expiry_date") }
							</label>
							<input
								type="date"
								id="cat-field-expiry"
								name="expiry_date"
								class="form-input w-full-rounded"
							/>
						</div>
					</div>

					<div class="grid-2">
						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_shipping_warehouse") }
							</label>
							<select name="branch_id" id="cat-field-branch" class="form-input w-full-rounded">
								for _, b := range data.Branches {
									<option value={ fmt.Sprintf("%d", b.ID) } selected?={ b.IsMain }>
										{ b.Name }
										if b.IsMain {
											<span> { i18n.T(lang, "vendor_products.main_branch_suffix") }</span>
										}
									</option>
								}
							</select>
						</div>

						<div class="stack-sm">
							<label class="form-label font-bold text-primary text-sm">
								{ i18n.T(lang, "vendor_products.fld_is_negotiable") }
							</label>
							<select name="is_negotiable" id="cat-field-negotiable" class="form-input w-full rounded-lg font-bold">
								<option value="false">{ i18n.T(lang, "vendor_products.negotiable_no") }</option>
								<option value="true">{ i18n.T(lang, "vendor_products.negotiable_yes") }</option>
							</select>
						</div>
					</div>

					<div class="modal-footer">
						<button type="button" class="btn btn-secondary font-bold" onclick="closeAddFromCatalogModal()">
							{ i18n.T(lang, "common.cancel") }
						</button>
						<button type="submit" class="btn btn-primary font-bold px-6">
							{ i18n.T(lang, "vendor_products.btn_save_add_supply") }
						</button>
					</div>
				</div>

			</div>
		</form>
	}
}