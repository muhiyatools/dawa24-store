package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminAskForPage renders document & action requests table.
templ AdminAskForPage(requests []*workflow.Request, lang, dir string) {
	@layouts.AdminShell("إدارة طلبات المستندات والإجراءات (Ask For)", "tools", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							📋
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">طلبات المستندات والإجراءات المطلوبة ({ fmt.Sprintf("%d", len(requests)) })</h1>
							<p class="text-sm text-secondary m-0 mt-1">متابعة طلبات المستندات الرسمية والتحديثات المطلوبة من الصيدليات والموردين</p>
						</div>
					</div>
				</div>
			</div>

			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(requests) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">📋</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد طلبات معلقة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يتم إصدار طلبات مستندات بعد.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>#</th>
									<th>العنوان</th>
									<th>النوع</th>
									<th>من منشأة</th>
									<th>إلى منشأة</th>
									<th class="text-center">الحالة</th>
									<th class="text-end">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, r := range requests {
									<tr>
										<td class="tabular-nums font-bold text-brand">#{ fmt.Sprintf("%d", r.ID) }</td>
										<td><strong class="text-primary text-xs">{ r.Title.Get("ar") }</strong></td>
										<td><code class="font-mono text-xs p-1 rounded bg-surface border">{ string(r.Type) }</code></td>
										<td class="text-xs text-secondary">منشأة #{ fmt.Sprintf("%d", r.FromOrgID) }</td>
										<td class="text-xs text-secondary">منشأة #{ fmt.Sprintf("%d", r.ToOrgID) }</td>
										<td class="text-center">
											if r.Status == workflow.RequestPending {
												<span class="badge badge-amber text-xs font-bold">قيد الانتظار</span>
											} else if r.Status == workflow.RequestAccepted {
												<span class="badge badge-emerald text-xs font-bold">تم القبول</span>
											} else {
												<span class="badge badge-rose text-xs font-bold">مرفوض</span>
											}
										</td>
										<td class="text-end">
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/ask-for/%d", r.ID)) } class="btn btn-secondary btn-sm font-bold text-xs">عرض الطلب</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

// AdminAskForDetailPage renders single request detail.
templ AdminAskForDetailPage(r *workflow.Request, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("طلب مستند: %s", r.Title.Get("ar")), "tools", lang, dir) {
		<div class="page-container max-w-2xl mx-auto">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center mb-4 pb-3 border-b">
					<div>
						<h2 class="text-xl font-black text-primary m-0">{ r.Title.Get("ar") }</h2>
						<p class="text-xs text-secondary m-0 mt-1">طلب #{ fmt.Sprintf("%d", r.ID) } | نوع: { string(r.Type) }</p>
					</div>
					<a href="/admin/ask-for" class="btn btn-secondary btn-sm font-bold text-xs">العودة للطلبات</a>
				</div>

				<div class="p-4 rounded-xl bg-surface-sunken border mb-6">
					<div class="text-xs text-muted font-bold mb-1">الوصف المطلوب:</div>
					<div class="text-sm text-primary leading-relaxed">{ r.Description }</div>
				</div>

				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/ask-for/%d/respond", r.ID)) } class="d-flex justify-end gap-3">
					<button type="submit" name="status" value="declined" class="btn btn-ghost btn-sm text-danger font-bold">رفض الطلب</button>
					<button type="submit" name="status" value="accepted" class="btn btn-primary btn-sm font-bold px-4">قبول واعتماد</button>
				</form>
			</div>
		</div>
	}
}
