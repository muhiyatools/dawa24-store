package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/workflow"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// AdminAskForPage renders document & action requests table.
templ AdminAskForPage(requests []*workflow.Request, lang, dir string) {
	@layouts.AdminShell("إدارة طلبات المستندات والإجراءات (Ask For)", "tools", lang, dir) {
		<div class="card mb-0">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 class="card-title m-0">طلبات المستندات والإجراءات المطلوبة ({ fmt.Sprintf("%d", len(requests)) })</h2>
					<p class="subtitle">متابعة طلبات المستندات الرسمية والتحديثات المطلوبة من الصيدليات والموردين.</p>
				</div>
			</div>

			if len(requests) == 0 {
				@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات معلقة", Message: "لم يتم إصدار طلبات مستندات بعد."})
			} else {
				<div class="table-container">
					<table class="b2b-table">
						<thead>
							<tr>
								<th>#</th>
								<th>العنوان</th>
								<th>النوع</th>
								<th>من منشأة</th>
								<th>إلى منشأة</th>
								<th>الحالة</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range requests {
								<tr>
									<td class="tabular-nums">#{ fmt.Sprintf("%d", r.ID) }</td>
									<td><strong>{ r.Title.Get("ar") }</strong></td>
									<td><code>{ string(r.Type) }</code></td>
									<td>منشأة #{ fmt.Sprintf("%d", r.FromOrgID) }</td>
									<td>منشأة #{ fmt.Sprintf("%d", r.ToOrgID) }</td>
									<td>
										if r.Status == workflow.RequestPending {
											<span class="badge badge-warning">قيد الانتظار</span>
										} else if r.Status == workflow.RequestAccepted {
											<span class="badge badge-success">تم القبول</span>
										} else {
											<span class="badge badge-danger">مرفوض</span>
										}
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/ask-for/%d", r.ID)) } class="btn btn-secondary btn-sm">عرض الطلب</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminAskForDetailPage renders single request detail.
templ AdminAskForDetailPage(r *workflow.Request, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("طلب مستند: %s", r.Title.Get("ar")), "tools", lang, dir) {
		<div class="card max-w-2xl mx-auto">
			<div class="header-row">
				<div>
					<h2 class="card-title m-0">{ r.Title.Get("ar") }</h2>
					<p class="subtitle">طلب #{ fmt.Sprintf("%d", r.ID) } | نوع: { string(r.Type) }</p>
				</div>
				<a href="/admin/ask-for" class="btn btn-secondary btn-sm">العودة للطلبات</a>
			</div>

			<div style="margin-bottom:1.5rem; background:var(--surface-sunken); padding:1rem; border-radius:var(--radius-md);">
				<div style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:0.25rem;">الوصف المطلوب:</div>
				<div style="font-size:0.95rem; line-height:1.5;">{ r.Description }</div>
			</div>

			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/ask-for/%d/respond", r.ID)) } style="display:flex; justify-content:flex-end; gap:0.75rem;">
				<button type="submit" name="status" value="declined" class="btn btn-secondary text-danger">رفض الطلب</button>
				<button type="submit" name="status" value="accepted" class="btn btn-primary">قبول واعتماد</button>
			</form>
		</div>
	}
}
