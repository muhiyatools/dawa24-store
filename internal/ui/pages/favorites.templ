package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ FavoritesPage(lang, dir string, products []*catalog.Product) {
	@layouts.CustomerShell("الأدوية والمستلزمات المفضلة | دواء 24", "favorites", lang, dir, nil) {
		<div class="py-2">
			<!-- Page Header Strip (Platform Design System) -->
			<div class="glass-panel p-5 mb-5 flex-between flex-wrap gap-4 border rounded-2xl shadow-xs">
				<div class="stack-2xs">
					<nav class="text-xs text-muted mb-1 d-flex items-center gap-1.5 font-bold">
						<a href="/customer/dashboard" class="text-secondary transition-colors">لوحة التحكم</a>
						<span class="text-muted">/</span>
						<span class="text-primary font-black">المنتجات المفضلة</span>
					</nav>
					<h1 class="text-2xl font-black text-primary m-0 tracking-tight">
						الأدوية والمستلزمات الطبية المحفوظة
					</h1>
					<p class="text-xs text-secondary mt-1 mb-0 font-medium">
						قائمة الأصناف المحفوظة لتسهيل المتابعة، المقارنة، وإجراء طلبات الشراء السريعة
					</p>
				</div>

				<div class="d-flex items-center gap-2.5 flex-wrap">
					<a href="/catalog" class="btn btn-secondary btn-sm font-bold gap-2 shadow-xs">
						@components.IconPackage("icon-xs")
						<span>تصفح الكتالوج الدوائي</span>
					</a>
					<a href="/customer/purchase-request" class="btn btn-primary btn-sm font-extrabold gap-2 px-4 shadow-sm">
						@components.IconZap("icon-xs")
						<span>طلب شراء ذكي</span>
					</a>
				</div>
			</div>

			<!-- Summary Toolbar -->
			<div class="glass-panel p-3 mb-5 border rounded-xl shadow-xs flex-between items-center flex-wrap gap-3">
				<div class="d-flex items-center gap-2">
					@components.IconHeartFilled("icon-xs text-rose")
					<span class="text-xs font-bold text-primary">إجمالي الأصناف المحفوظة:</span>
					<span class="badge badge-secondary text-xs font-black tabular-nums">
						{ fmt.Sprintf("%d أصناف", len(products)) }
					</span>
				</div>
				<a href="/catalog" class="text-xs font-bold text-brand hover:underline">
					+ إضافة أصناف جديدة من الكتالوج
				</a>
			</div>

			if len(products) == 0 {
				<div class="glass-panel p-12 text-center border rounded-2xl shadow-xs">
					<div class="w-14 h-14 rounded-full bg-rose-50 text-rose-500 d-flex items-center justify-center mx-auto mb-3">
						@components.IconHeart("icon-md")
					</div>
					<h3 class="text-base font-extrabold text-primary mb-1.5">قائمة المفضلة فارغة حالياً</h3>
					<p class="text-xs text-secondary mb-5 max-w-md mx-auto leading-relaxed">
						لم تقم بحفظ أي أدوية أو مستلزمات طبية بعد. يمكنك الضغط على رمز القلب في بطاقة أي صنف لحفظه هنا للطلب السريع.
					</p>
					<a href="/catalog" class="btn btn-primary btn-sm font-bold px-5 py-2 shadow-xs">
						<span>تصفح الكتالوج الدوائي الآن</span>
					</a>
				</div>
			} else {
				<div class="product-grid-wrapper mb-6">
					for _, p := range products {
						<div class="product-card-glass d-flex flex-col justify-between">
							<div>
								<!-- Top Badges & Remove Button -->
								<div class="flex-between items-center mb-3">
									<div>
										if p.DosageForm != "" {
											<span class="badge badge-sky font-bold text-xs shadow-xs">
												{ p.DosageForm }
											</span>
										} else {
											<span class="badge badge-slate font-bold text-xs">
												صنف دوائي
											</span>
										}
									</div>

									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/remove", p.ID)) } class="m-0">
										<button
											type="submit"
											class="fav-icon-btn is-active"
											title="إزالة من المفضلة"
										>
											@components.IconTrash("icon-xs text-rose")
										</button>
									</form>
								</div>

								<!-- Media Box -->
								<div class="product-card-media">
									if p.Image != "" {
										<img src={ p.Image } alt={ p.Name["ar"] } class="product-card-img" loading="lazy" />
									} else {
										<div class="product-card-placeholder">
											@components.IconPill("icon-lg")
											<span class="text-xs font-bold opacity-60">صورة الصنف</span>
										</div>
									}
								</div>

								<!-- Product Title -->
								<h3 class="text-sm font-black text-primary m-0 mb-1 line-clamp-2 leading-snug">
									if p.Name["ar"] != "" {
										{ p.Name["ar"] }
									} else {
										{ p.Name["en"] }
									}
								</h3>
								if p.Name["en"] != "" && p.Name["en"] != p.Name["ar"] {
									<div class="text-xs text-muted font-bold mb-2 text-truncate" dir="ltr">
										{ p.Name["en"] }
									</div>
								}

								<!-- Manufacturer & Scientific Name -->
								if p.ManufacturingCompanies != "" {
									<div class="d-flex items-center gap-1.5 text-xs text-secondary mb-1">
										@components.IconBuilding("icon-xs text-muted flex-shrink-0")
										<span class="text-muted font-medium">الشركة:</span>
										<strong class="text-primary text-truncate">{ p.ManufacturingCompanies }</strong>
									</div>
								}
								if p.ScientificName != "" {
									<div class="text-xs text-secondary mb-2 text-truncate font-medium">
										<span class="text-muted">المادة: </span>
										<span class="font-bold text-primary">{ p.ScientificName }</span>
									</div>
								}
							</div>

							<!-- Price & Action Footer -->
							<div class="border-t pt-3 mt-auto">
								<div class="flex-between items-baseline mb-2.5">
									<div>
										<span class="text-2xs text-muted font-bold d-block">سعر الجمهور:</span>
										if p.Price.IsPositive() {
											<span class="text-sm font-black text-primary tabular-nums">
												{ p.Price.String() } ج.م
											</span>
										} else {
											<span class="text-xs text-muted font-semibold">-</span>
										}
									</div>
								</div>

								<a
									href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) }
									class="btn btn-primary btn-sm w-full font-bold justify-center gap-1.5 shadow-xs"
								>
									<span>استعراض عروض التوريد والطلب</span>
									@components.IconArrowLeft("icon-xs")
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}