package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ FavoritesPage(lang, dir string, products []*catalog.Product) {
	@layouts.CustomerShell("الأدوية والمستلزمات المفضلة", "favorites", lang, dir, nil) {
  <div class="stack-sm">
   <div class="stack-sm">
				<div class="row-center-sm">
					<div class="stack-xs text-sm">
						@components.IconHeart("icon-sm")
					</div>
     <div class="stack-sm">
						<h2 class="card-title font-bold text-base m-0">
							الأدوية والمستلزمات المفضلة
						</h2>
      <p class="text-sm text-secondary m-0">
							قائمة الأصناف المحفوظة للطلب السريع
						</p>
					</div>
				</div>
				<a href="/catalog" class="btn btn-secondary btn-sm fw-700">
					@components.IconSearch("icon-xs")
					<span>تصفح الكتالوج الدوائي</span>
				</a>
			</div>

			if len(products) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:       "قائمة المفضلة فارغة",
					Message:     "لم تقم بحفظ أي أدوية بعد. يمكنك الضغط على رمز القلب في صفحة الصنف لحفظه هنا.",
					ActionLabel: "تصفح الكتالوج الدوائي",
				})
			} else {
				<div class="product-grid">
					for _, p := range products {
						<div class="card hover-lift">
       <div class="stack-sm">
        <div class="stack-sm">
									<span class="badge badge-slate text-xs">
										@components.IconPill("icon-xs")
										<span>{ p.DosageForm }</span>
									</span>
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/favorites/%d/remove", p.ID)) } class="m-0">
										<button type="submit" class="btn btn-secondary btn-icon" title="إزالة من المفضلة">
											@components.IconTrash("icon-xs")
										</button>
									</form>
								</div>

								<h3 class="font-bold text-sm m-0">
									if p.Name["ar"] != "" {
										{ p.Name["ar"] }
									} else {
										{ p.Name["en"] }
									}
								</h3>

								if p.ScientificName != "" {
         <p class="text-sm text-secondary m-0">
										{ p.ScientificName }
									</p>
								}
								if p.ManufacturingCompanies != "" {
									<div class="stack-xs text-sm">
										الشركة: { p.ManufacturingCompanies }
									</div>
								}
							</div>

       <div class="stack-sm">
								<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-primary btn-sm">
									@components.IconFileText("icon-xs")
									<span>التفاصيل والطلب</span>
								</a>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}
