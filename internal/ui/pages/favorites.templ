package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ FavoritesPage(lang, dir string, products []*catalog.Product) {
	@layouts.CustomerShell("المفضلة | Favorites", lang, dir) {
		<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
			<h2 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin:0;">منتجاتك المفضلة</h2>
			<a href="/catalog" class="btn btn-secondary btn-sm">تصفح الكتالوج</a>
		</div>
		if len(products) == 0 {
			@components.EmptyState(components.EmptyStateProps{
				Title:       "قائمة المفضلة فارغة",
				Message:     "لم تحفظ أي منتجات بعد. اضغط على القلب في أي منتج لإضافته هنا.",
				ActionLabel: "تصفح الكتالوج",
			})
		} else {
			<div class="product-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:1.25rem;">
				for _, p := range products {
					<div class="card hover-lift" style="display:flex; flex-direction:column; justify-content:space-between; padding:1.25rem; margin-bottom:0;">
						<div>
							<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.6rem;">
								<span class="badge badge-slate" style="font-size:0.725rem;">{ p.DosageForm }</span>
								<form method="POST" action={ fmt.Sprintf("/favorites/%d/remove", p.ID) } style="margin:0;">
									<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);" aria-label="إزالة من المفضلة">
										@components.IconClose("icon-xs")
									</button>
								</form>
							</div>
							<h4 style="font-size:1.05rem; font-weight:700; margin-bottom:0.25rem; color:var(--neutral-900);">
								if p.Name["ar"] != "" {
									{ p.Name["ar"] }
								} else {
									{ p.Name["en"] }
								}
							</h4>
							<p style="font-size:0.8rem; color:var(--neutral-500);">{ p.Name["en"] }</p>
						</div>
						<div style="margin-top:1.25rem; border-top:1px solid var(--neutral-100); padding-top:0.875rem;">
							<a href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", p.ID)) } class="btn btn-secondary" style="width:100%; font-size:0.85rem; justify-content:center;">التفاصيل والأسعار</a>
						</div>
					</div>
				}
			</div>
		}
	}
}
