package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// VendorPaymentsPageData carries all view state for the vendor payments ledger.
type VendorPaymentsPageData struct {
	Payments   []*billing.AdminPaymentView
	Invoices   []*billing.AdminInvoiceView
	Stats      *billing.VendorPaymentStats
	Search     string
	Method     string
	Status     string
	DateFrom   string
	DateTo     string
	Page       int
	PerPage    int
	TotalCount int
	Lang       string
	Dir        string
}

func vendorPaymentMethodLabel(m string) string {
	switch m {
	case "bank_transfer":
		return "تحويل بنكي"
	case "cash":
		return "نقدي"
	case "cheque":
		return "شيك مصرفي"
	case "electronic_wallet":
		return "محفظة إلكترونية"
	default:
		if m == "" {
			return "غير محدد"
		}
		return m
	}
}

func vendorPaymentStatusBadge(s string) (string, string) {
	switch s {
	case "paid", "completed":
		return "مدفوعة", "badge-emerald"
	case "pending":
		return "قيد المعالجة", "badge-amber"
	case "failed":
		return "ملغاة", "badge-rose"
	case "refunded":
		return "مستردة", "badge-slate"
	default:
		return s, "badge-slate"
	}
}

func vendorPaymentsQueryValues(data VendorPaymentsPageData) url.Values {
	q := url.Values{}
	if data.Search != "" {
		q.Set("q", data.Search)
	}
	if data.Method != "" {
		q.Set("method", data.Method)
	}
	if data.Status != "" {
		q.Set("status", data.Status)
	}
	if data.DateFrom != "" {
		q.Set("from", data.DateFrom)
	}
	if data.DateTo != "" {
		q.Set("to", data.DateTo)
	}
	return q
}

// VendorPaymentsPage renders payments history for the vendor.
templ VendorPaymentsPage(data VendorPaymentsPageData) {
	@layouts.VendorShell("المدفوعات والمستحقات المالية", "vendor_payments", data.Lang, data.Dir) {
		<div class="page-container">
			<!-- Header Banner -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4 items-center">
					<div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconCreditCard("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">سجل المدفوعات والتحصيلات المالية</h1>
						</div>
						<p class="text-sm text-secondary m-0">إدارة ومتابعة كافة المقبوضات والتحصيلات المسجلة وربطها المباشر بفواتير العملاء</p>
					</div>
					<button
						type="button"
						onclick="openRecordPaymentModal()"
						class="btn btn-primary btn-sm font-bold flex-center gap-2"
					>
						@components.IconPlus("icon-xs")
						<span>تسجيل دفعة جديدة</span>
					</button>
				</div>
			</div>

			<!-- KPI Cards -->
			<div class="dashboard-stat-grid cols-4 mb-6">
				<!-- Total Count -->
				<div class="stat-card-3d">
					<div class="flex-between items-center mb-2">
						<span class="stat-card-label font-bold text-xs">إجمالي العمليات</span>
						<div class="w-8 h-8 rounded-lg bg-brand-subtle text-brand flex-center">
							@components.IconLayers("icon-xs")
						</div>
					</div>
					<div class="stat-card-value font-black tabular-nums text-xl text-primary">
						{ fmt.Sprintf("%d", data.Stats.TotalCount) }
					</div>
					<div class="stat-card-sub text-2xs text-muted font-bold mt-1">عمليات تحصيل مسجلة</div>
				</div>

				<!-- Total Amount -->
				<div class="stat-card-3d">
					<div class="flex-between items-center mb-2">
						<span class="stat-card-label font-bold text-xs">إجمالي المبالغ المحصلة</span>
						<div class="w-8 h-8 rounded-lg bg-emerald-subtle text-emerald flex-center">
							@components.IconWallet("icon-xs")
						</div>
					</div>
					<div class="stat-card-value font-black tabular-nums text-xl text-emerald">
						{ fmt.Sprintf("%s ج.م", data.Stats.TotalAmount.String()) }
					</div>
					<div class="stat-card-sub text-2xs text-muted font-bold mt-1">إجمالي ما تم تحصيله بالكامل</div>
				</div>

				<!-- Today Amount -->
				<div class="stat-card-3d">
					<div class="flex-between items-center mb-2">
						<span class="stat-card-label font-bold text-xs">تحصيلات اليوم</span>
						<div class="w-8 h-8 rounded-lg bg-blue-subtle text-blue flex-center">
							@components.IconClock("icon-xs")
						</div>
					</div>
					<div class="stat-card-value font-black tabular-nums text-xl text-primary">
						{ fmt.Sprintf("%s ج.م", data.Stats.TodayAmount.String()) }
					</div>
					<div class="stat-card-sub text-2xs text-muted font-bold mt-1">المبالغ الواردة خلال اليوم</div>
				</div>

				<!-- Month Amount -->
				<div class="stat-card-3d">
					<div class="flex-between items-center mb-2">
						<span class="stat-card-label font-bold text-xs">تحصيلات الشهر</span>
						<div class="w-8 h-8 rounded-lg bg-purple-subtle text-purple flex-center">
							@components.IconTrendingUp("icon-xs")
						</div>
					</div>
					<div class="stat-card-value font-black tabular-nums text-xl text-primary">
						{ fmt.Sprintf("%s ج.م", data.Stats.MonthAmount.String()) }
					</div>
					<div class="stat-card-sub text-2xs text-muted font-bold mt-1">تحصيلات الشهر الحالي حتى الآن</div>
				</div>
			</div>

			<!-- Filter Bar -->
			<div class="glass-panel p-4 mb-6">
				<form method="GET" action="/vendor/payments" class="filter-form d-flex items-center gap-3 flex-wrap m-0">
					<div class="flex-1 min-w-48">
						<input
							type="text"
							name="q"
							value={ data.Search }
							placeholder="بحث برقم المعاملة، رقم الفاتورة، أو اسم الصيدلية..."
							class="form-input w-full text-xs font-bold"
						/>
					</div>

					<div class="w-44">
						<select name="method" class="form-select w-full text-xs font-bold">
							<option value="">كافة طرق الدفع</option>
							<option value="bank_transfer" selected?={ data.Method == "bank_transfer" }>تحويل بنكي</option>
							<option value="cash" selected?={ data.Method == "cash" }>نقدي</option>
							<option value="cheque" selected?={ data.Method == "cheque" }>شيك مصرفي</option>
							<option value="electronic_wallet" selected?={ data.Method == "electronic_wallet" }>محفظة إلكترونية</option>
						</select>
					</div>

					<div class="w-40">
						<select name="status" class="form-select w-full text-xs font-bold">
							<option value="">كافة الحالات</option>
							<option value="paid" selected?={ data.Status == "paid" || data.Status == "completed" }>مدفوعة / معتمدة</option>
							<option value="pending" selected?={ data.Status == "pending" }>قيد المعالجة</option>
							<option value="failed" selected?={ data.Status == "failed" }>ملغاة</option>
						</select>
					</div>

					<div class="d-flex items-center gap-2">
						<label class="text-xs text-muted font-bold whitespace-nowrap" for="pay-from">من</label>
						<input
							type="date"
							id="pay-from"
							name="from"
							value={ data.DateFrom }
							class="form-input text-xs font-bold"
						/>
					</div>

					<div class="d-flex items-center gap-2">
						<label class="text-xs text-muted font-bold whitespace-nowrap" for="pay-to">إلى</label>
						<input
							type="date"
							id="pay-to"
							name="to"
							value={ data.DateTo }
							class="form-input text-xs font-bold"
						/>
					</div>

					<div class="d-flex items-center gap-2">
						<button type="submit" class="btn btn-secondary btn-sm font-bold">
							تطبيق الفلترة
						</button>
						if data.Search != "" || data.Method != "" || data.Status != "" || data.DateFrom != "" || data.DateTo != "" {
							<a href="/vendor/payments" class="btn btn-ghost btn-sm font-bold text-muted">
								إعادة تعيين
							</a>
						}
					</div>
				</form>
			</div>

			<!-- Payments Table -->
			if len(data.Payments) == 0 {
				<div class="glass-panel p-10 text-center empty-state-glass">
					<div class="text-4xl mb-3">@components.IconCreditCard("icon-sm text-muted")</div>
					<h3 class="text-lg font-black text-primary mb-2">لا توجد دفعات مطابقة</h3>
					<p class="text-sm text-secondary mb-4">لم يتم العثور على أي حركات سداد مسجلة بهذه المعايير.</p>
					<button
						type="button"
						onclick="openRecordPaymentModal()"
						class="btn btn-primary btn-sm font-bold"
					>
						تسجيل دفعة جديدة الآن
					</button>
				</div>
			} else {
				<div class="glass-panel p-0 mb-6 overflow-hidden">
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>رقم المعاملة / المرجع</th>
									<th>الفاتورة المرتبطة</th>
									<th>العميل / الصيدلية</th>
									<th>المبلغ</th>
									<th>طريقة الدفع</th>
									<th>الحالة</th>
									<th>تاريخ التحصيل</th>
									<th class="text-center">إجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, p := range data.Payments {
									<tr class="cursor-pointer" onclick={ templ.ComponentScript{Call: fmt.Sprintf("handlePaymentRowClick('%s')", p.InvoiceNumber)} }>
										<!-- Col 1: Transaction / Ref -->
										<td class="tabular-nums font-bold">
											<div class="d-flex flex-col">
												if p.ReferenceNumber != "" {
													<strong class="text-primary text-xs">{ p.ReferenceNumber }</strong>
												} else if p.TransactionID != "" {
													<strong class="text-primary text-xs">{ p.TransactionID }</strong>
												} else {
													<strong class="text-primary text-xs">{ fmt.Sprintf("PAY-%d", p.ID) }</strong>
												}
												if p.Notes != "" {
													<span class="text-3xs text-muted truncate max-w-xs">{ p.Notes }</span>
												}
											</div>
										</td>

										<!-- Col 2: Related Invoice -->
										<td>
											if p.InvoiceNumber != "" {
												<a
													href={ templ.SafeURL(fmt.Sprintf("/vendor/invoices?q=%s", p.InvoiceNumber)) }
													class="badge badge-brand text-xs font-black d-inline-flex items-center gap-1 hover:underline"
													onclick="event.stopPropagation()"
													title="انقر لفتح الفاتورة المرتبطة"
												>
													@components.IconFileText("icon-3xs")
													<span>{ p.InvoiceNumber }</span>
												</a>
											} else {
												<span class="text-muted text-xs">—</span>
											}
										</td>

										<!-- Col 3: Customer -->
										<td>
											<span class="text-xs font-bold text-primary">{ p.CustomerName }</span>
										</td>

										<!-- Col 4: Amount -->
										<td class="tabular-nums font-black text-emerald text-sm">
											{ fmt.Sprintf("%s ج.م", p.Amount.String()) }
										</td>

										<!-- Col 5: Method -->
										<td>
											<span class="badge badge-slate text-xs font-bold">
												{ vendorPaymentMethodLabel(p.Method) }
											</span>
										</td>

										<!-- Col 6: Status -->
										<td>
											{{ label, badgeClass := vendorPaymentStatusBadge(p.Status) }}
											<span class={ "badge", badgeClass, "text-2xs font-black" }>
												{ label }
											</span>
										</td>

										<!-- Col 7: Date -->
										<td class="tabular-nums text-xs text-secondary font-medium">
											if p.PaidAt != nil {
												{ p.PaidAt.Format("2006-01-02 03:04 PM") }
											} else {
												{ p.CreatedAt.Format("2006-01-02 03:04 PM") }
											}
										</td>

										<!-- Col 8: Action -->
										<td class="text-center" onclick="event.stopPropagation()">
											if p.InvoiceNumber != "" {
												<a
													href={ templ.SafeURL(fmt.Sprintf("/vendor/invoices?q=%s", p.InvoiceNumber)) }
													class="btn btn-secondary btn-icon btn-xs text-brand"
													title="فتح الفاتورة"
												>
													@components.IconExternalLink("icon-2xs")
												</a>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					if data.TotalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.TotalCount,
							BaseURL:     "/vendor/payments",
							QueryValues: vendorPaymentsQueryValues(data),
						})
					}
				</div>
			}
		</div>

		<!-- Modal for Recording Invoice Payment -->
		<div id="record-payment-modal" class="d-none fixed inset-0 z-50 items-center justify-center p-4 bg-black/60 backdrop-blur-xs" onclick="closeRecordPaymentModal()">
			<div class="glass-panel w-full max-w-lg p-6 rounded-2xl shadow-2xl border border-border" onclick="event.stopPropagation()">
				<div class="flex-between items-center mb-4 pb-3 border-b border-border">
					<div class="d-flex items-center gap-2">
						<div class="w-8 h-8 rounded-lg bg-brand-subtle text-brand flex-center font-bold">
							@components.IconCreditCard("icon-xs")
						</div>
						<h3 class="text-base font-black text-primary m-0">تسجيل دفعة جديدة على فاتورة</h3>
					</div>
					<button type="button" onclick="closeRecordPaymentModal()" class="btn btn-secondary btn-icon btn-xs text-muted" title="إغلاق">
						@components.IconClose("icon-xs")
					</button>
				</div>

				<form method="POST" action="/vendor/payments/record" class="d-flex flex-col gap-4 m-0">
					<!-- Invoice Selection -->
					<div>
						<label for="modal-payment-invoice" class="form-label text-xs font-bold mb-1.5 d-block">
							اختيار الفاتورة المستحقة: <span class="text-danger">*</span>
						</label>
						if len(data.Invoices) == 0 {
							<select id="modal-payment-invoice" name="invoice_id" class="form-select w-full text-xs font-bold" disabled>
								<option value="">لا توجد فواتير مفتوحة بحاجة لسداد حالياً</option>
							</select>
							<p class="text-3xs text-muted mt-1">كافة الفواتير الحالية مسددة بالكامل أو ملغاة.</p>
						} else {
							<select id="modal-payment-invoice" name="invoice_id" class="form-select w-full text-xs font-bold" required onchange="updateSuggestedAmount(this)">
								<option value="">-- اختر الفاتورة المطلوب تحصيلها --</option>
								for _, inv := range data.Invoices {
									<option
										value={ fmt.Sprintf("%d", inv.ID) }
										data-remaining={ inv.RemainingAmount.String() }
									>
										{ fmt.Sprintf("%s — %s (المتبقي: %s ج.م من %s ج.م)", inv.InvoiceNumber, inv.CustomerName, inv.RemainingAmount.String(), inv.TotalAmount.String()) }
									</option>
								}
							</select>
						}
					</div>

					<!-- Payment Amount -->
					<div>
						<label for="modal-payment-amount" class="form-label text-xs font-bold mb-1.5 d-block">
							مبلغ الدفعة (ج.م): <span class="text-danger">*</span>
						</label>
						<input
							type="number"
							id="modal-payment-amount"
							name="amount"
							step="0.01"
							min="0.01"
							class="form-input w-full text-sm font-black tabular-nums"
							placeholder="0.00"
							required
						/>
						<span class="text-3xs text-muted mt-1 d-block">يمكنك تسجيل دفعة كاملة أو دفعة جزئية وسيتم تحديث رصيد الفاتورة آلياً.</span>
					</div>

					<!-- Method & Reference in Grid -->
					<div class="grid grid-cols-2 gap-3">
						<div>
							<label for="modal-payment-method" class="form-label text-xs font-bold mb-1.5 d-block">طريقة التحصيل:</label>
							<select id="modal-payment-method" name="method" class="form-select w-full text-xs font-bold">
								<option value="bank_transfer">تحويل بنكي</option>
								<option value="cash">نقدي</option>
								<option value="cheque">شيك مصرفي</option>
								<option value="electronic_wallet">محفظة إلكترونية</option>
							</select>
						</div>

						<div>
							<label for="modal-payment-ref" class="form-label text-xs font-bold mb-1.5 d-block">رقم الإيصال / المرجع:</label>
							<input
								type="text"
								id="modal-payment-ref"
								name="reference_number"
								class="form-input w-full text-xs font-bold"
								placeholder="مثال: TRX-99824"
							/>
						</div>
					</div>

					<!-- Notes -->
					<div>
						<label for="modal-payment-notes" class="form-label text-xs font-bold mb-1.5 d-block">ملاحظات التحصيل:</label>
						<textarea
							id="modal-payment-notes"
							name="notes"
							rows="2"
							class="form-input w-full text-xs font-medium"
							placeholder="أي تفاصيل أو ملاحظات إضافية حول الدفعة..."
						></textarea>
					</div>

					<!-- Submit Buttons -->
					<div class="flex-end gap-2 pt-3 border-t border-border">
						<button type="button" onclick="closeRecordPaymentModal()" class="btn btn-secondary btn-sm font-bold">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary btn-sm font-black" disabled?={ len(data.Invoices) == 0 }>
							تأكيد وتسجيل الدفعة
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Script for Modal and Row Navigation -->
		<script>
			function openRecordPaymentModal() {
				const modal = document.getElementById('record-payment-modal');
				if (modal) {
					modal.classList.remove('d-none');
					modal.classList.add('d-flex');
				}
			}

			function closeRecordPaymentModal() {
				const modal = document.getElementById('record-payment-modal');
				if (modal) {
					modal.classList.add('d-none');
					modal.classList.remove('d-flex');
				}
			}

			function updateSuggestedAmount(selectEl) {
				const selectedOption = selectEl.options[selectEl.selectedIndex];
				if (selectedOption) {
					const remaining = selectedOption.getAttribute('data-remaining');
					const amountInput = document.getElementById('modal-payment-amount');
					if (amountInput && remaining) {
						amountInput.value = remaining;
					}
				}
			}

			function handlePaymentRowClick(invoiceNumber) {
				if (invoiceNumber && invoiceNumber.trim() !== "") {
					window.location.href = `/vendor/invoices?q=${encodeURIComponent(invoiceNumber)}`;
				}
			}

			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					closeRecordPaymentModal();
				}
			});
		</script>
	}
}

// VendorEarningsOrderPage renders unified financial and net profit report for the vendor.
templ VendorEarningsOrderPage(summary *commerce.VendorFinancialSummary, lang, dir string) {
	@layouts.VendorShell("الأرباح والبيانات المالية", "earnings_order", lang, dir) {
		<div class="page-container">
			
			<!-- Header & Period Filter Toolbar -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4 items-center">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconWallet("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">
								التقرير المالي وصافي الأرباح المحققة
							</h1>
						</div>
						<p class="text-sm text-secondary m-0">
							تحليل دقيق للمبيعات، الخصومات الممنوحة، تكلفة البضاعة المباعة (COGS)، وصافي الأرباح الفعلية للطلبيات المستلمة
						</p>
					</div>

					<!-- Period Filter Tabs -->
					<div class="d-flex items-center gap-1 p-1 bg-surface-sunken rounded-xl border">
						<a
							href="/vendor/earnings/order?period=month"
							class={ "btn btn-sm font-bold text-xs rounded-lg text-decoration-none", templ.KV("btn-primary", summary.Period == "month" || summary.Period == ""), templ.KV("btn-secondary", summary.Period != "month" && summary.Period != "") }
						>
							هذا الشهر
						</a>
						<a
							href="/vendor/earnings/order?period=last_month"
							class={ "btn btn-sm font-bold text-xs rounded-lg text-decoration-none", templ.KV("btn-primary", summary.Period == "last_month"), templ.KV("btn-secondary", summary.Period != "last_month") }
						>
							الشهر الماضي
						</a>
						<a
							href="/vendor/earnings/order?period=year"
							class={ "btn btn-sm font-bold text-xs rounded-lg text-decoration-none", templ.KV("btn-primary", summary.Period == "year"), templ.KV("btn-secondary", summary.Period != "year") }
						>
							العام الحالي
						</a>
						<a
							href="/vendor/earnings/order?period=all"
							class={ "btn btn-sm font-bold text-xs rounded-lg text-decoration-none", templ.KV("btn-primary", summary.Period == "all"), templ.KV("btn-secondary", summary.Period != "all") }
						>
							كافة الفترات
						</a>
					</div>
				</div>
			</div>

			<!-- Financial Accounting Logic Banner -->
			<div class="alert alert-info mb-6 p-4">
				<div class="d-flex items-start gap-3">
					<div class="text-sky flex-shrink-0 mt-0.5">
						@components.IconInfo("icon-sm")
					</div>
     <div class="stack-sm">
						<div class="font-extrabold text-sm text-primary">
							معادلة احتساب الأرباح والمصروفات المعتمدة:
						</div>
						<div class="text-xs text-secondary mt-1 lh-relaxed">
							<strong>صافي الربح الفعلي = (سعر الجمهور - خصم الجمهور للصيدلية) - (سعر التكلفة - خصم التكلفة)</strong>. 
							يتم احتساب الأرباح وتسجيل تكلفة البضاعة المباعة تلقائياً فور تحول الشحنة إلى حالة <strong>مستلم (Delivered)</strong>. 
							الأصناف التي لا يتوفر لها سعر تكلفة يتم احتساب أرباحها بالكامل من صافي سعر البيع.
						</div>
					</div>
				</div>
			</div>

			<!-- 6 Key Financial KPI Cards -->
			<div class="dashboard-stat-grid cols-6 mb-6">
				
				<!-- 1. Gross Sales -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-primary font-bold flex-between">
						<span>إجمالي المبيعات (الجمهور)</span>
						<span class="badge badge-slate text-xs">Gross</span>
					</div>
					<div class="stat-card-value text-primary tabular-nums mt-2">
						{ summary.GrossSales.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
					</div>
					<div class="text-xs text-muted mt-1">سعر الجمهور الإجمالي قبل الخصم</div>
				</div>

				<!-- 2. Total Discounts -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-warning font-bold flex-between">
						<span>الخصومات الممنوحة</span>
						<span class="badge badge-amber text-xs">خصومات</span>
					</div>
					<div class="stat-card-value text-warning tabular-nums mt-2">
						-{ summary.TotalDiscounts.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
					</div>
					<div class="text-xs text-muted mt-1">إجمالي خصومات الصيدليات المطبقة</div>
				</div>

				<!-- 3. Net Revenue -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-brand font-bold flex-between">
						<span>صافي المبيعات المحققة</span>
						<span class="badge badge-emerald text-xs">إيرادات</span>
					</div>
					<div class="stat-card-value text-brand tabular-nums mt-2">
						{ summary.NetSales.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
					</div>
					<div class="text-xs text-muted mt-1">قيمة المبيعات الفعلية بعد الخصم</div>
				</div>

				<!-- 4. Cost of Goods Sold (COGS) -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-danger font-bold flex-between">
						<span>تكلفة البضاعة المباعة (COGS)</span>
						<span class="badge badge-rose text-xs">مصروفات</span>
					</div>
					<div class="stat-card-value text-danger tabular-nums mt-2">
						-{ summary.COGS.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
					</div>
					<div class="text-xs text-muted mt-1">سعر التكلفة بعد تطبيق خصم التكلفة</div>
				</div>

				<!-- 5. Realized Net Profit -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-success font-extrabold flex-between">
						<span>صافي الأرباح المحققة</span>
						if summary.ProfitMargin > 0 {
							<span class="badge badge-emerald text-xs font-black tabular-nums">
								هامش { fmt.Sprintf("%.1f%%", summary.ProfitMargin) }
							</span>
						}
					</div>
					<div class="stat-card-value text-success font-black tabular-nums mt-2">
						+{ summary.NetProfit.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
					</div>
					<div class="text-xs text-success font-bold mt-1">صافي الربح الفعلي بعد استبعاد التكاليف</div>
				</div>

				<!-- 6. Wallet Balance -->
				<div class="stat-card-3d">
					<div class="stat-card-label text-sky font-bold flex-between">
						<span>رصيد المحفظة المتاح</span>
						<span class="badge badge-sky text-xs">سيولة</span>
					</div>
					<div class="stat-card-value text-sky tabular-nums mt-2">
						{ summary.WalletBalance.String() } <span class="text-xs font-bold text-secondary">ج.م</span>
					</div>
					<div class="text-xs text-muted mt-1">الرصيد الجاهز للتسوية والتحويل</div>
				</div>

			</div>

			<!-- Tabs for Breakdown Views -->
			<div class="stack-lg">
				
				<!-- Section 1: Delivered Orders Financial Breakdown -->
				<div class="glass-panel p-0 overflow-hidden mb-6">
					<div class="p-5 border-b flex-between flex-wrap gap-3 items-center">
						<div class="d-flex items-center gap-2">
							<span class="text-brand">@components.IconPackage("icon-xs")</span>
							<h3 class="text-lg font-black text-primary m-0">
								تفاصيل أرباح الطلبيات المسلّمة ({ fmt.Sprintf("%d", len(summary.Shipments)) } شحنة)
							</h3>
						</div>
						<span class="badge badge-emerald text-xs font-bold">
							طلبيات معتمدة ومستلمة
						</span>
					</div>

					if len(summary.Shipments) == 0 {
						<div class="p-8 text-center text-muted">
							<div class="text-3xl mb-2">@components.IconInbox("icon-md")</div>
							<div class="font-bold text-sm text-primary">لا توجد طلبيات مسلمة خلال هذه الفترة المحددة</div>
							<div class="text-xs text-secondary mt-1">تظهر الأرباح والتكاليف هنا فور تسليم الشحنات وتوثيق الاستلام من الصيدليات.</div>
						</div>
					} else {
						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th>رقم الشحنة / الطلب</th>
										<th>تاريخ التسليم</th>
										<th>العميل المستلم</th>
										<th class="text-center">الأصناف</th>
										<th class="tabular-nums">إجمالي المبيعات</th>
										<th class="tabular-nums">الخصومات</th>
										<th class="tabular-nums">صافي القيمة</th>
										<th class="tabular-nums">تكلفة البضاعة (COGS)</th>
										<th class="tabular-nums">صافي الربح</th>
										<th class="text-center">هامش الربح</th>
										<th class="text-center">حالة السداد</th>
									</tr>
								</thead>
								<tbody>
									for _, s := range summary.Shipments {
										<tr>
											<td>
												<div class="font-extrabold text-primary text-sm tabular-nums">
													{ s.ShipmentNumber }
												</div>
												<div class="text-xs text-muted tabular-nums">
													طلب: { s.OrderNumber }
												</div>
											</td>
											<td class="tabular-nums text-xs font-semibold text-secondary">
												{ s.DeliveredAt.Format("2006-01-02 03:04 PM") }
											</td>
											<td>
												<span class="font-bold text-sm text-primary">{ s.CustomerOrgName }</span>
											</td>
											<td class="text-center">
												<span class="badge badge-slate text-xs tabular-nums font-bold">
													{ fmt.Sprintf("%d صنف", s.LineItemsCount) }
												</span>
											</td>
											<td class="tabular-nums font-bold text-primary text-sm">
												{ s.GrossSales.String() } ج.م
											</td>
											<td class="tabular-nums text-warning font-bold text-xs">
												if s.Discounts.IsPositive() {
													-{ s.Discounts.String() } ج.م
												} else {
													<span>-</span>
												}
											</td>
											<td class="tabular-nums font-extrabold text-brand text-sm">
												{ s.NetSales.String() } ج.م
											</td>
											<td class="tabular-nums font-bold text-danger text-sm">
												if s.COGS.IsPositive() {
													-{ s.COGS.String() } ج.م
												} else {
													<span class="text-muted text-xs">لا توجد</span>
												}
											</td>
											<td class="tabular-nums font-black text-success text-sm">
												+{ s.NetProfit.String() } ج.م
											</td>
											<td class="text-center">
												if s.ProfitMargin > 0 {
													<span class="badge badge-emerald text-xs font-black tabular-nums">
														{ fmt.Sprintf("%.1f%%", s.ProfitMargin) }
													</span>
												} else {
													<span class="badge badge-slate text-xs">100%</span>
												}
											</td>
											<td class="text-center">
												if s.PaymentStatus == "paid" {
													<span class="badge badge-emerald text-xs font-bold">مسدد بالكامل</span>
												} else {
													<span class="badge badge-amber text-xs font-bold">بانتظار التسوية</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Section 2: Product Margin & Profitability Table -->
				if len(summary.TopProducts) > 0 {
					<div class="glass-panel p-0 overflow-hidden mb-6">
						<div class="p-5 border-b flex-between flex-wrap gap-3 items-center">
							<div class="d-flex items-center gap-2">
								<span class="text-brand">@components.IconPill("icon-xs")</span>
								<h3 class="text-lg font-black text-primary m-0">
									تحليل ربحية وهوامش الأصناف المباعة ({ fmt.Sprintf("%d", len(summary.TopProducts)) } صنف)
								</h3>
							</div>
							<span class="badge badge-sky text-xs font-bold">
								مقارنة الأسعار والتكلفة
							</span>
						</div>

						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th>اسم الصنف والرمز</th>
										<th class="text-center">الكمية المباعة</th>
										<th class="tabular-nums">سعر البيع</th>
										<th class="tabular-nums">سعر التكلفة وخصم التكلفة</th>
										<th class="tabular-nums">التكلفة الفعلية</th>
										<th class="tabular-nums">إجمالي الإيرادات</th>
										<th class="tabular-nums">إجمالي التكلفة</th>
										<th class="tabular-nums">صافي الربح المحقق</th>
										<th class="text-center">هامش الربح</th>
									</tr>
								</thead>
								<tbody>
									for _, p := range summary.TopProducts {
										<tr>
											<td>
												<div class="font-extrabold text-primary text-sm">
													{ p.Name }
												</div>
												if p.SKU != "" {
													<div class="text-xs text-muted tabular-nums">
														<code>{ p.SKU }</code>
													</div>
												}
											</td>
											<td class="text-center tabular-nums font-bold">
												<span class="badge badge-secondary text-xs">{ fmt.Sprintf("%d عبوة", p.QuantitySold) }</span>
											</td>
											<td class="tabular-nums font-bold text-primary text-sm">
												{ p.SellingPrice.String() } ج.م
											</td>
											<td>
												if p.CostPrice != nil && p.CostPrice.IsPositive() {
													<div class="tabular-nums font-semibold text-xs text-secondary">
														الأصل: { p.CostPrice.String() } ج.م
													</div>
													if p.CostDiscountPercentage > 0 {
														<div class="text-xs text-sky font-bold">
															خصم التكلفة: { fmt.Sprintf("%.1f%%", p.CostDiscountPercentage) }
														</div>
													}
												} else {
													<span class="badge badge-slate text-xs">غير محدد</span>
												}
											</td>
											<td class="tabular-nums font-bold text-secondary text-sm">
												if p.DiscountedCost.IsPositive() {
													{ p.DiscountedCost.String() } ج.م
												} else {
													<span class="text-muted text-xs">-</span>
												}
											</td>
											<td class="tabular-nums font-extrabold text-brand text-sm">
												{ p.TotalRevenue.String() } ج.م
											</td>
											<td class="tabular-nums font-bold text-danger text-sm">
												if p.TotalCost.IsPositive() {
													-{ p.TotalCost.String() } ج.م
												} else {
													<span class="text-muted text-xs">0.00 ج.م</span>
												}
											</td>
											<td class="tabular-nums font-black text-success text-sm">
												+{ p.NetProfit.String() } ج.م
											</td>
											<td class="text-center">
												if p.ProfitMargin > 0 {
													<span class="badge badge-emerald text-xs font-black tabular-nums">
														{ fmt.Sprintf("%.1f%%", p.ProfitMargin) }
													</span>
												} else {
													<span class="badge badge-slate text-xs">100%</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				}

			</div>

		</div>
	}
}

// VendorEarningsOffersPage renders offers revenue report.
templ VendorEarningsOffersPage(revenue money.Amount, lang, dir string) {
	@layouts.VendorShell("أرباح ومبيعات عروض التوفير", "earnings_offers", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="d-flex items-center gap-3 mb-1">
					<div class="user-avatar-badge text-xl">
						@components.IconTag("icon-sm")
					</div>
					<h1 class="text-2xl font-black text-primary m-0">أرباح ومبيعات عروض التوفير والصفقات</h1>
				</div>
				<p class="text-sm text-secondary m-0">ملخص إيرادات العروض الخاصة والخصومات الكمية</p>
			</div>

			<div class="dashboard-stat-grid mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label text-success">إجمالي مبيعات العروض</div>
					<div class="stat-card-value text-success tabular-nums">{ fmt.Sprintf("%s ج.م", revenue.String()) }</div>
					<span class="text-xs text-secondary mt-1 d-block">مبيعات صفقات وعروض التوفير</span>
				</div>
			</div>
		</div>
	}
}

// VendorOfferOrdersPage renders vendor offer orders list.
templ VendorOfferOrdersPage(shipments []*commerce.OrderShipment, lang, dir string, page, perPage, totalCount int) {
	@layouts.VendorShell("طلبات عروض الأسعار والتوريد", "offer_orders", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between flex-wrap gap-4">
     <div class="stack-sm">
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								@components.IconPackage("icon-sm")
							</div>
							<h1 class="text-2xl font-black text-primary m-0">طلبات عروض الأسعار الواردة ({ fmt.Sprintf("%d", totalCount) })</h1>
						</div>
						<p class="text-sm text-secondary m-0">متابعة الشحنات والطلبيات المرتبطة بعروض أسعار خاصة أو خصومات إضافية</p>
					</div>
				</div>
			</div>

			if len(shipments) == 0 {
				<div class="glass-panel p-8 text-center empty-state-glass">
					<div class="text-4xl mb-3">@components.IconPackage("icon-sm")</div>
					<h3 class="text-lg font-black text-primary mb-2">لا توجد طلبات عروض واردة</h3>
					<p class="text-sm text-secondary m-0">ستظهر هنا الشحنات الخاصة بالطلبيات المقدمة من الصيدليات.</p>
				</div>
			} else {
				<div class="glass-panel p-0 mb-6 overflow-hidden">
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>رقم الشحنة</th>
									<th>المبلغ</th>
									<th class="text-center">الحالة</th>
									<th>التاريخ</th>
									<th class="col-actions">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range shipments {
									<tr>
										<td class="tabular-nums font-bold text-primary">#{ s.ShipmentNumber }</td>
										<td class="tabular-nums font-extrabold text-success">{ fmt.Sprintf("%s ج.م", s.TotalAmount.String()) }</td>
										<td class="text-center"><span class="badge badge-sky text-xs font-bold">{ string(s.Status) }</span></td>
										<td class="tabular-nums text-xs text-muted">{ s.CreatedAt.Format("2006-01-02") }</td>
										<td class="col-actions">
											<a href={ templ.SafeURL(fmt.Sprintf("/vendor/orders/offers/%d", s.ID)) } class="btn btn-secondary btn-sm font-bold text-xs">عرض الشحنة</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if totalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: page,
							PageSize:    perPage,
							TotalCount:  totalCount,
							BaseURL:     "/vendor/orders/offers",
						})
					}
				</div>
			}
		</div>
	}
}

// VendorOfferOrderDetailPage renders single offer order details.
templ VendorOfferOrderDetailPage(id int64, lang, dir string) {
	@layouts.VendorShell(fmt.Sprintf("طلب عروض #%d", id), "offer_orders", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 max-w-2xl mx-auto">
				<div class="flex-between items-center mb-4 pb-2 border-b">
     <div class="stack-sm">
						<h1 class="text-xl font-black text-primary m-0">طلب عروض #{ fmt.Sprintf("%d", id) }</h1>
					</div>
					<a href="/vendor/orders/offers" class="btn btn-secondary btn-sm font-bold">العودة</a>
				</div>
			</div>
		</div>
	}
}
