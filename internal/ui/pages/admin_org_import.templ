package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminOrgImportPageData struct {
	Organizations   []*org.Organization
	TotalOrgs       int
	TotalPharmacies int
	TotalVendors    int
	ActiveTab       string // "pharmacy" or "vendor"
	SearchQuery     string
	StatusFilter    string
	Page            int
	PerPage         int
	TotalCount      int
	NoticeType      string
	NoticeMsg       string
}

templ AdminOrgImportPage(data AdminOrgImportPageData, lang, dir string) {
	@layouts.AdminShell("استيراد المنتجات لمنظمات", "org_imports", lang, dir) {
		<div
			class="admin-page-container"
			x-data="{
				savingModal: false,
				warehouseModal: false,
				selectedOrg: { id: 0, name: '', type: '' },
				openSaving(id, name, type) {
					this.selectedOrg = { id: id, name: name, type: type };
					this.savingModal = true;
				},
				openWarehouse(id, name, type) {
					this.selectedOrg = { id: id, name: name, type: type };
					this.warehouseModal = true;
				}
			}"
		>
			<!-- Header Banner -->
			<div class="admin-banner">
				<div class="admin-banner-inner">
					<div class="d-flex items-center gap-3">
						<div class="admin-banner-icon purple">
							@components.IconUpload("icon-sm")
						</div>
						<div class="stack-sm">
							<h1 class="admin-banner-title">
								<span>استيراد المنتجات لمنظمات</span>
								<span class="badge badge-purple text-xs font-black tabular-nums">{ fmt.Sprintf("%d منشأة", data.TotalCount) }</span>
							</h1>
							<p class="admin-banner-subtitle">
								أداة الإدارة المركزية لرفع منتجات التوفير والمستودعات المؤقتة نيابة عن الصيدليات والموردين مع المطابقة التفاعلية
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Notice Alerts -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger mb-4 d-flex items-center gap-3 p-4 rounded-xl border border-rose-200 bg-rose-50/70 shadow-xs">
						@components.IconAlert("icon-sm text-rose-600 flex-shrink-0")
						<span class="font-bold text-xs text-rose-800">{ data.NoticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success mb-4 d-flex items-center gap-3 p-4 rounded-xl border border-emerald-200 bg-emerald-50/70 shadow-xs">
						@components.IconCheckCircle("icon-sm text-emerald-600 flex-shrink-0")
						<span class="font-bold text-xs text-emerald-800">{ data.NoticeMsg }</span>
					</div>
				}
			}

			<!-- Type Selection Tabs -->
			<div class="tabs-nav mb-6">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/import?tab=pharmacy&q=%s", data.SearchQuery)) }
					class={ "tab-btn", templ.KV("active", data.ActiveTab == "pharmacy" || data.ActiveTab == "") }
				>
					@components.IconBuilding("icon-xs")
					<span>الصيدليات (العملاء)</span>
					<span class="badge badge-neutral text-2xs tabular-nums ms-1">{ fmt.Sprintf("%d", data.TotalPharmacies) }</span>
				</a>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/import?tab=vendor&q=%s", data.SearchQuery)) }
					class={ "tab-btn", templ.KV("active", data.ActiveTab == "vendor") }
				>
					@components.IconTruck("icon-xs")
					<span>الموردون والشركات</span>
					<span class="badge badge-neutral text-2xs tabular-nums ms-1">{ fmt.Sprintf("%d", data.TotalVendors) }</span>
				</a>
			</div>

			<!-- Search & Filter Bar -->
			<div class="glass-panel p-4 mb-6">
				<form method="GET" action="/admin/organizations/import" class="d-flex flex-wrap gap-3 items-center justify-between">
					<input type="hidden" name="tab" value={ data.ActiveTab }/>
					<div class="d-flex flex-wrap gap-3 items-center flex-grow">
						<div class="relative flex-grow max-w-md">
							<input
								type="text"
								name="q"
								value={ data.SearchQuery }
								placeholder="ابحث باسم المنشأة، السجل التجاري، الرقم الضريبي..."
								class="input-control w-full pr-9 text-sm"
							/>
							<span class="absolute top-2.5 right-3 text-secondary pointer-events-none">
								@components.IconSearch("icon-xs")
							</span>
						</div>

						<button type="submit" class="btn btn-primary btn-sm font-bold text-xs gap-1">
							@components.IconFilter("icon-xs")
							<span>تصفية</span>
						</button>

						if data.SearchQuery != "" {
							<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/import?tab=%s", data.ActiveTab)) } class="btn btn-secondary btn-sm text-xs">
								إعادة تعيين
							</a>
						}
					</div>
				</form>
			</div>

			<!-- Organizations Table -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(data.Organizations) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconBuilding("icon-sm")</div>
						<h3 class="font-bold text-base mb-1">لا توجد منشآت مطابقة</h3>
						<p class="text-xs text-secondary mb-0">لم يتم العثور على أية منشآت تطابق نوع الحساب والبحث المحدد</p>
					</div>
				} else {
					<div class="table-container">
						<table class="table-modern">
							<thead>
								<tr>
									<th>المنشأة والمؤسسة</th>
									<th>نوع الحساب</th>
									<th>السجل والترخيص</th>
									<th>حالة الاعتماد</th>
									<th class="col-actions">عمليات الاستيراد لمنظمة</th>
								</tr>
							</thead>
							<tbody>
								for _, orgItem := range data.Organizations {
									<tr>
										<td>
											<div class="d-flex items-center gap-3">
												<div class="avatar-sm bg-purple-50 text-purple-700 font-black rounded-xl p-2.5 text-xs border border-purple-100 shadow-2xs">
													if orgItem.Type == org.TypeVendor {
														@components.IconTruck("icon-xs")
													} else {
														@components.IconBuilding("icon-xs")
													}
												</div>
												<div class="stack-xs">
													<div class="font-black text-sm text-primary">
														{ orgDisplayName(orgItem, lang) }
													</div>
													if orgItem.LegalName != "" && orgItem.LegalName != orgDisplayName(orgItem, lang) {
														<div class="text-2xs text-secondary font-medium">
															الاسم القانوني: { orgItem.LegalName }
														</div>
													}
												</div>
											</div>
										</td>
										<td>
											if orgItem.Type == org.TypeVendor {
												<span class="badge badge-purple text-xs font-bold">مورد معتمد</span>
											} else {
												<span class="badge badge-emerald text-xs font-bold">صيدلية مرخصة</span>
											}
										</td>
										<td class="tabular-nums text-xs">
											if orgItem.CommercialRegister != "" {
												<div class="font-mono text-primary font-bold">{ orgItem.CommercialRegister }</div>
											} else {
												<span class="text-muted">—</span>
											}
											if orgItem.TaxNumber != "" {
												<div class="text-secondary text-2xs mt-0.5">ضريبي: { orgItem.TaxNumber }</div>
											}
										</td>
										<td>
											switch orgItem.Status {
												case org.StatusApproved:
													<span class="badge badge-emerald text-xs font-bold">نشط ومعتمد</span>
												case org.StatusPending:
													<span class="badge badge-amber text-xs font-bold">قيد الاعتماد</span>
												case org.StatusSuspended:
													<span class="badge badge-rose text-xs font-bold">موقوف مؤقتاً</span>
												default:
													<span class="badge badge-neutral text-xs font-bold">{ string(orgItem.Status) }</span>
											}
										</td>
										<td class="col-actions">
											<div class="table-actions">
												<!-- Operation 1: Upload Savings Products -->
												<button
													type="button"
													class="btn btn-primary btn-sm font-bold text-xs gap-1.5 shadow-2xs"
													@click={ fmt.Sprintf("openSaving(%d, %q, %q)", orgItem.ID, orgDisplayName(orgItem, lang), string(orgItem.Type)) }
												>
													@components.IconUpload("icon-xs")
													<span>رفع منتجات التوفير</span>
												</button>

												<!-- Operation 2: Upload Temporary Warehouse -->
												<button
													type="button"
													class="btn btn-secondary btn-sm font-bold text-xs gap-1.5 shadow-2xs"
													@click={ fmt.Sprintf("openWarehouse(%d, %q, %q)", orgItem.ID, orgDisplayName(orgItem, lang), string(orgItem.Type)) }
												>
													@components.IconFolder("icon-xs")
													<span>رفع مستودع مؤقت</span>
												</button>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					if data.TotalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: data.Page,
							PageSize:    data.PerPage,
							TotalCount:  data.TotalCount,
							BaseURL:     "/admin/organizations/import",
							QueryValues: map[string][]string{
								"tab": {data.ActiveTab},
								"q":   {data.SearchQuery},
							},
						})
					}
				}
			</div>

			<!-- Modal 1: Upload Savings Products for Organization -->
			<div
				class="modal-backdrop"
				x-show="savingModal"
				x-cloak
				style="display: none;"
			>
				<div class="modal-dialog max-w-lg" @click.away="savingModal = false">
					<div class="modal-header flex-between items-center pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 d-flex items-center justify-center">
								@components.IconUpload("icon-xs")
							</div>
							<div class="stack-xs">
								<h3 class="font-black text-base text-primary m-0">رفع منتجات التوفير للمنظمة</h3>
								<div class="text-2xs text-secondary">
									المنشأة المستهدفة: <strong class="text-emerald-700 font-black" x-text="selectedOrg.name"></strong>
								</div>
							</div>
						</div>
						<button type="button" class="btn-close text-secondary hover:text-primary" @click="savingModal = false">
							✕
						</button>
					</div>

					<form method="POST" action="/admin/organizations/import/saving/upload" enctype="multipart/form-data" class="p-4 space-y-4">
						<input type="hidden" name="org_id" :value="selectedOrg.id"/>

						<div class="alert alert-info p-3 text-2xs rounded-xl border border-blue-200 bg-blue-50/60 mb-3">
							@components.IconInfo("icon-xs text-blue-600 inline me-1")
							<span>سيتم رفع ومطابقة ملف الأصناف، وربط النتائج مباشرة بحساب هذه المنشأة في الكتالوج.</span>
						</div>

						<div class="form-group mb-3">
							<label class="form-label font-bold text-xs mb-1">ملف الإكسل أو CSV (.xlsx, .xls, .csv)</label>
							<input
								type="file"
								name="file"
								accept=".xlsx,.xls,.csv"
								required
								class="input-control w-full text-xs"
							/>
						</div>

						<div class="form-group mb-3">
							<label class="form-label font-bold text-xs mb-1">طريقة المعالجة والمطابقة</label>
							<select name="match_choice" class="input-control w-full text-xs">
								<option value="fuzzy">مطابقة ذكية مع الكتالوج الدوائي العام (موصى به)</option>
								<option value="exact">مطابقة تامة بالكود ورقم الصنف فقط</option>
							</select>
						</div>

						<div class="flex-end gap-2 pt-3 border-t mt-4">
							<button type="button" class="btn btn-secondary btn-sm text-xs" @click="savingModal = false">
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary btn-sm font-bold text-xs gap-1.5 shadow-sm">
								@components.IconUpload("icon-xs")
								<span>بدء الرفع والمطابقة</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Modal 2: Upload Temporary Warehouse for Organization -->
			<div
				class="modal-backdrop"
				x-show="warehouseModal"
				x-cloak
				style="display: none;"
			>
				<div class="modal-dialog max-w-lg" @click.away="warehouseModal = false">
					<div class="modal-header flex-between items-center pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 d-flex items-center justify-center">
								@components.IconFolder("icon-xs")
							</div>
							<div class="stack-xs">
								<h3 class="font-black text-base text-primary m-0">رفع مستودع مؤقت للمنظمة</h3>
								<div class="text-2xs text-secondary">
									المنشأة المستهدفة: <strong class="text-purple-700 font-black" x-text="selectedOrg.name"></strong>
								</div>
							</div>
						</div>
						<button type="button" class="btn-close text-secondary hover:text-primary" @click="warehouseModal = false">
							✕
						</button>
					</div>

					<form method="POST" action="/admin/organizations/import/temp-warehouse/upload" enctype="multipart/form-data" class="p-4 space-y-4">
						<input type="hidden" name="org_id" :value="selectedOrg.id"/>

						<div class="alert alert-info p-3 text-2xs rounded-xl border border-purple-200 bg-purple-50/60 mb-3">
							@components.IconInfo("icon-xs text-purple-600 inline me-1")
							<span>سيتم تسجيل المستودع المؤقت وربطه بحساب المنشأة وإتاحته للمقارنة في أداة المستودعات المؤقتة.</span>
						</div>

						<div class="form-group mb-3">
							<label class="form-label font-bold text-xs mb-1">اسم المستودع / المورد في أداة المقارنة</label>
							<input
								type="text"
								name="supplier_name"
								:placeholder="selectedOrg.name"
								class="input-control w-full text-xs"
							/>
							<div class="text-2xs text-secondary mt-1">اتركه فارغاً لاستخدام اسم المنشأة تلقائياً</div>
						</div>

						<div class="form-group mb-3">
							<label class="form-label font-bold text-xs mb-1">ملف المخزون (.xlsx, .xls, .csv)</label>
							<input
								type="file"
								name="file"
								accept=".xlsx,.xls,.csv"
								required
								class="input-control w-full text-xs"
							/>
						</div>

						<div class="flex-end gap-2 pt-3 border-t mt-4">
							<button type="button" class="btn btn-secondary btn-sm text-xs" @click="warehouseModal = false">
								إلغاء
							</button>
							<button type="submit" class="btn btn-primary btn-sm font-bold text-xs gap-1.5 shadow-sm">
								@components.IconFolder("icon-xs")
								<span>رفع وإنشاء المستودع</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	}
}