package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)



// AdminSessionPlansPage renders session plan management.
templ AdminSessionPlansPage(lang, dir string) {
	@layouts.AdminShell("خطط الجلسات والأجهزة (Session Plans)", "session_plans", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
    <div class="stack-sm">
					<h2 class="card-title m-0">خطط الجلسات المتعددة وتحديد الأجهزة</h2>
					<p class="subtitle">تحديد عدد الأجهزة المتزامنة المسموح بها لكل مستخدم حسب خطته.</p>
				</div>
				<a href="/admin/session-plan/requests" class="btn btn-secondary btn-sm">طلبات زيادة المقاعد</a>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "خطط الجلسات", Message: "تحديد الحد الأقصى للجلسات الفعالة والأجهزة المسجلة."})
		</div>
	}
}

// AdminSessionPlanRequestsPage renders session seat requests.
templ AdminSessionPlanRequestsPage(lang, dir string) {
	@layouts.AdminShell("طلبات زيادة الجلسات والأجهزة", "session_plans", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
    <div class="stack-sm">
					<h2 class="card-title m-0">طلبات زيادة عدد الأجهزة والجلسات</h2>
				</div>
				<a href="/admin/session-plan" class="btn btn-secondary btn-sm">العودة للخطط</a>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "لا توجد طلبات معلقة", Message: "تظهر هنا طلبات المنشآت لزيادة عدد المقاعد والأجهزة المتصلة."})
		</div>
	}
}

// CustomerReportIssuePage renders issue form.
templ CustomerReportIssuePage(lang, dir string) {
	@layouts.CustomerShell("الإبلاغ عن مشكلة أو اقتراح", "support", lang, dir, nil) {
		<div class="card max-w-xl mx-auto">
			<h2 class="card-title mb-sm">الإبلاغ عن مشكلة أو إرسال اقتراح</h2>
			<p class="text-sm text-secondary m-0">فريق الدعم الفني يتابع بلاغاتك ويعمل على حلها فوراً.</p>

			<form method="POST" action="/report-issue" class="stack-lg">
    <div class="stack-sm">
					<label class="form-label">نوع البلاغ</label>
					<select name="issue_type" class="form-input" required>
						<option value="technical">مشكلة تقنية أو خطأ في النظام</option>
						<option value="order">مشكلة في طلب أو شحنة</option>
						<option value="billing">مشكلة في الدفع أو الفاتورة</option>
						<option value="suggestion">اقتراح تحسين للمنصة</option>
					</select>
				</div>
    <div class="stack-sm">
					<label class="form-label">تفاصيل البلاغ</label>
					<textarea name="description" class="form-input" rows="5" placeholder="اشرح المشكلة بالتفصيل مع ذكر أي أرقام مرجعية ذات صلة..." required></textarea>
				</div>
				<div class="flex justify-end">
					<button type="submit" class="btn btn-primary">إرسال البلاغ للدعم الفني</button>
				</div>
			</form>
		</div>
	}
}

// AdminReportIssuesPage renders admin issues review queue.
templ AdminReportIssuesPage(lang, dir string) {
	@layouts.AdminShell("بلاغات المستخدمين والدعم الفني (Report Issues)", "report_issues", lang, dir) {
		<div class="card mb-0">
			<div class="header-row">
    <div class="stack-sm">
					<h2 class="card-title m-0">قائمة بلاغات وشكاوى المستخدمين</h2>
					<p class="subtitle">متابعة مشاكل العملاء والموردين وتوجيهها للفريق المختص.</p>
				</div>
			</div>
			@components.EmptyState(components.EmptyStateProps{Title: "سجل البلاغات", Message: "جميع البلاغات والشكاوى المسجلة تم التعامل معها بنجاح."})
		</div>
	}
}
