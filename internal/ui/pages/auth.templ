package pages

import "github.com/muhiya/dawa24-store/internal/ui/layouts"

templ LoginPage(lang, dir, errorMsg string) {
	@layouts.Base("Sign In", lang, dir) {
		<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:1.5rem;">
			<div class="card" style="width:100%; max-width:420px;">
				<div style="text-align:center; margin-bottom:1.5rem;">
					<h1 style="font-size:1.5rem; font-weight:700; color:var(--primary-700);">Dawa24 Store</h1>
					<p style="color:var(--neutral-500); font-size:0.875rem; margin-top:0.25rem;">Sign in to your account</p>
				</div>

				if errorMsg != "" {
					<div style="background-color:var(--danger-bg); color:var(--danger); padding:0.75rem; border-radius:var(--radius-md); font-size:0.875rem; margin-bottom:1rem;">
						{ errorMsg }
					</div>
				}

				<form method="POST" action="/api/v1/auth/login">
					<div class="form-group">
						<label class="form-label" for="email">Email Address</label>
						<input type="email" id="email" name="email" required class="form-input" placeholder="pharmacist@dawa24.eg"/>
					</div>
					<div class="form-group">
						<label class="form-label" for="password">Password</label>
						<input type="password" id="password" name="password" required class="form-input" placeholder="••••••••"/>
					</div>
					<button type="submit" class="btn btn-primary" style="width:100%; margin-top:0.5rem;">
						Sign In
					</button>
				</form>
				<div style="text-align:center; margin-top:1.25rem; font-size:0.875rem; color:var(--neutral-600);">
					Don't have an account? <a href="/auth/register">Register your pharmacy or store</a>
				</div>
			</div>
		</div>
	}
}
