package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerOrderOfferModal(details *commerce.OrderLineOfferDetails, lang string) {
	<div
		class="modal-backdrop"
		x-data="{ open: true }"
		x-show="open"
		x-transition.opacity
		@keydown.escape.window="open = false; $el.remove()"
	>
		<div
			class="modal-container max-w-2xl"
			@click.outside="open = false; $el.closest('.modal-backdrop').remove()"
		>
			<!-- Modal Header -->
			<div class="modal-header">
				<div class="d-flex items-center gap-2">
					@components.IconPackage("icon-sm text-brand")
					<div>
						<h3 class="modal-title font-black m-0 text-base">
							{ details.Title.Get(i18n.ParseLang(lang)) }
						</h3>
						if details.VendorName != "" {
							<span class="text-xs text-secondary d-block mt-0.5">
								المورد: <strong class="text-primary">{ details.VendorName }</strong>
							</span>
						}
					</div>
				</div>
				<button
					type="button"
					class="btn btn-icon btn-ghost btn-sm"
					@click="open = false; $el.closest('.modal-backdrop').remove()"
					aria-label="إغلاق"
				>
					@components.IconClose("icon-xs")
				</button>
			</div>

			<!-- Modal Body -->
			<div class="modal-body stack-md p-5">
				if details.Description.Get(i18n.ParseLang(lang)) != "" {
					<div class="p-3 rounded-xl bg-surface-sunken border text-xs text-secondary leading-relaxed">
						{ details.Description.Get(i18n.ParseLang(lang)) }
					</div>
				}

				<div>
					<div class="d-flex items-center justify-between mb-2">
						<h4 class="text-xs font-black text-primary uppercase tracking-wider m-0">
							الأصناف المشمولة في هذا العرض / الباقة ({ fmt.Sprintf("%d", len(details.Items)) })
						</h4>
						<span class="badge badge-emerald text-2xs font-black">باقة ترويجية مجمعة</span>
					</div>

					<div class="table-container m-0 border rounded-xl overflow-hidden">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>الصنف المشمول</th>
									<th class="text-center">الكمية بالباقة</th>
									<th class="text-end">سعر التوريد</th>
									<th class="text-center">الخصم الإضافي</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range details.Items {
									<tr>
										<td>
											<div class="font-extrabold text-primary text-xs">
												{ item.ProductName.Get(i18n.ParseLang(lang)) }
											</div>
											if item.VariantName != "" || item.SKU != "" {
												<div class="text-2xs text-muted mt-0.5">
													if item.VariantName != "" {
														<span>{ item.VariantName }</span>
													}
													if item.SKU != "" {
														<span class="font-mono ms-1">SKU: { item.SKU }</span>
													}
												</div>
											}
										</td>
										<td class="text-center tabular-nums font-bold text-xs">
											<span class="p-1 px-2.5 rounded bg-surface border">
												{ fmt.Sprintf("%d", item.Quantity) }
											</span>
										</td>
										<td class="text-end tabular-nums text-xs text-primary font-bold">
											if item.CustomPrice.IsPositive() {
												{ item.CustomPrice.String() } ج.م
											} else {
												<span class="text-muted">مشمول بالباقة</span>
											}
										</td>
										<td class="text-center tabular-nums text-xs">
											if item.CustomDiscountPercent > 0 {
												<span class="badge badge-emerald text-2xs font-bold">
													{ fmt.Sprintf("%.1f%%", item.CustomDiscountPercent) }
												</span>
											} else {
												<span class="text-muted">-</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- Modal Footer -->
			<div class="modal-footer d-flex items-center justify-end p-4 border-t">
				<button
					type="button"
					class="btn btn-secondary btn-sm font-bold"
					@click="open = false; $el.closest('.modal-backdrop').remove()"
				>
					إغلاق
				</button>
			</div>
		</div>
	</div>
}
