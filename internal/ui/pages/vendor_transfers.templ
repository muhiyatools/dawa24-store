package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorTransfers(transfers []*inventory.WarehouseTransfer, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorTransfersTable(transfers)
	} else {
		@layouts.VendorShell("التحويلات المخزنية | Stock Transfers", "inventory", lang, dir) {
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">سجل التحويلات بين المخازن</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">متابعة حركة نقل البضائع بين الفروع والمستودعات</p>
				</div>
			</div>

			<div id="vendor-transfers-content">
				@VendorTransfersTable(transfers)
			</div>
		}
	}
}

templ VendorTransfersTable(transfers []*inventory.WarehouseTransfer) {
	if len(transfers) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا توجد تحويلات مخزنية سابقة",
			Message: "لم يتم إنشاء أي عمليات نقل بضائع بين المخازن حتى الآن.",
		})
	} else {
		<div style="background:#fff; border:1px solid var(--neutral-200); border-radius:var(--radius-lg); overflow:hidden;">
			<table style="width:100%; border-collapse:collapse; text-align:start; font-size:0.9rem;">
				<thead>
					<tr style="background:var(--neutral-50); border-bottom:1px solid var(--neutral-200);">
						<th style="padding:0.75rem 1rem;">التحويل</th>
						<th style="padding:0.75rem 1rem;">من مخزن</th>
						<th style="padding:0.75rem 1rem;">إلى مخزن</th>
						<th style="padding:0.75rem 1rem;">الكمية</th>
						<th style="padding:0.75rem 1rem;">الحالة</th>
						<th style="padding:0.75rem 1rem;">التاريخ</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range transfers {
						<tr style="border-bottom:1px solid var(--neutral-100);">
							<td style="padding:0.75rem 1rem; font-weight:700; color:var(--primary-700);" class="tabular-nums">
								#{ fmt.Sprintf("%d", t.ID) }
							</td>
							<td style="padding:0.75rem 1rem; color:var(--neutral-600);">
								Warehouse #{ fmt.Sprintf("%d", t.FromWarehouseID) }
							</td>
							<td style="padding:0.75rem 1rem; color:var(--neutral-600);">
								Warehouse #{ fmt.Sprintf("%d", t.ToWarehouseID) }
							</td>
							<td style="padding:0.75rem 1rem; font-weight:700;" class="tabular-nums">
								{ fmt.Sprintf("%d", t.Quantity) }
							</td>
							<td style="padding:0.75rem 1rem;">
								<span style="font-size:0.75rem; padding:0.2rem 0.5rem; border-radius:4px; background:var(--primary-50); color:var(--primary-700); font-weight:600;">
									{ string(t.Status) }
								</span>
							</td>
							<td style="padding:0.75rem 1rem; color:var(--neutral-500);" class="tabular-nums">
								{ t.CreatedAt.Format("2006-01-02 15:04") }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
