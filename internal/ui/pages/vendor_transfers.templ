package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ VendorTransfers(transfers []*inventory.WarehouseTransfer, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorTransfersTable(transfers)
	} else {
		@layouts.VendorShell("التحويلات المخزنية | Stock Transfers", "transfers", lang, dir) {
			<div class="header-row">
				<div>
					<h2 style="font-size:1.5rem; font-weight:800; color:var(--neutral-900);">سجل التحويلات بين المخازن</h2>
					<p style="font-size:0.875rem; color:var(--neutral-500);">متابعة حركة نقل البضائع بين الفروع والمخازن</p>
				</div>
			</div>

			<div id="vendor-transfers-content">
				@VendorTransfersTable(transfers)
			</div>
		}
	}
}

templ VendorTransfersTable(transfers []*inventory.WarehouseTransfer) {
	if len(transfers) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "لا توجد تحويلات مخزنية سابقة",
			Message: "لم يتم إنشاء أي عمليات نقل بضائع بين المخازن حتى الآن.",
		})
	} else {
		<div class="card" style="padding:0; overflow:hidden; margin-bottom:0;">
			<table class="b2b-table">
				<thead>
					<tr>
						<th>رقم التحويل</th>
						<th>من مخزن</th>
						<th>إلى مخزن</th>
						<th>الكمية</th>
						<th>الحالة</th>
						<th>التاريخ</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range transfers {
						<tr>
							<td style="font-weight:700; color:var(--primary-700);" class="tabular-nums">
								#{ fmt.Sprintf("%d", t.ID) }
							</td>
							<td style="color:var(--neutral-600);">
								Warehouse #{ fmt.Sprintf("%d", t.FromWarehouseID) }
							</td>
							<td style="color:var(--neutral-600);">
								Warehouse #{ fmt.Sprintf("%d", t.ToWarehouseID) }
							</td>
							<td>
								<span class="badge badge-slate tabular-nums" style="font-size:0.85rem; font-weight:700;">
									{ fmt.Sprintf("%d", t.Quantity) } عبوة
								</span>
							</td>
							<td>
								<span class="badge badge-sky">
									{ string(t.Status) }
								</span>
							</td>
							<td style="color:var(--neutral-500);" class="tabular-nums">
								{ t.CreatedAt.Format("2006-01-02 15:04") }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
