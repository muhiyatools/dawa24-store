package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/inventory"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorTransfersData struct {
	Transfers  []*inventory.WarehouseTransfer
	Page       int
	PerPage    int
	TotalCount int
}

templ VendorTransfers(data VendorTransfersData, lang, dir string, isPartial bool) {
	if isPartial {
		@VendorTransfersTable(data)
	} else {
		@layouts.VendorShell("التحويلات المخزنية | Stock Transfers", "transfers", lang, dir) {
			<div class="page-container">
				<!-- Header -->
				<div class="glass-panel p-6 mb-6">
					<div class="flex-between flex-wrap gap-4">
      <div class="stack-sm">
							<div class="d-flex items-center gap-3 mb-1">
								<div class="user-avatar-badge text-xl">
									@components.IconRefresh("icon-sm")
								</div>
								<h1 class="text-2xl font-black text-primary m-0">سجل التحويلات بين المخازن</h1>
							</div>
							<p class="text-sm text-secondary m-0">متابعة حركة نقل البضائع والأدوية بين الفروع والمخازن التوزيعية</p>
						</div>
					</div>
				</div>

				<div class="stack-sm" id="vendor-transfers-content">
					@VendorTransfersTable(data)
				</div>
			</div>
		}
	}
}

templ VendorTransfersTable(data VendorTransfersData) {
	if len(data.Transfers) == 0 {
		<div class="glass-panel p-8 text-center empty-state-glass">
			<div class="text-4xl mb-3">@components.IconPackage("icon-sm")</div>
			<h3 class="text-lg font-black text-primary mb-2">لا توجد تحويلات مخزنية سابقة</h3>
			<p class="text-sm text-secondary m-0">لم يتم إنشاء أي عمليات نقل بضائع بين المخازن حتى الآن.</p>
		</div>
	} else {
		<div class="glass-panel p-0 mb-6 overflow-hidden">
			<div class="table-container m-0">
				<table class="data-table m-0">
					<thead>
						<tr>
							<th>رقم التحويل</th>
							<th>من مخزن</th>
							<th>إلى مخزن</th>
							<th>الكمية</th>
							<th class="text-center">الحالة</th>
							<th class="text-end">التاريخ</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range data.Transfers {
							<tr>
								<td class="font-extrabold text-primary tabular-nums">
									#{ fmt.Sprintf("%d", t.ID) }
								</td>
								<td class="text-secondary text-sm">
									Warehouse #{ fmt.Sprintf("%d", t.FromWarehouseID) }
								</td>
								<td class="text-secondary text-sm">
									Warehouse #{ fmt.Sprintf("%d", t.ToWarehouseID) }
								</td>
								<td>
									<span class="badge badge-slate tabular-nums text-xs font-bold">
										{ fmt.Sprintf("%d", t.Quantity) } عبوة
									</span>
								</td>
								<td class="text-center">
									<span class="badge badge-sky text-xs font-bold">
										{ string(t.Status) }
									</span>
								</td>
								<td class="text-end tabular-nums text-xs text-muted">
									{ t.CreatedAt.Format("2006-01-02 03:04 PM") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if data.TotalCount > 0 {
				@components.B2BPagination(components.PaginationProps{
					CurrentPage: data.Page,
					PageSize:    data.PerPage,
					TotalCount:  data.TotalCount,
					BaseURL:     "/vendor/transfers",
				})
			}
		</div>
	}
}
