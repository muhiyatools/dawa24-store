package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
)

func formatDiscountInt(pct float64) string {
	if pct <= 0 {
		return "0%"
	}
	return fmt.Sprintf("%.0f%%", pct)
}

templ InvoicePrintablePage(data billing.PrintableInvoiceData, lang, dir string) {
	<!DOCTYPE html>
	<html lang={ lang } dir={ dir }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ fmt.Sprintf("فاتورة توريد #%s - دواء 24", data.InvoiceNumber) }</title>
			<style>
				:root {
					--primary: #0f172a;
					--accent: #2563eb;
					--border: #cbd5e1;
					--border-light: #e2e8f0;
					--text: #0f172a;
					--text-secondary: #475569;
					--text-muted: #64748b;
					--bg-light: #f8fafc;
				}
				* {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans Arabic", sans-serif;
				}
				body {
					background-color: #f1f5f9;
					color: var(--text);
					direction: rtl;
					font-size: 13px;
					line-height: 1.45;
					padding: 1.5rem 1rem 3rem 1rem;
				}

				/* Action Bar (Hidden in Print) */
				.no-print-toolbar {
					max-width: 840px;
					margin: 0 auto 1.5rem auto;
					background: #ffffff;
					padding: 0.85rem 1.25rem;
					border-radius: 12px;
					box-shadow: 0 4px 14px rgba(0,0,0,0.06);
					border: 1px solid var(--border-light);
					display: flex;
					align-items: center;
					justify-content: space-between;
					flex-wrap: wrap;
					gap: 0.75rem;
				}
				.toolbar-btn-group {
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}
				.btn-action {
					display: inline-flex;
					align-items: center;
					gap: 0.4rem;
					padding: 0.55rem 1.1rem;
					font-size: 0.85rem;
					font-weight: 700;
					border-radius: 8px;
					cursor: pointer;
					text-decoration: none;
					transition: all 0.15s ease;
					border: 1px solid transparent;
				}
				.btn-primary {
					background: #2563eb;
					color: #ffffff;
				}
				.btn-primary:hover {
					background: #1d4ed8;
				}
				.btn-thermal {
					background: #0f172a;
					color: #ffffff;
				}
				.btn-thermal:hover {
					background: #1e293b;
				}
				.btn-secondary {
					background: #f8fafc;
					color: #334155;
					border-color: #cbd5e1;
				}
				.btn-secondary:hover {
					background: #e2e8f0;
				}

				/* A4 Container */
				.invoice-paper-a4 {
					max-width: 840px;
					margin: 0 auto;
					background: #ffffff;
					padding: 2.25rem 2.25rem 2rem 2.25rem;
					border-radius: 10px;
					box-shadow: 0 4px 20px rgba(0,0,0,0.06);
					border: 1px solid var(--border-light);
				}

				/* Thermal Container */
				.invoice-paper-thermal {
					display: none;
					width: 80mm;
					max-width: 80mm;
					margin: 0 auto;
					background: #ffffff;
					padding: 12px 10px;
					font-size: 11px;
					line-height: 1.35;
					color: #000000;
				}

				/* Typography & Number tabular format */
				.tabular-nums {
					font-variant-numeric: tabular-nums;
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
				}

				/* Top Header: 3-column layout (Right: Vendor Logo/Info, Center: Dawa24 Logo, Left: Invoice Meta) */
				.invoice-header {
					display: grid;
					grid-template-columns: 1.2fr 1fr 1.2fr;
					align-items: center;
					border-bottom: 2px solid #0f172a;
					padding-bottom: 1.25rem;
					margin-bottom: 1.25rem;
					gap: 1rem;
				}
				.header-vendor {
					text-align: right;
				}
				.header-center-logo {
					text-align: center;
				}
				.header-meta {
					text-align: left;
					direction: ltr;
				}

				/* Parties Info Grid */
				.parties-grid {
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: 1.25rem;
					margin-bottom: 1.25rem;
					border: 1px solid var(--border-light);
					border-radius: 8px;
					padding: 0.85rem 1.1rem;
					background: #fafafa;
				}
				.party-column h4 {
					font-size: 0.85rem;
					font-weight: 800;
					color: #0f172a;
					margin-bottom: 0.4rem;
					padding-bottom: 0.25rem;
					border-bottom: 1px solid #e2e8f0;
				}
				.party-info-row {
					font-size: 0.825rem;
					color: #334155;
					margin-bottom: 0.2rem;
					line-height: 1.4;
				}
				.party-info-row strong {
					color: #0f172a;
				}

				/* Items Table */
				.invoice-table {
					width: 100%;
					border-collapse: collapse;
					margin-bottom: 1.25rem;
				}
				.invoice-table th {
					background: #0f172a;
					color: #ffffff;
					font-size: 0.775rem;
					font-weight: 800;
					padding: 0.55rem 0.5rem;
					text-align: right;
					border: 1px solid #0f172a;
				}
				.invoice-table td {
					padding: 0.5rem 0.5rem;
					border: 1px solid #cbd5e1;
					font-size: 0.825rem;
					color: #0f172a;
					vertical-align: middle;
				}
				.invoice-table tr:nth-child(even) {
					background: #f8fafc;
				}

				/* Totals & Signatures */
				.invoice-bottom-grid {
					display: grid;
					grid-template-columns: 1.2fr 1fr;
					gap: 1.5rem;
					align-items: start;
					margin-top: 1rem;
					margin-bottom: 1.25rem;
				}
				.signatures-box {
					border: 1px dashed #cbd5e1;
					border-radius: 8px;
					padding: 0.75rem 1rem;
					background: #fafafa;
					display: flex;
					justify-content: space-between;
					gap: 1rem;
				}
				.sig-col {
					flex: 1;
					font-size: 0.75rem;
					color: #475569;
				}
				.sig-line {
					height: 38px;
					border-bottom: 1px solid #94a3b8;
					margin-top: 0.25rem;
				}
				.totals-table {
					width: 100%;
					border-collapse: collapse;
					border: 1px solid var(--border-light);
					border-radius: 6px;
					overflow: hidden;
				}
				.totals-table td {
					padding: 0.4rem 0.6rem;
					font-size: 0.825rem;
					border-bottom: 1px solid var(--border-light);
				}
				.totals-table tr.grand-total {
					background: #f1f5f9;
					font-weight: 900;
					font-size: 0.95rem;
					color: #0f172a;
					border-top: 2px solid #0f172a;
				}

				/* Legal Disclaimer Box (Strictly Required) */
				.legal-disclaimer-box {
					border-top: 1px solid var(--border);
					padding-top: 0.75rem;
					margin-top: 0.75rem;
					text-align: center;
					font-size: 0.75rem;
					color: #64748b;
					line-height: 1.5;
				}

				/* Print Styles (Pixel-perfect A4 Output) */
				@media print {
					@page {
						size: A4 portrait;
						margin: 10mm 12mm;
					}
					html, body {
						background: #ffffff !important;
						padding: 0 !important;
						margin: 0 !important;
						color: #000000 !important;
						font-size: 11pt !important;
						-webkit-print-color-adjust: exact !important;
						print-color-adjust: exact !important;
					}
					.no-print-toolbar, .no-print {
						display: none !important;
					}
					.invoice-paper-a4 {
						max-width: 100% !important;
						width: 100% !important;
						margin: 0 !important;
						padding: 0 !important;
						border: none !important;
						box-shadow: none !important;
						border-radius: 0 !important;
					}
					.invoice-header {
						border-bottom: 2px solid #000000 !important;
					}
					.invoice-table th {
						background: #0f172a !important;
						color: #ffffff !important;
						border: 1px solid #000000 !important;
					}
					.invoice-table td {
						border: 1px solid #94a3b8 !important;
						color: #000000 !important;
					}
					.invoice-table tr {
						page-break-inside: avoid !important;
					}
					.invoice-bottom-grid, .legal-disclaimer-box {
						page-break-inside: avoid !important;
					}
				}

				/* Thermal Receipt Specifics */
				.thermal-divider {
					border-top: 1px dashed #000000;
					margin: 5px 0;
				}
				.thermal-center {
					text-align: center;
				}
				.thermal-row {
					display: flex;
					justify-content: space-between;
					margin-bottom: 2px;
				}
				.thermal-bold {
					font-weight: 800;
				}
			</style>
		</head>
		<body>
			
			<!-- Floating Action Toolbar (Hidden in print) -->
			<div class="no-print-toolbar">
				<div class="d-flex items-center gap-2">
					<span style="font-size:1.3rem;">@components.IconFileText("icon-sm")</span>
					<div>
						<strong style="font-size:0.95rem; display:block; color:#0f172a;">
							فاتورة استلام وتوريد
						</strong>
						<span style="font-size:0.75rem; color:#64748b;">
							رقم الفاتورة: <span class="tabular-nums font-bold">{ data.InvoiceNumber }</span>
						</span>
					</div>
				</div>

				<div class="toolbar-btn-group">
					<!-- Standard A4 Print -->
					<button
						type="button"
						class="btn-action btn-primary"
						onclick="printA4()"
						title="طباعة الفاتورة بالحجم القياسي A4"
					>
						<span>طباعة الفاتورة (A4)</span>
					</button>

					<!-- Thermal Print (POS 80mm) -->
					<button
						type="button"
						class="btn-action btn-thermal"
						onclick="printThermal()"
						title="طباعة إيصال كاشير 80 مم"
					>
						<span>طباعة إيصال كاشير (Thermal)</span>
					</button>

					<!-- Close / Back -->
					<button
						type="button"
						class="btn-action btn-secondary"
						onclick="window.close(); if(!window.closed) window.history.back();"
					>
						<span>إغلاق</span>
					</button>
				</div>
			</div>

			<!-- =========================================================================
			     VIEW 1: Standard A4 Invoice (فاتورة A4 منسقة ومعيارية)
			     ========================================================================= -->
			<div class="invoice-paper-a4" id="a4-invoice-container">
				
				<!-- Header Section: Vendor Right, Dawa 24 Center, Invoice Details Left -->
				<div class="invoice-header">
					
					<!-- 1. Right Column: Vendor Logo & Basic Info -->
					<div class="header-vendor">
						if data.Vendor.LogoURL != "" {
							<img
								src={ data.Vendor.LogoURL }
								alt={ data.Vendor.DisplayName }
								onerror="this.style.display='none'"
								style="max-height:52px; max-width:150px; object-fit:contain; margin-bottom:0.35rem; display:block; -webkit-print-color-adjust:exact; print-color-adjust:exact;"
							/>
						}
						<div style="font-size:1.15rem; font-weight:900; color:#0f172a; line-height:1.2;">
							{ data.Vendor.DisplayName }
						</div>
						if data.Vendor.LegalName != "" && data.Vendor.LegalName != data.Vendor.DisplayName {
							<div style="font-size:0.75rem; color:#64748b; margin-top:2px;">
								{ data.Vendor.LegalName }
							</div>
						}
						<div style="font-size:0.75rem; color:#334155; margin-top:3px;">
							if data.Vendor.TaxNumber != "" {
								<span>ب.ض: <strong class="tabular-nums">{ data.Vendor.TaxNumber }</strong></span>
							}
							if data.Vendor.CommercialRegister != "" {
								<span style="margin-inline-start:0.4rem;">س.ت: <strong class="tabular-nums">{ data.Vendor.CommercialRegister }</strong></span>
							}
						</div>
					</div>

					<!-- 2. Center Column: Dawa 24 Official Vector Logo & Document Title -->
					<div class="header-center-logo">
						<div style="display:inline-flex; align-items:center; justify-content:center; gap:0.45rem;">
							<svg width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline-block; vertical-align:middle;">
								<rect width="32" height="32" rx="8" fill="#2563eb"/>
								<path d="M16 7V25M7 16H25" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
							<span style="font-size:1.6rem; font-weight:900; color:#2563eb; letter-spacing:-0.5px;">دواء</span>
							<span style="font-size:1.6rem; font-weight:900; color:#0f172a; letter-spacing:-0.5px;">24</span>
						</div>
						<div style="font-size:0.75rem; font-weight:700; color:#475569; margin-top:2px;">
							منصة الربط والتوزيع الدوائي المعتمدة
						</div>
						<div style="font-size:0.75rem; font-weight:800; color:#0f172a; margin-top:4px; padding:0.2rem 0.6rem; background:#f1f5f9; border-radius:4px; display:inline-block; border:1px solid #e2e8f0;">
							فاتورة استلام وتوريد
						</div>
					</div>

					<!-- 3. Left Column: Invoice Meta Details -->
					<div class="header-meta" style="text-align:left; direction:ltr;">
						<div style="font-size:0.85rem; color:#334155; margin-bottom:0.2rem;">
							<span style="direction:rtl; display:inline-block; font-size:0.8rem; color:#64748b; margin-right:4px;">رقم الفاتورة:</span>
							<strong class="tabular-nums" style="color:#0f172a; font-size:0.95rem;">{ data.InvoiceNumber }</strong>
						</div>
						if data.OrderNumber != "" {
							<div style="font-size:0.8rem; color:#334155; margin-bottom:0.2rem;">
								<span style="direction:rtl; display:inline-block; font-size:0.75rem; color:#64748b; margin-right:4px;">أمر الشراء:</span>
								<strong class="tabular-nums">#{ data.OrderNumber }</strong>
							</div>
						}
						<div style="font-size:0.775rem; color:#334155; margin-bottom:0.2rem;">
							<span style="direction:rtl; display:inline-block; font-size:0.75rem; color:#64748b; margin-right:4px;">تاريخ الإصدار:</span>
							<span class="tabular-nums">{ data.IssueDate.Format("2006-01-02 15:04") }</span>
						</div>
						<div style="font-size:0.775rem; color:#334155;">
							<span style="direction:rtl; display:inline-block; font-size:0.75rem; color:#64748b; margin-right:4px;">طريقة السداد:</span>
							if data.PaymentMethod == "cash" || data.PaymentMethod == "cash_on_delivery" || data.PaymentMethod == "cod" {
								<span class="font-bold">نقداً عند الاستلام</span>
							} else if data.PaymentMethod == "wallet" {
								<span class="font-bold">المحفظة الإلكترونية</span>
							} else {
								<span class="font-bold">آجل / حساب ائتماني</span>
							}
						</div>
						if data.DeliveryCode != "" {
							<div style="font-size:0.775rem; color:#0f172a; margin-top:0.35rem; background:#f0fdf4; padding:0.25rem 0.5rem; border-radius:4px; border:1px solid #bbf7d0;">
								<span style="font-size:0.75rem; color:#166534; font-weight:bold;">كود الاستلام (PIN):</span>
								<strong class="tabular-nums" style="font-family:monospace; font-size:0.95rem; color:#15803d; margin-inline-start:0.35rem; letter-spacing:0.1em;">{ data.DeliveryCode }</strong>
							</div>
						}
					</div>

				</div>

				<!-- Parties Info Box (Clean 2-Column Grid) -->
				<div class="parties-grid">
					
					<!-- Vendor Details (Right in RTL) -->
					<div class="party-column">
						<h4>بيانات المورد (البائع / المصدر)</h4>
						<div class="party-info-row">الاسم التجاري: <strong>{ data.Vendor.DisplayName }</strong></div>
						if data.Vendor.TaxNumber != "" {
							<div class="party-info-row">البطاقة الضريبية: <strong class="tabular-nums">{ data.Vendor.TaxNumber }</strong></div>
						}
						if data.Vendor.CommercialRegister != "" {
							<div class="party-info-row">السجل التجاري: <strong class="tabular-nums">{ data.Vendor.CommercialRegister }</strong></div>
						}
						if data.Vendor.Address != "" {
							<div class="party-info-row">العنوان: { data.Vendor.Address }</div>
						}
						if data.Vendor.Phone != "" {
							<div class="party-info-row">الهاتف: <span class="tabular-nums" dir="ltr">{ data.Vendor.Phone }</span></div>
						}
					</div>

					<!-- Customer / Pharmacy Details (Left in RTL) -->
					<div class="party-column">
						<h4>بيانات الصيدلية (المشتري / المستلم)</h4>
						<div class="party-info-row">اسم الصيدلية: <strong>{ data.Customer.DisplayName }</strong></div>
						if data.Customer.OrganizationNumber != "" {
							<div class="party-info-row">رقم المنظمة لدى المورد: <strong class="tabular-nums" style="font-family:monospace; color:#2563eb; font-size:0.9rem;">{ data.Customer.OrganizationNumber }</strong></div>
						}
						if data.Customer.PharmacistLicense != "" {
							<div class="party-info-row">ترخيص الصيدلية: <strong class="tabular-nums">{ data.Customer.PharmacistLicense }</strong></div>
						}
						if data.Customer.Address != "" {
							<div class="party-info-row">عنوان الاستلام: { data.Customer.Address }</div>
						}
						if data.Customer.Phone != "" {
							<div class="party-info-row">الهاتف: <span class="tabular-nums" dir="ltr">{ data.Customer.Phone }</span></div>
						}
					</div>

				</div>

				<!-- Items Table: Sequence is strictly Item -> Public Price -> Discount % -> Quantity -> Net Unit Price -> Total -->
				<table class="invoice-table">
					<thead>
						<tr>
							<th style="width:35px; text-align:center;">#</th>
							<th>الصنف الدوائي / البيان</th>
							<th style="width:95px; text-align:center;">سعر الجمهور</th>
							<th style="width:75px; text-align:center;">نسبة الخصم</th>
							<th style="width:60px; text-align:center;">الكمية</th>
							<th style="width:105px; text-align:center;">سعر الوحدة الصافي</th>
							<th style="width:115px; text-align:center;">الإجمالي</th>
						</tr>
					</thead>
					<tbody>
						if len(data.Lines) == 0 {
							<tr>
								<td colspan="7" style="text-align:center; padding:1.5rem; color:#64748b;">
									لا توجد أصناف مسجلة في الفاتورة.
								</td>
							</tr>
						}
						for idx, line := range data.Lines {
							<tr>
								<td style="text-align:center; color:#64748b;" class="tabular-nums">{ fmt.Sprintf("%d", idx+1) }</td>
								<td>
									<strong style="color:#0f172a;">{ line.ItemName }</strong>
									if line.SKU != "" {
										<span style="font-size:0.725rem; color:#64748b; font-family:monospace; margin-inline-start:0.35rem;">
											({ line.SKU })
										</span>
									}
								</td>
								<td class="tabular-nums text-center">{ line.UnitPrice.String() } ج.م</td>
								<td style="text-align:center; font-weight:800; color:#0f172a;" class="tabular-nums">
									{ formatDiscountInt(line.DiscountPercent) }
								</td>
								<td style="text-align:center; font-weight:800;" class="tabular-nums">{ fmt.Sprintf("%d", line.Quantity) }</td>
								<td class="tabular-nums text-center">
									{ line.NetUnitPrice.String() } ج.م
								</td>
								<td style="text-align:center; font-weight:800; color:#0f172a;" class="tabular-nums">
									{ line.TotalPrice.String() } ج.م
								</td>
							</tr>
						}
					</tbody>
				</table>

				<!-- Bottom Section: Signatures (Right) & Financial Totals (Left) -->
				<div class="invoice-bottom-grid">
					
					<!-- Signatures Box -->
					<div class="signatures-box">
						<div class="sig-col">
							<strong style="display:block; color:#0f172a; margin-bottom:0.25rem;">تسليم المورد (المندوب):</strong>
							<div style="font-size:0.7rem; color:#64748b;">الاسم: .......................................</div>
							<div class="sig-line"></div>
							<div style="font-size:0.7rem; color:#64748b; margin-top:2px;">التوقيع والتاريخ</div>
						</div>
						<div class="sig-col">
							<strong style="display:block; color:#0f172a; margin-bottom:0.25rem;">استلام الصيدلية (المشتري):</strong>
							<div style="font-size:0.7rem; color:#64748b;">الاسم: .......................................</div>
							<div class="sig-line"></div>
							<div style="font-size:0.7rem; color:#64748b; margin-top:2px;">الختم / التوقيع</div>
						</div>
					</div>

					<!-- Financial Totals -->
					<div>
						<table class="totals-table">
							<tr>
								<td style="color:#64748b;">إجمالي سعر الجمهور:</td>
								<td style="text-align:left;" class="tabular-nums">{ data.Subtotal.String() } ج.م</td>
							</tr>
							if data.TotalDiscount.IsPositive() {
								<tr>
									<td style="color:#0f172a;">إجمالي الخصم التجاري:</td>
									<td style="text-align:left; font-weight:700;" class="tabular-nums">
										-{ data.TotalDiscount.String() } ج.م
									</td>
								</tr>
							}
							<tr class="grand-total">
								<td>الصافي المستحق سداده:</td>
								<td style="text-align:left; color:#2563eb;" class="tabular-nums">{ data.TotalAmount.String() } ج.م</td>
							</tr>
						</table>
						if data.Notes != "" {
							<div style="font-size:0.75rem; color:#475569; margin-top:0.4rem;">
								<strong>ملاحظات:</strong> { data.Notes }
							</div>
						}
					</div>

				</div>

				<!-- Exact Required Disclaimer Statement (Bottom of A4) -->
				<div class="legal-disclaimer-box">
					Dawa24 منصة وسيطة ولا تتحمل أي مسؤولية عن البيع أو التسليم أو الاستلام أو التحصيل أو السداد بين العميل والمورد، وتظل المسؤولية كاملة على أطراف المعاملة، كلٌ حسب التزامه القانوني والتعاقدي.
				</div>

			</div>


			<!-- =========================================================================
			     VIEW 2: Thermal POS Receipt 80mm (إيصال كاشير حراري منسق)
			     ========================================================================= -->
			<div class="invoice-paper-thermal" id="thermal-invoice-container">
				
				<div class="thermal-center">
					if data.Vendor.LogoURL != "" {
						<img
							src={ data.Vendor.LogoURL }
							alt={ data.Vendor.DisplayName }
							onerror="this.style.display='none'"
							style="max-height:36px; max-width:120px; object-fit:contain; margin:0 auto 4px auto; display:block; filter:grayscale(100%) contrast(150%);"
						/>
					}
					<div style="font-size:15px; font-weight:900; letter-spacing:-0.5px;">
						{ data.Vendor.DisplayName }
					</div>
					if data.Vendor.TaxNumber != "" {
						<div class="font-size-10">ب.ض: { data.Vendor.TaxNumber } | س.ت: { data.Vendor.CommercialRegister }</div>
					}
					if data.Vendor.Phone != "" {
						<div class="font-size-10">هاتف: { data.Vendor.Phone }</div>
					}
					<div class="thermal-divider"></div>
					<div style="font-size:13px; font-weight:900;">
						دواء 24 — إيصال استلام وتوريد
					</div>
					<div class="tabular-nums font-size-10">#{ data.InvoiceNumber }</div>
					<div class="thermal-divider"></div>
				</div>

				<!-- Meta -->
				<div class="thermal-row">
					<span>التاريخ:</span>
					<span class="tabular-nums">{ data.IssueDate.Format("2006-01-02 15:04") }</span>
				</div>
				if data.OrderNumber != "" {
					<div class="thermal-row">
						<span>أمر الشراء:</span>
						<span class="tabular-nums">#{ data.OrderNumber }</span>
					</div>
				}
				<div class="thermal-row">
					<span>الصيدلية:</span>
					<span class="thermal-bold">{ data.Customer.DisplayName }</span>
				</div>
				if data.Customer.OrganizationNumber != "" {
					<div class="thermal-row">
						<span>رقم المنظمة:</span>
						<span class="thermal-bold tabular-nums" style="font-family:monospace;">{ data.Customer.OrganizationNumber }</span>
					</div>
				}
				if data.Customer.PharmacistLicense != "" {
					<div class="thermal-row">
						<span>الترخيص:</span>
						<span>{ data.Customer.PharmacistLicense }</span>
					</div>
				}
				if data.DeliveryCode != "" {
					<div class="thermal-row" style="background:#f1f5f9; padding:2px 4px; border-radius:3px; margin:2px 0;">
						<span class="thermal-bold">كود الاستلام (PIN):</span>
						<span class="thermal-bold tabular-nums" style="font-family:monospace; font-size:11px; letter-spacing:0.1em;">{ data.DeliveryCode }</span>
					</div>
				}
				<div class="thermal-divider"></div>

				<!-- Items Header: Sequence is Name -> Public Price -> Discount -> Qty -> Total -->
				<div class="thermal-row thermal-bold" style="font-size:9.5px; border-bottom:1px solid #000; padding-bottom:2px; margin-bottom:4px;">
					<span style="flex:2;">الصنف</span>
					<span style="width:48px; text-align:center;">سعر الجمهور</span>
					<span style="width:34px; text-align:center;">الخصم</span>
					<span style="width:26px; text-align:center;">الكمية</span>
					<span style="width:50px; text-align:left;">الإجمالي</span>
				</div>

				<!-- Items -->
				for _, line := range data.Lines {
					<div style="margin-bottom:5px;">
						<div style="font-weight:700; font-size:10.5px;">{ line.ItemName }</div>
						<div class="thermal-row" style="font-size:9.5px; color:#111; align-items:center;">
							<span style="flex:2; color:#555;" class="tabular-nums">{ line.NetUnitPrice.String() + " صافي" }</span>
							<span style="width:48px; text-align:center;" class="tabular-nums">{ line.UnitPrice.String() }</span>
							<span style="width:34px; text-align:center;" class="tabular-nums">{ formatDiscountInt(line.DiscountPercent) }</span>
							<span style="width:26px; text-align:center; font-weight:800;" class="tabular-nums">{ fmt.Sprintf("%d", line.Quantity) }</span>
							<span style="width:50px; text-align:left; font-weight:800;" class="tabular-nums">{ line.TotalPrice.String() }</span>
						</div>
					</div>
				}

				<div class="thermal-divider"></div>

				<!-- Totals -->
				<div class="thermal-row">
					<span>إجمالي سعر الجمهور:</span>
					<span class="tabular-nums">{ data.Subtotal.String() } ج.م</span>
				</div>
				if data.TotalDiscount.IsPositive() {
					<div class="thermal-row">
						<span>إجمالي الخصم:</span>
						<span class="tabular-nums">-{ data.TotalDiscount.String() } ج.م</span>
					</div>
				}
				<div class="thermal-divider"></div>
				<div class="thermal-row thermal-bold" style="font-size:13px;">
					<span>الصافي المطلوب:</span>
					<span class="tabular-nums">{ data.TotalAmount.String() } ج.م</span>
				</div>
				<div class="thermal-divider"></div>

				<!-- Exact Required Disclaimer Statement (Bottom of Thermal) -->
				<div class="thermal-center" style="font-size:8.5px; line-height:1.35; color:#333; margin-top:6px; padding-top:4px; border-top:1px dashed #000;">
					Dawa24 منصة وسيطة ولا تتحمل أي مسؤولية عن البيع أو التسليم أو الاستلام أو التحصيل أو السداد بين العميل والمورد، وتظل المسؤولية كاملة على أطراف المعاملة، كلٌ حسب التزامه القانوني والتعاقدي.
				</div>

			</div>

			<!-- Scripts for Thermal and A4 Printing Modes -->
			<script>
				function printA4() {
					const thermal = document.getElementById('thermal-invoice-container');
					const a4 = document.getElementById('a4-invoice-container');
					if (thermal) thermal.style.display = 'none';
					if (a4) a4.style.display = 'block';
					window.print();
				}

				function printThermal() {
					const thermal = document.getElementById('thermal-invoice-container');
					const a4 = document.getElementById('a4-invoice-container');
					if (a4) a4.style.display = 'none';
					if (thermal) thermal.style.display = 'block';
					window.print();
					// restore after print dialog
					setTimeout(() => {
						if (a4) a4.style.display = 'block';
						if (thermal) thermal.style.display = 'none';
					}, 1000);
				}

				// Auto print if requested via query parameter
				window.addEventListener('DOMContentLoaded', () => {
					const params = new URLSearchParams(window.location.search);
					if (params.get('thermal') === '1') {
						printThermal();
					} else if (params.get('autoprint') === '1') {
						printA4();
					}
				});
			</script>
		</body>
	</html>
}
