package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type CustomerJobsData struct {
	Jobs              []*VendorJobItem
	Branches          []*org.Branch
	TotalCount        int
	PublishedCount    int
	ClosedCount       int
	TotalApplications int
	NoticeType        string
	NoticeMsg         string
	Permissions       []string
}

templ CustomerJobs(lang, dir string, data CustomerJobsData) {
	@layouts.CustomerShell("إدارة التوظيف والوظائف | دواء 24", "jobs", lang, dir, data.Permissions) {
		<div>
			
			<!-- Notice Toast -->
			if data.NoticeMsg != "" {
				if data.NoticeType == "error" {
					<div class="alert alert-danger">
						<span class="text-xl">@components.IconAlert("icon-sm")</span>
						<span>{ data.NoticeMsg }</span>
					</div>
				} else {
					<div class="alert alert-success">
						<span class="text-xl">@components.IconCheckCircle("icon-sm")</span>
						<span>{ data.NoticeMsg }</span>
					</div>
				}
			}

			<!-- Top Header Banner -->
			<div class="card">
				<div>
					<div>
						لوحة الصيدلية • إدارة الكوادر والتوظيف
					</div>
					<h1>
						شواغر ووظائف الصيدلية
					</h1>
					<p>
						نشر الشواغر الوظيفية لفروع صيدليتك، استعراض المتقدمين والسير الذاتية، وتعيين الكوادر في الفروع مباشرة.
					</p>
				</div>
				<button type="button" class="btn btn-primary" data-modal-open="add-job-modal" onclick="openAddJobModal()">
					@components.IconPlus("icon-sm")
					<span>نشر وظيفة جديدة</span>
				</button>
			</div>

			<!-- Metric Stats Cards -->
			<div>
				<!-- Card 1 -->
				<div class="card">
					<div>
						@components.IconBriefcase("icon-sm")
					</div>
					<div>
						<div class="text-sm fw-700 text-muted">إجمالي الوظائف</div>
						<div>
							{ fmt.Sprintf("%d", data.TotalCount) }
						</div>
					</div>
				</div>

				<!-- Card 2 -->
				<div class="card">
					<div>
						🟢
					</div>
					<div>
						<div class="text-sm fw-700 text-muted">الوظائف النشطة</div>
						<div>
							{ fmt.Sprintf("%d", data.PublishedCount) }
						</div>
					</div>
				</div>

				<!-- Card 3 -->
				<div class="card">
					<div>
						@components.IconShield("icon-sm")
					</div>
					<div>
						<div class="text-sm fw-700 text-muted">الوظائف المغلقة</div>
						<div>
							{ fmt.Sprintf("%d", data.ClosedCount) }
						</div>
					</div>
				</div>

				<!-- Card 4 -->
				<div class="card">
					<div>
						@components.IconUsers("icon-sm")
					</div>
					<div>
						<div class="text-sm fw-700 text-muted">إجمالي المتقدمين</div>
						<div>
							{ fmt.Sprintf("%d", data.TotalApplications) }
						</div>
					</div>
				</div>
			</div>

			<!-- Main Jobs Table Card -->
			<div class="card">
				<div>
					<h3>
						قائمة الوظائف المنشورة
					</h3>
				</div>

				if len(data.Jobs) == 0 {
					<div>
						<div>@components.IconBriefcase("icon-sm")</div>
						<h3>لم تقم بنشر أي وظائف حتى الآن</h3>
						<p>
							يمكنك نشر وظيفة جديدة الآن لاستقبال طلبات الصيادلة ومساعدي الصيادلة وإدارة التعيينات بكل سهولة.
						</p>
						<button type="button" class="btn btn-primary" onclick="openAddJobModal()">
							@components.IconPlus("icon-xs")
							<span>نشر وظيفتك الأولى الآن</span>
						</button>
					</div>
				} else {
					<div class="table-responsive">
						<table class="data-table">
							<thead>
								<tr>
									<th>المسمى الوظيفي</th>
									<th>الموقع / الفرع</th>
									<th>الراتب المقترح</th>
									<th>المتقدمين</th>
									<th>الحالة</th>
									<th>الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Jobs {
									<tr>
										<td>
											<div>
												{ item.Job.Title.Get(i18n.ParseLang(lang)) }
											</div>
											<div>
												{ item.Job.PublicID }
											</div>
										</td>
										<td>
											<div>
												<span>@components.IconMapPin("icon-sm")</span>
												<span>
													if item.Job.Location != "" {
														{ item.Job.Location }
													} else {
														الفرع الرئيسي
													}
												</span>
											</div>
										</td>
										<td>
											<div>
												if !item.Job.SalaryMin.IsZero() || !item.Job.SalaryMax.IsZero() {
													@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: item.Job.SalaryMin })
													if !item.Job.SalaryMax.IsZero() {
														<span> - </span>
														@components.MoneyDisplay(components.MoneyDisplayProps{ Amount: item.Job.SalaryMax })
													}
												} else {
													<span class="text-muted">يحدد بالمقابلة</span>
												}
											</div>
										</td>
										<td>
											<button
												type="button"
												class="btn btn-secondary btn-sm"
												onclick={ templ.ComponentScript{ Call: fmt.Sprintf("viewApplicants(%d, %q)", item.Job.ID, item.Job.Title.Get(i18n.ParseLang(lang))) } }
											
											>
												<span>@components.IconUsers("icon-sm")</span>
												<span>{ fmt.Sprintf("%d متقدم", item.ApplicationsCount) }</span>
											</button>
										</td>
										<td>
											if item.Job.Status == "published" {
												<span class="badge badge-emerald">
													منشورة ومتاحة
												</span>
											} else {
												<span class="badge badge-slate">
													مغلقة
												</span>
											}
										</td>
										<td>
											<div>
												<!-- Edit Button -->
												<button
													type="button"
													class="btn btn-secondary btn-sm btn-icon"
													title="تعديل بيانات الوظيفة"
													data-job-id={ fmt.Sprintf("%d", item.Job.ID) }
													data-title-ar={ item.Job.Title.Get(i18n.AR) }
													data-title-en={ item.Job.Title.Get(i18n.EN) }
													data-location={ item.Job.Location }
													data-sal-min={ fmt.Sprintf("%d", item.Job.SalaryMin.Minor()/100) }
													data-sal-max={ fmt.Sprintf("%d", item.Job.SalaryMax.Minor()/100) }
													data-status={ item.Job.Status }
													data-desc={ item.Job.Description }
													data-reqs={ item.Job.Requirements }
													onclick="openEditJobModalFromBtn(this)"
												>
													@components.IconEdit("icon-sm")
												</button>

												<!-- Toggle Status Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/jobs/%d/toggle", item.Job.ID)) }>
													<button
														type="submit"
														class="btn btn-secondary btn-sm btn-icon"
														title={ templ.EscapeString("تغيير حالة الوظيفة (نشر / إغلاق)") }
													>
														if item.Job.Status == "published" {
															@components.IconShield("icon-sm")
														} else {
															🟢
														}
													</button>
												</form>

												<!-- Delete Form -->
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/customer/jobs/%d/delete", item.Job.ID)) } onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذا الشاغر الوظيفي نهائياً؟');">
													<button type="submit" class="btn btn-danger btn-sm btn-icon" title="حذف الوظيفة">
														@components.IconTrash("icon-sm")
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>

		<!-- ================= ADD JOB MODAL ================= -->
		<div id="add-job-modal" class="modal-backdrop hidden">
			<div class="card">
				<div class="section-head">
					<div>
						<h3>
							نشر وظيفة / شاغر صيدلاني جديد
						</h3>
						<p>
							أدخل تفاصيل الشاغر لاستقبال طلبات التقديم والسير الذاتية من الكوادر المعتمدة.
						</p>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closeAddJobModal()">@components.IconX("icon-sm")</button>
				</div>

				<form method="POST" action="/customer/jobs" class="stack-115">
					<!-- Job Title Arabic & English -->
					<div class="grid-2">
						<div>
							<label class="form-label">
								المسمى الوظيفي (بالعربية) <span class="text-danger">*</span>
							</label>
							<input
 type="text"
 name="title_ar"
 required
 class="form-input field-height"
 placeholder="مثال: صيدلي أول / مساعد صيدلي"
 
 />
						</div>

						<div>
							<label class="form-label">
								المسمى الوظيفي (بالإنجليزية)
							</label>
							<input
 type="text"
 name="title_en"
 class="form-input field-height"
 placeholder="e.g. Pharmacist / Branch Manager"
 
 />
						</div>
					</div>

					<!-- Location & Branch Selection -->
					<div class="grid-2">
						<div>
							<label class="form-label">
								الفرع المخصص للشاغر <span class="text-danger">*</span>
							</label>
							if len(data.Branches) == 0 {
								<div>
									<span>لم تسجل فروعاً بعد. سيتم ربط الوظيفة بـ <strong>(الفرع الرئيسي)</strong>. يمكنك إضافة فروعك من <a href="/customer/branches" class="text-primary font-bold text-decoration-none">إدارة الفروع ↗</a>.</span>
								</div>
								<input type="hidden" name="location" value="الفرع الرئيسي" />
							} else {
								<select
 name="branch_id"
 required
 class="form-input field-cta"
 
>
									<option value="">-- اختر الفرع المتاح للوظيفة --</option>
									for _, b := range data.Branches {
										<option value={ fmt.Sprintf("%d", b.ID) }>
											{ b.Name.Get(i18n.ParseLang(lang)) }
											if b.IsMain {
												 (الفرع الرئيسي)
											}
										</option>
									}
								</select>
							}
						</div>

						<div>
							<label class="form-label">
								حالة الوظيفة <span class="text-danger">*</span>
							</label>
							<select
 name="status"
 required
 class="form-input field-cta"
 
>
								<option value="published">منشورة ومتاحة للتقديم (Published)</option>
								<option value="closed">مغلقة ومكتفية (Closed)</option>
								<option value="draft">مسودة غير معلنة (Draft)</option>
							</select>
						</div>
					</div>

					<!-- Salary Range -->
					<div class="grid-2">
						<div>
							<label class="form-label">
								الحد الأدنى للراتب (اختياري)
							</label>
							<input
 type="text"
 name="salary_min"
 class="form-input field-height"
 placeholder="مثال: 8000"
 
 />
						</div>

						<div>
							<label class="form-label">
								الحد الأقصى للراتب (اختياري)
							</label>
							<input
 type="text"
 name="salary_max"
 class="form-input field-height"
 placeholder="مثال: 12000"
 
 />
						</div>
					</div>

					<!-- Description -->
					<div>
						<label class="form-label">
							الوصف الوظيفي والمسؤوليات
						</label>
						<textarea
							name="description"
							rows="4"
							class="form-input"
							placeholder="اكتب نبذة عن المسؤوليات اليومية، مواعيد الشفتات، وطبيعة العمل بالفرع..."
						
						></textarea>
					</div>

					<!-- Requirements -->
					<div>
						<label class="form-label">
							المتطلبات والمؤهلات المطلوبة
						</label>
						<textarea
							name="requirements"
							rows="3"
							class="form-input"
							placeholder="مثال: بكالوريوس صيدلة، ترخيص مزاولة المهنة، خبرة سنة على الأقل..."
						
						></textarea>
					</div>

					<!-- Form Actions -->
					<div>
						<button type="button" class="btn btn-secondary" onclick="closeAddJobModal()">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary">
							@components.IconCheck("icon-xs")
							<span>نشر الشاغر الوظيفي الآن</span>
						</button>
					</div>

				</form>
			</div>
		</div>

		<!-- ================= EDIT JOB MODAL ================= -->
		<div id="edit-job-modal" class="modal-backdrop hidden">
			<div class="card">
				<div class="section-head">
					<div>
						<h3>
							تعديل بيانات الشاغر الوظيفي
						</h3>
						<p>
							تحديث متطلبات الوظيفة أو الراتب أو تغيير حالتها.
						</p>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closeEditJobModal()">@components.IconX("icon-sm")</button>
				</div>

				<form id="edit-job-form" method="POST" action="" class="stack-115">
					<!-- Job Title Arabic & English -->
					<div class="grid-2">
						<div>
							<label class="form-label">
								المسمى الوظيفي (بالعربية) <span class="text-danger">*</span>
							</label>
							<input
 type="text"
 name="title_ar"
 id="edit-job-title-ar"
 required
 class="form-input field-height"
 
 />
						</div>

						<div>
							<label class="form-label">
								المسمى الوظيفي (بالإنجليزية)
							</label>
							<input
 type="text"
 name="title_en"
 id="edit-job-title-en"
 class="form-input field-height"
 
 />
						</div>
					</div>

					<!-- Location & Status -->
					<div class="grid-2">
						<div>
							<label class="form-label">
								الفرع المخصص للشاغر <span class="text-danger">*</span>
							</label>
							if len(data.Branches) == 0 {
								<input
									type="text"
									name="location"
									id="edit-job-location"
									readonly
									class="form-input"
								
								/>
							} else {
								<select
 name="branch_id"
 id="edit-job-branch-id"
 required
 class="form-input field-cta"
 
>
									<option value="">-- اختر الفرع المتاح للوظيفة --</option>
									for _, b := range data.Branches {
										<option 
											value={ fmt.Sprintf("%d", b.ID) }
											data-branch-name={ b.Name.Get(i18n.ParseLang(lang)) }
											data-branch-name-ar={ b.Name.Get(i18n.AR) }
											data-branch-name-en={ b.Name.Get(i18n.EN) }
										>
											{ b.Name.Get(i18n.ParseLang(lang)) }
											if b.IsMain {
												 (الفرع الرئيسي)
											}
										</option>
									}
								</select>
							}
						</div>

						<div>
							<label class="form-label">
								حالة الوظيفة <span class="text-danger">*</span>
							</label>
							<select
 name="status"
 id="edit-job-status"
 required
 class="form-input field-cta"
 
>
								<option value="published">منشورة ومتاحة للتقديم (Published)</option>
								<option value="closed">مغلقة ومكتفية (Closed)</option>
								<option value="draft">مسودة غير معلنة (Draft)</option>
							</select>
						</div>
					</div>

					<!-- Salary Range -->
					<div class="grid-2">
						<div>
							<label class="form-label">
								الحد الأدنى للراتب
							</label>
							<input
 type="text"
 name="salary_min"
 id="edit-job-salary-min"
 class="form-input field-height"
 
 />
						</div>

						<div>
							<label class="form-label">
								الحد الأقصى للراتب
							</label>
							<input
 type="text"
 name="salary_max"
 id="edit-job-salary-max"
 class="form-input field-height"
 
 />
						</div>
					</div>

					<!-- Description -->
					<div>
						<label class="form-label">
							الوصف الوظيفي والمسؤوليات
						</label>
						<textarea
							name="description"
							id="edit-job-description"
							rows="4"
							class="form-input"
						
						></textarea>
					</div>

					<!-- Requirements -->
					<div>
						<label class="form-label">
							المتطلبات والمؤهلات المطلوبة
						</label>
						<textarea
							name="requirements"
							id="edit-job-requirements"
							rows="3"
							class="form-input"
						
						></textarea>
					</div>

					<!-- Form Actions -->
					<div>
						<button type="button" class="btn btn-secondary" onclick="closeEditJobModal()">
							إلغاء
						</button>
						<button type="submit" class="btn btn-primary">
							@components.IconCheck("icon-xs")
							<span>حفظ التعديلات والتحديث</span>
						</button>
					</div>

				</form>
			</div>
		</div>

		<!-- ================= APPLICANTS & ONBOARDING MODAL ================= -->
		<div id="job-applicants-modal" class="modal-backdrop hidden">
			<div class="card">
				<div class="section-head">
					<div>
						<h3>
							طلبات التقديم والسير الذاتية
						</h3>
						<p id="applicants-modal-subtitle">
							الوظيفة: -
						</p>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closeApplicantsModal()">@components.IconX("icon-sm")</button>
				</div>

				<!-- Dynamic Content -->
				<div id="applicants-modal-content">
					<!-- Populated by JS -->
				</div>
			</div>
		</div>

		<!-- ================= ONBOARD EMPLOYEE MODAL ================= -->
		<div id="onboard-modal" class="modal-backdrop hidden">
			<div class="card">
				<div>
					<div>
						<h3>
							قبول المتقدم وتعيينه كموظف
						</h3>
						<p id="onboard-modal-subtitle">
							المتقدم: -
						</p>
					</div>
					<button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="closeOnboardModal()">@components.IconX("icon-sm")</button>
				</div>

				<form id="onboard-employee-form" onsubmit="submitOnboardEmployee(event)">
					<input type="hidden" id="onboard-job-id" value="" />
					<input type="hidden" id="onboard-app-id" value="" />

					<!-- Branch Selection -->
					<div>
						<label class="form-label">
							الفرع المخصص للعمل <span class="text-danger">*</span>
						</label>
						<select id="onboard-branch-id" required class="form-input field-cta">
							if len(data.Branches) == 0 {
								<option value="">الفرع الرئيسي</option>
							} else {
								for _, b := range data.Branches {
									<option value={ fmt.Sprintf("%d", b.ID) }>
										{ b.Name.Get(i18n.ParseLang(lang)) }
										if b.IsMain {
											 (الرئيسي)
										}
									</option>
								}
							}
						</select>
					</div>

					<!-- Role / Permissions Selection -->
					<div>
						<label class="form-label">
							الدور الوظيفي والصلاحيات <span class="text-danger">*</span>
						</label>
						<select id="onboard-role-key" required class="form-input field-cta">
							<option value="org_pharmacist">صيدلي مسؤول (طلبات، فواتير، استلام)</option>
							<option value="org_manager">مدير فرع (صلاحيات كاملة للفرع)</option>
							<option value="org_employee">موظف / كاشير (صلاحيات أساسية)</option>
							<option value="org_warehouse">أمين مخزن (المخزون والاستلام)</option>
							<option value="org_accountant">محاسب (المالية والفواتير)</option>
						</select>
					</div>

					<!-- Job Title -->
					<div>
						<label class="form-label">
							المسمى الوظيفي المعتمد <span class="text-danger">*</span>
						</label>
						<input
 type="text"
 id="onboard-job-title"
 required
 class="form-input field-height"
 placeholder="مثال: صيدلي أول / مدير شفت مسائي"
 
 />
					</div>

					<!-- Salary -->
					<div>
						<label class="form-label">
							الراتب الأساسي (ج.م / شهرياً)
						</label>
						<input
 type="text"
 id="onboard-base-salary"
 class="form-input field-height"
 placeholder="مثال: 9500"
 
 />
					</div>

					<!-- Notes -->
					<div>
						<label class="form-label">
							ملاحظات التعيين (اختياري)
						</label>
						<textarea
							id="onboard-notes"
							rows="2"
							class="form-input"
							placeholder="ملاحظات حول موعد بدء العمل أو الشفت..."
						
						></textarea>
					</div>

					<!-- Form Actions -->
					<div>
						<button type="button" class="btn btn-secondary" onclick="closeOnboardModal()">
							إلغاء
						</button>
						<button type="submit" id="onboard-submit-btn" class="btn btn-primary">
							@components.IconCheck("icon-xs")
							<span>تأكيد القبول وتعيين الموظف</span>
						</button>
					</div>
				</form>
			</div>
		</div>

		<script>
			let currentJobId = 0;
			let currentJobTitle = '';

			function openAddJobModal() {
				const el = document.getElementById('add-job-modal');
				if (el) {
					el.classList.remove('hidden');
					el.style.display = 'flex';
				}
			}

			function closeAddJobModal() {
				const el = document.getElementById('add-job-modal');
				if (el) {
					el.classList.add('hidden');
					el.style.display = 'none';
				}
			}

			function openEditJobModalFromBtn(btn) {
				if (!btn) return;
				const jobId = btn.getAttribute('data-job-id');
				const titleAr = btn.getAttribute('data-title-ar') || '';
				const titleEn = btn.getAttribute('data-title-en') || '';
				const location = btn.getAttribute('data-location') || '';
				const salMin = btn.getAttribute('data-sal-min') || '';
				const salMax = btn.getAttribute('data-sal-max') || '';
				const status = btn.getAttribute('data-status') || '';
				const desc = btn.getAttribute('data-desc') || '';
				const reqs = btn.getAttribute('data-reqs') || '';

				const form = document.getElementById('edit-job-form');
				if (form) form.action = `/customer/jobs/${jobId}/edit`;

				const titleArInput = document.getElementById('edit-job-title-ar');
				const titleEnInput = document.getElementById('edit-job-title-en');
				const locationInput = document.getElementById('edit-job-location');
				const branchSelect = document.getElementById('edit-job-branch-id');
				const statusInput = document.getElementById('edit-job-status');
				const salMinInput = document.getElementById('edit-job-salary-min');
				const salMaxInput = document.getElementById('edit-job-salary-max');
				const descInput = document.getElementById('edit-job-description');
				const reqsInput = document.getElementById('edit-job-requirements');

				if (titleArInput) titleArInput.value = titleAr || '';
				if (titleEnInput) titleEnInput.value = titleEn || '';
				if (locationInput) locationInput.value = location || '';
				if (branchSelect) {
					let matched = false;
					if (location) {
						for (let i = 0; i < branchSelect.options.length; i++) {
							const opt = branchSelect.options[i];
							const optText = opt.textContent.trim();
							const optName = opt.getAttribute('data-branch-name') || '';
							const optNameAr = opt.getAttribute('data-branch-name-ar') || '';
							const optNameEn = opt.getAttribute('data-branch-name-en') || '';
							if (optText.includes(location) || optName === location || optNameAr === location || optNameEn === location) {
								branchSelect.selectedIndex = i;
								matched = true;
								break;
							}
						}
					}
					if (!matched && branchSelect.options.length > 1) {
						branchSelect.selectedIndex = 1;
					}
				}
				if (statusInput) statusInput.value = status || 'published';
				if (salMinInput) salMinInput.value = salMin || '';
				if (salMaxInput) salMaxInput.value = salMax || '';
				if (descInput) descInput.value = desc || '';
				if (reqsInput) reqsInput.value = reqs || '';

				const modal = document.getElementById('edit-job-modal');
				if (modal) {
					modal.classList.remove('hidden');
					modal.style.display = 'flex';
				}
			}

			function closeEditJobModal() {
				const modal = document.getElementById('edit-job-modal');
				if (modal) {
					modal.classList.add('hidden');
					modal.style.display = 'none';
				}
			}

			function openApplicantsModal() {
				const el = document.getElementById('job-applicants-modal');
				if (el) {
					el.classList.remove('hidden');
					el.style.display = 'flex';
				}
			}

			function closeApplicantsModal() {
				const el = document.getElementById('job-applicants-modal');
				if (el) {
					el.classList.add('hidden');
					el.style.display = 'none';
				}
			}

			function openOnboardModal(appId, applicantName, jobTitle) {
				document.getElementById('onboard-job-id').value = currentJobId;
				document.getElementById('onboard-app-id').value = appId;
				document.getElementById('onboard-modal-subtitle').textContent = `المتقدم: ${applicantName} • الوظيفة: ${jobTitle}`;
				document.getElementById('onboard-job-title').value = jobTitle || '';
				const modal = document.getElementById('onboard-modal');
				if (modal) {
					modal.classList.remove('hidden');
					modal.style.display = 'flex';
				}
			}

			function closeOnboardModal() {
				const modal = document.getElementById('onboard-modal');
				if (modal) {
					modal.classList.add('hidden');
					modal.style.display = 'none';
				}
			}

			async function viewApplicants(jobId, jobTitle) {
				currentJobId = jobId;
				currentJobTitle = jobTitle;
				document.getElementById('applicants-modal-subtitle').textContent = `الوظيفة: ${jobTitle}`;
				document.getElementById('applicants-modal-content').innerHTML = `
					<div>
						<div>⏳</div>
						<div>جاري استرجاع طلبات التقديم والسير الذاتية...</div>
					</div>
				`;
				openApplicantsModal();

				try {
					const res = await fetch(`/customer/jobs/${jobId}/applications`);
					if (!res.ok) throw new Error('فشل في جلب البيانات');
					const apps = await res.json();

					if (!apps || apps.length === 0) {
						document.getElementById('applicants-modal-content').innerHTML = `
							<div>
								<div>@components.IconMail("icon-sm")</div>
								<h4>لا يوجد متقدمين حتى الآن</h4>
								<p>
									لم يقم أي مستخدم بالتقديم على هذه الوظيفة بعد.
								</p>
							</div>
						`;
						return;
					}

					let html = `<div>`;

					apps.forEach(app => {
						const dateStr = app.created_at ? new Date(app.created_at).toLocaleDateString('ar-EG') : '';
						const cvBtn = app.cv_storage_key 
							? `<a href="${app.cv_storage_key}" target="_blank" class="btn btn-secondary btn-sm">
									<span>@components.IconFile("icon-sm")</span>
									<span>تحميل السيرة الذاتية (CV)</span>
							   </a>`
							: `<span class="text-xs text-muted">لم يرفق CV</span>`;

						let statusBadge = '';
						let actionButtons = '';

						if (app.status === 'accepted' || app.status === 'hired') {
							const branchText = app.branch_name ? `فرع: ${app.branch_name}` : 'الفرع الرئيسي';
							statusBadge = `<span class="badge badge-emerald text-xs fw-700">تم القبول والتعيين (${branchText})</span>`;
						} else if (app.status === 'rejected') {
							statusBadge = `<span class="badge badge-slate text-xs fw-700">تم رفض الطلب</span>`;
						} else {
							statusBadge = `<span class="badge badge-sky text-xs fw-700">⏳ قيد المراجعة</span>`;
							actionButtons = `
								<div>
									<button type="button" class="btn btn-primary btn-sm fw-800" onclick="openOnboardModal(${app.id}, '${app.applicant_name}', '${jobTitle}')">
										<span>@components.IconCheckCircle("icon-sm")</span>
										<span>قبول وتعيين</span>
									</button>
									<button type="button" class="btn btn-secondary btn-sm text-danger" onclick="rejectApplicant(${jobId}, ${app.id})">
										<span>رفض</span>
									</button>
								</div>
							`;
						}

						html += `
							<div>
								<div>
									<div class="inline-row-06">
										<span>${app.applicant_name || 'متقدم'}</span>
										${statusBadge}
									</div>
									<div>
										<span>${app.applicant_email || '-'}</span>
										<span>${app.applicant_phone || '-'}</span>
										<span>${dateStr}</span>
									</div>
								</div>
								<div>
									${cvBtn}
									${actionButtons}
								</div>
							</div>
						`;
					});

					html += `</div>`;
					document.getElementById('applicants-modal-content').innerHTML = html;
				} catch (err) {
					document.getElementById('applicants-modal-content').innerHTML = `
						<div class="alert alert-danger p-md">
							حدث خطأ أثناء تحميل المتقدمين: ${err.message}
						</div>
					`;
				}
			}

			async function submitOnboardEmployee(e) {
				e.preventDefault();
				const jobId = document.getElementById('onboard-job-id').value;
				const appId = document.getElementById('onboard-app-id').value;
				const branchId = document.getElementById('onboard-branch-id').value;
				const roleKey = document.getElementById('onboard-role-key').value;
				const jobTitle = document.getElementById('onboard-job-title').value;
				const baseSalary = document.getElementById('onboard-base-salary').value;
				const notes = document.getElementById('onboard-notes').value;

				const submitBtn = document.getElementById('onboard-submit-btn');
				submitBtn.disabled = true;
				submitBtn.innerHTML = '<span>جاري التعيين...</span>';

				try {
					const res = await fetch(`/customer/jobs/${jobId}/applications/${appId}/accept`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							branch_id: branchId ? parseInt(branchId) : 0,
							role_key: roleKey,
							job_title: jobTitle,
							base_salary: baseSalary,
							notes: notes
						})
					});
					const data = await res.json();
					if (!res.ok || data.error) throw new Error(data.error || 'فشلت العملية');

					closeOnboardModal();
					alert('تم قبول المتقدم وتعيينه كموظف بنجاح وإرسال إشعار رسمي له!');
					viewApplicants(currentJobId, currentJobTitle);
				} catch (err) {
					alert('حدث خطأ: ' + err.message);
				} finally {
					submitBtn.disabled = false;
					submitBtn.innerHTML = '<span>تأكيد القبول وتعيين الموظف</span>';
				}
			}

			async function rejectApplicant(jobId, appId) {
				if (!confirm('هل أنت متأكد من رفض هذا الطلب؟ سيتم إرسال إشعار اعتذار للمتقدم.')) return;
				try {
					const res = await fetch(`/customer/jobs/${jobId}/applications/${appId}/reject`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ notes: 'تمت المراجعة والاعتذار عن الطلب' })
					});
					const data = await res.json();
					if (!res.ok || data.error) throw new Error(data.error || 'فشلت العملية');

					alert('تم رفض الطلب وإرسال إشعار للمتقدم.');
					viewApplicants(currentJobId, currentJobTitle);
				} catch (err) {
					alert('حدث خطأ: ' + err.message);
				}
			}

			// Close on backdrop click
			window.addEventListener('click', function(e) {
				const addModal = document.getElementById('add-job-modal');
				const editModal = document.getElementById('edit-job-modal');
				const appModal = document.getElementById('job-applicants-modal');
				const onbModal = document.getElementById('onboard-modal');
				if (e.target === addModal) closeAddJobModal();
				if (e.target === editModal) closeEditJobModal();
				if (e.target === appModal) closeApplicantsModal();
				if (e.target === onbModal) closeOnboardModal();
			});
		</script>
	}
}
