package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)


templ SettingsEmployees(employees []*org.EmployeeView, branches []*org.Branch, roles []*org.Role, lang, dir string, actor authctx.Actor) {
	@layouts.ShellFor("إدارة الموظفين ومدراء الفروع | Team & Managers", "employees", lang, dir, actor) {

  <div class="stack-sm">

			<!-- Top Header Card -->
   <div class="stack-sm">
    <div class="stack-sm">
					<div class="stack-xs text-sm">
						@components.IconUsers("icon-sm")
					</div>
     <div class="stack-sm">
						<h1 class="page-title font-bold text-xl m-0">
							منظومة الموظفين ومدراء الفروع المعتمدين
						</h1>
      <p class="text-sm text-secondary m-0">
							إدارة حسابات الصيادلة والموظفين، وتعيين مدير مسؤول لكل فرع ونقطة توزيع.
						</p>
					</div>
				</div>

				<div class="row-center">
					<a href="/vendor/roles" class="btn btn-secondary btn-sm font-bold">
						<span>إدارة الأدوار والصلاحيات</span>
					</a>
					<a href="#new-employee-panel" class="btn btn-primary btn-sm font-bold">
						@components.IconPlus("icon-xs")
						<span>+ إضافة موظف جديد</span>
					</a>
				</div>
			</div>

			<!-- In-Page Embedded Form Panel: Add New Employee (NO floating modal overlay) -->
			<div class="stack-sm" id="new-employee-panel">
    <div class="stack-sm">
					<div class="row-center">
						<div class="stack-xs text-sm">
							@components.IconUser("icon-sm")
						</div>
      <div class="stack-sm">
							<h2 class="text-lg fw-800 text-primary m-0">
								إضافة وتعيين حساب موظف / مدير جديد
							</h2>
       <p class="text-sm text-secondary m-0">
								أدخل البيانات وسيقوم النظام بربط الموظف بالدور والفرع المختار
							</p>
						</div>
					</div>
				</div>

				<form method="POST" action="/settings/employees/create" class="stack-115">
     <div class="stack-sm">
      <div class="stack-sm">
							<label class="form-label">
								اسم الموظف بالكامل <span class="text-danger">*</span>
							</label>
							<input type="text" name="name" placeholder="د. أحمد محمود" class="form-input w-full" required/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								البريد الإلكتروني الرسمي <span class="text-danger">*</span>
							</label>
							<input type="email" name="email" placeholder="pharmacist@example.com" class="form-input tabular-nums w-full" required/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								رقم الهاتف / الواتساب
							</label>
							<input type="tel" name="phone" placeholder="01012345678" class="form-input tabular-nums w-full"/>
						</div>
					</div>

     <div class="stack-sm">
      <div class="stack-sm">
							<label class="form-label">
								المسمى الوظيفي <span class="text-danger">*</span>
							</label>
							<input type="text" name="job_title" placeholder="مدير فرع / صيدلي مسؤول" class="form-input w-full" required/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								كود الموظف الداخلي
							</label>
							<input type="text" name="employee_code" placeholder="EMP-0101" class="form-input tabular-nums w-full"/>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								الدور والصلاحيات
							</label>
							<select name="role_key" class="form-input w-full">
								<option value="org_manager">مدير فرع / عمليات (Branch Manager)</option>
								<option value="org_pharmacist">صيدلي مسؤول (Pharmacist)</option>
								<option value="org_warehouse">أمين مخزن وتوزيع (Warehouse)</option>
								<option value="org_accountant">محاسب مالي (Accountant)</option>
								for _, r := range roles {
									if r.Key != "org_owner" && r.Key != "org_manager" && r.Key != "org_pharmacist" && r.Key != "org_warehouse" && r.Key != "org_accountant" {
										<option value={ r.Key }>{ r.Name.Get(i18n.Lang(lang)) }</option>
									}
								}
							</select>
						</div>
					</div>

     <div class="stack-sm">
      <div class="stack-sm">
							<label class="form-label">
								الفرع المخصص
							</label>
							<select name="branch_id" class="form-input w-full">
								<option value="">كافة الفروع (صلاحية عامة)</option>
								for _, b := range branches {
									<option value={ fmt.Sprintf("%d", b.ID) }>
										if b.Name["ar"] != "" {
											{ b.Name["ar"] }
										} else {
											{ b.Name["en"] }
										}
									</option>
								}
							</select>
						</div>

      <div class="stack-sm">
							<label class="form-label">
								الراتب الأساسي (ج.م)
							</label>
							<input type="number" name="base_salary" placeholder="8000" class="form-input tabular-nums w-full"/>
						</div>
					</div>

     <div class="stack-sm">
      <div class="stack-sm">
							<span>ℹ️ سيتم تطبيق الصلاحيات والوصول للفرع المحدد تلقائياً وفقاً للدور المختار.</span>
						</div>

						<button type="submit" class="btn btn-primary">
							@components.IconCheck("icon-xs")
							<span>حفظ وإضافة الموظف الآن</span>
						</button>
					</div>
				</form>
			</div>


			<!-- Section 1: Branch Managers Assignment (توزيع وتعيين مدراء الفروع) -->
   <div class="stack-sm">
    <div class="stack-sm">
					<div class="stack-xs text-sm">
						@components.IconBuilding("icon-xs")
					</div>
     <div class="stack-sm">
						<h3 class="text-lg fw-800 text-primary m-0">
							تعيين مدراء الفروع ونقاط التوزيع
						</h3>
      <p class="text-sm text-secondary m-0">
							يتم تعيين مدير لكل فرع من بين حسابات الموظفين المسجلين في النظام.
						</p>
					</div>
				</div>

				if len(branches) == 0 {
     <div class="stack-sm">
						لم يتم تسجيل أي فروع للمنشأة بعد. يمكنك إضافة فروع من <a href="/vendor/branches">صفحة الفروع ونقاط التوزيع</a>.
					</div>
				} else {
     <div class="stack-sm">
						for _, b := range branches {
       <div class="stack-sm">
        <div class="stack-sm">
         <div class="stack-sm">
          <div class="stack-sm">
											<strong>
												if b.Name["ar"] != "" {
													{ b.Name["ar"] }
												} else {
													{ b.Name["en"] }
												}
											</strong>
											if b.IsMain {
												<span class="badge badge-emerald">الفرع الرئيسي</span>
											}
										</div>
										<span class="badge badge-sky tabular-nums text-xs">{ b.Code }</span>
									</div>

         <div class="stack-sm">
										<span>العنوان: </span><strong>{ b.Address }</strong>
									</div>

									<!-- Current Manager Status -->
         <div class="stack-sm">
										<span class="text-muted">المدير الحالي: </span>
										if b.ManagerID != nil && *b.ManagerID > 0 {
											<strong class="text-accent">
												if b.ManagerName != "" {
													{ b.ManagerName }
												} else if b.ManagerEmail != "" {
													{ b.ManagerEmail }
												} else {
													<span>مدير فرع معين</span>
												}
											</strong>
										} else {
											<span class="text-muted">غير معين حالياً</span>
										}
									</div>
								</div>

								<!-- Quick Assign Manager Dropdown -->
								<form class="stack-md" method="POST" action="/settings/employees/assign-manager">
									<input type="hidden" name="branch_id" value={ fmt.Sprintf("%d", b.ID) }/>
									<select name="manager_user_id" class="form-input">
										<option value="0">-- إلغاء تعيين المدير --</option>
										for _, emp := range employees {
											<option
												value={ fmt.Sprintf("%d", emp.Member.UserID) }
												selected?={ b.ManagerID != nil && *b.ManagerID == emp.Member.UserID }
											>
												{ emp.UserName } ({ emp.RoleName })
											</option>
										}
									</select>
									<button type="submit" class="btn btn-secondary btn-sm">
										<span>حفظ</span>
									</button>
								</form>
							</div>
						}
					</div>
				}
			</div>

			<!-- Section 2: Employees Directory List (جدول الموظفين والصلاحيات) -->
   <div class="stack-sm">
    <div class="stack-sm">
     <div class="stack-sm">
						<h3 class="text-lg fw-800 text-primary m-0">
							سجل الموظفين وفريق العمل
						</h3>
      <p class="text-sm text-secondary m-0">
							جميع أعضاء المنشأة والصيادلة المرتبطين بصلاحيات التشغيل.
						</p>
					</div>

					<span class="badge badge-sky tabular-nums">
						{ fmt.Sprintf("%d", len(employees)) } موظف مسجل
					</span>
				</div>

				if len(employees) == 0 {
					<div class="stack-xs text-sm">
						لا يوجد موظفون مضافون حالياً. استخدم نموذج الإضافة أعلاه لإضافة أول موظف.
					</div>
				} else {
     <div class="stack-sm">
      <table class="data-table">
							<thead>
								<tr>
									<th class="pad-md">الموظف</th>
									<th class="pad-md">المسمى والكود</th>
									<th class="pad-md">الدور</th>
									<th class="pad-md">الفرع</th>
									<th class="pad-md">الرتبة</th>
									<th class="pad-md">الراتب الأساسي</th>
									<th class="pad-md">الحالة</th>
									<th class="col-actions">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, emp := range employees {
									<tr class="rule-bottom">
										<td>
											<div class="fw-800 text-primary">{ emp.UserName }</div>
											<div class="tabular-nums">{ emp.UserEmail } • { emp.UserPhone }</div>
										</td>
										<td>
											<div class="font-bold text-primary">{ emp.Member.JobTitle }</div>
											if emp.Member.EmployeeCode != "" {
												<div class="stack-xs text-sm">{ emp.Member.EmployeeCode }</div>
											}
										</td>
										<td>
											<span>
												{ emp.RoleName }
											</span>
										</td>
										<td>
											if emp.BranchName != "" {
												<span>{ emp.BranchName }</span>
											} else {
												<span class="badge badge-gray text-xs">كافة الفروع</span>
											}
										</td>
										<td>
											if emp.IsManager {
												<span class="badge badge-emerald">
													@components.IconCheck("icon-xs")
													<span>مدير فرع معتمد</span>
												</span>
											} else {
												<span>موظف تشغيل</span>
											}
										</td>
										<td class="tabular-nums">
											if emp.Member.BaseSalary.Minor() > 0 {
												{ format.Money(emp.Member.BaseSalary, "ar") }
											} else {
												<span class="text-muted">—</span>
											}
										</td>
										<td>
											if emp.Member.IsActive {
												<span class="badge badge-emerald text-xs">نشط</span>
											} else {
												<span class="badge badge-slate text-xs">معطل</span>
											}
										</td>
										<td class="col-actions">
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/settings/employees/%d/delete", emp.Member.UserID)) } class="m-0 inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الموظف من المنشأة؟');">
												<button type="submit" class="btn btn-secondary btn-xs">
													<span>حذف</span>
												</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
