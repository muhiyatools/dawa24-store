package pages

import (
	"fmt"
	"strings"

	"github.com/muhiya/dawa24-store/internal/modules/assistant"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type AdminChatHistoryData struct {
	SearchQuery string
	Page        int
	PerPage     int
	TotalCount  int
	Stats       *assistant.AssistantStats
	AIConvs     []*assistant.ConversationSummary
}

// AdminChatHistoryPage renders conversation threads list for AI Assistant.
templ AdminChatHistoryPage(data AdminChatHistoryData, lang, dir string) {
	@layouts.AdminShell("سجلات محادثات المساعد الذكي كبسولة AI", "chat_history", lang, dir) {
		<div class="page-container">
			
			<!-- Header -->
			<div class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							✨
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">سجلات محادثات المساعد الذكي كبسولة AI</h1>
							<p class="text-sm text-secondary m-0 mt-1">مراقبة وتدقيق كافة جلسات ومحادثات الذكاء الاصطناعي مع المستخدمين (صيدليات وموردين) واستهلاك الرموز وتفاصيل الحوارات</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Stats Overview Cards -->
			if data.Stats != nil {
				<div class="dashboard-stat-grid mb-6">
					<div class="stat-card-3d">
						<div class="text-xs font-bold text-muted mb-1">إجمالي الجلسات</div>
						<div class="text-2xl font-black text-primary tabular-nums">{ fmt.Sprintf("%d", data.Stats.TotalConversations) }</div>
					</div>
					<div class="stat-card-3d">
						<div class="text-xs font-bold text-muted mb-1">إجمالي الرسائل المتبادلة</div>
						<div class="text-2xl font-black text-brand tabular-nums">{ fmt.Sprintf("%d", data.Stats.TotalMessages) }</div>
					</div>
					<div class="stat-card-3d">
						<div class="text-xs font-bold text-muted mb-1">المستخدمون النشطون</div>
						<div class="text-2xl font-black text-success tabular-nums">{ fmt.Sprintf("%d", data.Stats.ActiveUsers) }</div>
					</div>
					<div class="stat-card-3d">
						<div class="text-xs font-bold text-muted mb-1">إجمالي الرموز (Tokens)</div>
						<div class="text-xl font-black text-primary tabular-nums">
							<span>{ fmt.Sprintf("%d", data.Stats.TotalInputTokens + data.Stats.TotalOutputTokens) }</span>
							<span class="text-xs text-muted font-normal block mt-0.5">({ fmt.Sprintf("إدخال %d / توليد %d", data.Stats.TotalInputTokens, data.Stats.TotalOutputTokens) })</span>
						</div>
					</div>
				</div>
			}

			<!-- Filter / Search Bar -->
			<div class="glass-panel p-4 mb-6">
				<form method="GET" action="/admin/chat/history" class="d-flex gap-3 items-center flex-wrap m-0">
					<div class="flex-1" style="min-width:240px;">
						<input
							type="text"
							name="q"
							value={ data.SearchQuery }
							placeholder="البحث باسم المستخدم، البريد الإلكتروني، الهاتف، اسم المنشأة، أو موضوع الجلسة..."
							class="form-input text-xs w-full"
						/>
					</div>
					<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-3">
						@components.IconSearch("icon-xs")
						<span>بحث وتصفية</span>
					</button>
					if data.SearchQuery != "" {
						<a href="/admin/chat/history" class="btn btn-secondary btn-sm text-xs">
							@components.IconClose("icon-xs")
							<span>إلغاء التصفية</span>
						</a>
					}
				</form>
			</div>

			<!-- AI Assistant Conversations Table -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(data.AIConvs) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">✨</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد جلسات مطابقة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يتم العثور على أي جلسات محادثة للذكاء الاصطناعي تطابق معايير البحث.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table m-0">
						<thead>
							<tr>
								<th>#</th>
								<th>المستخدم المنشئ</th>
								<th>المنشأة</th>
								<th>عنوان / موضوع الجلسة</th>
								<th>عدد الرسائل</th>
								<th>استهلاك الرموز (Tokens)</th>
								<th>تاريخ البدء</th>
								<th>آخر نشاط</th>
								<th class="text-end">الإجراءات</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range data.AIConvs {
								<tr>
									<td class="tabular-nums">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/chat/ai/%d", c.ID)) } class="fw-700 text-primary">
											#{ fmt.Sprintf("%d", c.ID) }
										</a>
									</td>
									<td>
										<div class="fw-700 text-primary">{ c.UserName }</div>
										if c.UserRole != "" {
											<span class="badge badge-slate" style="font-size:0.68rem; margin-top:0.15rem;">{ c.UserRole }</span>
										}
										if c.UserPhone != "" {
											<div class="text-xs text-muted" dir="ltr">{ c.UserPhone }</div>
										} else if c.UserEmail != "" {
											<div class="text-xs text-muted" dir="ltr">{ c.UserEmail }</div>
										}
									</td>
									<td>
										<div style="font-weight:600; color:var(--text);">{ c.OrganizationName }</div>
										<div style="display:flex; align-items:center; gap:0.4rem; margin-top:0.15rem;">
											if c.OrganizationType == "vendor" {
												<span class="badge badge-sky" style="font-size:0.68rem;">مورد</span>
											} else if c.OrganizationType == "customer" {
												<span class="badge badge-emerald" style="font-size:0.68rem;">صيدلية</span>
											}
											<span class="text-xs text-muted">منشأة #{ fmt.Sprintf("%d", c.OrganizationID) }</span>
										</div>
									</td>
									<td>
										<div style="max-width:280px; font-size:0.875rem;">
											if c.Title != "" {
												<a href={ templ.SafeURL(fmt.Sprintf("/admin/chat/ai/%d", c.ID)) } style="color:var(--text); text-decoration:none; font-weight:700; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title={ c.Title }>
													{ c.Title }
												</a>
											} else {
												<span style="color:var(--text-muted); font-style:italic;">محادثة بدون عنوان</span>
											}
										</div>
									</td>
									<td class="tabular-nums">
										<span class="badge badge-emerald">{ fmt.Sprintf("%d رسائل", c.MessageCount) }</span>
									</td>
									<td class="tabular-nums text-sm">
										<div><span class="text-muted">إدخال:</span> { fmt.Sprintf("%d", c.TotalInputTokens) }</div>
										<div><span class="text-muted">توليد:</span> { fmt.Sprintf("%d", c.TotalOutputTokens) }</div>
									</td>
									<td class="text-sm text-muted tabular-nums">
										{ c.CreatedAt.Format("2006-01-02 15:04") }
									</td>
									<td class="text-sm text-secondary tabular-nums">
										{ c.UpdatedAt.Format("2006-01-02 15:04") }
									</td>
									<td class="text-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/chat/ai/%d", c.ID)) } class="btn btn-secondary btn-sm fw-700" style="gap:0.35rem;">
											@components.IconEye("icon-xs")
											<span>عرض المحادثة</span>
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				</div>
			}
			</div>

		</div>
	}
}

// AdminAIChatDetailPage renders full messages transcript for an AI assistant conversation.
templ AdminAIChatDetailPage(summary *assistant.ConversationSummary, msgs []*assistant.Message, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("محادثة ذكاء اصطناعي #%d", summary.ID), "chat_history", lang, dir) {
		<div style="max-width:960px; margin:0 auto; display:flex; flex-direction:column; gap:1.25rem;">
			
			<!-- Header Card -->
			<div class="card mb-0">
				<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap;">
					<div>
						<div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
							<span class="badge badge-emerald">جلسة مساعد كبسولة AI</span>
							<span class="tabular-nums" style="font-weight:800; color:var(--text); font-size:1.15rem;">#{ fmt.Sprintf("%d", summary.ID) }</span>
						</div>
						<h2 style="font-size:1.35rem; font-weight:800; margin:0.25rem 0; color:var(--text);">
							if summary.Title != "" {
								{ summary.Title }
							} else {
								<span>محادثة كبسولة</span>
							}
						</h2>
						<div style="font-size:0.825rem; color:var(--text-secondary); margin-top:0.4rem; display:flex; gap:1.25rem; flex-wrap:wrap;">
							<div>👤 <strong>المستخدم:</strong> { summary.UserName } ({ summary.UserEmail })</div>
							<div>🏢 <strong>المنشأة:</strong> { summary.OrganizationName } (#{ fmt.Sprintf("%d", summary.OrganizationID) })</div>
							<div>📅 <strong>تاريخ البدء:</strong> { summary.CreatedAt.Format("2006-01-02 15:04") }</div>
							<div>⏱️ <strong>آخر نشاط:</strong> { summary.UpdatedAt.Format("2006-01-02 15:04") }</div>
						</div>
					</div>

					<div class="row-center-sm">
						<a href="/admin/chat/history" class="btn btn-secondary btn-sm" style="font-weight:700; gap:0.35rem;">
							@components.IconArrowRight("icon-xs")
							<span>العودة لقائمة السجلات</span>
						</a>
					</div>
				</div>

				<!-- Stats Strip -->
				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.75rem; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--border);">
					<div style="background:var(--surface-sunken); padding:0.6rem 0.85rem; border-radius:var(--radius-md);">
						<div style="font-size:0.725rem; color:var(--text-muted);">إجمالي الرسائل</div>
						<div style="font-size:1.15rem; font-weight:800; color:var(--text);" class="tabular-nums">{ fmt.Sprintf("%d", len(msgs)) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.6rem 0.85rem; border-radius:var(--radius-md);">
						<div style="font-size:0.725rem; color:var(--text-muted);">رموز الإدخال (Input)</div>
						<div style="font-size:1.15rem; font-weight:800; color:var(--text);" class="tabular-nums">{ fmt.Sprintf("%d", summary.TotalInputTokens) }</div>
					</div>
					<div style="background:var(--surface-sunken); padding:0.6rem 0.85rem; border-radius:var(--radius-md);">
						<div style="font-size:0.725rem; color:var(--text-muted);">رموز التوليد (Output)</div>
						<div style="font-size:1.15rem; font-weight:800; color:var(--text);" class="tabular-nums">{ fmt.Sprintf("%d", summary.TotalOutputTokens) }</div>
					</div>
				</div>
			</div>

			<!-- Transcript -->
			<div class="card mb-0 p-card">
				<h3 style="font-size:1.05rem; font-weight:800; margin:0 0 1.25rem 0; border-bottom:1px solid var(--border); padding-bottom:0.5rem; display:flex; align-items:center; gap:0.4rem;">
					@components.IconFileText("icon-xs")
					<span>سجل الحوار والرسائل الكامل (Full Transcript)</span>
				</h3>

				if len(msgs) == 0 {
					@components.EmptyState(components.EmptyStateProps{Title: "لا توجد رسائل مسجلة", Message: "هذه الجلسة لا تحتوي على رسائل."})
				} else {
					<div class="stack-lg">
						for _, m := range msgs {
							if m.Role == "user" {
								<!-- User Bubble -->
								<div style="display:flex; justify-content:flex-start;">
									<div style="max-width:85%; background:var(--surface-sunken); border:1px solid var(--border); border-radius:18px 18px 4px 18px; padding:0.85rem 1.15rem;">
										<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.35rem; font-size:0.75rem; color:var(--text-muted);">
											<span style="font-weight:700; color:var(--accent);">👤 { summary.UserName }</span>
											<span class="tabular-nums">{ m.CreatedAt.Format("15:04:05") }</span>
										</div>
										<div style="font-size:0.9rem; line-height:1.6; color:var(--text); white-space:pre-wrap;" dir="auto">{ m.Content }</div>
										if len(m.Attachments) > 0 {
											<div style="margin-top:0.75rem; display:flex; flex-wrap:wrap; gap:0.6rem;">
												for _, att := range m.Attachments {
													<div style="border:1px solid var(--border); border-radius:var(--radius-md); overflow:hidden; background:var(--surface); max-width:260px;">
														if strings.HasPrefix(att.MIMEType, "image/") || strings.HasPrefix(att.DataURL, "data:image/") {
															<a href={ templ.SafeURL(att.DataURL) } target="_blank" title="عرض الصورة بالحجم الكامل">
																<img 
																	src={ att.DataURL } 
																	alt={ att.Filename } 
																	style="width:100%; max-height:160px; object-fit:cover; display:block; cursor:pointer; background:var(--surface-sunken);" 
																/>
															</a>
														}
														<div style="padding:0.35rem 0.55rem; font-size:0.75rem; color:var(--text-secondary); display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
															<span style="font-weight:600; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;" title={ att.Filename }>
																📎 { att.Filename }
															</span>
															if att.SizeMB > 0 {
																<span style="color:var(--text-muted); font-size:0.7rem;" class="tabular-nums">{ fmt.Sprintf("%.2f MB", att.SizeMB) }</span>
															}
														</div>
													</div>
												}
											</div>
										}
									</div>
								</div>
							} else if m.Role == "assistant" {
								<!-- Assistant Bubble -->
								<div style="display:flex; justify-content:flex-start;">
									<div style="width:100%; background:var(--surface-raised); border:1px solid var(--border); border-radius:18px 18px 18px 4px; padding:1rem 1.25rem;">
										<div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.5rem; font-size:0.75rem; color:var(--text-muted);">
											<span style="font-weight:700; color:#0284c7; display:flex; align-items:center; gap:0.3rem;">
												@components.IconSparkles("icon-xxs")
												<span>المساعد كبسولة AI</span>
												if m.ModelRole != "" {
													<code style="font-size:0.7rem; background:var(--surface-sunken); padding:0.1rem 0.3rem; border-radius:3px;">{ m.ModelRole }</code>
												}
											</span>
											<span class="tabular-nums">{ m.CreatedAt.Format("15:04:05") } ({ fmt.Sprintf("%d tokens", m.OutputTokens) })</span>
										</div>
										<div style="font-size:0.9rem; line-height:1.65; color:var(--text); white-space:pre-wrap;" dir="auto">{ m.Content }</div>
									</div>
								</div>
							}
						}
					</div>
				}
			</div>

		</div>
	}
}

