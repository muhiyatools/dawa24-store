package pages

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// MarketDiscountsPage renders market-wide approved discounts with responsive views, filters, and pagination.
templ MarketDiscountsPage(lang, dir string, actor authctx.Actor, result *compare.MarketDiscountsResult, filter compare.MarketDiscountsFilter, currentView string) {
	@layouts.ShellFor("خصومات السوق العامة | دواء 24", "market-discounts", lang, dir, actor) {
		<div
			class="page-container"
			x-data={ fmt.Sprintf("{ showMoreFilters: %t, currentView: '%s', setView(v) { this.currentView = v; localStorage.setItem('d24_market_view', v); }, init() { const saved = localStorage.getItem('d24_market_view'); if (saved && (saved === 'list' || saved === 'grid')) { this.currentView = saved; } } }", (filter.MinPrice != nil || filter.MaxPrice != nil || filter.MinDiscount != nil || filter.MaxDiscount != nil), currentView) }
		>
			<!-- 1. Sleek Integrated Header & KPI Bar -->
			<div class="glass-panel p-4 mb-0">
				<div class="flex-between items-center flex-wrap gap-3">
     <div class="stack-sm">
						<div class="d-flex items-center gap-2 mb-1">
							<span class="text-xl">@components.IconTag("icon-sm")</span>
							<h1 class="text-xl font-black text-primary m-0">
								خصومات السوق العامة
							</h1>
							<span class="badge badge-sky text-xs font-bold tabular-nums">
								{ fmt.Sprintf("%d عرض متاح", result.TotalCount) }
							</span>
						</div>
						<p class="text-xs text-secondary m-0">
							مقارنة الخصومات وأسعار التوريد اللحظية المرفوعة من الموزعين والمستودعات الطبية في السوق.
						</p>
					</div>

					<!-- Compact KPI Chips -->
					<div class="d-flex items-center gap-2 flex-wrap">
						<div class="bg-surface-sunken border rounded-lg p-2 px-3 text-center">
							<span class="text-xs text-muted d-block font-bold">الشركات</span>
							<strong class="text-brand text-sm tabular-nums font-black">{ fmt.Sprintf("%d", len(result.AvailableSuppliers)) }</strong>
						</div>

						<div class="bg-surface-sunken border rounded-lg p-2 px-3 text-center">
							<span class="text-xs text-muted d-block font-bold">أعلى خصم</span>
							<strong class="text-success text-sm tabular-nums font-black">{ fmt.Sprintf("%.1f%%", calculateMaxDiscount(result.Items)) }</strong>
						</div>

						<a href="/compare/tool" class="btn btn-primary btn-sm font-bold text-xs px-3 py-2 gap-1">
							@components.IconTrendingUp("icon-xs")
							<span>محرك المقارنة</span>
						</a>
					</div>
				</div>
			</div>

			<!-- 2. Compact Filter Deck -->
			<div class="glass-panel p-4 mb-0">
				<form method="GET" action="/market-discounts" class="d-flex flex-col gap-3 m-0" id="market-filter-form">
					<input type="hidden" name="view" x-bind:value="currentView" />

					<!-- Main Filter Row -->
					<div class="d-flex items-center gap-3 flex-wrap">
						<!-- Search Input -->
						<div class="flex-1">
							<input
								type="text"
								name="q"
								value={ filter.Query }
								class="form-input text-xs w-full"
								placeholder="بحث باسم الدواء، المادة الفعالة، SKU، الباركود..."
							/>
						</div>

						<!-- Supplier Select -->
      <div class="stack-sm">
							<select name="supplier" class="form-input text-xs w-full" onchange="this.form.submit()">
								<option value="">كافة الشركات ({ fmt.Sprintf("%d", len(result.AvailableSuppliers)) })</option>
								for _, sup := range result.AvailableSuppliers {
									<option value={ sup } selected?={ filter.Supplier == sup }>{ sup }</option>
								}
							</select>
						</div>

						<!-- Sort Order -->
      <div class="stack-sm">
							<select name="sort" class="form-input text-xs w-full" onchange="this.form.submit()">
								<option value="discount_desc" selected?={ filter.SortBy == "" || filter.SortBy == "discount_desc" }>الأعلى خصماً </option>
								<option value="price_asc" selected?={ filter.SortBy == "price_asc" }>الأقل سعراً </option>
								<option value="price_desc" selected?={ filter.SortBy == "price_desc" }>الأعلى سعراً</option>
								<option value="newest" selected?={ filter.SortBy == "newest" }>الأحدث إضافة </option>
								<option value="oldest" selected?={ filter.SortBy == "oldest" }>الأقدم</option>
							</select>
						</div>

						<!-- Page Size Limit -->
      <div class="stack-sm">
							<select name="limit" class="form-input text-xs w-full" onchange="this.form.submit()">
								<option value="24" selected?={ filter.Limit == 24 || filter.Limit == 0 }>24 عنصر</option>
								<option value="48" selected?={ filter.Limit == 48 }>48 عنصر</option>
								<option value="96" selected?={ filter.Limit == 96 }>96 عنصر</option>
							</select>
						</div>

						<!-- Advanced Toggle & Search Submit -->
						<button
							type="button"
							@click="showMoreFilters = !showMoreFilters"
							class="btn btn-secondary btn-sm text-xs font-bold px-3"
							title="نطاق السعر والخصم"
						>
							<span x-text="showMoreFilters ? '▲ إخفاء النطاق' : 'نطاق متقدم'"></span>
						</button>

						<button type="submit" class="btn btn-primary btn-sm font-black text-xs px-4">
							@components.IconSearch("icon-xs")
							<span>بحث</span>
						</button>

						<!-- View Switcher -->
						<div class="cb-tabs-nav m-0">
							<button
								type="button"
								@click="setView('list')"
								class="cb-tab-btn"
								:class="{ 'active': currentView === 'list' }"
								title="عرض كقائمة"
							>
								<span>☰</span>
							</button>
							<button
								type="button"
								@click="setView('grid')"
								class="cb-tab-btn"
								:class="{ 'active': currentView === 'grid' }"
								title="عرض ككروت"
							>
								<span>⊞</span>
							</button>
						</div>

						if filter.Query != "" || filter.Supplier != "" || filter.MinPrice != nil || filter.MaxPrice != nil || filter.MinDiscount != nil || filter.MaxDiscount != nil {
							<a href="/market-discounts" class="btn btn-secondary btn-sm text-xs">
								إلغاء الفلاتر
							</a>
						}
					</div>

					<!-- Collapsible Advanced Range Filters -->
					<div x-show="showMoreFilters" x-cloak x-transition.opacity class="pt-3 border-t">
						<!-- Price Range -->
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-secondary mb-1 d-block">
								نطاق السعر الصافي بعد الخصم (ج.م)
							</label>
							<div class="d-flex gap-2 items-center">
								<input
									type="number"
									step="0.5"
									name="min_price"
									value={ formatOptionalFloat(filter.MinPrice) }
									class="form-input text-xs flex-1"
									placeholder="من سعر"
								/>
								<span class="text-muted">-</span>
								<input
									type="number"
									step="0.5"
									name="max_price"
									value={ formatOptionalFloat(filter.MaxPrice) }
									class="form-input text-xs flex-1"
									placeholder="إلى سعر"
								/>
							</div>
						</div>

						<!-- Discount Range -->
      <div class="stack-sm">
							<label class="form-label text-xs font-bold text-secondary mb-1 d-block">
								نطاق نسبة الخصم (%)
							</label>
							<div class="d-flex gap-2 items-center">
								<input
									type="number"
									step="1"
									name="min_discount"
									value={ formatOptionalFloat(filter.MinDiscount) }
									class="form-input text-xs flex-1"
									placeholder="من خصم %"
								/>
								<span class="text-muted">-</span>
								<input
									type="number"
									step="1"
									name="max_discount"
									value={ formatOptionalFloat(filter.MaxDiscount) }
									class="form-input text-xs flex-1"
									placeholder="إلى خصم %"
								/>
							</div>
						</div>
					</div>
				</form>
			</div>

			<!-- 3. Results Surface -->
			if len(result.Items) == 0 {
				<div class="glass-panel p-12 text-center empty-state-glass">
					<div class="text-4xl mb-3">@components.IconSearch("icon-sm")</div>
					<h3 class="text-lg font-black text-primary mb-2">
						لم نجد أي خصومات مطابقة
					</h3>
					<p class="text-sm text-secondary max-w-md mx-auto mb-6">
						جرب البحث بكلمات أخرى، أو تغيير خيارات الشركة الموردة ونطاقات الأسعار والخصومات المحددة.
					</p>
					<a href="/market-discounts" class="btn btn-primary font-bold text-xs">
						عرض كافة خصومات السوق
					</a>
				</div>
			} else {
				<!-- 1. LIST VIEW -->
				<div class="stack-sm" x-show="currentView === 'list'" x-cloak>
					for _, item := range result.Items {
						<div class="glass-panel p-4 flex-between items-center flex-wrap gap-4">
							<!-- Right: Product Name & SKU -->
       <div class="stack-sm">
								<h3 class="text-base font-black text-primary m-0 mb-1 leading-snug">
									{ item.ProductName }
								</h3>
								<div class="d-flex items-center gap-2 text-xs text-secondary">
									<span>الكود:</span>
									if item.SKU != "" {
										<strong class="tabular-nums font-mono text-primary font-bold">{ item.SKU }</strong>
									} else {
										<strong class="tabular-nums font-mono text-muted font-bold">#{ fmt.Sprintf("%d", item.ID) }</strong>
									}
									if item.InCatalog {
										<span class="badge badge-sky text-xs font-bold">
											معتمد
										</span>
									}
								</div>
							</div>

							<!-- Center: Warehouse Pill & Date -->
							<div class="text-center">
								<div class="badge badge-primary text-xs font-bold py-1 px-3">
									{ item.SupplierName }
								</div>
								<div class="text-xs text-muted mt-1 tabular-nums">
									تاريخ العرض: <strong class="text-secondary">{ item.CreatedAt.Format("2006-01-02") }</strong>
								</div>
							</div>

							<!-- Left: Discount Pill + Public Price & Total Price -->
							<div class="d-flex items-center gap-4 justify-end">
								<!-- Discount Badge Pill -->
        <div class="stack-sm">
									if item.DiscountPercent >= 40 {
										<div class="badge badge-rose text-xs font-black py-2 px-3">
											{ formatDiscount(item.DiscountPercent) }% خصم
										</div>
									} else {
										<div class="badge badge-emerald text-xs font-black py-2 px-3">
											{ formatDiscount(item.DiscountPercent) }% خصم
										</div>
									}
								</div>

								<!-- Prices Column -->
								<div class="text-end">
									<div class="text-base font-black text-primary tabular-nums">
										{ formatDiscountPrice(item.PriceAfterDiscount) } ج.م
									</div>
									if item.OriginalPrice.Minor() > 0 {
										<div class="text-xs text-muted tabular-nums line-through">
											{ formatDiscountPrice(item.OriginalPrice) } ج.م
										</div>
									}
								</div>

								<!-- Quick Order / Cart Action -->
        <div class="stack-sm">
									if item.InCatalog && item.MatchedProductID != nil {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", *item.MatchedProductID)) }
											class="btn btn-secondary btn-sm font-bold text-xs"
											title="عرض في الكتالوج والشراء"
										>
											@components.IconCart("icon-xs")
											<span>طلب</span>
										</a>
									} else {
										<button
											type="button"
											class="btn btn-secondary btn-sm font-bold text-xs"
											disabled
											title="غير متاح للطلب الفوري عبر السلة"
										>
											<span>معاينة</span>
										</button>
									}
								</div>
							</div>
						</div>
					}
				</div>

				<!-- 2. GRID VIEW -->
				<div class="stack-sm" x-show="currentView === 'grid'" x-cloak>
					for _, item := range result.Items {
						<div class="glass-panel p-5 d-flex flex-col justify-between gap-4">
       <div class="stack-sm">
								<div class="flex-between items-center mb-2">
									<span class="badge badge-primary text-xs font-bold">
										{ item.SupplierName }
									</span>
									if item.DiscountPercent >= 40 {
										<span class="badge badge-rose text-xs font-black">
											{ formatDiscount(item.DiscountPercent) }% خصم
										</span>
									} else {
										<span class="badge badge-emerald text-xs font-black">
											{ formatDiscount(item.DiscountPercent) }% خصم
										</span>
									}
								</div>

								<h3 class="text-base font-black text-primary m-0 mb-1 leading-snug">
									{ item.ProductName }
								</h3>

								<div class="text-xs text-secondary mt-1">
									<span>الكود: </span>
									if item.SKU != "" {
										<strong class="tabular-nums font-mono text-primary font-bold">{ item.SKU }</strong>
									} else {
										<strong class="tabular-nums font-mono text-muted font-bold">#{ fmt.Sprintf("%d", item.ID) }</strong>
									}
								</div>
							</div>

							<div class="border-t pt-3 flex-between items-center">
        <div class="stack-sm">
									<div class="text-lg font-black text-primary tabular-nums">
										{ formatDiscountPrice(item.PriceAfterDiscount) } ج.م
									</div>
									if item.OriginalPrice.Minor() > 0 {
										<div class="text-xs text-muted tabular-nums line-through">
											{ formatDiscountPrice(item.OriginalPrice) } ج.م
										</div>
									}
								</div>

        <div class="stack-sm">
									if item.InCatalog && item.MatchedProductID != nil {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", *item.MatchedProductID)) }
											class="btn btn-primary btn-sm font-bold text-xs gap-1"
										>
											@components.IconCart("icon-xs")
											<span>شراء</span>
										</a>
									}
								</div>
							</div>
						</div>
					}
				</div>

				<!-- Pagination Footer Deck -->
				if result.TotalPages > 1 {
					<div class="glass-panel p-4 flex-between items-center flex-wrap gap-4 bg-surface-sunken">
						<div class="text-xs text-secondary">
							عرض صفحة <strong class="text-primary tabular-nums">{ fmt.Sprintf("%d", result.Page) }</strong> من إجمالي <strong class="text-primary tabular-nums">{ fmt.Sprintf("%d", result.TotalPages) }</strong> صفحات ({ fmt.Sprintf("%d", result.TotalCount) } عرض مسجل)
						</div>

						<div class="d-flex items-center gap-1">
							if result.Page > 1 {
								<a
									href={ templ.SafeURL(buildMarketDiscountsURL(filter, result.Page-1, currentView)) }
									class="btn btn-secondary btn-sm text-xs font-bold"
								>
									السابق
								</a>
							}

							for p := 1; p <= result.TotalPages; p++ {
								if p == 1 || p == result.TotalPages || (p >= result.Page-2 && p <= result.Page+2) {
									<a
										href={ templ.SafeURL(buildMarketDiscountsURL(filter, p, currentView)) }
										class={ "btn btn-sm text-xs font-bold", templ.KV("btn-primary", p == result.Page), templ.KV("btn-secondary", p != result.Page) }
									>
										{ fmt.Sprintf("%d", p) }
									</a>
								}
							}

							if result.Page < result.TotalPages {
								<a
									href={ templ.SafeURL(buildMarketDiscountsURL(filter, result.Page+1, currentView)) }
									class="btn btn-secondary btn-sm text-xs font-bold"
								>
									التالي
								</a>
							}
						</div>
					</div>
				}
			}
		</div>
	}
}

func buildMarketDiscountsURL(f compare.MarketDiscountsFilter, page int, view string) string {
	u, _ := url.Parse("/market-discounts")
	q := u.Query()
	if f.Query != "" {
		q.Set("q", f.Query)
	}
	if f.Supplier != "" {
		q.Set("supplier", f.Supplier)
	}
	if f.SortBy != "" {
		q.Set("sort", f.SortBy)
	}
	if f.Limit > 0 && f.Limit != 24 {
		q.Set("limit", strconv.Itoa(f.Limit))
	}
	if f.MinPrice != nil {
		q.Set("min_price", fmt.Sprintf("%.2f", *f.MinPrice))
	}
	if f.MaxPrice != nil {
		q.Set("max_price", fmt.Sprintf("%.2f", *f.MaxPrice))
	}
	if f.MinDiscount != nil {
		q.Set("min_discount", fmt.Sprintf("%.1f", *f.MinDiscount))
	}
	if f.MaxDiscount != nil {
		q.Set("max_discount", fmt.Sprintf("%.1f", *f.MaxDiscount))
	}
	if view != "" {
		q.Set("view", view)
	}
	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}
	u.RawQuery = q.Encode()
	return u.String()
}

func formatOptionalFloat(val *float64) string {
	if val == nil {
		return ""
	}
	return fmt.Sprintf("%.1f", *val)
}

func formatDiscount(pct float64) string {
	if pct == float64(int64(pct)) {
		return fmt.Sprintf("%d", int64(pct))
	}
	return fmt.Sprintf("%.1f", pct)
}

func formatDiscountPrice(m money.Amount) string {
	return m.String()
}

func calculateMaxDiscount(items []*compare.MarketDiscountRow) float64 {
	var max float64
	for _, item := range items {
		if item.DiscountPercent > max {
			max = item.DiscountPercent
		}
	}
	return max
}
