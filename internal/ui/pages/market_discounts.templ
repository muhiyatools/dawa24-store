package pages

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// MarketDiscountsPage renders market-wide approved discounts with responsive views, filters, and pagination.
templ MarketDiscountsPage(lang, dir string, actor authctx.Actor, result *compare.MarketDiscountsResult, filter compare.MarketDiscountsFilter, currentView string) {
	@layouts.ShellFor("خصومات السوق العامة | دواء 24", "market-discounts", lang, dir, actor) {
		<div
			class="page-container"
			x-data={ fmt.Sprintf("{ showMoreFilters: %t, currentView: '%s', setView(v) { this.currentView = v; localStorage.setItem('d24_market_view', v); }, init() { const saved = localStorage.getItem('d24_market_view'); if (saved && (saved === 'list' || saved === 'grid')) { this.currentView = saved; } } }", (filter.MinPrice != nil || filter.MaxPrice != nil || filter.MinDiscount != nil || filter.MaxDiscount != nil), currentView) }
		>
			<!-- 1. Header Banner -->
			<div class="glass-panel p-6 mb-0">
				<div class="flex-between items-center flex-wrap gap-4">
					<div>
						<div class="d-flex items-center gap-3 mb-1">
							<div class="user-avatar-badge text-xl">
								🏷️
							</div>
							<div>
								<h1 class="text-2xl font-black text-primary m-0">
									خصومات السوق العامة
								</h1>
								<span class="text-xs text-brand font-bold uppercase">
									Market Intelligence & Supplier Price Lists
								</span>
							</div>
						</div>
						<p class="text-sm text-secondary m-0 mt-2">
							تصفح وقارن أحدث الخصومات وعروض الأسعار التنافسية المرفوعة من مختلف الموزعين والمستودعات الطبية في السوق.
						</p>
					</div>

					<div>
						<a href="/compare/tool" class="btn btn-primary btn-sm font-bold text-xs px-4 py-2 gap-1">
							@components.IconTrendingUp("icon-xs")
							<span>محرك المقارنة الذكي</span>
						</a>
					</div>
				</div>
			</div>

			<!-- 2. KPI Metrics Summary Cards -->
			<div class="dashboard-stat-grid cols-4 mb-0">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي العروض بالسوق</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", result.TotalCount) }
					</div>
					<div class="text-xs text-muted mt-1">
						عرض وخصم دوائي متاح
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">الشركات والموردون</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%d", len(result.AvailableSuppliers)) }
					</div>
					<div class="text-xs text-muted mt-1">
						شركة توزيع ومستودع مسجل
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">أعلى نسبة خصم بالسوق</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%.1f%%", calculateMaxDiscount(result.Items)) }
					</div>
					<div class="text-xs text-muted mt-1">
						أفضل فرصة توفير متاحة
					</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label">الأصناف المعروضة حالياً</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", len(result.Items)) }
					</div>
					<div class="text-xs text-muted mt-1">
						صفحة { fmt.Sprintf("%d", result.Page) } من { fmt.Sprintf("%d", result.TotalPages) }
					</div>
				</div>
			</div>

			<!-- 3. Filter & Search Deck Card -->
			<div class="glass-panel p-6 mb-0">
				<form method="GET" action="/market-discounts" class="d-flex flex-col gap-4 m-0" id="market-filter-form">
					<input type="hidden" name="view" x-bind:value="currentView" />

					<div class="d-grid grid-auto-fit gap-4 items-end">
						
						<!-- Search Input -->
						<div class="form-group mb-0" style="grid-column: span 2; min-width:260px;">
							<label class="form-label text-xs font-bold text-primary mb-1">
								بحث بالأدوية والمواد الفعالة
							</label>
							<div class="position-relative">
								<input
									type="text"
									name="q"
									value={ filter.Query }
									class="form-input text-xs w-full"
									placeholder="اسم الدواء، المادة الفعالة، كود SKU، الباركود..."
								/>
							</div>
						</div>

						<!-- Supplier Select -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-primary mb-1">
								الشركة الموردة
							</label>
							<select name="supplier" class="form-input text-xs w-full">
								<option value="">كل الشركات ({ fmt.Sprintf("%d", len(result.AvailableSuppliers)) })</option>
								for _, sup := range result.AvailableSuppliers {
									<option value={ sup } selected?={ filter.Supplier == sup }>{ sup }</option>
								}
							</select>
						</div>

						<!-- Sort Order -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-primary mb-1">
								ترتيب النتائج
							</label>
							<select name="sort" class="form-input text-xs w-full">
								<option value="discount_desc" selected?={ filter.SortBy == "" || filter.SortBy == "discount_desc" }>الأعلى خصماً 🔥</option>
								<option value="price_asc" selected?={ filter.SortBy == "price_asc" }>الأقل سعراً 💰</option>
								<option value="price_desc" selected?={ filter.SortBy == "price_desc" }>الأعلى سعراً</option>
								<option value="newest" selected?={ filter.SortBy == "newest" }>الأحدث إضافة ⚡</option>
								<option value="oldest" selected?={ filter.SortBy == "oldest" }>الأقدم</option>
							</select>
						</div>

						<!-- Page Size Limit -->
						<div class="form-group mb-0">
							<label class="form-label text-xs font-bold text-primary mb-1">
								عناصر بالصفحة
							</label>
							<select name="limit" class="form-input text-xs w-full">
								<option value="24" selected?={ filter.Limit == 24 || filter.Limit == 0 }>24 عنصر</option>
								<option value="48" selected?={ filter.Limit == 48 }>48 عنصر</option>
								<option value="96" selected?={ filter.Limit == 96 }>96 عنصر</option>
							</select>
						</div>
					</div>

					<!-- Collapsible Advanced Range Filters -->
					<div x-show="showMoreFilters" x-collapse class="pt-4 border-t d-grid grid-auto-fit gap-4">
						<!-- Price Range -->
						<div>
							<label class="form-label text-xs font-bold text-secondary mb-1">
								💰 نطاق السعر الصافي بعد الخصم (ج.م)
							</label>
							<div class="d-flex gap-2 items-center">
								<input
									type="number"
									step="0.5"
									name="min_price"
									value={ formatOptionalFloat(filter.MinPrice) }
									class="form-input text-xs flex-1"
									placeholder="من سعر"
								/>
								<span class="text-muted">-</span>
								<input
									type="number"
									step="0.5"
									name="max_price"
									value={ formatOptionalFloat(filter.MaxPrice) }
									class="form-input text-xs flex-1"
									placeholder="إلى سعر"
								/>
							</div>
						</div>

						<!-- Discount Range -->
						<div>
							<label class="form-label text-xs font-bold text-secondary mb-1">
								📉 نطاق نسبة الخصم (%)
							</label>
							<div class="d-flex gap-2 items-center">
								<input
									type="number"
									step="1"
									name="min_discount"
									value={ formatOptionalFloat(filter.MinDiscount) }
									class="form-input text-xs flex-1"
									placeholder="من خصم %"
								/>
								<span class="text-muted">-</span>
								<input
									type="number"
									step="1"
									name="max_discount"
									value={ formatOptionalFloat(filter.MaxDiscount) }
									class="form-input text-xs flex-1"
									placeholder="إلى خصم %"
								/>
							</div>
						</div>
					</div>

					<!-- Toolbar Actions & View Mode Switcher -->
					<div class="flex-between items-center border-t pt-4 flex-wrap gap-3">
						<div class="d-flex items-center gap-2">
							<button
								type="button"
								@click="showMoreFilters = !showMoreFilters"
								class="btn btn-secondary btn-sm font-bold text-xs"
							>
								<span x-text="showMoreFilters ? 'إخفاء نطاقات الأسعار والخصم ▲' : 'نطاق السعر والخصم المتقدم ▼'"></span>
							</button>

							if filter.Query != "" || filter.Supplier != "" || filter.MinPrice != nil || filter.MaxPrice != nil || filter.MinDiscount != nil || filter.MaxDiscount != nil || (filter.SortBy != "" && filter.SortBy != "discount_desc") {
								<a href="/market-discounts" class="btn btn-secondary btn-sm text-xs">
									إلغاء التصفية
								</a>
							}
						</div>

						<div class="d-flex items-center gap-3">
							<!-- View Switcher -->
							<div class="cb-tabs-nav m-0">
								<button
									type="button"
									@click="setView('list')"
									class="cb-tab-btn"
									:class="{ 'active': currentView === 'list' }"
								>
									<span>☰ عرض القائمة</span>
								</button>
								<button
									type="button"
									@click="setView('grid')"
									class="cb-tab-btn"
									:class="{ 'active': currentView === 'grid' }"
								>
									<span>⊞ عرض الكروت</span>
								</button>
							</div>

							<button type="submit" class="btn btn-primary btn-sm font-bold text-xs px-4">
								@components.IconSearch("icon-xs")
								<span>تطبيق البحث</span>
							</button>
						</div>
					</div>
				</form>
			</div>

			<!-- 4. Results Surface -->
			if len(result.Items) == 0 {
				<div class="glass-panel p-12 text-center empty-state-glass">
					<div class="text-4xl mb-3">🔍</div>
					<h3 class="text-lg font-black text-primary mb-2">
						لم نجد أي خصومات مطابقة
					</h3>
					<p class="text-sm text-secondary max-w-md mx-auto mb-6">
						جرب البحث بكلمات أخرى، أو تغيير خيارات الشركة الموردة ونطاقات الأسعار والخصومات المحددة.
					</p>
					<a href="/market-discounts" class="btn btn-primary font-bold text-xs">
						عرض كافة خصومات السوق
					</a>
				</div>
			} else {
				<!-- 1. LIST VIEW -->
				<div x-show="currentView === 'list'" class="d-flex flex-col gap-3">
					for _, item := range result.Items {
						<div class="glass-panel p-4 flex-between items-center flex-wrap gap-4">
							<!-- Right: Product Name & SKU -->
							<div style="min-width:240px; flex:1;">
								<h3 class="text-base font-black text-primary m-0 mb-1 leading-snug">
									{ item.ProductName }
								</h3>
								<div class="d-flex items-center gap-2 text-xs text-secondary">
									<span>الكود:</span>
									if item.SKU != "" {
										<strong class="tabular-nums font-mono text-primary font-bold">{ item.SKU }</strong>
									} else {
										<strong class="tabular-nums font-mono text-muted font-bold">#{ fmt.Sprintf("%d", item.ID) }</strong>
									}
									if item.InCatalog {
										<span class="badge badge-sky text-xs font-bold">
											✓ معتمد
										</span>
									}
								</div>
							</div>

							<!-- Center: Warehouse Pill & Date -->
							<div class="text-center" style="min-width:180px;">
								<div class="badge badge-primary text-xs font-bold py-1 px-3">
									{ item.SupplierName }
								</div>
								<div class="text-xs text-muted mt-1 tabular-nums">
									تاريخ العرض: <strong class="text-secondary">{ item.CreatedAt.Format("2006-01-02") }</strong>
								</div>
							</div>

							<!-- Left: Discount Pill + Public Price & Total Price -->
							<div class="d-flex items-center gap-4 justify-end" style="min-width:200px;">
								<!-- Discount Badge Pill -->
								<div>
									if item.DiscountPercent >= 40 {
										<div class="badge badge-rose text-xs font-black py-2 px-3">
											%{ formatDiscount(item.DiscountPercent) } خصم
										</div>
									} else {
										<div class="badge badge-emerald text-xs font-black py-2 px-3">
											%{ formatDiscount(item.DiscountPercent) } خصم
										</div>
									}
								</div>

								<!-- Prices -->
								<div class="text-start">
									<div class="tabular-nums text-xl font-black text-primary leading-none" title="سعر الجمهور">
										<span class="text-xs font-bold text-muted me-1">ج.م</span>
										<span>{ item.OriginalPrice.String() }</span>
									</div>
									<div class="tabular-nums text-xs font-black text-brand mt-1" title="السعر الإجمالي بعد الخصم">
										<span>ج.م { item.PriceAfterDiscount.String() }</span>
									</div>
								</div>
							</div>
						</div>
					}
				</div>

				<!-- 2. CARDS / GRID VIEW -->
				<div x-show="currentView === 'grid'" class="product-grid-wrapper">
					for _, item := range result.Items {
						<div class="glass-panel p-4 d-flex flex-col justify-between mb-0">
							<div>
								<div class="flex-between items-start gap-2 mb-2">
									<div class="badge badge-primary text-xs font-bold">
										{ item.SupplierName }
									</div>
									<div>
										if item.DiscountPercent >= 40 {
											<span class="badge badge-rose text-xs font-black">
												%{ formatDiscount(item.DiscountPercent) } خصم
											</span>
										} else {
											<span class="badge badge-emerald text-xs font-black">
												%{ formatDiscount(item.DiscountPercent) } خصم
											</span>
										}
									</div>
								</div>

								<!-- Drug Title -->
								<h3 class="text-sm font-black text-primary m-0 mb-1 leading-snug product-card-title">
									{ item.ProductName }
								</h3>

								<!-- SKU Code -->
								<div class="d-flex items-center gap-1 text-xs text-muted mb-3">
									<span>الكود:</span>
									if item.SKU != "" {
										<strong class="tabular-nums font-mono text-primary font-bold">{ item.SKU }</strong>
									} else {
										<strong class="tabular-nums font-mono text-muted font-bold">#{ fmt.Sprintf("%d", item.ID) }</strong>
									}
								</div>
							</div>

							<div class="border-t pt-3 mt-2">
								<div class="flex-between items-baseline">
									<div class="tabular-nums text-lg font-black text-success">
										%{ formatDiscount(item.DiscountPercent) }
									</div>

									<div class="text-start">
										<div class="tabular-nums text-base font-black text-primary leading-none">
											<span class="text-xs text-muted me-1">ج.م</span>
											<span>{ item.OriginalPrice.String() }</span>
										</div>
										<div class="tabular-nums text-xs font-bold text-brand mt-1">
											<span>ج.م { item.PriceAfterDiscount.String() }</span>
										</div>
									</div>
								</div>

								<div class="flex-between text-xs text-muted border-t pt-2 mt-2">
									<span>تاريخ العرض:</span>
									<strong class="tabular-nums text-secondary">{ item.CreatedAt.Format("2006-01-02") }</strong>
								</div>
							</div>
						</div>
					}
				</div>

				<!-- 5. Modern Pagination Footer -->
				<div class="glass-panel p-4 flex-between items-center flex-wrap gap-3">
					
					<!-- Left: Pagination Info -->
					<div class="text-xs text-secondary font-semibold">
						<span>عرض </span>
						<strong class="tabular-nums text-primary font-bold">{ fmt.Sprintf("%d", calculateStartItem(result.Page, result.Limit, result.TotalCount)) }</strong>
						<span> إلى </span>
						<strong class="tabular-nums text-primary font-bold">{ fmt.Sprintf("%d", calculateEndItem(result.Page, result.Limit, result.TotalCount)) }</strong>
						<span> من إجمالي </span>
						<strong class="tabular-nums text-primary font-black">{ fmt.Sprintf("%d", result.TotalCount) }</strong>
						<span> عرض وخصم متاح</span>
					</div>

					<!-- Right: Prev / Numbered / Next Buttons -->
					<div class="d-flex gap-1 items-center">
						if result.HasPrev {
							<a
								href={ templ.SafeURL(buildMarketPaginationURL(filter, result.Page-1, currentView)) }
								class="btn btn-secondary btn-sm text-xs font-bold"
							>
								&laquo; السابق
							</a>
						} else {
							<button class="btn btn-secondary btn-sm text-xs" disabled style="opacity:0.4;">
								&laquo; السابق
							</button>
						}

						for _, p := range calculatePageRange(result.Page, result.TotalPages) {
							if p == result.Page {
								<span class="btn btn-primary btn-sm text-xs font-black">
									{ fmt.Sprintf("%d", p) }
								</span>
							} else {
								<a
									href={ templ.SafeURL(buildMarketPaginationURL(filter, p, currentView)) }
									class="btn btn-secondary btn-sm text-xs font-bold"
								>
									{ fmt.Sprintf("%d", p) }
								</a>
							}
						}

						if result.HasNext {
							<a
								href={ templ.SafeURL(buildMarketPaginationURL(filter, result.Page+1, currentView)) }
								class="btn btn-secondary btn-sm text-xs font-bold text-primary"
							>
								التالي &raquo;
							</a>
						} else {
							<button class="btn btn-secondary btn-sm text-xs" disabled style="opacity:0.4;">
								التالي &raquo;
							</button>
						}
					</div>

				</div>
			}

		</div>
	}
}

func calculateMaxDiscount(items []*compare.MarketDiscountRow) float64 {
	maxD := 0.0
	for _, it := range items {
		if it != nil && it.DiscountPercent > maxD {
			maxD = it.DiscountPercent
		}
	}
	return maxD
}

func formatDiscount(d float64) string {
	return fmt.Sprintf("%.0f", d)
}

func formatOptionalFloat(v *float64) string {
	if v == nil {
		return ""
	}
	return fmt.Sprintf("%.2f", *v)
}

func calculateStartItem(page, limit int, total int64) int64 {
	if total == 0 {
		return 0
	}
	return int64((page-1)*limit + 1)
}

func calculateEndItem(page, limit int, total int64) int64 {
	end := int64(page * limit)
	if end > total {
		return total
	}
	return end
}

func calculatePageRange(current, total int) []int {
	if total <= 1 {
		return []int{1}
	}
	start := current - 2
	if start < 1 {
		start = 1
	}
	end := start + 4
	if end > total {
		end = total
		start = end - 4
		if start < 1 {
			start = 1
		}
	}
	var nums []int
	for i := start; i <= end; i++ {
		nums = append(nums, i)
	}
	return nums
}

func buildMarketPaginationURL(filter compare.MarketDiscountsFilter, targetPage int, view string) string {
	vals := url.Values{}
	if filter.Query != "" {
		vals.Set("q", filter.Query)
	}
	if filter.Supplier != "" {
		vals.Set("supplier", filter.Supplier)
	}
	if filter.SortBy != "" {
		vals.Set("sort", filter.SortBy)
	}
	if filter.MinPrice != nil {
		vals.Set("min_price", fmt.Sprintf("%.2f", *filter.MinPrice))
	}
	if filter.MaxPrice != nil {
		vals.Set("max_price", fmt.Sprintf("%.2f", *filter.MaxPrice))
	}
	if filter.MinDiscount != nil {
		vals.Set("min_discount", fmt.Sprintf("%.2f", *filter.MinDiscount))
	}
	if filter.MaxDiscount != nil {
		vals.Set("max_discount", fmt.Sprintf("%.2f", *filter.MaxDiscount))
	}
	if filter.Limit > 0 && filter.Limit != 24 {
		vals.Set("limit", strconv.Itoa(filter.Limit))
	}
	if view != "" {
		vals.Set("view", view)
	}
	vals.Set("page", strconv.Itoa(targetPage))
	return "/market-discounts?" + vals.Encode()
}
