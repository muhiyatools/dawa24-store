package pages

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/muhiya/dawa24-store/internal/modules/compare"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

// MarketDiscountsPage renders market-wide approved discounts with responsive views, filters, and pagination.
templ MarketDiscountsPage(lang, dir string, actor authctx.Actor, result *compare.MarketDiscountsResult, filter compare.MarketDiscountsFilter, currentView string) {
	@layouts.ShellFor("خصومات السوق العامة | دواء 24", "market-discounts", lang, dir, actor) {
		<div
			class="page-container"
			x-data={ fmt.Sprintf("{ showMoreFilters: %t, currentView: '%s', setView(v) { this.currentView = v; localStorage.setItem('d24_market_view', v); }, init() { const saved = localStorage.getItem('d24_market_view'); if (saved && (saved === 'list' || saved === 'grid')) { this.currentView = saved; } } }", (filter.MinPrice != nil || filter.MaxPrice != nil || filter.MinDiscount != nil || filter.MaxDiscount != nil), currentView) }
		>
			<!-- Header: what this page is, and the two numbers that describe it -->
			<header class="md-header">
				<div class="md-header-copy">
					<h1 class="md-title">
						@components.IconTag("icon-sm")
						<span>خصومات السوق العامة</span>
					</h1>
					<p class="md-subtitle">
						أصناف الموردين المتوفرة فعلياً في المخازن، بأسعار التوريد والخصومات اللحظية.
					</p>
				</div>

				<dl class="md-stats">
					<div class="md-stat">
						<dt>عروض متاحة</dt>
						<dd class="tabular-nums">{ fmt.Sprintf("%d", result.TotalCount) }</dd>
					</div>
					<div class="md-stat">
						<dt>الشركات</dt>
						<dd class="tabular-nums">{ fmt.Sprintf("%d", len(result.AvailableSuppliers)) }</dd>
					</div>
					<div class="md-stat is-accent">
						<dt>أعلى خصم</dt>
						<dd class="tabular-nums">{ fmt.Sprintf("%.0f%%", calculateMaxDiscount(result.Items)) }</dd>
					</div>
				</dl>
			</header>

			<!-- Controls: one row — search, two selects, actions, view switch -->
			<div class="filter-bar md-controls">
				<form method="GET" action="/market-discounts" class="md-controls-form" id="market-filter-form">
					<input type="hidden" name="view" x-bind:value="currentView"/>
					<input type="hidden" name="limit" value={ strconv.Itoa(marketDiscountsLimit(filter)) }/>

					<div class="md-controls-row">
						<input
							type="search"
							name="q"
							value={ filter.Query }
							class="form-input md-search"
							placeholder="بحث باسم الدواء، المادة الفعالة، أو الكود..."
							aria-label="بحث في خصومات السوق"
						/>

						<select name="supplier" class="form-select md-select" onchange="this.form.submit()" aria-label="الشركة الموردة">
							<option value="">كافة الشركات ({ fmt.Sprintf("%d", len(result.AvailableSuppliers)) })</option>
							for _, sup := range result.AvailableSuppliers {
								<option value={ sup } selected?={ filter.Supplier == sup }>{ sup }</option>
							}
						</select>

						<select name="sort" class="form-select md-select" onchange="this.form.submit()" aria-label="الترتيب">
							<option value="discount_desc" selected?={ filter.SortBy == "" || filter.SortBy == "discount_desc" }>الأعلى خصماً</option>
							<option value="price_asc" selected?={ filter.SortBy == "price_asc" }>الأقل سعراً</option>
							<option value="price_desc" selected?={ filter.SortBy == "price_desc" }>الأعلى سعراً</option>
							<option value="newest" selected?={ filter.SortBy == "newest" }>الأحدث إضافة</option>
							<option value="oldest" selected?={ filter.SortBy == "oldest" }>الأقدم</option>
						</select>

						<button type="submit" class="btn btn-primary btn-sm font-bold">
							@components.IconSearch("icon-xs")
							<span>بحث</span>
						</button>

						<button
							type="button"
							@click="showMoreFilters = !showMoreFilters"
							class="btn btn-secondary btn-sm font-bold"
							:class="{ 'active': showMoreFilters }"
							title="نطاق السعر والخصم"
							x-bind:aria-expanded="showMoreFilters ? 'true' : 'false'"
						>
							<span>نطاق متقدم</span>
						</button>

						if filter.Query != "" || filter.Supplier != "" || filter.MinPrice != nil || filter.MaxPrice != nil || filter.MinDiscount != nil || filter.MaxDiscount != nil {
							<a href="/market-discounts" class="btn btn-ghost btn-sm">إلغاء الفلاتر</a>
						}

						<div class="md-controls-spacer"></div>

						<div class="tabs-nav md-viewswitch" role="group" aria-label="طريقة العرض">
							<button
								type="button"
								@click="setView('list')"
								class="tab-btn"
								:class="{ 'active': currentView === 'list' }"
								x-bind:aria-pressed="currentView === 'list' ? 'true' : 'false'"
								title="عرض كقائمة"
							>
								@components.IconList("icon-xs")
							</button>
							<button
								type="button"
								@click="setView('grid')"
								class="tab-btn"
								:class="{ 'active': currentView === 'grid' }"
								x-bind:aria-pressed="currentView === 'grid' ? 'true' : 'false'"
								title="عرض ككروت"
							>
								@components.IconGrid("icon-xs")
							</button>
						</div>
					</div>

					<!-- Advanced ranges, collapsed until asked for -->
					<div x-show="showMoreFilters" x-cloak x-transition.opacity class="md-ranges">
						<div class="md-range">
							<span class="md-range-label">السعر بعد الخصم (ج.م)</span>
							<div class="md-range-pair">
								<input type="number" step="0.5" name="min_price" value={ formatOptionalFloat(filter.MinPrice) } class="form-input" placeholder="من" aria-label="أقل سعر"/>
								<span class="md-range-dash">—</span>
								<input type="number" step="0.5" name="max_price" value={ formatOptionalFloat(filter.MaxPrice) } class="form-input" placeholder="إلى" aria-label="أعلى سعر"/>
							</div>
						</div>

						<div class="md-range">
							<span class="md-range-label">نسبة الخصم (%)</span>
							<div class="md-range-pair">
								<input type="number" step="1" name="min_discount" value={ formatOptionalFloat(filter.MinDiscount) } class="form-input" placeholder="من" aria-label="أقل خصم"/>
								<span class="md-range-dash">—</span>
								<input type="number" step="1" name="max_discount" value={ formatOptionalFloat(filter.MaxDiscount) } class="form-input" placeholder="إلى" aria-label="أعلى خصم"/>
							</div>
						</div>

						<button type="submit" class="btn btn-primary btn-sm font-bold md-range-apply">تطبيق النطاق</button>
					</div>
				</form>
			</div>

			<!-- 3. Results Surface -->
			if len(result.Items) == 0 {
				<div class="glass-panel p-12 text-center empty-state-glass">
					<div class="text-4xl mb-3">@components.IconSearch("icon-sm")</div>
					<h3 class="text-lg font-black text-primary mb-2">
						لم نجد أي خصومات مطابقة
					</h3>
					<p class="text-sm text-secondary max-w-md mx-auto mb-6">
						الصفحة تعرض أصناف الموردين المتوفرة في المخازن فقط. جرب كلمات بحث أخرى، أو غيّر الشركة الموردة ونطاقات السعر والخصم.
					</p>
					<a href="/market-discounts" class="btn btn-primary font-bold text-xs">
						عرض كافة خصومات السوق
					</a>
				</div>
			} else {
				<!-- 1. LIST VIEW — one scannable row per offer -->
				<div class="market-list" x-show="currentView === 'list'" x-cloak>
					for _, item := range result.Items {
						<article class="glass-panel market-list-row">
							<!-- Zone 1: identity -->
							<div class="market-list-identity">
								<h3 class="market-list-title">{ item.ProductName }</h3>
								<div class="market-list-meta">
									if item.SKU != "" {
										<span class="market-code">{ item.SKU }</span>
									} else {
										<span class="market-code is-muted">#{ fmt.Sprintf("%d", item.ID) }</span>
									}
									<span class="badge badge-primary market-supplier-badge">{ item.SupplierName }</span>
									<span class="market-stock tabular-nums" title="الرصيد المتاح لدى المورد">
										{ fmt.Sprintf("متاح: %d", item.AvailableStock) }
									</span>
									<span class="market-list-date tabular-nums">{ item.CreatedAt.Format("2006-01-02") }</span>
								</div>
							</div>

							<!-- Zone 2: the money — public price, discount, net price side by side -->
							<div class="market-money">
								<div class="market-money-cell">
									<span class="market-money-label">سعر الجمهور</span>
									if item.OriginalPrice.Minor() > 0 {
										<span class="market-money-was tabular-nums">{ formatDiscountPrice(item.OriginalPrice) } ج.م</span>
									} else {
										<span class="market-money-was is-empty">—</span>
									}
								</div>

								<div class="market-money-cell">
									<span class="market-money-label">الخصم</span>
									if item.DiscountPercent >= 40 {
										<span class="market-disc-pill is-hot tabular-nums">{ formatDiscount(item.DiscountPercent) }%</span>
									} else {
										<span class="market-disc-pill tabular-nums">{ formatDiscount(item.DiscountPercent) }%</span>
									}
								</div>

								<div class="market-money-cell is-net">
									<span class="market-money-label">سعر بعد الخصم</span>
									<span class="market-money-net tabular-nums">
										{ formatDiscountPrice(item.PriceAfterDiscount) } <small>ج.م</small>
									</span>
								</div>
							</div>

							<!-- Zone 3: action -->
							<div class="market-list-action">
								<a
									href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", item.VariantID)) }
									class="btn btn-primary btn-sm font-bold"
									title="عرض الصنف والشراء"
								>
									@components.IconCart("icon-xs")
									<span>طلب</span>
								</a>
							</div>
						</article>
					}
				</div>

				<!-- 2. GRID VIEW — four compact cards per row -->
				<div class="market-grid" x-show="currentView === 'grid'" x-cloak>
					for _, item := range result.Items {
						<article class="glass-panel market-card">
							<header class="market-card-head">
								<span class="badge badge-primary market-supplier-badge">{ item.SupplierName }</span>
								<span class="market-stock tabular-nums" title="الرصيد المتاح لدى المورد">
									{ fmt.Sprintf("متاح: %d", item.AvailableStock) }
								</span>
							</header>

							<h3 class="market-card-title">{ item.ProductName }</h3>

							<div class="market-card-code">
								if item.SKU != "" {
									<span class="market-code">{ item.SKU }</span>
								} else {
									<span class="market-code is-muted">#{ fmt.Sprintf("%d", item.ID) }</span>
								}
							</div>

							<!-- Price rail: public price, net price and the discount tag together -->
							<div class="market-card-rail">
								<div class="market-card-rail-prices">
									<div class="market-card-rail-row">
										<span class="market-money-label">سعر الجمهور</span>
										if item.OriginalPrice.Minor() > 0 {
											<span class="market-money-was tabular-nums">{ formatDiscountPrice(item.OriginalPrice) }</span>
										} else {
											<span class="market-money-was is-empty">—</span>
										}
									</div>
									<div class="market-card-rail-row">
										<span class="market-money-label">سعر بعد الخصم</span>
										<span class="market-money-net tabular-nums">
											{ formatDiscountPrice(item.PriceAfterDiscount) } <small>ج.م</small>
										</span>
									</div>
								</div>
								if item.DiscountPercent >= 40 {
									<span class="market-disc-pill is-hot is-block tabular-nums">
										{ formatDiscount(item.DiscountPercent) }%
										<small>خصم</small>
									</span>
								} else {
									<span class="market-disc-pill is-block tabular-nums">
										{ formatDiscount(item.DiscountPercent) }%
										<small>خصم</small>
									</span>
								}
							</div>

							<footer class="market-card-foot">
								<a
									href={ templ.SafeURL(fmt.Sprintf("/catalog/%d", item.VariantID)) }
									class="btn btn-primary btn-sm font-bold w-full justify-center"
								>
									@components.IconCart("icon-xs")
									<span>شراء</span>
								</a>
							</footer>
						</article>
					}
				</div>

				<!-- Pagination Footer Deck -->
				if result.TotalCount > 0 {
					<div class="glass-panel p-4 bg-surface-sunken">
						@components.B2BPagination(components.PaginationProps{
							CurrentPage:     result.Page,
							PageSize:        marketDiscountsLimit(filter),
							TotalCount:      int(result.TotalCount),
							BaseURL:         "/market-discounts",
							QueryValues:     marketDiscountsQueryValues(filter, currentView),
							PageSizeOptions: []int{24, 48, 96},
						})
					</div>
				}
			}
		</div>
	}
}

// marketDiscountsLimit is the page size in effect: the filter's value, or the
// grid default of 24.
func marketDiscountsLimit(f compare.MarketDiscountsFilter) int {
	if f.Limit == 24 || f.Limit == 48 || f.Limit == 96 {
		return f.Limit
	}
	return 24
}

// marketDiscountsQueryValues carries every filter the screen supports through a
// page change. components.B2BPagination adds page and limit itself.
func marketDiscountsQueryValues(f compare.MarketDiscountsFilter, view string) url.Values {
	q := url.Values{}
	if f.Query != "" {
		q.Set("q", f.Query)
	}
	if f.Supplier != "" {
		q.Set("supplier", f.Supplier)
	}
	if f.SortBy != "" {
		q.Set("sort", f.SortBy)
	}
	if f.MinPrice != nil {
		q.Set("min_price", fmt.Sprintf("%.2f", *f.MinPrice))
	}
	if f.MaxPrice != nil {
		q.Set("max_price", fmt.Sprintf("%.2f", *f.MaxPrice))
	}
	if f.MinDiscount != nil {
		q.Set("min_discount", fmt.Sprintf("%.1f", *f.MinDiscount))
	}
	if f.MaxDiscount != nil {
		q.Set("max_discount", fmt.Sprintf("%.1f", *f.MaxDiscount))
	}
	if view != "" {
		q.Set("view", view)
	}
	return q
}

func formatOptionalFloat(val *float64) string {
	if val == nil {
		return ""
	}
	return fmt.Sprintf("%.1f", *val)
}

func formatDiscount(pct float64) string {
	if pct == float64(int64(pct)) {
		return fmt.Sprintf("%d", int64(pct))
	}
	return fmt.Sprintf("%.1f", pct)
}

func formatDiscountPrice(m money.Amount) string {
	return m.String()
}

func calculateMaxDiscount(items []*compare.MarketDiscountRow) float64 {
	var max float64
	for _, item := range items {
		if item.DiscountPercent > max {
			max = item.DiscountPercent
		}
	}
	return max
}
