package pages

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

templ AboutPage(lang, dir string) {
	@layouts.CustomerShell("من نحن | About DAWA24", lang, dir) {
		<div style="max-width:1120px; margin:1rem auto 4rem auto;">
			<!-- Hero -->
			<section style="background:#ffffff; border:1px solid var(--border-card); border-radius:var(--radius-2xl); padding:3.5rem 2.5rem; text-align:center; box-shadow:var(--shadow-sm); margin-bottom:3rem;">
				<div style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.4rem 1rem; border-radius:var(--radius-full); background:var(--primary-50); color:var(--primary-800); font-weight:800; font-size:0.85rem; margin-bottom:1.25rem; border:1px solid var(--primary-200);">
					@components.IconBuilding("icon-xs")
					<span>شركة DAWA24 لتكنولوجيا التوريد الدوائي</span>
				</div>
				<h1 style="font-size:2.5rem; font-weight:900; color:var(--neutral-900); margin-bottom:1rem; letter-spacing:-0.02em;">
					من نحن — منصة التوريد الدوائي الذكية
				</h1>
				<p style="color:var(--neutral-600); font-size:1.1rem; max-width:760px; margin:0 auto; line-height:1.9;">
					دواء 24 هي المنظومة الرقمية الرائدة في جمهورية مصر العربية المصممة لربط الصيدليات، المستشفيات، والمراكز الطبية المرخصة مباشرة بمصانع وشركات ومستودعات توزيع الأدوية المعتمدة، لخلق سوق دوائي موثوق، شفاف، وفائق الكفاءة.
				</p>
			</section>

			<!-- Mission and Vision Cards -->
			<section style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:2rem; margin-bottom:3.5rem;">
				<div class="card hover-lift" style="margin-bottom:0; padding:2.25rem;">
					<div style="width:48px; height:48px; border-radius:var(--radius-lg); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
						@components.IconShield("icon-md")
					</div>
					<h3 style="font-size:1.35rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.75rem;">
						رؤيتنا
					</h3>
					<p style="color:var(--neutral-600); font-size:0.95rem; line-height:1.8;">
						أن نكون البنية التحتية الرقمية الأكثر أماناً وموثوقية لسلاسل الإمداد والتوريد الدوائي في الشرق الأوسط وإفريقيا، وضمان توافر الدواء بجودة قياسية وأسعار عادلة لكل مريض عبر تمكين الصيدلي والمورد.
					</p>
				</div>

				<div class="card hover-lift" style="margin-bottom:0; padding:2.25rem;">
					<div style="width:48px; height:48px; border-radius:var(--radius-lg); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
						@components.IconTruck("icon-md")
					</div>
					<h3 style="font-size:1.35rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.75rem;">
						رسالتنا
					</h3>
					<p style="color:var(--neutral-600); font-size:0.95rem; line-height:1.8;">
						القضاء على تعقيدات ونواقص التوريد التقليدي عبر توفير منصة إلكترونية ذكية تتيح مقارنة الأسعار، الشراء المباشر، الفواتير الإلكترونية المعتمدة، وسلاسل التبريد المتطورة بدعم تقني وصيدلي متواصل 24/7.
					</p>
				</div>
			</section>

			<!-- Strategic Pillars -->
			<section style="background:#ffffff; border:1px solid var(--border-card); border-radius:var(--radius-2xl); padding:3.5rem 2.5rem; margin-bottom:3.5rem;">
				<div style="text-align:center; margin-bottom:3rem;">
					<h2 style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.5rem;">
						ركائز العمل في منصة دواء 24
					</h2>
					<p style="color:var(--neutral-500); font-size:1rem;">معايير صارمة وضمانات متكاملة تضمن جودة كل شحنة دوائية</p>
				</div>

				<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:2rem;">
					<div>
						<div style="width:44px; height:44px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
							@components.IconCheckCircle("icon-sm")
						</div>
						<h4 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">توثيق التراخيص الرسمية</h4>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">فحص وتدقيق السجلات التجارية وتراخيص هيئة الدواء ونقابة الصيادلة لكافة الأطراف قبل تفعيل الحسابات.</p>
					</div>

					<div>
						<div style="width:44px; height:44px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
							@components.IconTruck("icon-sm")
						</div>
						<h4 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">سلسلة تبريد معتمدة (Cold-Chain)</h4>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">أسطول مجهز بحاويات مبردة ومجسات حرارية لضمان وصول الأنسولين والأمصال بأعلى معايير الأمان الحيوي.</p>
					</div>

					<div>
						<div style="width:44px; height:44px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
							@components.IconFileText("icon-sm")
						</div>
						<h4 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">تكامل الفاتورة الإلكترونية</h4>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">ربط مباشر مع مصلحة الضرائب المصرية لإصدار الفواتير الضريبية المعتمدة فور تسليم أمر التوريد.</p>
					</div>

					<div>
						<div style="width:44px; height:44px; border-radius:var(--radius-md); background:var(--primary-50); color:var(--primary-700); display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
							@components.IconPhone("icon-sm")
						</div>
						<h4 style="font-size:1.1rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">دعم فني واستشارات 24/7</h4>
						<p style="color:var(--neutral-600); font-size:0.875rem; line-height:1.7;">فريق دعم صيدلي متفرغ لمعالجة الطلبات العاجلة، متابعة خطوط السير، وحل نواقص السوق الدوائي.</p>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section style="background:linear-gradient(135deg, var(--primary-700) 0%, var(--primary-950) 100%); border-radius:var(--radius-2xl); padding:3.5rem 2rem; text-align:center; color:#ffffff; box-shadow:var(--shadow-md);">
				<h2 style="font-size:2rem; font-weight:900; color:#ffffff; margin-bottom:0.75rem;">
					كن جزءاً من مستقبل التوريد الدوائي الذكي
				</h2>
				<p style="color:var(--primary-100); font-size:1.05rem; max-width:600px; margin:0 auto 2rem auto; line-height:1.8;">
					سواء كنت صيدلية تسعى لتأمين احتياجاتها بأفضل الأسعار، أو مورداً يريد توسيع قاعدة عملائه، دواء 24 هو شريكك الاستراتيجي.
				</p>
				<div style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
					<a href="/auth/register" class="btn" style="background:#ffffff; color:var(--primary-800) !important; font-size:1rem; font-weight:800; padding:0.75rem 2rem;">
						<span>تسجيل حساب صيدلية جديد</span>
					</a>
					<a href="/onboarding" class="btn" style="background:rgba(255,255,255,0.15); color:#ffffff !important; border:1px solid rgba(255,255,255,0.4); font-size:1rem; font-weight:700; padding:0.75rem 2rem;">
						<span>انضمام كشريك مورد</span>
					</a>
				</div>
			</section>
		</div>
	}
}
