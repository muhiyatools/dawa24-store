package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorBranchesData struct {
	Branches []*org.Branch
	Cities   []*platformadmin.City
}

templ VendorBranchesPage(data VendorBranchesData, lang, dir string) {
	@layouts.VendorShell("إدارة الفروع ونقاط التوزيع اللوجستية", "branches", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:2rem;">
			
			<!-- Header Action Bar -->
			<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
				<div>
					<h2 style="font-size:1.6rem; font-weight:900; color:var(--neutral-900); margin:0;">
						شبكة الفروع والمستودعات المركزية
					</h2>
					<p style="color:var(--neutral-500); font-size:0.925rem; margin:0.25rem 0 0 0;">
						إدارة مواقع الفروع، إحداثيات GPS، السعات التخزينية، وسلاسل التبريد الدوائية
					</p>
				</div>

				<button type="button" class="btn btn-primary" data-modal-open="add-branch-modal" style="font-weight:800; padding:0.7rem 1.5rem;">
					@components.IconPlus("icon-xs")
					<span>إضافة فرع أو مستودع جديد</span>
				</button>
			</div>

			<!-- Quick Logistics Metrics -->
			<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem;">
				<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem 1.5rem; border-inline-start:4px solid var(--primary-600);">
					<div style="font-size:0.825rem; font-weight:700; color:var(--neutral-500);">إجمالي الفروع المسجلة</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin-top:0.25rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", len(data.Branches)) }
					</div>
					<div style="font-size:0.775rem; color:var(--neutral-400); margin-top:0.25rem;">نقاط شحن وتوزيع نشطة</div>
				</div>

				<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem 1.5rem; border-inline-start:4px solid var(--success);">
					<div style="font-size:0.825rem; font-weight:700; color:var(--neutral-500);">فروع مجهزة بسلاسل تبريد</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--success); margin-top:0.25rem;" class="tabular-nums">
						{ fmt.Sprintf("%d", countColdStorageBranches(data.Branches)) }
					</div>
					<div style="font-size:0.775rem; color:var(--neutral-400); margin-top:0.25rem;">مستودعات مبردة (2° - 8° مئوية)</div>
				</div>

				<div class="card hover-lift" style="margin-bottom:0; padding:1.25rem 1.5rem; border-inline-start:4px solid var(--secondary);">
					<div style="font-size:0.825rem; font-weight:700; color:var(--neutral-500);">إجمالي المساحة التخزينية</div>
					<div style="font-size:1.85rem; font-weight:900; color:var(--neutral-900); margin-top:0.25rem;" class="tabular-nums">
						{ fmt.Sprintf("%.0f م²", totalCapacitySQM(data.Branches)) }
					</div>
					<div style="font-size:0.775rem; color:var(--neutral-400); margin-top:0.25rem;">سعة تخزين الأدوية المتاحة</div>
				</div>
			</div>

			<!-- Branches Grid List -->
			if len(data.Branches) == 0 {
				<div class="card" style="padding:4rem 2rem; text-align:center;">
					<div style="width:64px; height:64px; border-radius:var(--radius-full); background:var(--primary-50); color:var(--primary-600); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem auto;">
						@components.IconBuilding("icon-lg")
					</div>
					<h3 style="font-size:1.35rem; font-weight:900; color:var(--neutral-900); margin-bottom:0.5rem;">
						لا توجد فروع مسجلة حتى الآن
					</h3>
					<p style="color:var(--neutral-500); font-size:0.925rem; max-width:480px; margin:0 auto 1.5rem auto;">
						أضف فرعك الرئيسي أو مستودعات التوزيع ليتمكن الصيادلة من معرفة أقرب نقطة استلام وشحن دوائي.
					</p>
					<button type="button" class="btn btn-primary" data-modal-open="add-branch-modal" style="font-weight:800; padding:0.65rem 1.75rem;">
						@components.IconPlus("icon-xs")
						<span>إضافة الفرع الأول الآن</span>
					</button>
				</div>
			} else {
				<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(360px, 1fr)); gap:1.5rem;">
					for _, b := range data.Branches {
						<div class="card hover-lift" style="margin-bottom:0; padding:1.75rem; border-radius:var(--radius-2xl); border:1px solid var(--border-card); display:flex; flex-direction:column; justify-content:space-between; background:#ffffff;">
							<div>
								<!-- Header Strip -->
								<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem;">
									<div>
										<div style="display:flex; align-items:center; gap:0.5rem;">
											<h3 style="font-size:1.2rem; font-weight:900; color:var(--neutral-900); margin:0;">
												{ b.Name.Get(i18n.Lang(lang)) }
											</h3>
											if b.IsMain {
												<span class="badge badge-sky" style="font-size:0.7rem; font-weight:800;">الفرع الرئيسي</span>
											}
										</div>
										if b.Code != "" {
											<div style="font-size:0.775rem; color:var(--primary-700); font-weight:800; margin-top:0.2rem;" class="tabular-nums">
												كود الفرع: { b.Code }
											</div>
										}
									</div>

									<span class={ "badge", templ.KV("badge-emerald", b.Status == "active" || b.Status == ""), templ.KV("badge-amber", b.Status != "active" && b.Status != "") } style="font-size:0.75rem; font-weight:800;">
										if b.Status == "active" || b.Status == "" {
											نشط ومتاح للتوريد
										} else {
											تحت التجهيز
										}
									</span>
								</div>

								<!-- Key Details List -->
								<div style="display:flex; flex-direction:column; gap:0.65rem; font-size:0.875rem; color:var(--neutral-600); margin-bottom:1.5rem; background:var(--neutral-50); padding:1rem; border-radius:var(--radius-lg);">
									<div style="display:flex; align-items:flex-start; gap:0.5rem;">
										@components.IconHome("icon-xs")
										<span style="flex:1;">العنوان: { b.Address }</span>
									</div>

									if b.Phone != "" {
										<div style="display:flex; align-items:center; gap:0.5rem;">
											@components.IconUser("icon-xs")
											<span>الهاتف: <strong class="tabular-nums">{ b.Phone }</strong></span>
										</div>
									}

									if b.ManagerName != "" {
										<div style="display:flex; align-items:center; gap:0.5rem;">
											@components.IconUsers("icon-xs")
											<span>المدير المسؤول: <strong>{ b.ManagerName }</strong></span>
										</div>
									}

									if b.HasColdStorage {
										<div style="display:flex; align-items:center; gap:0.5rem; color:var(--primary-700); font-weight:800;">
											@components.IconCheckCircle("icon-xs")
											<span>مجهز بغرفة تبريد دوائي مخصصة (2° - 8° م)</span>
										</div>
									}

									if b.CapacitySQM > 0 {
										<div style="display:flex; align-items:center; gap:0.5rem;">
											@components.IconPackage("icon-xs")
											<span>المساحة التخزينية: <strong class="tabular-nums">{ fmt.Sprintf("%.0f م²", b.CapacitySQM) }</strong></span>
										</div>
									}

									if b.OperatingHours != "" {
										<div style="display:flex; align-items:center; gap:0.5rem;">
											@components.IconClock("icon-xs")
											<span>مواعيد العمل: { b.OperatingHours }</span>
										</div>
									}
								</div>
							</div>

							<!-- Footer Map / Actions -->
							<div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--neutral-100); padding-top:1rem; margin-top:0.5rem;">
								if b.GoogleMapsURL != "" {
									<a href={ templ.SafeURL(b.GoogleMapsURL) } target="_blank" class="btn btn-secondary btn-sm" style="font-weight:700; gap:0.4rem;">
										@components.IconSearch("icon-xs")
										<span>عرض في خرائط Google</span>
									</a>
								} else if b.Latitude != nil && b.Longitude != nil {
									<a href={ templ.SafeURL(fmt.Sprintf("https://www.google.com/maps?q=%f,%f", *b.Latitude, *b.Longitude)) } target="_blank" class="btn btn-secondary btn-sm" style="font-weight:700; gap:0.4rem;">
										@components.IconSearch("icon-xs")
										<span>عرض الموقع على الخريطة</span>
									</a>
								} else {
									<span style="font-size:0.8rem; color:var(--neutral-400);">لا توجد إحداثيات محددة</span>
								}

								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/vendor/branches/%d/delete", b.ID)) } style="margin:0;" onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذا الفرع؟');">
									<button type="submit" class="btn btn-icon" style="color:var(--danger); width:32px; height:32px; background:transparent; border:none;" title="حذف الفرع">
										@components.IconClose("icon-xs")
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}

			<!-- Add Branch Modal -->
			<div id="add-branch-modal" class="modal-overlay" style="display:none;">
				<div class="modal-card" style="max-width:680px; width:95%; max-height:90vh; overflow-y:auto; background:#ffffff; border-radius:var(--radius-2xl); padding:2rem; box-shadow:var(--shadow-2xl);">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--neutral-100); padding-bottom:1rem;">
						<div style="display:flex; align-items:center; gap:0.6rem;">
							<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center;">
								@components.IconPlus("icon-xs")
							</div>
							<h3 style="font-size:1.35rem; font-weight:900; color:var(--neutral-900); margin:0;">
								إضافة فرع أو مستودع توزيع جديد
							</h3>
						</div>
						<button type="button" class="btn btn-secondary btn-icon" data-modal-close="add-branch-modal" style="width:32px; height:32px;">
							@components.IconClose("icon-xs")
						</button>
					</div>

					<form method="POST" action="/vendor/branches/new" style="display:flex; flex-direction:column; gap:1.25rem; margin:0;">
						<!-- Interactive GPS & Map Picker -->
						<div style="background:var(--neutral-900); color:#ffffff; padding:1.25rem; border-radius:var(--radius-xl); display:flex; flex-direction:column; gap:1rem;">
							<div style="display:flex; justify-content:space-between; align-items:center;">
								<span style="font-weight:800; font-size:0.875rem; color:var(--primary-300);">تحديد الموقع الجغرافي والإحداثيات (GPS)</span>
								<span style="font-size:0.75rem; color:var(--neutral-400);">انقر لتحديد موقع الفرع</span>
							</div>

							<!-- Mock Mini Map Visual Selector -->
							<div style="height:140px; border-radius:var(--radius-lg); background:#1e293b url('/static/img/map-placeholder.png') center/cover no-repeat; border:1px solid rgba(255,255,255,0.15); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
								<div style="background:rgba(15,23,42,0.75); backdrop-filter:blur(4px); padding:0.5rem 1rem; border-radius:var(--radius-md); font-size:0.8rem; font-weight:700; color:#fff; display:flex; align-items:center; gap:0.4rem;">
									@components.IconSearch("icon-xs")
									<span>القاهرة، مصر (30.0444° N, 31.2357° E)</span>
								</div>
							</div>

							<div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
								<div>
									<label class="form-label" style="color:var(--neutral-300); font-size:0.8rem;">خط العرض (Latitude)</label>
									<input type="number" step="0.000001" name="latitude" class="form-input" placeholder="30.044420" value="30.044420" style="background:rgba(255,255,255,0.08); color:#fff; border-color:rgba(255,255,255,0.15);" />
								</div>
								<div>
									<label class="form-label" style="color:var(--neutral-300); font-size:0.8rem;">خط الطول (Longitude)</label>
									<input type="number" step="0.000001" name="longitude" class="form-input" placeholder="31.235712" value="31.235712" style="background:rgba(255,255,255,0.08); color:#fff; border-color:rgba(255,255,255,0.15);" />
								</div>
							</div>

							<div>
								<label class="form-label" style="color:var(--neutral-300); font-size:0.8rem;">رابط الموقع على خرائط Google Maps</label>
								<input type="url" name="google_maps_url" class="form-input" placeholder="https://maps.google.com/?q=..." style="background:rgba(255,255,255,0.08); color:#fff; border-color:rgba(255,255,255,0.15);" />
							</div>
						</div>

						<!-- Basic Info -->
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div>
								<label class="form-label" for="br-name-ar">اسم الفرع / المستودع (عربي) *</label>
								<input type="text" id="br-name-ar" name="name_ar" class="form-input" placeholder="مثال: مستودع العبور المركزي" required />
							</div>
							<div>
								<label class="form-label" for="br-code">كود الفرع الداخلي (Code)</label>
								<input type="text" id="br-code" name="code" class="form-input tabular-nums" placeholder="مثال: WH-OBR-01" />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div>
								<label class="form-label" for="br-type">نوع المنشأة / المستودع *</label>
								<select id="br-type" name="warehouse_type" class="form-select">
									<option value="warehouse">مستودع أدوية مركزي رئيسي</option>
									<option value="fast_hub">نقطة توزيع وتوريد سريعة (Hub)</option>
									<option value="cold_depot">مستودع أدوية مبرد بالكامل (Cold Depot)</option>
									<option value="pharmacy_branch">صيدلية فرعية</option>
								</select>
							</div>
							<div>
								<label class="form-label" for="br-city">المحافظة / المدينة *</label>
								<select id="br-city" name="city_id" class="form-select" required>
									<option value="" disabled selected>اختر المحافظة</option>
									for _, c := range data.Cities {
										<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name.Get(i18n.Lang(lang)) }</option>
									}
								</select>
							</div>
						</div>

						<div>
							<label class="form-label" for="br-address">العنوان التفصيلي ونقطة العلام *</label>
							<input type="text" id="br-address" name="address" class="form-input" placeholder="المنطقة الصناعية الأولى، قطعة 48، بجوار مصنع..." required />
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div>
								<label class="form-label" for="br-manager">المدير المسؤول عن الفرع</label>
								<input type="text" id="br-manager" name="manager_name" class="form-input" placeholder="د. محمود شريف" />
							</div>
							<div>
								<label class="form-label" for="br-phone">هاتف التواصل المباشر للفرع *</label>
								<input type="tel" id="br-phone" name="phone" class="form-input tabular-nums" placeholder="01012345678" required />
							</div>
						</div>

						<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
							<div>
								<label class="form-label" for="br-cap">المساحة التخزينية (متر مربع)</label>
								<input type="number" id="br-cap" name="capacity_sqm" class="form-input tabular-nums" placeholder="مثال: 500" />
							</div>
							<div>
								<label class="form-label" for="br-hours">مواعيد العمل واستلام الشحنات</label>
								<input type="text" id="br-hours" name="operating_hours" class="form-input" placeholder="يومياً من 8 ص حتى 8 م" />
							</div>
						</div>

						<div style="background:var(--neutral-50); padding:1rem; border-radius:var(--radius-lg); border:1px solid var(--neutral-200); display:flex; flex-direction:column; gap:0.75rem;">
							<label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer; font-weight:800; font-size:0.875rem; color:var(--neutral-900);">
								<input type="checkbox" name="has_cold_storage" value="true" style="width:18px; height:18px;" />
								<span>الفرع مجهز بغرف وسلاسل تبريد دوائية (2° - 8° مئوية)</span>
							</label>

							<label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer; font-weight:800; font-size:0.875rem; color:var(--neutral-900);">
								<input type="checkbox" name="is_main" value="true" style="width:18px; height:18px;" />
								<span>تعيين هذا الفرع كفرع رئيسي معتمد للشركة</span>
							</label>
						</div>

						<div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem;">
							<button type="button" class="btn btn-secondary" data-modal-close="add-branch-modal">إلغاء</button>
							<button type="submit" class="btn btn-primary" style="font-weight:800; padding:0.75rem 2rem;">
								@components.IconCheck("icon-xs")
								<span>حفظ وإضافة الفرع</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}

func countColdStorageBranches(branches []*org.Branch) int {
	count := 0
	for _, b := range branches {
		if b.HasColdStorage {
			count++
		}
	}
	return count
}

func totalCapacitySQM(branches []*org.Branch) float64 {
	total := 0.0
	for _, b := range branches {
		total += b.CapacitySQM
	}
	return total
}
