package pages

import (
	"encoding/json"
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorBranchesData struct {
	Branches  []*org.Branch
	Cities    []*platformadmin.City
	Employees []*org.EmployeeView
}

var institutionalWorkCategories = []struct {
	Key     string
	LabelAr string
	LabelEn string
	Icon    string
}{
	{Key: "group", LabelAr: "مجموعة", LabelEn: "Group", Icon: ""},
	{Key: "sector", LabelAr: "قطاع", LabelEn: "Sector", Icon: ""},
	{Key: "startup", LabelAr: "شركة ناشئة", LabelEn: "Startup", Icon: ""},
	{Key: "sole_proprietorship", LabelAr: "مؤسسة فردية", LabelEn: "Sole Proprietorship", Icon: ""},
	{Key: "audience_category", LabelAr: "فئة جماهيرية", LabelEn: "Audience Category", Icon: ""},
	{Key: "retail", LabelAr: "تجزئة", LabelEn: "Retail", Icon: ""},
	{Key: "nonprofit", LabelAr: "منظمة غير ربحية", LabelEn: "Nonprofit Organization", Icon: ""},
	{Key: "factory", LabelAr: "مصنع", LabelEn: "Factory", Icon: ""},
	{Key: "cooperative", LabelAr: "جمعية تعاونية", LabelEn: "Cooperative", Icon: ""},
	{Key: "services", LabelAr: "خدمات", LabelEn: "Services", Icon: ""},
	{Key: "pharmacy", LabelAr: "صيدلية", LabelEn: "Pharmacy", Icon: ""},
	{Key: "joint_stock", LabelAr: "شركة مساهمة", LabelEn: "Joint Stock Company", Icon: ""},
}

templ VendorBranchesPage(data VendorBranchesData, lang, dir string) {
	@layouts.VendorShell("إدارة الفروع ونقاط التوزيع اللوجستية", "branches", lang, dir) {
		<div x-data="vendorBranchManager()" x-init="init()" class="page-container">
			
			<!-- Header Action Bar -->
			<div class="glass-panel p-6 mb-4">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-2xl">
							@components.IconMapPin("icon-sm")
						</div>
						<div>
							<h1 class="text-2xl font-black text-primary m-0">
								شبكة الفروع والمخازن المركزية
							</h1>
							<p class="text-xs text-secondary mt-1 mb-0">
								إدارة مواقع الفروع، إحداثيات GPS، الأعمال المؤسسية، وسلاسل التبريد الدوائية
							</p>
						</div>
					</div>

					<div>
						<button
							type="button"
							class="btn btn-primary font-bold text-xs px-4 py-2 gap-2"
							@click="resetToAddMode(); document.getElementById('branch-form-panel').scrollIntoView({behavior:'smooth'});"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة فرع جديد</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Quick Logistics Metrics -->
			<div class="dashboard-stat-grid cols-3 mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الفروع المسجلة</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", len(data.Branches)) }
					</div>
					<div class="text-xs text-muted mt-1">فروع ومخازن نشطة</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-success">سلاسل تبريد دوائية</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%d", countColdStorageBranches(data.Branches)) }
					</div>
					<div class="text-xs text-muted mt-1">مخازن مجهزة (2° - 8° مئوية)</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">المساحة التخزينية الكلية</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%.0f م²", totalCapacitySQM(data.Branches)) }
					</div>
					<div class="text-xs text-muted mt-1">سعة تخزين الأدوية المتاحة</div>
				</div>
			</div>

			<!-- Responsive 2-Column Split: Left = Branch List, Right = Unified Form Panel -->
			<div>
				
				<!-- Left Column: Branch Cards List -->
				<div class="d-flex flex-col gap-4">
					
					<!-- Search Input -->
					<div class="glass-panel p-3 mb-0">
						<input
							type="text"
							id="branch-search-input"
							placeholder="بحث في الفروع والمخازن حسب الاسم، الكود، أو العنوان..."
							class="form-input text-xs w-full"
							oninput="filterBranchesList(this.value)"
						/>
					</div>

					<div class="alert alert-warning p-3 d-flex items-center gap-2 text-xs mb-0">
						<span class="text-base">@components.IconInfo("icon-sm")</span>
						<span>
							لظهور منتجات الفرع في التغطية الجغرافية بدقة، تأكد من تعيين <strong>الأعمال المؤسسية</strong> والإحداثيات الجغرافية.
						</span>
					</div>

					<!-- Branch List Items -->
					if len(data.Branches) == 0 {
						<div class="glass-panel p-12 text-center empty-state-glass">
							<div class="text-4xl mb-3">@components.IconMapPin("icon-sm")</div>
							<h3 class="text-lg font-black text-primary mb-2">
								لا توجد فروع مسجلة حتى الآن
							</h3>
							<p class="text-xs text-secondary max-w-md mx-auto mb-4">
								أضف فرعك الرئيسي أو مخزنك المركزي عبر اللوحة المجاورة ليتمكن الصيادلة من معرفة نطاق التغطية والاستلام.
							</p>
							<button type="button" class="btn btn-primary btn-sm font-bold text-xs" @click="resetToAddMode()">
								@components.IconPlus("icon-xs")
								<span>بدء تعبئة بيانات الفرع الأول</span>
							</button>
						</div>
					} else {
						<div id="branches-container" class="d-flex flex-col gap-3">
							for _, b := range data.Branches {
								<div
									class="branch-card glass-panel p-5 d-flex flex-col gap-3"
									data-name={ b.Name.Get(i18n.Lang(lang)) }
									data-code={ b.Code }
								>
									<!-- Card Header -->
									<div class="flex-between items-start gap-3 flex-wrap">
										<div>
											<div class="d-flex items-center gap-2">
												<h3 class="text-base font-black text-primary m-0">
													{ b.Name.Get(i18n.Lang(lang)) }
												</h3>
												if b.IsMain {
													<span class="badge badge-sky text-xs font-black">الفرع الرئيسي</span>
												}
												if b.Status == "active" {
													<span class="badge badge-emerald text-xs font-bold">نشط</span>
												} else {
													<span class="badge badge-rose text-xs font-bold">معطل</span>
												}
											</div>
											if b.Code != "" {
												<div class="text-xs text-brand font-bold mt-1 tabular-nums">
													كود الفرع: { b.Code }
												</div>
											}
										</div>

										<div class="d-flex items-center gap-2">
											if b.GoogleMapsURL != "" {
												<a href={ templ.SafeURL(b.GoogleMapsURL) } target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm font-bold text-xs" title="فتح في Google Maps">
													<span>خرائط Google</span>
												</a>
											}
										</div>
									</div>

									<!-- Card Details Grid -->
									<div class="d-grid grid-cols-2 gap-2 text-xs bg-surface-sunken p-3 rounded-xl border">
										<div>
											<strong class="text-muted d-block text-xs mb-0.5">العنوان والمقر:</strong>
											<span class="text-primary font-bold">{ b.Address }</span>
										</div>
										<div>
											<strong class="text-muted d-block text-xs mb-0.5">مدير الفرع:</strong>
											if b.ManagerName != "" {
												<span class="text-brand font-bold">{ b.ManagerName }</span>
											} else {
												<span class="text-muted">غير محدد</span>
											}
										</div>
										<div>
											<strong class="text-muted d-block text-xs mb-0.5">سلسلة التبريد:</strong>
											if b.HasColdStorage {
												<span class="badge badge-emerald text-xs font-bold">مبرد (2° - 8° مئوية)</span>
											} else {
												<span class="text-secondary">تخزين جاف عادي</span>
											}
										</div>
										<div>
											<strong class="text-muted d-block text-xs mb-0.5">المساحة التخزينية:</strong>
											<span class="tabular-nums font-bold text-primary">{ fmt.Sprintf("%.0f م²", b.CapacitySQM) }</span>
										</div>
									</div>

									<!-- Institutional Works Tags -->
									if len(b.InstitutionalWorks) > 0 {
										<div>
											<div class="text-xs font-bold text-muted uppercase mb-1">
												الأعمال المؤسسية المغطاة:
											</div>
											<div class="d-flex flex-wrap gap-1">
												for _, cat := range b.InstitutionalWorks {
													<span class="badge badge-slate text-xs font-bold">
														{ formatInstitutionalWorkLabel(cat) }
													</span>
												}
											</div>
										</div>
									}

									<!-- Card Actions -->
									<div class="flex-between items-center border-t pt-3 mt-1">
										<div class="text-xs text-muted tabular-nums">
											if b.Latitude != nil && b.Longitude != nil {
												<span>{ fmt.Sprintf("%.4f, %.4f", *b.Latitude, *b.Longitude) }</span>
											}
										</div>

										<div class="d-flex items-center gap-2">
											<button
												type="button"
												class="btn btn-secondary btn-sm font-bold text-xs gap-1"
												data-edit-branch-btn={ fmt.Sprintf("%d", b.ID) }
												@click={ fmt.Sprintf("setEditMode({id: %d, name_ar: %q, name_en: %q, code: %q, warehouse_type: %q, city_id: %d, manager_id: %d, address: %q, phone: %q, capacity_sqm: %.0f, google_maps_url: %q, has_cold_storage: %t, is_main: %t, latitude: %f, longitude: %f, institutional_works: %s})",
													b.ID, b.Name.Get("ar"), b.Name.Get("en"), b.Code, b.WarehouseType,
													func() int64 { if b.CityID != nil { return *b.CityID }; return 0 }(),
													func() int64 { if b.ManagerID != nil { return *b.ManagerID }; return 0 }(),
													b.Address, b.Phone, b.CapacitySQM, b.GoogleMapsURL, b.HasColdStorage, b.IsMain,
													func() float64 { if b.Latitude != nil { return *b.Latitude }; return 30.0444 }(),
													func() float64 { if b.Longitude != nil { return *b.Longitude }; return 31.2357 }(),
													formatWorksSliceJSON(b.InstitutionalWorks)) }
											>
												@components.IconEdit("icon-xs")
												<span>تعديل</span>
											</button>

											<form action={ templ.SafeURL(fmt.Sprintf("/vendor/branches/%d/delete", b.ID)) } method="POST" onsubmit="return confirm('هل أنت متأكد من حذف هذا الفرع؟');" class="m-0">
												<button type="submit" class="btn btn-secondary btn-sm btn-icon text-danger" title="حذف الفرع">
													@components.IconTrash("icon-xs")
												</button>
											</form>
										</div>
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- Right Column: Sticky Form Panel with Add / Edit Modes -->
				<div id="branch-form-panel" class="glass-panel p-6 d-flex flex-col gap-4 sticky top-6">
					
					<!-- Form Header -->
					<div class="flex-between items-center pb-3 border-b">
						<div class="d-flex items-center gap-2">
							<span class="text-xl" x-text="mode === 'edit' ? '' : ''"></span>
							<div>
								<h2 class="text-base font-black text-primary m-0" x-text="mode === 'edit' ? 'تعديل بيانات الفرع: ' + (form.name_ar || '') : 'إضافة فرع / مخزن جديد'">
								</h2>
								<p class="text-xs text-secondary m-0 mt-0.5" x-text="mode === 'edit' ? 'تحديث وتعديل بيانات الفرع المحدد وموقعه الجغرافي' : 'أدخل بيانات الفرع أو المستودع وموقعه لإضافته لشبكتك'">
								</p>
							</div>
						</div>

						<!-- Exit Edit Mode Button -->
						<template x-if="mode === 'edit'">
							<button
								type="button"
								class="btn btn-secondary btn-xs font-bold gap-1"
								@click="resetToAddMode()"
								title="الخروج من وضع التعديل والعودة لإضافة فرع جديد"
							>
								<span>الخروج من وضع التعديل</span>
							</button>
						</template>
					</div>

					<form method="POST" :action="formAction" class="d-flex flex-col gap-3 m-0">
						
						<!-- Section 1: Names & Code -->
						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									اسم الفرع (بالعربية) <span class="text-danger">*</span>
								</label>
								<input type="text" name="name_ar" x-model="form.name_ar" required placeholder="مثال: الفرع الرئيسي - القاهرة" class="form-input text-xs w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									اسم الفرع (بالإنجليزية) <span class="text-danger">*</span>
								</label>
								<input type="text" name="name_en" x-model="form.name_en" placeholder="e.g. Main Branch - Cairo" class="form-input text-xs w-full" dir="ltr"/>
							</div>
						</div>

						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									كود الفرع (Branch Code)
								</label>
								<input type="text" name="code" x-model="form.code" placeholder="مثال: BR-CAI-01" class="form-input text-xs tabular-nums w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									نوع المنشأة اللوجستية <span class="text-danger">*</span>
								</label>
								<select name="warehouse_type" x-model="form.warehouse_type" class="form-input text-xs w-full">
									<option value="warehouse">مخزن أدوية مركزي (Warehouse)</option>
									<option value="fast_hub">نقطة توزيع سريعة (Fast Hub)</option>
									<option value="cold_depot">مخزن تبريد مخصص (Cold Depot)</option>
									<option value="pharmacy_branch">فرع صيدلية (Pharmacy Branch)</option>
								</select>
							</div>
						</div>

						<!-- Section 2: Interactive Location Map & GPS -->
						<div class="d-flex flex-col gap-1">
							<label class="form-label text-xs font-bold text-secondary mb-1 d-block">
								موقع الفرع الجغرافي وخريطة OpenStreetMap
							</label>

							<div data-map-picker data-default-lat="30.0444" data-default-lon="31.2357" class="border rounded-xl overflow-hidden bg-surface-sunken position-relative">
								<div class="map-container map-canvas"></div>
								
								<div class="flex-between items-center p-2 bg-surface-raised border-t text-xs">
									<span data-map-coords-badge class="tabular-nums font-bold text-brand">30.0444, 31.2357</span>
									<button type="button" data-map-locate class="btn btn-secondary btn-xs font-bold">
										<span>موقعي الحالي</span>
									</button>
								</div>

								<input type="hidden" name="latitude" data-map-input="lat" :value="form.latitude"/>
								<input type="hidden" name="longitude" data-map-input="lon" :value="form.longitude"/>
							</div>
						</div>

						<!-- Google Maps URL Input -->
						<div>
							<label class="form-label text-xs font-bold text-primary mb-1 d-block">
								رابط خرائط Google (Google Maps URL)
							</label>
							<input type="text" name="google_maps_url" x-model="form.google_maps_url" data-map-input="google_url" placeholder="الصق أي رابط من Google Maps لاستخراج الإحداثيات فوراً..." class="form-input text-xs w-full"/>
						</div>

						<!-- Section 3: City, Address, Manager -->
						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									المدينة / المحافظة <span class="text-danger">*</span>
								</label>
								<select name="city_id" x-model="form.city_id" data-map-city class="form-input text-xs w-full">
									<option value="">-- اختر المدينة --</option>
									for _, c := range data.Cities {
										<option
											value={ fmt.Sprintf("%d", c.ID) }
											data-lat={ fmt.Sprintf("%.6f", c.Latitude) }
											data-lng={ fmt.Sprintf("%.6f", c.Longitude) }
										>
											{ c.Name.Get(i18n.Lang(lang)) }
										</option>
									}
								</select>
							</div>

							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									مدير الفرع المسؤول
								</label>
								<select name="manager_id" x-model="form.manager_id" class="form-input text-xs w-full">
									<option value="">-- تعيين مدير من الموظفين --</option>
									for _, emp := range data.Employees {
										if emp.Member != nil {
											<option value={ fmt.Sprintf("%d", emp.Member.UserID) }>
												{ emp.UserName } ({ emp.RoleName })
											</option>
										}
									}
								</select>
							</div>
						</div>

						<div>
							<label class="form-label text-xs font-bold text-primary mb-1 d-block">
								العنوان التفصيلي <span class="text-danger">*</span>
							</label>
							<input type="text" name="address" x-model="form.address" required placeholder="مثال: المنطقة الصناعية الثانية، قطعة 42" class="form-input text-xs w-full"/>
						</div>

						<div class="d-grid grid-cols-2 gap-3">
							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									رقم هاتف الفرع
								</label>
								<input type="tel" name="phone" x-model="form.phone" placeholder="010XXXXXXXX" class="form-input text-xs tabular-nums w-full"/>
							</div>

							<div>
								<label class="form-label text-xs font-bold text-primary mb-1 d-block">
									المساحة التخزينية (م²)
								</label>
								<input type="number" name="capacity_sqm" x-model="form.capacity_sqm" placeholder="500" class="form-input text-xs tabular-nums w-full"/>
							</div>
						</div>

						<!-- Section 4: Institutional Works (12 Categories) -->
						<div class="bg-surface-sunken p-3 rounded-xl border d-flex flex-col gap-2">
							<label class="text-xs font-black text-primary m-0 d-block">
								الأعمال المؤسسية المغطاة (Institutional Works)
							</label>

							<div class="d-grid grid-cols-2 gap-1.5 mt-1">
								for _, cat := range institutionalWorkCategories {
									<label class="d-flex items-center gap-1.5 text-xs text-secondary cursor-pointer p-1 rounded hover:bg-surface-raised">
										<input type="checkbox" name="institutional_works" value={ cat.Key } x-model="form.institutional_works" class="form-checkbox"/>
										<span>{ cat.Icon } { cat.LabelAr }</span>
									</label>
								}
							</div>
						</div>

						<!-- Section 5: Checkboxes -->
						<div class="d-grid grid-cols-2 gap-3 py-1">
							<label class="d-flex items-center gap-2 text-xs font-bold text-primary cursor-pointer p-2 rounded-lg bg-surface-sunken border">
								<input type="checkbox" name="has_cold_storage" value="true" x-model="form.has_cold_storage" class="form-checkbox"/>
								<span>سلسلة تبريد (2° - 8°)</span>
							</label>

							<label class="d-flex items-center gap-2 text-xs font-bold text-primary cursor-pointer p-2 rounded-lg bg-surface-sunken border">
								<input type="checkbox" name="is_main" value="true" x-model="form.is_main" class="form-checkbox"/>
								<span>تعيين كفرع رئيسي</span>
							</label>
						</div>

						<!-- Submit Button -->
						<button type="submit" class="btn btn-primary btn-sm font-black w-full justify-center py-2.5 mt-2">
							@components.IconCheck("icon-xs")
							<span x-text="mode === 'edit' ? 'حفظ تحديثات الفرع' : 'حفظ وإضافة الفرع الآن'"></span>
						</button>
					</form>
				</div>
			</div>
		</div>

		<script>
			function vendorBranchManager() {
				return {
					mode: 'add',
					editId: 0,
					formAction: '/vendor/branches/new',
					form: {
						id: 0,
						name_ar: '',
						name_en: '',
						code: '',
						warehouse_type: 'warehouse',
						city_id: '',
						manager_id: '',
						address: '',
						phone: '',
						capacity_sqm: '',
						google_maps_url: '',
						has_cold_storage: false,
						is_main: false,
						latitude: 30.0444,
						longitude: 31.2357,
						institutional_works: []
					},
					init() {
						const urlParams = new URLSearchParams(window.location.search);
						const editParam = urlParams.get('edit');
						if (editParam) {
							const btn = document.querySelector(`[data-edit-branch-btn="${editParam}"]`);
							if (btn) btn.click();
						}
					},
					setEditMode(b) {
						this.mode = 'edit';
						this.editId = b.id;
						this.formAction = '/vendor/branches/' + b.id + '/edit';
						this.form = {
							id: b.id,
							name_ar: b.name_ar || '',
							name_en: b.name_en || '',
							code: b.code || '',
							warehouse_type: b.warehouse_type || 'warehouse',
							city_id: b.city_id ? String(b.city_id) : '',
							manager_id: b.manager_id ? String(b.manager_id) : '',
							address: b.address || '',
							phone: b.phone || '',
							capacity_sqm: b.capacity_sqm || '',
							google_maps_url: b.google_maps_url || '',
							has_cold_storage: !!b.has_cold_storage,
							is_main: !!b.is_main,
							latitude: b.latitude || 30.0444,
							longitude: b.longitude || 31.2357,
							institutional_works: Array.isArray(b.institutional_works) ? b.institutional_works : []
						};
						const formEl = document.getElementById('branch-form-panel');
						if (formEl) {
							formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
						}
					},
					resetToAddMode() {
						this.mode = 'add';
						this.editId = 0;
						this.formAction = '/vendor/branches/new';
						this.form = {
							id: 0,
							name_ar: '',
							name_en: '',
							code: '',
							warehouse_type: 'warehouse',
							city_id: '',
							manager_id: '',
							address: '',
							phone: '',
							capacity_sqm: '',
							google_maps_url: '',
							has_cold_storage: false,
							is_main: false,
							latitude: 30.0444,
							longitude: 31.2357,
							institutional_works: []
						};
					}
				};
			}

			function filterBranchesList(q) {
				const query = (q || '').toLowerCase().trim();
				const cards = document.querySelectorAll('.branch-card');
				cards.forEach(card => {
					const name = (card.getAttribute('data-name') || '').toLowerCase();
					const code = (card.getAttribute('data-code') || '').toLowerCase();
					if (!query || name.includes(query) || code.includes(query)) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});
			}
		</script>
	}
}

func countColdStorageBranches(branches []*org.Branch) int {
	c := 0
	for _, b := range branches {
		if b.HasColdStorage {
			c++
		}
	}
	return c
}

func totalCapacitySQM(branches []*org.Branch) float64 {
	var total float64
	for _, b := range branches {
		total += b.CapacitySQM
	}
	return total
}

func formatInstitutionalWorkLabel(key string) string {
	for _, cat := range institutionalWorkCategories {
		if cat.Key == key {
			return cat.Icon + " " + cat.LabelAr
		}
	}
	return key
}

func formatWorksSliceJSON(works []string) string {
	if len(works) == 0 {
		return "[]"
	}
	b, err := json.Marshal(works)
	if err != nil {
		return "[]"
	}
	return string(b)
}
