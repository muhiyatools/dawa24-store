package pages

import (
	"encoding/json"
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type VendorBranchesData struct {
	Branches   []*org.Branch
	Cities     []*platformadmin.City
	Employees  []*org.EmployeeView
	Page       int
	PerPage    int
	TotalCount int
}

func formatVendorBranchJSON(b *org.Branch) string {
	if b == nil {
		return "{}"
	}
	cityID := int64(0)
	if b.CityID != nil {
		cityID = *b.CityID
	}
	managerID := int64(0)
	if b.ManagerID != nil {
		managerID = *b.ManagerID
	}
	lat := 30.0444
	if b.Latitude != nil {
		lat = *b.Latitude
	}
	lon := 31.2357
	if b.Longitude != nil {
		lon = *b.Longitude
	}
	m := map[string]any{
		"id":                  b.ID,
		"name_ar":             b.Name.Get("ar"),
		"name_en":             b.Name.Get("en"),
		"code":                b.Code,
		"warehouse_type":      b.WarehouseType,
		"city_id":             cityID,
		"manager_id":          managerID,
		"address":             b.Address,
		"phone":               b.Phone,
		"capacity_sqm":        b.CapacitySQM,
		"google_maps_url":     b.GoogleMapsURL,
		"has_cold_storage":    b.HasColdStorage,
		"is_main":             b.IsMain,
		"latitude":            lat,
		"longitude":           lon,
		"institutional_works": b.InstitutionalWorks,
	}
	bytes, err := json.Marshal(m)
	if err != nil {
		return "{}"
	}
	return string(bytes)
}

// institutionalWorkCategories and formatInstitutionalWorkLabel live in
// institutional_categories.go — shared with the pharmacy branch screen.

templ VendorBranchesPage(data VendorBranchesData, lang, dir string) {
	@layouts.VendorShell("إدارة الفروع ونقاط التوزيع اللوجستية", "branches", lang, dir) {
		<div x-data="vendorBranchManager()" x-init="init()" class="page-container">
			
			<!-- Header Action Bar -->
			<div class="glass-panel p-6 mb-4">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-2xl">
							@components.IconMapPin("icon-sm")
						</div>
      <div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">
								شبكة الفروع والمخازن المركزية
							</h1>
							<p class="text-xs text-secondary mt-1 mb-0">
								إدارة مواقع الفروع، إحداثيات GPS، الأعمال المؤسسية، وسلاسل التبريد الدوائية
							</p>
						</div>
					</div>

     <div class="stack-sm">
						<button
							type="button"
							class="btn btn-primary font-bold text-xs px-4 py-2 gap-2"
							@click="resetToAddMode(); document.getElementById('branch-form-panel').scrollIntoView({behavior:'smooth'});"
						>
							@components.IconPlus("icon-xs")
							<span>إضافة فرع جديد</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Quick Logistics Metrics -->
			<div class="dashboard-stat-grid cols-3 mb-6">
				<div class="stat-card-3d">
					<div class="stat-card-label">إجمالي الفروع المسجلة</div>
					<div class="stat-card-value text-primary tabular-nums">
						{ fmt.Sprintf("%d", len(data.Branches)) }
					</div>
					<div class="text-xs text-muted mt-1">فروع ومخازن نشطة</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-success">سلاسل تبريد دوائية</div>
					<div class="stat-card-value text-success tabular-nums">
						{ fmt.Sprintf("%d", countColdStorageBranches(data.Branches)) }
					</div>
					<div class="text-xs text-muted mt-1">مخازن مجهزة (2° - 8° مئوية)</div>
				</div>

				<div class="stat-card-3d">
					<div class="stat-card-label text-brand">المساحة التخزينية الكلية</div>
					<div class="stat-card-value text-brand tabular-nums">
						{ fmt.Sprintf("%.0f م²", totalCapacitySQM(data.Branches)) }
					</div>
					<div class="text-xs text-muted mt-1">سعة تخزين الأدوية المتاحة</div>
				</div>
			</div>

			<!-- Two-column split. In RTL the first grid child sits on the right, so
			     the list is declared first and the form lands on the left, which is
			     where it is expected. The wrapper had no class at all, so there was
			     no grid and the two panels simply stacked. -->
			<div class="branches-split">
				
				<!-- Branch cards list (right in RTL, left in LTR) -->
				<div class="d-flex flex-col gap-4">
					
					<!-- Search Input -->
					<div class="glass-panel p-3 mb-0">
						<input
							type="text"
							id="branch-search-input"
							placeholder="بحث في الفروع والمخازن حسب الاسم، الكود، أو العنوان..."
							class="form-input text-xs w-full"
							oninput="filterBranchesList(this.value)"
						/>
					</div>

					<div class="alert alert-warning p-3 d-flex items-center gap-2 text-xs mb-0">
						<span class="text-base">@components.IconInfo("icon-sm")</span>
						<span>
							لظهور منتجات الفرع في التغطية الجغرافية بدقة، تأكد من تعيين <strong>الأعمال المؤسسية</strong> والإحداثيات الجغرافية.
						</span>
					</div>

					<!-- Branch List Items -->
					if len(data.Branches) == 0 {
						<div class="glass-panel p-12 text-center empty-state-glass">
							<div class="text-4xl mb-3">@components.IconMapPin("icon-sm")</div>
							<h3 class="text-lg font-black text-primary mb-2">
								لا توجد فروع مسجلة حتى الآن
							</h3>
							<p class="text-xs text-secondary max-w-md mx-auto mb-4">
								أضف فرعك الرئيسي أو مخزنك المركزي عبر اللوحة المجاورة ليتمكن الصيادلة من معرفة نطاق التغطية والاستلام.
							</p>
							<button type="button" class="btn btn-primary btn-sm font-bold text-xs" @click="resetToAddMode()">
								@components.IconPlus("icon-xs")
								<span>بدء تعبئة بيانات الفرع الأول</span>
							</button>
						</div>
					} else {
						<div id="branches-container" class="d-flex flex-col gap-3">
							for _, b := range data.Branches {
								<div
									class="branch-card glass-panel p-5 d-flex flex-col gap-3"
									data-name={ b.Name.Get(i18n.Lang(lang)) }
									data-code={ b.Code }
								>
									<!-- Card Header -->
									<div class="flex-between items-start gap-3 flex-wrap">
          <div class="stack-sm">
											<div class="d-flex items-center gap-2">
												<h3 class="text-base font-black text-primary m-0">
													{ b.Name.Get(i18n.Lang(lang)) }
												</h3>
												if b.IsMain {
													<span class="badge badge-sky text-xs font-black">الفرع الرئيسي</span>
												}
												if b.Status == "active" {
													<span class="badge badge-emerald text-xs font-bold">نشط</span>
												} else {
													<span class="badge badge-rose text-xs font-bold">معطل</span>
												}
											</div>
											if b.Code != "" {
												<div class="text-xs text-brand font-bold mt-1 tabular-nums">
													كود الفرع: { b.Code }
												</div>
											}
										</div>

										<div class="d-flex items-center gap-2">
											if b.GoogleMapsURL != "" {
												<a href={ templ.SafeURL(b.GoogleMapsURL) } target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm font-bold text-xs" title="فتح في Google Maps">
													<span>خرائط Google</span>
												</a>
											}
										</div>
									</div>

									<!-- Card Details Grid -->
									<div class="d-grid grid-cols-2 gap-2 text-xs bg-surface-sunken p-3 rounded-xl border">
          <div class="stack-sm">
											<strong class="text-muted d-block text-xs mb-0.5">العنوان والمقر:</strong>
											<span class="text-primary font-bold">{ b.Address }</span>
										</div>
          <div class="stack-sm">
											<strong class="text-muted d-block text-xs mb-0.5">مدير الفرع:</strong>
											if b.ManagerName != "" {
												<span class="text-brand font-bold">{ b.ManagerName }</span>
											} else {
												<span class="text-muted">غير محدد</span>
											}
										</div>
          <div class="stack-sm">
											<strong class="text-muted d-block text-xs mb-0.5">سلسلة التبريد:</strong>
											if b.HasColdStorage {
												<span class="badge badge-emerald text-xs font-bold">مبرد (2° - 8° مئوية)</span>
											} else {
												<span class="text-secondary">تخزين جاف عادي</span>
											}
										</div>
          <div class="stack-sm">
											<strong class="text-muted d-block text-xs mb-0.5">المساحة التخزينية:</strong>
											<span class="tabular-nums font-bold text-primary">{ fmt.Sprintf("%.0f م²", b.CapacitySQM) }</span>
										</div>
									</div>

									<!-- Institutional Works Tags -->
									if len(b.InstitutionalWorks) > 0 {
          <div class="stack-sm">
											<div class="text-xs font-bold text-muted uppercase mb-1">
												الأعمال المؤسسية المغطاة:
											</div>
											<div class="d-flex flex-wrap gap-1">
												for _, cat := range b.InstitutionalWorks {
													<span class="badge badge-slate text-xs font-bold">
														{ formatInstitutionalWorkLabel(cat) }
													</span>
												}
											</div>
										</div>
									}

									<!-- Card Actions -->
									<div class="flex-between items-center border-t pt-3 mt-1">
										<div class="text-xs text-muted tabular-nums">
											if b.Latitude != nil && b.Longitude != nil {
												<span>{ fmt.Sprintf("%.4f, %.4f", *b.Latitude, *b.Longitude) }</span>
											}
										</div>

										<div class="d-flex items-center gap-2">
											<button
												type="button"
												class="btn btn-secondary btn-sm font-bold text-xs gap-1"
												data-edit-branch-btn={ fmt.Sprintf("%d", b.ID) }
												data-branch-data={ formatVendorBranchJSON(b) }
												@click="setEditModeFromElement($el)"
											>
												@components.IconEdit("icon-xs")
												<span>تعديل</span>
											</button>

											<form action={ templ.SafeURL(fmt.Sprintf("/vendor/branches/%d/delete", b.ID)) } method="POST" onsubmit="return confirm('هل أنت متأكد من حذف هذا الفرع؟');" class="m-0">
												<button type="submit" class="btn btn-secondary btn-sm btn-icon text-danger" title="حذف الفرع">
													@components.IconTrash("icon-xs")
												</button>
											</form>
										</div>
									</div>
								</div>
							}
						</div>
						if data.TotalCount > 0 {
							@components.B2BPagination(components.PaginationProps{
								CurrentPage: data.Page,
								PageSize:    data.PerPage,
								TotalCount:  data.TotalCount,
								BaseURL:     "/vendor/branches",
							})
						}
					}
				</div>

				<!-- Sticky form panel, add and edit modes (left in RTL, right in LTR) -->
				@VendorBranchesForm(data, lang)
			</div>
		</div>

		@VendorBranchesScript()
	}
}

func countColdStorageBranches(branches []*org.Branch) int {
	c := 0
	for _, b := range branches {
		if b.HasColdStorage {
			c++
		}
	}
	return c
}

func totalCapacitySQM(branches []*org.Branch) float64 {
	var total float64
	for _, b := range branches {
		total += b.CapacitySQM
	}
	return total
}

func formatWorksSliceJSON(works []string) string {
	if len(works) == 0 {
		return "[]"
	}
	b, err := json.Marshal(works)
	if err != nil {
		return "[]"
	}
	return string(b)
}
