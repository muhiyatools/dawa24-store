package pages

import (
	"fmt"
	"github.com/muhiya/dawa24-store/internal/modules/hr"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type UserDashboardData struct {
	User         *identity.User
	Applications []*hr.JobApplication
}

templ UserDashboardPage(data UserDashboardData, lang, dir string) {
	@layouts.IndividualShell("لوحة التحكم والملف المهني", "dashboard", lang, dir) {
		<div style="display:flex; flex-direction:column; gap:2rem;">
			
			<!-- Profile Card -->
			<div class="card hover-lift" style="margin-bottom:0; padding:2rem; border-radius:var(--radius-2xl); background:linear-gradient(135deg, #ffffff 0%, var(--primary-50) 100%); border:1px solid var(--primary-200);">
				<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem;">
					<div style="display:flex; align-items:center; gap:1.25rem;">
						<div style="width:72px; height:72px; border-radius:var(--radius-full); background:var(--primary-100); color:var(--primary-700); display:flex; align-items:center; justify-content:center; font-size:1.75rem; font-weight:900; border:2px solid var(--primary-300);">
							@components.IconUser("icon-md")
						</div>
						<div>
							<div style="display:flex; align-items:center; gap:0.6rem;">
								<h2 style="font-size:1.5rem; font-weight:900; color:var(--neutral-900); margin:0;">
									if data.User != nil {
										{ data.User.Name.Get(i18n.Lang(lang)) }
									} else {
										د. صيدلي
									}
								</h2>
								<span class="badge badge-sky" style="font-weight:800;">حساب مهني معتمد</span>
							</div>
							<p style="color:var(--neutral-600); font-size:0.925rem; margin:0.35rem 0 0 0;">
								if data.User != nil && data.User.Email != "" {
									البريد: <span class="tabular-nums">{ data.User.Email }</span>
								}
								if data.User != nil && data.User.Phone != "" {
									<span style="margin-inline-start:1rem;">الهاتف: <span class="tabular-nums">{ data.User.Phone }</span></span>
								}
							</p>
						</div>
					</div>

					<div style="display:flex; gap:0.75rem;">
						<a href="/jobs" class="btn btn-primary" style="font-weight:800; padding:0.7rem 1.5rem;">
							@components.IconSearch("icon-xs")
							<span>تصفح وظائف الصيدليات الشاغرة</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Applied Jobs Section -->
			<div class="card" style="padding:0; overflow:hidden; border:1px solid var(--neutral-200); border-radius:var(--radius-xl);">
				<div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--neutral-200); display:flex; justify-content:space-between; align-items:center;">
					<div>
						<h3 style="font-size:1.2rem; font-weight:800; color:var(--neutral-900); margin:0;">
							طلبات التوظيف والفرص التي تقدمت إليها
						</h3>
						<p style="font-size:0.85rem; color:var(--neutral-500); margin-top:0.2rem;">
							متابعة حالة مراجعة السيرة الذاتية والتواصل مع أصحاب العمل
						</p>
					</div>
				</div>

				if len(data.Applications) == 0 {
					<div style="padding:4rem 2rem; text-align:center;">
						<div style="width:60px; height:60px; border-radius:var(--radius-full); background:var(--primary-50); color:var(--primary-600); display:flex; align-items:center; justify-content:center; margin:0 auto 1.25rem auto;">
							@components.IconFile("icon-lg")
						</div>
						<h3 style="font-size:1.25rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.5rem;">
							لم تتقدم لأي وظائف بعد
						</h3>
						<p style="color:var(--neutral-500); font-size:0.9rem; max-width:440px; margin:0 auto 1.5rem auto;">
							استعرض أحدث الوظائف المنشورة من كبرى شركات الأدوية وسلاسل الصيدليات وقدم سيرتك الذاتية بضغطة زر.
						</p>
						<a href="/jobs" class="btn btn-primary" style="font-weight:800; display:inline-flex;">
							@components.IconSearch("icon-xs")
							<span>استكشاف الوظائف المتاحة</span>
						</a>
					</div>
				} else {
					<div class="table-container" style="margin:0; border:none;">
						<table class="table" style="margin:0;">
							<thead>
								<tr>
									<th>رقم الطلب</th>
									<th>الوظيفة المتقدم إليها</th>
									<th>تاريخ التقديم</th>
									<th>حالة الطلب</th>
									<th>ملاحظات جهة العمل</th>
								</tr>
							</thead>
							<tbody>
								for _, app := range data.Applications {
									<tr>
										<td class="tabular-nums" style="font-weight:700; color:var(--primary-700);">
											#{ fmt.Sprintf("APP-%d", app.ID) }
										</td>
										<td>
											<span style="font-weight:800; color:var(--neutral-900);">
												وظيفة شاغرة #{ fmt.Sprintf("%d", app.JobOfferID) }
											</span>
										</td>
										<td class="tabular-nums" style="color:var(--neutral-600); font-size:0.875rem;">
											{ app.CreatedAt.Format("2006-01-02 15:04") }
										</td>
										<td>
											if app.Status == "hired" || app.Status == "accepted" {
												<span class="badge badge-emerald" style="font-weight:800;">تم القبول المبدئي</span>
											} else if app.Status == "reviewed" || app.Status == "interview" {
												<span class="badge badge-sky" style="font-weight:800;">قيد المقابلة والمراجعة</span>
											} else if app.Status == "rejected" {
												<span class="badge badge-slate" style="font-weight:800;">مرفوض</span>
											} else {
												<span class="badge badge-amber" style="font-weight:800;">قيد الفحص والتدقيق</span>
											}
										</td>
										<td>
											if app.Notes != "" {
												<span style="font-size:0.85rem; color:var(--neutral-700);">{ app.Notes }</span>
											} else {
												<span style="color:var(--neutral-400); font-size:0.85rem;">بانتظار رد مسؤول التوظيف</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}
