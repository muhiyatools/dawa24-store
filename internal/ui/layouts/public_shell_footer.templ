package layouts

import (
	platformadmin "github.com/muhiya/dawa24-store/internal/modules/platform_admin"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/platform/features"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ publicMobileNav(site *platformadmin.SiteSettings) {
	<div
		class="nav-scrim"
		x-show="mobileNav"
		x-cloak
		x-transition:enter="ease-out duration-200"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		@click="mobileNav = false"
	></div>

	<div
		class="nav-drawer"
		x-show="mobileNav"
		x-cloak
		x-transition:enter="transform transition ease-in-out duration-300"
		x-transition:enter-start="translate-x-full"
		x-transition:enter-end="translate-x-0"
		x-transition:leave="transform transition ease-in-out duration-200"
		x-transition:leave-start="translate-x-0"
		x-transition:leave-end="translate-x-full"
	>
		<div class="nav-drawer-head">
			<span class="nav-brand-text">
				<span class="nav-brand-name">دوا 24</span>
			</span>
			<button
				type="button"
				@click="mobileNav = false"
				class="nav-btn nav-btn--icon"
				aria-label="إغلاق القائمة"
			>
				@components.IconX("icon-sm")
			</button>
		</div>

		<div class="nav-drawer-body">
			if actor, ok := authctx.From(ctx); ok {
				<nav class="nav-drawer-section" aria-label="روابط الحساب">
					<span class="nav-drawer-label">حسابي</span>
					if actor.IsCustomer() && actor.IsOrgApproved() {
						<a href="/customer/dashboard" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconHome("icon-sm")
							<span>لوحة تحكم الصيدلية</span>
						</a>
						<a href="/catalog" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconPill("icon-sm")
							<span>كتالوج الأدوية الموحد</span>
						</a>
						if features.Enabled(ctx, "offers.enabled") {
							<a href="/offers" class="nav-drawer-link" @click="mobileNav = false">
								@components.IconPercent("icon-sm")
								<span>عروض وتخفيضات الموردين</span>
							</a>
						}
						<a href="/suppliers" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconBuilding("icon-sm")
							<span>دليل الموردين والمصانع</span>
						</a>
						<a href="/cart" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconCart("icon-sm")
							<span>سلة المشتريات</span>
						</a>
					} else if actor.IsVendor() && actor.IsOrgApproved() {
						<a href="/vendor/dashboard" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconHome("icon-sm")
							<span>لوحة تحكم المورد</span>
						</a>
						<a href="/vendor/products" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconPackage("icon-sm")
							<span>الأصناف والمخزون</span>
						</a>
					} else if actor.IsStaff {
						<a href="/admin/dashboard" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconChart("icon-sm")
							<span>لوحة التحكم الرئيسية</span>
						</a>
					} else {
						<a href="/documents" class="nav-drawer-link" @click="mobileNav = false">
							@components.IconFile("icon-sm")
							<span>السندات والمستندات</span>
						</a>
					}
				</nav>
			}

			<nav class="nav-drawer-section" aria-label="التنقل الرئيسي">
				<span class="nav-drawer-label">المنصة</span>
				@drawerLink("/how-it-works", "كيف تعمل المنصة") {
					@components.IconZap("icon-sm")
				}
				@drawerLink("/about", "من نحن") {
					@components.IconBuilding("icon-sm")
				}
				@drawerLink("/contact", "تواصل معنا") {
					@components.IconPhone("icon-sm")
				}
				if features.Enabled(ctx, "jobs.enabled") {
					@drawerLink("/jobs", "وظائف التوظيف الصيدلي") {
						@components.IconBriefcase("icon-sm")
					}
				}
				@drawerLink("/faq", "الأسئلة الشائعة") {
					@components.IconFileText("icon-sm")
				}
			</nav>
		</div>

		if actor, ok := authctx.From(ctx); ok {
			<div class="nav-drawer-foot">
				<div class="nav-drawer-account">
					<span class="nav-avatar" aria-hidden="true">{ components.Initials(actor.DisplayName()) }</span>
					<span class="nav-menu-identity">
						<span class="nav-menu-name">{ actor.DisplayName() }</span>
						if actor.Email != "" {
							<span class="nav-menu-detail">{ actor.Email }</span>
						}
					</span>
				</div>
				<form action="/auth/logout" method="POST" class="nav-menu-form">
					<button type="submit" class="nav-btn nav-btn--outline">
						@components.IconLogout("icon-xs")
						<span>تسجيل الخروج</span>
					</button>
				</form>
			</div>
		} else {
			<div class="nav-drawer-foot">
				<a href="/auth/login" class="nav-btn nav-btn--outline" @click="mobileNav = false">
					@components.IconUser("icon-xs")
					<span>تسجيل الدخول</span>
				</a>
				<a href="/auth/register" class="nav-btn nav-btn--solid" @click="mobileNav = false">
					<span>انضمام للمنصة</span>
				</a>
			</div>
		}
	</div>
}

// drawerLink is the ruled row used by the mobile sheet. It takes its icon as
// children so the caller keeps naming the icon it wants without this template
// growing a switch over icon names.
templ drawerLink(href string, label string) {
	<a
		href={ templ.SafeURL(href) }
		class={ "nav-drawer-link", templ.KV("is-active", IsCurrentPath(ctx, href)) }
		@click="mobileNav = false"
		if IsCurrentPath(ctx, href) {
			aria-current="page"
		}
	>
		{ children... }
		<span>{ label }</span>
	</a>
}

templ publicFooter(site *platformadmin.SiteSettings) {
	<footer class="site-footer">
		<div class="footer-content">
			<!-- Brand & Bio -->
			<div class="stack-sm">
				<div class="footer-brand">
					<img src={ site.LogoURL } alt={ site.SiteName } class="footer-logo" />
					<div class="stack-sm">
						<div class="footer-brand-name">
							دوا 24
						</div>
						<div class="footer-brand-subtitle">
							منظومة الربط والتوريد الدوائي المباشر
						</div>
					</div>
				</div>
				<p class="footer-description">
					منصة التوريد الذكية توفر تجربة شاملة وآمنة لربط العملاء بالموردين، مع نظام موثوق يسهل عمليات الشراء والتوريد، ويدعم التواصل المباشر، والتحليلات المتقدمة، والدعم الفني المتواصل 24/7 لتحقيق كفاءة وأمان أعلى.
				</p>
				<div class="footer-social-links">
					if site.SocialLinks["facebook"] != "" {
						<a href={ templ.SafeURL(site.SocialLinks["facebook"]) } target="_blank" rel="noopener" class="footer-social-btn" title="فيسبوك">
							@components.IconFacebook("icon-xs")
						</a>
					}
					if site.SocialLinks["twitter"] != "" {
						<a href={ templ.SafeURL(site.SocialLinks["twitter"]) } target="_blank" rel="noopener" class="footer-social-btn" title="تويتر (X)">
							@components.IconTwitter("icon-xs")
						</a>
					}
					if site.SocialLinks["linkedin"] != "" {
						<a href={ templ.SafeURL(site.SocialLinks["linkedin"]) } target="_blank" rel="noopener" class="footer-social-btn" title="لينكد إن">
							@components.IconLinkedIn("icon-xs")
						</a>
					}
					if site.SocialLinks["whatsapp"] != "" {
						<a href={ templ.SafeURL("https://wa.me/" + site.SocialLinks["whatsapp"]) } target="_blank" rel="noopener" class="footer-social-btn" title="واتساب">
							@components.IconWhatsApp("icon-xs")
						</a>
					}
					if site.SocialLinks["instagram"] != "" {
						<a href={ templ.SafeURL(site.SocialLinks["instagram"]) } target="_blank" rel="noopener" class="footer-social-btn" title="إنستغرام">
							@components.IconInstagram("icon-xs")
						</a>
					}
					if site.SocialLinks["tiktok"] != "" {
						<a href={ templ.SafeURL(site.SocialLinks["tiktok"]) } target="_blank" rel="noopener" class="footer-social-btn" title="تيك توك">
							@components.IconTikTok("icon-xs")
						</a>
					}
				</div>
			</div>

			<!-- Quick Links -->
			<div class="stack-sm">
				<h4 class="footer-heading">
					خدمات وروابط المنصة
				</h4>
				<ul class="footer-link-list">
					<li><a href="/about">من نحن (عن دوا 24)</a></li>
					<li><a href="/how-it-works">كيف تعمل المنصة؟</a></li>
					if features.Enabled(ctx, "jobs.enabled") {
						<li><a href="/jobs">شواغر التوظيف الطبي</a></li>
					}
					<li><a href="/faq">الأسئلة الشائعة (FAQ)</a></li>
					<li><a href="/contact">التواصل والدعم</a></li>
					if _, ok := authctx.From(ctx); !ok {
						<li><a href="/auth/register">انضمام الصيدليات والموردين</a></li>
					}
				</ul>
			</div>

			<!-- Contact & Support -->
			<div class="stack-sm">
				<h4 class="footer-heading">
					التواصل والدعم الفني
				</h4>
				<ul class="footer-link-list footer-contact-list">
					<li class="row-center-sm">
						@components.IconMail("icon-sm")
						<a href={ templ.SafeURL("mailto:" + site.SupportEmail) } class="contact-link">{ site.SupportEmail }</a>
					</li>
					<li class="row-center-sm">
						@components.IconPhone("icon-sm")
						<a href={ templ.SafeURL("tel:" + site.Phone) } class="tabular-nums contact-link">{ site.Phone }</a>
					</li>
					if site.Address != "" {
						<li class="footer-address">
							@components.IconBuilding("icon-sm")
							<span>{ site.Address }</span>
						</li>
					}
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<div class="footer-copyright-group">
				<p class="footer-copyright-text">جميع الحقوق محفوظة © 2026 لدى دوا 24.</p>
				<div class="footer-developer-credit">
					<span>تم التطوير بواسطة</span>
					<a href="https://muhiya.com" target="_blank" rel="noopener" class="developer-link">
						<img src="/static/img/muhiya-logo.png" alt="Muhiya" class="developer-logo" />
						<span>Muhiya</span>
					</a>
				</div>
			</div>
			<div class="footer-legal-links">
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">شروط الاستخدام</a>
				<a href="/shipping-returns">الشحن والاسترجاع والإلغاء</a>
				<a href="/cookies">ملفات تعريف الارتباط</a>
				<a href="/payment-policy">سياسة الدفع</a>
			</div>
		</div>
	</footer>
}
