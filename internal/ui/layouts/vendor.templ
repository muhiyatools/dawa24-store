package layouts

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorShell(title string, activeNav string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir) {
			<div class="app-shell">
				<!-- Sidebar -->
				<aside class="sidebar">
					<div class="sidebar-header" style="padding:1.25rem 1.25rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.08);">
						<div style="display:flex; align-items:center; gap:0.75rem; overflow:hidden;">
							<img src={ site.LogoURL } alt={ site.SiteName } style="height:46px; max-height:48px; object-fit:contain;" />
							<div style="display:flex; flex-direction:column;">
								<span style="font-weight:700; font-size:1.15rem; color:#ffffff; line-height:1.2;">{ site.SiteName }</span>
								<span style="font-size:0.75rem; color:var(--text-muted); font-weight:700;">بوابة الموردين والمستودعات</span>
							</div>
						</div>
					<button type="button" class="btn btn-icon" data-sidebar-toggle style="background:rgba(255,255,255,0.08); color:#ffffff; width:34px; height:34px; border:none; border-radius:var(--radius-md); flex-shrink:0;" title="طي/توسيع القائمة">
						@components.IconMenu("icon-xs")
					</button>
				</div>

				<nav class="sidebar-nav" style="padding:0.75rem 0.65rem; display:flex; flex-direction:column; gap:0.25rem;">
					<!-- 1. لوحة التحكم -->
					<a href="/vendor/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
						@components.IconHome("icon-sm")
						<span>لوحة التحكم</span>
					</a>

					<!-- 2. بيانات المنشأة -->
					<a href="/settings/organization" class={ "sidebar-link", templ.KV("active", activeNav == "organization") }>
						@components.IconBuilding("icon-sm")
						<span>بيانات المنشأة</span>
					</a>

					<!-- 3. الفروع -->
					<a href="/vendor/branches" class={ "sidebar-link", templ.KV("active", activeNav == "branches") }>
						@components.IconBuilding("icon-sm")
						<span>الفروع</span>
					</a>

					<!-- 4. الموظفون -->
					<a href="/settings/employees" class={ "sidebar-link", templ.KV("active", activeNav == "employees" || activeNav == "team") }>
						@components.IconUsers("icon-sm")
						<span>الموظفون</span>
					</a>

					<!-- 5. الأدوار والصلاحيات -->
					<a href="/vendor/roles" class={ "sidebar-link", templ.KV("active", activeNav == "roles") }>
						@components.IconShield("icon-sm")
						<span>الأدوار والصلاحيات</span>
					</a>

					<!-- 6. رفع الموظفين دفعة واحدة -->
					<a href="/vendor/team/import" class={ "sidebar-link", templ.KV("active", activeNav == "team_import") }>
						@components.IconUpload("icon-sm")
						<span>رفع الموظفين دفعة واحدة</span>
					</a>

					<!-- 7. التغطية الأسبوعية -->
					<a href="/vendor/coverage" class={ "sidebar-link", templ.KV("active", activeNav == "coverage") }>
						@components.IconTruck("icon-sm")
						<span>التغطية الأسبوعية</span>
					</a>

					<!-- 8. تغطية الصيدليات -->
					<a href="/vendor/pharmacy-coverage" class={ "sidebar-link", templ.KV("active", activeNav == "pharmacy_coverage") }>
						@components.IconUsers("icon-sm")
						<span>تغطية الصيدليات</span>
					</a>

					<!-- 9. اختيار المنتجات المتاحة -->
					<a href="/vendor/catalog/select" class={ "sidebar-link", templ.KV("active", activeNav == "catalog_select") }>
						@components.IconPackage("icon-sm")
						<span>اختيار المنتجات المتاحة</span>
					</a>

					<!-- 10. منتجاتي -->
					<a href="/vendor/products" class={ "sidebar-link", templ.KV("active", activeNav == "products" || activeNav == "variants") }>
						@components.IconPill("icon-sm")
						<span>منتجاتي</span>
					</a>

					<!-- 11. استيراد المنتجات -->
					<a href="/vendor/ingest" class={ "sidebar-link", templ.KV("active", activeNav == "ingest") }>
						@components.IconUpload("icon-sm")
						<span>استيراد المنتجات</span>
					</a>

					<!-- 12. منتجات التوفير -->
					<a href="/vendor/saving-products" class={ "sidebar-link", templ.KV("active", activeNav == "saving_products") }>
						@components.IconTag("icon-sm")
						<span>منتجات التوفير</span>
					</a>

					<!-- 13. المخزون -->
					<a href="/vendor/inventory" class={ "sidebar-link", templ.KV("active", activeNav == "inventory") }>
						@components.IconPackage("icon-sm")
						<span>المخزون</span>
					</a>

					<!-- 14. المستودعات -->
					<a href="/vendor/warehouses" class={ "sidebar-link", templ.KV("active", activeNav == "warehouses") }>
						@components.IconBuilding("icon-sm")
						<span>المستودعات</span>
					</a>

					<!-- 15. العروض -->
					<a href="/vendor/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
						@components.IconTag("icon-sm")
						<span>العروض</span>
					</a>

					<!-- 16-19. باقات العروض والرعايات -->
					<a href="/vendor/offers-packages" class={ "sidebar-link", templ.KV("active", activeNav == "offers_packages") }>
						@components.IconTag("icon-sm")
						<span>باقات العروض</span>
					</a>

					<!-- 20. الطلبات -->
					<a href="/vendor/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
						@components.IconTruck("icon-sm")
						<span>الطلبات</span>
					</a>

					<!-- 21. طلبات العروض -->
					<a href="/vendor/orders/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offer_orders") }>
						@components.IconFile("icon-sm")
						<span>طلبات العروض</span>
					</a>

					<!-- 22. الفواتير -->
					<a href="/invoices" class={ "sidebar-link", templ.KV("active", activeNav == "invoices") }>
						@components.IconFile("icon-sm")
						<span>الفواتير</span>
					</a>

					<!-- 23. المدفوعات -->
					<a href="/vendor/payments" class={ "sidebar-link", templ.KV("active", activeNav == "payments") }>
						@components.IconWallet("icon-sm")
						<span>المدفوعات</span>
					</a>

					<!-- 24. مقارنة الخصومات -->
					<a href="/compare/tool" class={ "sidebar-link", templ.KV("active", activeNav == "compare") }>
						@components.IconTrendingUp("icon-sm")
						<span>مقارنة الخصومات</span>
					</a>

					<!-- 25. خصومات السوق -->
					<a href="/market-discounts" class={ "sidebar-link", templ.KV("active", activeNav == "market-discounts") }>
						@components.IconBarChart("icon-sm")
						<span>خصومات السوق</span>
					</a>

					<!-- 26. الوظائف -->
					<a href="/vendor/jobs" class={ "sidebar-link", templ.KV("active", activeNav == "jobs") }>
						@components.IconFile("icon-sm")
						<span>الوظائف</span>
					</a>

					<!-- 27. المستندات -->
					<a href="/vendor/documents" class={ "sidebar-link", templ.KV("active", activeNav == "documents") }>
						@components.IconFile("icon-sm")
						<span>المستندات</span>
					</a>

					<!-- 28. السياسات -->
					<a href="/vendor/policies" class={ "sidebar-link", templ.KV("active", activeNav == "policies") }>
						@components.IconShield("icon-sm")
						<span>السياسات</span>
					</a>

					<!-- 29. وسائل التواصل -->
					<a href="/vendor/social-media" class={ "sidebar-link", templ.KV("active", activeNav == "social_media") }>
						@components.IconMail("icon-sm")
						<span>وسائل التواصل</span>
					</a>

					<!-- 30. الأقسام المميزة -->
					<a href="/vendor/storefront" class={ "sidebar-link", templ.KV("active", activeNav == "storefront") }>
						@components.IconTag("icon-sm")
						<span>الأقسام المميزة</span>
					</a>

					<!-- 31. سجل النشاطات -->
					<a href="/vendor/activities" class={ "sidebar-link", templ.KV("active", activeNav == "activities") }>
						@components.IconClock("icon-sm")
						<span>سجل النشاطات</span>
					</a>

					<!-- 32. عضوية المنشآت -->
					<a href="/settings/organization" class={ "sidebar-link", templ.KV("active", activeNav == "user_organization") }>
						@components.IconUsers("icon-sm")
						<span>عضوية المنشآت</span>
					</a>
				</nav>

				<div style="margin-top:auto; border-top:1px solid rgba(255,255,255,0.08); padding:0.75rem; display:flex; flex-direction:column; gap:0.5rem;">
					<a href="/catalog" class="btn sidebar-footer-btn" style="width:100%; justify-content:center; font-weight:600; padding:0.6rem 0.75rem; color:rgba(255,255,255,0.85); background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radius-md);" title="كتالوج المنتجات">
						@components.IconPackage("icon-sm")
						<span>كتالوج المنتجات</span>
					</a>
				</div>
			</aside>

			<!-- Main Content -->
			<main class="main-content">
				<header class="top-navbar" style="border-bottom:1px solid var(--border); background:var(--surface-raised); padding:0 var(--space-6); height:var(--header-height); display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:var(--z-sticky);">
					<div style="display:flex; align-items:center; gap:var(--space-3);">
						<h1 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">{ title }</h1>
					</div>

					<div style="display:flex; align-items:center; gap:var(--space-3);">
						@components.LanguageToggle(lang)
						@components.ThemeToggle()
						<span class="badge badge-emerald" style="padding:0.3rem 0.65rem; font-weight:600; font-size:var(--text-xs);">
							@components.IconCheckCircle("icon-xs")
							<span>مورد معتمد</span>
						</span>
						<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
							<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger-text); border-color:var(--danger-border); font-weight:600;">
								@components.IconLogout("icon-xs")
								<span>تسجيل الخروج</span>
							</button>
						</form>
					</div>
				</header>

				<div class="page-container" style="padding:2rem;">
					{ children... }
				</div>
			</main>
		</div>
	}
	}
}
