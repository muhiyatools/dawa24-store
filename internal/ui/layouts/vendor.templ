package layouts

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorShell(title string, activeNav string, lang string, dir string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<aside class="sidebar">
				<div class="sidebar-header">
					<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--primary-700); color:#fff; display:flex; align-items:center; justify-content:center;">
						@components.IconBuilding("icon-sm")
					</div>
					<span>بوابة الموردين</span>
				</div>
				<nav class="sidebar-nav">
					<a href="/vendor/products" class={ "sidebar-link", templ.KV("active", activeNav == "products") }>
						@components.IconPill("icon-sm")
						<span>قائمة المنتجات</span>
					</a>
					<a href="/vendor/products/new" class={ "sidebar-link", templ.KV("active", activeNav == "new_product") }>
						@components.IconPlus("icon-sm")
						<span>إضافة صنف جديد</span>
					</a>
					<a href="/vendor/inventory" class={ "sidebar-link", templ.KV("active", activeNav == "inventory") }>
						@components.IconPackage("icon-sm")
						<span>الأرصدة والمخازن</span>
					</a>
					<a href="/vendor/transfers" class={ "sidebar-link", templ.KV("active", activeNav == "transfers") }>
						@components.IconRefresh("icon-sm")
						<span>التحويلات المخزنية</span>
					</a>
					<a href="/vendor/ingest" class={ "sidebar-link", templ.KV("active", activeNav == "ingest") }>
						@components.IconUpload("icon-sm")
						<span>استيراد ملفات الكتالوج</span>
					</a>
					<a href="/vendor/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
						@components.IconTruck("icon-sm")
						<span>الشحنات والتوريد</span>
					</a>
					<a href="/vendor/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
						@components.IconMegaphone("icon-sm")
						<span>العروض والإعلانات</span>
					</a>
				</nav>
				<div style="border-top:1px solid var(--neutral-800); padding:1rem; display:flex; flex-direction:column; gap:0.5rem;">
					<a href="/catalog" style="color:var(--neutral-400); font-size:0.875rem; display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0.75rem; text-decoration:none;">
						@components.IconArrowLeft("icon-xs")
						<span>العودة للسوق</span>
					</a>
				</div>
			</aside>

			<main class="main-content">
				<header class="top-navbar">
					<div>
						<h1 style="font-size:1.15rem; font-weight:700; color:var(--neutral-900);">{ title }</h1>
					</div>
					<div style="display:flex; align-items:center; gap:1rem;">
						<span class="badge badge-emerald">
							@components.IconCheckCircle("icon-xs")
							<span>مورد معتمد</span>
						</span>
						<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
							<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">
								@components.IconLogout("icon-xs")
								<span>خروج</span>
							</button>
						</form>
					</div>
				</header>
				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
}
