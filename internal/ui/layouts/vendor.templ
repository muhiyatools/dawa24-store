package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/rbac"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorShell(title string, activeNav string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir) {
			<div class="app-shell">
				<!-- Sidebar -->
				<aside class="sidebar">
					<div class="sidebar-header">
						<div class="sidebar-brand">
							<img class="sidebar-logo" src={ site.LogoURL } alt={ site.SiteName } />
							<div class="sidebar-brand-copy">
								<span class="sidebar-brand-name">{ site.SiteName }</span>
								<span class="sidebar-brand-subtitle">بوابة الموردين والمخازن</span>
							</div>
						</div>
					<button type="button" class="btn btn-icon sidebar-toggle" data-sidebar-toggle title="طي/توسيع القائمة">
						@components.IconSidebarToggle("icon-xs")
					</button>
				</div>

				@SidebarNav(rbac.ScopeVendor, activeNav, lang)
			</aside>

			<!-- Main Content -->
			<main class="main-content">
				<header class="top-navbar">
					<div class="top-navbar-start">
						<h1 class="top-navbar-title">{ title }</h1>
					</div>

					<div class="top-navbar-end">
						@components.LanguageToggle(lang)
						@components.ThemeToggle()
						<span class="badge badge-emerald font-semibold">
							@components.IconCheckCircle("icon-xs")
							<span>مورد معتمد</span>
						</span>
						<form action="/auth/logout" method="POST" class="m-0 inline">
							<button type="submit" class="btn btn-secondary btn-sm btn-logout" title="تسجيل الخروج">
								@components.IconLogout("icon-xs")
								<span>تسجيل الخروج</span>
							</button>
						</form>
					</div>
				</header>

				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
	}
}
