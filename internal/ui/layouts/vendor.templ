package layouts

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorShell(title string, activeNav string, lang string, dir string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-header" style="padding:1.25rem 1.25rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--neutral-800);">
					<div style="display:flex; align-items:center; gap:0.75rem; overflow:hidden;">
						<img src="/static/img/logo.png" alt="DAWA24" style="height:46px; max-height:48px; object-fit:contain;" />
						<div style="display:flex; flex-direction:column;">
							<span style="font-weight:900; font-size:1.1rem; color:#ffffff; line-height:1.2;">دواء 24</span>
							<span style="font-size:0.75rem; color:var(--primary-400); font-weight:700;">بوابة الموردين</span>
						</div>
					</div>
					<button type="button" class="btn btn-icon" data-sidebar-toggle style="background:rgba(255,255,255,0.08); color:#ffffff; width:34px; height:34px; border:none; border-radius:var(--radius-md); flex-shrink:0;" title="طي/توسيع القائمة">
						@components.IconMenu("icon-xs")
					</button>
				</div>
				<nav class="sidebar-nav" style="padding:1rem 0.75rem; display:flex; flex-direction:column; gap:0.25rem;">
					<a href="/vendor/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
						@components.IconChart("icon-sm")
						<span>لوحة التحكم</span>
					</a>
					<a href="/vendor/products" class={ "sidebar-link", templ.KV("active", activeNav == "products") }>
						@components.IconPill("icon-sm")
						<span>قائمة المنتجات</span>
					</a>
					<a href="/vendor/products/new" class={ "sidebar-link", templ.KV("active", activeNav == "new_product") }>
						@components.IconPlus("icon-sm")
						<span>إضافة صنف جديد</span>
					</a>
					<a href="/vendor/inventory" class={ "sidebar-link", templ.KV("active", activeNav == "inventory") }>
						@components.IconPackage("icon-sm")
						<span>الأرصدة والمخازن</span>
					</a>
					<a href="/vendor/transfers" class={ "sidebar-link", templ.KV("active", activeNav == "transfers") }>
						@components.IconRefresh("icon-sm")
						<span>التحويلات المخزنية</span>
					</a>
					<a href="/vendor/ingest" class={ "sidebar-link", templ.KV("active", activeNav == "ingest") }>
						@components.IconUpload("icon-sm")
						<span>استيراد ملفات الكتالوج</span>
					</a>
					<a href="/vendor/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
						@components.IconTruck("icon-sm")
						<span>الشحنات والتوريد</span>
					</a>
					<a href="/vendor/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
						@components.IconMegaphone("icon-sm")
						<span>العروض والإعلانات</span>
					</a>
				</nav>
				<div style="margin-top:auto; border-top:1px solid var(--neutral-800); padding:1rem; display:flex; flex-direction:column; gap:0.5rem;">
					<a href="/catalog" style="color:var(--neutral-400); font-size:0.875rem; display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0.75rem; text-decoration:none; border-radius:var(--radius-md); transition:background 0.15s ease;">
						@components.IconArrowLeft("icon-xs")
						<span>العودة للمتجر الدوائي</span>
					</a>
				</div>
			</aside>

			<main class="main-content">
				<header class="top-navbar" style="border-bottom:1px solid var(--border-subtle); background:#ffffff; padding:0 2rem; height:4rem; display:flex; align-items:center; justify-content:space-between;">
					<div style="display:flex; align-items:center; gap:1rem;">
						<button type="button" class="btn btn-secondary btn-icon" data-sidebar-toggle style="width:36px; height:36px;" title="طي / توسيع القائمة">
							@components.IconMenu("icon-xs")
						</button>
						<h1 style="font-size:1.2rem; font-weight:800; color:var(--neutral-900); margin:0;">{ title }</h1>
					</div>
					<div style="display:flex; align-items:center; gap:1rem;">
						<span class="badge badge-emerald">
							@components.IconCheckCircle("icon-xs")
							<span>مورد معتمد</span>
						</span>
						<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
							<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border); font-weight:700;">
								@components.IconLogout("icon-xs")
								<span>خروج</span>
							</button>
						</form>
					</div>
				</header>
				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
}
