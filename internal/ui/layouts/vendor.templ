package layouts

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ VendorShell(title string, activeNav string, lang string, dir string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-header" style="padding:1.25rem 1.25rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--neutral-800);">
					<div style="display:flex; align-items:center; gap:0.75rem; overflow:hidden;">
						<img src="/static/img/logo.png" alt="دواء 24" style="height:46px; max-height:48px; object-fit:contain;" />
						<div style="display:flex; flex-direction:column;">
							<span style="font-weight:900; font-size:1.15rem; color:#ffffff; line-height:1.2; font-family:'Cairo', sans-serif;">دواء <span style="color:var(--primary-400);">24</span></span>
							<span style="font-size:0.75rem; color:var(--neutral-400); font-weight:700;">بوابة الموردين والمستودعات</span>
						</div>
					</div>
					<button type="button" class="btn btn-icon" data-sidebar-toggle style="background:rgba(255,255,255,0.08); color:#ffffff; width:34px; height:34px; border:none; border-radius:var(--radius-md); flex-shrink:0;" title="طي/توسيع القائمة">
						@components.IconMenu("icon-xs")
					</button>
				</div>

				<nav class="sidebar-nav" style="padding:1rem 0.75rem; display:flex; flex-direction:column; gap:0.25rem;">
					<a href="/vendor/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
						@components.IconHome("icon-sm")
						<span>لوحة التحكم الرئيسية</span>
					</a>

					<a href="/vendor/products" class={ "sidebar-link", templ.KV("active", activeNav == "products" || activeNav == "variants") }>
						@components.IconPill("icon-sm")
						<span>عروض وأصناف التوريد</span>
					</a>

					<a href="/vendor/variants/new" class={ "sidebar-link", templ.KV("active", activeNav == "new_variant") }>
						@components.IconPlus("icon-sm")
						<span>إضافة عرض توريد لصنف</span>
					</a>

					<a href="/vendor/inventory" class={ "sidebar-link", templ.KV("active", activeNav == "inventory") }>
						@components.IconPackage("icon-sm")
						<span>الأرصدة والمخازن</span>
					</a>

					<a href="/vendor/branches" class={ "sidebar-link", templ.KV("active", activeNav == "branches") }>
						@components.IconBuilding("icon-sm")
						<span>الفروع ونقاط التوزيع</span>
					</a>

					<a href="/vendor/team" class={ "sidebar-link", templ.KV("active", activeNav == "team") }>
						@components.IconUsers("icon-sm")
						<span>الموظفين وصلاحيات الفريق</span>
					</a>

					<a href="/vendor/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
						@components.IconTruck("icon-sm")
						<span>أوامر التوريد والشحنات</span>
					</a>

					<a href="/vendor/jobs" class={ "sidebar-link", templ.KV("active", activeNav == "jobs") }>
						@components.IconFile("icon-sm")
						<span>وظائف المنشأة والتوظيف</span>
					</a>

					<a href="/vendor/transfers" class={ "sidebar-link", templ.KV("active", activeNav == "transfers") }>
						@components.IconRefresh("icon-sm")
						<span>التحويلات المخزنية</span>
					</a>

					<a href="/vendor/ingest" class={ "sidebar-link", templ.KV("active", activeNav == "ingest") }>
						@components.IconUpload("icon-sm")
						<span>استيراد ملفات الكتالوج</span>
					</a>

					<a href="/vendor/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
						@components.IconMegaphone("icon-sm")
						<span>العروض والخصومات</span>
					</a>
				</nav>

				<div style="margin-top:auto; border-top:1px solid var(--neutral-800); padding:1rem 0.75rem; display:flex; flex-direction:column; gap:0.5rem;">
					<a href="/catalog" class="btn btn-secondary" style="width:100%; justify-content:center; font-weight:800; padding:0.65rem; color:#ffffff; background:rgba(255,255,255,0.08); border-color:transparent;">
						@components.IconSearch("icon-xs")
						<span>استعراض المتجر الدوائي</span>
					</a>
				</div>
			</aside>

			<!-- Main Content -->
			<main class="main-content">
				<header class="top-navbar" style="border-bottom:1px solid var(--border-subtle); background:#ffffff; padding:0 2rem; height:4.25rem; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100;">
					<div style="display:flex; align-items:center; gap:1rem;">
						<button type="button" class="btn btn-secondary btn-icon" data-sidebar-toggle style="width:36px; height:36px;" title="طي / توسيع القائمة">
							@components.IconMenu("icon-xs")
						</button>
						<h1 style="font-size:1.3rem; font-weight:900; color:var(--neutral-900); margin:0;">{ title }</h1>
					</div>

					<div style="display:flex; align-items:center; gap:1rem;">
						<span class="badge badge-emerald" style="padding:0.35rem 0.75rem; font-weight:800; font-size:0.8rem;">
							@components.IconCheckCircle("icon-xs")
							<span>مورد معتمد</span>
						</span>
						<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
							<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border); font-weight:800;">
								@components.IconLogout("icon-xs")
								<span>تسجيل الخروج</span>
							</button>
						</form>
					</div>
				</header>

				<div class="page-container" style="padding:2rem;">
					{ children... }
				</div>
			</main>
		</div>
	}
}
