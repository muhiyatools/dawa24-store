package layouts

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/assistant"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// Base is the document shell every page renders inside.
//
// Three things changed here and each was a real cost:
//
//   - Every stylesheet and script is served from this application. htmx, Alpine
//     and Leaflet were loaded from unpkg and cdnjs on every request, which made
//     each page render depend on two third-party hosts being up and fast, and
//     two of the three carried no integrity attribute. The self-hosted copies
//     were verified against the integrity hashes that were pinned here before
//     they were moved.
//
//   - Leaflet is no longer loaded at all by default. It was on every page in
//     the platform and is used by two of them. app.js pulls it in when a map
//     element is actually present.
//
//   - Asset URLs carry a content hash instead of a hand-typed version string.
//     The old ones had drifted: the stylesheets said 2026082903 and the script
//     said 2026082901, so a CSS change could ship without its JavaScript.
//
// GetSiteSettings never returns nil — it falls back to a complete default — so
// the nil check that used to wrap this entire template could not fire. It has
// been removed rather than left to imply a failure mode that does not exist.
templ Base(title string, lang string, dir string, extraCSS ...string) {
	{{ site := GetSiteSettings(ctx) }}
	<!DOCTYPE html>
	<html lang={ lang } dir={ dir }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="session-idle-timeout-mins" content={ fmt.Sprintf("%d", site.SessionIdleTimeoutMinutes) }/>
			<title>{ title } | { site.SiteName }</title>
			<script>
				(function() {
					var urlTheme = new URLSearchParams(window.location.search).get('theme');
					var t = urlTheme || localStorage.getItem('dawa24-theme') || 'system';
					var isDark = t === 'dark' || (t === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
					document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');

					// Early scroll restoration, before first paint.
					try {
						var raw = sessionStorage.getItem('dawa24_scroll_pos');
						if (raw) {
							var data = JSON.parse(raw);
							if (data && typeof data.y === 'number' && (Date.now() - data.time < 20000)) {
								window.scrollTo(0, data.y);
							}
						}
					} catch (e) {}
				})();
			</script>
			// Asset leaves an uploaded favicon URL alone and hashes a bundled one.
			<link rel="icon" type="image/png" href={ Asset(site.FaviconURL) }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700;800&family=Spline+Sans+Mono:wght@400;500;600;700&display=swap"/>
			<link rel="stylesheet" href={ Asset("/static/css/tokens.css") }/>
			<link rel="stylesheet" href={ Asset("/static/css/base.css") }/>
			<link rel="stylesheet" href={ Asset("/static/css/layout.css") }/>
			<link rel="stylesheet" href={ Asset("/static/css/components.css") }/>
			// nav.css carries the whole navigation visual system -- both bars, every
			// popover, the mobile drawer. It loads on every page because the chrome
			// is on every page, and it sits after components.css because it
			// deliberately supersedes the header rules that used to live there.
			<link rel="stylesheet" href={ Asset("/static/css/nav.css") }/>
			<link rel="stylesheet" href={ Asset("/static/css/foundations.css") }/>
			<link rel="stylesheet" href={ Asset("/static/css/utilities.css") }/>
			<link rel="stylesheet" href={ Asset("/static/css/wizard.css") }/>
			<link rel="stylesheet" href={ Asset("/static/css/app.css") }/>
			for _, cssPath := range extraCSS {
				<link rel="stylesheet" href={ Asset(cssPath) }/>
			}
			<script defer src={ Asset("/static/vendor/htmx-1.9.10.min.js") }></script>
			<script defer src={ Asset("/static/vendor/alpine-3.13.5.min.js") }></script>
			<script defer src={ Asset("/static/js/app.js") }></script>
			// maps.js defines ensureLeaflet + initMapPickers. It is ~9 KB and self
			// -contained; Leaflet itself (the ~200 KB payload) is still fetched on
			// demand by ensureLeaflet only when a map element is present. Loading
			// this shim on every page is what makes the picker work everywhere it
			// appears -- registration, branches, admin cities, offer locations.
			<script defer src={ Asset("/static/js/maps.js") }></script>
		</head>
		<body>
			{ children... }
			// The floating assistant is a feature of the approved dashboard, and
			// now also of a role the owner has granted it to. Rendered for a
			// signed-out visitor, a قيد المراجعة account, or an employee whose
			// role does not hold the assistant permission, it would be a
			// launcher that opens onto endpoints refusing them — a button that
			// only sits there glowing.
			//
			// assistant.Allowed is the same function the API gate uses, so the
			// launcher and the endpoints can never disagree about who has it.
			if actor := authctx.FromContext(ctx); actor.IsOrgApproved() {
				if _, ok := assistant.Allowed(actor); ok {
					@components.CapsuleAssistantTrigger()
				}
			}
		</body>
	</html>
}
