package layouts

import (
	"context"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

func canAccessAdmin(ctx context.Context, perm string) bool {
	actor, ok := authctx.From(ctx)
	if !ok || !actor.IsStaff {
		return false
	}
	return actor.Role == "super_admin" || actor.Role == "developer" || actor.Can("*") || actor.Can(perm)
}

templ AdminShell(title string, activeNav string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir) {
			<div class="app-shell">
				<!-- Sidebar -->
				<aside class="sidebar">
					<div class="sidebar-header" style="padding:1.25rem 1.25rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.08);">
						<div style="display:flex; align-items:center; gap:0.75rem; overflow:hidden;">
							<img src={ site.LogoURL } alt={ site.SiteName } style="height:46px; max-height:48px; object-fit:contain;" />
							<div style="display:flex; flex-direction:column;">
								<span style="font-weight:700; font-size:1.1rem; color:#ffffff; line-height:1.2;">{ site.SiteName }</span>
								<span style="font-size:0.75rem; color:var(--primary-400); font-weight:700;">لوحة الإدارة والتحكم</span>
							</div>
						</div>
						<button type="button" class="btn btn-icon" data-sidebar-toggle style="background:rgba(255,255,255,0.08); color:#ffffff; width:34px; height:34px; border:none; border-radius:var(--radius-md); flex-shrink:0;" title="طي/توسيع القائمة">
							@components.IconMenu("icon-xs")
						</button>
					</div>

					<nav class="sidebar-nav" style="padding:0.75rem 0.65rem; display:flex; flex-direction:column; gap:0.5rem; overflow-y:auto;">
						
						<!-- Group 1: الرئيسية والمتابعة (dashboard_and_overview) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>الرئيسية والمتابعة</span>
							</div>
							<a href="/admin/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
								@components.IconChart("icon-sm")
								<span>لوحة المعلومات الرئيسية</span>
							</a>
							if canAccessAdmin(ctx, "notifications.notification.view") {
								<a href="/admin/notifications" class={ "sidebar-link", templ.KV("active", activeNav == "notifications") }>
									@components.IconBell("icon-sm")
									<span>مركز الإشعارات والتنبيهات</span>
								</a>
							}
						</div>

						<!-- Group 2: المؤسسة والمشرفين (organization_management) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>المؤسسة والمشرفين</span>
							</div>
							if canAccessAdmin(ctx, "org.organization.view") || canAccessAdmin(ctx, "identity.user.view") {
								<a href="/admin/organizations" class={ "sidebar-link", templ.KV("active", activeNav == "organizations" || activeNav == "branches" || activeNav == "users") }>
									@components.IconBuilding("icon-sm")
									<span>المنشآت والفروع والمستخدمين</span>
								</a>
							}
							if canAccessAdmin(ctx, "identity.user.view") {
								<a href="/admin/roles" class={ "sidebar-link", templ.KV("active", activeNav == "roles") }>
									@components.IconSettings("icon-sm")
									<span>الأدوار والصلاحيات (RBAC)</span>
								</a>
							}
							if canAccessAdmin(ctx, "org.organization.view") || canAccessAdmin(ctx, "hr.document.view") {
								<a href="/admin/approvals" class={ "sidebar-link", templ.KV("active", activeNav == "approvals" || activeNav == "documents" || activeNav == "ask_for") }>
									@components.IconShield("icon-sm")
									<span>اعتماد المنشآت والوثائق</span>
								</a>
							}
							if canAccessAdmin(ctx, "identity.user.view") {
								<a href="/admin/employee-activities" class={ "sidebar-link", templ.KV("active", activeNav == "employee_activities") }>
									@components.IconClock("icon-sm")
									<span>نشاط الموظفين</span>
								</a>
							}
							if canAccessAdmin(ctx, "platform.chat.view") {
							<a href="/admin/chat/history" class={ "sidebar-link", templ.KV("active", activeNav == "chat_history") }>
									@components.IconInbox("icon-sm")
									<span>سجل المحادثات</span>
								</a>
							}
						</div>

						<!-- Group 3: الإعدادات والمحتوى (settings_and_content) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>الإعدادات والمحتوى</span>
							</div>
							if canAccessAdmin(ctx, "platform.setting.view") {
								<a href="/admin/settings" class={ "sidebar-link", templ.KV("active", activeNav == "settings") }>
									@components.IconSettings("icon-sm")
									<span>إعدادات النظام العامة</span>
								</a>
							}
							if canAccessAdmin(ctx, "org.institutional_work.view") {
								<a href="/admin/institutional" class={ "sidebar-link", templ.KV("active", activeNav == "institutional") }>
									@components.IconLayers("icon-sm")
									<span>الأنشطة والأعمال المؤسسية</span>
								</a>
							}
							if canAccessAdmin(ctx, "platform.content.view") {
								<a href="/admin/cities" class={ "sidebar-link", templ.KV("active", activeNav == "cities") }>
									@components.IconLocation("icon-sm")
									<span>المحافظات والمدن</span>
								</a>
							}
							if canAccessAdmin(ctx, "platform.content.view") {
							<a href="/admin/content" class={ "sidebar-link", templ.KV("active", activeNav == "content" || activeNav == "highlight_sections") }>
									@components.IconFile("icon-sm")
									<span>محتوى الصفحات والأقسام</span>
								</a>
							}
							if canAccessAdmin(ctx, "platform.setting.view") {
								<a href="/admin/translations" class={ "sidebar-link", templ.KV("active", activeNav == "translations") }>
									@components.IconGlobe("icon-sm")
									<span>اللغات والترجمة</span>
								</a>
							}
						</div>

						<!-- Group 4: إدارة المنتجات والمخزون (inventory_management) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>المنتجات والمخزون</span>
							</div>
							if canAccessAdmin(ctx, "catalog.product.view") {
								<a href="/admin/products" class={ "sidebar-link", templ.KV("active", activeNav == "products") }>
									@components.IconPackage("icon-sm")
									<span>كتالوج الأدوية المعتمدة</span>
								</a>
								<a href="/admin/categories" class={ "sidebar-link", templ.KV("active", activeNav == "categories") }>
									@components.IconFolder("icon-sm")
									<span>فئات المنتجات</span>
								</a>
							}
							if canAccessAdmin(ctx, "catalog.product.manage") {
								<a href="/admin/products/import" class={ "sidebar-link", templ.KV("active", activeNav == "import") }>
									@components.IconUpload("icon-sm")
									<span>استيراد الكتالوج العام</span>
								</a>
								<a href="/admin/products/images/import" class={ "sidebar-link", templ.KV("active", activeNav == "product_images_import") }>
									@components.IconImage("icon-sm")
									<span>استرداد صور المنتجات أو الكتالوج الرسمي</span>
								</a>
							}
							if canAccessAdmin(ctx, "catalog.product.view") {
							<a href="/admin/brands" class={ "sidebar-link", templ.KV("active", activeNav == "brands") }>
									@components.IconTag("icon-sm")
									<span>الشركات المصنعة</span>
								</a>
							}
							if canAccessAdmin(ctx, "catalog.product.view") {
							<a href="/admin/product-child" class={ "sidebar-link", templ.KV("active", activeNav == "product_child") }>
									@components.IconLayers("icon-sm")
									<span>أصناف الموردين</span>
								</a>
							}
							if canAccessAdmin(ctx, "catalog.product.view") {
							<a href="/admin/adv-products" class={ "sidebar-link", templ.KV("active", activeNav == "adv_products") }>
									@components.IconStar("icon-sm")
									<span>المنتجات المروَّجة</span>
								</a>
							}
							if canAccessAdmin(ctx, "catalog.product.view") {
							<a href="/admin/saving-products" class={ "sidebar-link", templ.KV("active", activeNav == "saving_products") }>
									@components.IconPackage("icon-sm")
									<span>منتجات التوفير</span>
								</a>
							}
							if canAccessAdmin(ctx, "inventory.warehouse.manage") {
							<a href="/admin/warehouses" class={ "sidebar-link", templ.KV("active", activeNav == "warehouses") }>
									@components.IconPackage("icon-sm")
									<span>المستودعات</span>
								</a>
							}
							if canAccessAdmin(ctx, "inventory.warehouse.manage") {
							<a href="/admin/user/temparte-warehouses" class={ "sidebar-link", templ.KV("active", activeNav == "temp_warehouses") }>
									@components.IconPackage("icon-sm")
									<span>المستودعات المؤقتة</span>
								</a>
							}
							if canAccessAdmin(ctx, "workflow.coverage.view") {
							<a href="/admin/weekly-coverages" class={ "sidebar-link", templ.KV("active", activeNav == "weekly_coverages") }>
									@components.IconMapPin("icon-sm")
									<span>التغطية الأسبوعية</span>
								</a>
							}
						</div>

						<!-- Group 5: المبيعات والمالية (sales_and_finance) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>المبيعات والمالية</span>
							</div>
							if canAccessAdmin(ctx, "commerce.order.view") {
								<a href="/admin/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders" || activeNav == "offer_orders") }>
									@components.IconTruck("icon-sm")
									<span>طلبات الشراء وأوامر التوريد</span>
								</a>
							}
							if canAccessAdmin(ctx, "billing.invoice.view") || canAccessAdmin(ctx, "billing.payment.view") || canAccessAdmin(ctx, "billing.invoice.read") {
								<a href="/admin/finance" class={ "sidebar-link", templ.KV("active", activeNav == "finance" || activeNav == "invoices" || activeNav == "payments" || activeNav == "wallets" || activeNav == "earnings_order" || activeNav == "earnings_offers") }>
									@components.IconWallet("icon-sm")
									<span>الإدارة المالية والمحافظ</span>
								</a>
							}
							if canAccessAdmin(ctx, "billing.subscription_plan.view") {
								<a href="/admin/plans" class={ "sidebar-link", templ.KV("active", activeNav == "plans" || activeNav == "subscriptions") }>
									@components.IconTag("icon-sm")
									<span>باقات وخطط الاشتراك</span>
								</a>
							}
						</div>

						<!-- Group 6: العروض والتسويق (offers_promotions_management) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>العروض والتسويق</span>
							</div>
							if canAccessAdmin(ctx, "promo.offer.view") {
								<a href="/admin/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
									@components.IconTag("icon-sm")
									<span>مراجعة عروض الموردين</span>
								</a>
							}
							if canAccessAdmin(ctx, "promo.offer.manage") {
							<a href="/admin/offers-packages" class={ "sidebar-link", templ.KV("active", activeNav == "offers_packages") }>
									@components.IconLayers("icon-sm")
									<span>باقات العروض والرعايات</span>
								</a>
							}
							if canAccessAdmin(ctx, "promo.offer.manage") {
							<a href="/admin/offers/locations" class={ "sidebar-link", templ.KV("active", activeNav == "offer_locations") }>
									@components.IconMapPin("icon-sm")
									<span>مواقع تغطية العروض</span>
								</a>
							}
							if canAccessAdmin(ctx, "promo.ad.view") {
							<a href="/admin/ads" class={ "sidebar-link", templ.KV("active", activeNav == "ads") }>
									@components.IconStar("icon-sm")
									<span>الإعلانات</span>
								</a>
							}
							if canAccessAdmin(ctx, "promo.ad.view") {
							<a href="/admin/ad-plan" class={ "sidebar-link", templ.KV("active", activeNav == "ad_plans") }>
									@components.IconLayers("icon-sm")
									<span>خطط الإعلانات</span>
								</a>
							}
							if canAccessAdmin(ctx, "platform.analytics.view") {
							<a href="/admin/analytics" class={ "sidebar-link", templ.KV("active", activeNav == "analytics") }>
									@components.IconChart("icon-sm")
									<span>التحليلات والإحصائيات</span>
								</a>
							}
						</div>

						<!-- Group 7: أدوات أخرى (tools) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>الأدوات والخدمات</span>
							</div>
							if canAccessAdmin(ctx, "platform.message.view") {
								<a href="/admin/messages" class={ "sidebar-link", templ.KV("active", activeNav == "messages") }>
									@components.IconMail("icon-sm")
									<span>رسائل واستفسارات التواصل</span>
								</a>
							}
							if canAccessAdmin(ctx, "hr.job.view") {
								<a href="/admin/jobs" class={ "sidebar-link", templ.KV("active", activeNav == "jobs") }>
									@components.IconUsers("icon-sm")
									<span>وظائف وشواغر القطاع</span>
								</a>
							}
						</div>

						<!-- Group 8: إدارة الحذف والمحذوفات (system_deletes_trash) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>إدارة المحذوفات</span>
							</div>
							if canAccessAdmin(ctx, "platform.trash.view") {
								<a href="/admin/trash-list" class={ "sidebar-link", templ.KV("active", activeNav == "trash") }>
									@components.IconTrash("icon-sm")
									<span>سلة المحذوفات الشاملة</span>
								</a>
							}
						</div>

						<!-- Group 9: أدوات المطور (developer) -->
						<div class="sidebar-group">
							<div class="sidebar-section-header">
								<span>المطور والتشخيص</span>
							</div>
							if canAccessAdmin(ctx, "platform.developer.sql") {
								<a href="/admin/developers" class={ "sidebar-link", templ.KV("active", activeNav == "developers") }>
									@components.IconTerminal("icon-sm")
									<span>أدوات المطورين والـ AI</span>
								</a>
							}
						</div>
					</nav>

					<div style="margin-top:auto; border-top:1px solid rgba(255,255,255,0.08); padding:0.75rem; display:flex; flex-direction:column; gap:0.5rem;">
						<a href="/catalog" class="btn sidebar-footer-btn" style="width:100%; justify-content:center; font-weight:600; padding:0.6rem 0.75rem; color:rgba(255,255,255,0.85); background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radius-md);" title="كتالوج المنتجات">
							@components.IconPackage("icon-sm")
							<span>كتالوج المنتجات</span>
						</a>
					</div>
				</aside>

				<script>
					(function() {
						try {
							var nav = document.querySelector('.sidebar-nav');
							if (!nav) return;
							var currentPath = window.location.pathname;
							var links = Array.from(nav.querySelectorAll('.sidebar-link'));
							var hasActive = links.some(function(l) { return l.classList.contains('active'); });
							if (!hasActive && links.length > 0) {
								var sorted = links.slice().sort(function(a, b) { return (b.getAttribute('href') || '').length - (a.getAttribute('href') || '').length; });
								for (var i = 0; i < sorted.length; i++) {
									var href = sorted[i].getAttribute('href');
									if (href && (currentPath === href || (href !== '/admin/dashboard' && currentPath.indexOf(href) === 0))) {
										sorted[i].classList.add('active');
										break;
									}
								}
							}
							var saved = sessionStorage.getItem('dawa_sidebar_scroll_top');
							if (saved !== null) {
								nav.scrollTop = parseInt(saved, 10);
							} else {
								var act = nav.querySelector('.sidebar-link.active');
								if (act) {
									act.scrollIntoView({ block: 'nearest' });
								}
							}
						} catch (e) {}
					})();
				</script>

				<!-- Main Admin Content Area -->
				<main class="main-content">
					<!-- Top Admin Header -->
					<header class="top-navbar" style="border-bottom:1px solid var(--border); background:var(--surface-raised); padding:0 var(--space-6); height:var(--header-height); display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:var(--z-sticky);">
						<div style="display:flex; align-items:center; gap:var(--space-3);">
							<h1 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">{ title }</h1>
						</div>

						<div style="display:flex; align-items:center; gap:var(--space-4);">
							@components.LanguageToggle(lang)
							@components.ThemeToggle()

							<div style="display:flex; align-items:center; gap:0.65rem; border-inline-start:1px solid var(--border); padding-inline-start:1rem;">
								<div style="width:30px; height:30px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
									@components.IconShield("icon-xs")
								</div>
								<div style="display:flex; flex-direction:column;">
									<span style="font-size:var(--text-xs); font-weight:600; color:var(--text);">مدير النظام العام</span>
									<span style="font-size:10px; color:var(--text-muted);">Super Admin</span>
								</div>

								<form action="/auth/logout" method="POST" style="margin:0; margin-inline-start:0.35rem;">
									<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger-text); border-color:var(--danger-border); font-weight:600; padding:0.3rem 0.65rem;">
										@components.IconLogout("icon-xs")
										<span>خروج</span>
									</button>
								</form>
							</div>
						</div>
					</header>

					<!-- Page Container -->
					<div class="page-container p-modal">
						{ children... }
					</div>
				</main>
			</div>
		}
	}
}
