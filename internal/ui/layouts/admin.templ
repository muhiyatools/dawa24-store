package layouts

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ AdminShell(title string, activeNav string, lang string, dir string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<aside class="sidebar">
				<div class="sidebar-header" style="padding:1.25rem 1.5rem; display:flex; align-items:center; gap:0.75rem; border-bottom:1px solid var(--neutral-800);">
					<img src="/static/img/logo.png" alt="DAWA24" style="height:48px; max-height:50px; object-fit:contain;" />
					<span style="font-weight:800; font-size:1.1rem; color:#ffffff;">لوحة الإدارة</span>
				</div>
				<nav class="sidebar-nav">
					<a href="/admin/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
						@components.IconChart("icon-sm")
						<span>لوحة المعلومات</span>
					</a>
					<a href="/admin/approvals" class={ "sidebar-link", templ.KV("active", activeNav == "approvals") }>
						@components.IconBuilding("icon-sm")
						<span>اعتماد الشركاء والموردين</span>
					</a>
					<a href="/admin/users" class={ "sidebar-link", templ.KV("active", activeNav == "users") }>
						@components.IconUsers("icon-sm")
						<span>المستخدمين والأدوار</span>
					</a>
					<a href="/admin/settings" class={ "sidebar-link", templ.KV("active", activeNav == "settings") }>
						@components.IconSettings("icon-sm")
						<span>إعدادات المنصة</span>
					</a>
				</nav>
				<div style="border-top:1px solid var(--neutral-800); padding:1rem; display:flex; flex-direction:column; gap:0.5rem;">
					<a href="/catalog" style="color:var(--neutral-400); font-size:0.875rem; display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0.75rem; text-decoration:none;">
						@components.IconArrowLeft("icon-xs")
						<span>العودة للمتجر الدوائي</span>
					</a>
				</div>
			</aside>

			<main class="main-content">
				<header class="top-navbar">
					<div>
						<h1 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900);">{ title }</h1>
					</div>
					<div style="display:flex; align-items:center; gap:1rem;">
						<span class="badge badge-sky">
							@components.IconShield("icon-xs")
							<span>مدير المنصة العام</span>
						</span>
						<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
							<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border); font-weight:700;">
								@components.IconLogout("icon-xs")
								<span>خروج</span>
							</button>
						</form>
					</div>
				</header>
				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
}
