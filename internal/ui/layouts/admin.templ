package layouts

templ AdminShell(title string, activeNav string, lang string, dir string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<aside class="sidebar">
				<div class="sidebar-header">
					<span>Dawa24 Admin</span>
				</div>
				<nav class="sidebar-nav">
					<a href="/admin/dashboard" class={ "nav-link", templ.KV("active", activeNav == "dashboard") }>
						<span>📊 Dashboard</span>
					</a>
					<a href="/admin/approvals" class={ "nav-link", templ.KV("active", activeNav == "approvals") }>
						<span>🏢 Tenant Approvals</span>
					</a>
					<a href="/admin/catalog" class={ "nav-link", templ.KV("active", activeNav == "catalog") }>
						<span>💊 Global Catalog</span>
					</a>
					<a href="/admin/users" class={ "nav-link", templ.KV("active", activeNav == "users") }>
						<span>👥 Users & Security</span>
					</a>
					<a href="/admin/system" class={ "nav-link", templ.KV("active", activeNav == "system") }>
						<span>⚙️ System Resources</span>
					</a>
				</nav>
			</aside>
			<main class="main-content">
				<header class="top-navbar">
					<div>
						<h1 style="font-size:1.25rem; font-weight:600;">{ title }</h1>
					</div>
					<div style="display:flex; align-items:center; gap:1rem;">
						<span style="font-size:0.875rem; color:var(--neutral-600);">Super Admin</span>
						<button hx-post="/api/v1/auth/logout" class="btn btn-secondary">Logout</button>
					</div>
				</header>
				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
}
