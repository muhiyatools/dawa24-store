package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/rbac"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ AdminShell(title string, activeNav string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir, "/static/css/admin.css") {
			<div class="app-shell">
				<!-- Sidebar -->
				<aside class="sidebar" id="app-sidebar">
					<div class="sidebar-header">
						<div class="sidebar-brand">
							<img class="sidebar-logo" src={ site.LogoURL } alt={ site.SiteName } />
							<div class="sidebar-brand-copy">
								<span class="sidebar-brand-name">{ site.SiteName }</span>
								<span class="sidebar-brand-subtitle">لوحة الإدارة والتحكم</span>
							</div>
						</div>
						<button type="button" class="btn btn-icon sidebar-toggle" data-sidebar-toggle title="طي/توسيع القائمة">
							@components.IconSidebarToggle("icon-xs")
						</button>
					</div>

					@SidebarNav(rbac.ScopeAdmin, activeNav, lang)
				</aside>

				<!-- Main Admin Content Area -->
				<main class="main-content">
					@components.DashboardTopBar(components.TopBarProps{
						Title:   title,
						Lang:    lang,
						Compact: true,
					})

					<!-- Page Container -->
					<div class="page-container">
						{ children... }
					</div>
				</main>
			</div>
		}
	}
}
