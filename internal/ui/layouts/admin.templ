package layouts

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ AdminShell(title string, activeNav string, lang string, dir string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-header" style="padding:1.25rem 1.25rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.08);">
					<div style="display:flex; align-items:center; gap:0.75rem; overflow:hidden;">
						<img src="/static/img/logo.png" alt="DAWA24" style="height:46px; max-height:48px; object-fit:contain;" />
						<div style="display:flex; flex-direction:column;">
							<span style="font-weight:700; font-size:1.1rem; color:#ffffff; line-height:1.2;">دواء 24</span>
							<span style="font-size:0.75rem; color:var(--primary-400); font-weight:700;">لوحة الإدارة والتحكم</span>
						</div>
					</div>
					<button type="button" class="btn btn-icon" data-sidebar-toggle style="background:rgba(255,255,255,0.08); color:#ffffff; width:34px; height:34px; border:none; border-radius:var(--radius-md); flex-shrink:0;" title="طي/توسيع القائمة">
						@components.IconMenu("icon-xs")
					</button>
				</div>

				<nav class="sidebar-nav" style="padding:1rem 0.75rem; display:flex; flex-direction:column; gap:0.25rem;">
					<a href="/admin/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
						@components.IconChart("icon-sm")
						<span>لوحة المعلومات الرئيسية</span>
					</a>
					<a href="/admin/approvals" class={ "sidebar-link", templ.KV("active", activeNav == "approvals") }>
						@components.IconShield("icon-sm")
						<span>طلبات الاعتماد والتراخيص</span>
					</a>
					<a href="/admin/documents" class={ "sidebar-link", templ.KV("active", activeNav == "documents") }>
						@components.IconFile("icon-sm")
						<span>سجل المستندات المرفقة</span>
					</a>
					<a href="/admin/organizations" class={ "sidebar-link", templ.KV("active", activeNav == "organizations") }>
						@components.IconBuilding("icon-sm")
						<span>المنشآت والصيدليات</span>
					</a>
					<a href="/admin/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
						@components.IconTag("icon-sm")
						<span>مراجعة عروض الموردين</span>
					</a>
					<a href="/admin/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
						@components.IconTruck("icon-sm")
						<span>أوامر التوريد والعمليات</span>
					</a>
					<a href="/admin/products" class={ "sidebar-link", templ.KV("active", activeNav == "products") }>
						@components.IconPackage("icon-sm")
						<span>كتالوج الأدوية المعتمدة</span>
					</a>
					<a href="/admin/institutional" class={ "sidebar-link", templ.KV("active", activeNav == "institutional") }>
						@components.IconLayers("icon-sm")
						<span>الهيكل المؤسسي وأنواعه</span>
					</a>
					<a href="/admin/cities" class={ "sidebar-link", templ.KV("active", activeNav == "cities") }>
						@components.IconLocation("icon-sm")
						<span>المحافظات والمدن (125)</span>
					</a>
					<a href="/admin/users" class={ "sidebar-link", templ.KV("active", activeNav == "users") }>
						@components.IconUsers("icon-sm")
						<span>المستخدمين والصلاحيات</span>
					</a>
					<a href="/admin/analytics" class={ "sidebar-link", templ.KV("active", activeNav == "analytics") }>
						@components.IconChart("icon-sm")
						<span>التحليلات والمؤشرات</span>
					</a>
					<a href="/admin/audit" class={ "sidebar-link", templ.KV("active", activeNav == "audit") }>
						@components.IconClock("icon-sm")
						<span>سجل العمليات والتدقيق</span>
					</a>
					<a href="/admin/settings" class={ "sidebar-link", templ.KV("active", activeNav == "settings") }>
						@components.IconSettings("icon-sm")
						<span>إعدادات النظام والمنصة</span>
					</a>
				</nav>


				<div style="margin-top:auto; border-top:1px solid rgba(255,255,255,0.08); padding:0.75rem; display:flex; flex-direction:column; gap:0.5rem;">
					<a href="/catalog" class="btn sidebar-footer-btn" style="width:100%; justify-content:center; font-weight:600; padding:0.6rem 0.75rem; color:rgba(255,255,255,0.85); background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radius-md);" title="كتالوج المنتجات">
						@components.IconPackage("icon-sm")
						<span>كتالوج المنتجات</span>
					</a>
				</div>
			</aside>

			<!-- Main Admin Content Area -->
			<main class="main-content">
				<!-- Top Admin Header -->
				<header class="top-navbar" style="border-bottom:1px solid var(--border); background:var(--surface-raised); padding:0 var(--space-6); height:var(--header-height); display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:var(--z-sticky);">
					<div style="display:flex; align-items:center; gap:var(--space-3);">
						<h1 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">{ title }</h1>
					</div>

					<div style="display:flex; align-items:center; gap:var(--space-4);">
						@components.ThemeToggle()

						<div style="display:flex; align-items:center; gap:0.65rem; border-inline-start:1px solid var(--border); padding-inline-start:1rem;">
							<div style="width:30px; height:30px; border-radius:var(--radius-full); background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center;">
								@components.IconShield("icon-xs")
							</div>
							<div style="display:flex; flex-direction:column;">
								<span style="font-size:var(--text-xs); font-weight:600; color:var(--text);">مدير النظام العام</span>
								<span style="font-size:10px; color:var(--text-muted);">Super Admin</span>
							</div>

							<form action="/auth/logout" method="POST" style="margin:0; margin-inline-start:0.35rem;">
								<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger-text); border-color:var(--danger-border); font-weight:600; padding:0.3rem 0.65rem;">
									@components.IconLogout("icon-xs")
									<span>خروج</span>
								</button>
							</form>
						</div>
					</div>
				</header>

				<!-- Page Container -->
				<div class="page-container" style="padding:2rem;">
					{ children... }
				</div>
			</main>
		</div>
	}
}
