package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/rbac"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ AdminShell(title string, activeNav string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir, "/static/css/customer.css", "/static/css/admin.css") {
			<div class="app-shell">
				<!-- Sidebar -->
				<aside class="sidebar" id="app-sidebar">
					<div class="sidebar-header">
						<a href="/admin/dashboard" class="sidebar-brand text-decoration-none">
							if site.LogoURL != "" {
								<img class={ "sidebar-logo logo-light", templ.KV("logo-always", site.LogoDarkURL == "") } src={ site.LogoURL } alt={ site.SiteName } onerror="this.style.display='none'" />
							} else {
								<img class={ "sidebar-logo logo-light", templ.KV("logo-always", site.LogoDarkURL == "") } src="/static/img/logo.png" alt={ site.SiteName } onerror="this.style.display='none'" />
							}
							if site.LogoDarkURL != "" {
								<img class="sidebar-logo logo-dark" src={ site.LogoDarkURL } alt={ site.SiteName } onerror="this.style.display='none'" />
							}
							<div class="sidebar-brand-copy">
								<span class="sidebar-brand-name">{ site.SiteName }</span>
								<span class="sidebar-brand-subtitle">لوحة الإدارة والتحكم</span>
							</div>
						</a>
						<button type="button" class="sidebar-toggle" data-sidebar-toggle title="طي/توسيع القائمة">
							@components.IconSidebarToggle("icon-xs")
						</button>
					</div>

					@SidebarNav(rbac.ScopeAdmin, activeNav, lang)
				</aside>

				<!-- Main Admin Content Area -->
				<main class="main-content">
					@components.DashboardTopBar(components.TopBarProps{
						Title:   title,
						Lang:    lang,
						Compact: true,
					})

					<!-- Page Container -->
					<div class="page-container">
						@AuthNoticeBanner()
						{ children... }
					</div>
				</main>
			</div>
		}
	}
}
