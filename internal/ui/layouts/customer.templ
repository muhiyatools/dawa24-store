package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerShell(title string, lang string, dir string) {
	@Base(title, lang, dir) {
		<header class="top-navbar">
			<div style="display:flex; align-items:center; gap:2.5rem;">
				<a href="/" style="display:flex; align-items:center; gap:0.75rem; text-decoration:none;">
					<img src="/static/img/logo.png" alt="DAWA24.com" style="height:52px; max-height:56px; object-fit:contain; border-radius:var(--radius-sm);" />
				</a>
			</div>

			<div style="display:flex; align-items:center; gap:0.875rem;">
				<!-- Language Toggle Switch (Sleek pill switch: عربي | EN) -->
				@components.LanguageToggle(lang)

				<!-- Cart Button: Clean Icon-only with badge -->
				<a href="/cart" class="btn btn-secondary btn-icon" title="سلة المشتريات">
					@components.IconCart("icon-md")
				</a>

				if actor, ok := authctx.From(ctx); ok {
					<!-- Notifications Popover -->
					<div class="dropdown">
						<button
							type="button"
							class="btn btn-secondary btn-icon"
							title="الإشعارات"
							hx-get="/notifications/dropdown"
							hx-target="#notif-dropdown-content"
							hx-trigger="click"
							hx-swap="innerHTML"
							style="position:relative;"
						>
							@components.IconBell("icon-md")
							<span hx-get="/notifications/unread-badge" hx-trigger="load, every 60s" hx-swap="innerHTML" hx-target="this" style="position:absolute; top:4px; inset-inline-end:4px; pointer-events:none;"></span>
						</button>

						<div
							class="dropdown-menu"
							style="inset-inline-start:auto; inset-inline-end:0; min-width:340px; padding:0; overflow:hidden;"
							id="notif-dropdown-content"
						>
							<div style="min-width:320px; max-width:380px;">
								<div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 1rem; border-bottom:1px solid var(--neutral-100);">
									<div style="display:flex; align-items:center; gap:0.4rem;">
										@components.IconBell("icon-xs")
										<span style="font-weight:800; color:var(--neutral-900); font-size:0.9rem;">الإشعارات</span>
									</div>
								</div>
								<div style="padding:2rem 1rem; text-align:center; color:var(--neutral-500); font-size:0.875rem;">
									<div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--neutral-100); color:var(--neutral-400); display:flex; align-items:center; justify-content:center; margin:0 auto 0.5rem auto;">
										@components.IconBell("icon-sm")
									</div>
									<div>لا توجد إشعارات جديدة</div>
								</div>
								<div style="display:flex; border-top:1px solid var(--neutral-100); background:var(--neutral-50);">
									<a href="/notifications" style="flex:1; display:block; text-align:center; padding:0.65rem; font-size:0.825rem; font-weight:700; color:var(--neutral-700);">عرض كل الإشعارات</a>
								</div>
							</div>
						</div>
					</div>

					<!-- User Avatar Dropdown -->
					<div class="dropdown">
						<button
							type="button"
							class="btn btn-secondary"
							style="padding:0.45rem 0.85rem; display:inline-flex; align-items:center; gap:0.6rem; border-radius:var(--radius-md); height:42px;"
						>
							<div style="width:28px; height:28px; border-radius:var(--radius-full); background:var(--primary-100); color:var(--primary-700); display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">
								@components.IconUser("icon-xs")
							</div>
							<span style="font-weight:700; font-size:0.875rem; color:var(--neutral-800); max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
								{ actor.DisplayName() }
							</span>
							@components.IconChevronDown("icon-xs")
						</button>

						<div
							class="dropdown-menu"
							:class="{ 'is-active': open }"
							x-show="open"
							x-cloak
							x-transition.opacity
							style="inset-inline-start:auto; inset-inline-end:0; min-width:240px; padding:0.5rem 0;"
						>
							<!-- Wallet Balance Snapshot in dropdown -->
							<a href="/wallet" class="dropdown-item" style="background:var(--primary-50); border-radius:var(--radius-md); margin:0.25rem 0.5rem; color:var(--primary-800) !important; font-weight:800; justify-content:space-between;">
								<div style="display:flex; align-items:center; gap:0.5rem;">
									@components.IconWallet("icon-xs")
									<span>رصيد المحفظة</span>
								</div>
								<span class="tabular-nums" style="color:var(--primary-700); font-weight:900;">5,420.00 ج.م</span>
							</a>

							<div class="dropdown-divider"></div>

							<a href="/settings" class="dropdown-item">
								@components.IconUser("icon-xs")
								<span>الملف الشخصي والحساب</span>
							</a>
							<a href="/wallet" class="dropdown-item">
								@components.IconWallet("icon-xs")
								<span>المحفظة والمعاملات</span>
							</a>
							<a href="/orders" class="dropdown-item">
								@components.IconPackage("icon-xs")
								<span>طلبياتي</span>
							</a>
							<a href="/favorites" class="dropdown-item">
								@components.IconHeart("icon-xs")
								<span>المفضلة</span>
							</a>
							<a href="/settings#payments" class="dropdown-item">
								@components.IconShield("icon-xs")
								<span>طرق الدفع المحفوظة</span>
							</a>

							<!-- Dynamic Dashboard link based on role -->
							if actor.Role == "admin" || actor.Role == "super_admin" {
								<a href="/admin/dashboard" class="dropdown-item" style="color:var(--primary-700) !important; font-weight:800;">
									@components.IconChart("icon-xs")
									<span>لوحة الإدارة العامة</span>
								</a>
							} else if actor.Role == "supplier" || actor.Role == "vendor" || actor.Role == "org_manager" || actor.Role == "company" {
								<a href="/vendor/products" class="dropdown-item" style="color:var(--primary-700) !important; font-weight:800;">
									@components.IconChart("icon-xs")
									<span>بوابة المورد</span>
								</a>
							} else if actor.Role == "pharmacy" {
								<a href="/pharmacy/dashboard" class="dropdown-item" style="color:var(--primary-700) !important; font-weight:800;">
									@components.IconChart("icon-xs")
									<span>لوحة الصيدلية</span>
								</a>
							}

							<div class="dropdown-divider"></div>

							<form action="/auth/logout" method="POST" style="margin:0;">
								<button type="submit" class="dropdown-item" style="color:var(--danger) !important;">
									@components.IconLogout("icon-xs")
									<span>تسجيل الخروج</span>
								</button>
							</form>
						</div>
					</div>
				} else {
					<a href="/auth/login" class="btn btn-secondary" style="padding:0.55rem 1.125rem;">
						تسجيل الدخول
					</a>
					<a href="/onboarding" class="btn btn-primary" style="padding:0.55rem 1.25rem;">
						انضم كشريك
					</a>
				}
			</div>
		</header>

		<main class="page-container" style="flex:1; min-height:calc(100vh - 220px);">
			{ children... }
		</main>

		<!-- Redesigned Production Footer with clean links and ample spacing -->
		<footer class="site-footer">
			<div class="footer-content">
				<!-- Company Info & Mission -->
				<div>
					<div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem;">
						<img src="/static/img/logo.png" alt="DAWA24.com" style="height:54px; object-fit:contain; border-radius:var(--radius-xl); box-shadow:var(--shadow-xs); background:#ffffff; padding:4px;" />
					</div>
					<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.75rem;">
						شركة DAWA24
					</h3>
					<p style="color:var(--neutral-600); font-size:0.925rem; line-height:1.8; max-width:540px;">
						منصة التوريد الذكية توفر تجربة شاملة وآمنة لربط العملاء بالموردين، مع نظام موثوق يسهل عمليات الشراء والتوريد، ويدعم التواصل المباشر، التحليلات المتقدمة، والدعم الفني المتواصل 24/7 لتحقيق كفاءة وأمان أعلى.
					</p>
				</div>

				<!-- Quick Links -->
				<div>
					<h4 style="font-size:1rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.25rem;">
						روابط المنصة
					</h4>
					<ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.75rem; font-size:0.9rem;">
						<li><a href="/catalog">كتالوج الأدوية والمستلزمات</a></li>
						<li><a href="/about">من نحن (عن دواء 24)</a></li>
						<li><a href="/faq">الأسئلة الشائعة (FAQ)</a></li>
						<li><a href="/auth/register">انضمام الشركاء والموردين</a></li>
						<li><a href="/privacy">سياسة الخصوصية</a></li>
						<li><a href="/terms">الشروط والأحكام</a></li>
					</ul>
				</div>

				<!-- Contact & Support -->
				<div>
					<h4 style="font-size:1rem; font-weight:800; color:var(--neutral-900); margin-bottom:1.25rem;">
						التواصل والدعم الفني
					</h4>
					<ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.875rem; font-size:0.9rem; color:var(--neutral-700);">
						<li style="display:flex; align-items:center; gap:0.6rem;">
							@components.IconMail("icon-sm")
							<a href="mailto:info@dawa24.com" style="direction:ltr; font-weight:700; color:var(--primary-700) !important;">info@dawa24.com</a>
						</li>
						<li style="display:flex; align-items:center; gap:0.6rem;">
							@components.IconPhone("icon-sm")
							<a href="tel:01065397000" class="tabular-nums" style="direction:ltr; font-weight:700; color:var(--primary-700) !important;">01065397000</a>
						</li>
						<li style="font-size:0.825rem; color:var(--neutral-500); margin-top:0.5rem; line-height:1.6;">
							الدعم الفني متاح 24 ساعة طوال أيام الأسبوع للمؤسسات والصيدليات المعتمدة.
						</li>
					</ul>
				</div>
			</div>

			<div class="footer-bottom">
				<div>
					<p>جميع الحقوق محفوظة © 2026 لدى دوا 24</p>
				</div>
				<div style="display:flex; gap:1.75rem;">
					<a href="/about">عن الشركة</a>
					<a href="/faq">الأسئلة الشائعة</a>
					<a href="/privacy">الخصوصية</a>
					<a href="/terms">الشروط</a>
				</div>
			</div>
		</footer>
	}
}
