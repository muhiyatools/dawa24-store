package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerShell(title string, lang string, dir string) {
	@Base(title, lang, dir) {
		<header class="top-navbar">
			<div style="display:flex; align-items:center; gap:2.5rem;">
				<a href="/" style="display:flex; align-items:center; gap:0.6rem; text-decoration:none; color:var(--primary-700); font-weight:800; font-size:1.35rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-md); background:var(--primary-600); color:#fff; display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow-xs);">
						@components.IconPill("icon-md")
					</div>
					<span>دواء 24</span>
				</a>
				<nav style="display:flex; gap:1.25rem;">
					<a href="/catalog" class="nav-link" style="color:var(--neutral-700); font-weight:600; font-size:0.925rem; display:flex; align-items:center; gap:0.4rem;">
						@components.IconSearch("icon-sm")
						<span>الأدوية والمستلزمات</span>
					</a>
					<a href="/vendor/offers" class="nav-link" style="color:var(--neutral-700); font-weight:600; font-size:0.925rem; display:flex; align-items:center; gap:0.4rem;">
						@components.IconMegaphone("icon-sm")
						<span>العروض الحصرية</span>
					</a>
				</nav>
			</div>

			<div style="display:flex; align-items:center; gap:0.75rem;">
				<a href="/cart" class="btn btn-secondary" style="padding:0.5rem 0.875rem;">
					@components.IconCart("icon-sm")
					<span>السلة</span>
				</a>

				if actor, ok := authctx.From(ctx); ok {
					<a href="/orders" class="btn btn-secondary" style="padding:0.5rem 0.875rem;">
						@components.IconPackage("icon-sm")
						<span>طلبياتي</span>
					</a>
					<a href="/notifications" class="btn btn-secondary" style="padding:0.5rem 0.875rem;">
						@components.IconBell("icon-sm")
						<span>الإشعارات</span>
					</a>

					if actor.Role == "admin" || actor.Role == "super_admin" {
						<a href="/admin/dashboard" class="btn btn-secondary" style="color:var(--primary-700); font-weight:600;">
							@components.IconShield("icon-sm")
							<span>لوحة الإدارة</span>
						</a>
					}
					if actor.Role == "supplier" || actor.Role == "vendor" || actor.Role == "org_manager" || actor.Role == "company" {
						<a href="/vendor/products" class="btn btn-secondary" style="color:var(--primary-700); font-weight:600;">
							@components.IconBuilding("icon-sm")
							<span>بوابة المورد</span>
						</a>
					}

					<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
						<button type="submit" class="btn btn-secondary" style="color:var(--danger); border-color:var(--danger-border); padding:0.5rem 0.875rem;">
							@components.IconLogout("icon-sm")
							<span>خروج</span>
						</button>
					</form>
				} else {
					<a href="/auth/login" class="btn btn-secondary" style="padding:0.55rem 1.125rem;">
						تسجيل الدخول
					</a>
					<a href="/onboarding" class="btn btn-primary" style="padding:0.55rem 1.25rem;">
						انضم كشريك
					</a>
				}
			</div>
		</header>

		<main class="page-container" style="flex:1; min-height:calc(100vh - 140px);">
			{ children... }
		</main>

		<footer style="background-color:#ffffff; border-block-start:1px solid var(--border-card); padding:2.5rem 2rem; color:var(--neutral-500); font-size:0.875rem;">
			<div style="max-width:1320px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem;">
				<div style="display:flex; align-items:center; gap:0.5rem; color:var(--primary-800); font-weight:700; font-size:1.1rem;">
					@components.IconPill("icon-sm")
					<span>دواء 24 — سوق الأدوية والمستلزمات الصيدلانية الموحد</span>
				</div>
				<div style="display:flex; gap:1.5rem; color:var(--neutral-600);">
					<a href="/terms" style="color:inherit;">الشروط والأحكام</a>
					<a href="/privacy" style="color:inherit;">سياسة الخصوصية</a>
					<a href="/onboarding" style="color:inherit;">انضمام الموردين</a>
				</div>
				<div>
					<p>© 2026 دواء 24. جميع الحقوق محفوظة لجمهورية مصر العربية.</p>
				</div>
			</div>
		</footer>
	}
}
