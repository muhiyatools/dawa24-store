package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// PublicShell is the marketing layout for pages a visitor may reach without
// signing in: navbar + footer around the content. Authenticated screens never
// render it — they use the sidebar shells (Rebuild V2 §1.5).
templ PublicShell(title string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir, "/static/css/public.css") {
			<div x-data="{ mobileNav: false }" class="public-shell-root">
				<!-- Top Modern Navbar -->
				<header class="site-header">
					<div class="site-header-container">
						<div class="site-header-brand">
							<a href="/" class="brand-lockup" title="دواء 24 — الصفحة الرئيسية">
								if site.LogoURL != "" {
									<img class="brand-logo" src={ site.LogoURL } alt={ site.SiteName } />
								}
								<div class="brand-text-lockup">
									<span class="brand-name">دواء 24</span>
								</div>
							</a>
						</div>

						<!-- Desktop Central Navigation Links -->
						<nav class="public-nav-links" aria-label="التنقل الرئيسي">
							<a href="/how-it-works" class="public-nav-link">كيف تعمل المنصة</a>
							<a href="/about" class="public-nav-link">عن دواء 24</a>
							<a href="/contact" class="public-nav-link">تواصل معنا</a>
						</nav>

						<div class="site-header-actions">
							if _, ok := authctx.From(ctx); ok {
								@components.NotificationsBell(lang)
								@components.UserMenu(lang, false)
							} else {
								<div class="d-flex items-center gap-2">
									<a href="/auth/login" class="navbar-login-btn">
										@components.IconUser("icon-xs")
										<span>تسجيل الدخول</span>
									</a>
									<a href="/auth/register" class="navbar-register-btn">
										@components.IconPlus("icon-xs")
										<span>انضمام للمنصة</span>
									</a>
								</div>
							}

							<!-- Mobile Menu Hamburger Button -->
							<button
								type="button"
								@click="mobileNav = true"
								class="btn-ghost btn-icon show-mobile header-mobile-toggle"
								aria-label="قائمة التصفح"
							>
								@components.IconMenu("icon-sm")
							</button>
						</div>
					</div>
				</header>

				@publicMobileNav(site)

				<main class="page-body">
					<div class="page-container">
						{ children... }
					</div>
				</main>
			</div>

			@publicFooter(site)
		}
	}
}
