package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/platform/features"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// PublicShell is the marketing layout for pages a visitor may reach without
// signing in: navbar + footer around the content. Authenticated screens never
// render it — they use the sidebar shells (Rebuild V2 §1.5).
templ PublicShell(title string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir, "/static/css/public.css") {
			<div x-data="{ mobileNav: false }" class="public-shell-root">
				<!-- Top Modern Navbar -->
				<header class="site-header">
					<div class="site-header-brand">
						<a href="/" class="brand-lockup" title="دواء 24 — الصفحة الرئيسية">
							if site.LogoURL != "" {
								<img class="brand-logo" src={ site.LogoURL } alt={ site.SiteName } />
							}
							<div class="brand-text-lockup">
								<span class="brand-name">
									دواء <span class="text-accent">24</span>
								</span>
							</div>
						</a>

						<nav class="nav-links hide-mobile">
							<a href="/catalog" class="nav-item-link">
								@components.IconPill("icon-xs")
								<span>كتالوج الأدوية</span>
							</a>
							if features.Enabled(ctx, "offers.enabled") {
								<a href="/offers" class="nav-item-link">
									@components.IconPercent("icon-xs")
									<span>العروض والتخفيضات</span>
								</a>
							}
							<a href="/compare/results" class="nav-item-link">
								@components.IconSliders("icon-xs")
								<span>مقارنة الخصومات</span>
							</a>
							<a href="/suppliers" class="nav-item-link">
								@components.IconBuilding("icon-xs")
								<span>دليل الموردين</span>
							</a>
							if features.Enabled(ctx, "jobs.enabled") {
								<a href="/jobs" class="nav-item-link">
									@components.IconBriefcase("icon-xs")
									<span>وظائف وصيادلة</span>
								</a>
							}
						</nav>
					</div>

					<div class="site-header-actions">
						if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
							<div class="hide-mobile">
								@PharmacyBranchSelector(ctx)
							</div>
						}
						
						<div class="hide-mobile">
							@components.LanguageToggle(lang)
						</div>
						@components.ThemeToggle()

						if actor, ok := authctx.From(ctx); ok {
							<!-- Cart Button: customer-only surface -->
							if actor.IsCustomer() {
								<a href="/cart" class="btn btn-secondary btn-icon" title="سلة المشتريات">
									@components.IconCart("icon-md")
								</a>
							}

							<!-- Notifications Popover -->
							<div class="dropdown" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">
								<button
									type="button"
									title="الإشعارات"
									@click="open = !open"
									hx-get="/notifications/dropdown"
									hx-target="#notif-dropdown-content"
									hx-trigger="click"
									hx-swap="innerHTML"
									class="btn btn-secondary btn-icon btn-notification-wrap"
								>
									@components.IconBell("icon-md")
									<span class="notification-indicator" hx-get="/notifications/unread-badge" hx-trigger="load, every 60s" hx-swap="innerHTML" hx-target="this"></span>
								</button>

								<div
									class="dropdown-menu notification-menu"
									id="notif-dropdown-content"
									x-show="open"
									x-cloak
									x-transition.origin.top.duration.150ms
								>
									<div class="notification-panel">
										<div class="notification-header">
											<div class="row-center-sm">
												@components.IconBell("icon-xs")
												<span class="notification-title">الإشعارات</span>
											</div>
										</div>
										<div class="notification-empty">
											<div class="notification-empty-icon">
												@components.IconBell("icon-sm")
											</div>
											<div>لا توجد إشعارات جديدة</div>
										</div>
										<div class="notification-footer">
											<a href="/notifications" class="notification-footer-link">عرض كل الإشعارات</a>
										</div>
									</div>
								</div>
							</div>

							<!-- User Avatar Dropdown -->
							<div class="dropdown" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">
								<button
									type="button"
									@click="open = !open"
									class="btn btn-secondary account-trigger"
								>
									<div class="account-avatar">
										@components.IconUser("icon-xs")
									</div>
									<span class="account-name">
										{ actor.DisplayName() }
									</span>
									@components.IconChevronDown("icon-xs")
								</button>

								<div
									class="dropdown-menu account-menu"
									x-show="open"
									x-cloak
									x-transition.origin.top.duration.150ms
								>
									<!-- User Header Card -->
									<div class="account-header">
										<div class="row-center">
											<div class="account-avatar account-avatar-lg">
												@components.IconUser("icon-sm")
											</div>
											<div class="account-details">
												<div class="account-name account-name-lg">
													{ actor.DisplayName() }
												</div>
												<div class="account-role">
													if actor.IsStaff {
														<span class="badge badge-sky badge-compact">فريق المنصة</span>
													} else if actor.IsVendor() {
														<span class="badge badge-emerald badge-compact">مورد معتمد</span>
													} else {
														<span class="badge badge-slate badge-compact">صيدلية معتمدة</span>
													}
												</div>
											</div>
										</div>
									</div>

									<!-- 1. Wallet Balance Snapshot -->
									if !actor.IsStaff {
										if actor.IsVendor() {
											<a href="/vendor/wallet" class="dropdown-item wallet-item">
												<div class="row-center-sm">
													@components.IconWallet("icon-xs")
													<span class="wallet-label">المحفظة</span>
												</div>
												<span class="dropdown-item-arrow">←</span>
											</a>
										} else {
											<a href="/customer/wallet" class="dropdown-item wallet-item">
												<div class="row-center-sm">
													@components.IconWallet("icon-xs")
													<span class="wallet-label">المحفظة</span>
												</div>
												<span class="dropdown-item-arrow">←</span>
											</a>
										}
									}

									<!-- 2. Dashboard -->
									if actor.IsStaff {
										<a href="/admin/dashboard" class="dropdown-item fw-600">
											@components.IconChart("icon-xs")
											<span>لوحة التحكم الرئيسية</span>
										</a>
									} else if actor.IsVendor() {
										<a href="/vendor/dashboard" class="dropdown-item fw-600">
											@components.IconChart("icon-xs")
											<span>لوحة تحكم المورد</span>
										</a>
									} else {
										<a href="/customer/dashboard" class="dropdown-item fw-600">
											@components.IconHome("icon-xs")
											<span>لوحة تحكم الصيدلية</span>
										</a>
									}

									<!-- 3. Profile & Settings (Vendor sees Organization profile, Pharmacy sees pharmacy settings) -->
									if actor.IsVendor() {
										<a href="/vendor/organization" class="dropdown-item">
											@components.IconBuilding("icon-xs")
											<span>بيانات المنشأة والتراخيص</span>
										</a>
									} else if actor.IsStaff {
										<a href="/admin/settings" class="dropdown-item">
											@components.IconSettings("icon-xs")
											<span>إعدادات النظام</span>
										</a>
									} else {
										<a href="/settings" class="dropdown-item">
											@components.IconSettings("icon-xs")
											<span>الملف الشخصي للصيدلية</span>
										</a>
									}

									<div class="dropdown-divider"></div>

									<!-- 4. Sign Out -->
									<form action="/auth/logout" method="POST" class="logout-form">
										<button type="submit" class="dropdown-item text-danger dropdown-action">
											@components.IconLogout("icon-xs")
											<span>تسجيل الخروج</span>
										</button>
									</form>
								</div>
							</div>
						} else {
							<div class="row-center-xs hide-mobile">
								<a href="/auth/login" class="btn btn-secondary btn-sm fw-700 navbar-auth-link">
									@components.IconUser("icon-xs")
									<span>تسجيل الدخول</span>
								</a>
								<a href="/auth/register" class="btn btn-primary btn-sm fw-800 navbar-auth-link">
									@components.IconPlus("icon-xs")
									<span>انضمام للمنصة</span>
								</a>
							</div>
						}

						<!-- Mobile Menu Toggle Button -->
						<button
							type="button"
							@click="mobileNav = !mobileNav"
							class="btn btn-secondary btn-icon show-mobile-only"
							aria-label="القائمة الرئيسية"
						>
							@components.IconMenu("icon-sm")
						</button>
					</div>
				</header>

				<!-- Mobile Slideover Navigation Drawer -->
				<div
					class="mobile-nav-backdrop"
					x-show="mobileNav"
					x-cloak
					x-transition:enter="ease-out duration-200"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					x-transition:leave="ease-in duration-150"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					@click="mobileNav = false"
				></div>

				<div
					class="mobile-nav-drawer"
					x-show="mobileNav"
					x-cloak
					x-transition:enter="transform transition ease-in-out duration-300"
					x-transition:enter-start="translate-x-full"
					x-transition:enter-end="translate-x-0"
					x-transition:leave="transform transition ease-in-out duration-200"
					x-transition:leave-start="translate-x-0"
					x-transition:leave-end="translate-x-full"
				>
					<div class="mobile-nav-header">
						<div class="brand-lockup">
							<span class="brand-name">
								دواء <span class="text-accent">24</span>
							</span>
						</div>
						<button
							type="button"
							@click="mobileNav = false"
							class="btn btn-ghost btn-icon btn-sm"
							aria-label="إغلاق القائمة"
						>
							@components.IconX("icon-sm")
						</button>
					</div>

					<div class="mobile-nav-body">
						<nav class="mobile-nav-links">
							<a href="/catalog" class="mobile-nav-link" @click="mobileNav = false">
								@components.IconPill("icon-sm")
								<span>كتالوج الأدوية الموحد</span>
							</a>
							if features.Enabled(ctx, "offers.enabled") {
								<a href="/offers" class="mobile-nav-link" @click="mobileNav = false">
									@components.IconPercent("icon-sm")
									<span>عروض وتخفيضات الموردين</span>
								</a>
							}
							<a href="/compare/results" class="mobile-nav-link" @click="mobileNav = false">
								@components.IconSliders("icon-sm")
								<span>مقارنة الخصومات الفورية</span>
							</a>
							<a href="/suppliers" class="mobile-nav-link" @click="mobileNav = false">
								@components.IconBuilding("icon-sm")
								<span>دليل الموردين والمصانع</span>
							</a>
							if features.Enabled(ctx, "jobs.enabled") {
								<a href="/jobs" class="mobile-nav-link" @click="mobileNav = false">
									@components.IconBriefcase("icon-sm")
									<span>وظائف التوظيف الصيدلي</span>
								</a>
							}
						</nav>

						<div class="mobile-nav-divider"></div>

						if actor, ok := authctx.From(ctx); ok {
							<div class="mobile-nav-user-box">
								<div class="account-name-lg">{ actor.DisplayName() }</div>
								if actor.IsStaff {
									<a href="/admin/dashboard" class="btn btn-primary btn-sm w-full mt-2">
										@components.IconChart("icon-xs")
										<span>لوحة التحكم الرئيسية</span>
									</a>
								} else if actor.IsVendor() {
									<a href="/vendor/dashboard" class="btn btn-primary btn-sm w-full mt-2">
										@components.IconChart("icon-xs")
										<span>لوحة تحكم المورد</span>
									</a>
								} else {
									<a href="/customer/dashboard" class="btn btn-primary btn-sm w-full mt-2">
										@components.IconHome("icon-xs")
										<span>لوحة تحكم الصيدلية</span>
									</a>
								}
							</div>
						} else {
							<div class="mobile-nav-auth-stack">
								<a href="/auth/login" class="btn btn-secondary w-full" @click="mobileNav = false">
									@components.IconUser("icon-xs")
									<span>تسجيل الدخول</span>
								</a>
								<a href="/auth/register" class="btn btn-primary w-full" @click="mobileNav = false">
									@components.IconPlus("icon-xs")
									<span>انضمام للمنصة</span>
								</a>
							</div>
						}
					</div>
				</div>

				<main class="page-body">
					<div class="page-container">
						{ children... }
					</div>
				</main>
			</div>

			<footer class="site-footer">
				<div class="footer-content">
					<!-- Brand & Bio -->
					<div>
						<div class="footer-brand">
							<img src={ site.LogoURL } alt={ site.SiteName } class="footer-logo" />
							<div>
								<div class="footer-brand-name">
									دواء <span class="text-accent">24</span>
								</div>
								<div class="footer-brand-subtitle">
									منظومة الربط والتوريد الدوائي المباشر
								</div>
							</div>
						</div>
						<p class="footer-description">
							{ site.SiteDescription }
						</p>
						<div class="footer-social-links">
							if site.SocialLinks["facebook"] != "" {
								<a href={ templ.SafeURL(site.SocialLinks["facebook"]) } target="_blank" rel="noopener" class="footer-social-btn" title="فيسبوك">
									@components.IconFacebook("icon-xs")
								</a>
							}
							if site.SocialLinks["twitter"] != "" {
								<a href={ templ.SafeURL(site.SocialLinks["twitter"]) } target="_blank" rel="noopener" class="footer-social-btn" title="تويتر (X)">
									@components.IconTwitter("icon-xs")
								</a>
							}
							if site.SocialLinks["linkedin"] != "" {
								<a href={ templ.SafeURL(site.SocialLinks["linkedin"]) } target="_blank" rel="noopener" class="footer-social-btn" title="لينكد إن">
									@components.IconLinkedIn("icon-xs")
								</a>
							}
							if site.SocialLinks["whatsapp"] != "" {
								<a href={ templ.SafeURL("https://wa.me/" + site.SocialLinks["whatsapp"]) } target="_blank" rel="noopener" class="footer-social-btn" title="واتساب">
									@components.IconWhatsApp("icon-xs")
								</a>
							}
							if site.SocialLinks["instagram"] != "" {
								<a href={ templ.SafeURL(site.SocialLinks["instagram"]) } target="_blank" rel="noopener" class="footer-social-btn" title="إنستغرام">
									@components.IconInstagram("icon-xs")
								</a>
							}
							if site.SocialLinks["tiktok"] != "" {
								<a href={ templ.SafeURL(site.SocialLinks["tiktok"]) } target="_blank" rel="noopener" class="footer-social-btn" title="تيك توك">
									@components.IconTikTok("icon-xs")
								</a>
							}
						</div>
					</div>

					<!-- Quick Links -->
					<div>
						<h4 class="footer-heading">
							خدمات وروابط المنصة
						</h4>
						<ul class="footer-link-list">
							<li><a href="/catalog">كتالوج الأدوية والمستلزمات</a></li>
							if features.Enabled(ctx, "offers.enabled") {
								<li><a href="/offers">العروض والتخفيضات الحية</a></li>
							}
							<li><a href="/suppliers">دليل الموردين والمصانع</a></li>
							if features.Enabled(ctx, "jobs.enabled") {
								<li><a href="/jobs">وظائف التوظيف الصيدلي</a></li>
							}
							<li><a href="/about">من نحن (عن دواء 24)</a></li>
							<li><a href="/faq">الأسئلة الشائعة (FAQ)</a></li>
							<li><a href="/auth/register">انضمام الصيدليات والموردين</a></li>
						</ul>
					</div>

					<!-- Contact & Support -->
					<div>
						<h4 class="footer-heading">
							التواصل والدعم الفني
						</h4>
						<ul class="footer-link-list footer-contact-list">
							<li class="row-center-sm">
								@components.IconMail("icon-sm")
								<a href={ templ.SafeURL("mailto:" + site.SupportEmail) } class="contact-link">{ site.SupportEmail }</a>
							</li>
							<li class="row-center-sm">
								@components.IconPhone("icon-sm")
								<a href={ templ.SafeURL("tel:" + site.Phone) } class="tabular-nums contact-link">{ site.Phone }</a>
							</li>
							if site.Address != "" {
								<li class="footer-address">
									@components.IconBuilding("icon-sm")
									<span>{ site.Address }</span>
								</li>
							}
							<li class="footer-support-note">
								خدمة العملاء والدعم الفني متاح 24/7 للمؤسسات والصيدليات المعتمدة.
							</li>
						</ul>
					</div>
				</div>

				<div class="footer-bottom">
					<div>
						<p>جميع الحقوق محفوظة © 2026 { site.SiteName } — ترخيص واعتماد المنشآت الطبية والصيدلانية</p>
					</div>
					<div class="footer-legal-links">
						<a href="/privacy">الخصوصية</a>
						<a href="/terms">الشروط</a>
					</div>
				</div>
			</footer>
		}
	}
}
