package layouts

import (
	"context"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// CustomerShell is the authenticated pharmacy portal: sidebar (RTL right),
// top strip, and main. No navbar, no footer — Rule 1.5. The branch selector
// lives in the top strip (Phase 3.2): changing it changes what the whole
// catalogue shows.
templ CustomerShell(title string, activeNav string, lang string, dir string, perms []string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir) {
			<div class="app-shell">
				<!-- Sidebar -->
				<aside class="sidebar">
					<div class="sidebar-header">
						<div class="sidebar-brand">
							<img class="sidebar-logo" src={ site.LogoURL } alt={ site.SiteName } />
							<div class="sidebar-brand-copy">
								<span class="sidebar-brand-name">{ site.SiteName }</span>
								<span class="sidebar-brand-subtitle">بوابة الصيدلية المعتمدة</span>
							</div>
						</div>
					<button type="button" class="btn btn-icon sidebar-toggle" data-sidebar-toggle title="طي/توسيع القائمة">
						@components.IconSidebarToggle("icon-xs")
					</button>
				</div>

				<nav class="sidebar-nav">
					
					<!-- Group 1: الرئيسية والطلبات -->
					<div class="sidebar-group">
						<div class="sidebar-section-header">
							<span>{ i18n.T(lang, "nav.orders_and_shipments") }</span>
						</div>
						<a href="/customer/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
							@components.IconHome("icon-sm")
							<span>{ i18n.T(lang, "nav.dashboard") }</span>
						</a>
						<a href="/customer/purchase-request" class={ "sidebar-link", templ.KV("active", activeNav == "purchase-request" || activeNav == "purchase_request" || activeNav == "smart-order" || activeNav == "smart_order") }>
							@components.IconShoppingBag("icon-sm")
							<span>طلب الشراء</span>
						</a>
						<a href="/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
							@components.IconTruck("icon-sm")
							<span>{ i18n.T(lang, "nav.orders_and_shipments") }</span>
						</a>
						<a href="/favorites" class={ "sidebar-link", templ.KV("active", activeNav == "favorites") }>
							@components.IconHeart("icon-sm")
							<span>{ i18n.T(lang, "nav.favorite_products") }</span>
						</a>
					</div>

					<!-- Group 2: العروض والموردون -->
					<div class="sidebar-group">
						<div class="sidebar-section-header">
							<span>{ i18n.T(lang, "nav.offers_and_discounts") }</span>
						</div>
						<a href="/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
							@components.IconTag("icon-sm")
							<span>{ i18n.T(lang, "nav.offers_and_discounts") }</span>
						</a>
						<a href="/customer/saving-products" class={ "sidebar-link", templ.KV("active", activeNav == "saving_products") }>
							@components.IconPackage("icon-sm")
							<span>{ i18n.T(lang, "nav.saving_products") }</span>
						</a>
						<a href="/customer/decision-memory" class={ "sidebar-link", templ.KV("active", activeNav == "decision_memory") }>
							@components.IconZap("icon-sm")
							<span>ذاكرة قرارات المطابقة</span>
						</a>
						<a href="/suppliers" class={ "sidebar-link", templ.KV("active", activeNav == "suppliers") }>
							@components.IconBuilding("icon-sm")
							<span>{ i18n.T(lang, "nav.suppliers_directory") }</span>
						</a>
						<a href="/suppliers/followed" class={ "sidebar-link", templ.KV("active", activeNav == "followed") }>
							@components.IconHeart("icon-sm")
							<span>{ i18n.T(lang, "nav.followed_suppliers") }</span>
						</a>
					</div>

					<!-- Group 3: الخدمات والحساب -->
					<div class="sidebar-group">
						<div class="sidebar-section-header">
							<span>{ i18n.T(lang, "nav.profile_and_settings") }</span>
						</div>
						<a href="/customer/branches" class={ "sidebar-link", templ.KV("active", activeNav == "branches") }>
							@components.IconLocation("icon-sm")
							<span>{ i18n.T(lang, "nav.pharmacy_branches") }</span>
						</a>
						<a href="/customer/documents" class={ "sidebar-link", templ.KV("active", activeNav == "documents") }>
							@components.IconFile("icon-sm")
							<span>{ i18n.T(lang, "nav.documents_and_licenses") }</span>
						</a>
						<a href="/customer/user-organization" class={ "sidebar-link", templ.KV("active", activeNav == "user_organization") }>
							@components.IconBuilding("icon-sm")
							<span>المستخدم-المنظمة</span>
						</a>
						<a href="/customer/subscription" class={ "sidebar-link", templ.KV("active", activeNav == "subscription") }>
							@components.IconSparkles("icon-sm")
							<span>{ i18n.T(lang, "nav.subscription_and_membership") }</span>
						</a>
						<a href="/customer/jobs" class={ "sidebar-link", templ.KV("active", activeNav == "jobs") }>
							@components.IconBriefcase("icon-sm")
							<span>{ i18n.T(lang, "nav.jobs_and_careers") }</span>
						</a>
						<a href="/customer/ai-logs" class={ "sidebar-link", templ.KV("active", activeNav == "ai_logs") }>
							@components.IconSparkles("icon-sm")
							<span>سجل استهلاك الذكاء الاصطناعي</span>
						</a>
						<a href="/settings/profile" class={ "sidebar-link", templ.KV("active", activeNav == "profile" || activeNav == "settings" || activeNav == "wallet" || activeNav == "organization") }>
							@components.IconUser("icon-sm")
							<span>{ i18n.T(lang, "nav.profile_and_settings") }</span>
						</a>
					</div>
				</nav>
			</aside>

			<!-- Main Content -->
			<main class="main-content">
				<!-- Top Bar with Branch Selector -->
				<header class="top-navbar">
					<div style="display:flex; align-items:center; gap:var(--space-4);">
						<h1 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">{ title }</h1>
						@PharmacyBranchSelector(ctx)
					</div>

					<div style="display:flex; align-items:center; gap:var(--space-3);">
						@components.LanguageToggle(lang)
						@components.ThemeToggle()
						
						<!-- Cart Button -->
						<a href="/cart" class="btn btn-secondary btn-icon" title={ i18n.T(lang, "nav.cart") } style="position:relative;">
							@components.IconCart("icon-sm")
						</a>

						<span class="badge badge-emerald font-semibold">
							@components.IconCheckCircle("icon-xs")
							<span>{ i18n.T(lang, "nav.pharmacy_portal") }</span>
						</span>
						<form action="/auth/logout" method="POST" class="m-0 inline">
							<button type="submit" class="btn btn-secondary btn-sm btn-logout" title="تسجيل الخروج">
								@components.IconLogout("icon-xs")
								<span>{ i18n.T(lang, "auth.logout") }</span>
							</button>
						</form>
					</div>
				</header>

				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
	}
}

// PharmacyBranchSelector is an island in the top navbar. It reads the current
// active branch from the request context (or session), renders a dropdown of
// the user's pharmacy branches, and POSTs to /customer/set-branch on change.
templ PharmacyBranchSelector(ctx context.Context) {
	if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
		if buying, has := authctx.BuyingBranchFrom(ctx); has && len(buying.Branches) > 0 {
			<div class="branch-selector-pill">
				<div class="branch-selector-icon-label">
					@components.IconMapPin("icon-xs")
					<span class="text-secondary font-semibold">فرع التوريد:</span>
				</div>
				<form method="POST" action="/customer/set-branch" class="m-0 d-inline">
					<select
						name="branch_id"
						class="branch-selector-select"
						onchange="this.form.submit()"
						title="تغيير فرع الصيدلية لحساب التغطية وشحن الطلبية"
					>
						for _, b := range buying.Branches {
							<option
								value={ fmt.Sprintf("%d", b.ID) }
								selected?={ buying.Active != nil && *buying.Active == b.ID }
							>
								{ b.Name }
							</option>
						}
					</select>
				</form>
			</div>
		}
	}
}
