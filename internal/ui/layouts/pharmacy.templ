package layouts

import (
	"github.com/muhiya/dawa24-store/internal/platform/rbac"
	"context"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// CustomerShell is the authenticated pharmacy portal: sidebar (RTL right),
// top strip, and main. No navbar, no footer — Rule 1.5. The branch selector
// lives in the top strip (Phase 3.2): changing it changes what the whole
// catalogue shows.
templ CustomerShell(title string, activeNav string, lang string, dir string, perms []string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir, "/static/css/customer.css") {
			<div class="app-shell">
				<!-- Sidebar -->
				<aside class="sidebar" id="app-sidebar">
					<div class="sidebar-header">
						<div class="sidebar-brand">
							<img class="sidebar-logo" src={ site.LogoURL } alt={ site.SiteName } />
							<div class="sidebar-brand-copy">
								<span class="sidebar-brand-name">{ site.SiteName }</span>
								<span class="sidebar-brand-subtitle">بوابة الصيدلية المعتمدة</span>
							</div>
						</div>
					<button type="button" class="sidebar-toggle" data-sidebar-toggle title="طي/توسيع القائمة">
						@components.IconSidebarToggle("icon-xs")
					</button>
				</div>

				@SidebarNav(rbac.ScopePharmacy, activeNav, lang)
			</aside>

			<!-- Main Content -->
			<main class="main-content">
				<!-- Top Bar with Branch Selector -->
				@components.DashboardTopBar(components.TopBarProps{
					Title:   title,
					Lang:    lang,
					Context: PharmacyBranchSelector(ctx),
					Actions: pharmacyTopBarActions(lang),
				})

				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
	}
}

// PharmacyBranchSelector is an island in the top navbar. It reads the current
// active branch from the request context (or session), renders a dropdown of
// the user's pharmacy branches, and POSTs to /customer/set-branch on change.
templ PharmacyBranchSelector(ctx context.Context) {
	if actor, ok := authctx.From(ctx); ok && actor.IsCustomer() {
		if buying, has := authctx.BuyingBranchFrom(ctx); has && len(buying.Branches) > 0 {
			<div class="nav-pop" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">
				<button
					type="button"
					class="nav-trigger"
					@click="open = !open"
					:aria-expanded="open ? 'true' : 'false'"
					aria-haspopup="menu"
					title="تغيير فرع الصيدلية لحساب التغطية وشحن الطلبية"
				>
					@components.IconMapPin("icon-xs")
					<span class="nav-trigger-text">
						<span class="nav-trigger-label">BRANCH</span>
						<span class="nav-trigger-value">
							for _, b := range buying.Branches {
								if buying.Active != nil && *buying.Active == b.ID {
									{ b.Name }
								}
							}
						</span>
					</span>
					@components.IconChevronDown("icon-2xs nav-trigger-chevron")
				</button>
				<div
					class="nav-menu nav-menu--start"
					role="menu"
					x-show="open"
					x-cloak
					x-transition.origin.top.duration.150ms
				>
					<div class="nav-menu-head">
						<span class="nav-menu-eyebrow">اختر فرع التوريد النشط</span>
					</div>
					<div class="nav-menu-body">
						<div class="nav-menu-group">
							for _, b := range buying.Branches {
								<form method="POST" action="/customer/set-branch" class="nav-menu-form">
									<input type="hidden" name="branch_id" value={ fmt.Sprintf("%d", b.ID) } />
									<button
										type="submit"
										role="menuitem"
										class={ "nav-menu-item", templ.KV("is-active", buying.Active != nil && *buying.Active == b.ID) }
									>
										<span class="nav-branch-dot"></span>
										<span class="nav-branch-name">{ b.Name }</span>
										if buying.Active != nil && *buying.Active == b.ID {
											@components.IconCheck("icon-xs")
										}
									</button>
								</form>
							}
						</div>
					</div>
				</div>
			</div>
		}
	}
}

// pharmacyTopBarActions is the one control the pharmacy bar has that the other
// two dashboards do not. It goes in the top bar's Actions slot rather than being
// hand-placed in the header, which is what made this shell drift out of
// alignment with admin and vendor in the first place.
templ pharmacyTopBarActions(lang string) {
	<a href="/cart" class="nav-btn nav-btn--icon" title={ i18n.T(lang, "nav.cart") }>
		@components.IconCart("icon-sm")
	</a>
}
