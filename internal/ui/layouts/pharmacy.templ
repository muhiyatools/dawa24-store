package layouts

import (
	"context"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// CustomerShell is the authenticated pharmacy portal: sidebar (RTL right),
// top strip, and main. No navbar, no footer — Rule 1.5. The branch selector
// lives in the top strip (Phase 3.2): changing it changes what the whole
// catalogue shows.
templ CustomerShell(title string, activeNav string, lang string, dir string, perms []string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-header" style="padding:1.25rem 1.25rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.08);">
					<div style="display:flex; align-items:center; gap:0.75rem; overflow:hidden;">
						<img src="/static/img/logo.png" alt="دواء 24" style="height:46px; max-height:48px; object-fit:contain;" />
						<div style="display:flex; flex-direction:column;">
							<span style="font-weight:700; font-size:1.15rem; color:#ffffff; line-height:1.2;">دواء <span style="color:var(--primary-400);">24</span></span>
							<span style="font-size:0.75rem; color:var(--neutral-400); font-weight:700;">بوابة الصيدلية المعتمدة</span>
						</div>
					</div>
					<button type="button" class="btn btn-icon" data-sidebar-toggle style="background:rgba(255,255,255,0.08); color:#ffffff; width:34px; height:34px; border:none; border-radius:var(--radius-md); flex-shrink:0;" title="طي/توسيع القائمة">
						@components.IconMenu("icon-xs")
					</button>
				</div>

				<nav class="sidebar-nav" style="padding:1rem 0.75rem; display:flex; flex-direction:column; gap:0.25rem;">
					<a href="/customer/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
						@components.IconHome("icon-sm")
						<span>لوحة التحكم الرئيسية</span>
					</a>
					<a href="/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
						@components.IconTag("icon-sm")
						<span>العروض المتاحة والتخفيضات</span>
					</a>
					<a href="/cart" class={ "sidebar-link", templ.KV("active", activeNav == "cart") }>
						@components.IconCart("icon-sm")
						<span>سلة المشتريات</span>
					</a>
					<a href="/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
						@components.IconTruck("icon-sm")
						<span>طلبياتي وأوامر التوريد</span>
					</a>
					<a href="/favorites" class={ "sidebar-link", templ.KV("active", activeNav == "favorites") }>
						@components.IconStar("icon-sm")
						<span>الأدوية المفضلة</span>
					</a>
					<a href="/suppliers/followed" class={ "sidebar-link", templ.KV("active", activeNav == "followed") }>
						@components.IconHeart("icon-sm")
						<span>الموردون المتابعون</span>
					</a>
					<a href="/catalog" class={ "sidebar-link", templ.KV("active", activeNav == "catalog") }>
						@components.IconPackage("icon-sm")
						<span>كتالوج الأدوية والمستلزمات</span>
					</a>
					<a href="/customer/branches" class={ "sidebar-link", templ.KV("active", activeNav == "branches") }>
						@components.IconBuilding("icon-sm")
						<span>فروع الصيدلية ومواقع الاستلام</span>
					</a>
					<a href="/settings/employees" class={ "sidebar-link", templ.KV("active", activeNav == "employees") }>
						@components.IconUsers("icon-sm")
						<span>فريق العمل والموظفون</span>
					</a>
					<a href="/customer/documents" class={ "sidebar-link", templ.KV("active", activeNav == "documents") }>
						@components.IconFile("icon-sm")
						<span>المستندات والتراخيص الرسمية</span>
					</a>
					<a href="/wallet" class={ "sidebar-link", templ.KV("active", activeNav == "wallet") }>
						@components.IconWallet("icon-sm")
						<span>المحفظة والمعاملات</span>
					</a>
					<a href="/invoices" class={ "sidebar-link", templ.KV("active", activeNav == "invoices") }>
						@components.IconFile("icon-sm")
						<span>الفواتير الإلكترونية</span>
					</a>
					<a href="/messages" class={ "sidebar-link", templ.KV("active", activeNav == "messages") }>
						@components.IconMail("icon-sm")
						<span>الرسائل</span>
					</a>
					<a href="/notifications" class={ "sidebar-link", templ.KV("active", activeNav == "notifications") }>
						@components.IconBell("icon-sm")
						<span>الإشعارات</span>
					</a>
					<a href="/settings" class={ "sidebar-link", templ.KV("active", activeNav == "settings") }>
						@components.IconSettings("icon-sm")
						<span>الملف الشخصي والإعدادات</span>
					</a>

				</nav>

				<div style="border-top:1px solid rgba(255,255,255,0.08); padding:0.75rem; display:flex; flex-direction:column; gap:0.5rem; margin-top:auto;">
					<a href="/catalog" class="btn sidebar-footer-btn" style="width:100%; justify-content:center; font-weight:600; padding:0.6rem 0.75rem; color:rgba(255,255,255,0.85); background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radius-md);" title="كتالوج المنتجات">
						@components.IconPackage("icon-sm")
						<span>كتالوج المنتجات</span>
					</a>
				</div>
			</aside>

			<!-- Main Workspace -->
			<main class="main-content">
				<header class="top-navbar" style="padding:0 var(--space-6); height:var(--header-height); display:flex; justify-content:space-between; align-items:center; background:var(--surface-raised); border-bottom:1px solid var(--border); position:sticky; top:0; z-index:var(--z-sticky);">
					<div style="display:flex; align-items:center; gap:var(--space-3);">
						<h1 style="font-size:var(--text-lg); font-weight:700; color:var(--text); margin:0;">{ title }</h1>
					</div>

					<div style="display:flex; align-items:center; gap:var(--space-3);">
						@components.ThemeToggle()
						@buyingBranchSelector(ctx)
						<a href="/cart" class="btn btn-secondary btn-icon" title="سلة المشتريات">
							@components.IconCart("icon-sm")
						</a>
						<a href="/wallet" class="btn btn-secondary" style="font-weight:600; background:var(--accent-subtle); color:var(--accent-text); border-color:var(--border);">
							@components.IconWallet("icon-xs")
							<span>المحفظة</span>
						</a>
						<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
							<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger-text); border-color:var(--danger-border); font-weight:600;">
								@components.IconLogout("icon-xs")
								<span>خروج</span>
							</button>
						</form>
					</div>
				</header>

				<div class="page-container" style="padding:2rem;">
					{ children... }
				</div>
			</main>
		</div>
	}
}

// buyingBranchSelector is the top-strip branch dropdown (Rebuild V2 §3.2).
// One branch: a static label. Several: an auto-submitting select. None: the
// strip simply does not render a selector.
templ buyingBranchSelector(ctx context.Context) {
	if selection, ok := authctx.BuyingBranchFrom(ctx); ok && len(selection.Branches) > 0 {
		if len(selection.Branches) == 1 {
			<div style="display:flex; align-items:center; gap:var(--space-1); font-size:var(--text-xs); color:var(--text-secondary);">
				@components.IconBuilding("icon-xs")
				<span>{ selection.Branches[0].Name }</span>
			</div>
		} else {
			<form action="/customer/set-branch" method="POST" x-data="{ changed: false }" @change="changed = true" style="margin:0; display:inline-flex; align-items:center; gap:var(--space-1);">
				<label style="font-size:var(--text-xs); color:var(--text-muted); font-weight:600;">الشراء لفرع:</label>
				<select name="branch_id" style="font-size:var(--text-xs); padding:0.35rem 0.6rem; border-radius:var(--radius-md); border:1px solid var(--border); background:var(--surface-sunken); color:var(--text); font-weight:600; max-width:180px;">
					for _, b := range selection.Branches {
						if selection.Active != nil && *selection.Active == b.ID {
							<option selected value={ fmt.Sprintf("%d", b.ID) }>{ b.Name }</option>
						} else {
							<option value={ fmt.Sprintf("%d", b.ID) }>{ b.Name }</option>
						}
					}
				</select>
				<button type="submit" x-show="changed" class="btn btn-secondary btn-sm" style="font-size:var(--text-xs); font-weight:600;">
					تطبيق
				</button>
			</form>
		}
	}
}
