package layouts

import (
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// PharmacyShell is the buyer-side shell for pharmacies and pharmacy chains.
// It renders only the navigation the acting member may reach: Has() gates each
// link against the caller's permission set, so a warehouse clerk never sees
// billing and an owner sees everything.
templ PharmacyShell(title string, activeNav string, lang string, dir string, perms []string) {
	@Base(title, lang, dir) {
		<div class="app-shell">
			<aside class="sidebar">
				<div class="sidebar-header">
					<div style="width:32px; height:32px; border-radius:var(--radius-md); background:var(--primary-700); color:#fff; display:flex; align-items:center; justify-content:center;">
						@components.IconPill("icon-sm")
					</div>
					<span>بوابة الصيدليات</span>
				</div>
				<nav class="sidebar-nav">
					<a href="/pharmacy/dashboard" class={ "sidebar-link", templ.KV("active", activeNav == "dashboard") }>
						@components.IconHome("icon-sm")
						<span>الرئيسية</span>
					</a>
					<a href="/catalog" class={ "sidebar-link", templ.KV("active", activeNav == "catalog") }>
						@components.IconPill("icon-sm")
						<span>تصفح المنتجات</span>
					</a>
					<a href="/cart" class={ "sidebar-link", templ.KV("active", activeNav == "cart") }>
						@components.IconCart("icon-sm")
						<span>السلة</span>
					</a>
					<a href="/orders" class={ "sidebar-link", templ.KV("active", activeNav == "orders") }>
						@components.IconTruck("icon-sm")
						<span>طلباتي</span>
					</a>
					<a href="/favorites" class={ "sidebar-link", templ.KV("active", activeNav == "favorites") }>
						@components.IconHeart("icon-sm")
						<span>المفضلة</span>
					</a>
					<a href="/offers" class={ "sidebar-link", templ.KV("active", activeNav == "offers") }>
						@components.IconMegaphone("icon-sm")
						<span>العروض</span>
					</a>
					<a href="/suppliers" class={ "sidebar-link", templ.KV("active", activeNav == "suppliers") }>
						@components.IconBuilding("icon-sm")
						<span>الموردون</span>
					</a>
					if Has(perms, "billing.wallet.read") {
						<a href="/wallet" class={ "sidebar-link", templ.KV("active", activeNav == "wallet") }>
							@components.IconWallet("icon-sm")
							<span>المحفظة والفواتير</span>
						</a>
					}
					<a href="/settings" class={ "sidebar-link", templ.KV("active", activeNav == "settings") }>
						@components.IconSettings("icon-sm")
						<span>الإعدادات</span>
					</a>
				</nav>
				<div style="border-top:1px solid var(--neutral-800); padding:1rem; display:flex; flex-direction:column; gap:0.5rem;">
					<a href="/catalog" style="color:var(--neutral-400); font-size:0.875rem; display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0.75rem; text-decoration:none;">
						@components.IconArrowLeft("icon-xs")
						<span>السوق</span>
					</a>
				</div>
			</aside>

			<main class="main-content">
				<header class="top-navbar">
					<div>
						<h1 style="font-size:1.15rem; font-weight:700; color:var(--neutral-900);">{ title }</h1>
					</div>
					<div style="display:flex; align-items:center; gap:1rem;">
						<form action="/auth/logout" method="POST" style="margin:0; display:inline;">
							<button type="submit" class="btn btn-secondary btn-sm" style="color:var(--danger); border-color:var(--danger-border);">
								@components.IconLogout("icon-xs")
								<span>خروج</span>
							</button>
						</form>
					</div>
				</header>
				<div class="page-container">
					{ children... }
				</div>
			</main>
		</div>
	}
}
