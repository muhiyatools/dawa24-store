package components

type ToastProps struct {
	ID      string
	Title   string
	Message string
	Type    string // "success", "error", "info"
}

// Toast is a transient confirmation, anchored to the inline-start edge so it
// sits under the reader's eye in an RTL layout rather than across the page.
templ Toast(props ToastProps) {
	<div class="toast-stack" aria-live="polite" aria-atomic="true">
		<div
			id={ props.ID }
			class={ "toast",
				templ.KV("toast-success", props.Type == "success"),
				templ.KV("toast-error", props.Type == "error"),
				templ.KV("toast-info", props.Type != "success" && props.Type != "error") }
			role="status"
		>
			switch props.Type {
				case "success":
					@IconCheckCircle("icon-sm")
				case "error":
					@IconAlert("icon-sm")
				default:
					@IconInfo("icon-sm")
			}
			<div style="flex:1;">
				if props.Title != "" {
					<div class="toast-title">{ props.Title }</div>
				}
				<div>{ props.Message }</div>
			</div>
			<button class="toast-close" aria-label="إغلاق" onclick={ dismissToast(props.ID) }>
				@IconClose("icon-xs")
			</button>
		</div>
	</div>
}

script dismissToast(id string) {
	const el = document.getElementById(id);
	if (el) { el.remove(); }
}
