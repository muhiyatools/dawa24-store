package components

type AvatarProps struct {
	ImageURL string
	Initials string
	Name     string
	Size     string // "sm", "md" (default), "lg"
	State    string
}

templ Avatar(props AvatarProps) {
	<span
		class={ "avatar",
			templ.KV("avatar-sm", props.Size == "sm"),
			templ.KV("avatar-lg", props.Size == "lg"),
			templ.KV("avatar-md", props.Size != "sm" && props.Size != "lg") }
		if props.Name != "" {
			title={ props.Name }
		}
	>
		switch {
			case props.State == "loading":
				<span class="skeleton" style="width:100%; height:100%; border-radius:inherit;"></span>
			case props.ImageURL != "":
				<img src={ props.ImageURL } alt={ props.Name } loading="lazy"/>
			default:
				<span>{ props.Initials }</span>
		}
	</span>
}
