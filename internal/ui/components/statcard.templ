package components

import "github.com/muhiya/dawa24-store/internal/shared/money"

// StatCardProps renders a dashboard metric card.
type StatCardProps struct {
	Label    string
	Value    string
	Money    *money.Amount
	Subtitle string
	Tone     string // "primary", "warning", "danger", "info", "emerald", "amber", "rose", "cyan", "neutral"
	Trend    string // e.g. "+12.5%", "-3.2%"
	TrendUp  *bool
	Icon     string // optional icon name or emoji
}

templ StatCard(props StatCardProps) {
	<div class="stat-card-3d">
		<div class="stat-card-top">
			<span class="stat-card-title">{ props.Label }</span>
			if props.Trend != "" {
				<span class={ "pill-3d", templ.KV("pill-success", props.TrendUp == nil || *props.TrendUp), templ.KV("pill-danger", props.TrendUp != nil && !*props.TrendUp) }>
					{ props.Trend }
				</span>
			}
		</div>
		<div class={ "stat-card-value", statToneClass(props.Tone) }>
			if props.Money != nil {
				@MoneyDisplay(MoneyDisplayProps{ Amount: *props.Money, Large: true })
			} else {
				{ props.Value }
			}
		</div>
		if props.Subtitle != "" {
			<div class="stat-card-footer">
				<span>{ props.Subtitle }</span>
			</div>
		}
	</div>
}

func statToneClass(tone string) string {
	switch tone {
	case "primary", "cyan":
		return "text-brand"
	case "warning", "amber":
		return "text-warning"
	case "danger", "rose":
		return "text-danger"
	case "info", "sky":
		return "text-info"
	case "success", "emerald":
		return "text-success"
	default:
		return ""
	}
}

