package components

import "github.com/muhiya/dawa24-store/internal/shared/money"

// StatCardProps renders a dashboard metric card.
type StatCardProps struct {
	Label    string
	Value    string
	Money    *money.Amount
	Subtitle string
	Tone     string // "primary", "warning", "danger", "info", "neutral"
}

templ StatCard(props StatCardProps) {
	<div class="b2b-metric-card">
		<div class="b2b-metric-header">
			<span class="b2b-metric-title">{ props.Label }</span>
		</div>
		<div class={ "b2b-metric-value", statToneClass(props.Tone) }>
			if props.Money != nil {
				@MoneyDisplay(MoneyDisplayProps{ Amount: *props.Money, Large: true })
			} else {
				{ props.Value }
			}
		</div>
		if props.Subtitle != "" {
			<span class="b2b-metric-sub">
				{ props.Subtitle }
			</span>
		}
	</div>
}

func statToneClass(tone string) string {
	switch tone {
	case "primary":
		return "text-accent"
	case "warning":
		return "text-warning"
	case "danger":
		return "text-danger"
	case "info":
		return "text-info"
	default:
		return ""
	}
}

