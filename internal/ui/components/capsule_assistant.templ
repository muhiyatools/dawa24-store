package components

templ CapsuleAssistant() {
	<div
		x-data="capsuleAssistantManager()"
		style="position:fixed; bottom:24px; left:24px; right:auto; z-index:9990; font-family:var(--font-sans); direction:rtl;"
	>
		
		<!-- Floating Trigger Capsule Button (Hidden when Drawer is Open) -->
		<button
			type="button"
			x-show="!isOpen"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 transform scale-90"
			x-transition:enter-end="opacity-100 transform scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 transform scale-100"
			x-transition:leave-end="opacity-0 transform scale-90"
			@click="openAssistant()"
			class="hover-lift"
			style="display:flex; align-items:center; gap:0.6rem; background:linear-gradient(135deg, #0284c7, #4f46e5); color:#ffffff; border:none; padding:0.65rem 1.15rem; border-radius:var(--radius-full); box-shadow:0 12px 28px -6px rgba(79, 70, 229, 0.45), 0 6px 12px -4px rgba(2, 132, 199, 0.3); cursor:pointer; font-weight:800; font-size:0.875rem; transition:all 0.2s cubic-bezier(0.4, 0, 0.2, 1); border:1px solid rgba(255, 255, 255, 0.25);"
		>
			<div style="position:relative; display:flex; align-items:center; justify-content:center; width:24px; height:24px; background:rgba(255,255,255,0.2); border-radius:var(--radius-full);">
				@IconSparkles("icon-xs")
				<span style="position:absolute; top:-2px; right:-2px; width:7px; height:7px; background:#10b981; border-radius:50%; border:1.5px solid #ffffff;"></span>
			</div>
			<span>المساعد كبسولة</span>
			<span style="background:rgba(255,255,255,0.2); font-size:0.65rem; padding:0.15rem 0.45rem; border-radius:var(--radius-full); font-weight:700; letter-spacing:0.02em;">AI</span>
		</button>

		<!-- Slide-Out Chat Window -->
		<div
			x-show="isOpen"
			x-transition:enter="transition ease-out duration-250"
			x-transition:enter-start="opacity-0 transform translate-y-4 scale-95"
			x-transition:enter-end="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 transform translate-y-4 scale-95"
			@dragover.prevent="isDragging = true"
			@dragleave.prevent="isDragging = false"
			@drop.prevent="handleDrop($event)"
			style="display:none; position:fixed; bottom:24px; left:24px; right:auto; width:400px; max-width:calc(100vw - 32px); height:580px; max-height:calc(100vh - 48px); background:var(--surface-raised); border:1px solid var(--border); border-radius:24px; box-shadow:var(--shadow-2xl); display:flex; flex-direction:column; overflow:hidden; z-index:9995; backdrop-filter:blur(16px);"
			:style="isOpen ? 'display:flex;' : 'display:none;'"
		>
			
			<!-- Drag & Drop Overlay Zone -->
			<div
				x-show="isDragging"
				style="position:absolute; inset:0; z-index:50; background:rgba(14, 165, 233, 0.9); backdrop-filter:blur(4px); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.75rem; color:#ffffff;"
			>
				@IconUpload("icon-lg")
				<div style="font-weight:800; font-size:1.1rem;">أفلت الملفات هنا للإرفاق</div>
				<div style="font-size:0.8rem; opacity:0.9;">يدعم الصور، الروشتات، وملفات PDF الطبية</div>
			</div>

			<!-- Window Header -->
			<div style="padding:0.9rem 1.25rem; background:linear-gradient(135deg, #0284c7, #4f46e5); color:#ffffff; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.12);">
				<div style="display:flex; align-items:center; gap:0.75rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:rgba(255,255,255,0.2); border:1px solid rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center;">
						@IconSparkles("icon-sm")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.95rem; margin:0; display:flex; align-items:center; gap:0.4rem;">
							<span>المساعد كبسولة</span>
							<span style="width:6px; height:6px; background:#10b981; border-radius:50%; display:inline-block;"></span>
						</div>
						<div style="font-size:0.725rem; opacity:0.85; margin-top:1px;">المعالج الصيدلي الذكي للأصناف والتوريد</div>
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.35rem;">
					<button
						type="button"
						@click="closeAssistant()"
						style="background:rgba(255,255,255,0.15); border:none; color:#ffffff; width:30px; height:30px; border-radius:var(--radius-full); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 150ms;"
						onmouseover="this.style.background='rgba(255,255,255,0.25)'"
						onmouseout="this.style.background='rgba(255,255,255,0.15)'"
						title="إغلاق"
					>
						@IconClose("icon-xs")
					</button>
				</div>
			</div>

			<!-- Messages Scroll Area -->
			<div
				id="capsule-messages-container"
				style="flex:1; padding:1.15rem; overflow-y:auto; display:flex; flex-direction:column; gap:0.85rem; background:var(--surface-sunken);"
			>
				
				<!-- Welcome Greeting -->
				<div style="display:flex; flex-direction:column; gap:0.4rem;">
					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px 18px 18px 4px; padding:0.85rem 1rem; color:var(--text); font-size:0.875rem; line-height:1.6; max-width:90%; box-shadow:var(--shadow-xs);">
						مرحباً بك في منصة دواء 24. أنا <strong>كبسولة</strong>، مساعدك الصيدلي الرقمي. كيف يمكنني مساعدتك اليوم في فحص الأصناف أو مقارنة عروض التوريد؟
					</div>
				</div>

				<!-- Quick Chips -->
				<div x-show="messages.length === 0" style="display:flex; flex-direction:column; gap:0.35rem; margin-top:0.25rem;">
					<div style="font-size:0.725rem; font-weight:700; color:var(--text-muted); margin-bottom:0.15rem;">استفسارات شائعة:</div>
					
					<button
						type="button"
						@click="askChip('أفضل عروض المضادات الحيوية المتوفرة اليوم')"
						style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.45rem 0.75rem; font-size:0.8rem; color:var(--text); text-align:start; cursor:pointer; display:flex; align-items:center; gap:0.45rem; transition:border-color 150ms;"
						onmouseover="this.style.borderColor='var(--accent)'"
						onmouseout="this.style.borderColor='var(--border)'"
					>
						@IconPackage("icon-xs")
						<span>أفضل عروض المضادات الحيوية المتوفرة اليوم</span>
					</button>

					<button
						type="button"
						@click="askChip('كيف أقوم بمقارنة عروض الموردين والخصومات؟')"
						style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.45rem 0.75rem; font-size:0.8rem; color:var(--text); text-align:start; cursor:pointer; display:flex; align-items:center; gap:0.45rem; transition:border-color 150ms;"
						onmouseover="this.style.borderColor='var(--accent)'"
						onmouseout="this.style.borderColor='var(--border)'"
					>
						@IconLayers("icon-xs")
						<span>كيف أقوم بمقارنة عروض الموردين والخصومات؟</span>
					</button>

					<button
						type="button"
						@click="askChip('اشتراطات سلاسل التبريد المعتمدة للأدوية المبردة')"
						style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-lg); padding:0.45rem 0.75rem; font-size:0.8rem; color:var(--text); text-align:start; cursor:pointer; display:flex; align-items:center; gap:0.45rem; transition:border-color 150ms;"
						onmouseover="this.style.borderColor='var(--accent)'"
						onmouseout="this.style.borderColor='var(--border)'"
					>
						@IconShield("icon-xs")
						<span>اشتراطات سلاسل التبريد المعتمدة للأدوية المبردة</span>
					</button>
				</div>

				<!-- Dynamically Rendered Messages -->
				<template x-for="(msg, idx) in messages" :key="idx">
					<div
						:style="msg.isUser ? 'display:flex; justify-content:flex-end; animation:fadeIn 200ms ease;' : 'display:flex; justify-content:flex-start; animation:fadeIn 200ms ease;'"
					>
						<div style="max-width:88%; display:flex; flex-direction:column; gap:0.35rem;" :style="msg.isUser ? 'align-items:flex-end;' : 'align-items:flex-start;'">
							
							<!-- Attached files in message if any -->
							<template x-if="msg.attachments && msg.attachments.length > 0">
								<div style="display:flex; flex-wrap:wrap; gap:0.3rem;">
									<template x-for="file in msg.attachments" :key="file.name">
										<div style="display:flex; align-items:center; gap:0.3rem; background:rgba(0,0,0,0.1); padding:0.25rem 0.5rem; border-radius:var(--radius-md); font-size:0.75rem;">
											<span>📎</span>
											<span x-text="file.name" style="max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
										</div>
									</template>
								</div>
							</template>

							<!-- Message Text Bubble -->
							<div
								:style="msg.isUser ?
									'background:var(--accent); color:#ffffff; border-radius:18px 18px 4px 18px; padding:0.75rem 1rem; font-size:0.875rem; line-height:1.5; box-shadow:var(--shadow-xs);' :
									'background:var(--surface-raised); border:1px solid var(--border); border-radius:18px 18px 18px 4px; padding:0.85rem 1rem; color:var(--text); font-size:0.875rem; line-height:1.6; box-shadow:var(--shadow-xs);'"
							>
								<span x-text="msg.text"></span>
							</div>

						</div>
					</div>
				</template>

				<!-- Processing / Breathing Animation State -->
				<div x-show="isProcessing" style="display:flex; justify-content:flex-start; animation:fadeIn 200ms ease;">
					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px 18px 18px 4px; padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem; box-shadow:var(--shadow-xs);">
						<div class="capsule-breathing-pill" style="width:8px; height:8px; background:var(--accent); border-radius:50%;"></div>
						<span style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">كبسولة يكتب الآن...</span>
					</div>
				</div>

			</div>

			<!-- Attached Files Preview Strip -->
			<div x-show="attachedFiles.length > 0" style="padding:0.45rem 0.85rem; background:var(--surface-raised); border-top:1px solid var(--border); display:flex; gap:0.4rem; overflow-x:auto; align-items:center;">
				<template x-for="(f, i) in attachedFiles" :key="i">
					<div style="display:flex; align-items:center; gap:0.4rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.25rem 0.5rem; font-size:0.75rem; flex-shrink:0;">
						@IconPaperclip("icon-xs")
						<span x-text="f.name" style="max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600;"></span>
						<span x-text="formatBytes(f.size)" style="color:var(--text-muted); font-size:0.7rem;"></span>
						<button type="button" @click="removeAttachment(i)" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-weight:800; padding:0 2px;">✕</button>
					</div>
				</template>
			</div>

			<!-- Voice Recording Bar Active State -->
			<div x-show="isRecordingVoice" style="padding:0.75rem 1rem; background:var(--surface-raised); border-top:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
				<div style="display:flex; align-items:center; gap:0.6rem;">
					<span style="width:10px; height:10px; background:#ef4444; border-radius:50%; animation:pulse 1s infinite;"></span>
					<span style="font-size:0.825rem; font-weight:700; color:var(--text);" x-text="'جاري التسجيل الصوتي... ' + formatDuration(recordingSeconds)"></span>
				</div>
				<div style="display:flex; gap:0.5rem;">
					<button type="button" @click="cancelVoiceRecord()" class="btn btn-secondary btn-xs">إلغاء</button>
					<button type="button" @click="finishVoiceRecord()" class="btn btn-primary btn-xs" style="font-weight:700;">إنهاء وإرسال</button>
				</div>
			</div>

			<!-- Normal Chat Input Bar -->
			<div x-show="!isRecordingVoice" style="padding:0.75rem 1rem; background:var(--surface-raised); border-top:1px solid var(--border);">
				<input type="file" multiple x-ref="fileInput" @change="handleFileSelect($event)" style="display:none;" />
				<form @submit.prevent="sendMessage()" style="display:flex; gap:0.45rem; align-items:center; margin:0;">
					
					<!-- Attach Button -->
					<button
						type="button"
						@click="$refs.fileInput.click()"
						class="btn btn-secondary btn-icon"
						style="width:36px; height:36px; flex-shrink:0; color:var(--text-secondary);"
						title="إرفاق ملفات أو روشتات"
					>
						@IconPaperclip("icon-xs")
					</button>

					<!-- Voice Input Button -->
					<button
						type="button"
						@click="startVoiceRecord()"
						class="btn btn-secondary btn-icon"
						style="width:36px; height:36px; flex-shrink:0; color:var(--text-secondary);"
						title="تسجيل صوتي"
					>
						@IconMicrophone("icon-xs")
					</button>

					<!-- Query Text Input -->
					<input
						type="text"
						x-model="inputQuery"
						placeholder="اكتب استفسارك الصيدلي هنا..."
						class="form-input"
						style="flex:1; padding:0.5rem 0.85rem; font-size:0.85rem; border-radius:var(--radius-lg);"
					/>

					<!-- Send Button -->
					<button
						type="submit"
						class="btn btn-primary btn-icon"
						style="width:36px; height:36px; flex-shrink:0;"
						:disabled="!inputQuery.trim() && attachedFiles.length === 0"
						title="إرسال"
					>
						@IconSend("icon-xs")
					</button>
				</form>
			</div>

		</div>

		<style>
			@keyframes capsulePulse {
				0%, 100% { transform: scale(1); opacity: 0.8; }
				50% { transform: scale(1.4); opacity: 1; }
			}
			.capsule-breathing-pill {
				animation: capsulePulse 1.2s infinite ease-in-out;
			}
		</style>

		<script>
			function capsuleAssistantManager() {
				return {
					isOpen: false,
					inputQuery: '',
					isProcessing: false,
					isDragging: false,
					isRecordingVoice: false,
					recordingSeconds: 0,
					recordingTimer: null,
					attachedFiles: [],
					messages: [],

					openAssistant() {
						this.isOpen = true;
						this.scrollToBottom();
					},

					closeAssistant() {
						this.isOpen = false;
					},

					askChip(text) {
						this.inputQuery = text;
						this.sendMessage();
					},

					handleFileSelect(e) {
						const files = Array.from(e.target.files || []);
						this.attachedFiles.push(...files);
						e.target.value = '';
					},

					handleDrop(e) {
						this.isDragging = false;
						const files = Array.from(e.dataTransfer?.files || []);
						if (files.length > 0) {
							this.attachedFiles.push(...files);
						}
					},

					removeAttachment(idx) {
						this.attachedFiles.splice(idx, 1);
					},

					formatBytes(bytes) {
						if (!bytes) return '0 B';
						const k = 1024;
						const sizes = ['B', 'KB', 'MB'];
						const i = Math.floor(Math.log(bytes) / Math.log(k));
						return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
					},

					startVoiceRecord() {
						this.isRecordingVoice = true;
						this.recordingSeconds = 0;
						this.recordingTimer = setInterval(() => {
							this.recordingSeconds++;
						}, 1000);
					},

					cancelVoiceRecord() {
						this.isRecordingVoice = false;
						clearInterval(this.recordingTimer);
						this.recordingSeconds = 0;
					},

					finishVoiceRecord() {
						this.isRecordingVoice = false;
						clearInterval(this.recordingTimer);
						this.inputQuery = '🎤 تسجيل صوتي (' + this.formatDuration(this.recordingSeconds) + ')';
						this.sendMessage();
						this.recordingSeconds = 0;
					},

					formatDuration(secs) {
						const m = Math.floor(secs / 60);
						const s = secs % 60;
						return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
					},

					sendMessage() {
						const q = this.inputQuery.trim();
						if (!q && this.attachedFiles.length === 0) return;

						const currentAttachments = [...this.attachedFiles];
						this.messages.push({
							text: q || (currentAttachments.length > 0 ? 'مرفق: ' + currentAttachments.map(f => f.name).join(', ') : ''),
							isUser: true,
							attachments: currentAttachments
						});

						this.inputQuery = '';
						this.attachedFiles = [];
						this.isProcessing = true;
						this.scrollToBottom();

						// Simulated Smart Response with fast typewriter streaming
						setTimeout(() => {
							this.isProcessing = false;
							const responseText = this.generateResponse(q);
							this.typewriterMessage(responseText);
						}, 700);
					},

					typewriterMessage(fullText) {
						const msgObj = { text: '', isUser: false };
						this.messages.push(msgObj);
						let charIdx = 0;
						const speed = 12; // Fast & crisp typing

						const timer = setInterval(() => {
							if (charIdx < fullText.length) {
								msgObj.text += fullText.charAt(charIdx);
								charIdx++;
								this.scrollToBottom();
							} else {
								clearInterval(timer);
							}
						}, speed);
					},

					generateResponse(q) {
						const lower = (q || '').toLowerCase();
						if (lower.includes('مضاد') || lower.includes('antibiotic')) {
							return 'تم فحص أحدث عروض المضادات الحيوية المسجلة اليوم: تتوفر خصومات إضافية تصل إلى 8.5% على الأوجمنتين والسيبروفلوكساسين من 3 مستودعات معتمدة بسلاسل تبريد موثقة.';
						}
						if (lower.includes('مقارنة') || lower.includes('سعر')) {
							return 'يمكنك النقر على أي صنف في الكتالوج لعرض جدول المقارنة اللحظي بين كافة الموردين المتوفر لديهم الصنف، بما يشمل نسبة الخصم الإضافي، تواريخ الصلاحية، وسرعة التسليم.';
						}
						if (lower.includes('تبريد') || lower.includes('تخزين')) {
							return 'تشترط لائحة التوريد حفظ الأدوية الحيوية والمصلية في نطاق درجات حرارة بين 2° إلى 8° مئوية مع تسجيل بيانات جهاز التتبع الحراري (Data Logger) عند كل تسليم.';
						}
						if (lower.includes('صوتي') || lower.includes('🎤')) {
							return 'تم استلام التسجيل الصوتي بنجاح وجاري ربطه مع خوارزمية التحويل الصوتي إلى نصوص (Speech-to-Text) عبر بوابة المعالجة الذكية.';
						}
						return 'تم استلام طلبك ومطابقته مع قواعد بيانات الأدوية والتوريد في دواء 24. يمكنك إتمام أمر الشراء أو فحص تفاصيل التوريد عبر لوحة التحكم.';
					},

					scrollToBottom() {
						this.$nextTick(() => {
							const container = document.getElementById('capsule-messages-container');
							if (container) {
								container.scrollTop = container.scrollHeight;
							}
						});
					}
				};
			}
		</script>
	</div>
}
