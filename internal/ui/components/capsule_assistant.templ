package components

templ CapsuleAssistant() {
	<div
		x-data="capsuleAssistantManager()"
		x-init="init()"
		x-cloak
		style="position:fixed; bottom:24px; left:24px; right:auto; z-index:9990; font-family:var(--font-sans); direction:rtl;"
	>
		<!-- Floating Trigger: Polished Circular Button -->
		<button
			type="button"
			x-show="!isOpen"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 transform scale-75"
			x-transition:enter-end="opacity-100 transform scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 transform scale-100"
			x-transition:leave-end="opacity-0 transform scale-75"
			@click="openAssistant()"
			class="capsule-circle-btn"
			style="position:relative; width:56px; height:56px; border-radius:50%; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%); color:#ffffff; border:1px solid rgba(255, 255, 255, 0.35); box-shadow:0 12px 28px -4px rgba(37, 99, 235, 0.45), 0 6px 14px -2px rgba(2, 132, 199, 0.3); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); outline:none;"
			title="المساعد الذكي كبسولة"
		>
			<div style="display:flex; align-items:center; justify-content:center; transition:transform 0.2s ease;">
				@IconSparkles("icon-md")
			</div>
			<!-- Online Pulse Indicator -->
			<span style="position:absolute; top:2px; right:2px; width:12px; height:12px; background:#10b981; border-radius:50%; border:2px solid #ffffff; box-shadow:0 0 8px rgba(16, 185, 129, 0.8);"></span>
		</button>

		<!-- Slide-Out Chat Window -->
		<div
			x-show="isOpen"
			x-transition:enter="transition ease-out duration-250"
			x-transition:enter-start="opacity-0 transform translate-y-6 scale-95"
			x-transition:enter-end="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 transform translate-y-6 scale-95"
			@dragenter.prevent="onDragEnter($event)"
			@dragover.prevent=""
			@dragleave.prevent="onDragLeave($event)"
			@drop.prevent="onDrop($event)"
			style="position:fixed; bottom:24px; left:24px; right:auto; width:430px; max-width:calc(100vw - 32px); height:600px; max-height:calc(100vh - 48px); background:var(--surface-raised); border:1px solid var(--border); border-radius:24px; box-shadow:0 24px 48px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08); display:flex; flex-direction:column; overflow:hidden; z-index:9995; backdrop-filter:blur(20px);"
		>
			<!-- Drag & Drop Overlay Zone -->
			<div
				x-show="isDragging"
				x-transition:enter="transition ease-out duration-150"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-100"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				style="position:absolute; inset:12px; border-radius:20px; z-index:9999; background:rgba(2, 132, 199, 0.96); backdrop-filter:blur(12px); border:2px dashed rgba(255,255,255,0.85); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:0.8rem; color:#ffffff; box-shadow:0 16px 36px rgba(0,0,0,0.3); pointer-events:none;"
			>
				<div style="width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.22); display:flex; align-items:center; justify-content:center; margin:0 auto; flex-shrink:0; border:1px solid rgba(255,255,255,0.35);">
					@IconUpload("icon-md")
				</div>
				<div>
					<div style="font-weight:800; font-size:1.15rem; margin:0 0 0.25rem 0; line-height:1.3;">أفلت الملفات هنا للإرفاق</div>
					<div style="font-size:0.8rem; opacity:0.92; margin:0;">يدعم الصور، الروشتات، وملفات PDF الدوائية</div>
				</div>
			</div>

			<!-- Window Header -->
			<div style="padding:0.85rem 1.25rem; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%); color:#ffffff; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.15); flex-shrink:0;">
				<div style="display:flex; align-items:center; gap:0.7rem;">
					<div style="width:36px; height:36px; border-radius:var(--radius-lg); background:rgba(255,255,255,0.2); border:1px solid rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(0,0,0,0.15);">
						@IconSparkles("icon-sm")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.95rem; margin:0; display:flex; align-items:center; gap:0.4rem;">
							<span>المساعد كبسولة</span>
							<span style="width:7px; height:7px; background:#10b981; border-radius:50%; display:inline-block; box-shadow:0 0 6px #10b981;"></span>
						</div>
						<div style="font-size:0.725rem; opacity:0.9; margin-top:1px;">المعالج الصيدلي الذكي للأصناف والتوريد</div>
					</div>
				</div>

				<div style="display:flex; align-items:center; gap:0.35rem;">
					<button
						type="button"
						@click="closeAssistant()"
						style="background:rgba(255,255,255,0.15); border:none; color:#ffffff; width:30px; height:30px; border-radius:var(--radius-full); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 150ms;"
						onmouseover="this.style.background='rgba(255,255,255,0.28)'"
						onmouseout="this.style.background='rgba(255,255,255,0.15)'"
						title="إغلاق النافذة"
					>
						@IconClose("icon-xs")
					</button>
				</div>
			</div>

			<!-- Messages Scroll Area -->
			<div
				id="capsule-messages-container"
				style="flex:1 1 auto; min-height:0; padding:1rem; overflow-y:auto; display:flex; flex-direction:column; gap:0.85rem; background:var(--surface-sunken);"
			>
				<!-- Welcome Greeting Bubble -->
				<div style="display:flex; flex-direction:column; gap:0.35rem;">
					<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:18px 18px 18px 4px; padding:0.85rem 1.1rem; color:var(--text); font-size:0.85rem; line-height:1.6; max-width:92%; box-shadow:var(--shadow-xs);">
						مرحباً بك في منصة دواء 24. أنا <strong>كبسولة</strong>، مساعدك الصيدلي الرقمي المباشر. كيف يمكنني مساعدتك اليوم في فحص الأصناف، الروشتات، أو مقارنة عروض التوريد؟
					</div>
				</div>

				<!-- Quick Suggestion Chips -->
				<div x-show="messages.length === 0" style="display:flex; flex-direction:column; gap:0.4rem; margin-top:0.25rem;">
					<div style="font-size:0.725rem; font-weight:700; color:var(--text-muted); margin-bottom:0.1rem;">استفسارات شائعة مقترحة:</div>
					
					<button
						type="button"
						@click="askChip('أفضل عروض المضادات الحيوية المتوفرة اليوم')"
						class="chip-btn"
						style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:0.5rem 0.8rem; font-size:0.775rem; color:var(--text); text-align:start; cursor:pointer; display:flex; align-items:center; gap:0.5rem; transition:all 150ms;"
					>
						@IconPackage("icon-xs")
						<span>أفضل عروض المضادات الحيوية المتوفرة اليوم</span>
					</button>

					<button
						type="button"
						@click="askChip('كيف أقوم بمقارنة عروض الموردين والخصومات؟')"
						class="chip-btn"
						style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:0.5rem 0.8rem; font-size:0.775rem; color:var(--text); text-align:start; cursor:pointer; display:flex; align-items:center; gap:0.5rem; transition:all 150ms;"
					>
						@IconLayers("icon-xs")
						<span>كيف أقوم بمقارنة عروض الموردين والخصومات؟</span>
					</button>

					<button
						type="button"
						@click="askChip('اشتراطات سلاسل التبريد المعتمدة للأدوية المبردة')"
						class="chip-btn"
						style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); padding:0.5rem 0.8rem; font-size:0.775rem; color:var(--text); text-align:start; cursor:pointer; display:flex; align-items:center; gap:0.5rem; transition:all 150ms;"
					>
						@IconShield("icon-xs")
						<span>اشتراطات سلاسل التبريد المعتمدة للأدوية المبردة</span>
					</button>
				</div>

				<!-- Dynamically Rendered Messages -->
				<template x-for="(msg, idx) in messages" :key="idx">
					<div
						:style="msg.isUser ? 'display:flex; justify-content:flex-end; animation:fadeIn 180ms ease;' : 'display:flex; justify-content:flex-start; animation:fadeIn 180ms ease;'"
					>
						<div style="max-width:88%; display:flex; flex-direction:column; gap:0.3rem;" :style="msg.isUser ? 'align-items:flex-end;' : 'align-items:flex-start;'">
							
							<!-- Attached files badge if any -->
							<template x-if="msg.attachments && msg.attachments.length > 0">
								<div style="display:flex; flex-wrap:wrap; gap:0.25rem;">
									<template x-for="file in msg.attachments" :key="file.name || file.filename">
										<div style="display:flex; align-items:center; gap:0.3rem; background:rgba(0,0,0,0.1); padding:0.2rem 0.45rem; border-radius:var(--radius-md); font-size:0.725rem;">
											@IconPaperclip("icon-xxs")
											<span x-text="file.name || file.filename" style="max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
										</div>
									</template>
								</div>
							</template>

							<!-- Reasoning collapsible block if present -->
							<template x-if="!msg.isUser && msg.reasoning">
								<div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.45rem 0.7rem; font-size:0.725rem; color:var(--text-secondary); width:100%;">
									<div style="font-weight:700; display:flex; align-items:center; gap:0.3rem; margin-bottom:0.2rem; color:var(--text-muted);">
										@IconSparkles("icon-xxs")
										<span>التفكير المنطقي للمساعد:</span>
									</div>
									<div style="white-space:pre-wrap; line-height:1.4;" x-text="msg.reasoning"></div>
								</div>
							</template>

							<!-- Speech Bubble -->
							<div
								:style="msg.isUser ?
									'background:linear-gradient(135deg, #0284c7, #2563eb); color:#ffffff; border-radius:18px 18px 4px 18px; padding:0.75rem 1.05rem; font-size:0.85rem; line-height:1.55; box-shadow:var(--shadow-xs);' :
									'background:var(--surface-raised); border:1px solid var(--border); border-radius:18px 18px 18px 4px; padding:0.85rem 1.1rem; color:var(--text); font-size:0.85rem; line-height:1.6; box-shadow:var(--shadow-xs);'"
							>
								<div x-html="renderMarkdown(msg.text)" style="white-space:pre-wrap; word-break:break-word;"></div>
								
								<!-- Streaming cursor -->
								<span x-show="msg.isStreaming" class="capsule-breathing-pill" style="display:inline-block; width:6px; height:6px; background:var(--accent); border-radius:50%; margin-right:4px;"></span>
							</div>

						</div>
					</div>
				</template>

				<!-- Thinking indicator: three dots, no card, no label. Only
				     attachment analysis shows text, because it is slow enough
				     that the user needs to know which file is being read. -->
				<div x-show="isStreaming && messages.length > 0 && !messages[messages.length-1].text" class="capsule-thinking-row">
					<div class="capsule-thinking">
						<span class="capsule-dot"></span>
						<span class="capsule-dot"></span>
						<span class="capsule-dot"></span>
						<span x-show="statusStage" x-text="statusMessage" class="capsule-thinking-label"></span>
					</div>
				</div>

			</div>

			<!-- Pinned Bottom Controls (Always sits at the bottom of the card) -->
			<div style="margin-top:auto; flex-shrink:0; background:var(--surface-raised); border-top:1px solid var(--border); width:100%; box-sizing:border-box;">
				
				<!-- Attached Files Preview Strip -->
				<div x-show="attachedFiles.length > 0" style="padding:0.4rem 0.85rem; background:var(--surface-sunken); border-bottom:1px solid var(--border); display:flex; gap:0.35rem; overflow-x:auto; align-items:center;">
					<template x-for="(f, i) in attachedFiles" :key="i">
						<div style="display:flex; align-items:center; gap:0.35rem; background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.25rem 0.5rem; font-size:0.725rem; flex-shrink:0;">
							@IconPaperclip("icon-xxs")
							<span x-text="f.name" style="max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600;"></span>
							<span x-show="f.uploading" style="color:var(--accent); font-size:0.675rem;">(رفع...)</span>
							<span x-show="!f.uploading && !f.error" x-text="formatBytes(f.size)" style="color:var(--text-muted); font-size:0.675rem;"></span>
							<span x-show="f.error" style="color:var(--danger); font-size:0.675rem;" x-text="f.error"></span>
							<button type="button" @click="removeAttachment(i)" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-weight:800; padding:0 2px; line-height:1;" title="حذف">✕</button>
						</div>
					</template>
				</div>

				<!-- Voice Recording Active Bar -->
				<div x-show="isRecordingVoice" style="padding:0.75rem 1rem; display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
					<div style="display:flex; align-items:center; gap:0.5rem;">
						<span style="width:9px; height:9px; background:#ef4444; border-radius:50%; animation:pulse 1s infinite;"></span>
						<span style="font-size:0.8rem; font-weight:700; color:var(--text);" x-text="'جاري الاستماع الصوتي... ' + formatDuration(recordingSeconds)"></span>
					</div>
					<div style="display:flex; gap:0.4rem;">
						<button type="button" @click="cancelVoiceRecord()" class="btn btn-secondary btn-xs">إلغاء</button>
						<button type="button" @click="finishVoiceRecord()" class="btn btn-primary btn-xs" style="font-weight:700;">إنهاء وإرسال</button>
					</div>
				</div>

				<!-- Normal Chat Input Bar -->
				<div x-show="!isRecordingVoice" style="padding:0.65rem 0.85rem; width:100%; box-sizing:border-box;">
					<input type="file" multiple x-ref="fileInput" @change="handleFileSelect($event)" style="display:none;" />
					
					<!-- Integrated Input Pill Container -->
					<div style="display:flex; align-items:center; gap:0.4rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:24px; padding:0.25rem 0.4rem 0.25rem 0.65rem; transition:border-color 150ms;">
						
						<!-- Attach Button -->
						<button
							type="button"
							@click="$refs.fileInput.click()"
							style="width:32px; height:32px; flex-shrink:0; border-radius:var(--radius-full); border:none; background:none; color:var(--text-secondary); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 120ms;"
							onmouseover="this.style.background='rgba(0,0,0,0.06)'"
							onmouseout="this.style.background='none'"
							title="إرفاق ملفات أو روشتات"
							:disabled="isStreaming"
						>
							@IconPaperclip("icon-xs")
						</button>

						<!-- Voice Input Button -->
						<button
							type="button"
							@click="startVoiceRecord()"
							style="width:32px; height:32px; flex-shrink:0; border-radius:var(--radius-full); border:none; background:none; color:var(--text-secondary); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 120ms;"
							onmouseover="this.style.background='rgba(0,0,0,0.06)'"
							onmouseout="this.style.background='none'"
							title="تسجيل صوتي"
							:disabled="isStreaming"
						>
							@IconMicrophone("icon-xs")
						</button>

						<!-- Multiline Textarea without scrollbar spinners -->
						<textarea
							x-ref="chatTextarea"
							x-model="inputQuery"
							@keydown="handleKeydown($event)"
							@input="autoResizeTextarea()"
							placeholder="اكتب استفسارك الصيدلي... (Enter للإرسال)"
							rows="1"
							style="flex:1; background:transparent; border:none; outline:none; resize:none; padding:0.35rem 0.25rem; font-size:0.85rem; color:var(--text); line-height:1.45; max-height:110px; min-height:24px; height:24px; font-family:inherit; overflow-y:auto; scrollbar-width:none; box-sizing:border-box;"
							:disabled="isStreaming"
						></textarea>

						<!-- Send / Stop Button -->
						<template x-if="!isStreaming">
							<button
								type="button"
								@click="sendMessage()"
								class="btn btn-primary"
								style="width:34px; height:34px; padding:0; flex-shrink:0; border-radius:var(--radius-full); display:flex; align-items:center; justify-content:center;"
								:disabled="!inputQuery.trim() && attachedFiles.length === 0"
								title="إرسال (Enter)"
							>
								@IconSend("icon-xs")
							</button>
						</template>

						<template x-if="isStreaming">
							<button
								type="button"
								@click="cancelStream()"
								class="btn btn-secondary"
								style="width:34px; height:34px; padding:0; flex-shrink:0; border-radius:var(--radius-full); color:#ef4444; border-color:#ef4444; display:flex; align-items:center; justify-content:center;"
								title="إيقاف التوليد"
							>
								@IconClose("icon-xs")
							</button>
						</template>

					</div>
				</div>

			</div>

		</div>

		<style>
			.capsule-circle-btn:hover {
				transform: translateY(-3px) scale(1.05);
				box-shadow: 0 16px 32px -4px rgba(37, 99, 235, 0.55), 0 8px 18px -2px rgba(2, 132, 199, 0.4) !important;
			}
			.chip-btn:hover {
				border-color: var(--accent) !important;
				background: var(--accent-subtle) !important;
				color: var(--accent) !important;
			}
			@keyframes capsulePulse {
				0%, 100% { transform: scale(1); opacity: 0.8; }
				50% { transform: scale(1.4); opacity: 1; }
			}
			.capsule-breathing-pill {
				animation: capsulePulse 1.2s infinite ease-in-out;
			}
		</style>

		<script>
			function capsuleAssistantManager() {
				return {
					isOpen: false,
					inputQuery: '',
					isStreaming: false,
					statusStage: '',
					statusMessage: '',
					isDragging: false,
					dragCounter: 0,
					isRecordingVoice: false,
					recordingSeconds: 0,
					recordingTimer: null,
					mediaRecorder: null,
					audioChunks: [],
					speechRecognition: null,
					attachedFiles: [],
					messages: [],
					conversationID: 0,
					abortController: null,

					init() {
						const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
						if (SpeechRec) {
							try {
								this.speechRecognition = new SpeechRec();
								this.speechRecognition.lang = 'ar-EG';
								this.speechRecognition.interimResults = false;
								this.speechRecognition.maxAlternatives = 1;
								this.speechRecognition.onresult = (event) => {
									const text = event.results[0][0].transcript;
									if (text) {
										this.inputQuery = (this.inputQuery ? this.inputQuery + ' ' : '') + text;
										this.$nextTick(() => this.autoResizeTextarea());
									}
								};
								this.speechRecognition.onend = () => {
									this.isRecordingVoice = false;
									clearInterval(this.recordingTimer);
									this.recordingSeconds = 0;
								};
								this.speechRecognition.onerror = () => {
									this.isRecordingVoice = false;
									clearInterval(this.recordingTimer);
									this.recordingSeconds = 0;
								};
							} catch (e) {
								this.speechRecognition = null;
							}
						}
					},

					openAssistant() {
						this.isOpen = true;
						this.scrollToBottom();
					},

					closeAssistant() {
						this.isOpen = false;
						this.isDragging = false;
						this.dragCounter = 0;
					},

					askChip(text) {
						this.inputQuery = text;
						this.sendMessage();
					},

					onDragEnter(e) {
						if (!this.isOpen) return;
						if (e.dataTransfer && e.dataTransfer.types && e.dataTransfer.types.includes('Files')) {
							this.dragCounter++;
							this.isDragging = true;
						}
					},

					onDragLeave(e) {
						if (!this.isOpen) return;
						this.dragCounter--;
						if (this.dragCounter <= 0) {
							this.dragCounter = 0;
							this.isDragging = false;
						}
					},

					onDrop(e) {
						if (!this.isOpen) return;
						this.dragCounter = 0;
						this.isDragging = false;
						const files = Array.from(e.dataTransfer?.files || []);
						this.addFiles(files);
					},

					handleFileSelect(e) {
						const files = Array.from(e.target.files || []);
						this.addFiles(files);
						e.target.value = '';
					},

					async addFiles(files) {
						for (const file of files) {
							if (this.attachedFiles.length >= 5) break;
							const fileItem = {
								file: file,
								name: file.name,
								size: file.size,
								handle: '',
								uploading: true,
								error: ''
							};
							this.attachedFiles.push(fileItem);
							this.uploadAttachment(fileItem);
						}
					},

					async uploadAttachment(item) {
						try {
							const form = new FormData();
							form.append('file', item.file);
							const resp = await fetch('/api/v1/assistant/attachments', {
								method: 'POST',
								body: form
							});
							if (!resp.ok) {
								const errData = await resp.json().catch(() => ({}));
								item.error = errData.message || 'فشل رفع الملف';
								return;
							}
							const data = await resp.json();
							if (data.attachments && data.attachments.length > 0) {
								item.handle = data.attachments[0].handle;
							}
						} catch (e) {
							item.error = 'خطأ في الاتصال بالخادم';
						} finally {
							item.uploading = false;
						}
					},

					removeAttachment(idx) {
						this.attachedFiles.splice(idx, 1);
					},

					formatBytes(bytes) {
						if (!bytes) return '0 B';
						const k = 1024;
						const sizes = ['B', 'KB', 'MB'];
						const i = Math.floor(Math.log(bytes) / Math.log(k));
						return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
					},

					async startVoiceRecord() {
						this.isRecordingVoice = true;
						this.recordingSeconds = 0;
						this.recordingTimer = setInterval(() => {
							this.recordingSeconds++;
						}, 1000);

						if (this.speechRecognition) {
							try {
								this.speechRecognition.start();
								return;
							} catch (e) {
								// Fallback to MediaRecorder
							}
						}

						try {
							const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
							this.audioChunks = [];
							this.mediaRecorder = new MediaRecorder(stream);
							this.mediaRecorder.ondataavailable = (e) => {
								if (e.data.size > 0) this.audioChunks.push(e.data);
							};
							this.mediaRecorder.start();
						} catch (e) {
							this.cancelVoiceRecord();
							alert('تعذر الوصول إلى الميكروفون: ' + e.message);
						}
					},

					cancelVoiceRecord() {
						this.isRecordingVoice = false;
						clearInterval(this.recordingTimer);
						this.recordingSeconds = 0;
						if (this.speechRecognition) {
							try { this.speechRecognition.stop(); } catch (e) {}
						}
						if (this.mediaRecorder && this.mediaRecorder.state !== 'inactive') {
							this.mediaRecorder.stop();
						}
					},

					async finishVoiceRecord() {
						if (this.speechRecognition) {
							try { this.speechRecognition.stop(); } catch (e) {}
							return;
						}

						if (this.mediaRecorder && this.mediaRecorder.state !== 'inactive') {
							this.mediaRecorder.onstop = async () => {
								const audioBlob = new Blob(this.audioChunks, { type: 'audio/webm' });
								this.audioChunks = [];
								this.statusMessage = 'جاري تفريغ الصوت عبر Whisper...';
								try {
									const form = new FormData();
									form.append('file', audioBlob, 'voice.webm');
									const resp = await fetch('/api/v1/assistant/transcribe', {
										method: 'POST',
										body: form
									});
									if (resp.ok) {
										const data = await resp.json();
										if (data.text) {
											this.inputQuery = (this.inputQuery ? this.inputQuery + ' ' : '') + data.text;
											this.$nextTick(() => this.autoResizeTextarea());
										}
									}
								} catch (e) {
									console.warn('transcription failed', e);
								} finally {
									this.statusMessage = '';
								}
							};
							this.mediaRecorder.stop();
						}

						this.isRecordingVoice = false;
						clearInterval(this.recordingTimer);
						this.recordingSeconds = 0;
					},

					formatDuration(secs) {
						const m = Math.floor(secs / 60);
						const s = secs % 60;
						return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
					},

					handleKeydown(e) {
						if (e.key === 'Enter') {
							if (e.shiftKey) {
								this.$nextTick(() => this.autoResizeTextarea());
							} else {
								e.preventDefault();
								this.sendMessage();
							}
						}
					},

					autoResizeTextarea() {
						const el = this.$refs.chatTextarea;
						if (!el) return;
						el.style.height = '24px';
						const newHeight = Math.min(Math.max(el.scrollHeight, 24), 110);
						el.style.height = newHeight + 'px';
					},

					async sendMessage() {
						const q = this.inputQuery.trim();
						if (this.isStreaming || (!q && this.attachedFiles.length === 0)) return;

						// Check if any file is still uploading
						const stillUploading = this.attachedFiles.some(f => f.uploading);
						if (stillUploading) {
							this.statusMessage = 'يرجى الانتظار حتى اكتمال رفع المرفقات...';
							return;
						}

						const handles = this.attachedFiles.filter(f => f.handle && !f.error).map(f => f.handle);
						const sentAttachments = [...this.attachedFiles];

						this.messages.push({
							text: q || (sentAttachments.length > 0 ? 'مرفق: ' + sentAttachments.map(f => f.name).join(', ') : ''),
							isUser: true,
							attachments: sentAttachments
						});

						// Push first, then take the element back out. Alpine wraps
						// pushed objects in a reactive proxy; keeping a reference to
						// the original object means every later mutation is invisible
						// to the DOM, which is why the answer bubble stayed empty.
						this.messages.push({
							text: '',
							reasoning: '',
							isUser: false,
							isStreaming: true
						});
						const assistantMsg = this.messages[this.messages.length - 1];

						this.inputQuery = '';
						this.attachedFiles = [];
						if (this.$refs.chatTextarea) {
							this.$refs.chatTextarea.style.height = '24px';
						}
						this.isStreaming = true;
						this.statusStage = '';
						this.statusMessage = '';
						this.scrollToBottom();

						this.abortController = new AbortController();

						try {
							const resp = await fetch('/api/v1/assistant/messages', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									text: q,
									conversation_id: this.conversationID,
									attachment_handles: handles
								}),
								signal: this.abortController.signal
							});

							if (!resp.ok) {
								const errData = await resp.json().catch(() => ({}));
								assistantMsg.text = errData.message || 'تعذر الاتصال بالمساعد الذكي.';
								assistantMsg.isStreaming = false;
								this.isStreaming = false;
								return;
							}

							const reader = resp.body.getReader();
							const decoder = new TextDecoder('utf-8');
							let buffer = '';

							while (true) {
								const { done, value } = await reader.read();
								if (done) break;

								buffer += decoder.decode(value, { stream: true });
								const lines = buffer.split('\n');
								buffer = lines.pop() || '';

								let currentEvent = 'message';
								for (const line of lines) {
									const trimmed = line.trim();
									if (trimmed.startsWith('event:')) {
										currentEvent = trimmed.substring(6).trim();
									} else if (trimmed.startsWith('data:')) {
										const dataStr = trimmed.substring(5).trim();
										if (!dataStr) continue;

										try {
											const data = JSON.parse(dataStr);
											if (currentEvent === 'delta' && data.text) {
												this.statusStage = '';
												assistantMsg.text += data.text;
												this.scrollToBottom();
											} else if (currentEvent === 'reasoning' && data.text) {
												assistantMsg.reasoning += data.text;
												this.scrollToBottom();
											} else if (currentEvent === 'status') {
												this.statusStage = data.stage || '';
												this.statusMessage = data.message || (data.stage === 'analyzing_attachment' ? 'جاري تحليل المرفق (' + data.file + ')...' : '');
												this.scrollToBottom();
											} else if (currentEvent === 'done') {
												if (data.conversation_id) {
													this.conversationID = data.conversation_id;
												}
												assistantMsg.isStreaming = false;
											} else if (currentEvent === 'error') {
												assistantMsg.text += '\n\n[خطأ: ' + (data.message || 'حدث خطأ غير متوقع') + ']';
												assistantMsg.isStreaming = false;
											}
										} catch (parseErr) {
											// Non-JSON frame ignore
										}
									}
								}
							}
						} catch (e) {
							if (e.name !== 'AbortError') {
								assistantMsg.text += '\n\n[انقطع الاتصال بالخادم: ' + e.message + ']';
							}
						} finally {
							assistantMsg.isStreaming = false;
							this.isStreaming = false;
							this.statusStage = '';
							this.statusMessage = '';
							this.abortController = null;
							this.scrollToBottom();
						}
					},

					cancelStream() {
						if (this.abortController) {
							this.abortController.abort();
							this.abortController = null;
						}
						this.isStreaming = false;
						this.statusStage = '';
						this.statusMessage = '';
					},

					renderMarkdown(raw) {
						if (!raw) return '';
						let escaped = raw
							.replace(/&/g, '&amp;')
							.replace(/</g, '&lt;')
							.replace(/>/g, '&gt;');

						escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
						escaped = escaped.replace(/`([^`]+)`/g, '<code style="background:rgba(0,0,0,0.08); padding:0.15rem 0.35rem; border-radius:4px; font-size:0.85em;">$1</code>');
						return escaped;
					},

					scrollToBottom() {
						this.$nextTick(() => {
							const container = document.getElementById('capsule-messages-container');
							if (container) {
								container.scrollTop = container.scrollHeight;
							}
						});
					}
				};
			}
		</script>
	</div>
}
