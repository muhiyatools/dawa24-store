package components

templ CapsuleAssistant() {
	<div
		x-data="capsuleAssistantManager()"
		x-init="init()"
		x-cloak
		style="position:fixed; bottom:24px; left:24px; right:auto; z-index:9990; font-family:var(--font-sans); direction:rtl;"
	>
		<!-- Floating Trigger: Polished Circular Button (Hidden when Window is Open) -->
		<button
			type="button"
			x-show="!isOpen"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 transform scale-75"
			x-transition:enter-end="opacity-100 transform scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 transform scale-100"
			x-transition:leave-end="opacity-0 transform scale-75"
			@click="openAssistant()"
			class="capsule-circle-btn"
			style="position:relative; width:54px; height:54px; border-radius:50%; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%); color:#ffffff; border:1px solid rgba(255, 255, 255, 0.35); box-shadow:0 10px 24px -4px rgba(37, 99, 235, 0.45), 0 4px 12px -2px rgba(2, 132, 199, 0.3); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1); outline:none;"
			title="المساعد الذكي كبسولة"
		>
			<div style="display:flex; align-items:center; justify-content:center;">
				@IconSparkles("icon-md")
			</div>
			<!-- Online Pulse Indicator -->
			<span style="position:absolute; top:2px; right:2px; width:11px; height:11px; background:#10b981; border-radius:50%; border:2px solid #ffffff; box-shadow:0 0 6px rgba(16, 185, 129, 0.8);"></span>
		</button>

		<!-- ChatGPT-Style Chat Window -->
		<div
			x-show="isOpen"
			x-transition:enter="transition ease-out duration-250"
			x-transition:enter-start="opacity-0 transform translate-y-6 scale-95"
			x-transition:enter-end="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 transform translate-y-6 scale-95"
			@dragenter.prevent="onDragEnter($event)"
			@dragover.prevent=""
			@dragleave.prevent="onDragLeave($event)"
			@drop.prevent="onDrop($event)"
			style="position:fixed; bottom:24px; left:24px; right:auto; width:440px; max-width:calc(100vw - 32px); height:620px; max-height:calc(100dvh - 36px); background:var(--surface-raised); border:1px solid var(--border); border-radius:22px; box-shadow:0 24px 60px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08); display:flex; flex-direction:column; overflow:hidden; z-index:9995; backdrop-filter:blur(20px);"
		>
			<!-- Drag & Drop Overlay Zone -->
			<div
				x-show="isDragging"
				x-transition:enter="transition ease-out duration-150"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-100"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				style="position:absolute; inset:10px; border-radius:18px; z-index:9999; background:rgba(2, 132, 199, 0.96); backdrop-filter:blur(12px); border:2px dashed rgba(255,255,255,0.85); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:0.75rem; color:#ffffff; box-shadow:0 16px 36px rgba(0,0,0,0.3); pointer-events:none;"
			>
				<div style="width:54px; height:54px; border-radius:50%; background:rgba(255,255,255,0.22); display:flex; align-items:center; justify-content:center; margin:0 auto; flex-shrink:0; border:1px solid rgba(255,255,255,0.35);">
					@IconUpload("icon-md")
				</div>
				<div>
					<div style="font-weight:800; font-size:1.1rem; margin:0 0 0.2rem 0;">أفلت الملفات هنا للإرفاق</div>
					<div style="font-size:0.775rem; opacity:0.92; margin:0;">يدعم الصور، الروشتات، وملفات PDF الدوائية</div>
				</div>
			</div>

			<!-- Sleek Minimal Header -->
			<div style="padding:0.75rem 1.15rem; background:var(--surface-raised); border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-shrink:0; height:56px; box-sizing:border-box;">
				<div style="display:flex; align-items:center; gap:0.65rem;">
					<div style="width:32px; height:32px; border-radius:10px; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%); color:#ffffff; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(37,99,235,0.3);">
						@IconSparkles("icon-xs")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.925rem; margin:0; display:flex; align-items:center; gap:0.35rem; color:var(--text);">
							<span>كبسولة</span>
							<span style="width:6px; height:6px; background:#10b981; border-radius:50%; display:inline-block; box-shadow:0 0 4px #10b981;"></span>
						</div>
						<div style="font-size:0.7rem; color:var(--text-muted); line-height:1;">المساعد الصيدلي الذكي</div>
					</div>
				</div>

				<!-- Header Action Buttons -->
				<div style="display:flex; align-items:center; gap:0.3rem;">
					<!-- Close Button -->
					<button
						type="button"
						@click="closeAssistant()"
						style="background:none; border:none; color:var(--text-muted); width:28px; height:28px; border-radius:var(--radius-md); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 120ms;"
						onmouseover="this.style.background='var(--surface-sunken)'; this.style.color='var(--text)';"
						onmouseout="this.style.background='none'; this.style.color='var(--text-muted)';"
						title="إغلاق"
					>
						@IconClose("icon-xs")
					</button>
				</div>
			</div>

			<!-- Messages Scroll Area (Canvas Style - Direct Text on Background) -->
			<div
				id="capsule-messages-container"
				class="capsule-messages-scroll"
				style="flex:1 1 auto; min-height:0; overflow-y:auto; overflow-x:hidden; padding:1.25rem 1.15rem; display:flex; flex-direction:column; gap:1.25rem; background:var(--surface-raised); overscroll-behavior:contain;"
			>
				<!-- Empty State / Welcome Greeting -->
				<div x-show="messages.length === 0" style="display:flex; flex-direction:column; align-items:center; text-align:center; padding:1.5rem 0.5rem; gap:1rem;">
					<div style="width:48px; height:48px; border-radius:14px; background:linear-gradient(135deg, rgba(2, 132, 199, 0.15), rgba(37, 99, 235, 0.15)); color:var(--accent); display:flex; align-items:center; justify-content:center; border:1px solid rgba(2, 132, 199, 0.25);">
						@IconSparkles("icon-md")
					</div>
					<div>
						<h4 style="margin:0 0 0.25rem 0; font-size:1.05rem; font-weight:800; color:var(--text);">مرحباً بك! أنا كبسولة</h4>
						<p style="margin:0; font-size:0.8rem; color:var(--text-secondary); line-height:1.5; max-width:320px;">
							مساعدك الذكي لفحص الأدوية، تحليل الروشتات والمرفقات، ومقارنة عروض الموردين والأسعار.
						</p>
					</div>

					<!-- Quick Suggestion Chips (Minimalist Outline Pills) -->
					<div style="display:flex; flex-direction:column; gap:0.45rem; width:100%; max-width:360px; margin-top:0.25rem;">
						<button
							type="button"
							@click="askChip('أفضل عروض المضادات الحيوية المتوفرة اليوم')"
							class="capsule-chip-btn"
						>
							@IconPackage("icon-xs")
							<span>أفضل عروض المضادات الحيوية المتوفرة اليوم</span>
						</button>

						<button
							type="button"
							@click="askChip('كيف أقوم بمقارنة عروض الموردين والخصومات؟')"
							class="capsule-chip-btn"
						>
							@IconLayers("icon-xs")
							<span>كيف أقوم بمقارنة عروض الموردين والخصومات؟</span>
						</button>

						<button
							type="button"
							@click="askChip('اشتراطات سلاسل التبريد المعتمدة للأدوية')"
							class="capsule-chip-btn"
						>
							@IconShield("icon-xs")
							<span>اشتراطات سلاسل التبريد المعتمدة للأدوية</span>
						</button>
					</div>
				</div>

				<!-- Message Stream -->
				<template x-for="(msg, idx) in messages" :key="idx">
					<div>
						<!-- User Message (Subtle Right-Aligned Pill) -->
						<template x-if="msg.isUser">
							<div style="display:flex; justify-content:flex-start; margin-bottom:0.25rem;">
								<div style="max-width:85%; display:flex; flex-direction:column; align-items:flex-start; gap:0.35rem;">
									<!-- Attached Files Badges -->
									<template x-if="msg.attachments && msg.attachments.length > 0">
										<div style="display:flex; flex-wrap:wrap; gap:0.3rem;">
											<template x-for="file in msg.attachments" :key="file.name || file.filename">
												<div style="display:flex; align-items:center; gap:0.3rem; background:var(--surface-sunken); border:1px solid var(--border); padding:0.2rem 0.5rem; border-radius:var(--radius-md); font-size:0.725rem; color:var(--text-secondary);">
													@IconPaperclip("icon-xxs")
													<span x-text="file.name || file.filename" style="max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
												</div>
											</template>
										</div>
									</template>
									<!-- User Text Bubble -->
									<div
										dir="auto"
										style="background:var(--surface-sunken); border:1px solid var(--border); color:var(--text); border-radius:18px 18px 4px 18px; padding:0.65rem 1rem; font-size:0.875rem; line-height:1.55; word-break:break-word;"
										x-text="msg.text"
									></div>
								</div>
							</div>
						</template>

						<!-- Assistant Message (ChatGPT Style - Direct on Canvas) -->
						<template x-if="!msg.isUser">
							<div style="display:flex; flex-direction:column; gap:0.45rem; animation:fadeIn 150ms ease;">
								
								<!-- Assistant Header / Avatar Line -->
								<div style="display:flex; align-items:center; gap:0.45rem;">
									<div style="width:20px; height:20px; border-radius:6px; background:linear-gradient(135deg, #0284c7, #2563eb); color:#ffffff; display:flex; align-items:center; justify-content:center;">
										@IconSparkles("icon-xxs")
									</div>
									<span style="font-size:0.775rem; font-weight:700; color:var(--text);">كبسولة</span>
								</div>

								<!-- Collapsible Reasoning Block (Thinking...) -->
								<template x-if="msg.reasoning">
									<div x-data="{ open: false }" style="margin:0.2rem 0; border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--surface-sunken);">
										<button
											type="button"
											@click="open = !open"
											style="width:100%; padding:0.4rem 0.65rem; background:none; border:none; display:flex; justify-content:space-between; align-items:center; cursor:pointer; font-size:0.75rem; color:var(--text-secondary);"
										>
											<span style="display:flex; align-items:center; gap:0.35rem; font-weight:600;">
												@IconSparkles("icon-xxs")
												<span>التفكير المنطقي للمساعد</span>
											</span>
											<span x-text="open ? '▲ إخفاء' : '▼ إظهار'" style="font-size:0.7rem; color:var(--text-muted);"></span>
										</button>
										<div x-show="open" style="padding:0.5rem 0.65rem; font-size:0.75rem; color:var(--text-muted); border-top:1px solid var(--border); white-space:pre-wrap; line-height:1.45;" x-text="msg.reasoning"></div>
									</div>
								</template>

								<!-- Assistant Response Body (Markdown Rendered with Auto Direction) -->
								<div
									dir="auto"
									class="capsule-prose"
									style="font-size:0.875rem; line-height:1.65; color:var(--text); word-break:break-word;"
								>
									<span x-html="renderMarkdown(msg.text)"></span>
									<!-- Glowing Streaming Cursor -->
									<span x-show="msg.isStreaming" class="capsule-cursor">▊</span>
								</div>

								<!-- Minimalist Discreet Copy Button Under Response -->
								<div x-show="!msg.isStreaming && msg.text" style="display:flex; align-items:center; gap:0.5rem; margin-top:0.15rem;">
									<button
										type="button"
										@click="copyText(msg.text, $el)"
										class="capsule-mini-copy-btn"
										title="نسخ الإجابة"
									>
										@IconCopy("icon-xxs")
										<span class="copy-btn-text">نسخ</span>
									</button>
								</div>

							</div>
						</template>
					</div>
				</template>

				<!-- Thinking indicator: three dots, no card. Only attachment analysis shows text. -->
				<div x-show="isStreaming && messages.length > 0 && !messages[messages.length-1].text" class="capsule-thinking-row">
					<div class="capsule-thinking">
						<span class="capsule-dot"></span>
						<span class="capsule-dot"></span>
						<span class="capsule-dot"></span>
						<span x-show="statusStage" x-text="statusMessage" class="capsule-thinking-label"></span>
					</div>
				</div>

			</div>

			<!-- Pinned Bottom Controls (ChatGPT-Style Docked Prompt Capsule) -->
			<div style="flex-shrink:0; background:var(--surface-raised); border-top:1px solid var(--border); padding:0.65rem 0.85rem; box-sizing:border-box; width:100%; position:relative; z-index:10; margin-top:auto;">
				
				<!-- Attached Files Preview Strip -->
				<div x-show="attachedFiles.length > 0" style="margin-bottom:0.45rem; display:flex; gap:0.35rem; overflow-x:auto; align-items:center;">
					<template x-for="(f, i) in attachedFiles" :key="i">
						<div style="display:flex; align-items:center; gap:0.35rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.2rem 0.45rem; font-size:0.725rem; flex-shrink:0;">
							@IconPaperclip("icon-xxs")
							<span x-text="f.name" style="max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600;"></span>
							<span x-show="f.uploading" style="color:var(--accent); font-size:0.675rem;">(رفع...)</span>
							<span x-show="!f.uploading && !f.error" x-text="formatBytes(f.size)" style="color:var(--text-muted); font-size:0.675rem;"></span>
							<span x-show="f.error" style="color:var(--danger); font-size:0.675rem;" x-text="f.error"></span>
							<button type="button" @click="removeAttachment(i)" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-weight:800; padding:0 2px; line-height:1;" title="حذف">✕</button>
						</div>
					</template>
				</div>

				<!-- Voice Recording Active Bar -->
				<div x-show="isRecordingVoice" style="padding:0.4rem 0.5rem; display:flex; align-items:center; justify-content:space-between; gap:0.5rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:20px; margin-bottom:0.4rem;">
					<div style="display:flex; align-items:center; gap:0.45rem; padding-inline-start:0.5rem;">
						<span style="width:8px; height:8px; background:#ef4444; border-radius:50%; animation:pulse 1s infinite;"></span>
						<span style="font-size:0.775rem; font-weight:700; color:var(--text);" x-text="'جاري الاستماع... ' + formatDuration(recordingSeconds)"></span>
					</div>
					<div style="display:flex; gap:0.35rem;">
						<button type="button" @click="cancelVoiceRecord()" class="btn btn-secondary btn-xs" style="height:28px; padding:0 0.6rem;">إلغاء</button>
						<button type="button" @click="finishVoiceRecord()" class="btn btn-primary btn-xs" style="height:28px; padding:0 0.6rem; font-weight:700;">إنهاء</button>
					</div>
				</div>

				<!-- ChatGPT-Style Floating Input Capsule Form -->
				<form x-show="!isRecordingVoice" @submit.prevent="sendMessage()" style="position:relative; margin:0; width:100%;">
					<input type="file" multiple x-ref="fileInput" @change="handleFileSelect($event)" style="display:none;" />
					
					<div class="capsule-input-capsule">
						
						<!-- Attach File Button -->
						<button
							type="button"
							@click="$refs.fileInput.click()"
							class="capsule-tool-btn"
							title="إرفاق ملف أو روشتة"
							:disabled="isStreaming"
						>
							@IconPaperclip("icon-xs")
						</button>

						<!-- Voice Input Button -->
						<button
							type="button"
							@click="startVoiceRecord()"
							class="capsule-tool-btn"
							title="تسجيل صوتي"
							:disabled="isStreaming"
						>
							@IconMicrophone("icon-xs")
						</button>

						<!-- Auto-Expanding Textarea -->
						<textarea
							x-ref="chatTextarea"
							x-model="inputQuery"
							@keydown="handleKeydown($event)"
							@input="autoResizeTextarea()"
							placeholder="اسأل كبسولة عن أي دواء، صنف، أو توريد..."
							rows="1"
							class="capsule-textarea"
							:disabled="isStreaming"
							dir="auto"
						></textarea>

						<!-- Submit Send Button / Stop Button -->
						<template x-if="!isStreaming">
							<button
								type="submit"
								class="capsule-send-btn"
								:class="{ 'active': inputQuery.trim().length > 0 || attachedFiles.length > 0 }"
								:disabled="!inputQuery.trim() && attachedFiles.length === 0"
								title="إرسال (Enter)"
							>
								@IconSend("icon-xs")
							</button>
						</template>

						<template x-if="isStreaming">
							<button
								type="button"
								@click="cancelStream()"
								class="capsule-stop-btn"
								title="إيقاف التوليد"
							>
								@IconClose("icon-xs")
							</button>
						</template>

					</div>
				</form>

			</div>

		</div>

		<!-- Polished Design Styles -->
		<style>
			.capsule-messages-scroll {
				scrollbar-width: thin;
				scrollbar-color: var(--border) transparent;
			}
			.capsule-messages-scroll::-webkit-scrollbar {
				width: 6px;
			}
			.capsule-messages-scroll::-webkit-scrollbar-track {
				background: transparent;
			}
			.capsule-messages-scroll::-webkit-scrollbar-thumb {
				background: var(--border);
				border-radius: 4px;
			}
			.capsule-messages-scroll::-webkit-scrollbar-thumb:hover {
				background: var(--text-muted);
			}
			.capsule-circle-btn:hover {
				transform: translateY(-2px) scale(1.04);
				box-shadow: 0 14px 28px -4px rgba(37, 99, 235, 0.55), 0 6px 14px -2px rgba(2, 132, 199, 0.35) !important;
			}
			.capsule-chip-btn {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				border-radius: var(--radius-full);
				padding: 0.45rem 0.85rem;
				font-size: 0.775rem;
				color: var(--text-secondary);
				text-align: start;
				cursor: pointer;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				transition: all 140ms ease;
			}
			.capsule-chip-btn:hover {
				border-color: var(--accent);
				color: var(--text);
				background: var(--accent-subtle);
			}
			.capsule-input-capsule {
				display: flex;
				align-items: flex-end;
				gap: 0.35rem;
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				border-radius: 22px;
				padding: 0.3rem 0.45rem 0.3rem 0.6rem;
				transition: border-color 150ms, box-shadow 150ms;
			}
			.capsule-input-capsule:focus-within {
				border-color: var(--accent);
				box-shadow: 0 0 0 2px var(--accent-subtle);
			}
			.capsule-tool-btn {
				width: 30px;
				height: 30px;
				flex-shrink: 0;
				border-radius: var(--radius-full);
				border: none;
				background: none;
				color: var(--text-muted);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 120ms;
				margin-bottom: 1px;
			}
			.capsule-tool-btn:hover:not(:disabled) {
				background: rgba(0,0,0,0.06);
				color: var(--text);
			}
			.capsule-textarea {
				flex: 1;
				background: transparent;
				border: none;
				outline: none;
				resize: none;
				padding: 0.35rem 0.25rem;
				font-size: 0.875rem;
				color: var(--text);
				line-height: 1.45;
				max-height: 110px;
				min-height: 24px;
				height: 24px;
				font-family: inherit;
				overflow-y: auto;
				scrollbar-width: none;
				box-sizing: border-box;
			}
			.capsule-send-btn {
				width: 30px;
				height: 30px;
				padding: 0;
				flex-shrink: 0;
				border-radius: var(--radius-full);
				border: none;
				background: var(--surface-raised);
				color: var(--text-muted);
				cursor: not-allowed;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 140ms ease;
				margin-bottom: 1px;
			}
			.capsule-send-btn.active {
				background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
				color: #ffffff;
				cursor: pointer;
				box-shadow: 0 2px 8px rgba(37,99,235,0.35);
			}
			.capsule-stop-btn {
				width: 30px;
				height: 30px;
				padding: 0;
				flex-shrink: 0;
				border-radius: var(--radius-full);
				border: 1px solid #ef4444;
				background: rgba(239, 68, 68, 0.1);
				color: #ef4444;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				margin-bottom: 1px;
			}
			.capsule-cursor {
				display: inline-block;
				color: var(--accent);
				font-weight: 900;
				margin-inline-start: 2px;
				animation: blink 0.8s infinite;
			}
			@keyframes blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}
			.capsule-dot-pulse {
				width: 7px;
				height: 7px;
				background: var(--accent);
				border-radius: 50%;
				animation: pulseDot 1.2s infinite;
			}
			@keyframes pulseDot {
				0%, 100% { transform: scale(0.9); opacity: 0.7; }
				50% { transform: scale(1.3); opacity: 1; }
			}
			.capsule-dot {
				width: 6px;
				height: 6px;
				background: var(--text-muted);
				border-radius: 50%;
				animation: dotBounce 1.2s infinite ease-in-out;
			}
			@keyframes dotBounce {
				0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
				40% { transform: scale(1.1); opacity: 1; }
			}
			.capsule-thinking-row {
				display: flex;
				align-items: center;
				padding: 0.25rem 0;
			}
			.capsule-thinking {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			.capsule-thinking-label {
				font-size: 0.775rem;
				color: var(--text-muted);
				margin-inline-start: 0.35rem;
			}
			.capsule-prose p { margin: 0 0 0.5rem 0; }
			.capsule-prose p:last-child { margin-bottom: 0; }
			.capsule-prose strong { font-weight: 700; color: var(--text); }
			.capsule-inline-code {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				padding: 0.1rem 0.35rem;
				border-radius: 4px;
				font-size: 0.825em;
				font-family: monospace;
				direction: ltr;
				display: inline-block;
			}
			.capsule-code-block {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				padding: 0.65rem 0.85rem;
				border-radius: 8px;
				font-size: 0.8em;
				font-family: monospace;
				direction: ltr;
				text-align: left;
				overflow-x: auto;
				margin: 0.4rem 0;
			}
			.capsule-list-item {
				display: flex;
				align-items: baseline;
				gap: 0.45rem;
				margin: 0.2rem 0;
			}
			.capsule-bullet {
				color: var(--accent);
				font-weight: 800;
			}
			.capsule-h2 { font-size: 1.05rem; font-weight: 800; margin: 0.6rem 0 0.3rem 0; color: var(--text); }
			.capsule-h3 { font-size: 0.95rem; font-weight: 800; margin: 0.5rem 0 0.25rem 0; color: var(--text); }
			.capsule-h4 { font-size: 0.875rem; font-weight: 700; margin: 0.4rem 0 0.2rem 0; color: var(--text); }
			.capsule-mini-copy-btn {
				background: transparent;
				border: 1px solid var(--border);
				border-radius: 6px;
				color: var(--text-muted);
				font-size: 0.7rem;
				cursor: pointer;
				padding: 2px 7px;
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				transition: all 120ms ease;
			}
			.capsule-mini-copy-btn:hover {
				color: var(--text);
				background: var(--surface-sunken);
				border-color: var(--accent);
			}
		</style>

		<!-- Assistant Core Logic -->
		<script>
			function capsuleAssistantManager() {
				return {
					isOpen: false,
					inputQuery: '',
					isStreaming: false,
					statusStage: '',
					statusMessage: '',
					isDragging: false,
					dragCounter: 0,
					isRecordingVoice: false,
					recordingSeconds: 0,
					recordingTimer: null,
					mediaRecorder: null,
					audioChunks: [],
					speechRecognition: null,
					attachedFiles: [],
					messages: [],
					conversationID: 0,
					abortController: null,
					autoScrollEnabled: true,

					init() {
						this.$nextTick(() => {
							const c = document.getElementById('capsule-messages-container');
							if (c) {
								c.addEventListener('scroll', () => {
									const dist = c.scrollHeight - c.scrollTop - c.clientHeight;
									this.autoScrollEnabled = dist < 80;
								});
							}
						});

						const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
						if (SpeechRec) {
							try {
								this.speechRecognition = new SpeechRec();
								this.speechRecognition.lang = 'ar-EG';
								this.speechRecognition.interimResults = false;
								this.speechRecognition.maxAlternatives = 1;
								this.speechRecognition.onresult = (event) => {
									const text = event.results[0][0].transcript;
									if (text) {
										this.inputQuery = (this.inputQuery ? this.inputQuery + ' ' : '') + text;
										this.$nextTick(() => this.autoResizeTextarea());
									}
								};
								this.speechRecognition.onend = () => {
									this.isRecordingVoice = false;
									clearInterval(this.recordingTimer);
									this.recordingSeconds = 0;
								};
								this.speechRecognition.onerror = () => {
									this.isRecordingVoice = false;
									clearInterval(this.recordingTimer);
									this.recordingSeconds = 0;
								};
							} catch (e) {
								this.speechRecognition = null;
							}
						}
					},

					openAssistant() {
						this.isOpen = true;
						this.autoScrollEnabled = true;
						this.scrollToBottom(true);
						this.$nextTick(() => {
							if (this.$refs.chatTextarea) this.$refs.chatTextarea.focus();
						});
					},

					closeAssistant() {
						this.isOpen = false;
						this.isDragging = false;
						this.dragCounter = 0;
					},

					clearChat() {
						if (this.isStreaming) this.cancelStream();
						this.messages = [];
						this.conversationID = 0;
						this.attachedFiles = [];
						this.inputQuery = '';
						if (this.$refs.chatTextarea) this.$refs.chatTextarea.style.height = '24px';
					},

					askChip(text) {
						this.inputQuery = text;
						this.sendMessage();
					},

					copyText(text, btnEl) {
						if (!text) return;
						navigator.clipboard.writeText(text).then(() => {
							const textSpan = btnEl ? btnEl.querySelector('.copy-btn-text') : null;
							if (textSpan) {
								const orig = textSpan.innerText;
								textSpan.innerText = 'تم النسخ!';
								setTimeout(() => { textSpan.innerText = orig; }, 1500);
							}
						});
					},

					onDragEnter(e) {
						if (!this.isOpen) return;
						if (e.dataTransfer && e.dataTransfer.types && e.dataTransfer.types.includes('Files')) {
							this.dragCounter++;
							this.isDragging = true;
						}
					},

					onDragLeave(e) {
						if (!this.isOpen) return;
						this.dragCounter--;
						if (this.dragCounter <= 0) {
							this.dragCounter = 0;
							this.isDragging = false;
						}
					},

					onDrop(e) {
						if (!this.isOpen) return;
						this.dragCounter = 0;
						this.isDragging = false;
						const files = Array.from(e.dataTransfer?.files || []);
						this.addFiles(files);
					},

					handleFileSelect(e) {
						const files = Array.from(e.target.files || []);
						this.addFiles(files);
						e.target.value = '';
					},

					async addFiles(files) {
						for (const file of files) {
							if (this.attachedFiles.length >= 5) break;
							const fileItem = {
								file: file,
								name: file.name,
								size: file.size,
								handle: '',
								uploading: true,
								error: ''
							};
							this.attachedFiles.push(fileItem);
							this.uploadAttachment(fileItem);
						}
					},

					async uploadAttachment(item) {
						try {
							const form = new FormData();
							form.append('file', item.file);
							const resp = await fetch('/api/v1/assistant/attachments', {
								method: 'POST',
								body: form
							});
							if (!resp.ok) {
								const errData = await resp.json().catch(() => ({}));
								item.error = errData.message || 'فشل رفع الملف';
								return;
							}
							const data = await resp.json();
							if (data.attachments && data.attachments.length > 0) {
								item.handle = data.attachments[0].handle;
							}
						} catch (e) {
							item.error = 'خطأ في الاتصال بالخادم';
						} finally {
							item.uploading = false;
						}
					},

					removeAttachment(idx) {
						this.attachedFiles.splice(idx, 1);
					},

					formatBytes(bytes) {
						if (!bytes) return '0 B';
						const k = 1024;
						const sizes = ['B', 'KB', 'MB'];
						const i = Math.floor(Math.log(bytes) / Math.log(k));
						return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
					},

					async startVoiceRecord() {
						this.isRecordingVoice = true;
						this.recordingSeconds = 0;
						this.recordingTimer = setInterval(() => {
							this.recordingSeconds++;
						}, 1000);

						if (this.speechRecognition) {
							try {
								this.speechRecognition.start();
								return;
							} catch (e) {
								// Fallback to MediaRecorder
							}
						}

						try {
							const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
							this.audioChunks = [];
							this.mediaRecorder = new MediaRecorder(stream);
							this.mediaRecorder.ondataavailable = (e) => {
								if (e.data.size > 0) this.audioChunks.push(e.data);
							};
							this.mediaRecorder.start();
						} catch (e) {
							this.cancelVoiceRecord();
							alert('تعذر الوصول إلى الميكروفون: ' + e.message);
						}
					},

					cancelVoiceRecord() {
						this.isRecordingVoice = false;
						clearInterval(this.recordingTimer);
						this.recordingSeconds = 0;
						if (this.speechRecognition) {
							try { this.speechRecognition.stop(); } catch (e) {}
						}
						if (this.mediaRecorder && this.mediaRecorder.state !== 'inactive') {
							this.mediaRecorder.stop();
						}
					},

					async finishVoiceRecord() {
						if (this.speechRecognition) {
							try { this.speechRecognition.stop(); } catch (e) {}
							return;
						}

						if (this.mediaRecorder && this.mediaRecorder.state !== 'inactive') {
							this.mediaRecorder.onstop = async () => {
								const audioBlob = new Blob(this.audioChunks, { type: 'audio/webm' });
								this.audioChunks = [];
								this.statusMessage = 'جاري تفريغ الصوت عبر Whisper...';
								try {
									const form = new FormData();
									form.append('file', audioBlob, 'voice.webm');
									const resp = await fetch('/api/v1/assistant/transcribe', {
										method: 'POST',
										body: form
									});
									if (resp.ok) {
										const data = await resp.json();
										if (data.text) {
											this.inputQuery = (this.inputQuery ? this.inputQuery + ' ' : '') + data.text;
											this.$nextTick(() => this.autoResizeTextarea());
										}
									}
								} catch (e) {
									console.warn('transcription failed', e);
								} finally {
									this.statusMessage = '';
								}
							};
							this.mediaRecorder.stop();
						}

						this.isRecordingVoice = false;
						clearInterval(this.recordingTimer);
						this.recordingSeconds = 0;
					},

					formatDuration(secs) {
						const m = Math.floor(secs / 60);
						const s = secs % 60;
						return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
					},

					handleKeydown(e) {
						if (e.key === 'Enter') {
							if (e.shiftKey) {
								this.$nextTick(() => this.autoResizeTextarea());
							} else {
								e.preventDefault();
								this.sendMessage();
							}
						}
					},

					autoResizeTextarea() {
						const el = this.$refs.chatTextarea;
						if (!el) return;
						el.style.height = '24px';
						const newHeight = Math.min(Math.max(el.scrollHeight, 24), 110);
						el.style.height = newHeight + 'px';
					},

					async sendMessage() {
						const q = this.inputQuery.trim();
						if (this.isStreaming || (!q && this.attachedFiles.length === 0)) return;

						// Check if any file is still uploading
						const stillUploading = this.attachedFiles.some(f => f.uploading);
						if (stillUploading) {
							this.statusMessage = 'يرجى الانتظار حتى اكتمال رفع المرفقات...';
							return;
						}

						const handles = this.attachedFiles.filter(f => f.handle && !f.error).map(f => f.handle);
						const sentAttachments = [...this.attachedFiles];

						this.messages.push({
							text: q || (sentAttachments.length > 0 ? 'مرفق: ' + sentAttachments.map(f => f.name).join(', ') : ''),
							isUser: true,
							attachments: sentAttachments
						});

						this.messages.push({
							text: '',
							reasoning: '',
							isUser: false,
							isStreaming: true
						});
						const assistantMsg = this.messages[this.messages.length - 1];

						this.inputQuery = '';
						this.attachedFiles = [];
						if (this.$refs.chatTextarea) {
							this.$refs.chatTextarea.style.height = '24px';
						}
						this.isStreaming = true;
						this.statusStage = '';
						this.statusMessage = '';
						this.autoScrollEnabled = true;
						this.scrollToBottom(true);

						this.abortController = new AbortController();

						try {
							const resp = await fetch('/api/v1/assistant/messages', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									text: q,
									conversation_id: this.conversationID,
									attachment_handles: handles
								}),
								signal: this.abortController.signal
							});

							if (!resp.ok) {
								const errData = await resp.json().catch(() => ({}));
								assistantMsg.text = errData.message || 'تعذر الاتصال بالمساعد الذكي.';
								assistantMsg.isStreaming = false;
								this.isStreaming = false;
								return;
							}

							const reader = resp.body.getReader();
							const decoder = new TextDecoder('utf-8');
							let buffer = '';

							while (true) {
								const { done, value } = await reader.read();
								if (done) break;

								buffer += decoder.decode(value, { stream: true });
								const lines = buffer.split('\n');
								buffer = lines.pop() || '';

								let currentEvent = 'message';
								for (const line of lines) {
									const trimmed = line.trim();
									if (trimmed.startsWith('event:')) {
										currentEvent = trimmed.substring(6).trim();
									} else if (trimmed.startsWith('data:')) {
										const dataStr = trimmed.substring(5).trim();
										if (!dataStr) continue;

										try {
											const data = JSON.parse(dataStr);
											if (currentEvent === 'delta' && data.text) {
												this.statusStage = '';
												assistantMsg.text += data.text;
												this.scrollToBottom();
											} else if (currentEvent === 'reasoning' && data.text) {
												assistantMsg.reasoning += data.text;
												this.scrollToBottom();
											} else if (currentEvent === 'status') {
												this.statusStage = data.stage || '';
												this.statusMessage = data.message || (data.stage === 'analyzing_attachment' ? 'جاري تحليل المرفق (' + data.file + ')...' : '');
												this.scrollToBottom();
											} else if (currentEvent === 'done') {
												if (data.conversation_id) {
													this.conversationID = data.conversation_id;
												}
												assistantMsg.isStreaming = false;
											} else if (currentEvent === 'error') {
												assistantMsg.text += '\n\n[خطأ: ' + (data.message || 'حدث خطأ غير متوقع') + ']';
												assistantMsg.isStreaming = false;
											}
										} catch (parseErr) {
											// Non-JSON frame ignore
										}
									}
								}
							}
						} catch (e) {
							if (e.name !== 'AbortError') {
								assistantMsg.text += '\n\n[انقطع الاتصال بالخادم: ' + e.message + ']';
							}
						} finally {
							assistantMsg.isStreaming = false;
							this.isStreaming = false;
							this.statusStage = '';
							this.statusMessage = '';
							this.abortController = null;
							this.scrollToBottom();
						}
					},

					cancelStream() {
						if (this.abortController) {
							this.abortController.abort();
							this.abortController = null;
						}
						this.isStreaming = false;
						this.statusStage = '';
						this.statusMessage = '';
					},

					renderMarkdown(raw) {
						if (!raw) return '';
						let text = raw
							.replace(/&/g, '&amp;')
							.replace(/</g, '&lt;')
							.replace(/>/g, '&gt;');

						// Code blocks
						text = text.replace(/```([\s\S]*?)```/g, (match, p1) => {
							return `<pre class="capsule-code-block"><code>${p1.trim()}</code></pre>`;
						});

						// Inline code
						text = text.replace(/`([^`]+)`/g, '<code class="capsule-inline-code">$1</code>');

						// Bold
						text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

						// Italic
						text = text.replace(/\*([^*]+)\*/g, '<em>$1</em>');

						// Headings
						text = text.replace(/^### (.*$)/gim, '<h4 class="capsule-h4">$1</h4>');
						text = text.replace(/^## (.*$)/gim, '<h3 class="capsule-h3">$1</h3>');
						text = text.replace(/^# (.*$)/gim, '<h2 class="capsule-h2">$1</h2>');

						// List items (bullet points)
						text = text.replace(/^[-*•]\s+(.*$)/gim, '<div class="capsule-list-item"><span class="capsule-bullet">•</span><span>$1</span></div>');

						// Double newlines to spacing
						text = text.replace(/\n\n/g, '<div style="height:0.5rem;"></div>');
						// Single newline
						text = text.replace(/\n/g, '<br/>');

						return text;
					},

					scrollToBottom(force = false) {
						this.$nextTick(() => {
							const container = document.getElementById('capsule-messages-container');
							if (container && (this.autoScrollEnabled || force)) {
								container.scrollTop = container.scrollHeight;
							}
						});
					}
				};
			}
		</script>
	</div>
}
