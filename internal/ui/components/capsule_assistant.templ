package components

templ CapsuleAssistantTrigger() {
	<div
		id="capsule-assistant-host"
		x-data="capsuleAssistantHost()"
		class="capsule-assistant-host"
		style="position:fixed; bottom:24px; left:24px !important; right:auto !important; z-index:9990; font-family:var(--font-sans); direction:rtl;"
	>
		<!-- Floating Trigger: Polished Circular Button (Hidden when Window is Open) -->
		<button
			type="button"
			x-show="!isOpen"
			@click="triggerClick()"
			class="capsule-circle-btn"
			style="position:relative; width:54px; height:54px; border-radius:50%; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%); color:#ffffff; border:1px solid rgba(255, 255, 255, 0.35); box-shadow:0 10px 24px -4px rgba(37, 99, 235, 0.45), 0 4px 12px -2px rgba(2, 132, 199, 0.3); cursor:pointer; display:flex; align-items:center; justify-content:center; outline:none;"
			title="المستشار الصيدلي كبسولة"
		>
			<div class="flex-center">
				@IconSparkles("icon-md")
			</div>
			<!-- Online Pulse Indicator -->
			<span style="position:absolute; top:2px; right:2px; width:11px; height:11px; background:#10b981; border-radius:50%; border:2px solid #ffffff; box-shadow:0 0 6px rgba(16, 185, 129, 0.8);"></span>
		</button>
		<div id="capsule-panel-slot"></div>
		<script>
			function capsuleAssistantHost() {
				return {
					isOpen: false,
					loaded: false,
					triggerClick() {
						if (!this.loaded) {
							this.loaded = true;
							htmx.ajax('GET', '/components/capsule-assistant', {
								target: '#capsule-panel-slot',
								swap: 'innerHTML'
							});
						} else {
							window.dispatchEvent(new CustomEvent('open-capsule-assistant'));
						}
						this.isOpen = true;
					}
				};
			}
		</script>
	</div>
}

templ CapsuleAssistant() {
	@CapsuleAssistantTrigger()
}

templ CapsuleAssistantPanel() {
	<div
		x-data="capsuleAssistantManager()"
		x-init="init()"
		x-cloak
	>
		<!-- ChatGPT-Style Chat Window -->
		<div
			x-show="isOpen"
			x-cloak
			x-transition:enter="transition ease-out duration-250"
			x-transition:enter-start="opacity-0 transform translate-y-6 scale-95"
			x-transition:enter-end="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 transform translate-y-6 scale-95"
			@dragenter.prevent="onDragEnter($event)"
			@dragover.prevent=""
			@dragleave.prevent="onDragLeave($event)"
			@drop.prevent="onDrop($event)"
			class="capsule-drawer"
		>
			<!-- Drag & Drop Overlay Zone -->
			<div
				x-show="isDragging"
				x-cloak
				x-transition:enter="transition ease-out duration-150"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-100"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				style="position:absolute; inset:10px; border-radius:18px; z-index:9999; background:rgba(2, 132, 199, 0.96); backdrop-filter:blur(12px); border:2px dashed rgba(255,255,255,0.85); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:0.75rem; color:#ffffff; box-shadow:0 16px 36px rgba(0,0,0,0.3); pointer-events:none;"
			>
				<div style="width:54px; height:54px; border-radius:50%; background:rgba(255,255,255,0.22); display:flex; align-items:center; justify-content:center; margin:0 auto; flex-shrink:0; border:1px solid rgba(255,255,255,0.35);">
					@IconUpload("icon-md")
				</div>
				<div>
					<div style="font-weight:800; font-size:0.95rem; margin:0 0 0.2rem 0;">أفلت الملفات هنا للإرفاق</div>
					<div style="font-size:0.725rem; opacity:0.92; margin:0;">يدعم الصور، الروشتات، وملفات PDF الدوائية</div>
				</div>
			</div>

			<!-- Sleek Minimal Header -->
			<div style="padding:0.75rem 1.15rem; background:var(--surface-raised); border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-shrink:0; height:56px; box-sizing:border-box;">
				<div style="display:flex; align-items:center; gap:0.65rem;">
					<div style="width:32px; height:32px; border-radius:10px; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%); color:#ffffff; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(37,99,235,0.3);">
						@IconSparkles("icon-xs")
					</div>
					<div>
						<div style="font-weight:800; font-size:0.825rem; margin:0; display:flex; align-items:center; gap:0.35rem; color:var(--text);">
							<span>كبسولة</span>
							<span style="width:6px; height:6px; background:#10b981; border-radius:50%; display:inline-block; box-shadow:0 0 4px #10b981;"></span>
						</div>
						<div style="font-size:0.65rem; color:var(--text-muted); line-height:1;">المستشار الصيدلي المعتمد</div>
					</div>
				</div>

				<!-- Header Action Buttons (Icon-Only, Clean & Minimalist) -->
				<div style="display:flex; align-items:center; gap:0.25rem;">
					<!-- New Chat Button -->
					<button
						type="button"
						@click="startNewConversation()"
						class="capsule-hdr-icon-btn"
						title="محادثة جديدة"
					>
						@IconPlus("icon-xs")
					</button>

					<!-- History / Sessions Button -->
					<button
						type="button"
						@click="toggleSessionsDrawer()"
						class="capsule-hdr-icon-btn"
						:class="{ 'active': showSessionsDrawer }"
						title="سجل المحادثات"
					>
						@IconClock("icon-xs")
					</button>

					<!-- Close Button -->
					<button
						type="button"
						@click="closeAssistant()"
						class="capsule-hdr-icon-btn"
						title="إغلاق النافذة"
					>
						@IconClose("icon-xs")
					</button>
				</div>
			</div>

			<!-- Sessions Drawer Overlay (Full Height Slide-over) -->
			<div
				x-show="showSessionsDrawer"
				x-cloak
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 -translate-y-2"
				x-transition:enter-end="opacity-100 translate-y-0"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100 translate-y-0"
				x-transition:leave-end="opacity-0 -translate-y-2"
				class="capsule-sessions-overlay"
			>
				<!-- Drawer Top Bar -->
				<div style="padding:0.75rem 1rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; background:var(--surface-raised);">
					<div style="display:flex; align-items:center; gap:0.4rem; font-weight:800; font-size:0.875rem; color:var(--text);">
						@IconClock("icon-xs")
						<span>المحادثات السابقة</span>
					</div>
					<button
						type="button"
						@click="showSessionsDrawer = false"
						class="capsule-hdr-icon-btn"
						title="إغلاق السجل"
					>
						@IconClose("icon-xs")
					</button>
				</div>

				<!-- Start New Chat Action in Drawer -->
				<div style="padding:0.75rem 1rem 0.5rem 1rem; display:flex; flex-direction:column; gap:0.5rem;">
					<button
						type="button"
						@click="startNewConversation()"
						style="width:100%; background:linear-gradient(135deg, #0284c7 0%, #2563eb 100%); color:#ffffff; border:none; border-radius:var(--radius-md); padding:0.55rem 0.85rem; font-size:0.8rem; font-weight:800; display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer; box-shadow:0 2px 6px rgba(37,99,235,0.25);"
					>
						@IconPlus("icon-xs")
						<span>بدء محادثة جديدة الآن</span>
					</button>

					<!-- Search Filter -->
					<div style="position:relative; width:100%;">
						<input
							type="text"
							x-model="searchPastQuery"
							placeholder="بحث في المحادثات..."
							style="width:100%; background:var(--surface-sunken); border:1px solid var(--border); border-radius:var(--radius-md); padding:0.4rem 2rem 0.4rem 0.75rem; font-size:0.775rem; color:var(--text); outline:none; box-sizing:border-box;"
						/>
						<div style="position:absolute; right:8px; top:50%; transform:translateY(-50%); color:var(--text-muted); pointer-events:none; display:flex; align-items:center;">
							@IconSearch("icon-xxs")
						</div>
					</div>
				</div>

				<!-- Sessions List Scrollable Container -->
				<div style="flex:1 1 0%; min-height:0; overflow-y:auto; padding:0.5rem 1rem 1rem 1rem; display:flex; flex-direction:column; gap:0.5rem;">
					<!-- Loading State -->
					<template x-if="isLoadingPastSessions">
						<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:2rem 0; gap:0.5rem; color:var(--text-muted); font-size:0.8rem;">
							<div class="capsule-spinner" style="width:20px; height:20px; border-color:var(--accent); border-top-color:transparent;"></div>
							<span>جاري جلب المحادثات السابقة...</span>
						</div>
					</template>

					<!-- Empty State -->
					<template x-if="!isLoadingPastSessions && filteredPastConversations().length === 0">
						<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:2rem 0; text-align:center; color:var(--text-muted); gap:0.4rem;">
							<div style="width:36px; height:36px; border-radius:50%; background:var(--surface-sunken); display:flex; align-items:center; justify-content:center; color:var(--text-muted);">
								@IconClock("icon-sm")
							</div>
							<div style="font-size:0.825rem; font-weight:700; color:var(--text);">لا توجد محادثات سابقة</div>
							<div style="font-size:0.725rem;">أي استفسار تطرحه يتم حفظه هنا تلقائياً لترجع له في أي وقت.</div>
						</div>
					</template>

					<!-- Conversations Items -->
					<template x-for="conv in filteredPastConversations()" :key="conv.id">
						<div
							class="capsule-session-card"
							:class="{ 'active': conversationID === conv.id }"
							@click="loadSession(conv.id)"
						>
							<div style="flex:1; min-width:0;">
								<div style="display:flex; align-items:center; gap:0.35rem; margin-bottom:0.15rem;">
									<span style="font-size:0.8rem; font-weight:700; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" x-text="conv.title || 'محادثة سابقة'"></span>
									<template x-if="conversationID === conv.id">
										<span style="font-size:0.65rem; background:var(--accent); color:#fff; padding:0.1rem 0.35rem; border-radius:4px; font-weight:700;">نشطة</span>
									</template>
								</div>
								<div style="font-size:0.68rem; color:var(--text-muted);" x-text="formatDate(conv.updated_at)"></div>
							</div>
							<button
								type="button"
								@click.stop="deleteSession(conv.id)"
								class="capsule-icon-delete-btn"
								title="حذف المحادثة"
							>
								@IconTrash("icon-xxs")
							</button>
						</div>
					</template>
				</div>
			</div>

			<!-- Messages Scroll Area (Canvas Style - Direct Text on Background) -->
			<div
				id="capsule-messages-container"
				class="capsule-messages-scroll"
				style="flex:1 1 0%; min-height:0; overflow-y:auto; overflow-x:hidden; padding:1rem; display:flex; flex-direction:column; gap:1rem; background:var(--surface-raised); overscroll-behavior:contain; -webkit-overflow-scrolling:touch;"
			>
				<!-- Empty State / Clean Start Session with Quick Prompts -->
				<div x-show="messages.length === 0" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:1.5rem 1rem 1rem 1rem; gap:0.65rem; margin:auto; width:100%; box-sizing:border-box;">
					<div style="width:48px; height:48px; border-radius:14px; background:var(--accent-subtle); color:var(--accent); display:flex; align-items:center; justify-content:center; border:1px solid rgba(2, 132, 199, 0.2); margin:0 auto; flex-shrink:0;">
						@IconSparkles("icon-md")
					</div>
					<div style="display:flex; flex-direction:column; align-items:center; text-align:center; width:100%;">
						<h4 style="margin:0 0 0.35rem 0; font-size:0.95rem; font-weight:800; color:var(--text); text-align:center;">المستشار الصيدلي الذكي</h4>
						<p style="margin:0 auto; font-size:0.775rem; color:var(--text-muted); line-height:1.5; max-width:290px; text-align:center;">
							اطرح استفسارك، قارن عروض الموردين، أو أرفق صورة روشتة أو دواء لفحصها ومطابقتها فورياً.
						</p>
					</div>

					<!-- Interactive Quick Prompts -->
					<div style="display:flex; flex-direction:column; gap:0.4rem; width:100%; max-width:320px; margin-top:0.4rem;">
						<button
							type="button"
							class="capsule-chip-btn"
							@click="askChip('ما هي أفضل بدائل التوفير المتاحة لأشهر أدوية الضغط والسكر؟')"
						>
							<span style="font-size:0.85rem;">@IconPill("icon-sm")</span>
							<span>اقتراح بدائل التوفير للأدوية المزمنة</span>
						</button>
						<button
							type="button"
							class="capsule-chip-btn"
							@click="askChip('كيف أقوم بمقارنة خصومات الموردين على طلبيات النواقص؟')"
						>
							<span style="font-size:0.85rem;">@IconBarChart("icon-sm")</span>
							<span>مقارنة خصومات الموردين وسرعة الشحن</span>
						</button>
						<button
							type="button"
							class="capsule-chip-btn"
							@click="askChip('فحص التداخلات الدوائية والجرعات المصرح بها')"
						>
							<span style="font-size:0.85rem;">@IconSearch("icon-sm")</span>
							<span>فحص التداخلات الدوائية والجرعات</span>
						</button>
					</div>
				</div>

				<!-- Message Stream -->
				<template x-for="(msg, idx) in messages" :key="idx">
					<div>
						<!-- User Message (Subtle Right-Aligned Pill) -->
						<template x-if="msg.isUser">
							<div style="display:flex; justify-content:flex-start; margin-bottom:0.25rem;">
								<div style="max-width:85%; display:flex; flex-direction:column; align-items:flex-start; gap:0.35rem;">
									<!-- Attached Files Badges / Image Previews -->
									<template x-if="msg.attachments && msg.attachments.length > 0">
										<div style="display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:0.25rem;">
											<template x-for="file in msg.attachments" :key="file.name || file.filename">
												<div>
													<template x-if="file.isImage && file.previewUrl">
														<img :src="file.previewUrl" style="width:68px; height:68px; border-radius:10px; object-fit:cover; border:1px solid var(--border); cursor:pointer;" @click="window.open(file.previewUrl, '_blank')" alt="صورة مرفقة" />
													</template>
													<template x-if="!file.isImage || !file.previewUrl">
														<div style="display:inline-flex; align-items:center; gap:0.35rem; background:var(--surface-sunken); border:1px solid var(--border); padding:0.25rem 0.55rem; border-radius:8px; font-size:0.7rem; color:var(--text-secondary);">
															<div style="width:14px; height:14px; display:inline-flex; align-items:center; justify-content:center;">
																@IconPaperclip("icon-xxs")
															</div>
															<span x-text="file.name || file.filename" style="max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
														</div>
													</template>
												</div>
											</template>
										</div>
									</template>
									<!-- User Text Bubble -->
									<div
										dir="auto"
										style="background:var(--surface-sunken); border:1px solid var(--border); color:var(--text); border-radius:18px 18px 4px 18px; padding:0.65rem 1rem; font-size:0.8125rem; line-height:1.55; word-break:break-word;"
										x-text="msg.text"
									></div>
								</div>
							</div>
						</template>

						<!-- Assistant Message (ChatGPT Style - Direct on Canvas) -->
						<template x-if="!msg.isUser">
							<div style="display:flex; flex-direction:column; gap:0.45rem; animation:fadeIn 150ms ease;">
								
								<!-- Collapsible Reasoning Block (Thinking...) -->
								<template x-if="msg.reasoning">
									<div x-data="{ open: false }" style="margin:0.2rem 0; border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--surface-sunken);">
										<button
											type="button"
											@click="open = !open"
											style="width:100%; padding:0.4rem 0.65rem; background:none; border:none; display:flex; justify-content:space-between; align-items:center; cursor:pointer; font-size:0.7rem; color:var(--text-secondary);"
										>
											<span style="display:flex; align-items:center; gap:0.35rem; font-weight:600;">
												@IconSparkles("icon-xxs")
												<span>التحليل الصيدلي للاستفسار</span>
											</span>
											<span x-text="open ? '▲ إخفاء' : '▼ إظهار'" style="font-size:0.65rem; color:var(--text-muted);"></span>
										</button>
										<div x-show="open" style="padding:0.5rem 0.65rem; font-size:0.7rem; color:var(--text-muted); border-top:1px solid var(--border); white-space:pre-wrap; line-height:1.45;" x-text="msg.reasoning"></div>
									</div>
								</template>

								<!-- Assistant Response Body (Markdown Rendered with Auto Direction) -->
								<div
									dir="auto"
									class="capsule-prose"
									style="font-size:0.8125rem; line-height:1.65; color:var(--text); word-break:break-word;"
								>
									<span x-html="renderMarkdown(msg.text)"></span>
									<!-- Glowing Streaming Cursor -->
									<span x-show="msg.isStreaming" class="capsule-cursor">▊</span>
								</div>

								<!-- Minimalist Icon-Only Copy Button with Feedback State -->
								<div x-show="!msg.isStreaming && msg.text" style="display:flex; align-items:center; gap:0.5rem; margin-top:0.2rem;">
									<button
										type="button"
										@click="copyText(msg.text, $el)"
										class="capsule-icon-copy-btn"
										title="نسخ الإجابة"
									>
										<span class="copy-icon-default">
											@IconCopy("icon-xs")
										</span>
										<span class="copy-icon-success" style="display:none; color:#10b981;">
											@IconCheck("icon-xs")
										</span>
									</button>
								</div>

							</div>
						</template>
					</div>
				</template>

				<!-- Thinking Indicator: Single Breathing Glowing Avatar Icon -->
				<div x-show="isStreaming && messages.length > 0 && !messages[messages.length-1].text" class="capsule-thinking-row">
					<div class="capsule-thinking">
						<div class="capsule-breathing-icon">
							@IconSparkles("icon-xs")
						</div>
						<span class="capsule-thinking-label" x-text="statusMessage || 'جاري البحث والتحليل الصيدلي...' "></span>
					</div>
				</div>

			</div>

			<!-- Pinned Bottom Controls (ChatGPT-Style Docked Prompt Capsule) -->
			<div style="flex-shrink:0; background:var(--surface-raised); border-top:1px solid var(--border); padding:0.65rem 0.85rem; box-sizing:border-box; width:100%; position:relative; z-index:10; margin-top:auto;">
				
				<!-- Attached Files Preview Strip (Clean Square Thumbnails) -->
				<div x-show="attachedFiles.length > 0" style="margin-bottom:0.45rem; display:flex; gap:0.45rem; overflow-x:auto; padding:0.2rem 0; align-items:center;">
					<template x-for="(f, i) in attachedFiles" :key="i">
						<div class="capsule-attachment-thumb">
							<!-- Image Preview Thumbnail -->
							<template x-if="f.isImage && f.previewUrl">
								<img :src="f.previewUrl" class="capsule-thumb-img" alt="مرفق" />
							</template>
							<!-- Non-Image Document Thumbnail -->
							<template x-if="!f.isImage || !f.previewUrl">
								<div class="capsule-thumb-doc">
									<div style="width:16px; height:16px; display:flex; align-items:center; justify-content:center;">
										@IconPaperclip("icon-xxs")
									</div>
									<span style="font-size:0.625rem; font-weight:800; text-transform:uppercase; margin-top:2px;" x-text="(f.name.split('.').pop() || 'ملف').substring(0,4)"></span>
								</div>
							</template>
							
							<!-- Uploading Spinner Overlay -->
							<div x-show="f.uploading && !f.error" class="capsule-thumb-overlay">
								<span class="capsule-spinner"></span>
							</div>
							<!-- Error Overlay -->
							<div x-show="f.error" class="capsule-thumb-overlay" style="background:rgba(239, 68, 68, 0.35);" :title="f.error">
								<span style="color:#ffffff; font-weight:900; font-size:12px;">!</span>
							</div>
							<!-- Delete Button -->
							<button type="button" @click="removeAttachment(i)" class="capsule-thumb-delete" title="حذف">
								@IconX("icon-sm")
							</button>
						</div>
					</template>
				</div>

				<!-- Voice Recording Active Bar -->
				<div x-show="isRecordingVoice" style="padding:0.4rem 0.5rem; display:flex; align-items:center; justify-content:space-between; gap:0.5rem; background:var(--surface-sunken); border:1px solid var(--border); border-radius:20px; margin-bottom:0.4rem;">
					<div style="display:flex; align-items:center; gap:0.45rem; padding-inline-start:0.5rem;">
						<span style="width:8px; height:8px; background:#ef4444; border-radius:50%; animation:pulse 1s infinite;"></span>
						<span style="font-size:0.725rem; font-weight:700; color:var(--text);" x-text="'جاري الاستماع... ' + formatDuration(recordingSeconds)"></span>
					</div>
					<div style="display:flex; gap:0.35rem;">
						<button type="button" @click="cancelVoiceRecord()" class="btn btn-secondary btn-xs" style="height:28px; padding:0 0.6rem;">إلغاء</button>
						<button type="button" @click="finishVoiceRecord()" class="btn btn-primary btn-xs" style="height:28px; padding:0 0.6rem; font-weight:700;">إنهاء</button>
					</div>
				</div>

				<!-- ChatGPT-Style Floating Input Capsule Form -->
				<form x-show="!isRecordingVoice" @submit.prevent="sendMessage()" style="position:relative; margin:0; width:100%;">
					<input type="file" multiple x-ref="fileInput" @change="handleFileSelect($event)" style="display:none;" />
					
					<div class="capsule-input-capsule">
						
						<!-- Attach File Button -->
						<button
							type="button"
							@click="$refs.fileInput.click()"
							class="capsule-tool-btn"
							title="إرفاق ملف أو روشتة"
							:disabled="isStreaming"
						>
							@IconPaperclip("icon-xs")
						</button>

						<!-- Voice Input Button -->
						<button
							type="button"
							@click="startVoiceRecord()"
							class="capsule-tool-btn"
							title="تسجيل صوتي"
							:disabled="isStreaming"
						>
							@IconMicrophone("icon-xs")
						</button>

						<!-- Auto-Expanding Textarea -->
						<textarea
							x-ref="chatTextarea"
							x-model="inputQuery"
							@keydown="handleKeydown($event)"
							@input="autoResizeTextarea()"
							placeholder="اسأل كبسولة عن أي دواء، صنف، أو توريد..."
							rows="1"
							class="capsule-textarea"
							:disabled="isStreaming"
							dir="auto"
						></textarea>

						<!-- Submit Send Button / Stop Button -->
						<template x-if="!isStreaming">
							<button
								type="submit"
								class="capsule-send-btn"
								:class="{ 'active': inputQuery.trim().length > 0 || attachedFiles.length }"
								:disabled="!inputQuery.trim() && attachedFiles.length === 0"
								title="إرسال (Enter)"
							>
								@IconSend("icon-xs")
							</button>
						</template>

						<template x-if="isStreaming">
							<button
								type="button"
								@click="cancelStream()"
								class="capsule-stop-btn"
								title="إيقاف التوليد"
							>
								@IconClose("icon-xs")
							</button>
						</template>

					</div>
				</form>

			</div>

		</div>

		<!-- Polished Design Styles -->
		<style>
			/* The drawer's size lives here, not in a style attribute: an inline
			   style cannot be overridden by a media query, which is why the
			   assistant had no small-screen behaviour and ran past the bottom of
			   short viewports with the composer out of reach. */
			.capsule-drawer {
				position: fixed;
				bottom: 24px;
				left: 24px !important;
				right: auto !important;
				width: 440px;
				max-width: calc(100vw - 32px);
				/* One source of truth for the height. dvh tracks the VISIBLE
				   viewport, so mobile browser chrome cannot push the composer
				   underneath the address bar. */
				height: min(620px, calc(100dvh - 48px));
				background: var(--surface-raised);
				border: 1px solid var(--border);
				border-radius: 22px;
				box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08);
				display: flex;
				flex-direction: column;
				overflow: hidden;
				z-index: 9995;
			}

			@media (max-width: 1024px) {
				.capsule-drawer { width: 390px; }
			}

			/* Phone: a full-screen sheet. A 440px floating card on a 400px screen
			   leaves no room for the answer or the composer. */
			@media (max-width: 640px) {
				.capsule-drawer {
					inset: 0;
					width: 100%;
					max-width: 100%;
					height: 100dvh;
					border-radius: 0;
					border: none;
				}
			}

			.capsule-messages-scroll {
				scrollbar-width: thin;
				scrollbar-color: var(--border) transparent;
			}
			.capsule-messages-scroll::-webkit-scrollbar {
				width: 6px;
			}
			.capsule-messages-scroll::-webkit-scrollbar-track {
				background: transparent;
			}
			.capsule-messages-scroll::-webkit-scrollbar-thumb {
				background: var(--border);
				border-radius: 4px;
			}
			.capsule-messages-scroll::-webkit-scrollbar-thumb:hover {
				background: var(--text-muted);
			}
			.capsule-circle-btn:hover {
				transform: translateY(-2px) scale(1.04);
				box-shadow: 0 14px 28px -4px rgba(37, 99, 235, 0.55), 0 6px 14px -2px rgba(2, 132, 199, 0.35) !important;
			}
			.capsule-chip-btn {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				border-radius: var(--radius-full);
				padding: 0.45rem 0.85rem;
				font-size: 0.775rem;
				color: var(--text-secondary);
				text-align: start;
				cursor: pointer;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				transition: all 140ms ease;
			}
			.capsule-chip-btn:hover {
				border-color: var(--accent);
				color: var(--text);
				background: var(--accent-subtle);
			}
			.capsule-input-capsule {
				display: flex;
				align-items: flex-end;
				gap: 0.35rem;
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				border-radius: 22px;
				padding: 0.3rem 0.45rem 0.3rem 0.6rem;
				transition: border-color 150ms, box-shadow 150ms;
			}
			.capsule-input-capsule:focus-within {
				border-color: var(--accent);
				box-shadow: 0 0 0 2px var(--accent-subtle);
			}
			.capsule-tool-btn {
				width: 30px;
				height: 30px;
				flex-shrink: 0;
				border-radius: var(--radius-full);
				border: none;
				background: none;
				color: var(--text-muted);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 120ms;
				margin-bottom: 1px;
			}
			.capsule-tool-btn:hover:not(:disabled) {
				background: rgba(0,0,0,0.06);
				color: var(--text);
			}
			.capsule-textarea {
				flex: 1;
				background: transparent;
				border: none;
				outline: none;
				resize: none;
				padding: 0.35rem 0.25rem;
				font-size: 0.875rem;
				color: var(--text);
				line-height: 1.45;
				max-height: 110px;
				min-height: 24px;
				height: 24px;
				font-family: inherit;
				overflow-y: auto;
				scrollbar-width: none;
				box-sizing: border-box;
			}
			.capsule-send-btn {
				width: 30px;
				height: 30px;
				padding: 0;
				flex-shrink: 0;
				border-radius: var(--radius-full);
				border: none;
				background: var(--surface-raised);
				color: var(--text-muted);
				cursor: not-allowed;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 140ms ease;
				margin-bottom: 1px;
			}
			.capsule-send-btn.active {
				background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
				color: #ffffff;
				cursor: pointer;
				box-shadow: 0 2px 8px rgba(37,99,235,0.35);
			}
			.capsule-stop-btn {
				width: 30px;
				height: 30px;
				padding: 0;
				flex-shrink: 0;
				border-radius: var(--radius-full);
				border: 1px solid #ef4444;
				background: rgba(239, 68, 68, 0.1);
				color: #ef4444;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				margin-bottom: 1px;
			}
			.capsule-cursor {
				display: inline-block;
				color: var(--accent);
				font-weight: 900;
				margin-inline-start: 2px;
				animation: blink 0.8s infinite;
			}
			@keyframes blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}
			.capsule-dot-pulse {
				width: 7px;
				height: 7px;
				background: var(--accent);
				border-radius: 50%;
				animation: pulseDot 1.2s infinite;
			}
			@keyframes pulseDot {
				0%, 100% { transform: scale(0.9); opacity: 0.7; }
				50% { transform: scale(1.3); opacity: 1; }
			}
			.capsule-dot {
				width: 6px;
				height: 6px;
				background: var(--text-muted);
				border-radius: 50%;
				animation: dotBounce 1.2s infinite ease-in-out;
			}
			@keyframes dotBounce {
				0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
				40% { transform: scale(1.1); opacity: 1; }
			}
			.capsule-thinking-row {
				display: flex;
				align-items: center;
				padding: 0.25rem 0;
			}
			.capsule-thinking {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			.capsule-thinking-label {
				font-size: 0.775rem;
				color: var(--text-muted);
				margin-inline-start: 0.35rem;
			}
			.capsule-prose p { margin: 0 0 0.5rem 0; }
			.capsule-prose p:last-child { margin-bottom: 0; }
			.capsule-prose strong { font-weight: 700; color: var(--text); }
			.capsule-inline-code {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				padding: 0.1rem 0.35rem;
				border-radius: 4px;
				font-size: 0.825em;
				font-family: monospace;
				direction: ltr;
				display: inline-block;
			}
			.capsule-code-block {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				padding: 0.65rem 0.85rem;
				border-radius: 8px;
				font-size: 0.8em;
				font-family: monospace;
				direction: ltr;
				text-align: left;
				overflow-x: auto;
				margin: 0.4rem 0;
			}
			.capsule-list-item {
				display: flex;
				align-items: baseline;
				gap: 0.45rem;
				margin: 0.2rem 0;
			}
			.capsule-bullet {
				color: var(--accent);
				font-weight: 800;
			}
			.capsule-h2 { font-size: 1.05rem; font-weight: 800; margin: 0.6rem 0 0.3rem 0; color: var(--text); }
			.capsule-h3 { font-size: 0.95rem; font-weight: 800; margin: 0.5rem 0 0.25rem 0; color: var(--text); }
			.capsule-h4 { font-size: 0.875rem; font-weight: 700; margin: 0.4rem 0 0.2rem 0; color: var(--text); }

			/* Sleek Icon-Only Copy Button */
			.capsule-icon-copy-btn {
				background: transparent;
				border: 1px solid transparent;
				border-radius: 6px;
				color: var(--text-muted);
				padding: 4px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: all 150ms ease;
			}
			.capsule-icon-copy-btn:hover {
				background: var(--surface-sunken);
				border-color: var(--border);
				color: var(--text);
			}

			/* Single Breathing Glow Icon for Thinking */
			.capsule-breathing-icon {
				width: 22px;
				height: 22px;
				border-radius: 7px;
				background: linear-gradient(135deg, #0284c7, #2563eb);
				color: #ffffff;
				display: flex;
				align-items: center;
				justify-content: center;
				animation: capsuleBreathe 1.5s infinite ease-in-out;
				flex-shrink: 0;
			}
			@keyframes capsuleBreathe {
				0%, 100% {
					transform: scale(0.94);
					opacity: 0.75;
					box-shadow: 0 0 0 0 rgba(2, 132, 199, 0.35);
				}
				50% {
					transform: scale(1.06);
					opacity: 1;
					box-shadow: 0 0 12px 3px rgba(37, 99, 235, 0.5);
				}
			}

			/* Attachment Thumbnails */
			.capsule-attachment-thumb {
				position: relative;
				width: 50px;
				height: 50px;
				border-radius: 10px;
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				flex-shrink: 0;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.capsule-thumb-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.capsule-thumb-doc {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				color: var(--text-secondary);
				width: 100%;
				height: 100%;
			}
			.capsule-thumb-overlay {
				position: absolute;
				inset: 0;
				background: rgba(0, 0, 0, 0.65);
				display: flex;
				align-items: center;
				justify-content: center;
				color: #ffffff;
			}
			.capsule-thumb-delete {
				position: absolute;
				top: 2px;
				left: 2px;
				width: 16px;
				height: 16px;
				border-radius: 50%;
				background: rgba(0, 0, 0, 0.75);
				color: #ffffff;
				border: none;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 10px;
				line-height: 1;
				transition: background 120ms;
			}
			.capsule-thumb-delete:hover {
				background: #ef4444;
			}
			/* Sessions Overlay and Header Buttons */
			.capsule-hdr-icon-btn {
				background: transparent;
				border: 1px solid transparent;
				color: var(--text-muted);
				width: 32px;
				height: 32px;
				border-radius: var(--radius-md);
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: all 120ms ease;
			}
			.capsule-hdr-icon-btn:hover {
				background: var(--surface-sunken);
				border-color: var(--border);
				color: var(--text);
			}
			.capsule-hdr-icon-btn.active {
				background: var(--accent-subtle);
				border-color: var(--accent);
				color: var(--accent);
			}
			.capsule-icon-delete-btn {
				background: transparent;
				border: none;
				color: var(--text-muted);
				cursor: pointer;
				padding: 6px;
				border-radius: 6px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: all 120ms ease;
			}
			.capsule-icon-delete-btn:hover {
				color: #ef4444;
				background: rgba(239, 68, 68, 0.12);
			}
			.capsule-hdr-btn {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				color: var(--text-secondary);
				height: 28px;
				padding: 0 0.55rem;
				border-radius: var(--radius-md);
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.725rem;
				font-weight: 700;
				transition: all 120ms ease;
			}
			.capsule-hdr-btn:hover {
				background: var(--accent-subtle);
				border-color: var(--accent);
				color: var(--text);
			}
			.capsule-hdr-btn.active {
				background: var(--accent);
				border-color: var(--accent);
				color: #ffffff;
			}
			.capsule-sessions-overlay {
				position: absolute;
				inset: 56px 0 0 0;
				background: var(--surface-raised);
				z-index: 9998;
				display: flex;
				flex-direction: column;
				overflow: hidden;
			}
			.capsule-session-card {
				background: var(--surface-sunken);
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				padding: 0.65rem 0.85rem;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
				transition: all 120ms ease;
				text-align: right;
			}
			.capsule-session-card:hover {
				border-color: var(--accent);
				background: var(--surface);
			}
			.capsule-session-card.active {
				border-color: var(--accent);
				background: var(--accent-subtle);
			}

			.capsule-spinner {
				width: 14px;
				height: 14px;
				border: 2px solid rgba(255, 255, 255, 0.3);
				border-top-color: #ffffff;
				border-radius: 50%;
				animation: spin 0.8s linear infinite;
			}
			@keyframes spin { to { transform: rotate(360deg); } }
		</style>

		<!-- Assistant Core Logic -->
		@CapsuleAssistantScript()
	</div>
}
