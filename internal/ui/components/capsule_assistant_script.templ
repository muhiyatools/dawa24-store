package components

templ CapsuleAssistantScript() {
		<script>
			function capsuleAssistantManager() {
				return {
					isOpen: true,
					inputQuery: '',
					isStreaming: false,
					statusStage: '',
					statusMessage: '',
					isDragging: false,
					dragCounter: 0,
					isRecordingVoice: false,
					recordingSeconds: 0,
					recordingTimer: null,
					mediaStream: null,
					mediaRecorder: null,
					audioChunks: [],
					attachedFiles: [],
					messages: [],
					conversationID: 0,
					abortController: null,
					autoScrollEnabled: true,
					showSessionsDrawer: false,
					pastConversations: [],
					isLoadingPastSessions: false,
					searchPastQuery: '',

					init() {
						window.addEventListener('open-capsule-assistant', () => {
							this.openAssistant();
						});
						this.$nextTick(() => {
							const c = document.getElementById('capsule-messages-container');
							if (c) {
								c.addEventListener('scroll', () => {
									const dist = c.scrollHeight - c.scrollTop - c.clientHeight;
									this.autoScrollEnabled = dist < 80;
								});
							}
							if (this.$refs.chatTextarea) this.$refs.chatTextarea.focus();
						});
					},

					openAssistant() {
						this.isOpen = true;
						this.autoScrollEnabled = true;
						this.scrollToBottom(true);
						const host = Alpine.$data(document.getElementById('capsule-assistant-host'));
						if (host) host.isOpen = true;
						this.$nextTick(() => {
							if (this.$refs.chatTextarea) this.$refs.chatTextarea.focus();
						});
					},

					closeAssistant() {
						this.isOpen = false;
						this.isDragging = false;
						this.dragCounter = 0;
						const host = Alpine.$data(document.getElementById('capsule-assistant-host'));
						if (host) host.isOpen = false;
					},

					filteredPastConversations() {
						const q = (this.searchPastQuery || '').trim().toLowerCase();
						if (!q) return this.pastConversations;
						return this.pastConversations.filter(c => (c.title || '').toLowerCase().includes(q));
					},

					toggleSessionsDrawer() {
						this.showSessionsDrawer = !this.showSessionsDrawer;
						if (this.showSessionsDrawer) {
							this.fetchConversations();
						}
					},

					async fetchConversations() {
						this.isLoadingPastSessions = true;
						try {
							const resp = await fetch('/api/v1/assistant/conversations');
							if (resp.ok) {
								const data = await resp.json();
								this.pastConversations = data.conversations || [];
							}
						} catch (err) {
							console.error('Failed to fetch conversations:', err);
						} finally {
							this.isLoadingPastSessions = false;
						}
					},

					startNewConversation() {
						if (this.isStreaming) this.cancelStream();
						this.conversationID = 0;
						this.messages = [];
						this.attachedFiles = [];
						this.inputQuery = '';
						this.showSessionsDrawer = false;
						if (this.$refs.chatTextarea) {
							this.$refs.chatTextarea.style.height = '24px';
							this.$refs.chatTextarea.focus();
						}
					},

					async loadSession(convID) {
						if (this.isStreaming) this.cancelStream();
						this.isLoadingPastSessions = true;
						try {
							const resp = await fetch('/api/v1/assistant/conversations/' + convID);
							if (resp.ok) {
								const data = await resp.json();
								this.conversationID = convID;
								this.messages = [];
								if (data.messages && data.messages.length > 0) {
									for (const m of data.messages) {
										if (m.role === 'user') {
											this.messages.push({
												isUser: true,
												text: m.content,
												attachments: m.attachments || []
											});
										} else if (m.role === 'assistant') {
											this.messages.push({
												isUser: false,
												text: m.content,
												reasoning: '',
												isStreaming: false
											});
										}
									}
								}
								this.showSessionsDrawer = false;
								this.scrollToBottom(true);
							}
						} catch (err) {
							console.error('Failed to load session:', err);
						} finally {
							this.isLoadingPastSessions = false;
						}
					},

					async deleteSession(convID) {
						if (!confirm('هل أنت متأكد من حذف هذه المحادثة من سجلك؟')) return;
						try {
							const resp = await fetch('/api/v1/assistant/conversations/' + convID, {
								method: 'DELETE'
							});
							if (resp.ok) {
								this.pastConversations = this.pastConversations.filter(c => c.id !== convID);
								if (this.conversationID === convID) {
									this.startNewConversation();
								}
							}
						} catch (err) {
							console.error('Failed to delete session:', err);
						}
					},

					formatDate(isoStr) {
						if (!isoStr) return '';
						try {
							const d = new Date(isoStr);
							return d.toLocaleDateString('ar-EG', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true });
						} catch (e) {
							return isoStr;
						}
					},

					clearChat() {
						this.startNewConversation();
					},

					askChip(text) {
						this.inputQuery = text;
						this.sendMessage();
					},

					copyText(text, btnEl) {
						if (!text) return;
						navigator.clipboard.writeText(text).then(() => {
							if (btnEl) {
								const defIcon = btnEl.querySelector('.copy-icon-default');
								const succIcon = btnEl.querySelector('.copy-icon-success');
								if (defIcon && succIcon) {
									defIcon.style.display = 'none';
									succIcon.style.display = 'inline-flex';
									setTimeout(() => {
										defIcon.style.display = 'inline-flex';
										succIcon.style.display = 'none';
									}, 1800);
								}
							}
						});
					},

					onDragEnter(e) {
						if (!this.isOpen) return;
						if (e.dataTransfer && e.dataTransfer.types && e.dataTransfer.types.includes('Files')) {
							this.dragCounter++;
							this.isDragging = true;
						}
					},

					onDragLeave(e) {
						if (!this.isOpen) return;
						this.dragCounter--;
						if (this.dragCounter <= 0) {
							this.dragCounter = 0;
							this.isDragging = false;
						}
					},

					onDrop(e) {
						if (!this.isOpen) return;
						this.dragCounter = 0;
						this.isDragging = false;
						const files = Array.from(e.dataTransfer?.files || []);
						this.addFiles(files);
					},

					handleFileSelect(e) {
						const files = Array.from(e.target.files || []);
						this.addFiles(files);
						e.target.value = '';
					},

					async addFiles(files) {
						for (const file of files) {
							if (this.attachedFiles.length >= 5) break;
							const isImg = file.type.startsWith('image/');
							let previewUrl = '';
							if (isImg) {
								try {
									previewUrl = URL.createObjectURL(file);
								} catch (e) {}
							}
							const fileItem = {
								id: 'att-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8),
								file: file,
								name: file.name,
								size: file.size,
								type: file.type,
								isImage: isImg,
								previewUrl: previewUrl,
								handle: '',
								uploading: true,
								error: ''
							};
							this.attachedFiles.push(fileItem);
							this.uploadAttachment(fileItem.id, file);
						}
					},

					async uploadAttachment(itemId, rawFile) {
						try {
							const form = new FormData();
							form.append('file', rawFile);
							const resp = await fetch('/api/v1/assistant/attachments', {
								method: 'POST',
								body: form
							});
							const target = this.attachedFiles.find(f => f.id === itemId);
							if (!target) return;

							if (!resp.ok) {
								const errData = await resp.json().catch(() => ({}));
								target.error = errData.message || 'فشل رفع الملف';
								target.uploading = false;
								return;
							}
							const data = await resp.json();
							if (data.attachments && data.attachments.length > 0) {
								target.handle = data.attachments[0].handle;
							} else {
								target.error = 'استجابة غير صحيحة من الخادم';
							}
						} catch (e) {
							const target = this.attachedFiles.find(f => f.id === itemId);
							if (target) {
								target.error = 'خطأ في الاتصال بالخادم';
							}
						} finally {
							const target = this.attachedFiles.find(f => f.id === itemId);
							if (target) {
								target.uploading = false;
							}
						}
					},

					removeAttachment(idx) {
						if (this.attachedFiles[idx] && this.attachedFiles[idx].previewUrl) {
							URL.revokeObjectURL(this.attachedFiles[idx].previewUrl);
						}
						this.attachedFiles.splice(idx, 1);
					},

					formatBytes(bytes) {
						if (!bytes) return '0 B';
						const k = 1024;
						const sizes = ['B', 'KB', 'MB'];
						const i = Math.floor(Math.log(bytes) / Math.log(k));
						return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
					},

					async startVoiceRecord() {
						if (this.isRecordingVoice) return;
						try {
							const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
							this.mediaStream = stream;
							this.audioChunks = [];
							this.mediaRecorder = new MediaRecorder(stream);
							this.mediaRecorder.ondataavailable = (e) => {
								if (e.data && e.data.size > 0) this.audioChunks.push(e.data);
							};
							this.mediaRecorder.start();
							this.isRecordingVoice = true;
							this.recordingSeconds = 0;
							this.recordingTimer = setInterval(() => {
								this.recordingSeconds++;
							}, 1000);
						} catch (e) {
							this.cancelVoiceRecord();
							alert('تعذر فتح الميكروفون، يرجى السماح بالوصول في إعدادات المتصفح.');
						}
					},

					cancelVoiceRecord() {
						this.isRecordingVoice = false;
						if (this.recordingTimer) {
							clearInterval(this.recordingTimer);
							this.recordingTimer = null;
						}
						this.recordingSeconds = 0;
						if (this.mediaRecorder && this.mediaRecorder.state !== 'inactive') {
							try { this.mediaRecorder.stop(); } catch (e) {}
						}
						if (this.mediaStream) {
							try { this.mediaStream.getTracks().forEach(t => t.stop()); } catch (e) {}
							this.mediaStream = null;
						}
						this.audioChunks = [];
					},

					async finishVoiceRecord() {
						if (!this.mediaRecorder || this.mediaRecorder.state === 'inactive') {
							this.cancelVoiceRecord();
							return;
						}

						this.mediaRecorder.onstop = async () => {
							const audioBlob = new Blob(this.audioChunks, { type: 'audio/webm' });
							this.audioChunks = [];
							if (this.mediaStream) {
								try { this.mediaStream.getTracks().forEach(t => t.stop()); } catch (e) {}
								this.mediaStream = null;
							}

							this.statusMessage = 'جاري تحويل الصوت إلى نص...';
							try {
								const form = new FormData();
								form.append('file', audioBlob, 'voice.webm');
								const resp = await fetch('/api/v1/assistant/transcribe', {
									method: 'POST',
									body: form
								});
								if (resp.ok) {
									const data = await resp.json();
									if (data.text) {
										this.inputQuery = (this.inputQuery ? this.inputQuery + ' ' : '') + data.text.trim();
										this.$nextTick(() => {
											this.autoResizeTextarea();
											if (this.$refs.chatTextarea) this.$refs.chatTextarea.focus();
										});
									}
								} else {
									const err = await resp.json().catch(() => ({}));
									alert(err.message || 'تعذر تفريغ التسجيل الصوتي.');
								}
							} catch (e) {
								console.warn('transcription failed', e);
							} finally {
								this.statusMessage = '';
							}
						};

						this.isRecordingVoice = false;
						if (this.recordingTimer) {
							clearInterval(this.recordingTimer);
							this.recordingTimer = null;
						}
						this.recordingSeconds = 0;
						try {
							this.mediaRecorder.stop();
						} catch (e) {
							this.cancelVoiceRecord();
						}
					},

					formatDuration(secs) {
						const m = Math.floor(secs / 60);
						const s = secs % 60;
						return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
					},

					handleKeydown(e) {
						if (e.key === 'Enter') {
							if (e.shiftKey) {
								this.$nextTick(() => this.autoResizeTextarea());
							} else {
								e.preventDefault();
								this.sendMessage();
							}
						}
					},

					autoResizeTextarea() {
						const el = this.$refs.chatTextarea;
						if (!el) return;
						el.style.height = '24px';
						const newHeight = Math.min(Math.max(el.scrollHeight, 24), 110);
						el.style.height = newHeight + 'px';
					},

					async sendMessage() {
						const q = this.inputQuery.trim();
						if (this.isStreaming || (!q && this.attachedFiles.length === 0)) return;

						// If any file is still uploading, wait asynchronously up to 8s for completion
						if (this.attachedFiles.some(f => f.uploading)) {
							this.statusMessage = 'جاري رفع المرفقات...';
							let waited = 0;
							while (this.attachedFiles.some(f => f.uploading) && waited < 32) {
								await new Promise(r => setTimeout(r, 250));
								waited++;
							}
							this.statusMessage = '';
						}

						const handles = this.attachedFiles.filter(f => f.handle && !f.error).map(f => f.handle);
						const sentAttachments = [...this.attachedFiles];

						this.messages.push({
							text: q || (sentAttachments.length > 0 ? 'مرفق: ' + sentAttachments.map(f => f.name).join(', ') : ''),
							isUser: true,
							attachments: sentAttachments
						});

						this.messages.push({
							text: '',
							reasoning: '',
							isUser: false,
							isStreaming: true
						});
						const assistantMsg = this.messages[this.messages.length - 1];

						this.inputQuery = '';
						this.attachedFiles = [];
						if (this.$refs.chatTextarea) {
							this.$refs.chatTextarea.style.height = '24px';
						}
						this.isStreaming = true;
						this.statusStage = '';
						this.statusMessage = '';
						this.autoScrollEnabled = true;
						this.scrollToBottom(true);

						this.abortController = new AbortController();

						try {
							const resp = await fetch('/api/v1/assistant/messages', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									text: q,
									conversation_id: this.conversationID,
									attachment_handles: handles
								}),
								signal: this.abortController.signal
							});

							if (!resp.ok) {
								const errData = await resp.json().catch(() => ({}));
								assistantMsg.text = errData.message || 'تعذر الاتصال بالمساعد الذكي.';
								assistantMsg.isStreaming = false;
								this.isStreaming = false;
								return;
							}

							const reader = resp.body.getReader();
							const decoder = new TextDecoder('utf-8');
							let buffer = '';

							while (true) {
								const { done, value } = await reader.read();
								if (done) break;

								buffer += decoder.decode(value, { stream: true });
								const lines = buffer.split('\n');
								buffer = lines.pop() || '';

								let currentEvent = 'message';
								for (const line of lines) {
									const trimmed = line.trim();
									if (trimmed.startsWith('event:')) {
										currentEvent = trimmed.substring(6).trim();
									} else if (trimmed.startsWith('data:')) {
										const dataStr = trimmed.substring(5).trim();
										if (!dataStr) continue;

										try {
											const data = JSON.parse(dataStr);
											if (currentEvent === 'delta' && data.text) {
												this.statusStage = '';
												assistantMsg.text += data.text;
												this.scrollToBottom();
											} else if (currentEvent === 'reasoning' && data.text) {
												assistantMsg.reasoning += data.text;
												this.scrollToBottom();
											} else if (currentEvent === 'status') {
												this.statusStage = data.stage || '';
												this.statusMessage = data.message || (data.stage === 'analyzing_attachment' ? 'جاري تحليل المرفق (' + data.file + ')...' : '');
												this.scrollToBottom();
											} else if (currentEvent === 'done') {
												if (data.conversation_id) {
													this.conversationID = data.conversation_id;
													this.fetchConversations();
												}
												assistantMsg.isStreaming = false;
											} else if (currentEvent === 'error') {
												assistantMsg.text += '\n\n[خطأ: ' + (data.message || 'حدث خطأ غير متوقع') + ']';
												assistantMsg.isStreaming = false;
											}
										} catch (parseErr) {
											// Non-JSON frame ignore
										}
									}
								}
							}
						} catch (e) {
							if (e.name !== 'AbortError') {
								assistantMsg.text += '\n\n[انقطع الاتصال بالخادم: ' + e.message + ']';
							}
						} finally {
							assistantMsg.isStreaming = false;
							this.isStreaming = false;
							this.statusStage = '';
							this.statusMessage = '';
							this.abortController = null;
							this.scrollToBottom();
						}
					},

					cancelStream() {
						if (this.abortController) {
							this.abortController.abort();
							this.abortController = null;
						}
						this.isStreaming = false;
						this.statusStage = '';
						this.statusMessage = '';
					},

					renderMarkdown(raw) {
						if (!raw) return '';
						let text = raw
							.replace(/&/g, '&amp;')
							.replace(/</g, '&lt;')
							.replace(/>/g, '&gt;');

						// Code blocks
						text = text.replace(/```([\s\S]*?)```/g, (match, p1) => {
							return `<pre class="capsule-code-block"><code>${p1.trim()}</code></pre>`;
						});

						// Inline code
						text = text.replace(/`([^`]+)`/g, '<code class="capsule-inline-code">$1</code>');

						// Bold
						text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

						// Italic
						text = text.replace(/\*([^*]+)\*/g, '<em>$1</em>');

						// Headings
						text = text.replace(/^### (.*$)/gim, '<h4 class="capsule-h4">$1</h4>');
						text = text.replace(/^## (.*$)/gim, '<h3 class="capsule-h3">$1</h3>');
						text = text.replace(/^# (.*$)/gim, '<h2 class="capsule-h2">$1</h2>');

						// List items (bullet points)
						text = text.replace(/^[-*•]\s+(.*$)/gim, '<div class="capsule-list-item"><span class="capsule-bullet">•</span><span>$1</span></div>');

						// Double newlines to spacing
						text = text.replace(/\n\n/g, '<div style="height:0.5rem;"></div>');
						// Single newline
						text = text.replace(/\n/g, '<br/>');

						return text;
					},

					scrollToBottom(force = false) {
						this.$nextTick(() => {
							const container = document.getElementById('capsule-messages-container');
							if (container && (this.autoScrollEnabled || force)) {
								container.scrollTop = container.scrollHeight;
							}
						});
					}
				};
			}
		</script>
}
