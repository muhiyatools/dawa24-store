package components

templ LanguageToggle(currentLang string) {
	<div class="lang-toggle-group" style="display:inline-flex; align-items:center; background:var(--surface-sunken); padding:2px; border-radius:var(--radius-full); border:1px solid var(--border); gap:2px; user-select:none;">
		<a
			href="/lang/ar"
			class={ "lang-toggle-btn", templ.KV("active", currentLang == "ar" || currentLang == "") }
			style={ "display:inline-flex; align-items:center; gap:0.35rem; padding:0.25rem 0.65rem; border-radius:var(--radius-full); font-size:0.775rem; font-weight:700; text-decoration:none !important; transition:all 0.15s ease;", templ.KV("background:var(--surface-raised); color:var(--text); box-shadow:var(--shadow-sm);", currentLang == "ar" || currentLang == ""), templ.KV("color:var(--text-muted);", currentLang == "en") }
			title="العربية"
		>
			<span style="display:inline-flex; align-items:center;">@IconFlagEG("icon-xxs")</span>
			<span>عربي</span>
		</a>
		<a
			href="/lang/en"
			class={ "lang-toggle-btn", templ.KV("active", currentLang == "en") }
			style={ "display:inline-flex; align-items:center; gap:0.35rem; padding:0.25rem 0.65rem; border-radius:var(--radius-full); font-size:0.775rem; font-weight:700; text-decoration:none !important; transition:all 0.15s ease;", templ.KV("background:var(--surface-raised); color:var(--text); box-shadow:var(--shadow-sm);", currentLang == "en"), templ.KV("color:var(--text-muted);", currentLang != "en") }
			title="English"
		>
			<span style="display:inline-flex; align-items:center;">@IconFlagGB("icon-xxs")</span>
			<span>EN</span>
		</a>
	</div>
}
