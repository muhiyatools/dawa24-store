package components

import "strconv"

type Tab struct {
	ID    string
	Label string
	// URL makes the tab a link, which is what a tab that changes the page
	// should be: it stays shareable, bookmarkable and usable with the back
	// button. Leave empty for a client-side tab.
	URL   string
	Count int
}

type TabsProps struct {
	Tabs     []Tab
	ActiveID string
	State    string
}

templ Tabs(props TabsProps) {
	<div>
		<div class="tabs" role="tablist">
			for _, tab := range props.Tabs {
				if tab.URL != "" {
					<a
						href={ templ.SafeURL(tab.URL) }
						role="tab"
						class={ "tab", templ.KV("active", tab.ID == props.ActiveID) }
						if tab.ID == props.ActiveID {
							aria-selected="true"
						} else {
							aria-selected="false"
						}
					>
						{ tab.Label }
						if tab.Count > 0 {
							@Badge(BadgeProps{Label: strconv.Itoa(tab.Count), Tone: "slate"})
						}
					</a>
				} else {
					<button
						type="button"
						role="tab"
						class={ "tab", templ.KV("active", tab.ID == props.ActiveID) }
						if tab.ID == props.ActiveID {
							aria-selected="true"
						} else {
							aria-selected="false"
						}
					>
						{ tab.Label }
					</button>
				}
			}
		</div>
		<div role="tabpanel">
			switch props.State {
				case "loading":
					@SkeletonText(4)
				case "error":
					@ErrorState(ErrorStateProps{})
				case "empty":
					@EmptyState(EmptyStateProps{Title: "لا توجد بيانات", Message: "لا يوجد محتوى في هذا القسم بعد."})
				default:
					{ children... }
			}
		</div>
	</div>
}
