package components

type SelectOption struct {
	Value    string
	Label    string
	Selected bool
}

templ FormInput(label, name, inputType, value, placeholder string, required bool) {
	<div class="form-group">
		<label class="form-label" for={ name }>
			{ label }
			if required {
				<span class="text-danger ms-1">*</span>
			}
		</label>
		<input
			type={ inputType }
			id={ name }
			name={ name }
			value={ value }
			placeholder={ placeholder }
			if required {
				required
			}
			class="form-input"
		/>
	</div>
}

templ FormSelect(label, name string, options []SelectOption, required bool) {
	<div class="form-group">
		<label class="form-label" for={ name }>
			{ label }
			if required {
				<span class="text-danger ms-1">*</span>
			}
		</label>
		<select
			id={ name }
			name={ name }
			if required {
				required
			}
			class="form-select"
		>
			for _, opt := range options {
				<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
			}
		</select>
	</div>
}

templ FormTextarea(label, name, value, placeholder string, rows int, required bool) {
	<div class="form-group">
		<label class="form-label" for={ name }>
			{ label }
			if required {
				<span class="text-danger ms-1">*</span>
			}
		</label>
		<textarea
			id={ name }
			name={ name }
			placeholder={ placeholder }
			rows={ string(rune('0' + rows)) }
			if required {
				required
			}
			class="form-textarea"
		>{ value }</textarea>
	</div>
}

templ FormCheckbox(label, name string, checked bool, description string) {
	<div class="form-group form-checkbox-wrapper">
		<input
			type="checkbox"
			id={ name }
			name={ name }
			checked?={ checked }
			class="form-checkbox"
		/>
		<div>
			<label class="form-label mb-0 cursor-pointer font-semibold" for={ name }>{ label }</label>
			if description != "" {
				<p class="form-helper-text">{ description }</p>
			}
		</div>
	</div>
}

