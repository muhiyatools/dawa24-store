package components

import (
	"encoding/json"
	"fmt"
	"strings"
)

// ComboboxOption is one row of an inline list.
type ComboboxOption struct {
	ID    string `json:"id"`
	Label string `json:"label"`
	// Hint is searched alongside the label and shown beside it — a SKU, an
	// English name, a governorate.
	Hint string `json:"hint,omitempty"`
	// Badge is a short trailing marker: a stock count, a price.
	Badge string `json:"badge,omitempty"`
	// Parent is the id this option belongs to, for a chained list.
	Parent string `json:"parent,omitempty"`
}

// ComboboxProps configures the shared searchable dropdown.
type ComboboxProps struct {
	// Name is the submitted field name and the identity other comboboxes use
	// to chain off this one.
	Name  string
	Label string
	// Placeholder is the empty-state prompt inside the input.
	Placeholder string
	// URL is a search endpoint returning a JSON array of ComboboxOption.
	// "{q}" is replaced by the encoded query and "{other_name}" by another
	// combobox's current value. Leave empty to use Options instead.
	URL string
	// Options is an inline list, for a list short and constant enough to ship
	// with the page.
	Options []ComboboxOption
	// DependsOn names the combobox this one is filtered by. Choosing there
	// clears the selection here.
	DependsOn string
	// SelectedValue and SelectedLabel restore a choice after a failed submit.
	SelectedValue string
	SelectedLabel string
	Required      bool
	Disabled      bool
	// EmptyText overrides the "no matches" line.
	EmptyText string
	// Help is a line under the control.
	Help string
	// Class is added to the wrapper.
	Class string
}

// Combobox renders a searchable single-select.
//
// It replaces four hand-rolled dropdowns that each lost the selection when the
// list closed before the click landed, offered no keyboard, and could not tell
// "still searching" from "nothing found". The behaviour lives in
// static/js/combobox.js; this is the markup and the accessibility contract.
//
// The submitted value is the hidden input; the visible input is the query, and
// carries no name, so a half-typed search can never be posted as an answer.
templ Combobox(props ComboboxProps) {
	<div
		class={ "combobox", props.Class }
		x-data={ comboboxState(props) }
		x-init="init()"
		x-on:combobox-change.window="/* chained lists reset themselves */"
		@keydown.escape.stop="close()"
	>
		if props.Label != "" {
			<label class="form-label text-xs font-bold" :for="$id('combobox')">
				{ props.Label }
				if props.Required {
					<span class="text-danger">*</span>
				}
			</label>
		}

		<div class="combobox-shell" @click.outside="close()">
			<input
				type="text"
				:id="$id('combobox')"
				x-ref="input"
				x-model="query"
				@focus="onFocus()"
				@input="onInput()"
				@keydown.arrow-down.prevent="move(1)"
				@keydown.arrow-up.prevent="move(-1)"
				@keydown.home.prevent="jump('start')"
				@keydown.end.prevent="jump('end')"
				@keydown.enter="if (commitActive()) { $event.preventDefault(); }"
				@keydown.tab="close()"
				class="form-input combobox-input"
				autocomplete="off"
				role="combobox"
				aria-autocomplete="list"
				:aria-expanded="open ? 'true' : 'false'"
				:aria-controls="$id('combobox') + '-list'"
				:aria-activedescendant="active >= 0 ? optionId(active) : null"
				placeholder={ props.Placeholder }
				if props.Disabled {
					disabled
				}
				dir="auto"
			/>

			<span class="combobox-icon" aria-hidden="true">
				@IconSearch("icon-xs")
			</span>

			<template x-if="selected">
				<button
					type="button"
					class="combobox-clear"
					@click="clear()"
					:aria-label="'إلغاء الاختيار: ' + (selected ? selected.label : '')"
				>
					@IconClose("icon-2xs")
				</button>
			</template>

			<input
				type="hidden"
				x-ref="hidden"
				name={ props.Name }
				:value="selected ? selected.id : ''"
			/>

			<ul
				class="combobox-list"
				:id="$id('combobox') + '-list'"
				role="listbox"
				x-show="open"
				x-cloak
				x-transition.opacity.duration.100ms
			>
				<template x-if="loading">
					<li class="combobox-status" role="presentation">جارٍ البحث…</li>
				</template>
				<template x-if="!loading && failed">
					<li class="combobox-status is-error" role="presentation">تعذّر الاتصال بالخادم. حاول مرة أخرى.</li>
				</template>
				<template x-if="!loading && !failed && query.trim().length < minChars">
					<li class="combobox-status" role="presentation">
						اكتب حرفين على الأقل للبحث
					</li>
				</template>
				<template x-if="!loading && !failed && query.trim().length >= minChars && results.length === 0">
					<li class="combobox-status" role="presentation">{ comboboxEmptyText(props) }</li>
				</template>

				<template x-for="(item, i) in results" :key="item.id">
					<li
						:id="optionId(i)"
						class="combobox-option"
						:class="{ 'is-active': i === active }"
						role="option"
						:aria-selected="selected && selected.id === item.id ? 'true' : 'false'"
						@mousedown.prevent="choose(item)"
						@mouseenter="active = i"
					>
						<span class="combobox-option-main">
							<span class="combobox-option-label" x-text="item.label" dir="auto"></span>
							<template x-if="item.hint">
								<span class="combobox-option-hint" x-text="item.hint" dir="auto"></span>
							</template>
						</span>
						<template x-if="item.badge">
							<span class="combobox-option-badge tabular-nums" x-text="item.badge"></span>
						</template>
					</li>
				</template>
			</ul>
		</div>

		if props.Help != "" {
			<p class="combobox-help">{ props.Help }</p>
		}
	</div>
}

// comboboxEmptyText is the "nothing matched" line.
func comboboxEmptyText(props ComboboxProps) string {
	if props.EmptyText != "" {
		return props.EmptyText
	}
	return "لا توجد نتائج مطابقة"
}

// comboboxState builds the Alpine payload. Everything the browser needs is JSON
// so a label carrying a quote or an Arabic comma cannot break the attribute.
func comboboxState(props ComboboxProps) string {
	cfg := struct {
		Name          string           `json:"name"`
		URL           string           `json:"url,omitempty"`
		Options       []ComboboxOption `json:"options,omitempty"`
		DependsOn     string           `json:"dependsOn,omitempty"`
		SelectedValue string           `json:"selectedValue,omitempty"`
		SelectedLabel string           `json:"selectedLabel,omitempty"`
	}{
		Name:          props.Name,
		URL:           props.URL,
		Options:       props.Options,
		DependsOn:     props.DependsOn,
		SelectedValue: strings.TrimSpace(props.SelectedValue),
		SelectedLabel: strings.TrimSpace(props.SelectedLabel),
	}
	encoded, err := json.Marshal(cfg)
	if err != nil {
		return "dawaCombobox({})"
	}
	return fmt.Sprintf("dawaCombobox(%s)", string(encoded))
}
