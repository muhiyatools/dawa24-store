package components

import "github.com/muhiya/dawa24-store/internal/shared/i18n"

// The notifications bell.
//
// This markup lived only in the public marketing header, so a signed-in user on
// a dashboard — the people who actually receive notifications — had no way to
// see them without navigating to /notifications. It is a component now and both
// headers render the same one.
//
// The panel body is fetched on first open rather than with the page: the badge
// polls a tiny endpoint every 60s, and the list itself is only worth loading if
// somebody opens it.
templ NotificationsBell(lang string) {
	<div class="dropdown notif-bell" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">
		<button
			type="button"
			title={ i18n.T(lang, "notifications.title") }
			aria-label={ i18n.T(lang, "notifications.title") }
			:aria-expanded="open ? 'true' : 'false'"
			@click="open = !open"
			hx-get="/notifications/dropdown"
			hx-target="#notif-dropdown-content"
			hx-trigger="click once"
			hx-swap="innerHTML"
			class="btn btn-secondary btn-icon btn-notification-wrap"
		>
			@IconBell("icon-sm")
			<span
				class="notification-indicator"
				hx-get="/notifications/unread-badge"
				hx-trigger="load, every 60s"
				hx-swap="innerHTML"
				hx-target="this"
			></span>
		</button>
		<div
			class="dropdown-menu notification-menu"
			id="notif-dropdown-content"
			role="menu"
			x-show="open"
			x-cloak
			x-transition.origin.top.duration.150ms
		>
			<div class="notification-panel">
				<div class="notification-header">
					<div class="row-center-sm">
						@IconBell("icon-xs")
						<span class="notification-title">{ i18n.T(lang, "notifications.title") }</span>
					</div>
				</div>
				<div class="notification-empty">
					<div class="notification-empty-icon">
						@IconBell("icon-sm")
					</div>
					<div class="stack-xs text-sm">{ i18n.T(lang, "notifications.empty") }</div>
				</div>
			</div>
		</div>
	</div>
}
