package components

type EmptyStateProps struct {
	Title       string
	Message     string
	ActionLabel string
}

templ EmptyState(props EmptyStateProps) {
	<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:3rem 2rem; text-align:center; border:2px dashed var(--neutral-300); border-radius:var(--radius-xl); background:var(--neutral-50); margin:1.5rem 0;">
		<div style="width:56px; height:56px; border-radius:var(--radius-xl); background:var(--neutral-100); color:var(--neutral-400); display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
			@IconPackage("icon-xl")
		</div>
		<h3 style="font-size:1.15rem; font-weight:800; color:var(--neutral-900); margin-bottom:0.35rem;">{ props.Title }</h3>
		<p style="font-size:0.9rem; color:var(--neutral-500); margin-bottom:1.25rem; max-width:420px; line-height:1.6;">{ props.Message }</p>
		if props.ActionLabel != "" {
			<a href="/catalog" class="btn btn-primary" style="padding:0.6rem 1.5rem; font-size:0.9rem;">
				{ props.ActionLabel }
			</a>
		}
	</div>
}
