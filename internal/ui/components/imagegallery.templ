package components

import "fmt"

type ImageGalleryProps struct {
	Images []string // image URLs
	Alt    string
}

// ImageGallery is an Alpine product-detail gallery: a main image plus
// thumbnails.
templ ImageGallery(props ImageGalleryProps) {
	<div class="image-gallery" x-data="{ current: 0 }">
		<div class="image-gallery-main" style="position:relative; overflow:hidden;">
			for i, src := range props.Images {
				<img src={ src } alt={ props.Alt } x-show={ fmt.Sprintf("current === %d", i) } style="width:100%; display:block;" />
			}
		</div>
		if len(props.Images) > 1 {
			<div class="image-gallery-thumbs" style="display:flex; gap:0.5rem; margin-top:0.5rem;">
				for i, src := range props.Images {
					<button type="button" x-on:click={ fmt.Sprintf("current = %d", i) } style="padding:0; border:2px solid var(--border-card); border-radius:var(--radius-sm); overflow:hidden;">
						<img src={ src } alt={ props.Alt } style="width:56px; height:56px; object-fit:cover;" />
					</button>
				}
			</div>
		}
	</div>
}
