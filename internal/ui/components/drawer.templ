package components

type DrawerProps struct {
	ID    string
	Title string
	State string
}

// Drawer slides in from the inline-end edge — the start side in an RTL layout
// is where the navigation lives, so a panel belongs opposite it.
//
// The previous version positioned itself with translate-x-full and a "hidden"
// class and had no open/close mechanism, so it was permanently invisible.
templ Drawer(props DrawerProps) {
	<div id={ props.ID } x-data="{ open: false }" @open-drawer.window="if ($event.detail === $el.id) open = true" @keydown.escape.window="open = false">
		<div class="drawer-overlay" x-show="open" x-cloak x-transition.opacity @click="open = false"></div>
		<aside
			class="drawer-panel"
			x-show="open"
			x-cloak
			x-transition:enter-start="translate-end"
			role="dialog"
			aria-modal="true"
			aria-labelledby={ props.ID + "-title" }
		>
			<div class="drawer-header">
				<h2 class="drawer-title" id={ props.ID + "-title" }>{ props.Title }</h2>
				<button type="button" class="modal-close" aria-label="إغلاق" @click="open = false">
					@IconClose("icon-sm")
				</button>
			</div>
			<div class="drawer-body">
				switch props.State {
					case "loading":
						@SkeletonText(5)
					case "error":
						@ErrorState(ErrorStateProps{})
					default:
						{ children... }
				}
			</div>
		</aside>
	</div>
}

// DrawerTrigger opens a drawer by id.
templ DrawerTrigger(drawerID, class string) {
	<button type="button" class={ class } onclick={ openDrawer(drawerID) }>
		{ children... }
	</button>
}

script openDrawer(id string) {
	window.dispatchEvent(new CustomEvent("open-drawer", { detail: id }));
}
