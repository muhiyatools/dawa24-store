package components

import (
	"strings"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/platform/rbac"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
)

templ UserMenu(lang string, inDashboard ...bool) {
	if actor, ok := authctx.From(ctx); ok {
		{{ isDash := len(inDashboard) > 0 && inDashboard[0] }}
		<div class="user-menu" x-data="{ open: false }" @keydown.escape.window="open = false">
			<button
				type="button"
				class="user-menu-trigger"
				@click="open = !open"
				:aria-expanded="open ? 'true' : 'false'"
				aria-haspopup="menu"
				aria-controls="user-menu-panel"
			>
				<span class="user-menu-avatar" aria-hidden="true">{ initials(actor.DisplayName()) }</span>
				<span class="user-menu-identity">
					<span class="user-menu-name">{ actor.DisplayName() }</span>
				</span>
				@IconChevronDown("icon-xs")
			</button>
			<div
				id="user-menu-panel"
				class="user-menu-panel"
				role="menu"
				x-show="open"
				x-cloak
				@click.outside="open = false"
				x-transition.opacity.duration.120ms
			>
				<div class="user-menu-header">
					<span class="user-menu-header-name">{ actor.DisplayName() }</span>
					if actor.Email != "" {
						<span class="user-menu-header-detail">{ actor.Email }</span>
					}
				</div>
				<div class="user-menu-items">
					if isDash {
						<a href="/" class="user-menu-item user-menu-item-nav" role="menuitem">
							@IconHome("icon-xs")
							<span>الخروج من صفحة الداشبورد</span>
						</a>
					} else {
						<a href={ templ.SafeURL(dashboardURL(actor)) } class="user-menu-item user-menu-item-nav" role="menuitem">
							@IconGrid("icon-xs")
							<span>دخول اللوحة</span>
						</a>
					}
					<a href="/settings" class="user-menu-item" role="menuitem">
						@IconSettings("icon-xs")
						<span>{ i18n.T(lang, "common.settings") }</span>
					</a>
					if orgLink(actor) != "" {
						<a href={ templ.SafeURL(orgLink(actor)) } class="user-menu-item" role="menuitem">
							@IconBuilding("icon-xs")
							<span>{ i18n.T(lang, "nav.linked_organizations") }</span>
						</a>
					}
				</div>
				<div class="user-menu-section">
					<span class="user-menu-section-label">المظهر</span>
					<div class="user-menu-segmented" role="group" aria-label="المظهر">
						<button type="button" class="user-menu-segment" data-set-theme="light" title="فاتح">
							@IconSun("icon-xs")
							<span>فاتح</span>
						</button>
						<button type="button" class="user-menu-segment" data-set-theme="dark" title="داكن">
							@IconMoon("icon-xs")
							<span>داكن</span>
						</button>
					</div>
				</div>
				<div class="user-menu-section">
					<span class="user-menu-section-label">اللغة</span>
					<div class="user-menu-segmented language-flags-only" role="group" aria-label="اللغة">
						<a href="/lang/ar" class={ "user-menu-segment", templ.KV("is-active", lang != "en") } hreflang="ar" title="العربية">
							@IconFlagEG("icon-sm")
						</a>
						<a href="/lang/en" class={ "user-menu-segment", templ.KV("is-active", lang == "en") } hreflang="en" title="English">
							@IconFlagGB("icon-sm")
						</a>
					</div>
				</div>
				<form action="/auth/logout" method="POST" class="user-menu-logout">
					<button type="submit" class="user-menu-item user-menu-item-danger" role="menuitem">
						@IconLogout("icon-xs")
						<span>{ i18n.T(lang, "auth.logout") }</span>
					</button>
				</form>
			</div>
		</div>
	}
}

func dashboardURL(actor authctx.Actor) string {
	switch actor.DashboardScope() {
	case rbac.ScopeAdmin:
		return "/admin/dashboard"
	case rbac.ScopeVendor:
		return "/vendor/dashboard"
	default:
		return "/customer/dashboard"
	}
}

func initials(name string) string {
	fields := strings.Fields(name)
	if len(fields) == 0 {
		return "?"
	}
	first := []rune(fields[0])
	out := string(first[:1])
	if len(fields) > 1 {
		second := []rune(fields[len(fields)-1])
		out += string(second[:1])
	}
	return strings.ToUpper(out)
}

func orgLink(actor authctx.Actor) string {
	switch {
	case actor.IsStaff:
		return ""
	case actor.IsVendor() && actor.Can("vendor.user_org.view"):
		return "/vendor/user-organization"
	case actor.IsCustomer() && actor.Can("pharmacy.user_org.view"):
		return "/customer/user-organization"
	default:
		return ""
	}
}