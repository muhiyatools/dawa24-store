package components

import (
	"strings"

	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/platform/rbac"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
)

// The account menu.
//
// It renders on the shared .nav-menu surface, so it, the notifications panel
// and the branch selector are one object. What changed beyond the styling:
//
//   - The items are grouped and each group carries a mono label. The menu had
//     grown to eleven undifferentiated rows, and a reader looking for "الطلبات"
//     had to read all of them.
//   - Theme and language keep their segmented controls at the foot, where
//     settings belong, and sign-out is last and alone.
templ UserMenu(lang string, inDashboard ...bool) {
	if actor, ok := authctx.From(ctx); ok {
		{{ isDash := len(inDashboard) > 0 && inDashboard[0] }}
		<div class="nav-pop" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">
			<button
				type="button"
				class="nav-trigger"
				@click="open = !open"
				:aria-expanded="open ? 'true' : 'false'"
				aria-haspopup="menu"
				aria-controls="user-menu-panel"
			>
				<span class="nav-avatar" aria-hidden="true">{ Initials(actor.DisplayName()) }</span>
				<span class="nav-trigger-text">
					<span class="nav-trigger-label">{ accountEyebrow(actor) }</span>
					<span class="nav-trigger-value">{ actor.DisplayName() }</span>
				</span>
				@IconChevronDown("icon-xs nav-trigger-chevron")
			</button>
			<div
				id="user-menu-panel"
				class="nav-menu"
				role="menu"
				x-show="open"
				x-cloak
				x-transition.origin.top.duration.150ms
			>
				<div class="nav-menu-head">
					<span class="nav-menu-identity">
						<span class="nav-menu-name">{ actor.DisplayName() }</span>
						if actor.Email != "" {
							<span class="nav-menu-detail">{ actor.Email }</span>
						}
					</span>
				</div>
				<div class="nav-menu-body">
					<div class="nav-menu-group">
						if isDash {
							<a href="/" class="nav-menu-item nav-menu-item--primary" role="menuitem">
								@IconHome("icon-xs")
								<span>الخروج من صفحة الداشبورد</span>
							</a>
						} else {
							<a href={ templ.SafeURL(dashboardURL(actor)) } class="nav-menu-item nav-menu-item--primary" role="menuitem">
								@IconGrid("icon-xs")
								<span>دخول اللوحة</span>
							</a>
						}
					</div>

					if actor.IsOrgApproved() {
						if actor.IsCustomer() || actor.IsVendor() {
							<div class="nav-menu-group">
								<span class="nav-menu-label">الحساب التجاري</span>
								if actor.IsCustomer() {
									<a href="/orders" class="nav-menu-item" role="menuitem">
										@IconPackage("icon-xs")
										<span>طلباتي</span>
									</a>
									<a href="/customer/wallet" class="nav-menu-item" role="menuitem">
										@IconWallet("icon-xs")
										<span>المحفظة والرصيد</span>
									</a>
									<a href="/suppliers/followed" class="nav-menu-item" role="menuitem">
										@IconHeartFilled("icon-xs")
										<span>الموردون المتابعون</span>
									</a>
								} else {
									<a href="/orders" class="nav-menu-item" role="menuitem">
										@IconPackage("icon-xs")
										<span>طلبات التوريد</span>
									</a>
									<a href="/vendor/wallet" class="nav-menu-item" role="menuitem">
										@IconWallet("icon-xs")
										<span>المحفظة والرصيد</span>
									</a>
								}
							</div>
						}

						<div class="nav-menu-group">
							<a href="/settings" class="nav-menu-item" role="menuitem">
								@IconSettings("icon-xs")
								<span>{ i18n.T(lang, "common.settings") }</span>
							</a>
							if orgLink(actor) != "" {
								<a href={ templ.SafeURL(orgLink(actor)) } class="nav-menu-item" role="menuitem">
									@IconBuilding("icon-xs")
									<span>{ i18n.T(lang, "nav.linked_organizations") }</span>
								</a>
							}
						</div>
					} else {
						<div class="nav-menu-group">
							<span class="nav-menu-label">قيد المراجعة</span>
							if actor.IsVendor() {
								<a href="/vendor/documents" class="nav-menu-item" role="menuitem">
									@IconFile("icon-xs")
									<span>المستندات والتراخيص</span>
								</a>
							} else {
								<a href="/customer/documents" class="nav-menu-item" role="menuitem">
									@IconFile("icon-xs")
									<span>المستندات والتراخيص</span>
								</a>
							}
							<a href="/notifications" class="nav-menu-item" role="menuitem">
								@IconBell("icon-xs")
								<span>مركز الإشعارات</span>
							</a>
						</div>
					}
				</div>
				<div class="nav-menu-settings">
					<span class="nav-menu-eyebrow">المظهر</span>
					<div class="nav-seg" role="group" aria-label="المظهر">
						<button type="button" class="nav-seg-btn" data-set-theme="light" title="فاتح">
							@IconSun("icon-xs")
							<span>فاتح</span>
						</button>
						<button type="button" class="nav-seg-btn" data-set-theme="dark" title="داكن">
							@IconMoon("icon-xs")
							<span>داكن</span>
						</button>
					</div>
				</div>
				<div class="nav-menu-settings">
					<span class="nav-menu-eyebrow">اللغة</span>
					<div class="nav-seg nav-seg--flags" role="group" aria-label="اللغة">
						<a href="/lang/ar" class={ "nav-seg-btn", templ.KV("is-active", lang != "en") } hreflang="ar" title="العربية">
							@IconFlagEG("icon-sm")
						</a>
						<a href="/lang/en" class={ "nav-seg-btn", templ.KV("is-active", lang == "en") } hreflang="en" title="English">
							@IconFlagGB("icon-sm")
						</a>
					</div>
				</div>
				<div class="nav-menu-exit">
					<form action="/auth/logout" method="POST" class="nav-menu-form">
						<button type="submit" class="nav-menu-item nav-menu-item--danger" role="menuitem">
							@IconLogout("icon-xs")
							<span>{ i18n.T(lang, "auth.logout") }</span>
						</button>
					</form>
				</div>
			</div>
		</div>
	}
}

func dashboardURL(actor authctx.Actor) string {
	if !actor.IsOrgApproved() && !actor.IsStaff {
		if actor.IsVendor() {
			return "/vendor/documents"
		}
		return "/customer/documents"
	}
	switch actor.DashboardScope() {
	case rbac.ScopeAdmin:
		return "/admin/dashboard"
	case rbac.ScopeVendor:
		return "/vendor/dashboard"
	default:
		return "/customer/dashboard"
	}
}

// accountEyebrow is the mono descriptor above the name in the trigger. It says
// which of the three audiences the caller is signed in as, which is the one
// piece of context that decides what every other control in the bar does.
func accountEyebrow(actor authctx.Actor) string {
	switch {
	case actor.IsStaff:
		return "ADMIN"
	case actor.IsVendor():
		return "SUPPLIER"
	default:
		return "PHARMACY"
	}
}

// Initials builds the avatar monogram. Exported because the mobile drawer
// renders the same avatar as the account menu trigger.
func Initials(name string) string {
	fields := strings.Fields(name)
	if len(fields) == 0 {
		return "?"
	}
	first := []rune(fields[0])
	out := string(first[:1])
	if len(fields) > 1 {
		second := []rune(fields[len(fields)-1])
		out += string(second[:1])
	}
	return strings.ToUpper(out)
}

func orgLink(actor authctx.Actor) string {
	switch {
	case actor.IsStaff:
		return ""
	case actor.IsVendor() && actor.Can("vendor.user_org.view"):
		return "/vendor/user-organization"
	case actor.IsCustomer() && actor.Can("pharmacy.user_org.view"):
		return "/customer/user-organization"
	default:
		return ""
	}
}
