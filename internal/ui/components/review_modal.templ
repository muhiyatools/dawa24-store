package components

// ReviewModalProps configures the multi-criteria feedback dialog.
type ReviewModalProps struct {
	ID             string
	TargetOrgID    int64
	TargetName     string
	OrderID        *int64
	Context        string // supplier, pharmacy, product
	CriteriaKeys   []string
	CriteriaLabels []string
}

templ ReviewModal(props ReviewModalProps) {
	<div
		id={ props.ID }
		class="modal-backdrop"
		style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px); z-index:var(--z-modal); align-items:center; justify-content:center; padding:var(--space-4);"
		data-modal
	>
		<div
			class="modal-content"
			style="background:var(--surface-raised); border:1px solid var(--border); border-radius:var(--radius-xl); max-width:600px; width:100%; max-height:90vh; overflow-y:auto; padding:var(--space-6); box-shadow:var(--shadow-xl);"
		>
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-5); border-bottom:1px solid var(--border); padding-bottom:var(--space-3);">
				<div>
					<h3 style="margin:0; font-size:var(--text-lg); font-weight:700; color:var(--text);">
						تقييم تجربة التعامل
					</h3>
					if props.TargetName != "" {
						<div class="text-xs" style="color:var(--text-secondary); margin-top:2px;">
							{ props.TargetName }
						</div>
					}
				</div>
				<button
					type="button"
					class="btn-close"
					style="background:transparent; border:none; color:var(--text-secondary); font-size:1.5rem; cursor:pointer; padding:var(--space-1);"
					onclick={ templ.ComponentScript{Call: "document.getElementById('" + props.ID + "').style.display='none'"} }
				>
					×
				</button>
			</div>

			<form method="POST" action="/api/v1/reviews">
				<input type="hidden" name="organization_id" value={ templ.EscapeString(string(rune(props.TargetOrgID))) }/>
				if props.OrderID != nil {
					<input type="hidden" name="order_id" value={ templ.EscapeString(string(rune(*props.OrderID))) }/>
				}
				<input type="hidden" name="context" value={ props.Context }/>

				<!-- Overall & Criteria Ratings -->
				<div style="margin-bottom:var(--space-5);">
					<label class="form-label" style="font-weight:600; margin-bottom:var(--space-3); display:block; color:var(--text);">
						معايير التقييم والجودة
					</label>
					
					<div style="display:grid; gap:var(--space-3); background:var(--surface-sunken); padding:var(--space-4); border-radius:var(--radius-md); border:1px solid var(--border);">
						{{
							keys := props.CriteriaKeys
							labels := props.CriteriaLabels
							if len(keys) == 0 {
								keys = []string{"delivery_speed", "product_quality", "rep_service", "price_fairness", "order_accuracy", "packaging"}
								labels = []string{"سرعة التوصيل", "جودة المنتجات", "تعامل المندوب", "مناسبة الأسعار", "دقة تنفيذ الطلب", "جودة التغليف"}
							}
						}}
						for i, key := range keys {
							<div style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-3);">
								<span style="font-size:var(--text-sm); font-weight:500; color:var(--text);">
									if i < len(labels) {
										{ labels[i] }
									} else {
										{ key }
									}
								</span>
								<div class="star-rating-input" style="display:flex; gap:4px; font-size:1.25rem; color:#f59e0b; cursor:pointer;">
									<select name={ "rating_" + key } class="form-control text-xs" style="padding:4px 8px; width:auto;">
										<option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
										<option value="4">⭐⭐⭐⭐ (4/5)</option>
										<option value="3">⭐⭐⭐ (3/5)</option>
										<option value="2">⭐⭐ (2/5)</option>
										<option value="1">⭐ (1/5)</option>
									</select>
								</div>
							</div>
						}
					</div>
				</div>

				<!-- Title & Comment -->
				<div style="margin-bottom:var(--space-4);">
					<label class="form-label" style="font-weight:600; margin-bottom:var(--space-1); display:block; color:var(--text);">
						عنوان التقييم (اختياري)
					</label>
					<input type="text" name="title" placeholder="ملخص تجربتك..." class="form-control" style="width:100%;"/>
				</div>

				<div style="margin-bottom:var(--space-5);">
					<label class="form-label" style="font-weight:600; margin-bottom:var(--space-1); display:block; color:var(--text);">
						الملاحظات والتعليق
					</label>
					<textarea name="review_text" rows="3" placeholder="اكتب تفاصيل تجربتك لمساعدة الزملاء والمورد..." class="form-control" style="width:100%; resize:vertical;"></textarea>
				</div>

				<div style="display:flex; justify-content:flex-end; gap:var(--space-3);">
					<button
						type="button"
						class="btn btn-secondary"
						onclick={ templ.ComponentScript{Call: "document.getElementById('" + props.ID + "').style.display='none'"} }
					>
						إلغاء
					</button>
					<button type="submit" class="btn btn-primary">
						إرسال التقييم
					</button>
				</div>
			</form>
		</div>
	</div>
}
