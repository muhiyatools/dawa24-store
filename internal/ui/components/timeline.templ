package components

// Timeline renders a vertical chronological list. Used by order status
// history and address-change history.
templ Timeline() {
	<div class="timeline">
		{ children... }
	</div>
}

// TimelineItem is one entry: a title, an optional body, and a timestamp.
templ TimelineItem(title, time, body string) {
	<div class="timeline-item">
		<div class="timeline-dot"></div>
		<div class="timeline-content">
			<div style="font-weight:700; color:var(--neutral-900);">{ title }</div>
			if body != "" {
				<div style="font-size:0.85rem; color:var(--neutral-600);">{ body }</div>
			}
			<div style="font-size:0.72rem; color:var(--neutral-400); margin-top:0.2rem;">{ time }</div>
		</div>
	</div>
}
