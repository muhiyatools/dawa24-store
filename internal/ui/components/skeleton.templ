package components

// Loading placeholders.
//
// These are the shape of the content that is coming, not a spinner in the
// middle of an empty box. A list skeleton with the row height of the real rows
// means the page does not jump when the data lands.

// SkeletonText renders n placeholder lines, the last one short so it reads as
// the end of a paragraph.
templ SkeletonText(lines int) {
	<div class="skeleton-text" aria-hidden="true">
		for i := 0; i < lines; i++ {
			if i == lines-1 {
				<div class="skeleton skeleton-line" style="width:65%;"></div>
			} else {
				<div class="skeleton skeleton-line" style="width:100%;"></div>
			}
		}
	</div>
}

// SkeletonCard is a single product/summary card placeholder.
templ SkeletonCard() {
	<div class="skeleton-card" aria-hidden="true">
		<div class="skeleton skeleton-block"></div>
		<div class="skeleton skeleton-title"></div>
		<div class="skeleton skeleton-line" style="width:100%;"></div>
		<div class="skeleton skeleton-line" style="width:80%;"></div>
	</div>
}

// SkeletonGrid fills a catalog grid while products load.
templ SkeletonGrid(count int) {
	<div class="skeleton-grid" aria-hidden="true">
		for i := 0; i < count; i++ {
			@SkeletonCard()
		}
	</div>
}

// SkeletonTable mirrors a data table: a header strip and n rows of four cells.
templ SkeletonTable(rows int) {
	<div class="table-container" aria-hidden="true">
		<div class="skeleton" style="height:2.6rem; border-radius:0;"></div>
		for i := 0; i < rows; i++ {
			<div class="skeleton-row">
				<div class="skeleton skeleton-line" style="width:28%; margin:0;"></div>
				<div class="skeleton skeleton-line" style="width:22%; margin:0;"></div>
				<div class="skeleton skeleton-line" style="width:18%; margin:0;"></div>
				<div class="skeleton skeleton-line" style="width:15%; margin:0;"></div>
			</div>
		}
	</div>
}

// SkeletonList is a media list: avatar plus two lines, repeated.
templ SkeletonList(rows int) {
	<div aria-hidden="true">
		for i := 0; i < rows; i++ {
			<div class="skeleton-row">
				<div class="skeleton skeleton-avatar"></div>
				<div style="flex:1;">
					<div class="skeleton skeleton-line" style="width:40%;"></div>
					<div class="skeleton skeleton-line" style="width:70%; margin-bottom:0;"></div>
				</div>
			</div>
		}
	</div>
}

// SkeletonStats is a row of dashboard metric cards.
templ SkeletonStats(count int) {
	<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem;" aria-hidden="true">
		for i := 0; i < count; i++ {
			<div class="skeleton-card">
				<div class="skeleton skeleton-line" style="width:55%;"></div>
				<div class="skeleton" style="height:2rem; width:40%; margin-top:0.75rem;"></div>
			</div>
		}
	</div>
}

// Spinner is for inline use inside a button or beside a label, where a full
// skeleton would be too heavy.
templ Spinner(size string) {
	if size == "lg" {
		<span class="spinner spinner-lg" role="status" aria-label="جارٍ التحميل"></span>
	} else {
		<span class="spinner" role="status" aria-label="جارٍ التحميل"></span>
	}
}

// LoadingIndicator is the HTMX partner: hidden until a request is in flight on
// the element that names it via hx-indicator.
templ LoadingIndicator(label string) {
	<span class="htmx-indicator" style="display:none; align-items:center; gap:0.5rem; color:var(--neutral-600); font-size:0.875rem;">
		@Spinner("")
		if label != "" {
			<span>{ label }</span>
		} else {
			<span>جارٍ التحميل…</span>
		}
	</span>
}
