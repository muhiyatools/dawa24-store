package components

type DropdownProps struct {
	ID    string
	Label string
	State string
	// Align "end" opens the menu from the inline-end edge.
	Align string
}

// Dropdown is an Alpine-driven menu. Alpine is already loaded in the base
// layout; the previous version toggled a "hidden" class that nothing ever
// removed, so the menu could not be opened at all.
templ Dropdown(props DropdownProps) {
	<div class="dropdown" id={ props.ID } x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">
		<button
			type="button"
			class="btn btn-secondary btn-sm"
			@click="open = !open"
			:aria-expanded="open"
			aria-haspopup="true"
		>
			<span>{ props.Label }</span>
			<svg class="icon-xs" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<div
			class="dropdown-menu"
			x-show="open"
			x-cloak
			x-transition.opacity
			role="menu"
			if props.Align == "end" {
				style="inset-inline-start:auto; inset-inline-end:0;"
			}
		>
			switch props.State {
				case "loading":
					<div class="dropdown-item" style="color:var(--neutral-500);">
						@Spinner("")
						<span>جارٍ التحميل…</span>
					</div>
				case "error":
					<div class="dropdown-item danger">تعذر تحميل القائمة</div>
				default:
					{ children... }
			}
		</div>
	</div>
}

type DropdownItemProps struct {
	Label  string
	URL    string
	Danger bool
	// OnClickDialog opens the dialog with this id instead of navigating, which
	// is how a destructive item routes through a confirmation.
	OnClickDialog string
}

templ DropdownItem(props DropdownItemProps) {
	if props.OnClickDialog != "" {
		<button
			type="button"
			class={ "dropdown-item", templ.KV("danger", props.Danger) }
			role="menuitem"
			onclick={ openDialog(props.OnClickDialog) }
		>
			if props.Danger {
				@IconTrash("icon-xs")
			}
			<span>{ props.Label }</span>
		</button>
	} else {
		<a
			href={ templ.SafeURL(props.URL) }
			class={ "dropdown-item", templ.KV("danger", props.Danger) }
			role="menuitem"
		>
			<span>{ props.Label }</span>
		</a>
	}
}
