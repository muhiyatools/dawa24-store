package components

templ PrimaryButton(text string, hxPost string, hxTarget string) {
	<button
		type="button"
		class="btn btn-primary"
		if hxPost != "" {
			hx-post={ hxPost }
		}
		if hxTarget != "" {
			hx-target={ hxTarget }
		}
	>
		{ text }
	</button>
}

templ SecondaryButton(text string, href string) {
	<a href={ templ.SafeURL(href) } class="btn btn-secondary">
		{ text }
	</a>
}

templ DangerButton(text string, hxDelete string, hxConfirm string) {
	<button
		type="button"
		class="btn btn-danger"
		hx-delete={ hxDelete }
		if hxConfirm != "" {
			hx-confirm={ hxConfirm }
		}
	>
		{ text }
	</button>
}
