package components

type CommandPaletteProps struct {
	Commands []Command
}

// Command is one navigable entry in the command palette.
type Command struct {
	Label string
	URL   string
}

// CommandPalette is a ⌘K / Ctrl+K navigation overlay for power users.
templ CommandPalette(props CommandPaletteProps) {
	<div x-data="{ open: false }" @keydown.window.cmd.k.prevent="open = !open" @keydown.window.ctrl.k.prevent="open = !open" @keydown.escape.window="open = false">
		<div x-show="open" x-cloak class="palette-overlay" @click="open = false"></div>
		<div x-show="open" x-cloak class="palette">
			<input type="text" class="form-input palette-input" placeholder="اكتب للبحث عن صفحة…" autofocus />
			<div class="palette-list">
				for _, c := range props.Commands {
					<a href={ templ.SafeURL(c.URL) } class="palette-item" @click="open = false">
						<span>{ c.Label }</span>
					</a>
				}
			</div>
		</div>
	</div>
}
