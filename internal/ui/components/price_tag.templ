package components

import (
	"strconv"

	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/money"
)

// PriceBreakdown mirrors promo.DiscountBreakdown at the view layer, keeping
// this package free of module imports. Build it in the handler from
// promo.EffectivePrice (Rebuild V2 §3.4).
type PriceBreakdown struct {
	ListPrice      money.Amount // list price, struck through when a discount applies
	Price          money.Amount // the price the customer actually pays
	DiscountAmount money.Amount // saved amount, shown as توفير X when positive
	DiscountBPS    int64        // effective percent in basis points (1500 = 15%)
	Large          bool        // buy-box scale for the final price
}

// percentFromBPS renders basis points as a trimmed percent ("15", "12.5").
func percentFromBPS(bps int64) string {
	return strconv.FormatFloat(float64(bps)/100, 'f', -1, 64)
}

// PriceTag renders a discounted price the way Laravel did: list price struck
// through, the discounted price prominent, a خصم % badge and a توفير line.
// With no discount it collapses to the price alone.
templ PriceTag(bd PriceBreakdown) {
	<div class="stack-sm items-start">
		if bd.DiscountAmount.IsPositive() && bd.ListPrice.Minor() > bd.Price.Minor() {
			<div class="row-center-xs flex-wrap">
				<span class="tabular-nums text-xs text-muted" style="text-decoration:line-through;">
					{ format.Money(bd.ListPrice, "ar") }
				</span>
				if bd.DiscountBPS > 0 {
					<span class="badge badge-rose fw-800 text-xs">
						خصم { percentFromBPS(bd.DiscountBPS) }%
					</span>
				}
			</div>
			<span class={ "money tabular-nums fw-800 text-accent", templ.KV("money-lg", bd.Large) }>
				{ format.Money(bd.Price, "ar") }
			</span>
			<span class="tabular-nums text-xs fw-600 text-success">
				توفير { format.Money(bd.DiscountAmount, "ar") }
			</span>
		} else {
			<span class={ "money tabular-nums fw-800 text-accent", templ.KV("money-lg", bd.Large) }>
				{ format.Money(bd.Price, "ar") }
			</span>
		}
	</div>
}