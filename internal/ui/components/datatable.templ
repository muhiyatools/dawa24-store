package components

type Column struct {
	Key      string
	Label    string
	Sortable bool
	// Numeric right-aligns and applies tabular figures, so a column of money
	// or quantities lines up on the decimal.
	Numeric bool
}

type DataTableProps struct {
	Columns []Column
	// State is one of loading, empty, error, ready, partial.
	State string
	Error string
	// EmptyTitle and EmptyMessage let each screen say something specific
	// instead of a generic "no data".
	EmptyTitle   string
	EmptyMessage string
	// ShowActions appends an actions column header.
	ShowActions bool
	// SortURL is the base URL for sortable headers; the column key is appended
	// as ?sort=<key>.
	SortURL string
}

templ DataTable(props DataTableProps) {
	switch props.State {
		case "loading":
			@SkeletonTable(6)
		case "error":
			@ErrorState(ErrorStateProps{Message: props.Error})
		case "empty":
			@EmptyState(EmptyStateProps{
				Title:   defaultStr(props.EmptyTitle, "لا توجد سجلات"),
				Message: defaultStr(props.EmptyMessage, "لم يتم العثور على أي بيانات لعرضها حتى الآن."),
			})
		default:
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							for _, col := range props.Columns {
								<th
									if col.Numeric {
										class="tabular-nums text-end"
									}
								>
									if col.Sortable && props.SortURL != "" {
										<a href={ templ.SafeURL(props.SortURL + "?sort=" + col.Key) } style="color:inherit; display:inline-flex; align-items:center; gap:0.25rem;">
											{ col.Label }
											<span aria-hidden="true" style="opacity:0.5;">↕</span>
										</a>
									} else {
										{ col.Label }
									}
								</th>
							}
							if props.ShowActions {
								<th class="text-end">إجراءات</th>
							}
						</tr>
					</thead>
					<tbody>
						{ children... }
					</tbody>
				</table>
				if props.State == "partial" {
					<div class="table-empty" style="border-top:1px solid var(--neutral-100);">
						@Spinner("")
						<span style="margin-inline-start:0.5rem;">جارٍ تحميل المزيد…</span>
					</div>
				}
			</div>
	}
}

func defaultStr(v, fallback string) string {
	if v == "" {
		return fallback
	}
	return v
}
