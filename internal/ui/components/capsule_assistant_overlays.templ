package components

templ CapsuleAssistantOverlays() {
	<!-- Sessions Drawer Overlay (Full Height Slide-over) -->
	<div
		x-show="showSessionsDrawer"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-2"
		class="capsule-sessions-overlay"
	>
		<!-- Drawer Top Bar -->
		<div class="p-3 border-b flex-between items-center bg-surface-raised">
			<div class="d-flex items-center gap-1.5 font-extrabold text-xs text-primary">
				@IconClock("icon-xs")
				<span x-text="window.dawaT ? window.dawaT('capsule.history_title', 'المحادثات السابقة') : 'المحادثات السابقة'">المحادثات السابقة</span>
			</div>
			<button
				type="button"
				@click="showSessionsDrawer = false"
				class="capsule-hdr-icon-btn"
				:title="window.dawaT ? window.dawaT('common.close', 'إغلاق') : 'إغلاق'"
			>
				@IconClose("icon-xs")
			</button>
		</div>

		<!-- Start New Chat Action in Drawer -->
		<div class="p-3 pb-2 d-flex flex-col gap-2">
			<button
				type="button"
				@click="startNewConversation()"
				class="btn btn-primary btn-sm w-full font-extrabold justify-center gap-1.5 shadow-xs"
			>
				@IconPlus("icon-xs")
				<span x-text="window.dawaT ? window.dawaT('capsule.new_chat', 'بدء محادثة جديدة الآن') : 'بدء محادثة جديدة الآن'">بدء محادثة جديدة الآن</span>
			</button>

			<!-- Search Filter -->
			<div class="relative w-full">
				<input
					type="text"
					x-model="searchPastQuery"
					:placeholder="window.dawaT ? window.dawaT('common.search', 'بحث في المحادثات...') : 'بحث في المحادثات...'"
					class="form-input text-xs w-full pe-7"
				/>
				<div class="absolute inset-y-0 end-2 flex-center text-muted pointer-events-none">
					@IconSearch("icon-2xs")
				</div>
			</div>
		</div>

		<!-- Sessions List Scrollable Container -->
		<div class="flex-1 overflow-y-auto p-3 pt-1 d-flex flex-col gap-2">
			<!-- Loading State -->
			<template x-if="isLoadingPastSessions">
				<div class="d-flex flex-col items-center justify-center py-8 gap-2 text-muted text-xs">
					<div class="capsule-spinner"></div>
					<span x-text="window.dawaT ? window.dawaT('common.loading', 'جاري جلب المحادثات السابقة...') : 'جاري جلب المحادثات السابقة...'">جاري جلب المحادثات السابقة...</span>
				</div>
			</template>

			<!-- Empty State -->
			<template x-if="!isLoadingPastSessions && filteredPastConversations().length === 0">
				<div class="d-flex flex-col items-center justify-center py-8 text-center text-muted gap-1.5">
					<div class="w-9 h-9 rounded-full bg-surface-sunken flex-center text-muted">
						@IconClock("icon-sm")
					</div>
					<div class="text-xs font-bold text-primary" x-text="window.dawaT ? window.dawaT('common.empty', 'لا توجد محادثات سابقة') : 'لا توجد محادثات سابقة'">لا توجد محادثات سابقة</div>
					<div class="text-2xs max-w-xs">أي استفسار تطرحه يتم حفظه هنا تلقائياً لترجع له في أي وقت.</div>
				</div>
			</template>

			<!-- Conversations Items -->
			<template x-for="conv in filteredPastConversations()" :key="conv.id">
				<div
					class="capsule-session-card"
					:class="{ 'active': conversationID === conv.id }"
					@click="loadSessionThread(conv.id)"
				>
					<div class="flex-1 text-truncate">
						<div class="d-flex items-center gap-1.5 mb-0.5">
							<span class="text-xs font-bold text-primary text-truncate" x-text="conv.title || (window.dawaT ? window.dawaT('capsule.past_chat', 'محادثة سابقة') : 'محادثة سابقة')"></span>
							<template x-if="conversationID === conv.id">
								<span class="badge badge-primary text-2xs font-bold" x-text="window.dawaT ? window.dawaT('common.active', 'نشطة') : 'نشطة'">نشطة</span>
							</template>
						</div>
						<div class="text-2xs text-muted font-mono" x-text="formatDate(conv.updated_at)"></div>
					</div>
					<button
						type="button"
						@click.stop="deleteSession(conv.id)"
						class="capsule-hdr-icon-btn text-danger hover:text-danger"
						:title="window.dawaT ? window.dawaT('common.delete', 'حذف المحادثة') : 'حذف المحادثة'"
					>
						@IconTrash("icon-2xs")
					</button>
				</div>
			</template>
		</div>
	</div>

	<!-- Memory Drawer Overlay (Full Height Slide-over) -->
	<div
		x-show="showMemoryDrawer"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-2"
		class="capsule-sessions-overlay"
	>
		<!-- Drawer Top Bar -->
		<div class="p-3 border-b flex-between items-center bg-surface-raised">
			<div class="d-flex items-center gap-1.5 font-extrabold text-xs text-primary">
				@IconDatabase("icon-xs")
				<span x-text="window.dawaT ? window.dawaT('capsule.memory_title', 'ذاكرة المنشأة الذكية') : 'ذاكرة المنشأة الذكية'">ذاكرة المنشأة الذكية</span>
				<span class="badge badge-2xs badge-primary ms-1" x-text="memories.length"></span>
			</div>
			<button
				type="button"
				@click="showMemoryDrawer = false"
				class="capsule-hdr-icon-btn"
				:title="window.dawaT ? window.dawaT('common.close', 'إغلاق الذاكرة') : 'إغلاق الذاكرة'"
			>
				@IconClose("icon-xs")
			</button>
		</div>

		<!-- Educational / Explanatory Note -->
		<div class="px-3 pt-2.5 pb-1">
			<div class="p-2 rounded-lg bg-primary-subtle/40 border border-primary/15 text-2xs text-secondary leading-relaxed">
				يتعلم "كبسولة" ويحفظ تلقائياً القواعد والتفضيلات والسياسات الخاصة بمنشأتك (مثل مواعيد الفروع وشروط السداد)، ويتذكرها في كافة الجلسات والمحادثات.
			</div>
		</div>

		<!-- Add Manual Memory Input -->
		<div class="p-3 pb-2 d-flex flex-col gap-2 border-b">
			<div class="d-flex flex-col gap-1.5">
				<textarea
					x-model="newMemoryContent"
					rows="2"
					placeholder="أضف قاعدة أو تفضيل يدوي للمنشأة..."
					class="form-input text-xs w-full resize-none"
					@keydown.enter.prevent="if (!$event.shiftKey) addMemory()"
				></textarea>
				<div class="d-flex items-center justify-between gap-2">
					<select x-model="newMemoryCategory" class="form-select text-2xs py-1 px-2 flex-1">
						<option value="general">معلومات عامة</option>
						<option value="logistics">اللوجستيات ومواعيد الاستلام</option>
						<option value="financial">التفضيلات المالية والسداد</option>
						<option value="procurement">المشتريات والتوريد</option>
						<option value="business_profile">ملف ونشاط المنشأة</option>
						<option value="preferences">تفضيلات التعامل والتحليل</option>
						<option value="contacts">جهات الاتصال والمسؤولين</option>
					</select>
					<button
						type="button"
						@click="addMemory()"
						:disabled="!newMemoryContent.trim() || isSavingMemory"
						class="btn btn-primary btn-sm text-xs px-3 py-1 font-extrabold gap-1"
					>
						<template x-if="isSavingMemory">
							<span class="capsule-spinner w-3 h-3"></span>
						</template>
						<span x-text="window.dawaT ? window.dawaT('common.save', 'حفظ بالذاكرة') : 'حفظ بالذاكرة'">حفظ بالذاكرة</span>
					</button>
				</div>
			</div>

			<!-- Search Filter -->
			<div class="relative w-full mt-1">
				<input
					type="text"
					x-model="searchMemoryQuery"
					:placeholder="window.dawaT ? window.dawaT('common.search', 'بحث في الذاكرة...') : 'بحث في الذاكرة...'"
					class="form-input text-xs w-full pe-7"
				/>
				<div class="absolute inset-y-0 end-2 flex-center text-muted pointer-events-none">
					@IconSearch("icon-2xs")
				</div>
			</div>
		</div>

		<!-- Memories List Scrollable Container -->
		<div class="flex-1 overflow-y-auto p-3 pt-1 d-flex flex-col gap-2">
			<!-- Loading State -->
			<template x-if="isLoadingMemories">
				<div class="d-flex flex-col items-center justify-center py-8 gap-2 text-muted text-xs">
					<div class="capsule-spinner"></div>
					<span x-text="window.dawaT ? window.dawaT('common.loading', 'جاري جلب ذاكرة المنشأة...') : 'جاري جلب ذاكرة المنشأة...'">جاري جلب ذاكرة المنشأة...</span>
				</div>
			</template>

			<!-- Empty State -->
			<template x-if="!isLoadingMemories && filteredMemories().length === 0">
				<div class="d-flex flex-col items-center justify-center py-8 gap-1.5 text-center">
					<div class="text-muted opacity-50 mb-1">
						@IconDatabase("icon-lg")
					</div>
					<div class="font-extrabold text-xs text-primary" x-text="window.dawaT ? window.dawaT('capsule.memory_empty', 'الذاكرة فارغة حالياً') : 'الذاكرة فارغة حالياً'">الذاكرة فارغة حالياً</div>
					<div class="text-2xs text-muted max-w-xs leading-relaxed" x-text="window.dawaT ? window.dawaT('capsule.memory_empty_sub', 'ستظهر هنا القواعد والتفضيلات التي يستنتجها المساعد أو التي تضيفها أنت يدوياً.') : 'ستظهر هنا القواعد والتفضيلات التي يستنتجها المساعد أو التي تضيفها أنت يدوياً.'">
						ستظهر هنا القواعد والتفضيلات التي يستنتجها المساعد أو التي تضيفها أنت يدوياً.
					</div>
				</div>
			</template>

			<!-- Memory Cards -->
			<template x-for="mem in filteredMemories()" :key="mem.id">
				<div class="capsule-session-card flex-col items-start gap-1.5 relative group">
					<div class="w-full flex-between items-center gap-1">
						<div class="d-flex items-center gap-1.5 flex-wrap">
							<span class="badge badge-2xs badge-primary" x-text="memoryCategoryLabel(mem.category)"></span>
							<span class="badge badge-2xs badge-neutral" x-text="memorySourceLabel(mem.source)"></span>
						</div>
						<button
							type="button"
							@click.stop="deleteMemory(mem.id)"
							class="capsule-hdr-icon-btn text-danger hover:text-danger p-1"
							:title="window.dawaT ? window.dawaT('common.delete', 'حذف المعلومة من الذاكرة') : 'حذف المعلومة من الذاكرة'"
						>
							@IconTrash("icon-2xs")
						</button>
					</div>
					<div class="text-xs text-primary font-medium leading-relaxed select-text" x-text="mem.content"></div>
					<div class="text-3xs text-muted" x-text="formatDate(mem.created_at)"></div>
				</div>
			</template>
		</div>
	</div>
}