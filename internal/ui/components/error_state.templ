package components

type ErrorStateProps struct {
	Title      string
	Message    string
	RetryURL   string
	RetryLabel string
}

templ ErrorState(props ErrorStateProps) {
	<div class="error-state flex flex-col items-center justify-center p-8 text-center border border-red-200 rounded-xl bg-red-50/50 my-6">
		<div class="mb-4 text-red-500">
			<svg class="w-12 h-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
			</svg>
		</div>
		<h3 class="text-lg font-bold text-red-900 mb-1">
			if props.Title != "" {
				{ props.Title }
			} else {
				حدث خطأ أثناء تحميل البيانات
			}
		</h3>
		<p class="text-sm text-red-700 mb-4 max-w-md">
			if props.Message != "" {
				{ props.Message }
			} else {
				تعذر إتمام العملية المطلوبة. يرجى المحاولة مرة أخرى أو الاتصال بالدعم الفني.
			}
		</p>
		if props.RetryURL != "" {
			<a href={ templ.SafeURL(props.RetryURL) } class="btn btn-primary bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition-colors inline-flex items-center gap-2">
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
				</svg>
				if props.RetryLabel != "" {
					{ props.RetryLabel }
				} else {
					إعادة المحاولة
				}
			</a>
		}
	</div>
}
