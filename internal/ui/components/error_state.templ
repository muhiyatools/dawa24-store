package components

type ErrorStateProps struct {
	Title      string
	Message    string
	RetryURL   string
	RetryLabel string
}

templ ErrorState(props ErrorStateProps) {
	<div class="stack-sm" style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:2.5rem 1.5rem; text-align:center; border:1px solid var(--danger-border); border-radius:var(--radius-xl); background:var(--danger-light); margin:1.5rem 0;">
		<div class="stack-sm" style="width:48px; height:48px; border-radius:var(--radius-lg); background:#fee2e2; color:var(--danger); display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
			<svg class="icon-lg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
			</svg>
		</div>
		<h3 style="font-size:1.15rem; font-weight:800; color:#991b1b; margin-bottom:0.35rem;">
			if props.Title != "" {
				{ props.Title }
			} else {
				حدث خطأ أثناء تحميل البيانات
			}
		</h3>
		<p style="font-size:0.9rem; color:#b91c1c; margin-bottom:1.25rem; max-width:440px; line-height:1.6;">
			if props.Message != "" {
				{ props.Message }
			} else {
				تعذر إتمام العملية المطلوبة. يرجى المحاولة مرة أخرى أو مراجعة الاتصال بالخادم.
			}
		</p>
		if props.RetryURL != "" {
			<a href={ templ.SafeURL(props.RetryURL) } class="btn btn-danger" style="padding:0.55rem 1.25rem; font-size:0.875rem;">
				@IconRefresh("icon-xs")
				if props.RetryLabel != "" {
					<span>{ props.RetryLabel }</span>
				} else {
					<span>إعادة المحاولة</span>
				}
			</a>
		}
	</div>
}
