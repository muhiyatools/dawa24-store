package components

// ModalProps configures a dialog.
//
// Built on the native <dialog> element rather than a div with a z-index: the
// browser then handles the top layer, focus trapping, the backdrop and Escape
// to close, none of which the previous hand-rolled version did.
type ModalProps struct {
	ID    string
	Title string
	// State renders the body as a placeholder while its content loads, for a
	// modal whose contents arrive over HTMX after it opens.
	State string
	// Size is "" (default), "sm" or "lg".
	Size string
}

templ Modal(props ModalProps) {
	<dialog id={ props.ID } class="modal" aria-labelledby={ props.ID + "-title" }>
		<div
			class={ "modal-box",
				templ.KV("modal-sm", props.Size == "sm"),
				templ.KV("modal-lg", props.Size == "lg"),
				templ.KV("modal-xl", props.Size == "xl"),
				templ.KV("modal-full", props.Size == "full"),
				templ.KV("modal-md", props.Size == "" || props.Size == "md") }
		>
			<div class="modal-header">
				<h3 class="modal-title" id={ props.ID + "-title" }>{ props.Title }</h3>
				<form method="dialog">
					<button class="modal-close" aria-label="إغلاق">
						@IconClose("icon-sm")
					</button>
				</form>
			</div>
			<div class="modal-body">
				switch props.State {
					case "loading":
						@SkeletonText(4)
					case "error":
						@ErrorState(ErrorStateProps{})
					default:
						{ children... }
				}
			</div>
		</div>
	</dialog>
}

// ConfirmModalProps describes a destructive-action confirmation.
type ConfirmModalProps struct {
	ID          string
	Title       string
	Message     string
	ConfirmURL  string
	ConfirmVerb string // "delete", "post" — the HTMX verb to use
	ConfirmText string
	CancelText  string
	// Danger styles the confirm button as destructive.
	Danger bool
	// Target is the HTMX target to swap on success.
	Target string
	// Swap defaults to innerHTML. outerHTML on a container would replace the
	// element that carries the target id, so the next action on the same page
	// would have nothing to aim at.
	Swap string
}

// ModalTrigger is the button that opens a dialog by id.
templ ModalTrigger(dialogID, class string) {
	<button
		type="button"
		class={ class }
		data-modal-open={ dialogID }
		data-dialog-target={ dialogID }
		onclick={ openDialog(dialogID) }
	>
		{ children... }
	</button>
}

script openDialog(id string) {
	const el = document.getElementById(id);
	if (el && typeof el.showModal === "function") {
		try { el.showModal(); } catch (_) { el.setAttribute('open', ''); }
	}
}

script closeDialog(id string) {
	const el = document.getElementById(id);
	if (el && typeof el.close === "function") {
		try { el.close(); } catch (_) { el.removeAttribute('open'); }
	}
}

