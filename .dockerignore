# Keep the build context tiny, fast, and secrets out of the image.

# Version control and editor noise
.git
.github
.idea
.vscode
.DS_Store
.system_generated

# Compiled binaries and local builds
bin
tmp
dist
build
*.exe
*.dll
*.so
*.dylib
*.out
*.log
*.tar
*.zip
*.gz
*.7z

# Local development data and coverage
.data
coverage.html
*.test

# Secrets must never enter a build context
.env
.env.*
!.env.example

# Local-only compose and documentation
docker-compose*.yml
*.md
!README.md
docs
test/fixtures
